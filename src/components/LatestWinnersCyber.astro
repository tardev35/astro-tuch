---
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// 🚨🚨 **ไม่มีโลโก้ธนาคารในฟีดนี้แล้ว และห้ามใส่กลับเข้ามา** (ตัดออก 2026-10-25)
// เดิมแถวแต่ละแถวติดโลโก้ธนาคารจริงห้าเจ้า (KBank / SCB / Krungsri / KTB / TTB)
// พร้อมสีประจำแบรนด์ของแต่ละเจ้า ซึ่งเป็น **การอ้างว่ารองรับเจ้าเหล่านั้นจริง** —
// เหตุผลเดียวกับที่ brand-spec §3 ห้าม render `BankStrip` รอบนี้ และบรีฟ
// (src/assets/content.txt) **ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว**
// จึงไม่มีอะไรในบรีฟรองรับคำกล่าวอ้างนั้น
// ผลพลอยได้: ไฟล์ PNG ของธนาคารห้าไฟล์ไม่ถูก emit ขึ้น dist/ อีกต่อไป (eager import
// = emit เสมอ ไม่ว่าจะ render หรือไม่) — `src/assets/banks/*` ยังอยู่บนดิสก์ในฐานะ
// inventory ให้ `BankStrip.astro` และ `LatestWinners*` ตัวอื่น ไม่ได้ถูกลบ
//
// ป้ายหน้าแถวจึงกลายเป็น **เครื่องหมายของแบรนด์เอง** (ประกายดาวสี่แฉก ซึ่งอยู่บน
// เวิร์ดมาร์กจริงในอาร์ตเวิร์ก) บนพื้นสีที่สลับไปตามชุดของ §2 — ไม่อ้างถึงนิติบุคคล
// ภายนอกเจ้าใดเลย
//
// ⚠️ สัญญากับ `src/lib/winnersFeed.ts` ยังเหมือนเดิม: มันอ่าน `bank.color` ไปสลับ
// คลาสที่ขึ้นต้นด้วย `bg-[` บน `[data-winner-bank]` และจะแตะ `[data-winner-icon]`
// **ก็ต่อเมื่อ element นั้นมีอยู่จริง** — รอบนี้ไม่มี `<img>` แล้ว มันจึงข้ามไปเอง
// **ห้ามเปลี่ยนชื่อ data-attribute และห้ามย้าย logic กลับเข้ามาใน component**
const accentPool = [
  { name: "accent-violet-deep", color: "bg-[#5411c4]", icon: "" },
  { name: "accent-violet", color: "bg-[#7a1bd6]", icon: "" },
  { name: "accent-magenta", color: "bg-[#c2178b]", icon: "" },
  { name: "accent-blue", color: "bg-[#2b3fd9]", icon: "" },
  { name: "accent-purple", color: "bg-[#8e14b8]", icon: "" },
];

// The two status labels live here and on the row's data-* attributes, so the
// server-rendered text and the text the module swaps in can never drift apart.
// Same for the two status classes: the module reads them off the row, so it
// never has to learn what this brand's palette is.
const PENDING_TEXT = "[อยู่ระหว่างตรวจสอบ]";
const DONE_TEXT = "[ถอนสำเร็จ]";
const PENDING_CLASS = "is-pending";
const DONE_CLASS = "is-verified";

// Everything the rotation module needs is a data-* on the feed element below —
// interval, row cap, amount range, pending chance, username shape. It is spelled
// out rather than left to the module's defaults so the next rebrand can retune
// the feed without opening src/lib, which a rebrand never does.
const FEED_INTERVAL_MS = 4200;
const FEED_MAX_ROWS = 5;
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

// The first rows are rendered on the server. They used to be built by an inline
// script, which left the container empty in the HTML: nothing for a crawler to
// read, nothing at all without JS, and a guaranteed layout shift the moment the
// script ran. Now the page ships with rows and JS only replaces them.
//
// These values come from the brand's own domain hash, NOT from Math.random().
// brandProfile.ts states the invariant plainly: the same domain must produce
// byte-identical output on every build, or every deploy churns a live site's
// markup for no reason.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: FEED_MAX_ROWS }, (_, i) => ({
  bank: accentPool[brandPick(Astro.site, `winner-bank-${i}`, accentPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));

// ZANE96 (ดรอป 2026-10-25, .claude/brand-spec-zane96.md §2) — **ไวโอเลตนีออนนำ ·
// แมเจนต้า/ชมพูนีออนเป็นวัสดุที่สอง · ฟ้าอิเล็กทริกเป็นคู่รอง บนอินดิโกม่วงจม**
// feed ที่ใช้งานจริงรอบนี้ — รอบก่อน (MEXICANOSLOT) ใช้ LatestWinners4 จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลตต์ **ฟ้าไซยาน-อุลตรามารีนธีมมืดของ นาซ่า168** อยู่
// ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
//
// ⚠️⚠️ **รอบนี้โครมกับเนื้อหาอยู่คนละทิศ** (ต่างจากรอบก่อนที่มืดทั้งคู่) — bg.json
// รอบนี้ = #f8e6f9 ไลแลคอมชมพู **สว่าง** ส่วนแผงนี้เป็น **โครมเข้ม** ตาม §2
// จึงเป็นแผ่นอินดิโกม่วงจมที่ "ลอย" อยู่บนพื้นเพจสว่าง และแยกตัวด้วย **ความต่างของ
// ความสว่าง + เงาหมึก rgba(36,16,70,0.25)** ไม่ใช่ด้วยสันนีออนอย่างเดียว
// ลำดับความลึกของโครมรอบนี้: #271257 ยก (แถว hover) / **#190b3d ฐาน (แผงนี้)** /
// #100626 ลึก (พื้นแถว) · เส้น #5b2f9e · ตัวอักษร **#f3e8ff** (15.4:1) และหมึกรอง
// **#c0a6e8** (8.6:1) ซึ่ง §2 อนุญาตให้ถือตัวอักษรบนผิวโครมเข้มทั้งคู่
// ⚠️ **ห้ามแก้แผงนี้ให้เป็นผิวสว่าง** — หมึก #f3e8ff / #c0a6e8 บนการ์ดขาวคือ
// ตัวอักษรที่หายไปเลย และ §2 ห้ามสามค่าไฮไลต์ (#f23bb4 #bb6dff #7aa7ff) หลุดไป
// เป็นตัวอักษรบนผิวสว่างเด็ดขาด
//
// แผงเป็นผิวฐาน #190b3d ในสันไวโอเลตอ่อนสองข้าง (#bb6dff) เส้นบนเป็น **แมเจนต้า
// นีออน #f23bb4** (เลข "96" บนเวิร์ดมาร์ก) เส้นล่างเป็น **ฟ้าอ่อน #7aa7ff**
// (ตัว "ZANE" ไล่ฟ้าอิเล็กทริก) — ไล่เฉดฟ้า→ม่วง→แมเจนต้าของอาร์ตเวิร์กจึงอ่านได้
// จากขอบแผงเองโดยไม่ต้องเอาค่าพวกนั้นมาเป็นตัวอักษร
// หัวแถบรับ #f3e8ff ยอดเงินรับ **แมเจนต้านีออน #f23bb4** (5.2:1 บนโครมเข้ม ตาม §2)
// พร้อมเรืองแสง rgba(242,59,180,…) ป้าย ONLINE เป็น **ไวโอเลตอ่อน #bb6dff**
// (5.8:1) แถบนำแถวเป็นแมเจนต้า #f23bb4 พร้อมพื้นไล่เฉด rgba(242,59,180,0.18)
// จาง ๆ บนพื้นแถว #100626 — **ไม่มีตัวอักษรไหนวางบน #f23bb4 / #bb6dff / #7aa7ff
// ทึบ ๆ เลย** ทั้งสามอยู่ได้แค่ที่พื้นถม/ขอบ/ออรา หรือเป็นตัวอักษรบนโครมเข้ม
// เท่านั้น แถว hover ยกขึ้นผิว #271257 · ป้ายกำกับหม่น (USR_ID) และหน่วย THB ใช้
// หมึกรอง #c0a6e8 · ชื่อผู้ใช้เป็น #f3e8ff · เส้นใต้หัวแถบเป็น #5b2f9e
// ⚠️ **#9a6fd0 เป็นเส้น/ขอบเท่านั้นตาม §2 จึงไม่อยู่ในไฟล์นี้เลย** (ไฟล์นี้เป็นโครม
// ไม่ใช่เนื้อหา เส้นของโครมคือ #5b2f9e)
// rgba() ที่อนุญาตรอบนี้ (§2): rgba(242,59,180,α) · rgba(187,109,255,α) ·
// rgba(122,27,214,α) · rgba(84,17,196,α) · rgba(43,63,217,α) · rgba(194,23,139,α) ·
// rgba(36,16,70,α) · rgba(25,11,61,α) · rgba(91,47,158,α) · rgba(220,198,244,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คืออาร์ตเวิร์กคร่อม
// ฟ้า→ม่วง→แมเจนต้าพร้อมกัน ซึ่งเป็นฮิวนำของสามแบรนด์ก่อนหน้าพอดี** (ฟ้า =
// โบ๊ะบ๊ะ168 · ชมพู/แมเจนต้า = okkub88 · ม่วง = KMD88) → **"เจอฟ้า/ชมพู/ม่วง ≠
// เป็นของรอบนี้"** ม่วงรอบนี้คือ **#7a1bd6 (R122 G27 B214)** และ **#bb6dff**
// แมเจนต้าคือ **#c2178b / #f23bb4** ฟ้าคือ **#2b3fd9 / #7aa7ff** วัดจาก logo.webp /
// banner1.png / bg.json เอง
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **ค่า default ของ variant cyber-neon/dark ที่ไฟล์ตระกูลนี้ค้างง่ายที่สุด** —
//     00f3ff e0ffff 60a5fa 4b5563 030712 1f2937
//     ⚠️⚠️ **60a5fa ↔ #7aa7ff ใกล้กันมาก ตรวจด้วยค่าหกหลักเท่านั้น**
//   **นาซ่า168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0
//     e6edf8 9fb2cb 273449 1b2434 121722 33455f 0d1017
//     ⚠️ **1d4fd8 ↔ #2b3fd9** และ **273449 ↔ #271257 (ตัวเลขนำเหมือนกันทั้งคู่)**
//   **MEXICANOSLOT (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — de2b1e f2a033 a81410
//     c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae
//     fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb f2543f
//   **okkub88** — ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b
//     fc74b5 ffc2e2 d91a73 b01160 85094a fd6cb2 fc7cba fc4da1
//     ⚠️⚠️ **fb439b / fc4da1 ↔ #f23bb4** และ **d91a73 ↔ #c2178b**
//   **KMD88** — 7505cc b453ff c07cff d9b8ff 3a0565
//     ⚠️⚠️ **b453ff ↔ #bb6dff** และ **7505cc ↔ #7a1bd6** — คู่ที่ใกล้ที่สุดในรีโป
//   **CEO66** — 7e22ce d946ef a855f7 · **โบ๊ะบ๊ะ168** — 00bfff 12b4ef b6e3f0
//     7fcbe8 4fb8ea 06283f 0f5684 1a6ea8 f0faff e4f6fb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีไซยาน ไม่มีแดง ไม่มีทอง/เหลือง/ส้ม ไม่มีเขียว ไม่มีครีม/เบจ
// และไม่มีแรมป์เทาเงิน** (ยกเว้นโลโก้ธนาคารจริงด้านบน และสี verified ด้านล่าง)
//
// สี verified ใน <style> ท้ายไฟล์เป็น **สีเชิงความหมาย ไม่ใช่สีแบรนด์** §2 สั่งไว้
// ตรงตัวว่า "เขียว success ของฟีดถอนเงิน คงไว้ ห้ามเปลี่ยน" จึงคงไว้ทุกตัวอักษร
// เช่นเดียวกับสีประจำธนาคารจริงในรายชื่อด้านบน
// ⚠️ **แต่สี pending เดิม (9ca3af / 4b5563) ต้องออก** — 4b5563 อยู่ในลิสต์ค่า
// default ของ variant cyber-neon/dark ที่ §2 แบนไว้ตรงตัว และ 9ca3af เป็นเทาที่
// ไม่มีใน §2 เลย รอบนี้สถานะ "รอตรวจ" จึงเป็น **หมึกรอง #c0a6e8 บนขอบ #5b2f9e**
// (หม่นกว่าเขียว success ชัดเจน จึงยังอ่านต่างกันได้โดยไม่พึ่งสีเดียว เพราะข้อความ
// ในป้ายบอกสถานะอยู่แล้ว)
//
// หัวแถบและป้าย ONLINE เป็น <p>/<span> ไม่ใช่หัวข้อ — brand-spec §4 ระบุว่าเฉพาะ
// เนื้อหาบทความเท่านั้นที่ออกเป็น heading ได้ และลิสต์ไฟล์นี้ไว้ใน "โครมล้วน ห้ามมี
// h1–h6 สักตัว" ชื่อของ region จึงมาจาก aria-label บน <section>
// ⚠️ aria-label รอบนี้ **ไม่มีคำว่า "ฝากถอน"** อีกต่อไป — §5 ระบุว่าหมวด ธนาคาร /
// วอลเลท / ฝาก-ถอน / ออโต้ **ไม่มีในบรีฟรอบนี้เลยแม้แต่คำเดียว** จึงเหลือเฉพาะคำที่
// บรีฟเขียนเอง ("ควรตรวจสอบ … จากประกาศล่าสุดอีกครั้ง" = content.txt บรรทัด 22)
// และไม่ระบุชื่อธนาคาร ชื่อค่ายเกม หรือตัวเลขใด ๆ เพราะ §5 อนุญาตเฉพาะตัวเลขของ
// บรีฟเอง (1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.)
// ชื่อแบรนด์มาจาก BRAND_NAME เสมอ ไม่พิมพ์ตรง ๆ และไม่มีโดเมนในไฟล์นี้
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label={`รายการถอนล่าสุดของสมาชิก ${BRAND_NAME} เป็นข้อมูลตัวอย่างที่แสดงรูปแบบรายการ ควรตรวจสอบรายละเอียดจากบัญชีสมาชิกและประกาศล่าสุดอีกครั้ง`}
    class="relative border-r-4 border-l-4 border-[#bb6dff]/60 bg-[#190b3d]/95 px-4 py-8 shadow-[0_10px_30px_rgba(36,16,70,0.25)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div aria-hidden="true" class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#f23bb4] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#7aa7ff] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between gap-3 border-b border-[#5b2f9e] pb-4">
      <p class="text-xl font-black tracking-[0.2em] text-[#f3e8ff] drop-shadow-[0_0_8px_rgba(242,59,180,0.45)]">/// {BRAND_NAME} · รายการถอนล่าสุด</p>
      <span class="shrink-0 animate-pulse border border-[#bb6dff]/60 px-2 py-1 text-xs font-bold tracking-widest text-[#bb6dff]">ONLINE</span>
    </div>

    <div
      data-winners-feed
      data-interval={FEED_INTERVAL_MS}
      data-max-rows={FEED_MAX_ROWS}
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between border-l-2 border-[#f23bb4] bg-[#100626] bg-gradient-to-r from-[#f23bb4]/18 to-transparent p-3 transition-colors hover:bg-[#271257]">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 items-center justify-center border border-[#5b2f9e] ${row.bank.color}`}>
                  <span aria-hidden="true" class="text-sm leading-none text-[#f3e8ff]">
                    ✦
                  </span>
                </div>
                <div class="font-mono text-sm text-[#c0a6e8]">
                  USR_ID:{" "}
                  <span data-winner-user class="font-bold text-[#f3e8ff]">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <div
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`winner-status font-mono text-[10px] tracking-widest ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </div>
                <div class="font-mono text-xl font-black text-[#f23bb4] drop-shadow-[0_0_8px_rgba(242,59,180,0.4)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#c0a6e8]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(accentPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer
  // and leaves a parser-blocking script in the middle of the document. The bank
  // list arrives as inert JSON above instead, and this module is bundled and
