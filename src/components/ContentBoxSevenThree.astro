---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is a 7fr_3fr block, so the WIDE column is the left one and `title` is the
// shorthand for ITS heading. The narrow right column is the picture's, and the
// page passes it no `titleright`, so the block emits exactly one docx heading.
// The heading sits in normal flow, never `absolute`, so a title that wraps
// pushes the slot down instead of covering it — no badge arithmetic here. No
// `whitespace-nowrap` anywhere in this file.
//
// DRAWN WIDTH OF THE 3fr IMAGE COLUMN (the RIGHT one here), recomputed from the
// classes in THIS file for the `widths`/`sizes` index.astro passes. Tailwind sets
// box-sizing: border-box globally, so max-w-* caps the box INCLUDING padding and
// border. NOTE the cap here is on the <section>, so px-4 comes out OF the 1400:
//   section  max-w-[1400px] + px-4 (16x2=32)  -> card outer = min(100vw,1400) - 32
//   card     border (1x2=2) + p-8 (32x2=64) / md:p-10 (40x2=80)
//   grid     gap-8 (32, md+ only)
//   image column adds md:pl-6 (24). The md:border-r + md:pr-6 are on the TEXT
//   column, so they come out of ITS track, not the picture's.
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 1254 x 0.3 - 24 = 352px
//   md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   < md      : one column at p-8, no md:pl-6        = calc(100vw - 98px),
//               which exceeds the 600px bitmap above a 698px viewport, so the
//               page caps that band at 600px rather than asking for pixels the
//               source file does not have.
// These are DIFFERENT numbers from ContentBoxSevenThreePremium, the other image
// block on the same page — that one caps the SECTION at max-w-7xl, pays gap-10
// and md:pl-10 plus a 1px md:border-l on the image column, landing at 297px and
// calc(30vw - 87px) instead of 352px and calc(30vw - 68px). Change any
// padding/gap/border/cap here and the page's `sizes` has to move with it.
//
// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2-§4): กล่องนี้ถือ docx H3 §5 ("โปรโมชั่น แนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด") คู่กับ **slide2.png** ซึ่งพิมพ์คำว่า โปรโมชั่น / แนะนำเพื่อน
// / 0.8% ไว้ในตัวภาพเอง
// ⚠️ **รอบที่แล้วสลับกัน** (slide1 = แนะนำเพื่อน) — ตัวเลขที่พิมพ์อยู่บนงานอาร์ต
// เป็นตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์ (เปิดอ่านสไลด์ทั้งสองใบจริงก่อนเขียน alt แล้ว)
// slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์ก่อน **ห้าม import**
//
// รอบนี้เป็น **สองฮิวจริง: ทองนำ ชมพูบานเย็นรอง** — ทองแบรนด์ #fcd434 คือเลข 168
// สามมิติ เหรียญจีนทองรูสี่เหลี่ยมและทองแท่งจีน ส่วนชมพูบานเย็น #f5469f คือริบบิ้น
// ซาติน หัวใจ ดอกซากุระ และครึ่งล่างของตัวอักษร "มีโชค" พื้นเพจ **ดำสนิท #000000**
// ⚠️ ไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย #0b0509 คือก้นสุดที่ใช้ได้
//
// ใบนี้เป็นการ์ดมุมตัดใบที่สองของหน้า นั่งอยู่ที่ **ผิวยก #24101c** ซึ่งเป็นชั้น
// ตื้นที่สุดของทั้งสี่ชั้น ตื้นกว่าผิวจม #0b0509 ของ ContentBoxTwoCyberCut (§2) และ
// ของ ContentBox3ThreeCyberCut (§6) ที่ตามมาทันที
// §5 กับ §6 อยู่ติดกันจึงถูกแยกด้วยสี่อย่างพร้อมกัน: **ทิศของมุมตัด** (ใบนี้ตัด
// ซ้ายบน-ขวาล่าง · ใบนั้นตัดขวาบน-ซ้ายล่าง เป็นภาพกระจก) **ขนาดมุม** (36px vs 30px)
// **ความลึกของผิว** (ยก vs จม) และ **การจัดหัวข้อ** (ใบนี้เป็นตัวอักษรไล่เฉดพร้อม
// แถบตั้ง · ใบนั้นเป็นหัวข้อในแถบ header ที่มีเส้นคั่นใต้)
// กรอบเป็นชมพูบานเย็น #f5469f โปร่ง มีเส้นไรผมชมพูอ่อน #ff8dc6 พาดขอบบนหนึ่งพิกเซล
// (ริบบิ้นซาตินชมพูที่พาดโค้งอยู่หลังฉากในแบนเนอร์) ซ้ายบนเป็นออราพลัมเข้ม #8c0f52
// ที่อิ่มขึ้นเป็นชมพูบานเย็นตอน hover
// หัวข้อไล่ ชมพูอ่อน #ff8dc6 → ทองแบรนด์ #fcd434 → ชมพูบานเย็น #f5469f ซึ่งเป็น
// ลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ แถบตั้งนำหน้าไล่ ทองแบรนด์ #fcd434 →
// ชมพูบานเย็น #f5469f → พลัมเข้ม #8c0f52 และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่ลูกของ
// มัน (เพราะ bg-clip-text ของหัวข้อจะชนกับพื้นของแถบถ้าซ้อนกัน)
// เส้นคั่นคอลัมน์เป็นพลัมเข้ม #8c0f52 เนื้อความ #f6e4ee (= BRAND_TEXT) — 14.9:1 บน
// ผิวยก
// §2 ห้าม #8c0f52 #7a5508 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ในไล่เฉดของ
// แถบ เส้นคั่น ขอบ และออราเท่านั้น · #ffeaa0 สงวนไว้ให้ <strong> ในย่อหน้าตาม §2
// จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** แบรนด์รอบก่อนหน้า
// ทันที (ขวัญใจ168) ก็เป็นทองนำบนดำสนิทเหมือนกัน ทองของมันคือ f7c92b ส่วนรอบนี้คือ
// fcd434 ชุดเต็มของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06 241509 160d06 0b0603) ไม่เหลือที่นี่ ชุดแดงมังกร-โครเมียมขาวของ
// GT66B ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609
// 3b0405 fdfcfd b4bcc2 eceaea 1c0c0b 130c0c 0b0303) ชุดของ TKB55 (fb131b ff8a8f
// ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a 1a0304)
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e 041a43) ชุดทองมังกรของ
// TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b 120c04 070502) ชุดทองอำพันเสือ
// ของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214 4a2a08 2d1c0a 1c1206
// 0f0903) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffd94a) ชุดทอง
// แชมเปี้ยน-เงินโครเมียมของ UFA324 (e5a81b b9c2cc 464f5a) ชุดมรกต-ทองของ KOON234
// (cc920a 2fbf6a) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (fbc134 cfd6e3 eef2f8) และ
// ชุดทองเมทัลลิก-บรอนซ์ของ 789BETTING (fad354 ddab33 b5a888) ออกครบทุกค่าแล้ว
// ⚠️ **ชมพูของรอบนี้คือ #f5469f / #ff8dc6 ไม่ใช่ f41571 / ff5ca8 ของ PUNPRO168**
// ซึ่งเป็นชมพูฮอตพิงก์เหมือนกันแต่คนละค่า — เทียบทีละหลัก ห้ามกะด้วยตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดง**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full border border-[#f5469f]/55 bg-[#24101c]/96 p-8 text-[#f6e4ee] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff8dc6]/60 hover:shadow-[0_15px_40px_rgba(245,70,159,0.30)] md:p-10"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ff8dc6]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#8c0f52]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#f5469f]/40">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#8c0f52] pb-6 text-left text-base leading-relaxed text-[#f6e4ee] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcd434] via-[#f5469f] to-[#8c0f52] shadow-[0_0_10px_rgba(245,70,159,0.6)]" />
              <HeadingTag class="min-w-0 bg-gradient-to-r from-[#ff8dc6] via-[#fcd434] to-[#f5469f] bg-clip-text text-2xl leading-normal font-black tracking-wider text-transparent uppercase">
                {leftHeading}
              </HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e4ee] md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#ff8dc6] via-[#fcd434] to-[#f5469f] bg-clip-text text-center text-2xl leading-normal font-black tracking-wider text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
