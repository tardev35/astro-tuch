---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): คู่กับ
// ContentBoxSevenThreeNeumorphism ที่เป็นแผ่นนูนหัวข้อแดงสว่างในหน้าเดียวกัน ใบนี้
// กลับด้านกัน — การ์ดโปร่งเกือบดำ #16090a ในกรอบแดงแบรนด์ #de161d ของคำว่า GAME
// บนโลโก้ มีเส้นเงินโครเมียมพาดขอบบน หัวข้อฝั่งขวาเป็นเงินโครเมียม #e2e8ef ทึบ
// ไม่ไล่เฉด และมีแถบเงิน-แดงตั้งนำหน้า คนละจังหวะสายตากับใบแรกทั้งที่อยู่ในพาเลตต์
// เดียวกัน — ทองชุด 365LOTTO (#fadc64 #fdf3b4 #9c6a12) แดงเก่า #e01f26 พื้น
// #120406 และครีม #f0ddc4 ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#de161d]/50 bg-[#16090a]/94 p-8 text-[#e8e3e1] shadow-[0_10px_30px_rgba(8,5,6,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2e8ef]/55 hover:shadow-[0_15px_40px_rgba(222,22,29,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#e2e8ef]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#de161d]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e8ef]/20">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#7a0a0e]/60 pb-6 text-left text-base leading-relaxed text-[#e8e3e1] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#e2e8ef] uppercase drop-shadow-[0_2px_10px_rgba(222,22,29,0.45)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8e3e1] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black text-[#e2e8ef] uppercase drop-shadow-[0_0_8px_rgba(226,232,239,0.3)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e2e8ef] via-[#9ba3ad] to-[#de161d] shadow-[0_0_10px_rgba(226,232,239,0.5)]" />
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
