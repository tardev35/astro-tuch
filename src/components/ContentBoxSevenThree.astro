---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม-ดำ 2026-09-25): คู่กับ ContentBoxSevenThreePremium
// ที่ไล่เฉดหัวข้อทองในหน้าเดียวกัน ใบนี้กลับด้านกัน — การ์ดโปร่งเกือบดำ #14100a ใน
// กรอบทองแบรนด์ #d9a62b มีเส้นเงินโครเมียม #d2d3d4 พาดขอบบนเป็นเส้นผมหนึ่งพิกเซล
// หัวข้อฝั่งขวาเป็นเงินโครเมียม #d2d3d4 ทึบ ไม่ไล่เฉด และมีแถบตั้งเงิน→ทองนำหน้า
// (เรียงตามโลโก้สองโลหะ MI ทอง / RACLE เงิน / 55 ทอง) คนละจังหวะสายตากับใบแรก
// ทั้งที่อยู่ในพาเลตต์เดียวกัน เนื้อความ #e8e6e1 (BRAND_TEXT) — แดงชุด MAHAGAME66
// (#de161d #ff4d52 #7a0a0e #e2e8ef #9ba3ad) พื้น #16090a และเนื้อความ #e8e3e1
// ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d9a62b]/50 bg-[#14100a]/94 p-8 text-[#e8e6e1] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#d2d3d4]/55 hover:shadow-[0_15px_40px_rgba(252,218,101,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#d2d3d4]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d9a62b]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#d2d3d4]/20">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#8c5f14]/60 pb-6 text-left text-base leading-relaxed text-[#e8e6e1] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#d2d3d4] uppercase drop-shadow-[0_2px_10px_rgba(252,218,101,0.45)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8e6e1] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black text-[#d2d3d4] uppercase drop-shadow-[0_0_8px_rgba(210,211,212,0.35)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcfcfc] via-[#a8acb1] to-[#d9a62b] shadow-[0_0_10px_rgba(210,211,212,0.5)]" />
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
