---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is a 7fr_3fr block, so the WIDE column is the left one and `title` is the
// shorthand for ITS heading. The narrow right column is the picture's, and the
// page passes it no `titleright`, so the block emits exactly one docx heading.
// The heading sits in normal flow, never `absolute`, so a title that wraps
// pushes the slot down instead of covering it — no badge arithmetic here. No
// `whitespace-nowrap` anywhere in this file.
//
// DRAWN WIDTH OF THE 3fr IMAGE COLUMN (the RIGHT one here), recomputed from the
// classes in THIS file for the `widths`/`sizes` index.astro passes. Tailwind sets
// box-sizing: border-box globally, so max-w-* caps the box INCLUDING padding and
// border. NOTE the cap here is on the <section>, so px-4 comes out OF the 1400:
//   section  max-w-[1400px] + px-4 (16x2=32)  -> card outer = min(100vw,1400) - 32
//   card     border (1x2=2) + p-8 (32x2=64) / md:p-10 (40x2=80)
//   grid     gap-8 (32, md+ only)
//   image column adds md:pl-6 (24). The md:border-r + md:pr-6 are on the TEXT
//   column, so they come out of ITS track, not the picture's.
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 1254 x 0.3 - 24 = 352px
//   md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   < md      : one column at p-8, no md:pl-6        = calc(100vw - 98px),
//               which exceeds the 600px bitmap above a 698px viewport, so the
//               page caps that band at 600px rather than asking for pixels the
//               source file does not have.
// These are DIFFERENT numbers from ContentBoxSevenThreePremium, the other image
// block on the same page — that one caps the SECTION at max-w-7xl, pays gap-10
// and md:pl-10 plus a 1px md:border-l on the image column, landing at 297px and
// calc(30vw - 87px) instead of 352px and calc(30vw - 68px). Change any
// padding/gap/border/cap here and the page's `sizes` has to move with it.
// ⚠️ สไลด์ของดรอปนี้เป็น **จัตุรัส 600×600** เพดาน max-w-[600px] จึงเป็นพิกเซลจริง
// พอดี ไม่ใช่การอัปสเกล
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2-§5): กล่องนี้ถือ docx H3 §4
// ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ **slide1.png** ซึ่งพิมพ์คำว่า
// โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้ในตัวภาพเอง
// ⚠️ **ตัวเลขที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** (เปิดอ่าน
// สไลด์ทั้งสองใบจริงด้วย Read ก่อนเขียน alt แล้ว รอบนี้ slide1 = 0.3% และ slide2 =
// 0.8% ซึ่งสลับทางจากดรอปก่อน) slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์
// ก่อน **ห้าม import** เพราะ eager import = emit ลง dist/ ต่อให้ไม่ render
//
// รอบนี้เป็น **สองฮิวจริง: ฟ้านำ ทองรอง** — ฟ้าอะซัวร์ #039cfa คือตัวอักษร "แทร่168"
// บนโลโก้ ถุงเงินสลักดอลลาร์ ปึกธนบัตร มือถือจอฟ้า หัวใจฟ้า โบว์ซาตินฟ้า และกล่อง
// ของขวัญผูกโบว์ฟ้า ส่วนทองอำพัน #f9a826 คือคำว่า "รวย" บนโลโก้ มงกุฎเหนือคำว่า
// โปรโมชั่น กองเหรียญทอง และประกายดาว พื้นเพจ **ดำสนิท #000000**
// ⚠️ ไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย #030f1d คือก้นสุดที่ใช้ได้
//
// ใบนี้เป็น **การ์ดมุมตัดใบเดียวของหน้า** นั่งอยู่ที่ **ผิวยก #0b2d52** ซึ่งเป็นชั้น
// ตื้นที่สุดของทั้งสี่ชั้น ตื้นกว่า §5 ที่ตามมาทันทีและไล่จากผิวยกลงผิวกลาง #071e38
// §4 กับ §5 อยู่ติดกันจึงถูกแยกด้วยสี่อย่างพร้อมกัน: **การมีมุมตัด** (ใบนี้ตัด
// ซ้ายบน-ขวาล่าง 36px · ใบนั้นเป็น rounded-3xl ไม่มี clip-path) **ผิวทึบ vs ไล่เฉด**
// **การจัดหัวข้อ** (ใบนี้เป็นตัวอักษรไล่เฉดพร้อมแถบตั้งนำหน้า · ใบนั้นไม่มีแถบ) และ
// **ลำดับไล่เฉด** (ทอง→ฟ้าน้ำแข็ง→ฟ้า vs ฟ้า→ทอง→ฟ้าน้ำแข็ง)
// กรอบเป็นฟ้าอะซัวร์ #039cfa โปร่ง มีเส้นไรผมฟ้าน้ำแข็ง #c3ebfc พาดขอบบนหนึ่งพิกเซล
// (เส้นแสงฟ้าที่พาดอยู่หลังฉากในงานอาร์ต) ซ้ายบนเป็นออราน้ำเงินลึก #04366b ที่อิ่มขึ้น
// เป็นฟ้าอะซัวร์ตอน hover
// หัวข้อไล่ ทองอำพัน #f9a826 → ฟ้าน้ำแข็ง #c3ebfc → ฟ้าอะซัวร์ #039cfa ซึ่งเป็นลำดับ
// ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ ⚠️ bg-clip-text = พิกเซลของตัวอักษร ทุก
// สต็อปจึงต้องถือตัวอักษรได้ตาม §2 (6.9 / 10.8 / 4.6 ที่ text-2xl font-black =
// large text)
// แถบตั้งนำหน้าไล่ ฟ้าอะซัวร์ #039cfa → ทองอำพัน #f9a826 → น้ำเงินลึก #04366b และ
// เป็น **พี่น้อง** ของหัวข้อ ไม่ใช่ลูกของมัน (เพราะ bg-clip-text ของหัวข้อจะชนกับพื้น
// ของแถบถ้าซ้อนกัน) — แถบเป็น **พื้น** ไม่ใช่ตัวอักษร #04366b จึงอยู่ในนั้นได้
// เส้นคั่นคอลัมน์เป็นน้ำเงินลึก #04366b เนื้อความ #e3f2fc (= BRAND_TEXT) — 11.9:1
// บนผิวยก
// §2 ห้าม #04366b #704504 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ในไล่เฉดของ
// แถบ เส้นคั่น ขอบ และออราเท่านั้น · #f9a826 สงวนไว้ให้ <strong> ในย่อหน้าตาม §2
// จึงโผล่ที่นี่แค่ในไล่เฉดของหัวข้อกับแถบ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// แบรนด์รอบก่อนหน้าทันที (นินจา168) เป็นฟ้าไซยาน 32bcfb นำ + เหลืองมะนาว fef54b รอง
// และก่อนหน้านั้น (สบายเบท168) เป็นฟ้า 2f9ff5 + ทอง ffc82e ส่วนรอบนี้คือ **#039cfa +
// #f9a826** ต่างกันทุกหลัก
// ชุดเต็มของสบายเบท168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (2f9ff5 a8dcff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16 และ rgba 47/159/245) ชุดของนินจา168 (32bcfb
// a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของถอนชัวร์168
// (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทอง-
// ชมพูบานเย็นของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee
// 24101c 160a12 0b0509) ชุดเต็มของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b
// 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดแดงมังกร-โครเมียมขาวของ GT66B
// (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea 1c0c0b
// 130c0c 0b0303) ชุดของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f
// 1a0708 0d0304 c40304 8a0206 53050a 1a0304) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3
// 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f) ชุดทอง
// มังกรของ TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b 120c04 070502) ชุดทอง
// อำพันเสือของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214 4a2a08 2d1c0a
// 1c1206 0f0903) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffd94a)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (e5a81b b9c2cc 464f5a) ชุดมรกต-ทองของ
// KOON234 (cc920a 2fbf6a) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (fbc134 cfd6e3 eef2f8)
// และชุดทองเมทัลลิก-บรอนซ์ของ 789BETTING (fad354 ddab33 b5a888) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full border border-[#039cfa]/55 bg-[#0b2d52]/96 p-8 text-[#e3f2fc] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#c3ebfc]/60 hover:shadow-[0_15px_40px_rgba(3,156,250,0.30)] md:p-10"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c3ebfc]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#04366b]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#039cfa]/45">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#04366b] pb-6 text-left text-base leading-relaxed text-[#e3f2fc] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#039cfa] via-[#f9a826] to-[#04366b] shadow-[0_0_10px_rgba(3,156,250,0.6)]" />
              <HeadingTag class="min-w-0 bg-gradient-to-r from-[#f9a826] via-[#c3ebfc] to-[#039cfa] bg-clip-text text-2xl leading-normal font-black tracking-wider text-transparent uppercase">
                {leftHeading}
              </HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e3f2fc] md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f9a826] via-[#c3ebfc] to-[#039cfa] bg-clip-text text-center text-2xl leading-normal font-black tracking-wider text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
