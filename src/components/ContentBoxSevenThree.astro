---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// This is the COIN-GOLD half of the promo pair — ContentBoxSevenThreePremium
// runs the same image+text shape in emerald. Keeping them on different halves of
// the UVO88 logo (the gold 88 vs. the green chip) is what stops two stacked
// promo sections reading as one duplicated card.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#9c7d2b]/55 bg-[#051a0e]/88 p-8 text-[#c8e3d0] shadow-[0_10px_30px_rgba(2,13,7,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2c230]/70 hover:shadow-[0_15px_40px_rgba(242,194,48,0.22)] md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#9c7d2b]/50 pb-6 text-left text-base font-medium text-[#c8e3d0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-4xl leading-normal font-black tracking-wider text-[#f2c230] uppercase drop-shadow-[0_2px_10px_rgba(242,194,48,0.32)] md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#c8e3d0] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-2 bg-gradient-to-r from-[#ffe08a] via-[#f2c230] to-[#9c7d2b] bg-clip-text text-2xl leading-normal font-black text-transparent drop-shadow-[0_0_8px_rgba(242,194,48,0.4)]">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
