---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns
// render <h2> — this box only ever carries docx article headings.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#123a7e]/50 bg-[#010514]/85 p-8 text-[#cfdcf2] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#2f7bf6]/60 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#0a2d6d]/60 pb-6 text-left text-base font-medium text-[#7db4ff] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <h2 class="text-center text-4xl leading-normal font-black tracking-wider text-[#e6edf7] uppercase drop-shadow-[0_2px_10px_rgba(230,237,247,0.25)] md:text-left">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfdcf2] md:pl-6">
        {rightHeading && <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-[#2f7bf6] drop-shadow-[0_0_8px_rgba(47,123,246,0.35)]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
