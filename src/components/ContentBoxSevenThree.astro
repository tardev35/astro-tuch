---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is a 7fr_3fr block, so the WIDE column is the left one and `title` is the
// shorthand for ITS heading. The narrow right column is the picture's, and the
// page passes it no `titleright`, so the block emits exactly one docx heading.
// The heading sits in normal flow, never `absolute`, so a title that wraps
// pushes the slot down instead of covering it — no badge arithmetic here. No
// `whitespace-nowrap` anywhere in this file.
//
// DRAWN WIDTH OF THE 3fr IMAGE COLUMN (the RIGHT one here), recomputed from the
// classes in this file for the `widths`/`sizes` the page passes. Tailwind sets
// box-sizing: border-box globally, so max-w-* caps the box INCLUDING padding and
// border:
//   section  max-w-[1400px] + px-4 (16x2=32)  -> card outer = min(100vw,1400) - 32
//   card     border (1x2=2) + p-8 (32x2=64) / md:p-10 (40x2=80)
//   grid     gap-8 (32, md+ only)
//   image column adds md:pl-6 (24). The md:border-r + md:pr-6 are on the TEXT
//   column, so they come out of ITS track, not the picture's.
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 1254 x 0.3 - 24 = 352px
//   md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   < md      : one column at p-8, no md:pl-6        = calc(100vw - 98px),
//               which exceeds the 600px bitmap above a 698px viewport, so the
//               page caps that band at 600px rather than asking for pixels the
//               source file does not have.
// Change any padding/gap/border/cap here and the page's `sizes` has to move
// with it.
//
// FAH999 (รอบชมพูฮอต-ทอง บนพลัมดำ 2026-10-11, brand-spec §2-§4):
// กล่องนี้ถือ docx H3 #5 ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ slide2
// ซึ่งพิมพ์คำว่า โปรโมชั่น กับ แนะนำเพื่อน โบนัส 0.8% ไว้ในตัวภาพเอง — ตัวเลขที่พิมพ์
// อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์
//
// ใบนี้เป็นใบที่ "จม" ที่สุดในหน้า — ผิวลึกสุด #210220 ซึ่งลึกกว่าพื้นเพจพลัมดำ
// #2e002c เอง จึงอ่านว่ายุบลงไปในหน้า (รอบนี้ทำได้ เพราะพื้นเพจไม่ใช่ดำสนิทแบบรอบก่อน)
// ตรงข้ามกับ ContentBoxPremium (ไล่ผิวยก #4a0b42 → ผิวกลาง) และ ContentBox (ผิวยกทึบ)
// ที่ลอยขึ้นมา ส่วน ContentBoxTwoCyberCut อยู่ที่ผิวกลาง #3a0534 ตรงกลางระหว่างสองขั้ว
// กรอบเป็นชมพูแบรนด์ #ff3fa4 โปร่ง มีเส้นไรผมทองสว่าง #ffe49a พาดขอบบนหนึ่งพิกเซล
// (ขอบมงกุฎทองในงานอาร์ต) ซ้ายบนเป็นออราชมพูเข้ม #7a0046 ที่อิ่มขึ้นเป็นชมพูลึก
// #b3006a ตอน hover
// หัวข้อฝั่งซ้ายเป็นชมพูซีด #ffd1ea ทึบ ไม่ไล่เฉด และมีแถบตั้งไล่ "ทองสว่าง #ffe49a →
// ชมพูแบรนด์ #ff3fa4 → ชมพูเข้ม #7a0046" นำหน้า ซึ่งเป็นแถบเดียวในหน้าที่เริ่มจากทอง
// แล้วไหลลงชมพู (ของ ContentBoxPremium เริ่มจากชมพูซีด)
// เส้นคั่นคอลัมน์เป็นชมพูเข้มสุด #4d002b เนื้อความ #fde8f3 (= BRAND_TEXT) — 16.5:1 บน
// ผิวลึกสุด
// §2 ห้าม #b3006a #7a0046 #4d002b และ #9c6f08 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสี่อยู่
// ในไล่เฉดของแถบ เส้นคั่น และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดมรกต-ทองของ KOON234 ที่เคยค้างในไฟล์นี้
// (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #0d2414 #e8f2e6) ชุดทองอวกาศ-เงิน
// โครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3
// #3f4859 #fdf3df #382400 #241700 #231500) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34
// #fde464 #c8901a #f58b2a #f6ecd9) และชุดชมพู-ม่วงของ BPLAY639 (#f472b6 #fbcfe8
// #e9d5f5 #7e22ce #14061f) ออกครบทุกจุดแล้ว — ⚠️ BPLAY639 ก็ชมพู "มีชมพูอยู่แล้ว"
// จึงไม่พิสูจน์อะไร และ #f5c518 ของ GOT777 ต่างจาก #f5c53d ของรอบนี้แค่สองตัวอักษร
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ff3fa4]/55 bg-[#210220]/94 p-8 text-[#fde8f3] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd1ea]/60 hover:shadow-[0_15px_40px_rgba(255,63,164,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ffe49a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#7a0046]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#b3006a]/40">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#4d002b] pb-6 text-left text-base leading-relaxed text-[#fde8f3] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black tracking-wider text-[#ffd1ea] uppercase drop-shadow-[0_2px_10px_rgba(255,63,164,0.45)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe49a] via-[#ff3fa4] to-[#7a0046] shadow-[0_0_10px_rgba(255,63,164,0.6)]" />
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fde8f3] md:pl-6">
        {
          titleright && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#ffd1ea] uppercase drop-shadow-[0_0_8px_rgba(255,63,164,0.45)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
