---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// This is the METALLIC-GOLD half of the promo pair — ContentBoxSevenThreePremium
// runs the same image+text shape in chrome silver. Keeping the two promo blocks
// on different halves of the OCZPLUS logo (the gold PLUS vs. the silver OCZ) is
// what stops two stacked promo sections reading as one duplicated card.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a6b2c]/60 bg-[#071a36]/90 p-8 text-[#ccd6e6] shadow-[0_10px_30px_rgba(2,16,31,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9b45e]/75 hover:shadow-[0_15px_40px_rgba(217,180,94,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d9b45e]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#f2dc9a]/32">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#8a6b2c]/55 pb-6 text-left text-base leading-relaxed text-[#ccd6e6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#e4c67f] uppercase drop-shadow-[0_2px_10px_rgba(217,180,94,0.30)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ccd6e6] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-2 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] bg-clip-text text-2xl leading-normal font-black text-transparent drop-shadow-[0_0_8px_rgba(217,180,94,0.35)]">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
