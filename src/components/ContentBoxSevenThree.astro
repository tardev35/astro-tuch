---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is the 7fr_3fr half of the pair, so the WIDE column is the left one and
// `title` is the shorthand for ITS heading — the mirror image of
// ContentBoxSevenThreePremium, where `title` lands in the wide right column.
// That is what lets the two blocks put their picture on opposite edges while
// each keeps its heading in the text column. This box only ever carries docx
// article headings; the narrow image column is passed no `titleright`, so the
// block emits exactly one docx heading. No `whitespace-nowrap` anywhere.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): คู่กับ ContentBoxSevenThreePremium ที่ไล่เฉดการ์ด
// ในหน้าเดียวกัน ใบนี้กลับด้านกันทั้งเลย์เอาต์และผิว — การ์ดทึบผิวการ์ด #140c02 ในกรอบ
// ทองแบรนด์ #e4b34d มีเส้นแชมเปญ #fdf2ac พาดขอบบนเป็นเส้นผมหนึ่งพิกเซล หัวข้อฝั่งซ้าย
// เป็นแชมเปญ #fdf2ac ทึบ ไม่ไล่เฉด และมีแถบตั้งไล่ทองนำหน้า (แบรนด์นี้เป็นทองล้วน
// ไม่มีสีคู่ตรงข้าม ความต่างมาจากระดับความสว่างของทองเท่านั้น) คนละจังหวะสายตากับใบแรก
// ทั้งที่อยู่ในพาเลตต์เดียวกัน เนื้อความ #f3e8cf (BRAND_TEXT) — ชุดชมพูนีออน-ม่วงของ
// SEXYGAME666 ที่ค้างในไฟล์นี้ (#8b3df3 #c9a4ff #ddc3ff #fa42b5 #140722 #4a0e33 #f2dcee)
// และชุดทองเมทัลลิก-โครเมียมของ PKG44 (#c8920a #fdd32a #c2c8d0 #f2f4f7 #8a9099 #4a3a12
// #12100a #efe6d2) ออกทั้งหมด
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e4b34d]/55 bg-[#140c02]/94 p-8 text-[#f3e8cf] shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdf2ac]/60 hover:shadow-[0_15px_40px_rgba(228,179,77,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fdf2ac]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e4b34d]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf2ac]/22">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#8a5f12]/80 pb-6 text-left text-base leading-relaxed text-[#f3e8cf] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black tracking-wider text-[#fdf2ac] uppercase drop-shadow-[0_2px_10px_rgba(228,179,77,0.45)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] shadow-[0_0_10px_rgba(228,179,77,0.6)]" />
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e8cf] md:pl-6">
        {
          titleright && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#fdf2ac] uppercase drop-shadow-[0_0_8px_rgba(192,143,43,0.45)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
