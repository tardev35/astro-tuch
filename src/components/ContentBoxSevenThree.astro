---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is a 7fr_3fr block, so the WIDE column is the left one and `title` is the
// shorthand for ITS heading. The narrow right column is the picture's, and the
// page passes it no `titleright`, so the block emits exactly one docx heading.
// The heading sits in normal flow, never `absolute`, so a title that wraps
// pushes the slot down instead of covering it — no badge arithmetic here. No
// `whitespace-nowrap` anywhere in this file.
//
// DRAWN WIDTH OF THE 3fr IMAGE COLUMN (the RIGHT one here), recomputed from the
// classes in this file for the `widths`/`sizes` the page passes. Tailwind sets
// box-sizing: border-box globally, so max-w-* caps the box INCLUDING padding and
// border:
//   section  max-w-[1400px] + px-4 (16x2=32)  -> card outer = min(100vw,1400) - 32
//   card     border (1x2=2) + p-8 (32x2=64) / md:p-10 (40x2=80)
//   grid     gap-8 (32, md+ only)
//   image column adds md:pl-6 (24). The md:border-r + md:pr-6 are on the TEXT
//   column, so they come out of ITS track, not the picture's.
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 1254 x 0.3 - 24 = 352px
//   md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   < md      : one column at p-8, no md:pl-6        = calc(100vw - 98px),
//               which exceeds the 600px bitmap above a 698px viewport, so the
//               page caps that band at 600px rather than asking for pixels the
//               source file does not have.
// Change any padding/gap/border/cap here and the page's `sizes` has to move
// with it.
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม 2026-10-10, brand-spec §2-§4):
// กล่องนี้ถือ docx H3 #4 ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ slide1
// ซึ่งพิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย กับเลข 0.3% ตัวทองขนาดใหญ่ไว้ในตัวภาพเอง
// (⚠️ คู่สไลด์กลับด้านจากรอบก่อน — รอบก่อน slide2 คือ 0.3% รอบนี้ slide1 คือ 0.3%
// ตัวเลขที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสิน ไม่ใช่ลำดับไฟล์)
//
// ใบนี้เป็นใบที่ "จม" ที่สุดในหน้า — ผิวลึกสุด #241700 ซึ่งลึกกว่าพื้นเพจ #382400 เอง
// จึงอ่านว่ายุบลงไปในหน้า ตรงข้ามกับ ContentBoxPremium (ไล่ผิวยก #4e3406 → ผิวเพจ)
// และ ContentBox (ผิวยกทึบ) ที่ลอยขึ้นมา ส่วน ContentBoxTwoCyberCut อยู่ที่ผิวกลาง
// #432b03 ตรงกลางระหว่างสองขั้ว
// กรอบเป็นทองกลางเข้ม #cf9a18 ซึ่งเป็นทองเฉดเดียวในชุดที่ยังรองหมึก #231500 ได้ (7.0:1)
// มีเส้นไรผมทองสว่าง #ffe87a พาดขอบบนหนึ่งพิกเซล — ซ้ายบนเป็นออราเงินลึก #3f4859
// (หมวกนักบินในเงา) ที่อิ่มขึ้นเป็นโครเมียม #cfd6e3 ตอน hover ซึ่งเป็นใบเดียวในหน้าที่
// ออราหลักเป็นเงินล้วน ไม่ใช่ทอง
// หัวข้อฝั่งซ้ายเป็นทองสว่าง #ffe87a ทึบ ไม่ไล่เฉด และมีแถบตั้งไล่ "โครเมียมสว่าง
// #eef2f8 → ทองแบรนด์ #fbc134 → ทองลึก #96690a" นำหน้า ซึ่งเป็นแถบเดียวในหน้าที่
// เริ่มจากเงินแล้วไหลลงทอง (ของ ContentBoxPremium เริ่มจากทองสว่าง)
// เส้นคั่นคอลัมน์เป็นทองลึกสุด #6b4a05 เนื้อความ #fdf3df (= BRAND_TEXT) — 16.0:1 บน
// ผิวลึกสุด
// §2 ห้าม #96690a #6b4a05 และ #3f4859 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสามอยู่ใน
// ไล่เฉดของแถบ เส้นคั่น และออราเท่านั้น
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดมรกต-ทองของ KOON234 ที่เคยค้างในไฟล์นี้ (#0a6b32 #2fbf6a #043d1c
// #cc920a #f7d14e #fde9a6 #0d2414 #e8f2e6 rgba(204,146,10,α)) ชุดทองเมทัลลิก-เงิน
// โครเมียมของ UOK365 (#c8912f #f5d98a #d8dbe0 #a46b25 #6d4412 #191108 #ece1cc) และ
// ชุดทอง-ดำของ NAZA99 ก่อนหน้านั้น (#e4b34d #fdf2ac #140c02 #8a5f12 #f3e8cf) ออกครบ
// ทุกจุดแล้ว — NAZA99 เป็นชื่อที่ใกล้ NAZA168 มากและก็เป็นทองเหมือนกัน แต่เป็นคนละ
// แบรนด์และคนละค่าสีทุกตัว
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#cf9a18]/55 bg-[#241700]/94 p-8 text-[#fdf3df] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe87a]/60 hover:shadow-[0_15px_40px_rgba(251,193,52,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#ffe87a]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#3f4859]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#cfd6e3]/25">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#6b4a05] pb-6 text-left text-base leading-relaxed text-[#fdf3df] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black tracking-wider text-[#ffe87a] uppercase drop-shadow-[0_2px_10px_rgba(251,193,52,0.45)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef2f8] via-[#fbc134] to-[#96690a] shadow-[0_0_10px_rgba(251,193,52,0.6)]" />
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fdf3df] md:pl-6">
        {
          titleright && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#ffe87a] uppercase drop-shadow-[0_0_8px_rgba(251,193,52,0.45)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
