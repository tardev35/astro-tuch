---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): คู่กับ ContentBoxSevenThreeHuay
// ที่เป็นการ์ดแดงเกือบดำในกรอบทองพร้อมหัวข้อไล่เฉด ใบนี้กลับด้านกัน — พื้นเพจแดง
// เกือบดำ #120406 ในกรอบแดงสด #e01f26 ของวง O บนโลโก้ มีเส้นทองพาดขอบบน หัวข้อ
// ฝั่งขวาเป็นทองหลักทึบ #fadc64 ไม่ไล่เฉด และมีแถบทองตั้งนำหน้า คนละจังหวะสายตา
// กับใบแรกทั้งที่อยู่ในพาเลตต์เดียวกัน — ทองชุด HENG35 (#ecc55c #fefac4 #ffdf8a
// #a3732c) และพื้น #12100b/#ece1cb ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e01f26]/50 bg-[#120406]/94 p-8 text-[#f0ddc4] shadow-[0_10px_30px_rgba(18,4,6,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadc64]/70 hover:shadow-[0_15px_40px_rgba(224,31,38,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fadc64]/85 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e01f26]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fadc64]/28">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#9c6a12]/55 pb-6 text-left text-base leading-relaxed text-[#f0ddc4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#fadc64] uppercase drop-shadow-[0_2px_10px_rgba(224,31,38,0.45)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0ddc4] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black text-[#fadc64] uppercase drop-shadow-[0_0_8px_rgba(250,220,100,0.35)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3b4] via-[#fadc64] to-[#e01f26] shadow-[0_0_10px_rgba(250,220,100,0.6)]" />
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
