---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): คู่กับ ContentBoxSevenThreePremium
// ที่ไล่เฉดหัวข้อทองในหน้าเดียวกัน ใบนี้กลับด้านกัน — การ์ดโปร่งเกือบดำ #12100a ใน
// กรอบทองลึก #c8920a มีเส้นเงินโครเมียม #c2c8d0 พาดขอบบนเป็นเส้นผมหนึ่งพิกเซล
// หัวข้อฝั่งขวาเป็นเงินโครเมียม #c2c8d0 ทึบ ไม่ไล่เฉด และมีแถบตั้งเงิน→ทองนำหน้า
// (เรียงตามโลโก้สองโลหะ P ทอง / K เงิน / G44 ทอง) คนละจังหวะสายตากับใบแรกทั้งที่อยู่
// ในพาเลตต์เดียวกัน เนื้อความ #efe6d2 (BRAND_TEXT) — ทอง-โครเมียมของ MIRACLE55
// (#fcda65 #fee47b #d9a62b #fcfcfc #d2d3d4 #a8acb1 #8c5f14 #14100a #050403
// #e8e6e1) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c8920a]/50 bg-[#12100a]/94 p-8 text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#c2c8d0]/55 hover:shadow-[0_15px_40px_rgba(253,211,42,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c2c8d0]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c8920a]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#c2c8d0]/20">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#4a3a12]/60 pb-6 text-left text-base leading-relaxed text-[#efe6d2] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#c2c8d0] uppercase drop-shadow-[0_2px_10px_rgba(253,211,42,0.45)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#efe6d2] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black text-[#c2c8d0] uppercase drop-shadow-[0_0_8px_rgba(194,200,208,0.35)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2f4f7] via-[#8a9099] to-[#c8920a] shadow-[0_0_10px_rgba(194,200,208,0.5)]" />
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
