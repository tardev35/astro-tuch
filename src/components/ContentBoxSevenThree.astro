---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// This is the CHROME-WHITE half of the promo pair — ContentBoxSevenThreePremium
// runs the same image+text shape in emerald. Keeping them on different halves of
// the TTN69 logo (snow cap vs. emerald ridge) is what stops two stacked promo
// sections reading as one duplicated card.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#046b3a]/60 bg-[#061309]/88 p-8 text-[#d5e6da] shadow-[0_10px_30px_rgba(2,8,5,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4ece7]/60 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#046b3a]/55 pb-6 text-left text-base font-medium text-[#d5e6da] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-4xl leading-normal font-black tracking-wider text-[#e4ece7] uppercase drop-shadow-[0_2px_10px_rgba(228,236,231,0.32)] md:text-left">{titleleft}</HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e6da] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-2 text-2xl leading-normal font-black text-[#e4ece7] drop-shadow-[0_0_8px_rgba(2,185,97,0.55)]">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
