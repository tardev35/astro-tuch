---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// This is the 7fr_3fr half of the pair, so the WIDE column is the left one and
// `title` is the shorthand for ITS heading — the mirror image of
// ContentBoxSevenThreeCyberCut, where `title` lands in the wide right column.
// That is what lets the two blocks put their picture on opposite edges while
// each keeps its heading in the text column. This box only ever carries docx
// article headings; the narrow image column is passed no `titleright`, so the
// block emits exactly one docx heading. No `whitespace-nowrap` anywhere.
//
// Drawn width of the 3fr image column (the RIGHT one here), for the
// `widths`/`sizes` the page passes — section max-w-[1400px] + px-4, card border
// 1px x2, p-8 / md:p-10, grid gap-8, and the image column adds md:pl-6 (24px):
//   >= 1400px : (1400 - 32 - 2 - 80 - 32) x 0.3 - 24 = 376.2 - 24 -> 352px
//   md..1399  : (100vw - 146) x 0.3 - 24             = calc(30vw - 68px)
//   < md      : one column at p-8, no pl-6           = calc(100vw - 98px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2):
// คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน ใบนี้กลับด้านกัน
// ทั้งเลย์เอาต์ ผิว และรูปทรง — การ์ดโค้งผิวยก #0d2414 ในกรอบทองแบรนด์ #cc920a มีเส้น
// ทองซีด #fde9a6 พาดขอบบนเป็นเส้นผมหนึ่งพิกเซล ส่วนใบมุมตัดเป็นผิวลึก #051007
// หัวข้อฝั่งซ้ายของใบนี้เป็นทองสว่าง #f7d14e ทึบ ไม่ไล่เฉด และมีแถบตั้งไล่ "ทองซีด →
// ทองแบรนด์ → เขียวมรกต" นำหน้า ซึ่งเป็นแถบเดียวบนหน้านี้ที่พาทั้งสองฮิวไว้ในแถบเดียว —
// ของอีกใบเป็นทองซีด #fde9a6 ทึบพร้อมพรอมป์ &gt;_ สองใบจึงคนละเฉดทองและคนละเครื่องหมาย
// นำหน้า
// ออร่ามุมบนซ้ายเป็นเขียวมรกต #0a6b32 ซึ่งอิ่มขึ้นเป็นเขียวสว่าง #2fbf6a ตอน hover
// เส้นคั่นกลางเป็นเขียวเข้ม #043d1c เนื้อความ #e8f2e6 (= BRAND_TEXT) — 14.7:1 บนผิวยก
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #d8dbe0
// #a46b25 #6d4412 #191108 #ece1cc rgba(200,145,47,…)) และชุดทอง-ดำของ NAZA99 ก่อนหน้า
// นั้น (#e4b34d #fdf2ac #140c02 #8a5f12 #f3e8cf) ออกครบทุกจุดแล้ว — สองรอบก่อนบังเอิญ
// เป็นทองอีกเฉดหนึ่ง ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว" ไม่ได้หมายความว่า
// เป็นทองของแบรนด์นี้
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#cc920a]/55 bg-[#0d2414]/94 p-8 text-[#e8f2e6] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde9a6]/60 hover:shadow-[0_15px_40px_rgba(204,146,10,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#fde9a6]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0a6b32]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#2fbf6a]/30">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#043d1c] pb-6 text-left text-base leading-relaxed text-[#e8f2e6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          leftHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black tracking-wider text-[#f7d14e] uppercase drop-shadow-[0_2px_10px_rgba(204,146,10,0.45)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde9a6] via-[#cc920a] to-[#0a6b32] shadow-[0_0_10px_rgba(204,146,10,0.6)]" />
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8f2e6] md:pl-6">
        {
          titleright && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#f7d14e] uppercase drop-shadow-[0_0_8px_rgba(204,146,10,0.45)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
