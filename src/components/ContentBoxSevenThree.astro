---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// FAH999: คู่กับ ContentBoxSevenThreePremium ที่เป็นการ์ดไล่เฉดขอบมน ตัวนี้เป็น
// กรอบทองหลัก #e8c25a บนพื้นดำอมน้ำตาล #12100b หัวข้อฝั่งขวาเป็นทองทึบไม่ไล่เฉด
// และมีเส้นคั่นกลางระหว่างสองคอลัมน์ — คนละจังหวะสายตากับใบแรก ทั้งที่เป็นทอง
// ชุดเดียวกัน
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e8c25a]/60 bg-[#12100b]/92 p-8 text-[#e7dcc4] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f7e7a8]/75 hover:shadow-[0_15px_40px_rgba(247,231,168,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e8c25a]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#f7e7a8]/34">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#a3732c]/55 pb-6 text-left text-base leading-relaxed text-[#e7dcc4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#c49a41] uppercase drop-shadow-[0_2px_10px_rgba(232,194,90,0.35)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e7dcc4] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-2 text-2xl leading-normal font-black text-[#f7e7a8] drop-shadow-[0_0_8px_rgba(232,194,90,0.4)]">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
