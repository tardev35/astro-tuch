---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level. The docx decides it — a promo
   *  sub-section under an H2 is an h3, a top-level section is an h2. No level
   *  is hardcoded in the markup below; `as` is the only thing that sets it. */
  as?: "h2" | "h3" | "h4";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
// `title` is the shorthand for the right-hand column heading. This box only
// ever carries docx article headings.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): คู่กับ ContentBoxSevenThreePremium
// ที่ไล่เฉดหัวข้อชมพูในหน้าเดียวกัน ใบนี้กลับด้านกัน — การ์ดโปร่งดำอมม่วง #140722 ใน
// กรอบม่วงแบรนด์ #8b3df3 มีเส้นม่วงอ่อน #c9a4ff พาดขอบบนเป็นเส้นผมหนึ่งพิกเซล
// หัวข้อฝั่งขวาเป็นม่วงอ่อน #c9a4ff ทึบ ไม่ไล่เฉด และมีแถบตั้งม่วง→ชมพูนำหน้า (เรียง
// ตามโลโก้สองโทน SEXY ชมพู / GAME ม่วง / 666 ชมพู) คนละจังหวะสายตากับใบแรกทั้งที่
// อยู่ในพาเลตต์เดียวกัน เนื้อความ #f2dcee (BRAND_TEXT) — ชุดทองเมทัลลิก-โครเมียมของ
// PKG44 (#c8920a #fdd32a #c2c8d0 #f2f4f7 #8a9099 #4a3a12 #12100a #efe6d2)
// ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8b3df3]/55 bg-[#140722]/94 p-8 text-[#f2dcee] shadow-[0_10px_30px_rgba(8,2,13,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fa42b5]/60 hover:shadow-[0_15px_40px_rgba(250,66,181,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-[#c9a4ff]/80 to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#8b3df3]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#fa42b5]/22">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#4a0e33]/80 pb-6 text-left text-base leading-relaxed text-[#f2dcee] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wider text-[#c9a4ff] uppercase drop-shadow-[0_2px_10px_rgba(250,66,181,0.45)] md:text-left md:text-3xl">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2dcee] md:pl-6">
        {
          rightHeading && (
            <HeadingTag class="flex items-center gap-3 text-2xl leading-normal font-black text-[#c9a4ff] uppercase drop-shadow-[0_0_8px_rgba(139,61,243,0.45)]">
              <span aria-hidden="true" class="h-7 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ddc3ff] via-[#8b3df3] to-[#fa42b5] shadow-[0_0_10px_rgba(139,61,243,0.6)]" />
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
