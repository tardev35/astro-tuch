---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits when
   *  `heading` is left false. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions the PAGE invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, and the <section> is named by aria-label so
   *  chrome never enters the heading inventory. Leave it true only when the
   *  labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// This box used to expose ONLY titleleft/titlecenter/titleright and render all
// three as real heading tags, which meant one docx section came out as three
// headings and the h2/h3 inventory could never match the brief. It now takes the
// section's own `title` (the docx heading) plus an opt-in `heading` flag for the
// captions, exactly like the Premium sibling — same prop shape, so a page can be
// moved between the two without touching its markup.
//
// `heading` defaults to FALSE: a three-column split on this template is almost
// always one docx paragraph broken into three readable columns, so the safe
// default keeps chrome out of the heading inventory. This round the home page
// passes heading={false} explicitly AND passes no column labels at all — the
// brief gives §2 one running paragraph with no sub-labels, so the three columns
// are purely a reading split and the block emits exactly one heading, its own
// docx H2.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#b44c06] uppercase";
const columnDot = "block h-2 w-2 shrink-0 bg-[#eb0305] shadow-[0_0_6px_rgba(235,3,5,0.8)]";

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children. This round the
// page passes named slots only, so it stays unrendered.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// โปรดี168 (รอบ **แดงเชอร์รี่นำ · ทองแดงไหม้รอง · ธีมสว่าง** 2026-10-22,
// .claude/brand-spec-prodeee168.md §2): ใบนี้ถือ **docx H2 §2** ("โปรดี168
// ค่ายตรงมาแรง พร้อมโปรโมชั่น เดิมพันออนไลน์ อัปเดตก่อนสิ้นปี 2026") และย่อหน้า
// เต็มของบรีฟถูกแบ่งเป็นสามท่อนลงสามคอลัมน์ โดยไม่มีป้ายคอลัมน์
//
// ⚠️ **ธีมสว่าง** — bg.json = {"mode":"color","color":"#ffd1d1"} ชมพูพาสเทลสว่าง
// ลำดับความลึก: #ffffff ผิวยก / **#fff4ea อินเซ็ต (ใบนี้)** / #ffd1d1 พื้นเพจ
// หมึก **น้ำตาลแดง #401107** (= BRAND_TEXT, 14.9:1 บนผิวอินเซ็ต)
// **ห้าม "แก้" การ์ดกลับไปเป็นพื้นเข้ม** เพราะพื้นเพจของดรอปนี้สว่าง
//
// หน้าแรกรอบนี้มีการ์ดมุมตัดสองใบ (§2 ใบนี้ และ §4 ContentBoxSevenThreeCyberCut)
// โดยมี §3 คั่นกลาง ทั้งคู่ถูกแยกออกจากกันสี่ทางพร้อมกัน:
//   **ทิศของมุมตัด** — ใบนี้ตัด **ขวาบน-ซ้ายล่าง** · §4 ตัดซ้ายบน-ขวาล่าง
//   **ขนาดมุม** — 30px · §4 เป็น 36px
//   **ความลึกของผิว** — ใบนี้เป็น **ผิวอินเซ็ต #fff4ea** · §4 เป็นผิวยก #ffffff
//   **การจัดหัวข้อ** — ใบนี้เป็น **ไล่เฉดสามสต็อปบน bg-clip-text พร้อมแถบตั้งนำ**
//     · §4 เป็นหัวข้อทึบสีเดียวพร้อมเครื่องหมาย ✦
// กรอบมุมตัดเป็นทองแดงไหม้ #b44c06 และสว่างขึ้นเป็นแดงเชอร์รี่ #eb0305 ตอน hover
// เส้นรูดสี่มุมจับคู่สองฮิวของอาร์ตเวิร์กไขว้กัน — แดงเชอร์รี่ #eb0305 คู่ทองแดงไหม้
// #b44c06 บนแนวนอน (ผ้าพันคอแดงของกระต่ายกับป้ายไม้/เหรียญทอง) และแดงสด #ff4446
// คู่ทองแดงเข้ม #7a2f03 บนแนวตั้ง (โบว์แดงของเด็กหญิงกับรั้วไม้/กังหัน)
// หัวข้อไล่ แดงเชอร์รี่ #eb0305 → ทองแดงไหม้ #b44c06 → ทองแดงเข้ม #7a2f03 ซึ่งไม่
// ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ แถบตั้งนำหน้าไล่ #eb0305 → #ff4446 →
// #b44c06 และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่ลูก (bg-clip-text ของหัวข้อจะชนกับ
// พื้นของแถบถ้าซ้อนกัน) — แถบเป็น **พื้นถม** #ff4446 จึงอยู่ในนั้นได้
// ⚠️ bg-clip-text = พิกเซลของตัวอักษร ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2:
// #eb0305 4.3:1 · #b44c06 4.9:1 · #7a2f03 8.7:1 บนผิวอินเซ็ต และหัวข้อเป็น
// text-xl/2xl font-black จึงนับเป็น large text ทุกแบนด์
// ป้ายคอลัมน์ (ถ้ารอบถัดไปส่งมา) เป็นทองแดงไหม้ #b44c06 กับจุดนำแดงเชอร์รี่
// ⚠️ §2 ห้าม **#ff4446** ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร — ในไฟล์นี้มันอยู่ที่
// เส้นรูดกับแถบตั้งเท่านั้น · **#9b0a0c สงวนไว้ให้ <strong> ในย่อหน้า** จึงไม่โผล่
// ที่นี่ · **ทองสาลี่ #f0b46a ไม่มีในไฟล์นี้เลย** เพราะ §2 กันไว้ให้โครมเท่านั้น
// (1.8:1 บนผิวสว่าง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง+ทอง ซึ่งเป็นฮิวที่
// แน่นที่สุดในรีโปนี้ และรอบก่อน (รวยแท้168) ก็เป็นแดง+ทอง+ธีมสว่างชมพูเหมือนกัน**
// การเจอแดงในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบทีละหลัก: แดงรอบนี้คือ
// **#eb0305 (R235 G3 B5)** วัดจาก logo.webp เอง ไม่ใช่ c30303 ของรอบก่อน (ห่าง 40
// ที่ R) ตัวที่ใกล้ที่สุดในรีโปคือ dc0203 ของหวย365 (ห่าง 18) รับไว้โดยตั้งใจ
// ชุดทอง-ชมพูบานเย็นของ **มีโชค168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509 d8b9c9 c89a08
// e8bc1c กับ rgba 252/212/52 α) rgba 245/70/159 α)) ออกครบทุกค่าแล้ว เช่นเดียวกับ
// ชุดแดงคริมสัน-ทองโบราณของรอบขาออก **รวยแท้168** (c30303 8f0505 e81313 dcb95f
// b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ชุดเขียวมรกตของ
// **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7
// e9fbdd) และชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ **TSDET911** (0360f3 0292fb 6ec8ff
// 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e 041a43)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง/ไวโอเลต
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#b44c06]/70 bg-[#fff4ea] p-8 text-[#401107] shadow-[0_10px_30px_rgba(64,17,7,0.16)] transition-all duration-300 hover:border-[#eb0305]/70 hover:shadow-[0_15px_40px_rgba(235,3,5,0.22)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#eb0305] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#b44c06] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff4446] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#7a2f03] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#b44c06]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 bg-gradient-to-b from-[#eb0305] via-[#ff4446] to-[#b44c06] shadow-[0_0_10px_rgba(235,3,5,0.4)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#eb0305] via-[#b44c06] to-[#7a2f03] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#401107]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#b44c06]/45 pb-6 text-left text-base leading-relaxed text-[#401107] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#b44c06]/45 pb-6 text-left text-base leading-relaxed text-[#401107] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#401107] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
