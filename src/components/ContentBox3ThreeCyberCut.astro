---
export interface Props {
  /** The section's own docx heading — the only heading this box ever emits when
   *  `heading` is left false. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions the PAGE invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, and the <section> is named by aria-label so
   *  chrome never enters the heading inventory. Leave it true only when the
   *  labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// This box used to expose ONLY titleleft/titlecenter/titleright and render all
// three as real heading tags, which meant one docx section came out as three
// headings and the h2/h3 inventory could never match the brief. It now takes the
// section's own `title` (the docx heading) plus an opt-in `heading` flag for the
// captions, exactly like the Premium sibling — same prop shape, so a page can be
// moved between the two without touching its markup.
//
// `heading` defaults to FALSE: a three-column split on this template is almost
// always one docx paragraph broken into three readable columns, so the safe
// default keeps chrome out of the heading inventory. /ทดลองเล่น relies on that
// default. The home page relies on it too this round: it passes heading={false}
// explicitly and sends the brief's own "ขั้นตอนที่ 1/2/3 …" labels through, so
// the three steps render as <p> and the printed h3 count stays at exactly 2 —
// the two promotion sub-sections, which are the only H3s the brief has.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff8dc6] uppercase";
const columnDot = "block h-2 w-2 shrink-0 bg-[#f5469f] shadow-[0_0_6px_rgba(245,70,159,0.85)]";

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2): ใบนี้ถือ docx H2 §6 ("สมัครรับบริการเล่นสล็อต
// <แบรนด์> ง่ายๆ 3 ขั้นตอน") — ย่อหน้านำของบรีฟอยู่ในสล็อต default และสามขั้นตอน
// ของบรีฟอยู่ในสามคอลัมน์ โดยป้ายคอลัมน์เป็น <p> ไม่ใช่หัวข้อ
//
// สองการ์ดมุมตัดของหน้านี้อยู่ติดกัน (§5 แล้ว §6) จึงถูกแยกด้วยสามอย่างพร้อมกัน:
// **ทิศของมุมตัด** — ใบนี้ตัด **ขวาบน-ซ้ายล่าง** เป็นภาพกระจกของ ContentBoxSevenThree
// ที่ตัดซ้ายบน-ขวาล่าง · ขนาดมุม 30px เทียบกับ 36px ของใบนั้น · และความลึกของผิว คือ
// **ผิวจม #0b0509** เทียบกับผิวยก #24101c ของใบนั้น
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #24101c ยก /
// #160a12 กลาง / #0b0509 จม / #000000 พื้น
// กรอบมุมตัดเป็นเส้นทองลึก #7a5508 และสว่างขึ้นเป็นทองแบรนด์ #fcd434 ตอน hover
// เส้นรูดสี่มุมจับคู่สองฮิวของโลโก้ไขว้กัน — ทองแบรนด์ #fcd434 คู่พลัมเข้ม #8c0f52
// บนแนวนอน (เหรียญจีนทองกับเงาใต้ทองแท่ง) ชมพูอ่อน #ff8dc6 คู่ชมพูบานเย็น #f5469f
// บนแนวตั้ง (ดอกซากุระกับริบบิ้นซาติน)
// หัวข้อไล่ ทองแบรนด์ #fcd434 → ชมพูอ่อน #ff8dc6 → ชมพูบานเย็น #f5469f ซึ่งไม่ซ้ำ
// ลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ สันหัวข้อไล่ ทองแบรนด์ #fcd434 → ชมพูบานเย็น
// #f5469f → พลัมเข้ม #8c0f52
// ป้ายสามคอลัมน์เป็นตัวอักษรชมพูอ่อน #ff8dc6 (9.9:1 และเป็น text-lg font-black จึง
// เป็น large text) กับจุดนำชมพูบานเย็น เนื้อความ #f6e4ee (= BRAND_TEXT) — 17.0:1
// บนผิวจม
// §2 ห้าม #8c0f52 #7a5508 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ที่ขอบ เส้นรูด
// สันหัวข้อ และเส้นคั่นคอลัมน์เท่านั้น · #ffeaa0 สงวนไว้ให้ <strong> ในย่อหน้า
// จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** ทองรอบนี้คือ
// #fcd434 ไม่ใช่ f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310
// ffc93d ffe4a3 (TND168) f2c230 ffe066 (KINGKONG555) e2b33f (KMD88) e5a81b (UFA324)
// fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f3bb34 (DUCK1688) หรือ
// fbe455 (WEPLAY168) และ **ชมพูรอบนี้คือ #f5469f ไม่ใช่ f41571 / ff5ca8 ของ
// PUNPRO168** ซึ่งเป็นชมพูฮอตพิงก์เหมือนกันแต่คนละค่า
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 ที่เคยค้างอยู่ทั้งไฟล์นี้ (0360f3 0292fb
// 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e
// 041a43) ชุดแดงแบรนด์-ทองของ หวย24 (d20a0a 7a0505 ff3b3b f5c33b ffd45e 170707
// f7e2d6 พร้อม rgba(210,10,10,α) และ rgba(245,195,59,α)) และชุดทอง-เขียวของ PGW44
// (fde90e 35d413 5df53a a86f02 f5c518 1f5a16 0b1408 e9f0dd) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดง**
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#7a5508]/80 bg-[#0b0509]/92 p-8 text-[#f6e4ee] shadow-[0_10px_30px_rgba(252,212,52,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#fcd434]/70 hover:shadow-[0_15px_40px_rgba(245,70,159,0.28)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fcd434] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#8c0f52] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff8dc6] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f5469f] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7a5508]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 bg-gradient-to-b from-[#fcd434] via-[#f5469f] to-[#8c0f52] shadow-[0_0_10px_rgba(245,70,159,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fcd434] via-[#ff8dc6] to-[#f5469f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f6e4ee]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#7a5508]/80 pb-6 text-left text-base leading-relaxed text-[#f6e4ee] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#7a5508]/80 pb-6 text-left text-base leading-relaxed text-[#f6e4ee] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4ee] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
