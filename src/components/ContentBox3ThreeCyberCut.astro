---
export interface Props {
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  as?: "h2" | "h3" | "h4" | "h5" | "h6";
}
// The three column titles are docx article headings, not chrome labels, so they
// render as real heading tags. They used to be <p>, which dropped three docx
// sections out of the page's heading outline.
//
// PAOTUNG: this box carries the brief's three signup steps as H3 sub-points
// under the section's own H2, so the labels are article content by construction.
//
// PAOTUNG palette: the clipped frame is the logo's primary blue on the navy card
// surface (#04203c). The corner rules are split by diagonal — gold metallic on
// the top-left/bottom-right pair, brand blue on the vertical pair — and each
// step label takes light gold with a bright-blue marker square. The previous
// brand's amber/brown set is gone entirely.
const { titleleft, titlecenter, titleright, as: HeadingTag = "h3" } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#226ca9]/45 bg-[#04203c]/90 p-8 text-[#cfdeed] shadow-[0_0_25px_rgba(34,108,169,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#3b9ddd] hover:shadow-[0_0_40px_rgba(59,157,221,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e0bd72] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f5e3b3] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#226ca9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#3b9ddd] to-transparent"></div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#226ca9]/50 pb-6 text-left text-base leading-relaxed text-[#cfdeed] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f5e3b3] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#3b9ddd] shadow-[0_0_5px_rgba(59,157,221,0.8)]" /> {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#226ca9]/50 pb-6 text-left text-base leading-relaxed text-[#cfdeed] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <HeadingTag class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f5e3b3] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#3b9ddd] shadow-[0_0_5px_rgba(59,157,221,0.8)]" /> {titlecenter}
            </HeadingTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed] md:pl-6">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f5e3b3] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#3b9ddd] shadow-[0_0_5px_rgba(59,157,221,0.8)]" /> {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
