---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// พาเลตต์ NAZA168 (ทองอวกาศ-เงินโครเมียมบนน้ำตาลไหม้ 2026-10-10, brand-spec §2):
// แถบน้ำตาลไหม้ลึกสุด #241700 ขอบทองแบรนด์ #fbc134 ป้าย "ประกาศ" ไล่จากทองสว่าง
// #ffe87a ผ่านทองแบรนด์ #fbc134 ลงทองกลางเข้ม #cf9a18 ตัวหนังสือบนป้ายเป็นหมึก
// น้ำตาลเกือบดำ #231500 (7.0:1 บนปลายที่เข้มที่สุด) เนื้อข่าว #fdf3df (BRAND_TEXT)
// จุดนำหน้าสองจุดเป็นทองสว่าง #ffe87a กับเงินโครเมียม #cfd6e3 — โลโก้แบรนด์นี้เป็น
// คู่ ทอง/เงินโครเมียม จริง (NAZA ทองสามมิติ 168 เงินโครเมียม) จุดคู่จึงต่างกันที่
// "สี" ได้ ไม่ใช่แค่ความสว่าง · โทนมรกต-ทองของ KOON234 (#cc920a #fde9a6 #8a6204
// #07170c #e8f2e6 #f7d14e #2fbf6a #020803 rgba(204,146,10,α) rgba(247,209,78,α))
// ที่เคยค้างอยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว — ทองรอบนี้เป็นคนละค่า และรอบนี้
// ไม่มีเขียวเลย อย่าปล่อยของเก่าไว้
//
// ⚠️ #cf9a18 เป็นปลายเข้มสุดที่ยอมให้รองหมึกได้ ถ้าใช้ #96690a ของ brand-spec
// แทนจะเหลือ ~3.7:1 ซึ่งตก AA
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §5 §6): NAZA168 เป็นเว็บสล็อต
// ("เว็บสล็อตนาซ่า") ไม่ใช่เว็บหวยและไม่ใช่เว็บคาสิโนรวม · บรีฟไม่ได้เอ่ยชื่อเกม
// หรือชื่อค่ายไว้สักชื่อ จึงห้ามใส่ลงไป · ไม่ระบุช่องทางไลน์ (บรีฟพูดแค่ "ช่องทาง
// ติดต่อหลักที่เว็บไซต์กำหนด") · คำว่า "ส่งตรงจากเมกา" กับ "ฐานเกมหลัก 100%"
// ห้ามพูดลอยๆ เพราะบรีฟย้ำเองสามครั้งว่าควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ ·
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง (0.3% · 0.8% · 24 ชั่วโมง · 100%)

const {
  message = `${BRAND_NAME} เว็บสล็อตนาซ่า รวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน และโบนัสตัวคูณ รองรับทั้งมือถือและคอมพิวเตอร์ • ค้นหาเกม ตรวจสอบเครดิต และติดตามโปรโมชั่นได้จากแพลตฟอร์มเดียวโดยไม่ต้องสลับหลายหน้าจอ • ระบบจัดหมวดหมู่เกมช่วยให้เลือกค่ายที่สนใจได้ง่าย ตรวจสอบยอดเดิมพันและตารางจ่ายของแต่ละเกมก่อนเริ่มเล่นได้โดยตรง • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสตามรอบที่เว็บไซต์กำหนด ควรอ่านรอบตัดยอดและเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง • โปรโมชั่นแนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ ตรวจสอบจำนวนเพื่อนและสถานะโบนัสได้จากบัญชีสมาชิก • ฝากถอนเข้าบัญชีบริษัทโดยตรง ควรตรวจสอบชื่อบัญชีปลายทางและจำนวนเงินก่อนยืนยันรายการทุกครั้ง • ข้อความส่งตรงจากเมกาและฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ ไม่ควรใช้เป็นหลักฐานยืนยันเพียงอย่างเดียว • แอดมิน ${BRAND_NAME} ให้บริการตลอด 24 ชั่วโมง ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#fbc134]/45 bg-[#241700]/92 shadow-[0_8px_20px_rgba(251,193,52,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(255,232,122,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe87a] via-[#fbc134] to-[#cf9a18] px-8 py-2.5 font-black text-[#231500] shadow-[4px_0_15px_rgba(251,193,52,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#241700] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#fdf3df]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffe87a] shadow-[0_0_8px_rgba(255,232,122,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#cfd6e3] shadow-[0_0_8px_rgba(207,214,227,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
