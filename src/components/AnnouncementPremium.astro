---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "JOKERSLOTZ ทางเข้าสำรอง ล่าสุด เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย • อัปเดตลิ้งก์ใหม่เพื่อแก้ปัญหาลิ้งก์เข้าใช้งานไม่ได้หรือเว็บโดนบล็อก เข้าเล่นเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming ได้ต่อเนื่อง • แนะนำให้สมัครยูสใหม่บนทางเข้าล่าสุด ระบบเซิร์ฟเวอร์ใหม่เข้ารหัสความปลอดภัยแน่นหนาขึ้น 100% • โปรโมชั่นแนะนำเพื่อน รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเดิมพันของเพื่อน • โปรโมชั่นคืนยอดเสีย 0.3% ในทุกรอบบิล ตรวจสอบสิทธิ์ได้จากบัญชีสมาชิก • สมัครสมาชิกอัตโนมัติเสร็จภายใน 1 นาที รองรับทุกธนาคารและ TrueMoney Wallet • ติดต่อแอดมิน JOKERSLOTZ ผ่าน Line Official ได้ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#d9b45e]/45 bg-[#1c0202]/92 shadow-[0_8px_20px_rgba(217,180,94,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(217,180,94,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#bc9b5b] px-8 py-2.5 font-black text-[#1c0202] shadow-[4px_0_15px_rgba(217,180,94,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#1c0202] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ecdfd0]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#d9b45e] shadow-[0_0_8px_rgba(217,180,94,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#c81e1e] shadow-[0_0_8px_rgba(200,30,30,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
