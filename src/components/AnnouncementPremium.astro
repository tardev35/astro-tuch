---
const {
  message = "AMAZON789 คาสิโนมือถือ ฝากถอนปลอดภัย ทีมงานแนะนำ 24 ชม. • โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% • ฝากถอนออโต้ปลอดภัย ใช้งานง่าย • เข้าระบบเล่นง่ายบนมือถือทุกอุปกรณ์",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#16a34a]/35 bg-[#0a140c]/92 shadow-[0_8px_20px_rgba(22,163,74,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(236,72,153,0.24)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f9a8d4] via-[#ec4899] to-[#16a34a] px-8 py-2.5 font-black text-[#0a140c] shadow-[4px_0_15px_rgba(236,72,153,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a140c] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#e8f5ee]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#4ade80] shadow-[0_0_8px_rgba(74,222,128,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#4ade80] shadow-[0_0_8px_rgba(74,222,128,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
