---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// พาเลตต์ UOK365 (ทองเมทัลลิก-เงินโครเมียม-ดำ 2026-10-07, brand-spec §2): แถบ
// น้ำตาลเกือบดำ #0a0806 ขอบทองแบรนด์ #c8912f ป้าย "ประกาศ" ไล่จากทองอ่อน #f5d98a
// ผ่านทองแบรนด์ #c8912f ลงทองลึก #6d4412 ตัวหนังสือบนป้ายเป็นหมึก #191005 เนื้อข่าว
// #ece1cc (BRAND_TEXT) จุดนำหน้าสองจุดเป็นทองอ่อน #f5d98a กับเงินโครเมียม #d8dbe0 —
// โลโก้แบรนด์นี้เป็นสองโลหะจริง (UOK ทอง / 365 เงิน) จุดคู่จึงต่างกันที่ "สี" ได้
// ไม่ใช่แค่ความสว่าง · โทนทอง-ดำของ 1SS365 (#050505 #edbb23 #ffeeb4 #a87708
// #f0e6d2 #c8cbce) ที่เคยค้างอยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §4 §6): เป็นเว็บสล็อตเบทต่ำ ไม่ใช่หวย
// และไม่ใช่บอล · บรีฟไม่ได้เอ่ยชื่อเกมหรือชื่อค่ายไว้สักชื่อ จึงห้ามใส่ชื่อเกมลงไป ·
// ไม่ระบุช่องทางไลน์ (บรีฟพูดแค่ "ช่องทางบริการหลักที่เว็บไซต์กำหนด") · "ไม่มีขั้นต่ำ"
// ห้ามพูดลอยๆ เพราะบรีฟย้ำว่าขั้นต่ำและสูงสุดขึ้นกับค่ายและเกมที่เลือก · ตัวเลขที่
// ใช้ได้มีแค่ของบรีฟเอง (0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง)
const {
  message = `${BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำ รวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ • เหมาะกับสายสล็อตที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ เลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนดได้ • คำว่าไม่มีขั้นต่ำควรอ้างอิงจากเกมที่เปิดให้บริการจริง เพราะเกมสล็อตแต่ละค่ายกำหนดยอดต่ำสุดไม่เท่ากัน ควรตรวจตารางจ่ายและช่วงเดิมพันก่อนเริ่มทุกครั้ง • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตรวจรอบตัดยอดและค่ายเกมที่ร่วมรายการได้จากบัญชีสมาชิก • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด • สมัครผ่านมือถือได้ใน 3 ขั้นตอน แล้วใช้บัญชีเดียวดูเครดิต โปรโมชั่น และประวัติรายการ • แอดมิน ${BRAND_NAME} ดูแลตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#c8912f]/45 bg-[#0a0806]/92 shadow-[0_8px_20px_rgba(200,145,47,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(245,217,138,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f5d98a] via-[#c8912f] to-[#6d4412] px-8 py-2.5 font-black text-[#191005] shadow-[4px_0_15px_rgba(200,145,47,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0806] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ece1cc]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f5d98a] shadow-[0_0_8px_rgba(245,217,138,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#d8dbe0] shadow-[0_0_8px_rgba(216,219,224,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
