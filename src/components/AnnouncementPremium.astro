---
const {
  message = "SUPERWIN9 คาสิโนเกมนักล่า รวมเกมคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อตครบทุกค่ายในบัญชีเดียว • โบนัสแนะนำเพื่อน 0.8% เพียงแชร์ลิงก์แนะนำของตนเอง เข้ากระเป๋าออนไลน์ทันที • ฝากถอนรองรับทุกธนาคารตามช่องทางที่เปิดให้บริการ ตรวจสอบสถานะรายการได้เอง • แอดมิน SUPERWIN9 ดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#ebbb4a]/35 bg-[#0a0202]/92 shadow-[0_8px_20px_rgba(200,17,24,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(235,187,74,0.24)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fbe289] via-[#ebbb4a] to-[#c81118] px-8 py-2.5 font-black text-[#2a0a02] shadow-[4px_0_15px_rgba(235,187,74,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0202] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#efe3d2]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ebbb4a] shadow-[0_0_8px_rgba(235,187,74,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ebbb4a] shadow-[0_0_8px_rgba(235,187,74,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
