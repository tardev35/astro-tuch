---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "CREEKBET เกมคาสิโนเว็บแท้ รวมบาคาร่า รูเล็ต เสือมังกร คาสิโนสด และสล็อตไว้ในบัญชีเดียว • โบนัสคืนยอดเสีย 0.3% คำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข • โบนัสแนะนำเพื่อน 0.8% แชร์ลิงก์แนะนำของตนเองแล้วติดตามสิทธิ์ได้ในบัญชีสมาชิก • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง พร้อมแอดมิน CREEKBET คอยตรวจสอบรายการให้ทุกวัน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#cfd4da]/35 bg-[#0a0b0d]/92 shadow-[0_8px_20px_rgba(207,212,218,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(244,246,248,0.24)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-8 py-2.5 font-black text-[#0a0b0d] shadow-[4px_0_15px_rgba(207,212,218,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0b0d] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#dfe4ea]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#c02434] shadow-[0_0_8px_rgba(192,36,52,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#c02434] shadow-[0_0_8px_rgba(192,36,52,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
