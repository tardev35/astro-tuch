---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "UVO88 เว็บพนันที่น่าเชื่อที่สุด ครบทุกการเดิมพัน ส่งตรงจากต่างประเทศ • รวมบาคาร่า เกมไพ่ สล็อตออนไลน์ หวย และฟุตบอล ไว้ในบัญชีเดียว สลับหมวดเกมได้โดยไม่ต้องสมัครหลายบัญชี • รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ • ก่อนเริ่มเดิมพันควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกม เพราะรายละเอียดอาจต่างกันตามผู้ให้บริการ • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% คำนวณจากยอดที่เข้าเงื่อนไข ตามรอบและข้อกำหนดที่เว็บไซต์กำหนด • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% ตรวจสอบสิทธิ์และยอดที่เข้าเกณฑ์ได้จากบัญชีสมาชิก • ติดต่อแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f2c230]/45 bg-[#051a0e]/92 shadow-[0_8px_20px_rgba(242,194,48,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(242,194,48,0.28)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f2c230] to-[#a9791a] px-8 py-2.5 font-black text-[#03110a] shadow-[4px_0_15px_rgba(242,194,48,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#051a0e] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#c8e3d0]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f2c230] shadow-[0_0_8px_rgba(242,194,48,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#57dd8f] shadow-[0_0_8px_rgba(87,221,143,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
