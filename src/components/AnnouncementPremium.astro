---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "TIGER88 สล็อตไทเกอร์แท้ รวมเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ในระบบเดียว • มีทั้งสล็อตธีมยอดนิยม เกมโบนัส ฟรีสปิน และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ • เกมแนะนำ Fortune Tiger, Mahjong Ways 2, Lucky Neko และ Wild Bandito ควรเลือกจาก RTP ความผันผวน และขนาดเดิมพันที่เหมาะกับเงินทุน • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไข • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • ขั้นต่ำจริงขึ้นอยู่กับเกมและผู้ให้บริการแต่ละราย ควรตรวจสอบบนหน้าเกมก่อนเริ่มเล่น • สมัคร TIGER88 ผ่านมือถือได้เองใน 3 ขั้นตอน • แอดมิน TIGER88 ให้บริการออนไลน์ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#fdd121]/45 bg-[#070202]/92 shadow-[0_8px_20px_rgba(239,22,34,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(253,209,33,0.28)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe98a] via-[#ef1622] to-[#b00a12] px-8 py-2.5 font-black text-[#1c0606] shadow-[4px_0_15px_rgba(239,22,34,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#070202] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f2e3c9]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#fdd121] shadow-[0_0_8px_rgba(253,209,33,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#fdd121] shadow-[0_0_8px_rgba(253,209,33,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
