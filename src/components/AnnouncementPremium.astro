---
const {
  message = "UFA99 เว็บรวมคาสิโนสล็อต ค่ายเกมแท้ มาตรฐานเอเชีย รวมสล็อต บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และคาสิโนสดไว้ในบัญชีเดียว • โบนัสแนะนำเพื่อน 0.8% แชร์ลิงก์แนะนำของตนเองแล้วติดตามสิทธิ์ได้ในบัญชีสมาชิก • โปรโมชั่นคืนยอดเสีย 0.3% คำนวณตามยอดและประเภทเกมที่เข้าเงื่อนไข • ระบบฝากถอนอัตโนมัติ พร้อมทีมงาน UFA99 ดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#ebc36b]/35 bg-[#050301]/92 shadow-[0_8px_20px_rgba(235,195,107,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(252,228,140,0.24)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fce48c] via-[#ebc36b] to-[#c9962f] px-8 py-2.5 font-black text-[#150e05] shadow-[4px_0_15px_rgba(235,195,107,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#050301] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ece0c8]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ebc36b] shadow-[0_0_8px_rgba(235,195,107,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ebc36b] shadow-[0_0_8px_rgba(235,195,107,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
