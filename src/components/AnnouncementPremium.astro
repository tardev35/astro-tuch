---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// รวยเทพ168 (รอบทองจักรพรรดินำ-แดงชาดรอง 2026-10-20): ticker ที่ใช้งานจริงรอบนี้ —
// รอบก่อน มีเฮ168 ใช้ Announcement5 จึงหมุนมาที่ไฟล์นี้ ทุกหน้าเรียกแบบ bare
// เหมือนกันหมด ข้อความจึงตรงกันทั้งเว็บ ห้ามส่ง prop message จากหน้าไหน
//
// พาเลตต์ตาม .claude/brand-spec-ruaythep168.md §2: แถบน้ำตาลไหม้ #260d04
// (bg.json ของดรอปนี้คือ #000000 แถบจึงลอยเหนือพื้นหนึ่งชั้น) ขอบทองแบรนด์ #f0bb4e
// ป้าย "ประกาศ" ไล่จากครีมทอง #ffeccb ลงทองแบรนด์ #f0bb4e ตัวหนังสือบนป้าย
// เป็นหมึกน้ำตาลไหม้ #2b1400 (9.9:1 บนปลายที่เข้มที่สุด) เนื้อข่าว #fff8ec
// (= BRAND_TEXT, 17.4:1 บนแถบ)
//
// ⚠️ แบรนด์นี้เป็น **สองฮิวจริง** (ทองนำ แดงรอง) จุดนำหน้าสองจุดจึง **ต่างที่สี**
// ได้จริง: จุดแรกครีมทอง #ffeccb (ริ้วทองกับมงกุฎบนโลโก้) จุดที่สองแดงชาด #e4021b
// (เลข 168) ไม่ใช่ต่างที่ "ค่าความสว่างของทองเดียวกัน" และเงาของป้ายเป็นแดง
// rgba(228,2,27,α) เรืองออกจากแผ่นทอง ซึ่งคือคู่สีบนโลโก้ตรงๆ
// ⚠️ แดง #e4021b เป็น **พื้นถม/จุด/เงา เท่านั้น ไม่ถือตัวอักษร** (3.8:1 บนแถบนี้)
//
// ⚠️ ชุดทองไทย-แดงมังกรของ รับตัง168 ที่ค้างอยู่ในไฟล์นี้ (f0b429 ffdc8c ff6b6e
// 140505 1a0505 f5ece0 rgba 240/180/41 α) rgba 255/220/140 α) rgba 211/3/4 α)
// rgba 255/107/110 α)) ชุดทองมังกรของ TND168 ก่อนหน้านั้น (dfa310 ffe4a3 ffc93d
// 140d02 f0e9dc) และชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (fbc134 ffe87a cf9a18
// 96690a cfd6e3 fdf3df 241700 231500) ถูกแทนครบทุกจุดแล้ว ทั้งในคลาสและใน
// rgba() — ⚠️ ทองรอบนี้ #f0bb4e **มี R เท่ากับ f0b429 ของรับตัง168 เป๊ะ** ต่างกันที่
// B78 vs B41 อย่าปล่อยของเก่าไว้เพราะ "ก็ทองเหมือนกัน" ต้อง grep เป็นค่า
// (เฮกซ์ของแบรนด์เก่าเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §6): รวยเทพ168 เป็น **เว็บเกมสล็อต
// เป็นแกน** ที่บรีฟระบุหมวดเกมไว้สี่หมวดจริง — **สล็อต ยิงปลา ไฮโล และหวยออนไลน์**
// สี่คำนี้จึงใช้ได้รอบนี้ (ต่างจากรอบก่อนที่ห้าม) แต่ยังไม่ใช่เว็บหวย · คำว่า
// บาคาร่า รูเล็ต แทงบอล คาสิโนไลฟ์สด และ เว็บตรง **ไม่มีในบรีฟรอบนี้สักคำ** จึงห้าม
// ใส่ · บรีฟไม่ได้เอ่ยชื่อค่ายเกมไว้สักชื่อ จึงห้ามใส่ลงไป · ตัวเลขที่ใช้ได้มีแค่
// ของบรีฟเอง (0.3% · 0.8% · 3 ขั้นตอน · 24ชม.) · คำกำกับของบรีฟที่ต้องคงไว้คือ
// "เกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไร"

const {
  message = `${BRAND_NAME} รวมช่องทางบริการเกมออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว ทั้งเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ พร้อมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และตรวจสอบโปรโมชั่น • ผู้ใช้งานสามารถศึกษากติกา อัตราจ่าย และข้อกำหนดของแต่ละประเภทเกมก่อนเลือกใช้งานได้จากหน้าเว็บไซต์ • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน ควรตรวจสอบก่อนว่าคำนวณจากยอดเสียของเกมประเภทใด มีรอบเวลาคำนวณอย่างไร และต้องกดรับเครดิตด้วยตนเองหรือไม่ • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และหลักเกณฑ์การคำนวณโบนัสให้ครบถ้วน • การสมัครสมาชิกมี 3 ขั้นตอน ควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องก่อนกรอกข้อมูล และอ่านเงื่อนไขการเปิดบัญชีทุกครั้ง • ติดต่อเจ้าหน้าที่เรื่องการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่นได้ตลอด 24ชม. • ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น • ควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง เพราะเกมเหล่านี้มีความเสี่ยงต่อการสูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไรจากการเดิมพัน`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f0bb4e]/45 bg-[#260d04]/92 shadow-[0_8px_20px_rgba(240,187,78,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(255,236,203,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffeccb] to-[#f0bb4e] px-8 py-2.5 font-black text-[#2b1400] shadow-[4px_0_15px_rgba(228,2,27,0.35)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#260d04] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#fff8ec]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffeccb] shadow-[0_0_8px_rgba(255,236,203,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#e4021b] shadow-[0_0_8px_rgba(228,2,27,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
