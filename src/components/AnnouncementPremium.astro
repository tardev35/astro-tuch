---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "UFAFOX เกมสล็อต PG ค่ายหลัก แหล่งเดิมพันสล็อตที่ดีที่สุด • รวมคำแนะนำ เทคนิค และสูตรบริหารเงินทุนให้ศึกษาครบทุกเกม ไม่มีค่าใช้จ่ายเพิ่ม • อ่าน Paytable, RTP, ความผันผวน, Wild, Scatter และ Free Spins ให้ครบก่อนลงเงินจริง • ไม่มีสูตรใดบังคับผลสล็อตให้ชนะได้ แต่ช่วยวางแผนงบและลดการเล่นตามอารมณ์ • สมัคร UFAFOX ด้วยตัวเองผ่านมือถือได้ใน 3 ขั้นตอน • แอดมิน UFAFOX พร้อมตรวจสอบรายการให้ตลอดทั้งวัน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f26a02]/45 bg-[#0b0503]/92 shadow-[0_8px_20px_rgba(242,106,2,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(255,145,48,0.28)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffb266] via-[#f26a02] to-[#8c3a01] px-8 py-2.5 font-black text-[#070403] shadow-[4px_0_15px_rgba(242,106,2,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0b0503] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ded4cb]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ff9130] shadow-[0_0_8px_rgba(255,145,48,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#ff9130] shadow-[0_0_8px_rgba(255,145,48,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
