---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
const {
  message = "JUDTEM168 ศูนย์สล็อตอันดับ1 รวมค่ายเกมฮิตติดอันดับ ฝากถอนออโต้ เล่นได้ตลอดทั้งวัน • รวมเกมจาก PG SOFT, Pragmatic Play, JILI, JDB และ Habanero ไว้ในบัญชีเดียว • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของกิจกรรม • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน JUDTEM168 ตรวจสอบรายการให้ตลอดทั้งวัน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#cc9c2d]/45 bg-[#0b0703]/92 shadow-[0_8px_20px_rgba(204,156,45,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(250,226,124,0.28)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] px-8 py-2.5 font-black text-[#050301] shadow-[4px_0_15px_rgba(204,156,45,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0b0703] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f0e2bd]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fae27c] shadow-[0_0_8px_rgba(250,226,124,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fae27c] shadow-[0_0_8px_rgba(250,226,124,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
