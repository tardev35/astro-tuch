---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// รับตัง168 (รอบทองไทยนำ-แดงมังกรรอง 2026-10-18): ticker ที่ใช้งานจริงรอบนี้ —
// รอบก่อน สมหวัง168 ใช้ Announcement3 จึงหมุนมาที่ไฟล์นี้ ทุกหน้าเรียกแบบ bare
// เหมือนกันหมด ข้อความจึงตรงกันทั้งเว็บ ห้ามส่ง prop message จากหน้าไหน
//
// พาเลตต์ตาม .claude/brand-spec-rubtang168.md §2: แถบแดงเกือบดำ #140505
// (bg.json ของดรอปนี้คือ #1a0505 แถบจึงจมกว่าพื้นหนึ่งชั้น) ขอบทองแบรนด์ #f0b429
// ป้าย "ประกาศ" ไล่จากทองสว่าง #ffdc8c ลงทองแบรนด์ #f0b429 ตัวหนังสือบนป้าย
// เป็นหมึกแดงเกือบดำ #1a0505 (9.7:1 บนปลายที่เข้มที่สุด) เนื้อข่าว #f5ece0
// (= BRAND_TEXT)
//
// ⚠️ แบรนด์นี้เป็น **สองฮิวจริง** (ทองนำ แดงรอง) ซึ่งตรงข้ามกับ TND168 ที่เคยอยู่
// ในไฟล์นี้และเป็นฮิวเดียวล้วน — จุดนำหน้าสองจุดจึง **ต่างที่สี** ได้จริง: จุดแรก
// ทองสว่าง #ffdc8c (กองเหรียญบนโลโก้) จุดที่สองแดงสว่าง #ff6b6e (เลข 168) ไม่ใช่
// ต่างที่ "ค่าความสว่างของทองเดียวกัน" แบบรอบก่อน และเงาของป้ายเป็นแดง
// rgba(211,3,4,α) เรืองออกจากแผ่นทอง ซึ่งคือคู่สีบนโลโก้ตรงๆ
//
// ⚠️ ชุดทองมังกรของ TND168 ที่ค้างอยู่ในไฟล์นี้ (#dfa310 #ffe4a3 #ffc93d #140d02
// #f0e9dc #000000 rgba(223,163,16,α) rgba(255,228,163,α)) และชุดทองอวกาศ-เงิน
// โครเมียมของ NAZA168 ก่อนหน้านั้น (#fbc134 #ffe87a #cf9a18 #96690a #cfd6e3
// #fdf3df #241700 #231500) ถูกแทนครบทุกจุดแล้ว ทั้งในคลาสและใน rgba() —
// ทองรอบนี้ #f0b429 เป็นคนละค่ากับทั้งสองชุด อย่าปล่อยของเก่าไว้เพราะ "ก็ทองเหมือนกัน"
//
// ⚠️ #f0b429 เป็นปลายเข้มสุดที่ยอมให้รองหมึก #1a0505 ได้ ถ้าใช้ #9a6c0c ของ
// brand-spec แทนจะเหลือ ~3.3:1 ซึ่งตก AA · และ #d30304 รองหมึกเข้มไม่ได้เลย
// (2.2:1) จึงอยู่ได้แค่ในเงา ไม่ใช่ในพื้นถมใต้ตัวอักษร
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §5 §7): รับตัง168 เป็น **เว็บเกม
// สล็อตล้วน** ที่ขายตัวเองเป็นช่องทางรับบริการจากผู้ให้บริการเว็บตรง ไม่ใช่คาสิโน
// รวมทุกหมวดแบบ TND168 ที่เคยอยู่ในไฟล์นี้ — คำว่า บาคาร่า รูเล็ต ไฮโล แทงบอล
// และ คาสิโนไลฟ์สด **ไม่มีในบรีฟรอบนี้สักคำ** จึงถูกถอดออกทั้งหมด · บรีฟไม่ได้
// เอ่ยชื่อค่ายเกมไว้สักชื่อ จึงห้ามใส่ลงไป · ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง
// (0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง) · คำกำกับของบรีฟที่ต้องคงไว้คือ
// "ควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง"

const {
  message = `${BRAND_NAME} ช่องทางรับบริการจาก ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ฐานหลักเกมสล็อตออนไลน์ 100% • ผู้ใช้งานติดต่อเจ้าหน้าที่เพื่อสอบถามเรื่องการเข้าเล่น การทำรายการฝากถอน และรายละเอียดโปรโมชั่นได้ตามเวลาที่เว็บไซต์แจ้งไว้ตลอด 24 ชั่วโมง • ก่อนทำรายการควรตรวจสอบข้อมูลบัญชีและรายละเอียดที่เกี่ยวข้องให้ถูกต้อง รวมถึงอ่านข้อกำหนดของเว็บไซต์เพื่อให้เข้าใจขั้นตอนและเงื่อนไขการให้บริการอย่างชัดเจน • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน ควรตรวจสอบก่อนว่าคำนวณจากยอดเสียประเภทใด ครอบคลุมเกมไหน และต้องกดรับสิทธิ์ด้วยตนเองหรือไม่ • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ควรตรวจสอบวิธีลงทะเบียนผู้แนะนำ เงื่อนไขของบัญชีที่เข้าร่วม และหลักเกณฑ์การคำนวณโบนัสให้ครบถ้วน • การสมัครสมาชิกมี 3 ขั้นตอน ควรตรวจสอบว่าเป็นช่องทางทางการก่อนกรอกข้อมูลและอ่านเงื่อนไขก่อนสมัครทุกครั้ง • ตรวจสอบช่องทาง LINE Official จากหน้าเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ • ควรใช้ข้อมูลของตนเองเท่านั้น เก็บรหัสผ่านไว้เป็นความลับ และไม่ส่งรหัสยืนยันหรือข้อมูลสำคัญให้บุคคลอื่น • สิทธิ์ที่ได้รับอาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ และข้อกำหนดของแต่ละโปรโมชั่น ควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f0b429]/45 bg-[#140505]/92 shadow-[0_8px_20px_rgba(240,180,41,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(255,220,140,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffdc8c] to-[#f0b429] px-8 py-2.5 font-black text-[#1a0505] shadow-[4px_0_15px_rgba(211,3,4,0.35)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#140505] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f5ece0]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffdc8c] shadow-[0_0_8px_rgba(255,220,140,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ff6b6e] shadow-[0_0_8px_rgba(255,107,110,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
