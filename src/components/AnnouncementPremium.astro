---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// โปรดี168 (รอบแดงเชอร์รี่นำ-ทองแดงไหม้รอง **ธีมสว่าง** 2026-10-22): ticker ที่ใช้งาน
// จริงรอบนี้ — รอบก่อน รวยแท้168 ใช้ Announcement5 จึงหมุนมาที่ไฟล์นี้ ทุกหน้าเรียก
// แบบ bare เหมือนกันหมด ข้อความจึงตรงกันทั้งเว็บ ห้ามส่ง prop message จากหน้าไหน
//
// พาเลตตาม .claude/brand-spec-prodeee168.md §2: ⚠️ **ไฟล์นี้อยู่ในโซน "โครม"**
// จึงเป็นแถบเข้มบนพื้นเพจสว่าง (#ffd1d1 จาก bg.json) — **ห้าม "แก้" ให้เป็นแถบสว่าง
// เพื่อให้เข้ากับพื้น** เพราะหัว-ท้าย-ticker เข้มคือกรอบที่คร่อมเนื้อหาสว่างไว้
// แถบน้ำตาลแดงเข้ม #2c1004 ขอบทองสาลี่ #f0b46a ป้าย "ประกาศ" ไล่จากทองสาลี่ #f0b46a
// ลงทองแดงกลาง #d9803a ตัวหนังสือบนป้ายเป็นหมึกเกือบดำ #1a0802 (11.5:1 บนต้นเฉด
// และ 6.6:1 บนปลายเฉด ผ่านทุก stop) เนื้อข่าวครีม #fff0e4 (15.9:1 บนแถบ)
//
// ⚠️ แบรนด์นี้เป็น **สองฮิวจริง** (แดงนำ ทองแดงรอง) จุดนำหน้าสองจุดจึง **ต่างที่สี**
// ได้จริง: จุดแรกแดงเชอร์รี่ #eb0305 (ตัวอักษรบนโลโก้และผ้าพันคอของตัวละคร)
// จุดที่สองทองสาลี่ #f0b46a (เหรียญทองและป้ายไม้ในแบนเนอร์) ไม่ใช่ต่างที่
// "ค่าความสว่างของแดงเดียวกัน" และเงาของป้ายเป็นแดง rgba(235,3,5,α) เรืองออกจาก
// แผ่นทอง ซึ่งคือคู่สีบนอาร์ตเวิร์กตรงๆ
// ⚠️ ทองแดงไหม้ #b44c06 เป็น **พื้นถม/ขอบ/เงา เท่านั้น ไม่ถือตัวอักษรบนแถบนี้**
// (2.8:1 บนแถบ #2c1004) — บนการ์ดขาวถือได้ แต่ไฟล์นี้ไม่ใช่การ์ด
//
// ⚠️ ชุดทองจักรพรรดิ-แดงชาดของ รวยเทพ168 ที่ค้างอยู่ในไฟล์นี้ (f0bb4e ffeccb e4021b
// 260d04 2b1400 fff8ec rgba 240/187/78 α) rgba 255/236/203 α) rgba 228/2/27 α))
// ชุดทองไทย-แดงมังกรของ รับตัง168 ก่อนหน้านั้น (f0b429 ffdc8c ff6b6e 140505 1a0505
// f5ece0) ชุดทองมังกรของ TND168 (dfa310 ffe4a3 ffc93d 140d02 f0e9dc) และชุดทอง
// อวกาศ-เงินโครเมียมของ NAZA168 (fbc134 ffe87a cf9a18 96690a cfd6e3 fdf3df 241700
// 231500) ถูกแทนครบทุกจุดแล้ว ทั้งในคลาสและใน rgba() — ⚠️ **ทองรอบนี้ #f0b46a มี R
// เท่ากับ f0bb4e ของรวยเทพ168 และ f0b429 ของรับตัง168 เป๊ะทั้งคู่** ต่างกันที่
// G180 vs G187 vs G180 และ B106 vs B78 vs B41 อย่าปล่อยของเก่าไว้เพราะ "ก็ทอง
// เหมือนกัน" ต้อง grep เป็นค่า
// (เฮกซ์ของแบรนด์เก่าเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §6): โปรดี168 เป็น **เว็บเกมสล็อตล้วน**
// บรีฟเขียนถึง **เกมสล็อต ค่ายเกม ลิขสิทธิ์ โปรโมชั่น และการสมัครสมาชิก** เท่านั้น ·
// คำว่า **หวย สลาก บาคาร่า รูเล็ต ยิงปลา ไฮโล แทงบอล คาสิโนสด และ เว็บตรง
// ไม่มีในบรีฟรอบนี้สักคำ จึงห้ามใส่** (รอบก่อนเป็นเว็บหวยเต็มตัว คำกลุ่มนั้นจึงเป็น
// ของค้างที่เสี่ยงที่สุด) · บรีฟไม่ได้เอ่ยชื่อค่ายเกมหรือชื่อธนาคารไว้สักชื่อ จึงห้าม
// ใส่ลงไป · ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง (0.3% · 0.8% · 3 ขั้นตอน · 24ชม. · ปี 2026)
// · คำกำกับของบรีฟที่ต้องคงไว้คือ "ควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการ
// จากหลักฐานทางการก่อนใช้งาน" และ "เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืน
// จากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป"

const {
  message = `${BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมรวบรวมข้อมูลค่ายเกม โปรโมชั่น และบริการสมาชิกไว้ในเว็บไซต์เดียว • ผู้ใช้งานสามารถศึกษารูปแบบเกม ฟีเจอร์พิเศษ และเงื่อนไขการเดิมพันก่อนเลือกใช้งานได้จากหน้าเว็บไซต์ • รายชื่อค่ายเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้ จึงควรตรวจสอบข้อมูลล่าสุดรวมถึงหลักฐานการได้รับอนุญาตจากเจ้าของเกมก่อนตัดสินใจ • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน ควรตรวจสอบก่อนว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และเครดิตจะเข้าบัญชีอัตโนมัติหรือต้องกดรับเอง • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ควรศึกษาวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบถ้วน • การสมัครสมาชิกมี 3 ขั้นตอน ควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องก่อนกรอกข้อมูล ตั้งรหัสผ่านที่ปลอดภัย และอ่านเงื่อนไขการเปิดบัญชีทุกครั้ง • ติดต่อเจ้าหน้าที่เรื่องการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่นได้ตลอด 24ชม. • ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น • ควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งานทุกครั้ง เพราะเครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f0b46a]/45 bg-[#2c1004]/95 shadow-[0_8px_20px_rgba(240,180,106,0.22)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(235,3,5,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f0b46a] to-[#d9803a] px-8 py-2.5 font-black text-[#1a0802] shadow-[4px_0_15px_rgba(235,3,5,0.35)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#2c1004] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#fff0e4]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#eb0305] shadow-[0_0_8px_rgba(235,3,5,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f0b46a] shadow-[0_0_8px_rgba(240,180,106,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
