---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// พาเลตต์ UWIN33 (ทอง-โครเมียม-ดำ 2026-09-24): แถบดำอมน้ำตาล #0a0702 ขอบทองแบรนด์
// #e0b429 ป้าย "ประกาศ" ไล่จากทองอ่อน #fde9a3 ผ่านทองสว่าง #fbd564 ลงทองบรอนซ์
// #b8860b ตัวหนังสือบนป้ายเป็นดำ #161106 เนื้อข่าว #ece6d8 จุดนำหน้าเป็นทอง
// #e0b429 กับเงินโครเมียม #dfe4ec ตามคู่สีในโลโก้ — เขียวมรกต #03140a/#1faa4e
// กับทอง #f3cf63 ของ HENG38 ที่เคยอยู่ในไฟล์นี้หายหมดแล้ว
const {
  message = "UWIN33 พนันเว็บตรงยอดนิยมอันดับ1 รวมเกมเดิมพันสำหรับนักเล่นชาวไทยไว้ในระบบเดียว ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย • เมนูแบ่งหมวดชัดเจน รองรับทั้งมือถือและคอมพิวเตอร์ เลือกเกมและจัดการบัญชีได้โดยไม่ต้องสลับหลายเว็บไซต์ • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ตรวจสอบยอดที่เข้าเกณฑ์ได้จากบัญชีสมาชิก • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% ดูรอบคำนวณและเงื่อนไขได้จากหน้าโปรโมชั่น • สมัครเองได้ใน 3 ขั้นตอน รับโปรโมชั่นที่เปิดให้สมาชิกได้ทันที • เจ้าหน้าที่ UWIN33 พร้อมดูแลผ่าน LINE OFFICIAL ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#e0b429]/45 bg-[#0a0702]/92 shadow-[0_8px_20px_rgba(224,180,41,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(251,213,100,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fde9a3] via-[#fbd564] to-[#b8860b] px-8 py-2.5 font-black text-[#161106] shadow-[4px_0_15px_rgba(224,180,41,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0702] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ece6d8]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#e0b429] shadow-[0_0_8px_rgba(224,180,41,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#dfe4ec] shadow-[0_0_8px_rgba(223,228,236,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
