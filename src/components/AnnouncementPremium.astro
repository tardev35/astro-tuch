---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// พาเลตต์ KOON234 (มรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2): แถบ
// เขียวเกือบดำ #020803 ขอบทองแบรนด์ #cc920a ป้าย "ประกาศ" ไล่จากทองซีด #fde9a6
// ผ่านทองแบรนด์ #cc920a ลงทองเข้ม #8a6204 ตัวหนังสือบนป้ายเป็นหมึกเขียวเข้ม
// #07170c (6.5:1 บนปลายที่เข้มที่สุด) เนื้อข่าว #e8f2e6 (BRAND_TEXT) จุดนำหน้า
// สองจุดเป็นทองสว่าง #f7d14e กับเขียวสว่าง #2fbf6a — โลโก้แบรนด์นี้เป็นคู่
// ทอง/มรกตจริง จุดคู่จึงต่างกันที่ "สี" ได้ ไม่ใช่แค่ความสว่าง · โทนทอง-เงินของ
// UOK365 (#0a0806 #c8912f #f5d98a #6d4412 #191005 #ece1cc #d8dbe0
// rgba(200,145,47,α) rgba(245,217,138,α) rgba(216,219,224,α)) ที่เคยค้างอยู่ใน
// ไฟล์นี้ถูกแทนครบทุกจุดแล้ว — ทองรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้
//
// ข้อความยึดตามบรีฟรอบนี้เท่านั้น (brand-spec §5 §6): เป็นเว็บพนันออนไลน์ที่รวม
// ช่องทางเข้าเล่นไว้ในระบบเดียว ไม่ใช่เว็บหวยและไม่ใช่เว็บสล็อตโดยเฉพาะ · บรีฟ
// ไม่ได้เอ่ยชื่อเกมหรือชื่อค่ายไว้สักชื่อ จึงห้ามใส่ลงไป · ไม่ระบุช่องทางไลน์
// (บรีฟพูดแค่ "ช่องทางบริการหลักที่เว็บไซต์กำหนด") · คำว่า "ปลอดภัยขึ้น 100%"
// ห้ามพูดลอยๆ เพราะบรีฟย้ำเองว่าใช้รับรองว่าไม่มีความเสี่ยงทั้งหมดไม่ได้ ·
// ตัวเลขที่ใช้ได้มีแค่ของบรีฟเอง (0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง)

const {
  message = `${BRAND_NAME} เว็บพนันฐานเล่นหลัก รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว รองรับทั้งมือถือและคอมพิวเตอร์ • ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว ไม่ต้องสลับหลายหน้าจอ • อัปเกรดระบบฝั่งสมาชิกตั้งแต่หน้าเข้าสู่ระบบ การจัดการบัญชี ไปจนถึงการตรวจสอบรายการ • ข้อความว่าปลอดภัยขึ้น 100% ใช้รับรองว่าไม่มีความเสี่ยงทั้งหมดไม่ได้ ควรตรวจสอบทางเข้าเว็บไซต์และรักษาข้อมูลบัญชีของตนเองทุกครั้ง • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสตามรอบที่กำหนด ตรวจเวลาตัดรอบและข้อกำหนดก่อนใช้งานโบนัส • โปรโมชั่นแนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ • สมัครผ่านมือถือได้ใน 3 ขั้นตอน เข้าสู่หน้าสมัคร กรอกและตรวจสอบข้อมูล แล้วยืนยันบัญชี • แอดมิน ${BRAND_NAME} ให้บริการตลอด 24 ชั่วโมง ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#cc920a]/45 bg-[#020803]/92 shadow-[0_8px_20px_rgba(204,146,10,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(247,209,78,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f7d14e] via-[#cc920a] to-[#8a6204] px-8 py-2.5 font-black text-[#07170c] shadow-[4px_0_15px_rgba(204,146,10,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#020803] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#e8f2e6]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f7d14e] shadow-[0_0_8px_rgba(247,209,78,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#2fbf6a] shadow-[0_0_8px_rgba(47,191,106,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
