---
// ค่า default ต้องเป็นคอปปี้ของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// แบบไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ห้ามมี emoji นำหน้าข้อความ เพราะ emoji ที่ฝัง
// อยู่ใน text prop ครอบ aria-hidden ไม่ได้ และ marquee เรนเดอร์ซ้ำสองรอบ
//
// พาเลตต์ HENG35 (ดำ-ทอง 2026-09-21): แถบดำ #070605 ขอบทองหลัก #ecc55c
// ป้าย "ประกาศ" ไล่จากทองสว่าง #fefac4 ลงทองบรอนซ์ #a3732c ตัวหนังสือบนป้าย
// เป็นดำ #0d0b0a เนื้อข่าว #ece1cb — แดง #2b0101 และทอง #f5b70a ของแบรนด์
// ก่อนหน้าที่เคยอยู่ในไฟล์นี้หายหมด
const {
  message = "HENG35 สมัครสล็อตยูสใหม่ ไม่ล็อคยูส รับโบนัสฝากแรกตามเงื่อนไขที่กำหนด • รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว จัดหมวดเกมชัดเจน ค้นหาเกมที่ต้องการได้จากหน้าเดียว • โปรโมชั่นคืนยอดเสีย 0.3% ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ได้จากหน้าโปรโมชั่น • โปรโมชั่นแนะนำเพื่อน 0.8% ตรวจสอบยอดสิทธิ์และรายละเอียดโบนัสได้จากบัญชีสมาชิก • รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ฝากถอนไม่จำกัด • แอดมิน HENG35 พร้อมให้บริการตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#ecc55c]/45 bg-[#070605]/92 shadow-[0_8px_20px_rgba(236,197,92,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(236,197,92,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] px-8 py-2.5 font-black text-[#0d0b0a] shadow-[4px_0_15px_rgba(236,197,92,0.32)]">
      <span aria-hidden="true" class="mr-2 text-lg">🔔</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#070605] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ece1cb]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ecc55c] shadow-[0_0_8px_rgba(236,197,92,0.7)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#fefac4] shadow-[0_0_8px_rgba(254,250,196,0.7)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
