---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ABM96 (ดรอป 2026-10-29 · รอบชมพูบานเย็นนำ ทองอำพันรอง **เนื้อหาสว่าง โครมเข้ม**
// บนพื้นเพจชมพูพาสเทล #f8b9f0):
// footer ที่ใช้งานจริงรอบนี้ หมุนมาจาก FooterHuay ของ LOTTOPLUS — ไฟล์นั้นมี
// คอลัมน์ "ทางลัดหน้าเว็บ" ที่ลิงก์หน้าหวยโดยเฉพาะ ไฟล์นี้เป็นคนละทรงชัดเจน:
// **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ** พร้อมตารางเส้นพื้นหลัง
// กริด 12 คอลัมน์แบ่ง 5/3/4 และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** —
// ไม่ใช่เพราะอยากได้ธีมไซเบอร์พังก์
// **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนกลับเข้ามา** และห้ามใส่
// ภาษาซามูไร (ดาบคาทานะ · กอไผ่ · วงพู่กันหมึก) ของ ZORO365 หรือภาษาอวกาศ
// (ดาวพร่าง นักบินอวกาศ) ของ นาซ่า168 หรือภาษานีออนคาสิโนม่วง-แมเจนต้า
// (ตู้สล็อต 777 ผิวแก้วม่วง · เพชรม่วง · ประกายดาวสี่แฉก) ของ ZANE96
// ซึ่งเป็นสามเจ้าของก่อนหน้าของไฟล์นี้
// รอบนี้ภาษาภาพคือ **ชมพูหวาน: เวิร์ดมาร์กตัวอ้วนมนขาว-ชมพูที่มีหัวใจในตัว A ·
// มาสคอตลูกหมูการ์ตูนชมพูในจานวงกลม · หัวใจชมพูสามมิติ · โบว์ริบบิ้นซาติน ·
// ไพ่เอซ · ลูกเต๋าชมพูจุดขาว · ชิปคาสิโนชมพู-ขาว · วงล้อรูเล็ตขอบทอง ·
// แถบแคปซูลพื้นชมพูบานเย็นขอบทอง**
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน ZORO365 โทนเขียวมรกตนีออน (3ddc4a 1e7033 35a043
// 031b09 0e5424 eef7f0 e8c86a 073c1a 002908 dfe6e3 9dc2a5 23823a 010d04)
// ก่อนหน้านั้น ZANE96 ไวโอเลตนีออน-ฟ้าอิเล็กทริก (bb6dff 7aa7ff 5411c4 5b2f9e
// 190b3d 271257 f3e8ff 2f1766 c2178b) นาซ่า168 ฟ้าไซยาน-น้ำเงินอุลตรามารีน
// (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 33455f 121722 1b2434 273449 0d1017)
// ยูฟ้า168 ทองคานารี-โครเมียมเงิน (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf
// 78828f 5a6472 0a0908 1e1a13 eae3d4) รวยแท้168 แดงเลือดหมู-ทองโบราณ (c30303
// 8f0505 dcb95f 96681f 280b0b 461212 ffeee8) นินจา168 ฟ้าไซยาน-เหลืองมะนาว
// (32bcfb a9e9ff fef54b 07335f 6b5c10 030e16 071a28 dceefc) ถอนชัวร์168
// ชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5)
// WEPLAY168 ม่วงนีออน และ BOOM369 เขียวนีออน — ทั้งเก้าชุดถอดออกครบแล้ว
// 🚨🚨 **ถอนชัวร์168 เป็นแบรนด์ชมพูเหมือนรอบนี้** และเคยถือไฟล์นี้มาก่อน —
// `fa63b9` ↔ #e0509f · `ffb3de` ↔ #f3a7d3 · `6d0b3f` ↔ #440d31 ·
// `ffd84d` ↔ #f2c14e · `6b4708` ↔ #6e4705 **ทุกคู่ใกล้กันจนตาเปล่าแยกไม่ออก
// ต้องเทียบหกหลัก**
// ข้อความของ ZORO365 (เกมคาสิโนสายตรง · ถูกลิขสิทธิ์ · ไม่ผ่านเว็บตัวแทน ·
// บาคาร่า สล็อต หวย บอล ไฮโล) ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน ไม่ใช่
// find-and-replace ทับประโยคเดิม 🚨 **"เว็บตรง" "ถูกลิขสิทธิ์" "ไม่ผ่านเว็บตัวแทน"
// "หวย" "บอล" ไม่มีในบรีฟรอบนี้เลยสักคำ — ห้ามเขียนกลับเข้ามา**
//
// พาเลตต์ตาม .claude/brand-spec-abm96.md §2 (โซน "โครม"):
// ชมพูบานเย็น #e0509f (ขอบ เส้นคั่น หัวคอลัมน์ สี hover แสงรอบโลโก้) ·
// ทองอำพัน #f2c14e (จุดนำหน้า/เน้นรอง — มาจากขอบแคปซูลและวงล้อรูเล็ตในอาร์ตเวิร์ก) ·
// ชมพูเข้ม #a30d63 และชมพูสว่าง #ff7ac2 เป็นพื้นถม/เส้นตารางพื้นหลังเท่านั้น ·
// พื้นแผ่น #2b0620 · พื้นถมป้าย #5e1746 · เนื้อความ #ffeef8
// ⚠️ #e0509f บน #2b0620 ได้ ≈ 6.6:1 และบนป้าย #5e1746 ได้ ≈ 4.6:1 จึงถือตัวอักษร
// ได้จริงในไฟล์นี้ (ต่างจากบนการ์ดขาวซึ่งมันตก 3.6:1) · #f2c14e บน #2b0620
// ได้ ≈ 12.4:1 · #ffeef8 ได้ ≈ 18.7:1
// ส่วน **#a30d63 ได้ ≈ 1.8:1 บน #2b0620 = ขอบ/เส้น/พื้นถมเท่านั้น ห้ามถือตัวอักษร**
// ⚠️⚠️ **กับดักของรอบนี้คือไฟล์นี้เพิ่งเป็นเขียวทั้งใบ ซึ่งเป็น "คนละตระกูลสี"
// จึงมองออกง่าย** — ตัวที่มองไม่ออกคือชมพูของ ถอนชัวร์168 และ okkub88
// ให้เทียบเป็นค่าทีละตัวหกหลัก ไม่ใช่ด้วยตา:
// ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b d91a73 b01160
// 85094a fc4da1 (okkub88 — **เสี่ยงสูงสุดรอบนี้ เป็นแบรนด์ชมพูเหมือนกัน**
// ⚠️ **d91a73 ↔ #d11a7e และ 9c0f55 ↔ #a30d63 และ fb439b ↔ #e0509f
// และ f9b2d9 ↔ #f3a7d3 ใกล้กันทุกคู่**)
// และชมพู/แดงของแบรนด์อื่น: a30d1a c21325 8a1420 36080f 6b2b33 f7e4e9 fdf5f6
// f7dfe4 eec3cc d98fa0 dca53a 1c050b ef4a5e (123BET ⚠️ **a30d1a ↔ #a30d63
// ต่างกันสองหลักท้าย**) · c1071b b00718 8a0412 e9b53c 24060c fff0f0 ffe4e6
// ffd4d7 f5b9bd (LOTTO189) · de2b1e f2a033 a81410 (MEXICANOSLOT) ·
// 7505cc b453ff c07cff (KMD88) · d946ef a855f7 (CEO66) — **ต้องไม่เหลือเลยสักค่า**
// และของ LOTTOPLUS แบรนด์ขาออกทันที: 046c4e 0d3326 3f6f5c 19a97c 2fd49b a3ddc3
// d2f3e4 e1fef3 f0fdf7 052e22 03201a 0a4433 e2b32a c8d4d0 e9fbf3 0c7c58 03543c
// — **รอบนี้ไม่มีเขียว ม่วง ฟ้า ไซแอน ส้ม แดงชาด เลยสักเฉด**
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// ⚠️ รอบนี้แบรนด์เป็นชมพู จึงไม่มีความเสี่ยงที่จะ "รวบ" ปุ่ม LINE เข้าพาเลต
// เหมือนรอบก่อนที่แบรนด์เป็นเขียว แต่กฎเดิมยังอยู่: ปุ่มนั้นต้องเป็นเขียว LINE
// ค่าเดิมเสมอ เพราะมันคือสีของแบรนด์ LINE ไม่ใช่ของแบรนด์นี้
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง ไม่อยู่ในลิสต์นี้** — รอบนี้ ABM96 เป็นเว็บคาสิโน
// และบรีฟ **ไม่มีคำว่า "หวย" เลยสักคำ** (ต่างจากรอบก่อนที่ทั้งเว็บคือหวย)
// สองหน้านั้นถูกย้ายกลับไปจอดใน src/pages-disabled/ แล้ว จึงไม่มี route จริง
// **ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด (คนมักดูแค่ navbar) และ dead href จะทำให้
// verify-build แดง — ห้ามใส่กลับจนกว่าจะมีแบรนด์หวยรอบใหม่ที่ย้ายไฟล์กลับเข้ามา**
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// 🚨🚨 **BankStrip ไม่ได้ถูก render ในไฟล์นี้** และห้ามใส่กลับเข้ามา เพราะบรีฟ
// รอบนี้ (src/assets/content.txt) **ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลย
// แม้แต่คำเดียว** — แถบโลโก้ธนาคารคือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มี
// อะไรในบรีฟรองรับ ไฟล์ BankStrip.astro ยังอยู่บนดิสก์ในฐานะ inventory ไม่ได้ถูกลบ
// ✅ **นี่คือเหตุผลหลักที่เลือก FooterCyber รอบนี้** — มันเป็นหนึ่งในสอง footer
// ที่ไม่ import BankStrip มาเอง (อีกตัวคือ FooterPremiumSumo) จึงไม่ต้องถอดด้วยมือ
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// เว็บเอเอ็มบีคาสิโน · แหล่งเดิมพันเกมออนไลน์ · บาคาร่า · สล็อตออนไลน์ · รูเล็ต ·
// ไฮโล · คาสิโนสดถ่ายทอดแบบเรียลไทม์ · เริ่มต้น 1 บาท · ไลฟ์ 24 ชั่วโมง ·
// ระบบสมาชิก · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24ชม. —
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนเกม
// หรือค่า RTP เป็นตัวเลข** จึงไม่มีในไฟล์นี้
// ตัวเลขที่อ้างได้รอบนี้มี 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. เท่านั้น
// ⚠️ **ไม่มี "100%"** · **"เว็บตรงไม่ผ่านเอเย่นต์" เป็นคำของ ZANE96 ห้ามใช้** ·
// **"ไม่ผ่านเว็บตัวแทน" เป็นคำของ ZORO365 ห้ามใช้** · **"เซิร์ฟนอก" เป็นคำของ
// TEVA69 ห้ามใช้** อย่าสืบทอดคำอนุญาตข้ามรอบ
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
//
// ⚠️ widths/sizes ของโลโก้คิดจากบิตแมปจริงของดรอปนี้ ซึ่งเป็น **500x500 จัตุรัส**
// — โลโก้จัตุรัสที่สูง 60px ถูกวาดกว้างแค่ 60px (รอบก่อนไฟล์นี้ขอ 160px เพราะ
// โลโก้ของแบรนด์นั้นเป็นเวิร์ดมาร์กแนวนอน) **ห้ามลอกตัวเลขข้ามดรอป**
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตราทรงกลมพื้นชมพูอ่อนขอบขาวหนา ด้านบนของวงเป็นมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพูอ่อน หูตกสองข้าง แก้มแดงระเรื่อ ขยิบตาข้างขวาและยิ้มอ้าปาก เอาสองขาหน้าเกาะขอบวงกลมโผล่ขึ้นมา ด้านล่างของวงเป็นข้อความตัวอักษรละตินสามมิติอ้วนมน ${BRAND_NAME} ผิวไล่จากขาวนวลลงมาหาชมพูอ่อน ตัดขอบสีชมพูเข้มหนาสองชั้น โดยตัวอักษร A มีหัวใจสีชมพูดวงเล็กซ้อนอยู่ในช่องกลางตัวอักษร รอบตราวงกลมมีหัวใจสีชมพูสามมิติผิวมันเงาลอยประดับอยู่ทั้งซ้ายและขวา`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#e0509f]/45 bg-[#2b0620] pt-16 pb-8 font-sans text-[#ffeef8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#a30d63 1px, transparent 1px), linear-gradient(90deg, #e0509f 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[60, 120, 180]}
                sizes="60px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(224,80,159,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#e0509f]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e0509f]/70 pl-4 text-sm leading-relaxed text-[#ffeef8]/80">
          {BRAND_NAME} เว็บเอเอ็มบีคาสิโน รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว ทั้งบาคาร่า สล็อตออนไลน์ รูเล็ต ไฮโล และคาสิโนสดที่มีการถ่ายทอดเกมแบบเรียลไทม์
