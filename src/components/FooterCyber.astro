---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// /ตรวจหวย and /แนวทาง are NOT listed: this is a casino brand, so those two pages
// sit in src/pages-disabled/ and the routes do not exist. Linking them here
// would be a dead href, which verify-build.mjs fails the build on.
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#5cc23f]/30 bg-[#040d04] pt-16 pb-8 font-sans text-[#d4e8cb]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(#0f3d0d 1px, transparent 1px), linear-gradient(90deg, #1d6b18 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ YADOM168 ตัวอักษร YADOM สีขาวโครเมียมขอบเขียว วางเหนือเลข 168 สีเขียวสด ด้านบนเป็นตู้สล็อตขึ้นเลข 777 สีเขียว"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(92,194,63,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f2fbef]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#5cc23f]/70 pl-4 text-sm leading-relaxed text-[#d4e8cb]/80">
          {BRAND_NAME} ให้บริการเกมสล็อตออนไลน์ที่รวมเกมจากหลายค่ายไว้ในบัญชีเดียว พร้อมระบบออโต้สำหรับจัดการเครดิต ฝากถอน และตรวจสอบรายการ สมาชิกเลือกเกม รับโปรโมชั่น และติดตามสถานะบัญชีได้ด้วยตัวเอง รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#5cc23f]/45 bg-[#0f3d0d] px-3 py-1 font-mono text-xs text-[#8fe06f]">AUTO_BET_1B</span>
          <span class="border border-[#e6bd5c]/45 bg-[#0f3d0d] px-3 py-1 font-mono text-xs text-[#e6bd5c]">ADMIN_24H</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f2fbef] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#d4e8cb]/80">
          <li><a href="/" class="transition-colors hover:text-[#8fe06f]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#8fe06f]">&gt; โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#8fe06f]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#8fe06f]">&gt; เข้าสู่ระบบ</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#8fe06f]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#8fe06f]">&gt; ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#8fe06f]">&gt; เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#8fe06f]">&gt; ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f2fbef] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#e6bd5c]/60 bg-transparent py-3 font-bold text-[#e6bd5c] transition-all hover:bg-[#0f3d0d]/70"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#d4e8cb]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#5cc23f]/25 pt-6 font-mono text-xs text-[#d4e8cb]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#8fe06f]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#8fe06f]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
