---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ZORO365 (รอบเขียวมรกตนำ-เงินโครเมียมรอง · **มืดทั้งเว็บ**):
// footer ที่ใช้งานจริงรอบนี้ หมุนมาจาก FooterStyle2 ของ TEVA69 —
// ไฟล์นั้นเป็นแผ่นแบน ขอบบนเป็นเส้นหนา 3px ไม่มีมุมมนและไม่มีการ์ดลอย
// กริด 4 คอลัมน์เท่ากัน ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบน
// เป็นหลังคาแหลมกลางจอ** พร้อมตารางเส้นพื้นหลัง กริด 12 คอลัมน์แบ่ง 5/3/4
// และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** และเพราะ
// **ขอบบนแหลมอ่านเป็นสันหลังคาแบบญี่ปุ่น** ซึ่งเข้ากับภาษาภาพกิโมโน/ไผ่/คาทานะ
// ของแบรนด์นี้ — ไม่ใช่เพราะอยากได้ธีมไซเบอร์พังก์
// **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนกลับเข้ามา** และห้ามใส่
// ภาษาอวกาศ (ดาวพร่าง นักบินอวกาศ ดวงจันทร์) ของ นาซ่า168 หรือภาษานีออนคาสิโน
// ม่วง-แมเจนต้า (ตู้สล็อต 777 ผิวแก้วม่วง · ชิปคาสิโนแมเจนต้า · เพชรม่วง ·
// ประกายดาวสี่แฉก) ของ ZANE96 ซึ่งเป็นสองเจ้าของก่อนหน้าของไฟล์นี้
// รอบนี้ภาษาภาพคือ **ซามูไร: เวิร์ดมาร์กโครเมียมเงิน + ตัวเลขเขียวมรกตเรืองแสง ·
// วงพู่กันหมึกดำ-เขียว · ดาบคาทานะ · กอไผ่และดอกไม้ขาว · ชิปคาสิโนเขียว-ขาว ·
// แคปซูลพื้นดำขอบทอง**
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน ZANE96 โทนไวโอเลตนีออน-ฟ้าอิเล็กทริก (bb6dff 7aa7ff
// 5411c4 5b2f9e 190b3d 271257 f3e8ff 2f1766 c2178b) ก่อนหน้านั้น นาซ่า168
// ฟ้าไซยาน-น้ำเงินอุลตรามารีน (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 33455f
// 121722 1b2434 273449 0d1017) ยูฟ้า168 ทองคานารี-โครเมียมเงิน (fee45d e6a416
// b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 0a0908 1e1a13 eae3d4) รวยแท้168
// แดงเลือดหมู-ทองโบราณ (c30303 8f0505 dcb95f 96681f 280b0b 461212 ffeee8)
// นินจา168 ฟ้าไซยาน-เหลืองมะนาว (32bcfb a9e9ff fef54b 07335f 6b5c10 030e16
// 071a28 dceefc) ถอนชัวร์168 ชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de ffd84d 0d040a
// 1a0914 6d0b3f 6b4708 fdeaf5) WEPLAY168 ม่วงนีออน และ BOOM369 เขียวนีออน —
// ทั้งแปดชุดถอดออกครบแล้ว
// ข้อความของ ZANE96 (รวมเกมสล็อตจากค่ายเกมหลากหลายแบรนด์ · ค่า RTP และความผันผวน ·
// เว็บตรงไม่ผ่านเอเย่นต์ · ยูสใหม่เล่น 1 บาท) ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// พาเลตต์ตาม .claude/brand-spec-zoro365.md §2 (โซน "โครม"):
// เขียวมรกตนีออน #3ddc4a (ขอบ เส้นคั่น หัวคอลัมน์ สี hover แสงรอบโลโก้) ·
// ทองอำพัน #e8c86a (จุดนำหน้า/เน้นรอง — มาจากขอบแคปซูลในอาร์ตเวิร์ก) ·
// เขียวเข้ม #1e7033 และ #35a043 เป็นพื้นถม/เส้นตารางพื้นหลังเท่านั้น
// **ไม่ถือตัวอักษรบนผิวเข้มนี้** · พื้นแผ่น #031b09 · พื้นถมป้าย #0e5424 ·
// เนื้อความ #eef7f0
// ⚠️ #3ddc4a บน #031b09 ได้ ≈ 9.9:1 และบนป้าย #0e5424 ได้ ≈ 5.5:1 จึงถือตัวอักษร
// ได้จริง · #e8c86a บน #031b09 ได้ ≈ 11.5:1 · #eef7f0 ได้ ≈ 16.8:1
// ส่วน **#1e7033 ได้ ≈ 2.1:1 บน #031b09 = ขอบ/เส้น/พื้นถมเท่านั้น ห้ามถือตัวอักษร**
// และ **#35a043 ได้ ≈ 3.5:1 = เส้น/ขอบ/ออราเท่านั้นเช่นกัน**
// ⚠️⚠️ **กับดักของรอบนี้คือรอบก่อนทันที (TEVA69) ก็เป็นแบรนด์เขียว/เงินโครเมียม
// เหมือนกันเป๊ะ ต่างกันแค่กลับทิศสว่าง-มืด** — การเจอ "เขียว" หรือ "เทาเงิน"
// ในไฟล์นี้จึงไม่พิสูจน์อะไร ให้เทียบเป็นค่าทีละตัวหกหลัก ไม่ใช่ด้วยตา:
// 28c437 116018 1a7d24 0b4a12 3f7a2e 2d6b2f 0b2a12 15401d 051409 c6cfd2 e8fbe4
// b4d6ad e3bb45 f0ffeb e6f7df d7f0cd b2dba3 10280f 3c5b36 8a6a0e (TEVA69 —
// **เสี่ยงหลงเหลือสูงสุด** ⚠️ **e8fbe4 ↔ #eef7f0 และ c6cfd2 ↔ #dfe6e3 และ
// e3bb45 ↔ #e8c86a และ 28c437 ↔ #3ddc4a ใกล้กันทุกคู่**)
// และเขียวของแบรนด์เก่ากว่า: 8ce023 e9f7d6 bde397 1a5c04 2f8c07 a87a08 f2c230
// ffe066 (KINGKONG555 ⚠️ **bde397 ↔ #9dc2a5 · 1a5c04 ↔ #1e7033**) · 0b7d28
// 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168 ⚠️ **0c3a16 ↔ #073c1a ต่างหลักเดียว**) ·
// 1fae1c 0d2312 143a1c 07130a (888PARUAY) · 117a41 2bb061 (MEXICANOSLOT) ·
// 2fbf6a (KOON234) — **ต้องไม่เหลือเลยสักค่า**
// และฟ้า/ม่วง/ชมพู/แดงของแบรนด์อื่นก็ต้องกวาดเช่นกัน: 60a5fa 00f3ff 7e22ce
// d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88) ·
// d91a73 fb439b fc4da1 9c0f55 85094a (okkub88) · de2b1e f2a033 a81410 c81e12
// 2b100a 431a10 fdeee2 e8c6ae (MEXICANOSLOT) · b00718 c1071b e9b53c 24060c
// (LOTTO189) — **รอบนี้ไม่มีม่วง ฟ้า ไซแอน ชมพู แมเจนต้า แดง เลยสักเฉด**
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// ⚠️⚠️ **รอบนี้แบรนด์เป็นสีเขียวด้วย ซึ่งทำให้เผลอ "รวบ" ปุ่ม LINE เข้าพาเลต
// ได้ง่ายกว่าทุกรอบที่ผ่านมา — ห้ามเปลี่ยนเป็น #3ddc4a เด็ดขาด** ปุ่มนั้นต้อง
// เป็นเขียว LINE ค่าเดิมเสมอ เพราะมันคือสีของแบรนด์ LINE ไม่ใช่ของแบรนด์นี้
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง ไม่อยู่ในลิสต์นี้** — รอบนี้ ZORO365 เป็นเว็บคาสิโน
// และบรีฟเอ่ยคำว่า "หวย" แค่ในฐานะหนึ่งในห้าหมวดเกม (บาคาร่า สล็อต หวย บอล ไฮโล)
// ไม่ใช่แกนของเว็บ สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง
// **ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด (คนมักดูแค่ navbar) และ dead href จะทำให้
// verify-build แดง — ห้ามใส่กลับจนกว่าจะมีแบรนด์หวยรอบใหม่ที่ย้ายไฟล์กลับเข้ามา**
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// 🚨🚨 **BankStrip ไม่ได้ถูก render ในไฟล์นี้** และห้ามใส่กลับเข้ามา เพราะบรีฟ
// รอบนี้ (src/assets/content.txt) **ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลย
// แม้แต่คำเดียว** — แถบโลโก้ธนาคารคือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มี
// อะไรในบรีฟรองรับ ไฟล์ BankStrip.astro ยังอยู่บนดิสก์ในฐานะ inventory ไม่ได้ถูกลบ
// ✅ **นี่คือเหตุผลหลักที่เลือก FooterCyber รอบนี้** — มันเป็นหนึ่งในสอง footer
// ที่ไม่ import BankStrip มาเอง (อีกตัวคือ FooterPremiumSumo) จึงไม่ต้องถอดด้วยมือ
// เหมือนที่รอบก่อนต้องทำกับ FooterStyle2
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// เกมคาสิโนสายตรง · รวมเกมเดิมพันออนไลน์ · ถูกลิขสิทธิ์ · ไม่ผ่านเว็บตัวแทน ·
// บาคาร่า สล็อต หวย บอล ไฮโล · ระบบสมาชิก · โปรโมชั่น · ช่องทางติดต่อเจ้าหน้าที่ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24ชม. —
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนเกม
// หรือค่า RTP เป็นตัวเลข** จึงไม่มีในไฟล์นี้
// ตัวเลขที่อ้างได้รอบนี้มี 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. เท่านั้น
// ⚠️ **ไม่มี "100%" และไม่มี "1 บาท"** · **"เว็บตรงไม่ผ่านเอเย่นต์" เป็นคำของ
// ZANE96 ห้ามใช้รอบนี้** — บรีฟรอบนี้ใช้คำว่า **"ไม่ผ่านเว็บตัวแทน"** ซึ่งคนละคำ
// และ **"เซิร์ฟนอก" เป็นคำของ TEVA69 ห้ามใช้เช่นกัน** อย่าสืบทอดคำอนุญาตข้ามรอบ
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กสามมิติที่ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงาเรืองแสง ทุกตัวตัดขอบสีดำหนาและมีแสงสะท้อนสีขาวพาดอยู่ด้านบน วางทับวงพู่กันหมึกสีดำและเขียวที่มีรอยสะบัดสีกระเด็นอยู่รอบวง โดยมีดาบคาทานะเล่มหนึ่งปักตั้งผ่ากลางวง ด้ามพันเชือกสีเขียวและปลายใบมีดชี้ขึ้น ด้านล่างของวงมีควันสีเขียวเรืองแสงลอยขึ้นมา`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#3ddc4a]/45 bg-[#031b09] pt-16 pb-8 font-sans text-[#eef7f0]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#1e7033 1px, transparent 1px), linear-gradient(90deg, #35a043 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(61,220,74,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#3ddc4a]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#3ddc4a]/70 pl-4 text-sm leading-relaxed text-[#eef7f0]/80">
          {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายหมวดหมู่ไว้ในเว็บไซต์เดียว ทั้งบาคาร่า สล็อต หวย ฟุตบอล และไฮโล พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น
          และช่องทางติดต่อเจ้าหน้าที่ ผู้ใช้งานสามารถศึกษากติกาเกม รูปแบบการเดิมพัน และอัตราจ่ายของแต่ละหมวดได้จากเว็บไซต์ รวมถึงควรตรวจสอบวงเงินเดิมพันขั้นต่ำและสูงสุด
          และข้อกำหนดการถอนเงินก่อนทำรายการ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นคาสิโนสายตรง เกมถูกลิขสิทธิ์ หรือการจ่ายเต็มไม่มีโกง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาต
          จากแหล่งที่เชื่อถือได้ เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#35a043] bg-[#0e5424] px-3 py-1 text-xs font-bold text-[#eef7f0]">แอดมิน 24ชม.</span>
          <span class="border border-[#3ddc4a]/50 bg-[#0e5424] px-3 py-1 text-xs font-bold text-[#3ddc4a]">คืนยอดเสีย 0.3%</span>
