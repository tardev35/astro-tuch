---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ยูฟ้า168 (รอบทองคานารีนำ-โครเมียมเงินรอง บน **ธีมมืด** 2026-10-22): footer ที่ใช้
// งานจริงรอบนี้ หมุนมาจาก FooterPremiumSumo ของ โปรดี168 — ไฟล์นั้นเป็นแผ่นโค้งมน
// ซ้อนชั้น ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลม
// กลางจอ** พร้อมตารางเส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** ไม่ใช่เพราะ
// ธีมไซเบอร์ — **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออนกลับเข้ามา**
// และห้ามใส่ภาษานินจา (ชูริเคน ผ้าคาดหัว ใบมีด) ซึ่งเป็นของเจ้าของเดิมของไฟล์นี้
// รอบนี้ภาษาภาพคือ **สนามฟุตบอลกลางคืน ทองอร่าม และโครเมียมเงิน**
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน รวยแท้168 โทนแดงเลือดหมู-ทองโบราณบนธีมสว่าง (c30303
// 8f0505 dcb95f 96681f 280b0b 461212 ffeee8) ก่อนหน้านั้น นินจา168 ฟ้าไซยาน-เหลือง
// มะนาว (32bcfb a9e9ff fef54b 07335f 6b5c10 030e16 071a28 dceefc) ถอนชัวร์168
// ชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5)
// WEPLAY168 ม่วงนีออน และ BOOM369 เขียวนีออน — ทั้งห้าชุดถอดออกครบแล้ว
// ข้อความของ รวยแท้168 (หวยรัฐบาลไทย · ลาวพัฒนา · ฮานอย · หวยหุ้นต่างประเทศ ·
// อัตราจ่าย 2 ตัว 100 · บริษัทแม่) ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ⚠️⚠️ **ufalion168 (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304) และ
// UFA324 (e5a81b ffe08a bb8410 7d5a07 8792a0 b9c2cc f0e8d4 464f5a) เป็นลูกค้าคนละ
// เจ้าที่ชื่อใกล้รอบนี้ที่สุด และเป็นแบรนด์แนวบอลเหมือนกัน** — ชุดทองของทั้งสองตัว
// ห้ามปนเข้ามาเด็ดขาด และห้ามสับสนว่าเป็นลูกค้าเดียวกัน
//
// พาเลตต์ตาม .claude/brand-spec-ufabet168.md §2 (โซน "โครม"):
// ทองกลาง #e6a416 (ขอบ เส้นคั่น จุดนำหน้า) · ทองนำ #fee45d (หัวคอลัมน์ สี hover
// แสงรอบโลโก้) · ทองมืด #7a4e05 และโครเมียมมืด #5a6472 เป็นเส้นตารางพื้นหลังเท่านั้น
// ไม่ถือตัวอักษร · พื้นแผ่น #0a0908 · พื้นถมป้าย #1e1a13 · เนื้อความ #eae3d4
// ⚠️ #fee45d บน #0a0908 ได้ ≈ 15.6:1 และบนป้าย #1e1a13 ได้ ≈ 13.6:1 จึงถือตัวอักษร
// ได้จริง ส่วน **#7a4e05 ได้ ≈ 2.4:1 บน #0a0908 = ขอบ/เส้น/เงาเท่านั้น
// ห้ามถือตัวอักษร** และ **#5a6472 ได้ ≈ 3.3:1 = เส้น/ขอบเท่านั้นเช่นกัน**
// ⚠️⚠️ **กับดักรอบนี้คือทอง ซึ่งเป็นฮิวที่ผ่านรีโปนี้มาเกือบทุกแบรนด์** — dcb95f
// b8862b (รวยแท้168) f0b46a b44c06 (โปรดี168 รอบก่อน) fcd45c (มีเฮ168) f0b429
// (รับตัง168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) fef54b
// (นินจา168) e5a81b (UFA324) d39c45 (ufalion168) — การเจอทองในไฟล์นี้จึงไม่พิสูจน์
// อะไร ทองรอบนี้คือ **#fee45d** ให้เทียบเป็นค่าทีละตัว ไม่ใช่ด้วยตา
// ⚠️ และรอบก่อน (โปรดี168) เป็นแดงเชอร์รี่-ทองแดงไหม้ (eb0305 9b0a0c ff4446 c20305
// b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 401107) ซึ่งต้อง
// ไม่เหลือในไฟล์นี้เลยสักค่า
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// **ห้ามเปลี่ยนเป็นทองของแบรนด์**
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง ถูกลบออกจากลิสต์แล้วรอบนี้** — ไฟล์นี้ ship มาพร้อม
// สองลิงก์นั้นจากรอบ รวยแท้168 ซึ่งเป็นเว็บหวยล้วน รอบนี้ยูฟ้า168 เป็นเว็บพนัน
// แทงบอล/สล็อต/บาคาร่า สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง
// **ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด (คนมักดูแค่ navbar) และ dead href จะทำให้
// verify-build แดง — ห้ามใส่กลับจนกว่าจะมีแบรนด์หวยรอบใหม่ที่ย้ายไฟล์กลับเข้ามา**
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// ⚠️ **BankStrip ถูกถอดออกจากไฟล์นี้รอบนี้** พร้อมบรรทัด "ธนาคารและวอลเล็ตที่รองรับ"
// เพราะบรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารหรือวอลเลทแม้แต่รายเดียว** — แถบโลโก้
// ธนาคารคือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มีอะไรในบรีฟรองรับ
// ไฟล์ BankStrip.astro ยังอยู่บนดิสก์ในฐานะ inventory ไม่ได้ถูกลบ
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// ฐานหลักเว็บพนันออนไลน์ · แทงบอล สล็อต บาคาร่า · เว็บตรง100% ไม่ผ่านม้า ·
// ฝากถอนไม่จำกัด ไม่มีขั้นต่ำ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24ชม. —
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ชื่อวอลเลท ยอดฝากขั้นต่ำ
// หรือจำนวนสมาชิกที่ยืนยันได้** จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้รอบนี้มี
// 0.3% · 0.8% · 100% · 24ชม. เท่านั้น
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นลูกฟุตบอลลายขาว-ดำขอบทอง มีหางวงโคจรสีทองโค้งพาดอยู่ด้านหลัง ถัดมาเป็นคำว่า ยูฟ้า ตัวอักษรไทยหนาสามมิติผิวมันวาวสีทองอร่าม ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติผิวโครเมียมเงินสะท้อนแสง`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#e6a416]/45 bg-[#0a0908] pt-16 pb-8 font-sans text-[#eae3d4]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#7a4e05 1px, transparent 1px), linear-gradient(90deg, #5a6472 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(254,228,93,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#fee45d]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e6a416]/70 pl-4 text-sm leading-relaxed text-[#eae3d4]/80">
          {BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว ทั้งแทงบอล สล็อตออนไลน์ และบาคาร่า พร้อมรายละเอียดเมนูสมัครสมาชิก รายการฝากถอน และโปรโมชั่นที่เปิดให้ตรวจสอบ
          ผู้ใช้งานควรตรวจสอบยอดขั้นต่ำ ชื่อบัญชีรับเงิน และเงื่อนไขของแต่ละรายการก่อนทำธุรกรรมทุกครั้ง ส่วนข้อมูลเกี่ยวกับการเป็นเว็บตรงหรือการเชื่อมต่อค่ายเกมโดยตรงควรตรวจสอบจากหลักฐานของผู้ให้บริการ
          เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#a8b2bf]/50 bg-[#1e1a13] px-3 py-1 text-xs font-bold text-[#e8ecf1]">แอดมิน 24ชม.</span>
          <span class="border border-[#e6a416]/50 bg-[#1e1a13] px-3 py-1 text-xs font-bold text-[#fee45d]">คืนยอดเสีย 0.3%</span>
          <span class="border border-[#e6a416]/50 bg-[#1e1a13] px-3 py-1 text-xs font-bold text-[#fee45d]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#e6a416]/30 pb-2 text-base font-black tracking-widest text-[#fee45d]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#eae3d4]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#fee45d]">
                  <span aria-hidden="true" class="text-[#e6a416]">
                    ✦
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#e6a416]/30 pb-2 text-base font-black tracking-widest text-[#fee45d]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#a8b2bf]/60 bg-transparent py-3 font-bold text-[#e8ecf1] transition-all hover:bg-[#5a6472]/35 hover:text-[#ffffff]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e6a416]/25 pt-6 text-xs text-[#eae3d4]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fee45d]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fee45d]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
