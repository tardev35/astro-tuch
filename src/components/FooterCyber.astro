---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// นินจา168 (รอบฟ้าไซยานนำ-เหลืองมะนาวรอง บนดำสนิท 2026-10-19): footer ที่ใช้งาน
// จริงรอบนี้ หมุนมาจาก FooterStyle2 ของ สบายเบท168 — ไฟล์นั้นเป็นแผ่นแบน ขอบบน
// เส้นหนา 3px กริด 4 คอลัมน์เท่ากัน
// ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ**
// พร้อมตารางเส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ทรงตัดมุมคู่กับ NavbarCyber เลือกให้เข้ากับธีม **นินจา** ของรอบนี้ (คมเหมือน
// รอยใบมีด) ไม่ใช่โทนไซเบอร์ — จึงไม่มีภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_ ที่ไหน
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน ถอนชัวร์168 โทนชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de
// ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5) ก่อนหน้านั้น WEPLAY168 ม่วงนีออน
// และ BOOM369 เขียวนีออน — ทั้งสามชุดถอดออกครบแล้ว ข้อความของ ถอนชัวร์168
// (เว็บสล็อตฐานหลักถอนง่าย · เงื่อนไขการถอนเงิน · รีวิวหลายแหล่ง) ก็ถูกเขียนใหม่
// จากบรีฟรอบนี้ทั้งก้อน ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// พาเลตต์ตาม .claude/brand-spec-ninja168.md §2: ฟ้าไซยาน #32bcfb ฮิวนำ ·
// ฟ้าน้ำแข็ง #a9e9ff ตัวอักษรรอง/หัวคอลัมน์ · เหลืองมะนาว #fef54b ฮิวที่สอง ·
// น้ำเงินลึก #07335f และทองลึก #6b5c10 เป็นเส้น/ขอบ/พื้นถมเท่านั้น ไม่ถือตัวอักษร ·
// พื้นแผ่น #030e16 · พื้นถมป้าย #071a28 · เนื้อความ #dceefc (= BRAND_TEXT)
// ⚠️ #32bcfb บน #030e16 ได้ ≈ 8.1:1 และ #fef54b ได้ ≈ 14.6:1 จึงถือตัวอักษรได้จริง
// ⚠️ **กับดักรอบนี้คือรอบที่แล้วก็ฟ้า+ทอง** ฟ้าของ สบายเบท168 คือ 2f9ff5/a8dcff
// และทองคือ ffc82e — ฟ้ารอบนี้ #32bcfb สว่าง/ไซยานกว่า ส่วน #fef54b เป็นเหลือง
// มะนาวไม่ใช่ทองอำพัน ให้เทียบเป็นค่า ไม่ใช่ด้วยตา
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// /ตรวจหวย และ /แนวทาง **ไม่อยู่ในลิสต์รอบนี้** — นินจา168 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย ทั้งสองไฟล์ park อยู่ใน src/pages-disabled/ จึงไม่มี route
// ให้ลิงก์ ถ้าปล่อยทิ้งไว้จะเป็น dead href ที่ verify-build ทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// โปรโมชั่นแนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · ลิงก์แนะนำและการตรวจสอบผ่านบัญชี
// สมาชิก · ฝากถอนผ่านธนาคารและวอลเลท · ติดต่อเจ้าหน้าที่สอบถามเงื่อนไข — บรีฟ
// รอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือจำนวน
// สมาชิกที่ยืนยันได้** จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้รอบนี้มี 0.3% · 0.8% ·
// 24 ชม. เท่านั้น
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นนินจาการ์ตูนชุดดำยืนอยู่ทางซ้าย ผูกผ้าคาดหัวสีฟ้า-ขาวที่มีรูปดาวสีน้ำเงิน ปิดครึ่งล่างของใบหน้าด้วยผ้าปิดปากสีดำ ขยิบตาหนึ่งข้าง และถือดาวกระจายแบบชูริเคนสีฟ้าไว้ในมือ มีชายผ้าคาดหัวสีฟ้าปลิวไปด้านหลัง ถัดไปทางขวาเป็นคำว่า นินจา ตัวอักษรไทยหนาสามมิติสีเหลืองทองตัดขอบขาว ต่อด้วยเลข 168 ตัวหนาสามมิติผิวมันวาวสีฟ้า โดยมีประกายดาวสีทองและชูริเคนสีฟ้าลอยอยู่รอบตัวอักษร`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#32bcfb]/45 bg-[#030e16] pt-16 pb-8 font-sans text-[#dceefc]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#07335f 1px, transparent 1px), linear-gradient(90deg, #6b5c10 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(50,188,251,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#a9e9ff]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#32bcfb]/70 pl-4 text-sm leading-relaxed text-[#dceefc]/80">
          {BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจรับสิทธิ์จากการแนะนำเพื่อน โดยระบุอัตราโบนัส 0.8% พร้อมช่องทางแชร์ลิงก์แนะนำและตรวจสอบข้อมูลโปรโมชั่นผ่านบัญชีสมาชิก
          นอกจากนี้ยังมีรายละเอียดเกี่ยวกับการฝากถอนผ่านธนาคารและวอลเลท รวมถึงช่องทางติดต่อเจ้าหน้าที่สำหรับสอบถามเงื่อนไขต่าง ๆ ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#32bcfb]/50 bg-[#071a28] px-3 py-1 text-xs font-bold text-[#a9e9ff]">แอดมิน 24 ชม.</span>
          <span class="border border-[#fef54b]/50 bg-[#071a28] px-3 py-1 text-xs font-bold text-[#fef54b]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#32bcfb]/30 pb-2 text-base font-black tracking-widest text-[#a9e9ff]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#dceefc]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#fef54b]">
                  <span aria-hidden="true" class="text-[#32bcfb]">
                    ✦
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#32bcfb]/30 pb-2 text-base font-black tracking-widest text-[#a9e9ff]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#fef54b]/60 bg-transparent py-3 font-bold text-[#fef54b] transition-all hover:bg-[#071a28] hover:text-[#a9e9ff]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <p class="mt-2 text-xs font-bold text-[#dceefc]/60">ธนาคารและวอลเล็ตที่รองรับ</p>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#32bcfb]/25 pt-6 text-xs text-[#dceefc]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fef54b]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fef54b]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
