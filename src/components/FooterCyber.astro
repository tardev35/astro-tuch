---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// BOOM369 (รอบเขียวนีออนบนดำ 2026-10-07): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน
// HI59 ใช้ FooterStyle3 (กริด 12 คอลัมน์ มีการ์ด CTA ลอยคร่อมขอบบน) ไฟล์นี้เป็น
// ทรงตัดมุมหลังคาแหลมกลางจอพร้อมตารางเส้นพื้นหลัง คนละทรงกันชัดเจน
// ไฟล์นี้เคยเป็นของ หวย365 โทนแดงสด-ทองบนแดงเกือบดำ ตอนนี้ย้ายมาเป็นพื้นเขียว
// เกือบดำ #041109 ตารางพื้นหลังเป็นเขียวเข้ม #0b231b คู่กับเขียวลึก #036b26
// ขอบบนและเส้นคั่นเป็นเขียวนีออนแบรนด์ #42fb5a (สีคำว่า BOOM บนโลโก้) หัวคอลัมน์
// เขียวอ่อน #8dffa0 ลิงก์เนื้อความ #cfe9d7 hover เป็นเขียวนีออน #42fb5a
// ชุดแดง-ทองของ หวย365 (#dc0203 #ffc93c #180303 #6b0102 #3d0506 #c08a07
// #ffeab0 #f6e7e0) ออกครบทุกจุดแล้ว
//
// /ตรวจหวย และ /แนวทาง **ถูกถอดออกจาก directory รอบนี้** — BOOM369 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย ทั้งสองไฟล์ถูก park ไว้ใน src/pages-disabled/ จึงไม่มี route
// ให้ลิงก์ไปหา ถ้าปล่อยทิ้งไว้จะเป็น dead href ที่ verify-build ทำให้ build แดง
// ถ้ารอบหน้าเป็นแบรนด์หวย ต้องใส่สองบรรทัดนั้นกลับพร้อมย้ายไฟล์กลับ src/pages/
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความทุกย่อหน้ามาจาก src/assets/content.txt รอบนี้เท่านั้น: สล็อตเบทต่ำ
// ทุนน้อยก็เล่นได้ รวมเกมหลายรูปแบบในระบบเดียว เลือกเกมตามช่วงเดิมพัน ตรวจตาราง
// จ่าย/ฟีเจอร์โบนัสก่อนเริ่ม และแอดมิน 24 ชั่วโมง — บรีฟไม่ได้ระบุใบอนุญาต ชื่อ
// ค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก จึงไม่มีในไฟล์นี้ ตัวเลขที่
// อ้างได้มีห้าตัวเท่านั้น: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชั่วโมง
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#42fb5a]/40 bg-[#041109] pt-16 pb-8 font-sans text-[#cfe9d7]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#0b231b 1px, transparent 1px), linear-gradient(90deg, #036b26 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ BOOM369 ตัวอักษรหนาสามมิติ คำว่า BOOM เป็นเขียวนีออนไล่เฉด และเลข 369 เป็นเงินโครเมียม วางอยู่กลางวงแหวนเปิดที่ไล่จากเขียวนีออนไปเขียวอมฟ้าเข้ม"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(66,251,90,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#8dffa0]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#42fb5a]/70 pl-4 text-sm leading-relaxed text-[#cfe9d7]/80">
          {BRAND_NAME} สุดยอดเกมสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งสล็อตคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูงและแบ่งงบเล่นเป็นรอบ
          สมาชิกสามารถเลือกเกมตามช่วงเดิมพัน ตรวจสอบตารางจ่าย ฟีเจอร์โบนัส และรายละเอียดของแต่ละเกมก่อนเริ่มได้จากบัญชีเดียว ส่วนยอดเดิมพันต่ำสุดจะแตกต่างกันตามเกมและค่าย จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลัก
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#42fb5a]/50 bg-[#0b231b] px-3 py-1 font-mono text-xs text-[#8dffa0]">ADMIN_24H</span>
          <span class="border border-[#f3c44a]/45 bg-[#0b231b] px-3 py-1 font-mono text-xs text-[#f3c44a]">LOW_BET_SLOTS</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#8dffa0] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#cfe9d7]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="transition-colors hover:text-[#42fb5a]">
                  &gt; {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#8dffa0] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#42fb5a]/60 bg-transparent py-3 font-bold text-[#42fb5a] transition-all hover:bg-[#0b231b]/80 hover:text-[#8dffa0]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#cfe9d7]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#42fb5a]/25 pt-6 font-mono text-xs text-[#cfe9d7]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#42fb5a]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#42fb5a]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
