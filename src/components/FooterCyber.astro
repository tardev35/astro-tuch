---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน PIGPG ใช้ FooterStyle2 (กริด 4 คอลัมน์บนพื้นทึบ เส้นทองหนาคาดขอบบน)
// ไฟล์นี้เป็นทรงตัดมุมหลังคาแหลมกลางจอพร้อมตารางเส้นพื้นหลังและตัวอักษร monospace
// คนละทรงกันชัดเจน
// ไฟล์นี้เคยเป็นของ BOOM369 โทนเขียวนีออนบนดำ ตอนนี้ย้ายมาเป็นพื้นม่วงเกือบดำ
// #0a0117 ตารางพื้นหลังเป็นม่วงเข้ม #1e0a3c คู่กับม่วงลึก #5b1a75
// ขอบบนและเส้นคั่นเป็นม่วงนีออนแบรนด์ #a435f0 (สีตัวเครื่องเกมพกพาบนโลโก้)
// หัวคอลัมน์ม่วงอ่อน #d2a6ff ลิงก์เนื้อความ #c9b2e8 hover เป็นทองแบรนด์ #fbe455
// (ไม่ใช่ม่วงนีออน — #a435f0 บนพื้นนี้ได้แค่ 4.2:1 ซึ่งตก AA สำหรับข้อความปกติ
// ม่วงนีออนจึงถือได้แค่เส้นขอบกับเส้นคั่น ไม่ถือตัวอักษร)
// ชุดเขียวนีออนของ BOOM369 (#041109 #0b231b #036b26 #42fb5a #8dffa0 #cfe9d7
// #f3c44a) กับชุดแดง-ทองของ หวย365 ก่อนหน้านั้นออกครบทุกจุดแล้ว
//
// /ตรวจหวย และ /แนวทาง **ไม่อยู่ใน directory รอบนี้** — WEPLAY168 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย ทั้งสองไฟล์ถูก park ไว้ใน src/pages-disabled/ จึงไม่มี route
// ให้ลิงก์ไปหา ถ้าปล่อยทิ้งไว้จะเป็น dead href ที่ verify-build ทำให้ build แดง
// ถ้ารอบหน้าเป็นแบรนด์หวย ต้องใส่สองบรรทัดนั้นกลับพร้อมย้ายไฟล์กลับ src/pages/
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความทุกย่อหน้ามาจาก src/assets/content.txt รอบนี้เท่านั้น: สล็อตออโต้
// รวมเกมจากค่ายหลักไว้ในแพลตฟอร์มเดียว มีสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ
// เบทเริ่มต้น 1 บาทในบางเกม ตรวจตารางจ่าย/อัตราคืนเงินผู้เล่นก่อนเริ่ม และแอดมิน
// 24 ชั่วโมง — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือ
// จำนวนสมาชิก จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้มีสี่ตัวเท่านั้น: 1 บาท · 0.3% ·
// 0.8% · 24 ชั่วโมง
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#a435f0]/40 bg-[#0a0117] pt-16 pb-8 font-sans text-[#c9b2e8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#1e0a3c 1px, transparent 1px), linear-gradient(90deg, #5b1a75 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ WEPLAY168 เป็นเครื่องเกมพกพาทรงเกมบอยสีม่วงที่หน้าจอมีตัวมนุษย์ต่างดาวพิกเซลสีทอง มีคำว่า WEPLAY ตัวอักษรสามมิติสีเงินอมม่วงและเลข 168 สีทองวาวพาดอยู่กลางเครื่อง บนแฉกสายฟ้าสีม่วง"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(164,53,240,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#d2a6ff]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#a435f0]/70 pl-4 text-sm leading-relaxed text-[#c9b2e8]/80">
          {BRAND_NAME} เล่นสล็อตออโต้ผ่านระบบออนไลน์ที่รวบรวมเกมสล็อตจากค่ายหลักไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ รองรับการใช้งานผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม
          สมาชิกสามารถเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว บางเกมรองรับการเดิมพันเริ่มต้น 1 บาทตามช่วงเดิมพันที่ค่ายกำหนด จึงควรตรวจสอบตารางจ่ายและอัตราการคืนเงินผู้เล่นของแต่ละเกมก่อนเริ่มเล่น
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#a435f0]/50 bg-[#1e0a3c] px-3 py-1 font-mono text-xs text-[#d2a6ff]">ADMIN_24H</span>
          <span class="border border-[#fbe455]/45 bg-[#1e0a3c] px-3 py-1 font-mono text-xs text-[#fbe455]">AUTO_SLOT_ALL</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#d2a6ff] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#c9b2e8]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="transition-colors hover:text-[#fbe455]">
                  &gt; {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#d2a6ff] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#a435f0]/60 bg-transparent py-3 font-bold text-[#d2a6ff] transition-all hover:bg-[#1e0a3c]/80 hover:text-[#fbe455]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#c9b2e8]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a435f0]/25 pt-6 font-mono text-xs text-[#c9b2e8]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#fbe455]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#fbe455]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
