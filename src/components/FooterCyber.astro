---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// หวย365 (รอบแดงสด-ทอง 2026-10-02): footer ที่ใช้งานจริงรอบนี้ — รอบก่อน หวยเฮง789
// ใช้ FooterHuay ไฟล์นี้เคยเป็นของ SEXYGAME666 โทนชมพูนีออน-ม่วง-ดำ ตอนนี้ย้ายมาเป็น
// พื้นแดงเกือบดำ #180303 ตารางพื้นหลังเป็นแดงลึก #6b0102 คู่กับทองลึก #c08a07
// ขอบบนและเส้นคั่นเป็นแดงแบรนด์ #dc0203 (สีคำว่า "หวย" บนโลโก้) หัวคอลัมน์ทองอ่อน
// #ffeab0 ลิงก์เนื้อความ #f6e7e0 hover เป็นทอง #ffc93c ชุดเดิมของ SEXYGAME666
// (#08020d #fa42b5 #3d1180 #7d1550 #ecd8e8 #ffd6f0 #c9a4ff #1d0c33 #ffb3e2)
// ออกครบทุกจุดแล้ว
//
// /ตรวจหวย และ /แนวทาง อยู่ในรายการรอบนี้ เพราะ หวย365 เป็นเว็บแทงหวยล้วนและ
// ทั้งสองไฟล์อยู่ใน src/pages/ จริง ถ้ารอบหน้าเป็นแบรนด์สล็อต/คาสิโน ต้องถอดสอง
// บรรทัดนั้นออกพร้อมกับย้ายไฟล์กลับไป pages-disabled ไม่งั้นลิงก์จะกลายเป็น 404
// และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความทุกย่อหน้ามาจาก src/assets/content.txt รอบนี้เท่านั้น: รายการหวยหลาย
// ประเภทในบัญชีเดียว แนวทางหวย กลุ่มหวย สถิติย้อนหลัง ผลหวยตามรอบ ส่งโพยผ่านมือถือ
// และแอดมิน 24 ชั่วโมง — บรีฟไม่ได้ระบุใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือ
// จำนวนสมาชิก จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้มีสี่ตัวเท่านั้น: 2 ตัวจ่าย 100 ·
// 3 ตัวจ่าย 1,000 · 3 ขั้นตอน · 24 ชั่วโมง
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#dc0203]/40 bg-[#180303] pt-16 pb-8 font-sans text-[#f6e7e0]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#6b0102 1px, transparent 1px), linear-gradient(90deg, #c08a07 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ หวย365 ตัวอักษรไทยหนาเอียงสามมิติ คำว่า หวย เป็นสีแดงสด ต่อด้วยเลข 3 สีดำ เลข 6 สีแดงสด และเลข 5 สีดำ"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(220,2,3,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffeab0]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#dc0203]/70 pl-4 text-sm leading-relaxed text-[#f6e7e0]/80">
          {BRAND_NAME} เว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ สมาชิกติดตามได้ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ
          พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือจากบัญชีเดียว ส่วนสถิติย้อนหลังเป็นข้อมูลประกอบสำหรับย้อนดูผลรอบที่ผ่านมา ไม่ได้ใช้ยืนยันเลขที่จะออกในงวดถัดไป
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#dc0203]/50 bg-[#3d0506] px-3 py-1 font-mono text-xs text-[#ffeab0]">ADMIN_24H</span>
          <span class="border border-[#c08a07]/45 bg-[#3d0506] px-3 py-1 font-mono text-xs text-[#ffc93c]">ALL_LOTTO_TYPES</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffeab0] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#f6e7e0]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="transition-colors hover:text-[#ffc93c]">
                  &gt; {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffeab0] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#ffc93c]/60 bg-transparent py-3 font-bold text-[#ffc93c] transition-all hover:bg-[#6b0102]/80 hover:text-[#ffeab0]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#f6e7e0]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#dc0203]/25 pt-6 font-mono text-xs text-[#f6e7e0]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#ffc93c]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#ffc93c]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
