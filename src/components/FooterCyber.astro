---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// นาซ่า168 (รอบฟ้าไซยานไฟฟ้านำ-น้ำเงินอุลตรามารีนรอง บน **ธีมมืด**): footer ที่ใช้
// งานจริงรอบนี้ หมุนมาจาก FooterPremiumSumo ของ ร่ำรวย168 — ไฟล์นั้นเป็นแผ่นมุมบนมน
// ใหญ่ rounded-t-[3rem] มีออราสองชั้นและ <section> CTA คร่อมอยู่เหนือ ไฟล์นี้เป็น
// คนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ** พร้อมตาราง
// เส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** และเพราะเป็น
// **ภาษาของแผงควบคุมยานอวกาศ** ซึ่งเข้ากับธีมอวกาศของรอบนี้ — ไม่ใช่เพราะธีมไซเบอร์
// **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออนกลับเข้ามา**
// และห้ามใส่ภาษาสนามบอล/ลูกฟุตบอล/วงโคจรทอง ซึ่งเป็นของเจ้าของเดิมของไฟล์นี้
// หรือภาษานินจา (ชูริเคน ผ้าคาดหัว ใบมีด) ของเจ้าของก่อนหน้านั้น
// รอบนี้ภาษาภาพคือ **อวกาศ ดาวพร่าง นักบินอวกาศชุดขาว โลกและดวงจันทร์**
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน ยูฟ้า168 โทนทองคานารี-โครเมียมเงินบนธีมมืด (fee45d
// e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 0a0908 1e1a13 15130f eae3d4
// 0b0d10 140e02 000000) ก่อนหน้านั้น รวยแท้168 แดงเลือดหมู-ทองโบราณ (c30303
// 8f0505 dcb95f 96681f 280b0b 461212 ffeee8) นินจา168 ฟ้าไซยาน-เหลืองมะนาว
// (32bcfb a9e9ff fef54b 07335f 6b5c10 030e16 071a28 dceefc) ถอนชัวร์168
// ชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5)
// WEPLAY168 ม่วงนีออน และ BOOM369 เขียวนีออน — ทั้งหกชุดถอดออกครบแล้ว
// ข้อความของ ยูฟ้า168 (แทงบอล · บาคาร่า · เว็บตรง100% · ฐานหลักเว็บพนันออนไลน์)
// ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ⚠️⚠️ **NAZA168 (ตัวละติน) เป็นลูกค้าคนละเจ้าที่ชื่อออกเสียงเหมือนรอบนี้เป๊ะ และ
// ใช้ธีมอวกาศเหมือนกัน** ชุดสีของเจ้านั้นคือ "ทองอวกาศ-เงินโครเมียม"
// (fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3 241700 1a1000 432b03 231500)
// **ห้ามปนเข้ามาเด็ดขาด และห้ามสับสนว่าเป็นลูกค้าเดียวกัน** — worker ของเจ้านั้นคือ
// naza168-slot ส่วนรอบนี้คือ xn--168-ill4dyhb9o (ดู wrangler.toml)
// นี่คือเหตุผลที่รอบนี้ **ไม่มีทอง/เหลือง/ส้ม/แรมป์เทาเงินเป็นสี UI เลยสักเฉด**
// แม้เลข "168" ในโลโก้จะเป็นทองอำพันจริง — มันเป็นตัวอักษรในภาพ ไม่ใช่สีแบรนด์
//
// พาเลตต์ตาม .claude/brand-spec-naza168.md §2 (โซน "โครม"):
// ฟ้าไซยาน #1fd8f0 (ขอบ เส้นคั่น จุดนำหน้า หัวคอลัมน์ สี hover แสงรอบโลโก้) ·
// น้ำแข็งอ่อน #8fd9ec (ไอคอน/เน้นรอง) · น้ำเงินอุลตรามารีน #1d4fd8 และ #143aa0
// เป็นพื้นถม/เส้นตารางพื้นหลังเท่านั้น **ไม่ถือตัวอักษร** · เส้น #33455f ก็เช่นกัน ·
// พื้นแผ่น #121722 · พื้นถมป้าย #1b2434 · เนื้อความ #e6edf8
// ⚠️ #1fd8f0 บน #121722 ได้ ≈ 10.5:1 และบนป้าย #1b2434 ได้ ≈ 9.1:1 จึงถือตัวอักษร
// ได้จริง ส่วน **#1d4fd8 ได้ ≈ 2.4:1 บน #121722 = ขอบ/เส้น/พื้นถมเท่านั้น
// ห้ามถือตัวอักษร** และ **#33455f ได้ ≈ 1.9:1 = เส้น/ขอบเท่านั้นเช่นกัน**
// ⚠️⚠️ **กับดักของรอบนี้คือฟ้า ไม่ใช่ทอง** — ฟ้าเคยนำมาแล้วหกแบรนด์ในรีโปนี้
// และ **รอบก่อนทันที (ร่ำรวย168) ก็ฟ้านำเหมือนกัน**: 18a5e2 0d6b9b 0a5176 a9d7f2
// 111a3f 202a66 31408a e9f1ff adc0e4 f4e4d3 e4cbb3 dbe6ff — **ต้องไม่เหลือเลยสักค่า**
// ส่วน 32bcfb (นินจา168) 2cc3fc/6bdcfb (สบาย168) 039cfa (รวยแทร่168)
// 2f9ff5 (สบายเบท168) 0360f3/0292fb (TSDET911) ก็ต้องกวาดออกเช่นกัน
// การเจอฟ้าในไฟล์นี้จึงไม่พิสูจน์อะไร ให้เทียบเป็นค่าทีละตัว ไม่ใช่ด้วยตา
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// **ห้ามเปลี่ยนเป็นฟ้าของแบรนด์**
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง ไม่อยู่ในลิสต์นี้** — รอบนี้ นาซ่า168 เป็นเว็บสล็อต
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง
// **ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด (คนมักดูแค่ navbar) และ dead href จะทำให้
// verify-build แดง — ห้ามใส่กลับจนกว่าจะมีแบรนด์หวยรอบใหม่ที่ย้ายไฟล์กลับเข้ามา**
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// ⚠️ **BankStrip ไม่ได้ถูก render ในไฟล์นี้** พร้อมบรรทัด "ธนาคารและวอลเล็ตที่รองรับ"
// เพราะบรีฟรอบนี้พูดถึง "ธนาคารและทรูมันนี่" แบบรวมๆ เท่านั้น **ไม่ได้ระบุชื่อธนาคาร
// แม้แต่รายเดียว** — แถบโลโก้ธนาคารคือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มี
// อะไรในบรีฟรองรับ ไฟล์ BankStrip.astro ยังอยู่บนดิสก์ในฐานะ inventory ไม่ได้ถูกลบ
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// สล็อตนาซ่าเซิร์ฟไทย · ระบบเล่นง่าย รองรับภาษาไทย · ลิขสิทธิ์แท้จากอเมริกา ·
// ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า · ธนาคารและทรูมันนี่ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · แอดมิน 24ชม. — บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต
// ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือจำนวนสมาชิกที่ยืนยันได้** จึงไม่มีในไฟล์นี้
// ตัวเลขที่อ้างได้รอบนี้มี 0.3% · 0.8% · 24ชม. เท่านั้น
// ⚠️ **ไม่มี "100%" และไม่มี "เว็บตรง"** — สองคำนั้นเป็นของ ยูฟ้า168 เจ้าของเดิม
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นหมวกนักบินอวกาศสีขาวเงิน บังตาเป็นกระจกโค้งสีเข้มที่สะท้อนภาพโลกสีน้ำเงินและฟ้า ขอบหมวกมีไฟสีฟ้าสว่าง ถัดมาเป็นคำว่า นาซ่า ตัวอักษรไทยหนาสามมิติผิวมันวาวไล่เฉดจากฟ้าไซยานลงน้ำเงินเข้ม ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติสีทองอำพัน`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#1fd8f0]/45 bg-[#121722] pt-16 pb-8 font-sans text-[#e6edf8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#143aa0 1px, transparent 1px), linear-gradient(90deg, #33455f 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(31,216,240,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#1fd8f0]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#1fd8f0]/70 pl-4 text-sm leading-relaxed text-[#e6edf8]/80">
          {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์ที่เน้นรูปแบบการใช้งานภาษาไทยไว้ในเว็บไซต์เดียว ทั้งเมนูสำหรับศึกษารายละเอียดเกม โปรโมชั่น และช่องทางฝากถอนผ่านธนาคารและทรูมันนี่
          ผู้ใช้งานควรตรวจสอบกติกาเกม ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนทำรายการทุกครั้ง ส่วนข้อมูลเรื่องลิขสิทธิ์แท้จากอเมริกาและการรับเงินผ่านบัญชีบริษัทโดยตรง
          ควรตรวจสอบชื่อผู้พัฒนาเกม ข้อมูลนิติบุคคล และหลักฐานการอนุญาตจากแหล่งที่เชื่อถือได้ เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#33455f] bg-[#1b2434] px-3 py-1 text-xs font-bold text-[#e6edf8]">แอดมิน 24ชม.</span>
          <span class="border border-[#1fd8f0]/50 bg-[#1b2434] px-3 py-1 text-xs font-bold text-[#1fd8f0]">คืนยอดเสีย 0.3%</span>
          <span class="border border-[#1fd8f0]/50 bg-[#1b2434] px-3 py-1 text-xs font-bold text-[#1fd8f0]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#1fd8f0]/30 pb-2 text-base font-black tracking-widest text-[#1fd8f0]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#e6edf8]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#1fd8f0]">
                  <span aria-hidden="true" class="text-[#8fd9ec]">
                    ✦
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#1fd8f0]/30 pb-2 text-base font-black tracking-widest text-[#1fd8f0]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#1fd8f0]/60 bg-transparent py-3 font-bold text-[#e6edf8] transition-all hover:bg-[#273449]/60 hover:text-[#1fd8f0]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#1fd8f0]/25 pt-6 text-xs text-[#e6edf8]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#1fd8f0]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#1fd8f0]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
