---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ZANE96 (รอบไวโอเลตนีออนนำ-ฟ้าอิเล็กทริกรอง · **เนื้อหาสว่าง โครมเข้ม**):
// footer ที่ใช้งานจริงรอบนี้ หมุนมาจาก FooterPremiumSumo ของ MEXICANOSLOT —
// ไฟล์นั้นเป็นแผ่นมุมบนมนใหญ่ rounded-t-[3rem] มีออราเบลอคร่อมสองขอบและกริด 5/3/4
// ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ**
// พร้อมตารางเส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** ไม่ใช่เพราะ
// อยากได้ธีมไซเบอร์พังก์ — **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกน
// กลับเข้ามา** และห้ามใส่ภาษาอวกาศ (ดาวพร่าง นักบินอวกาศ ดวงจันทร์) ของเจ้าของ
// เดิมของไฟล์นี้ หรือภาษาสนามบอล/ลูกฟุตบอล หรือภาษานินจา (ชูริเคน ผ้าคาดหัว)
// ของเจ้าของก่อนหน้านั้น
// รอบนี้ภาษาภาพคือ **นีออนคาสิโน: เวิร์ดมาร์กโครเมียมไล่ฟ้า→ม่วง→แมเจนต้า ·
// ตู้สล็อต 777 ผิวแก้วม่วง · ชิปคาสิโนแมเจนต้า · เพชรม่วง · ประกายดาวสี่แฉก**
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน นาซ่า168 โทนฟ้าไซยาน-น้ำเงินอุลตรามารีน (1fd8f0 0bb6d4
// 8fd9ec 1d4fd8 143aa0 e6edf8 33455f 121722 1b2434 273449 0d1017) ก่อนหน้านั้น
// ยูฟ้า168 ทองคานารี-โครเมียมเงิน (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf
// 78828f 5a6472 0a0908 1e1a13 eae3d4) รวยแท้168 แดงเลือดหมู-ทองโบราณ (c30303
// 8f0505 dcb95f 96681f 280b0b 461212 ffeee8) นินจา168 ฟ้าไซยาน-เหลืองมะนาว
// (32bcfb a9e9ff fef54b 07335f 6b5c10 030e16 071a28 dceefc) ถอนชัวร์168
// ชมพูบับเบิลกัม-ทองเนย (fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5)
// WEPLAY168 ม่วงนีออน และ BOOM369 เขียวนีออน — ทั้งเจ็ดชุดถอดออกครบแล้ว
// ข้อความของ นาซ่า168 (สล็อตนาซ่าเซิร์ฟไทย · ลิขสิทธิ์แท้จากอเมริกา · ไม่ผ่านม้า ·
// ธนาคารและทรูมันนี่) ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน ไม่ใช่ find-and-replace
// ทับประโยคเดิม
//
// พาเลตต์ตาม .claude/brand-spec-zane96.md §2 (โซน "โครม"):
// ไวโอเลตนีออน #bb6dff (ขอบ เส้นคั่น จุดนำหน้า หัวคอลัมน์ สี hover แสงรอบโลโก้) ·
// ฟ้าอิเล็กทริกอ่อน #7aa7ff (ไอคอน/เน้นรอง) · ไวโอเลตเข้ม #5411c4 และเส้น #5b2f9e
// เป็นพื้นถม/เส้นตารางพื้นหลังเท่านั้น **ไม่ถือตัวอักษรบนผิวเข้มนี้** ·
// พื้นแผ่น #190b3d · พื้นถมป้าย #271257 · เนื้อความ #f3e8ff
// ⚠️ #bb6dff บน #190b3d ได้ ≈ 5.8:1 และบนป้าย #271257 ได้ ≈ 5.0:1 จึงถือตัวอักษร
// ได้จริง ส่วน **#5411c4 ได้ ≈ 1.4:1 บน #190b3d = ขอบ/เส้น/พื้นถมเท่านั้น
// ห้ามถือตัวอักษร** และ **#5b2f9e ได้ ≈ 1.9:1 = เส้น/ขอบเท่านั้นเช่นกัน**
// ⚠️⚠️ **กับดักของรอบนี้คือไฟล์นี้เพิ่งเป็น "ฟ้าไซยาน" ของ นาซ่า168 มาก่อน และ
// รอบนี้ก็มีฟ้าเป็นคู่รอง** — ฟ้าเคยนำมาแล้วหกแบรนด์ในรีโปนี้: 1fd8f0 0bb6d4
// 8fd9ec 1d4fd8 143aa0 e6edf8 33455f 121722 1b2434 273449 (นาซ่า168) · 18a5e2
// 0d6b9b 0a5176 a9d7f2 111a3f 202a66 31408a e9f1ff adc0e4 dbe6ff (ร่ำรวย168) ·
// 32bcfb (นินจา168) · 2cc3fc/6bdcfb (สบาย168) · 039cfa (รวยแทร่168) · 2f9ff5
// (สบายเบท168) · 0360f3/0292fb/6ec8ff (TSDET911) · 00f3ff/60a5fa (default cyber)
// — **ต้องไม่เหลือเลยสักค่า** ⚠️ **60a5fa ↔ #7aa7ff ใกล้ที่สุดในลิสต์**
// และม่วงของแบรนด์อื่นก็ต้องกวาดเช่นกัน: 7e22ce d946ef a855f7 (CEO66) ·
// 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88 — ⚠️⚠️ **b453ff ↔ #bb6dff ต่างไบต์เดียว**)
// กับชมพู/แมเจนต้าของ okkub88: d91a73 fb439b fc4da1 9c0f55 85094a
// (⚠️ **d91a73 ↔ #c2178b**) และแดง/ทองของ MEXICANOSLOT: de2b1e f2a033 a81410
// c81e12 2b100a 431a10 fdeee2 e8c6ae
// การเจอฟ้า/ม่วง/ชมพูในไฟล์นี้จึงไม่พิสูจน์อะไร ให้เทียบเป็นค่าทีละตัว ไม่ใช่ด้วยตา
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// **ห้ามเปลี่ยนเป็นม่วงของแบรนด์**
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง ไม่อยู่ในลิสต์นี้** — รอบนี้ ZANE96 เป็นเว็บสล็อต
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง
// **ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด (คนมักดูแค่ navbar) และ dead href จะทำให้
// verify-build แดง — ห้ามใส่กลับจนกว่าจะมีแบรนด์หวยรอบใหม่ที่ย้ายไฟล์กลับเข้ามา**
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// 🚨🚨 **BankStrip ไม่ได้ถูก render ในไฟล์นี้** และห้ามใส่กลับเข้ามา เพราะบรีฟ
// รอบนี้ (src/assets/content.txt) **ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลย
// แม้แต่คำเดียว** — แถบโลโก้ธนาคารคือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มี
// อะไรในบรีฟรองรับ ไฟล์ BankStrip.astro ยังอยู่บนดิสก์ในฐานะ inventory ไม่ได้ถูกลบ
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// สล็อตลิขสิทธิ์แท้ในไทย · เว็บตรงไม่ผ่านเอเย่นต์ · รวมเกมสล็อตแบรนด์ดัง ·
// ยูสใหม่เล่นง่ายไม่มีขั้นต่ำ 1 บาทก็เล่นได้ · สล็อตคลาสสิก ฟรีสปิน เกมโบนัส ·
// ค่า RTP และความผันผวน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · แอดมิน 24ชม. —
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ยอดฝากขั้นต่ำ จำนวนเกม
// หรือค่า RTP เป็นตัวเลข** จึงไม่มีในไฟล์นี้
// ตัวเลขที่อ้างได้รอบนี้มี 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24ชม. เท่านั้น
// ⚠️ **ไม่มี "100%"** และ **"เว็บตรงไม่ผ่านเอเย่นต์" ใช้ได้รอบนี้** เพราะอยู่ใน
// บรีฟตรงตัว (บรรทัด 3) — ต่างจากรอบก่อนๆ ที่ห้ามไว้ **อย่าสืบทอดข้อห้ามข้ามรอบ**
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กล้วนไม่มีสัญลักษณ์ประกอบ เขียนด้วยตัวอักษรละตินหนาสามมิติผิวโครเมียมมันวาวเอียงไปทางขวา สี่ตัวอักษรแรกไล่เฉดจากฟ้าอิเล็กทริกเข้าหาม่วง ส่วนตัวเลขสองหลักท้ายเป็นสีชมพูแมเจนต้าไล่ลงม่วงเข้ม ทุกตัวตัดขอบสีขาวหนาและมีแสงสะท้อนสีขาวพาดอยู่ด้านบน มีประกายดาวสี่แฉกสีขาวอมม่วงประดับอยู่ที่มุมบนขวาและมุมล่างของตัวเลข`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#bb6dff]/45 bg-[#190b3d] pt-16 pb-8 font-sans text-[#f3e8ff]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#5411c4 1px, transparent 1px), linear-gradient(90deg, #5b2f9e 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(187,109,255,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#bb6dff]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#bb6dff]/70 pl-4 text-sm leading-relaxed text-[#f3e8ff]/80">
          {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ไว้ในเว็บไซต์เดียว ทั้งรายละเอียดเกม โปรโมชั่นสำหรับสมาชิก และช่องทางติดต่อเจ้าหน้าที่
          พร้อมระบบสมาชิกที่ออกแบบให้ใช้งานผ่านมือถือได้สะดวก ผู้ใช้งานควรตรวจสอบยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และกติกาของแต่ละเกมก่อนใช้งาน
          รวมถึงศึกษาค่า RTP และความผันผวนของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์
          ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#5b2f9e] bg-[#271257] px-3 py-1 text-xs font-bold text-[#f3e8ff]">แอดมิน 24ชม.</span>
          <span class="border border-[#bb6dff]/50 bg-[#271257] px-3 py-1 text-xs font-bold text-[#bb6dff]">คืนยอดเสีย 0.3%</span>
          <span class="border border-[#bb6dff]/50 bg-[#271257] px-3 py-1 text-xs font-bold text-[#bb6dff]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#bb6dff]/30 pb-2 text-base font-black tracking-widest text-[#bb6dff]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#f3e8ff]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#bb6dff]">
                  <span aria-hidden="true" class="text-[#7aa7ff]">
                    ✦
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#bb6dff]/30 pb-2 text-base font-black tracking-widest text-[#bb6dff]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#bb6dff]/60 bg-transparent py-3 font-bold text-[#f3e8ff] transition-all hover:bg-[#2f1766]/60 hover:text-[#bb6dff]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#bb6dff]/25 pt-6 text-xs text-[#f3e8ff]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#bb6dff]">เงื่อนไขข้อตกลง</a>
