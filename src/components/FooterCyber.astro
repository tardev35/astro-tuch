---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// รวยแท้168 (รอบแดงเลือดหมูนำ-ทองโบราณรอง บน **ธีมสว่าง** 2026-10-21): footer ที่ใช้
// งานจริงรอบนี้ หมุนมาจาก FooterHuay ของ สาธุ168 — ไฟล์นั้นเป็นแผ่นลายไทยขอบทอง
// ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ**
// พร้อมตารางเส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
// ⚠️ ทรงตัดมุมของไฟล์นี้ถูกเลือกเพราะเป็น **ทรงที่ต่างจากรอบก่อนจริง** ไม่ใช่เพราะ
// ธีมไซเบอร์ — **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออนกลับเข้ามา**
// และห้ามใส่ภาษานินจา (ชูริเคน ผ้าคาดหัว ใบมีด) ซึ่งเป็นของเจ้าของเดิมของไฟล์นี้
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน นินจา168 โทนฟ้าไซยาน-เหลืองมะนาว (32bcfb a9e9ff fef54b
// 07335f 6b5c10 030e16 071a28 dceefc) ก่อนหน้านั้น ถอนชัวร์168 ชมพูบับเบิลกัม-ทองเนย
// (fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5) WEPLAY168 ม่วงนีออน
// และ BOOM369 เขียวนีออน — ทั้งสี่ชุดถอดออกครบแล้ว ข้อความของ นินจา168
// (แนะนำเพื่อน · ลิงก์แนะนำ · เว็บสล็อต) ก็ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งก้อน
// ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// ⚠️⚠️ **รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826) เป็นแบรนด์คนละเจ้าที่ชื่อ
// ไทยต่างกันหนึ่งตัวอักษรและโดเมนต่างกันแค่ -vip** — ชุดฟ้าของมันห้ามปนเข้ามาเด็ดขาด
// และห้ามสับสนว่าเป็นลูกค้าเดียวกัน
//
// พาเลตต์ตาม .claude/brand-spec-ruaythear168vip.md §2 (โซน "โครม"):
// แดงสด #c30303 ฮิวนำ (ขอบ เส้นคั่น จุดนำหน้า แสงรอบโลโก้) · ทองโบราณ #dcb95f
// ฮิวที่สอง (หัวคอลัมน์ สี hover ปุ่มกลับขึ้นบน) · แดงเข้ม #8f0505 และทองลึก
// #96681f เป็นเส้นตารางพื้นหลังเท่านั้น ไม่ถือตัวอักษร · พื้นแผ่น #280b0b ·
// พื้นถมป้าย #461212 · เนื้อความ #ffeee8
// ⚠️ #dcb95f บน #280b0b ได้ ≈ 9.9:1 และบนป้าย #461212 ได้ 8.2:1 จึงถือตัวอักษรได้จริง
// ส่วน **#96681f ได้ 3.8:1 บน #280b0b = ขอบ/เส้น/เงาเท่านั้น ห้ามถือตัวอักษร**
// และ **#e81313 ไม่ปรากฏในไฟล์นี้เลย** เพราะถือตัวอักษรไม่ได้และเป็นพื้นของตัวอักษรไม่ได้
// ⚠️⚠️ **กับดักรอบนี้คือแดง ซึ่งเป็นฮิวที่ผ่านรีโปนี้มามากที่สุด** — d9212a
// (ดวงเศรษฐี168) d30304 (รับตัง168) b90203 fa0513 (สมหวัง168) fb1b32 (มีเฮ168)
// e4021b (รวยเทพ168) b3121b (ขวัญใจ168) dc0203 (หวย365) การเจอแดงในไฟล์นี้จึงไม่
// พิสูจน์อะไร แดงรอบนี้คือ **#c30303** ให้เทียบเป็นค่าทีละตัว ไม่ใช่ด้วยตา
// ⚠️ และรอบก่อน (สาธุ168) เป็นเขียวมรกต-ทองสัมฤทธิ์ (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ซึ่งต้องไม่เหลือในไฟล์นี้เลยสักค่า
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
// **ห้ามเปลี่ยนเป็นแดงของแบรนด์** ถึงรอบนี้สีแบรนด์จะเป็นแดงก็ตาม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ⚠️ **/ตรวจหวย และ /แนวทาง อยู่ในลิสต์รอบนี้** — บรีฟทั้งฉบับเป็นเว็บหวยล้วน
// (หวยรัฐบาลไทย · ลาวพัฒนา · ฮานอย · หุ้นต่างประเทศ) ทั้งสองไฟล์อยู่ใน src/pages/
// จึงมี route จริง ถ้ารอบหน้าเป็นแบรนด์สล็อตแล้ว park สองหน้านั้นกลับไป
// src/pages-disabled/ **ต้องลบสองลิงก์นี้ออกจากที่นี่ด้วย ไม่ใช่แค่จาก navbar** —
// ลิสต์นี้เป็นจุดที่คนลืมบ่อยที่สุด และ dead href จะทำให้ verify-build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// ช่องทางเล่นหวยหลายประเภทในที่เดียว · อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ฝากถอนผ่านธนาคารและวอลเลท · ติดต่อ
// เจ้าหน้าที่ — บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ชื่อวอลเลท
// ยอดฝากขั้นต่ำ หรือจำนวนสมาชิกที่ยืนยันได้** จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้
// รอบนี้มี 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม. เท่านั้น
// ⚠️ และบรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนจึง ship ด้วย ไม่ใช่
// ตัดทิ้งเพราะฟังดูไม่ขาย
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นเครื่องหมายโค้งสะบัดทรงตัวเอสสามมิติผิวมันวาว ไล่สีแดงคริมสันกับทอง ถัดมาเป็นคำว่า รวยแท้ ตัวอักษรไทยหนาสามมิติผิวมันวาวสีแดงคริมสัน ตัดขอบทองหนา ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติผิวทองขัดเงาสะท้อนแสง`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#c30303]/45 bg-[#280b0b] pt-16 pb-8 font-sans text-[#ffeee8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#8f0505 1px, transparent 1px), linear-gradient(90deg, #96681f 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(195,3,3,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#dcb95f]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#c30303]/70 pl-4 text-sm leading-relaxed text-[#ffeee8]/80">
          {BRAND_NAME} รวบรวมข้อมูลหวยออนไลน์หลายประเภทไว้ในที่เดียว ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ พร้อมรายละเอียดอัตราจ่าย โปรโมชั่น และช่องทางฝากถอนผ่านธนาคารและวอลเลท
          ผู้ใช้งานควรตรวจสอบรอบเปิดรับ อัตราจ่ายล่าสุด และเงื่อนไขของแต่ละรายการก่อนทำธุรกรรมทุกครั้ง ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#c30303]/50 bg-[#461212] px-3 py-1 text-xs font-bold text-[#ffeee8]">แอดมิน 24ชม.</span>
          <span class="border border-[#dcb95f]/50 bg-[#461212] px-3 py-1 text-xs font-bold text-[#dcb95f]">คืนยอดเสีย 0.3%</span>
          <span class="border border-[#dcb95f]/50 bg-[#461212] px-3 py-1 text-xs font-bold text-[#dcb95f]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#c30303]/30 pb-2 text-base font-black tracking-widest text-[#dcb95f]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#ffeee8]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#dcb95f]">
                  <span aria-hidden="true" class="text-[#c30303]">
                    ✦
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#c30303]/30 pb-2 text-base font-black tracking-widest text-[#dcb95f]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#dcb95f]/60 bg-transparent py-3 font-bold text-[#dcb95f] transition-all hover:bg-[#461212] hover:text-[#ffeee8]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <p class="mt-2 text-xs font-bold text-[#ffeee8]/60">ธนาคารและวอลเล็ตที่รองรับ</p>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#c30303]/25 pt-6 text-xs text-[#ffeee8]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#dcb95f]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#dcb95f]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
