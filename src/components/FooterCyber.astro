---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// /ตรวจหวย and /แนวทาง are NOT listed: this is a live-casino brand, so those two
// pages sit in src/pages-disabled/ and the routes do not exist. Linking them here
// would be a dead href, which verify-build.mjs fails the build on.
//
// /ทางเข้า IS listed: the page is still routed and indexed, it is only absent
// from the navbar because the cta toggle made /register and /login real pages.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): footer ที่ใช้งานจริงรอบนี้
// (รอบก่อน PGW44 ใช้ FooterStyle3) พื้นเกือบดำอมม่วง #08020d ตารางพื้นหลังเป็น
// ม่วงลึก #3d1180 / ชมพูลึก #7d1550 ขอบบนและเส้นคั่นชมพูบานเย็นแบรนด์ #fa42b5
// หัวคอลัมน์ชมพูอ่อนสว่าง #ffd6f0 ลิงก์เนื้อความ #ecd8e8 hover เป็นม่วงอ่อน
// #c9a4ff ชิปสถานะใช้ชมพูคู่กับม่วง ตามโลโก้ที่ SEXY เป็นชมพูบานเย็น GAME ไล่ไป
// เป็นม่วง และ 666 กลับมาเป็นชมพู — เขียว #22c55e/#7cf25c/#04380c/#0a6b18/#0a1a0c
// /#123a18 กับพื้น #040a05 และเงิน #f1f5f9/#aab4bf/#dfeadd ของ BRAZIL999
// ถูกถอดออกหมด
//
// เนื้อความทุกย่อหน้ามาจากบรีฟรอบนี้เท่านั้น: เกมเซ็กซี่บาคาร่าไลฟ์สด โต๊ะเกมและ
// รูปแบบการเดิมพันตามรายการที่เปิดให้บริการ ผู้ให้บริการต่างประเทศ บัญชีบริษัท
// โดยตรง รองรับมือถือและคอมพิวเตอร์ และเจ้าหน้าที่ 24 ชั่วโมง — บรีฟไม่ได้ระบุ
// ค่ายเกม ชื่อโต๊ะ ใบอนุญาต หรือช่องทางฝากถอนใดเป็นชื่อๆ จึงไม่มีในไฟล์นี้
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#fa42b5]/40 bg-[#08020d] pt-16 pb-8 font-sans text-[#ecd8e8]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#3d1180 1px, transparent 1px), linear-gradient(90deg, #7d1550 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ SEXYGAME666 ตัวอักษรหนาสามมิติ คำว่า SEXY เป็นชมพูบานเย็นไล่เฉด GAME ไล่จากม่วงไปน้ำเงินม่วง และเลข 666 กลับมาเป็นชมพูบานเย็น"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(250,66,181,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffd6f0]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fa42b5]/70 pl-4 text-sm leading-relaxed text-[#ecd8e8]/80">
          {BRAND_NAME} รวมเกมเซ็กซี่บาคาร่าออนไลน์ในรูปแบบไลฟ์สด เชื่อมต่อจากผู้ให้บริการต่างประเทศตามข้อมูลที่เว็บไซต์ระบุ พร้อมโต๊ะเกมและรูปแบบการเดิมพันให้เลือกตามรายการที่เปิดให้บริการ
          สมาชิกสามารถเลือกโต๊ะ ตรวจสอบรายละเอียดเกม และเข้าเล่นผ่านระบบออนไลน์ได้ทั้งบนมือถือและคอมพิวเตอร์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#fa42b5]/50 bg-[#1d0c33] px-3 py-1 font-mono text-xs text-[#ffb3e2]">LIVE_24H</span>
          <span class="border border-[#c9a4ff]/45 bg-[#1d0c33] px-3 py-1 font-mono text-xs text-[#c9a4ff]">DIRECT_COMPANY</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffd6f0] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#ecd8e8]/80">
          <li><a href="/" class="transition-colors hover:text-[#c9a4ff]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#c9a4ff]">&gt; โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#c9a4ff]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#c9a4ff]">&gt; เข้าสู่ระบบ</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#c9a4ff]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#c9a4ff]">&gt; ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#c9a4ff]">&gt; เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#c9a4ff]">&gt; ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffd6f0] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#c9a4ff]/60 bg-transparent py-3 font-bold text-[#c9a4ff] transition-all hover:bg-[#3d1180]/80 hover:text-[#ffd6f0]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#ecd8e8]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#fa42b5]/25 pt-6 font-mono text-xs text-[#ecd8e8]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#c9a4ff]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#c9a4ff]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
