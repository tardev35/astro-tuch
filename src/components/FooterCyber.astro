---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ถอนชัวร์168 (รอบชมพูบับเบิลกัม-ทองเนย 2026-10-18): footer ที่ใช้งานจริงรอบนี้
// หมุนมาจาก FooterStyle3 ของ มีโชค168 — ไฟล์นั้นเป็นการ์ด CTA ลอยคร่อมขอบบน
// (-top-14 / md:-top-16) แล้วแผ่นเว้น pt-64 ไว้รับ
// ไฟล์นี้เป็นคนละทรงชัดเจน: **แผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ**
// พร้อมตารางเส้นพื้นหลัง และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน WEPLAY168 โทนม่วงนีออน-ทองอาร์เขต (#0a0117 #1e0a3c
// #5b1a75 #a435f0 #d2a6ff #c9b2e8 #fbe455) และก่อนหน้านั้น BOOM369 เขียวนีออน
// (#041109 #0b231b #036b26 #42fb5a #8dffa0 #cfe9d7 #f3c44a) — ทั้งสองชุดถอดออก
// ครบแล้ว ข้อความของ WEPLAY168 (รวมเกมสล็อตจากค่ายหลัก สล็อตคลาสสิก เกมโบนัส
// ฟรีสปิน ตัวคูณ เบทเริ่มต้น 1 บาท ตารางจ่าย/อัตราคืนเงินผู้เล่น) ก็ถูกเขียนใหม่
// จากบรีฟรอบนี้ทั้งก้อน ไม่ใช่ find-and-replace ทับประโยคเดิม
//
// รอบนี้ยังถอด **ภาษามอนอสเปซ/สแลชสามตัว (/// DIRECTORY, SYSTEM_COPYRIGHT,
// ADMIN_24H, LINE CONNECT)** ออกทั้งหมด — ทรงแผ่นตัดมุมคือสิ่งที่หมุนมาใช้
// ไม่ใช่โทนไซเบอร์ และอาร์ตเวิร์กรอบนี้เป็นแมวการ์ตูนกับหัวใจชมพู คนละเรื่องกัน
//
// พาเลตต์ตาม .claude/brand-spec-tonchua168.md §2: ชมพูบับเบิลกัม #fa63b9 ฮิวนำ ·
// ชมพูอ่อน #ffb3de ตัวอักษรรอง/hover · ทองเนย #ffd84d ฮิวที่สอง · พลัมเข้ม
// #6d0b3f เป็นเส้น/ขอบ/พื้นถมเท่านั้น ไม่ถือตัวอักษร · พื้นแผ่น #0d040a ·
// พื้นถมป้าย #1a0914 · เนื้อความ #fdeaf5 (= BRAND_TEXT)
// ⚠️ #fa63b9 บน #0d040a ได้ ≈ 7.4:1 จึงถือตัวอักษรได้จริง ต่างจาก #a435f0 ของ
// WEPLAY168 ที่ได้แค่ 4.2:1 จนถือได้แค่เส้นขอบ — คนละข้อจำกัดกัน
//
// สีเขียว LINE (#00B900) เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: footer ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// /ตรวจหวย และ /แนวทาง **ไม่อยู่ในลิสต์รอบนี้** — ถอนชัวร์168 เป็นเว็บสล็อต
// ไม่ใช่เว็บหวย ทั้งสองไฟล์ park อยู่ใน src/pages-disabled/ จึงไม่มี route
// ให้ลิงก์ ถ้าปล่อยทิ้งไว้จะเป็น dead href ที่ verify-build ทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
//
// เนื้อความย่อหน้าเดียวด้านล่างมาจาก src/assets/content.txt รอบนี้เท่านั้น:
// เว็บสล็อตฐานหลักถอนง่าย · รวมเมนูสมัครสมาชิก ฝากถอน และโปรโมชั่นไว้ที่เดียว ·
// ควรศึกษาขั้นตอนทำรายการและเงื่อนไขการถอนเงินก่อนเริ่มใช้งาน · สอบถามเจ้าหน้าที่
// เมื่อพบปัญหา — บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร ยอดฝาก
// ขั้นต่ำ หรือจำนวนสมาชิกที่ยืนยันได้** จึงไม่มีในไฟล์นี้ ตัวเลขที่อ้างได้รอบนี้มี
// 0.3% · 0.8% · 3 ขั้นตอน · 24 ชม. เท่านั้น
//
// บล็อก <address> ตั้งใจไม่ทาสีแบรนด์ — border-white/15 + bg-black/20 + opacity
// บนสีตัวอักษรที่ inherit มา ลงตัวกับ footer ทุกตัวในไลบรารี ห้าม retheme
const directory = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นแมวการ์ตูนขนขาวแก้มชมพู หน้ายิ้มหลับตา ยกอุ้งเท้าข้างหนึ่งขึ้น นั่งอยู่หลังมือถือจอชมพูที่มีลูกศรดาวน์โหลดและปึกแบงก์ชมพู ใต้ลงมาเป็นคำว่า ถอน ตัวอักษรไทยหนาสามมิติสีทองเนยตัดขอบชมพู ต่อด้วยคำว่า ชัวร์ และเลข 168 ตัวหนาสามมิติสีชมพูบับเบิลกัมตัดขอบทอง มีหัวใจชมพูและประกายดาวสีทองลอยอยู่รอบตัวอักษร`;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#fa63b9]/45 bg-[#0d040a] pt-16 pb-8 font-sans text-[#fdeaf5]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.16]"
    style="background-image: linear-gradient(#6d0b3f 1px, transparent 1px), linear-gradient(90deg, #6b4708 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(250,99,185,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffb3de]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fa63b9]/70 pl-4 text-sm leading-relaxed text-[#fdeaf5]/80">
          {BRAND_NAME} เว็บสล็อตฐานหลักถอนง่าย รวมเมนูสำหรับสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษาขั้นตอนทำรายการและเงื่อนไขการถอนเงินก่อนเริ่มใช้งาน
          รวมถึงสอบถามเจ้าหน้าที่เมื่อพบปัญหา ส่วนข้อมูลเกี่ยวกับการจ่ายเงินจริงและความน่าเชื่อถือ ควรตรวจสอบจากหลักฐานและรีวิวหลายแหล่งก่อนตัดสินใจ
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="border border-[#fa63b9]/50 bg-[#1a0914] px-3 py-1 text-xs font-bold text-[#ffb3de]">แอดมิน 24 ชม.</span>
          <span class="border border-[#ffd84d]/50 bg-[#1a0914] px-3 py-1 text-xs font-bold text-[#ffd84d]">เว็บสล็อตฐานหลัก</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="border-b border-[#fa63b9]/30 pb-2 text-base font-black tracking-widest text-[#ffb3de]">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm text-[#fdeaf5]/80">
          {
            directory.map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-[#ffd84d]">
                  <span aria-hidden="true" class="text-[#fa63b9]">
                    ❤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="border-b border-[#fa63b9]/30 pb-2 text-base font-black tracking-widest text-[#ffb3de]">ติดต่อเจ้าหน้าที่</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">💬</span>
          ติดต่อแอดมินทาง LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#ffd84d]/60 bg-transparent py-3 font-bold text-[#ffd84d] transition-all hover:bg-[#1a0914] hover:text-[#ffb3de]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <p class="mt-2 text-xs font-bold text-[#fdeaf5]/60">ธนาคารและวอลเล็ตที่รองรับ</p>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#fa63b9]/25 pt-6 text-xs text-[#fdeaf5]/60 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffd84d]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd84d]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
