---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is absolutely positioned at -top-6, so the card's top padding has
// to clear the badge's own height minus that 24px offset. The title is a full
// docx sentence, which wraps to three lines on a 320-375px viewport
// (3 x 24px line box + 20px py + 4px border = 96px, bottom edge at 72px), so
// pt-24 (96px) is the smallest padding that still leaves visible daylight.
// Do not shrink it back to pt-16 — that was sized for a 2-3 word placeholder.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#7a5d2c]/65 bg-gradient-to-b from-[#0b1405] to-[#030803] p-8 pt-24 shadow-[0_10px_40px_rgba(3,8,3,0.6)]">
    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#7a5d2c]/70 bg-[#030803] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(226,196,102,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#e2c466]">
            ✦
          </span>
          <HeadingTag class="bg-gradient-to-r from-[#fff4cd] via-[#e2c466] to-[#b5811e] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#e2c466]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfb4]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#efd591] drop-shadow-[0_0_5px_rgba(226,196,102,0.3)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfb4] md:border-l md:border-[#7a5d2c]/55 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#efd591] drop-shadow-[0_0_5px_rgba(226,196,102,0.3)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
