---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport.
//
// It is absolutely positioned at -top-6, so the card's top padding has to clear
// the badge's own height minus that 24px offset. A long docx H2 (หวยกินดี365's
// 67-character section title) wraps to three lines once the two ✦ spans and the
// padding are taken off a 320-375px viewport (3 x 24px line box + 20px py + 4px
// border = 96px, bottom edge at 72px), and it can reach four on the narrowest
// phones — so pt-28 (112px) is the mobile padding. From md the badge is
// max-w-2xl at text-2xl and wraps to two lines (2 x 36px + 24px = 96px, bottom
// edge at 72px), where pt-24 still leaves visible daylight. Do not shrink either
// back to pt-16 — that was sized for a 2-3 word placeholder.
//
// WIN8S palette: the card is the brand's black-to-ember gradient and the badge
// is the orange wordmark hue over the panel black.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#f36403]/40 bg-gradient-to-b from-[#2a0f03] to-[#050201] p-8 pt-28 shadow-[0_10px_40px_rgba(5,2,1,0.7)] md:pt-24">
    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#f36403]/70 bg-[#140300] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(243,100,3,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fd9a1e]">
            ✦
          </span>
          <HeadingTag class="bg-gradient-to-r from-[#fd9a1e] via-[#fc8d13] to-[#ec5402] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fd9a1e]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#fd9a1e] drop-shadow-[0_0_5px_rgba(243,100,3,0.30)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6] md:border-l md:border-[#f36403]/30 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#fd9a1e] drop-shadow-[0_0_5px_rgba(243,100,3,0.30)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
