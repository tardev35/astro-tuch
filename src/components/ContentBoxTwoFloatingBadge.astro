---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport and forcing horizontal scroll on a phone. Re-grepped for this brand:
// no `whitespace-nowrap` survives anywhere in this file.
//
// The two side ornaments stay OUT of the line box — they are `absolute`
// hairlines, so 100% of the badge's inner width belongs to the title and the
// card's top padding is sized against that full width.
//
// BADGE CLEARANCE RE-DERIVED FOR THIS BRAND (2026-10-20). This box carries docx
// H2 §6, which is "สมัครแทงบอล <BRAND> ง่ายๆ 3 ขั้นตอน" — 38 code points with the
// brand interpolated, 4 of them zero-width Thai marks, so it advances 34 cells
// including its 4 spaces. That is 15 cells SHORTER than the previous round's 49,
// so every band gains clearance rather than losing it; the arithmetic is still
// redone from scratch below rather than inherited, because the padding must never
// be trusted from a title it was not measured against. Its five space-delimited
// chunks measure 10 / 10 / 4 / 1 / 5 cells and the worst case assumed is that the
// line breaker only breaks at those 4 spaces (no Thai dictionary breaking). The
// widest chunk is 10 cells, narrower than one line at every width, so nothing can
// overflow sideways.
//
// Badge height = (line-height x wrapped lines) + py-2.5 (20px) + border-2 (4px),
// with `leading-normal` (1.5) on the heading, and its bottom edge sits at that
// minus 24px (`-top-6`), measured from the card's top. Text width = badge width
// - horizontal padding - border:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-base 16px -> ~9.3px/cell = 24 cells/line, 24px/line.
//               Greedy at the 4 spaces: 10+1+10 = 21 | 4+1+1+1+5 = 12
//                                                              -> 2 lines.
//               Budgeted at 3 to leave slack for a less efficient breaker:
//               3x24 + 24 = 96, edge 72 vs pt-36/144px   -> 72px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-xl 20px -> ~11.6px/cell = 42 cells/line. 34 -> 1 line.
//               Budget 2 = 2x30 + 24 = 84, edge 60 vs pt-36/144px
//                                                        -> 84px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl 24px -> ~13.9px/cell = 43 cells/line. 34 -> 1 line.
//               Budget 2 = 2x36 + 24 = 96, edge 72 vs pt-36/144px
//                                                        -> 72px clear
// Every band clears with daylight to spare, so pt-36 stands unchanged and NO
// *FloatingBadge padding moved this round. The flat pt-36 is held across all
// four files (this one, ContentBoxFloatingBadge, ContentBoxSevenThreeFloatingBadge
// and ContentBox3ThreeFloatingBadge) so the next brand cannot inherit a padding
// that was only ever sized for a short title — an older round shipped
// pt-36 / pt-28 / pt-32 / pt-32-sm:pt-24 and the short ones went down to 4px of
// clearance the moment they got a real docx sentence. Do not push it either way
// without redoing the arithmetic against the real sentence the next brand puts
// in here.
//
// ufalion168 (รอบ **ทองสองเฉด + บรอนซ์ บนดำสนิท — ไม่มีสีที่สองที่เป็นคนละวงศ์**
// 2026-10-20, brand-spec §2): พาเลตต์ทองอำพันน้ำผึ้ง + เลมอนครีม + บรอนซ์ บนพื้น
// **ดำสนิท #000000** การ์ดไล่จากผิวกลาง #1f1304 ขึ้นไปหาผิวยก #33200a ในกรอบทองนำ
// #d4922c หนาสองพิกเซล
// ป้ายลอยของใบนี้เป็นขั้วตรงข้ามกับเกือบทุกหัวข้อบนหน้า: **แผ่นทองทึบ** ไล่ ทองนำ
// #d4922c → ทองสว่าง #fdfc71 ที่ถือ **หมึกเข้ม #1a1000** ซึ่ง §2 ระบุว่าเป็นหมึก
// ตัวเดียวที่วางบนพื้นถมทอง/เลมอน/ครีมได้ (7.10:1 บน #d4922c · 17.3:1 บน #fdfc71)
// — **ห้ามพลิกแผ่นนี้ไปใช้หมึกสว่าง** และห้ามลากปลายเข้มของไล่เฉดลงไปถึง #a25b24
// หรือ #5a3310 เพราะหมึกจะอ่านไม่ออก ⚠️ ลำดับสองสต็อปนี้ (ทองนำ → เลมอน) ไม่ซ้ำกับ
// หัวข้อใบไหนบนหน้าเดียวกัน
// เป็นป้ายลอยใบเดียวของหน้านี้ ประกายสองข้างเป็นเส้นตั้งคู่บรอนซ์ #a25b24 กับ
// บรอนซ์ไหม้ #5a3310 ซึ่งอ่านเป็นริ้วทองเหลวที่สาดโค้งรอบหัวสิงโตบนโลโก้
// ป้ายคอลัมน์ซ้ายเป็นทองนำ #d4922c (5.87:1 บนผิวยก) ฝั่งขวาเป็นครีมทอง #f6e3b4
// (12.3:1) ทั้งคู่เป็น text-2xl font-bold จึงเป็น large text
// บรอนซ์ #a25b24 และบรอนซ์ไหม้ #5a3310 เป็นขอบ เส้นคั่น และเงาเท่านั้น ไม่ถือ
// ตัวอักษรที่ไหนในไฟล์นี้ ตามที่ §2 กำหนด (4.06:1 บนดำ · 3.0:1 บนผิวการ์ด = ตก AA)
// เนื้อความ #fbf6e3 (= BRAND_TEXT, 14.3:1 บนผิวยก) ทองนำสงวนไว้ให้ <strong> ใน
// เนื้อความของหน้าแรก จึงอยู่ในไฟล์นี้ได้ที่ขอบ แผ่นป้าย และป้ายคอลัมน์
//
// ⚠️ เทียบสีเป็นค่า ไม่ใช่ตระกูลสี: **กับดักรอบนี้คือทอง เพราะทองเคยนำมาแล้ว
// เกือบทุกแบรนด์ในรีโปนี้** ชุดทองอิมพีเรียล-แดงชาดของรวยเทพ168 ที่เพิ่งค้างอยู่
// ทั้งไฟล์นี้ (#f0bb4e #ffeccb #e4021b #d9701a #3b1b0e #260d04 #0d0501 #5c2a06
// #fff8ec #2b1400) ชุดแดงมังกร-ทองไทยของสมหวัง168 (#fa0513 #ffadaf #ff5a5f #e3b23c
// #ffe5a8 #8a6210 #b90203 #8c0204 #5b0203 #3c0303 #170504 #f4ecea #2c1413 #1f0d0c
// #290f0f) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #ffe08a #bb8410 #7d5a07
// #43300a #b9c2cc #8792a0 #464f5a #17130a #0d0b06 #f0e8d4) ชุดทองสายฟ้า-แดงเลือดนก
// ของ FLASH877 (#f5c518 #ffdd73 #b8860f #8a6208 #ff3b14 #8c0f0a #5a0603 #fdf0e2)
// ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #9c6f08 #b3006a
// #7a0046 #4d002b #2b0019) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #f6ecd9) ชุดเขียวป่า-ทองของ KINGKONG555
// (#8ce023 #f2c230 #ffe066 #a87a08) ชุดแดงเสือโคร่งของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666) และชุดม่วงนีออนของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d
// #c98a05 #1e0a3c) ออกครบทุกจุดแล้ว
// ⚠️ ทองนำรอบนี้ #d4922c (R=212 G=146 B=44) **ไม่ใช่ #dfa310 ของ TND168 (G=163
// B=16) ซึ่งเป็นตัวที่ใกล้ที่สุด** ไม่ใช่ #f0bb4e ของรอบขาออก (R=240 G=187) ไม่ใช่
// #e3b23c ของสมหวัง168 (R=227 G=178) ไม่ใช่ #e5a81b ของ UFA324 และไม่ใช่ #e2b33f
// ของ KMD88 · ทองสว่างรอบนี้ #fdfc71 (B=113) ไม่ใช่ #fef54b ของนินจา168 (B=75) ·
// บรอนซ์ #a25b24 ไม่มีแบรนด์ไหนในรีโปนี้เคยใช้ และไม่ใช่ #d9701a ทองแดงของรอบขาออก
// ⚠️ **รอบนี้ไม่มีแดงเลย** (รอบขาออกแดง #e4021b เป็นฮิวที่สอง) **ไม่มีเงิน/โครเมียม
// ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว ไม่มีน้ำเงิน/ฟ้า และไม่มีส้มสด**
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#d4922c]/70 bg-gradient-to-b from-[#1f1304] to-[#33200a] p-8 pt-36 shadow-[0_10px_40px_rgba(0,0,0,0.6)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#d4922c]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#a25b24]/22 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 isolate flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center overflow-hidden rounded-lg border-2 border-[#a25b24] bg-gradient-to-r from-[#d4922c] to-[#fdfc71] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(0,0,0,0.65)] sm:px-8">
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 left-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#a25b24] to-transparent" />
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 right-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#5a3310] to-transparent" />
          <HeadingTag class="text-base leading-normal font-black tracking-tighter text-[#1a1000] uppercase sm:text-xl md:text-2xl">{title}</HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbf6e3]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#d4922c]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbf6e3] md:border-l md:border-[#5a3310] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#f6e3b4]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
