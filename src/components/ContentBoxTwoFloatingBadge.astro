---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport and forcing horizontal scroll on a phone. Re-checked for this brand:
// no `whitespace-nowrap` survives anywhere in this file.
//
// The two side ornaments stay OUT of the line box — they are `absolute`
// hairlines, so 100% of the badge's inner width belongs to the title and the
// card's top padding is sized against that full width.
//
// BADGE CLEARANCE RE-DERIVED FOR 789BETTING (2026-10-08). This box carries docx
// H2 #6:
//   "คาสิโนออนไลน์ 789BETTING ฝากถอนได้ทุกช่องทาง ยอดเข้าบริษัทตรง"
// 61 code points; 8 of them are zero-width Thai marks, so it advances 53 cells
// including its 3 spaces — the LONGEST heading anywhere on this page, longer
// even than the docx H1. Its four space-delimited chunks measure
// 11 / 10 / 16 / 13 cells, and the worst case assumed below is that the line
// breaker only breaks at those 3 spaces (no Thai dictionary breaking). No chunk
// is wider than one line at any width, so nothing can overflow sideways.
//
// Badge height = (line-height x wrapped lines) + py-2.5 (20px) + border-2 (4px),
// with `leading-normal` (1.5) on the heading, and its bottom edge sits at that
// minus 24px (`-top-6`), measured from the card's top. Text width = badge width
// - horizontal padding - border:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-base 16px -> ~9.3px/cell = 24 cells/line, 24px/line.
//               Greedy at the 3 spaces: 11+1+10 | 16 | 13 -> 3 lines.
//               Budget 4 lines = 4x24 + 24 = 120, edge 96 vs pt-36/144px
//                                                        -> 48px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-xl 20px -> ~11.6px/cell = 42 cells/line, 30px/line.
//               11+1+10+1+16 = 39 | 13 -> 2 lines.
//               Budget 3 = 3x30 + 24 = 114, edge 90
//               vs pt-36/144px (sm inherits it)            -> 54px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl 24px -> ~13.9px/cell = 43 cells/line, 36px/line.
//               39 | 13 -> 2 lines. Budget 3 = 3x36 + 24 = 132, edge 108
//               vs pt-36/144px                             -> 36px clear
// The padding goes UP from the pt-28 the previous brand needed, because this
// round's docx H2 #6 is a materially longer sentence (53 cells against 39) and
// at md the 3-line budget came out at 4px of clearance against the old 112px.
// All three *FloatingBadge files now sit on the same flat pt-36 so the next
// brand cannot inherit a padding that was only ever sized for the short one. Do
// not push it either way without redoing the arithmetic against the real docx
// sentence the next brand puts in here.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): การ์ดไล่จากผิวกลาง
// #0e0b05 ขึ้นไปหาผิวยก #17130a ในกรอบทองแชมเปญ #ffe79a ซึ่งกลับทางกับ
// ContentBoxFloatingBadge ที่ไล่ยก→กลาง ในกรอบทองแบรนด์ #fad354
// ป้ายลอยของใบนี้เป็น "แผ่นดำลึกสุด" #060402 บนการ์ดมืด ซึ่งเป็นขั้วตรงข้ามกับป้ายทองทึบ
// ของ ContentBoxFloatingBadge ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน — สองป้ายลอยบนหน้าเดียว
// จึงไม่อ่านเป็นแผ่นเดียวกันสองรอบ หัวข้อบนพื้นดำจึงไล่เฉดได้ตามปกติ ทองแชมเปญ #ffe79a →
// ทองกลาง #ddab33 → ทองแบรนด์ #fad354 (ปลายที่เข้มสุด #ddab33 บนพื้น #060402 ได้ 10.5:1)
// ซึ่งเป็นลำดับไล่เฉดที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว ทองลึก #8a6410 กับ
// เส้นไรผม #4a3407 ถูกใช้เป็นขอบและเส้นคั่นเท่านั้น ไม่เคยเป็นสีตัวอักษร เพราะอ่านไม่ออก
// บนพื้นมืด
// ประกายสองข้างเป็นเส้นตั้งคู่ทองแชมเปญ-ทองกลาง แทนที่จะเป็นอักขระ ป้ายคอลัมน์ซ้ายเป็น
// ทองแบรนด์ #fad354 ฝั่งขวาเป็นทองแชมเปญ #ffe79a ซึ่งสลับฝั่งกับ ContentBoxTwoCyberCut
// เนื้อความ #f3e7cd (= BRAND_TEXT)
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#f5d98a #c8912f #6d4412
// #d8dbe0 #120c07 #191108 #070504 #ece1cc) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#ffe79a]/70 bg-gradient-to-b from-[#0e0b05] to-[#17130a] p-8 pt-36 shadow-[0_10px_40px_rgba(0,0,0,0.6)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fad354]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#c9881f]/32 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 isolate flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center overflow-hidden rounded-lg border-2 border-[#fad354]/80 bg-[#060402] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(0,0,0,0.65)] sm:px-8">
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 left-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#ffe79a] to-transparent" />
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 right-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#ddab33] to-transparent" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe79a] via-[#ddab33] to-[#fad354] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#fad354]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd] md:border-l md:border-[#4a3407] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#ffe79a]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
