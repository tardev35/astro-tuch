---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport and forcing horizontal scroll on a phone. Re-checked for this brand:
// no `whitespace-nowrap` survives anywhere in this file.
//
// It is absolutely positioned at -top-6, so the card's top padding has to clear
// the badge's own height minus that 24px offset. RE-DERIVED for UP555's docx
// H2 #2, "UP555 สล็อต บาคาร่า บอล หวย ครบทุกประเภท ระบบอัปเกรดใหม่ ปลอดภัยแน่นอน" —
// 70 code points, ~65 advancing glyphs once the 5 zero-width Thai marks
// (็ ่ ั ่ ่) are discounted. That is nearly DOUBLE the 34-glyph title the
// previous pt-32/md:pt-36 pair was sized against, so the padding moves up a step
// to pt-36/md:pt-40. The heading carries `leading-normal` (1.5), the badge adds
// py-2.5 (20px) and border-2 (4px), and the two ✦ spans plus gap-2 take ~48px of
// the line box. Budget is one full spare line beyond the measured wrap:
//   base  text-base 16px -> 24px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~24 glyphs/line,
//         so 65 glyphs wraps to 3. Budget 4 lines = 4x24 + 24 = 120px,
//         bottom edge 96px vs pt-36/144px             -> 48px clear
//   sm    text-xl 20px -> 30px/line, ~473px of text width
//         (w-[92%] 589 - px-8 64 - border 4 - sparks 48) = ~43 glyphs/line,
//         so 2 lines. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-36/144px             -> 54px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 glyphs/line,
//         so 2 lines. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-40/160px         -> 52px clear
// Do not push it back down without redoing the arithmetic against the real docx
// sentence the next brand puts in here. The sibling *FloatingBadge files are not
// rendered this round and still carry pt-32/md:pt-36 as inventory; whichever
// brand wires one in next owns that same derivation for its own title.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): การ์ดไล่จากผิวการ์ดดำอม
// น้ำตาล #130b03 ลงไปหาพื้นเพจ #0c0502 ในกรอบทองแบรนด์ #ebbb54 ซึ่งต่างจาก
// ContentBoxCyberCut ที่เป็นมุมตัดไร้ป้ายลอย ป้ายหัวข้อลอยบนพื้นเพจ #0c0502 ในกรอบ
// ทองแบรนด์ ประกายสองข้างแยกตามคู่โลหะของโลโก้ — ทองสว่าง #fce675 ฝั่งซ้ายตามเลข 555
// ที่เป็นทองเมทัลลิก และเงินโครเมียม #d5d4d3 ฝั่งขวาตามตัวอักษร UP ที่เป็นเงิน ตัวหัวข้อ
// สานสองโลหะเข้าด้วยกัน ทองสว่าง #fce675 → เงินโครเมียม #d5d4d3 → ทองลึก #ab6d24
// ซึ่งเป็นไล่เฉดเดียวบนหน้านี้ที่สลับโลหะกลางทาง ป้ายคอลัมน์ซ้ายเป็นทองสว่าง ฝั่งขวาเป็น
// เงิน เส้นคั่นเป็นทองลึก #6b4517 เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#edb543 #fcdc73 #fde8a8 #e6e6e6
// #a9761f #101010 #070707 #3a2a0d #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#ebbb54] bg-gradient-to-b from-[#130b03] to-[#0c0502] p-8 pt-36 shadow-[0_10px_40px_rgba(5,2,1,0.85)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fce675]/26 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#d5d4d3]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ebbb54]/80 bg-[#0c0502] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(235,187,84,0.35)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fce675]">
            ✦
          </span>
          <HeadingTag class="bg-gradient-to-r from-[#fce675] via-[#d5d4d3] to-[#ab6d24] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#d5d4d3]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#fce675] drop-shadow-[0_0_5px_rgba(235,187,84,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9] md:border-l md:border-[#6b4517] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#d5d4d3] drop-shadow-[0_0_5px_rgba(213,212,211,0.3)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
