---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport and forcing horizontal scroll on a phone. Re-checked for this brand:
// no `whitespace-nowrap` survives anywhere in this file.
//
// The two side ornaments stay OUT of the line box — they are `absolute`
// hairlines, so 100% of the badge's inner width belongs to the title and the
// card's top padding is sized against that full width.
//
// BADGE CLEARANCE RE-DERIVED FOR UOK365 (2026-10-07). This box carries docx H2 #6:
//   "สมัครเว็บ UOK365 เล่นสล็อตไม่จำกัดยอด 3 ขั้นตอน"
// 47 code points; 8 of them are zero-width Thai marks, so it advances 39 cells
// including its 4 spaces. Its five space-delimited chunks measure
// 7 / 6 / 16 / 1 / 5 cells, and the worst case assumed below is that the line
// breaker only breaks at those 4 spaces (no Thai dictionary breaking). No chunk
// is wider than one line at any width, so nothing can overflow sideways.
//
// Badge height = (line-height x wrapped lines) + py-2.5 (20px) + border-2 (4px),
// with `leading-normal` (1.5) on the heading, and its bottom edge sits at that
// minus 24px (`-top-6`), measured from the card's top. Text width = badge width
// - horizontal padding - border:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-base 16px -> ~9.3px/cell = 24 cells/line, 24px/line.
//               Greedy at the 4 spaces: 7+1+6 | 16+1+1+1+5 -> 2 lines.
//               Budget 3 lines = 3x24 + 24 = 96, edge 72 vs pt-28/112px
//                                                        -> 40px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-xl 20px -> ~11.6px/cell = 42 cells/line, 30px/line.
//               All 39 cells on 1 line. Budget 2 = 2x30 + 24 = 84, edge 60
//               vs pt-28/112px (sm inherits it)            -> 52px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl 24px -> ~13.9px/cell = 43 cells/line, 36px/line.
//               1 line. Budget 2 = 2x36 + 24 = 96, edge 72
//               vs pt-28/112px                             -> 40px clear
// One flat pt-28 covers every width here, and it comes DOWN from the pt-36 the
// previous brand needed because this round's docx H2 #6 is a shorter sentence
// (39 cells against 47). Do not push it either way without redoing the
// arithmetic against the real sentence the next brand puts in here.
//
// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// การ์ดไล่จากผิวกลาง #120c07 ขึ้นไปหาผิวยก #191108 ในกรอบทองอ่อน #f5d98a ซึ่งกลับทาง
// กับ ContentBoxFloatingBadge ที่ไล่ยก→กลาง ในกรอบทองแบรนด์ #c8912f
// ป้ายลอยของใบนี้เป็น "แผ่นดำลึกสุด" #070504 บนการ์ดมืด ซึ่งเป็นขั้วตรงข้ามกับป้ายทอง
// ทึบของ ContentBoxFloatingBadge ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน — สองป้ายลอยบนหน้า
// เดียวจึงไม่อ่านเป็นแผ่นเดียวกันสองรอบ หัวข้อบนพื้นดำจึงไล่เฉดได้ตามปกติ ทองอ่อน
// #f5d98a → เงินโครเมียม #d8dbe0 → ทองแบรนด์ #c8912f (ปลายที่เข้มสุด #c8912f บนพื้น
// #070504 ได้ 7.3:1) ซึ่งเป็นจุดเดียวในไฟล์นี้ที่เงินโครเมียมถูกใช้เป็นสีตัวอักษร ตาม
// กฎ §2 ที่ให้ใช้เงินอย่างประหยัดในฐานะ "โลหะตัวที่สอง" ไม่ใช่สีแบรนด์ตัวที่สอง
// ประกายสองข้างเป็นเส้นตั้งคู่ทอง-เงินแทนที่จะเป็นอักขระ ป้ายคอลัมน์ซ้ายเป็นเงิน
// โครเมียม ฝั่งขวาเป็นทองอ่อน ซึ่งสลับฝั่งกับ ContentBoxTwoCyberCut
// เส้นคั่นเป็นทองลึก #6d4412 เนื้อความ #ece1cc (= BRAND_TEXT)
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 ที่เคยค้างในไฟล์นี้ (#e7f2fd #f6fbff #fdbc04
// #04203f #5ec2ff #e4f1fd #ffe27a #8a6102 #065a9c #9ecbf2 #0d2744
// rgba(6,53,95,…)) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f5d98a]/70 bg-gradient-to-b from-[#120c07] to-[#191108] p-8 pt-28 shadow-[0_10px_40px_rgba(0,0,0,0.6)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#c8912f]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#d8dbe0]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 isolate flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center overflow-hidden rounded-lg border-2 border-[#c8912f]/80 bg-[#070504] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(0,0,0,0.65)] sm:px-8">
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 left-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#f5d98a] to-transparent" />
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 right-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#d8dbe0] to-transparent" />
          <HeadingTag class="bg-gradient-to-r from-[#f5d98a] via-[#d8dbe0] to-[#c8912f] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#d8dbe0]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc] md:border-l md:border-[#6d4412] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#f5d98a]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
