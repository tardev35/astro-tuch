---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is absolutely positioned at -top-6, so the card's top padding has
// to clear the badge's own height minus that 24px offset. The title is a full
// docx sentence, which wraps to three lines on a 320-375px viewport
// (3 x 24px line box + 20px py + 4px border = 96px, bottom edge at 72px), so
// pt-24 (96px) is the smallest padding that still leaves visible daylight.
// Do not shrink it back to pt-16 — that was sized for a 2-3 word placeholder.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#0b6cf0]/40 bg-gradient-to-b from-[#0a1836] to-[#03081c] p-8 pt-24 shadow-[0_10px_40px_rgba(2,6,15,0.5)]">
    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#0b6cf0]/50 bg-[#03081c] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(11,108,240,0.2)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#c3ced9]">
            ✦
          </span>
          <HeadingTag class="bg-gradient-to-r from-[#e8f2fd] via-[#c3ced9] to-[#4aa3ff] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#c3ced9]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdcea]">
        {titleleft && <h3 class="text-2xl leading-normal font-bold text-[#9dd2fa] drop-shadow-[0_0_5px_rgba(11,108,240,0.3)]">{titleleft}</h3>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdcea] md:border-l md:border-[#1e4b9e]/50 md:pl-10">
        {titleright && <h3 class="text-2xl leading-normal font-bold text-[#9dd2fa] drop-shadow-[0_0_5px_rgba(11,108,240,0.3)]">{titleright}</h3>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
