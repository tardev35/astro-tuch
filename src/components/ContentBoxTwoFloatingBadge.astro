---
export interface Props {
  /** The section's own docx heading — rendered inside the floating badge. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. These are card furniture rather than docx sections, so they
   *  render as <p> carrying the same classes a heading would. */
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred rather than
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport and forcing horizontal scroll on a phone. Re-checked for this brand:
// no `whitespace-nowrap` survives anywhere in this file.
//
// CHANGE THAT MADE THE NUMBERS WORK THIS ROUND: the two ✦ glyphs are out of the
// line box. The previous owner put them INSIDE the flex row, where they plus
// their gap-2 ate ~48px of every line at every width — a fifth of the text column
// on a phone. They are a pair of `absolute` side rules now, so 100% of the
// badge's inner width belongs to the title and the card's top padding comes down
// with it.
//
// BADGE CLEARANCE RE-DERIVED FOR HI59 (2026-10-07). This box carries docx H2 #6:
//   "เว็บ HI59 ฝากถอนได้ทุกช่องทาง ยอดเข้าบริษัทตรง ไม่ผ่านม้า"
// 56 code points; 9 of them are zero-width Thai marks, so it advances 47 cells
// including its 4 spaces. Its five space-delimited chunks measure
// 3 / 4 / 16 / 13 / 7 cells, and the worst case assumed below is that the line
// breaker only breaks at those 4 spaces (no Thai dictionary breaking).
//
// Badge height = (line-height x wrapped lines) + py-2.5 (20px) + border-2 (4px),
// and its bottom edge sits at that minus 24px (`-top-6`), measured from the
// card's top. Text width = badge width - horizontal padding - border:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-base 16px -> ~9.3px/cell = 24 cells/line, 24px/line.
//               Greedy at the 4 spaces: 3+1+4 | 16 | 13+1+7 -> 3 lines.
//               Budget 4 lines = 4x24 + 24 = 120, edge 96 vs pt-36/144px
//                                                        -> 48px clear
//   base 360px  badge 302, text 266 -> 28 cells/line. 25 | 21 -> 2 lines.
//               Budget 4, same 96 edge                     -> 48px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-xl 20px -> ~11.6px/cell = 42 cells/line, 30px/line.
//               39 | 7 -> 2 lines. Budget 3 = 3x30 + 24 = 114, edge 90
//               vs pt-36/144px (sm inherits it)            -> 54px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl 24px -> ~13.9px/cell = 43 cells/line, 36px/line.
//               39 | 7 -> 2 lines. Budget 3 = 3x36 + 24 = 132, edge 108
//               vs pt-36/144px                             -> 36px clear
// One flat pt-36 covers every width here because the wider badge at md buys back
// exactly what the taller text-2xl line costs. Do not push it either way without
// redoing the arithmetic against the real sentence the next brand puts in here.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): การ์ดสว่างไล่จาก #e7f2fd
// ขึ้นไปหา #f6fbff ในกรอบทองแบรนด์ #fdbc04 ซึ่งกลับทางกับ ContentBoxFloatingBadge ที่
// ไล่สว่าง→หม่น ในกรอบฟ้า
// ป้ายลอยของใบนี้เป็น "แผ่นกรมท่าเข้ม" #04203f บนการ์ดสว่าง ซึ่งเป็นขั้วตรงข้ามกับป้าย
// ทองทึบของ ContentBoxFloatingBadge ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน — สองป้ายลอยบน
// หน้าเดียวจึงไม่อ่านเป็นแผ่นเดียวกันสองรอบ หัวข้อบนพื้นเข้มจึงไล่เฉดได้ตามปกติ
// ขาวฟ้า #e4f1fd → ทองอ่อน #ffe27a → ฟ้าเรือง #5ec2ff (#e4f1fd บนพื้นกรมท่าได้
// 13.8:1) ซึ่งเป็นจุดเดียวในไฟล์นี้ที่สีตัวอักษรชุดโครมถูกใช้ ตามกฎ §2 ที่ว่า #e4f1fd
// ต้องอยู่บนผิวโครมเข้มเท่านั้น
// ประกายสองข้างเป็นเส้นตั้งคู่ฟ้า-ทองของโลโก้แทนที่จะเป็นอักขระ ป้ายคอลัมน์ซ้ายเป็น
// ทองหมึก #8a6102 ฝั่งขวาเป็นฟ้าลึก #065a9c ซึ่งสลับฝั่งกับ ContentBoxTwoCyberCut
// เส้นคั่นเป็นฟ้าขอบการ์ด #9ecbf2 เนื้อความ #0d2744 (= BRAND_TEXT)
//
// ชุดแดงแบรนด์+ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#230d0d #0a0303 #d20a0a #ff3b3b
// #f5c33b #ffd45e #7a0505 #f7e2d6) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#fdbc04] bg-gradient-to-b from-[#e7f2fd] to-[#f6fbff] p-8 pt-36 shadow-[0_10px_40px_rgba(6,53,95,0.20)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#5ec2ff]/40 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#fdbc04]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 isolate flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center overflow-hidden rounded-lg border-2 border-[#fdbc04]/80 bg-[#04203f] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(6,53,95,0.45)] sm:px-8">
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 left-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#5ec2ff] to-transparent" />
          <span aria-hidden="true" class="pointer-events-none absolute inset-y-2 right-2 -z-10 w-[3px] rounded-full bg-gradient-to-b from-transparent via-[#fdbc04] to-transparent" />
          <HeadingTag class="bg-gradient-to-r from-[#e4f1fd] via-[#ffe27a] to-[#5ec2ff] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#8a6102]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744] md:border-l md:border-[#9ecbf2] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#065a9c]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
