---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// อ่านจากไฟล์ src/assets/logo.webp ของดรอปนี้จริง (2026-10-28) ไม่ได้คัดลอกของรอบก่อน
// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูป แต่ alt อ้างชื่อด้วย ${BRAND_NAME} เท่านั้น
// ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลงใน alt (โลโก้ขึ้นทุกหน้า จึงเป็นจุดรั่วที่กว้างที่สุด)
// 🚨 ของรอบก่อน (LOTTO189) ที่ **ไม่มี** ในรูปนี้: เวิร์ดมาร์กเซอริฟที่ครึ่งหลัง
// เป็น "ตัวเลข" ผิวแดงเลือดนก · แถบแสงสะท้อนขาวพาดกลางตัวเลข · เส้นตัดขอบแดง
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเวิร์ดมาร์กสามมิติตัวหนาสองบรรทัดวางอยู่ในวงรี บรรทัดบนเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาไล่แสงจากขาวลงมาหาเทา ตัดขอบเส้นสีเขียวเข้ม โดยตัวอักษร O ตัวที่สองถูกแทนที่ด้วยใบโคลเวอร์สี่แฉกสีเขียวมรกตเคลือบเงา บรรทัดล่างเป็นตัวอักษรผิวเขียวมรกตไล่เงาตัดขอบเขียวเข้ม รอบนอกมีแถบโค้งผิวโครเมียมเงินสลับเขียวมรกตพันรอบเป็นวงโคจรสองชั้น พร้อมจุดประกายแสงสีขาวกระจายตามขอบ วางอยู่บนพื้นโปร่งใส`;

// พาเลตรอบนี้ (LOTTOPLUS ดรอป 2026-10-28) ล็อกไว้ใน .claude/brand-spec-lottoplus.md §2
// ทิศของธีม: **เนื้อหาสว่าง (การ์ดขาวบนพื้นเพจ #e1fef3) แต่โครมเข้ม** — navbar คือโครม
// จึงเป็นแถบผิวเขียวป่าจม #052e22 ที่ยกขึ้นจากพื้นเพจสว่างอย่างชัดเจน ทำหน้าที่เป็น
// "กรอบโปสเตอร์" ให้อาร์ตเวิร์กที่เป็นฉากห้องสีขาวงาช้าง — **ห้าม "แก้" ให้โครมสว่าง
// ตามพื้นเพจ** ชั้นจมของปุ่มรอง/ปุ่มแฮมเบอร์เกอร์เป็น #03201a ชั้นยกเป็น #0a4433
// เส้นขอบเป็น #19a97c และ accent ทองอำพัน #e2b32a อ่านมาจากลวดลายปักทองบนชุดไทย
// ยอดปรางค์ทอง และขอบทองของแคปซูล "แทงหวยออนไลน์ จ่ายเต็ม โอนไว" บนแบนเนอร์
// ส่วนเงินโครเมียม #c8d4d0 อ่านมาจากบรรทัดบนของเวิร์ดมาร์กและแถบวงโคจร
// ตัวอักษรเมนูปกติเป็นหมึกมินต์ขาว #e9fbf3 และ hover ยกเป็นขาวสนิท
//
// ⚠️⚠️ ธีมเดิมของไฟล์นี้คือ **LOTTO189 แดงเลือดนก/ทองอำพัน** (24060c 120307 3d0d16
// 7e1221 8a0412 b00718 d61023 ff2436 e9b53c c3ccd6 ffeaea) และก่อนหน้านั้น
// **รวย168 ดำ/ทอง** (121110 070707 ffd94a e3a712 b07d08 f3ece0 0a0a0a) และ
// **สาธุ168 เขียวมรกต/ทองสัมฤทธิ์** (0c3a16 061f0c c9cb63 aeb04a 9ba03c e9fbdd)
// — ถอดออกครบทั้งสามชุดแล้ว ห้ามเขียนกลับเข้ามา
// 🚨🚨 **สาธุ168 เป็นเขียวมรกต/ทอง = ตระกูลสีเดียวกับรอบนี้เป๊ะ** และ TEVA69 กับ
// ZORO365 ก็เป็นเขียวมาแล้ว → **"เจอเขียว ≠ เป็นของรอบนี้"** ต้องเทียบให้ตรงหกหลัก
// กับ brand-spec §2 ห้ามตัดสินด้วยสายตา
// 🚨🚨 และ **LOTTO189 เป็นเว็บหวยเหมือนรอบนี้** ไฟล์นี้จึงถูกทั้งเรื่องโครงสร้าง
// (เมนู 9 รายการมี ตรวจหวย/แนวทาง · ไอคอนแนวหวย) ตั้งแต่ยังไม่แก้ **แต่สีทุกค่า
// เป็นของแบรนด์นั้น** — ความถูกเชิงโครงสร้างไม่เคยพิสูจน์ความถูกเชิงสี
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// คู่พื้น-หมึกของปุ่ม คำนวณครบทุก stop แล้ว ห้ามสลับข้าง:
// - ปุ่มสมัครสมาชิก = ไล่เฉดเขียว #0c7c58 → #046c4e → #03543c ถือหมึกขาว #ffffff
//   ได้ 5.2:1 / 6.7:1 / 9.2:1 ตามลำดับ ปลายสว่างของไล่เฉดจึงจบที่ #0c7c58 พอดี
//   ⚠️⚠️ **ห้ามดัน stop ขึ้นไปถึง #19a97c หรือ #e2b32a** — ขาวบน #19a97c ได้แค่
//   3.0:1 และบน #e2b32a ได้ 2.0:1 ตกเกณฑ์ทั้งคู่ สองค่านั้นสงวนไว้สำหรับ
//   ขอบ/ออรา/พื้นถมที่ไม่มีตัวอักษร และสำหรับ accent บนผิวเข้มเท่านั้น
// - ปุ่มเข้าสู่ระบบ = ขอบทอง #e2b32a/35 บนพื้นจม #03201a/70 ถือตัวอักษรขาว
// - เมนูปกติ #e9fbf3 บน #052e22 = 14.0:1 · สถานะ active #e2b32a บน #052e22 = 7.4:1
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน และอ่านจากอาร์ตเวิร์กของดรอปนี้เอง:
// 🎁 โปรโมชั่น (โปสเตอร์โปรโมชั่นของสไลด์ทั้งสองใบ) · 🔢 ตรวจหวย (ตัวเลขผลรางวัล) ·
// 📊 แนวทาง (สถิติย้อนหลัง) · 🎱 ทดลองเล่น (ลูกบอลหวยเขียว-ขาวพิมพ์ตัวเลข
// ที่วางอยู่สองฝั่งของแบนเนอร์) · 🏢 เกี่ยวกับเรา · 📞 ติดต่อเรา
// ⚠️ ห้ามใช้ 🎰 🃏 🎲 หรือไอคอนแนวสล็อต/คาสิโน — รอบนี้เป็นเว็บหวยล้วน
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// /ตรวจหวย และ /แนวทาง อยู่ในเมนูรอบนี้ เพราะแบรนด์นี้เป็นเว็บหวยเต็มตัว (บรีฟพูดถึง
// หวยรัฐบาลไทย/ลาว/ฮานอย/หุ้น และแบนเนอร์เขียนว่า "แทงหวยออนไลน์ จ่ายเต็ม โอนไว")
// และทั้งสองไฟล์ถูกย้ายกลับเข้า src/pages/ แล้วรอบนี้ — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ถ้าแบรนด์ถัดไปไม่ใช่เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น verify-build
// จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ เพราะ /ตรวจหวย กับ /แนวทาง อยู่ในเมนู —
// ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อยคืนเป็น text-sm
// tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับเข้าไป**:
// ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้และ
// มองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// เมนูประกาศที่เดียว (const menu) แล้วทั้งแถวเดสก์ท็อปและลิ้นชักมือถือ map จาก
// ตัวเดียวกัน — ห้ามแยกเป็นสองอาร์เรย์ ไม่งั้นรอบหน้าจะมีคนแก้แค่ฝั่งเดียว
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔢" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// โลโก้ของดรอปนี้เป็นบิตแมป **จัตุรัส** จึงถูกวาดกว้างเท่ากับความสูงที่กำหนดไว้
// (45px ที่จอทั่วไป · 55px ที่ xl) — candidate จึงเป็น 55 / 110 / 165 (1x 2x 3x)
// **ห้ามลอกตัวเลขของรอบก่อน** (130/260/390 คิดจากเวิร์ดมาร์กแนวนอน ซึ่งผิดรูปทรง
// สำหรับโลโก้จัตุรัส และทำให้โหลดไฟล์ใหญ่เกินที่วาดจริงเกินสองเท่า)
const logoWidths = [55, 110, 165];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#e2b32a]/55 bg-[#052e22]/95 px-4 shadow-[0_5px_20px_rgba(3,32,26,0.8)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#e2b32a]/25 bg-[#0a4433]/60 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={logoWidths}
            sizes="55px"
            class="h-[45px] w-auto drop-shadow-md xl:h-[55px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <p class="rounded-md bg-[#046c4e] px-3 py-1 text-2xl font-black tracking-widest text-[#ffffff] drop-shadow-md">{BRAND_NAME}</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#e2b32a]" : "text-[#e9fbf3]/80 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#e2b32a] via-[#2fd49b] to-[#046c4e] shadow-[0_-2px_10px_rgba(226,179,42,0.75)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#e2b32a]/35 bg-[#03201a]/70 px-6 py-2.5 text-sm font-bold text-[#ffffff] backdrop-blur-md transition-all hover:border-[#e2b32a]/70 hover:bg-[#0a4433]/80 hover:text-[#ffffff] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#03543c] via-[#046c4e] to-[#0c7c58] px-6 py-2.5 text-sm font-black text-[#ffffff] shadow-[0_4px_15px_rgba(4,108,78,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(25,169,124,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#e2b32a]/35 bg-[#03201a]/80 lg:hidden"
        aria-label="เปิดเมนูหลัก">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#e2b32a] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#e2b32a] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#e2b32a] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#e2b32a]/60 bg-[#052e22]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#e2b32a] bg-[#0a4433] text-[#e2b32a]" : "text-[#e9fbf3]/80 hover:bg-[#0a4433]/70 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#03543c] via-[#046c4e] to-[#0c7c58] py-3.5 text-lg font-black text-[#ffffff] shadow-[0_5px_15px_rgba(4,108,78,0.5)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#e2b32a]/35 bg-[#03201a]/70 py-3.5 text-lg font-bold text-[#ffffff]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
