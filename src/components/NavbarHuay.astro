---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ LOTTOPLUS ตัวอักษรภาษาอังกฤษสีขาวตัวหนาวางบนแถบสี่เหลี่ยมสีแดงสด";

// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): แถบบนพื้นดำอมแดง #120b0c ขอบแดงแบรนด์
// #dc020e (มาจากบล็อกแดงของโลโก้ตรงๆ) สถานะ active เป็นแดงสว่าง #ff2d38 ทองเป็น
// สีรอง #f3c623 ตามเหรียญทองกับมงกุฎในแบนเนอร์ ปุ่มสมัครไล่เฉดทอง ปุ่มเข้าสู่ระบบ
// เป็นการ์ดแดงเข้ม #2a0d0f ขอบทอง — ชุดแดง/ทองของ LOTTO24 รอบสองรอบก่อน
// (#dc2626 #fc2b2c #b40102 #fde68a #fbbf24 #e0a010 #15060a #2a0405 #f6e2e2)
// ถูกแทนครบทุกจุดแล้ว
//
// หมึกบนปุ่มสมัครเป็น #1a0203 บนทอง — ปลายล่างของไล่เฉดจึงต้องจบที่ทอง "สว่าง"
// #e0a808 (ได้ 9.3:1) ไม่ใช่ทองลึก #8a6a0a ซึ่งตกทันทีที่ 3.8:1 และห้ามเปลี่ยน
// ปุ่มนี้ไปเป็นไล่เฉดแดงโดยคงหมึกเข้มไว้ เพราะแดงแบรนด์ #dc020e กับหมึกเข้มได้
// แค่ 3.9:1 — ถ้าจะใช้พื้นแดง ต้องสลับหมึกเป็นขาว (ขาวบนแดงแบรนด์ = 5.2:1)
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน: 🔎 ตรวจหวย · 📊 แนวทาง ·
// 🎱 ทดลองเล่น (ลูกหวยแดง-ขาวในแบนเนอร์) · 🎫 โปรโมชั่น (โพย/ใบหวยในอาร์ตเวิร์ก)
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ (รอบก่อนของ LOTTO24 มี 7) เพราะ /ตรวจหวย กับ
// /แนวทาง กลับเข้ามา — ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อย
// คืนเป็น text-sm tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับ
// เข้าไป**: ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้
// และมองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// /ตรวจหวย และ /แนวทาง กลับเข้าเมนูรอบนี้ เพราะ LOTTOPLUS เป็นเว็บหวยล้วนและ
// ทั้งสองไฟล์ถูกย้ายกลับมาอยู่ใน src/pages/ แล้ว — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ถ้าแบรนด์ถัดไปไม่ใช่เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น
// verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎫" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔎" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏛️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#dc020e]/55 bg-[#120b0c]/95 px-4 shadow-[0_5px_20px_rgba(5,1,2,0.7)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#f3c623]/25 bg-[#f3c623]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt={logoAlt} loading="eager" widths={[130, 260, 390]} sizes="130px" class="h-[45px] w-auto drop-shadow-md xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <p class="rounded-md bg-[#dc020e] px-3 py-1 text-2xl font-black tracking-widest text-white drop-shadow-md">LOTTOPLUS</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#ff2d38]" : "text-[#f0e2e2]/80 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#fde79a] via-[#ff2d38] to-[#6b0207] shadow-[0_-2px_10px_rgba(220,2,14,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#f3c623]/35 bg-[#2a0d0f]/60 px-6 py-2.5 text-sm font-bold text-[#f0e2e2] backdrop-blur-md transition-all hover:border-[#f3c623]/70 hover:bg-[#f3c623]/10 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#e0a808] px-6 py-2.5 text-sm font-black text-[#1a0203] shadow-[0_4px_15px_rgba(243,198,35,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(243,198,35,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f3c623]/35 bg-[#2a0d0f]/70 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f3c623] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f3c623] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f3c623] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#dc020e]/60 bg-[#120b0c]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#ff2d38] bg-[#ff2d38]/10 text-[#ff2d38]" : "text-[#f0e2e2]/80 hover:bg-[#f3c623]/5 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#e0a808] py-3.5 text-lg font-black text-[#1a0203] shadow-[0_5px_15px_rgba(243,198,35,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#f3c623]/35 bg-[#2a0d0f]/60 py-3.5 text-lg font-bold text-[#f0e2e2]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
