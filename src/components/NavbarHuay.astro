---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ หวย365 ตัวอักษรเอียงหนาทึบบนพื้นขาว คำว่า หวย เป็นสีแดงสด ตามด้วยเลข 365 ที่สลับสีดำ แดง ดำ";

// หวย365 (รอบแดงสด-ทอง 2026-10-03): แถบบนพื้นดำอมแดง #140203 ขอบแดงแบรนด์
// #dc0203 ซึ่งมาจาก vivid ของ logo.webp ตรงๆ (#dc0203 #e00104 #e2020a เป็นแดง
// ล้วนทั้งชุด) สถานะ active เป็นแดงสว่าง #f5282a ทองเป็นสีรอง #ffc93c ตามเหรียญ
// ทองกับตัวอักษรบนแบนเนอร์ ตัวอักษรรองเป็นครีมอมชมพู #f6e7e0 = BRAND_TEXT
//
// รอบก่อน (NATO168) เป็นเว็บสล็อตโทนทอง-เงิน-ดำ ชุดเดิมในไฟล์นี้เป็นของ หวยเฮง789
// (#1c0606 #2b0909 #dc2224 #e43434 #f4bc5d #ffefc2 #a8690c #d99a10 #fbe3d4 #ab0204)
// ถูกแทนครบทุกจุดแล้ว — แดงของ หวยเฮง789 เป็น #dc2224 ที่อมชมพู ส่วนแดงของแบรนด์นี้
// เป็น #dc0203 ที่อิ่มกว่าและเอียงไปทางส้มเล็กน้อย จึงไม่ใช่การยกค่าเดิมมาใช้ซ้ำ
//
// หมึกบนปุ่มสมัครเป็น #1a0303 บนทอง — ปลายล่างของไล่เฉดจึงต้องจบที่ #c08a07
// (6.4:1) ห้ามจบที่ทองที่เข้มกว่านี้ และห้ามเปลี่ยนปุ่มนี้ไปเป็นไล่เฉดแดงโดยคง
// หมึกเข้มไว้ เพราะแดงแบรนด์ #dc0203 กับหมึก #1a0303 ได้แค่ 2.8:1 — ถ้าจะใช้
// พื้นแดง ต้องสลับหมึกเป็นขาว (ขาวบน #dc0203 ≈ 5.1:1 และตัวอักษรบนปุ่มเป็น bold
// ทุกตัว) หมึกทองอ่อนบนแดงยิ่งแย่กว่า ห้ามใช้
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน: 🔎 ตรวจหวย · 📊 แนวทาง ·
// 🎱 ทดลองเล่น (ลูกบอลหวยแดง-ขาวในแบนเนอร์) · 🎫 โปรโมชั่น (โพย/ใบหวยในอาร์ตเวิร์ก)
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ เพราะ /ตรวจหวย กับ /แนวทาง กลับเข้ามา —
// ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อยคืนเป็น text-sm
// tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับเข้าไป**:
// ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้และ
// มองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// /ตรวจหวย และ /แนวทาง อยู่ในเมนูรอบนี้ เพราะ หวย365 เป็นเว็บหวยล้วนและทั้งสองไฟล์
// ถูกย้ายกลับมาอยู่ใน src/pages/ แล้ว — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ ถ้าแบรนด์ถัดไป
// ไม่ใช่เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น verify-build จะฟ้อง
// href ที่ชี้ไป route ที่ไม่มีจริง
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎫" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔎" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏛️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#dc0203]/55 bg-[#140203]/95 px-4 shadow-[0_5px_20px_rgba(8,1,1,0.75)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#ffc93c]/25 bg-[#ffc93c]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt={logoAlt} loading="eager" widths={[130, 260, 390]} sizes="130px" class="h-[45px] w-auto drop-shadow-md xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <p class="rounded-md bg-[#dc0203] px-3 py-1 text-2xl font-black tracking-widest text-white drop-shadow-md">หวย365</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#f5282a]" : "text-[#f6e7e0]/80 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#ffeab0] via-[#f5282a] to-[#8c0402] shadow-[0_-2px_10px_rgba(220,2,3,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#ffc93c]/35 bg-[#3a0a0c]/60 px-6 py-2.5 text-sm font-bold text-[#f6e7e0] backdrop-blur-md transition-all hover:border-[#ffc93c]/70 hover:bg-[#ffc93c]/10 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] px-6 py-2.5 text-sm font-black text-[#1a0303] shadow-[0_4px_15px_rgba(255,201,60,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(255,201,60,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#ffc93c]/35 bg-[#3a0a0c]/70 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#ffc93c] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#ffc93c] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#ffc93c] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#dc0203]/60 bg-[#140203]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#f5282a] bg-[#f5282a]/10 text-[#f5282a]" : "text-[#f6e7e0]/80 hover:bg-[#ffc93c]/5 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] py-3.5 text-lg font-black text-[#1a0303] shadow-[0_5px_15px_rgba(255,201,60,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#ffc93c]/35 bg-[#3a0a0c]/60 py-3.5 text-lg font-bold text-[#f6e7e0]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
