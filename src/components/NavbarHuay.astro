---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ 365LOTTO ตัวเลข 365 สีทองสามมิติ ต่อด้วยคำว่า LOTTO สีขาวโครเมียมที่ตัว O ทั้งสองเป็นวงสีแดง";

// 365LOTTO (รอบแดง-ทอง 2026-09-24): แถบบนพื้นแดงเกือบดำ #120406 ขอบทองลึก
// #9c6a12 สถานะ active เป็นทอง #fadc64 ปุ่มสมัครไล่เฉดทอง #fdf3b4 → #e0b03a
// ปุ่มเข้าสู่ระบบเป็นการ์ดแดงเข้ม #2a0b0e ขอบทอง — สีกรมท่า #030b1c/#0f2149
// และตัวอักษร #dbe4f7 ของ หวยพยัคฆ์ รอบก่อนถูกแทนครบทุกจุดแล้ว
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// /ตรวจหวย และ /แนวทาง ถูกถอดออกจากเมนูรอบนี้ เพราะทั้งสองไฟล์อยู่ใน
// src/pages-disabled/ ตามสถานะ toggle ที่ operator ตั้งไว้ — ลิงก์ที่ชี้ไป
// route ที่ไม่มีจริงจะทำให้ verify-build ขึ้น error ถ้าแบรนด์ถัดไปเปิดสองหน้านั้น
// ต้องใส่กลับพร้อมกันทั้งไฟล์และลิงก์
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#9c6a12]/55 bg-[#120406]/95 px-4 shadow-[0_5px_20px_rgba(18,4,6,0.7)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#fadc64]/25 bg-[#fadc64]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt={logoAlt} loading="eager" widths={[130, 260, 390]} sizes="130px" class="h-[45px] w-auto drop-shadow-md xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <p class="text-2xl font-black tracking-widest text-white italic drop-shadow-md">
            <span class="bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] bg-clip-text text-transparent">365</span>
            <span class="bg-gradient-to-r from-[#f3f6fa] to-[#e01f26] bg-clip-text text-transparent">LOTTO</span>
          </p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-4 lg:flex xl:gap-6">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-1.5 text-sm font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "text-[#fadc64]" : "text-[#f0ddc4]/80 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#fdf3b4] via-[#e01f26] to-[#9c6a12] shadow-[0_-2px_10px_rgba(250,220,100,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#fadc64]/35 bg-[#2a0b0e]/60 px-6 py-2.5 text-sm font-bold text-[#f0ddc4] backdrop-blur-md transition-all hover:border-[#fadc64]/70 hover:bg-[#fadc64]/10 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] px-6 py-2.5 text-sm font-black text-[#120406] shadow-[0_4px_15px_rgba(250,220,100,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(250,220,100,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#fadc64]/35 bg-[#2a0b0e]/70 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#fadc64] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#fadc64] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#fadc64] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#9c6a12]/60 bg-[#120406]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#fadc64] bg-[#fadc64]/10 text-[#fadc64]" : "text-[#f0ddc4]/80 hover:bg-[#fadc64]/5 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] py-3.5 text-lg font-black text-[#120406] shadow-[0_5px_15px_rgba(250,220,100,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#fadc64]/35 bg-[#2a0b0e]/60 py-3.5 text-lg font-bold text-[#f0ddc4]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
