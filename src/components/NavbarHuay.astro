---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// อ่านจากไฟล์ src/assets/logo.webp ของดรอปนี้จริง (2026-10-27) ไม่ได้คัดลอกของรอบก่อน
// ⚠️ อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูป แต่ alt อ้างชื่อด้วย ${BRAND_NAME} เท่านั้น
// ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลงใน alt (โลโก้ขึ้นทุกหน้า จึงเป็นจุดรั่วที่กว้างที่สุด)
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเวิร์ดมาร์กสามมิติแบบเซอริฟตัวหนา ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาไล่แสงจากขาวไปเทา ตัดขอบเส้นสีแดงเลือดนก ครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงาที่มีแถบแสงสะท้อนสีขาวพาดกลางตัวอักษร ตัดขอบขาว วางอยู่บนพื้นโปร่งใส`;

// พาเลตรอบนี้ (LOTTO189 ดรอป 2026-10-27) ล็อกไว้ใน .claude/brand-spec-lotto189.md §2
// ทิศของธีม: **เนื้อหาสว่าง (การ์ดขาวบนพื้นเพจ #fff0f0) แต่โครมเข้ม** — navbar คือโครม
// จึงเป็นแถบผิวออกซ์บลัด #24060c ที่ยกขึ้นจากพื้นเพจสว่างอย่างชัดเจน ทำหน้าที่เป็น
// "กรอบโปสเตอร์" ให้อาร์ตเวิร์กที่เป็นฉากห้องสีขาวครีม — **ห้าม "แก้" ให้โครมสว่าง
// ตามพื้นเพจ** ชั้นจมของปุ่มรอง/ปุ่มแฮมเบอร์เกอร์เป็น #120307 ชั้นยกเป็น #3d0d16
// เส้นขอบเป็น #7e1221 และ accent ทองอำพัน #e9b53c อ่านมาจากขอบทองของอาร์มแชร์
// ปากกาสีทองบนโพยหวย และขอบทองของแคปซูล "แทงหวยจ่ายสด | รับทุกเลข | ไม่มีอั้น"
// บนแบนเนอร์ ส่วนเงินโครเมียม #c3ccd6 อ่านมาจากครึ่งแรกของเวิร์ดมาร์ก
// ตัวอักษรเมนูปกติเป็นหมึกชมพูขาว #ffeaea และ hover ยกเป็นขาวสนิท
//
// ⚠️⚠️ ธีมเดิมของไฟล์นี้คือ **รวย168 ดำ/ทอง** (121110 070707 ffd94a e3a712 b07d08
// f3ece0 0a0a0a) และก่อนหน้านั้น **สาธุ168 เขียวมรกต/ทองสัมฤทธิ์** (0c3a16 061f0c
// c9cb63 aeb04a 9ba03c e9fbdd) — ถอดออกครบทั้งสองชุดแล้ว ห้ามเขียนกลับเข้ามา
// 🚨🚨 **รอบนี้เป็นแบรนด์แดง ซึ่งเป็นตระกูลเดียวกับ มาดาม168 (ff2e52 e01238 c9102f)
// และ MEXICANOSLOT (de2b1e a81410 c81e12 9d140c 2b100a 1d0a06)** → "เจอแดง ≠ เป็น
// ของรอบนี้" ต้องเทียบให้ตรงหกหลักกับ brand-spec §2 ห้ามตัดสินด้วยสายตา
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// คู่พื้น-หมึกของปุ่ม คำนวณครบทุก stop แล้ว ห้ามสลับข้าง:
// - ปุ่มสมัครสมาชิก = ไล่เฉดแดง #8a0412 → #b00718 → #d61023 ถือหมึกขาว #ffffff
//   ได้ 10.4:1 / 7.3:1 / 5.3:1 ตามลำดับ ปลายสว่างของไล่เฉดจึงจบที่ #d61023 พอดี
//   ⚠️⚠️ **ห้ามดัน stop ขึ้นไปถึง #ff2436 หรือ #e9b53c** — ขาวบน #ff2436 ได้แค่
//   3.8:1 และบน #e9b53c ได้ 2.0:1 ตกเกณฑ์ทั้งคู่ สองค่านั้นสงวนไว้สำหรับ
//   ขอบ/ออรา/พื้นถมที่ไม่มีตัวอักษร และสำหรับ accent บนผิวเข้มเท่านั้น
// - ปุ่มเข้าสู่ระบบ = ขอบทอง #e9b53c/35 บนพื้นจม #120307/70 ถือตัวอักษรขาว
// - เมนูปกติ #ffeaea บน #24060c = 16.6:1 · สถานะ active #e9b53c บน #24060c = 10.0:1
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน และอ่านจากอาร์ตเวิร์กของดรอปนี้เอง:
// 🎁 โปรโมชั่น (โปสเตอร์โปรโมชั่นของสไลด์ทั้งสองใบ) · 🔢 ตรวจหวย (ตัวเลขผลรางวัล) ·
// 📊 แนวทาง (สถิติย้อนหลัง) · 🎱 ทดลองเล่น (ลูกบอลหวยสีขาวพิมพ์เลข 9 7 8 3
// ที่ลอยอยู่สองฝั่งของแบนเนอร์) · 🏢 เกี่ยวกับเรา · 📞 ติดต่อเรา
// ⚠️ ห้ามใช้ 🎰 🃏 🎲 หรือไอคอนแนวสล็อต/คาสิโน — รอบนี้เป็นเว็บหวยล้วน
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// /ตรวจหวย และ /แนวทาง อยู่ในเมนูรอบนี้ เพราะแบรนด์นี้เป็นเว็บหวยเต็มตัว (บรีฟพูดถึง
// หวยรัฐบาลไทย/ลาว/ฮานอย/หุ้นต่างประเทศ และแบนเนอร์เขียนว่า "แนะนำเว็บหวยลอตโต้")
// และทั้งสองไฟล์ถูกย้ายกลับเข้า src/pages/ แล้วรอบนี้ — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ถ้าแบรนด์ถัดไปไม่ใช่เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น verify-build
// จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ เพราะ /ตรวจหวย กับ /แนวทาง อยู่ในเมนู —
// ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อยคืนเป็น text-sm
// tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับเข้าไป**:
// ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้และ
// มองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// เมนูประกาศที่เดียว (const menu) แล้วทั้งแถวเดสก์ท็อปและลิ้นชักมือถือ map จาก
// ตัวเดียวกัน — ห้ามแยกเป็นสองอาร์เรย์ ไม่งั้นรอบหน้าจะมีคนแก้แค่ฝั่งเดียว
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔢" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#e9b53c]/55 bg-[#24060c]/95 px-4 shadow-[0_5px_20px_rgba(18,3,7,0.8)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#e9b53c]/25 bg-[#3d0d16]/60 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[130, 260, 390]}
            sizes="130px"
            class="h-[45px] w-auto drop-shadow-md xl:h-[55px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <p class="rounded-md bg-[#b00718] px-3 py-1 text-2xl font-black tracking-widest text-[#ffffff] drop-shadow-md">{BRAND_NAME}</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#e9b53c]" : "text-[#ffeaea]/80 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#e9b53c] via-[#ff2436] to-[#b00718] shadow-[0_-2px_10px_rgba(233,181,60,0.75)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#e9b53c]/35 bg-[#120307]/70 px-6 py-2.5 text-sm font-bold text-[#ffffff] backdrop-blur-md transition-all hover:border-[#e9b53c]/70 hover:bg-[#3d0d16]/80 hover:text-[#ffffff] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#d61023] px-6 py-2.5 text-sm font-black text-[#ffffff] shadow-[0_4px_15px_rgba(176,7,24,0.5)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(214,16,35,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#e9b53c]/35 bg-[#120307]/80 lg:hidden"
        aria-label="เปิดเมนูหลัก">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#e9b53c] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#e9b53c] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#e9b53c] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#e9b53c]/60 bg-[#24060c]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#e9b53c] bg-[#3d0d16] text-[#e9b53c]" : "text-[#ffeaea]/80 hover:bg-[#3d0d16]/70 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#d61023] py-3.5 text-lg font-black text-[#ffffff] shadow-[0_5px_15px_rgba(176,7,24,0.5)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#e9b53c]/35 bg-[#120307]/70 py-3.5 text-lg font-bold text-[#ffffff]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
