---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นตัวอักษรไทยคำว่า สาธุ แบบสามมิติผิวมันวาวไล่เฉดสีเขียวมรกตเข้มไปเขียวใบตองสว่างตัดขอบสีขาว ต่อท้ายด้วยเลข 168 แบบสามมิติผิวมันวาวสีทอง`;

// พาเลตรอบนี้ (ดรอป 2026-10-21): ธีมหน้าเว็บเป็น "สว่าง" แต่ navbar อยู่ในโซนโครม
// จึงยังเป็นแถบเข้มที่คร่อมเนื้อหาสว่างไว้ — พื้นแถบเขียวป่า #0c3a16 (= BRAND_TEXT
// ซึ่งรอบนี้ทำหน้าที่ทั้งหมึกบนพื้นสว่างและพื้นของโครม) ชั้นจมของปุ่มรอง/ปุ่ม
// แฮมเบอร์เกอร์เป็นเขียวจม #061f0c ส่วน accent เป็นทองสัมฤทธิ์อมเขียว (olive brass)
// สามสเต็ป: #c9cb63 สว่าง → #aeb04a แบรนด์ → #9ba03c ลึก ซึ่งอ่านมาจากเลข "168"
// ทองบนโลโก้และแผ่นป้ายทองขอบมนบนแบนเนอร์ ตัวอักษรเมนูปกติเป็นเขียวใบตองซีด #e9fbdd
// และสถานะ hover ยกขึ้นเป็นขาวบริสุทธิ์
//
// คู่พื้น-หมึกของปุ่ม คำนวณครบทุก stop แล้ว ห้ามสลับข้าง:
// - ปุ่มสมัครสมาชิก = ไล่เฉดทอง #c9cb63 → #aeb04a → #9ba03c ถือหมึกเขียวป่า #0c3a16
//   ได้ 7.5:1 / 6.2:1 / 4.6:1 ตามลำดับ ปลายล่างของไล่เฉดจึงจบที่ #9ba03c พอดี
//   **ห้ามกลับด้านเป็นพื้นทองแล้วใส่ตัวอักษรขาว** — ขาวบนทองสัมฤทธิ์ชุดนี้ตกเกณฑ์
//   ทุกค่า (ทองของรอบนี้สว่างเกินกว่าจะรับหมึกสว่าง)
// - ปุ่มเข้าสู่ระบบ = ขอบทอง #aeb04a/35 บนพื้นเขียวจม #061f0c/70 ถือตัวอักษรขาว
// - เมนูปกติ #e9fbdd บน #0c3a16 = 11.8:1 · สถานะ active #c9cb63 บน #0c3a16 = 7.5:1
//
// เขียวใบตองสว่าง (ค่าที่สเปกกันไว้เป็น stop ของไล่เฉด/ออราบนพื้นสว่างเท่านั้น)
// ไม่มีในไฟล์นี้เลยและห้ามเพิ่มเข้ามา — บนแถบเข้มมันตกคอนทราสต์ทุกบทบาท
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน: 🎫 โปรโมชั่น (ใบสลากกินแบ่งที่
// คู่ชาย-หญิงถืออยู่ในอาร์ตเวิร์ก) · 🔢 ตรวจหวย (ตัวเลขผลรางวัล) · 📊 แนวทาง
// (สถิติ ล้อไอคอนกราฟแท่งบนแบนเนอร์) · 🎱 ทดลองเล่น (ลูกบอลหวยมุมล่างของแบนเนอร์) ·
// 🏛️ เกี่ยวกับเรา (เจดีย์/วัดไทยซึ่งเป็นฉากหลังของทั้งแบนเนอร์และสไลด์)
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// /ตรวจหวย และ /แนวทาง อยู่ในเมนูรอบนี้ เพราะแบรนด์นี้เป็นเว็บหวยเต็มตัว (บรีฟพูดถึง
// หวยรัฐบาลไทย/ฮานอย/ลาว/หุ้น และแบนเนอร์เขียนว่า "เว็บหวยจ่ายจริงไม่โกง") และทั้งสอง
// ไฟล์ถูกย้ายเข้า src/pages/ แล้ว — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ ถ้าแบรนด์ถัดไปไม่ใช่
// เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น verify-build จะฟ้อง href ที่ชี้ไป
// route ที่ไม่มีจริง
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ เพราะ /ตรวจหวย กับ /แนวทาง อยู่ในเมนู —
// ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อยคืนเป็น text-sm
// tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับเข้าไป**:
// ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้และ
// มองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// เมนูประกาศที่เดียว (const menu) แล้วทั้งแถวเดสก์ท็อปและลิ้นชักมือถือ map จาก
// ตัวเดียวกัน — ห้ามแยกเป็นสองอาร์เรย์ ไม่งั้นรอบหน้าจะมีคนแก้แค่ฝั่งเดียว
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎫" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔢" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏛️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#aeb04a]/55 bg-[#0c3a16]/95 px-4 shadow-[0_5px_20px_rgba(12,58,22,0.8)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#aeb04a]/25 bg-[#aeb04a]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[130, 260, 390]}
            sizes="130px"
            class="h-[45px] w-auto drop-shadow-md xl:h-[55px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <p class="rounded-md bg-[#aeb04a] px-3 py-1 text-2xl font-black tracking-widest text-[#0c3a16] drop-shadow-md">{BRAND_NAME}</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#c9cb63]" : "text-[#e9fbdd]/80 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#c9cb63] via-[#aeb04a] to-[#9ba03c] shadow-[0_-2px_10px_rgba(174,176,74,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#aeb04a]/35 bg-[#061f0c]/70 px-6 py-2.5 text-sm font-bold text-[#ffffff] backdrop-blur-md transition-all hover:border-[#aeb04a]/70 hover:bg-[#aeb04a]/10 hover:text-[#ffffff] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#c9cb63] via-[#aeb04a] to-[#9ba03c] px-6 py-2.5 text-sm font-black text-[#0c3a16] shadow-[0_4px_15px_rgba(174,176,74,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(174,176,74,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#aeb04a]/35 bg-[#061f0c]/80 lg:hidden"
        aria-label="เปิดเมนูหลัก">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#c9cb63] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#c9cb63] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#c9cb63] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#aeb04a]/60 bg-[#0c3a16]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#c9cb63] bg-[#c9cb63]/10 text-[#c9cb63]" : "text-[#e9fbdd]/80 hover:bg-[#aeb04a]/10 hover:text-[#ffffff]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#c9cb63] via-[#aeb04a] to-[#9ba03c] py-3.5 text-lg font-black text-[#0c3a16] shadow-[0_5px_15px_rgba(174,176,74,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#aeb04a]/35 bg-[#061f0c]/70 py-3.5 text-lg font-bold text-[#ffffff]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
