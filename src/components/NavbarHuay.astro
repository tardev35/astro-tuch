---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ หวยเฮง789 ตัวอักษรไทยสามมิติ คำว่า หวย เป็นสีแดงเลือดนกขอบทอง และคำว่า เฮง789 เป็นสีทองไล่เฉด";

// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แถบบนพื้นแดงเกือบดำ #1c0606 ขอบแดง
// แบรนด์ #dc2224 (มาจาก vivid ของโลโก้ตรงๆ) สถานะ active เป็นแดงสว่าง #e43434
// ทองเป็นสีรอง #f4bc5d ตามเหรียญทองกับลายไทยในแบนเนอร์
//
// รอบก่อน (หวยเฮง24) เป็นเว็บหวยเหมือนกันและใช้อาร์ตแดง-ทองเหมือนกัน แต่ "นำ"
// ด้วยทอง (#e0a52a ทุกจุด) รอบนี้กลับด้าน: โลโก้ หวยเฮง789 มี vivid เป็นแดงล้วน
// (#ab0204 #e43434 #dc2224) ทองมาทีหลัง จึงให้แดงเป็นสีตัวตนและทองเป็นสีเน้น
// ชุดของ LOTTOPLUS ที่เคยอยู่ในไฟล์นี้ (#dc020e #ff2d38 #f3c623 #fde79a #e0a808
// #120b0c #2a0d0f #f0e2e2 #1a0203 #6b0207) ถูกแทนครบทุกจุดแล้ว
//
// หมึกบนปุ่มสมัครเป็น #1c0606 บนทอง — ปลายล่างของไล่เฉดจึงต้องจบที่ทอง "สว่าง"
// #d99a10 (7.0:1) ไม่ใช่ทองลึก #a8690c ซึ่งตกทันทีที่ 3.8:1 และห้ามเปลี่ยน
// ปุ่มนี้ไปเป็นไล่เฉดแดงโดยคงหมึกเข้มไว้ เพราะแดงแบรนด์ #dc2224 กับหมึกเข้มได้
// แค่ 3.4:1 — ถ้าจะใช้พื้นแดง ต้องสลับหมึกเป็นขาว (ขาวบนแดงแบรนด์ = 4.9:1 และ
// ตัวอักษรบนปุ่มเป็น bold ทุกตัว) หมึกทองอ่อนบนแดงยิ่งแย่กว่า (4.3:1) ห้ามใช้
//
// icon เป็น sibling ของ label เสมอ และอยู่ใน span aria-hidden — ห้ามต่อเข้าไปใน
// ข้อความ ไม่งั้น screen reader จะอ่านชื่อไอคอนนำหน้าชื่อเมนู (verify-build เช็กให้)
//
// ไอคอนเลือกตามแนวหวยล้วน ไม่ใช่แนวสล็อต/คาสิโน: 🔎 ตรวจหวย · 📊 แนวทาง ·
// 🎱 ทดลองเล่น (ลูกหวยแดง-ขาวในแบนเนอร์) · 🎫 โปรโมชั่น (โพย/ใบหวยในอาร์ตเวิร์ก)
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// แถวเมนูเดสก์ท็อปรอบนี้มี 9 รายการ เพราะ /ตรวจหวย กับ
// /แนวทาง กลับเข้ามา — ที่ช่วง lg จึงลดเป็น text-xs tracking-normal gap-2 แล้วค่อย
// คืนเป็น text-sm tracking-wide gap-5 ที่ xl และ **ห้ามใส่ whitespace-nowrap กลับ
// เข้าไป**: ถ้าแถวแน่นเกิน โหมดพังของ nowrap คือรายการถูกตัดหายออกนอกขอบ (คลิกไม่ได้
// และมองไม่เห็นว่ามีอยู่) ส่วนโหมดพังของแบบปล่อยให้ตัดบรรทัดคือ label ขึ้นสองบรรทัด
// ในแถบสูง 85px ซึ่งยังเห็นครบและกดได้ทุกอัน — เลือกอย่างหลังโดยตั้งใจ
//
// /ตรวจหวย และ /แนวทาง อยู่ในเมนูรอบนี้ เพราะ หวยเฮง789 เป็นเว็บหวยล้วนและ
// ทั้งสองไฟล์ถูกย้ายกลับมาอยู่ใน src/pages/ แล้ว — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ถ้าแบรนด์ถัดไปไม่ใช่เว็บหวย ต้องถอดทั้งไฟล์และลิงก์ออกพร้อมกัน ไม่งั้น
// verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎫" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔎" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎱" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏛️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#dc2224]/55 bg-[#1c0606]/95 px-4 shadow-[0_5px_20px_rgba(11,2,2,0.7)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#f4bc5d]/25 bg-[#f4bc5d]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt={logoAlt} loading="eager" widths={[130, 260, 390]} sizes="130px" class="h-[45px] w-auto drop-shadow-md xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <p class="rounded-md bg-[#dc2224] px-3 py-1 text-2xl font-black tracking-widest text-white drop-shadow-md">หวยเฮง789</p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-2 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1 px-1 text-center text-xs font-bold tracking-normal uppercase transition-colors xl:gap-1.5 xl:text-sm xl:tracking-wide ${isActive(item.path) ? "text-[#e43434]" : "text-[#fbe3d4]/80 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#ffefc2] via-[#e43434] to-[#ab0204] shadow-[0_-2px_10px_rgba(220,34,36,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#f4bc5d]/35 bg-[#2b0909]/60 px-6 py-2.5 text-sm font-bold text-[#fbe3d4] backdrop-blur-md transition-all hover:border-[#f4bc5d]/70 hover:bg-[#f4bc5d]/10 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-6 py-2.5 text-sm font-black text-[#1c0606] shadow-[0_4px_15px_rgba(244,188,93,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(244,188,93,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f4bc5d]/35 bg-[#2b0909]/70 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f4bc5d] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f4bc5d] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f4bc5d] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#dc2224]/60 bg-[#1c0606]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold tracking-wider uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#e43434] bg-[#e43434]/10 text-[#e43434]" : "text-[#fbe3d4]/80 hover:bg-[#f4bc5d]/5 hover:text-white"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] py-3.5 text-lg font-black text-[#1c0606] shadow-[0_5px_15px_rgba(244,188,93,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#f4bc5d]/35 bg-[#2b0909]/60 py-3.5 text-lg font-bold text-[#fbe3d4]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
