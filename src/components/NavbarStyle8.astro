---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ KINGDOM66 ตัวอักษรภาษาอังกฤษหนาสีทองสลักนูนเป็นเงาวาว คำว่า KINGDOM ไล่เฉดทองอ่อนไปทองเข้ม ส่วนเลข 66 ด้านท้ายเป็นทองสว่างเต็มตัว บนพื้นหลังโปร่งใส";

// KINGDOM66 (รอบทอง-ดำ 2026-09-25): navbar ที่ใช้งานจริงรอบนี้ (รอบก่อน UWIN33
// ใช้ NavbarPremium) ของเดิมในไฟล์เป็นแดง-เงินโครเมียมของ MAHAGAME66 ย้ายทั้ง
// ไฟล์มาเป็นพื้นเกือบดำ #151109 + ทองแบรนด์ #e6bf4e ที่วัดมาจากโลโก้จริง +
// ครีมอุ่น #efe6cf แทนเงินโครเมียมเดิม — แบรนด์นี้ไม่มีสีเงินเย็นอยู่เลย
//
// ปุ่ม CTA พื้นทองใช้ตัวอักษรสีเข้ม #1a1206 ไม่ใช่สีขาวแบบของเดิม เพราะพื้นทอง
// สว่างกับตัวอักษรเกือบขาวคือคู่ที่อ่านไม่ออกจริงๆ บนจอกลางแจ้ง
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ตรวจหวย และ /แนวทาง ในเมนู: KINGDOM66 เป็นแบรนด์คาสิโนรวมเกม สองหน้า
// หมวดหวยถูกพักไว้ใน src/pages-disabled/ รอบนี้ ถ้าใส่ลิงก์ไว้ verify-build.mjs
// จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีอยู่จริงใน dist/
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#151109]/95 shadow-[0_4px_20px_rgba(5,4,3,0.85)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#5c4113] via-[#e6bf4e] to-[#efe6cf] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(230,191,78,0.6)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#efe6cf] to-[#e6bf4e] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-6 lg:flex xl:gap-8">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#efe6cf] drop-shadow-[0_0_8px_rgba(239,230,207,0.8)]" : "text-[#b5a888] group-hover:text-[#efe6cf]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#e6bf4e] shadow-[0_-2px_10px_rgba(230,191,78,0.9)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#e6bf4e]/70 px-6 py-2 text-sm font-bold text-[#efe6cf] transition-all hover:bg-[#5c4113]/45 hover:shadow-[0_0_15px_rgba(230,191,78,0.55)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#1a1206] shadow-[0_0_20px_rgba(230,191,78,0.55)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/register"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#1a1206] shadow-[0_0_10px_rgba(230,191,78,0.55)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#e6bf4e]/50 bg-[#5c4113]/30 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#efe6cf] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#efe6cf] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#efe6cf] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#e6bf4e]/45 bg-[#151109] shadow-[-10px_0_30px_rgba(5,4,3,0.92)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#e6bf4e]/25 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#efe6cf]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#efe6cf] hover:text-[#e6bf4e]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#e6bf4e]/65 bg-[#5c4113]/40 text-[#efe6cf]" : "border-transparent bg-[#241c13] text-[#b5a888] hover:bg-[#33291a]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#e6bf4e]/40 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-lg border border-[#efe6cf]/70 bg-transparent py-3.5 text-sm font-bold text-[#efe6cf] transition-colors hover:border-transparent hover:text-[#1a1206]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    /* ไล่เฉดทั้งเส้นต้องสว่างพอให้ตัวอักษร #1a1206 อ่านออกตลอดปุ่ม — ปลายซ้าย
       เดิมเป็น #5c4113 ซึ่งเข้มเกินกว่าจะวางตัวอักษรสีเข้มทับได้ */
    background-image: linear-gradient(in oklab to right, #c9a13a, #e6bf4e, #f5e196);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
