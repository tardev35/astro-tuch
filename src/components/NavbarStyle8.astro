---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-24 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — เครื่องหมายโค้งทรงตัวเอสไล่แดงคริมสัน-ทอง คำว่า รวยแท้
// ตัดขอบทอง และเลข 168 ผิวทองขัดเงาของ รวยแท้168 ที่เคยอยู่บรรทัดนี้ **ไม่มีในรูป
// รอบนี้เลยสักอย่าง** และเวิร์ดมาร์กเจลแดงมีมงกุฎทองของ สล็อต168 (รอบก่อนทันที)
// ก็ไม่มีเช่นกัน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นลูกหมูการ์ตูนสีชมพูอ้วนกลม หลับตายิ้มกว้างเห็นลิ้น มีปีกนางฟ้าสีขาวคู่หนึ่งกางออกจากหลัง อยู่ในท่าเหินตัวไปข้างหน้า ถัดมาเป็นคำว่า หมูบิน เป็นตัวอักษรไทยทรงบับเบิลสามมิติผิวมันวาว โดยพยางค์แรกเป็นสีชมพูบานเย็นและพยางค์หลังเป็นสีขาวมุก ต่อท้ายด้วยเลข 168 ทรงบับเบิลสีชมพูบานเย็น และมีรูปหัวใจสีชมพูขนาดเล็กลอยประดับอยู่เหนือตัวอักษรสองจุด`;

// หมูบิน168 (รอบแคนดี้ชมพูบน **ธีมสว่าง** 2026-10-24): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน สล็อต168 ใช้ NavbarStyle11 จึงหมุนมาที่ไฟล์นี้ ซึ่งไม่ปรากฏในสิบสองคอมมิต
// ล่าสุดเลยสักครั้ง ของเดิมที่ค้างอยู่ข้างในเป็นชุด **แดงคริมสันนำ-ทองโบราณรอง**
// ของ รวยแท้168 (c30303 8f0505 dcb95f b8862b c99a3f 280b0b 461212 ffeee8 และ
// rgba(195,3,3,α) rgba(220,185,95,α)) ย้ายทั้งไฟล์มาเป็นพาเลตของแบรนด์นี้แล้ว
// **ไม่เหลือแดงและไม่เหลือทองอีกแม้แต่ค่าเดียว** ก่อนหน้านั้นไฟล์นี้เคยถือชุดทองนำ-
// ชมพูบานเย็นของ มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 1a0612) และชุดแดง
// เสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a 7d0f12 f2b705 ffd666 180800) ซึ่ง
// หายไปหมดแล้วทั้งสองชุด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// ⚠️⚠️ **f5469f กับ ff8dc6 ของ มีโชค168 เป็นชมพูเหมือนกัน และ f5469f ห่างจาก
// #fa539c ของรอบนี้แค่ไม่กี่หน่วย** — ถ้า grep แล้วเจอสองค่านั้นแปลว่าพิมพ์ผิด
// ไม่ใช่สีของแบรนด์นี้ เช่นเดียวกับ fa63b9/ffb3de ของ ถอนชัวร์168 ที่ R ตรงกับ
// fa539c เป๊ะ และ a4186b ของ มีทรัพย์168 ที่มี 18 อยู่กลางค่าเหมือน #c2185b
//
// NavbarStyle11 ของรอบก่อนเป็นแถบที่หุบความสูงตอนเลื่อน — ไฟล์นี้เป็นคนละทรง:
// แถบนอนแบนเต็มความกว้างติดขอบบน ไม่มีแถบ info และ drawer เป็นแผงเลื่อนเข้าจาก
// ขอบ **ขวา** กว้าง 260px สองแบรนด์ติดกันจึงไม่ออกมาหน้าตาเหมือนเว็บเดียวกันทาสีใหม่
//
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูพาสเทลสว่าง #ffe5ff (จาก bg.json)** แต่ navbar เป็น
// **โครม** จึงเป็นพลัมเข้ม #3b0b26 โดยตั้งใจ — หัว-ท้ายเข้มคร่อมเนื้อหาสว่างคือกรอบ
// ที่อ่านง่าย และโลโก้ชมพู-ขาวมุกบนพื้นโปร่งอ่านออกชัดกว่าบนพื้นสว่างด้วยกัน
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "ชมพูบานเย็นนำ ขาวมุกเป็นวัสดุที่สอง" ไม่มีฮิว
// ที่สาม: ชมพู #fa539c ถือแถบ active สีเน้น และแสงรอบโลโก้ · ชมพูเข้ม #c2185b เป็น
// ปลายเย็นของเส้นคาดใต้แถบและขอบปุ่มรอง · พื้นพลัมจม #3b0b26 ยกระดับด้วย #54123a
// เส้นคั่น #7a2350 · เนื้อความบนโครม #ffe9f5 (14.6:1 บน #3b0b26) ส่วนเมนูที่ยังไม่
// active ใช้ **#ffe9f5 ที่ความทึบ 70%** แทนการคิดค่าสีใหม่ ทำให้พาเลตของไฟล์นี้
// ไม่มีค่าที่อยู่นอกตารางใน brand-spec §2 เลยสักค่า
//
// ปุ่ม CTA พื้น **ชมพู** และใช้ **หมึกเข้ม** #3b0b26 ไม่ใช่ตัวอักษรขาว สองข้อนี้ผูกกัน:
// 🚨 ตัวอักษรขาวบนชมพู #fa539c ได้แค่ **3.2:1 ซึ่งไม่ผ่าน** ส่วนหมึกพลัมเข้มบนชมพู
// ได้ 5.3:1 ที่ #fa539c · 4.9:1 ที่ปลายเข้มสุด #f04b94 · 7.9:1 ที่ปลายสว่าง #fd8fc2
// ⚠️ ห้ามพลิกกลับเป็นพื้นชมพู-ตัวอักษรขาว และห้ามดันปลายเข้มของไล่เฉดให้เข้มกว่า
// #f04b94 (เข้มกว่านั้นหมึกพลัมจะตกต่ำกว่า 4.5:1) ถ้าต้องการพื้นที่รับหมึก **ขาว**
// จริงๆ ต้องเป็น #c2185b (5.9:1) ลงไปเท่านั้น
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
// ไอคอนเลือกตามหมวดของแบรนด์: รอบนี้เป็น **เว็บสล็อต** จึงมี 🎰 อยู่ที่ ทดลองเล่น
// และ **ไม่มี 🔍 ตรวจหวย หรือ 📊 แนวทาง อยู่เลย**
//
// 🚨 **ไม่มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้แล้ว** — รอบก่อนหน้าของไฟล์นี้
// (รวยแท้168) เป็นเว็บหวยจึงมีสองลิงก์นั้น แต่รอบนี้เป็นแบรนด์สล็อต สองไฟล์ถูก
// เก็บไว้ที่ src/pages-disabled/ **route จึงไม่มีอยู่จริงใน dist/** ลิงก์ค้างไว้
// = verify-build แดงทันที ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/
// ค่อยเติมสองรายการนี้กลับ
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// สองจุด "ปุ่มลัด" เฉพาะจอมือถือชี้ตรงไปลิงก์ aff แทน /register, /login:
// ปุ่ม สมัครสมาชิก เล็กข้าง hamburger (compact header, lg:hidden) กับปุ่ม
// เข้าสู่ระบบ ท้าย sidebar (มือถือเท่านั้นเหมือนกัน) — ตัดตัวกลางออกให้กดครั้งเดียว
// ถึงลิงก์ aff เลย ส่วนรายการ สมัครสมาชิก/เข้าสู่ระบบ ใน `links` (ทั้งแถบบนจอใหญ่
// และลิสต์ใน sidebar) ยังคงชี้ไป /register, /login ตามเดิม — สองหน้านั้นต้องเหลือ
// ทางเข้าไว้ให้ Google เก็บ index ได้จริง
// ⚠️ targetUrl ต้องเป็น **ลิงก์ aff ของแบรนด์นี้** ซึ่งเท่ากับค่าใน Navfoot.astro,
// src/pages/login.astro และ src/pages/register.astro เป๊ะๆ — รอบนี้ค่าที่ค้างอยู่
// ในไฟล์นี้ตรงกับสามไฟล์นั้นอยู่แล้ว (ตรวจแล้วใน P1) จึงไม่ต้องแก้
//
// ⚠️ ไฟล์นี้หมุนออกตอนรีแบรนด์รอบหน้า — ถ้า navbar ที่เลือกใหม่เป็นไฟล์อื่น ต้องย้าย
// const targetUrl กับสองจุดนี้ไปด้วย ไม่งั้นปุ่มลัดมือถือของแบรนด์ถัดไปจะกลับไปพาไป
// หน้า /register, /login เหมือนเดิม
const targetUrl = "https://yoalink.com/l360";
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🐷" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#3b0b26]/95 shadow-[0_4px_20px_rgba(59,11,38,0.55)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#c2185b] via-[#fa539c] to-[#fdc6c3] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(250,83,156,0.7)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffe9f5] via-[#fa539c] to-[#fdc6c3] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-4 lg:flex xl:gap-6">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#ffe9f5] drop-shadow-[0_0_8px_rgba(250,83,156,0.9)]" : "text-[#ffe9f5]/70 group-hover:text-[#fa539c]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#fa539c] shadow-[0_-2px_10px_rgba(250,83,156,0.95)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#fa539c]/65 px-6 py-2 text-sm font-bold text-[#ffe9f5] transition-all hover:bg-[#54123a] hover:shadow-[0_0_15px_rgba(250,83,156,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded-full px-6 py-2 text-sm font-extrabold text-[#3b0b26] shadow-[0_0_20px_rgba(250,83,156,0.6)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={targetUrl}
            rel="nofollow sponsored"
            class="bg-theme-oklab flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-bold text-[#3b0b26] shadow-[0_0_10px_rgba(250,83,156,0.6)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded-lg border border-[#fa539c]/60 bg-[#54123a] p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#ffe9f5] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#ffe9f5] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#ffe9f5] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-[#3b0b26]/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#7a2350] bg-[#3b0b26] shadow-[-10px_0_30px_rgba(59,11,38,0.75)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#7a2350] px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#fa539c]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#ffe9f5] hover:text-[#fa539c]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-xl border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#fa539c]/70 bg-[#7a2350] text-[#ffe9f5]" : "border-transparent bg-[#54123a] text-[#ffe9f5]/70 hover:bg-[#7a2350]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#7a2350] pt-6">
        <a
          href={targetUrl}
          rel="nofollow sponsored"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-xl border border-[#fa539c]/70 bg-transparent py-3.5 text-sm font-bold text-[#ffe9f5] transition-colors hover:border-transparent hover:text-[#3b0b26]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* #mobile-sidebar ใช้ h-screen (100vh) ในคลาส แต่บนมือถือจริง 100vh คำนวณจาก
     viewport ใหญ่สุด (แถบที่อยู่เว็บหด) ไม่ใช่พื้นที่ที่เห็นจริงตอนนั้น — พอแถบที่อยู่
     ขยายกลับมา (เช่นหลังเลื่อนหน้า) แผง sidebar จะเตี้ยกว่าจอจริง เหลือช่องให้เนื้อหา
     หน้าเว็บโผล่ทะลุออกมาด้านล่างเมนู อาการนี้ไม่เกิดใน headless browser เพราะไม่มี
     แถบที่อยู่แบบไดนามิก จึงไม่เจอตอนทดสอบปกติ #mobile-overlay ไม่เป็นเพราะใช้ inset-0
     ซึ่งอิง edge ของ viewport จริงตลอดเวลา ไม่ใช่ค่า vh ที่ตรึงไว้
     แก้ด้วย selector นี้แทนที่จะแก้คลาสตรงๆ เพราะ specificity ของ #id ชนะ .h-screen
     เสมอโดยไม่ต้องสนลำดับ แล้วถ้าเบราว์เซอร์เก่าไม่รู้จัก dvh บรรทัดนี้จะถูกข้ามไปเอง
     เหลือ h-screen (100vh) เป็นค่า fallback ต่อ ไม่ต้องลบคลาสเดิมออก */
  #mobile-sidebar {
    height: 100dvh;
  }

  .bg-theme-oklab {
    /* ปุ่มนี้เป็นพื้น **ชมพู** ไล่เฉด และตัวอักษรเป็นหมึกพลัมเข้ม #3b0b26 ไม่ใช่สีขาว —
       สองข้อนี้ผูกกัน 🚨 ตัวอักษรขาวบนชมพู #fa539c ได้แค่ 3.2:1 ซึ่งไม่ผ่านสำหรับ
       ปุ่มหลัก ส่วนพื้นชมพูกับหมึกพลัมได้ 5.3:1 ที่ #fa539c · 4.9:1 ที่ปลายเข้มสุด
       (#f04b94) และ 7.9:1 ที่ปลายสว่าง (#fd8fc2) — ห้ามดันปลายเข้มให้เข้มกว่า
       #f04b94 ห้ามเปลี่ยนพื้นเป็นพลัม และห้ามพลิกไปใช้ตัวอักษรสีขาว
       พื้นที่รับหมึกขาวได้จริงต้องเป็น #c2185b (5.9:1) ลงไปเท่านั้น */
    background-image: linear-gradient(in oklab to right, #f04b94, #fa539c, #fd8fc2);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
