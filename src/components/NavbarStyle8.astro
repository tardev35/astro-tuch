---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ GUCCI168 บนพื้นโปร่งใส กลางภาพเป็นเทพเจ้าโชคลาภจีนหน้ากลมยิ้มตาหยี มีหนวดสองปลาย สวมหมวกทรงจีนสีเขียวมรกตคาดแถบแดง ประดับพลอยเขียวทรงรีในกรอบทองตรงกลางหมวก มีเหรียญทองจีนรูสี่เหลี่ยมห้อยอยู่สองข้าง ด้านหน้าเป็นตัวอักษรละตินหนาสามมิติคำว่า GUCCI สีขาวเงินตัดขอบเขียวมรกต วางทับตัวเลข 168 สามมิติสีแดงเมทัลลิกตัดขอบทอง และมีไพ่โพดำโผล่ออกมาทางซ้าย";

// GUCCI168 (รอบตรุษจีน แดง-เขียวมรกต-ทอง 2026-10-08): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน UOK365 ใช้ NavbarPremium จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ข้างในเป็น
// แดง-เงินโครเมียมของ หวยดีใจ (#0d0407 #17080c #211016 #dc0409 #8e0206 #c90308
// #e8161c #f5363d #eef0f4 #c3c7d1 #8d93a1 #edeaf0) ย้ายทั้งไฟล์มาเป็นพาเลตต์ของ
// แบรนด์นี้แล้ว ไม่เหลือเฉดแดง-เงินเดิมอีก
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "แดงนำ เขียวรอง ทองคั่น": ตัว GUCCI เป็นขาวเงิน
// ตัดขอบเขียวมรกต เลข 168 เป็นแดงเมทัลลิกตัดขอบทอง และหมวกของเทพเจ้าโชคลาภเป็น
// เขียวมรกตคาดแถบแดง — ต่างจาก UOK365 รอบก่อนที่เป็นคู่ ทอง/เงิน รอบนี้เป็นสามสี
// แดงแบรนด์ #c41115 ถือเส้นเน้น ขอบ แถบ active ปุ่มหลัก และแสงรอบโลโก้ · เขียวมรกต
// #0b7a33 กับเขียวสว่าง #2bbf63 เป็นฮิวที่สองจริง อยู่ที่ปลายเส้นคาดใต้แถบ ·
// ทองแบรนด์ #d9a521 กับทองอ่อน #ffdf91 เป็นโลหะคั่น อยู่ที่ขอบปุ่มรองและหัว MENU
// พื้นเกือบดำอมแดง #090302 ยกระดับด้วย #160604 / #3d0a09 เนื้อความ #f6e3cf
// (BRAND_TEXT รอบนี้) เมนูปกติเป็น #a8897f (6.4:1 บนพื้น)
//
// ปุ่ม CTA พื้นแดงใช้ตัวอักษรขาว — ปลายไล่เฉดที่สว่างที่สุด (#e0201f) ได้ 4.8:1
// กับสีขาว ซึ่งผ่าน AA สำหรับตัวอักษรขนาดปกติพอดี ห้ามดันปลายนั้นให้สว่างกว่านี้
// ส่วนทองของโลโก้ไปอยู่ที่ปุ่มเส้นขอบแทน เพราะทองเป็นพื้นแล้วตัวอักษรสว่างอ่านไม่ออก
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
//
// ไม่มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้: GUCCI168 เป็นเว็บคาสิโนไลฟ์ ไม่ใช่เว็บหวย
// สองหน้านั้นอยู่ใน src/pages-disabled/ จึงไม่มี route ใน dist/ — ถ้าเหลือลิงก์ไว้
// verify-build จะแดงเพราะ href ชี้ไป route ที่ไม่มีอยู่ (navbar ขึ้นทุกหน้า)
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏮" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#090302]/95 shadow-[0_4px_20px_rgba(3,1,0,0.9)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#0b7a33] via-[#c41115] to-[#d9a521] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(196,17,21,0.7)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffdf91] via-[#ffffff] to-[#c41115] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-5 lg:flex xl:gap-7">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#f6e3cf] drop-shadow-[0_0_8px_rgba(196,17,21,0.9)]" : "text-[#a8897f] group-hover:text-[#f6e3cf]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#c41115] shadow-[0_-2px_10px_rgba(196,17,21,0.95)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#d9a521]/65 px-6 py-2 text-sm font-bold text-[#f6e3cf] transition-all hover:bg-[#3d0a09]/80 hover:shadow-[0_0_15px_rgba(217,165,33,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-white shadow-[0_0_20px_rgba(196,17,21,0.6)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/register"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-white shadow-[0_0_10px_rgba(196,17,21,0.6)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#c41115]/60 bg-[#3d0a09]/70 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#f6e3cf] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#f6e3cf] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#f6e3cf] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#c41115]/50 bg-[#090302] shadow-[-10px_0_30px_rgba(3,1,0,0.95)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#c41115]/30 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#ffdf91]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#f6e3cf] hover:text-[#e0201f]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#c41115]/70 bg-[#3d0a09]/85 text-[#f6e3cf]" : "border-transparent bg-[#160604] text-[#a8897f] hover:bg-[#3d0a09]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#c41115]/45 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-lg border border-[#d9a521]/70 bg-transparent py-3.5 text-sm font-bold text-[#f6e3cf] transition-colors hover:border-transparent hover:text-white">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    /* ไล่เฉดทั้งเส้นต้องเข้มพอให้ตัวอักษรขาวอ่านออกตลอดปุ่ม — ปลายที่สว่างที่สุด
       #e0201f ได้ 4.8:1 กับสีขาว ซึ่งผ่าน AA พอดี ห้ามดันให้สว่างกว่านี้ ส่วนทอง
       ของโลโก้ (#d9a521) ไม่ได้มาอยู่ในปุ่มนี้เพราะทองเป็นพื้นต้องใช้หมึกเข้ม
       คู่แดง-เขียว-ทองของแบรนด์ไปอยู่ที่เส้นคั่น เส้นใต้ แถบ active และปุ่มเส้นขอบแทน */
    background-image: linear-gradient(in oklab to right, #7a0505, #c41115, #e0201f);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
