---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ KOON234 บนพื้นโปร่งใส เป็นวงแหวนหนาสีเขียวมรกตเข้มไล่เงาทองวางอยู่ด้านหลัง ด้านหน้าเป็นตัวอักษรละตินหนาสามมิติคำว่า KOON สีเงินโครเมียมตัดขอบเขียวมรกตเข้ม ต่อด้วยตัวเลข 234 สามมิติสีทองไล่เงาวาวตัดขอบเขียวเข้ม ทั้งแถบเอียงขึ้นเล็กน้อยไปทางขวา";

// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน แตกดี168 ใช้ NavbarStyle10 จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ข้างในเป็น
// ชุดตรุษจีน แดง-เขียว-ทอง ของ GUCCI168 (#c41115 #e0201f #7a0505 #d9a521 #ffdf91
// #f6e3cf #a8897f #090302 #160604 #3d0a09 #0b7a33 #2bbf63 rgba(196,17,21,α))
// ย้ายทั้งไฟล์มาเป็นพาเลตต์ของแบรนด์นี้แล้ว ไม่เหลือเฉดแดงเดิมอีก
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "ทองนำ เขียวมรกตรอง เงินโครเมียมเป็นตัวอักษร":
// ตัว KOON เป็นเงินโครเมียมตัดขอบเขียวเข้ม เลข 234 เป็นทองไล่เงาวาว และวงแหวน
// ด้านหลังเป็นเขียวมรกตเข้มสลับทอง — ต่างจาก แตกดี168 รอบก่อนที่เป็นคู่ ฟ้าสด/
// เหลืองมะนาว รอบนี้เป็นคู่ ทอง/มรกต
// ทองแบรนด์ #cc920a ถือเส้นเน้น ขอบ แถบ active ปุ่มหลัก และแสงรอบโลโก้ · ทองสว่าง
// #f7d14e กับทองซีด #fde9a6 เป็นปลายสว่างของไล่เฉดและหัว MENU · เขียวมรกต #0a6b32
// กับเขียวสว่าง #2fbf6a เป็นฮิวที่สองจริง อยู่ที่ปลายเย็นของเส้นคาดใต้แถบและ
// ไล่เฉดโลโก้สำรอง พื้นเขียวเกือบดำ #020803 ยกระดับด้วย #09190d / #043d1c
// เนื้อความ #e8f2e6 (BRAND_TEXT รอบนี้) เมนูปกติเป็น #9ab79f (9.3:1 บนพื้น)
//
// ปุ่ม CTA พื้นทองใช้ **หมึกเข้ม** #07170c ไม่ใช่ตัวอักษรขาว — ทองเป็นสีสว่าง
// ตัวอักษรขาวบนทองเหลือราว 1.3:1 อ่านไม่ออก ปลายไล่เฉดที่เข้มที่สุด (#cc920a)
// ได้ 6.5:1 กับหมึกนี้ และปลายสว่างสุด (#f7d14e) ได้ 16:1
// ⚠️ ห้ามพลิกกลับเป็นพื้นทอง-ตัวอักษรขาว และห้ามดันปลายเข้มให้เข้มกว่า #cc920a
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
//
// ไม่มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้: KOON234 เป็นเว็บพนันออนไลน์ ไม่ใช่เว็บหวย
// สองหน้านั้นอยู่ใน src/pages-disabled/ จึงไม่มี route ใน dist/ — ถ้าเหลือลิงก์ไว้
// verify-build จะแดงเพราะ href ชี้ไป route ที่ไม่มีอยู่ (navbar ขึ้นทุกหน้า)
// ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/ ต้องเพิ่มสองลิงก์นี้คืน
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// สองจุด "ปุ่มลัด" เฉพาะจอมือถือชี้ตรงไปลิงก์ aff แทน /register, /login:
// ปุ่ม สมัครสมาชิก เล็กข้าง hamburger (compact header, lg:hidden) กับปุ่ม
// เข้าสู่ระบบ ท้าย sidebar (มือถือเท่านั้นเหมือนกัน) — ตัดตัวกลางออกให้กดครั้งเดียว
// ถึงลิงก์ aff เลย ส่วนรายการ สมัครสมาชิก/เข้าสู่ระบบ ใน `links` (ทั้งแถบบนจอใหญ่
// และลิสต์ใน sidebar) ยังคงชี้ไป /register, /login ตามเดิม — สองหน้านั้นต้องเหลือ
// ทางเข้าไว้ให้ Google เก็บ index ได้จริง targetUrl เป็นลิงก์เดียวกับที่ /register,
// /login ใช้ ห้ามแก้ตรงนี้เอง อัปโหลดเดอร์อัปเดตให้พร้อมกัน — ดูคอมเมนต์เต็มที่
// src/components/Navfoot.astro ซึ่งมีปุ่มคู่เดียวกันนี้
//
// ⚠️ ไฟล์นี้หมุนออกตอนรีแบรนด์รอบหน้า (ดู "หนึ่งไฟล์ต่อหนึ่งรอบ" ด้านบน) — ถ้า navbar
// ที่เลือกใหม่เป็นไฟล์อื่น ต้องย้าย const targetUrl กับสองจุดนี้ไปด้วย ไม่งั้นปุ่มลัด
// มือถือของแบรนด์ถัดไปจะกลับไปพาไปหน้า /register, /login เหมือนเดิม
const targetUrl = "https://yoalink.com/l360";
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎮" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#020803]/95 shadow-[0_4px_20px_rgba(0,0,0,0.9)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#0a6b32] via-[#cc920a] to-[#f7d14e] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(204,146,10,0.7)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#e9eef0] via-[#fde9a6] to-[#cc920a] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-5 lg:flex xl:gap-7">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#e8f2e6] drop-shadow-[0_0_8px_rgba(204,146,10,0.9)]" : "text-[#9ab79f] group-hover:text-[#e8f2e6]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#cc920a] shadow-[0_-2px_10px_rgba(204,146,10,0.95)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#cc920a]/65 px-6 py-2 text-sm font-bold text-[#e8f2e6] transition-all hover:bg-[#043d1c]/80 hover:shadow-[0_0_15px_rgba(204,146,10,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#07170c] shadow-[0_0_20px_rgba(204,146,10,0.6)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={targetUrl}
            rel="nofollow sponsored"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#07170c] shadow-[0_0_10px_rgba(204,146,10,0.6)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#cc920a]/60 bg-[#043d1c]/70 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#e8f2e6] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#e8f2e6] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#e8f2e6] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#cc920a]/50 bg-[#020803] shadow-[-10px_0_30px_rgba(0,0,0,0.95)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#cc920a]/30 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#fde9a6]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#e8f2e6] hover:text-[#f7d14e]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#cc920a]/70 bg-[#043d1c]/85 text-[#e8f2e6]" : "border-transparent bg-[#09190d] text-[#9ab79f] hover:bg-[#043d1c]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#cc920a]/45 pt-6">
        <a
          href={targetUrl}
          rel="nofollow sponsored"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-lg border border-[#cc920a]/70 bg-transparent py-3.5 text-sm font-bold text-[#e8f2e6] transition-colors hover:border-transparent hover:text-[#07170c]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* #mobile-sidebar ใช้ h-screen (100vh) ในคลาส แต่บนมือถือจริง 100vh คำนวณจาก
     viewport ใหญ่สุด (แถบที่อยู่เว็บหด) ไม่ใช่พื้นที่ที่เห็นจริงตอนนั้น — พอแถบที่อยู่
     ขยายกลับมา (เช่นหลังเลื่อนหน้า) แผง sidebar จะเตี้ยกว่าจอจริง เหลือช่องให้เนื้อหา
     หน้าเว็บโผล่ทะลุออกมาด้านล่างเมนู อาการนี้ไม่เกิดใน headless browser เพราะไม่มี
     แถบที่อยู่แบบไดนามิก จึงไม่เจอตอนทดสอบปกติ #mobile-overlay ไม่เป็นเพราะใช้ inset-0
     ซึ่งอิง edge ของ viewport จริงตลอดเวลา ไม่ใช่ค่า vh ที่ตรึงไว้
     แก้ด้วย selector นี้แทนที่จะแก้คลาสตรงๆ เพราะ specificity ของ #id ชนะ .h-screen
     เสมอโดยไม่ต้องสนลำดับ แล้วถ้าเบราว์เซอร์เก่าไม่รู้จัก dvh บรรทัดนี้จะถูกข้ามไปเอง
     เหลือ h-screen (100vh) เป็นค่า fallback ต่อ ไม่ต้องลบคลาสเดิมออก */
  #mobile-sidebar {
    height: 100dvh;
  }

  .bg-theme-oklab {
    /* ปุ่มนี้เป็นพื้นทองไล่เฉด ตัวอักษรจึงเป็นหมึกเข้ม #07170c ไม่ใช่สีขาว —
       ทองเป็นสีสว่าง ตัวอักษรขาวบนทองเหลือราว 1.3:1 อ่านไม่ออก
       ปลายที่เข้มที่สุดของเส้นนี้ (#cc920a) ได้ 6.5:1 กับหมึกนั้น และปลายสว่างสุด
       (#f7d14e) ได้ 16:1 — ห้ามดันปลายเข้มให้เข้มกว่า #cc920a และห้ามพลิกกลับไป
       ใช้ตัวอักษรสีขาว ส่วนเขียวมรกตของแบรนด์ไปอยู่ที่เส้นคั่น เส้นใต้ และ
       แถบ active แทน เพราะเขียวเข้มเป็นพื้นแล้วตัวอักษรหมึกเข้มอ่านไม่ออก */
    background-image: linear-gradient(in oklab to right, #cc920a, #e8b52a, #f7d14e);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
