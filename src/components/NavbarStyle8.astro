---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-24 17:37 จริง (เปิดอ่านด้วย Read
// ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — ลูกหมูการ์ตูนชมพู**มีปีกนางฟ้า** คำว่า หมูบิน
// ตัวบับเบิล และเลข 168 ของ หมูบิน168 ที่เคยอยู่บรรทัดนี้ **ไม่มีในรูปรอบนี้เลย
// สักอย่าง** และหัวการ์ตูนผู้หญิงผมมวยสูงหน้าตกใจของ โบ๊ะบ๊ะ168 (รอบก่อนทันที)
// ก็ไม่มีเช่นกัน
// ⚠️ **กับดักของรอบนี้: สไลด์มีหมูการ์ตูนชมพูอยู่จริง แต่ "ไม่มีปีก" และไม่ได้อยู่
// ในโลโก้** ตัวที่อยู่ในโลโก้คือ **หน้าการ์ตูนกลมที่ทำหน้าที่เป็นตัว O ของเวิร์ดมาร์ก**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กตัวอักษรละตินทรงเจลลี่สามมิติผิวมันวาวสีชมพูบับเบิลกัมตัดขอบสีขาวหนา โดยตัวอักษรตัวแรกถูกแทนที่ด้วยหน้าการ์ตูนกลมสีชมพูที่ขยิบตาข้างหนึ่ง ยิ้มอ้าปากเห็นลิ้น แก้มแดง และมีมือการ์ตูนสวมถุงมือสีขาวชูสองนิ้วอยู่ทางซ้าย ต่อด้วยตัวอักษรที่เหลือและเลขแปดสองตัวทรงเจลลี่สีชมพู โดยมีรูปหัวใจสีชมพูขนาดเล็กสามดวงและขีดประกายสีชมพูลอยประดับอยู่เหนือตัวอักษร`;

// okkub88 (รอบบับเบิลกัมชมพูบน **ธีมสว่าง** 2026-10-24): navbar ที่ใช้งานจริงรอบนี้ —
// รอบก่อน โบ๊ะบ๊ะ168 ใช้ NavbarStyle5 จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่ข้างใน
// เป็นชุด **ชมพูบานเย็นนำ-พลัมจม** ของ หมูบิน168 (fa539c c2185b fdc6c3 ffe9f5
// 3b0b26 54123a 7a2350 f04b94 fd8fc2 และ rgba(250,83,156,α) rgba(59,11,38,α))
// ย้ายทั้งไฟล์มาเป็นพาเลตของแบรนด์นี้แล้ว ก่อนหน้านั้นไฟล์นี้เคยถือชุด **แดงคริมสัน
// นำ-ทองโบราณรอง** ของ รวยแท้168 (c30303 8f0505 dcb95f b8862b c99a3f 280b0b
// 461212 ffeee8) ชุดทองนำ-ชมพูของ มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 1a0612) และชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a 7d0f12 f2b705
// ffd666 180800) ซึ่งหายไปหมดแล้วทุกชุด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// 🚨🚨 **ไฟล์นี้คือจุดที่อันตรายที่สุดของรอบนี้ทั้งรีโป** เพราะทั้งแบรนด์เก่าที่ค้าง
// อยู่ในไฟล์ (หมูบิน168) และแบรนด์ใหม่รอบนี้ **เป็นชมพูทั้งคู่** การ retheme จึงไม่ใช่
// "เปลี่ยนตระกูลสี" แต่เป็น **เปลี่ยนค่าทีละค่าในตระกูลเดียวกัน** — ตรวจด้วยค่า
// ห้ามตัดสินด้วยสายตา คู่ที่ใกล้จนต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   ffe9f5 (หมูบิน) ↔ #ffe9f7 (ผิวโครมยกรอบนี้) — **ต่างกันแค่ไบต์สุดท้าย**
//   fb8cc0 (หมูบิน) ↔ #fb439b (ฮิวนำรอบนี้)     — **R เท่ากันเป๊ะ**
//   f7bcd9 (หมูบิน) ↔ #f9b2d9 (เส้นอ่อนรอบนี้)  — **B เท่ากันเป๊ะ**
//   c2185b (หมูบิน) ↔ #9c0f55 (หัวข้อรอบนี้)   — ต่าง R ชัดเจน (c2 vs 9c)
//   7a2350 54123a 3b0b26 (หมึกหมูบิน) ↔ #6a0f3c (หมึกรอบนี้) — ตระกูลเดียวกัน
// และชมพูของแบรนด์อื่นที่ห้ามใช้: f5469f ff8dc6 8c0f52 ของ มีโชค168 ·
// fa63b9 ffb3de ของ ถอนชัวร์168 · a4186b dd1b74 ของ มีทรัพย์168 · f41571 ff5ca8
// ของ PUNPRO168 — ไฟล์นี้ไม่เหลือค่าใดในลิสต์นั้นแล้ว
//
// NavbarStyle5 ของรอบก่อนมีแถบ info คาดเหนือ nav และเมนูมือถือเป็นแผงเต็มจอ —
// ไฟล์นี้เป็นคนละทรง: แถบนอนแบนเต็มความกว้างติดขอบบน ไม่มีแถบ info และ drawer
// เป็นแผงเลื่อนเข้าจากขอบ **ขวา** กว้าง 260px สองแบรนด์ติดกันจึงไม่ออกมาหน้าตา
// เหมือนเว็บเดียวกันทาสีใหม่
//
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูบับเบิลกัมพาสเทล #ffd6fa (จาก bg.json) และ navbar
// ก็เป็นผิว "สว่าง" ด้วย — กลับทิศจากรอบก่อนที่โครมเป็นพลัม/น้ำเงินเข้ม**
// เหตุผล: อาร์ตเวิร์กทั้งดรอป (โลโก้ แบนเนอร์ สองสไลด์) เป็นฉากสตูดิโอ **ขาว**
// ไม่มีพื้นเข้มอยู่ในภาพไหนเลย แถบเข้มคาดหัวจะกลายเป็นกรอบดำตัดกับแบนเนอร์
// navbar จึงเป็น #ffffff/95 ยกระดับด้วย #ffe9f7 เส้นคั่น #f4a7cf
// **ห้าม "แก้" ให้กลับไปเป็นโครมมืด**
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "ชมพูบับเบิลกัมนำ ขาวเป็นวัสดุที่สอง" ไม่มีฮิว
// ที่สาม: ชมพู #fb439b ถือแถบ active เส้นคาด และแสงรอบโลโก้ (**พื้น/ขอบ/ออรา
// เท่านั้น ไม่เคยถือตัวอักษร** 3.3:1 กับขาว) · #9c0f55 เป็นหมึกของเมนู active
// สีเน้น และป้าย MENU (8.1:1 บนขาว) · หมึกหลัก #6a0f3c (12.1:1 บนขาว) ส่วนเมนู
// ที่ยังไม่ active ใช้ **#6a0f3c ที่ความทึบ 70%** (= 5.4:1 บนขาว ผ่าน AA)
// แทนการคิดค่าสีใหม่ ทำให้พาเลตของไฟล์นี้ไม่มีค่าที่อยู่นอกตารางใน brand-spec §2
//
// ปุ่ม CTA พื้น **ชมพูเข้ม** ไล่เฉด #d91a73 -> #b01160 -> #85094a และใช้ตัวอักษร
// **ขาว** สองข้อนี้ผูกกัน:
// 🚨🚨 **ห้ามใช้ #fb439b เป็นพื้นของปุ่มที่ถือหมึกขาวเด็ดขาด** — ขาวบน #fb439b
// ได้แค่ 3.2:1 ซึ่งไม่ผ่าน ส่วนไล่เฉดที่ใช้อยู่ได้ **4.8:1 / 6.8:1 / 9.8:1** ตาม stop
// ⚠️ และห้ามดันปลายสว่างของไล่เฉดให้สว่างกว่า #d91a73 (สว่างกว่านั้นขาวจะตก
// ต่ำกว่า 4.5:1) ถ้าต้องการพื้น **ชมพูสด** จริงๆ ต้องใช้คู่กับหมึกเข้ม #6a0f3c
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
// ไอคอนเลือกตามหมวดของแบรนด์: รอบนี้เป็น **เว็บสล็อต** จึงมี 🎰 อยู่ที่ ทดลองเล่น
// และ **ไม่มี 🔍 ตรวจหวย หรือ 📊 แนวทาง อยู่เลย**
// ⚠️ 🐷 ที่เคยอยู่ที่ เกี่ยวกับเรา เป็นไอคอนของ **หมูบิน168** (ชื่อแบรนด์คือหมู)
// รอบนี้ไม่ใช่ จึงเปลี่ยนเป็น ℹ️ — หมูในสไลด์เป็นวัตถุในภาพ ไม่ใช่มาสคอตของแบรนด์
//
// 🚨 **ไม่มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้** — สองไฟล์อยู่ที่
// src/pages-disabled/ **route จึงไม่มีอยู่จริงใน dist/** ลิงก์ค้างไว้
// = verify-build แดงทันที ถ้ารอบหน้าเป็นแบรนด์หวยแล้วย้ายไฟล์กลับเข้า src/pages/
// ค่อยเติมสองรายการนี้กลับ
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// สองจุด "ปุ่มลัด" เฉพาะจอมือถือชี้ตรงไปลิงก์ aff แทน /register, /login:
// ปุ่ม สมัครสมาชิก เล็กข้าง hamburger (compact header, lg:hidden) กับปุ่ม
// เข้าสู่ระบบ ท้าย sidebar (มือถือเท่านั้นเหมือนกัน) — ตัดตัวกลางออกให้กดครั้งเดียว
// ถึงลิงก์ aff เลย ส่วนรายการ สมัครสมาชิก/เข้าสู่ระบบ ใน `links` (ทั้งแถบบนจอใหญ่
// และลิสต์ใน sidebar) ยังคงชี้ไป /register, /login ตามเดิม — สองหน้านั้นต้องเหลือ
// ทางเข้าไว้ให้ Google เก็บ index ได้จริง
// ⚠️⚠️ targetUrl ต้องเป็น **ลิงก์ aff ของแบรนด์นี้** ซึ่งเท่ากับค่าใน Navfoot.astro,
// src/pages/login.astro และ src/pages/register.astro เป๊ะๆ — **รอบนี้ค่าที่ค้างอยู่
// ในไฟล์นี้เป็นของรอบก่อน (l360) เพราะ uploader อัปเดตให้เฉพาะสามไฟล์นั้น
// ไม่ได้แตะ navbar ที่ยังไม่ถูกเลือกใช้** จึงแก้ให้ตรงกันใน P1 แล้ว
// ⚠️ ไฟล์นี้หมุนออกตอนรีแบรนด์รอบหน้า — ถ้า navbar ที่เลือกใหม่เป็นไฟล์อื่น ต้องย้าย
// const targetUrl กับสองจุดนี้ไปด้วย ไม่งั้นปุ่มลัดมือถือของแบรนด์ถัดไปจะกลับไปพาไป
// หน้า /register, /login เหมือนเดิม
const targetUrl = "https://yoalink.com/hx8w";
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "ℹ️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#ffffff]/95 shadow-[0_4px_20px_rgba(106,15,60,0.18)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#9c0f55] via-[#fb439b] to-[#ffc2e2] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(251,67,155,0.55)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#9c0f55] via-[#d91a73] to-[#fb439b] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-4 lg:flex xl:gap-6">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#9c0f55]" : "text-[#6a0f3c]/70 group-hover:text-[#9c0f55]"}`}>{link.name}</span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#fb439b] shadow-[0_-2px_10px_rgba(251,67,155,0.65)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#9c0f55]/70 px-6 py-2 text-sm font-bold text-[#9c0f55] transition-all hover:bg-[#ffe9f7] hover:shadow-[0_0_15px_rgba(251,67,155,0.35)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="nav8-cta hidden items-center justify-center rounded-full px-6 py-2 text-sm font-extrabold text-[#ffffff] shadow-[0_6px_18px_rgba(133,9,74,0.35)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={targetUrl}
            rel="nofollow sponsored"
            class="nav8-cta flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-bold text-[#ffffff] shadow-[0_4px_12px_rgba(133,9,74,0.35)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded-lg border border-[#f4a7cf] bg-[#ffe9f7] p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#6a0f3c] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#6a0f3c] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#6a0f3c] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-[#6a0f3c]/45 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#f4a7cf] bg-[#ffffff] shadow-[-10px_0_30px_rgba(106,15,60,0.25)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#f4a7cf] px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#9c0f55]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#6a0f3c] hover:text-[#9c0f55]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-xl border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#fb439b]/70 bg-[#ffe3f5] text-[#9c0f55]" : "border-transparent bg-[#fff4fb] text-[#6a0f3c]/70 hover:bg-[#ffe9f7]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#f4a7cf] pt-6">
        <a
          href={targetUrl}
          rel="nofollow sponsored"
          class="sidebar-item flex justify-center gap-2 rounded-xl border border-[#9c0f55]/70 bg-transparent py-3.5 text-sm font-bold text-[#9c0f55] transition-colors hover:bg-[#ffe9f7]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* #mobile-sidebar ใช้ h-screen (100vh) ในคลาส แต่บนมือถือจริง 100vh คำนวณจาก
     viewport ใหญ่สุด (แถบที่อยู่เว็บหด) ไม่ใช่พื้นที่ที่เห็นจริงตอนนั้น — พอแถบที่อยู่
     ขยายกลับมา (เช่นหลังเลื่อนหน้า) แผง sidebar จะเตี้ยกว่าจอจริง เหลือช่องให้เนื้อหา
     หน้าเว็บโผล่ทะลุออกมาด้านล่างเมนู อาการนี้ไม่เกิดใน headless browser เพราะไม่มี
     แถบที่อยู่แบบไดนามิก จึงไม่เจอตอนทดสอบปกติ #mobile-overlay ไม่เป็นเพราะใช้ inset-0
     ซึ่งอิง edge ของ viewport จริงตลอดเวลา ไม่ใช่ค่า vh ที่ตรึงไว้
     แก้ด้วย selector นี้แทนที่จะแก้คลาสตรงๆ เพราะ specificity ของ #id ชนะ .h-screen
     เสมอโดยไม่ต้องสนลำดับ แล้วถ้าเบราว์เซอร์เก่าไม่รู้จัก dvh บรรทัดนี้จะถูกข้ามไปเอง
     เหลือ h-screen (100vh) เป็นค่า fallback ต่อ ไม่ต้องลบคลาสเดิมออก */
  #mobile-sidebar {
    height: 100dvh;
  }

  .nav8-cta {
    /* ปุ่มนี้เป็นพื้น **ชมพูเข้ม** ไล่เฉด และตัวอักษรเป็น **ขาว** — สองข้อนี้ผูกกัน
       🚨🚨 ห้ามเปลี่ยนพื้นเป็น #fb439b (ฮิวนำของแบรนด์) เพราะขาวบนค่านั้นได้แค่
       3.2:1 ซึ่งไม่ผ่านสำหรับปุ่มหลัก ส่วนไล่เฉดที่ใช้อยู่ได้ 4.8:1 ที่ปลายสว่าง
       (#d91a73) · 6.8:1 ที่กลาง (#b01160) · 9.8:1 ที่ปลายเข้ม (#85094a)
       ห้ามดันปลายสว่างให้สว่างกว่า #d91a73 และห้ามพลิกไปใช้หมึกเข้มบนพื้นเข้ม
       ถ้าต้องการพื้นชมพูสดจริงๆ ต้องจับคู่กับหมึก #6a0f3c เท่านั้น
       ⚠️ ชื่อคลาสตั้งเฉพาะไฟล์นี้ (nav8-) เพราะเป็น is:global — ถ้าใช้ชื่อกลางๆ
       อย่าง bg-theme-oklab จะชนกับ footer/ticker ที่อาจประกาศชื่อเดียวกัน */
    background-image: linear-gradient(in oklab to right, #d91a73, #b01160, #85094a);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
