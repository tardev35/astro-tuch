---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ หวยดีใจ บนพื้นโปร่งใส ด้านซ้ายเป็นมงกุฎทองห้าแฉกประดับลูกกลมที่ปลายแต่ละแฉก ถัดมาเป็นตัวอักษรไทยคำว่า หวย ตัวหนาสามมิติสีเงินโครเมียมไล่แสง ต่อด้วยคำว่า ดีใจ ตัวหนาสามมิติสีแดงเมทัลลิกเรียงติดกันเป็นบรรทัดเดียว";

// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): navbar ที่ใช้งานจริง
// รอบนี้ — รอบก่อน หวย24 ใช้ NavbarStyle10 จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้างอยู่
// ข้างในเป็นทอง-เงินของ NATO168 (#070707 #edb543 #fde8a8 #a9761f #e6e6e6 #a9a9a9
// #f4ead3 #101010 #17120a #241a09 #1a1203 #b8832a) ย้ายทั้งไฟล์มาเป็นพาเลตต์ของ
// แบรนด์นี้แล้ว ไม่เหลือเฉดทองน้ำตาลเดิมอีก
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "เงินนำ แดงตาม": คำว่า "หวย" เป็นโครเมียมเงิน
// ส่วน "ดีใจ" เป็นแดงเมทัลลิก และมงกุฎด้านหน้าเป็นทอง — ต่างจาก หวย24 รอบก่อนที่
// เป็นคู่ แดง/ทอง รอบนี้คู่หลักคือ แดง/เงิน และทองถูกลดบทบาทเหลือแค่จุดเน้นเล็ก
// แดงแบรนด์ #dc0409 ถือเส้นเน้น ขอบ แถบ active และแสงรอบโลโก้ ส่วนเงิน #eef0f4
// ถือตัวอักษรเมนูที่ active กับเส้นคั่น และ #8d93a1 เป็นเมนูปกติ
// พื้นเกือบดำอมแดง #0d0407 ยกระดับด้วย #17080c / #211016 เนื้อความ #edeaf0
// (BRAND_TEXT รอบนี้)
//
// ปุ่ม CTA พื้นแดงใช้ตัวอักษรขาว — ปลายไล่เฉดที่สว่างที่สุด (#e8161c) ยังได้ 4.6:1
// กับสีขาว ซึ่งผ่าน AA สำหรับตัวอักษรขนาดปกติพอดี ห้ามดันปลายนั้นให้สว่างกว่านี้
// (#f5363d ซึ่งเป็นแดงสว่างของพาเลตต์ตกลงมาเหลือ 3.8:1 ทันที) ถ้าปรับสีปุ่มรอบหน้า
// ให้คำนวณคู่พื้น-หมึกใหม่ทุกครั้ง ส่วนเงินของโลโก้ไปอยู่ที่ปุ่มเส้นขอบแทน เพราะ
// เงินบนแดงอิ่มตัวอ่านยากกว่าขาวล้วน
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
//
// มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้: หวยดีใจ เป็นเว็บหวยเต็มตัว สองหน้านั้นอยู่ใน
// src/pages/ จึงมี route จริงใน dist/ (ถ้าแบรนด์ถัดไปเป็นสล็อต ต้องถอดลิงก์คู่นี้ออก
// พร้อมกับย้ายไฟล์กลับไป src/pages-disabled/ ไม่งั้น verify-build จะแดงเพราะ href
// ชี้ไป route ที่ไม่มีอยู่)
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔍" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "🔢" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#0d0407]/95 shadow-[0_4px_20px_rgba(2,0,1,0.9)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#8e0206] via-[#dc0409] to-[#eef0f4] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(220,4,9,0.65)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#eef0f4] via-[#c3c7d1] to-[#dc0409] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-5 lg:flex xl:gap-7">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#edeaf0] drop-shadow-[0_0_8px_rgba(220,4,9,0.9)]" : "text-[#8d93a1] group-hover:text-[#edeaf0]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#dc0409] shadow-[0_-2px_10px_rgba(220,4,9,0.95)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#c3c7d1]/60 px-6 py-2 text-sm font-bold text-[#edeaf0] transition-all hover:bg-[#211016]/80 hover:shadow-[0_0_15px_rgba(195,199,209,0.4)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-white shadow-[0_0_20px_rgba(220,4,9,0.6)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/register"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-white shadow-[0_0_10px_rgba(220,4,9,0.6)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#dc0409]/60 bg-[#211016]/70 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#edeaf0] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#edeaf0] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#edeaf0] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#dc0409]/50 bg-[#0d0407] shadow-[-10px_0_30px_rgba(2,0,1,0.95)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#dc0409]/30 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#eef0f4]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#edeaf0] hover:text-[#f5363d]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#dc0409]/70 bg-[#211016]/85 text-[#edeaf0]" : "border-transparent bg-[#17080c] text-[#8d93a1] hover:bg-[#211016]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#dc0409]/45 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-lg border border-[#c3c7d1]/70 bg-transparent py-3.5 text-sm font-bold text-[#edeaf0] transition-colors hover:border-transparent hover:text-white">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    /* ไล่เฉดทั้งเส้นต้องเข้มพอให้ตัวอักษรขาวอ่านออกตลอดปุ่ม — ปลายที่สว่างที่สุด
       #e8161c ได้ 4.6:1 กับสีขาว ซึ่งผ่าน AA พอดี ห้ามใช้ #f5363d (แดงสว่างของ
       พาเลตต์) เป็นปลายเกรเดียนต์ เพราะตกลงเหลือ 3.8:1 ส่วนเงินของโลโก้ (#eef0f4)
       ไม่ได้มาอยู่ในปุ่มนี้เพราะเงินบนแดงอิ่มตัวแยกกันไม่ออก คู่แดง-เงินของแบรนด์
       ไปอยู่ที่เส้นคั่น เส้นใต้ แถบ active และปุ่มเส้นขอบแทน */
    background-image: linear-gradient(in oklab to right, #8e0206, #c90308, #e8161c);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
