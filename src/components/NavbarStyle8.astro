---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจาก src/assets/logo.webp ของดรอป 2026-10-21 จริง (เปิดอ่านด้วย Read ก่อนเขียน)
// ไม่ใช่คัดลอกของรอบก่อน — **แมวกวักนำโชค ริบบิ้นชมพูบานเย็น เหรียญจีน และทองแท่ง
// ทรงเรือของ มีโชค168 ที่เคยอยู่บรรทัดนี้ไม่มีในรูปรอบนี้เลย** และตัวอักษร "สาธุ"
// เขียวมรกตของรอบก่อนหน้าก็ไม่มี
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นเครื่องหมายโค้งสะบัดทรงตัวเอสสามมิติผิวมันวาว ไล่สีแดงคริมสันกับทอง ถัดมาเป็นคำว่า รวยแท้ ตัวอักษรไทยหนาสามมิติผิวมันวาวสีแดงคริมสัน ตัดขอบทองหนา ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติผิวทองขัดเงาสะท้อนแสง`;

// รวยแท้168 (รอบแดงเลือดหมูนำ-ทองโบราณรอง บน **ธีมสว่าง** 2026-10-21): navbar ที่ใช้
// งานจริงรอบนี้ — รอบก่อน สาธุ168 ใช้ NavbarHuay จึงหมุนมาที่ไฟล์นี้ ของเดิมที่ค้าง
// อยู่ข้างในเป็นชุดทองนำ-ชมพูบานเย็นของ มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 1a0612 f6e4ee 24101c 160a12 0b0509 d8b9c9 c89a08 e8bc1c และ rgba(245,70,159,α)
// rgba(252,212,52,α)) ย้ายทั้งไฟล์มาเป็นพาเลตต์ของแบรนด์นี้แล้ว ไม่เหลือเฉดชมพูเดิมอีก
// ก่อนหน้านั้นไฟล์นี้เคยถือชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a 7d0f12
// f2b705 ffd666 180800 301105 4a0605 fbe8d5 c9a898 2b0a00 c08a0b e0a50e) ซึ่งหายไปหมดแล้ว
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// NavbarHuay ของรอบก่อนเป็นแถบสองชั้นพร้อมลายไทย — ไฟล์นี้เป็นคนละทรง: แถบนอนแบน
// เต็มความกว้างติดขอบบน ไม่มีแถบ info และ drawer เป็นแผงเลื่อนเข้าจากขอบ **ขวา**
// กว้าง 260px สองแบรนด์หวยติดกันจึงไม่ออกมาหน้าตาเหมือนเว็บเดียวกันทาสีใหม่
//
// ⚠️⚠️ **รอบนี้พื้นเพจเป็นชมพูกุหลาบสว่าง #ffdbdb (จาก bg.json)** แต่ navbar เป็น
// **โครม** จึงยังเป็นแดงจม #280b0b โดยตั้งใจ — หัว-ท้ายเข้มคร่อมเนื้อหาสว่างคือกรอบ
// ที่อ่านง่าย และโลโก้แดง-ทองบนพื้นโปร่งอ่านออกชัดกว่าบนพื้นเข้ม
//
// แกนสีมาจากโลโก้จริงซึ่งอ่านเป็น "แดงคริมสันนำ ทองเป็นฮิวที่สอง": คำว่า รวยแท้ เป็น
// แดงตัดขอบทอง เลข 168 เป็นทองล้วน และเครื่องหมายโค้งด้านซ้ายไล่แดง-ทอง — ต่างจาก
// สาธุ168 รอบก่อนที่เป็นคู่ เขียวมรกต/ทองสัมฤทธิ์
// แดงแบรนด์ #c30303 ถือแถบ active ขอบปุ่มรอง และแสงรอบโลโก้ · แดงเข้ม #8f0505 เป็น
// ปลายเย็นของเส้นคาดใต้แถบและพื้นปุ่ม hamburger · ทองโบราณ #dcb95f ถือหัว MENU
// สี hover และปลายสว่างของปุ่ม CTA · พื้นแดงจม #280b0b ยกระดับด้วย #461212
// เนื้อความบนโครม #ffeee8 (13.8:1 บน #461212) ส่วนเมนูที่ยังไม่ active ใช้
// **#ffeee8 ที่ความทึบ 70%** แทนการคิดค่าสีใหม่ — ทำให้พาเลตของไฟล์นี้ไม่มีค่าที่
// อยู่นอกตารางใน brand-spec §2 เลยสักค่า
//
// ปุ่ม CTA พื้น **ทอง** และใช้ **หมึกเข้ม** #280b0b ไม่ใช่ตัวอักษรขาว สองข้อนี้ผูกกัน:
// ตัวอักษรขาวบนทอง #dcb95f ได้แค่ 1.9:1 ส่วนหมึกเข้มบนทองได้ 9.8:1 ที่ปลายสว่าง
// (#dcb95f) และ 5.7:1 ที่ปลายเข้มสุด (#b8862b)
// ⚠️ ห้ามพลิกกลับเป็นพื้นทอง-ตัวอักษรขาว ห้ามเปลี่ยนพื้นปุ่มเป็นแดง และห้ามดัน
// ปลายเข้มของไล่เฉดให้เข้มกว่า #b8862b
// ⚠️ **#e81313 แดงสกาเล็ตไม่ปรากฏในไฟล์นี้เลย** — มันถือตัวอักษรไม่ได้และเป็นพื้นของ
// ตัวอักษรไม่ได้ ซึ่งในแถบนี้ทุกชั้นมีตัวอักษรอยู่
//
// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย ทุกรายการมีไอคอนของตัวเอง
// วางใน <span aria-hidden> แยกจากข้อความ ไม่ปนอยู่ในตัวอักษรของ label
// ไอคอนเลือกตามหมวดของแบรนด์: รอบนี้เป็น **เว็บหวยล้วน** จึงไม่มี 🎰 ตู้สล็อตอยู่เลย
// — 🔍 สำหรับ ตรวจหวย · 📊 สำหรับ แนวทาง · 🎫 สำหรับ ทดลองเล่น
//
// ⚠️ **มี /ตรวจหวย และ /แนวทาง ในเมนูรอบนี้**: บรีฟทั้งฉบับเป็นหวยล้วน (รัฐบาลไทย
// ลาวพัฒนา ฮานอย หุ้นต่างประเทศ) สองหน้านั้นอยู่ใน src/pages/ จึงมี route จริงใน dist/
// ถ้ารอบหน้าเป็นแบรนด์สล็อต/คาสิโนแล้วย้ายไฟล์กลับไป src/pages-disabled/ **ต้องลบ
// สองลิงก์นี้ออกด้วย** ไม่งั้น verify-build จะแดงเพราะ href ชี้ไป route ที่ไม่มีอยู่
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// สองจุด "ปุ่มลัด" เฉพาะจอมือถือชี้ตรงไปลิงก์ aff แทน /register, /login:
// ปุ่ม สมัครสมาชิก เล็กข้าง hamburger (compact header, lg:hidden) กับปุ่ม
// เข้าสู่ระบบ ท้าย sidebar (มือถือเท่านั้นเหมือนกัน) — ตัดตัวกลางออกให้กดครั้งเดียว
// ถึงลิงก์ aff เลย ส่วนรายการ สมัครสมาชิก/เข้าสู่ระบบ ใน `links` (ทั้งแถบบนจอใหญ่
// และลิสต์ใน sidebar) ยังคงชี้ไป /register, /login ตามเดิม — สองหน้านั้นต้องเหลือ
// ทางเข้าไว้ให้ Google เก็บ index ได้จริง
// ⚠️ targetUrl ต้องเป็น **ลิงก์ aff ของแบรนด์นี้** ซึ่งเท่ากับค่าใน Navfoot.astro,
// src/pages/login.astro และ src/pages/register.astro เป๊ะๆ — ค่าที่ค้างอยู่ในไฟล์นี้
// ตอนหมุนมาใช้ (https://yoalink.com/2u19) เป็นของ มีโชค168 คนละแบรนด์ จึงถูกแก้เป็น
// ค่าของรอบนี้ใน P1 ห้ามแก้ค่านี้เองรอบถัดไป อัปโหลดเดอร์อัปเดตให้พร้อมกันทั้งสี่ไฟล์
//
// ⚠️ ไฟล์นี้หมุนออกตอนรีแบรนด์รอบหน้า — ถ้า navbar ที่เลือกใหม่เป็นไฟล์อื่น ต้องย้าย
// const targetUrl กับสองจุดนี้ไปด้วย ไม่งั้นปุ่มลัดมือถือของแบรนด์ถัดไปจะกลับไปพาไป
// หน้า /register, /login เหมือนเดิม
const targetUrl = "https://yoalink.com/l360";
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔍" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎫" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#280b0b]/95 shadow-[0_4px_20px_rgba(0,0,0,0.9)] backdrop-blur-lg">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#8f0505] via-[#c30303] to-[#dcb95f] opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(195,3,3,0.7)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffeee8] via-[#c30303] to-[#dcb95f] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-4 lg:flex xl:gap-6">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true">{link.icon}</span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#ffeee8] drop-shadow-[0_0_8px_rgba(195,3,3,0.9)]" : "text-[#ffeee8]/70 group-hover:text-[#dcb95f]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#c30303] shadow-[0_-2px_10px_rgba(195,3,3,0.95)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#c30303]/65 px-6 py-2 text-sm font-bold text-[#ffeee8] transition-all hover:bg-[#8f0505]/80 hover:shadow-[0_0_15px_rgba(195,3,3,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#280b0b] shadow-[0_0_20px_rgba(220,185,95,0.6)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={targetUrl}
            rel="nofollow sponsored"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#280b0b] shadow-[0_0_10px_rgba(220,185,95,0.6)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#c30303]/60 bg-[#8f0505]/70 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#ffeee8] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#ffeee8] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#ffeee8] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#c30303]/50 bg-[#280b0b] shadow-[-10px_0_30px_rgba(0,0,0,0.95)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#c30303]/30 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#dcb95f]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#ffeee8] hover:text-[#dcb95f]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#c30303]/70 bg-[#8f0505]/85 text-[#ffeee8]" : "border-transparent bg-[#461212] text-[#ffeee8]/70 hover:bg-[#8f0505]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#c30303]/45 pt-6">
        <a
          href={targetUrl}
          rel="nofollow sponsored"
          class="sidebar-item hover:bg-theme-oklab flex justify-center gap-2 rounded-lg border border-[#c30303]/70 bg-transparent py-3.5 text-sm font-bold text-[#ffeee8] transition-colors hover:border-transparent hover:text-[#280b0b]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* #mobile-sidebar ใช้ h-screen (100vh) ในคลาส แต่บนมือถือจริง 100vh คำนวณจาก
     viewport ใหญ่สุด (แถบที่อยู่เว็บหด) ไม่ใช่พื้นที่ที่เห็นจริงตอนนั้น — พอแถบที่อยู่
     ขยายกลับมา (เช่นหลังเลื่อนหน้า) แผง sidebar จะเตี้ยกว่าจอจริง เหลือช่องให้เนื้อหา
     หน้าเว็บโผล่ทะลุออกมาด้านล่างเมนู อาการนี้ไม่เกิดใน headless browser เพราะไม่มี
     แถบที่อยู่แบบไดนามิก จึงไม่เจอตอนทดสอบปกติ #mobile-overlay ไม่เป็นเพราะใช้ inset-0
     ซึ่งอิง edge ของ viewport จริงตลอดเวลา ไม่ใช่ค่า vh ที่ตรึงไว้
     แก้ด้วย selector นี้แทนที่จะแก้คลาสตรงๆ เพราะ specificity ของ #id ชนะ .h-screen
     เสมอโดยไม่ต้องสนลำดับ แล้วถ้าเบราว์เซอร์เก่าไม่รู้จัก dvh บรรทัดนี้จะถูกข้ามไปเอง
     เหลือ h-screen (100vh) เป็นค่า fallback ต่อ ไม่ต้องลบคลาสเดิมออก */
  #mobile-sidebar {
    height: 100dvh;
  }

  .bg-theme-oklab {
    /* ปุ่มนี้เป็นพื้น **ทอง** ไล่เฉด และตัวอักษรเป็นหมึกเข้ม #280b0b ไม่ใช่สีขาว —
       สองข้อนี้ผูกกัน ตัวอักษรขาวบนทอง #dcb95f ได้แค่ 1.9:1 ไม่ผ่านสำหรับปุ่มหลัก
       พื้นทองกับหมึกนั้นได้ 9.8:1 ที่ปลายสว่าง (#dcb95f) และ 5.7:1 ที่ปลายเข้มสุด
       (#b8862b) — ห้ามดันปลายเข้มให้เข้มกว่า #b8862b ห้ามเปลี่ยนพื้นเป็นแดง และ
       ห้ามพลิกไปใช้ตัวอักษรสีขาว
       แดงแบรนด์ไปอยู่ที่เส้นคั่น เส้นใต้ แถบ active และขอบปุ่มรองแทน */
    background-image: linear-gradient(in oklab to right, #b8862b, #c99a3f, #dcb95f);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .sidebar-item:nth-child(8) {
    transition-delay: 0.45s;
  }
  .sidebar-item:nth-child(9) {
    transition-delay: 0.5s;
  }
  .sidebar-item:nth-child(10) {
    transition-delay: 0.55s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
