---
import { isActivePath } from "../lib/nav";
import { Image } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

// isActivePath มาจาก ../lib/nav — **ห้ามเขียน isActive เองในไฟล์นี้**
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (/ทดลองเล่น) ถ้าเทียบ
// สตริงตรงๆ จะไม่มีเมนูไหนไฮไลต์เลยบนหน้าเหล่านั้น ทั้ง 16 variant เคยเป็นแบบนั้น
const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียว map ทั้งเดสก์ท็อปและลิ้นชักมือถือ — ไฟล์นี้เคยประกาศอาร์เรย์เดียวกัน
// สองรอบ ซึ่งแปลว่าคนถัดไปแก้ข้างเดียวแล้วอีกข้างค้าง
//
// ลำดับตามกฎ playbook: หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ
// สองรายการกลางเป็น "การกระทำที่แปลงเป็นยอด" ไม่ใช่หน้าให้อ่าน จึงต้องอยู่ก่อน
// หน้าข้อมูล ไม่ใช่ท้ายรายการที่ uploader append มาให้
//
// ⚠️ **/ทางเข้า ไม่อยู่ในเมนูโดยตั้งใจ** เพราะ toggle cta เปิดอยู่: /register กับ
// /login เป็นหน้าปุ่มจริงและอยู่ในเมนูแล้ว การใส่ /ทางเข้า ด้วยคือลิงก์ที่สาม
// ที่พาไปที่เดียวกัน — หน้านั้นยังมี route และยัง index ได้ตามปกติ
// ⚠️⚠️ **ห้ามใส่ /ตรวจหวย หรือ /แนวทาง กลับเข้ามา** รอบนี้เป็นเว็บสล็อต สองหน้านั้น
// ถูกย้ายไป src/pages-disabled/ แล้ว ลิงก์ที่ชี้ไป route ที่ไม่มีจะทำให้ build แดง
//
// ไอคอนเป็น <span aria-hidden="true"> ที่เป็น **พี่น้อง** ของ label เสมอ ไม่ใช่
// อยู่ในตัวข้อความ — ไม่งั้น screen reader จะอ่าน "house หน้าแรก" และ emoji ที่
// อบอยู่ในสตริงก็ mark ไม่ได้ ไอคอนเลือกให้ตรงหมวดเว็บสล็อตฟาร์มของรอบนี้
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🐰" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// โลโก้วาดจริงที่สูง 40px (xl: 45px) บนไฟล์ต้นทาง 500x500 = จัตุรัส จึงกว้างเท่า
// ความสูง widths/sizes จึงอิง 45px ไม่ใช่ความกว้างของไฟล์ ถ้าไม่บอก Astro
// มันจะ ship ไฟล์ต้นฉบับทั้งใบลงกล่อง 45x45
//
// ⚠️ **เป็น <Image format="webp"> ไม่ใช่ <Picture> ที่มี avif โดยตั้งใจ** — ที่
// 45w/90w/135w ค่าโสหุ้ยของคอนเทนเนอร์ AVIF กินมากกว่าที่มันประหยัดได้ รอบนี้วัดได้
// avif 1,126 ไบต์ ปะทะ webp 968 ไบต์ (+16%) ซึ่ง `tools/verify-build.mjs` ทำให้
// build แดงถูกต้องแล้ว เพราะเบราว์เซอร์ที่รองรับ avif จะหยิบไฟล์ที่ **ใหญ่กว่า**
// การลด quality ไม่ช่วยเพราะพื้นของ avif อยู่ที่ ~700 ไบต์ไม่ว่าจะลดแค่ไหน
// **ห้ามเติม avif กลับเข้ามาที่ขนาดนี้** ถ้าวันไหนโลโก้ถูกวาดใหญ่ขึ้นมากค่อยทบทวน
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นรูปกระต่ายการ์ตูนขนขาวผูกผ้าพันคอสีแดงยกนิ้วโป้งและขยิบตา อยู่ข้างคำว่า ${BRAND_NAME} ตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ตัดขอบขาว`;

// พาเลตรอบนี้ (brand-spec §2 — แดงเชอร์รี่นำ ทองแดงไหม้รอง **ธีมสว่าง**):
// ไฟล์นี้อยู่ในโซน "โครม" จึงเป็น **พื้นเข้ม ตัวอักษรสว่าง** ตรงข้ามกับการ์ดเนื้อหา
//   พื้นแถบ #2c1004 (จม) · แผงลิ้นชัก #2c1004 · ชั้นยก #4d1c0a
//   ตัวอักษรหลัก #fff0e4 (15.9:1 บน #2c1004) · ตัวอักษรรอง ทองสาลี่ #f0b46a (9.7:1)
//   ขอบ/ไฮไลต์ ทองแดงไหม้ #b44c06 · สถานะ active แดงเชอร์รี่ #eb0305
// ⚠️ ไฟล์นี้เคยเป็นธีม **ม่วง-ชมพูนีออนบน navy 020617 ของ CEO66** ทั้งใบ
// (purple-500 d946ef 7e22ce f5d0fe a855f7 020617) — กวาดออกหมดแล้ว ห้ามกลับมา
// และ **ห้ามเอาคำ/ลวดลายหวย-สลาก-เจดีย์ของรวยแท้168 (รอบก่อน) เข้ามา**
// ทรงของ variant นี้ (แท็บสี่เหลี่ยมเฉียง skew + ลิ้นชักขวา) คงไว้ — นั่นคือสิ่งที่
// ทำให้รอบนี้ไม่เหมือน NavbarStyle8 ของรอบก่อน เปลี่ยนแต่ภาษาสี
---

<nav class="sticky top-0 z-50 w-full border-b border-[#b44c06]/50 bg-[#2c1004] font-sans shadow-[0_4px_20px_rgba(235,3,5,0.18)] backdrop-blur-md">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-[#eb0305]/25 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        <Image
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          fetchpriority="high"
          widths={[45, 90, 135]}
          sizes="45px"
          class="relative h-[40px] w-auto drop-shadow-[0_0_12px_rgba(240,180,106,0.45)] transition-transform group-hover:scale-105 xl:h-[45px]"
          format="webp"
          quality={70}
        />
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative skew-x-[-15deg] overflow-hidden border px-5 py-2 transition-all duration-300 ${isActive(item.path) ? "border-[#f0b46a] bg-[#eb0305]/25 shadow-[0_0_15px_rgba(235,3,5,0.35)]" : "border-[#f0b46a]/25 bg-[#fff0e4]/5 hover:border-[#f0b46a]/70"}`}>
            <div
              class={`absolute inset-0 translate-y-full bg-gradient-to-r from-[#eb0305] to-[#b44c06] transition-transform duration-300 ${isActive(item.path) ? "translate-y-0 opacity-25" : "opacity-40 group-hover:translate-y-0"}`}
            />
            <span
              class={`relative z-10 flex skew-x-[15deg] items-center gap-1.5 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#fff0e4] drop-shadow-[0_0_6px_rgba(235,3,5,0.6)]" : "text-[#f0b46a] group-hover:text-[#fff0e4]"}`}>
              <span aria-hidden="true">{item.icon}</span>
              <span>{item.name}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-lg border border-[#b44c06]/60 bg-[#4d1c0a] p-2 shadow-[0_0_10px_rgba(235,3,5,0.25)] transition-all hover:bg-[#4d1c0a]/70 xl:hidden"
        aria-label="เปิดหรือปิดเมนูนำทาง">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f0b46a] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#f0b46a] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#f0b46a] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#b44c06]/70 bg-[#2c1004] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`sidebar-item flex items-center rounded-xl border px-4 py-3.5 transition-all ${isActive(item.path) ? "border-[#f0b46a] bg-[#eb0305]/25 text-[#fff0e4] shadow-[inset_4px_0_0_#eb0305]" : "border-transparent bg-[#fff0e4]/5 text-[#f0b46a] hover:bg-[#fff0e4]/10 hover:text-[#fff0e4]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {item.icon}
            </span>
            <span class="text-sm font-bold">{item.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    background-color: #eb0305;
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    background-color: #eb0305;
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .sidebar-item:nth-child(7) {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
