---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ brand-spec §9 ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟ **เว็บคาสิโนไทย
// เซิร์ฟเวอร์ต่างประเทศ รวมบาคาร่า ไฮโล บอล สล็อต ในบัญชีเดียว** ซึ่ง brand-spec §7
// ของรอบนี้ห้ามทุกคำในชุดนั้น — โดยเฉพาะ บาคาร่า · ไฮโล · บอล/บอลออนไลน์ ·
// อัตราต่อรอง · รายการแข่งขัน · คาสิโน · เซิร์ฟเวอร์ต่างประเทศ · ฝากถอนทุกธนาคาร ·
// ยอดเข้าบริษัทโดยตรง · ไม่มีขั้นต่ำ ไม่เหลือแม้คำเดียวในไฟล์นี้
//
// บรีฟรอบนี้ครอบคลุมแค่: **ช่องทางรับบริการจากผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้
// ฐานหลักเกมสล็อตออนไลน์ 100%** สำหรับ **เข้าเล่น · ฝากถอน · ติดต่อ · รับโปรโมชั่น
// จากเจ้าหน้าที่ได้ 24 ชั่วโมง**; โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% เข้ายูสทุกวัน
// และ แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด); ขั้นตอนสมัครสมาชิกสามขั้น; และช่องทาง
// LINE Official — ไม่มีอะไรนอกนี้ ไม่มีหมวดเกมอื่น ไม่มีชื่อค่ายเกม และ **ไม่มีคำ
// เกี่ยวกับหวยที่ไหนเลย**
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: ควรอ่านเงื่อนไขของแต่ละรายการก่อน
// ดำเนินการทุกครั้ง · สิทธิ์ที่ได้รับอาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลา
// ของแคมเปญ · การได้รับเครดิตคืนไม่ได้เป็นการรับประกันผลการเดิมพันในครั้งต่อไป ·
// แม้จะมีการระบุว่าไม่จำกัด แต่จำนวนสิทธิ์และยอดที่นำมาคำนวณควรยืนยันจากประกาศ
// โปรโมชั่นฉบับล่าสุด · ควรตรวจสอบช่องทาง LINE Official จากหน้าเว็บไซต์ทางการก่อน
// เพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือ
// รหัส OTP ให้บุคคลอื่น
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อหน่วยงานกำกับ ชื่อนิติบุคคล ชื่อค่ายเกม ชื่อธนาคาร
// ค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือที่ตั้งเซิร์ฟเวอร์ — บรีฟไม่ได้
// ระบุไว้สักข้อ ตัวเลขที่อ้างมีแค่สามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง
// (คำว่า "100%" ปรากฏได้เพราะเป็นส่วนหนึ่งของวลี "ฐานหลักเกมสล็อตออนไลน์ 100%" ที่
// บรีฟเขียนเอง และ "3 ขั้นตอน" มาจากหัวข้อ §6 ของบรีฟเช่นกัน)
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้ที่สอบถามก่อนเข้าเล่น",
    role: "ตรวจสอบรายละเอียดบริการก่อนทุกครั้ง",
    stars: 4,
    content: `เปิดหน้าเว็บ ${BRAND_NAME} มาเพราะอยากรู้ว่าช่องทางรับบริการมีอะไรให้ถามได้บ้าง ตัวหน้าเขียนไว้ตรงๆ ว่าเป็นช่องทางสำหรับผู้ที่ต้องการเข้าใช้งานเกมสล็อตออนไลน์และสอบถามข้อมูลเกี่ยวกับบริการต่าง ๆ ทั้งการเข้าเล่น ฝากถอน และโปรโมชั่น ซึ่งตรงกับที่ใช้จริง ผมทักไปถามขั้นตอนการใช้งานก่อนเริ่ม เจ้าหน้าที่ก็ตอบตามที่หน้าเว็บระบุไว้ว่าให้ตรวจสอบรายละเอียดบริการได้ตลอด 24 ชั่วโมง หัก 1 ดาวตรงที่หน้าเว็บย้ำเองว่าควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง ซึ่งถ้ารวมเงื่อนไขของแต่ละรายการไว้ให้อ่านจบในหน้าเดียวได้ก็จะสะดวกกว่านี้`,
    avatar: "🎧",
  },
  {
    name: "ผู้อ่านเงื่อนไขก่อนรับสิทธิ์",
    role: "ไล่ดูช่วงเวลาสรุปยอดกับวิธีรับสิทธิ์",
    stars: 4,
    content:
      "เรื่องที่ถูกถามมากที่สุดคือโปรโมชั่น หน้านี้เขียนไว้เองว่าสิทธิ์ที่ได้รับอาจขึ้นอยู่กับประเภทบัญชี ยอดเดิมพัน ระยะเวลาของแคมเปญ และข้อกำหนดของแต่ละโปรโมชั่น จึงควรตรวจสอบรายละเอียดจากช่องทางทางการให้ครบถ้วน ทั้งอัตราที่ได้รับ วิธีรับสิทธิ์ และเงื่อนไขการใช้งาน ซึ่งตรงกับที่แนะนำกันอยู่แล้วว่าให้อ่านให้จบก่อนกดรับสิทธิ์ อีกข้อที่ชอบคือหน้าเว็บบอกเองว่าการได้รับเครดิตคืนไม่ได้เป็นการรับประกันผลการเดิมพันในครั้งต่อไป ส่วนที่ยังอยากให้เพิ่มคือคำว่าไม่จำกัดในรายการแนะนำเพื่อน ควรระบุให้ชัดว่าหมายถึงจำนวนสิทธิ์ ยอดที่นำมาคำนวณ หรือข้อกำหนดอื่น ๆ เพราะตอนนี้ต้องไปยืนยันจากประกาศโปรโมชั่นฉบับล่าสุดอีกที",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ทำรายการฝากถอนประจำ",
    role: "เก็บหลักฐานรายการไว้ทุกครั้งก่อนยืนยัน",
    stars: 5,
    content: `ใช้ต่อเนื่องเพราะเปิดดูโปรโมชั่นกับรายละเอียดบริการจากหน้าเดิมได้เลย คืนยอดเสีย 0.3% เป็นรายการที่ระบุว่าจะคืนยอดตามเงื่อนไขที่กำหนด ผมก็ถามเจ้าหน้าที่ก่อนว่าคำนวณจากยอดเสียประเภทใด ครอบคลุมเกมไหน และต้องกดรับสิทธิ์ด้วยตนเองหรือไม่ แล้วดูช่วงเวลาสรุปยอดกับข้อกำหนดการใช้เครดิตเอาเอง ส่วนแนะนำเพื่อน โบนัส 0.8% ก่อนส่งต่อข้อมูลก็ตรวจวิธีลงทะเบียนผู้แนะนำ เงื่อนไขของบัญชีที่เข้าร่วม และหลักเกณฑ์การคำนวณโบนัสให้ครบก่อน เรื่องฝากถอนผมตรวจข้อมูลบัญชีและรายละเอียดที่เกี่ยวข้องให้ถูกต้องก่อนยืนยันทุกครั้ง และเก็บหลักฐานรายการไว้จนรายการเสร็จสิ้น เพราะหน้าเว็บเองก็เขียนว่าถ้าพบปัญหาเกี่ยวกับรายการทางการเงิน ควรเก็บหลักฐานรายการไว้และสอบถามขั้นตอนตรวจสอบจากช่องทางที่ยืนยันได้ ตอนจะทัก LINE Official ของ ${BRAND_NAME} ก็เช็กจากหน้าเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อเลี่ยงบัญชีที่แอบอ้างชื่อบริการ เจ้าหน้าที่แจ้งปัญหาได้ตรงประเด็น ไม่เคยถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง ให้ไปเลย 5 ดาว`,
    avatar: "💬",
  },
];

// รับตัง168 (รอบทองไทยนำ แดงมังกรรอง บนดำอมแดง 2026-10-18, brand-spec §2):
// การ์ดรีวิวที่ใช้งานจริงรอบนี้ — รอบก่อน (สมหวัง168) ใช้ ReviewCardSumo2 จึงหมุนมา
// ที่ไฟล์นี้ การ์ดเป็นผิวยก #2b100f ในกรอบทองแบรนด์ #f0b429 โปร่ง บนพื้นเพจ
// **ดำอมแดง #1a0505** (bg.json) จึงลอยขึ้นมาชัดเจน
// ⚠️ ลำดับความลึกรอบนี้: #2b100f ยก / #200a09 กลาง / #140505 จม / #1a0505 พื้น —
// ผิวจมมืดกว่าพื้นเพจ ต่างจากสองรอบก่อนที่พื้นเพจดำสนิท
// แบรนด์มีสองฮิวจริงตามโลโก้ — **ทองนำ** (กองเหรียญจีนทองรูสี่เหลี่ยมที่กลบงานอาร์ต
// ทั้งใบ ฝนเหรียญทอง กรอบลวดลายทอง มงกุฎทอง) และ **แดงรอง** (เลข 168 สามมิติแดงสด
// ริบบิ้นซาตินแดง) การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ: เครื่องหมายคำพูดเป็นแดงสว่าง
// #ff6b6e ชื่อผู้รีวิวเป็นทองแบรนด์ #f0b429 ที่ไต่ขึ้นเป็นทองสว่าง #ffdc8c ตอน hover
// ดาวที่ติดเป็น **ทองสว่าง #ffdc8c** พร้อมเรืองแสง rgba(255,220,140,α) ส่วนออรามุม
// การ์ดเป็นทองแบรนด์ที่อิ่มขึ้นตอน hover และขอบรูปโปรไฟล์เป็นทองลึก #9a6c0c บนพื้นไล่
// ผิวกลาง #200a09 → ผิวจม #140505
// ⚠️ **ดาวเป็นทอง ไม่ใช่เงินโครเมียม** — §2 ระบุว่ารอบนี้ไม่มีโครเมียม/เงินเป็นสีระบบ
// และฮิวนำคือทอง (รอบก่อนของไฟล์นี้ดาวเป็นเงินโครเมียมของแบรนด์คนละเจ้า)
// ดาวที่ไม่ติดตกไปเป็นตัวอักษรรอง #cfd9e6 ที่ opacity ต่ำ — และกลีฟ ★ นับเป็นตัวอักษร
// จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร (#ffdc8c 12:1 / #cfd9e6 10.9:1) ไม่ใช่
// #d30304 หรือแดงลึกตัวใดตัวหนึ่ง
// หัวแถบไล่ทองแบรนด์ #f0b429 → ทองสว่าง #ffdc8c → ทองแบรนด์ #f0b429 พร้อมคำว่า
// ผู้ใช้งานจริง เป็นแดงสว่าง #ff6b6e — ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของ
// ตัวอักษร** ไม่ใช่พื้นหลัง ทุกค่าในไล่เฉดจึงต้องถือตัวอักษรได้ หัวแถบนี้เป็น <p>
// ไม่ใช่หัวข้อ ข้อความรองใช้ตัวอักษรรอง #cfd9e6 ซึ่ง §2 กำหนดเป็นสีรองไว้แล้ว
// เส้นคั่นในการ์ดเป็นแดงเข้มสุด #4a0202 ซึ่ง §2 ห้ามถือตัวอักษรทุกขนาด
// เนื้อความ #f5ece0 (= BRAND_TEXT) — 13.0:1 บนผิวยก
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของรอบนี้คือแดง และสามแบรนด์ก่อน
// หน้าเป็นแดงทั้งหมด** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ไฟล์นี้เพิ่งถือชุด
// แดงเลือดนก-เงินโครเมียมของ TKB55 มาทั้งไฟล์ (fb131b / ff4d55 / ff8a8f / e9eef4 /
// aeb9c6 / f2e4e5 / 2a0d0f / 1a0708 / 0d0304 / 53050a) และก่อนนั้นเป็นชุดม่วงราชา-ทอง
// ของ KMD88 (7505cc / b453ff / c07cff / d9b8ff / bba8d4 / e2b33f / ece2f8 / 1d0832 /
// 140522 / 2c0349 / 0a0213) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 / ff5ca8 /
// fce343 / ffd94a / f0c3dc / fde7f2 / 8a0a45 / 4a1038 / 1c0014) ชุดทองแชมเปี้ยน-เงิน
// ของ UFA324 (e5a81b / b9c2cc / 231c0e / f0e8d4) ชุดทองอำพันเสือของ TIGERWIN369
// (d98324 / f7b733 / ffd98a / f7e4c0 / e3cfae) และชุดแดงเสือโคร่ง-ทองของ
// SUPERSLOTCLUB (e8232a / f2b705 / ffd666 / fbe8d5) — ออกครบทุกค่าแล้ว
// ⚠️ แดงรอบนี้คือ #d30304 (R=211 G=3 B=4) **คนละค่า** กับ fa0513 (สมหวัง168)
// fb131b (TKB55) fb141b (GT66B) e8232a (SUPERSLOTCLUB) d4200d (PIGPG — ต่างสองหลัก)
// ff3b14 (FLASH877) และ d20a0a / ff5c5c (หวย24) ที่ยังค้างในไฟล์ inventory อื่นๆ
// ⚠️ ทองรอบนี้คือ #f0b429 / #ffdc8c ไม่ใช่ e3b23c / ffe5a8 ของสมหวัง168 และไม่ใช่
// dfa310 e5a81b e2b33f f2b705 ffd666 หรือ fad354
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม** และ
// ไม่มีโครเมียม/เงินเป็นสีระบบ
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f0b429] via-[#ffdc8c] to-[#f0b429] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(240,180,41,0.45)]">
      เสียงตอบรับจาก <span class="text-[#ff6b6e]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0b429] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#f0b429]/55 bg-[#2b100f]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffdc8c]/75 hover:shadow-[0_15px_40px_rgba(240,180,41,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#f0b429]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#f0b429]/35" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#4a0202] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ff6b6e]/70 drop-shadow-[0_0_5px_rgba(211,3,4,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ffdc8c] drop-shadow-[0_0_5px_rgba(255,220,140,0.75)]" : "text-[#cfd9e6]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f5ece0] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#4a0202]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#9a6c0c] bg-gradient-to-br from-[#200a09] to-[#140505] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f0b429] transition-colors group-hover:text-[#ffdc8c]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#cfd9e6] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
