---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for a
// คาสิโนฐานเข้าหลัก brief (789BETTING: บาคาร่า รูเล็ต บอล หวย สล็อต side by side)
// and before that for a สล็อตเบทต่ำ one — brand-spec §6 bans every one of those
// words on this brand. KOON234 is a เว็บพนันฐานเล่นหลัก that rounds up ช่องทาง
// เข้าเล่นออนไลน์ into one system, and the brief talks about the MEMBER-SIDE
// system (เข้าสู่ระบบ, จัดการบัญชีสมาชิก, ตรวจสอบรายการ, การเข้ารหัสข้อมูล, การจัดการ
// สิทธิ์เข้าถึง, แจ้งเตือนรายการผิดปกติ), two promotions, a 3-step signup and a
// 24-hour admin desk — nothing else. So the three cards are written from that
// brief end to end.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt):
// รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว · รองรับมือถือและคอมพิวเตอร์ · ปรับรูปแบบ
// เว็บไซต์ให้เข้าถึงเมนูได้สะดวก · ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานจากหน้าเดียว ·
// อัปเกรดระบบตั้งแต่หน้าเข้าสู่ระบบถึงการตรวจสอบรายการ · การเข้ารหัสข้อมูล · การจัดการ
// สิทธิ์เข้าถึง · แจ้งเตือนรายการผิดปกติ · คืนยอดเสีย 0.3% ตามรอบประจำวัน · แนะนำเพื่อน
// 0.8% จากยอดที่เข้าเกณฑ์ · ลิงก์ส่วนตัว · โอนโบนัสเข้ายูสอัตโนมัติ · สมัคร 3 ขั้นตอน ·
// ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// — พร้อมคำกำกับของบรีฟเองว่า การระบุว่าไม่ผ่านเอเย่นต์ควรมีข้อมูลผู้ดำเนินงานและช่องทาง
// หลักที่ตรวจสอบได้ · ข้อความปลอดภัยขึ้น 100% ไม่สามารถใช้รับรองว่าไม่มีความเสี่ยงได้
// ทั้งหมด · ไม่ใช่ทุกการเดิมพันจะได้รับโบนัสโดยอัตโนมัติ · เงื่อนไขไม่จำกัดควรระบุให้ชัดว่า
// เป็นจำนวนเพื่อน จำนวนครั้ง หรือวงเงินโบนัส
//
// No licence claim, no regulator, no operator name, no bank name, no provider
// name, no member count, no founding year, no deposit minimum, no promised
// profit — the brief names none of them. The only figures used are the brief's
// own: 0.3% · 0.8% · 100% · 24 ชั่วโมง · 3 ขั้นตอน.
// The brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่กดดูทีละเมนูตามที่หน้าเว็บบอกไว้ รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียวจริง เปิดจากมือถือหาเมนูเจอง่าย เปิดจากคอมพิวเตอร์ก็ได้หน้าเดียวกัน รูปแบบเว็บไซต์ปรับมาให้กดเข้าเมนูต่างๆ ได้สะดวก ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียวโดยไม่ต้องสลับหลายหน้าจอ ฝั่งสมาชิกไล่ได้ครบตั้งแต่หน้าเข้าสู่ระบบ การจัดการบัญชีสมาชิก ไปจนถึงการตรวจสอบรายการต่างๆ หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเดิมพัน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่า ไม่ผ่านเอเย่นต์ กับ ปลอดภัยขึ้น 100% มากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าการระบุว่าเป็นเว็บไม่ผ่านเอเย่นต์ ควรมีข้อมูลผู้ดำเนินงานและช่องทางหลักที่ตรวจสอบได้ เพื่อให้ทราบว่าเว็บไซต์ให้บริการโดยใคร และบอกเองว่าข้อความปลอดภัยขึ้น 100% ไม่สามารถใช้รับรองว่าไม่มีความเสี่ยงได้ทั้งหมด ตรงกับที่เราแนะนำอยู่แล้วว่าให้ดูมาตรการที่ใช้งานจริงอย่างการเข้ารหัสข้อมูล การจัดการสิทธิ์เข้าถึง และการแจ้งเตือนรายการผิดปกติ ไม่ใช่ดูจากข้อความโฆษณาเพียงอย่างเดียว",
    avatar: "🛡️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `ใช้งานจากบัญชีเดียวมาตลอด เลยชอบที่ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว คืนยอดเสีย 0.3% คำนวณตามรอบประจำวันและอ้างอิงเฉพาะรายการที่เข้าเกณฑ์ พอเป็นระบบโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดกับประวัติการรับสิทธิ์จากบัญชีได้เอง ส่วนแนะนำเพื่อนใช้ลิงก์ส่วนตัวเชิญเพื่อนสมัคร แล้วระบบคำนวณ 0.8% จากยอดที่เข้าเกณฑ์ ยังอยากให้ระบุคำว่าไม่จำกัดให้ชัดว่าเป็นจำนวนเพื่อน จำนวนครั้ง หรือวงเงินโบนัส และก่อนกดรับก็ยังต้องดูเวลาตัดรอบเองอยู่ดี เพราะไม่ใช่ทุกการเดิมพันจะได้รับโบนัสโดยอัตโนมัติ เคยติดปัญหาโบนัสไม่แสดง ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งวันเวลาและรายละเอียดไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "🔄",
  },
];

// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2):
// การ์ดเป็นผิวยก #0d2414 ในเส้นไรผมทองแบรนด์ #cc920a บนพื้นเพจเขียวเกือบดำ รอบนี้แบรนด์มี
// สองฮิวจริง — เขียวมรกตเข้มกับทอง — การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ ไม่ใช่ด้วย "ช่วงของ
// ทอง" แบบรอบ 789BETTING: เครื่องหมายคำพูดกับชื่อผู้รีวิวเป็นทองซีด #fde9a6 ที่ไต่ขึ้นเป็น
// ทองสว่าง #f7d14e ตอน hover ดาวที่ติดเป็นทองสว่างพร้อมเรืองแสง rgba(247,209,78,…) ส่วน
// ออรามุมการ์ดเป็นเขียวมรกต #0a6b32 ที่อิ่มขึ้นเป็นเขียวสว่าง #2fbf6a ตอน hover และขอบรูป
// โปรไฟล์เป็นทองแบรนด์โปร่งบนพื้นไล่ผิวกลาง #09190d → ผิวลึกสุด #020803
// ดาวที่ไม่ติดตกไปเป็นทองเข้ม #8a6204 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่เขียวสว่าง
// #2fbf6a → ทองซีด #fde9a6 → ทองสว่าง #f7d14e พร้อมคำว่า ผู้ใช้งานจริง เป็นไฮไลต์ทองสว่าง
// ข้อความรองใช้สีเนื้อความแบบลดความทึบ (#e8f2e6/70) เพราะพาเลตต์รอบนี้ไม่มีสีกลางหม่นของ
// ตัวเอง และการสร้างเทาขึ้นมาใหม่คือการเพิ่มสีนอกพาเลตต์ เนื้อความ #e8f2e6 (= BRAND_TEXT)
// — 14.7:1 บนผิวยก
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ 789BETTING/UOK365 ที่เคยค้างในไฟล์นี้ (#fad354 #ffe79a
// #ddab33 #8a6410 #c9881f #4a3407 #17130a #0e0b05 #060402 #b5a888 #f3e7cd #c8912f
// #f5d98a #6d4412 #d8dbe0 #191108 #120c07 #070504 #ece1cc #b7a58a rgba(250,211,84,…)
// rgba(200,145,47,…) rgba(245,217,138,…)) ออกครบทุกจุดแล้ว — ทองสองรอบก่อนเป็นคนละค่ากับ
// ทองของรอบนี้ ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว" ไม่ได้หมายความว่าเป็นทอง
// ของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#2fbf6a] via-[#fde9a6] to-[#f7d14e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(204,146,10,0.35)]">
      เสียงตอบรับจาก <span class="text-[#f7d14e]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#cc920a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#cc920a]/50 bg-[#0d2414]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fde9a6]/70 hover:shadow-[0_15px_40px_rgba(204,146,10,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#0a6b32]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#2fbf6a]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#043d1c] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fde9a6]/50 drop-shadow-[0_0_5px_rgba(253,233,166,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f7d14e] drop-shadow-[0_0_5px_rgba(247,209,78,0.8)]" : "text-[#8a6204]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#e8f2e6] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#cc920a]/40 bg-gradient-to-br from-[#09190d] to-[#020803] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fde9a6] transition-colors group-hover:text-[#f7d14e]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#e8f2e6]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
