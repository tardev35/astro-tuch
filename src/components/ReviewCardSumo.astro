---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what the UP555 brief supports: คาสิโนอัปเดตล่าสุด
// ที่ปรับปรุงทางเข้าเล่นเกมใหม่ให้รองรับมือถือได้สะดวกขึ้น, รวมเกมหลายประเภทไว้ใน
// บัญชีเดียว ทั้งสล็อต บาคาร่า บอล และหวยตามรายการที่ระบบเปิดให้บริการ, เลือกหมวดเกม
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านระบบเดียว, คืนยอดเสีย 0.3% และแนะนำ
// เพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด, สมัครผ่านมือถือ 3 ขั้นตอน,
// แอดมิน 24 ชั่วโมง และห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น พร้อมคำกำกับ
// ของบรีฟเองว่าไม่ควรใช้คำว่า "ปลอดภัยแน่นอน" เป็นการรับประกันโดยไม่มีข้อมูลที่
// ตรวจสอบได้รองรับ และผลการเดิมพันมีความไม่แน่นอน จึงรับประกันผลกำไรไม่ได้
//
// No licence claim, no bank name, no operator name, no game name, no provider
// name, no member count, no founding year, no RTP figure, no promised profit —
// the brief names none of them. The slot/เว็บตรงต่างประเทศ/ไม่ผ่านเอเย่นต์/
// เดิมพันไม่มีขั้นต่ำ copy earlier holders of this file carried for 1SS365 and
// NATO168 is gone, along with the lottery vocabulary from the round before those.
// The brand name is interpolated from BRAND_NAME, never typed — a hardcoded
// "1SS365" in review 3 was how the previous brand's name survived into this one.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลเพื่อเปิดบัญชีแล้ว Login เข้าสู่ระบบ จากนั้นเลือกหมวดเกมที่ต้องการพร้อมตรวจสอบรายละเอียดและโปรโมชั่นก่อนเริ่มใช้งาน ทางเข้าใหม่เปิดจากมือถือแล้วหาเมนูเจอง่ายกว่าเดิม เปิดจากคอมพิวเตอร์ก็ได้หน้าเดียวกัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บคาสิโน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่าปลอดภัยแน่นอนมากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าด้านความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน และข้อมูลผู้ดำเนินงาน จึงไม่ควรใช้คำนั้นเป็นการรับประกันโดยไม่มีข้อมูลรองรับ ซึ่งตรงกับที่เราแนะนำอยู่แล้วว่าให้ตรวจสอบประกาศจากช่องทางหลักของเว็บไซต์ และเลี่ยงลิงก์ที่ยืนยันแหล่งที่มาไม่ได้",
    avatar: "🛡️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `เลือกได้ทั้งสล็อต บาคาร่า บอล และหวยตามรายการที่ระบบเปิดให้บริการ จากบัญชีเดียว สลับประเภทเกมได้โดยไม่ต้องสมัครใหม่หลายครั้ง ตรวจเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียวจริง ส่วนคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ก่อนกดรับก็ยังต้องดูรอบตัดยอดและประเภทเกมที่ร่วมรายการเองอยู่ดี ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว`,
    avatar: "🔄",
  },
];

// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): การ์ดเป็นผิวการ์ดดำอมน้ำตาล
// #130b03 ในเส้นไรผมทองแบรนด์ #ebbb54 บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และ
// ชื่อผู้รีวิวไต่ขึ้นเป็นทองสว่าง #fce675 กับทองแบรนด์ ตามลูกศร วงรี และเลข 555 ที่เป็น
// ทองบนโลโก้ ส่วนออร่ามุมการ์ดกับขอบรูปโปรไฟล์เป็นเงินโครเมียม #d5d4d3 ตามตัว U และ UP
// ที่เป็นเงิน การ์ดจึงพาสองโลหะของโลโก้มาครบโดยไม่ต้องใช้สีนอกพาเลตต์ ดาวที่ไม่ติดตกไป
// เป็นทองลึก #ab6d24 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่เงิน → ทองสว่าง → ทองลึก พร้อม
// คำว่า ผู้ใช้งานจริง เป็นไฮไลต์เงิน ข้อความรองใช้ #d8c9a8 เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#edbb23 #ffeeb4 #a87708 #c8cbce #121010
// #050505 #2a2115 #cfc2a6 #f0e6d2) ออกครบทุกจุดแล้ว พร้อมกับ copy ของบรีฟรอบก่อน
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#d5d4d3] via-[#fce675] to-[#ab6d24] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(235,187,84,0.35)]">
      เสียงตอบรับจาก <span class="text-[#d5d4d3]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebbb54] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#ebbb54]/50 bg-[#130b03]/90 p-8 shadow-[0_10px_30px_rgba(12,5,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fce675]/70 hover:shadow-[0_15px_40px_rgba(235,187,84,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#d5d4d3]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#ebbb54]/28" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#241705] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fce675]/50 drop-shadow-[0_0_5px_rgba(252,230,117,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ebbb54] drop-shadow-[0_0_5px_rgba(235,187,84,0.8)]" : "text-[#ab6d24]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f8eed9] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#d5d4d3]/40 bg-gradient-to-br from-[#241705] to-[#0c0502] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fce675] transition-colors group-hover:text-[#ebbb54]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d8c9a8] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
