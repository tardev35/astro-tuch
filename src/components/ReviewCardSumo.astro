// ⚠️ แดงรอบนี้คือ #fb131b (R=251 G=19 B=27) **คนละค่า** กับ e8232a (SUPERSLOTCLUB)
// d4200d (PIGPG) ff3b14 (FLASH877) 6d0804 / 7a0505 (แดงลึกของแบรนด์เก่า) และ
// d20a0a / ff5c5c (หวย24) ที่ยังค้างในไฟล์ inventory อื่นๆ
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e9eef4] via-[#aeb9c6] to-[#e9eef4] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(251,19,27,0.45)]">
      เสียงตอบรับจาก <span class="text-[#ff4d55]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb131b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#fb131b]/55 bg-[#2a0d0f]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ff4d55]/75 hover:shadow-[0_15px_40px_rgba(251,19,27,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#fb131b]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#fb131b]/50" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#53050a] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ff4d55]/70 drop-shadow-[0_0_5px_rgba(251,19,27,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#e9eef4] drop-shadow-[0_0_5px_rgba(233,238,244,0.75)]" : "text-[#aeb9c6]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f2e4e5] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#53050a]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#fb131b]/50 bg-gradient-to-br from-[#1a0708] to-[#0d0304] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ff4d55] transition-colors group-hover:text-[#e9eef4]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#aeb9c6] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
