---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what CK268's brief supports: รวมเกมสล็อตจากหลาย
// ค่ายผ่านบัญชีเดียว, เกมยอดนิยม/สล็อตเปิดใหม่/ฟรีสปิน/ตัวคูณ/ฟีเจอร์โบนัส, อัปเดต
// รายการเกมใหม่ตลอดสัปดาห์ตามค่ายที่เปิดให้บริการ, เข้าเล่นผ่านมือถือ แท็บเล็ต
// คอมพิวเตอร์, บางเกมเริ่มเดิมพันในระดับ 1 บาทโดยช่วงเดิมพันจริงต้องดูในเกม,
// โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่มีรอบคำนวณของตัวเอง, สมัครเอง
// 3 ขั้นตอน, ตรวจชื่อบัญชีกับข้อมูลนิติบุคคลที่เว็บไซต์ประกาศก่อนโอน, แอดมิน
// 24 ชั่วโมง และห้ามบอกรหัสผ่าน PIN หรือ OTP กับใคร. No licence claim, no bank
// name, no game-studio name, no member count, no promised profit — and none of
// the lottery vocabulary the previous holder of this file was full of.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านระบบออนไลน์บนมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชี จากนั้นเลือกเกมสล็อต ค่ายเกม และโปรโมชั่นที่ต้องการได้เลย เปิดจากแท็บเล็ตกับคอมพิวเตอร์ก็ได้หน้าเดียวกัน ตรวจเครดิตและประวัติรายการจากบัญชีเดียว หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเกม",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องโปรโมชั่นมากที่สุด หน้านี้แยกไว้ชัดว่าโบนัส 0.3% คือคืนยอดเสียจากยอดที่เข้าเงื่อนไข ส่วน 0.8% คือกิจกรรมแนะนำเพื่อนจากยอดที่เข้าเกณฑ์ ตรวจจำนวนเพื่อนกับยอดคำนวณได้จากบัญชีตัวเอง แต่ละรายการกำหนดรอบคำนวณ ประเภทเกมสล็อต และระยะเวลารับสิทธิ์ไม่เหมือนกัน จึงต้องอ่านรายละเอียดล่าสุดก่อนกดรับทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "เล่นมาหลายสัปดาห์ เห็นรายการเกมใหม่ทยอยเพิ่มเข้ามาตามค่ายที่เปิดให้บริการจริง มีทั้งเกมวงล้อแบบคลาสสิก สล็อตโบนัส และเกมฟรีสปิน บางเกมเริ่มเดิมพันในระดับ 1 บาทได้ แต่ช่วงเดิมพันขั้นต่ำและสูงสุดต่างกันตามค่าย ต้องดูตัวเลขในเกมก่อนกดเริ่มทุกครั้ง ก่อนโอนรอบแรกลองเทียบชื่อบัญชีกับข้อมูลนิติบุคคลที่เว็บไซต์ประกาศไว้แล้วตรงกัน ถามแอดมินตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🎰",
  },
];

// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): การ์ดเป็นผิวดำอมเขียว #0b160b ในเส้น
// ไรผมเขียวนีออนแบรนด์ #8bfc13 บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อ
// ผู้รีวิวไต่ขึ้นเป็นโครเมียมขาว #e8f0e6 กับเขียวอ่อน #c9ff8f ตามสองโทนของโลโก้
// (ตัว C กับเลข 68 เป็นโลหะขาวเงิน ตัว K กับเลข 2 เป็นเขียวนีออน) ดาวที่ไม่ติดตกไป
// เป็นเขียวลึก #1a7a08 ที่ opacity ต่ำ ไม่ใช่เทา จึงไม่มีจุดใดในการ์ดหลุดออกจากคู่
// เขียว-โครเมียมของแบรนด์ หัวแถบไล่โครเมียมขาว → เขียวอ่อน → เขียวนีออน พร้อมคำว่า
// ผู้ใช้งานจริง เป็นไฮไลต์ #eaffd6 เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ
// LOTTOPLUS ที่ค้างในไฟล์นี้ (#dc020e #6b0207 #f3c623 #fde79a #8a6a0a #120b0c
// #050505 #fff4f4 #f0e2e2) ออกทั้งหมด พร้อมกับ copy ของแบรนด์ลอตเตอรีที่ไม่ใช่ของแบรนด์นี้
// ทองไม่ถูกใช้เลยสักจุด เพราะ GOT777 รอบก่อนเป็นทอง-แดงทั้งหน้า
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8f0e6] via-[#c9ff8f] to-[#8bfc13] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(139,252,19,0.25)]">
      เสียงตอบรับจาก <span class="text-[#eaffd6]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#8bfc13] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#8bfc13]/50 bg-[#0b160b]/90 p-8 shadow-[0_10px_30px_rgba(1,4,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#c9ff8f]/70 hover:shadow-[0_15px_40px_rgba(139,252,19,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#1a7a08]/28 blur-[50px] transition-all duration-500 group-hover:bg-[#8bfc13]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#8bfc13]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#e8f0e6]/50 drop-shadow-[0_0_5px_rgba(232,240,230,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#c9ff8f] drop-shadow-[0_0_5px_rgba(201,255,143,0.8)]" : "text-[#1a7a08]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#d5e6cd]/90 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e8f0e6]/30 bg-gradient-to-br from-[#1a7a08] to-[#030703] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#e8f0e6] transition-colors group-hover:text-[#c9ff8f]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d5e6cd]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
