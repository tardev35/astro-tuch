---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บเดิมพัน",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ทดสอบการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์แล้ว หน้าเลือกเกมกับหน้าฝากถอนโหลดไว เมนูจัดกลุ่มตามหมวดเกมชัดเจน ตรวจกติกากับอัตราจ่ายของแต่ละเกมได้ก่อนกดเดิมพัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเดิมพัน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "จุดที่สมาชิกในเพจพูดถึงบ่อยคือรวมเกมหลายหมวดไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย ไม่ต้องสลับหลายบัญชี ส่วนโปรโมชั่นแนะนำเพื่อนกับคืนยอดเสียมีเงื่อนไขเขียนไว้ให้อ่านก่อนกดรับ",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "เลือกเล่นได้หลายหมวดจากบัญชีเดียว เช็กรอบรับโบนัส 0.8% กับคืนยอดเสีย 0.3% ได้จากหน้าโปรโมชั่นเอง ตอนติดปัญหาโปรไม่แสดง แจ้งเวลาและรายละเอียดรายการไปแล้วแอดมิน UFA168 ตรวจให้ในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "👑",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ UFA168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(243,219,91,0.2)]">
      เสียงตอบรับจาก <span class="text-[#d8dce2]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f3db5b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#6b5316]/50 bg-[#0d0a05]/90 p-8 shadow-[0_10px_30px_rgba(5,4,3,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#d4af37]/70 hover:shadow-[0_15px_40px_rgba(212,175,55,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#a37c14]/14 blur-[50px] transition-all duration-500 group-hover:bg-[#f3db5b]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#6b5316]/60 pb-4">
              <span class="font-serif text-4xl leading-none text-[#d4af37]/50 drop-shadow-[0_0_5px_rgba(212,175,55,0.5)]">"</span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f3db5b] drop-shadow-[0_0_5px_rgba(243,219,91,0.8)]" : "text-[#8b929c]/50"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="min-h-[100px] text-left text-sm leading-relaxed text-[#e6dcc2]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f3db5b]/30 bg-gradient-to-br from-[#d4af37] to-[#050403] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fff3bf] transition-colors group-hover:text-[#f3db5b]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#8b929c] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
