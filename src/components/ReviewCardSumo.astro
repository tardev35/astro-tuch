// 6b4708 2a0617 fdeaf5) — ออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้คือ #f0bb4e **คนละค่า** กับ fcd45c (มีเฮ168 รอบก่อน G212 vs G187)
// f9a826 (รวยแทร่168) fef54b (นินจา168) ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168)
// fcd434 (มีโชค168) f7c92b (ขวัญใจ168) e3b23c (สมหวัง168) dfa310 e5a81b e2b33f
// f2b705 ffd666 หรือ fad354 ⚠️ **และ R ของมันตรงกับ f0b429 ของรับตัง168 เป๊ะ
// ตัวตัดสินคือ B78 vs B41**
// ⚠️ แดงรอบนี้คือ #e4021b ไม่ใช่ fb1b32 ff8f9c 5c0410 (มีเฮ168) fa0513 (สมหวัง168)
// d30304 (รับตัง168) b3121b (ขวัญใจ168) fb131b (TKB55) หรือ e8232a (SUPERSLOTCLUB)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** ส้มตัวเดียวที่อนุญาตคือ
// ทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#d9701a] via-[#f0bb4e] to-[#d9701a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(240,187,78,0.45)]">
      เสียงตอบรับจาก <span class="text-[#ffeccb]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e4021b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#f0bb4e]/55 bg-[#3b1b0e]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#e4021b]/80 hover:shadow-[0_15px_40px_rgba(240,187,78,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#f0bb4e]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#f0bb4e]/40" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#5c2a06] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffeccb]/70 drop-shadow-[0_0_5px_rgba(240,187,78,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f0bb4e] drop-shadow-[0_0_5px_rgba(240,187,78,0.75)]" : "text-[#ffeccb]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#fff8ec] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#5c2a06] pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#5c2a06] bg-gradient-to-br from-[#260d04] to-[#0d0501] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f0bb4e] transition-colors group-hover:text-[#ffeccb]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#ffeccb] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
