---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บหวย",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ทดสอบส่งโพยผ่านมือถือแล้วหมวดหวยแยกชัดเจน ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย VIP และหวยหุ้นต่างประเทศ เลือกรอบ กรอกเลข 2 ตัวหรือ 3 ตัว แล้วเห็นอัตราจ่ายก่อนกดยืนยัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บหวย",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามถึงเรทมากที่สุด หน้านี้กำหนดไว้ที่เลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 คำนวณยอดตามเรทได้ตั้งแต่ก่อนเดิมพัน ส่วนเวลาเปิด-ปิดของแต่ละตลาดต่างกันจริง ต้องดูหน้าส่งโพยของรอบนั้นอีกครั้ง",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ชอบที่แทงหวยได้หลายประเภทจากบัญชีเดียว ฝากเครดิตผ่านธนาคารและวอลเลท แล้วตรวจยอด ส่งคำขอถอน และติดตามสถานะเองได้ ตอนรายการถอนค้าง แจ้งเวลาและจำนวนเงินไป เจ้าหน้าที่ กินดี365 ตรวจให้ในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "🧾",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ กินดี365" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(233,197,93,0.2)]">
      เสียงตอบรับจาก <span class="text-[#5ec2f5]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9c55d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#1c47a8]/70 bg-[#031234]/90 p-8 shadow-[0_10px_30px_rgba(0,4,18,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#e9c55d]/70 hover:shadow-[0_15px_40px_rgba(233,197,93,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#5ec2f5]/16 blur-[50px] transition-all duration-500 group-hover:bg-[#e9c55d]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#1c47a8]/70 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#e9c55d]/50 drop-shadow-[0_0_5px_rgba(233,197,93,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#e9c55d] drop-shadow-[0_0_5px_rgba(233,197,93,0.8)]" : "text-[#a9c4e8]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="min-h-[100px] text-left text-sm leading-relaxed text-[#dbe4f5]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e9c55d]/30 bg-gradient-to-br from-[#1c47a8] to-[#00081f] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fbeeb8] transition-colors group-hover:text-[#e9c55d]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#a9c4e8] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
