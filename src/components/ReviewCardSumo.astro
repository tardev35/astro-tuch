---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what หวยเต็ง's brief supports: รวมรายการหวยยอดนิยม
// ไว้ให้เลือกผ่านบัญชีเดียว, หวยรัฐบาลไทย/ลาวพัฒนา/ฮานอยปกติ/ฮานอยพิเศษ/ฮานอยวีไอพี/
// หวยหุ้นต่างประเทศ, เลือกเลข ส่งโพย ตรวจสอบรายการ อัตราจ่าย และผลหวยจากระบบเดียว,
// อัตรา 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท เฉพาะรายการที่ร่วมเงื่อนไขและ
// ต้องดูที่หน้าส่งโพยก่อนยืนยัน, หวยแต่ละประเภทมีตารางเวลาและเวลาปิดรับต่างกัน,
// สมัครผ่านมือถือ 3 ขั้นตอน, แอดมิน 24 ชั่วโมง และห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP
// ให้บุคคลอื่น. No licence claim, no bank name, no operator name, no member count,
// no promised profit — and none of the football or slot vocabulary the previous two
// holders of this file were full of (บอล ค่าน้ำ อัตราต่อรอง ลีก บิล สล็อต ฟรีสปิน).
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชีสมาชิก จากนั้นเลือกรายการหวย เลขที่ต้องการ และตรวจอัตราจ่ายก่อนส่งโพยได้เลย เปิดจากแท็บเล็ตกับคอมพิวเตอร์ก็ได้หน้าเดียวกัน ตรวจโพย ประวัติรายการ และผลหวยจากบัญชีเดียว หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บหวย",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องอัตราจ่ายมากที่สุด หน้านี้แยกไว้ชัดว่ามีตัวเลือก 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่ร่วมเงื่อนไข ไม่ใช่ทุกประเภทโดยอัตโนมัติ เพราะรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นอาจมีอัตราหรือเงื่อนไขต่างกัน เขาเขียนไว้ตรงๆ ว่าให้ยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลัก ซึ่งตรงกับที่เราแนะนำสมาชิกอยู่แล้ว",
    avatar: "🎟️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ตามหวยหลายประเภทในวันเดียวได้จากบัญชีเดียว ทั้งรัฐบาลไทยตามกำหนดออกรางวัล ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศตามตลาดที่ระบบเปิดรับ แต่ละประเภทมีตารางเวลาไม่เหมือนกัน ก่อนส่งโพยจึงต้องดูชื่อรายการ เลขที่เลือก ยอดเดิมพัน และเวลาปิดรับของรอบนั้นทุกครั้ง พอประกาศผลก็กลับมาตรวจโพยกับผลรางวัลได้ ถามแอดมินตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🔢",
  },
];

// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): การ์ดเป็นผิวเขียวเข้ม #062a12 ในเส้นไรผมทอง
// แบรนด์ #e5c04f บนพื้นเพจเขียวเกือบดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อผู้รีวิว
// ไต่ขึ้นเป็นขาวอมเขียว #eafbe9 กับทองอ่อน #fae474 ตามสองโทนของโลโก้ (คำว่า "หวย"
// เป็นเขียวมรกต คำว่า "เต็ง" เป็นทอง) ดาวที่ไม่ติดตกไปเป็นเขียวแบรนด์ #026314 ที่
// opacity ต่ำ ไม่ใช่เทา จึงไม่มีจุดใดในการ์ดหลุดออกจากคู่เขียว-ทองของแบรนด์ หัวแถบ
// ไล่ขาวอมเขียว → เขียวเงิน #a9cfae → เขียวมรกตสว่าง #0bb42f พร้อมคำว่า ผู้ใช้งานจริง
// เป็นไฮไลต์ทองอ่อน เนื้อความ #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268
// ที่ค้างในไฟล์นี้ (#8bfc13 #c9ff8f #1a7a08 #eaffd6 #e8f0e6 #0b160b #030703 #d5e6cd)
// ออกทั้งหมด พร้อมกับ copy ของแบรนด์สล็อตที่ไม่ใช่ของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eafbe9] via-[#a9cfae] to-[#0bb42f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(2,99,20,0.35)]">
      เสียงตอบรับจาก <span class="text-[#fae474]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e5c04f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#e5c04f]/50 bg-[#062a12]/90 p-8 shadow-[0_10px_30px_rgba(1,10,4,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fae474]/70 hover:shadow-[0_15px_40px_rgba(229,192,79,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#026314]/28 blur-[50px] transition-all duration-500 group-hover:bg-[#e5c04f]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#e5c04f]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#eafbe9]/50 drop-shadow-[0_0_5px_rgba(234,251,233,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#fae474] drop-shadow-[0_0_5px_rgba(250,228,116,0.8)]" : "text-[#026314]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#d8ead9]/90 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#eafbe9]/30 bg-gradient-to-br from-[#026314] to-[#010a04] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#eafbe9] transition-colors group-hover:text-[#fae474]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d8ead9]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
