---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของแบรนด์ก่อน
// (**ศูนย์บริการหลัก / ศูนย์รวมช่องทางบริการ / ช่องทางรับบริการ / ลิขสิทธิ์เว็บ
// แท้100%**) ซึ่ง brand-spec §6 ของรอบนี้ห้ามทุกคำในชุดนั้น — ไม่เหลือแม้คำเดียว
//
// บรีฟรอบนี้ครอบคลุมแค่: **ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์** รวม
// **ค่ายเกมมาตรฐานสากล PG SOFT / JOKER / JILI 3 ค่ายหลัก**; โปรโมชั่นสองรายการ
// (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และ แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด); ขั้นตอน
// สมัครสมาชิกสามขั้น; และช่องทาง LINE Official — ไม่มีอะไรนอกนี้ ไม่มีหมวดเกมอื่น
// ไม่มีค่ายเกมอื่น และ **ไม่มีคำเกี่ยวกับคาสิโน กีฬา หรือหวยที่ไหนเลย**
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: ข้อมูลเกี่ยวกับลิขสิทธิ์และแหล่ง
// ที่มาของระบบควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง · ข้อมูลการเชื่อมต่อระบบจาก
// สิงคโปร์และสถานะลิขสิทธิ์ควรตรวจสอบกับผู้ให้บริการโดยตรง · ก่อนเข้าร่วมควรตรวจสอบ
// ระยะเวลาของแคมเปญ เงื่อนไขยอดเดิมพัน และวิธีรับเครดิต · เครดิตคืนยอดเสียไม่ได้
// รับประกันผลตอบแทนจากการเล่นครั้งต่อไป · แม้โปรโมชั่นจะระบุว่าไม่จำกัด แต่ควร
// ตรวจสอบข้อกำหนดเกี่ยวกับจำนวนบัญชี ยอดที่นำมาคำนวณ และระยะเวลารับสิทธิ์ · ควร
// ตรวจสอบลิงก์หรือ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชี
// แอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล ชื่อธนาคาร ค่า RTP ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือค่ายเกมอื่นนอกจากสามค่ายของบรีฟ — บรีฟไม่ได้
// ระบุไว้สักข้อ ตัวเลขที่อ้างมีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 3 ค่าย
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้ที่ศึกษาข้อมูลก่อนเริ่มใช้งาน",
    role: "ไล่อ่านกติกาและตารางการจ่ายรางวัลก่อนเลือกเกม",
    stars: 4,
    content: `เปิดหน้าเว็บ ${BRAND_NAME} มาเพราะอยากรู้ว่ามีเกมสล็อตจากค่ายไหนให้เลือกบ้าง ตัวหน้าเขียนไว้ตรงๆ ว่ารวม 3 ค่ายหลัก คือ PG SOFT ที่โดดเด่นด้านภาพและรูปแบบการเล่นบนมือถือ JOKER ที่มีเกมสล็อตหลากหลายแนว และ JILI ที่เน้นเกมดีไซน์ทันสมัยพร้อมฟีเจอร์แตกต่างกันในแต่ละเกม ผมเลยไล่อ่านกติกากับตารางการจ่ายรางวัลของแต่ละเกมก่อนเลือกว่าจะเริ่มที่ค่ายไหน ซึ่งตรงกับที่หน้าเว็บแนะนำให้ศึกษาคุณสมบัติของเกมก่อนเข้าใช้งาน หัก 1 ดาวตรงที่เรื่องลิขสิทธิ์และแหล่งที่มาของระบบ หน้าเว็บบอกเองว่าควรตรวจสอบจากหลักฐานของผู้ให้บริการโดยตรง ถ้ารวมจุดที่ให้ตรวจสอบไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้`,
    avatar: "🔎",
  },
  {
    name: "ผู้อ่านเงื่อนไขก่อนรับสิทธิ์",
    role: "ไล่ดูรอบการคำนวณกับวิธีรับเครดิต",
    stars: 4,
    content:
      "เรื่องที่ถูกถามมากที่สุดคือโปรโมชั่น หน้านี้ระบุรายการหลักไว้สองอย่าง คือคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แล้วเขียนกำกับเองว่าแต่ละรายการมีวิธีคำนวณและข้อกำหนดแตกต่างกัน ก่อนเข้าร่วมจึงควรตรวจสอบระยะเวลาของแคมเปญ เงื่อนไขยอดเดิมพัน และวิธีรับเครดิตให้ชัดเจน ผมถามเจ้าหน้าที่ก่อนว่าเกมประเภทใดเข้าร่วมรายการ ใช้ยอดเสียช่วงเวลาใดในการคำนวณ และเครดิตจะเข้าบัญชีอัตโนมัติหรือต้องกดรับเอง อีกข้อที่ชอบคือหน้าเว็บบอกเองว่าเครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเล่นครั้งต่อไป ส่วนที่ยังอยากให้เพิ่มคือคำว่าไม่จำกัดในรายการแนะนำเพื่อน ควรระบุให้ชัดว่าหมายถึงจำนวนบัญชี ยอดที่นำมาคำนวณ หรือระยะเวลารับสิทธิ์ เพราะตอนนี้ต้องไปถามเจ้าหน้าที่อีกที",
    avatar: "🧮",
  },
  {
    name: "สมาชิกที่สมัครผ่าน 3 ขั้นตอน",
    role: "ตรวจที่อยู่เว็บไซต์ทางการก่อนกรอกข้อมูลทุกครั้ง",
    stars: 5,
    content: `สมัครตามที่หน้าเว็บเขียนไว้ 3 ขั้นตอนพอดี เริ่มจากตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องแล้วเลือกเมนูสมัครสมาชิก อ่านเงื่อนไขการเปิดบัญชีกับข้อมูลเกี่ยวกับการจัดเก็บและใช้ข้อมูลส่วนบุคคลก่อน จากนั้นกรอกข้อมูลตามที่ระบบกำหนด ตรวจความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย โดยไม่ใช้ข้อมูลของผู้อื่นและไม่เปิดเผยรหัสยืนยันให้บุคคลภายนอก พอลงทะเบียนเรียบร้อยก็เข้าสู่ระบบไปไล่อ่านรายละเอียดเกมจาก PG SOFT, JOKER และ JILI รวมถึงกติกาและเงื่อนไขของโปรโมชั่นต่าง ๆ ก่อนดำเนินการ ตอนจะทัก LINE Official ของ ${BRAND_NAME} ผมเช็กลิงก์กับ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อเลี่ยงบัญชีแอบอ้าง เวลาแจ้งปัญหาก็ส่งรายละเอียดพร้อมหลักฐานที่เกี่ยวข้องให้เจ้าหน้าที่ตรวจสอบ ไม่เคยถูกถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง ให้ไปเลย 5 ดาว`,
    avatar: "📝",
  },
];

// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2-§3): การ์ดรีวิวที่ใช้งานจริงรอบนี้ — รอบก่อน (ขวัญใจ168)
// ใช้ ReviewCardSumo2 จึงหมุนมาที่ไฟล์นี้ การ์ดเป็นผิวยก #24101c ในกรอบชมพูบานเย็น
// #f5469f โปร่ง บนพื้นเพจ **ดำสนิท #000000** (bg.json) จึงลอยขึ้นมาชัดเจน
// ⚠️ ลำดับความลึกรอบนี้: #24101c ยก / #160a12 กลาง / #0b0509 จม / #000000 พื้น
// แบรนด์มีสองฮิวจริงตามโลโก้ — **ทองนำ** (เลข 168 สามมิติ เหรียญจีนทองรูสี่เหลี่ยม
// ทองแท่งจีน มงกุฎทอง) และ **ชมพูบานเย็นรอง** (ริบบิ้นซาติน หัวใจชมพู ดอกซากุระ และ
// ครึ่งล่างของตัวอักษร "มีโชค") การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ: เครื่องหมายคำพูด
// เป็นชมพูอ่อน #ff8dc6 ชื่อผู้รีวิวเป็นทองแบรนด์ #fcd434 ที่เปลี่ยนเป็นชมพูอ่อนตอน
// hover ดาวที่ติดเป็น **ทองแบรนด์ #fcd434** พร้อมเรืองแสง rgba(252,212,52,α) ส่วน
// ออรามุมการ์ดเป็นชมพูบานเย็นที่อิ่มขึ้นตอน hover และขอบรูปโปรไฟล์เป็นทองลึก #7a5508
// บนพื้นไล่ผิวกลาง #160a12 → ผิวจม #0b0509
// ⚠️ **ดาวเป็นทอง ไม่ใช่เงินโครเมียม** — §2 ระบุว่ารอบนี้ไม่มีโครเมียม/เงินเป็นสีระบบ
// และฮิวนำคือทอง ดาวที่ไม่ติดตกไปเป็นชมพูอ่อน #ff8dc6 ที่ opacity ต่ำ — และกลีฟ ★
// นับเป็นตัวอักษร จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร (#fcd434 12.4:1 /
// #ff8dc6 9.9:1) ไม่ใช่ #8c0f52 หรือ #7a5508
// หัวแถบไล่ทองแบรนด์ #fcd434 → ชมพูอ่อน #ff8dc6 → ทองแบรนด์ #fcd434 พร้อมคำว่า
// ผู้ใช้งานจริง เป็นชมพูบานเย็น #f5469f — ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซล
// ของตัวอักษร** ไม่ใช่พื้นหลัง ทุกค่าในไล่เฉดจึงต้องถือตัวอักษรได้ หัวแถบนี้เป็น <p>
// ไม่ใช่หัวข้อ ข้อความรองใช้ชมพูอ่อน #ff8dc6 ซึ่ง §2 กำหนดเป็นสีรองไว้แล้ว
// เส้นคั่นในการ์ดเป็นพลัมเข้ม #8c0f52 ซึ่ง §2 ห้ามถือตัวอักษรทุกขนาด
// เนื้อความ #f6e4ee (= BRAND_TEXT) — 14.9:1 บนผิวยก
// #ffeaa0 สงวนไว้ให้ <strong> ในย่อหน้าของหน้าเพจ จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของรอบนี้คือทอง และเกือบทุกแบรนด์
// ที่ผ่าน repo นี้มีทอง** "มีทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ไฟล์นี้เพิ่งถือชุด
// ทองไทย-แดงมังกรของรับตัง168 มาทั้งไฟล์ (f0b429 / ffdc8c / d30304 / ff6b6e / a00203
// / 4a0202 / 9a6c0c / cfd9e6 / f5ece0 / 2b100f / 200a09 / 140505 / 1a0505) ก่อนนั้น
// เป็นชุดแดงเลือดนก-เงินโครเมียมของ TKB55 (fb131b / ff4d55 / ff8a8f / e9eef4 /
// aeb9c6 / f2e4e5 / 2a0d0f / 1a0708 / 0d0304 / 53050a) ชุดม่วงราชา-ทองของ KMD88
// (7505cc / b453ff / c07cff / d9b8ff / bba8d4 / e2b33f / ece2f8 / 1d0832 / 140522 /
// 2c0349 / 0a0213) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 / ff5ca8 / fce343 /
// ffd94a / f0c3dc / fde7f2 / 8a0a45 / 4a1038 / 1c0014) ชุดทองแชมเปี้ยน-เงินของ UFA324
// (e5a81b / b9c2cc / 231c0e / f0e8d4) ชุดทองอำพันเสือของ TIGERWIN369 (d98324 /
// f7b733 / ffd98a / f7e4c0 / e3cfae) และชุดแดงเสือโคร่ง-ทองของ SUPERSLOTCLUB
// (e8232a / f2b705 / ffd666 / fbe8d5) — ออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้คือ #fcd434 / ชมพูคือ #f5469f + #ff8dc6 **คนละค่า** กับ f7c92b +
// f2bba5 (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) f41571 + ff5ca8
// (PUNPRO168 ซึ่งเป็นชมพูฮอตพิงก์เหมือนกันแต่คนละเลข) dfa310 e5a81b e2b33f f2b705
// ffd666 หรือ fad354
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดง**
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fcd434] via-[#ff8dc6] to-[#fcd434] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(252,212,52,0.45)]">
      เสียงตอบรับจาก <span class="text-[#f5469f]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5469f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#f5469f]/55 bg-[#24101c]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fcd434]/75 hover:shadow-[0_15px_40px_rgba(245,70,159,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#f5469f]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#f5469f]/35" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#8c0f52] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ff8dc6]/70 drop-shadow-[0_0_5px_rgba(245,70,159,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#fcd434] drop-shadow-[0_0_5px_rgba(252,212,52,0.75)]" : "text-[#ff8dc6]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f6e4ee] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#8c0f52]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#7a5508] bg-gradient-to-br from-[#160a12] to-[#0b0509] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fcd434] transition-colors group-hover:text-[#ff8dc6]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#ff8dc6] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
