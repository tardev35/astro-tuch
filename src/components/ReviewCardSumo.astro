---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
// ตรวจแล้วรอบนี้: ไม่มี <h1>-<h3> hardcode ในไฟล์นี้ · <section> มี aria-label ·
// รูปเดียวในไฟล์นี้คืออีโมจิอวาตาร์ซึ่งเป็น **ของตกแต่งล้วน** จึงอยู่ในกล่อง
// aria-hidden="true" ของตัวเอง ไม่ใช่ <img> ที่ต้องมี alt
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของ **รวยเทพ168**
// (เว็บสล็อต) และก่อนหน้านั้นเป็นคำของ **ufalion168** (เว็บบอล) ซึ่งพูดถึง
// **แฟนเพจเว็บบอลยูฟ่า / แทงบอล / ทริคแทงบอล / ค่าน้ำ / ราคาบอล / ราคาต่อรอง /
// สถิติการพบกัน / ความพร้อมของนักเตะ / โปรแกรมแข่งขัน / ผลการแข่งขัน / ลีก / แมตช์**
// — brand-spec §6 ของรอบนี้ไม่มีคำเหล่านั้นสักคำในบรีฟ จึงออกทั้งหมด
// (คำว่า **ฟุตบอล/บอล เฉยๆ ยังใช้ได้** เพราะบรีฟรอบนี้ระบุเอง แต่คำแวดล้อมข้างบนไม่ได้)
// **บรีฟรอบนี้ไม่ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** และ **ไม่เอ่ยคำว่า "ค่ายเกม" ด้วย**
// จึงไม่มีทั้งสองอย่างในไฟล์นี้
//
// บรีฟรอบนี้ครอบคลุมแค่: **เว็บสอนเล่นเกมเดิมพันออนไลน์หลายประเภท** (สล็อต บาคาร่า
// ยิงปลา ไฮโล ฟุตบอล และหวยออนไลน์) พร้อมคำอธิบายกติกา สัญลักษณ์ ตารางจ่ายรางวัล
// ความน่าจะเป็น ประเภทการเดิมพัน อัตราจ่าย และแนวทางศึกษาความเสี่ยง; โปรโมชั่น
// สองรายการ (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และ แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด);
// ขั้นตอนสมัครเรียนที่บรีฟเขียนไว้เป็น ขั้นตอนที่ 1 ถึง 3; และช่องทางติดต่อแอดมิน
// 24ชม. — ไม่มีอะไรนอกนี้ และ **ไม่มีคำว่า เว็บตรง ไม่ผ่านเอเย่นต์ คาสิโนสด
// หรือ รูเล็ต ที่ไหนเลย**
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: คำกล่าวอ้างเกี่ยวกับผู้สอนระดับ
// มือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้ · เทคนิคต่าง ๆ ควรใช้
// เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ · ผลการเดิมพันมีความไม่แน่นอนและอาจ
// ทำให้สูญเสียเงินได้ · การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน
// · ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล ชื่อธนาคาร ค่า RTP ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือชื่อค่ายเกมใดๆ — บรีฟไม่ได้ระบุไว้สักข้อ
// ตัวเลขที่อ้างมีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้เริ่มต้นที่อ่านกติกาก่อนลงมือ",
    role: "ไล่อ่านสัญลักษณ์ ตารางจ่ายรางวัล และความน่าจะเป็น",
    stars: 4,
    content: `เปิดหน้าเว็บ ${BRAND_NAME} มาเพราะอยากรู้ว่าเนื้อหาสอนเล่นครอบคลุมเกมแบบไหนบ้าง สิ่งที่ถูกใจคือมีตั้งแต่เกมสล็อต บาคาร่า ยิงปลา ไฮโล ไปจนถึงฟุตบอลและหวยออนไลน์ รวมคำอธิบายกติกา รูปแบบการเดิมพัน และแนวทางศึกษาความเสี่ยงของแต่ละเกมไว้ในที่เดียว ผมเลยเริ่มจากฝั่งสล็อตที่เน้นทำความเข้าใจสัญลักษณ์กับตารางจ่ายรางวัลก่อน แล้วค่อยขยับไปบาคาร่าที่อธิบายกติกาและความน่าจะเป็น หัก 1 ดาวตรงที่ต้องกดเข้าไปอ่านหลายจุดกว่าจะครบ ถ้ารวมหัวข้อที่ควรอ่านก่อนไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้ อีกเรื่องที่หน้าเว็บเขียนกำกับเองและผมว่าควรอ่านให้ครบคือเทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ เพราะผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้`,
    avatar: "📘",
  },
  {
    name: "สมาชิกที่เทียบเงื่อนไขโปรโมชั่นก่อนเข้าร่วม",
    role: "ตรวจรอบคำนวณยอดและรอบจ่ายเครดิต",
    stars: 4,
    content:
      "เข้ามาดูรายการโปรโมชั่นเป็นหลัก มีสองรายการที่ระบุไว้คือคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ก่อนกดเข้าร่วมผมไล่เช็กว่าเกมประเภทไหนร่วมรายการบ้าง ยอดที่ใช้คำนวณเครดิตนับอย่างไร มีรอบคำนวณยอดเมื่อใด และต้องกดรับเครดิตด้วยตนเองหรือไม่ ฝั่งแนะนำเพื่อนก็ต้องดูวิธีรับลิงก์แนะนำกับขั้นตอนเชื่อมโยงบัญชีให้ครบ ข้อที่ชอบคือหน้าเว็บเขียนกำกับไว้เองว่าการคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือช่วยลดความเสี่ยงทั้งหมด และแม้โปรโมชั่นแนะนำเพื่อนจะระบุว่าไม่จำกัด ก็ยังควรยืนยันข้อกำหนดเรื่องจำนวนบัญชีที่เข้าร่วมและรอบจ่ายเครดิตจากประกาศล่าสุดอยู่ดี ส่วนที่ยังอยากให้เพิ่มคือสรุปเงื่อนไขของทั้งสองรายการไว้เทียบกันในที่เดียว เพราะตอนนี้ต้องเปิดอ่านทีละประกาศ",
    avatar: "🎁",
  },
  {
    name: "ผู้ที่สมัครเรียนตามขั้นตอนที่ 1 ถึง 3",
    role: "ตรวจช่องทางทางการก่อนติดต่อเจ้าหน้าที่",
    stars: 5,
    content: `สมัครตามที่หน้าเว็บเขียนไว้พอดี เริ่มจากเข้าเว็บไซต์ทางการแล้วค้นหาข้อมูลเกี่ยวกับเนื้อหาการสอน รูปแบบบทเรียน และรายละเอียดผู้จัดทำเนื้อหาก่อนเลือกหัวข้อที่สนใจ จากนั้นอ่านข้อกำหนดเรื่องการสมัคร การใช้ข้อมูลส่วนบุคคล และค่าใช้จ่ายที่อาจเกี่ยวข้อง ตอนลงทะเบียนก็กรอกข้อมูลที่ถูกต้องและไม่เปิดเผยรหัสผ่านให้บุคคลอื่น พอเรียบร้อยก็เริ่มจากกติกาพื้นฐาน ความน่าจะเป็น และข้อจำกัดของแต่ละเกม ทั้งสล็อต บาคาร่า ยิงปลา ไฮโล บอล และหวย ตอนจะสอบถามรายละเอียดหลักสูตร ผมเช็กช่องทางติดต่อจากเว็บไซต์ทางการของ ${BRAND_NAME} ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง แล้วขอข้อมูลเรื่องหัวข้อเรียน ผู้สอน และเงื่อนไขค่าใช้จ่ายให้ชัดเจนก่อนตัดสินใจ เจ้าหน้าที่ไม่เคยถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง ที่สำคัญคือไม่ควรเชื่อคำโฆษณาที่รับประกันผลกำไรจากการเดิมพัน ให้ไปเลย 5 ดาว`,
    avatar: "📝",
  },
];

// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
