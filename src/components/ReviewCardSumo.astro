---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for UP555 and
// talked about บาคาร่า, บอล and หวย "ตามรายการที่ระบบเปิดให้บริการ" — brand-spec
// §4 bans every lottery word on this brand and the brief names no casino/sport
// category at all: it is a สล็อตเบทต่ำ brief end to end. It also inherited UP555's
// "ปลอดภัยแน่นอน" discussion, which is that brand's hedging sentence, not this
// one's.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt):
// สุดยอดเกมสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว, เกมคลาสสิก ฟรีสปิน โบนัส
// ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ, เข้าเล่นผ่านมือถือได้สะดวกพร้อมเลือกเกม
// ตามช่วงเดิมพันที่ต้องการ, ตรวจสอบตารางจ่ายและรายละเอียดของแต่ละเกมก่อนเริ่ม,
// ใช้บัญชีเดียวดูเครดิต โปรโมชั่น และประวัติรายการ, คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
// คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด, สมัครผ่านมือถือ 3 ขั้นตอน, แอดมิน 24 ชั่วโมง,
// และห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น — พร้อมคำกำกับของบรีฟเองว่า
// "ไม่มีขั้นต่ำ" ควรอ้างอิงจากเกมที่เปิดให้บริการจริง, "โบนัสสูง ให้เยอะกว่าใคร" ควรมี
// ข้อมูลเปรียบเทียบรองรับ, "เล่นสล็อตไม่จำกัดยอด" ควรอ้างอิงวงเงินของแต่ละเกม และ
// ค่ายตรง/ถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการที่ตรวจสอบได้
//
// No licence claim, no bank name, no operator name, no game name, no provider
// name, no member count, no founding year, no RTP figure, no promised profit —
// the brief names none of them. The only figures used are the brief's own:
// 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง.
// The brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ต่อด้วยตรวจสอบข้อมูลและยืนยันบัญชีสมาชิก จากนั้น Login แล้วเลือกค่ายและเกมสล็อตที่ต้องการ ก่อนยืนยันยอดยังกดดูช่วงเดิมพันของเกมนั้นได้ก่อนทุกรอบ เปิดจากมือถือหาเมนูเจอง่าย เปิดจากคอมพิวเตอร์ก็ได้หน้าเดียวกัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่าไม่มีขั้นต่ำมากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าควรอ้างอิงจากเกมที่เปิดให้บริการจริง เพราะเกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน บางเกมเริ่มด้วยยอดต่ำมาก บางเกมใช้ขั้นต่ำสูงกว่า ตรงกับที่เราแนะนำอยู่แล้วว่าให้ยึดตัวเลขที่แสดงภายในเกมและกำหนดงบก่อนเล่นทุกครั้ง ส่วนที่ระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ก็ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่ตรวจสอบได้ประกอบ",
    avatar: "🛡️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `เล่นสายเบทต่ำ ทุนน้อย เลยชอบที่เลือกเกมจากช่วงเดิมพันได้ก่อน มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ ดูตารางจ่ายของแต่ละเกมได้ก่อนเริ่ม ใช้บัญชีเดียวค้นหาเกม ดูเครดิต โปรโมชั่น และประวัติรายการได้จริง ส่วนคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ก่อนกดรับก็ยังต้องดูค่ายเกมและรอบตัดยอดเองอยู่ดี ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว`,
    avatar: "🔄",
  },
];

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// การ์ดเป็นผิวยก #191108 ในเส้นไรผมทองแบรนด์ #c8912f บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด
// ดาวที่ติด และชื่อผู้รีวิวไต่ขึ้นเป็นทองอ่อน #f5d98a กับทองแบรนด์ ตามวงแหวนและตัวอักษร
// UOK ที่เป็นทองบนโลโก้ ส่วนออร่ามุมการ์ดกับขอบรูปโปรไฟล์เป็นเงินโครเมียม #d8dbe0 ตาม
// ตัวเลข 365 ที่เป็นเงิน การ์ดจึงพาสองโลหะของโลโก้มาครบโดยไม่ต้องใช้สีนอกพาเลตต์
// ดาวที่ไม่ติดตกไปเป็นทองลึก #6d4412 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่เงิน → ทองอ่อน
// → ทองแบรนด์ พร้อมคำว่า ผู้ใช้งานจริง เป็นไฮไลต์เงิน ข้อความรองใช้งาช้างหม่น #b7a58a
// เนื้อความ #ece1cc (BRAND_TEXT) — 13.4:1 บนผิวยก
//
// ชุดทอง-เงินของ UP555 ที่เคยค้างในไฟล์นี้ (#ebbb54 #fce675 #ab6d24 #d5d4d3 #130b03
// #241705 #0c0502 #d8c9a8 #f8eed9 rgba(235,187,84,…) rgba(252,230,117,…)
// rgba(12,5,2,…)) ออกครบทุกจุดแล้ว — รอบก่อนบังเอิญเป็นทองอีกเฉดหนึ่ง ซึ่งเป็นกรณีที่
// พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว" ไม่ได้หมายความว่าเป็นทองของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#d8dbe0] via-[#f5d98a] to-[#c8912f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(200,145,47,0.35)]">
      เสียงตอบรับจาก <span class="text-[#d8dbe0]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c8912f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#c8912f]/50 bg-[#191108]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f5d98a]/70 hover:shadow-[0_15px_40px_rgba(200,145,47,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#d8dbe0]/16 blur-[50px] transition-all duration-500 group-hover:bg-[#c8912f]/28" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#6d4412] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#f5d98a]/50 drop-shadow-[0_0_5px_rgba(245,217,138,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#c8912f] drop-shadow-[0_0_5px_rgba(200,145,47,0.8)]" : "text-[#6d4412]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#ece1cc] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#d8dbe0]/40 bg-gradient-to-br from-[#120c07] to-[#070504] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f5d98a] transition-colors group-hover:text-[#d8dbe0]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#b7a58a] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
