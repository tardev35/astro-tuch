---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for a
// คาสิโนฐานเข้าหลัก brief (789BETTING: บาคาร่า รูเล็ต บอล หวย สล็อต side by side)
// and before that for a สล็อตเบทต่ำ one — brand-spec §6 bans every one of those
// words on this brand. PIGPG is a ฐานเข้าเล่นสล็อตเว็บหลัก / ศูนย์รวมเกมสล็อต
// ค่ายแท้, and the brief talks about the SLOT CATALOGUE (สล็อตคลาสสิก, เกมโบนัส,
// ฟรีสปิน, ตัวคูณ, เกมใหม่, เมนูเลือกค่าย), the member account (เครดิต,
// ประวัติรายการ, บัญชีสมาชิกเดียว), withdrawals inside 24 ชั่วโมง with their own
// conditions, two promotions, a 3-step signup and a 24-hour admin desk —
// nothing else. So the three cards are written from that brief end to end.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt):
// รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว · สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ ·
// เกมใหม่จากค่ายที่เปิดให้บริการ · เข้าเล่นผ่านมือถือ · เมนูเลือกค่าย · ตรวจสอบเครดิต ·
// ติดตามรายการต่างๆ ผ่านบัญชีสมาชิกเดียว · ส่งคำขอถอนยอดตามช่องทางที่เว็บไซต์เปิดให้
// ใช้งาน · ติดตามสถานะธุรกรรม · คืนยอดเสีย 0.3% ตามรอบประจำวัน · โอนโบนัสเข้ายูส
// อัตโนมัติ · ประวัติโปรโมชั่น · แนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ · แชร์ลิงก์ส่วนตัว ·
// สมัคร 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// — พร้อมคำกำกับของบรีฟเองว่า การระบุว่าเป็นศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทน
// ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ · ระยะเวลาที่เงินเข้าบัญชีอาจ
// แตกต่างกัน · ควรอ่านรายละเอียดก่อนรับสิทธิ์ · คำว่าไม่จำกัดควรตรวจสอบรายละเอียด
//
// No licence claim, no regulator, no operator name, no bank name, no provider
// name, no member count, no founding year, no deposit minimum, no promised
// profit — the brief names none of them. The only figures used are the brief's
// own: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน.
// The brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่กดดูทีละเมนูตามที่หน้าเว็บบอกไว้ รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียวจริง มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน เกมที่มีฟีเจอร์ตัวคูณ และเกมที่เพิ่งเพิ่มเข้ามาในระบบรวมอยู่กับเกมยอดนิยม เปิดจากมือถือกดหาเกมได้สะดวกเพราะมีเมนูเลือกค่ายให้ไล่ดูตามหมวดหมู่ ตรวจสอบเครดิตและติดตามรายการต่างๆ ได้จากบัญชีสมาชิกเดียวโดยไม่ต้องเปลี่ยนหลายหน้า หัก 1 ดาวเพราะอยากให้มีช่องค้นหาชื่อเกมเพิ่มมาด้วย",
    avatar: "🎰",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่า ศูนย์รวมเกมสล็อตค่ายแท้ ไม่ผ่านเว็บตัวแทน มากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าการระบุแบบนั้นควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้ เพื่อให้สมาชิกทราบรายละเอียดของแพลตฟอร์มก่อนใช้งาน ตรงกับที่เราแนะนำอยู่แล้วว่าให้ดูข้อมูลที่ตรวจสอบย้อนกลับได้ ไม่ใช่ดูจากข้อความโฆษณาเพียงอย่างเดียว เรื่องถอนยอดก็เขียนตามจริงว่าระบบเปิดรับคำขอได้ตลอด 24 ชั่วโมง แต่ระยะเวลาที่เงินเข้าบัญชีอาจแตกต่างกันตามขั้นตอนตรวจสอบและช่องทางชำระเงิน จึงควรดูยอดขั้นต่ำ เงื่อนไขการถอน และสถานะรายการก่อนทำธุรกรรมทุกครั้ง",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `ใช้บัญชีสมาชิกเดียวมาตลอด เลยชอบที่ตรวจสอบเครดิต ดูโปรโมชั่น และติดตามประวัติรายการได้จากหน้าเดียว คืนยอดเสีย 0.3% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบประจำวันที่เว็บไซต์กำหนด พอเป็นรูปแบบโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดจากประวัติโปรโมชั่นได้เอง ส่วนแนะนำเพื่อนใช้แชร์ลิงก์ส่วนตัวเชิญเพื่อนสมัคร แล้วระบบคำนวณ 0.8% จากยอดที่เข้าเกณฑ์ ยังอยากให้ระบุคำว่าไม่จำกัดให้ชัดว่าเป็นจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส และก่อนกดรับก็ยังต้องดูเวลาตัดรอบกับเกมที่ร่วมรายการเองอยู่ดี ตอนสมัครใช้มือถือทำได้ใน 3 ขั้นตอนตามที่เขียนไว้ เคยติดปัญหาโบนัสไม่เข้าบัญชี ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งชื่อเกม ค่าย และเวลาที่พบเหตุการณ์ไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "💸",
  },
];

// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2):
// การ์ดเป็นผิวยก #3a0d07 ในเส้นไรผมทองแบรนด์ #f5b61d บนพื้นเพจไล่แดงเลือดหมู-อำพัน
// รอบนี้แบรนด์มีสองฮิวจริง — แดงแล็กเกอร์กับทอง — การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ ไม่ใช่
// ด้วย "ช่วงของทอง" แบบรอบ 789BETTING: เครื่องหมายคำพูดกับชื่อผู้รีวิวเป็นทองสว่าง #ffd87a
// ที่ไต่ขึ้นเป็นครีมงาช้าง #fdf9e4 ตอน hover ดาวที่ติดเป็นทองสว่างพร้อมเรืองแสง
// rgba(255,216,122,…) ส่วนออรามุมการ์ดเป็นแดงสด #d4200d ที่อิ่มขึ้นเป็นแดงเข้ม #a30303
// ตอน hover และขอบรูปโปรไฟล์เป็นทองแบรนด์โปร่งบนพื้นไล่ผิวกลาง #2a0806 → ผิวลึกสุด
// #120302 ดาวที่ไม่ติดตกไปเป็นทองเข้ม #b07a06 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่ครีม
// งาช้าง #fdf9e4 → ทองสว่าง #ffd87a → ทองแบรนด์ #f5b61d พร้อมคำว่า ผู้ใช้งานจริง เป็น
// ไฮไลต์ทองสว่าง ข้อความรองใช้สีเนื้อความแบบลดความทึบ (#fdeedd/70) เพราะพาเลตต์รอบนี้
// ไม่มีสีกลางหม่นของตัวเอง และการสร้างเทาขึ้นมาใหม่คือการเพิ่มสีนอกพาเลตต์
// เนื้อความ #fdeedd (= BRAND_TEXT) — 14.8:1 บนผิวยก
//
// ชุดมรกต-ทองของ KOON234 ที่เคยค้างในไฟล์นี้ (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e
// #fde9a6 #8a6204 #0d2414 #09190d #020803 #e8f2e6 rgba(204,146,10,α) rgba(247,209,78,α))
// และชุดทองเมทัลลิก-เงินโครเมียมของ 789BETTING/UOK365 ก่อนหน้านั้น (#fad354 #ffe79a
// #ddab33 #8a6410 #c9881f #4a3407 #17130a #0e0b05 #060402 #b5a888 #f3e7cd #c8912f
// #f5d98a #6d4412 #d8dbe0 #191108 #120c07 #070504 #ece1cc #b7a58a) ออกครบทุกจุดแล้ว —
// ทองสองรอบก่อนเป็นคนละค่ากับทองของรอบนี้ ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ
// "ทองอยู่แล้ว" ไม่ได้หมายความว่าเป็นทองของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf9e4] via-[#ffd87a] to-[#f5b61d] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(245,182,29,0.35)]">
      เสียงตอบรับจาก <span class="text-[#ffd87a]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d4200d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#f5b61d]/50 bg-[#3a0d07]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffd87a]/70 hover:shadow-[0_15px_40px_rgba(245,182,29,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#d4200d]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#a30303]/45" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#6b0402] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffd87a]/50 drop-shadow-[0_0_5px_rgba(255,216,122,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ffd87a] drop-shadow-[0_0_5px_rgba(255,216,122,0.8)]" : "text-[#b07a06]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#fdeedd] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#6b0402]/70 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f5b61d]/40 bg-gradient-to-br from-[#2a0806] to-[#120302] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffd87a] transition-colors group-hover:text-[#fdf9e4]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#fdeedd]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
