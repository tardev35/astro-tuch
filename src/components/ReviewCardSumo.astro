---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for a
// ศูนย์รวมเกมสล็อตค่ายแท้ / สมัคร 3 ขั้นตอน brief and for KINGKONG555's
// เดิมพันเริ่มต้น 1 บาท / สล็อตเบทต่ำ / ตารางจ่าย one — brand-spec §6 bans every
// one of those phrases on this brand. FLASH877's brief covers only: a
// เว็บตรงฐานสล็อตหลัก with an อัปเดตระบบเข้าเล่นใหม่ 2026 that works on mobile and
// desktop, many kinds of slot in บัญชีเดียว (สล็อตคลาสสิก, เกมฟรีสปิน, โบนัสตัวคูณ,
// เกมใหม่จากค่ายที่เปิดให้บริการ), ค้นหาเกม / ตรวจสอบเครดิต / โปรโมชั่น / ประวัติรายการ,
// the update reaching หน้าเข้าสู่ระบบ / เมนูเลือกเกม / ส่วนจัดการบัญชี, two promotions
// (คืนยอดเสีย 0.3% and แนะนำเพื่อน 0.8%), ฝากถอนเข้าบัญชีบริษัทโดยตรง and
// แอดมิน 24 ชั่วโมง — nothing else.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt),
// including its own hedging, which §5 says ships with the copy rather than being
// trimmed for sounding downbeat: ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานยืนยัน ·
// คำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อน จำนวนครั้ง หรือวงเงิน ·
// ชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ·
// ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// No licence claim, no regulator, no operator name, no bank name, no provider
// name, no member count, no founding year, no deposit minimum, no RTP figure,
// no promised profit — the brief names none of them. The only figures used are
// the brief's own: 0.3% · 0.8% · 24 ชั่วโมง · 100% · 2026. There is no
// "1 บาท" anywhere: that was KINGKONG555's headline number, not this brief's.
// The brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่กดดูทีละเมนูตามที่หน้าเว็บเขียนไว้ การอัปเดตระบบเข้าเล่นใหม่ในปี 2026 ครอบคลุมทั้งหน้าเข้าสู่ระบบ เมนูเลือกเกม และส่วนจัดการบัญชีจริง เปิดจากมือถือหรือคอมพิวเตอร์ก็ใช้งานได้เหมือนกัน เกมสล็อตหลายประเภทอยู่ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ ค้นหาเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากที่เดียว การจัดหมวดเกมช่วยให้หาได้เร็วขึ้นพอสมควร หัก 1 ดาวเพราะอยากให้รายชื่อค่ายเกมที่ตรวจสอบได้แสดงอยู่ในหน้าเดียวกันไปเลย",
    avatar: "⚡",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่าเว็บตรงไม่ผ่านเอเย่นต์และเว็บฐานหลัก 100% มากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าข้อความแบบนั้นควรมีข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานยืนยันว่าเว็บไซต์เชื่อมต่อกับค่ายเกมโดยตรง ตรงกับที่เราแนะนำอยู่แล้วว่าให้ดูข้อมูลที่ย้อนกลับไปตรวจได้ ฝั่งธุรกรรมก็เขียนตามจริงว่าถ้าระบุว่าฝากถอนเข้าบัญชีบริษัทโดยตรง ก็ควรแสดงชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `ใช้มาต่อเนื่องเพราะจบได้ในบัญชีเดียว เปิดดูโปรโมชั่นกับประวัติรายการจากหน้าเดิมได้เลย คืนยอดเสีย 0.3% ระบบนำยอดที่เข้าเกณฑ์มาคำนวณตามรอบประจำวันที่เว็บไซต์กำหนด พอเป็นรูปแบบโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดกับประวัติการรับสิทธิ์ได้จากบัญชีเอง ส่วนแนะนำเพื่อนใช้แชร์ลิงก์แนะนำให้เพื่อนสมัคร แล้วระบบคำนวณ 0.8% จากยอดที่เข้าเกณฑ์ ยังอยากให้ระบุคำว่าไม่จำกัดให้ชัดว่าเป็นจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส ก่อนกดรับก็ยังต้องดูรอบตัดยอดกับรอบคำนวณเองอยู่ดี เวลาฝากถอนจะเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักก่อนทุกครั้ง แล้วเก็บหลักฐานธุรกรรมไว้จนรายการเสร็จ เคยติดปัญหาโปรโมชั่นไม่เข้าบัญชี ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งชื่อกิจกรรมกับรอบรับสิทธิ์ไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "💸",
  },
];

// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2):
// การ์ดเป็นผิวยก #7d1008 ในเส้นไรผมทองสายฟ้า #f5c518 บนพื้นเพจแดงเลือดนก #5c0000 —
// สว่างกว่าพื้นเพจ จึงลอยขึ้นมาเหมือนเหรียญกลมขอบทองในโลโก้ที่ลอยอยู่หน้าฉากม่าน
// กำมะหยี่แดง รอบนี้แบรนด์มีสองฮิวจริง — ทองสายฟ้านำ แดงสายฟ้าเป็นฮิวที่สอง — การ์ดจึง
// แยกชั้นด้วยคู่สีนั้นตรงๆ ไม่ใช่ด้วย "ช่วงของทอง" อย่างเดียว: เครื่องหมายคำพูดกับชื่อ
// ผู้รีวิวเป็นทองสว่าง #ffdd73 ที่ไต่ขึ้นเป็นครีม #fdf0e2 ตอน hover ดาวที่ติดเป็นทอง
// สว่างพร้อมเรืองแสง rgba(245,197,24,…) ส่วนออรามุมการ์ดเป็นแดงสายฟ้า #ff3b14 ที่อิ่ม
// ขึ้นตอน hover และขอบรูปโปรไฟล์เป็นทองสายฟ้าโปร่งบนพื้นไล่ผิวกลาง #6d0804 → ผิวลึกสุด
// #430000 ดาวที่ไม่ติดตกไปเป็นทองเข้ม #b8860f ที่ opacity ต่ำ ไม่ใช่เทา
// หัวแถบไล่ครีม #fdf0e2 → แดงสายฟ้า #ff3b14 → ทองสายฟ้า #f5c518 พร้อมคำว่า ผู้ใช้งานจริง
// เป็นไฮไลต์ทองสายฟ้า — หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ และเป็นตัวอักษร font-black
// text-3xl ซึ่ง §2 อนุญาตให้ #ff3b14 อยู่กลางไล่เฉดของ display ขนาดนี้ได้
// ข้อความรองใช้ครีมอมส้ม #f8d2bb ซึ่งเป็นสีรองที่ §2 กำหนดไว้อยู่แล้ว (9.0:1 บนผิวยก)
// เนื้อความ #fdf0e2 (= BRAND_TEXT) — 11.6:1 บนผิวยก
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) **ก็แดง-ทองเหมือนกัน** ซึ่งเป็นกรณีที่พลาดง่ายที่สุด
// เพราะ "แดงกับทองอยู่แล้ว" ไม่ได้แปลว่าเป็นแดงกับทองของแบรนด์นี้ ให้เทียบเป็นค่า:
// ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 ที่เคยค้างในไฟล์นี้ (#8ce023 #5cc211 #2f8c07
// #1a5c04 #f2c230 #ffe066 #a87a08 #bde397 #e9f7d6 #14380a #0f2e05 #051400
// rgba(242,194,48,α) rgba(140,224,35,α)) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b #f5cbb0 #fbe8d5 #3d1709
// #241000) ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #b07a06
// #6b0402 #fdeedd) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d
// #5b1a75 #1e0a3c #ece2ff) และชุดทองเมทัลลิก-เงินโครเมียมของ 789BETTING/UOK365
// (#fad354 #ffe79a #ddab33 #c8912f #f5d98a #6d4412 #d8dbe0 #ece1cc) ออกครบทุกจุดแล้ว
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf0e2] via-[#ff3b14] to-[#f5c518] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(245,197,24,0.35)]">
      เสียงตอบรับจาก <span class="text-[#f5c518]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c518] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#f5c518]/50 bg-[#7d1008]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffdd73]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#ff3b14]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#ff3b14]/50" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#8c0f0a] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffdd73]/50 drop-shadow-[0_0_5px_rgba(245,197,24,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ffdd73] drop-shadow-[0_0_5px_rgba(245,197,24,0.8)]" : "text-[#b8860f]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#fdf0e2] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#8c0f0a]/70 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f5c518]/40 bg-gradient-to-br from-[#6d0804] to-[#430000] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffdd73] transition-colors group-hover:text-[#fdf0e2]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#f8d2bb] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
