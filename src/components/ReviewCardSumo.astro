// จักรพรรดิ-แดงชาดของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04
// 0d0501 5c2a06 fff8ec 2b1400) ชุดบรอนซ์-ทองอำพันของ **ufalion168** (d4922c fdfc71
// a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) ชุดฟ้าอะซัวร์ของ
// **รวยแทร่168** (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d)
// ชุดของ **สบายเบท168** (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726
// 040d16) ชุดทอง-ชมพูบานเย็นของ **มีโชค168** (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดทองไทย-แดงมังกรของ **รับตัง168**
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09
// 140505 1a0505) ชุดแดงเลือดนก-เงินโครเมียมของ **TKB55** (fb131b ff4d55 ff8a8f
// e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 53050a) ชุดม่วงราชา-ทองของ **KMD88**
// (7505cc b453ff c07cff d9b8ff bba8d4 e2b33f ece2f8 1d0832 140522 2c0349 0a0213)
// ชุดชมพูฮอตพิงก์-ทองของ **PUNPRO168** (f41571 ff5ca8 fce343 ffd94a f0c3dc fde7f2
// 8a0a45 4a1038 1c0014) ชุดทองแชมเปี้ยน-เงินของ **UFA324** (e5a81b b9c2cc 231c0e
// f0e8d4) ชุดทองอำพันเสือของ **TIGERWIN369** (d98324 f7b733 ffd98a f7e4c0 e3cfae)
// ชุดแดงเสือโคร่ง-ทองของ **SUPERSLOTCLUB** (e8232a f2b705 ffd666 fbe8d5) ชุดของ
// **ถอนชัวร์168** (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617
// fdeaf5) และชุดชมพูบานเย็นของรอบขาออก **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720
// f7dcf6 f0ccf5) — ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีชมพู/ฟูเชีย ไม่มีแดง
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม ไม่มีเหลืองมะนาว ไม่มีส้มสด ไม่มีบรอนซ์
// และไม่มีทองบนการ์ด**
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#0a5f1c] via-[#0b7d28] to-[#0a5f1c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(11,125,40,0.3)]">
      เสียงตอบรับจาก <span class="text-[#0b7d28]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0f9b35] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#0b7d28]/55 bg-[#ffffff] p-8 shadow-[0_10px_30px_rgba(12,58,22,0.15)] transition-all duration-500 hover:-translate-y-2 hover:border-[#0a5f1c]/80 hover:shadow-[0_15px_40px_rgba(11,125,40,0.26)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#0f9b35]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#0f9b35]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#0b7d28]/35 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#0a5f1c]/60">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#0a5f1c]" : "text-[#0c3a16]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#0c3a16] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#0b7d28]/35 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#0b7d28]/40 bg-gradient-to-br from-[#e9fbdd] to-[#d8ffc7] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#0a5f1c] transition-colors group-hover:text-[#0b7d28]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#0c3a16] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
