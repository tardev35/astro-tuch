<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#2f9ff5] via-[#a8dcff] to-[#2f9ff5] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(47,159,245,0.45)]">
      เสียงตอบรับจาก <span class="text-[#ffc82e]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffc82e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#2f9ff5]/55 bg-[#0e2238]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffc82e]/75 hover:shadow-[0_15px_40px_rgba(47,159,245,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#2f9ff5]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#2f9ff5]/40" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#0b3f78] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#a8dcff]/70 drop-shadow-[0_0_5px_rgba(47,159,245,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ffc82e] drop-shadow-[0_0_5px_rgba(255,200,46,0.75)]" : "text-[#a8dcff]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#e8f4ff] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#0b3f78]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#5c4a16] bg-gradient-to-br from-[#081726] to-[#040d16] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffc82e] transition-colors group-hover:text-[#a8dcff]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#a8dcff] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
