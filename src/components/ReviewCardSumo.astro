---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what LOTTOPLUS's brief supports: สมัครและ Login
// ผ่านเบราว์เซอร์บนมือถือโดยไม่ต้องติดตั้งแอป, หวยรัฐบาลไทย/ลาวพัฒนา/ฮานอย/หวยหุ้น
// ในบัญชีเดียว, เลือกเลข-ส่งโพย-ตรวจสอบรายการ-ตรวจผลหวย, อัตราจ่าย 2 ตัว 100 กับ
// 3 ตัว 1,000 ที่ขึ้นกับประเภทหวย/รูปแบบการแทง/รอบที่เปิดรับ, โบนัสคืนยอดเสีย 0.3%
// กับแนะนำเพื่อน 0.8%, ฝากเข้าบัญชีบริษัทตรงไม่ผ่านตัวแทน, และแอดมิน 24 ชั่วโมง.
// No licence claim, no bank name, no member count, no promised profit — and no
// คาสิโน/บาคาร่า/สล็อต/ค่ายเกม, which is what the previous holder of this file
// was full of.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บหวย",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านเบราว์เซอร์บนมือถือตามที่หน้าเว็บบอกไว้ กรอกข้อมูลตามที่ระบบกำหนด ยืนยันบัญชี แล้ว Login เข้าไปเลือกประเภทหวยได้เลยโดยไม่ต้องติดตั้งแอปเพิ่ม ในบัญชีเดียวมีทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น เลือกเลขกับดูเวลาปิดรับก่อนส่งโพยได้จากหน้าเดียวกัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บหวย",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามถึงอัตราจ่ายกับโปรโมชั่นมากที่สุด หน้านี้แยกไว้ชัดว่ามีคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ตรวจยอดที่เข้าเกณฑ์จากบัญชีตัวเองได้ ส่วนอัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ไม่ได้ใช้เหมือนกันทุกรายการ เพราะขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ ต้องดูตัวเลขที่ระบบแสดงก่อนยืนยันโพยทุกครั้ง",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ก่อนโอนรอบแรกลองเทียบชื่อบัญชีปลายทางกับข้อมูลที่เว็บไซต์ประกาศไว้ ตรงกันตามที่บอกว่าเข้าบัญชีบริษัทโดยตรงไม่ผ่านตัวแทน หลังส่งโพยก็กลับมาดูเลขที่เลือก ยอดเดิมพัน และสถานะรายการได้ครบ ตอนถามเรื่องรอบคำนวณโบนัส แอดมินตอบกลับในคืนเดียวกันตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🧾",
  },
];

// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): การ์ดเป็นผิวดำอมแดง #120b0c ในเส้นไรผมแดง
// แบรนด์ #dc020e บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อผู้รีวิวไต่ขึ้นเป็น
// ทองอ่อน #fde79a กับทองรอง #f3c623 ตามเหรียญทองในงานอาร์ต ดาวที่ไม่ติดตกไปเป็นทอง
// ลึก #8a6a0a ที่ opacity ต่ำ ไม่ใช่เทา จึงไม่มีจุดใดในการ์ดหลุดออกจากคู่แดง-ทองของ
// แบรนด์ หัวแถบไล่ทองอ่อน → ทองรอง → แดงแบรนด์ พร้อมคำว่า ผู้ใช้งานจริง เป็นขาว
// ไฮไลต์ #fff4f4 เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดทองโอลีฟของ GODBET88 ที่ค้างใน
// ไฟล์นี้ (#c2a55c #f6e7b8 #e2c87f #9a7f3f #0a0806 #050403 #ece1cc #b9ad98) ออก
// ทั้งหมด พร้อมกับ copy เรื่องสล็อต/ค่ายเกม/เทิร์นโอเวอร์ที่ไม่ใช่ของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(220,2,14,0.25)]">
      เสียงตอบรับจาก <span class="text-[#fff4f4]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dc020e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#dc020e]/50 bg-[#120b0c]/90 p-8 shadow-[0_10px_30px_rgba(5,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f3c623]/70 hover:shadow-[0_15px_40px_rgba(220,2,14,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#6b0207]/28 blur-[50px] transition-all duration-500 group-hover:bg-[#dc020e]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#dc020e]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fde79a]/50 drop-shadow-[0_0_5px_rgba(253,231,154,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f3c623] drop-shadow-[0_0_5px_rgba(243,198,35,0.8)]" : "text-[#8a6a0a]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f0e2e2]/90 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#fde79a]/30 bg-gradient-to-br from-[#6b0207] to-[#050505] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fde79a] transition-colors group-hover:text-[#f3c623]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#f0e2e2]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
