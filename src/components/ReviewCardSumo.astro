---
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content: "ระบบหลังบ้านแน่นและเสถียรมากครับ โครงสร้าง API ของระบบฝาก-ถอนออโต้ทำงานได้ไวระดับเสี้ยววินาที ไร้รอยต่อจริงๆ แถม UI/UX ออกแบบมาให้ผู้เล่นใช้งานง่ายมาก หัก 1 ดาวเพราะอยากให้มีฟีเจอร์ปรับโหมดสว่างบ้าง รวมๆ คือโคตรตึง!",
    avatar: "🐻‍❄️"
  },
  {
    name: "ชุมนุม เว็บพนันออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content: "ทางเพจเราเทสแล้ว คอนเฟิร์มว่าที่นี่คือ 'เว็บพนันเว็บตรงของแท้ 100%' รวมเกมเดิมพันไว้เยอะมาก ทั้งสล็อต คาสิโนสด และกีฬา ไม่มีการปรับเรทหรือล็อคยูสเซอร์แน่นอน จ่ายจริงทุกบิล เป็นเว็บคุณภาพที่อยากแนะนำ",
    avatar: "🎰"
  },
  {
    name: "อาสาสมัครนักเล่นเกมเดิมพัน",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content: "ลองเทสมาแล้วหลายเว็บ สุดท้ายจบที่ LOBBYBKK ครับ! เกมหลากหลายจนเลือกไม่ถูก โปรโมชั่นก็ให้มาแบบจัดเต็มคุ้มค่าสุดๆ แอดมินบริการดีตอบไว 24 ชม. เงินเข้าปุ๊บปั๊บ เอาไปเลย 5 ดาวเต็มๆ ไม่ผิดหวังแน่นอนครับ!",
    avatar: "👑"
  }
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ LOBBYBKK" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a78bfa] via-[#8b5cf6] to-[#6d28d9] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(124,58,237,0.2)]">
      เสียงตอบรับจาก <span class="text-[#a78bfa]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7c3aed] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {reviews.map((review) => (
      <article class="group relative flex flex-col justify-between rounded-3xl border border-[#7c3aed]/30 bg-[#0f0818]/80 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#7c3aed]/60 hover:shadow-[0_15px_40px_rgba(124,58,237,0.3)]">
        <div class="pointer-events-none absolute -left-10 -top-10 h-32 w-32 rounded-full bg-[#7c3aed]/10 blur-[50px] transition-all duration-500 group-hover:bg-[#7c3aed]/20"></div>

        <div class="relative z-10 flex flex-col gap-4">
          <div class="flex items-center justify-between border-b border-[#4c1d95]/50 pb-4">
            <span class="text-4xl text-[#a78bfa]/50 drop-shadow-[0_0_5px_rgba(167,139,250,0.5)] leading-none font-serif">"</span>
            <div class="flex gap-1 text-lg">
              <span aria-hidden="true" class="flex gap-1">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={`${i < review.stars ? 'text-[#a78bfa] drop-shadow-[0_0_5px_rgba(167,139,250,0.8)] animate-pulse' : 'text-gray-600'}`}>
                    ★
                  </span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>
          </div>

          <p class="text-sm leading-relaxed text-gray-300 min-h-[100px] italic">
            "{review.content}"
          </p>
        </div>

        <div class="relative z-10 mt-6 flex items-center gap-4 pt-4 border-t border-white/5">
          <div
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#7c3aed] to-black border border-[#a78bfa]/30 text-2xl shadow-inner group-hover:scale-110 transition-transform duration-300">
            {review.avatar}
          </div>
          <div class="flex flex-col">
            <h4 class="text-base font-black text-white group-hover:text-[#a78bfa] transition-colors">{review.name}</h4>
            <span class="text-[11px] font-bold tracking-wider text-[#a78bfa]/70 uppercase">{review.role}</span>
          </div>
        </div>

      </article>
    ))}
  </div>
</section>
