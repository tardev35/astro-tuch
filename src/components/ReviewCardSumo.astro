---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
// ตรวจแล้วรอบนี้: ไม่มี <h1>-<h6> hardcode ในไฟล์นี้ · <section> มี aria-label ·
// รูปเดียวในไฟล์นี้คืออีโมจิอวาตาร์ซึ่งเป็น **ของตกแต่งล้วน** จึงอยู่ในกล่อง
// aria-hidden="true" ของตัวเอง ไม่ใช่ <img> ที่ต้องมี alt
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของ **สาธุ168**
// (เว็บหวยล้วน) และก่อนหน้านั้นเป็นคำของ **ดวงเศรษฐี168** (เว็บสอนเล่นเกม)
// **รวยเทพ168** (สล็อต) กับ **ufalion168** (บอล) ซึ่งพูดถึง **หวยรัฐบาลไทย /
// หวยฮานอย / หวยลาว / หวยหุ้นต่างประเทศ / สลากกินแบ่งรัฐบาล / รอบปิดรับ /
// รอบประกาศผล / อัตราจ่าย / บิลหวย / แหล่งอ้างอิงผลรางวัล / เศรษฐีพนันมือ1 /
// ผู้สอน / บทเรียน / สูตร / เทคนิค / บาคาร่า / ไฮโล / ยิงปลา / ฟุตบอล / ราคาต่อรอง
// / ค่าน้ำ** — brand-spec §1 ของรอบนี้ระบุว่าบรีฟ **ไม่มีคำเหล่านั้นสักคำ** จึงออก
// ทั้งหมด
// ⚠️ **รอบนี้เป็นเว็บเกมสล็อตล้วน** — "หวย / สลาก / ตรวจหวย / แนวทาง / บาคาร่า /
// คาสิโนสด / ยิงปลา / ไฮโล / บอล / เว็บตรง" เป็นคำค้างของแบรนด์ก่อน **ห้ามเติมกลับ
// เข้าไปแม้แต่คำเดียว** (คำว่า **ค่ายตรง** ที่ใช้ได้มาจากบรีฟเอง — คนละคำกับ
// "เว็บตรง" ที่บรีฟไม่ได้เขียน)
//
// บรีฟรอบนี้ครอบคลุมแค่: **เว็บที่รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายต่าง ๆ ไว้ที่
// เดียว** พร้อมรูปแบบเกม ฟีเจอร์พิเศษ ตารางจ่ายรางวัล และเงื่อนไขการเดิมพัน;
// โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และ แนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด); ขั้นตอนสมัครสมาชิก 3 ขั้น; และช่องทางติดต่อแอดมิน 24ชม. — ไม่มีอะไร
// นอกนี้
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: ควรตรวจสอบสถานะลิขสิทธิ์ของเกมและ
// ข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งาน · รายชื่อค่ายเกมและรายการที่เปิดให้
// บริการอาจเปลี่ยนแปลงได้ · เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุก
// การเดิมพันหรือทำกำไรได้ในครั้งต่อไป · ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อ
// หลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้
// บุคคลอื่น · ควรตรวจสอบเวลาการให้บริการและระยะเวลาตอบกลับล่าสุดจากประกาศทางการ
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล **ชื่อธนาคาร ชื่อค่ายเกม**
// ค่า RTP ยอดฝากขั้นต่ำเป็นตัวเลข จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟไม่ได้ระบุไว้
// สักข้อ ตัวเลขที่อ้างมีแค่ของบรีฟเอง: 0.3% · 0.8% · 24ชม. · ปี 2026
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้ใช้งานที่ไล่อ่านรายละเอียดเกมก่อนเลือกใช้งาน",
    role: "ตรวจรูปแบบเกม ฟีเจอร์พิเศษ และเงื่อนไขการเดิมพัน",
    stars: 4,
    content: `เปิดหน้าเว็บ ${BRAND_NAME} มาเพราะอยากได้ที่ที่รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายต่าง ๆ ไว้ให้ดูเทียบกันในที่เดียว สิ่งที่ถูกใจคือได้ไล่ศึกษารูปแบบเกม ฟีเจอร์พิเศษ ตารางจ่ายรางวัล และเงื่อนไขการเดิมพันก่อนเลือกใช้งานจริง ไม่ต้องเดาเอาเอง ผมเลยเริ่มจากอ่านรายละเอียดของเกมที่สนใจให้ครบก่อน แล้วค่อยเทียบกับกติกาและเงื่อนไขที่หน้าเว็บเขียนไว้ หัก 1 ดาวตรงที่ต้องกดเข้าไปอ่านหลายจุดกว่าจะครบ ถ้ารวมรายละเอียดของแต่ละเกมไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้ อีกเรื่องที่หน้าเว็บเขียนกำกับเองและผมว่าควรอ่านให้ครบคือ รายชื่อค่ายเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้ จึงควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งานทุกครั้ง`,
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เทียบเงื่อนไขโปรโมชั่นก่อนรับสิทธิ์",
    role: "ตรวจยอดที่นำมาคำนวณและรอบสรุปยอดเครดิต",
    stars: 4,
    content:
      "เข้ามาดูรายการโปรโมชั่นเป็นหลัก มีสองรายการที่ระบุไว้คือคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด ก่อนกดรับสิทธิ์ผมไล่เช็กว่าเกมสล็อตประเภทไหนเข้าร่วมรายการบ้าง มีรอบสรุปยอดเวลาใด เครดิตจะเข้าบัญชีโดยอัตโนมัติหรือต้องกดรับด้วยตนเอง และมีข้อกำหนดอะไรเรื่องการนำเครดิตไปใช้กับการถอนเงิน ฝั่งแนะนำเพื่อนก็ต้องดูวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ครบ ข้อที่ชอบคือหน้าเว็บเขียนกำกับไว้เองว่าเครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป และแม้รายการแนะนำเพื่อนจะระบุว่าไม่จำกัด ก็ยังควรยืนยันข้อกำหนดเรื่องจำนวนบัญชีที่เข้าร่วมและรอบจ่ายเครดิตจากประกาศล่าสุดอยู่ดี ส่วนที่ยังอยากให้เพิ่มคือสรุปเงื่อนไขของทั้งสองรายการไว้เทียบกันในที่เดียว เพราะตอนนี้ต้องเปิดอ่านทีละประกาศ",
    avatar: "🎁",
  },
  {
    name: "ผู้ที่ตรวจที่อยู่เว็บไซต์ให้ถูกต้องก่อนกรอกข้อมูลทุกครั้ง",
    role: "สมัครครบสามขั้นตอนแล้วค่อยเข้าดูรายละเอียดเกม",
    stars: 5,
    content: `ใช้งานฝั่งสมัครสมาชิกเป็นหลัก ขั้นตอนที่เขียนไว้มีสามขั้นและผมทำตามครบ เริ่มจากตรวจที่อยู่เว็บไซต์ให้ถูกต้องแล้วเข้าหน้าสมัครสมาชิก อ่านเงื่อนไขการเปิดบัญชีกับข้อกำหนดการใช้บริการก่อน จากนั้นกรอกข้อมูลตามที่ระบบกำหนด ตรวจความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัยโดยไม่ใช้ข้อมูลของบุคคลอื่น พอเข้าสู่ระบบได้ก็ไปไล่ดูรายชื่อค่ายเกมสล็อต กติกาการเล่น ช่วงเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ มีรอบหนึ่งที่ผมสงสัยเรื่องรายการฝากถอน ก็เตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้แล้วติดต่อเจ้าหน้าที่ผ่านช่องทางที่เช็กจากเว็บไซต์ทางการของ ${BRAND_NAME} ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ เรื่องก็จบตรงนั้น แอดมินไม่เคยถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง และถึงจะเขียนว่าดูแลตลอด 24ชม. ก็ยังควรตรวจเวลาการให้บริการกับระยะเวลาตอบกลับล่าสุดจากประกาศทางการอีกครั้ง ให้ไปเลย 5 ดาว`,
    avatar: "📝",
  },
];

// โปรดี168 (รอบ **แดงเชอร์รี่นำ · ทองแดงไหม้รอง · ธีมสว่าง** 2026-10-22,
// .claude/brand-spec-prodeee168.md §2–§3): การ์ดรีวิวที่ใช้งานจริงรอบนี้ — รอบก่อน
// (รวยแท้168) ใช้ ReviewCardSumo2 จึงหมุนกลับมาที่ไฟล์ฐานนี้
// ⚠️ **ธีมสว่าง**: bg.json = {"mode":"color","color":"#ffd1d1"} ชมพูพาสเทล และ §2
// จัด review cards ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** การ์ดจึงเป็น **ผิวยก #ffffff
// บนพื้นเพจ #ffd1d1** พร้อมหมึก **น้ำตาลแดง #401107** (16.1:1) — **ห้าม "แก้" กลับ
// ไปเป็นการ์ดเข้มลอยบนพื้นดำ** ลำดับความลึก: #ffffff ยก / #fff4ea อินเซ็ต /
// #ffd1d1 พื้นเพจ
//
