---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for a
// สล็อตพีจีเว็บเป็ด brief (รวมเกมเดิมพัน ค่ายหลัก · สล็อตคลาสสิก · เกมฟรีสปิน ·
// โบนัสตัวคูณ · สล็อตเบทต่ำ ทุนน้อยกำไรงาม · การันตีความน่าเชื่อถือ · สมัคร
// 3 ขั้นตอน) and before that for เว็บตรงฐานสล็อตหลัก and เดิมพันเริ่มต้น 1 บาท
// briefs — brand-spec §7 bans every one of those phrases on this brand.
//
// THIS brief covers only: a **เว็บเล่นเกมกีฬาออนไลน์** whose ทางเข้าเดิมพัน holds
// ฟุตบอล (คู่แข่งขัน · ประเภทการเดิมพัน · อัตราต่อรอง), มวย (รายการแข่งขันและรูปแบบ
// การเดิมพันตามที่ผู้ให้บริการเปิดให้บริการ) and เกมคาสิโน (เกมไพ่ · เกมโต๊ะ ·
// สล็อตจากค่ายต่างๆ) in one platform; กติกา · อัตราจ่าย · เงื่อนไขการตัดสินผล;
// two promotions (คืนยอดเสีย 0.3% เข้ายูสทุกวัน and แนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด); ฝากถอน (ยอดเงิน · ช่องทางชำระเงิน · สถานะรายการ · ชื่อบัญชีผู้รับเงิน ·
// ระยะเวลาดำเนินการ); and แอดมิน 24 ชั่วโมง — nothing else. There is no 3-step
// signup, no เบทต่ำ and no ฟรีสปิน/โบนัสตัวคูณ topic in this brief at all.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt),
// including its own hedging, which §7 says ships with the copy rather than being
// trimmed for sounding downbeat: ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบ
// ได้ · อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใดรับประกันผล
// ตอบแทน · ควรตรวจสอบว่าโปรโมชั่นครอบคลุมเฉพาะสล็อตหรือรวมกีฬา/คาสิโนด้วย ·
// คำว่าไม่จำกัดควรระบุให้ชัด · จ่ายตรง/ไม่บิดยูส/ไม่มีขั้นต่ำ/ไม่ผ่านบัญชีม้า ควรมี
// ข้อมูลที่ตรวจสอบได้รองรับ · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// No licence claim, no regulator, no operator name, no bank name, no provider
// name, no league / team / fighter name, no member count, no founding year, no
// deposit minimum, no RTP figure, no promised return — the brief names none of
// them. The only figures used are the brief's own: 0.3% · 0.8% · 24 ชั่วโมง.
// There is no "1 บาท", no "100%", no "2026" and no "3 ขั้นตอน" anywhere. The
// brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่เปิดดูทีละหมวดตามที่หน้าเว็บเขียนไว้ หมวดเดิมพันกีฬาและเกมคาสิโนอยู่ในระบบเดียวจริง ฝั่งฟุตบอลมีข้อมูลคู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรองให้ศึกษาก่อนตัดสินใจ ฝั่งมวยมีรายการแข่งขันและรูปแบบการเดิมพันตามที่ผู้ให้บริการเปิดให้บริการ ส่วนหมวดคาสิโนมีเกมไพ่ เกมโต๊ะ และสล็อตจากค่ายต่างๆ ให้เลือก ค้นหาประเภทกีฬาและเปิดดูรายละเอียดการแข่งขันจากมือถือก็ได้ จากคอมพิวเตอร์ก็ได้ หัก 1 ดาวเพราะจำนวนรายการจริงขึ้นอยู่กับระบบที่เปิดใช้งานในแต่ละช่วง อยากให้แสดงสถานะว่าหมวดไหนเปิดอยู่รวมในหน้าเดียวไปเลย",
    avatar: "⚽",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเดิมพัน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่า ฐานเกมแท้ กับ จ่ายตรง มากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าการระบุว่าเป็นฐานเกมแท้ควรมีข้อมูลผู้ให้บริการและระบบเกมที่สามารถตรวจสอบได้ เพื่อประกอบการพิจารณาก่อนใช้งาน และบอกด้วยว่าอัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา กับที่สำคัญคือไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน จึงควรกำหนดวงเงินและพิจารณาความเสี่ยงก่อนทำรายการ ตรงกับที่เราแนะนำอยู่แล้วว่าให้ดูข้อมูลที่ย้อนกลับไปตรวจได้ ส่วนข้อความ ไม่บิดยูส ไม่มีขั้นต่ำ และไม่ผ่านบัญชีม้า ก็เขียนตามจริงว่าควรมีชื่อผู้ดำเนินงาน ข้อกำหนดการถอนเงิน และข้อมูลบัญชีรับชำระรองรับ เพราะไม่มีระบบธุรกรรมใดรับประกันความปลอดภัยได้ทั้งหมด",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `ใช้มาต่อเนื่องเพราะเปิดดูโปรโมชั่นจากหน้าเดิมได้เลย คืนยอดเสีย 0.3% ระบบคำนวณโบนัสจากยอดเสียที่เข้าเงื่อนไขตามรอบประจำวันที่กำหนด พอเป็นรูปแบบโอนโบนัสเข้ายูสทุกวันก็ติดตามยอดที่ได้รับจากประวัติบัญชีได้เอง แต่ก็ต้องดูเองว่าระบบนับยอดจากสล็อต กีฬา หรือคาสิโนประเภทใดบ้าง รวมถึงเวลาตัดรอบกับวิธีรับโบนัส ส่วนแนะนำเพื่อนใช้ลิงก์แนะนำแชร์ให้เพื่อนสมัคร แล้วระบบคำนวณ 0.8% จากยอดที่เข้าเกณฑ์ ยังอยากให้ระบุคำว่าไม่จำกัดให้ชัดว่าเป็นจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด ด้านฝากถอนตรวจสอบยอดเงิน ช่องทางชำระเงิน และสถานะรายการได้จากบัญชี ก่อนยืนยันก็เทียบชื่อบัญชีผู้รับเงินกับที่เว็บไซต์แจ้งทุกครั้ง เคยติดเรื่องรายการไม่เป็นไปตามเงื่อนไข ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งชื่อคู่แข่งขัน เวลาแข่งขัน กับหมายเลขรายการไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "💳",
  },
];

// รอบนี้ (2026-10-11, brand-spec §2): การ์ดเป็นผิวยก #231c0e ในเส้นไรผมทองแบรนด์
// #e5a81b บนพื้นเพจ **ดำสนิท #000000** — สว่างกว่าพื้นเพจชัดเจน จึงลอยขึ้นมาเหมือน
// เหรียญตราทองที่ลอยอยู่บนฉากสนามกีฬากลางคืนในโลโก้ ⚠️ รอบนี้ไม่มีชั้นไหนจมต่ำกว่า
// พื้นได้อีก ทุกผิวต้องสว่างกว่าพื้น
// แบรนด์มีสองฮิวจริง — ทองแชมเปี้ยนนำ เงินโครเมียม (เลข 324 บนโลโก้) เป็นฮิวที่สอง —
// การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ ไม่ใช่ด้วย "ช่วงของทอง" อย่างเดียว: เครื่องหมาย
// คำพูดกับชื่อผู้รีวิวเป็นทองสว่าง #ffe08a ที่ไต่ขึ้นเป็นงาช้างอุ่น #f0e8d4 ตอน hover
// ดาวที่ติดเป็นทองสว่างพร้อมเรืองแสง rgba(229,168,27,…) ส่วนออรามุมการ์ดเป็นเงิน
// แบรนด์ #b9c2cc ที่อิ่มขึ้นตอน hover และขอบรูปโปรไฟล์เป็นทองแบรนด์โปร่งบนพื้นไล่
// ผิวกลาง #17130a → ผิวจม #0d0b06
// ดาวที่ไม่ติดตกไปเป็นทองลึก #7d5a07 ที่ opacity ต่ำ ไม่ใช่เทา
// หัวแถบไล่งาช้างอุ่น #f0e8d4 → เงินแบรนด์ #b9c2cc → ทองแบรนด์ #e5a81b พร้อมคำว่า
// ผู้ใช้งานจริง เป็นไฮไลต์ทองแบรนด์ — หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ
// ข้อความรองใช้เงินหม่น #8792a0 ซึ่งเป็นสีรองที่ §2 กำหนดไว้อยู่แล้ว (5.4:1 บนผิวยก)
// เส้นคั่นในการ์ดเป็นทองดำ #43300a ซึ่ง §2 ห้ามถือตัวอักษรทุกขนาด
// เนื้อความ #f0e8d4 (= BRAND_TEXT) — 13.9:1 บนผิวยก
//
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว"
// ไม่ได้แปลว่าเป็นทองของแบรนด์นี้ ให้เทียบเป็นค่า: ชุดทองเป็ด-ส้มอำพันที่เคยค้างใน
// ไฟล์นี้ (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #f6ecd9
// #d8c69b #1f1709 #171106 #0d0903) ชุดชมพูฮอต-ทองบนพลัมดำของแบรนด์รอบก่อนหน้าทันที
// (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #b3006a #4d002b #4a0b42 #3a0534
// #2e002c #210220) ชุดทองสายฟ้า-แดงเลือดนก (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a
// #6d0804 #5c0000 #430000 #fdf0e2 #f8d2bb) ชุดทองอวกาศ-เงินโครเมียม (#fbc134
// #ffe87a #cf9a18 #96690a #6b4a05 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406
// #432b03 #382400 #241700) ชุดเขียวป่า-ทองมงกุฎ (#8ce023 #f2c230 #ffe066 #a87a08
// #bde397 #e9f7d6 #0f2e05 #051400) ชุดแดงเสือโคร่ง-ทองถ่านไฟ (#e8232a #f2b705
// #ffd666 #c08a0b #fbe8d5) และชุดม่วงนีออน-ทอง (#a435f0 #fbe455 #efe6ff #ffd23d
// #5b1a75 #1e0a3c #ece2ff) ออกครบทุกจุดแล้ว — รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีเขียว
// ไม่มีม่วง และไม่มีส้ม
// ⚠️ เงินโครเมียมของรอบทองอวกาศคือ #cfd6e3 / #9aa6bb ซึ่ง **ไม่ใช่** เงินของรอบนี้
// (#b9c2cc / #8792a0) — "มีเงินอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f0e8d4] via-[#b9c2cc] to-[#e5a81b] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(229,168,27,0.35)]">
      เสียงตอบรับจาก <span class="text-[#e5a81b]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e5a81b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#e5a81b]/50 bg-[#231c0e]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffe08a]/70 hover:shadow-[0_15px_40px_rgba(229,168,27,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#b9c2cc]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#b9c2cc]/36" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#43300a] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffe08a]/50 drop-shadow-[0_0_5px_rgba(229,168,27,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ffe08a] drop-shadow-[0_0_5px_rgba(229,168,27,0.8)]" : "text-[#7d5a07]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f0e8d4] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#43300a]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e5a81b]/40 bg-gradient-to-br from-[#17130a] to-[#0d0b06] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffe08a] transition-colors group-hover:text-[#f0e8d4]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#8792a0] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
