---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
// ตรวจแล้วรอบนี้: ไม่มี <h1>-<h6> hardcode ในไฟล์นี้ · <section> มี aria-label ·
// รูปเดียวในไฟล์นี้คืออีโมจิอวาตาร์ซึ่งเป็น **ของตกแต่งล้วน** จึงอยู่ในกล่อง
// aria-hidden="true" ของตัวเอง ไม่ใช่ <img> ที่ต้องมี alt
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของ **สบาย168**
// (สล็อตเบทต่ำ-ทุนน้อย) และก่อนหน้านั้นเป็นคำของ **โปรดี168** **สาธุ168** (หวยล้วน)
// **ดวงเศรษฐี168** (สอนเล่นเกม) **รวยเทพ168** (สล็อต) กับ **ufalion168** (บอล)
// ⚠️ คำที่ต้องออกให้หมดเพราะเป็นของแบรนด์อื่น ไม่ใช่ของบรีฟรอบนี้: **เบทต่ำ ·
// สบายเป๋า · ทุนน้อย · เล่นง่าย · งบประมาณ · ยอดเดิมพันขั้นต่ำ · ปรับระดับการเดิมพัน**
// (สบาย168) · **เจ้าดัง · ไม่ผ่านม้า · บัญชีม้า · ค่ายแท้ · ถูกลิขสิทธิ์100% ·
// ทดลองเล่นฟรี · โหมดทดลองเล่น** (พักยก168 — แบรนด์ขาออก) · **แทงบอล · ฟุตบอล ·
// ราคาต่อรอง · ค่าน้ำ · บาคาร่า · เกมไพ่ · เว็บตรง100% · ไม่มีขั้นต่ำ** (ยูฟ้า168) ·
// **หวย · ตรวจหวย · แนวทาง · สลาก · เลขเด็ด · 3 ตัว 1,000** (แบรนด์หวย) ·
// **คาสิโน · ยิงปลา · ไฮโล · เว็บตรง** ซึ่งไม่มีในบรีฟนี้เลย
//
// บรีฟรอบนี้ครอบคลุมแค่: **เกมสล็อตออนไลน์มากกว่า 1,000 เกม จากค่ายมาตรฐานสากล**
// (สล็อตคลาสสิก เกมแนวผจญภัย เกมที่มีฟีเจอร์โบนัส และสล็อตที่ใช้สัญลักษณ์พิเศษใน
// การกำหนดผลรางวัล พร้อมตารางจ่ายรางวัลและค่า RTP ที่ผู้พัฒนาเปิดเผย); โปรโมชั่น
// สองรายการ (คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และ แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด);
// ขั้นตอนสมัครสมาชิก 3 ขั้นตอน; และช่องทางติดต่อแอดมิน 24ชม. — ไม่มีอะไรนอกนี้
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: จำนวนเกมที่เปิดให้บริการจริงอาจ
// เปลี่ยนแปลงได้ · ควรตรวจสอบรายชื่อค่ายเกมรวมถึงสถานะลิขสิทธิ์จากข้อมูลทางการ ·
// ค่า RTP เป็นค่าทางสถิติระยะยาว ไม่ใช่การรับประกันผลตอบแทนของการเล่นแต่ละครั้ง ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
// ผลกำไรในอนาคต · ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยงบัญชี
// แอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการให้
// บริการจริงจากประกาศล่าสุดอีกครั้ง
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล **ชื่อธนาคาร ชื่อค่ายเกม**
// ตัวเลขค่า RTP ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟไม่ได้ระบุไว้สักข้อ
// **ตัวเลขที่อ้างได้มีหกตัวเท่านั้น: 1,000 เกม · 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน ·
// 100%** ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนใน
// ไฟล์นี้
const reviews = [
  {
    name: "ผู้ใช้งานที่ไล่อ่านตารางจ่ายรางวัลก่อนเลือกเกม",
    role: "เทียบรูปแบบเกมกับค่า RTP ที่ผู้พัฒนาเปิดเผย",
    stars: 4,
    content: `เปิดหน้า ${BRAND_NAME} มาเพราะอยากได้ที่ที่รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายมาตรฐานสากลไว้ให้ไล่ดูเทียบกันได้ในที่เดียว เว็บไซต์ระบุว่ามีเกมสล็อตให้เลือกมากกว่า 1,000 เกม ครอบคลุมทั้งสล็อตคลาสสิก เกมแนวผจญภัย เกมที่มีฟีเจอร์โบนัส และสล็อตที่ใช้สัญลักษณ์พิเศษในการกำหนดผลรางวัล ผมเลยไล่อ่านรูปแบบเกม ตารางจ่ายรางวัล และค่า RTP ที่ผู้พัฒนาเปิดเผยให้ครบก่อนเลือกใช้งานจริง หัก 1 ดาวตรงที่ต้องกดเข้าไปอ่านหลายจุดกว่าจะครบ ถ้ารวมรายละเอียดของแต่ละเกมไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้ อีกเรื่องที่หน้าเว็บเขียนกำกับไว้เองและผมว่าควรอ่านให้จบคือ จำนวนเกมที่เปิดให้บริการจริงอาจเปลี่ยนแปลงได้ ควรตรวจสอบรายชื่อค่ายเกมรวมถึงสถานะลิขสิทธิ์จากข้อมูลทางการ และค่า RTP เป็นค่าทางสถิติระยะยาว ไม่ใช่การรับประกันผลตอบแทนของการเล่นแต่ละครั้ง`,
    avatar: "🔍",
  },
  {
    name: "สมาชิกที่เทียบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์",
    role: "ตรวจยอดที่นำมาคำนวณและรอบสรุปยอดเครดิต",
    stars: 4,
    content:
      "เข้ามาดูหน้าโปรโมชั่นเป็นหลัก ที่ระบุไว้มีสองรายการคือคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน กับโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด ก่อนกดรับสิทธิ์ผมไล่เช็กว่าเกมสล็อตประเภทไหนเข้าร่วมรายการบ้าง รอบสรุปยอดอยู่ช่วงเวลาใด เครดิตเข้าให้เองหรือต้องกดรับด้วยตนเอง และมีข้อกำหนดอะไรเรื่องการนำเครดิตไปใช้กับการถอนเงิน ฝั่งแนะนำเพื่อนก็ต้องดูวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ชัดเจน ข้อที่ชอบคือหน้าเว็บเขียนกำกับไว้เองว่าเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต และแม้จะระบุว่ากดรับได้ไม่จำกัด ก็ยังควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง จำนวนบัญชีที่เข้าร่วม รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดอยู่ดี ส่วนที่ยังอยากให้เพิ่มคือสรุปเงื่อนไขของทั้งสองรายการไว้เทียบกันในที่เดียว เพราะตอนนี้ต้องเปิดอ่านทีละประกาศ",
    avatar: "🎁",
  },
  {
    name: "ผู้ที่ตรวจที่อยู่เว็บไซต์ให้ถูกต้องก่อนกรอกข้อมูลทุกครั้ง",
    role: "สมัครครบ 3 ขั้นตอนแล้วค่อยเข้าดูรายละเอียดเกม",
    stars: 5,
    content: `ใช้งานฝั่งสมัครสมาชิกเป็นหลัก ขั้นตอนที่เขียนไว้มี 3 ขั้นตอนและผมทำตามครบ เริ่มจากตรวจที่อยู่เว็บไซต์ให้ถูกต้องแล้วเข้าหน้าสมัครสมาชิก อ่านเงื่อนไขการเปิดบัญชีกับนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล จากนั้นกรอกข้อมูลตามที่ระบบกำหนด ตรวจความถูกต้องก่อนยืนยันบัญชี และตั้งรหัสผ่านที่คาดเดาได้ยากโดยไม่ใช้ข้อมูลของบุคคลอื่น ก่อนเริ่มควรดูคุณสมบัติผู้สมัคร อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการให้ครบ พอเข้าสู่ระบบได้ก็ไปไล่ดูรายชื่อเกมสล็อต กติกาการเล่น อัตราจ่าย และรายละเอียดโปรโมชั่นที่เปิดให้บริการ มีรอบหนึ่งที่ผมสงสัยเรื่องรายการฝากถอน ก็เตรียมหมายเลขรายการกับหลักฐานที่เกี่ยวข้องไว้ แล้วติดต่อแอดมินผ่านช่องทางที่เช็กจากเว็บไซต์ทางการของ ${BRAND_NAME} ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง เรื่องก็จบตรงนั้น เจ้าหน้าที่ไม่เคยถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง และถึงจะเขียนว่าดูแลตลอด 24ชม. ก็ยังควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง ให้เต็มไปเลย`,
    avatar: "📝",
  },
];

// ───────────────────────────────────────────────────────────────────────────
// เงินทอง168 (ดรอป 2026-10-22, .claude/brand-spec-ngernthong168.md §2) —
// **ทองนำ · ครีมอุ่นเป็นวัสดุที่สอง · บนน้ำตาลโอลีฟเข้ม**
// การ์ดรีวิวยังอยู่ที่ไฟล์ฐานนี้เหมือนรอบก่อนหน้าหนึ่งรอบ แต่ **รอบขาออก (พักยก168)
// ใช้ ReviewCardSumo2** จึงหมุนกลับมาที่ไฟล์นี้ และไฟล์นี้ยังถือพาเลตต์ **ฟ้าสกาย-
// ทองคานารีธีมสว่างของ สบาย168** อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
// ⚠️⚠️ **รอบนี้เป็นธีมมืด**: bg.json = {"mode":"color","color":"#29210f"} น้ำตาล
// โอลีฟเข้ม และ §2 จัด review cards ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** การ์ดจึงเป็น
// **ผิวกลาง #332810 บนพื้นเพจ #29210f** พร้อมหมึก **ครีมอุ่น #ecd5c4** (10.3:1 บน
// การ์ด = BRAND_TEXT) — **ห้าม "แก้" กลับไปเป็นการ์ดขาวบนพื้นพาสเทลอย่างรอบก่อนหน้า**
// ลำดับความลึก: #3d3016 ยก / #332810 กลาง / #201906 อินเซ็ต / #29210f พื้นเพจ
//
// แบรนด์มีสองวัสดุจริงตามอาร์ตเวิร์ก — **ทองนำ** (ตราชั่งในโลโก้ คำว่า "เงินทอง"
// สามมิติ ทองคำแท่ง ประตูเซฟทองเหลือง โคมระย้า และเลข 0.3% / 0.8% บนป้ายของสไลด์)
// และ **ครีมอุ่นรอง** (ชุดซาตินสีงาช้างของนางแบบ ซึ่งเป็นค่าที่มี share มากที่สุด
// ใน slide1.png ทั้งใบ)
// ⚠️⚠️ **วัสดุที่สองคือครีม ไม่ใช่เทาโครเมียม** — เลข "168" เป็นโครเมียมในโลโก้ก็จริง
// แต่แรมป์เทาเงิน e0e0df c0c0bf a1a09e เป็นของ **พักยก168 ซึ่งเป็นแบรนด์ขาออกรอบนี้
// พอดี** และ e8ecf1 a8b2bf 78828f 5a6472 เป็นของยูฟ้า168 **ห้ามเอาเทาเงินเข้ามาใน
// ไฟล์นี้** นี่คือหนึ่งในสองตัวที่แยกรอบนี้ออกจากรอบก่อนทันที
// ⚠️ **หัวแถบของวิดเจ็ตนี้นั่งบนพื้นเพจ ไม่ใช่บนการ์ด** จึงคิดคอนทราสต์กับ #29210f:
// ทองแกน #f5ba14 = 8.7:1 ✓ และครีมอุ่น #ecd5c4 = 12.1:1 ✓ — **หัวแถบจึงเป็นตัวอักษร
// ทึบสองค่า ไม่ใช่ bg-clip-text ไล่เฉด** เพราะบนหน้าเดียวกันมีหัวข้อไล่เฉดอยู่แล้ว
// สี่กล่อง และ §2 สงวน **ทองสว่าง #fcee52 ไว้ให้ heading กับ <strong> เท่านั้น**
// ซึ่งหัวแถบนี้เป็น <p> จึงไม่ใช้
// การ์ดแยกชั้นด้วยสเกลทองตรงๆ: เครื่องหมายคำพูดเป็นทองแกน ชื่อผู้รีวิวเป็นทองแกน
// ออรามุมการ์ดเป็น **ทองแกนโปร่ง** ขอบการ์ดไต่จากทองลึก #b37c0b ไปทองแกน #f5ba14
// ตอน hover
// ⚠️ **ดาวเป็นทองแกน #f5ba14 (8.1:1 บนการ์ด) ไม่ใช่ทองลึก** — กลีฟ ★ นับเป็น
// **ตัวอักษร** จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร **#b37c0b ได้แค่ 4.0:1 บน
// การ์ดนี้และ §2 ห้ามมันถือกลีฟบนพื้นมืดไว้ชัด** · ดาวที่ไม่ติดตกไปเป็นหมึกครีม
// #ecd5c4 ที่ opacity ต่ำ แถวดาวตั้งไว้ที่ text-2xl = 24px ซึ่งเป็น large text
// ⚠️ **ไม่มีสีตัวอักษรตอน hover** — hover สื่อด้วยการยกการ์ด เปลี่ยนขอบ และเงา
// ขีดใต้หัวแถบเป็น **ทองแกน** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร จึงใช้ได้
// แผ่นอวาตาร์เป็นผิวไล่ #3d3016 → #201906 ขอบทองแกนโปร่ง เส้นคั่นในการ์ดเป็นทองลึก
// #b37c0b โปร่ง ข้อความรองเป็นครีมมืด #d2b9a4 (7.6:1 บนการ์ด)
// ⚠️ **ทองสว่าง #fcee52 สงวนไว้ให้ heading กับ <strong> ในย่อหน้าของหน้าเพจ** ตาม §2
// จึงไม่โผล่ในไฟล์นี้เลย
// rgba() ที่อนุญาตรอบนี้: rgba(245,186,20,α) · rgba(252,238,82,α) ·
// rgba(236,213,196,α) · rgba(32,25,6,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทองเคยผ่านรีโปนี้มาแล้วเกือบทุกเจ้า
// และรอบนี้เป็นทองนำสองรอบติดกัน** "มีทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ต้องเทียบ
// ทีละหลัก: ทองรอบนี้ **#f5ba14 (R245 G186 B20)** กับ **#fcee52 (R252 G238 B82)**
// วัดจาก logo.webp เอง
// ⚠️⚠️ **ไม่ใช่ eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6
// d6c6a8 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04 4e2f11 ของ พักยก168 ซึ่งเป็น
// แบรนด์ขาออก** (eeae12 ห่างแค่ R7/G12/B2 · fded41 ห่างแค่ R1/G17/B17 · 291d0f
// ห่างจากพื้นเพจ #29210f แค่ 4 ที่เขียว) ไม่ใช่ f7c92b ffe6a3 ของ ขวัญใจ168 (ห่างแค่
// R2/G15/B23) ไม่ใช่ fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 ของ
// ยูฟ้า168 และไม่ใช่ e5a81b ffe08a bb8410 7d5a07 8792a0 b9c2cc 464f5a ของ UFA324
// ไฟล์นี้เพิ่งถือชุด **ฟ้าสกาย-ทองคานารีธีมสว่าง** ของ **สบาย168** มาทั้งไฟล์
// (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504 ffffff f2fbff
// dff4fd ccf7ff 2a1f02 กับ rgba 44/195/252 α) rgba 6/58/87 α)) ออกครบทุกค่าแล้ว
// เช่นเดียวกับชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** (eb0305 e40303 c20305 9b0a0c
// ff4446 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802
// 401107) ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดทองน้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168**
// (f0c878 fff8d8 d9212a 8e1a16 4e2120 300605 150303) ชุดทองจักรพรรดิของ **รวยเทพ168**
// (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec) ชุดบรอนซ์-ทอง
// อำพันของ **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304
// 0a0601 5a3310 1a1000) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505
// e81313 dcb95f b8862b 96681f ffeee8 fff1ef ffdbdb c99a3f) ชุดฟ้า-ทองของ
// **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16) และชุดฟ้าไซยาน-เหลือง
// มะนาวของ **นินจา168** (32bcfb a9e9ff fef54b 07335f 6b5c10)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีม่วง ไม่มีเขียว ไม่มีฟ้า/น้ำเงิน
// ไม่มีส้ม ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และ ⚠️⚠️ ไม่มีแรมป์เทาเงิน**
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f5ba14] uppercase">
      เสียงตอบรับจาก <span class="text-[#ecd5c4]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5ba14] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#b37c0b] bg-[#332810] p-8 shadow-[0_10px_30px_rgba(0,0,0,0.45)] transition-all duration-500 hover:-translate-y-2 hover:border-[#f5ba14] hover:shadow-[0_15px_40px_rgba(245,186,20,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#f5ba14]/20 blur-[50px] transition-all duration-500 group-hover:bg-[#f5ba14]/40" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#b37c0b]/60 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#f5ba14]">
                "
              </span>
              <div class="flex gap-1 text-2xl">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f5ba14]" : "text-[#ecd5c4]/20"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#ecd5c4] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#b37c0b]/60 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f5ba14]/50 bg-gradient-to-br from-[#3d3016] to-[#201906] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f5ba14]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d2b9a4] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
