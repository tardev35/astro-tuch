---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what GODBET88's brief supports: การถอนได้ทันที
// โดยไม่ต้องทำยอดเทิร์นโอเวอร์, การสั่งถอนได้ตลอดเวลาโดยไม่จำกัดรอบบิลต่อวัน,
// เดิมพันเริ่มต้น 1 บาท กับฝาก-ถอนไม่มีขั้นต่ำ, เกมสล็อตลิขสิทธิ์แท้จาก PG SLOT
// Pragmatic Play Joker Gaming และ JILI, โปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย
// 0.3%, ระบบสมัครออโต้สามขั้นตอน, และแอดมินบน Line Official 24 ชั่วโมง. No
// licence claim, no member count, no promised profit.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บสล็อต",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามสามขั้นตอนที่หน้าเว็บบอกไว้ กรอกเบอร์รับ OTP ผูกบัญชีธนาคารชื่อเดียวกับผู้สมัคร แล้วตั้งรหัสผ่าน ใช้เวลาไม่ถึงนาทีจริง เข้าไปแล้วเลือกค่ายเกมได้จากบัญชีเดียว ทั้ง PG SLOT, Pragmatic Play, Joker Gaming และ JILI หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามถึงโปรโมชั่นมากที่สุด หน้านี้แยกไว้สองรายการคือแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ในทุกรอบบิล กดรับสิทธิ์ได้เองผ่านหน้าเว็บและตรวจยอดที่เข้าเกณฑ์จากบัญชีตัวเองได้ แต่ละรายการมีเงื่อนไขไม่เหมือนกัน ต้องกดอ่านรายละเอียดก่อนรับสิทธิ์อีกครั้ง",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ชอบที่ทุนน้อยก็ฝากเข้ามาปั่นได้ เบทเริ่มต้น 1 บาทและฝาก-ถอนไม่มีขั้นต่ำ พอเล่นได้แล้วกดถอนออกได้ทันทีโดยไม่ต้องทำยอดเทิร์น แล้วยังสั่งถอนซ้ำในวันเดียวกันได้อีกเพราะไม่จำกัดรอบบิล ตอนถามเรื่องรอบคำนวณโปร แอดมิน GODBET88 บน Line ตอบกลับในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "🧾",
  },
];

// GODBET88 palette: cards are the card surface (#0a0806) inside a primary-gold
// hairline (#c2a55c) on the page black, with the quote mark, the filled stars
// and the reviewer name stepping up to the sheen (#f6e7b8) and light
// (#e2c87f) golds. Unfilled stars fall back to deep gold at low opacity rather
// than a grey, so nothing on the card leaves the one hue. This file was left
// uncleaned as inventory for several brands, so it was rewritten whole rather
// than patched — the previous brand's olive-gold set and its off-brief
// บาคาร่า/บอล/หวย/ไฮโล copy are both gone.
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ GODBET88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#9a7f3f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(194,165,92,0.2)]">
      เสียงตอบรับจาก <span class="text-[#ece1cc]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c2a55c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#c2a55c]/50 bg-[#0a0806]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f6e7b8]/70 hover:shadow-[0_15px_40px_rgba(194,165,92,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#9a7f3f]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#c2a55c]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#c2a55c]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#f6e7b8]/50 drop-shadow-[0_0_5px_rgba(246,231,184,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#e2c87f] drop-shadow-[0_0_5px_rgba(226,200,127,0.8)]" : "text-[#9a7f3f]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#ece1cc]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f6e7b8]/30 bg-gradient-to-br from-[#9a7f3f] to-[#050403] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f6e7b8] transition-colors group-hover:text-[#e2c87f]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#b9ad98] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
