---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what the 1SS365 brief supports: เกมสล็อตออนไลน์
// จากแพลตฟอร์มต่างประเทศ รวมเกมหลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว ทั้งสล็อตคลาสสิก
// ฟรีสปิน ตัวคูณ และเกมโบนัส, เข้าเล่นผ่านมือถือโดยไม่ต้องสลับหลายเว็บไซต์, ตรวจสอบ
// ค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว, ขั้นต่ำและสูงสุดต่างกัน
// ตามค่ายและเกม, คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบ,
// สมัครผ่านมือถือ 3 ขั้นตอน, แอดมิน 24 ชั่วโมง และห้ามส่งรหัสผ่าน PIN หรือ OTP ให้
// บุคคลอื่น พร้อมคำกำกับของบรีฟเองว่าแตกง่าย/จ่ายไวเป็นลักษณะเชิงโฆษณา
//
// No licence claim, no bank name, no operator name, no game name, no provider
// name, no member count, no founding year, no RTP figure, no promised profit —
// the brief names none of them. The gold-and-silver copy earlier holders of this
// file carried for NATO168 is gone, and so is the lottery vocabulary (หวย โพย
// งวด อัตราจ่าย เลข 2 ตัว/3 ตัว ฮานอย ลาวพัฒนา หวยหุ้น) from the round after it.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชีสมาชิก จากนั้นเลือกค่ายและเกมสล็อตที่ต้องการพร้อมตรวจสอบช่วงเดิมพันและโปรโมชั่นก่อนเริ่มเล่น เปิดจากเบราว์เซอร์บนคอมพิวเตอร์ก็ได้หน้าเดียวกัน ไม่ต้องสลับหลายเว็บไซต์ หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่าเดิมพันไม่มีขั้นต่ำกับไม่ติดสแกมมากที่สุด หน้านี้เขียนไว้ตรงๆ ว่ายอดขั้นต่ำและสูงสุดขึ้นอยู่กับค่ายและเกมที่เลือก จึงไม่ควรถือว่าทุกเกมเหมือนกันทั้งหมด และการเป็นเว็บต่างประเทศหรือไม่ผ่านเอเย่นต์เพียงอย่างเดียวก็ไม่ได้รับประกันความปลอดภัย 100% ซึ่งตรงกับที่เราแนะนำอยู่แล้วว่าให้เปิดข้อมูลเกมและดูเงื่อนไขจากบัญชีตัวเองก่อนทุกครั้ง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "เลือกได้ทั้งสล็อตคลาสสิก เกมที่มีฟรีสปิน ตัวคูณ ไปจนถึงเกมโบนัส จากบัญชีเดียว ไม่ต้องสลับหลายเว็บไซต์ ค้นหาเกม ตรวจเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียวจริง ส่วนคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด ก่อนกดรับก็ยังต้องดูรอบตัดยอดและค่ายเกมที่ร่วมรายการเองอยู่ดี ถามแอดมิน 1SS365 ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🔄",
  },
];

// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): การ์ดเป็นผิวการ์ดดำอมทอง #121010 ในเส้น
// ไรผมทองแบรนด์ #edbb23 บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อผู้รีวิวไต่ขึ้น
// เป็นทองอ่อน #ffeeb4 กับทองแบรนด์ ตามเหรียญเลข 1 และเลข 365 ที่เป็นทองบนโลโก้ ส่วน
// ออร่ามุมการ์ดกับขอบรูปโปรไฟล์เป็นเงินโครเมียม #c8cbce ตามตัวอักษร 1SS ที่เป็นเงิน
// การ์ดจึงพาสองโลหะของโลโก้มาครบโดยไม่ต้องใช้สีนอกพาเลตต์ ดาวที่ไม่ติดตกไปเป็นทองลึก
// #a87708 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่เงิน → ทองอ่อน → ทองลึก พร้อมคำว่า
// ผู้ใช้งานจริง เป็นไฮไลต์เงิน ข้อความรองใช้ #cfc2a6 เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#edb543 #fde8a8 #a9761f #e6e6e6
// #101010 #3a2a0d #241a09 #070707 #bdb49f #f4ead3) ออกครบทุกจุดแล้ว พร้อมกับ copy
// ของบรีฟรอบก่อน
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#c8cbce] via-[#ffeeb4] to-[#a87708] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(237,187,35,0.35)]">
      เสียงตอบรับจาก <span class="text-[#c8cbce]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#edbb23] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#edbb23]/50 bg-[#121010]/90 p-8 shadow-[0_10px_30px_rgba(5,5,5,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffeeb4]/70 hover:shadow-[0_15px_40px_rgba(237,187,35,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#c8cbce]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#edbb23]/28" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#2a2115] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffeeb4]/50 drop-shadow-[0_0_5px_rgba(255,238,180,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#edbb23] drop-shadow-[0_0_5px_rgba(237,187,35,0.8)]" : "text-[#a87708]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f0e6d2] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#c8cbce]/40 bg-gradient-to-br from-[#2a2115] to-[#050505] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffeeb4] transition-colors group-hover:text-[#edbb23]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#cfc2a6] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
