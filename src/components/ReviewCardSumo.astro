// ⚠️ ฟ้ารอบนี้คือ #039cfa / #c3ebfc / #04366b ไม่ใช่ 32bcfb a9e9ff 07335f (นินจา168)
// 2f9ff5 a8dcff 0b3f78 (สบายเบท168) 0360f3 0292fb 6ec8ff 4fb4ff (TSDET911) 0a84e0
// (HI59) 0193fb 7bcffb (แตกดี168) หรือ cfd9e6 (เงินอมฟ้าของรับตัง168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#039cfa] via-[#c3ebfc] to-[#039cfa] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(3,156,250,0.45)]">
      เสียงตอบรับจาก <span class="text-[#f9a826]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f9a826] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#039cfa]/55 bg-[#0b2d52]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f9a826]/75 hover:shadow-[0_15px_40px_rgba(3,156,250,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#039cfa]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#039cfa]/40" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#04366b] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#c3ebfc]/70 drop-shadow-[0_0_5px_rgba(3,156,250,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f9a826] drop-shadow-[0_0_5px_rgba(249,168,38,0.75)]" : "text-[#c3ebfc]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#e3f2fc] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#04366b]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#704504] bg-gradient-to-br from-[#071e38] to-[#030f1d] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f9a826] transition-colors group-hover:text-[#c3ebfc]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#c3ebfc] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
