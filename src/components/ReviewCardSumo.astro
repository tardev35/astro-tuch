---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what NATO168's brief supports: รวมเกมสล็อตออนไลน์
// สำหรับผู้เริ่มต้นผ่านระบบที่ใช้งานไม่ซับซ้อน, สล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิด
// รองรับในบัญชีเดียว, เข้าเล่นผ่านมือถือโดยไม่ต้องสลับหลายแพลตฟอร์ม, หมวดโบนัสไทม์,
// เกมหลายรูปแบบตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส,
// คำว่ารับโบนัสทุกยูส/ไม่มีล็อคยูสควรอ้างอิงเงื่อนไขจริงของเว็บไซต์, คืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเงื่อนไขตามรอบ, สมัครผ่านมือถือ 3 ขั้นตอน,
// แอดมิน 24 ชั่วโมง และห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// No licence claim, no bank name, no operator name, no game name, no provider
// name, no member count, no founding year, no RTP figure, no promised profit —
// the brief names none of them. The lottery copy earlier holders of this file
// carried (หวย โพย งวด อัตราจ่าย เลข 2 ตัว/3 ตัว ฮานอย ลาว หุ้น) is gone, and so is
// the football and live-casino vocabulary from the rounds before that.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าสู่บัญชี จากนั้นเลือกเกมสล็อตหรือค่ายที่ต้องการพร้อมตรวจสอบโบนัสและรายละเอียดเกมก่อนเริ่มเล่น เปิดจากเว็บเบราว์เซอร์บนคอมพิวเตอร์ก็ได้หน้าเดียวกัน ไม่ต้องสลับหลายแพลตฟอร์ม หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องคำว่ารับโบนัสทุกยูสกับไม่มีล็อคยูสมากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าควรอ้างอิงเงื่อนไขจริงของเว็บไซต์ เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน ไม่ได้เหมารวมว่าทุกคนได้เท่ากันอัตโนมัติ ซึ่งตรงกับที่เราแนะนำสมาชิกอยู่แล้วว่าให้เข้าไปดูรายละเอียดจากบัญชีตัวเองก่อนกดรับทุกครั้ง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "เลือกได้ทั้งสล็อตพีจีและเกมสล็อตจากค่ายอื่นที่เปิดให้บริการจากบัญชีเดียว มีตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส หมวดโบนัสไทม์ช่วยให้ตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วงได้สะดวก ส่วนคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบจะคำนวณจากยอดที่เข้าเงื่อนไขตามรอบที่เว็บไซต์กำหนด ก่อนกดรับก็ยังต้องดูค่ายเกมและรอบตัดยอดเองอยู่ดี ถามแอดมินตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🔄",
  },
];

// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): การ์ดเป็นผิวการ์ดดำสนิท #101010 ในเส้นไรผม
// ทองแบรนด์ #edb543 บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อผู้รีวิวไต่ขึ้น
// เป็นทองอ่อน #fde8a8 กับทองแบรนด์ ตามเลข 168 ที่เป็นทองบนโลโก้ ส่วนออร่ามุมการ์ดกับ
// ขอบรูปโปรไฟล์เป็นเงิน #e6e6e6 ตามคำว่า NATO ที่เป็นเงินเมทัลลิก การ์ดจึงพาสองโทนของ
// โลโก้มาครบโดยไม่ต้องใช้สีนอกพาเลตต์ ดาวที่ไม่ติดตกไปเป็นทองลึก #a9761f ที่ opacity
// ต่ำ ไม่ใช่เทา หัวแถบไล่เงิน → ทองอ่อน → ทองลึก พร้อมคำว่า ผู้ใช้งานจริง เป็นไฮไลต์เงิน
// ข้อความรองใช้ #bdb49f เนื้อความ #f4ead3 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#dc2224 #f4bc5d #ffefc2 #e43434
// #ab0204 #fbe3d4 #2b0909 #0b0202) ออกครบทุกจุดแล้ว พร้อมกับ copy ของบรีฟรอบก่อน
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e6e6e6] via-[#fde8a8] to-[#a9761f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(237,181,67,0.35)]">
      เสียงตอบรับจาก <span class="text-[#e6e6e6]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#edb543] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#edb543]/50 bg-[#101010]/90 p-8 shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fde8a8]/70 hover:shadow-[0_15px_40px_rgba(237,181,67,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#e6e6e6]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#edb543]/28" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#3a2a0d] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fde8a8]/50 drop-shadow-[0_0_5px_rgba(253,232,168,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#edb543] drop-shadow-[0_0_5px_rgba(237,181,67,0.8)]" : "text-[#a9761f]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f4ead3] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e6e6e6]/40 bg-gradient-to-br from-[#241a09] to-[#070707] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#fde8a8] transition-colors group-hover:text-[#edb543]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#bdb49f] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
