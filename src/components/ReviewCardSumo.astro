---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for a
// **เว็บเล่นสล็อตออนไลน์ล้วน** brief (สล็อตปันโปรในตำนาน · ทางเข้าเล่นใหม่ 2026 ·
// สล็อตคลาสสิก · เว็บตรงในตำนาน · เว็บคนนิยมเล่นมายาวนาน · เว็บไซต์เลียนแบบ ·
// สมัคร 3 ขั้นตอน) and before that for เว็บเล่นเกมกีฬาออนไลน์, สล็อตพีจีเว็บเป็ด and
// เดิมพันเริ่มต้น 1 บาท briefs — brand-spec §1 bans every one of those phrases.
//
// THIS brief covers only: a **เว็บลิขสิทธิ์ไทยแท้** running a **ระบบเดิมพันออนไลน์
// ออโต้ทุกประเภท** — a MIXED casino holding บาคาร่า, สล็อต and บอลออนไลน์ in one
// แพลตฟอร์มเดียว, with เมนูจัดการบัญชี · ตรวจสอบเครดิต · ยอดเครดิต · ประวัติธุรกรรม ·
// ยืนยันรายการ · ตารางจ่าย · กติกา · คู่แข่งขัน · อัตราต่อรอง · เกมไพ่ · เกมวงล้อ
// ทั่วไป · ฟรีสปิน · ฟีเจอร์โบนัส; two promotions (คืนยอดเสีย 0.3% เข้ายูสทุกวัน and
// แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด); ระบบฝากถอนเข้าบริษัทเจ้าของโดยตรง; and
// แอดมิน 24 ชั่วโมง — nothing else. There is no รูเล็ต, no ไฮโล, no คาสิโนไลฟ์สด,
// no ยิงปลา, no เสือมังกร and no lottery word anywhere in this brief.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt),
// including its own hedging, which §1 says ships with the copy rather than being
// trimmed for sounding downbeat: ส่วนการระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ควรมีข้อมูล
// ใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้ · ไม่มีเกมประเภทใดรับประกันผลกำไร ·
// ควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง ·
// หากมีการใช้บัญชีบริษัทเจ้าของโดยตรง ควรแสดงชื่อบริษัทหรือนิติบุคคลที่เกี่ยวข้องให้
// ตรวจสอบได้ · การใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด ·
// คำว่าไม่จำกัดควรระบุให้ชัด · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// No licence claim, no regulator, no operator name, no bank name, no game studio
// name, no member count, no founding year, no deposit minimum, no RTP figure, no
// promised return — the brief names none of them. The only figures used are the
// brief's own three: 0.3% · 0.8% · 24 ชั่วโมง. There is no "3 ขั้นตอน", no
// "1 บาท", no "100%" and no year anywhere. The brand name is interpolated from
// BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่เปิดดูทีละหมวดตามที่หน้าเว็บเขียนไว้ หมวดเกมถูกรวมไว้ในแพลตฟอร์มเดียวจริง ทั้งบาคาร่าที่เป็นเกมไพ่ สล็อตที่มีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์โบนัส และบอลออนไลน์ที่มีข้อมูลคู่แข่งขันกับอัตราต่อรองให้ดูก่อนทำรายการ เมนูจัดการบัญชี ตรวจสอบเครดิต และติดตามรายการต่างๆ อยู่ในหน้าเดียวกัน เปิดจากมือถือก็ได้ จากคอมพิวเตอร์ก็ได้ ระบบอัตโนมัติช่วยลดขั้นตอนการทำรายการตามรูปแบบที่เว็บไซต์เปิดให้บริการ หัก 1 ดาวตรงที่หน้าเว็บระบุว่าเป็นเว็บลิขสิทธิ์ไทยแท้ ซึ่งควรมีข้อมูลใบอนุญาตและหน่วยงานที่ออกใบอนุญาตให้ตรวจสอบได้ประกอบไว้ด้วย",
    avatar: "🃏",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเดิมพัน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องโปรโมชั่นมากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า สล็อต หรือบอลออนไลน์ประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจมีข้อกำหนดแตกต่างกัน ตรงกับที่เราแนะนำอยู่แล้วว่าให้อ่านเงื่อนไขของกิจกรรมก่อนกดรับสิทธิ์ อีกข้อที่ชอบคือหน้าเว็บบอกเองว่าไม่มีเกมประเภทใดรับประกันผลกำไร และการเดิมพันทุกประเภทมีความเสี่ยงต่อการสูญเสียเงิน จึงควรศึกษาตารางจ่ายและกติกาของแต่ละเกมให้ครบ เพราะบาคาร่า สล็อต และการเดิมพันฟุตบอลมีวิธีตัดสินผลแตกต่างกัน ส่วนที่ยังอยากให้เพิ่มคือคำว่าไม่จำกัดในกิจกรรมแนะนำเพื่อน ควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `ใช้มาต่อเนื่องเพราะเปิดดูโปรโมชั่นกับยอดเครดิตจากหน้าเดิมได้เลย คืนยอดเสีย 0.3% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบประจำวันที่เว็บไซต์กำหนด พอเป็นรูปแบบโอนโบนัสเข้ายูสก็ตรวจสอบจำนวนโบนัสและประวัติการรับสิทธิ์ได้จากบัญชีเอง แต่ก็ต้องดูเองว่าเวลาตัดยอดคือกี่โมงและเกมที่ร่วมรายการมีอะไรบ้าง ส่วนแนะนำเพื่อนใช้ลิงก์แนะนำแชร์ให้เพื่อนเข้ามาสมัคร พอยอดเข้าเกณฑ์ระบบก็คำนวณ 0.8% ให้ แล้วดูจำนวนเพื่อนที่สมัครกับวิธีคำนวณโบนัสผ่านระบบสมาชิกได้ เรื่องฝากถอนผมเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักทุกครั้งก่อนยืนยันรายการ และเก็บหลักฐานธุรกรรมไว้ตลอด เพราะหน้าเว็บเองก็เขียนไว้ว่าการใช้บัญชีบริษัทไม่ได้รับประกันความปลอดภัยของธุรกรรมทั้งหมด เคยติดเรื่องเข้าสู่ระบบไม่ได้ ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งรายละเอียดปัญหากับเวลาที่เกิดเหตุไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "🏦",
  },
];

// KMD88 (รอบม่วงราชา-ทอง 2026-10-13, brand-spec §2): การ์ดเป็นผิวยก #1d0832 ในเส้นไรผม
// ม่วงแบรนด์ #7505cc บนพื้นเพจ **ดำสนิท #000000** — สว่างกว่าพื้นเพจชัดเจน จึงลอยขึ้นมา
// เหมือนตัวอักษร KMD ม่วงขัดเงาที่ลอยอยู่บนฉากดำประกายม่วง-ทอง
// ⚠️ พื้นเพจดำสนิท จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ผิวจม #0a0213 คือก้นสุด
// แบรนด์มีสองฮิวจริง — ม่วงนำ (ตัวอักษร KMD สามมิติและริบบิ้นแสงม่วง) ทองรอง (เลข 88
// เมทัลลิก วงแหวนทอง มงกุฎทอง ไพ่เอซทอง) — การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ ไม่ใช่
// ด้วย "ช่วงของม่วง" อย่างเดียว: เครื่องหมายคำพูดเป็นม่วงตัวอักษร #c07cff ส่วนชื่อ
// ผู้รีวิวเป็นทองแบรนด์ #e2b33f ที่ไต่ขึ้นเป็นงาช้างอมม่วง #ece2f8 ตอน hover ดาวที่ติด
// เป็นทองแบรนด์พร้อมเรืองแสง rgba(226,179,63,…) ส่วนออรามุมการ์ดเป็นม่วงแบรนด์ที่อิ่ม
// ขึ้นตอน hover และขอบรูปโปรไฟล์เป็นม่วงแบรนด์โปร่งบนพื้นไล่ผิวกลาง #140522 → ผิวจม
// #0a0213
// ดาวที่ไม่ติดตกไปเป็นม่วงหม่น #bba8d4 ที่ opacity ต่ำ ไม่ใช่เทา — §2 ห้าม #3a0565 /
// #2c0349 ถือตัวอักษรทุกขนาด และกลีฟ ★ ก็นับเป็นตัวอักษร
// หัวแถบไล่งาช้างอมม่วง #ece2f8 → ม่วงตัวอักษร #c07cff → ทองแบรนด์ #e2b33f พร้อมคำว่า
// ผู้ใช้งานจริง เป็นไฮไลต์ม่วงอ่อน #d9b8ff — หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ
// ข้อความรองใช้ม่วงหม่น #bba8d4 ซึ่งเป็นสีรองที่ §2 กำหนดไว้อยู่แล้ว (8.4:1)
// เส้นคั่นในการ์ดเป็นม่วงลึกสุด #2c0349 ซึ่ง §2 ห้ามถือตัวอักษรทุกขนาด
// เนื้อความ #ece2f8 (= BRAND_TEXT) — 12.6:1 บนผิวยก
// #ffd45e ถูกสงวนให้ <strong> ในย่อหน้าของหน้าแรก จึงไม่โผล่ในไฟล์นี้เลย
//
// ⚠️ เก้าในสิบสองแบรนด์หลังสุดมีทอง และ WEPLAY168 กับ BPLAY639 เป็นแบรนด์ม่วงมาก่อน
// ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ "ม่วงอยู่แล้ว" หรือ "ทองอยู่แล้ว" ไม่ได้แปลว่า
// เป็นของแบรนด์นี้ ให้เทียบเป็นค่า: ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เคยค้างอยู่ทั้ง
// ไฟล์นี้ (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #4a1038
// #3a0a2a #2e0022 #1c0014) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #8792a0) ชุดทอง
// มังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #1b1307
// #120c04 #070502) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0
// #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดทองเป็ด-ส้มอำพันของ
// DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #f6ecd9
// #d8c69b #1f1709 #171106 #0d0903) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea
// #e8b9d4 #fde8f3 #f5c53d #b3006a #4d002b #4a0b42 #3a0534 #2e002c #210220) ชุดทอง
// สายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a #6d0804
// #fdf0e2) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700)
// ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08 #bde397
// #e9f7d6 #0f2e05 #051400) และชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #c08a0b #fbe8d5) ออกครบทุกจุดแล้ว — รอบนี้ไม่มีเงิน ไม่มีเทา
// ไม่มีเขียว ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีส้ม และไม่มีแดง
// ⚠️ ม่วงของ WEPLAY168 คือ #a435f0 / #d2a6ff / #c9b2e8 และของ BPLAY639 คือ #7e22ce /
// #c4b5fd / #ddd6fe ซึ่ง **ไม่ใช่** ม่วงของรอบนี้ (#7505cc / #b453ff / #c07cff /
// #d9b8ff / #bba8d4) — "มีม่วงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ece2f8] via-[#c07cff] to-[#e2b33f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(117,5,204,0.4)]">
      เสียงตอบรับจาก <span class="text-[#d9b8ff]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7505cc] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#7505cc]/55 bg-[#1d0832]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#b453ff]/75 hover:shadow-[0_15px_40px_rgba(117,5,204,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#7505cc]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#7505cc]/50" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#2c0349] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#c07cff]/70 drop-shadow-[0_0_5px_rgba(117,5,204,0.6)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#e2b33f] drop-shadow-[0_0_5px_rgba(226,179,63,0.8)]" : "text-[#bba8d4]/30"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#ece2f8] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#2c0349]/80 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#7505cc]/50 bg-gradient-to-br from-[#140522] to-[#0a0213] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#e2b33f] transition-colors group-hover:text-[#ece2f8]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#bba8d4] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
