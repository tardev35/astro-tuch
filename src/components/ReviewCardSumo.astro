---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what SUPERMAX168's brief supports: บาคาร่า
// สล็อต บอล หวย และไฮโล ในบัญชีเดียว, การตรวจกติกา อัตราจ่าย และวงเงินก่อนเดิมพัน,
// โปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ตามรอบคำนวณ, ฝากถอนผ่านวอลเลทและ
// ธนาคาร, และแอดมินดูแล 24 ชั่วโมง. No licence claim, no member count, no
// promised profit.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บคาสิโน",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองเข้าใช้งานผ่านมือถือแล้วหมวดเกมแยกชัดเจน ทั้งบาคาร่า สล็อต บอล หวย และไฮโล เข้าสู่ระบบครั้งเดียวสลับหมวดได้เลย ก่อนเริ่มเดิมพันยังกดดูกติกา อัตราจ่าย และวงเงินของเกมนั้นได้ก่อน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บเดิมพัน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามถึงโปรโมชั่นมากที่สุด หน้านี้แยกไว้สองรายการคือแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ตรวจยอดที่เข้าเกณฑ์กับรอบคำนวณได้จากบัญชีตัวเอง แต่ละรายการมีเงื่อนไขไม่เหมือนกัน ต้องกดอ่านรายละเอียดก่อนรับสิทธิ์อีกครั้ง",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ชอบที่เดิมพันได้หลายรูปแบบจากบัญชีเดียว ฝากเครดิตผ่านวอลเลทและธนาคารตามช่องทางที่เปิดรองรับ แล้วตรวจยอด ส่งคำขอถอน และติดตามสถานะเองได้ ตอนรายการถอนค้าง แจ้งเวลากับจำนวนเงินไป แอดมิน SUPERMAX168 ตรวจให้ในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "🧾",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ SUPERMAX168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(236,201,100,0.2)]">
      เสียงตอบรับจาก <span class="text-[#e3e3e4]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecc964] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#d2a43b]/50 bg-[#030201]/90 p-8 shadow-[0_10px_30px_rgba(3,2,1,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ecc964]/70 hover:shadow-[0_15px_40px_rgba(236,201,100,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#ba8219]/18 blur-[50px] transition-all duration-500 group-hover:bg-[#ecc964]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#d2a43b]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ecc964]/50 drop-shadow-[0_0_5px_rgba(236,201,100,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#ecc964] drop-shadow-[0_0_5px_rgba(236,201,100,0.8)]" : "text-[#cbb98d]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="min-h-[100px] text-left text-sm leading-relaxed text-[#f3e6c8]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#ecc964]/30 bg-gradient-to-br from-[#ba8219] to-[#0d0904] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f9e38b] transition-colors group-hover:text-[#ecc964]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#cbb98d] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
