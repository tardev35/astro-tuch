// (e8c86a e9b53c e3bb45 e0b03a dca53a e8a000 d4922c e3a712 f0c878 f5ba14 ffd84d)
// และ **ห้ามใช้ #8a3a12 หรือ #5a2410 เป็นสีดาว** ส่วนดาวที่ไม่ติดตกไปเป็นหมึก
// #fdf0e6 ที่ opacity ต่ำ
// ⚠️ **ไม่มีสีตัวอักษรตอน hover** — hover สื่อด้วยการยกการ์ด เปลี่ยนขอบ และเงา
// ⚠️ ความนูนบนธีมมืด: **เงาฝั่งมืดเป็น rgba(20,3,2,α)** และ **ฝั่งสว่างเป็นประกาย
// ส้มจาง rgba(242,122,26,α)** ห้ามใช้ขาวล้วนเป็นฝั่งสว่าง และ **ไม่มีค่าขาวล้วนใน
// ไฟล์นี้สักตัว** (ขาวรอบนี้ปรากฏได้เฉพาะเป็น highlight sheet บนปุ่ม ซึ่งไฟล์นี้ไม่มี)
// rgba() ที่อนุญาตรอบนี้และใช้จริงที่นี่: rgba(242,122,26,α) · rgba(20,3,2,α)
//
// ⚠️⚠️ **ส้ม/ทอง/น้ำตาลเป็นฮิวนำของหลายแบรนด์ในรีโปนี้มาแล้ว — "เจอส้ม ≠ เป็นของ
// รอบนี้"** ต้องเทียบให้ตรงหกหลัก คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
// e8a000 d4922c e3a712 / e0b03a e3bb45 / e9b53c / dca53a ↔ #e5a92b ·
// c23400 / f2543f e2855c / ff5a5f ↔ #f27a1a #e8620e · 0e0602 2b1608 / 1a0709
// 2a0b0e / 330710 1c050b ↔ #140302 #250604 #2a0a04 · 7a3a0c 6a4a30 / 7a4a0c ↔
// #8a3a12 #5a2410 · fdeee2 e8fbe4 eef7f0 / fdf5f6 ↔ #fdf0e6
// ⚠️ **ชุดเขียวมรกตที่ไฟล์นี้เพิ่งถือไว้ทั้งใบ** (073c1a 0e5424 031b09 010d04
// 1e7033 35a043 3ddc4a eef7f0 9dc2a5 e8c86a + rgba(61,220,74,α) rgba(1,13,4,α))
// **ออกครบทุกจุดแล้ว** เช่นเดียวกับชุดแดง/ชมพูของแบรนด์ขาออก (f7e4e9 fdf5f6
// f7dfe4 eec3cc d98fa0 330710 1c050b 4d0c18 36080f 6b2b33 a30d1a 7a4a0c d2d7dd
// 8a1420 c21325 ef4a5e)
// ✅ สีเชิงความหมายที่ sweep ต้องข้าม (LINE green #00B900 · เขียว success ของฟีด
// รายการ · โลโก้ธนาคาร/ค่ายเกมจริง) **ไม่มีอยู่ในไฟล์นี้** จึงไม่มีอะไรต้องยกเว้น
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1150px] px-4 font-sans">
  <div class="mb-7 flex items-center gap-4">
    <p class="shrink-0 text-2xl font-black tracking-wide text-[#fdf0e6] md:text-3xl">
      เสียงตอบรับจาก <span class="text-[#f27a1a]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-[#8a3a12] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate overflow-hidden rounded-2xl border border-[#5a2410] bg-[#2a0a04] shadow-[0_14px_34px_rgba(20,3,2,0.55)] transition-all duration-500 hover:-translate-y-1 hover:border-[#8a3a12] hover:shadow-[0_20px_44px_rgba(20,3,2,0.7)] md:grid md:grid-cols-[230px_1fr]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-12 -left-12 -z-10 h-36 w-36 rounded-full bg-[#8a3a12]/25 blur-[55px] transition-all duration-500 group-hover:bg-[#8a3a12]/45" />

          <div class="flex flex-col gap-3 border-b border-[#5a2410] bg-[#250604] p-6 md:border-r md:border-b-0">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a3a12] bg-[#3b130b] text-2xl shadow-[inset_0_2px_6px_rgba(242,122,26,0.12)] transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>

            <p class="text-base font-black text-[#f27a1a]">{review.name}</p>
            <span class="text-[11px] font-bold tracking-wider text-[#e0bda4]">{review.role}</span>

            <div class="mt-auto flex items-center gap-1 pt-2 text-lg">
              <span aria-hidden="true" class="flex gap-1">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e5a92b]" : "text-[#fdf0e6]/20"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>
          </div>

          <div class="p-6 md:p-7">
            <p class="text-left text-base leading-relaxed text-[#fdf0e6]">"{review.content}"</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
