// 0.3% · 0.8% · 24 ชั่วโมง ไม่มี "3 ขั้นตอน" ไม่มี "1 บาท" ไม่มี "100%" และไม่มีปี
// ที่ไหน ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
