---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what KINDEE365's brief supports: หวย 4 ประเภท,
// เรท 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100, การตรวจเวลาเปิด-ปิด เลขอั้น และวงเงิน
// ก่อนส่งโพย, ฝากถอนออโต้ผ่านธนาคารและวอลเลท, และเจ้าหน้าที่ 24 ชั่วโมง. No
// licence, no member count, no promised profit.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บหวย",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองส่งโพยผ่านมือถือแล้วหมวดหวยแยกชัดเจน ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ เลือกรอบ กรอกเลข ใส่จำนวนเงิน แล้วเห็นอัตราจ่ายกับเลขอั้นของรอบนั้นก่อนกดยืนยัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บหวย",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามถึงเรทมากที่สุด หน้านี้กำหนดไว้ที่เลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 คำนวณยอดตามเรทได้ตั้งแต่ก่อนส่งโพย ส่วนเวลาเปิด-ปิดของแต่ละประเภทต่างกันจริง ต้องดูรายละเอียดของรอบนั้นอีกครั้งก่อนยืนยัน",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ชอบที่แทงหวยได้หลายประเภทจากบัญชีเดียว ฝากเครดิตผ่านธนาคารและวอลเลทด้วยระบบออโต้ แล้วตรวจยอด ส่งคำขอถอน และติดตามสถานะเองได้ ตอนรายการถอนค้าง แจ้งเวลากับจำนวนเงินไป เจ้าหน้าที่ KINDEE365 ตรวจให้ในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "🧾",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ KINDEE365" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(232,187,74,0.2)]">
      เสียงตอบรับจาก <span class="text-[#a3dbfb]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8bb4a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#1f6fd0]/70 bg-[#02153c]/90 p-8 shadow-[0_10px_30px_rgba(1,11,38,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#e8bb4a]/70 hover:shadow-[0_15px_40px_rgba(232,187,74,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#2b8ae9]/16 blur-[50px] transition-all duration-500 group-hover:bg-[#e8bb4a]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#1f6fd0]/70 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#e8bb4a]/50 drop-shadow-[0_0_5px_rgba(232,187,74,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#e8bb4a] drop-shadow-[0_0_5px_rgba(232,187,74,0.8)]" : "text-[#8fb3d9]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="min-h-[100px] text-left text-sm leading-relaxed text-[#cfe3f7]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e8bb4a]/30 bg-gradient-to-br from-[#1f6fd0] to-[#010b26] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#f8dc8c] transition-colors group-hover:text-[#e8bb4a]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#8fb3d9] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
