---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// ALL THREE REVIEWS WERE REWRITTEN FROM THIS DROP'S BRIEF, not find-and-replaced
// over the previous ones. The copy this file inherited was written for UP555 and
// then rewritten for a สล็อตเบทต่ำ brief (เบทต่ำ, ทุนน้อย, ค่ายตรง, ถูกลิขสิทธิ์,
// ตารางจ่าย, สมัคร 3 ขั้นตอน) — brand-spec §4 bans every one of those words on
// this brand, and this brief names no 3-step signup at all. 789BETTING is a
// คาสิโนฐานเข้าหลัก that carries บาคาร่า รูเล็ต บอล หวย สล็อต side by side, so
// the three cards are written from that brief end to end.
//
// Every line below stays inside what THIS brief supports (src/assets/content.txt):
// คาสิโนฐานเข้าหลักที่รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียว · บาคาร่าและรูเล็ตมีโต๊ะ
// ตามรายการที่เปิดให้บริการ · สล็อตมีเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ · บอลเลือก
// คู่แข่งขันและตลาดเดิมพันตามช่วงเวลา · หวยแบ่งรอบเปิดรับตามประเภท · เลือกเกม ตรวจสอบ
// เครดิต โปรโมชั่น และประวัติการเดิมพันผ่านบัญชีเดียว · Login เพื่อตรวจสอบโบนัส ยอดที่
// เข้าเกณฑ์ และสถานะการรับสิทธิ์ · คืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% คำนวณจากยอดที่
// เข้าเกณฑ์ตามรอบตัดยอด · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
// — พร้อมคำกำกับของบรีฟเองว่า "เดิมพันตรงกับบริษัท 100%" ควรมีชื่อบริษัทหรือนิติบุคคล
// ที่ตรวจสอบได้ · "ฝากถอนได้ทุกช่องทาง" ควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ
// · ควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักก่อนทำรายการ · และควรตรวจสอบ
// ราคา วงเงิน เวลาเปิด-ปิด ก่อนยืนยันการเดิมพัน
//
// No licence claim, no bank name, no operator name, no game name, no provider
// name, no member count, no founding year, no RTP figure, no deposit minimum, no
// promised profit — the brief names none of them. The only figures used are the
// brief's own: 0.3% · 0.8% · 100% · 24 ชั่วโมง.
// The brand name is interpolated from BRAND_NAME, never typed.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่กดดูทีละหมวดตามที่หน้าเว็บบอกไว้ รวมช่องทางเดิมพันหลายประเภทไว้ในระบบเดียวจริง บาคาร่ากับรูเล็ตขึ้นโต๊ะตามรายการที่เปิดให้บริการ สล็อตมีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ ส่วนบอลเลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลา หวยแบ่งรอบเปิดรับตามประเภท ก่อนยืนยันยังกดดูราคา วงเงิน และเวลาเปิด-ปิดของรายการนั้นได้ก่อนทุกรอบ Login ครั้งเดียวสลับหมวดได้หมด เปิดจากมือถือหาเมนูเจอง่าย เปิดจากคอมพิวเตอร์ก็ได้หน้าเดียวกัน หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บคาสิโน",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องข้อความ เดิมพันตรงกับบริษัท 100% มากที่สุด หน้านี้เขียนไว้ตรงๆ ว่าควรมีชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ประกอบ ไม่ควรพิจารณาจากข้อความเพียงอย่างเดียว ตรงกับที่เราแนะนำอยู่แล้วว่าก่อนทำรายการให้เปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลจากช่องทางหลักก่อน และเก็บหลักฐานรายการไว้ทุกครั้ง ส่วนคำว่า ฝากถอนได้ทุกช่องทาง ก็ควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ เพราะธนาคารหรือช่องทางชำระเงินเปลี่ยนแปลงได้",
    avatar: "🛡️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content: `เล่นหลายหมวดสลับกันในบัญชีเดียว เลยชอบที่เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติการเดิมพันได้จากที่เดียว โปรโมชั่นกด Login เข้าไปดูโบนัส ยอดที่เข้าเกณฑ์ และสถานะการรับสิทธิ์ได้เอง ส่วนคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ก่อนกดรับก็ยังต้องดูประเภทเกมและรอบตัดยอดเองอยู่ดี เคยเจอรายการฝากถอนค้างตรวจสอบ ถามแอดมิน ${BRAND_NAME} ตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง แจ้งเวลา จำนวนเงิน และหลักฐานธุรกรรมไปก็ตามให้ครบ ไม่ถามรหัสผ่าน PIN หรือ OTP เลย ให้ไปเลย 5 ดาว`,
    avatar: "🔄",
  },
];

// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2):
// การ์ดเป็นผิวยก #17130a ในเส้นไรผมทองแบรนด์ #fad354 บนพื้นเพจดำตัน รอบนี้แบรนด์มีฮิว
// เดียว ไม่มีโลหะตัวที่สองแบบคู่ทอง-เงินของ UOK365 การ์ดจึงแยกชั้นด้วย "ช่วงของทอง"
// แทน — เครื่องหมายคำพูดกับชื่อผู้รีวิวเป็นทองแชมเปญ #ffe79a ที่ไต่ขึ้นเป็นทองแบรนด์
// ตอน hover ดาวที่ติดเป็นทองแบรนด์ #fad354 พร้อมเรืองแสง rgba(250,211,84,…) ส่วนออรา
// มุมการ์ดเป็นบรอนซ์ #c9881f ที่อิ่มขึ้นเป็นทองแบรนด์ตอน hover และขอบรูปโปรไฟล์เป็นทอง
// แบรนด์โปร่งบนพื้นไล่ผิวกลาง #0e0b05 → ผิวลึกสุด #060402
// ดาวที่ไม่ติดตกไปเป็นทองลึก #8a6410 ที่ opacity ต่ำ ไม่ใช่เทา หัวแถบไล่ทองกลาง #ddab33
// → ทองแชมเปญ #ffe79a → ทองแบรนด์ #fad354 พร้อมคำว่า ผู้ใช้งานจริง เป็นไฮไลต์ทองแบรนด์
// ข้อความรองใช้งาช้างหม่น #b5a888 (8.1:1 บนผิวยก) เนื้อความ #f3e7cd (BRAND_TEXT) —
// 15.0:1 บนผิวยก
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #6d4412
// #d8dbe0 #191108 #120c07 #070504 #ece1cc #b7a58a rgba(200,145,47,…)
// rgba(245,217,138,…)) ออกครบทุกจุดแล้ว — รอบก่อนบังเอิญเป็นทองอีกเฉดหนึ่ง ซึ่งเป็นกรณี
// ที่พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว" ไม่ได้หมายความว่าเป็นทองของแบรนด์นี้
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ddab33] via-[#ffe79a] to-[#fad354] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(250,211,84,0.35)]">
      เสียงตอบรับจาก <span class="text-[#fad354]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fad354] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#fad354]/50 bg-[#17130a]/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#ffe79a]/70 hover:shadow-[0_15px_40px_rgba(250,211,84,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#c9881f]/20 blur-[50px] transition-all duration-500 group-hover:bg-[#fad354]/28" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#4a3407] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffe79a]/50 drop-shadow-[0_0_5px_rgba(255,231,154,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#fad354] drop-shadow-[0_0_5px_rgba(250,211,84,0.8)]" : "text-[#8a6410]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#f3e7cd] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#fad354]/40 bg-gradient-to-br from-[#0e0b05] to-[#060402] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffe79a] transition-colors group-hover:text-[#fad354]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#b5a888] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
