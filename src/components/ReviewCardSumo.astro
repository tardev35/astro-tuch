---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
// ตรวจแล้วรอบนี้: ไม่มี <h1>-<h6> hardcode ในไฟล์นี้ · <section> มี aria-label ·
// รูปเดียวในไฟล์นี้คืออีโมจิอวาตาร์ซึ่งเป็น **ของตกแต่งล้วน** จึงอยู่ในกล่อง
// aria-hidden="true" ของตัวเอง ไม่ใช่ <img> ที่ต้องมี alt
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของ **โปรดี168**
// และก่อนหน้านั้นเป็นคำของ **สาธุ168** (หวยล้วน) **ดวงเศรษฐี168** (สอนเล่นเกม)
// **รวยเทพ168** (สล็อต) กับ **ufalion168** (บอล) ซึ่งพูดถึง **ตารางจ่ายรางวัล /
// ค่ายตรง / ลิขสิทธิ์แท้ / หวยรัฐบาลไทย / หวยฮานอย / สลากกินแบ่ง / รอบปิดรับ /
// อัตราจ่าย / เศรษฐีพนันมือ1 / ผู้สอน / สูตร / เทคนิค / บาคาร่า / ไฮโล / ยิงปลา /
// ฟุตบอล / ราคาต่อรอง / ค่าน้ำ / ปี 2026** — brand-spec §5 ของรอบนี้ระบุว่าบรีฟ
// **ไม่มีคำเหล่านั้นสักคำ** จึงออกทั้งหมด
// ⚠️ **รอบนี้เป็นเว็บสล็อตออนไลน์เบทต่ำล้วน** — "หวย / สลาก / ตรวจหวย / แนวทาง /
// บาคาร่า / คาสิโน / ยิงปลา / ไฮโล / แทงบอล / ฟุตบอล / เว็บตรง100% / ไม่ผ่านม้า /
// ฐานหลัก / ไม่มีขั้นต่ำ" เป็นคำค้างของแบรนด์ก่อน **ห้ามเติมกลับเข้าไปแม้แต่คำเดียว**
//
// บรีฟรอบนี้ครอบคลุมแค่: **เกมสล็อตออนไลน์เบทต่ำจากค่ายต่าง ๆ สำหรับคนทุนน้อย**
// พร้อมเกมสล็อตคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่ปรับระดับการเดิมพันได้;
// โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และ แนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด); ขั้นตอนสมัครสมาชิก 3 ขั้นตอน; และช่องทางติดต่อแอดมิน 24ชม.
// — ไม่มีอะไรนอกนี้
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: ควรตรวจสอบยอดเดิมพันขั้นต่ำของ
// แต่ละเกมและข้อกำหนดการฝากเงินก่อนทำรายการ · ควรตรวจสอบสถานะลิขสิทธิ์ของเกมจาก
// หลักฐานทางการ · แม้เดิมพันด้วยเงินจำนวนน้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงิน ·
// การได้รับเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
// รับประกันผลกำไรในอนาคต · ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการเพื่อหลีกเลี่ยง
// บัญชีแอบอ้าง · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น · ควรตรวจสอบเวลาการ
// ให้บริการจริงจากประกาศล่าสุดอีกครั้ง
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล **ชื่อธนาคาร ชื่อค่ายเกม**
// ค่า RTP ยอดฝากขั้นต่ำเป็นตัวเลข จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟไม่ได้ระบุไว้
// สักข้อ **ตัวเลขที่อ้างได้มีสี่ตัวเท่านั้น: 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน**
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้ใช้งานที่ไล่อ่านยอดเดิมพันขั้นต่ำก่อนเริ่มเล่น",
    role: "เทียบรูปแบบเกมกับงบประมาณของตัวเองก่อนฝากยอด",
    stars: 4,
    content: `เปิดหน้า ${BRAND_NAME} มาเพราะอยากได้ที่ที่รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายต่าง ๆ ไว้ให้ไล่ดูเทียบกันได้ในที่เดียว มีทั้งเกมสล็อตคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่ปรับระดับการเดิมพันได้ ผมทุนน้อยเลยเริ่มจากเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำก่อน แล้วค่อยไล่เช็กยอดเดิมพันขั้นต่ำของแต่ละเกมกับข้อกำหนดการฝากเงินให้ครบก่อนทำรายการ เพราะจำนวนเงินเริ่มต้นแต่ละเกมไม่เท่ากัน หัก 1 ดาวตรงที่ต้องกดเข้าไปอ่านหลายจุดกว่าจะครบ ถ้ารวมรายละเอียดของแต่ละเกมไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้ อีกเรื่องที่หน้าเว็บเขียนกำกับไว้เองและผมว่าควรอ่านให้จบคือ ควรตรวจสอบสถานะลิขสิทธิ์ของเกมจากหลักฐานทางการ และต้องตระหนักว่าแม้เดิมพันด้วยเงินจำนวนน้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงินอยู่ดี`,
    avatar: "🔍",
  },
  {
    name: "สมาชิกที่เทียบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์",
    role: "ตรวจยอดที่นำมาคำนวณและรอบสรุปยอดเครดิต",
    stars: 4,
    content:
      "เข้ามาดูหน้าโปรโมชั่นเป็นหลัก ที่ระบุไว้มีสองรายการคือคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน กับโบนัสแนะนำเพื่อน 0.8% ไม่จำกัด ก่อนกดรับสิทธิ์ผมไล่เช็กว่าเกมสล็อตประเภทไหนเข้าร่วมรายการบ้าง รอบสรุปยอดอยู่ช่วงเวลาใด เครดิตเข้าให้เองหรือต้องกดรับด้วยตนเอง และมีข้อกำหนดอะไรเรื่องการนำเครดิตไปใช้กับการถอนเงิน ฝั่งแนะนำเพื่อนก็ต้องดูวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และยอดที่ใช้คำนวณโบนัสให้ชัดเจน ข้อที่ชอบคือหน้าเว็บเขียนกำกับไว้เองว่าการได้รับเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต และแม้รายการแนะนำเพื่อนจะระบุว่าไม่จำกัด ก็ยังควรยืนยันข้อกำหนดเรื่องจำนวนบัญชีที่เข้าร่วมและรอบจ่ายเครดิตจากประกาศล่าสุดอยู่ดี ส่วนที่ยังอยากให้เพิ่มคือสรุปเงื่อนไขของทั้งสองรายการไว้เทียบกันในที่เดียว เพราะตอนนี้ต้องเปิดอ่านทีละประกาศ",
    avatar: "🎁",
  },
  {
    name: "ผู้ที่ตรวจที่อยู่เว็บไซต์ให้ถูกต้องก่อนกรอกข้อมูลทุกครั้ง",
    role: "สมัครครบ 3 ขั้นตอนแล้วค่อยเข้าดูรายละเอียดเกม",
    stars: 5,
    content: `ใช้งานฝั่งสมัครสมาชิกเป็นหลัก ขั้นตอนที่เขียนไว้มี 3 ขั้นตอนและผมทำตามครบ เริ่มจากตรวจที่อยู่เว็บไซต์ให้ถูกต้องแล้วเข้าหน้าสมัครสมาชิก อ่านเงื่อนไขการเปิดบัญชีกับนโยบายการจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล จากนั้นกรอกข้อมูลตามที่ระบบกำหนด ตรวจความถูกต้องก่อนยืนยันบัญชี และตั้งรหัสผ่านที่คาดเดาได้ยากโดยไม่ใช้ข้อมูลของบุคคลอื่น พอเข้าสู่ระบบได้ก็ไปไล่ดูรายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และเงื่อนไขโปรโมชั่นที่เปิดให้บริการ มีรอบหนึ่งที่ผมสงสัยเรื่องรายการฝากถอน ก็เตรียมหมายเลขรายการกับหลักฐานที่เกี่ยวข้องไว้ แล้วติดต่อแอดมินผ่านช่องทางที่เช็กจากเว็บไซต์ทางการของ ${BRAND_NAME} ก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง เรื่องก็จบตรงนั้น เจ้าหน้าที่ไม่เคยถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง และถึงจะเขียนว่าดูแลตลอด 24ชม. ก็ยังควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง ให้เต็มไปเลย`,
    avatar: "📝",
  },
];

// สบาย168 (ดรอป 2026-10-22, .claude/brand-spec-sabai168.md §2): รอบนี้เป็น
// **ฟ้าสกายนำ · ทองคานารีรอง · ธีมสว่าง** และการ์ดรีวิวกลับมาที่ไฟล์ฐานนี้
// หลังรอบก่อน (ยูฟ้า168) ใช้ ReviewCardSumo2
// ⚠️⚠️ **ธีมสว่าง**: bg.json = {"mode":"color","color":"#ccf7ff"} ฟ้าพาสเทล และ §2
// จัด review cards ไว้ใน **โซนเนื้อหา ไม่ใช่โครม** การ์ดจึงเป็น **ผิวยก #ffffff
// บนพื้นเพจ #ccf7ff** พร้อมหมึก **น้ำเงินหมึก #0f3a4a** (12.2:1 = BRAND_TEXT)
// — **ห้าม "แก้" กลับไปเป็นการ์ดเข้มลอยบนพื้นมืดอย่างรอบก่อน** ลำดับความลึก:
// #ffffff ยก / #f2fbff กลาง / #dff4fd อินเซ็ต / #ccf7ff พื้นเพจ
//
// แบรนด์มีสองฮิวจริงตามอาร์ตเวิร์ก — **ฟ้าสกายนำ** (เลข "168" ในโลโก้ ท้องฟ้าเหนือ
// โรงเรือน และเลข 0.8% บนป้ายไม้ของสไลด์) และ **ทองคานารีรอง** (คำว่า "สบาย"
// สามมิติ ข้อความ "สล็อตเบทต่ำสบายเป๋า" และกองเหรียญทองขอบล่างของสไลด์)
// ⚠️ แต่ **ทองคานารี #fdcb0c กับทองซีด #fefb6b เป็นสีของโครมเท่านั้น** บนการ์ดขาว
// ได้แค่ 1.5–2.4:1 ไฟล์นี้จึง **ไม่มีสองค่านั้นเลยสักจุด**
// ⚠️ **หัวแถบของวิดเจ็ตนี้นั่งบนพื้นเพจ ไม่ใช่บนการ์ด** จึงคิดคอนทราสต์กับ #ccf7ff:
// น้ำเงินหมึก #063a57 = 10.5:1 ✓ และฟ้าลึก #0a7fbd = 3.8:1 ซึ่งผ่านเกณฑ์ large text
// (หัวแถบเป็น text-3xl font-black) — **ด้วยเหตุนี้หัวแถบจึงเป็นตัวอักษรทึบสองค่า
// ไม่ใช่ bg-clip-text ไล่เฉด** เพราะไล่เฉดบนพื้นสว่างจะลากค่าที่อ่านไม่ออกเข้ามาเป็น
// พิกเซลของตัวอักษรได้ง่ายเกินไป
// การ์ดแยกชั้นด้วยสเกลฟ้าตรงๆ: เครื่องหมายคำพูดเป็นฟ้าสกายโปร่ง ชื่อผู้รีวิวเป็น
// #063a57 (7.5:1) ออรามุมการ์ดเป็น **ฟ้าน้ำแข็ง #6bdcfb** ซึ่ง §2 อนุญาตเฉพาะงาน
// ออรา/พื้นถม (ชั้นนี้ไม่มีตัวอักษรวางทับ) ขอบการ์ดไต่จากฟ้าอ่อน #9ae0fa ไปฟ้าสกาย
// #2cc3fc ตอน hover
// ⚠️ **ดาวเป็นฟ้าลึก #0a7fbd ไม่ใช่ทอง** — กลีฟ ★ นับเป็น **ตัวอักษร** จึงต้องเป็น
// ค่าที่ §2 อนุญาตให้ถือตัวอักษรบนพื้นสว่าง #fdcb0c ได้แค่ 1.5:1 และ #2cc3fc ได้ 2.2:1
// ตกทั้งคู่ ส่วน #0a7fbd ได้ 4.2:1 บนผิวยก และแถวดาวถูกตั้งไว้ที่ **text-2xl = 24px
// ซึ่งเป็น large text** จึงผ่าน AA · ดาวที่ไม่ติดตกไปเป็นหมึก #0f3a4a ที่ opacity ต่ำ
// ⚠️ **ไม่มีสีตัวอักษรตอน hover** เพราะค่าที่ "สว่างขึ้น" ในพาเลตนี้คือ #0a7fbd
// (4.2:1) ซึ่งตกเกณฑ์สำหรับชื่อผู้รีวิวที่เป็น text-base bold = 16px — hover จึงสื่อ
// ด้วยการยกการ์ด เปลี่ยนขอบ และเงา ไม่ใช่ด้วยสีตัวอักษร
// ขีดใต้หัวแถบเป็น **ฟ้าสกาย** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร จึงใช้ได้
// แผ่นอวาตาร์เป็นผิวกลางไล่ #f2fbff → #dff4fd ขอบฟ้าสกายโปร่ง เส้นคั่นในการ์ดเป็น
// ฟ้าอ่อน #9ae0fa เนื้อความและข้อความรองเป็น #0f3a4a (= BRAND_TEXT)
// ⚠️ **ทองลึก #8a6504 สงวนไว้ให้ <strong> ในย่อหน้าของหน้าเพจ** ตาม §2 จึงไม่โผล่
// ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ฟ้ากับทองเคยผ่านรีโปนี้มาแล้วหลายเจ้า
// และหนึ่งในนั้นชื่อเกือบซ้ำกับรอบนี้** "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ต้อง
// เทียบทีละหลัก: ฟ้ารอบนี้ **#2cc3fc (R44 G195 B252)** วัดจาก logo.webp เอง
// ⚠️ **ไม่ใช่ 2f9ff5 a8dcff d6ecff 0b3f78 ffc82e ของ สบายเบท168 ซึ่งเป็นคนละลูกค้า
// ที่ชื่อใกล้ที่สุดในรีโปนี้** (worker ของเขาคือ xn---168-9gora7dtd1dwh ส่วนรอบนี้คือ
// xn---168-pho7byc9c) ไม่ใช่ 32bcfb a9e9ff fef54b 07335f ของ นินจา168 (⚠️ 32bcfb
// ห่างแค่ 6 ที่ R และ fef54b ก็ใกล้ทองซีดของรอบนี้มาก) และไม่ใช่ 039cfa 0494f5
// c3ebfc 04366b f9a826 ของ รวยแทร่168
// ไฟล์นี้เพิ่งถือชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** มาทั้งไฟล์ (eb0305 e40303
// c20305 9b0a0c ff4446 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea
// ffd1d1 1a0802 401107 กับ rgba 64/17/7 และ 235/3/5) ออกครบทุกค่าแล้ว เช่นเดียวกับ
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63
// aeb04a 9ba03c d8ffc7 e9fbdd) ชุดทองน้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** (f0c878
// fff8d8 d9212a 8e1a16 4e2120 300605 150303) ชุดทองจักรพรรดิของ **รวยเทพ168**
// (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุด
// บรอนซ์-ทองอำพันของ **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4
// 33200a 1f1304 0a0601 5a3310 1a1000) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168**
// (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef
// ffdbdb c99a3f) และชุดทองคานารี-โครเมียมเงินบนดำสนิทของรอบขาออก **ยูฟ้า168**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
// eae3d4 140e02 0b0d10)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีทองคานารีบนการ์ด**
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#063a57] uppercase">
      เสียงตอบรับจาก <span class="text-[#0a7fbd]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2cc3fc] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#9ae0fa] bg-[#ffffff] p-8 shadow-[0_10px_30px_rgba(6,58,87,0.14)] transition-all duration-500 hover:-translate-y-2 hover:border-[#2cc3fc] hover:shadow-[0_15px_40px_rgba(44,195,252,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#6bdcfb]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#6bdcfb]/45" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#9ae0fa] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#2cc3fc]">
                "
              </span>
              <div class="flex gap-1 text-2xl">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#0a7fbd]" : "text-[#0f3a4a]/20"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#0f3a4a] italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#9ae0fa] pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#2cc3fc]/50 bg-gradient-to-br from-[#f2fbff] to-[#dff4fd] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#063a57]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#0f3a4a] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
