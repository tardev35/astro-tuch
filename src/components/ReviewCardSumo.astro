---
// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บเดิมพัน",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ทดสอบเลือกเกมผ่านมือถือแล้วเมนูจัดกลุ่มตามธีมเกมชัดเจน เปิด Paytable ดูสัญลักษณ์ ฟีเจอร์ และช่วงเดิมพันของแต่ละเกมได้ก่อนกด Spin หน้าฝากถอนโหลดไว หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บสล็อต",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจพูดถึงเกมอย่าง Fortune Tiger, Mahjong Ways 2, Lucky Neko และ Wild Bandito บ่อยที่สุด แต่ละเกมกติกาต่างกันจริง ส่วนโปรโมชั่นแนะนำเพื่อนกับคืนยอดเสียมีเงื่อนไขเขียนไว้ให้อ่านก่อนกดรับ",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ชอบที่เลือกเกมได้จากบัญชีเดียวและเช็กรอบรับโบนัส 0.8% กับคืนยอดเสีย 0.3% ได้จากหน้าโปรโมชั่นเอง ตอนติดปัญหาโปรไม่แสดง แจ้งเวลาและรายละเอียดรายการไปแล้วแอดมิน TIGER88 ตรวจให้ในคืนเดียวกัน ให้ไปเลย 5 ดาว",
    avatar: "🐯",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ TIGER88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#c99a10] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(253,209,33,0.2)]">
      เสียงตอบรับจาก <span class="text-[#ff2a36]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdd121] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#5e0505]/70 bg-[#120404]/90 p-8 shadow-[0_10px_30px_rgba(7,2,2,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fdd121]/70 hover:shadow-[0_15px_40px_rgba(253,209,33,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#ef1622]/16 blur-[50px] transition-all duration-500 group-hover:bg-[#fdd121]/22" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#5e0505]/70 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fdd121]/50 drop-shadow-[0_0_5px_rgba(253,209,33,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#fdd121] drop-shadow-[0_0_5px_rgba(253,209,33,0.8)]" : "text-[#d6bf95]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="min-h-[100px] text-left text-sm leading-relaxed text-[#f2e3c9]/85 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#fdd121]/30 bg-gradient-to-br from-[#ef1622] to-[#070202] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffe98a] transition-colors group-hover:text-[#fdd121]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d6bf95] uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
