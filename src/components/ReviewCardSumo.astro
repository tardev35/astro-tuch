---
import { BRAND_NAME } from "../lib/brandProfile";

// การ์ดรีวิวที่ "มองเห็น" เท่านั้น — **ไม่มี** Review / AggregateRating JSON-LD
// ที่ไหนเลยโดยตั้งใจ verify-build ทำให้ build แดงถ้ามี และการมาร์กอัปรีวิวที่เขียน
// ขึ้นเองเป็น structured data บนหน้า YMYL คือการประกาศข้อมูลที่ไม่มีอยู่จริง
// แถวดาวเป็นของตกแต่ง (aria-hidden) และมีประโยค sr-only กำกับความหมายแทน
// หัวแถบเป็น <p> ส่วน <section> ถือ aria-label — วิดเจ็ตนี้จึง **ไม่ปล่อย heading tag
// ระดับไหนเลย** และห้ามอัป <p> นั้นเป็น h2 เพื่อ "แก้" accessibility เพราะจะทำให้
// การนับหัวข้อเทียบบรีฟของทุกรอบรีแบรนด์ถัดไปพัง
//
// รีวิวทั้งสามใบถูก **เขียนใหม่จากบรีฟของดรอปนี้** (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับของเดิม ของที่ไฟล์นี้รับมาเขียนไว้สำหรับบรีฟของ **มีโชค168**
// ซึ่งพูดถึง **ลิขสิทธิ์แท้ / นำเข้าตรงจากสิงคโปร์ / PG SOFT / JOKER / JILI /
// 3 ค่ายหลัก / ตารางการจ่ายรางวัล** — brand-spec §6 ของรอบนี้ห้ามทุกคำในชุดนั้น
// **บรีฟรอบนี้ไม่ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** จึงใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ
//
// บรีฟรอบนี้ครอบคลุมแค่: **เว็บสล็อตทางการ ผู้ให้บริการฐานเกมหลัก เว็บแท้อันดับ1**
// ที่รวบรวม สมัครสมาชิก / เข้าสู่ระบบ / ฝากถอน / โปรโมชั่น ไว้ในเว็บไซต์เดียว;
// โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และ แนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด); ขั้นตอนสมัครสมาชิกสามขั้น; และช่องทาง LINE Official 24ชม. — ไม่มีอะไร
// นอกนี้ ไม่มีหมวดเกมอื่น และ **ไม่มีคำเกี่ยวกับคาสิโน กีฬา หรือหวยที่ไหนเลย**
//
// ทุกบรรทัดด้านล่างอยู่ในขอบเขตที่บรีฟรองรับ รวมถึง **ประโยคกำกับ (hedge) ของบรีฟเอง
// ที่ต้องติดมาด้วย** ไม่ใช่ตัดออกเพราะฟังดูไม่ขาย: ควรตรวจสอบข้อมูลผู้ให้บริการและ
// ความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้ก่อนใช้งาน · คำกล่าวอ้างเกี่ยวกับการเป็น
// เว็บหลักหรือเว็บอันดับหนึ่ง ควรพิจารณาร่วมกับหลักฐานการอนุญาตและความคิดเห็นจาก
// ผู้ใช้งานหลายแหล่ง · ควรอ่านรายละเอียดโปรโมชั่นก่อนเข้าร่วมและสอบถามเจ้าหน้าที่
// หากมีข้อสงสัย · เครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพัน ·
// แม้ระบุว่าไม่จำกัด แต่ควรยืนยันรายละเอียดจากประกาศล่าสุด · ควรเพิ่มเพื่อนผ่านลิงก์
// หรือ QR Code จากเว็บไซต์ทางการเท่านั้น · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
//
// ไม่มีการอ้างเลขใบอนุญาต ชื่อผู้กำกับดูแล ชื่อนิติบุคคล ชื่อธนาคาร ค่า RTP ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือชื่อค่ายเกมใดๆ — บรีฟไม่ได้ระบุไว้สักข้อ
// ตัวเลขที่อ้างมีแค่ของบรีฟเอง: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม. · อันดับ1
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ ไม่พิมพ์ตรงๆ และไม่มีโดเมนในไฟล์นี้
const reviews = [
  {
    name: "ผู้ที่ศึกษาข้อมูลก่อนเริ่มใช้งาน",
    role: "ไล่อ่านรายชื่อค่ายเกมและกติกาก่อนเลือกเกม",
    stars: 4,
    content: `เปิดหน้าเว็บ ${BRAND_NAME} มาเพราะอยากรู้ว่าเกมสล็อตออนไลน์ที่เปิดให้บริการมีอะไรบ้าง สิ่งที่ถูกใจคือข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน และโปรโมชั่น ถูกรวบรวมไว้ในเว็บไซต์เดียว ไม่ต้องไล่หาจากหลายที่ ผมเลยไล่อ่านรายชื่อค่ายเกม กติกาของแต่ละเกม และเงื่อนไขบริการก่อนเริ่มต้น ซึ่งตรงกับที่หน้าเว็บแนะนำให้ศึกษารายละเอียดก่อนใช้งาน หัก 1 ดาวตรงที่คำกล่าวอ้างเรื่องการเป็นเว็บหลักหรือเว็บอันดับหนึ่ง หน้าเว็บบอกเองว่าควรพิจารณาร่วมกับข้อมูลผู้ให้บริการ หลักฐานการอนุญาต และความคิดเห็นจากผู้ใช้งานหลายแหล่ง ถ้ารวมจุดที่ให้ตรวจสอบไว้ในหน้าเดียวได้ก็จะหาง่ายกว่านี้`,
    avatar: "🔎",
  },
  {
    name: "ผู้อ่านเงื่อนไขก่อนรับสิทธิ์",
    role: "ไล่ดูรอบสรุปยอดกับวิธีรับเครดิต",
    stars: 4,
    content:
      "เรื่องที่ถูกถามมากที่สุดคือโปรโมชั่น หน้านี้ระบุรายการหลักไว้สองอย่าง คือคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แล้วเขียนกำกับเองว่าแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบรับเครดิต และข้อกำหนดการใช้งานแตกต่างกัน ผมถามเจ้าหน้าที่ก่อนว่าระบบคำนวณยอดจากเกมประเภทใด มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือไม่ อีกข้อที่ชอบคือหน้าเว็บบอกเองว่าเครดิตคืนยอดเสียไม่ใช่การรับประกันผลตอบแทนจากการเดิมพัน ส่วนที่ยังอยากให้เพิ่มคือคำว่าไม่จำกัดในรายการแนะนำเพื่อน ควรระบุให้ชัดว่าหมายถึงรอบจ่ายเครดิต จำนวนผู้เข้าร่วม หรือข้อกำหนดอื่น ๆ เพราะตอนนี้ต้องไปยืนยันจากประกาศล่าสุดอีกที",
    avatar: "🧮",
  },
  {
    name: "สมาชิกที่สมัครผ่าน 3 ขั้นตอน",
    role: "ตรวจลิงก์และ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน",
    stars: 5,
    content: `สมัครตามที่หน้าเว็บเขียนไว้ 3 ขั้นตอนพอดี เริ่มจากเปิดเว็บไซต์ทางการแล้วเลือกเมนูสมัครสมาชิก อ่านรายละเอียดเกี่ยวกับคุณสมบัติผู้ใช้งาน เงื่อนไขการเปิดบัญชี และนโยบายข้อมูลส่วนบุคคลก่อนกรอกข้อมูล จากนั้นกรอกข้อมูลตามที่ระบบกำหนด ตรวจสอบความถูกต้องก่อนยืนยัน และตั้งรหัสผ่านที่ปลอดภัย โดยไม่ใช้ข้อมูลของบุคคลอื่นหรือเปิดเผยรหัสยืนยันบัญชีให้ใครทราบ พอลงทะเบียนเรียบร้อยก็เข้าสู่ระบบไปศึกษารายชื่อค่ายเกมสล็อต กติกาการเล่น รายละเอียดฝากถอน และเงื่อนไขโปรโมชั่นก่อนทำรายการ ตอนจะทัก LINE Official ของ ${BRAND_NAME} ผมเช็กลิงก์กับ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ เวลาแจ้งปัญหาก็ส่งรายละเอียดพร้อมหลักฐานรายการที่เกี่ยวข้องให้เจ้าหน้าที่ตรวจสอบ ไม่เคยถูกถามรหัสผ่านหรือรหัส OTP เลยสักครั้ง ให้ไปเลย 5 ดาว`,
    avatar: "📝",
  },
];

// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19, brand-spec §2-§3): การ์ดรีวิวที่ใช้งานจริงรอบนี้ — รอบก่อน
// (ถอนชัวร์168) ใช้ ReviewCardSumo2 จึงหมุนมาที่ไฟล์นี้ การ์ดเป็นผิวยก #0e2238
// ในกรอบฟ้าแบรนด์ #2f9ff5 โปร่ง บนพื้นเพจ **ดำสนิท #000000** (bg.json) จึงลอยขึ้นมา
// ชัดเจน
// ⚠️ ลำดับความลึกรอบนี้: #0e2238 ยก / #081726 กลาง / #040d16 จม / #000000 พื้น
// แบรนด์มีสองฮิวจริงตามโลโก้ — **ฟ้านำ** (ตัวอักษร เบท168 ปลอกคอแมว มือถือจอฟ้า
// ปึกแบงก์ฟ้า หัวใจฟ้า โบว์ซาติน กล่องของขวัญ เส้นแสง) และ **ทองรอง** (คำว่า สบาย
// กระดิ่ง มงกุฎ เหรียญบิตคอยน์ ประกายดาว) การ์ดจึงแยกชั้นด้วยคู่สีนั้นตรงๆ:
// เครื่องหมายคำพูดเป็นฟ้าอ่อน #a8dcff ชื่อผู้รีวิวเป็นทอง #ffc82e ที่เปลี่ยนเป็น
// ฟ้าอ่อนตอน hover ดาวที่ติดเป็น **ทอง #ffc82e** พร้อมเรืองแสง rgba(255,200,46,α)
// ส่วนออรามุมการ์ดเป็นฟ้าแบรนด์ที่อิ่มขึ้นตอน hover และขอบรูปโปรไฟล์เป็นทองลึก
// #5c4a16 บนพื้นไล่ผิวกลาง #081726 → ผิวจม #040d16
// ⚠️ **ดาวเป็นทอง ไม่ใช่เงินโครเมียม** — §2 ระบุว่ารอบนี้ไม่มีโครเมียม/เงินเป็นสีระบบ
// ดาวที่ไม่ติดตกไปเป็นฟ้าอ่อน #a8dcff ที่ opacity ต่ำ — และกลีฟ ★ นับเป็นตัวอักษร
// จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร (#ffc82e 11.3:1 / #a8dcff 11.6:1)
// ไม่ใช่ #0b3f78 หรือ #5c4a16
// หัวแถบไล่ ฟ้าแบรนด์ #2f9ff5 → ฟ้าอ่อน #a8dcff → ฟ้าแบรนด์ #2f9ff5 พร้อมคำว่า
// ผู้ใช้งานจริง เป็นทอง #ffc82e — ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของ
// ตัวอักษร** ไม่ใช่พื้นหลัง ทุกค่าในไล่เฉดจึงต้องถือตัวอักษรได้ (5.9:1 ที่ text-3xl
// font-black = large text / 11.6:1) หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ ข้อความรองใช้
// ฟ้าอ่อน #a8dcff ซึ่ง §2 กำหนดเป็นสีรองไว้แล้ว
