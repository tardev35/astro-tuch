---
import { BRAND_NAME } from "../lib/brandProfile";

// Visible testimonial cards only — no Review/AggregateRating JSON-LD is emitted
// anywhere for these, by design. The star row is decorative and carries an
// sr-only sentence instead. The block title is a <p> and the <section> carries
// an aria-label, so this widget never emits a heading tag.
//
// Every line below stays inside what หวยเฮง789's brief supports: เลือกแทงหวย
// ออนไลน์หลายประเภทผ่านบัญชีเดียว, รัฐบาลไทย / ฮานอย / ลาว / หุ้นต่างประเทศ,
// เลือกเลขเด็ด เลขดัง หรือชุดตัวเลขเอง, ตรวจสอบรอบ เวลาปิดรับ อัตราจ่าย และ
// รายละเอียดโพยก่อนยืนยัน, อัตรา 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท
// เฉพาะรายการที่เข้าเงื่อนไขและต้องยึดหน้าส่งโพยของแต่ละรอบ, "ไม่จำกัด"/"แทงได้
// ไม่อั้น" ต้องอ้างอิงวงเงินที่ระบบเปิดรับจริง, สมัครผ่านมือถือ 3 ขั้นตอน,
// แอดมิน 24 ชั่วโมง และห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// No licence claim, no bank name, no operator name, no member count, no founding
// year, no promised profit. The previous brief's ลาวพัฒนา / ฮานอยปกติ / ฮานอย
// พิเศษ / ฮานอยวีไอพี sub-rounds are gone — this brief names no sub-rounds — and
// so are its ฝากถอนวอลเลทและธนาคาร and เช็คผลทันที angles, which this brief does
// not make. None of the football or slot vocabulary earlier holders of this file
// carried (บอล ค่าน้ำ อัตราต่อรอง ลีก บิล สล็อต ฟรีสปิน RTP) survives.
const reviews = [
  {
    name: "ทีมทดสอบระบบเว็บไซต์",
    role: "ผู้ดูแลด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ลองสมัครผ่านมือถือตามที่หน้าเว็บบอกไว้ ครบ 3 ขั้นตอนจริง เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชีสมาชิก จากนั้นเลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพยได้เลย เปิดจากแท็บเล็ตกับคอมพิวเตอร์ก็ได้หน้าเดียวกัน ตามรอบหวย ส่งโพย และตรวจสอบผลจากบัญชีเดียวโดยไม่ต้องสลับหลายบัญชี หัก 1 ดาวเพราะอยากให้มีโหมดสว่างเพิ่มมาด้วย",
    avatar: "🖥️",
  },
  {
    name: "คอมมูนิตี้รีวิวเว็บหวย",
    role: "เพจรวมรีวิวผู้ใช้งานจริง",
    stars: 4,
    content:
      "สมาชิกในเพจถามเรื่องอัตราจ่ายมากที่สุด หน้านี้แยกไว้ชัดว่ามีตัวเลือก 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข ไม่ใช่ทุกประเภทโดยอัตโนมัติ เพราะรัฐบาลไทย ฮานอย ลาว และหุ้นต่างประเทศอาจใช้อัตราหรือรูปแบบการเดิมพันต่างกัน เขาเขียนไว้ตรงๆ ว่าให้ยึดอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลัก ซึ่งตรงกับที่เราแนะนำสมาชิกอยู่แล้ว",
    avatar: "🎟️",
  },
  {
    name: "สมาชิกที่ใช้งานต่อเนื่อง",
    role: "ผู้ใช้งานประจำ",
    stars: 5,
    content:
      "ตามหวยหลายประเภทในวันเดียวได้จากบัญชีเดียว ทั้งรัฐบาลไทยตามกำหนดออกรางวัล ฮานอยและลาวตามรอบที่เปิดรับ และหุ้นต่างประเทศตามตลาดที่ระบบรองรับ เลขเด็ดเลขดังที่ตามมาก็เอามาเลือกแทงได้ตามรายการที่เปิดรับ แต่ต้องเข้าใจว่าจำนวนเงินสูงสุดขึ้นอยู่กับประเภทหวย รอบ และวงเงินของเลขนั้น โดยเฉพาะเลขที่มีผู้เลือกจำนวนมาก ก่อนยืนยันโพยจึงต้องดูตารางรอบ เวลาปิดรับ และยอดที่ระบบอนุญาตทุกครั้ง ถามแอดมินตอนดึกก็ตอบตามที่แจ้งว่าดูแล 24 ชั่วโมง ให้ไปเลย 5 ดาว",
    avatar: "🔢",
  },
];

// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): การ์ดเป็นผิวการ์ดแดงเข้ม #2b0909 ในเส้น
// ไรผมแดงแบรนด์ #dc2224 บนพื้นเพจดำ ส่วนเครื่องหมายคำพูด ดาวที่ติด และชื่อผู้รีวิว
// ไต่ขึ้นเป็นทองอ่อน #ffefc2 กับทองรอง #f4bc5d ตามสองโทนของโลโก้ (คำว่า "หวย" เป็น
// แดงเลือดนก คำว่า "เฮง789" เป็นทอง) ดาวที่ไม่ติดตกไปเป็นแดงลึก #ab0204 ที่ opacity
// ต่ำ ไม่ใช่เทา จึงไม่มีจุดใดในการ์ดหลุดออกจากคู่แดง-ทองของแบรนด์ หัวแถบไล่ขาวอม
// ชมพู #fbe3d4 → ทองรอง → แดงสว่าง #e43434 พร้อมคำว่า ผู้ใช้งานจริง เป็นไฮไลต์ทองอ่อน
// เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#062a12 #e5c04f #eafbe9 #fae474
// #026314 #a9cfae #0bb42f #010a04 #d8ead9) ออกครบทุกจุดแล้ว พร้อมกับ copy ของบรีฟรอบก่อน
---

<section aria-label={`เสียงตอบรับจากผู้ใช้งานจริงของ ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbe3d4] via-[#f4bc5d] to-[#e43434] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(220,34,36,0.35)]">
      เสียงตอบรับจาก <span class="text-[#ffefc2]">ผู้ใช้งานจริง</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f4bc5d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative flex flex-col justify-between rounded-3xl border border-[#dc2224]/50 bg-[#2b0909]/90 p-8 shadow-[0_10px_30px_rgba(11,2,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f4bc5d]/70 hover:shadow-[0_15px_40px_rgba(244,188,93,0.3)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 h-32 w-32 rounded-full bg-[#dc2224]/28 blur-[50px] transition-all duration-500 group-hover:bg-[#f4bc5d]/30" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#dc2224]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#ffefc2]/50 drop-shadow-[0_0_5px_rgba(255,239,194,0.5)]">
                "
              </span>
              <div class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "animate-pulse text-[#f4bc5d] drop-shadow-[0_0_5px_rgba(244,188,93,0.8)]" : "text-[#ab0204]/40"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </div>
            </div>

            <p class="text-left text-base leading-relaxed text-[#fbe3d4]/90 italic">"{review.content}"</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-white/5 pt-4">
            <div
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f4bc5d]/30 bg-gradient-to-br from-[#ab0204] to-[#0b0202] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </div>
            <div class="flex flex-col">
              <p class="text-base font-black text-[#ffefc2] transition-colors group-hover:text-[#f4bc5d]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#fbe3d4]/70 uppercase">{review.role}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
