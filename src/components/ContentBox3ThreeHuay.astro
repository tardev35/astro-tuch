---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c1121f]/45 bg-[#3d0b0e]/85 p-8 text-[#f4e7d3] shadow-[0_10px_30px_rgba(26,4,5,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3c56a]/55 hover:shadow-[0_15px_40px_rgba(227,197,106,0.2)] md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#c1121f]/40 pb-8 text-left text-base leading-relaxed text-[#f4e7d3] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#e3c56a] uppercase">
              <span aria-hidden="true" class="text-xl drop-shadow-[0_0_5px_rgba(227,197,106,0.8)]">💸</span> {titleleft}
            </h3>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#c1121f]/40 pb-8 text-left text-base leading-relaxed text-[#f4e7d3] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#e3c56a] uppercase">
              <span aria-hidden="true" class="text-xl drop-shadow-[0_0_5px_rgba(227,197,106,0.8)]">⚡</span> {titlecenter}
            </h3>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4e7d3] md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#e3c56a] uppercase">
              <span aria-hidden="true" class="text-xl drop-shadow-[0_0_5px_rgba(227,197,106,0.8)]">💎</span> {titleright}
            </h3>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
