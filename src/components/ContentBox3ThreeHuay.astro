---
export interface Props {
  /** The section's own docx heading — the ONLY heading this box ever emits.
   *  The three column labels are chrome (they name a card, not a section of the
   *  brief), so they render as <p> whatever `as` says. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  /** Accessible name for the <section> when no `title` is passed. */
  label?: string;
  iconleft?: string;
  iconcenter?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, iconleft = "📝", iconcenter = "🔑", iconright = "✅" } = Astro.props;

const sectionLabel = label ?? title ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
// The default slot is the section's lead paragraph, above the three columns.
// It is conditional so an unused intro cannot leave an empty spaced <div>.
const hasIntro = Astro.slots.has("default");

// Shape change 2026-09-24: the three column titles used to render at `as`
// level, which put three tags on one docx section whose sub-points are plain
// sentences rather than headings. One section header carries the docx heading
// now, the columns dropped to <p>, and the lead paragraph has a slot of its own
// instead of being folded into a column.
//
// ⚠️ นี่คือเหตุผลที่รอบนี้ใช้กล่องนี้รับ **docx H2 §6** (สาธุ168 รองรับการฝากถอน
// วอลเลทและธนาคารชั้นนำ — content.txt บรรทัด 14 ผ่าเป็นสามส่วนลงสามคอลัมน์) แทนที่
// จะใช้ FeatureHighlights: ตัวนั้น render <h3> ซึ่งจะดัน h3 ของหน้าเกินเช็กลิสต์
// brand-spec §4 ไปสามตัว ส่วนสามช่องนี้เป็น <p> อยู่แล้ว และ **บรีฟรอบนี้ไม่มี
// sub-list ใต้หัวข้อไหนเลย** จึงไม่มีอะไรให้ FeatureHighlights ถือตั้งแต่แรก
// หน้าแรกรอบนี้ **ไม่ส่ง titleleft/titlecenter/titleright** เพราะบรีฟเขียนหัวข้อนี้
// เป็นย่อหน้าเดียวยาวโดยไม่ตั้งชื่อย่อยให้สามส่วน — การคิดป้ายขึ้นมาเองจะเป็นถ้อยคำ
// ของหน้า ไม่ใช่ของบรีฟ (คลาสของป้ายสามใบยัง retheme ไว้ครบในฐานะ inventory)
// คำว่า Huay ในชื่อไฟล์เป็น **ป้ายสไตล์ ไม่ใช่เนื้อหา** — ไม่มีข้อความหวยฮาร์ดโค้ด
// อยู่ในไฟล์นี้เลย (รอบนี้แบรนด์เป็นเว็บหวยจริง แต่นั่นมาจาก prop ไม่ใช่จากไฟล์นี้)
//
// สาธุ168 (รอบ **เขียวมรกตนำ · ทองสัมฤทธิ์รอง · ธีมสว่าง** 2026-10-21,
// brand-spec §2): ถูกเลือกเพราะ "ทรง" — เป็นกล่องสามคอลัมน์ใบเดียวของหน้า ซึ่งตรง
// กับ §6 ที่บรีฟพูดถึงสามเรื่องคู่กัน (ช่องทางฝากถอน · ยอดขั้นต่ำกับระยะเวลา ·
// การตรวจชื่อบัญชีปลายทาง)
// ⚠️ **ธีมสว่าง** — bg.json = #d8ffc7 ลำดับความลึกกลับหัวจากทุกรอบก่อนของไฟล์นี้:
// #ffffff ผิวยก (ใบนี้) / #e9fbdd ชั้นกลาง / #d8ffc7 พื้นเพจ หมึก **เขียวป่า
// #0c3a16** (= BRAND_TEXT, 12.9:1 บนผิวยก) ไม่มีชั้นไหนจมต่ำกว่าพื้นเพจได้อีก
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีโครเมียม ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า
// ไม่มีส้ม และไม่มีทองบนการ์ด** — มีแค่เขียวสี่ค่า + ขาว + มิ้นต์
//
// ใบนี้เป็นการ์ดมุมกลม rounded-3xl ที่ผิวยก #ffffff แต่ถือ **border-2** และมี
// **แถบตั้งไล่เฉดหน้าหัวข้อ** จึงไม่อ่านเป็นใบเดียวกับ ContentBoxSevenThreeHuay
// (§4) ที่มุมกลมเหมือนกัน ผิวเดียวกัน แต่เป็น border เส้นเดียว + ออราเฉียงสองมุม
// และไม่ซ้ำกับ ContentBoxHuay (§1) ที่เป็นทรงใบสลากมีรอยปรุ ใบนี้เป็นใบเดียวของ
// หน้าที่มีสามคอลัมน์และมีแผ่นไอคอนเขียวทึบ
// กรอบเป็นเขียวมรกต #0b7d28 ที่เข้มขึ้นเป็นเขียวเข้ม #0a5f1c ตอน hover ออรามุม
// ขวาบนเป็น **เขียวใบตอง #0f9b35** ซึ่ง §2 อนุญาตเฉพาะงานออรา/พื้นถม
// แถบตั้งหน้าหัวข้อไล่ เขียวเข้ม #0a5f1c → เขียวมรกต #0b7d28 → เขียวใบตอง #0f9b35
// (เป็น **พื้นถม** ล้วน จึงพา #0f9b35 มาได้)
// หัวข้อ docx ไล่ **หมึกเขียวป่า #0c3a16 → เขียวเข้ม #0a5f1c → เขียวมรกต #0b7d28**
// ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ (§1 ไล่ #0a5f1c→#0b7d28→
// #0a5f1c · §3 ไล่ย้อนศรของ §1 · §4/§5 เป็นสีทึบ · §7 ไล่สองสต็อป)
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปจึงเป็นค่าที่
// §2 อนุญาตให้ถือตัวอักษรบนพื้นสว่าง — **ไม่มี #0f9b35 อยู่ในไล่เฉดนี้**
// ป้ายไอคอนสามใบเป็น **แผ่นถมเขียวทึบ** ไล่ #0b7d28 → #0a5f1c บนตัวอักษร **ขาว**
// ซึ่ง §2 ระบุว่าใช้ได้ (5.3:1 / 7.9:1) — ห้ามพลิกแผ่นเขียวไปใช้หมึกเข้ม
// ชื่อคอลัมน์เป็นเขียวเข้ม #0a5f1c (7.9:1) เส้นคั่นคอลัมน์เป็นเขียวมรกตโปร่ง
// §2 ห้าม #0f9b35 และทองสัมฤทธิ์ทุกค่าถือตัวอักษรบนพื้นสว่าง — ในไฟล์นี้ #0f9b35
// อยู่ที่ออรากับปลายแถบตั้งเท่านั้น และ **ทองไม่มีอยู่เลยสักค่า**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของรีโปนี้คือแดงกับทอง เพราะทั้ง
// คู่ผ่านมาแล้วเกือบทุกแบรนด์** รอบนี้ไม่ใช้ทั้งสองอย่างบนการ์ด และ **ไม่มีแบรนด์ไหน
// ในรีโปนี้เคยใช้เขียวเลยสักเฉด** ไฟล์นี้เพิ่งถือชุดแดงมังกร-โครเมียมขาวของ **GT66B**
// มาทั้งไฟล์ (fb141b db040b ec151c 8a0609 3b0405 ff5f63 fdfcfd b4bcc2 190505 1c0c0b
// 130c0c 0b0303 eceaea ffa0a2 rgba(251,20,27,…)) และก่อนนั้นเป็นชุดของ **365LOTTO**
// (9c6a12 fadc64 fdf3b4 e0b03a 1a0709 120406 f0ddc4 e01f26 f3f6fa) กับ **LOTTOKA**
// (140a0c c21e22 e2353a ff8a8d ded9da) — ออกครบทุกค่าแล้ว รวมถึงชุดชมพูบานเย็นของ
// รอบขาออก **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ที่ต้องไม่
// ไหลเข้ามา และชุดทองโลหะของ **หวยคิง** เจ้าของเดิมของตระกูล *Huay (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border-2 border-[#0b7d28]/45 bg-[#ffffff] p-8 text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.15)] transition-all duration-500 hover:border-[#0a5f1c]/70 hover:shadow-[0_15px_40px_rgba(11,125,40,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-44 w-44 rounded-full bg-[#0f9b35]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#0f9b35]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0b7d28]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0a5f1c] via-[#0b7d28] to-[#0f9b35] shadow-[0_0_10px_rgba(11,125,40,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#0c3a16] via-[#0a5f1c] to-[#0b7d28] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {
      hasIntro && (
        <div class="mb-8 text-left text-base leading-relaxed text-[#0c3a16]">
          <slot />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#0b7d28]/35 pb-8 text-left text-base leading-relaxed text-[#0c3a16] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-3 text-lg leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0a5f1c]/60 bg-gradient-to-br from-[#0b7d28] to-[#0a5f1c] text-sm text-[#ffffff] shadow-[0_0_10px_rgba(11,125,40,0.4)]">
                {iconleft}
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#0b7d28]/35 pb-8 text-left text-base leading-relaxed text-[#0c3a16] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-3 text-lg leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0a5f1c]/60 bg-gradient-to-br from-[#0b7d28] to-[#0a5f1c] text-sm text-[#ffffff] shadow-[0_0_10px_rgba(11,125,40,0.4)]">
                {iconcenter}
              </span>
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#0c3a16] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-3 text-lg leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0a5f1c]/60 bg-gradient-to-br from-[#0b7d28] to-[#0a5f1c] text-sm text-[#ffffff] shadow-[0_0_10px_rgba(11,125,40,0.4)]">
                {iconright}
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
