---
const {
  message = "FUN24 รวมเกมเดิมพันครบทุกหมวด คาสิโน บาคาร่า สล็อต ยิงปลา กีฬา หวย • คืนยอดเสียทุกวัน 0.3% • แนะนำเพื่อนรับโบนัส 0.8% • ฝากถอนออโต้ 24 ชม.",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#ea580c]/35 bg-gradient-to-r from-[#2a1206]/60 to-[#170a03] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(234,88,12,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#fb923c] bg-[#170a03] shadow-[0_0_15px_rgba(234,88,12,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#fb923c]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#fde68a]">
        <span class="drop-shadow-[0_0_5px_rgba(251,146,60,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(251,146,60,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
