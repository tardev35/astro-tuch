---
// ticker หลักของแบรนด์รอบนี้ (หวยเต็ง — เว็บแทงหวยออนไลน์ รัฐบาลไทย ลาว ฮานอย หุ้น)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ GOT777, 888PARUAY,
// UFAGOOL และ ABM96)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น — ไม่มีการอ้างใบอนุญาต ชื่อเจ้ามือ
// ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือจำนวนสมาชิก เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่
// อ้างได้มีสี่ตัวคือ 2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000 · 3 ขั้นตอน · 24 ชั่วโมง และ
// ไม่มีคำว่า บอล ค่าน้ำ อัตราต่อรอง ลีก บิล สล็อต ฟรีสปิน หรือ บาคาร่า เพราะ
// หวยเต็ง เป็นเว็บแทงหวย ไม่ใช่เว็บบอลหรือเว็บสล็อตแบบแบรนด์ก่อนหน้า
//
// ธีม: พื้นเขียวเกือบดำ #03150a / #062a12 / #0b3d18 ขอบและกระดิ่งเป็นทองแบรนด์
// #e5c04f กับเขียวมรกต #0bb42f เรืองแสง rgba(229,192,79,α) และ rgba(11,180,47,α)
// — ทอง #f5c518 กับแดงเลือดหมู #d21622 ของแบรนด์ก่อนหน้าถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บแทงหวยออนไลน์ รวมรายการหวยยอดนิยมไว้ให้เลือกผ่านบัญชีเดียว • มีทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ และฮานอยวีไอพี • รวมถึงหวยหุ้นต่างประเทศตามตลาดและรอบเวลาที่ระบบเปิดรับ • อัตราจ่าย 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่ร่วมเงื่อนไข • สมัครแทงหวย ${BRAND_NAME} ผ่านมือถือได้ด้วย 3 ขั้นตอน • เลือกเลข ส่งโพย ตรวจสอบรายการ และผลหวยได้จากระบบเดียว • แอดมินดูแลสมาชิกตลอด 24 ชั่วโมง • ก่อนส่งโพยควรตรวจสอบชื่อรายการ เลขที่เลือก ยอดเดิมพัน เวลาปิดรับ และอัตราจ่ายของรอบนั้นให้เรียบร้อยทุกครั้ง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#e5c04f]/55 bg-gradient-to-r from-[#0b3d18]/85 to-[#03150a] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(229,192,79,0.3)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e5c04f] bg-[#062a12] shadow-[0_0_15px_rgba(229,192,79,0.55)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#0bb42f]/70 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#eafbe9]">
        <span class="drop-shadow-[0_0_5px_rgba(229,192,79,0.55)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(229,192,79,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
