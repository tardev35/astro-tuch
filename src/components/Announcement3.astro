---
const {
  message = "JUMBOBET เว็บพนันเบอร์1ยอดนิยม รวมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ และหวยไว้ในบัญชีเดียว • คืนยอดเสีย 0.3% ไม่จำกัด ตรวจสอบสิทธิ์ได้ตามรอบที่กำหนด • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • สมัครสมาชิกใหม่ตรวจสอบโบนัสที่เปิดให้รับได้ทุกวัน",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#25cb0e]/35 bg-gradient-to-r from-[#031204]/60 to-[#010301] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(37,203,14,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#6ef25a] bg-[#010301] shadow-[0_0_15px_rgba(37,203,14,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#6ef25a]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#d5e8d0]">
        <span class="drop-shadow-[0_0_5px_rgba(110,242,90,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(110,242,90,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
