---
// ticker หลักของแบรนด์รอบนี้ (DM899 — สล็อตคาสิโนเว็บตรงต่างประเทศ)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ GOT777, 888PARUAY,
// UFAGOOL, ABM96 และ หวยเต็ง)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น — ไม่มีการอ้างใบอนุญาต ชื่อค่ายเกม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวนสมาชิก เพราะบรีฟไม่ได้ระบุไว้สักคำ
// ตัวเลขที่อ้างได้มีห้าตัวคือ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100% และ
// ไม่มีคำหมวดหวย (หวย โพย งวด เลข 2 ตัว/3 ตัว อัตราจ่าย ฮานอย ลาว หวยหุ้น)
// เพราะ DM899 เป็นเว็บสล็อตคาสิโน ไม่ใช่เว็บแทงหวยแบบแบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง (บัญชีบริษัทแท้ 100% กับการันตีระบบเกมมาตรฐานควรมี
// ข้อมูลที่ตรวจสอบได้รองรับ) ขนมาด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
//
// ธีม: พื้นดำอมเขียว #030a05 / #0a2410 / #0a4a18 ขอบและกระดิ่งเป็นเขียวแบรนด์
// #01a326 เส้นคั่นเป็นแดงแบรนด์ #fb252b (คู่เขียว-แดงของโลโก้) ตัวอักษร #e4f2e4
// เรืองแสง rgba(1,163,38,α) — ทอง #e5c04f กับเขียวมรกต #0bb42f ของ หวยเต็ง
// ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} สล็อตคาสิโนเว็บตรงต่างประเทศ รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว • มีทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ • รองรับการเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากบัญชีเดียว • โปรโมชั่นเปิดตามแคมเปญของแต่ละเดือน มีทั้งโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่เว็บไซต์กำหนด • สมัคร ${BRAND_NAME} ผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกประเภทเกมที่ต้องการได้ทันที • คำว่าบัญชีบริษัทแท้ 100% และการันตีระบบเกมมาตรฐาน ควรมีชื่อนิติบุคคล มาตรฐาน หรือหน่วยงานที่ตรวจสอบได้รองรับก่อนใช้ยืนยันความปลอดภัย • ควรตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#01a326]/60 bg-gradient-to-r from-[#0a4a18]/85 to-[#030a05] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(1,163,38,0.32)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#01a326] bg-[#0a2410] shadow-[0_0_15px_rgba(1,163,38,0.6)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#fb252b]/70 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#e4f2e4]">
        <span class="drop-shadow-[0_0_5px_rgba(1,163,38,0.6)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(1,163,38,0.6)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
