---
// ticker หลักของแบรนด์รอบนี้ (UFAGOOL — กีฬาคาสิโนเว็บตรง รวมพนันออนไลน์)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ ABM96 และ FAH999)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น ไม่มีการอ้างใบอนุญาต อัตราจ่าย หรือ
// "ฝากถอนไม่มีขั้นต่ำ" เพราะบรีฟไม่ได้ระบุไว้ — และไม่มีคำว่าหวย เพราะบรีฟ
// ของ UFAGOOL ระบุเฉพาะ กีฬา คาสิโนสด สล็อต และเกมออนไลน์ประเภทอื่น
//
// ธีม: พื้นเกือบดำ #0a0708 / #16100f / #241a1a ขอบและกระดิ่งเป็นแดงแบรนด์
// #c50d12 กับเงินโครเมียม #b8c3cf เรืองแสง rgba(197,13,18,α) และ
// rgba(184,195,207,α) — โทนชมพู #fd6494 กับเหลือง #feda2a ของแบรนด์ก่อนหน้า
// ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} กีฬาคาสิโนเว็บตรง รวมพนันออนไลน์ ในเครือลิขสิทธิ์แท้ • รวมเกมพนันหลายหมวดให้เลือกจากหน้าเดียว ทั้งการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ • เชื่อมต่อผ่านเครือแบรนด์โดยตรงตามข้อมูลของเว็บไซต์ ไม่ผ่านเอเย่นต์ • เข้าถึงเกมได้สะดวกผ่านบัญชีเดียวทั้งบนมือถือและคอมพิวเตอร์ • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% • สมัคร ${BRAND_NAME} ผ่านมือถือได้ด้วยตัวเองใน 3 ขั้นตอน • แอดมินดูแลสมาชิกตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#c50d12]/55 bg-gradient-to-r from-[#241a1a]/85 to-[#0a0708] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(197,13,18,0.32)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#b8c3cf] bg-[#16100f] shadow-[0_0_15px_rgba(184,195,207,0.55)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#c50d12]/55 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#e6ebf1]">
        <span class="drop-shadow-[0_0_5px_rgba(197,13,18,0.6)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(197,13,18,0.6)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
