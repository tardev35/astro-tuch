---
// ticker หลักของแบรนด์รอบนี้ (GUCCI168 — เว็บเล่นคาสิโนไลฟ์ 24 ชั่วโมง)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ GOT777, 888PARUAY,
// UFAGOOL, ABM96, หวยเต็ง, DM899 และ หวย24)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น — ไม่มีการอ้างใบอนุญาต ผู้ให้บริการ
// ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวนสมาชิก เพราะบรีฟไม่ได้
// ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสี่ตัวคือ 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
// และไม่มีคำหมวดหวย (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย) เพราะ GUCCI168
// เป็นเว็บคาสิโนไลฟ์ ไม่ใช่เว็บหวยแบบแบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง ("ไม่มีขั้นต่ำทุกรูปแบบเกม" ควรอ้างอิงวงเงินจริงในระบบ ·
// โต๊ะไลฟ์และการแข่งขันบางรายการมีเวลาเปิดต่างกัน) ขนมาด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
//
// ธีม (brand-spec §3): พื้นเกือบดำอมแดง #090302 / #3d0a09 / #7a0505 ขอบและกระดิ่ง
// เป็นแดงแบรนด์ #c41115 เส้นคั่นเป็นทองแบรนด์ #d9a521 ไล่เข้าเขียวมรกต #2bbf63
// (คู่สามสีของโลโก้: GUCCI ขาวเงินขอบเขียว ทับ 168 แดงขอบทอง)
// ตัวอักษร #f6e3cf เรืองแสง rgba(196,17,21,α) — ชุดแดง-ทองของ หวย24 (#0a0303
// #2a0606 #d20a0a #f5c33b #f7e2d6) ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บเล่นคาสิโนไลฟ์ 24 ชั่วโมง รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว • มีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล เลือกโต๊ะสดหรือหมวดเกมที่สนใจได้จากบัญชีเดียว • รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์ ระบบจัดหมวดหมู่ชัดเจน สลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก • คำว่า “ไม่มีขั้นต่ำทุกรูปแบบเกม” ควรอ้างอิงวงเงินจริงภายในระบบ เพราะบาคาร่า รูเล็ต ไฮโล สล็อต และบอลกำหนดยอดเดิมพันขั้นต่ำแตกต่างกันตามโต๊ะ เกม หรือผู้ให้บริการ • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ควรอ่านรายละเอียดก่อนกดรับสิทธิ์ • สมัคร ${BRAND_NAME} ผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกโต๊ะหรือหมวดเกมที่ต้องการได้ทันที • เกมไลฟ์และการแข่งขันบางรายการมีเวลาเปิดให้เดิมพันแตกต่างกัน ควรตรวจสอบสถานะจากระบบก่อนเริ่มทุกครั้ง • ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#c41115]/65 bg-gradient-to-r from-[#7a0505]/85 to-[#090302] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(196,17,21,0.38)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#c41115] bg-[#3d0a09] shadow-[0_0_15px_rgba(196,17,21,0.65)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#d9a521]/75 to-[#2bbf63]/40"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#f6e3cf]">
        <span class="drop-shadow-[0_0_5px_rgba(196,17,21,0.65)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(196,17,21,0.65)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
