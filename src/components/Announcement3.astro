---
// ticker หลักของแบรนด์รอบนี้ (แตกดี168 — เว็บสล็อตออนไลน์ถูกลิขสิทธิ์)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ GUCCI168, หวย24 และ
// แบรนด์เก่ากว่านั้น)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt) — ไม่มีการอ้าง
// ใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวน
// สมาชิก เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสามตัวคือ 0.3% · 0.8% ·
// 24 ชั่วโมง และไม่มีคำหมวดหวย (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย) หรือหมวด
// คาสิโนไลฟ์ (บาคาร่า รูเล็ต ไฮโล โต๊ะสด บอล) เพราะ แตกดี168 เป็นเว็บสล็อตล้วน
// ไม่ใช่เว็บหวยหรือคาสิโนรวมแบบแบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง ("ไม่มีขั้นต่ำ" ควรตรวจวงเงินจริงของแต่ละเกม · "ถูกลิขสิทธิ์"
// ควรมีข้อมูลค่ายที่ตรวจสอบได้ · รีวิวของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลของทุกคน)
// ขนมาด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
//
// ธีม (brand-spec §2): พื้นกรมท่าเกือบดำ #020609 / #07111d / #0b3c66 ขอบและกระดิ่ง
// เป็นฟ้าแบรนด์ #0193fb เส้นคั่นเป็นเหลืองมะนาว #fce604 ไล่เข้าฟ้าอ่อน #7bcffb
// (คู่สีของโลโก้: คำว่า แตกดี เหลืองมะนาว วางเหนือเลข 168 ฟ้าสด)
// ตัวอักษร #dbeafe เรืองแสง rgba(1,147,251,α) — ชุดแดง-เขียว-ทองของ GUCCI168
// (#c41115 #7a0505 #090302 #3d0a09 #d9a521 #2bbf63 #f6e3cf) ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เกมสล็อตออนไลน์ที่รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว • มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ • รองรับการเข้าเล่นผ่านมือถือ เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว • คำว่า “ไม่มีขั้นต่ำ” ควรตรวจสอบวงเงินจริงของแต่ละเกมก่อนเริ่มเล่น เพราะแต่ละเกมและแต่ละค่ายกำหนดช่วงเดิมพันไม่เท่ากัน • ส่วนการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ควรอ่านเงื่อนไขก่อนกดรับสิทธิ์ • สมัครสมาชิก ${BRAND_NAME} ผ่านมือถือได้เอง แล้ว Login เลือกเกมที่ต้องการได้ทันที • รีวิวจากสมาชิกใช้ประกอบการพิจารณาได้ แต่ผลของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลของสมาชิกทุกคน • ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#0193fb]/65 bg-gradient-to-r from-[#0b3c66]/85 to-[#020609] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(1,147,251,0.38)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#0193fb] bg-[#07111d] shadow-[0_0_15px_rgba(1,147,251,0.65)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#fce604]/75 to-[#7bcffb]/40"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#dbeafe]">
        <span class="drop-shadow-[0_0_5px_rgba(1,147,251,0.65)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(1,147,251,0.65)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
