---
// ticker หลักของแบรนด์รอบนี้ (KINGKONG555 — ฐานเว็บสล็อตหลัก)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ แตกดี168, GUCCI168,
// หวย24 และแบรนด์เก่ากว่านั้น)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt) — ไม่มีการอ้าง
// ใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวน
// สมาชิก เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสี่ตัวคือ 1 บาท · 0.3% ·
// 0.8% · 24 ชั่วโมง และไม่มีคำหมวดหวย (หวย โพย เลขเด็ด แนวทาง งวด อัตราจ่าย) หรือ
// หมวดคาสิโนไลฟ์ (บาคาร่า รูเล็ต ไฮโล โต๊ะสด บอล) เพราะ KINGKONG555 เป็นเว็บสล็อต
// ล้วน ไม่ใช่เว็บหวยหรือคาสิโนรวมแบบแบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง (ผลการหมุนเป็นแบบสุ่ม · เว็บแท้/ปลอดภัยควรมีข้อมูล
// ผู้ให้บริการที่ตรวจสอบได้รองรับ · ชื่อบัญชีบริษัทอย่างเดียวไม่รับประกันความปลอดภัย
// · คำว่าไม่จำกัดควรตรวจสอบเงื่อนไข) ขนมาด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
//
// ธีม (brand-spec §2): พื้นเขียวป่าเกือบดำ #051400 / #0f2e05 / #1a5c04 ขอบและ
// กระดิ่งเป็นเขียวมะนาว #8ce023 เส้นคั่นเป็นทองมงกุฎ #f2c230 ไล่เข้าเขียวซีด
// #bde397 (คู่สีของโลโก้: คำว่า KINGKONG เขียวมะนาว ใต้กอริลลาสวมมงกุฎทอง)
// ตัวอักษร #e9f7d6 เรืองแสง rgba(140,224,35,α) — ชุดฟ้า-เหลืองของ แตกดี168
// (#0193fb #fce604 #7bcffb #dbeafe #020609 #07111d #0b3c66) และชุดแดง-เขียว-ทอง
// ของ GUCCI168 (#c41115 #7a0505 #090302 #3d0a09 #d9a521 #2bbf63 #f6e3cf) ถูกถอด
// ออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} ฐานเว็บสล็อตหลักที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว • มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ พร้อมทางเข้าเล่นผ่านมือถือได้ตลอด 24 ชั่วโมง • รองรับการเดิมพันเริ่มต้น 1 บาทในเกมที่กำหนด เหมาะกับผู้ที่ต้องการเลือกสล็อตเบทต่ำและแบ่งงบเล่นตามความสะดวก • สมาชิกสามารถเลือกค่าย ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว • ยอดขั้นต่ำอาจแตกต่างกันตามค่ายและเกมที่เลือก ควรตรวจสอบช่วงเดิมพันที่แสดงในเกมก่อนเริ่มเล่นทุกครั้ง • ผลการหมุนเป็นแบบสุ่ม การเลือกเกมเบทต่ำช่วยให้แบ่งงบได้ชัดเจนขึ้น แต่ไม่ได้แปลว่ามีโอกาสชนะมากกว่าเกมเดิมพันสูง • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ควรอ่านเงื่อนไขก่อนกดรับสิทธิ์ • ส่วนคำว่าไม่จำกัด ควรตรวจสอบว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส • หากเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ควรแสดงชื่อนิติบุคคลที่ตรวจสอบได้ เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่รับประกันความปลอดภัยของธุรกรรมทั้งหมด • ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#8ce023]/65 bg-gradient-to-r from-[#1a5c04]/85 to-[#051400] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(140,224,35,0.38)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#8ce023] bg-[#0f2e05] shadow-[0_0_15px_rgba(140,224,35,0.65)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#f2c230]/75 to-[#bde397]/40"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#e9f7d6]">
        <span class="drop-shadow-[0_0_5px_rgba(140,224,35,0.65)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(140,224,35,0.65)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
