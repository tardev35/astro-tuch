---
const {
  message = "JAIDEE928 สล็อตใจดีเว็บแท้ จ่ายตรง ไม่ผ่านเอเย่นต์ รวมค่ายเกมฮิตสุดมันส์ครบทุกแบรนด์ไว้ในบัญชีเดียว • คอมมิชชั่นสูง คืนยอดเสียสูงสุด 0.3% แนะนำเพื่อนรับโบนัสสูงสุด 0.8% ตามเงื่อนไขของแต่ละโปรโมชั่น • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน JAIDEE928 พร้อมช่วยตรวจสอบรายการทุกวัน",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#9d16f1]/35 bg-gradient-to-r from-[#150726]/60 to-[#06020e] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(157,22,241,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#c47bff] bg-[#06020e] shadow-[0_0_15px_rgba(157,22,241,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#c47bff]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#ece0fb]">
        <span class="drop-shadow-[0_0_5px_rgba(196,123,255,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(196,123,255,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
