---
// ticker หลักของแบรนด์รอบนี้ (PUNPRO168 — สล็อตปันโปรในตำนาน)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ แตกดี168, GUCCI168,
// หวย24 และแบรนด์เก่ากว่านั้น)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt) — ไม่มีการอ้าง
// ใบอนุญาต ชื่อค่ายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวน
// สมาชิก เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสี่ตัวคือ 0.3% · 0.8% ·
// 3 ขั้นตอน · 24 ชั่วโมง (บวกปี 2026 ที่บรีฟเขียนไว้เองในหัวข้อ H1) ไม่มี "1 บาท"
// ซึ่งเป็นตัวเลขของ KINGKONG555 ไม่ใช่ของบรีฟนี้ และไม่มีคำหมวดหวย (หวย โพย เลขเด็ด
// แนวทาง งวด อัตราจ่าย) หรือหมวดคาสิโนไลฟ์ (บาคาร่า รูเล็ต ไฮโล โต๊ะสด บอล ยิงปลา)
// เพราะ PUNPRO168 เป็นเว็บเล่นสล็อตออนไลน์ล้วน ไม่ใช่เว็บหวยหรือคาสิโนรวมแบบ
// แบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง (ควรตรวจสอบช่องทางเข้าเล่นล่าสุดเพื่อเลี่ยงเว็บไซต์เลียนแบบ ·
// จำนวนปีที่เปิดเว็บไซต์และความนิยมไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว ·
// แต่ละกิจกรรมอาจกำหนดรอบรับสิทธิ์และเงื่อนไขต่างกัน · คำว่าไม่จำกัดควรตรวจสอบ
// เงื่อนไข · ไม่เปิดเผย PIN หรือ OTP) ขนมาด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
//
// ธีม (brand-spec §2): พื้นพลัมเข้มอมม่วง #1c0014 / #3a0a2a / #4a1038 ขอบและ
// กระดิ่งเป็นชมพูบานเย็น #f41571 เส้นคั่นเป็นทอง #fce343 ไล่เข้าชมพูสว่าง
// #ff5ca8 (คู่สีของโลโก้: คำว่า PUNPRO ชมพูบานเย็น ใต้เครื่องเกมชมพู แล้วจบที่
// เลข 168 ทอง) ตัวอักษร #fde7f2 เรืองแสง rgba(244,21,113,α) — ชุดเขียวป่าของ
// KINGKONG555 (#8ce023 #051400 #0f2e05 #1a5c04 #f2c230 #bde397 #e9f7d6) ชุด
// ฟ้า-เหลืองของ แตกดี168 (#0193fb #fce604 #7bcffb #dbeafe #020609 #07111d
// #0b3c66) และชุดแดง-เขียว-ทองของ GUCCI168 (#c41115 #7a0505 #090302 #3d0a09
// #d9a521 #2bbf63 #f6e3cf) ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} สล็อตปันโปรในตำนาน เว็บเล่นสล็อตออนไลน์ที่รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว • อัปเดตทางเข้าเล่นใหม่ปี 2026 ที่เน้นความสะดวกในการใช้งานผ่านมือถือและคอมพิวเตอร์ • มีทั้งเกมวงล้อแบบดั้งเดิม สล็อตภาพสมัยใหม่ เกมโบนัส และฟรีสปิน พร้อมเมนูตรวจสอบเครดิต โปรโมชั่น และข้อมูลบัญชีสมาชิกในหน้าเดียว • ควรตรวจสอบช่องทางเข้าเล่นล่าสุดและรายละเอียดค่ายเกมจากเว็บไซต์หลักก่อนใช้งาน เพื่อหลีกเลี่ยงการเข้าสู่เว็บไซต์เลียนแบบ • สำหรับภาพลักษณ์เว็บคนนิยมเล่นมายาวนาน จำนวนปีที่เปิดเว็บไซต์และความนิยมไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว จึงควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการให้ชัดเจนก่อนสมัครสมาชิก • โปรโมชั่นหลักมีคืนยอดเสีย 0.3% เข้ายูสทุกวัน คำนวณจากยอดที่เข้าเกณฑ์ตามรอบประจำวันที่เว็บไซต์กำหนด ควรตรวจสอบเวลาตัดรอบและเกมที่ร่วมรายการก่อนรับ • และแนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด ผ่านลิงก์แนะนำส่วนตัว • ส่วนคำว่าไม่จำกัด ควรตรวจสอบว่าหมายถึงจำนวนเพื่อน จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส • สมัครสมาชิกง่ายๆ 3 ขั้นตอน เข้าหน้าสมัคร กรอกข้อมูลบัญชี แล้วยืนยันการสมัคร • ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f41571]/65 bg-gradient-to-r from-[#4a1038]/85 to-[#1c0014] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(244,21,113,0.38)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f41571] bg-[#3a0a2a] shadow-[0_0_15px_rgba(244,21,113,0.65)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#fce343]/75 to-[#ff5ca8]/40"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#fde7f2]">
        <span class="drop-shadow-[0_0_5px_rgba(244,21,113,0.65)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(244,21,113,0.65)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
