---
// ticker หลักของแบรนด์รอบนี้ (FAH999 — สล็อตออโต้Top3 เว็บตรง)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนเว็บหวยของแบรนด์ก่อนหน้า)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น ไม่มีการอ้างใบอนุญาต อัตราจ่าย
// "ฝากถอนไม่มีขั้นต่ำ" หรือ "ตลอด 24 ชั่วโมง" เพราะบรีฟไม่ได้ระบุไว้
//
// ธีม: พื้นม่วงเข้ม #180430 / #1f0639 / #2a0a4d ขอบและกระดิ่งเป็นทอง
// #fbbf13 / #ffdf6b เรืองแสงม่วง rgba(168,85,247,α) และทอง
// rgba(251,191,19,α) — ทองอมน้ำตาลกับพื้นเกือบดำของแบรนด์ก่อนหน้าถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง • รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว จัดหมวดเกมชัดเจน ค้นหาจากหน้าเดียว • ระบบออโต้ จัดการบัญชีและเข้าเล่นสะดวกทั้งมือถือและคอมพิวเตอร์ • เกมยอดนิยม สล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอตจากหลายค่าย • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% • รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน • ติดต่อแอดมินสล็อต ${BRAND_NAME} ได้โดยตรงเมื่อมีปัญหาการสมัคร ทางเข้า โปรโมชั่น เกม หรือฝากถอน`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#fbbf13]/45 bg-gradient-to-r from-[#2a0a4d]/85 to-[#180430] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(168,85,247,0.3)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#fbbf13] bg-[#1f0639] shadow-[0_0_15px_rgba(251,191,19,0.6)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#fbbf13]/45 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#ecdcff]">
        <span class="drop-shadow-[0_0_5px_rgba(251,191,19,0.55)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(251,191,19,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
