const {
  message = `${BRAND_NAME} นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ พร้อมข้อมูลการเดิมพันเริ่มต้น 1 บาท และช่องทางฝากถอนผ่านธนาคารกับทรูวอลเลท ภายในเว็บไซต์รวบรวมรายละเอียดเกม โปรโมชั่น และระบบสมาชิกสำหรับผู้ใช้งานผ่านมือถือ ทั้งนี้ คำกล่าวอ้างว่าเป็นสล็อตลิขสิทธิ์แท้จำเป็นต้องมีข้อมูลที่ตรวจสอบได้ประกอบ จึงควรตรวจสอบรายชื่อค่ายเกมและหลักฐานการได้รับอนุญาตจากผู้พัฒนาก่อนใช้งาน • ${BRAND_NAME} เบทเริ่มต้น 1 บาท เล่นง่าย ไม่มีขั้นต่ำ มีทั้งสล็อตคลาสสิก เกมฟรีสปิน และเกมที่มีฟีเจอร์โบนัส เหมาะสำหรับผู้ที่ต้องการศึกษารูปแบบเกมด้วยงบประมาณจำกัด ควรตรวจสอบยอดเดิมพันขั้นต่ำของแต่ละเกม รวมถึงข้อกำหนดการฝากถอนและโปรโมชั่นให้ครบถ้วน เพราะข้อความว่าไม่มีขั้นต่ำหรือรับโปรโมชั่นได้ไม่จำกัด อาจมีข้อยกเว้นตามประเภทเกมและเงื่อนไขของผู้ให้บริการ • โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ทุกสัปดาห์ โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษหลักที่ระบุไว้ แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ รอบรับสิทธิ์ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบข้อมูลล่าสุดก่อนรับโบนัสทุกครั้ง • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน ควรตรวจสอบว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ควรตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสให้ชัดเจน แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุด • วิธีการสมัคร ${BRAND_NAME} ด้วยมือถือ 3 ขั้นตอน เริ่มจากเข้าสู่หน้าลงทะเบียน กรอกข้อมูลตามที่เว็บไซต์กำหนด แล้วยืนยันบัญชี ควรตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และตรวจสอบข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง กับนโยบายความเป็นส่วนตัวก่อนดำเนินการ • ระบบฝากถอน ${BRAND_NAME} ธนาคารและวอลเลท ก่อนฝากเงินควรตรวจสอบรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารเพื่อตรวจสอบก่อนโอนเงิน • ${BRAND_NAME} มีแอดมินออนไลน์ตลอด 24ชม. ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#e8a000]/55 bg-gradient-to-r from-[#1a0c04] to-[#2b1608] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(232,160,0,0.25)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e8a000] bg-[#2b1608] shadow-[0_0_15px_rgba(232,160,0,0.45)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#e8a000]/75 to-[#7a3a0c]/60"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#fff3e0]">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
