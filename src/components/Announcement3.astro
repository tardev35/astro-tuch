---
// ticker หลักของแบรนด์รอบนี้ (GOT777 — เว็บเกมสล็อตชั้นนำ แพลตฟอร์มค่ายใหญ่)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ 888PARUAY, UFAGOOL
// และ ABM96 ซึ่งเป็นเว็บหวยทั้งหมด)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น — ไม่มีการอ้างใบอนุญาต ชื่อค่ายเกม
// ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือตัวเลข RTP เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่
// อ้างได้มีสี่ตัวคือ 0.3% · 0.8% · 24 ชั่วโมง · 777 ในชื่อแบรนด์ และไม่มีคำว่า
// หวย โพย รัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น หรืออัตราจ่าย 2 ตัว 3 ตัว เพราะ
// GOT777 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวยแบบแบรนด์ก่อนหน้า
//
// ธีม: พื้นดำอมน้ำตาลเกือบดำ #0a0503 / #160b06 / #241108 ขอบและกระดิ่งเป็นทอง
// แบรนด์ #f5c518 กับแดงเลือดหมู #d21622 เรืองแสง rgba(245,197,24,α) และ
// rgba(210,22,34,α) — เขียว #1fae1c กับทอง #fcdc2b ของแบรนด์ก่อนหน้าถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บเกมสล็อตชั้นนำ รวมเกมจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว • มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมแจ็กพอตให้เลือกตามความสนใจ • รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ • เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว • โบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด • โบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ • สมัคร ${BRAND_NAME} ผ่านมือถือได้ด้วยตัวเอง • แอดมินดูแลสมาชิกตลอด 24 ชั่วโมง • เกมสล็อตมีผลลัพธ์แบบสุ่ม ควรตรวจสอบกติกาและช่วงเดิมพันภายในเกมก่อนเดิมพันทุกครั้ง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f5c518]/55 bg-gradient-to-r from-[#241108]/85 to-[#0a0503] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(245,197,24,0.3)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f5c518] bg-[#160b06] shadow-[0_0_15px_rgba(245,197,24,0.55)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#d21622]/70 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#ece0cb]">
        <span class="drop-shadow-[0_0_5px_rgba(245,197,24,0.55)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(245,197,24,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
