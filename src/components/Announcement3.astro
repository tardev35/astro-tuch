import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภท ทั้งบาคาร่า สล็อตออนไลน์ หวยออนไลน์ เดิมพันฟุตบอล และไฮโล พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ผู้ใช้งานสามารถศึกษากติกาเกมและเงื่อนไขการเดิมพันผ่านเว็บไซต์ได้ ส่วนคำกล่าวอ้างเกี่ยวกับการเป็นคาสิโนสายตรงหรือเกมถูกลิขสิทธิ์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน • ${BRAND_NAME} รวบรวมข้อมูลเกมเดิมพันหลายหมวดหมู่ ซึ่งแต่ละประเภทมีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน ผู้ใช้งานควรตรวจสอบวงเงินเดิมพันขั้นต่ำและสูงสุด รวมถึงข้อกำหนดการถอนเงินก่อนทำรายการ แม้เว็บไซต์จะระบุว่าจ่ายเต็มและไม่มีโกง แต่ควรตรวจสอบหลักฐานการดำเนินงานและเงื่อนไขการจ่ายรางวัลให้ชัดเจน เพราะไม่สามารถรับประกันความน่าเชื่อถือหรือผลตอบแทนจากข้อความโฆษณาเพียงอย่างเดียว • โปรโมชั่น ${BRAND_NAME} อัปเดตใหม่ตลอดสัปดาห์ โดยมีรายการคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% เป็นสิทธิพิเศษที่ระบุไว้ แต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนรับสิทธิ์ทุกครั้ง • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน ระบุการคืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน สมาชิกควรตรวจสอบว่าบาคาร่า สล็อต หวย บอล หรือไฮโลประเภทใดเข้าร่วมรายการ รวมถึงรอบเวลาคำนวณยอดและวิธีรับเครดิตให้ครบถ้วน โดยโปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด ควรตรวจสอบขั้นตอนการเชื่อมโยงบัญชีแนะนำเพื่อน ฐานยอดที่ใช้คำนวณโบนัส และรอบจ่ายเครดิตให้ชัดเจน แม้จะระบุว่าไม่จำกัด แต่ควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส และเงื่อนไขการถอนเงิน เพื่อให้เข้าใจรายละเอียดสิทธิ์ที่ได้รับตามประกาศจริง • สมัครเล่น ${BRAND_NAME} คาสิโนไม่มีขั้นต่ำ 3 ขั้นตอน เริ่มจากเข้าสู่หน้าลงทะเบียน กรอกข้อมูลและยืนยันบัญชี แล้วเข้าสู่ระบบเพื่อตรวจสอบรายละเอียดเกม ควรตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และตรวจสอบว่าข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย • แอดมิน ${BRAND_NAME} คาสิโนออนไลน์ตลอด 24ชม. ควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP และควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#3ddc4a]/55 bg-gradient-to-r from-[#031b09] to-[#0e5424] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(61,220,74,0.25)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#3ddc4a] bg-[#0e5424] shadow-[0_0_15px_rgba(61,220,74,0.45)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#3ddc4a]/75 to-[#1e7033]/60"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#eef7f0]">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
