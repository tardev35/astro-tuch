---
// ข้อความ default เป็นของแบรนด์ปัจจุบัน (ขวัญใจ168) เพราะหน้าอื่นเรียก
// <Announcement /> แบบเปล่า — ถ้า default ยังเป็นของแบรนด์ก่อนหน้า ticker
// จะไม่ตรงกันทั้งเว็บ ห้ามใส่ emoji นำหน้าข้อความ: emoji ที่ฝังมากับ prop
// ใส่ aria-hidden ไม่ได้ และ marquee นี้พิมพ์ข้อความซ้ำสองรอบ
const {
  message = "ขวัญใจ168 ทางเข้าเล่นสล็อตสำรอง เข้าเดิมพันได้ทันทีเมื่อช่องทางหลักใช้งานไม่ได้ • สมัครยูสเซอร์ใหม่หรือใช้บัญชีเดิมตามที่ระบบกำหนด ฝากถอนออโต้ • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข • รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน ขวัญใจ168 ดูแลสมาชิกตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#1687c9]/45 bg-gradient-to-r from-[#04223f]/80 to-[#01050b] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(22,135,201,0.2)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#4bdbee] bg-[#01050b] shadow-[0_0_15px_rgba(157,241,255,0.6)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#4bdbee]/35"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#cfe7f2]">
        <span class="drop-shadow-[0_0_5px_rgba(157,241,255,0.55)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(157,241,255,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
