---
const {
  message = "HONGHAO คาสิโนออนไลน์เว็บตรง รวมบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อตไว้ในบัญชีเดียว • โบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • ทีมงาน HONGHAO พร้อมตรวจสอบรายการให้ทุกวัน",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#62ae2d]/40 bg-gradient-to-r from-[#12290a]/70 to-[#040803] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(98,174,45,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#8fd45e] bg-[#040803] shadow-[0_0_15px_rgba(98,174,45,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#8fd45e]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#dbe5d3]">
        <span class="drop-shadow-[0_0_5px_rgba(143,212,94,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(143,212,94,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
