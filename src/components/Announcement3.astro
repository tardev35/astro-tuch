---
// ticker หลักของแบรนด์รอบนี้ (ABM96 — เว็บเดิมพันออนไลน์เจ้าของเดิม)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ FAH999)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น ไม่มีการอ้างใบอนุญาต อัตราจ่าย
// "ฝากถอนไม่มีขั้นต่ำ" หรือ "ตลอด 24 ชั่วโมง" เพราะบรีฟไม่ได้ระบุไว้
//
// ธีม: พื้นชมพูเกือบดำ #12030a / #1d0611 / #2a0a1a ขอบและกระดิ่งเป็นชมพูหลัก
// #fd6494 กับเหลืองโลโก้ #feda2a เรืองแสง rgba(253,100,148,α) และ
// rgba(254,218,42,α) — โทนม่วงกับทอง #fbbf13 ของแบรนด์ก่อนหน้าถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บเดิมพันออนไลน์เจ้าของเดิม ทางเข้าอัปเดตใหม่ • อัปเกรดระบบการใช้งานและระบบหลังบ้านให้เสถียรและเป็นขั้นตอนมากขึ้น • จัดการสิทธิ์บัญชีและข้อมูลภายในระบบอย่างเหมาะสม ลดความเสี่ยงจากการเข้าถึงโดยไม่ได้รับอนุญาต • รวมเกมครบในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล • เลือกหมวดที่สนใจจากเมนูหลักและสลับระหว่างเกมได้สะดวก • โปรโมชั่นแนะนำเพื่อน โบนัส 0.8% • โปรโมชั่นคืนยอดเสีย โบนัส 0.3% • สมัคร ${BRAND_NAME} ผ่านหน้าเว็บไซต์ได้ด้วยตัวเองใน 3 ขั้นตอน`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#fd6494]/45 bg-gradient-to-r from-[#2a0a1a]/85 to-[#12030a] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(253,100,148,0.3)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#feda2a] bg-[#1d0611] shadow-[0_0_15px_rgba(254,218,42,0.6)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#fd6494]/45 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#ffe0ec]">
        <span class="drop-shadow-[0_0_5px_rgba(254,218,42,0.55)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(254,218,42,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
