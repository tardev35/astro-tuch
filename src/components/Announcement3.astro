---
// ticker หลักของแบรนด์รอบนี้ (888PARUAY — แทงหวย ตรวจหวย เว็บตรงอันดับ1)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ UFAGOOL และ ABM96)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น ไม่มีการอ้างใบอนุญาตหรือ "ฝากถอน
// ไม่มีขั้นต่ำ" เพราะบรีฟไม่ได้ระบุไว้ — และไม่มีคำว่าสล็อต บาคาร่า หรือกีฬา
// เพราะบรีฟของ 888PARUAY ระบุเฉพาะหวย 4 ประเภทเท่านั้น
//
// ธีม: พื้นเขียวเข้มเกือบดำ #07130a / #0d2312 / #143a1c ขอบและกระดิ่งเป็นทอง
// แบรนด์ #fcdc2b กับเขียวสด #1fae1c เรืองแสง rgba(252,220,43,α) และ
// rgba(31,174,28,α) — แดง #c50d12 กับเงินโครเมียม #b8c3cf ของแบรนด์ก่อนหน้า
// ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} แทงหวย ตรวจหวย เว็บตรงอันดับ1 ปลอดภัยแน่นอน • รวมหวยยอดนิยมไว้ในระบบเดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ • เปิดรับแทงได้ตลอด 24 ชั่วโมง ตามรอบที่ระบบกำหนดของแต่ละรายการ • ตรวจสอบอัตราจ่ายและรายละเอียดบิลได้ก่อนกดยืนยันทุกครั้ง • เลข 2 ตัวจ่าย 100 • เลข 3 ตัวจ่าย 1,000 • สมัคร ${BRAND_NAME} ผ่านมือถือได้ด้วยตัวเองใน 3 ขั้นตอน • ตรวจผลหวยทุกประเภทได้จากหน้าเดียว • แอดมินดูแลสมาชิกตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#fcdc2b]/55 bg-gradient-to-r from-[#143a1c]/85 to-[#07130a] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(252,220,43,0.3)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#fcdc2b] bg-[#0d2312] shadow-[0_0_15px_rgba(252,220,43,0.55)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#1fae1c]/70 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#f2efd5]">
        <span class="drop-shadow-[0_0_5px_rgba(252,220,43,0.55)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(252,220,43,0.55)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
