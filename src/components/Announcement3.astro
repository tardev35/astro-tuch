---
const {
  message = "JADTEM88 สล็อตเครือยักษ์ใหญ่ เซิร์ฟนอก ไม่ล็อกรางวัล ปลอดภัย เชื่อถือได้ • รวมเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร และแบล็กแจ็กจากหลายค่ายไว้ในบัญชีเดียว • สมัครด้วยตัวเองง่าย ๆ 3 ขั้นตอน พร้อมตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่ • เข้าใช้งานได้ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ • แอดมิน JADTEM88 พร้อมช่วยตรวจสอบผ่าน LINE Official",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#2563eb]/40 bg-gradient-to-r from-[#0f1e3d]/70 to-[#03060f] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(37,99,235,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#60a5fa] bg-[#03060f] shadow-[0_0_15px_rgba(37,99,235,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#60a5fa]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#cbd5e1]">
        <span class="drop-shadow-[0_0_5px_rgba(96,165,250,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(96,165,250,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
