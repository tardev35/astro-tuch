---
// ticker หลักของแบรนด์รอบนี้ (หวย24 — เว็บแทงหวยออนไลน์ 24 ชั่วโมง)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ GOT777, 888PARUAY,
// UFAGOOL, ABM96, หวยเต็ง และ DM899)
//
// ห้ามขึ้นต้นข้อความด้วย emoji: ข้อความนี้เป็น prop ธรรมดา ใส่ aria-hidden
// ให้ emoji ข้างในไม่ได้ และ marquee นี้ render ข้อความซ้ำสองชุด
// ชุดที่สองจึงต้อง aria-hidden="true" ไม่ให้ screen reader อ่านซ้ำ
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น — ไม่มีการอ้างใบอนุญาต ผู้ให้บริการ
// ชื่อธนาคาร ยอดฝากขั้นต่ำ เวลาออกรางวัล หรือจำนวนสมาชิก เพราะบรีฟไม่ได้ระบุไว้
// สักคำ ตัวเลขที่อ้างได้มีห้าตัวคือ 2 ตัว · 3 ตัว · 100 บาท · 1,000 บาท ·
// 3 ขั้นตอน (บวก 24 ชั่วโมง ซึ่งเป็นชื่อแบรนด์เอง) และไม่มีคำหมวดสล็อต/คาสิโน
// (สล็อต บาคาร่า คาสิโนสด ค่ายเกม RTP คืนยอดเสีย แนะนำเพื่อน) เพราะ หวย24
// เป็นเว็บแทงหวย ไม่ใช่เว็บสล็อตแบบแบรนด์ที่เคยใช้ไฟล์นี้
// ประโยคกำกับของบรีฟเอง ("รับไม่อั้น"/"จ่ายเต็มทุกโพย" ควรยึดวงเงินจริงที่ระบบ
// แสดง · แนวทางหวยเป็นข้อมูลประกอบ ไม่รับประกันผลรางวัล) ขนมาด้วย ไม่ตัดทิ้ง
// เพราะฟังดูลบ
//
// ธีม: พื้นดำอมแดง #0a0303 / #2a0606 / #7a0505 ขอบและกระดิ่งเป็นแดงแบรนด์
// #d20a0a เส้นคั่นเป็นทองแบรนด์ #f5c33b (คู่แดง-ทองของโลโก้กับแบนเนอร์)
// ตัวอักษร #f7e2d6 เรืองแสง rgba(210,10,10,α) — ชุดเขียวมรกต-แดงสดของ DM899
// (#030a05 #0a2410 #0a4a18 #01a326 #fb252b #e4f2e4) ถูกถอดออกหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บแทงหวยออนไลน์ รวมรายการและแนวทางหวยไว้ให้ติดตามผ่านมือถือ • มีทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล • ตรวจสอบรอบเปิดรับ อัตราจ่าย ผลรางวัล และประวัติโพยได้จากบัญชีเดียว • อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข ควรยึดอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยัน • คำว่า “รับไม่อั้น” และ “จ่ายเต็มทุกโพย” ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง เพราะเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับต่างจากเลขทั่วไป • แนวทางหวยและเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้ • สมัคร ${BRAND_NAME} ผ่านมือถือได้ใน 3 ขั้นตอน แล้ว Login เลือกหวย รอบ และเลขที่ต้องการได้ทันที • ควรตรวจสอบเลขและจำนวนเงินก่อนยืนยันทุกครั้ง และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น • ระบบเว็บไซต์เข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#d20a0a]/60 bg-gradient-to-r from-[#7a0505]/85 to-[#0a0303] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(210,10,10,0.35)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#d20a0a] bg-[#2a0606] shadow-[0_0_15px_rgba(210,10,10,0.6)]">
      <span aria-hidden="true" class="ping text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-px bg-gradient-to-b from-transparent via-[#f5c33b]/70 to-transparent"></div>

    <div class="marquee-window flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="marquee-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#f7e2d6]">
        <span class="drop-shadow-[0_0_5px_rgba(210,10,10,0.6)]">{message}</span>
        <span aria-hidden="true" class="drop-shadow-[0_0_5px_rgba(210,10,10,0.6)]">{message}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: scroll 25s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  .ping {
    animation: ping-soft 2s ease-in-out infinite;
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
  @keyframes ping-soft {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .ping {
      animation: none;
    }
  }
</style>
