---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// ⚠️ NO HEADING LEVEL IS HARDCODED IN THIS FILE. The section heading renders at
// `as` and the three column labels follow it through `LabelTag`; this variant
// used to hardcode <h3> on all three labels, which put three headings on the
// page the brief never asked for. `heading={false}` demotes the labels to <p>
// while keeping the classes — the Phase 5 docx diff is only meaningful while
// chrome stays out of the heading list.
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid,
// exactly like ContentBoxTwoCyberCut's. The section heading sits in its own
// <header>, which is the only element allowed to carry `text-center` — putting it
// on the card would inherit straight into the slots and centre the body copy too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#c2185b]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fa539c] shadow-[0_0_8px_rgba(250,83,156,0.85)]";

// ───────────────────────────────────────────────────────────────────────────
// หมูบิน168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-moobin168.md §2
// รอบนี้ไฟล์นี้ถือ **docx H2 §6** ของหน้าแรก ("ระบบฝากถอน <แบรนด์> ได้ทุกธนาคาร
// และทรูมันนี่" — content.txt บรรทัด 19) โดยแบ่งย่อหน้าเดียวของบรีฟ (บรรทัด 20)
// เป็นสามส่วน: **ช่องทางที่ระบุไว้ → ข้อกำหนดจริงที่ต้องศึกษา → การตรวจบัญชี
// ปลายทางและสิ่งที่ต้องทำเมื่อพบความผิดปกติ** บรีฟไม่ได้ตั้งชื่อให้สามคอลัมน์
// หน้าเพจจึงไม่ส่ง titleleft/titlecenter/titleright มาเลย กล่องนี้จึงปล่อยหัวข้อ
// ออกมาใบเดียวคือหัวข้อของ section เอง · มีแค่ index.astro ที่ render ไฟล์นี้รอบนี้
//
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง**
// พื้นเพจ #ffe5ff (bg.json = ชมพูพาสเทลสว่างมาก) ส่วนรอบก่อน (สล็อต168) เป็น
// 140000 = ดำอมแดง **ห้ามแก้การ์ดกลับไปเป็นผิวมืด** — หมึก #3b0b26 บนการ์ดมืด
// คือตัวอักษรหายไปเลย
// ลำดับผิว: #ffffff ยก · **#fff0f8 ผิวการ์ด (ใบนี้)** · #ffeef7 wash ·
// #ffe5ff พื้นเพจ
//
// ⚠️ ความนูนแบบ neumorphic บนธีมสว่างกลับทางกับธีมมืด: **เงาฝั่งมืดเป็น
// rgba(194,24,91,α)** และ **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งอ่านเป็นแสงได้
// จริงเพราะสว่างกว่าทั้งผิวการ์ด #fff0f8 และพื้นเพจ #ffe5ff — **ห้ามใช้ดำหรือ
// ชมพูสดเป็นเงาฝั่งสว่างบนธีมนี้** (จะกลายเป็นเส้นขอบที่ไม่มีในพาเลต)
// หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 — สต็อปคือ พลัมเข้มสุด #8e0f41 (8.9:1 บนผิวการ์ด) → ชมพูเข้ม #c2185b
// (5.7:1) → #8e0f41 ซึ่งเป็นลำดับ "เข้ม → ชมพู → เข้ม" ที่ตรงกับตัวอักษรบับเบิล
// ในโลโก้ที่ไล่ชมพูบานเย็นสลับขาวมุกแล้วตัดขอบเข้ม
// 🚨 **ห้ามเอา #fa539c (3.1:1) #fb8cc0 #f7bcd9 #ef8dbd #fdc6c3 #ffd1cd มาเป็น
// สต็อป** — §2 ให้ทั้งหมดเป็นพื้นถม/ขอบ/ออราเท่านั้น
// เส้นใต้หัวข้อเป็นชมพูสด #fa539c ซึ่งเป็นแถบไม่มีตัวอักษร
// ป้ายคอลัมน์เป็นชมพูเข้ม #c2185b (5.7:1 บนผิวการ์ด ถือตัวอักษรได้) เส้นคั่น
// คอลัมน์เป็น #f7bcd9 · จุดนำหน้าป้ายเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร
// เนื้อความ #3b0b26 (= BRAND_TEXT) 16.2:1 บนผิวการ์ด
// ⚠️ **#ffffff #fff0f8 #ffeef7 #ffe5ff #f7bcd9 #ef8dbd เป็นสีพื้น/เส้นล้วน
// ห้ามถือตัวอักษร**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ชมพูผ่านรีโปนี้มาแล้วหลายเจ้า**
// ชมพูรอบนี้คือ #fa539c / #fb8cc0 ซึ่งวัดจาก logo.webp ของดรอปนี้เอง และ
// ⚠️⚠️ **เพื่อนบ้านที่ใกล้ที่สุดคือ f5469f ของ มีโชค168 ห่างแค่ R5/G13/B3 และ
// fa63b9 ของ ถอนชัวร์168 ซึ่งมี R=fa ตรงกัน — เจอค่านั้นแปลว่าพิมพ์ผิด**
// รองลงมาคือ dd1b74 a4186b (มีทรัพย์168 — **a4186b มี 18 กลางค่าเหมือน #c2185b**
// และ **8c0f52 ของ มีโชค168 ห่างจาก #8e0f41 แค่ R2/B17**) ff8dc6 ffb3de ff3fa4
// f41571 ff5ca8 ff8f9c ffadaf f2bba5 fce2d4 fcd4c3
// ⚠️⚠️ ชุดแดงเจล-มุกอุ่นบนดำอมแดงของแบรนด์ขาออก **สล็อต168** (fb2e33 cb0b0d
// d81115 b00d11 8a0608 c9060a fa292c f92124 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000
// 0b0000 1c0607 2a0c0d 551c1e) ต้องไม่เหลือค่าไหน — **เสี่ยงหลงเหลือสูงสุด**
// ชุดที่เคยอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้ว: ชุดทองนำ-โครเมียมเงินบนดำสนิท
// ของ **รวย168** (ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 f3ece0 121110 1c1a16
// 070707 000000 3d3425 + rgba 227,167,18) · ก่อนนั้นเป็นชุดทองมังกร-โครเมียมของ
// **พักยก168** (eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6
// d6c6a8 3a2713 32200f 1f1308 291d0f 4e2f11) · ชุดแดงคริมสัน-ทองโบราณบนผิวขาว
// ของ **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212
// 280b0b ffeee8 fff1ef ffdbdb c99a3f) · ชุดฟ้าสกาย-ทองคานารีของ **สบาย168**
// (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
// eafaff a9e3f9 fdcb0c fefb6b 8a6504) · ชุดทองคานารี-เงินโครเมียมของ **ยูฟ้า168**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
// eae3d4 140e02) · ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** (0b7d28 0a5f1c 0f9b35
// 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) · ชุดทอง-ดำของ **หวยคิง**
// (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · ชุดทองไทย-
// แดงมังกรของ **รับตัง168** (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c
// cfd9e6 f5ece0 2b100f) · ชุดแดง-ทองของ **หวย365** (140203 dc0203 f5282a ffc93c
// ffeab0 8c0402 3a0a0c c08a07) · ชุดชมพูบานเย็นของ **มีทรัพย์168** (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) · ชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168**
// (eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a
// 2c1004 fff0e4 fff4ea ffd1d1 1a0802) และ **ufalion168** (d4922c fdfc71 d39c45
// f6e3b4 a25b24 5a3310) ก็ไม่เหลือค่าไหน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองสักเฉด ไม่มีเขียว (ยกเว้น LINE green และเขียว success
// ที่ไฟล์อื่น) ไม่มีน้ำเงิน/ฟ้า/ไซยาน ไม่มีม่วง ไม่มีส้ม ไม่มีครีม/เบจ/น้ำตาล
// และไม่มีแรมป์เทาเงิน** — ความต่างของรอบนี้คือพื้นเพจชมพูพาสเทล #ffe5ff กับคู่
// วัสดุ **ชมพูสด #fa539c × พลัมเข้ม #3b0b26** ไม่ใช่ค่าชมพูเดี่ยว ๆ
// ⚠️ ชมพูรอบนี้มาจาก **ตัวอักษรบับเบิล "หมูบิน168" กับหัวใจในโลโก้ และแคปซูล
// 0.3% / 0.8% บนสไลด์** ไม่ใช่จากคาร์ดิแกนของนักแสดง (นั่นเป็นวัตถุในภาพ)
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#fff0f8] p-8 shadow-[12px_12px_26px_rgba(194,24,91,0.14),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(194,24,91,0.2),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#8e0f41] via-[#c2185b] to-[#8e0f41] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fa539c] to-transparent shadow-[0_0_10px_rgba(250,83,156,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3b0b26]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#f7bcd9] pb-6 text-left text-base leading-relaxed text-[#3b0b26] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#f7bcd9] pb-6 text-left text-base leading-relaxed text-[#3b0b26] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3b0b26] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
