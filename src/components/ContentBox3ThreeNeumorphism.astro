---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// ⚠️ NO HEADING LEVEL IS HARDCODED IN THIS FILE. The section heading renders at
// `as` and the three column labels follow it through `LabelTag`; this variant
// used to hardcode <h3> on all three labels, which put three headings on the
// page the brief never asked for. `heading={false}` demotes the labels to <p>
// while keeping the classes — the Phase 5 docx diff is only meaningful while
// chrome stays out of the heading list.
//
// 🚨 รอบนี้บรรทัด 15/17/19 ของบรีฟ ("ขั้นตอนที่ 1/2/3 …") **ไม่มี prefix H** จึง
// ห้ามเป็น heading ทุกระดับ — หน้าแรกรอบนี้จึง **ไม่ส่ง titleleft/titlecenter/
// titleright มาเลย** และเขียนป้ายขั้นตอนเป็น <p class="font-bold …"> ไว้ในสล็อต
// ของตัวเองแทน (หนึ่งสล็อต = หนึ่ง element หน้าเพจจึงห่อสองย่อหน้าไว้ใน <div>
// ใบเดียวเอง) **ห้ามส่งป้ายกลับเข้ามาโดยไม่ตั้ง heading={false} พร้อมกัน**
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid,
// exactly like ContentBoxTwoNeumorphism's. The section heading sits in its own
// <header>, which is the only element allowed to carry `text-center` — putting it
// on the card would inherit straight into the slots and centre the body copy too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#5411c4]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#f23bb4] shadow-[0_0_8px_rgba(242,59,180,0.85)]";

// ⚠️ เขียนชื่อคลาสสีในคอมเมนต์แบบไม่เต็มรูปโดยตั้งใจ — Tailwind สแกนคอมเมนต์ด้วย
//
// ───────────────────────────────────────────────────────────────────────────
// ZANE96 (ดรอป 2026-10-25) — พาเลตตาม .claude/brand-spec-zane96.md §2
// รอบนี้ไฟล์นี้ถือ **docx H2 §6** ของหน้าแรก ("วิธีการสมัคร <แบรนด์> ด้วยมือถือ
// 3 ขั้นตอน" — content.txt บรรทัด 13) โดย **ย่อหน้าอินโทร (บรรทัด 14) ลง default
// slot** และ **สามขั้นตอนของบรีฟ (บรรทัด 15–20) ลง left/center/right** ตามลำดับ
// เอกสาร โดยไม่ตกข้อความสักประโยค
// 🚨 **บรีฟรอบนี้เขียนว่า "ด้วยมือถือ" ไม่ใช่ "ด้วยตัวเอง"** — คำหลังเป็นของ
// MEXICANOSLOT รอบก่อน และเป็นคำที่พลาดง่ายที่สุดของรอบนี้ (brand-spec §5)
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนหัวข้อ/ขั้นตอนเรื่องฝากเงินขึ้นมาเอง
// (src/pages-disabled/ อ้างไฟล์นี้อยู่ด้วย แต่ Astro ไม่ route โฟลเดอร์นั้น)
//
// 🚨 ธีมสว่าง: พื้นเพจ #f8e6f9 (bg.json = ไลแลคอมชมพูจาง)
// **ห้ามแก้การ์ดกลับไปเป็นผิวมืดตามโครม** — หมึก #241046 บนการ์ดมืดคือตัวอักษร
// หายไปเลย (navbar/footer/ticker รอบนี้เป็น #190b3d แต่ไฟล์นี้อยู่ในโซนเนื้อหา)
// ลำดับผิว: #ffffff การ์ด/ฝั่งสว่างของเงานูน · **#f6edfe ผิวยก (ใบนี้)** ·
// #ece0fb wash · #f8e6f9 พื้นเพจ
//
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืดเป็น rgba(84,17,196,α)** และ
// **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งอ่านเป็นแสงได้จริงเพราะสว่างกว่าทั้ง
// ผิวการ์ด #f6edfe และพื้นเพจ #f8e6f9 — **ห้ามใช้ดำหรือม่วงสดเป็นเงาฝั่งสว่าง**
// หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 — สต็อปคือ ไวโอเลตลึก #5411c4 (9.3:1 บนขาว) → ไวโอเลตนีออน #7a1bd6
// (7.1:1) → #5411c4 ซึ่งเป็นลำดับ "ลึก → นีออน → ลึก" ที่ตรงกับเวิร์ดมาร์กสามมิติ
// ผิวโครเมียมที่ไล่ฟ้า→ม่วงแล้วตัดขอบขาวหนา
// 🚨 **ห้ามเอา #f23bb4 (3.5:1) #bb6dff (3.1:1) #7aa7ff #dcc6f4 #9a6fd0 มาเป็น
// สต็อป** — §2 ให้ทั้งหมดเป็นพื้นถม/ขอบ/ออราเท่านั้น
// เส้นใต้หัวข้อเป็นแมเจนต้านีออน #f23bb4 ซึ่งเป็นแถบไม่มีตัวอักษร
// ป้ายคอลัมน์เป็นไวโอเลตลึก #5411c4 (~9:1 บนผิวใบนี้ ถือตัวอักษรได้) เส้นคั่น
// คอลัมน์เป็น #dcc6f4 · จุดนำหน้าป้ายเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร
// เนื้อความ #241046 (= BRAND_TEXT) ~16:1 บนผิวใบนี้
// ⚠️ **#ffffff #f6edfe #ece0fb #f8e6f9 #dcc6f4 #9a6fd0 #f23bb4 #bb6dff #7aa7ff
// เป็นสีพื้น/เส้นล้วน ห้ามถือตัวอักษร**
// rgba() ที่อนุญาตรอบนี้: rgba(122,27,214,α) · rgba(84,17,196,α) ·
// rgba(194,23,139,α) · rgba(242,59,180,α) · rgba(43,63,217,α) ·
// rgba(187,109,255,α) · rgba(36,16,70,α) · rgba(220,198,244,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — อาร์ตเวิร์กรอบนี้คร่อม **ฟ้า ม่วง และ
// แมเจนต้า** ซึ่งเป็นฮิวนำของแบรนด์ก่อนๆ สามเจ้าพร้อมกัน "เจอสามสีนี้" จึงไม่
// พิสูจน์ว่าเป็นของรอบนี้ ค่าที่กวาดออกแล้ว (เขียนแบบไม่มี # โดยตั้งใจ):
//   **okkub88 (ชุดที่เพิ่งอยู่ทั้งใบนี้ — เสี่ยงหลงเหลือสูงสุด)** — ffd6fa fff4fb
//     ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
//     d91a73 b01160 85094a fd6cb2 fc7cba fc4da1 + rgba 156/15/85, rgba 251/67/155
//     ⚠️⚠️ **85094a / 9c0f55 เคยเป็นสามสต็อปของหัวข้อใบนี้ตรง ๆ และ fb439b เป็น
//     เส้นใต้กับจุดนำป้าย — ทั้งชุดต้องไม่เหลือ**
//   **MEXICANOSLOT (แบรนด์ขาออก)** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08
//     3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4
//     e2855c fde4d3 fff3ea fef6fb 117a41 2bb061 f2543f
//   **ม่วงของแบรนด์อื่น — รอบนี้ม่วงเป็นฮิวนำ จึงต้องเทียบแน่นที่สุด** — 7e22ce
//     d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88)
//     ⚠️⚠️ **b453ff ↔ #bb6dff ต่างไบต์เดียว · 7505cc ↔ #7a1bd6**
//   **ฟ้า/ไซแอน/น้ำเงินของแบรนด์อื่น** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f
//     0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 · 1177e8 0e68cc
//     0a4ea8 · 1fd8f0 0bb6d4 1d4fd8 143aa0 · 18a5e2 0d6b9b 0a5176 a9d7f2 · 2cc3fc
//     6bdcfb 0a7fbd 063a57 · 039cfa 0494f5 c3ebfc · 32bcfb a9e9ff 07335f · 2f9ff5
//     a8dcff d6ecff 0b3f78 · 0360f3 0292fb 6ec8ff · 00f3ff e0ffff 60a5fa 4b5563
//     030712 1f2937 ⚠️⚠️ **60a5fa ↔ #7aa7ff · 1d4fd8 ↔ #2b3fd9**
//   **ชมพู/แดงของแบรนด์อื่น** — fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9
//     ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463 · f41571
//     ff5ca8 · f5469f ff8dc6 8c0f52 · fa63b9 ffb3de · dd1b74 a4186b 4a0d35 2d0720 ·
//     fb2e33 cb0b0d d81115 b00d11 8a0608 · ff2e52 e01238 c9102f · fb1b32 ff8f9c ·
//     fa0513 ff5a5f ffadaf · b3121b f2bba5 · fce2d4 fcd4c3 · ff3fa4 ffd1ea
//   **ทอง/ครีม/เทาเงินของแบรนด์อื่น — รอบนี้ไม่มีเลยสักเฉด** — ffd94a e3a712 9d6f06
//     eeae12 fded41 dcb95f f5ba14 fdcb0c fee45d e5a81b cd9a2c f0b429 f9a826 ·
//     f4ead6 d6c6a8 f4e4d3 e4cbb3 ecd5c4 d2b9a4 f3ece0 e8eaee b4b9c2 6b7079 dde1e7
//     f0e6e4 c9b9b7 d9c9a6 cfd6e3
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีส้ม ไม่มีเขียวแบรนด์ ไม่มีครีม/เบจ/
// น้ำตาล และไม่มีแรมป์เทาเงิน** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของ
// ฟีดถอนเงินอยู่ไฟล์อื่น คงไว้) — ความต่างของรอบนี้คือพื้นเพจไลแลค #f8e6f9 กับคู่
// วัสดุ **ไวโอเลตนีออน #7a1bd6 × หมึกอินดิโกม่วงจม #241046** ไม่ใช่ค่าม่วงเดี่ยว ๆ
// ⚠️ ม่วงรอบนี้มาจาก **เวิร์ดมาร์ก ตู้สล็อต 777 ผิวแก้ว เพชร และลำแสงนีออน** ไม่ใช่
// จากชุดเมทัลลิกโฮโลแกรมของนักแสดง (นั่นเป็นวัตถุในภาพ)
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#f6edfe] p-8 shadow-[12px_12px_26px_rgba(84,17,196,0.14),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(84,17,196,0.2),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#5411c4] via-[#7a1bd6] to-[#5411c4] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f23bb4] to-transparent shadow-[0_0_10px_rgba(242,59,180,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#241046]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#dcc6f4] pb-6 text-left text-base leading-relaxed text-[#241046] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#dcc6f4] pb-6 text-left text-base leading-relaxed text-[#241046] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#241046] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
