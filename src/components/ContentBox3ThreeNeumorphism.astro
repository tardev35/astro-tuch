---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
//
// The section heading sits in its own <header>, which is the only element allowed
// to carry `text-center`: putting it on the card would inherit straight into the
// slot and centre the body paragraphs too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#eef0f4]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#dc0409] shadow-[0_0_8px_rgba(220,4,9,0.95)]";

// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04, brand-spec §2):
// แผ่นนูนเป็นผิวการ์ด #17080c ที่กดเงาลงไปหาพื้นเพจดำอมแดง #0d0407 และยกแสงขึ้นด้วย
// ผิวการ์ดสว่าง #211016 — ความนูนแบบ neumorphic ต้องเป็นคู่มืด/สว่างในโทนเดียว จึง
// ไม่มีสีที่สองมาอยู่ในเงา สีเน้นจึงปรากฏเฉพาะที่หัวข้อ เส้นคั่นคอลัมน์ และจุดนำหน้า
// ป้าย คือแดงแบรนด์ #dc0409 กับเงินสว่าง #eef0f4 ส่วนหัวข้อไล่จากแดงสว่าง #f5363d
// ผ่านแดงแบรนด์ไปจบที่เงินกลาง #c3c7d1 — ลำดับนี้ไม่ซ้ำกับ ContentBox (เงิน→แดง)
// หรือ ContentBoxNeumorphism (แดง→เงินสว่าง) ที่อยู่บนหน้าเดียวกัน ตามโลโก้ที่คำว่า
// "ดีใจ" เป็นแดงเมทัลลิกและ "หวย" เป็นโครเมียมเงิน เนื้อความ #edeaf0 (= BRAND_TEXT)
//
// ชุดแดง-ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#170707 #0a0303 #230d0d #d20a0a
// #f5c33b #ffd45e #ff5c5c #f7e2d6) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#17080c] p-8 shadow-[10px_10px_20px_#0d0407,-10px_-10px_20px_#211016] transition-all duration-300 hover:shadow-[15px_15px_30px_#0d0407,-15px_-15px_30px_#211016]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#f5363d] via-[#dc0409] to-[#c3c7d1] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dc0409] to-transparent shadow-[0_0_10px_rgba(220,4,9,0.7)]" />
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#211016] pb-6 text-left text-base leading-relaxed text-[#edeaf0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#211016] pb-6 text-left text-base leading-relaxed text-[#edeaf0] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#edeaf0] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
