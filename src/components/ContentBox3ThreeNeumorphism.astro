---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
//
// The section heading sits in its own <header>, which is the only element allowed
// to carry `text-center`: putting it on the card would inherit straight into the
// slot and centre the body paragraphs too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#b6ff9c]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.9)]";

// BRAZIL999 palette (เขียว-โครเมียม-ดำ 2026-09-25): แผ่นนูนเป็นผิวการ์ดเขียวเข้ม
// #0a1a0c ที่กดเงาลงไปหาพื้นเพจดำอมเขียว #040a05 และยกแสงขึ้นด้วยผิวการ์ดยก
// #123a18 — ความนูนแบบ neumorphic ต้องเป็นคู่มืด/สว่างในโทนเดียว จึงไม่มีสีที่สอง
// มาอยู่ในเงา เขียวจึงปรากฏเฉพาะที่หัวข้อ เส้นคั่นคอลัมน์ และจุดนำหน้าป้าย คือ
// เขียวแบรนด์ #22c55e กับเขียวสว่าง #b6ff9c ส่วนหัวข้อไล่จากโครเมียม #f1f5f9 ผ่าน
// เขียวสว่างไปจบที่เขียวแบรนด์ ตามโลโก้ที่คำว่า BRAZIL เป็นโครเมียมแล้วปิดท้ายด้วย
// เลข 999 สีเขียวสด เนื้อความ #dfeadd (BRAND_TEXT) — ชุดทอง-ดำของ KINGDOM66
// (#e6bf4e #f2d683 #efe6cf #f5e196 #241c13 #151109 #050403 #ebe3d3) ออกหมดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#0a1a0c] p-8 shadow-[10px_10px_20px_#040a05,-10px_-10px_20px_#123a18] transition-all duration-300 hover:shadow-[15px_15px_30px_#040a05,-15px_-15px_30px_#123a18]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent shadow-[0_0_10px_rgba(34,197,94,0.6)]" />
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#123a18] pb-6 text-left text-base leading-relaxed text-[#dfeadd] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#123a18] pb-6 text-left text-base leading-relaxed text-[#dfeadd] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
