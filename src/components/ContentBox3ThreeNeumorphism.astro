---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
// THIS round the page passes heading={false}: the brief writes its three signup
// steps as running prose, not as labelled sub-headings, so the labels are <p> and
// the printed h3 count stays at the docx's own two.
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid,
// exactly like ContentBoxTwoCyberCut's. The section heading sits in its own
// <header>, which is the only element allowed to carry `text-center` — putting it
// on the card would inherit straight into the slots and centre the body copy too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#f0b429]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#d30304] shadow-[0_0_8px_rgba(211,3,4,0.95)]";

// รับตัง168 (รอบทองไทยนำ แดงมังกรรอง บนดำอมแดง 2026-10-18, brand-spec §2):
// แผ่นนูนเป็นผิวการ์ด **ผิวกลาง #200a09** ที่กดเงาลงไปหาผิวจม #140505 และยกแสงขึ้น
// ด้วยผิวยก #2b100f — ความนูนแบบ neumorphic ต้องเป็นคู่มืด/สว่างในโทนเดียว จึงไม่มี
// สีที่สองมาอยู่ในเงา สีเน้นจึงปรากฏเฉพาะที่หัวข้อ เส้นคั่นคอลัมน์ และจุดนำหน้าป้าย
// คือทองแบรนด์ #f0b429 กับแดงแบรนด์ #d30304
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง #1a0505** (bg.json) ซึ่ง **สว่างกว่าผิวจม #140505**
// เงาที่กดลงไปจึงยังมืดกว่าพื้นเพจจริง
// ⚠️ รอบนี้ **ทองนำ แดงรอง** ซึ่งกลับลำดับจากรอบก่อน (สมหวัง168 แดงนำ ทองรอง) —
// กองเหรียญจีนทองรูสี่เหลี่ยมเป็นบริเวณอิ่มสีที่กว้างที่สุดในงานอาร์ตของดรอปนี้
// หัวข้อไล่ ทองแบรนด์ #f0b429 → ทองสว่าง #ffdc8c → แดงสว่าง #ff6b6e ซึ่งเป็นลำดับ
// คนละชุดกับอีกเจ็ดกล่องบนหน้าเดียวกัน ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซล
// ของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 — ห้ามเอา #d30304 #a00203
// #4a0202 #9a6c0c มาเป็นสต็อป และ **ห้ามเอา #cfd9e6 มาเป็นสต็อปเช่นกัน** เพราะ §2
// สงวนมันไว้เป็น "สีตัวอักษรรอง" อย่างเดียว ไม่ใช่สีระบบ
// เนื้อความ #f5ece0 (= BRAND_TEXT) — 13.9:1 บนผิวกลาง
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง และสามแบรนด์ก่อนหน้า
// เป็นแดงทั้งหมด** ชุดแดงแบรนด์-เงินโครเมียมของ หวยดีใจ ที่เคยค้างอยู่ทั้งไฟล์นี้
// (#dc0409 #f5363d #eef0f4 #c3c7d1 #edeaf0 #17080c #0d0407 #211016) ออกครบทุกจุดแล้ว
// และชุดแดง-ทองของ หวย24 ที่ค้างก่อนหน้านั้น (#170707 #0a0303 #230d0d #d20a0a
// #f5c33b #ffd45e #ff5c5c #f7e2d6) ก็ไม่เหลือ
// ⚠️ แดงรอบนี้คือ #d30304 (R=211 G=3 B=4) — ไม่ใช่ #dc0409 (หวยดีใจ) #d20a0a (หวย24)
// #d4200d (PIGPG) #fa0513 (สมหวัง168) #fb131b (TKB55) #fb141b (GT66B) #e8232a
// (SUPERSLOTCLUB) หรือ #ff3b14 (FLASH877) และทองรอบนี้คือ #f0b429 ไม่ใช่ #e3b23c
// #dfa310 #e5a81b #e2b33f #f5c33b หรือ #fad354
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม** และ
// ไม่มีโครเมียม/เงินเป็นสีระบบ
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#200a09] p-8 shadow-[10px_10px_20px_#140505,-10px_-10px_20px_#2b100f] transition-all duration-300 hover:shadow-[15px_15px_30px_#140505,-15px_-15px_30px_#2b100f]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#f0b429] via-[#ffdc8c] to-[#ff6b6e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0b429] to-transparent shadow-[0_0_10px_rgba(240,180,41,0.7)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f5ece0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#2b100f] pb-6 text-left text-base leading-relaxed text-[#f5ece0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#2b100f] pb-6 text-left text-base leading-relaxed text-[#f5ece0] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5ece0] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
