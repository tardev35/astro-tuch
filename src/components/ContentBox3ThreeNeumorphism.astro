---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions the page invented to
   *  break one paragraph into three readable columns — they then render as <p>
   *  carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the brief's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// ⚠️ NO HEADING LEVEL IS HARDCODED IN THIS FILE. The section heading renders at
// `as` and the three column labels follow it through `LabelTag`; this variant
// used to hardcode <h3> on all three labels, which put three headings on the
// page the brief never asked for. `heading={false}` demotes the labels to <p>
// while keeping the classes — the Phase 5 brief diff is only meaningful while
// chrome stays out of the heading list.
//
// รอบนี้ (ดรอป 2026-10-28) ไฟล์นี้ถูก render จาก **/ตรวจหวย กับ /แนวทาง** ซึ่ง
// ถูกย้ายกลับเข้า src/pages/ เพราะแบรนด์รอบนี้เป็นเว็บหวย ทั้งสองหน้าส่ง
// `heading={false}` มา เพราะป้ายสามคอลัมน์เป็นคำบรรยายที่หน้านั้นตั้งเอง (ชื่อ
// ประเภทหวย) ไม่ใช่หัวข้อย่อยของบรีฟ **ห้ามส่งป้ายกลับเข้ามาโดยไม่ตั้ง
// heading={false} พร้อมกัน**
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid.
// The section heading sits in its own <header>, which is the only element allowed
// to carry `text-center` — putting it on the card would inherit straight into the
// slots and centre the body copy too. **ห้ามเพิ่ม wrapper ใหม่ใน slot และห้ามลบ
// wrapper ที่ทำ layout จริง**
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#046c4e]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#19a97c] shadow-[0_0_8px_rgba(25,169,124,0.85)]";

// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ — Tailwind สแกนคอมเมนต์ด้วย
// ⚠️ และห้ามเขียน "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้ — การ sweep
// ไล่หาสีของแบรนด์เก่าใน src/ จะสะดุดที่คอมเมนต์ของตัวเองทุกครั้ง
// **ลิสต์ค่าต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lottoplus.md` §2 ที่เดียว**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้ตาม `.claude/brand-spec-lottoplus.md` §2 —
// **เขียวมรกตนำ · ทองอำพัน/เงินโครเมียมคู่รอง · เนื้อหาเป็นผิวสว่าง**
// 🚨 ธีมสว่าง: พื้นเพจ e1fef3 (bg.json ของดรอปนี้ = เขียวมินต์จางเกือบขาว และ
// bg.json คือแหล่งเดียวของพื้นเพจ — เปิดอ่านทุกรอบ ห้ามสืบทอดค่าข้ามรอบ)
// **ห้ามแก้การ์ดกลับไปเป็นผิวมืดตามโครม** — หมึก 0d3326 บนการ์ดมืดคือตัวอักษร
// หายไปเลย (navbar/footer/ticker รอบนี้เป็น 052e22 แต่ไฟล์นี้อยู่ในโซนเนื้อหา)
// 🚨 **ไฟล์นี้เพิ่งถือพาเลตของแบรนด์หวยเจ้าก่อนมาเต็มใบ (คนละฮิวกับรอบนี้)
// ทุกค่าถูกแทนด้วยตารางใน §2 แล้ว ห้ามให้ค่าเดิมกลับเข้ามา**
//
// ลำดับผิว: ffffff ฝั่งสว่างของเงานูน · **d2f3e4 ผิวยก (ใบนี้)** ·
// f0fdf7 การ์ดสำรอง · e1fef3 พื้นเพจ
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืดเป็น rgba(4,108,78,α) แบบเบา**
// และ **เงาฝั่งสว่างเป็นผิวขาว ffffff** ซึ่งอ่านเป็นแสงได้จริงเพราะสว่างกว่าทั้ง
// ผิวการ์ด d2f3e4 และพื้นเพจ e1fef3 — **ห้ามใช้ดำหรือเขียวสดเป็นเงาฝั่งสว่าง**
// และ **ห้ามลอกค่า alpha หนักของธีมมืดรอบก่อนมา** บนการ์ดสว่างจะเป็นคราบเทา
//
// หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 — สต็อปคือ เขียวจม 03543c (8.2:1 บนผิวใบนี้) → เขียวมรกต 046c4e (5.9:1)
// → 03543c ซึ่งเป็นลำดับ "ลึก → นำ → ลึก" ที่ตรงกับเวิร์ดมาร์กสามมิติสองบรรทัด
// (บรรทัดบนผิวโครเมียมเงินตัดขอบเขียวเข้ม บรรทัดล่างผิวเขียวมรกตไล่เงา)
// 🚨 **ห้ามเอา 19a97c (3.0:1 บนขาว) · 2fd49b · a3ddc3 · d2f3e4 · e2b32a (2.0:1)
// · c8d4d0 มาเป็นสต็อป** — §2 ให้ทั้งหมดเป็นพื้นถม/ขอบ/ออราบนผิวสว่างเท่านั้น
// เส้นใต้หัวข้อเป็นเขียวสด 19a97c ซึ่งเป็นแถบไม่มีตัวอักษร
// ป้ายคอลัมน์เป็นเขียวมรกต 046c4e (5.9:1 บนผิวใบนี้ ถือตัวอักษรได้) เส้นคั่น
// คอลัมน์เป็น a3ddc3 · จุดนำหน้าป้ายเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร
// เนื้อความ 0d3326 (= BRAND_TEXT) 12.1:1 บนผิวใบนี้
// ⚠️ **ffffff f0fdf7 d2f3e4 e1fef3 a3ddc3 19a97c 2fd49b e2b32a c8d4d0
// เป็นสีพื้น/เส้นล้วน ห้ามถือตัวอักษรบนผิวสว่าง**
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) ·
// rgba(47,212,155,α) · rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) ·
// rgba(3,32,26,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นแบรนด์เขียว/ทอง/เงิน และ
// **มีแบรนด์เก่าหลายเจ้าในรีโปนี้ที่ก็เป็นเขียว** (หนึ่งในนั้นเป็นเขียวมรกต/ทอง
// สัมฤทธิ์ = ตระกูลเดียวกับรอบนี้เป๊ะ) "เจอเขียว/ทอง" จึงไม่พิสูจน์ว่าเป็นของ
// รอบนี้ ต้องเทียบทีละหกหลักกับ §2 **ห้ามตัดสินด้วยสายตา** และถ้าเจอค่าที่ต่าง
// จาก §2 แค่ไบต์เดียว ให้ถือว่า **พิมพ์ผิด** ก่อนเสมอ
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู/แมเจนต้า ไม่มีแดง/เลือดหมู
// ไม่มีส้มเพลิง และไม่มีผิวมืดในโซนเนื้อหาเลยสักเฉด** (เขียว 00B900 ของปุ่ม LINE
// และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืนเข้าเขียวมรกตของ
// รอบนี้**) — ความต่างของรอบนี้คือพื้นเพจเขียวมินต์จาง e1fef3 กับคู่วัสดุ
// **เขียวมรกต 046c4e × หมึกเขียวจม 0d3326**
// ⚠️ เขียวรอบนี้มาจาก **เวิร์ดมาร์ก ใบโคลเวอร์สี่แฉก และแถบวงโคจรโครเมียม-เขียว
// ในอาร์ตเวิร์ก** ไม่ใช่จากผนังห้องสีขาวงาช้างหรือสีผิวนักแสดง (นั่นเป็นวัตถุในภาพ)
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#d2f3e4] p-8 shadow-[12px_12px_26px_rgba(4,108,78,0.14),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(4,108,78,0.18),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#03543c] via-[#046c4e] to-[#03543c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent`}>{title}</HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#19a97c] to-transparent shadow-[0_0_10px_rgba(25,169,124,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#0d3326]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#a3ddc3] pb-6 text-left text-base leading-relaxed text-[#0d3326] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#a3ddc3] pb-6 text-left text-base leading-relaxed text-[#0d3326] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d3326] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
