---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
// THIS round both calling pages pass heading={false}: the three column labels are
// captions the page invented to split one topic into three readable columns, not
// sub-headings the brief wrote, so they render as <p> and the printed heading
// inventory stays at h1×1 + the page's own h2 list.
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid,
// exactly like ContentBoxTwoCyberCut's. The section heading sits in its own
// <header>, which is the only element allowed to carry `text-center` — putting it
// on the card would inherit straight into the slots and centre the body copy too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#0a5f1c]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#0b7d28] shadow-[0_0_8px_rgba(11,125,40,0.85)]";

// ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น (src/pages/ตรวจหวย.astro ·
// src/pages/แนวทาง.astro) ซึ่งรอบนี้ (สาธุ168 2026-10-21) **เปิดอยู่** เพราะบรีฟ
// ทั้งฉบับเป็นเว็บหวยล้วน และ NavbarHuay/FooterHuay มีลิงก์ทั้งสองอยู่แล้ว
// ⚠️ ข้อยกเว้น "หน้าหวยคงธีม Huay แดง-ทอง" **ไม่ใช้รอบนี้** — ทั้งเว็บเป็นเว็บหวย
// และใช้ชุด *Huay อยู่แล้ว สองหน้านั้นจึงใช้พาเลตเขียว-ทองสัมฤทธิ์เหมือนทุกหน้า
//
// สาธุ168 (brand-spec §2 — เขียวมรกตนำ **ธีมสว่าง**): ไฟล์นี้อยู่ในโซน "เนื้อหา"
// จึงเป็นการ์ดสว่างหมึกเข้ม ไม่ใช่โครม
//   ผิวการ์ด (ชั้นยก) #ffffff · เส้นคั่นคอลัมน์/ขอบ #0b7d28 แบบโปร่ง
//   เนื้อความหมึกเขียวป่า #0c3a16 = 12.9:1 บนผิวการ์ด
//   ป้ายคอลัมน์เขียวเข้ม #0a5f1c = 7.9:1 · จุดนำหน้าป้ายเป็นเขียวมรกต #0b7d28
//     (จุดเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร)
// ความนูนแบบ neumorphic ของธีมสว่างกลับทางกับธีมมืด: เงาจมเป็น rgba(12,58,22,α)
// และเงายกเป็น #ffffff ซึ่งอ่านเป็นแสงได้เพราะพื้นเพจ #d8ffc7 เข้มกว่าผิวการ์ดขาว
// ⚠️ หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 — สต็อปคือ #0c3a16 (12.9:1) → #0a5f1c (7.9:1) → #0b7d28 (5.3:1)
// **ห้ามเอาทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c มาเป็นสต็อป** (1.7–2.8:1 บนขาว
// ตกทุกเกณฑ์ — ทองเป็นสีของโครมเท่านั้น) และ **ห้ามเอาเขียวใบตอง #0f9b35 มาเป็น
// สต็อปเช่นกัน** (3.7:1 บนขาว §2 สงวนไว้เป็นสต็อปของไล่เฉด/ออราที่ไม่มีตัวอักษร)
// ⚠️ #e9fbdd / #d8ffc7 เป็นสีพื้น/เส้นเท่านั้น ห้ามถือตัวอักษรบนผิวการ์ดขาว
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของไฟล์นี้คือทองกับแดง เพราะ
// เจ้าของเดิมทุกรายใช้คู่นั้น** ชุดทองไทย-แดงมังกรของรับตัง168 (f0b429 ffdc8c
// d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505)
// ออกครบทุกจุดแล้ว · ชุดแดงแบรนด์-เงินโครเมียมของ หวยดีใจ (dc0409 f5363d eef0f4
// c3c7d1 edeaf0 17080c 0d0407 211016) และชุดแดง-ทองของ หวย24 (170707 0a0303
// 230d0d d20a0a f5c33b ffd45e ff5c5c f7e2d6) ก็ไม่เหลือ · รวมถึงชุดชมพูบานเย็นของ
// รอบก่อนทันที มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม ไม่มีแดง และไม่มี
// เงิน/โครเมียมเป็นสีระบบ** — เขียวทั้งสี่ค่าคือความต่างของรอบนี้
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-white p-8 shadow-[12px_12px_26px_rgba(12,58,22,0.16),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(12,58,22,0.2),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#0c3a16] via-[#0a5f1c] to-[#0b7d28] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0b7d28] to-transparent shadow-[0_0_10px_rgba(11,125,40,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#0c3a16]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#0b7d28]/25 pb-6 text-left text-base leading-relaxed text-[#0c3a16] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#0b7d28]/25 pb-6 text-left text-base leading-relaxed text-[#0c3a16] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0c3a16] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
