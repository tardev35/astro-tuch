---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
//
// The section heading sits in its own <header>, which is the only element allowed
// to carry `text-center`: putting it on the card would inherit straight into the
// slot and centre the body paragraphs too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#ffd45e]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#d20a0a] shadow-[0_0_8px_rgba(210,10,10,0.9)]";

// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04, brand-spec §2): แผ่นนูนเป็น
// ผิวการ์ด #170707 ที่กดเงาลงไปหาพื้นเพจดำอมแดง #0a0303 และยกแสงขึ้นด้วยผิวการ์ด
// อุ่น #230d0d — ความนูนแบบ neumorphic ต้องเป็นคู่มืด/สว่างในโทนเดียว จึงไม่มีสีที่
// สองมาอยู่ในเงา สีเน้นจึงปรากฏเฉพาะที่หัวข้อ เส้นคั่นคอลัมน์ และจุดนำหน้าป้าย คือ
// แดงแบรนด์ #d20a0a กับทองสว่าง #ffd45e ส่วนหัวข้อไล่จากแดงสว่าง #ff5c5c ผ่าน
// แดงแบรนด์ไปจบที่ทองแบรนด์ #f5c33b — ลำดับนี้ไม่ซ้ำกับ ContentBox (ทอง→แดง) หรือ
// ContentBoxNeumorphism (แดง→ทองสว่าง) ที่อยู่บนหน้าเดียวกัน ตามโลโก้ที่วงกลม 24
// เป็นแดงและตัวอักษรบนแบนเนอร์เป็นทองโลหะ เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดเขียว-โครเมียมของ BRAZIL999 ที่เคยค้างในไฟล์นี้ (#0a1a0c #040a05 #123a18
// #22c55e #b6ff9c #f1f5f9 #dfeadd) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#170707] p-8 shadow-[10px_10px_20px_#0a0303,-10px_-10px_20px_#230d0d] transition-all duration-300 hover:shadow-[15px_15px_30px_#0a0303,-15px_-15px_30px_#230d0d]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ff5c5c] via-[#d20a0a] to-[#f5c33b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d20a0a] to-transparent shadow-[0_0_10px_rgba(210,10,10,0.6)]" />
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#230d0d] pb-6 text-left text-base leading-relaxed text-[#f7e2d6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#230d0d] pb-6 text-left text-base leading-relaxed text-[#f7e2d6] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
