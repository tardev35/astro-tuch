---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions the page invented to
   *  break one paragraph into three readable columns — they then render as <p>
   *  carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the brief's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// ⚠️ NO HEADING LEVEL IS HARDCODED IN THIS FILE. The section heading renders at
// `as` and the three column labels follow it through `LabelTag`; this variant
// used to hardcode <h3> on all three labels, which put three headings on the
// page the brief never asked for. `heading={false}` demotes the labels to <p>
// while keeping the classes — the Phase 5 brief diff is only meaningful while
// chrome stays out of the heading list.
//
// รอบนี้ (ดรอป 2026-10-27) ไฟล์นี้ถูก render จาก **/ตรวจหวย กับ /แนวทาง** ซึ่ง
// ถูกย้ายกลับเข้า src/pages/ เพราะแบรนด์รอบนี้เป็นเว็บหวย ทั้งสองหน้าส่ง
// `heading={false}` มา เพราะป้ายสามคอลัมน์เป็นคำบรรยายที่หน้านั้นตั้งเอง (ชื่อ
// ประเภทหวย) ไม่ใช่หัวข้อย่อยของบรีฟ **ห้ามส่งป้ายกลับเข้ามาโดยไม่ตั้ง
// heading={false} พร้อมกัน**
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid.
// The section heading sits in its own <header>, which is the only element allowed
// to carry `text-center` — putting it on the card would inherit straight into the
// slots and centre the body copy too. **ห้ามเพิ่ม wrapper ใหม่ใน slot และห้ามลบ
// wrapper ที่ทำ layout จริง**
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#b00718]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#c1071b] shadow-[0_0_8px_rgba(193,7,27,0.85)]";

// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ — Tailwind สแกนคอมเมนต์ด้วย
// ⚠️ และห้ามเขียน "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้ — การ sweep
// ไล่หาสีของแบรนด์เก่าใน src/ จะสะดุดที่คอมเมนต์ของตัวเองทุกครั้ง
// **ลิสต์ค่าต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lotto189.md` §2 ที่เดียว**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้ตาม `.claude/brand-spec-lotto189.md` §2 —
// **แดงเลือดนกนำ · ทองเข้มคู่รอง · เนื้อหาเป็นผิวสว่าง**
// 🚨 ธีมสว่าง: พื้นเพจ #fff0f0 (bg.json ของดรอปนี้ = ขาวอมชมพูจาง และ bg.json
// คือแหล่งเดียวของพื้นเพจ — เปิดอ่านทุกรอบ ห้ามสืบทอดค่าข้ามรอบ)
// **ห้ามแก้การ์ดกลับไปเป็นผิวมืดตามโครม** — หมึก #25090f บนการ์ดมืดคือตัวอักษร
// หายไปเลย (navbar/footer/ticker รอบนี้เป็น #24060c แต่ไฟล์นี้อยู่ในโซนเนื้อหา)
// 🚨 **สองหน้าหวยที่เรียกไฟล์นี้รอบก่อนเป็นผิวการ์ดเข้มทั้งหน้า — รอบนี้พลิกเป็น
// การ์ดสว่างทั้งไฟล์ ห้าม "แก้" กลับ**
//
// ลำดับผิว: #ffffff ฝั่งสว่างของเงานูน · **#ffe4e6 ผิวยก (ใบนี้)** ·
// #ffd4d7 wash · #fff0f0 พื้นเพจ
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืดเป็น rgba(176,7,24,α)** และ
// **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งอ่านเป็นแสงได้จริงเพราะสว่างกว่าทั้ง
// ผิวการ์ด #ffe4e6 และพื้นเพจ #fff0f0 — **ห้ามใช้ดำหรือแดงสดเป็นเงาฝั่งสว่าง**
//
// หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้
// ตาม §2 — สต็อปคือ แดงลึก #8a0412 (10.4:1 บนขาว) → แดงเลือดนก #b00718 (7.3:1)
// → #8a0412 ซึ่งเป็นลำดับ "ลึก → นำ → ลึก" ที่ตรงกับเวิร์ดมาร์กสามมิติผิวโครเมียม
// เงินตัดขอบแดง ต่อด้วยตัวเลขผิวแดงเลือดนกเคลือบเงา
// 🚨 **ห้ามเอา #ff2436 (3.9:1) #e9b53c (2.0:1) #f5b9bd #ffd4d7 #c3ccd6 มาเป็น
// สต็อป** — §2 ให้ทั้งหมดเป็นพื้นถม/ขอบ/ออราบนผิวสว่างเท่านั้น
// เส้นใต้หัวข้อเป็นแดงสด #d61023 ซึ่งเป็นแถบไม่มีตัวอักษร
// ป้ายคอลัมน์เป็นแดงเลือดนก #b00718 (~6.8:1 บนผิวใบนี้ ถือตัวอักษรได้) เส้นคั่น
// คอลัมน์เป็น #f5b9bd · จุดนำหน้าป้ายเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร
// เนื้อความ #25090f (= BRAND_TEXT) 16.4:1 บนผิวใบนี้
// ⚠️ **#ffffff #ffe4e6 #ffd4d7 #fff0f0 #f5b9bd #a8333f #ff2436 #e9b53c #c3ccd6
// เป็นสีพื้น/เส้นล้วน ห้ามถือตัวอักษรบนผิวสว่าง**
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(138,4,18,α) · rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นแบรนด์แดง/ทอง/ครีม ซึ่งเป็น
// ตระกูลเดียวกับแบรนด์เมื่อสามรอบก่อน และใกล้กับรอบก่อนทันที (ส้ม/ทอง/ครีม)
// "เจอแดง/ทอง/ครีม" จึงไม่พิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบทีละหกหลักกับ §2
// ⚠️ ใบนี้เคยถือพาเลตไวโอเลตนีออน/แมเจนต้าของแบรนด์สองรอบก่อนมาเต็มไฟล์ (หัวข้อ
// ไล่เฉด เส้นใต้ และจุดนำป้ายเป็นค่าของชุดนั้นตรง ๆ) จึงเป็นใบที่เสี่ยงหลงเหลือ
// สูงที่สุด — ค่าทุกค่าในไฟล์นี้ถูกแทนด้วยตารางใน §2 แล้ว
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพูบับเบิลกัม ไม่มีเขียวแบรนด์
// ไม่มีส้มเพลิง และไม่มีแรมป์เทาเงินบนผิวสว่างเลยสักเฉด** (เขียว #00B900 ของปุ่ม
// LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามเปลี่ยน) — ความต่าง
// ของรอบนี้คือพื้นเพจขาวอมชมพู #fff0f0 กับคู่วัสดุ **แดงเลือดนก #b00718 ×
// หมึกแดงจม #25090f**
// ⚠️ แดงรอบนี้มาจาก **เวิร์ดมาร์ก แคปซูลแดงขอบทอง และตัวอักษรสามมิติในอาร์ตเวิร์ก**
// ไม่ใช่จากผิวโครเมียมเงินหรือสีผิวนักแสดง (นั่นเป็นวัตถุในภาพ)
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#ffe4e6] p-8 shadow-[12px_12px_26px_rgba(176,7,24,0.14),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(176,7,24,0.2),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#8a0412] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent`}>{title}</HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d61023] to-transparent shadow-[0_0_10px_rgba(214,16,35,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#25090f]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#f5b9bd] pb-6 text-left text-base leading-relaxed text-[#25090f] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#f5b9bd] pb-6 text-left text-base leading-relaxed text-[#25090f] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#25090f] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
