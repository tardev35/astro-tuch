---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave it
   *  true only when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// This variant used to hardcode <h3> on all three column labels, which put three
// headings on the page that the brief never asked for. They follow `as` now, and
// `heading={false}` demotes them to <p> while keeping the classes — the docx
// diff in Phase 5 is only meaningful while chrome stays out of the heading list.
// THIS round both calling pages pass heading={false}: the three column labels are
// captions the page invented to split one topic into three readable columns, not
// sub-headings the brief wrote, so they render as <p> and the printed heading
// inventory stays at h1×1 + the page's own h2 list.
//
// The default slot is the section's INTRO, and it is the one wrapper in this file
// that cannot be hoisted away: it carries a real `mb-8` and sits beside the grid,
// exactly like ContentBoxTwoCyberCut's. The section heading sits in its own
// <header>, which is the only element allowed to carry `text-center` — putting it
// on the card would inherit straight into the slots and centre the body copy too.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? title ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-bold text-[#c30303]";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#c30303] shadow-[0_0_8px_rgba(195,3,3,0.85)]";

// ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น: src/pages/ตรวจหวย.astro และ
// src/pages/แนวทาง.astro ซึ่งรอบนี้ **เปิดอยู่** เพราะบรีฟทั้งฉบับเป็นเว็บหวยล้วน
// (หวยรัฐบาลไทย · หวยลาวพัฒนา · หวยฮานอย · หวยหุ้นต่างประเทศ)
// ⚠️ ข้อยกเว้น Phase 4.5 ของ playbook คุ้มครอง **ชุดคอมโพเนนต์** ของสองหน้านั้น
// (ชุด Huay/Neumorphism) ไม่ได้คุ้มครองสีหรือชื่อแบรนด์ — ไฟล์นี้จึงใช้พาเลตของ
// รอบปัจจุบันเต็มรูปแบบเหมือนทุกไฟล์ที่ render
//
// พาเลตรอบนี้ (brand-spec §2 — แดงเลือดหมูนำ ทองโบราณรอง **ธีมสว่าง**):
// ไฟล์นี้อยู่ในโซน "เนื้อหา" จึงเป็น **การ์ดสว่าง หมึกเข้ม** ไม่ใช่โครม
//   ผิวการ์ด (ชั้นยก) #ffffff · พื้นเพจ #ffdbdb (bg.json)
//   เนื้อความหมึกแดงเลือดหมู #4a0f0f = 15.4:1 บนผิวการ์ด
//   ป้ายคอลัมน์/ขอบคั่นคอลัมน์แดงสด #c30303 = 6.3:1 บนผิวการ์ด
//     (จุดนำหน้าป้ายเป็นวงกลมตกแต่ง aria-hidden ไม่ใช่ตัวอักษร)
// ความนูนแบบ neumorphic ของธีมสว่างกลับทางกับธีมมืด: เงาจมเป็น rgba(74,15,15,α)
// (หมึกของพาเลตเอง ไม่ใช่สีที่สาม) และเงายกเป็น #ffffff ซึ่งอ่านเป็นแสงได้จริง
// เพราะพื้นเพจ #ffdbdb เข้มกว่าผิวการ์ดขาว
// ⚠️ หัวข้อถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 — สต็อปคือ #4a0f0f (15.4:1) → #c30303 (6.3:1) → #4a0f0f
// **ห้ามเอาทองโบราณ #dcb95f #b8862b #96681f มาเป็นสต็อป** (1.9–3.5:1 บนขาว
// ตกทุกเกณฑ์ — ทองเป็นสีของโครมเท่านั้น) และ **ห้ามเอาแดงสแกเลต #e81313 มาเป็น
// สต็อปเช่นกัน** (§2 ห้ามมันถือตัวอักษร จึงใช้ได้เฉพาะแถบเส้นใต้หัวข้อที่ไม่มี
// ตัวอักษร) · #8f0505 สงวนไว้ให้ไฮไลต์บน <strong> ในย่อหน้าเท่านั้น
// ⚠️ #fff1ef / #ffdbdb เป็นสีพื้น/เส้นเท่านั้น ห้ามถือตัวอักษรบนผิวการ์ดขาว
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของไฟล์นี้คือทองกับแดง เพราะ
// เจ้าของเดิมทุกรายใช้คู่นั้น** รอบก่อนทันที เขียวมรกต-ทองสัมฤทธิ์ธีมสว่างของ
// สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd
// rgba 11/125/40 a · rgba 10/95/28 a · rgba 12/58/22 a · rgba 174/176/74 a)
// ออกครบทุกจุดแล้ว · ชุดทอง-ดำของ หวยคิง เจ้าของเดิมของไฟล์ชุด Huay (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · ชุดทองไทย-แดงมังกรของ
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f
// 200a09 140505 1a0505) · ชุดแดง-ทองของ หวย365 (140203 dc0203 f5282a ffc93c ffeab0
// 8c0402 3a0a0c c08a07 f6e7e0 1a0303) · ชุดชมพูบานเย็นของ มีทรัพย์168 (dd1b74
// a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ก็ไม่เหลือค่าไหนในไฟล์นี้
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า ไม่มีม่วง ไม่มีส้ม และไม่มี
// เงิน/โครเมียม** — ความต่างของรอบนี้คือพื้นเพจชมพูอมแดง #ffdbdb กับหมึก #4a0f0f
// ไม่ใช่ค่าแดงเดี่ยว ๆ
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-white p-8 shadow-[12px_12px_26px_rgba(74,15,15,0.16),-12px_-12px_26px_#ffffff] transition-all duration-300 hover:shadow-[16px_16px_32px_rgba(74,15,15,0.2),-16px_-16px_32px_#ffffff]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#4a0f0f] via-[#c30303] to-[#4a0f0f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e81313] to-transparent shadow-[0_0_10px_rgba(195,3,3,0.55)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#4a0f0f]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#c30303]/25 pb-6 text-left text-base leading-relaxed text-[#4a0f0f] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#c30303]/25 pb-6 text-left text-base leading-relaxed text-[#4a0f0f] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#4a0f0f] md:pl-6">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
