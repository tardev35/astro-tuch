---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — ทุกหน้าในรอบนี้ (ยกเว้นสองหน้าหวยที่คง
// AnnouncementHuay ไว้ตามข้อยกเว้น Phase 4.5) เรียก <Announcement /> แบบ bare
// ไม่ส่ง prop เลย ข้อความนี้จึงเป็นข้อความที่ขึ้นจริงเกือบทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงจะถูกอ่านออกเสียงซ้ำด้วย
// (ไอคอนทุกตัวในไฟล์นี้อยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความ)
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// รวยแท้168 (รอบแดงเลือดหมูนำ-ทองโบราณรอง บน **พื้นเพจชมพูกุหลาบสว่าง** 2026-10-21):
// ticker ที่ใช้งานจริงรอบนี้ — รอบก่อน (สาธุ168) ใช้ AnnouncementHuay จึงหมุนมาที่
// ไฟล์นี้ตาม brand-spec §3 ไฟล์นี้ล่าสุดเคย ship ให้ ดวงเศรษฐี168 จึงมาพร้อม
// พาเลตแดงชาด-ทองน้ำผึ้งของแบรนด์นั้น และโดนกวาดค่าต่อค่าครบแล้ว
//
// ทรงของรอบนี้: รางพื้นชั้นจม #280b0b ขอบทองโบราณโปร่ง แถบเฉียงซ้ายไล่
// แดงสด #c30303 -> แดงเข้ม #8f0505 แถบเฉียงขวาเป็นทองโบราณโปร่ง
// หัวแถบซ้ายเป็น **กล่องถมแดง** ถือกระดิ่งกับคำว่า ประกาศล่าสุด สีครีมอมชมพู
// #ffeee8 (6.3:1 บน #c30303 ผ่าน AA — แดงรอบนี้เป็นพื้นถม/ขอบ/ออรา **ห้ามถือ
// ตัวอักษร** บนพื้นเข้ม ถ้าอยากได้ตัวอักษรที่อ่านว่าแดง ต้องถมแดงแล้ววางครีมทับแบบนี้)
// เนื้อข้อความวิ่งเป็นครีม #ffeee8 บนชั้นจม #280b0b (ผ่านสบาย) จุดนำหน้าแต่ละท่อน
// เป็นทองโบราณ #dcb95f ซึ่งเป็นสีไฮไลต์ตัวเดียวของรอบนี้บนโครม
// ⚠️⚠️ รอบนี้ **พื้นเพจเป็นชมพูกุหลาบสว่าง #ffdbdb** ไม่ใช่ดำสนิทเหมือนรอบที่ไฟล์นี้
// เคย ship ล่าสุด รางชั้นจมจึงตัดกับพื้นเพจชัดเจนมากอยู่แล้ว ขอบทองและออราแดงเป็น
// ภาษาของแบรนด์ ไม่ใช่สิ่งที่จำเป็นต้องมีเพื่อแยกราง
//
// ชุดแดงชาด-ทองน้ำผึ้งของ ดวงเศรษฐี168 ที่เพิ่งอยู่ในไฟล์นี้รอบก่อน (d9212a /
// 8e1a16 / f0c878 / fff8d8 / 150303 / 4e2120 / 300605) ชุดเขียวมรกต-ทองสัมฤทธิ์
// ของ สาธุ168 (0b7d28 / 0a5f1c / 0f9b35 / 0c3a16 / 061f0c / c9cb63 / aeb04a /
// 9ba03c / d8ffc7 / e9fbdd) ชุดทองอำพัน-บรอนซ์ของ ufalion168 (d4922c / fdfc71 /
// a25b24 / f6e3b4 / 33200a / 1f1304 / 0a0601 / 5a3310) ชุดแดงชาด-ทองเนยของ
// มีเฮ168 (fb1b32 / ff8f9c / fcd45c / fdeaec / 0c0205 / 5c0410 / 6b4a08) ชุดฟ้า
// ไซยาน-เหลืองมะนาวของ นินจา168 (32bcfb / a9e9ff / fef54b / dceefc / 030e16 /
// 041019 / 07335f / 6b5c10) ชุดทองนำ-โรสโกลด์ของ ขวัญใจ168 (f7c92b / ffe6a3 /
// f2bba5 / eadfce / 0b0603 / 140c06 / 8a5f12 / b3121b) ชุดแดงเลือดนก-เงิน
// โครเมียมของ TKB55 (fb131b / ff4d55 / e9eef4 / aeb9c6 / f2e4e5 / 0d0304 /
// 1a0304) ชุดม่วงราชา-ทองของ KMD88 (7505cc / c07cff / e2b33f / ffdf8c / ece2f8 /
// 1a0526 / 0a0213) ชุดทองอำพันเสือของ TIGERWIN369 (0f0903 / d98324 / f7b733 /
// ffd98a / f7e4c0) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (2b0000 / f5c518 /
// ffdd73 / b8860f / ff3b14 / fdf0e2) และชุดม่วงนีออน-ทองของ WEPLAY168 (0a0117 /
// a435f0 / fbe455 / c98a05 / ece2ff) หายไปหมด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
// ⚠️ **กับดักรอบนี้คือทั้งแดงและทอง และแดงหนักกว่า** — TKB55 (fb131b) GT66B
// (fb141b) สมหวัง168 (fa0513 b90203) รับตัง168 (d30304) ขวัญใจ168 (b3121b)
// มีเฮ168 (fb1b32) และ ดวงเศรษฐี168 (d9212a) ล้วนเป็นแดง ส่วน ufalion168
// (d4922c) FLASH877 (f5c518) TIGERWIN369 (f7b733) WEPLAY168 (fbe455) KMD88
// (e2b33f) และ รับตัง168 (ffdc8c) ล้วนมีทอง การเจอแดงหรือทองในไฟล์นี้จึง
// **ไม่ได้แปลว่าเป็นของรอบนี้** แดงรอบนี้คือ #c30303 (R=195 G=3 B=3) คู่กับ
// #8f0505 และทองรอบนี้คือ #dcb95f / #b8862b ให้เทียบทีละค่ากับตารางใน
// brand-spec-ruaythear168vip.md §2 ไม่ใช่ด้วยตา
// ⚠️ ผิวการ์ดสว่าง #ffffff กับชั้นอินเซ็ต #fff1ef ไม่ปรากฏในไฟล์นี้ — ticker เป็น
// โครมที่นอนอยู่บนพื้นเพจตรงๆ ไม่ได้ซ้อนอยู่ในการ์ดใบใด
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): ช่องทางเล่นหวย
// ออนไลน์ · หวยรัฐบาลไทย ลาวพัฒนา ฮานอย หุ้นต่างประเทศ · อัตราจ่าย 2 ตัว 100
// และ 3 ตัว 1,000 · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ติดต่อแอดมิน 24ชม.
//
// ⚠️ **ข้อความนี้ต้องสั้น** ไม่ใช่ย่อหน้า ticker คือโครมที่ render บน **ทุกหน้า**
// และ marquee วาดข้อความซ้ำสองรอบเพื่อให้ลูปไม่มีรอยต่อ ความยาวจึงคูณสองคูณสิบหน้า
// เก็บไว้เฉพาะ: แกนของแบรนด์ · อัตราจ่ายสองค่า · สองโปรโมชั่น · ช่องทางติดต่อ
// พร้อมคำเตือนเรื่อง OTP ส่วนประโยคเตือนที่เหลือของบรีฟ ship อยู่ในหน้าแรกครบแล้ว
// ⚠️ ตัวเลขที่บรีฟให้มามีแค่ห้าตัว (2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.)
// จึงไม่มีเลขใบอนุญาต ชื่อหน่วยงานกำกับ **ชื่อค่ายเกม** ชื่อนิติบุคคล ชื่อธนาคาร
// ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวนเกมในข้อความนี้
// ⚠️ คำของแบรนด์ก่อนๆ (สล็อต · บาคาร่า · ยิงปลา · ไฮโล · บอล · สูตร · เทคนิค ·
// เศรษฐีพนันมือ1 · แทงบอล · ค่าน้ำ · เว็บตรง · ไม่ผ่านเอเย่นต์ · คาสิโนสด ·
// รูเล็ต) ถูกกวาดออกหมด — บรีฟรอบนี้ไม่มีคำพวกนี้แม้แต่คำเดียว เป็นบรีฟหวยล้วน
// ⚠️ บรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนของมันจึง ship ครบ:
// อัตราจ่ายจริงขึ้นกับประเภทหวยและเงื่อนไขของแต่ละรอบ · ควรตรวจสอบรอบเปิดรับและ
// เงื่อนไขก่อนทำรายการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
const {
  message = `${BRAND_NAME} ช่องทางเล่นหวยออนไลน์ หวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศ • อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 — อัตราจ่ายจริงขึ้นอยู่กับประเภทหวยและเงื่อนไขของแต่ละรอบ ควรตรวจสอบตารางอัตราจ่ายล่าสุดก่อนยืนยันบิล • คืนยอดเสีย 0.3% เข้ายูสทุกวัน • แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด • ติดต่อแอดมิน 24ชม. ผ่านช่องทางทางการเท่านั้น ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<section aria-label={`ประกาศล่าสุดจาก ${BRAND_NAME}`} class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#b8862b]/55 bg-[#280b0b] shadow-[0_0_15px_rgba(195,3,3,0.4)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#c30303] to-[#8f0505]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#b8862b]/45"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#dcb95f]/70 to-transparent"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex shrink-0 items-center gap-2 bg-gradient-to-b from-[#c30303] to-[#8f0505] py-2.5 pr-4 pl-3 shadow-[0_0_12px_rgba(143,5,5,0.75)]">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(0,0,0,0.85)]">🔔</span>
        <span class="hidden text-xs font-bold tracking-wide text-[#ffeee8] sm:inline">ประกาศล่าสุด</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#280b0b] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#280b0b] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffeee8]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#dcb95f] shadow-[0_0_6px_rgba(220,185,95,0.95)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#dcb95f] shadow-[0_0_6px_rgba(220,185,95,0.95)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-content {
    animation: marquee 34s linear infinite;
  }
  .marquee-container:hover .marquee-content,
  .marquee-container:focus-within .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
