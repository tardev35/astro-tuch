---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — หน้าที่เรียก <Announcement /> เปล่าๆ
// จะตกมาใช้ข้อความนี้ ทุกหน้าในรอบนี้เรียกแบบ bare ทั้งหมด ข้อความจึงตรงกันทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงถูกอ่านออกเสียงซ้ำด้วย
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// นินจา168 (รอบฟ้าไซยานนำ-เหลืองมะนาวรอง บนดำสนิท 2026-10-19): ticker ที่ใช้งาน
// จริงรอบนี้ — รอบก่อน (สบายเบท168) ใช้ Announcement2 จึงหมุนมาที่ไฟล์นี้
// พื้นฟ้าหมึกจม #030e16 แถบเฉียงซ้ายและกล่องกระดิ่งไล่ฟ้าน้ำแข็ง #a9e9ff ลงฟ้า
// แบรนด์ #32bcfb ส่วนแถบเฉียงขวาเป็น **เหลืองมะนาว #fef54b** แบบโปร่ง —
// **รอบนี้เป็นสองฮิวจริง ฟ้านำ เหลืองรอง** ตามโลโก้ที่เลข 168 เป็นฟ้าบับเบิลผิว
// มันวาว ส่วนคำว่า นินจา เป็นเหลืองทอง และ vivid สองอันดับแรกที่ palette.json
// วัดจาก logo.webp ได้คือ #fef54b กับ #32bcfb พอดี (เป็นไฟล์เดียวในดรอปนี้ที่
// ตัวเลขชี้ถูก — banner1/slide1 ให้ขาวกับโทนผิวนางแบบซึ่งไม่ใช่สีแบรนด์)
// สองแถบเฉียงจึงแยกฮิวกันคนละข้าง ไม่ใช่สองระดับของสีเดียว
// เนื้อข้อความใช้สีเนื้อความ #dceefc (BRAND_TEXT) จุดนำหน้าเป็นเหลืองมะนาว #fef54b
//
// ชุดทองนำ-โรสโกลด์ของ ขวัญใจ168 ที่เคยอยู่ในไฟล์นี้ (f7c92b / ffe6a3 / f2bba5 /
// eadfce / 0b0603 / 140c06 / 8a5f12 / b3121b) ชุดแดงเลือดนก-เงินโครเมียมของ TKB55
// (fb131b / ff4d55 / e9eef4 / aeb9c6 / f2e4e5 / 0d0304 / 1a0304) ชุดม่วงราชา-ทอง
// ของ KMD88 (7505cc / c07cff / e2b33f / ffdf8c / ece2f8 / 1a0526 / 0a0213)
// ชุดทองอำพันเสือของ TIGERWIN369 (0f0903 / d98324 / f7b733 / ffd98a / f7e4c0)
// ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (2b0000 / f5c518 / ffdd73 / b8860f /
// ff3b14 / fdf0e2) และชุดม่วงนีออน-ทองของ WEPLAY168 (0a0117 / a435f0 / fbe455 /
// c98a05 / ece2ff) หายไปทั้งหมด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
// ⚠️ **กับดักรอบนี้คือทั้งฟ้าและเหลือง** — รอบที่แล้ว (สบายเบท168) เป็นฟ้า 2f9ff5
// + ทอง ffc82e ซึ่งเป็นฮิวคู่เดียวกับรอบนี้ ส่วน FLASH877 (f5c518) TIGERWIN369
// (f7b733) WEPLAY168 (fbe455) และ KMD88 (e2b33f) ล้วนมีทอง การเจอฟ้าหรือทองใน
// ไฟล์นี้จึง **ไม่ได้แปลว่าเป็นของรอบนี้** ฟ้ารอบนี้คือ #32bcfb (R=50 G=188 B=251)
// และเหลืองรอบนี้คือ #fef54b (R=254 G=245 B=75) ให้เทียบทีละค่า ไม่ใช่ด้วยตา
// ⚠️ หมึกบนกล่องกระดิ่งพื้นฟ้าคือ #041019 ตัวเดียว (8.9:1 บน #32bcfb และ
// 13.2:1 บน #a9e9ff) ห้ามลากปลายเข้มของไล่เฉดลงไปถึง #07335f — จะเหลือ ~1.4:1
// ⚠️ ทองลึก #6b5c10 รอบนี้ไม่ปรากฏในไฟล์นี้เลย เป็นสำเนียงลึกที่ไม่ถือทั้งตัวอักษร
// และไม่ถือแถบใหญ่
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): โปรโมชั่นแนะนำเพื่อน
// โบนัส 0.8% · ลิงก์แนะนำและการตรวจสอบผ่านบัญชีสมาชิก · คืนยอดเสีย 0.3% เข้ายูส
// ทุกวัน · ฝากถอนผ่านธนาคารชั้นนำและวอลเลท · LINE Official 24 ชั่วโมง — บรีฟ
// ไม่ได้ระบุเลขใบอนุญาต ชื่อหน่วยงานที่ออกใบอนุญาต ชื่อค่ายเกม ชื่อนิติบุคคล
// ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวนเกมเป็นตัวเลข จึงไม่มีในข้อความนี้
// และ **ไม่มีคาสิโน บาคาร่า ไฮโล บอล เซิร์ฟเวอร์ต่างประเทศ หรือ 3 ขั้นตอน**
// ซึ่งเป็นคำของแบรนด์ก่อนๆ (3 ขั้นตอน เป็นของ สบายเบท168 รอบที่แล้วโดยเฉพาะ)
// ข้อความกำกับของบรีฟเองติดมาด้วยครบ (ควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละ
// รายการ · แม้ระบุว่ารับได้ไม่อั้นแต่ควรยืนยันรอบการจ่ายโบนัส · เครดิตคืนยอดเสีย
// ไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกรายการหรือรับประกันผลตอบแทนจากการเดิมพัน ·
// ควรเก็บหลักฐานการทำรายการและติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ · ห้ามส่งรหัสผ่าน
// หรือรหัส OTP ให้บุคคลอื่น · ตรวจสอบลิงก์หรือ QR Code จากเว็บไซต์ทางการก่อน
// เพิ่มเพื่อนเพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ)
const {
  message = `${BRAND_NAME} นำเสนอโปรโมชั่นสำหรับสมาชิกที่สนใจรับสิทธิ์จากการแนะนำเพื่อน โดยระบุอัตราโบนัส 0.8% พร้อมช่องทางแชร์ลิงก์แนะนำและตรวจสอบข้อมูลโปรโมชั่นผ่านบัญชีสมาชิก ก่อนเข้าร่วมควรตรวจสอบวิธีคำนวณโบนัสและข้อจำกัดของแต่ละรายการให้ครบถ้วน • แค่แนะนำลิงก์ ${BRAND_NAME} ง่ายๆ รับโบนัสเข้ายูสได้ไม่อั้น ผู้สนใจสามารถตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนการเชื่อมโยงบัญชี และยอดที่นำมาคำนวณโบนัสผ่านช่องทางบริการของเว็บไซต์ แม้โปรโมชั่นจะระบุว่ารับได้ไม่อั้น แต่ควรยืนยันรอบการจ่ายโบนัสและข้อจำกัดที่เกี่ยวข้องก่อนเข้าร่วม • โปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน ระบุการคืนเครดิตตามยอดเสียที่เข้าเงื่อนไขในแต่ละวัน ควรตรวจสอบช่วงเวลาคำนวณยอด ประเภทเกมที่ร่วมรายการ และวิธีรับเครดิตว่าระบบเพิ่มให้อัตโนมัติหรือต้องกดรับด้วยตนเอง ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกรายการหรือรับประกันผลตอบแทนจากการเดิมพัน • ระบบฝากถอน ${BRAND_NAME} รองรับทั้งธนาคารชั้นนำและวอลเลท ควรศึกษารายชื่อธนาคารและบริการวอลเลทที่เปิดใช้งานจริง ยอดขั้นต่ำ ระยะเวลาดำเนินการ และเงื่อนไขการถอนเงินให้ครบถ้วน หากพบรายการล่าช้าหรือสถานะไม่ถูกต้อง ควรเก็บหลักฐานการทำรายการและติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น • ติดต่อแอดมิน ${BRAND_NAME} ทาง LINE Official ได้ตลอด 24 ชั่วโมง ควรตรวจสอบลิงก์หรือ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ เมื่อแจ้งปัญหาควรอธิบายรายละเอียดให้ชัดเจนและเตรียมหลักฐานที่จำเป็นสำหรับการตรวจสอบ ทั้งนี้ ควรยืนยันเวลาให้บริการและระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#32bcfb]/65 bg-[#030e16] shadow-[0_0_15px_rgba(50,188,251,0.4)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#a9e9ff] to-[#32bcfb]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#fef54b]/45"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#a9e9ff] to-[#32bcfb] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(4,16,25,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#030e16] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#030e16] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#dceefc]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#fef54b] shadow-[0_0_5px_rgba(50,188,251,0.95)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fef54b] shadow-[0_0_5px_rgba(50,188,251,0.95)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
