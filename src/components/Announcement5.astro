---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — ทุกหน้าในรอบนี้เรียก <Announcement />
// แบบ bare ไม่ส่ง prop เลย ข้อความนี้จึงเป็นข้อความที่ขึ้นจริงทั้งเว็บ
// (รอบนี้ไม่มีข้อยกเว้นหน้าหวย — /ตรวจหวย กับ /แนวทาง อยู่ใน src/pages-disabled/
// เพราะ 123BET เป็นเว็บเกมคาสิโน และบรีฟเอ่ย "หวยออนไลน์" แค่ในฐานะหนึ่งใน
// เจ็ดหมวดเกม ไม่ใช่แกนของเว็บ)
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงจะถูกอ่านออกเสียงซ้ำด้วย
// (ไอคอนทุกตัวในไฟล์นี้อยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความ)
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// 123BET (รอบแดงชาดนำ เงินโครเมียม/ทองอำพันรอง **เนื้อหาสว่าง โครมเข้ม** บนพื้นเพจ
// ชมพูบลัชจาง #f7e4e9, 2026-10-28): ticker ที่ใช้งานจริงรอบนี้ — รอบก่อน (ZORO365)
// ใช้ Announcement3 จึงหมุนมาที่ไฟล์นี้ตาม .claude/brand-spec-123bet.md §3
// ไฟล์นี้ล่าสุดเคย ship ให้ MEXICANOSLOT จึงมาพร้อมพาเลตแดงเม็กซิกัน-ทองส้มของ
// แบรนด์นั้น และโดนกวาดค่าต่อค่าครบแล้ว (de2b1e c81e12 9d140c 6f0e08 1d0a06
// fdeee2 f2a033 f2543f — เขียนไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้เอง)
//
// 🚨🚨 **กับดักที่แหลมที่สุดของรอบนี้: แบรนด์ล่าสุดที่ ship ไฟล์นี้ก็เป็นแบรนด์แดง
// เหมือนกัน (MEXICANOSLOT)** และแดงเคยนำไฟล์นี้มาแล้วกว่าสิบเจ้า — TKB55
// (fb131b ff4d55) · มีเฮ168 (fb1b32 ff8f9c) · ดวงเศรษฐี168 (d9212a 8e1a16) ·
// รวยแท้168 (c30303 8f0505) · ขวัญใจ168 (b3121b) · FLASH877 (ff3b14) ·
// มาดาม168 (ff2e52 e01238 c9102f) · สล็อต168 (fb2e33 cb0b0d b00d11 8a0608) ·
// **LOTTO189 (c1071b b00718 8a0412 7e1221 d61023 ff2436 — ตระกูลสีเดียวกับ
// รอบนี้เป๊ะที่สุด)** → **การเจอแดงในไฟล์นี้ไม่ได้แปลว่าเป็นของรอบนี้**
// แดงรอบนี้คือ **#a30d1a** (R163 G13 B26) คู่กับ **#c21325** / **#8a1420**
// และไฮไลต์บนโครม **#ef4a5e** แปลงมาจาก vivid ของ logo.webp (ac0404) ซึ่งดิบเกินไป
// ⚠️ **a81410 ของ MEXICANOSLOT ห่างจาก #a30d1a แค่ไม่กี่หลัก และ c1071b ของ
// LOTTO189 ก็เช่นกัน** ให้เทียบทีละค่ากับตารางใน brand-spec-123bet.md §2 ไม่ใช่ด้วยตา
// ⚠️ **ทองรอบนี้มีจริง** (#dca53a บนโครม 8.1:1) เพราะมงกุฎบนโลโก้ ขอบแคปซูลบน
// แบนเนอร์ และขอบตัวเลขบนสไลด์เป็นทอง — แต่ **f2a033 f0c878 e9b53c e3bb45 e8c86a
// และทองของแบรนด์อื่นทั้งหมดห้ามใช้**
//
// ทรงของรอบนี้: รางพื้นโครมลึก #1c050b ขอบแดงโปร่ง แถบเฉียงซ้ายไล่
// แดงชาด #a30d1a -> แดงเลือดหมู #8a1420 แถบเฉียงขวาเป็นแดงสดโปร่ง #c21325
// หัวแถบซ้ายเป็น **กล่องถมแดงชาด** ถือกระดิ่งกับคำว่า ประกาศล่าสุด สีบลัชขาว
// #fdf5f6 (8.0:1 บน #a30d1a และ 9.5:1 บน #8a1420 ผ่าน AA ทั้งคู่)
// ⚠️⚠️ **ห้ามลากพื้นกล่องหัวแถบสว่างกว่า #c21325** เพราะหมึกสว่างบนนั้นเหลือ 6.2:1
// และสว่างกว่านั้นจะตกต่ำกว่า 4.5:1 ทันที
// เนื้อข้อความวิ่งเป็น #fdf5f6 บนโครมลึก #1c050b (18.2:1 ผ่านสบาย) จุดนำหน้าแต่ละ
// ท่อนเป็นแดงไฮไลต์ #ef4a5e ซึ่งเป็น **พื้นถมของจุด ไม่ใช่ตัวอักษร**
// ⚠️⚠️ รอบนี้ **พื้นเพจเป็นชมพูบลัชจาง #f7e4e9** (bg.json) ไม่ใช่พื้นเข้มแบบรอบก่อน
// (ZORO365 เป็น 002908 มืดทั้งเว็บ) — รางโครมลึก #1c050b จึงเป็น **แถบเข้มที่ลอย
// บนพื้นสว่าง** และนั่นถูกต้องตามทิศของรอบนี้ (โครมเข้ม เนื้อหาสว่าง)
// **ห้าม "แก้" ให้ ticker กลายเป็นผิวสว่างเพื่อให้กลืนกับพื้นเพจ** — มันต้องเป็น
// ชุดเดียวกับ navbar/footer
// ⚠️ ผิวการ์ดสว่างไม่ปรากฏในไฟล์นี้ — ticker เป็นโครมที่นอนอยู่บนพื้นเพจตรงๆ
// ไม่ได้ซ้อนอยู่ในการ์ดใบใด
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): เจ้าของบาคาร่าสล็อต ·
// เว็บตรง · ถูกลิขสิทธิ์ · ครบทุกค่าย · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// แอดมินออนไลน์ 24 ชั่วโมง
// 🚨 **"เว็บตรง" "ถูกลิขสิทธิ์" "ปลอดภัยในไทย" เป็นถ้อยคำของบรีฟรอบนี้เอง**
// (บรรทัด 1-3) ถึงแม้ spec ของรอบก่อนจะเคยห้ามสองคำแรกไว้ในฐานะคำของ TEVA69
// — **ห้ามลบออกเพราะอ่านคอมเมนต์เก่าในไฟล์ inventory แล้วเข้าใจผิด**
//
// ⚠️ **ข้อความนี้ต้องสั้น** ไม่ใช่ย่อหน้า ticker คือโครมที่ render บน **ทุกหน้า**
// และ marquee วาดข้อความซ้ำสองรอบเพื่อให้ลูปไม่มีรอยต่อ ความยาวจึงคูณสองคูณสิบเอ็ดหน้า
// เก็บไว้เฉพาะ: แกนของแบรนด์ · สองโปรโมชั่น · ช่องทางติดต่อ พร้อมคำเตือนเรื่อง OTP
// ส่วนประโยคกำกับที่เหลือของบรีฟ ship อยู่ในหน้าแรกครบแล้ว
// ⚠️ ตัวเลขที่บรีฟให้มามีแค่สี่ตัว (0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง) จึงไม่มี
// เลขใบอนุญาต ชื่อหน่วยงานกำกับ **ชื่อค่ายเกม** ชื่อนิติบุคคล ชื่อธนาคาร
// ยอดฝากขั้นต่ำ ค่า RTP หรือจำนวนเกมในข้อความนี้ และ **ไม่มี 100%**
// ⚠️ คำของ **ZORO365 แบรนด์ขาออก** (เกมคาสิโนสายตรง · แทงได้เท่าไหร่ ·
// เว็บจ่ายเต็ม · ไม่มีโกง · ไม่ผ่านเว็บตัวแทน) ถูกกวาดออกหมด และคำของแบรนด์เก่ากว่า
// (สล็อตเมกซิกัน · การันตีเว็บตรง · ยอดเข้าบริษัทไม่ผ่านเอเย่นต์ · เว็บสล็อตเงินดี ·
// ยูสใหม่แตกไว · ทรูวอลเลท · ทรูมันนี่ · เบทต่ำ · ไม่ทำเทิร์น · ไม่ผ่านเอเย่นต์100%)
// ก็ไม่มีในบรีฟรอบนี้
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลย** — ห้ามใส่ใน ticker
// ⚠️ บรีฟรอบนี้โฆษณาและกำกับในประโยคเดียวกัน ประโยคกำกับของมันจึง ship ครบ:
// คำกล่าวอ้างเรื่องการเป็นเจ้าของระบบเกมและลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัท
// และหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
const {
  message = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์ ครบทุกค่าย ไฮโล รูเล็ต ยิงปลา บอล หวย เข้าเล่นได้ 24 ชั่วโมง • คำกล่าวอ้างเรื่องการเป็นเจ้าของระบบเกมและลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน • คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน • แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด • แอดมินออนไลน์ตลอด 24 ชั่วโมง ผ่านช่องทางทางการเท่านั้น ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<section aria-label={`ประกาศล่าสุดจาก ${BRAND_NAME}`} class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#a30d1a]/60 bg-[#1c050b] shadow-[0_0_15px_rgba(163,13,26,0.4)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#a30d1a] to-[#8a1420]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#c21325]/45"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#dca53a]/70 to-transparent"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex shrink-0 items-center gap-2 bg-gradient-to-b from-[#a30d1a] to-[#8a1420] py-2.5 pr-4 pl-3 shadow-[0_0_12px_rgba(163,13,26,0.75)]">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(0,0,0,0.85)]">🔔</span>
        <span class="hidden text-xs font-bold tracking-wide text-[#fdf5f6] sm:inline">ประกาศล่าสุด</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1c050b] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#1c050b] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#fdf5f6]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ef4a5e] shadow-[0_0_6px_rgba(239,74,94,0.95)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ef4a5e] shadow-[0_0_6px_rgba(239,74,94,0.95)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-content {
    animation: marquee 34s linear infinite;
  }
  .marquee-container:hover .marquee-content,
  .marquee-container:focus-within .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
