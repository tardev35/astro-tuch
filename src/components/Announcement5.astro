---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — หน้าที่เรียก <Announcement /> เปล่าๆ
// จะตกมาใช้ข้อความนี้ ทุกหน้าในรอบนี้เรียกแบบ bare ทั้งหมด ข้อความจึงตรงกันทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงถูกอ่านออกเสียงซ้ำด้วย
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09): ticker ที่ใช้งานจริงรอบนี้
// (รอบก่อน PIGPG ใช้ AnnouncementCyber) พื้นม่วงเกือบดำ #0a0117 แถบเฉียงซ้ายและ
// กล่องกระดิ่งไล่ทองแบรนด์ #fbe455 ลงทองเข้ม #c98a05 ส่วนแถบเฉียงขวาเป็นม่วง
// แบรนด์ #a435f0 แบบโปร่ง — รอบนี้เป็นสองฮิวจริง (ม่วงนำ ทองเป็นฮิวที่สอง)
// ตามโลโก้ที่เป็นเครื่องเกมพกพาสีม่วงพาดด้วย WEPLAY สีเงินอมม่วงและ 168 สีทอง
// เนื้อข้อความใช้สีเนื้อความ #ece2ff (BRAND_TEXT) จุดนำหน้าเป็นทองแบรนด์ #fbe455
// (vivid อันดับหนึ่งของ banner1.png) — ชุดทองเมทัลลิกของ 789BETTING ที่เคยอยู่ใน
// ไฟล์นี้ (#060402 #fad354 #ffe79a #8a6410 #c9881f #f3e7cd) หายไปทั้งหมด
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): เล่นสล็อตออโต้
// ทุกค่าย รวมเกมจากค่ายหลักในแพลตฟอร์มเดียว เล่นผ่านมือถือไม่ต้องติดตั้งโปรแกรม
// เบทเริ่มต้น 1 บาทในบางเกม คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ฝากถอนเข้าบริษัท
// โดยตรง และแอดมิน 24 ชั่วโมง — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร
// ยอดฝากขั้นต่ำ หรือจำนวนเกมเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของ
// บรีฟเองติดมาด้วยครบ ("แตกง่าย/ไม่มีขั้นต่ำ" ควรพิจารณาจากข้อมูลเกมจริงเพราะผล
// การหมุนเป็นแบบสุ่ม · ชื่อบัญชีบริษัทอย่างเดียวไม่ได้รับประกันว่าธุรกรรมไม่มี
// ความเสี่ยง)
const {
  message = `${BRAND_NAME} เล่นสล็อตออโต้ทุกค่าย รวบรวมเกมสล็อตจากค่ายหลักไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ • รองรับการใช้งานผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว • บางเกมรองรับการเดิมพันเริ่มต้น 1 บาทตามช่วงเดิมพันที่ค่ายกำหนด ควรตรวจสอบตารางจ่ายและอัตราการคืนเงินผู้เล่นก่อนเริ่มเล่นทุกครั้ง • คำว่าแตกง่ายและไม่มีขั้นต่ำควรพิจารณาจากข้อมูลเกมจริง เพราะผลการหมุนสล็อตเป็นแบบสุ่ม ไม่มีเกมใดรับประกันว่าจะได้รับโบนัสหรือกำไรทุกครั้ง • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% โดยแต่ละรายการมีรอบคำนวณและเงื่อนไขรับสิทธิ์แตกต่างกัน • ระบบฝากถอนรองรับช่องทางตามที่เว็บไซต์เปิดให้บริการ ควรตรวจสอบชื่อบัญชีปลายทางและสถานะรายการก่อนยืนยันธุรกรรมทุกครั้ง • ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการหลักได้ตลอด 24 ชั่วโมง โดยไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#a435f0]/60 bg-[#0a0117] shadow-[0_0_15px_rgba(164,53,240,0.35)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#fbe455] to-[#c98a05]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#a435f0]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#fbe455] to-[#c98a05] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(10,1,23,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0a0117] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#0a0117] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ece2ff]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#fbe455] shadow-[0_0_5px_rgba(251,228,85,0.9)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fbe455] shadow-[0_0_5px_rgba(251,228,85,0.9)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
