---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — ทุกหน้าในรอบนี้เรียก <Announcement /> แบบ
// bare ไม่ส่ง prop เลย ข้อความนี้จึงเป็นข้อความที่ขึ้นจริงทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงจะถูกอ่านออกเสียงซ้ำด้วย
// (ไอคอนทุกตัวในไฟล์นี้อยู่ใน <span aria-hidden="true"> ที่เป็นพี่น้องของข้อความ)
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// ดวงเศรษฐี168 (รอบแดงชาดจีนนำ-ทองน้ำผึ้งรอง บนพื้นดำสนิท 2026-10-20):
// ticker ที่ใช้งานจริงรอบนี้ — รอบก่อน (ufalion168) ใช้ Announcement3 จึงหมุนมาที่
// ไฟล์นี้ตาม brand-spec §3
// ทรงของรอบนี้: รางพื้นชั้นจม #150303 ขอบทองน้ำผึ้งโปร่ง แถบเฉียงซ้ายไล่
// แดงชาด #d9212a -> แดงเลือดหมู #8e1a16 แถบเฉียงขวาเป็นทองน้ำผึ้งโปร่ง
// หัวแถบซ้ายเป็น **กล่องถมแดงชาด** ถือกระดิ่งกับคำว่า ประกาศล่าสุด สีงาช้าง
// #fff8d8 (4.7:1 ผ่าน AA — แดงรอบนี้เป็นพื้นถม/ขอบ/ออรา **ห้ามถือตัวอักษร**
// บนพื้นเข้ม ถ้าอยากได้ตัวอักษรที่อ่านว่าแดง ต้องถมแดงแล้ววางงาช้างทับแบบนี้)
// เนื้อข้อความวิ่งเป็นงาช้าง #fff8d8 บนชั้นจม (19.0:1) จุดนำหน้าแต่ละท่อนเป็น
// ทองน้ำผึ้ง #f0c878 ซึ่งเป็นสีไฮไลต์ตัวเดียวของรอบนี้
// ⚠️ ชั้นจม #150303 เป็นพื้นที่สว่างกว่าพื้นเพจ #000000 เพียงเล็กน้อย รางจึงอ่าน
// ออกว่าเป็นแถบด้วย "ขอบทอง + ออราแดง" ไม่ใช่ด้วยความต่างของพื้น
//
// ชุดทองอำพัน-บรอนซ์ของ ufalion168 ที่เพิ่งอยู่ในไฟล์นี้รอบก่อน (d4922c /
// fdfc71 / a25b24 / f6e3b4 / 33200a / 1f1304 / 0a0601 / 5a3310) ชุดแดงชาด-
// ทองเนยของ มีเฮ168 (fb1b32 / ff8f9c / fcd45c / fdeaec / 0c0205 / 5c0410 /
// 6b4a08) ชุดฟ้าไซยาน-เหลืองมะนาวของ นินจา168 (32bcfb / a9e9ff / fef54b /
// dceefc / 030e16 / 041019 / 07335f / 6b5c10) ชุดทองนำ-โรสโกลด์ของ ขวัญใจ168
// (f7c92b / ffe6a3 / f2bba5 / eadfce / 0b0603 / 140c06 / 8a5f12 / b3121b)
// ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 (fb131b / ff4d55 / e9eef4 / aeb9c6 /
// f2e4e5 / 0d0304 / 1a0304) ชุดม่วงราชา-ทองของ KMD88 (7505cc / c07cff /
// e2b33f / ffdf8c / ece2f8 / 1a0526 / 0a0213) ชุดทองอำพันเสือของ TIGERWIN369
// (0f0903 / d98324 / f7b733 / ffd98a / f7e4c0) ชุดทองสายฟ้า-แดงเลือดนกของ
// FLASH877 (2b0000 / f5c518 / ffdd73 / b8860f / ff3b14 / fdf0e2) และชุดม่วง
// นีออน-ทองของ WEPLAY168 (0a0117 / a435f0 / fbe455 / c98a05 / ece2ff) หายไปหมด
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์)
// ⚠️ **กับดักรอบนี้คือทั้งแดงและทอง** — TKB55 (fb131b) GT66B (fb141b) สมหวัง168
// (fa0513) รับตัง168 (d30304) ขวัญใจ168 (b3121b) และ มีเฮ168 (fb1b32) ล้วนเป็น
// แดง ส่วน ufalion168 (d4922c) FLASH877 (f5c518) TIGERWIN369 (f7b733)
// WEPLAY168 (fbe455) KMD88 (e2b33f) และ รับตัง168 (ffdc8c) ล้วนมีทอง การเจอ
// แดงหรือทองในไฟล์นี้จึง **ไม่ได้แปลว่าเป็นของรอบนี้** แดงรอบนี้คือ #d9212a
// (R=217 G=33 B=42) คู่กับ #8e1a16 และทองรอบนี้คือ #f0c878 (R=240 G=200 B=120)
// ให้เทียบทีละค่ากับตารางใน brand-spec-duangsetthi168.md §2 ไม่ใช่ด้วยตา
// ⚠️ ผิวการ์ดยก #4e2120 กับชั้นกลาง #300605 ไม่ปรากฏในไฟล์นี้ — ticker ใช้แค่
// ชั้นจม เพราะมันนอนอยู่บนพื้นเพจตรงๆ ไม่ได้ซ้อนอยู่ในการ์ดใบอื่น
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): เว็บสอนเล่นเกม
// เดิมพันออนไลน์หลายประเภท สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวย · รวมสูตร
// และเทคนิค · จากเศรษฐีพนันมือ1 · คืนยอดเสีย 0.3% เข้ายูสทุกวัน · แนะนำเพื่อน
// โบนัส 0.8% ไม่จำกัด · ติดต่อแอดมิน 24ชม. —
//
// ⚠️ **ข้อความนี้ต้องสั้น** ไม่ใช่ย่อหน้า ticker คือโครมที่ render บน **ทุกหน้า**
// และ marquee วาดข้อความซ้ำสองรอบเพื่อให้ลูปไม่มีรอยต่อ ความยาวจึงคูณสองคูณสิบหน้า
// ฉบับแรกของรอบนี้เขียนยาว ~1,400 ตัวอักษร (ยกย่อหน้าของบรีฟมาเกือบครบทุกหัวข้อ)
// ซึ่งกลายเป็นเนื้อหาบทความซ้ำกันทั้งเว็บ ไม่ใช่ประกาศ — orchestrator ย่อลงเหลือ
// ~250 ตัวอักษร เก็บไว้เฉพาะ: แกนของแบรนด์ · ประโยคเตือนเรื่องสูตรไม่รับประกันชัยชนะ ·
// สองโปรโมชั่น · ช่องทางติดต่อพร้อมคำเตือนเรื่อง OTP
// ส่วนประโยคเตือนที่เหลือของบรีฟ ship อยู่ในหน้าแรกครบอยู่แล้ว ไม่ต้องซ้ำที่นี่ —
// ตัวเลขที่บรีฟให้มามีแค่สี่ตัว (0.3% · 0.8% · 24ชม. · 3 ขั้นตอน) จึงไม่มีเลข
// ใบอนุญาต ชื่อหน่วยงานกำกับ **ชื่อค่ายเกม** ชื่อนิติบุคคล ชื่อธนาคาร ยอดฝาก
// ขั้นต่ำ ค่า RTP หรือจำนวนเกมในข้อความนี้ และ **ไม่มี เว็บตรง / ไม่ผ่าน
// เอเย่นต์ / คาสิโนสด / รูเล็ต**
// ⚠️ คำของ ufalion168 รอบก่อน (แทงบอล · ค่าน้ำ · ราคาต่อรอง · สถิติการพบกัน ·
// โปรแกรมแข่งขัน · ลีก · แมตช์ · ยูฟ่า) ถูกกวาดออกหมด — คำว่า "บอล" ยังอยู่ได้
// เพราะบรีฟรอบนี้ระบุเอง แต่คำแวดล้อมของเว็บบอลไม่ได้
// ⚠️ บรีฟรอบนี้โฆษณาและเตือนในประโยคเดียวกัน ประโยคเตือนของมันจึง ship ครบ:
// คำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบจากหลักฐานที่เชื่อถือได้ ·
// เทคนิคใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ · การคืนยอดเสียไม่ได้
// รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP
const {
  message = `${BRAND_NAME} เว็บสอนเล่นเกมเดิมพันออนไลน์ สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวย • รวมสูตรและเทคนิค จากเศรษฐีพนันมือ1 — เทคนิคใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ • คืนยอดเสีย 0.3% เข้ายูสทุกวัน • แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด • ติดต่อแอดมิน 24ชม. ผ่านช่องทางทางการเท่านั้น ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<section aria-label={`ประกาศล่าสุดจาก ${BRAND_NAME}`} class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f0c878]/55 bg-[#150303] shadow-[0_0_15px_rgba(217,33,42,0.4)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#d9212a] to-[#8e1a16]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f0c878]/45"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#f0c878]/70 to-transparent"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex shrink-0 items-center gap-2 bg-gradient-to-b from-[#d9212a] to-[#8e1a16] py-2.5 pr-4 pl-3 shadow-[0_0_12px_rgba(142,26,22,0.75)]">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(0,0,0,0.85)]">🔔</span>
        <span class="hidden text-xs font-bold tracking-wide text-[#fff8d8] sm:inline">ประกาศล่าสุด</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#150303] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#150303] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#fff8d8]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f0c878] shadow-[0_0_6px_rgba(240,200,120,0.95)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f0c878] shadow-[0_0_6px_rgba(240,200,120,0.95)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-content {
    animation: marquee 34s linear infinite;
  }
  .marquee-container:hover .marquee-content,
  .marquee-container:focus-within .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
