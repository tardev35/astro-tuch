---
const {
  message = "ZORO365 คาสิโนออนไลน์อัตราจ่ายสูง รวมเกมเดิมพันครบทุกค่าย ชวนเพื่อนเล่น รับค่าแนะนำ 0.8% ทุกวัน คืนยอดเสียสูงสุด 0.3% สมัครเดิมพันได้โดยไม่มีขั้นต่ำ",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#16a34a]/45 bg-[#06180d] shadow-[0_0_15px_rgba(22,163,74,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#22c55e] to-[#15803d]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f59e0b]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#22c55e] to-[#15803d] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(253,230,138,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#06180d] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#06180d] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#fbbf24]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fde68a] shadow-[0_0_5px_rgba(253,230,138,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fde68a] shadow-[0_0_5px_rgba(253,230,138,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
