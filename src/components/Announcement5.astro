---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — หน้าที่เรียก <Announcement /> เปล่าๆ
// จะตกมาใช้ข้อความนี้ ทุกหน้าในรอบนี้เรียกแบบ bare ทั้งหมด ข้อความจึงตรงกันทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงถูกอ่านออกเสียงซ้ำด้วย
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): ticker ที่ใช้งานจริงรอบนี้
// (รอบก่อน SUPERSLOTCLUB ใช้ Announcement2) พื้นแดงเลือดนกเข้ม #2b0000 แถบเฉียง
// ซ้ายและกล่องกระดิ่งไล่ทองสว่าง #ffdd73 ลงทองเข้ม #b8860f ส่วนแถบเฉียงขวาเป็น
// แดงสายฟ้า #ff3b14 แบบโปร่ง — รอบนี้เป็นสองฮิวจริง (ทองนำ แดงเป็นฮิวที่สอง)
// ตามโลโก้ที่เป็นสายฟ้าทองผ่ากลางเหรียญแดง คำว่า FLASH ทอง และเลข 877 แดงสด
// เนื้อข้อความใช้สีเนื้อความ #fdf0e2 (BRAND_TEXT) จุดนำหน้าเป็นทองแบรนด์ #f5c518
// ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่เคยอยู่ในไฟล์นี้ (#0a0117 #a435f0
// #fbe455 #c98a05 #ece2ff rgba(164,53,240,α) rgba(251,228,85,α)) หายไปทั้งหมด
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) ก็เป็นคู่แดง-ทอง — ทองรอบนี้ #f5c518 เป็น
// คนละค่ากับ #f2b705 และแดง #ff3b14 คนละค่ากับ #e8232a ให้เทียบทีละค่า
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): เว็บตรงฐานสล็อต
// หลัก อัปเดตระบบเข้าเล่นใหม่ 2026 รองรับมือถือและคอมพิวเตอร์ รวมเกมหลายประเภท
// ไว้ในบัญชีเดียว ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ คืนยอดเสีย 0.3%
// แนะนำเพื่อน 0.8% ฝากถอนเข้าบัญชีบริษัทโดยตรง และแอดมิน 24 ชั่วโมง — บรีฟไม่ได้
// ระบุใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือจำนวนเกมเป็นตัวเลข จึงไม่มี
// ในข้อความนี้ และข้อความกำกับของบรีฟเองติดมาด้วยครบ (ไม่ควรใช้คำโฆษณาเพียงอย่าง
// เดียวเป็นหลักฐานยืนยัน · ควรตรวจสอบชื่อบัญชีปลายทางก่อนโอน · ห้ามเปิดเผยรหัสผ่าน
// PIN หรือ OTP แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์)
const {
  message = `${BRAND_NAME} เว็บตรงฐานสล็อตหลัก อัปเดตระบบเข้าเล่นใหม่ในปี 2026 รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ รวบรวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ • สมาชิกค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้สะดวกจากบัญชีเดียว โดยการอัปเดตรอบนี้ครอบคลุมทั้งหน้าเข้าสู่ระบบ เมนูเลือกเกม และส่วนจัดการบัญชี • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% โดยแต่ละรายการมีรอบคำนวณและเงื่อนไขรับสิทธิ์แตกต่างกัน ควรอ่านรายละเอียดรอบตัดยอดก่อนรับสิทธิ์ทุกครั้ง • ระบบฝากถอนรองรับช่องทางตามที่เว็บไซต์เปิดให้บริการ ควรตรวจสอบชื่อบัญชี จำนวนเงิน และรายละเอียดปลายทางก่อนยืนยันรายการทุกครั้ง • ข้อความไม่ผ่านเอเย่นต์ ไม่ผ่านบัญชีม้า และเว็บฐานหลัก 100% ควรมีข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานยืนยัน • ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางติดต่อหลักได้ตลอด 24 ชั่วโมง โดยไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f5c518]/60 bg-[#2b0000] shadow-[0_0_15px_rgba(245,197,24,0.35)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffdd73] to-[#b8860f]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#ff3b14]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffdd73] to-[#b8860f] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(43,0,0,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#2b0000] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#2b0000] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#fdf0e2]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.9)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.9)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
