---
// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — หน้าที่เรียก <Announcement /> เปล่าๆ
// จะตกมาใช้ข้อความนี้ ส่วน index.astro ส่ง message ของตัวเองเข้ามาทับ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงถูกอ่านออกเสียงซ้ำด้วย
const {
  message = "UFA168 ลิ้งก์ทางเข้าตรง เกมพนันเว็บแท้ ระบบหลักแน่นอน • รวมเกมสล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย ไว้ในบัญชีเดียว • โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของแต่ละรายการ • สมัครเองได้ง่ายใน 3 ขั้นตอน ผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ • แอดมิน UFA168 ตรวจสอบรายการให้ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#6b5316]/70 bg-[#050403] shadow-[0_0_15px_rgba(243,219,91,0.18)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#fff3bf] to-[#a37c14]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#d8dce2]/25"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#fff3bf] to-[#a37c14] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,243,191,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#050403] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#050403] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#e6dcc2]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f3db5b] shadow-[0_0_5px_rgba(243,219,91,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f3db5b] shadow-[0_0_5px_rgba(243,219,91,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
