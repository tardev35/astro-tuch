---
import { BRAND_NAME } from "../lib/brandProfile";

// ค่า default นี้เป็นของแบรนด์ปัจจุบัน — หน้าที่เรียก <Announcement /> เปล่าๆ
// จะตกมาใช้ข้อความนี้ ทุกหน้าในรอบนี้เรียกแบบ bare ทั้งหมด ข้อความจึงตรงกันทั้งเว็บ
// ห้ามขึ้นต้นด้วย emoji: emoji ที่ฝังในข้อความ prop ใส่ aria-hidden ไม่ได้
// และ marquee นี้ render ข้อความซ้ำสองรอบ จึงถูกอ่านออกเสียงซ้ำด้วย
// ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรงๆ จึง drift ตามรอบไม่ได้
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08): ticker ที่ใช้งานจริงรอบนี้
// (รอบก่อน GUCCI168 ใช้ Announcement3) พื้นดำสนิท #060402 แถบเฉียงซ้ายและกล่อง
// กระดิ่งไล่ทองแชมเปญ #ffe79a ลงทองลึก #8a6410 ส่วนแถบเฉียงขวาเป็นบรอนซ์ #c9881f
// แบบโปร่ง — แบรนด์นี้เป็นทองล้วนฮิวเดียว ไม่มีโลหะที่สองแบบรอบก่อนๆ จึงไม่มีเงิน
// โครเมียมหรือแดง เนื้อข้อความใช้สีเนื้อความ #f3e7cd (BRAND_TEXT) จุดนำหน้าเป็น
// ทองแบรนด์ #fad354 (vivid ของ logo.webp) — ชุดแดง-เงินของ หวยดีใจ ที่เคยอยู่ใน
// ไฟล์นี้ (#dc0409 #f5363d #8e0206 #c3c7d1 #0d0407 #edeaf0 #f3c54e) หายไปทั้งหมด
//
// เนื้อข้อความมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt): คาสิโนฐานเข้าหลัก
// รวมบาคาร่า รูเล็ต บอล หวย สล็อต ในบัญชีเดียว กติกา/ช่วงเดิมพัน/เวลาเปิดรับต่างกัน
// ตรวจราคา วงเงิน เวลาเปิด-ปิดก่อนยืนยัน คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8%
// และแอดมิน 24 ชั่วโมง — บรีฟไม่ได้ระบุใบอนุญาต ค่ายเกม ชื่อธนาคาร ยอดขั้นต่ำ
// หรือจำนวนโต๊ะเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเองติดมาด้วย
// ครบ ("เดิมพันตรงกับบริษัท 100%" ควรมีชื่อนิติบุคคลที่ตรวจสอบได้ · "ฝากถอนได้ทุก
// ช่องทาง" หมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ)
const {
  message = `${BRAND_NAME} คาสิโนฐานเข้าหลัก รวมบาคาร่า รูเล็ต บอล หวย สล็อต และเกมคาสิโนตามรายการที่เปิดให้บริการไว้ในบัญชีเดียว • เกมแต่ละประเภทมีกติกา ช่วงเดิมพัน และเวลาเปิดรับแตกต่างกัน โดยเฉพาะบอลและหวยที่อ้างอิงตามตารางของแต่ละรายการ • ก่อนยืนยันการเดิมพันควรตรวจสอบราคา วงเงิน เวลาเปิด-ปิด และรายละเอียดที่แสดงในระบบทุกครั้ง • โปรโมชั่นมีทั้งคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% โดยแต่ละรายการอาจมีรอบคำนวณ ประเภทเกม และเงื่อนไขการรับสิทธิ์แตกต่างกัน • ข้อความเดิมพันตรงกับบริษัท 100% ควรมีชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้ เพื่อยืนยันว่าข้อมูลบนเว็บไซต์สอดคล้องกับผู้ให้บริการจริง • คำว่าฝากถอนได้ทุกช่องทางควรหมายถึงช่องทางที่ระบบรองรับจริงในขณะทำรายการ ควรตรวจสอบชื่อบัญชีและข้อมูลปลายทางก่อนยืนยันธุรกรรมทุกครั้ง • ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการหลักได้ตลอด 24 ชั่วโมง โดยไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#fad354]/60 bg-[#060402] shadow-[0_0_15px_rgba(250,211,84,0.3)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffe79a] to-[#8a6410]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#c9881f]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffe79a] to-[#8a6410] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(6,4,2,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#060402] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#060402] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#f3e7cd]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#fad354] shadow-[0_0_5px_rgba(250,211,84,0.9)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fad354] shadow-[0_0_5px_rgba(250,211,84,0.9)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
