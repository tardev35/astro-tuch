---
const {
  message = "AKA99 สล็อตเว็บตรงค่ายใหญ่ เซิร์ฟนอก การันตีเจ้าของแท้ รวมเกมสล็อต PGSOFT ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอตไว้ในระบบเดียว เข้าเล่นได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ฝากถอนผ่านระบบอัตโนมัติ และแอดมิน LINE Official ดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#0a2a6b]/50 bg-[#03081c] shadow-[0_0_15px_rgba(11,108,240,0.18)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#0b6cf0] to-[#1e4b9e]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#cfdcea]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#0b6cf0] to-[#1e4b9e] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(234,243,253,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#03081c] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#03081c] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#9dd2fa]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#eaf3fd] shadow-[0_0_5px_rgba(234,243,253,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#eaf3fd] shadow-[0_0_5px_rgba(234,243,253,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
