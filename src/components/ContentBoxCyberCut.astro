---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// รอบนี้ (2026-10-11, brand-spec §2): พาเลตต์ **ทองแชมเปี้ยน-เงินโครเมียม บนพื้นดำ
// สนิท** อ่านจากโลโก้จริงซึ่งเป็นถ้วยแชมป์ทอง + ลูกฟุตบอลทอง ตัวอักษร UFA เป็นทอง
// และเลข 324 เป็น **เงินโครเมียม** — แบรนด์จึงมีสองฮิวจริง ไม่ใช่ทองสองระดับ
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจดำสนิท จึง **ไม่มีชั้นไหน
// จมต่ำกว่าพื้นได้เลย** ทุกผิวต้องสว่างกว่า #000000 ขึ้นไปเท่านั้น
// การ์ดใบนี้เป็นผิวยก #231c0e ซึ่งเป็นผิวที่สว่างที่สุดในลำดับความลึกของหน้านี้ —
// หัวข้อ H1 จึงลอยขึ้นสูงสุด เทียบกับ ContentBoxSevenThreeCyberCut ที่เป็นผิวจม
// #0d0b06 สองใบมุมตัดจึงอยู่คนละปลายของลำดับความลึก ไม่ได้ซ้ำผิวเดียวกัน
// เส้นรูดสี่มุมจับคู่ "ทอง vs เงิน" ไขว้กัน — ทองแบรนด์ #e5a81b คู่ทองสว่าง #ffe08a
// บนแนวนอน เงินแบรนด์ #b9c2cc คู่เงินหม่น #8792a0 บนแนวตั้ง ตรงกับโลโก้ที่ตัวอักษร
// ทองวางคู่เลขเงินโครเมียมบนวงแหวนทอง
// หัวข้อไล่ทองสว่าง #ffe08a → เงินแบรนด์ #b9c2cc → ทองแบรนด์ #e5a81b ซึ่งเป็นลำดับ
// ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ทองลึก #7d5a07 ทองดำ #43300a และเงินลึก #464f5a ถูกใช้เป็นขอบ/เส้น/เงาเท่านั้น
// ไม่เคยถือตัวอักษร ตามที่ §2 กำหนด
// เนื้อความงาช้างอุ่น #f0e8d4 (= BRAND_TEXT) — 13.9:1 บนผิวยก
//
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง **การเจอทองในไฟล์ไม่ได้แปลว่าเป็นทองของรอบนี้**
// ต้องเทียบเป็น "ค่า": ชุดชมพูฮอต-ทองบนพลัมดำของแบรนด์รอบก่อนหน้าทันที (#ff3fa4
// #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a #7a0046 #4d002b #2b0019
// #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มอำพัน (#f3bb34 #fde464 #c8901a
// #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709 #171106
// #0d0903) ชุดทองอวกาศ-เงินโครเมียม (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05
// #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700)
// ชุดทองสายฟ้า-แดงเลือดนก (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a) และชุดม่วงนีออน-
// ทอง (#a435f0 #fbe455 #ffd23d #c98a05 #1e0a3c) ออกครบทุกจุดแล้ว
// ทองรอบนี้คือ #e5a81b / #ffe08a / #bb8410 เท่านั้น — ต่างจาก #f5c53d #f5c518
// #fbc134 #f3bb34 #f2b705 ทุกคู่แค่ไม่กี่ตัวอักษร และเงินรอบนี้คือ #b9c2cc ไม่ใช่
// #cfd6e3 ของรอบทองอวกาศ
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e5a81b]/40 bg-[#231c0e]/96 p-8 text-left text-base leading-relaxed text-[#f0e8d4] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#e5a81b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffe08a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#b9c2cc] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#8792a0] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#e5a81b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe08a] via-[#b9c2cc] to-[#e5a81b] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
