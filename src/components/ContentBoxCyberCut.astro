---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §3** มาให้ใบนี้ ("โปรโมชั่นสมาชิก <แบรนด์>
// กดรับได้ไม่จำกัด" — content.txt บรรทัด 8) พร้อมย่อหน้าเดียวของมัน กฎบ้าน
// "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบบทความของ
// แบรนด์ปัจจุบัน (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import
// = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22) — พาเลตตาม .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองคานารี-โครเมียมเงินบนดำสนิท ของ ยูฟ้า168**
// ทั้งใบ จึงรีเธมทั้งไฟล์: **รอบนี้เป็นธีมมืดโทนน้ำตาล** พื้นเพจ #291d0f (bg.json)
// ไม่ใช่ดำสนิท การ์ดเนื้อหาจึงเป็น **ผิวน้ำตาลเข้ม + หมึกไอวอรี**
// ลำดับผิว: #3a2713 ยก · #32200f กลาง · #1f1308 จม · #291d0f พื้นเพจ —
// การ์ดใบนี้ไล่จาก **ยกลงจม** (#3a2713 → #1f1308)
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ทอง vs
// โครเมียม" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — **แนวนอนเป็นทอง** (#fded41
// และ #eeae12) ส่วน **แนวตั้งเป็นโครเมียม** (#e0e0df และ #a1a09e) ซึ่งเป็นที่เดียว
// บนหน้าที่สองวัสดุของโลโก้ (ตัวอักษร "พักยก" ทอง + เลข "168" โครเมียม) ถูกวางไขว้
// กันตรงๆ ⚠️ §5 ContentBoxSevenThreeCyberCut เป็นมุมตัด **36px** บนผิวกลาง #32200f
// และเส้นรูดเป็นทองล้วน — สองใบจึงไม่อ่านซ้ำกันแม้จะอยู่ตระกูล CyberCut เหมือนกัน
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ไล่เฉด ไม่มีแผ่นถม และ
// ไม่มีเรืองแสง** — ทองสว่าง #fded41 (11.7:1 บนผิวยก และสูงกว่านั้นบนผิวจม)
// บนสันซ้ายหนาสี่พิกเซลสีทองแกน #eeae12
// เนื้อความ #f4ead6 (= BRAND_TEXT) — 11.9:1 บนผิวยก และ 16.4:1 บนผิวจม
//
// ⚠️ §2 ห้าม **ทองลึก #9f600d (2.8:1)** ถือตัวอักษร — ไม่มีค่านี้อยู่ใต้ตัวอักษรใน
// ไฟล์นี้ · โครเมียมเข้ม #a1a09e (5.4:1) อยู่ที่เส้นรูดซึ่งเป็นพื้นถมล้วน
// · และ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #fded41** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(238,174,18,α) · rgba(253,237,65,α) ·
// rgba(224,224,223,α) · rgba(31,15,4,α) · rgba(0,0,0,α)
//
// ⚠️ **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอทองในไฟล์ไม่พิสูจน์อะไร ต้อง
// grep เป็น "ค่า" ทีละตัว — ทองรอบนี้คือ #eeae12 กับ #fded41 เท่านั้น และไม่ใช่
// e6a416 fee45d b8780d 7a4e05 (ยูฟ้า168 — ⚠️ **แบรนด์ทอง+เงินเจ้าก่อนหน้า ใกล้
// แนวคิดรอบนี้ที่สุด** e6a416 ห่างทองแกนแค่ R8/G10/B4) e5a81b ffe08a bb8410 (UFA324)
// fef54b (นินจา168) f0bb4e (รวยเทพ168) f0c878 (ดวงเศรษฐี168) dcb95f (รวยแท้168)
// fdcb0c fefb6b (สบาย168) หรือ f0b46a (โปรดี168)
// ชุดที่ถอดออกรอบนี้คือ **ทองคานารี-เงินโครเมียมบนดำสนิท** ของ ยูฟ้า168 (fee45d
// e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4
// 140e02 0b0d10 000000) และชุดของแบรนด์ขาออก **สบาย168** (2cc3fc 6bdcfb 0a7fbd
// 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff a9e3f9 fdcb0c
// fefb6b 8a6504 0f3a4a 06293c 2a1f02) — ต้องไม่เหลือสักค่า พร้อมกับชุดของ
// รวยแท้168 (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8
// fff1ef ffdbdb c99a3f) มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5)
// ดวงเศรษฐี168 (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) ufalion168
// (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000)
// UFA324 (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a) CEO66 (020617
// 7e22ce d946ef f5d0fe a855f7) รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04
// 0d0501 5c2a06 fff8ec) นินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28
// 030e16 041019 dceefc) สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a
// 9ba03c d8ffc7 e9fbdd) หวยคิง (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 0c0b0a 120a02
// 1c140b) มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) หวย365
// (140203 dc0203 f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07) มีเฮ168 (fb1b32 ff8f9c
// 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205) รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b
// f9a826 704504 e3f2fc 0b2d52 071e38 030f1d) สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78
// ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16) ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20
// 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74
// b3121b 5a0a0e eadfce) รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c
// cfd9e6) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203)
// และโปรดี168 (eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a
// 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802) รวมถึง 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีเขียว ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีโรสโกลด์ และไม่มีส้ม**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#eeae12]/45 bg-gradient-to-br from-[#3a2713] to-[#1f1308] p-8 text-left text-base leading-relaxed text-[#f4ead6] shadow-[0_10px_30px_rgba(0,0,0,0.55)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fded41] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#eeae12] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e0e0df] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#a1a09e] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#eeae12] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#fded41] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
