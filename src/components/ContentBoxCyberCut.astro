---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e8121d]/35 bg-[#0b0203]/92 p-8 text-left text-base leading-relaxed text-[#dfe3ea] shadow-[0_10px_30px_rgba(232,18,29,0.16)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#e8121d] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#7c0207] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e8121d] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#7c0207] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#7c0207] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ff4d55] via-[#c2c9d4] to-[#e8121d] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
