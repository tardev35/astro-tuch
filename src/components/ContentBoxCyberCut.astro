---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries a page's H1 in the
// MIRACLE55 mix, and a level is never hardcoded in the markup below; `as`
// decides it. The header has no `whitespace-nowrap`: a full docx sentence has
// to wrap.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม-ดำ 2026-09-25): พื้นการ์ดดำอมน้ำตาล #14100a ใน
// กรอบทองแบรนด์ #fcda65 มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สองโลหะของโลโก้ไขว้กัน
// — ขาวโครเมียม #fcfcfc คู่กับเงินโครเมียม #d2d3d4 บนแนวหนึ่ง และทองสว่าง #fee47b
// คู่กับทองลึก #8c5f14 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ด
// เกือบดำ หัวข้อไล่ตามลำดับโลหะบนโลโก้ คือทองสว่าง → ขาวโครเมียม → ทองแบรนด์
// เนื้อความ #e8e6e1 (BRAND_TEXT) — โทนทอง-โครเมียมของ UWIN33 (#e0b429 #fbd564
// #7a5407 #dfe4ec #161106 #ece6d8) หายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fcda65]/55 bg-[#14100a]/94 p-8 text-left text-base leading-relaxed text-[#e8e6e1] shadow-[0_10px_30px_rgba(252,218,101,0.2)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fcfcfc] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#8c5f14] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fee47b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#d2d3d4] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#d9a62b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
