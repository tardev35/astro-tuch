---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2): แบรนด์นี้เป็น
// "คู่สี" จริง — เขียวมรกตเข้มกับทอง — ต่างจากคู่ฟ้าสด-เหลืองมะนาวของ แตกดี168 รอบก่อน
// และต่างจากทองเมทัลลิกฮิวเดียวของ 789BETTING ก่อนนั้น bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#061801"} = เขียวเกือบดำ จึงไม่ใช่พื้นดำตันอีกต่อไป และ
// การ์ดต้องยกขึ้นจากพื้นด้วยผิวที่สว่างกว่าพื้นหนึ่งขั้น
// หน้านี้มีการ์ดมุมตัดสามใบ จึงแยกด้วย "ระดับความลึกของผิว" ไม่ใช่แค่คนละสีหัวข้อ —
// ใบนี้เป็นผิวยกที่สว่างที่สุด #0d2414 · TwoCyberCut เป็นผิวกลาง #09190d ·
// SevenThreeCyberCut เป็นผิวลึก #051007
// เส้นรูดสี่มุมจับคู่ "ทอง vs เขียว" ไขว้กัน — ทองแบรนด์ #cc920a คู่ทองซีด #fde9a6 บน
// แนวนอน เขียวสว่าง #2fbf6a คู่เขียวมรกต #0a6b32 บนแนวตั้ง ทำให้กรอบพาทั้งสองฮิวมาไว้
// ที่ตัวกรอบเอง หัวข้อไล่เขียวสว่าง #2fbf6a → ทองสว่าง #f7d14e → ทองซีด #fde9a6 คือ
// ไล่จากเขียวขึ้นหาทอง ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ทองเข้ม #8a6204 กับเขียวเข้ม #043d1c อ่านไม่ออกบนผิวการ์ด จึงถูกใช้เป็นขอบและเส้นคั่น
// เท่านั้น ไม่เคยเป็นสีตัวอักษร เนื้อความขาวอมเขียว #e8f2e6 (= BRAND_TEXT) — 14.7:1
// บนผิวใบนี้
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #fff48a
// #c9a703 #0a1726 #07111d #dbeafe) และชุดทองเมทัลลิกของ 789BETTING/UOK365 ก่อนหน้านั้น
// (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #17130a #0e0b05 #060402 #f3e7cd
// #c8912f #f5d98a #ece1cc) ออกครบทุกจุดแล้ว — ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่า
// ไว้เพราะ "ดูคล้ายกัน"
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#cc920a]/40 bg-[#0d2414]/96 p-8 text-left text-base leading-relaxed text-[#e8f2e6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#cc920a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fde9a6] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#2fbf6a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#0a6b32] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#cc920a] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#2fbf6a] via-[#f7d14e] to-[#fde9a6] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
