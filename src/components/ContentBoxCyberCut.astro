---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// YADOM168 palette: near-black green surface (#071508) with a bright green rule
// pair on one diagonal and a gold-coin pair on the other, so the clipped corners
// read as the logo's chrome wordmark over the green 168 rather than one flat hue.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#5cc23f]/70 bg-[#071508]/92 p-8 text-left text-base leading-relaxed text-[#d4e8cb] shadow-[0_10px_30px_rgba(92,194,63,0.30)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#8fe06f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#1d6b18] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e6bd5c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#9c8340] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#5cc23f] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f2fbef] via-[#5cc23f] to-[#1d6b18] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
