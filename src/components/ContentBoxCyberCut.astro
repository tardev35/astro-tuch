---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §2** มาให้ใบนี้ (content.txt บรรทัด 6) พร้อมย่อหน้าเดียว
// ของมัน กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบ
// บทความของแบรนด์ปัจจุบัน (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager
// import = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง
// slide* ไว้กับ ContentBoxSevenThree* เท่านั้น
//
// ufalion168 (รอบ **ทองสองเฉด + บรอนซ์ บนดำสนิท — ไม่มีสีที่สองที่เป็นคนละวงศ์**
// 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ufalion168.md §2
// งานศิลป์: โลโก้คือหัวสิงโตทองคำสวมมงกุฎทองบนริ้วทองเหลวสาดกระเซ็น ใต้ลงมาเป็น
// คำว่า ufalion168 ตัวอักษรหนาสามมิติผิวทองมันวาว แบนเนอร์เป็นฉากสนามบอลกลางคืน
// พื้นดำกับชุดบอลดำ-ทอง ถ้วยแชมเปี้ยนส์ลีก และลูกฟุตบอลดำ-ทอง
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #33200a ยก / #1f1304 กลาง /
// #0a0601 จม / #000000 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ทองนำ vs
// ทองสว่าง" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — ทองนำ #d4922c คู่ครีมทอง
// #f6e3b4 อยู่บนแนวนอน ส่วนทองสว่าง #fdfc71 คู่บรอนซ์ไหม้ #5a3310 อยู่บนแนวตั้ง
// ตรงกับงานศิลป์ที่ตัวอักษรเป็นทองสองเฉด (`ufa`/`168` เข้ม `lion` อ่อนกว่า) และ
// เงาของขนแผงสิงโตเป็นบรอนซ์
// ⚠️ ใบนี้เป็นหนึ่งในสองใบบนหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ใช่ไล่เฉด** — ครีมทอง
// #f6e3b4 (12.3:1 บนผิวการ์ด) บนสันซ้ายทองนำ ส่วนอีกใบคือ §5 ที่เป็นทองนำทึบ
// ขณะที่ใบที่เหลือเป็นไล่เฉดสามสีคนละลำดับ หรือเป็นหมึกเข้มบนแผ่นถมสว่าง (§2)
// เนื้อความ #fbf6e3 (= BRAND_TEXT) — 14.3:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #a25b24 (3.0:1) และ #5a3310 ถือตัวอักษร — ที่นี่อยู่ที่ขอบและเส้นรูดเท่านั้น
//
// ⚠️ **กับดักรอบนี้: ทองเคยนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอ "ทอง" ในไฟล์นี้
// จึงไม่พิสูจน์อะไร ต้องเทียบเป็น "ค่า" ทีละตัว: ทองนำรอบนี้คือ **#d4922c**
// (R=212 G=146 B=44) ซึ่ง **ห่างจาก dfa310 ของ TND168 ที่ G=163 B=16 เพียงหลักเดียว
// ในสองช่อง** · ทองสว่างรอบนี้เป็น **เลมอนครีม #fdfc71** ไม่ใช่เลมอนจัด fef54b ของ
// นินจา168 · ฮิวที่สามเป็น **บรอนซ์ #a25b24** ที่ยังไม่มีแบรนด์ไหนในรีโปนี้ใช้ ·
// ชุดความลึกเป็น **น้ำตาลทอง** #33200a / #1f1304 / #0a0601 ไม่ใช่ 3b1b0e / 260d04 /
// 0d0501 ของรอบขาออก
// ชุดเต็มของรวยเทพ168 ที่เพิ่งอยู่ในไฟล์นี้ (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดของมีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c
// 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308) ชุดของรวยแทร่168 (039cfa 0494f5 c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของนินจา168 (32bcfb
// a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของสบายเบท168
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617
// fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee
// 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e
// 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของ
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303
// 170504 f4ecea 2c1413 1f0d0c 140706 290f0f) และชุดของ UFA324 (e5a81b ffe08a bb8410
// 7d5a07 43300a 8792a0 f0e8d4 b9c2cc 464f5a) ออกครบทุกจุดแล้ว รวมถึง 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงเลย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/
// โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มีส้มสด**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#5a3310]/60 bg-gradient-to-br from-[#33200a]/96 to-[#1f1304]/96 p-8 text-left text-base leading-relaxed text-[#fbf6e3] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#d4922c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#f6e3b4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fdfc71] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#5a3310] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#d4922c] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#f6e3b4] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
