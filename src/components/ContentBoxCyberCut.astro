---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2, but this file carries the page's H1 (docx #1) this
// round — which is why no level is hardcoded in the markup below; `as` decides
// it every time. The header has no `whitespace-nowrap`: a full docx sentence
// has to wrap.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): เว็บแทงหวยออนไลน์ โลโก้เป็นคำว่า "หวย"
// สีเขียวมรกตคู่กับ "เต็ง" สีทอง และงานอาร์ตเป็นฉากคืนเขียวป่าที่มีริ้วแสงทอง
// เหรียญทอง ลูกหวยทอง-ขาว กับเงาวัดสีทอง ผิวการ์ดจึงเป็นเขียวเข้ม #062a12 ใน
// กรอบทองแบรนด์ #e5c04f มุมตัดเฉียง เส้นรูดสี่มุมจับคู่สองโทนของโลโก้ไขว้กัน —
// ทองแบรนด์ คู่เขียวมรกตสว่าง #0bb42f บนแนวหนึ่ง และขาวอมเขียว #eafbe9 คู่เขียว
// เงิน #a9cfae บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเขียวเข้ม
// หัวข้อไล่ทองอ่อน #fae474 → ทองแบรนด์ → เขียวมรกตสว่าง ต่างจากหัวข้อของ
// ContentBox ตัวกลางที่ไล่ขาว → ทอง → เขียวลึก จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// เนื้อความ #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างใน
// ไฟล์นี้ (#8bfc13 #e8f0e6 #1a7a08 #8fa38a #0b160b #d5e6cd) ออกทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e5c04f]/55 bg-[#062a12]/94 p-8 text-left text-base leading-relaxed text-[#d8ead9] shadow-[0_10px_30px_rgba(229,192,79,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#e5c04f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#a9cfae] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#eafbe9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#0bb42f] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#e5c04f] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#0bb42f] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
