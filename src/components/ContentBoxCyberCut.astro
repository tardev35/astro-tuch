---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §2** มาให้ใบนี้ (content.txt บรรทัด 6) พร้อมย่อหน้าเดียว
// ของมัน กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบ
// บทความของแบรนด์ปัจจุบัน (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager
// import = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง
// slide* ไว้กับ ContentBoxSevenThree* เท่านั้น
//
// มีเฮ168 (รอบ **แดงชาดนำ · ทองเนยเป็นฮิวที่สอง · แดงลึก/บรอนซ์ลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-meehay168.md §2
// งานศิลป์: โลโก้คือ "มี" ตัวอักษรไทยหนาสามมิติสีขาวมุกตัดขอบเทา ต่อด้วย "เฮ168"
// สีแดงชาดบับเบิลผิวมันวาว ข้างๆ เป็นหน้ายิ้มหัวเราะสีเหลืองทองบนกองเหรียญทอง
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0711 ยก / #1a040a กลาง /
// #0c0205 จม / #000000 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "แดง vs ทอง"
// คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — แดงแบรนด์ #fb1b32 คู่ชมพูบลัช #ff8f9c
// อยู่บนแนวนอน ส่วนทองเนย #fcd45c คู่แดงลึก #5c0410 อยู่บนแนวตั้ง ตรงกับงานศิลป์ที่
// แดงเป็นสีหลักของตัวอักษร/โบว์/หัวใจ และทองเป็นเหรียญกับมงกุฎ
// ⚠️ ใบนี้เป็นใบเดียวบนหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ใช่ไล่เฉด** — ชมพูบลัช
// #ff8f9c (8.5:1 บนผิวการ์ด) บนสันซ้ายแดงแบรนด์ ขณะที่ใบอื่นเป็นไล่เฉดสามสีคนละ
// ลำดับ หรือเป็นหมึกเข้มบนแผ่นถมสว่าง (§2)
// เนื้อความ #fdeaec (= BRAND_TEXT) — 15:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #5c0410 (1.4:1) และ #6b4a08 (1.8:1) ถือตัวอักษร — ที่นี่อยู่ที่ขอบและ
// เส้นรูดเท่านั้น
//
// ⚠️ **กับดักรอบนี้: แดง และ ทอง เคยถูกใช้มาแล้วหลายแบรนด์ในรีโปนี้** การเจอ "แดง"
// หรือ "ทอง" ในไฟล์นี้จึงไม่พิสูจน์อะไร ต้องเทียบเป็น "ค่า" ทีละตัว: แดงรอบนี้คือ
// **#fb1b32** (R=251 G=27 B=50) ซึ่ง **ห่างจาก fa0513 ของสมหวัง168 แค่นิดเดียว** ·
// ฮิวที่สองรอบนี้เป็น **ทองเนย #fcd45c** ไม่ใช่ทองอำพัน f9a826 ของรอบที่แล้ว ·
// ชุดความลึกเป็น **แดงหมึก** #2b0711 / #1a040a / #0c0205 ไม่ใช่ 0b2d52 / 071e38 /
// 030f1d
// ชุดเต็มของรวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ผ่านมา (039cfa 0494f5 c3ebfc 04366b
// f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของนินจา168 (32bcfb a9e9ff
// fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของสบายเบท168 (2f9ff5
// a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ชุดของ
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5)
// ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c
// 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) และชุดของสมหวัง168
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504
// f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ออกครบทุกจุดแล้ว รวมถึง 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ม่วง เขียว ส้ม เงิน/โครเมียม โรสโกลด์ เหลืองมะนาว
// และชมพูฟูเชีย**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#5c0410]/60 bg-gradient-to-br from-[#2b0711]/96 to-[#1a040a]/96 p-8 text-left text-base leading-relaxed text-[#fdeaec] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fb1b32] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ff8f9c] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fcd45c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#5c0410] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fb1b32] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#ff8f9c] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
