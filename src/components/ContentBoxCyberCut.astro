---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here), so
// there is no badge arithmetic to redo in this file.
//
// รอบนี้หน้าแรกส่ง **docx H1 §1** มาให้ใบนี้ ("<แบรนด์> เกมพนันเบอร์ต้นๆของไทย
// สมัครเล่นไม่มีขั้นต่ำ" — content.txt บรรทัด 3) พร้อมย่อหน้าของมัน (บรรทัด 4)
// เป็นกล่องเดียวบนหน้าที่ถือ h1 — **ห้าม hardcode ข้อความไทยเป็น heading ที่นี่**
// ⚠️ ดรอปนี้ **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบันเลย** (banner2.png /
// banner3.png เป็นของ LOTTO189 และ eager import = emit ขึ้น dist ทุก build) จึงไม่มี
// รูปในการ์ดใบนี้ และ **ห้ามเอา slide มาแทน** — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา 2 ใบของรอบนี้ถูกใช้ไปที่ §4 กับ §5 ครบแล้ว
//
// ⚠️⚠️ **มุมตัดคงไว้ แต่ภาษาไซเบอร์ถอดออกหมด** — รูปทรงมุมเฉียงอ่านเป็น
// **ตั๋ว/ดวงตราประทับ** ซึ่งเข้ากับหัวข้อเปิดหน้าพอดี ส่วนภาษาภาพแบบนีออน-สแกนไลน์
// (มอนอสเปซ · `SYSTEM_` · สแลชสามตัว · เส้นสแกน) **ไม่มีในไฟล์นี้แล้วสักจุด**
//
// ───────────────────────────────────────────────────────────────────────────
// TEVA69 (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-teva69.md §2
// **เขียวป่านำ · เงินโครเมียม/ทองอำพันเป็นวัสดุที่สอง · เนื้อหาบนธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเม็กซิกัน-ทองของ MEXICANOSLOT** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ พื้นเพจรอบนี้ #f0ffeb (bg.json) = ขาวอมมิ้นต์จาง **ห้ามแก้กลับไปเป็น
// ผิวมืดตามโครม** — การ์ดมืดกับหมึก #10280f จะทำให้ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// **และห้ามเหลือแดง/ส้ม/พีชไว้เลยสักค่า**
// ลำดับผิว: #ffffff การ์ด · #e6f7df ยก · #d7f0cd wash · #f0ffeb พื้นเพจ —
// การ์ดใบนี้ไล่จาก **การ์ดขาวลง wash** (#ffffff → #d7f0cd) ซึ่งเป็นผิวที่ลึกที่สุด
// ในบรรดากล่องเนื้อหาของหน้านี้ (§3 ContentBox ตัวฐานเป็นขาวล้วน ·
// §2/§6 เป็นผิวยก/ไล่ขาว-ยก · §7 เป็น wash ครอบการ์ดขาว)
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "เขียว vs
// ทอง/เขียวสด" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — **แนวนอนเป็นเขียวแบรนด์**
// (#1a7d24 และ #116018) ส่วน **แนวตั้งเป็นทองอำพัน/เขียวสด** (#e3bb45 และ #28c437)
// ซึ่งเป็นที่เดียวบนหน้าที่สองวัสดุของรอบนี้ (เวิร์ดมาร์กเขียวมรกตกับมงกุฎทอง
// ดวงเล็กบนอาร์ตเวิร์ก) ถูกวางไขว้กันตรง ๆ
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **สันซ้ายหนาสี่พิกเซล** — สัน #1a7d24
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ) กับหัวข้อ **เขียวป่า #116018 ทึบสีเดียว
// ไม่ไล่เฉด ไม่มีแผ่นถม ไม่มีเรืองแสง** (7.8:1 บนผิวการ์ดขาว · ~7.2:1 บนปลาย wash)
// เนื้อความ #10280f (= BRAND_TEXT) — 15.8:1 บนผิวการ์ด และ 14.6:1 บน wash
//
// ⚠️⚠️ §2 ห้าม **#28c437 / #e3bb45 / #c6cfd2 / #b2dba3 / #d7f0cd / #e6f7df /
// #f0ffeb** ถือตัวอักษรบนผิวสว่างทุกกรณี — ในไฟล์นี้อยู่ที่สันซ้าย เส้นรูด และขอบ
// ซึ่งเป็นพื้นถมล้วน · **#3f7a2e เป็นเส้น/ขอบเท่านั้น** ·
// **#116018 ใช้ทั้งหัวข้อที่นี่และ <strong> ในเนื้อความ** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(17,96,24,α) · rgba(11,74,18,α) · rgba(26,125,36,α) ·
// rgba(40,196,55,α) · rgba(16,40,15,α) · rgba(227,187,69,α) · rgba(11,42,18,α)
//
// ⚠️ 🚨 **เขียวเป็นฮิวนำรอบนี้ และรีโปนี้มีเขียวของแบรนด์อื่นอยู่หลายชุด** การเจอ
// เขียวในไฟล์จึงไม่พิสูจน์อะไร ต้อง grep เป็น "ค่า" ทีละตัว — เขียวรอบนี้คือ
// **#116018 / #0b4a12 / #1a7d24 / #28c437 / #3f7a2e / #b2dba3** เท่านั้น ไม่ใช่
//   8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05 06220a (**KINGKONG555** —
//   ⚠️⚠️ **e9f7d6 ↔ e6f7df · bde397 ↔ b2dba3 · 1a5c04 ↔ 1a7d24 สามคู่นี้ใกล้ที่สุด
//   เจอค่าซ้ายให้ถือว่าพิมพ์ผิดก่อนเสมอ**) ·
//   0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (**สาธุ168** — 0b7d28 ↔ 0b4a12) ·
//   1fae1c 0d2312 143a1c 07130a (888PARUAY) · 117a41 2bb061 2fbf6a
//   (MEXICANOSLOT/KOON234 — **2bb061 ↔ 28c437**)
// ⚠️⚠️ ชุดที่เพิ่งอยู่ทั้งใบนี้และออกครบแล้ว: **MEXICANOSLOT** de2b1e f2a033 a81410
//   c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae
//   fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb f2543f + rgba 222/43/30,
//   rgba 168/20/16, rgba 63/19/13, rgba 246/196/164, rgba 254/215/181
// 🚨 **LOTTO189 คือแบรนด์ขาออกทันที = เสี่ยงหลงเหลือสูงสุด**: fff0f0 ffe4e6 ffd4d7
//   f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c
//   24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//   ⚠️⚠️ **e9b53c ↔ e3bb45 · c3ccd6 ↔ c6cfd2 · 8f6310 ↔ 8a6a0e** สามคู่ที่ใกล้ที่สุด
// ชุดอื่นที่ห้ามกลับเข้ามา: **ZNOVA168** 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0
//   e0b784 fffbf0 fff4e0 ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800
//   fa4903 fde90b e8a000 ff8a2b d8dde6 8f9aa8 6a4a30 · **ZANE96** 7a1bd6 2b3fd9
//   c2178b f23bb4 bb6dff 7aa7ff 5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb dcc6f4
//   9a6fd0 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 8e14b8 2f1766 · **โบ๊ะบ๊ะ168**
//   00bfff 12b4ef b6e3f0 06283f 0b4a73 2a87c4 eaf7ff · **หมูบิน168** fa539c c2185b
//   8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 3b0b26
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีส้ม/พีช ไม่มีชมพู/แมเจนต้า ไม่มีม่วง ไม่มีฟ้า/ไซแอน
// และไม่มีแรมป์เทาเงินเต็มหน้า** — เงินโครเมียม #c6cfd2 เป็น **ลายเซ็นของเวิร์ดมาร์ก**
// ใช้บนโครมเข้มเท่านั้น และไม่อยู่ในไฟล์นี้ · หญิงสาวสวมสูทขาว ห้องสีขาวครีม
// ชิปคาสิโนเขียวเข้ม มงกุฎทองดวงเล็ก และต้นไม้ในกระถางเป็น **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#b2dba3] bg-gradient-to-br from-white to-[#d7f0cd] p-8 text-left text-base leading-relaxed text-[#10280f] shadow-[0_10px_30px_rgba(17,96,24,0.13)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#1a7d24] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#116018] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e3bb45] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#28c437] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#1a7d24] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#116018]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
