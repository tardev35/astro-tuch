---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// KMD88 (รอบม่วงราชา-ทอง 2026-10-13, brand-spec §2): พาเลตต์รอบนี้เป็น **สองฮิวจริง
// ม่วงนำ ทองรอง** อ่านจากโลโก้ตรงๆ — คำว่า KMD เป็นตัวอักษรสามมิติม่วงขัดเงาขอบทอง
// ต่อด้วยเลข 88 ทองเมทัลลิก ในวงแหวนทองที่ขาดช่วง
// ⚠️ bg.json = {"mode":"color","color":"#000000"} → พื้นเพจ **ดำสนิท** จึงไม่มีชั้นไหน
// จมต่ำกว่าพื้นได้เลย ผิวจม #0a0213 คือก้นสุดของลำดับความลึกรอบนี้
// (#1d0832 ยก / #140522 กลาง / #0a0213 จม / #000000 พื้น)
// การ์ดใบนี้เป็นผิวยก #1d0832 ซึ่งเป็นผิวที่สว่างที่สุดของหน้า — หัวข้อ H1 จึงลอยขึ้น
// สูงสุด ต่างจาก Faq3 ที่เป็นผิวจม #0a0213 อยู่ท้ายสายบทความ
// เส้นรูดสี่มุมจับคู่ "ทอง vs ม่วง" ไขว้กัน — ทองแบรนด์ #e2b33f คู่ทองสว่าง #ffdf8c
// บนแนวนอน ม่วงสว่าง #b453ff คู่ม่วงแบรนด์ #7505cc บนแนวตั้ง ตรงกับโลโก้ที่ตัวอักษร
// ม่วงวางคู่เลขทองในวงแหวนทอง
// หัวข้อไล่ทองสว่าง #ffdf8c → ม่วงตัวอักษร #c07cff → ทองแบรนด์ #e2b33f ซึ่งเป็นลำดับ
// ที่ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกันสักใบ
// ม่วงแบรนด์ #7505cc ม่วงสว่าง #b453ff ม่วงลึก #3a0565 #2c0349 และทองลึก #7a5a0a
// ถูกใช้เป็นขอบ/เส้น/ออราเท่านั้น ไม่เคยถือตัวอักษร ตามที่ §2 กำหนด
// ม่วงที่ถือตัวอักษรได้มีสองตัวคือ #c07cff (5.3:1) และ #d9b8ff (8.6:1)
// เนื้อความงาช้างอมม่วง #ece2f8 (= BRAND_TEXT) — 12.6:1 บนผิวยก
// #ffd45e ถูกสงวนให้ <strong> ในย่อหน้าเท่านั้น จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทั้งสองฮิว** ทองมาแล้ว
// เก้าในสิบสองรอบ และม่วงก็เพิ่งมาสองรอบ "มีทองหรือมีม่วงอยู่แล้ว" จึงไม่พิสูจน์อะไร
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9
// #8792a0 #bb8410) ชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc
// #8a5c09 #43240b #140d02 #1b1307 #120c04 #070502) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168
// (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038
// #3a0a2a #2e0022 #1c0014) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4
// #fde8f3 #f5c53d #9c6f08 #b3006a #7a0046 #4d002b #210220 #3a0534) ชุดทองเป็ด-ส้ม
// อำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c
// #1a1203 #f6ecd9 #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ
// NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859
// #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ
// FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a) ออกครบทุกจุดแล้ว
// ⚠️ ม่วงที่ใกล้ที่สุดคือ #a435f0 ของ WEPLAY168 (R=164 G=53 B=240) และ #7e22ce ของ
// BPLAY639 (R=126 G=34 B=206) — ไม่มีตัวไหนเป็น #7505cc (R=117 G=5 B=204) และทอง
// #e2b33f (R=226 G=179 B=63) ก็ไม่ใช่ #e5a81b หรือ #dfa310 ห้ามกะด้วยตา
// ⚠️ **รอบนี้ไม่มีเงิน/เทา/โครเมียม ไม่มีชมพู ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้ม และ
// ไม่มีแดงเลย** #b9c2cc #8792a0 #464f5a #f2f5f9 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#7505cc]/45 bg-[#1d0832]/96 p-8 text-left text-base leading-relaxed text-[#ece2f8] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#e2b33f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffdf8c] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#b453ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#7505cc] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#7505cc] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffdf8c] via-[#c07cff] to-[#e2b33f] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
