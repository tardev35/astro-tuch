---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): เว็บคาสิโนอัปเดตล่าสุด
// โลโก้เป็นสองโลหะจริง — ตัว U กับตัวอักษร UP เป็นเงินโครเมียม ส่วนลูกศร วงรี และเลข
// 555 เป็นทองเมทัลลิก การ์ดจึงเป็นผิวการ์ดดำอมน้ำตาล #130b03 ในกรอบทองแบรนด์
// #ebbb54 มุมตัดเฉียง และเส้นรูดสี่มุมจับคู่สองโลหะของโลโก้ไขว้กัน — ทองแบรนด์คู่ทอง
// สว่าง #fce675 บนแนวหนึ่ง และเงินโครเมียม #d5d4d3 คู่ทองลึก #ab6d24 บนอีกแนวหนึ่ง
// ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนพื้นดำ หัวข้อไล่เงินสว่าง #f3f3f2 → ทองสว่าง
// #fce675 → ทองลึก #ab6d24 คือเริ่มที่เงินแล้วจบที่ทอง ต่างจากหัวข้อทองสว่าง →
// ทองแบรนด์ → เงิน ของ ContentBox ตัวกลางที่เริ่มทองจบเงิน และต่างจากหัวข้อทองตัน
// ของ SevenThreeCyberCut เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#121010 #edbb23 #ffeeb4 #c8cbce
// #a87708 #f7d458 #f0e6d2) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#ebbb54]/55 bg-[#130b03]/94 p-8 text-left text-base leading-relaxed text-[#f8eed9] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ebbb54] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fce675] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#d5d4d3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ab6d24] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#ebbb54] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f3f3f2] via-[#fce675] to-[#ab6d24] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
