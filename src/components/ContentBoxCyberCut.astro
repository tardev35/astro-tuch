---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries a page's H1 in the UWIN33
// mix, and a level is never hardcoded in the markup below; `as` decides it. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): พื้นการ์ดดำอมน้ำตาล #161106 ในกรอบทอง
// แบรนด์ #e0b429 มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สองสีของโลโก้ไขว้กัน — เงิน
// โครเมียม #dfe4ec คู่กับทองสว่าง #fbd564 บนแนวหนึ่ง และทองแบรนด์ #e0b429 คู่กับ
// ทองลึก #7a5407 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ
// หัวข้อไล่ตามลำดับสีบนโลโก้ คือเงินโครเมียม → ทองสว่าง → ทองแบรนด์ เนื้อความ
// #ece6d8 (BRAND_TEXT) — โทนทอง-เขียวเข้ม-แดงของ 888PARUAY หายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e0b429]/55 bg-[#161106]/94 p-8 text-left text-base leading-relaxed text-[#ece6d8] shadow-[0_10px_30px_rgba(224,180,41,0.2)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#dfe4ec] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#7a5407] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fbd564] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#e0b429] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#e0b429] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
