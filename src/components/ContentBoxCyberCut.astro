---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// VAK88 palette: near-black navy surface (#070b16) inside a metallic-gold hairline
// frame, with the clipped corners split across the logo's two hues — gold rules
// (#ffd873 / #8a5f14) on one diagonal, phoenix crimson (#ee3a34 / #6b0d11) on the
// other — so the cut corners read as the gold VAK88 wordmark against the crimson
// phoenix rather than one flat hue.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e6b23c]/60 bg-[#070b16]/92 p-8 text-left text-base leading-relaxed text-[#ded8ca] shadow-[0_10px_30px_rgba(230,178,60,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ffd873] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#8a5f14] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ee3a34] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6b0d11] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#e6b23c] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffd873] via-[#fff4dd] to-[#e6b23c] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
