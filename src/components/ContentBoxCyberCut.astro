---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2): รอบนี้พลิกทิศจาก
// คู่ "แดงเสือโคร่ง-ทองถ่านไฟ" ของ SUPERSLOTCLUB — ที่นั่นแดงนำบนพื้นน้ำตาลถ่าน
// เกือบดำ รอบนี้ **ทองนำ** บนพื้นแดงเลือดนกเต็มตัว เพราะ bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#5c0000"} การ์ดใบนี้เป็นผิวยก #7d1008 ซึ่งสว่างกว่าพื้น
// เพจ จึงลอยขึ้นมาแทนที่จะจมลง และเป็นใบที่สว่างที่สุดในสามใบมุมตัดของหน้านี้ —
// SevenThreeCyberCut เป็นผิวลึกสุด #430000 ส่วน SevenThreeFloatingBadge ไล่จาก
// ผิวกลาง #6d0804 ลงไปหาผิวลึกสุด ทั้งสามจึงไล่ระดับความลึก ไม่ได้ซ้ำผิวเดียวกัน
// เส้นรูดสี่มุมจับคู่ "ทอง vs แดง" ไขว้กัน — ทองสายฟ้า #f5c518 คู่ทองสว่าง #ffdd73
// บนแนวนอน แดงสายฟ้า #ff3b14 คู่แดงเข้ม #8c0f0a บนแนวตั้ง ตรงกับโลโก้ที่เป็นสายฟ้า
// ทองผ่ากลางเหรียญแดง คำว่า FLASH เป็นทองและเลข 877 เป็นแดงสด
// หัวข้อไล่ทองสว่าง #ffdd73 → แดงสายฟ้า #ff3b14 → ทองสายฟ้า #f5c518 ซึ่งเป็นลำดับ
// ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ทองเข้ม #b8860f แดงเข้ม #8c0f0a และแดงลึกสุด #5a0603 ถูกใช้เป็นขอบ/เส้นรูด/เงา
// เท่านั้น ไม่เคยถือตัวอักษร ตามที่ §2 กำหนด
// เนื้อความครีมอมส้มอ่อน #fdf0e2 (= BRAND_TEXT) — 11.6:1 บนผิวยก
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) **ก็แดง-ทองเหมือนกัน** เจอแดงหรือทองที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า": ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 ที่
// เคยค้างในไฟล์นี้ (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08 #bde397
// #e9f7d6 #14380a #0f2e05 #051400 #06220a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b #fbe8d5 #3d1709 #301105
// #241000) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #7a1fc4 #fbe455 #efe6ff #ece2ff
// #d2a6ff #ffd23d #5b1a75 #c98a05 #1e0a3c) และชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d
// #a30303 #f5b61d #ffd87a #b07a06 #6b0402) ออกครบทุกจุดแล้ว — ทองของรอบนี้คือ
// #f5c518 / #ffdd73 / #b8860f เท่านั้น และแดงคือ #ff3b14 / #8c0f0a / #5a0603
//
// ⚠️ #ff3b14 ได้แค่ ≈3.6:1 บนผิวการ์ด จึงอยู่ได้เฉพาะในไล่เฉดของหัวข้อตัวหนาขนาด
// ใหญ่ ในเส้นรูด และในออรา — ห้ามเอาไปถือตัวอักษรเนื้อความ
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#f5c518]/40 bg-[#7d1008]/96 p-8 text-left text-base leading-relaxed text-[#fdf0e2] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f5c518] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffdd73] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ff3b14] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#8c0f0a] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f5c518] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffdd73] via-[#ff3b14] to-[#f5c518] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
