---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §3** มาให้ใบนี้ ("อัตราจ่าย หวย <แบรนด์> จ่ายสูงไม่อั้น"
// — content.txt บรรทัด 8) พร้อมย่อหน้าเดียวของมัน กฎบ้าน "หนึ่งสล็อตรับ element
// เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit) จึงไม่มี
// รูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น
//
// รวยแท้168 (2026-10-21) — พาเลตตาม .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **ธีมสว่างรอบที่สามของรีโปนี้** พื้นเพจ #ffdbdb (bg.json) การ์ดเนื้อหาจึงเป็น
// **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก · #fff1ef กลาง · #ffdbdb พื้นเพจ — การ์ดใบนี้ไล่จากยกลงกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "แดงคริมสัน vs
// หมึกเลือดหมู" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — แนวนอนเป็นแดงคริมสัน
// #c30303 คู่สกาเล็ต #e81313 ส่วนแนวตั้งเป็นหมึกเลือดหมู #4a0f0f คู่แดงคริมสัน
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ไล่เฉด และไม่มีแผ่นถม** —
// แดงคริมสัน #c30303 (6.3:1 บนผิวขาว · 6.0:1 บนผิวกลาง) บนสันซ้ายหนาสี่พิกเซล
// เนื้อความ #4a0f0f (= BRAND_TEXT) — 15.4:1 บนผิวยก และ 14.6:1 บนผิวกลาง
//
// ⚠️ §2 ห้าม #ffdbdb/#fff1ef ถือตัวอักษรบนผิวขาว และ **ห้าม #e81313 ถือตัวอักษร
// หรือเป็นพื้นของตัวอักษร** (4.0:1 บนขาว = ตก AA) — ในไฟล์นี้ #e81313 อยู่ที่เส้นรูด
// ซึ่งเป็นพื้นถมล้วนเท่านั้น และ **#8f0505 ถูกสงวนไว้ให้ <strong> ในเนื้อความ** จึง
// ไม่อยู่ที่นี่ ส่วน **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของโครมล้วน
// ห้ามโผล่ในไฟล์นี้** (1.9–3.5:1 บนการ์ดขาว)
//
// ⚠️ **แดงนำมาแล้วมากกว่าฮิวใดในรีโปนี้** การเจอแดงในไฟล์ไม่พิสูจน์อะไร ต้อง grep
// เป็น "ค่า" ทีละตัว — แดงรอบนี้คือ #c30303 เท่านั้น และไม่ใช่ d30304 a00203
// (รับตัง168) fa0513 ff5a5f b90203 8c0204 (สมหวัง168) d9212a 8e1a16 (ดวงเศรษฐี168)
// e4021b (รวยเทพ168) fb1b32 (มีเฮ168) b3121b (ขวัญใจ168) dc0203 f5282a (หวย365)
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40, 10/95/28, 12/58/22,
// 174/176/74) และชุดชมพูบานเย็นของ มีทรัพย์168 ที่เคยอยู่ทั้งใบนี้ (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) ออกครบทุกค่าแล้ว พร้อมกับชุดของ ดวงเศรษฐี168 (d9212a
// 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) ufalion168 (d4922c fdfc71 a25b24
// 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) รวยเทพ168 (f0bb4e ffeccb
// e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06) มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c
// 6b4a08 2b0711 1a040a 0c0205 fdeaec) รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d) นินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10
// 0c2a3d 071a28 030e16) สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238) ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708)
// มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) ขวัญใจ168
// (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce) รับตัง168 (f0b429 ffdc8c
// d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0) สมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303) หวยคิง (cd9a2c fdeb7c ab7314
// f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) และ UFA324 (e5a81b ffe08a bb8410 7d5a07
// 43300a 8792a0 f0e8d4 b9c2cc 464f5a) รวมถึง 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้ม**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#c30303]/45 bg-gradient-to-br from-white to-[#fff1ef] p-8 text-left text-base leading-relaxed text-[#4a0f0f] shadow-[0_10px_30px_rgba(74,15,15,0.16)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#c30303] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#e81313] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#4a0f0f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#c30303] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#c30303] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#c30303] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
