---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2, but this file carries the page's H1 (docx #1) this
// round — which is why no level is hardcoded in the markup below; `as` decides
// it every time. The header has no `whitespace-nowrap`: a full docx sentence
// has to wrap.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): เว็บเกมสล็อตออนไลน์ โลโก้เป็น
// เวิร์ดมาร์กสองโทน — ตัว C กับเลข 68 เป็นโครเมียมขาวเงิน ส่วนตัว K กับเลข 2 เป็น
// เขียวนีออน และแบนเนอร์เป็นพื้นดำสนิทที่มีริ้วแสงเขียวนีออนพาดโค้งกับชิปคาสิโน
// เขียว-ดำ ผิวการ์ดจึงเป็นแผงดำอมเขียว #0b160b ในกรอบเขียวนีออนแบรนด์ #8bfc13
// มุมตัดเฉียง เส้นรูดสี่มุมจับคู่สองโทนของโลโก้ไขว้กัน — เขียวนีออน คู่เขียวลึก
// #1a7a08 บนแนวหนึ่ง และโครเมียมขาว #e8f0e6 คู่โครเมียมหม่น #8fa38a บนอีกแนวหนึ่ง
// ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ หัวข้อไล่โครเมียมขาว →
// เขียวนีออน → เขียวลึก เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS
// ที่ค้างในไฟล์นี้ (#dc020e #ff2d38 #6b0207 #fde79a #8a6a0a #2a0d0f #f0e2e2)
// ออกทั้งหมด ทองไม่ถูกใช้เป็น accent เลย เพราะ GOT777 รอบก่อนเป็นทอง-แดง
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#8bfc13]/55 bg-[#0b160b]/94 p-8 text-left text-base leading-relaxed text-[#d5e6cd] shadow-[0_10px_30px_rgba(139,252,19,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#8bfc13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#8fa38a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e8f0e6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#1a7a08] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#8bfc13] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
