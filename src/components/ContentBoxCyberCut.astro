---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §2** มาให้ใบนี้ ("…การันตีเว็บแท้ ผู้ใช้งานหลักแสนยูส
// ต่อวัน ไม่มีรีวิวเสียแน่นอน" — content.txt บรรทัด 6) พร้อมย่อหน้าเดียวของมัน
// กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// งานศิลป์: ฉากพื้นดำ หญิงสาวผมเงินประดับซากุระชมพูกับปิ่นทอง ชุดชมพูปักทอง ถือ
// เหรียญบิตคอยน์ทอง ข้างๆ เป็นมือถือจอชมพูขึ้นเครื่องหมายถูกพร้อมคำว่า ถอนสำเร็จ
// พื้นล่างเป็นปึกแบงก์ชมพูกับกองเหรียญทอง และริบบิ้นซาตินชมพูพลิ้วทั่วภาพ
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0f20 ยก / #1a0914 กลาง /
// #0d040a จม / #000000 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ชมพู vs ทอง"
// คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — ชมพูบับเบิลกัม #fa63b9 คู่ชมพูอ่อน
// #ffb3de อยู่บนแนวนอน ส่วนทองเนย #ffd84d คู่พลัมเข้ม #6d0b3f อยู่บนแนวตั้ง
// ตรงกับงานศิลป์ที่ฉากเป็นชมพูทั้งฉากและทองเป็นแค่เหรียญกับเส้นขอบ
// ⚠️ ใบนี้เป็นใบเดียวบนหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ใช่ไล่เฉด** — ชมพูอ่อน
// #ffb3de (10.7:1 บนผิวการ์ด) บนสันซ้ายชมพูบับเบิลกัม ขณะที่ใบอื่นเป็นไล่เฉดสามสี
// คนละลำดับ หรือเป็นหมึกเข้มบนแผ่นถมสว่าง (§1)
// เนื้อความ #fdeaf5 (= BRAND_TEXT) — 15.3:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #6d0b3f (1.5:1) และ #6b4708 (2.1:1) ถือตัวอักษร — ที่นี่อยู่ที่ขอบและ
// เส้นรูดเท่านั้น
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ชมพู และ ทอง** เพราะรอบที่แล้ว (มีโชค168) ก็เป็น
// ทอง+ชมพูบนดำเหมือนกัน การเจอชมพูหรือทองในไฟล์นี้ไม่ได้พิสูจน์ว่าเป็นของรอบนี้
// ต้องเทียบเป็น "ค่า" ทีละตัว: ชมพูรอบนี้คือ **#fa63b9** (R=250 G=99 B=185) ไม่ใช่
// f5469f (มีโชค168 — ตระกูลเดียวกันคนละค่า) f41571 / ff5ca8 (PUNPRO168) หรือ
// f472b6 (BPLAY639) · ทองรอบนี้คือ **#ffd84d** (R=255 G=216 B=77) ไม่ใช่ fcd434
// (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310
// (TND168) e5a81b (UFA324) e2b33f (KMD88) fad354 (789BETTING) f5c518 (FLASH877)
// fce343 (PUNPRO168) f3bb34 (DUCK1688) หรือ fbe455 (WEPLAY168)
// ชุดเต็มของมีโชค168 ที่เพิ่งอยู่ในไฟล์นี้ (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) และชุดของ
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f
// 200a09 140505 1a0505) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#6d0b3f]/60 bg-gradient-to-br from-[#2b0f20]/96 to-[#1a0914]/96 p-8 text-left text-base leading-relaxed text-[#fdeaf5] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fa63b9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffb3de] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ffd84d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6d0b3f] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fa63b9] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#ffb3de] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
