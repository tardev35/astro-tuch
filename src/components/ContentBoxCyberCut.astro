---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H1 §1** มาให้ใบนี้ (content.txt บรรทัด 4) พร้อมย่อหน้าเดียว
// ของมัน กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบ
// บทความของแบรนด์ปัจจุบัน (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager
// import = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง
// slide* ไว้กับ ContentBoxSevenThree* เท่านั้น
//
// นินจา168 (รอบ **ฟ้าไซยานนำ · เหลืองมะนาวเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-ninja168.md §2
// งานศิลป์: โลโก้เป็นนินจาการ์ตูนชุดดำ ผูกผ้าคาดหัวฟ้า-ขาวมีดาวน้ำเงิน ขยิบตา ถือ
// ดาวกระจาย (ชูริเคน) สีฟ้า มีผ้าพันคอฟ้าปลิว ล้อมด้วยประกายดาวทองและชูริเคนฟ้า
// ข้างๆ เป็นตัวอักษรไทยสามมิติ **สีเหลืองทอง** ต่อด้วยเลข **ฟ้าบับเบิลผิวมันวาว**
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0c2a3d ยก / #071a28 กลาง /
// #030e16 จม / #000000 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ฟ้า vs เหลือง"
// คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — ฟ้าแบรนด์ #32bcfb คู่ฟ้าน้ำแข็ง #a9e9ff
// อยู่บนแนวนอน ส่วนเหลืองมะนาว #fef54b คู่น้ำเงินลึก #07335f อยู่บนแนวตั้ง ตรงกับ
// งานศิลป์ที่ฉากเป็นฟ้าทั้งฉากและเหลืองทองเป็นแค่ตัวอักษรกับประกายดาว
// ⚠️ ใบนี้เป็นใบเดียวบนหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ใช่ไล่เฉด** — ฟ้าน้ำแข็ง
// #a9e9ff (11.3:1 บนผิวการ์ด) บนสันซ้ายฟ้าแบรนด์ ขณะที่ใบอื่นเป็นไล่เฉดสามสีคนละ
// ลำดับ หรือเป็นหมึกเข้มบนแผ่นถมสว่าง (§2)
// เนื้อความ #dceefc (= BRAND_TEXT) — 13:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #07335f (1.4:1) และ #6b5c10 (1.9:1) ถือตัวอักษร — ที่นี่อยู่ที่ขอบและ
// เส้นรูดเท่านั้น
//
// ⚠️ **กับดักรอบนี้: ฟ้า และ ทอง/เหลือง ซ้ำตระกูลกับรอบก่อน** รอบที่แล้ว
// (สบายเบท168) ก็ฟ้านำ+ทองรองบนดำเหมือนกัน การเจอ "ฟ้า" หรือ "ทอง" ในไฟล์นี้จึงไม่
// พิสูจน์อะไร ต้องเทียบเป็น "ค่า" ทีละตัว: ฟ้ารอบนี้คือ **#32bcfb** (R=50 G=188
// B=251) ไซยานสว่างกว่า 2f9ff5 ของสบายเบท168 · ฮิวที่สองรอบนี้เป็น **เหลืองมะนาว
// #fef54b** ไม่ใช่ทองอำพัน ffc82e · ชุดความลึกเป็น **ฟ้าหมึก** #0c2a3d / #071a28 /
// #030e16 ไม่ใช่ 0e2238 / 081726 / 040d16
// ชุดเต็มของสบายเบท168 ที่เพิ่งอยู่ในไฟล์นี้ผ่านมา (2f9ff5 a8dcff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168
// (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06
// 0b0603) และชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c
// cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ออกครบทุกจุดแล้ว รวมถึง 0a84e0 04203f
// e4f1fd ของ HI59 · 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ม่วง เขียว ส้ม แดง โรสโกลด์ และเงิน/โครเมียม**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#07335f]/60 bg-gradient-to-br from-[#0c2a3d]/96 to-[#071a28]/96 p-8 text-left text-base leading-relaxed text-[#dceefc] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#32bcfb] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#a9e9ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fef54b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#07335f] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#32bcfb] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#a9e9ff] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
