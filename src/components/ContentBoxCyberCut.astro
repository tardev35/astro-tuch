---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): เว็บสล็อตเว็บตรงต่างประเทศ โลโก้เป็น
// เวิร์ดมาร์กสองโลหะ ตัวอักษร 1SS เป็นเงินโครเมียม ส่วนเหรียญเลข 1 กับเลข 365 เป็นทอง
// การ์ดจึงเป็นพื้นผิวการ์ดดำอมทอง #121010 ในกรอบทองแบรนด์ #edbb23 มุมตัดเฉียง และ
// เส้นรูดสี่มุมจับคู่สองโลหะของโลโก้ไขว้กัน — ทองแบรนด์คู่ทองอ่อน #ffeeb4 บนแนวหนึ่ง
// และเงิน #c8cbce คู่ทองลึก #a87708 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออก
// บนพื้นดำ หัวข้อเป็นไล่ทองล้วน ทองอ่อน → ทองสว่าง #f7d458 → ทองลึก (4.8:1 บนผิวนี้)
// ต่างจากหัวข้อทองอ่อน → ทองแบรนด์ → เงิน ของ ContentBox ตัวกลาง และต่างจากหัวข้อ
// ทองตันของ SevenThreeCyberCut เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#101010 #edb543 #fde8a8 #e6e6e6
// #a9761f #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#edbb23]/55 bg-[#121010]/94 p-8 text-left text-base leading-relaxed text-[#f0e6d2] shadow-[0_10px_30px_rgba(5,5,5,0.85)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#edbb23] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffeeb4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#c8cbce] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#a87708] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#edbb23] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffeeb4] via-[#f7d458] to-[#a87708] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
