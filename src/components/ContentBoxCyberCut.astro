---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): เว็บแทงหวย พาเลตต์ตาม
// brand-spec §2 การ์ดมุมตัดเป็นผิวการ์ด #170707 ในกรอบแดงแบรนด์ #d20a0a ซึ่งมาจาก
// vivid ของ logo.webp หน้านี้มีการ์ดมุมตัดสามใบ จึงแยกด้วยผิวพื้นคนละระดับ ไม่ใช่
// แค่คนละสีหัวข้อ — ใบนี้ #170707 · SevenThreeCyberCut เป็น #0a0303 ที่ลึกที่สุด ·
// TwoCyberCut เป็น #230d0d ที่ยกสูงที่สุด เส้นรูดสี่มุมจับคู่แดง-ทองของโลโก้
// (วงกลม 24 สีแดง) กับแบนเนอร์ (ตัวอักษรทองบนผ้าไหมแดง) ไขว้กัน — แดงแบรนด์คู่
// แดงสว่าง #ff3b3b บนแนวหนึ่ง ทองแบรนด์ #f5c33b คู่ทองลึก #a9761a บนอีกแนวหนึ่ง
// หัวข้อไล่ทองสว่าง #ffd45e → แดงแบรนด์ → ทองลึก คือทอง-แดง-ทอง ซึ่งเป็นลำดับ
// เดียวบนหน้านี้ที่พาสีแบรนด์ไว้ตรงกลางแทนที่จะอยู่ปลาย เนื้อความ #f7e2d6
// (= BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#130b03 #ebbb54 #fce675
// #ab6d24 #d5d4d3 #f3f3f2 #f8eed9) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#d20a0a]/55 bg-[#170707]/94 p-8 text-left text-base leading-relaxed text-[#f7e2d6] shadow-[0_10px_30px_rgba(5,1,1,0.85)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#d20a0a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ff3b3b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#f5c33b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#a9761a] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f5c33b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffd45e] via-[#d20a0a] to-[#a9761a] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
