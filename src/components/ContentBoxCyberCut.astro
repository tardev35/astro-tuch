---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// This round the page hands this box docx H3 §5 ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด") plus its single paragraph, so the house rule of exactly ONE element
// per slot holds.
//
// รับตัง168 (รอบทองไทยนำ แดงมังกรรอง บนดำอมแดง 2026-10-18, brand-spec §2):
// โลโก้อ่านตรงๆ ได้ว่า คำว่า "รับตัง" เป็นตัวอักษรสามมิติผิวโครเมียมอมฟ้าเงินขอบแดง
// ต่อด้วยเลข "168" **สีแดงสด** สามมิติ ทั้งหมดวางอยู่บน **กองเหรียญจีนทองรูสี่เหลี่ยม**
// กับริบบิ้นซาตินแดง แบรนด์จึงเป็นสองโทนจริง **ทองนำ แดงรอง** ไม่ใช่สีเดียวไล่ความสว่าง
// ⚠️ ลำดับนำกลับทางจากรอบก่อน (สมหวัง168 แดงนำ ทองรอง) — กองเหรียญทองเป็นบริเวณ
// อิ่มสีที่กว้างที่สุดในภาพอย่างชัดเจน
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง #1a0505** (bg.json) ลำดับความลึก: #2b100f ยก /
// #200a09 กลาง / #140505 จม / #1a0505 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง ซึ่งอยู่
// เหนือผิวจมของ §2 ที่เป็นการ์ดมุมตัดอีกใบของหน้านี้
// มุมตัดเฉียง **40px** กับเส้นรูดสี่มุมที่ไขว้ "ทอง vs แดง" คือจุดต่างของใบนี้จากกล่อง
// docx ใบอื่น: ทองแบรนด์ #f0b429 คู่ทองสว่าง #ffdc8c บนแนวนอน และแดงแบรนด์ #d30304
// คู่แดงสว่าง #ff6b6e บนแนวตั้ง ตรงกับโลโก้ที่กองเหรียญทองรองรับตัวเลขแดง
// §2 ของ §5 เป็นใบเดียวบนหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ใช่ไล่เฉด** — ทองสว่าง
// #ffdc8c (12:1 บนผิวยก) บนสันซ้ายทองแบรนด์ ขณะที่อีกหกกล่องเป็นไล่เฉดสามสีคนละลำดับ
// และ §1 เป็นหมึกเข้มบนแผ่นทองทึบ
// เนื้อความ #f5ece0 (= BRAND_TEXT) — 13.0:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #d30304 #a00203 #4a0202 #9a6c0c ถือตัวอักษร — ที่นี่อยู่ที่ขอบและเส้นรูด
// เท่านั้น
//
// ⚠️ **กับดักรอบนี้คือ "แดง" และหนักกว่าทุกรอบ เพราะสามแบรนด์ก่อนหน้าเป็นแดงทั้งหมด**
// การเจอสีแดงในไฟล์ไม่ได้แปลว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละตัว: แดงของ
// สมหวัง168 คือ #fa0513 (R=250 G=5 B=19) · TKB55 #fb131b (G=19) · GT66B #fb141b
// (G=20) · SUPERSLOTCLUB #e8232a (R=232) · PIGPG #d4200d (R=212 G=32 B=13 — ต่าง
// จากรอบนี้แค่สองหลัก) · FLASH877 #ff3b14 (G=59) แดงรอบนี้คือ **#d30304** (R=211
// G=3 B=4) อ่านจาก logo.webp ของดรอปนี้ตรงๆ ผ่าน palette.json ห้ามกะด้วยตา
// ⚠️ ทองรอบนี้คือ **#f0b429** ไม่ใช่ #e3b23c (สมหวัง168) #dfa310 (TND168) #e5a81b
// (UFA324) #e2b33f (KMD88) #fad354 (789BETTING) #f2b705 หรือ #ffd666
// ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#fb131b #ff4d55
// #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a) ชุด
// ม่วงราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff #d9b8ff #3a0565 #2c0349 #7a5a0a
// #e2b33f #ffdf8c #ffd45e #ece2f8 #1a0526 #1d0832 #140522 #0a0213) ชุดน้ำเงินไฟฟ้า
// ของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e
// #0a1c42 #040e26 #00081f #032dad #04186e #041a43 #021026) ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffc554 #f0c3dc #fde7f2 #8a0a45 #4a1038
// #2a0012 #1c0014) ชุดทองแชมเปี้ยนของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #f2f5f9 #8792a0) และชุดทองมังกร
// ของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02)
// ออกครบทุกจุดแล้ว
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม** มีแค่
// ทองกับแดงบนดำอมแดง และไม่มีโครเมียม/เงินเป็นสีระบบ (#cfd9e6 เป็นสีตัวอักษรรอง
// อย่างเดียว ไฟล์นี้ไม่ได้ใช้)
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#d30304]/45 bg-gradient-to-br from-[#2b100f]/96 to-[#200a09]/96 p-8 text-left text-base leading-relaxed text-[#f5ece0] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f0b429] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffdc8c] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#d30304] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ff6b6e] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f0b429] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#ffdc8c] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
