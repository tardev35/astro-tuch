---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): เว็บแทงหวยออนไลน์ โลโก้เป็นเวิร์ดมาร์ก
// สามมิติสองโทน คำว่า "หวย" เป็นแดงเลือดนกขอบทอง ส่วน "เฮง789" เป็นทองไล่เฉด และ
// งานอาร์ตเป็นฉากผ้าซาตินแดงเข้มที่มีเงาปราสาททอง ริ้วแสงทอง เหรียญทอง กับลูกหวย
// แดง-ขาว ผิวการ์ดจึงเป็นพื้นส่วน #1c0606 ในกรอบแดงแบรนด์ #dc2224 มุมตัดเฉียง เส้น
// รูดสี่มุมจับคู่สองโทนของโลโก้ไขว้กัน — แดงแบรนด์ คู่ทองรอง #f4bc5d บนแนวหนึ่ง และ
// ทองอ่อน #ffefc2 คู่แดงสว่าง #e43434 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่าน
// ออกบนการ์ดแดงเข้ม หัวข้อไล่ขาวอมชมพู #fbe3d4 → ทองรอง → แดงสว่าง (4.5:1 บนผิวนี้)
// ต่างจากหัวข้อทอง→แดงของ ContentBox ตัวกลาง และหัวข้อทองล้วนของ
// ContentBoxTwoNeumorphism เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#062a12 #e5c04f #0bb42f #eafbe9
// #a9cfae #fae474 #d8ead9) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#dc2224]/55 bg-[#1c0606]/94 p-8 text-left text-base leading-relaxed text-[#fbe3d4] shadow-[0_10px_30px_rgba(220,34,36,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#dc2224] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#f4bc5d] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ffefc2] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#e43434] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#dc2224] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fbe3d4] via-[#f4bc5d] to-[#e43434] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
