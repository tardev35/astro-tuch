---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries a page's H1 in the PKG44
// mix, and a level is never hardcoded in the markup below; `as` decides it. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): ผิวการ์ด #12100a ในกรอบทองแบรนด์
// #fdd32a มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สองโลหะของโลโก้ไขว้กัน — ขาวโครเมียม
// #f2f4f7 คู่กับเงินโครเมียม #c2c8d0 บนแนวหนึ่ง และทองสว่าง #ffe27a คู่กับทองลึก
// #4a3a12 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ หัวข้อไล่
// ตามลำดับโลหะบนโลโก้ คือทองสว่าง → ขาวโครเมียม → ทองลึก เนื้อความ #efe6d2
// (BRAND_TEXT) — โทนทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b #d9a62b #fcfcfc
// #d2d3d4 #8c5f14 #14100a #e8e6e1) หายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fdd32a]/55 bg-[#12100a]/94 p-8 text-left text-base leading-relaxed text-[#efe6d2] shadow-[0_10px_30px_rgba(253,211,42,0.2)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f2f4f7] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#4a3a12] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ffe27a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#c2c8d0] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#c8920a] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
