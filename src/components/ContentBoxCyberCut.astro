---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §3** มาให้ใบนี้ ("โปรโมชั่น <แบรนด์> ฝากรับโบนัสได้
// ทั้งวัน ไม่ต้องทำเทิร์น" — content.txt บรรทัด 7) พร้อมย่อหน้าเดียวของมัน (บรรทัด 8)
// กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ตรง ๆ
// ⚠️ ดรอปนี้ **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบันเลย** (banner2.png /
// banner3.png เป็นของแบรนด์ก่อน และ eager import = emit ขึ้น dist ทุก build) จึงไม่มี
// รูปในการ์ดใบนี้ และ **ห้ามเอา slide มาแทน** — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา 2 ใบของรอบนี้ถูกใช้ไปที่ §4 กับ §5 ครบแล้ว
//
// ⚠️⚠️ **มุมตัดคงไว้ แต่ภาษาไซเบอร์ถอดออกหมด** — รูปทรงมุมเฉียงอ่านเป็น
// **ตั๋ว/ดวงตราประทับ** ซึ่งเข้ากับหัวข้อโปรโมชั่นพอดี ส่วนภาษาภาพแบบนีออน-สแกนไลน์
// (มอนอสเปซ · `SYSTEM_` · สแลชสามตัว · เส้นสแกน) **ไม่มีในไฟล์นี้แล้วสักจุด** —
// brand-spec §6 ห้ามไว้ตรง ๆ และรอบนี้เป็น **บับเบิล/แคนดี้ฟ้าสกาย**
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// **ฟ้าสกายบับเบิลนำ · ขาว/ฟ้าพาสเทลเป็นวัสดุที่สอง · บนธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้กลับทิศเป็นธีมสว่าง** พื้นเพจ #00bfff (bg.json) =
// ฟ้าสกายอิ่มตัว **ห้ามแก้กลับไปเป็นผิวมืด** — การ์ดมืดกับหมึก #06283f จะทำให้
// ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง **และห้ามเหลือแดง/มุก/ดำอมแดงไว้เลยสักค่า**
// ลำดับผิว: #ffffff การ์ด · #f0faff ยก · #e4f6fb wash · #00bfff พื้นเพจ —
// การ์ดใบนี้ไล่จาก **การ์ดขาวลง wash** (#ffffff → #e4f6fb)
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ฟ้าสกาย vs
// ฟ้าพาสเทล" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — **แนวนอนเป็นฟ้าสกาย**
// (#12b4ef และ #4fb8ea) ส่วน **แนวตั้งเป็นพาสเทล** (#b6e3f0 และ #7fcbe8) ซึ่งเป็น
// ที่เดียวบนหน้าที่สองวัสดุของรอบนี้ (ตัวอักษรบับเบิลฟ้าสกายกับไฮไลต์/ขอบตัดสีขาว
// บนโลโก้ และแคปซูลพื้นขาวขอบฟ้าใต้แบนเนอร์) ถูกวางไขว้กันตรง ๆ
// ⚠️ อีกใบที่เป็นมุมตัดบนหน้าเดียวกัน: **§5 ContentBoxSevenThreeCyberCut** ตัด
// **36px** บนผิวยกทึบ #f0faff พร้อมเส้นรูด **ฟ้าล้วนสามเฉด** — สองใบจึงไม่อ่าน
// ซ้ำกันแม้จะอยู่ตระกูลเดียวกัน
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **สันซ้ายหนาสี่พิกเซล** — สัน #12b4ef
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ) กับหัวข้อ **ฟ้าลึก #0f5684 ทึบสีเดียว
// ไม่ไล่เฉด ไม่มีแผ่นถม ไม่มีเรืองแสง** (7.8:1 บนผิวการ์ดขาว · 7.1:1 บนปลาย wash)
// เนื้อความ #06283f (= BRAND_TEXT) — 15.2:1 บนผิวการ์ด และ 14.0:1 บน wash
//
// ⚠️⚠️ §2 ห้าม **#12b4ef / #00bfff / #b6e3f0 / #7fcbe8 / #4fb8ea** ถือตัวอักษรบน
// ผิวสว่างทุกกรณี — ในไฟล์นี้อยู่ที่สันซ้าย เส้นรูด และขอบ ซึ่งเป็นพื้นถมล้วน ·
// **#0f5684 ใช้ทั้งหัวข้อที่นี่และ <strong> ในเนื้อความ** ซึ่งเป็นงานของหน้าเพจ ·
// ⚠️ **ห้ามวางหมึกขาวบน #12b4ef หรือ #00bfff ตรง ๆ (2.4:1 / 2.1:1)** ถ้าต้องขาว
// ให้ใช้ #1a6ea8 ลงไป และถ้าต้องถมด้วย #12b4ef ให้ใช้หมึก #06283f (6.4:1)
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️ 🚨 **ฟ้าเป็นฮิวนำรอบนี้ และรีโปนี้มีฟ้าของแบรนด์อื่นอยู่แปดชุด** การเจอ
// ฟ้าในไฟล์จึงไม่พิสูจน์อะไร ต้อง grep เป็น "ค่า" ทีละตัว — ฟ้ารอบนี้คือ
// **#12b4ef (R18 G180 B239) / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 /
// #1a6ea8 / #06283f** เท่านั้น ไม่ใช่
//   fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
//   1c0607 2a0c0d 551c1e (**สล็อต168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 (**หมูบิน168 — แบรนด์ขาออก เสี่ยงหลงเหลือ
//   สูงสุด**) ·
//   1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6
//   (มาดาม168) · 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722
//   33455f 0d1017 (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff f4e4d3
//   e4cbb3 (ร่ำรวย168 — ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13 เจอแล้ว
//   แปลว่าพิมพ์ผิด**) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168 — ⚠️ **063a57 มี
//   R=06 ตรงกับ #06283f เป๊ะ**) · 32bcfb a9e9ff 07335f (นินจา168 — ⚠️ **07335f
//   ใกล้ #06283f ที่ R**) · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 2f9ff5 a8dcff
//   d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff cfdcec 9db4d4
//   (TSDET911) · และไม่ใช่ 0ea5e9 1279be 1155cc ซึ่งเป็นสีจริงของโลโก้ธนาคาร
//   ในไฟล์อื่น
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **พักยก168** (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 1f0f04) ·
// **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f) · **ยูฟ้า168**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f) · **ufalion168** (d4922c
// fdfc71 a25b24 8c4312 f6e3b4) · **UFA324** (e5a81b ffe08a bb8410 8792a0 b9c2cc) ·
// **CEO66** (020617 7e22ce d946ef f5d0fe a855f7) · **สาธุ168** (0b7d28 0a5f1c
// 0f9b35 c9cb63) และ 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน** — วัสดุที่สอง
// รอบนี้คือ **ขาวกับฟ้าพาสเทล #ffffff / #e4f6fb / #b6e3f0 (B>G>R)** ส่วนเสื้อคลุม
// ถักฟ้าอ่อน ฉากสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงเป็น **วัตถุในภาพ**
// ไม่ใช่สี UI
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#7fcbe8] bg-gradient-to-br from-white to-[#e4f6fb] p-8 text-left text-base leading-relaxed text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.14)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#12b4ef] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#4fb8ea] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#b6e3f0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#7fcbe8] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#12b4ef] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#0f5684]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
