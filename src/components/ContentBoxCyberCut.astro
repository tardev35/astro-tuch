---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// FAH999: พื้นการ์ดดำอมน้ำตาล #12100b ในกรอบทองบรอนซ์ #a3732c มุมตัดเฉียง และ
// เส้นรูดสี่เส้นที่มุมไล่จากทองประกาย #f7e7a8 → ทองหลัก #e8c25a → ทองกลาง
// #c49a41 → บรอนซ์เข้ม #6b4a18 แบรนด์นี้มีสีเดียว จึงแยกชั้นด้วยความสว่าง
// ไม่ใช่ด้วยสีที่สอง ทองของแบรนด์ก่อนหน้าหายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#a3732c]/70 bg-[#12100b]/94 p-8 text-left text-base leading-relaxed text-[#e7dcc4] shadow-[0_10px_30px_rgba(232,194,90,0.18)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f7e7a8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#e8c25a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#c49a41] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6b4a18] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#e8c25a] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f7e7a8] via-[#c49a41] to-[#a3732c] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
