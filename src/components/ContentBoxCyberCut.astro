---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2, but this file carries BOTH the page's H1 (docx #1)
// and one H2 (docx #9) this round — which is why no level is hardcoded in the
// markup below; `as` decides it every time. The header has no
// `whitespace-nowrap`: a full docx sentence has to wrap.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): เว็บหวยออนไลน์ สีประจำแบรนด์ย้ายจาก
// ทองมาเป็นแดง — โลโก้เป็นตัวอักษรขาวบนบล็อกแดง #dc020e กับแบนเนอร์พื้นดำที่มี
// ริ้วแสงแดงลึก ลูกหวยแดง-ขาว เหรียญทองและมงกุฎทอง ผิวการ์ดจึงเป็นแผงแดงเข้ม
// #2a0d0f ในกรอบแดงแบรนด์ #dc020e มุมตัดเฉียง เส้นรูดสี่มุมจับคู่สองสีของงาน
// อาร์ตไขว้กัน — แดงสว่าง #ff2d38 คู่แดงลึก #6b0207 บนแนวหนึ่ง และทองอ่อน
// #fde79a คู่ทองลึก #8a6a0a บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออก
// บนการ์ดเกือบดำ หัวข้อไล่ทองอ่อน → แดงสว่าง → ทองลึก เนื้อความ #f0e2e2
// (BRAND_TEXT) — ชุดแดง-ทองของ LOTTO24 ที่ค้างในไฟล์นี้ (#dc2626 #fc2b2c
// #b40102 #fde68a #a16207 #2a0405 #f6e2e2) ออกทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#dc020e]/55 bg-[#2a0d0f]/94 p-8 text-left text-base leading-relaxed text-[#f0e2e2] shadow-[0_10px_30px_rgba(220,2,14,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ff2d38] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#8a6a0a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fde79a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6b0207] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#dc020e] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fde79a] via-[#ff2d38] to-[#8a6a0a] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
