---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §7** มาให้ใบนี้ ("ช่องทางติดต่อแอดมินเว็บ <แบรนด์>
// ตลอด 24ชม." — content.txt บรรทัด 15) พร้อมย่อหน้าเดียวของมัน (บรรทัด 16)
// กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ตรง ๆ
// ⚠️ ดรอปนี้ **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบันเลย** (banner2.png /
// banner3.png เป็นของรอบก่อน และ eager import = emit ขึ้น dist ทุก build) จึงไม่มี
// รูปในการ์ดใบนี้ และ **ห้ามเอา slide มาแทน** — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา 2 ใบของรอบนี้ถูกใช้ไปที่ §4 กับ §5 ครบแล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-slot168.md §2
// **แดงเจลมันวาวนำ · ขาว/มุกอุ่น (R>G>B) เป็นวัสดุที่สอง · บนดำอมแดงเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-อะซัวร์บนน้ำเงินเที่ยงคืนของ
// มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมมืด แต่คนละฮิว** พื้นเพจ
// #140000 (bg.json) = ดำอมแดงเข้มมาก **ห้ามแก้กลับไปเป็นผิวสว่าง** — การ์ดสว่าง
// กับหมึก #f0e6e4 จะทำให้ตัวอักษรหายไปเลย **และห้ามเหลือฟ้า/อะซัวร์/น้ำเงินไว้
// เลยสักค่า**
// ลำดับผิว: #2a0c0d ยก · #1c0607 การ์ด · #0b0000 จม · #140000 พื้นเพจ —
// การ์ดใบนี้ไล่จาก **การ์ดลงจม** (#1c0607 → #0b0000)
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "แดง vs มุก"
// คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — **แนวนอนเป็นแดง** (#fb2e33 และ #cb0b0d)
// ส่วน **แนวตั้งเป็นมุก** (#e3d6d4 และ #7d6f6e) ซึ่งเป็นที่เดียวบนหน้าที่สองวัสดุ
// ของรอบนี้ (ตัวอักษรเจลแดงมันวาวกับไฮไลต์ขาวสเปกคูลาร์บนโลโก้ และแคปซูลขาว
// "ทางเข้าแท้" ใต้แบนเนอร์) ถูกวางไขว้กันตรง ๆ
// ⚠️ อีกสองใบที่เป็นมุมตัดบนหน้าเดียวกัน: **§3 ContentBox3ThreeCyberCut** ตัด
// **30px ที่มุมขวาบน-ซ้ายล่าง** (กลับทิศจากใบนี้) และ **§5
// ContentBoxSevenThreeCyberCut** ตัด **36px** บนผิวจมทึบพร้อมเส้นรูด **แดงล้วน**
// — สามใบจึงไม่อ่านซ้ำกันแม้จะอยู่ตระกูล CyberCut เหมือนกัน
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **สันซ้ายหนาสี่พิกเซล** — สัน #fb2e33
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ) กับหัวข้อ **แดงเจล #fb2e33 ทึบสีเดียว
// ไม่ไล่เฉด ไม่มีแผ่นถม ไม่มีเรืองแสง** (5.1:1 บนผิวการ์ด · 5.5:1 บนผิวจม)
// เนื้อความ #f0e6e4 (= BRAND_TEXT) — 16.0:1 บนผิวการ์ด และ 16.9:1 บนผิวจม
//
// ⚠️⚠️ §2 ห้าม **#cb0b0d / #8a0608 / #551c1e / #7d6f6e** ถือตัวอักษรทุกกรณี —
// ในไฟล์นี้อยู่ที่สันซ้าย เส้นรูด และขอบ ซึ่งเป็นพื้นถมล้วน ·
// **#fb2e33 สงวนไว้ให้ <strong> ในเนื้อความด้วย** ซึ่งเป็นงานของหน้าเพจ ไม่ใช่
// ของไฟล์นี้ · ⚠️ **ห้ามวางหมึกขาวบน #fb2e33 ตรง ๆ (3.8:1)** ถ้าต้องขาวให้ใช้
// #d81115 ขึ้นไป และถ้าต้องถมด้วย #fb2e33 ให้ใช้หมึกดำ #0a0a0a (5.2:1)
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(227,214,212,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
//
// ⚠️ 🚨 **แดงเป็นฮิวนำรอบนี้ และรีโปนี้มีแดงของแบรนด์อื่นอยู่สิบกว่าชุด** การเจอ
// แดงในไฟล์จึงไม่พิสูจน์อะไร ต้อง grep เป็น "ค่า" ทีละตัว — แดงรอบนี้คือ
// **#fb2e33 (R251 G46 B51) / #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น ไม่ใช่
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (**มาดาม168 — ชุดที่เพิ่งอยู่ทั้งใบนี้** ⚠️ ff2e52 แดง
//   เหมือนกันแต่ B82 เทียบกับ B51 ของรอบนี้) ·
//   ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16 3d3425
//   f3ece0 bfb8aa (**รวย168 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด** ⚠️ 1c1a16 ห่างจาก
//   ผิวการ์ดรอบนี้ 1c0607 แค่ G/B) ·
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722 33455f 0d1017
//   (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff f4e4d3 e4cbb3 (ร่ำรวย168) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B — ⚠️ fb141b และ 8a0609 ห่างจากค่าของ
//   รอบนี้หนึ่งก้าว **เจอแล้วแปลว่าพิมพ์ผิด**) · b3121b 5a0a0e f2bba5 c98a74
//   (ขวัญใจ168) · c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef ffeee8 (รวยแท้168) ·
//   eb0305 e40303 c20305 9b0a0c ff4446 401107 (โปรดี168) · fa0513 ff5a5f ffadaf
//   (สมหวัง168) · d9212a 8e1a16 2a0608 (ดวงเศรษฐี168 — ⚠️ 2a0608 ห่างจากผิวยกรอบนี้
//   2a0c0d แค่ G/B) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) · d30304
//   a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) · dd1b74 a4186b 4a0d35 2d0720
//   (มีทรัพย์168) · fa63b9 ffb3de (ถอนชัวร์168) · f5469f ff8dc6 8c0f52 (มีโชค168) ·
//   ff3b14 6d0804 2b0000 (FLASH877) · และไม่ใช่ 0ea5e9 1279be 1155cc ซึ่งเป็นสีจริง
//   ของโลโก้ธนาคารในไฟล์อื่น
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **พักยก168** (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 1f0f04) ·
// **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906) ·
// **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 eae3d4) ·
// **ufalion168** (d4922c fdfc71 a25b24 8c4312 f6e3b4 33200a 1f1304 0a0601 1a1000) ·
// **UFA324** (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a) · **CEO66**
// (020617 7e22ce d946ef f5d0fe a855f7) · **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a) และ 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น** —
// วัสดุที่สองรอบนี้คือ **มุกอุ่น #e3d6d4 / #c9b9b7 / #7d6f6e (R>G>B)** ส่วนเสื้อ
// กล้ามขาว พื้นสตูดิโอขาว สีผิวนักแสดง และมงกุฎทองเล็กบนโลโก้เป็น **วัตถุในภาพ**
// ไม่ใช่สี UI
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#551c1e] bg-gradient-to-br from-[#1c0607] to-[#0b0000] p-8 text-left text-base leading-relaxed text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.6)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fb2e33] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#cb0b0d] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e3d6d4] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#7d6f6e] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fb2e33] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#fb2e33]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
