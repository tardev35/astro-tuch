---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box a single <p> in its default slot — docx
// section 1's one paragraph, i.e. the page's H1 block — so the house rule of
// exactly ONE element per slot
// holds. The LINE / สมัครสมาชิก button row lives in ContentBoxSpecial's
// `actions` slot further down the page, not here.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): รอบนี้เป็นแบรนด์
// "ฮิวเดียว" — ทองเมทัลลิกบนดำสนิท ไม่มีสีที่สอง ต่างจากชุดตรุษจีนสามสีของ GUCCI168
// (แดง-เขียวมรกต-ทอง) เพราะโลโก้เป็นเลข 789 ทองขัดเงาสามมิติทับคำว่า BETTING สีดำบน
// แถบขีดขาว แบนเนอร์กับสไลด์เป็นโถงคาสิโนดำ-ทอง และ bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#000000"} = ดำตัน
// หน้านี้มีการ์ดมุมตัดสามใบ จึงแยกด้วย "ระดับความลึกของผิว" ไม่ใช่แค่คนละสีหัวข้อ —
// ใบนี้เป็นผิวยกที่สว่างที่สุด #17130a · TwoCyberCut เป็นผิวกลาง #0e0b05 ·
// SevenThreeCyberCut เป็นผิวลึกสุด #060402
// เส้นรูดสี่มุมไล่จากสว่างไปเข้มไขว้กัน — ทองแบรนด์ #fad354 คู่ทองแชมเปญ #ffe79a บน
// แนวหนึ่ง บรอนซ์ #c9881f คู่ทองลึก #8a6410 บนอีกแนวหนึ่ง หัวข้อไล่ทองแบรนด์ #fad354 →
// ทองแชมเปญ #ffe79a → ทองกลาง #ddab33 ซึ่งเป็นลำดับเดียวบนหน้านี้ที่เริ่มด้วยทองแบรนด์
// ทองลึก #8a6410 กับเส้นไรผม #4a3407 อ่านไม่ออกบนผิวการ์ด จึงถูกใช้เป็นขอบและเส้นคั่น
// เท่านั้น ไม่เคยเป็นสีตัวอักษร เนื้อความงาช้างอมทอง #f3e7cd (= BRAND_TEXT) —
// 15.0:1 บนผิวใบนี้
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #d8dbe0
// #6d4412 #191108 #ece1cc) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fad354]/40 bg-[#17130a]/96 p-8 text-left text-base leading-relaxed text-[#f3e7cd] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fad354] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffe79a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#c9881f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#8a6410] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fad354] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fad354] via-[#ffe79a] to-[#ddab33] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
