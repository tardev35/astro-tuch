---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// JOKERSLOTZ palette: near-black maroon surface (#1c0202) inside a crimson
// hairline frame, with the clipped corners split across the logo's two halves —
// antique-gold rules (#f2dc9a / #bc9b5b) on one diagonal, crimson (#c81e1e /
// #6d0d0d) on the other — so the cut corners read as the jester's gold hat
// crossing the red wordmark rather than one flat hue.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#a51515]/60 bg-[#1c0202]/92 p-8 text-left text-base leading-relaxed text-[#ecdfd0] shadow-[0_10px_30px_rgba(165,21,21,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f2dc9a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#bc9b5b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#c81e1e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6d0d0d] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#a51515] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c81e1e] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
