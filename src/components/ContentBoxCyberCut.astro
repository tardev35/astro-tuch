---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries a page's H1 in the
// UFAGOOL mix, and a level is never hardcoded in the markup below; `as` decides
// it. The header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): พื้นการ์ดเกือบดำ #0a0708 ในกรอบเงิน
// โครเมียม #b8c3cf มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สองสีของแบรนด์ไขว้กัน —
// ขาวเงิน #f4f7fa คู่กับแดงสด #ef1f25 บนแนวหนึ่ง และเงินหลัก #b8c3cf คู่กับแดง
// แบรนด์ #c50d12 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ
// หัวข้อไล่จากขาวเงินไปหาแดงสด สลับทิศกับ ContentBox ตัวหลักที่ไล่จากแดงไปหาเงิน
// โทนชมพูมาเจนตา-ทองของ WY88 หายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#b8c3cf]/55 bg-[#0a0708]/94 p-8 text-left text-base leading-relaxed text-[#cdd5dd] shadow-[0_10px_30px_rgba(197,13,18,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f4f7fa] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#c50d12] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ef1f25] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#b8c3cf] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#c50d12] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f4f7fa] via-[#b8c3cf] to-[#ef1f25] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
