---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries a page's H1 in the
// 888PARUAY mix, and a level is never hardcoded in the markup below; `as`
// decides it. The header has no `whitespace-nowrap`: a full docx sentence has
// to wrap.
//
// 888PARUAY (รอบทอง-เขียว-แดง 2026-09-24): พื้นการ์ดเขียวเข้มเกือบดำ #0d2312 ใน
// กรอบทองแบรนด์ #fcdc2b มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สามสีของโลโก้ไขว้กัน
// — ทองอ่อน #fff6ae คู่กับเขียวสด #1fae1c บนแนวหนึ่ง และทองหลัก #fcdc2b คู่กับ
// แดง #cf1111 บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ
// หัวข้อไล่จากทองอ่อนไปหาเขียวสด สลับทิศกับ ContentBox ตัวหลักที่ไล่ไปหาแดง
// โทนแดง-เงินโครเมียมของ UFAGOOL หายไปทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fcdc2b]/55 bg-[#0d2312]/94 p-8 text-left text-base leading-relaxed text-[#e8e4c6] shadow-[0_10px_30px_rgba(252,220,43,0.2)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fff6ae] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#cf1111] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#1fae1c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#fcdc2b] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fcdc2b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#1fae1c] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
