---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13, brand-spec §2): โลโก้อ่านตรงๆ ได้ว่า
// คำว่า TKB เป็นตัวอักษรสามมิติ **สีแดงสด** ต่อด้วยเลข 55 **เงินโครเมียมขัดเงา**
// เหนือคำขึ้นไปเป็นมาสคอตโจรการ์ตูนใส่หน้ากากดำแบกถุงเงิน $ แบรนด์จึงเป็นสองโทนจริง
// **แดงนำ เงินโครเมียมรอง** ไม่ใช่แดงเฉดเดียวไล่ความสว่าง
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"}) จึงไม่มี
// ชั้นไหนจมต่ำกว่าพื้นได้ ลำดับความลึก: #2a0d0f ยก / #1a0708 กลาง / #0d0304 จม /
// #000000 พื้น การ์ดใบนี้ไล่จากผิวยกลงผิวกลาง ซึ่งเป็นช่วงที่สว่างที่สุดของหน้า
// เพราะมันถือ H1 อยู่หัวสายบทความ
// มุมตัดเฉียง 40px กับเส้นรูดสี่มุมที่ไขว้ "แดง vs เงินโครเมียม" คือจุดต่างของใบนี้
// จากกล่อง docx ใบอื่น: แดงแบรนด์ #fb131b คู่แดงสว่าง #ff4d55 บนแนวนอน และเงินโครเมียม
// สว่าง #e9eef4 คู่เงินโครเมียมหม่น #aeb9c6 บนแนวตั้ง ตรงกับโลโก้ที่ตัวอักษรแดงวางคู่
// ตัวเลขเงินโครเมียม
// หัวข้อไล่ แดงสว่าง #ff4d55 → เงินโครเมียมสว่าง #e9eef4 → เงินโครเมียมหม่น #aeb9c6
// ซึ่งเป็นใบเดียวบนหน้าที่ **เริ่มด้วยแดงแล้วจบที่เงิน** (ContentBox ของ §3 ไล่กลับทาง)
// เนื้อความขาวอมชมพู #f2e4e5 (= BRAND_TEXT) — 14.5:1 บนผิวยก สูงกว่านั้นบนผิวกลาง
// §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษร — ที่นี่อยู่ที่ขอบและเส้นรูด
// เท่านั้น และ #ff8a8f ถูกสงวนไว้ให้ <strong> ในย่อหน้า จึงไม่โผล่ในไฟล์นี้เลย
//
// ⚠️ **กับดักรอบนี้คือ "แดง"** โค้ดเบสนี้มีแบรนด์แดงมาแล้วหลายเจ้า การเจอสีแดงในไฟล์
// ไม่ได้แปลว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า" ทีละตัว: ชุดม่วงราชา-ทองของ KMD88
// ที่เคยค้างอยู่ทั้งไฟล์นี้ (#7505cc #b453ff #c07cff #d9b8ff #3a0565 #2c0349 #7a5a0a
// #e2b33f #ffdf8c #ffd45e #ece2f8 #1a0526 #1d0832 #140522 #0a0213) ชุดน้ำเงินไฟฟ้า-
// เงินโครเมียมของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7
// #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43 #021026) ชุดชมพูฮอตพิงก์-
// ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffc554 #f0c3dc #fde7f2 #8a0a45 #4a1038
// #2a0012 #1c0014) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e
// #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #f2f5f9 #8792a0) และชุดทอง
// มังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02)
// ออกครบทุกจุดแล้ว
// ⚠️ แดงของแบรนด์เก่าที่ **ห้ามสับสนกับรอบนี้**: SUPERSLOTCLUB #e8232a (R=232 G=35
// B=42) · PIGPG #d4200d (R=212 G=32 B=13) · FLASH877 #ff3b14 (R=255 G=59 B=20)
// แดงรอบนี้คือ #fb131b (R=251 G=19 B=27) อ่านจาก logo.webp ของดรอปนี้ตรงๆ — ห้ามกะ
// ด้วยตา ให้เทียบตัวเลข
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
// มีแค่แดงกับเงินโครเมียมบนดำ
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fb131b]/45 bg-gradient-to-br from-[#2a0d0f]/96 to-[#1a0708]/96 p-8 text-left text-base leading-relaxed text-[#f2e4e5] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fb131b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ff4d55] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e9eef4] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#aeb9c6] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fb131b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ff4d55] via-[#e9eef4] to-[#aeb9c6] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
