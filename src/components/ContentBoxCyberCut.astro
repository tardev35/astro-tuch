---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// The default level is h2 — this variant never carries the page's H1 in the
// LOTTO24 mix, and a level is never hardcoded in the markup below; `as` decides
// it. The header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): ผิวการ์ดแดงเกือบดำ #2a0405 ในกรอบแดงแบรนด์
// #dc2626 มุมตัดเฉียง เส้นรูดสี่เส้นที่มุมจับคู่สองสีของโลโก้ไขว้กัน — แดงสว่าง
// #fc2b2c คู่กับแดงลึก #b40102 บนแนวหนึ่ง และทองอ่อน #fde68a คู่กับทองลึก #a16207
// บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนการ์ดเกือบดำ หัวข้อไล่ทองอ่อน
// → แดงสว่าง → ทองลึก เนื้อความ #f6e2e2 (BRAND_TEXT) — โทนทอง-โครเมียมของ PKG44
// (#fdd32a #ffe27a #4a3a12 #f2f4f7 #c2c8d0 #c8920a #12100a #efe6d2) ออกทั้งหมด
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#dc2626]/55 bg-[#2a0405]/94 p-8 text-left text-base leading-relaxed text-[#f6e2e2] shadow-[0_10px_30px_rgba(220,38,38,0.2)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fc2b2c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#a16207] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fde68a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#b40102] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#b40102] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fde68a] via-[#fc2b2c] to-[#a16207] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
