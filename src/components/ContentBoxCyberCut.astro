---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// ENTER55: พื้นการ์ดดำสนิท #0b0b0a ในกรอบทองเข้ม #8a6d2c มุมตัดเฉียง และเส้นรูด
// สี่เส้นที่มุมเป็นทองไล่จากประกาย #ebd484 ลงไปหาทองบรอนซ์ #5a4e34 ให้อ่านเป็น
// ลายวงจรเส้นทองแบบเดียวกับพื้นหลังแบนเนอร์ ไม่ใช่กรอบทึบสีเดียว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#8a6d2c]/70 bg-[#0b0b0a]/94 p-8 text-left text-base leading-relaxed text-[#ded8cb] shadow-[0_10px_30px_rgba(196,162,85,0.18)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ebd484] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#c4a255] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#d2b262] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#5a4e34] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#c4a255] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#8a6d2c] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
