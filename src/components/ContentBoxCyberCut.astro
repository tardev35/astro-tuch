---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): เว็บสล็อตออนไลน์ โลโก้เป็นเวิร์ดมาร์กสองโทน
// คำว่า NATO เป็นเงินเมทัลลิก ส่วน 168 กับวงกลมตัว N เป็นทอง การ์ดจึงเป็นพื้นผิวการ์ด
// ดำสนิท #101010 ในกรอบทองแบรนด์ #edb543 มุมตัดเฉียง และเส้นรูดสี่มุมจับคู่สองโทนของ
// โลโก้ไขว้กัน — ทองแบรนด์คู่ทองอ่อน #fde8a8 บนแนวหนึ่ง และเงิน #e6e6e6 คู่ทองลึก
// #a9761f บนอีกแนวหนึ่ง ซึ่งเป็นสิ่งที่ทำให้มุมตัดยังอ่านออกบนพื้นดำสนิท หัวข้อไล่
// ทองอ่อน → ทองแบรนด์ (10.2:1 บนผิวนี้) → เงิน ต่างจากหัวข้อทองอ่อน → เงิน → ทองลึก
// ของ ContentBox ตัวกลาง และต่างจากหัวข้อทองตันของ SevenThreeCyberCut เนื้อความ
// #f4ead3 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#dc2224 #f4bc5d #ffefc2 #e43434
// #fbe3d4 #1c0606) ออกครบทุกจุดแล้ว
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#edb543]/55 bg-[#101010]/94 p-8 text-left text-base leading-relaxed text-[#f4ead3] shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#edb543] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fde8a8] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e6e6e6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#a9761f] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#edb543] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#e6e6e6] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
