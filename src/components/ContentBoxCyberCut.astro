---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §2** มาให้ใบนี้ (content.txt บรรทัด 6) พร้อมย่อหน้าเดียว
// ของมัน กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ ดรอปนี้ไม่มีรูปประกอบ
// บทความของแบรนด์ปัจจุบัน (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager
// import = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง
// slide* ไว้กับ ContentBoxSevenThree* เท่านั้น
//
// มีทรัพย์168 (2026-10-21) — พาเลตตาม .claude/brand-spec-meesub168.md §2
// ⚠️⚠️ **ธีมสว่างแบรนด์แรกของรีโปนี้** พื้นเพจ #f0ccf5 (bg.json) การ์ดเนื้อหาจึงเป็น
// **ผิวสว่าง + หมึกเข้ม** กลับทิศจากทุกรอบก่อนหน้า ห้ามแก้กลับเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก · #f7dcf6 กลาง · #f0ccf5 พื้นเพจ — การ์ดใบนี้ไล่จากยกลงกลาง
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "ชมพูบานเย็น vs
// พลัมเข้ม" คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — แนวนอนเป็นชมพูบานเย็น #dd1b74
// คู่โรสเข้ม #a4186b ส่วนแนวตั้งเป็นพลัมเข้ม #4a0d35 คู่ชมพูบานเย็น #dd1b74
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อเป็น **สีทึบสีเดียว ไม่ไล่เฉด และไม่มีแผ่นถม** —
// โรสเข้ม #a4186b (7.2:1 บนผิวขาว) บนสันซ้ายชมพูบานเย็นหนาสี่พิกเซล
// เนื้อความ #4a0d35 (= BRAND_TEXT) — 14.9:1 บนผิวยก และ 12.6:1 บนผิวกลาง
//
// ⚠️ §2 ห้าม #f0ccf5/#f7dcf6 ถือตัวอักษรบนผิวขาว และห้าม #dd1b74 ถือตัวอักษรบน
// พื้นเข้ม — ในไฟล์นี้ #dd1b74 อยู่ที่กรอบ สันซ้าย และเส้นรูดเท่านั้น
// ⚠️ **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168 fa63b9 · มีโชค168 f5469f · มีเฮ168
// ff8f9c) การเจอชมพูในไฟล์ไม่พิสูจน์อะไร ต้อง grep เป็น "ค่า" ทีละตัว — ตัวที่ใกล้
// dd1b74 ที่สุดคือ f5469f (ห่าง 65)
// ชุดของ ดวงเศรษฐี168 รอบขาออก (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605
// 150303 000000) และชุดทองสองเฉด-บรอนซ์ของ ufalion168 ที่เคยอยู่ทั้งใบนี้ (d4922c
// fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3) ออกครบแล้ว
// รวมถึงชุดของรวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06
// fff8ec 2b1400) มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205
// fdeaec 1b0308) รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52
// 071e38 030f1d 031320) นินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28
// 030e16 041019 dceefc) สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238 081726 040d16 04121f) ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a
// 6d0b3f 6b4708 2a0617 fdeaf5) มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// 1a0612 f6e4ee 24101c 160a12 0b0509) ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b
// 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) รับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) สมหวัง168
// (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 170504 f4ecea
// 2c1413 1f0d0c 140706 290f0f) และ UFA324 (e5a81b ffe08a bb8410 7d5a07 43300a 8792a0
// f0e8d4 b9c2cc 464f5a) รวมถึง 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีเขียว
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้ม**
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#dd1b74]/45 bg-gradient-to-br from-white to-[#f7dcf6] p-8 text-left text-base leading-relaxed text-[#4a0d35] shadow-[0_10px_30px_rgba(74,13,53,0.16)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#dd1b74] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#a4186b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#4a0d35] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#dd1b74] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#dd1b74] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#a4186b] uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
