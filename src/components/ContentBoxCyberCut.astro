---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2): แบรนด์นี้เป็นคู่สี
// "เขียวมะนาวสด-ทองมงกุฎ" บนพื้นเขียวป่าเกือบดำ พลิกจากคู่ "ม่วงนีออน-ทองอาร์เขต" ของ
// WEPLAY168 รอบก่อน โลโก้เป็นกอริลลาเขียวสวมมงกุฎทองฝังพลอยเขียวในกรอบใบไม้ป่า
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#0a2400"} = เขียวป่าเกือบดำ
// พื้นเพจจึงมืดกว่าการ์ด การ์ดรอบนี้ต้องยกลอยขึ้นจากพื้น ไม่ใช่จมลง
// หน้านี้มีการ์ดมุมตัดสามใบ จึงแยกด้วย "ระดับความลึกของผิว" ไม่ใช่แค่คนละสีหัวข้อ —
// ใบนี้เป็นผิวยกที่สว่างที่สุด #14380a · TwoCyberCut เป็นผิวกลาง #0f2e05 ·
// SevenThreeCyberCut เป็นผิวลึกสุด #051400
// เส้นรูดสี่มุมจับคู่ "ทอง vs เขียว" ไขว้กัน — ทองมงกุฎ #f2c230 คู่ทองสว่าง #ffe066 บน
// แนวนอน เขียวมะนาว #8ce023 คู่เขียวลึก #1a5c04 บนแนวตั้ง ทำให้กรอบพาทั้งสองฮิวมาไว้ที่
// ตัวกรอบเอง หัวข้อไล่ทองสว่าง #ffe066 → เขียวมะนาว #8ce023 → ทองมงกุฎ #f2c230 ซึ่งเป็น
// ลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// เขียวกลาง #2f8c07 เขียวลึก #1a5c04 และทองลึก #a87a08 ถูกใช้เป็นขอบ/เส้นรูด/เงาเท่านั้น
// ไม่เคยเป็นสีตัวอักษร ตามที่ §2 กำหนด
// เนื้อความเขียวครีมอ่อน #e9f7d6 (= BRAND_TEXT) — 11:1 บนผิวยก
//
// ชุดม่วงนีออน-ทองของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05 #1e0a3c #17062e #110321 #0a0117 #0c0024
// rgba(164,53,240,α) rgba(251,228,85,α)) ชุดแดงแล็กเกอร์-ทองของ PIGPG ก่อนหน้านั้น
// (#d4200d #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402 #3a0d07 #2a0806 #1c0503
// #120302 #fdeedd rgba(245,182,29,α)) และชุดมรกต-ทองของ KOON234 ออกครบทุกจุดแล้ว —
// ทองเป็นกับดัก: #fbe455 #ffd23d #f5b61d #ffd87a #f5c53d #fce604 ล้วนเป็นทองของแบรนด์
// ก่อนๆ ทองของรอบนี้คือ #f2c230 / #ffe066 / #a87a08 เท่านั้น
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#f2c230]/40 bg-[#14380a]/96 p-8 text-left text-base leading-relaxed text-[#e9f7d6] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f2c230] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffe066] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#8ce023] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#1a5c04] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f2c230] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe066] via-[#8ce023] to-[#f2c230] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
