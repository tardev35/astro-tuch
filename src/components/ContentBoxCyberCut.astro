---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2): แบรนด์นี้เป็นคู่สี
// "แดง-ทอง" บนครีมงาช้าง พลิกจากคู่ "มรกต-ทอง" ของ KOON234 รอบก่อน และจากคู่ฟ้าสด-
// เหลืองมะนาวของ แตกดี168 ก่อนนั้น bg.json ของดรอปนี้เป็น
// {"mode":"gradient","css":"linear-gradient(180deg, #6b0000, #7a4100)"} = แดงเลือดหมู
// ไล่ลงน้ำตาลอำพัน พื้นเพจจึงอุ่นและ "สว่างกว่า" การ์ด การ์ดรอบนี้จึงต้องจมลงจากพื้น
// ไม่ใช่ยกขึ้น เพื่อให้ทองบนการ์ดอ่านเป็นโลหะวาวอีกชั้น
// หน้านี้มีการ์ดมุมตัดสามใบ จึงแยกด้วย "ระดับความลึกของผิว" ไม่ใช่แค่คนละสีหัวข้อ —
// ใบนี้เป็นผิวยกที่สว่างที่สุด #3a0d07 · TwoCyberCut เป็นผิวกลาง #2a0806 ·
// SevenThreeCyberCut เป็นผิวลึก #1c0503
// เส้นรูดสี่มุมจับคู่ "ทอง vs แดง" ไขว้กัน — ทองแบรนด์ #f5b61d คู่ครีมงาช้าง #fdf9e4 บน
// แนวนอน แดงสด #d4200d คู่แดงเข้ม #6b0402 บนแนวตั้ง ทำให้กรอบพาทั้งสองฮิวมาไว้ที่ตัว
// กรอบเอง หัวข้อไล่ทองสว่าง #ffd87a → ครีมงาช้าง #fdf9e4 → ทองแบรนด์ #f5b61d คือไล่จาก
// สว่างลงหาโลหะ ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// แดงสด #d4200d ได้แค่ 3.5:1 บนผิวการ์ด จึงถูกใช้เป็นขอบ/เส้นรูด/เงาเท่านั้น ไม่เคยเป็น
// สีตัวอักษร เช่นเดียวกับแดงเข้ม #6b0402 และทองเข้ม #b07a06
// เนื้อความครีมอมส้มอ่อน #fdeedd (= BRAND_TEXT) — 14.8:1 บนผิวใบนี้
//
// ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #8a6204
// #0d2414 #09190d #051007 #e8f2e6 #07170c rgba(204,146,10,α)) ชุดฟ้าสด-เหลืองมะนาวของ
// แตกดี168 (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #c9a703 #0a1726 #07111d #dbeafe)
// และชุดทองเมทัลลิกของ 789BETTING ก่อนหน้านั้น (#fad354 #ffe79a #ddab33 #8a6410
// #c9881f #4a3407 #17130a #0e0b05 #060402 #f3e7cd) ออกครบทุกจุดแล้ว — ทองของรอบนี้
// เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#f5b61d]/40 bg-[#3a0d07]/96 p-8 text-left text-base leading-relaxed text-[#fdeedd] shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f5b61d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fdf9e4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#d4200d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#6b0402] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f5b61d] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffd87a] via-[#fdf9e4] to-[#f5b61d] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
