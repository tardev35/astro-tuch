---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, the slot renders as a direct child. Do not re-add a wrapper.
//
// No heading level is hardcoded below — `as` decides it every time. The header
// has no `whitespace-nowrap`, so a full docx sentence wraps instead of
// overflowing, and the title sits in normal flow (no floating badge here).
//
// รอบนี้หน้าแรกส่ง **docx H2 §6** มาให้ใบนี้ ("ระบบฝากถอน <แบรนด์> ได้ทุกธนาคาร
// และทรูมันนี่" — content.txt บรรทัด 13) พร้อมย่อหน้าเดียวของมัน (บรรทัด 14)
// กฎบ้าน "หนึ่งสล็อตรับ element เดียว" จึงเป็นจริงที่นี่ตรงๆ
// ⚠️ **ไม่มี BankStrip / ProviderGrid บนหน้าแรกรอบนี้** — บรีฟพูดถึง "ธนาคารและ
// ทรูมันนี่" แบบนามธรรม ไม่ได้ระบุชื่อธนาคาร ค่ายเกม วอลเล็ต หรือผู้ให้บริการราย
// ไหนเลยสักราย แถบโลโก้จึงเป็นข้อมูลที่หน้าเพจแต่งเอง ไม่ใช่ของบรีฟ
// ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน (banner2.png mtime 10-08 /
// banner3.png 09-27 เป็นของแบรนด์ก่อน และ eager import = emit) จึงไม่มีรูปในการ์ด
// ใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ ContentBoxSevenThree*
// เท่านั้น และโควตา 2 ใบของรอบนี้ถูกใช้ไปที่ §4 กับ §5 ครบแล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-madum168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-ครีมบนธีมสว่างของ ร่ำรวย168** ทั้งใบ
// จึงรีเธมทั้งไฟล์และ **กลับทิศ 180 องศา**: รอบนี้เป็น **ธีมมืด** พื้นเพจ #00091f
// (bg.json) = น้ำเงินเที่ยงคืนเกือบดำ การ์ดเนื้อหาจึงเป็น **ผิวมืด + หมึกสว่าง**
// **ห้ามแก้กลับไปเป็นผิวสว่าง** — การ์ดสว่างกับหมึก #f4eef1 จะทำให้ตัวอักษรหายไปเลย
// ลำดับผิว: #16234a ยก · #0b1733 กลาง · #050e26 จม · #00091f พื้นเพจ —
// การ์ดใบนี้ไล่จาก **กลางลงจม** (#0b1733 → #050e26)
//
// จังหวะรูปทรงของใบนี้: **มุมตัดเฉียง 40px** กับเส้นรูดสี่มุมที่ไขว้ "แดง vs อะซัวร์"
// คือจุดต่างของใบนี้จากกล่อง docx ใบอื่น — **แนวนอนเป็นแดง** (#ff2e52 และ #c9102f)
// ส่วน **แนวตั้งเป็นอะซัวร์** (#1177e8 และ #0a4ea8) ซึ่งเป็นที่เดียวบนหน้าที่สอง
// วัสดุของรอบนี้ (แดงสดของเลข "168" ในโลโก้ + ฟ้าอมน้ำเงินของคำว่า "มาดาม" และ
// แคปซูลเรืองแสงใต้แบนเนอร์) ถูกวางไขว้กันตรงๆ
// ⚠️ §5 ContentBoxSevenThreeCyberCut เป็นมุมตัด **36px** บนผิวจม #050e26 ทึบ และ
// เส้นรูดเป็นอะซัวร์ล้วน — สองใบจึงไม่อ่านซ้ำกันแม้จะอยู่ตระกูล CyberCut เหมือนกัน
// ⚠️ ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **สันซ้ายหนาสี่พิกเซล** — สัน #ff2e52
// (พื้นถมล้วน ไม่มีตัวอักษรวางทับ) กับหัวข้อ **แดงคริมสัน #ff2e52 ทึบสีเดียว
// ไม่ไล่เฉด ไม่มีแผ่นถม ไม่มีเรืองแสง** (4.9:1 บนผิวกลาง · 5.3:1 บนผิวจม)
// เนื้อความ #f4eef1 (= BRAND_TEXT) — 15.7:1 บนผิวกลาง และ 17.0:1 บนผิวจม
//
// ⚠️⚠️ §2 ห้าม **#1177e8 / #0e68cc / #0a4ea8 / #c9102f / #2a3c70** ถือตัวอักษร
// ทุกกรณี — ในไฟล์นี้อยู่ที่สันซ้าย เส้นรูด และขอบ ซึ่งเป็นพื้นถมล้วน ·
// **#ff2e52 สงวนไว้ให้ <strong> ในเนื้อความด้วย** ซึ่งเป็นงานของหน้าเพจ ไม่ใช่
// ของไฟล์นี้ · ⚠️ **ห้ามวางหมึกขาวบน #ff2e52 ตรงๆ (3.6:1)** ถ้าต้องขาวให้ใช้
// #e01238 ขึ้นไป
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) · rgba(217,223,233,α) ·
// rgba(0,9,31,α) · rgba(0,0,0,α)
//
// ⚠️ 🚨 **ฟ้า/ไซยานถูกใช้นำมาแล้วเจ็ดแบรนด์ในรีโปนี้** การเจอฟ้าในไฟล์ไม่พิสูจน์
// อะไร ต้อง grep เป็น "ค่า" ทีละตัว — อะซัวร์รอบนี้คือ **#1177e8 / #0e68cc /
// #0a4ea8** เท่านั้น และ **ไม่ถือตัวอักษร** ไม่ใช่:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (**นาซ่า168 — แบรนด์ขาออก เสี่ยงที่สุด**) ·
//   18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f 202a66 31408a
//   e9f1ff adc0e4 f4e4d3 e4cbb3 (ร่ำรวย168 — ชุดที่เพิ่งอยู่ทั้งใบนี้) ·
//   2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
//   eafaff a9e3f9 0f3a4a 06293c (สบาย168) · 039cfa 0494f5 c3ebfc 04366b e3f2fc
//   0b2d52 (รวยแทร่168) · 32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 (นินจา168) ·
//   2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff
//   cfdcec 9db4d4 dde8f7 00081f 102a5e 0a1c42 032dad 04186e (TSDET911) ·
//   และไม่ใช่ 0ea5e9 1279be 1155cc ซึ่งเป็นสีจริงของโลโก้ธนาคารในไฟล์อื่น
// ⚠️⚠️ **แดงเป็นฮิวนำรอบนี้ จึงต้องเทียบแดงของแบรนด์เก่าทีละค่าให้แน่นที่สุด** —
// แดงรอบนี้คือ **#ff2e52 (R255 G46 B82) / #e01238 / #c9102f** เท่านั้น ไม่ใช่
// b3121b f2bba5 c98a74 (ขวัญใจ168) c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef
// (รวยแท้168) fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B) eb0305 e40303 c20305
// 9b0a0c ff4446 401107 (โปรดี168) fa0513 ff5a5f ffadaf (สมหวัง168) d9212a 8e1a16
// (ดวงเศรษฐี168) fb1b32 ff8f9c 5c0410 (มีเฮ168) e4021b (รวยเทพ168) d30304 a00203
// ff6b6e (รับตัง168) dc0203 f5282a (หวย365) dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168)
// fa63b9 ffb3de (ถอนชัวร์168) f5469f ff8dc6 8c0f52 (มีโชค168) ff3b14 6d0804 2b0000
// (FLASH877)
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **พักยก168** (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 1f0f04) ·
// **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906
// 2e2512 1b1407 4d3c15) · **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf
// 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4) · **รวยแท้168** (c30303 8f0505 e81313
// dcb95f b8862b 96681f 4a0f0f ffeee8 fff1ef ffdbdb) · **มีทรัพย์168** (dd1b74
// a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) · **ufalion168** (d4922c fdfc71 a25b24 8c4312
// d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000 fbf6e3) · **UFA324** (e5a81b
// ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a) · **CEO66** (020617 7e22ce
// d946ef f5d0fe a855f7) · **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63
// aeb04a) และ 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีเขียว ไม่มีชมพู ไม่มีม่วง ไม่มีโรสโกลด์
// ไม่มีส้ม ไม่มีน้ำตาล ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงิน** (ผมสีขาวเงินกับสูท
// ขาวครีมในอาร์ตเวิร์กเป็น **วัตถุในภาพ** ไม่ใช่สี UI)
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#2a3c70] bg-gradient-to-br from-[#0b1733] to-[#050e26] p-8 text-left text-base leading-relaxed text-[#f4eef1] shadow-[0_10px_30px_rgba(0,0,0,0.5)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ff2e52] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#c9102f] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#1177e8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#0a4ea8] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#ff2e52] pl-6">
          <HeadingTag class={`${headingSize} leading-normal font-black text-[#ff2e52]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
