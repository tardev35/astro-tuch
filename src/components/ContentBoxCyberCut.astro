---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on the four
// corner rules, slot renders as a direct child. Do not re-add a wrapper.
//
// No level is hardcoded in the markup below — `as` decides it every time. The
// header has no `whitespace-nowrap`: a full docx sentence has to wrap.
//
// This round the page hands this box the docx H1 (section 1) plus its single
// paragraph, so the house rule of exactly ONE element per slot holds.
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10, brand-spec §2):
// รอบนี้พลิกทิศจากคู่ "ทองอวกาศ-เงินโครเมียม" ของ NAZA168 — ที่นั่นเงินโครเมียมเป็น
// ฮิวที่สองบนพื้นน้ำตาลไหม้ รอบนี้ฮิวที่สองเป็น **ส้มอำพันปากเป็ด** #f58b2a และพื้นเพจ
// เป็น **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"}) จึงไม่มีชั้นไหนจมลง
// ต่ำกว่าพื้นได้อีก ทุกผิวการ์ดต้องสว่างกว่าพื้นเสมอ
// การ์ดใบนี้เป็นผิวยก #1f1709 ซึ่งเป็นผิวที่สว่างที่สุดในลำดับความลึกของหน้านี้ —
// หัวข้อ H1 จึงลอยขึ้นสูงสุด เทียบกับ SevenThreeCyberCut ที่เป็นผิวลึก #0d0903
// ทั้งสองใบมุมตัดจึงอยู่คนละปลายของลำดับความลึก ไม่ได้ซ้ำผิวเดียวกัน
// เส้นรูดสี่มุมจับคู่ "ทอง vs ส้ม" ไขว้กัน — ทองเป็ด #f3bb34 คู่ทองสว่าง #fde464 บน
// แนวนอน ส้มอำพัน #f58b2a คู่ส้มลึก #a3510c บนแนวตั้ง ตรงกับโลโก้ที่เป็นเป็ดเหลือง
// สวมมงกุฎทองและมีปากสีส้มอำพัน คำว่า DUCK เป็นทองสามมิติบนแผ่นป้ายดำขอบทองหนา
// หัวข้อไล่ทองสว่าง #fde464 → ส้มอำพัน #f58b2a → ทองเป็ด #f3bb34 ซึ่งเป็นลำดับที่ไม่
// ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ (ContentBox ที่ใช้ร่วมกับหน้าอื่นไล่
// #fde464 → #f3bb34 → #f58b2a ซึ่งสลับสองตัวท้าย)
// ทองลึก #8a5f08 ทองเส้น #5c3f04 และส้มลึก #a3510c ถูกใช้เป็นขอบ/เส้นรูด/เงาเท่านั้น
// ไม่เคยถือตัวอักษร ตามที่ §2 กำหนด
// เนื้อความครีมอุ่น #f6ecd9 (= BRAND_TEXT) — 15.0:1 บนผิวยก
//
// ⚠️ แบรนด์รอบก่อน (NAZA168) **ก็ทองเหมือนกัน** และเจ็ดในแปดรอบหลังสุดก็มีทอง เจอทอง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ต้องเทียบเป็น "ค่า": ชุดทองสายฟ้า-แดงเลือดนกของ
// FLASH877 ที่เคยค้างในไฟล์นี้ (#f5c518 #ffdd73 #b8860f #8a6208 #ff3b14 #8c0f0a
// #5a0603 #7d1008 #6d0804 #5c0000 #430000 #fdf0e2) ชุดทองอวกาศ-เงินโครเมียมของ
// NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859
// #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ
// SUPERSLOTCLUB (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b) ชุดเขียวป่า-
// ทองมงกุฎของ KINGKONG555 (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08)
// ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #7a1fc4 #fbe455 #ffd23d #5b1a75 #c98a05
// #1e0a3c) และชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #b07a06
// #6b0402) ออกครบทุกจุดแล้ว — รอบนี้ **ไม่มีสีแดง ไม่มีเงินโครเมียม** เป็นฮิวเลย
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#f3bb34]/40 bg-[#1f1709]/96 p-8 text-left text-base leading-relaxed text-[#f6ecd9] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f3bb34] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fde464] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#f58b2a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#a3510c] to-transparent"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f3bb34] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fde464] via-[#f58b2a] to-[#f3bb34] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
