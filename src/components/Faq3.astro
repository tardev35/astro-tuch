---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2): แผงนี้เป็นกล่องสุดท้าย
// ของสายบทความ จึงวางที่ผิวลึกสุด #430000 ซึ่งจมลงไปจากพื้นเพจแดงเลือดนก #5c0000 —
// ต่างจากการ์ดเนื้อหาผิวยก/ผิวกลางที่อยู่เหนือมันทั้งหน้า เส้นกรอบเป็นแดงเข้ม #8c0f0a
// ที่สว่างขึ้นเป็นทองสายฟ้า #f5c518 ตอน hover พร้อมพื้นไต่ขึ้นมาเป็นผิวกลาง #6d0804
// หัวข้อไล่ทองสายฟ้า #f5c518 → ทองสว่าง #ffdd73 → แดงสายฟ้า #ff3b14 ตามลำดับที่ตาอ่าน
// โลโก้จริง (สายฟ้าทองผ่ากลางเหรียญ แล้วจบที่เลข 877 สีแดงสด) — ลำดับนี้ไม่ซ้ำกับกล่อง
// เนื้อหาใบอื่นบนหน้าเดียวกันสักตัว และ #ff3b14 อยู่ปลายไล่เฉดของ font-black text-2xl
// ขึ้นไปเท่านั้น ซึ่ง §2 อนุญาตเฉพาะ display ขนาดใหญ่/หนาแบบนี้
// เนื้อความใช้สี BRAND_TEXT #fdf0e2 คำถามสว่างขึ้นเป็นทองสว่าง #ffdd73 ตอนชี้ และ
// เครื่องหมาย + ตอนเปิดเป็นทองสายฟ้า #f5c518
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) ก็แดง-ทองเหมือนกัน ให้เทียบเป็นค่า: ชุดม่วงนีออน-
// ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #fbe455 #ffd23d #efe6ff #ece2ff
// #5b1a75 #17062e #1e0a3c) ชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33
// #8a6410 #0e0b05 #17130a #f3e7cd) และชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #fbe8d5 #3d1709 #241000) ออกครบ
// ทุกจุดแล้ว — ทองของรอบนี้คือ #f5c518 / #ffdd73 เท่านั้น
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#f5c518] via-[#ffdd73] to-[#ff3b14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c518] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#8c0f0a] bg-[#430000]/90 p-2 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all hover:border-[#f5c518]/70 hover:bg-[#6d0804]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#fdf0e2] transition-colors hover:text-[#ffdd73]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#fdf0e2]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f5c518;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
