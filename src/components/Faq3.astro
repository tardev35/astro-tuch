---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt lines 23-28,
// the brief's own three Q/A pairs).
//
// GT66B (รอบแดงมังกร-โครเมียมขาวบนดำสนิท 2026-10-13, brand-spec §2): แผงนี้เป็น
// กล่องสุดท้ายของสายบทความ จึงวางที่ **ผิวจม #0b0303** ซึ่ง ⚠️ ยังสว่างกว่าพื้นเพจ
// **ดำสนิท #000000** — รอบนี้ไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ต่างจากการ์ดเนื้อหาผิวยก/
// ผิวกลางที่อยู่เหนือมันทั้งหน้า เส้นกรอบเป็นแดงดำ #3b0405 ที่สว่างขึ้นเป็นแดงแบรนด์
// #fb141b ตอน hover พร้อมพื้นไต่ขึ้นมาเป็นผิวกลาง #130c0c
// หัวข้อไล่ แดงแบรนด์ #fb141b → แดงสว่าง #ff5f63 → โครเมียมสว่าง #fdfcfd ตามลำดับที่
// ตาอ่านโลโก้จากขวามาซ้าย (อักขระมังกรแดงกับเลข 66 แดงก่อน แล้วจบที่ตัวอักษร GT/B
// โครเมียมขาว) — ลำดับนี้ไม่ซ้ำกับกล่องเนื้อหาใบอื่นบนหน้าเดียวกันสักตัว แดงแบรนด์
// อยู่ได้เพราะเป็น **ปลาย** ของไล่เฉด ไม่ใช่สีตัวอักษรทึบ
// เนื้อความใช้สี BRAND_TEXT #eceaea (17.6:1 บนผิวจม) คำถามสว่างขึ้นเป็นแดงสว่าง
// #ff5f63 (6.4:1) ตอนชี้ และเครื่องหมาย + ตอนเปิดเป็นแดงสว่าง #ff5f63
// §2 ห้าม #fb141b #db040b #ec151c #8a0609 #3b0405 ถือตัวอักษร — ในไฟล์นี้อยู่ที่กรอบ
// เส้นใต้หัวข้อ และปลายไล่เฉดเท่านั้น และ #ffa0a2 สงวนให้ <strong> ในย่อหน้า จึงไม่
// โผล่ที่นี่
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** เพราะแบรนด์รอบก่อน
// หน้าทันที (TKB55) ก็เป็นแดง-โครเมียม-ดำเหมือนกัน แดงของมันคือ #fb131b ส่วนรอบนี้
// คือ #fb141b ต่างกันหนึ่งหลัก ชุดเต็มของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4
// #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ไม่เหลือ
// ในไฟล์นี้
// ชุดม่วงราชา-ทองของ KMD88 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#7505cc #b453ff #c07cff
// #d9b8ff #3a0565 #2c0349 #1d0832 #140522 #0a0213 #e2b33f #ffdf8c #ffd45e #ece2f8
// #bba8d4 #1a0526 #7a5a0a) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a) ชุดทองมังกรของ
// TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02 #1b1307
// #120c04 #070502) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #ff3b14
// #8c0f0a #6d0804 #5c0000 #430000 #fdf0e2) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571
// #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a
// #2e0022 #1c0014) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3
// #f5c53d #9c6f08 #b3006a #4d002b #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-
// ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #a3510c
// #1f1709 #171106 #0d0903 #f6ecd9) และชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134
// #ffe87a #cf9a18 #cfd6e3 #eef2f8 #4e3406 #382400 #241700) ออกครบทุกจุดแล้ว
// ⚠️ แดง false friend ที่ยังอยู่ในไฟล์ inventory อื่น: SUPERSLOTCLUB #e8232a (R=232)
// PIGPG #d4200d (R=212) FLASH877 #ff3b14 (R=255 G=59) — ไม่มีตัวไหนเป็น #fb141b
// (R=251 G=20 B=27) ของรอบนี้ และโครเมียมขาวรอบนี้คือ #fdfcfd / #b4bcc2 เท่านั้น
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#fb141b] via-[#ff5f63] to-[#fdfcfd] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb141b] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#3b0405] bg-[#0b0303]/90 p-2 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all hover:border-[#fb141b]/80 hover:bg-[#130c0c]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#eceaea] transition-colors hover:text-[#ff5f63]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#eceaea]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #ff5f63;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
