---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt lines 24-29,
// the brief's own three Q/A pairs, with the "1./2./3." markers dropped because
// the accordion is the list).
//
// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกาย + ทองคานารี บนธีมสว่าง ของ สบาย168**
// ทั้งใบ (2cc3fc 9ae0fa 0a7fbd 063a57 0f3a4a dff4fd f2fbff ccf7ff eafaff fdcb0c
// fefb6b 8a6504 06293c กับ rgba 6/58/87) จึงถูกกวาดออกทั้งหมด — ⚠️ **นี่คือกรณีที่
// อันตรายที่สุดของรอบนี้: ไฟล์เดิมก็ฟ้า ธีมเดิมก็สว่าง ตาจึงแยกไม่ออก ต้อง grep
// ทีละค่า** ก่อนหน้านั้นเป็นชุดแดงคริมสันของ รวยแท้168 (c30303 4a0f0f 8f0505 e81313
// dcb95f b8862b 96681f c99a3f fff1ef ffdbdb) และชุดทองสองเฉด-บรอนซ์ของ ufalion168
// (d4922c fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3) —
// ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของแบรนด์ขาออก **เงินทอง168** (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906) ซึ่งไม่เคยลงมาถึงไฟล์นี้
// และต้องไม่ลงมา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
//
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง** — bg.json = {"mode":"color","color":"#dbe6ff"}
// ฟ้าเพอริวิงเคิลอ่อน แผงนี้อยู่ใน **โซนเนื้อหา ไม่ใช่โครม** จึงเป็น **การ์ดขาว
// หมึกน้ำเงินเข้ม** ห้าม "แก้" ให้กลับไปเป็นแผงเข้มลอยบนพื้นสว่าง (โครมคือ
// navbar/footer/ticker/ฟีดฝากถอน/แผงรีวิว เท่านั้น) ลำดับผิว: #ffffff ยก (แถวปิด) ·
// #eef4ff กลาง (แถว hover) · #dce9fb อินเซ็ต (แป้นเครื่องหมาย +) · #f4e4d3 ครีม ·
// #dbe6ff พื้นเพจ
//
// จังหวะรูปทรง: แผงนี้เป็นกล่องสุดท้ายของสายบทความ (docx H2 §8 "คำถามที่พบบ่อย
// เกี่ยวกับ <แบรนด์>") และเป็นใบเดียวของหน้าที่ **หัวข้อจัดกึ่งกลางพร้อมขีดใต้จาง
// สองข้าง** ⚠️ `text-center` อยู่บน **ตัว HeadingTag เอง** เท่านั้น ไม่ได้อยู่บน
// <header> <section> หรือการ์ดใบไหน จึงไม่ไหลลงไปจัดกึ่งกลางคำตอบในแต่ละแถว
//
// สีที่ใช้และเหตุผล (ทุกค่ามาจากตาราง §2 ไม่มีเฉดคิดเพิ่ม):
//   หัวข้อ — ฟ้าเข้ม #0d6b9b เป็น **ตัวอักษรทึบค่าเดียว ไม่ใช่ bg-clip-text
//   ไล่เฉด** เพราะหัวข้อนี้นั่งบน **พื้นเพจ #dbe6ff** (4.5:1 ผ่าน AA ทั้งเกณฑ์ปกติ
//   และเกณฑ์ large text) และการไล่เฉดบนพื้นสว่างจะลากค่าที่อ่านไม่ออก (#18a5e2 =
//   2.1:1 บนพื้นเพจ) เข้ามาเป็นพิกเซลของตัวอักษรได้ง่ายเกินไป
//   เส้นคาดใต้หัวข้อ — ฟ้าไซยาน #18a5e2 ซึ่งเป็น **พื้นถม ไม่ใช่ตัวอักษร** จึงใช้ได้
//   ทั้งที่ §2 ห้ามมันถือตัวอักษรบนพื้นสว่าง
//   คำถาม — #0d6b9b (5.6:1 บนการ์ดขาว) · คำตอบ — #16294a = BRAND_TEXT (13.9:1)
//   ⚠️ **ไม่มีสีตัวอักษรตอน hover** เพราะค่าที่เหลือที่ "ดูสว่างขึ้น" ในพาเลตนี้คือ
//   #18a5e2 (2.6:1) ซึ่งตกเกณฑ์ทุกขนาด — hover จึงสื่อด้วย **ขอบ + พื้น** แทน
//   ไม่ใช่ด้วยสีตัวอักษร
//   เครื่องหมาย + — แป้นอินเซ็ต #dce9fb ขอบ #a9d7f2 หมึก #0d6b9b ตอนปิด และพลิกเป็น
//   **พื้นถมฟ้าไซยาน #18a5e2 + หมึก #111a3f (6.0:1)** ตอนเปิด ซึ่งเป็นคู่ที่ §2
//   ระบุไว้ตรงๆ สำหรับพื้นถมฟ้า **ห้ามพลิกไปใช้หมึกขาว** (2.6:1)
// ⚠️ **ครีม #f4e4d3 / #e4cbb3 เป็นวัสดุที่สองของ §3 กับ §6 บนหน้าเดียวกัน** จึง
// ไม่โผล่ในไฟล์นี้เลยสักค่า เพื่อให้แผงสุดท้ายอ่านเป็นฟ้าล้วน ·
// **#0d6b9b ในเนื้อความย่อหน้าเป็นงานของ <strong> บนหน้าเพจ**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า เพราะฟ้านำมาแล้ว
// ห้าแบรนด์ในรีโปนี้** การเจอ "ฟ้า" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ
// **#18a5e2 (R24 G165 B226)** กับ **#0d6b9b (R13 G107 B155)** และไม่ใช่ 2cc3fc
// 6bdcfb 0a7fbd 063a57 (สบาย168 — ⚠️ เจ้าที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ) ไม่ใช่
// 2f9ff5 a8dcff d6ecff 0b3f78 (สบายเบท168) ไม่ใช่ 32bcfb a9e9ff 07335f (นินจา168)
// ไม่ใช่ 039cfa 0494f5 c3ebfc 04366b (รวยแทร่168) ไม่ใช่ 0360f3 0292fb 6ec8ff
// 4fb4ff (TSDET911) และไม่ใช่ 0ea5e9 1279be ซึ่งเป็นสีจริงของโลโก้ธนาคารในไฟล์อื่น
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง
// ไม่มีเขียว ไม่มีส้ม ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8">
        <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#0d6b9b] md:text-3xl">{title}</HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#18a5e2] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#a9d7f2] bg-white p-2 shadow-[0_10px_30px_rgba(22,41,74,0.1)] transition-all hover:border-[#18a5e2] hover:bg-[#eef4ff]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#0d6b9b]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#a9d7f2] bg-[#dce9fb] text-xl leading-none text-[#0d6b9b] transition-all duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#16294a]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #18a5e2;
    background-color: #18a5e2;
    color: #111a3f;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
