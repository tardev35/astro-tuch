---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): แผงพื้นการ์ดเป็นผิว
// การ์ดกลาง #0e0b05 ในเส้นกรอบทองลึก #8a6410 ที่สว่างขึ้นเป็นทองแบรนด์ #fad354 ตอน hover
// พร้อมพื้นไต่ขึ้นเป็นผิวการ์ดยก #17130a หัวข้อไล่ทองแชมเปญ #ffe79a → ทองแบรนด์ #fad354
// → ทองกลาง #ddab33 ตามโลโก้ที่ตัวเลข 789 เป็นทองขัดเงาสามมิติทับคำว่า BETTING สีดำบน
// แถบขีดขาว — ลำดับแชมเปญ-ทอง-ทองกลางนี้ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว รอบนี้
// แบรนด์มีฮิวเดียว ไม่มีสีที่สองให้ปิดท้ายไล่เฉดแบบรอบก่อนๆ
// เนื้อความใช้สี BRAND_TEXT #f3e7cd คำถามสว่างขึ้นเป็นทองแบรนด์ตอนชี้ และเครื่องหมาย +
// ตอนเปิดเป็นทองแบรนด์
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #04ab3a #036b26 #07170f
// #0b231b #cfe9d7 #ffffff) ออกครบทุกจุดแล้ว
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#ffe79a] via-[#fad354] to-[#ddab33] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fad354] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-789betting"
          class="faq-item rounded-3xl border border-[#8a6410] bg-[#0e0b05]/90 p-2 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all hover:border-[#fad354]/70 hover:bg-[#17130a]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f3e7cd] transition-colors hover:text-[#fad354]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f3e7cd]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #fad354;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
