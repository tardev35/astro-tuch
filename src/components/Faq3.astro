---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — the docx's H3 tier belongs to the two
   *  bonus sub-sections only, so an FAQ must not add another one. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// WY88 (ชมพูมาเจนตา-ทอง 2026-09-23): แผงพื้นการ์ดพลัม #24081a ในเส้นมาเจนตาเข้ม
// #a3145a ที่สว่างขึ้นเป็นทองหลัก #e8b33a ตอน hover หัวข้อไล่จากชมพูกุหลาบ
// #f9a8cd → มาเจนตาหลัก #ec2b84 → ทองหลัก ตามโลโก้ที่ตัว WY เป็นชมพูมาเจนตาและ
// เลข 88 เป็นทอง เนื้อความใช้สี BRAND_TEXT #fce9f3 — ชุดกรมท่า-ทองของหวยพยัคฆ์
// ออกทั้งหมด
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b33a] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-wy88"
          class="faq-item rounded-3xl border border-[#a3145a] bg-[#24081a]/90 p-2 shadow-[0_10px_30px_rgba(23,4,17,0.6)] backdrop-blur-xl transition-all hover:border-[#e8b33a]/70 hover:bg-[#170411]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#fce9f3] transition-colors hover:text-[#fced94]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#fce9f3]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #e8b33a;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
