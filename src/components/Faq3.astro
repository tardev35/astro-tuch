---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt lines 24-29,
// the brief's own three Q/A pairs, with the "1./2./3." markers dropped because
// the accordion is the list).
//
// สบาย168 (ดรอป 2026-10-22) — พาเลตตาม .claude/brand-spec-sabai168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน + หมึกเลือดหมู บนพื้นชมพู ของ
// รวยแท้168** ทั้งใบ (c30303 4a0f0f fff1ef ffdbdb กับ rgba 74/15/15) จึงถูกกวาด
// ออกทั้งหมด รวมถึงชุดทองโบราณ dcb95f b8862b 96681f c99a3f และ 8f0505 e81313
// ของเจ้าเดียวกัน และชุดทองสองเฉด-บรอนซ์ของ ufalion168 (d4922c fdfc71 f6e3b4
// a25b24 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3) ที่เคยอยู่ใต้ชั้นนั้นอีกที
// ชุดทองคานารี-โครเมียมเงินบนดำสนิทของ **ยูฟ้า168 (แบรนด์ขาออก)** (fee45d e6a416
// b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02
// 0b0d10) ไม่เคยลงมาถึงไฟล์นี้ และต้องไม่ลงมา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
//
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง** — bg.json = {"mode":"color","color":"#ccf7ff"}
// ฟ้าพาสเทล แผงนี้อยู่ใน **โซนเนื้อหา ไม่ใช่โครม** จึงเป็น **การ์ดขาวหมึกน้ำเงินเข้ม**
// ห้าม "แก้" ให้กลับไปเป็นแผงเข้มลอยบนพื้นสว่าง (โครมคือ navbar/footer/ticker/
// ฟีดฝากถอน เท่านั้น) ลำดับผิว: #ffffff ยก (แถวปิด) · #f2fbff กลาง (แถว hover) ·
// #dff4fd อินเซ็ต (แป้นเครื่องหมาย +) · #ccf7ff พื้นเพจ
//
// จังหวะรูปทรง: แผงนี้เป็นกล่องสุดท้ายของสายบทความ (docx H2 §8 "คำถามที่พบบ่อย
// เกี่ยวกับ <แบรนด์>") text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บน <section>
// จึงไม่ไหลลงไปจัดกึ่งกลางคำตอบในแต่ละแถว
//
// สีที่ใช้และเหตุผล (ทุกค่ามาจากตาราง §2 ไม่มีเฉดคิดเพิ่ม):
//   หัวข้อ — น้ำเงินหมึก #063a57 เป็น **ตัวอักษรทึบค่าเดียว ไม่ใช่ bg-clip-text
//   ไล่เฉด** เพราะหัวข้อนี้นั่งบน **พื้นเพจ #ccf7ff** (10.5:1) และการไล่เฉดบนพื้น
//   สว่างจะลากค่าที่อ่านไม่ออกเข้ามาเป็นพิกเซลของตัวอักษรได้ง่ายเกินไป
//   เส้นคาดใต้หัวข้อ — ฟ้าสกาย #2cc3fc ซึ่งเป็น **พื้นถม ไม่ใช่ตัวอักษร** จึงใช้ได้
//   ทั้งที่ §2 ห้ามมันถือตัวอักษรบนพื้นสว่าง (2.2:1)
//   คำถาม — #063a57 (7.5:1 บนการ์ดขาว) · คำตอบ — #0f3a4a = BRAND_TEXT (12.2:1)
//   ⚠️ **ไม่มีสีตัวอักษรตอน hover** เพราะค่าที่เหลือที่ "ดูสว่างขึ้น" ในพาเลตนี้คือ
//   #0a7fbd (4.2:1) ซึ่งตกเกณฑ์สำหรับ text-base bold = 16px — hover จึงสื่อด้วย
//   **ขอบ + พื้น** แทน ไม่ใช่ด้วยสีตัวอักษร
//   เครื่องหมาย + — แป้นอินเซ็ต #dff4fd ขอบ #9ae0fa หมึก #063a57 ตอนปิด และพลิกเป็น
//   **พื้นถมฟ้าสกาย #2cc3fc + หมึก #06293c (7.5:1)** ตอนเปิด ซึ่งเป็นคู่ที่ §2
//   ระบุไว้ตรงๆ สำหรับพื้นถมฟ้า
// ⚠️ **ทองลึก #8a6504 สงวนไว้ให้ <strong> ในเนื้อความของหน้าเท่านั้น** จึงไม่อยู่ใน
// ไฟล์นี้ · **ทองคานารี #fdcb0c และทองซีด #fefb6b เป็นสีของโครม** (1.5–2.4:1 บน
// การ์ดขาว) จึงไม่โผล่ในไฟล์นี้เลยสักค่า
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า เพราะฟ้าผ่านรีโปนี้
// มาแล้วหลายเจ้า และหนึ่งในนั้นชื่อเกือบซ้ำกัน** การเจอ "ฟ้า" ในไฟล์นี้จึงไม่พิสูจน์
// อะไรเลย ฟ้ารอบนี้คือ **#2cc3fc (R44 G195 B252)** และไม่ใช่ 2f9ff5 a8dcff d6ecff
// 0b3f78 ffc82e ของ **สบายเบท168** (⚠️ คนละลูกค้า ชื่อใกล้ที่สุดในรีโป worker
// xn---168-9gora7dtd1dwh ส่วนรอบนี้คือ xn---168-pho7byc9c) ไม่ใช่ 32bcfb a9e9ff
// fef54b 07335f ของนินจา168 (32bcfb ห่างจาก 2cc3fc แค่ 6 ที่ R) ไม่ใช่ 039cfa
// 0494f5 c3ebfc 04366b f9a826 ของรวยแทร่168 และไม่ใช่ 0ea5e9 1279be ซึ่งเป็นสีจริง
// ของโลโก้ธนาคารในไฟล์อื่น
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีเงิน/โครเมียม**
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#063a57] uppercase md:text-3xl">{title}</HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2cc3fc] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#9ae0fa] bg-white p-2 shadow-[0_10px_30px_rgba(6,58,87,0.12)] transition-all hover:border-[#2cc3fc] hover:bg-[#f2fbff]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#063a57]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#9ae0fa] bg-[#dff4fd] text-xl leading-none text-[#063a57] transition-all duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#0f3a4a]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #2cc3fc;
    background-color: #2cc3fc;
    color: #06293c;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
