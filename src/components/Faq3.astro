---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from.
//
// รอบนี้ (2026-10-11, brand-spec §2): พาเลตต์ทองแชมเปี้ยน-เงินโครเมียมบนพื้น
// **ดำสนิท #000000** แผงนี้เป็นกล่องสุดท้ายของสายบทความ จึงวางที่ผิวจม #0d0b06 ซึ่ง
// ⚠️ ยังสว่างกว่าพื้นเพจ — รอบนี้ไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ต่างจากการ์ดเนื้อหา
// ผิวยก/ผิวกลางที่อยู่เหนือมันทั้งหน้า เส้นกรอบเป็นทองดำ #43300a ที่สว่างขึ้นเป็นทอง
// แบรนด์ #e5a81b ตอน hover พร้อมพื้นไต่ขึ้นมาเป็นผิวกลาง #17130a
// หัวข้อไล่ทองแบรนด์ #e5a81b → ทองสว่าง #ffe08a → เงินแบรนด์ #b9c2cc ตามลำดับที่ตา
// อ่านโลโก้จริง (ถ้วยแชมป์ทองกับลูกฟุตบอลทอง แล้วจบที่เลข 324 เงินโครเมียม) — ลำดับ
// นี้ไม่ซ้ำกับกล่องเนื้อหาใบอื่นบนหน้าเดียวกันสักตัว
// เนื้อความใช้สี BRAND_TEXT #f0e8d4 คำถามสว่างขึ้นเป็นทองสว่าง #ffe08a ตอนชี้ และ
// เครื่องหมาย + ตอนเปิดเป็นทองแบรนด์ #e5a81b
//
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง ให้เทียบเป็นค่า ไม่ใช่ตระกูลสี: ชุดทองสายฟ้า-แดง
// เลือดนกที่เคยค้างในไฟล์นี้ (#f5c518 #ffdd73 #ff3b14 #8c0f0a #6d0804 #5c0000
// #430000 #fdf0e2) ชุดชมพูฮอต-ทองบนพลัมดำของแบรนด์รอบก่อนหน้าทันที (#ff3fa4 #ff6cbb
// #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a #4d002b #4a0b42 #3a0534 #2e002c
// #210220) ชุดทองเป็ด-ส้มอำพัน (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a
// #a3510c #1f1709 #171106 #0d0903 #f6ecd9) ชุดทองอวกาศ-เงินโครเมียม (#fbc134
// #ffe87a #cf9a18 #cfd6e3 #eef2f8 #4e3406 #382400 #241700) และชุดม่วงนีออน-ทอง
// (#a435f0 #fbe455 #ffd23d #efe6ff #ece2ff #5b1a75 #1e0a3c) ออกครบทุกจุดแล้ว —
// ทองของรอบนี้คือ #e5a81b / #ffe08a เท่านั้น และเงินคือ #b9c2cc ไม่ใช่ #cfd6e3
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#e5a81b] via-[#ffe08a] to-[#b9c2cc] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e5a81b] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#43300a] bg-[#0d0b06]/90 p-2 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all hover:border-[#e5a81b]/70 hover:bg-[#17130a]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f0e8d4] transition-colors hover:text-[#ffe08a]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f0e8d4]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #e5a81b;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
