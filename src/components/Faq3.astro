---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <span> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt บรรทัด 24-29,
// คำถาม/คำตอบสามคู่ของบรีฟเอง ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion
// เป็นตัวลิสต์อยู่แล้ว)
//
// ⚠️ คำถามอยู่ใน <span> ภายใน <summary> ไม่ใช่ <p> และไม่ใช่ heading — <summary>
// รับได้แค่ phrasing content (หรือ heading หนึ่งใบ) และการเลื่อนขึ้นเป็น heading
// จะทำให้ inventory h2/h3 ของหน้าไม่ตรงกับบรีฟทันที
//
// ───────────────────────────────────────────────────────────────────────────
// ดรอป 2026-10-28 — พาเลตตาม brand-spec ของดรอปนี้ §2
// **เขียวมรกตนำ · ทองอำพัน/เงินโครเมียมเป็นวัสดุที่สอง · ภาษาภาพซามูไร-คาทานะ**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดง/ส้มเม็กซิกันบนการ์ดขาว** ทั้งใบ ซึ่งเป็น
// **ธีมสว่าง** ที่รอบนี้กลับทิศ 180°: bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#002908"} = **เขียวป่าจมเกือบดำ** แผงนี้จึงเป็น
// **การ์ดมืด + หมึกสว่าง** ⚠️ **ห้ามคงการ์ดขาวทึบ (ffffff) ของรอบก่อนไว้แม้แต่ใบเดียว**
// ขาวเป็นพื้นถมใหญ่รอบนี้ = จอสว่างแปลบกลางหน้าเข้ม (ขาวเหลือได้เฉพาะหมึกบนปุ่ม CTA
// ซึ่งไฟล์นี้ไม่มีปุ่มเลย จึงไม่มีค่าขาวในไฟล์นี้สักจุด)
// ลำดับผิว: #002908 พื้นเพจ (หัวข้อนั่งบนนี้ตรงๆ) · **#073c1a การ์ด (แถวปิด)** ·
// #0e5424 ยก (แถว hover) · #031b09 ผิวจม (แป้นเครื่องหมาย +)
//
// จังหวะรูปทรง: แผงนี้เป็นกล่องสุดท้ายของสายบทความ (docx §8 "คำถามที่พบบ่อย
// เกี่ยวกับ <แบรนด์>") และเป็นใบเดียวของหน้าที่ **หัวข้อจัดกึ่งกลางพร้อมขีดใต้จาง
// สองข้าง และไม่มีการ์ดครอบหัวข้อ** ⚠️ §2 ก็จัดกึ่งกลางเหมือนกัน แต่แถบของ §2
// อยู่ **เหนือ** หัวข้อและอยู่ในการ์ดมุมตัด
// ⚠️ `text-center` อยู่บน **ตัว HeadingTag เอง** เท่านั้น ไม่ได้อยู่บน <header>
// <section> หรือการ์ดใบไหน จึงไม่ไหลลงไปจัดกึ่งกลางคำตอบในแต่ละแถว
//
// 🚨 **หัวข้อนั่งบนพื้นเพจ #002908 ไม่มีการ์ดรอง** §2 จึงอนุญาตเฉพาะค่าที่ถือ
// ตัวอักษรได้ตรงนั้น — ทอง #e8c86a (10.1:1) · หมึกหลัก #eef7f0 (14.8:1) ·
// #3ddc4a (8.7:1) — **ห้าม #35a043 (3.8:1) ถือตัวอักษรเด็ดขาด เป็นเส้น/ออรา/
// พื้นถมเท่านั้น**
//
// สีที่ใช้และเหตุผล (ทุกค่ามาจากตาราง §2 ไม่มีเฉดคิดเพิ่ม):
//   หัวข้อ — ทองอำพัน #e8c86a เป็น **ตัวอักษรทึบค่าเดียว ไม่ใช่ bg-clip-text ไล่เฉด**
//   เพราะการไล่เฉดจะลากค่าที่ห้ามถือตัวอักษร (#35a043) เข้ามาเป็นพิกเซลของตัวอักษร
//   เส้นคาดใต้หัวข้อ — ไล่โปร่ง→#35a043→โปร่ง อ่านเป็นรอยสะบัดดาบ ซึ่งตรงนี้เป็น
//   **พื้นถม ไม่ใช่ตัวอักษร** จึงใช้ #35a043 ได้
//   คำถาม — ทอง #e8c86a (8.0:1 บนการ์ด · 5.5:1 บนผิวยก #0e5424)
//   คำตอบ — #eef7f0 = BRAND_TEXT (12.0:1 บนการ์ด · 8.2:1 บนผิวยก)
//   เครื่องหมาย + — แป้นอินเซ็ต #031b09 ขอบ #1e7033 หมึก #3ddc4a (9.9:1) ตอนปิด
//   และพลิกเป็น **พื้นถม #1e7033 + หมึก #eef7f0 (5.5:1)** ตอนเปิด
//   ⚠️ **ห้ามพลิกไปถมด้วย #35a043 หรือ #3ddc4a** (หมึกสว่างบนสองค่านั้นตกต่ำกว่า AA)
//   ออรา/เงา — rgba(1,13,4,…) เงาหมึกดำ · rgba(61,220,74,…) เรืองแสงนีออนตอน
//   hover/open เท่านั้น
// ⚠️ **เงินโครเมียม #dfe6e3 เป็นวัสดุของเวิร์ดมาร์ก (navbar/footer/hero)** และ
// **หมึกรอง #9dc2a5 ตกลงมา 4.6:1 บนผิวยก #0e5424** จึงไม่ถือเนื้อความในไฟล์นี้เลย
// แผงสุดท้ายอ่านเป็น **เขียวมรกต + ทอง** ล้วน
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือเขียว เพราะเขียวเป็นสี
// ที่ตาแยกค่าได้ยากที่สุด และรีโปนี้มีเขียวของแบรนด์อื่นอยู่ห้าชุดขึ้นไป** การเจอ
// "เขียว" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบให้ตรงหกหลัก
// เขียวรอบนี้คือ **#002908 #010d04 #031b09 #073c1a #0e5424 #1e7033 #35a043 #3ddc4a**
// และไม่ใช่ 117a41 2bb061 f2543f (**MEXICANOSLOT — ชุดที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ**
// ⚠️⚠️ **2bb061 ↔ #35a043 ตระกูลเดียวกันและความอิ่มใกล้กัน · 117a41 ↔ #1e7033
// ทั้งคู่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ**)
// ไม่ใช่ 15401d 28c437 e8fbe4 b4d6ad c6cfd2 e3bb45 0b4a12 116018 051409
// (**TEVA69 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด ⚠️ 15401d ↔ #0e5424 และ 28c437 ↔
// #3ddc4a ห่างกันก้าวเดียว เจอแล้วแปลว่าพิมพ์ผิด**)
// ไม่ใช่ 0c3a16 0a5f1c 0b7d28 061f0c 0f9b35 (**สาธุ168 — ⚠️ 0c3a16 ↔ #073c1a
// ต่างกันหลักเดียว**) ไม่ใช่ 143a1c 1fae1c 07130a 0d2312 (888PARUAY)
// ไม่ใช่ 1a5c04 2f8c07 8ce023 e9f7d6 bde397 (KINGKONG555) ไม่ใช่ 2fbf6a (KOON234)
// ไม่ใช่ 7a1bd6 c2178b bb6dff 190b3d f3e8ff (ZANE96) ไม่ใช่ de2b1e f2a033 a81410
// c81e12 9d140c 6f0e08 3f130d 2b100a f6c4a4 fde4d3 fdeee2 fff3ea fef6fb
// (**MEXICANOSLOT ชุดเต็ม**) ไม่ใช่ c1071b e9b53c f0bcbc c3ccd6 (LOTTO189)
// ไม่ใช่ 7a3a0c e0b784 c98a24 fa4903 (ZNOVA168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง/ส้ม/พีช ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง ไม่มีชมพู/ฟูเชีย
// ไม่มีแรมป์เทาเงิน และไฟล์นี้ไม่มีพื้นขาวเลยสักจุด**
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8">
        <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#e8c86a] md:text-3xl">{title}</HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#35a043] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#1e7033] bg-[#073c1a] p-2 shadow-[0_10px_30px_rgba(1,13,4,0.45)] transition-all hover:border-[#35a043] hover:bg-[#0e5424]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#e8c86a]">
            <span class="block text-left text-base leading-relaxed font-bold">{faq.q}</span>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#1e7033] bg-[#031b09] text-xl leading-none text-[#3ddc4a] transition-all duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#eef7f0]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: #35a043;
    box-shadow:
      0 10px 30px rgba(1, 13, 4, 0.55),
      0 0 0 1px rgba(61, 220, 74, 0.25);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #35a043;
    background-color: #1e7033;
    color: #eef7f0;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
