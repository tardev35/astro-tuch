---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): แผงพื้นการ์ดเป็น
// ผิวการ์ดกลาง #07170f ในเส้นกรอบเขียวลึก #036b26 ที่สว่างขึ้นเป็นเขียวนีออน #42fb5a
// ตอน hover พร้อมพื้นไต่ขึ้นเป็นผิวการ์ดยก #0b231b หัวข้อไล่ขาว #ffffff → เขียวนีออน
// #42fb5a → เขียวแบรนด์ #04ab3a ตามโลโก้ที่ตัวเลข 369 เป็นเงินแปรงและคำว่า BOOM
// เป็นเขียวนีออนในวงแหวนเขียวไล่ไปหาเทอร์ควอยซ์เข้ม — ลำดับขาว-นีออน-เขียวนี้ไม่ซ้ำ
// กับกล่องอื่นบนหน้าเดียวกันสักตัว เนื้อความใช้สี BRAND_TEXT #cfe9d7 คำถามสว่างขึ้นเป็น
// เขียวนีออนตอนชี้ และเครื่องหมาย + ตอนเปิดเป็นเขียวนีออน
//
// ชุดแดงแบรนด์-ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#170707 #230d0d #3d0a0a #d20a0a
// #f5c33b #ffd45e #ff5c5c #f7e2d6 rgba(5,2,2,…)) ออกครบทุกจุดแล้ว
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#ffffff] via-[#42fb5a] to-[#04ab3a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#42fb5a] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-boom369"
          class="faq-item rounded-3xl border border-[#036b26] bg-[#07170f]/90 p-2 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all hover:border-[#42fb5a]/70 hover:bg-[#0b231b]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#cfe9d7] transition-colors hover:text-[#42fb5a]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#cfe9d7]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #42fb5a;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
