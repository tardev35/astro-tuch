---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): แผงพื้นการ์ดดำอมเขียว #0b160b ใน
// เส้นเขียวลึก #1a7a08 ที่สว่างขึ้นเป็นเขียวนีออนแบรนด์ #8bfc13 ตอน hover หัวข้อ
// ไล่จากโครเมียมขาว #e8f0e6 → เขียวอ่อน #c9ff8f → เขียวนีออน ตามโลโก้ที่ตัว C กับ
// เลข 68 เป็นโครเมียมและตัว K กับเลข 2 เป็นเขียวนีออน เนื้อความใช้สี BRAND_TEXT
// #d5e6cd คำถามสว่างขึ้นเป็นเขียวอ่อนตอนชี้ และเครื่องหมาย + ตอนเปิดเป็นเขียว
// นีออน — ชุดทอง-ดำของ WIN999 ที่ค้างในไฟล์นี้ (#fcc403 #fdda04 #fffbea #4a3402
// #101010 #191712 #e9e4d6) ออกทั้งหมด
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#e8f0e6] via-[#c9ff8f] to-[#8bfc13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#8bfc13] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-ck268"
          class="faq-item rounded-3xl border border-[#1a7a08] bg-[#0b160b]/90 p-2 shadow-[0_10px_30px_rgba(1,4,1,0.7)] backdrop-blur-xl transition-all hover:border-[#8bfc13]/70 hover:bg-[#0f1b0e]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#d5e6cd] transition-colors hover:text-[#c9ff8f]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#d5e6cd]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #8bfc13;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
