---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt lines 24-29,
// the brief's own three Q/A pairs, with the "1./2./3." markers dropped because
// the accordion is the list).
//
// รวยแท้168 (2026-10-21 ดรอปที่สองของวัน) — พาเลตตาม
// .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองสองเฉด + บรอนซ์ บนดำสนิท ของ ufalion168**
// ทั้งใบ จึงกลับทิศทั้งไฟล์: **ธีมสว่างรอบที่สามของรีโปนี้** พื้นเพจ #ffdbdb
// (bg.json) แผงนี้จึงเป็น **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก (แถว details) · #fff1ef กลาง (แถวตอน hover/เปิด) ·
// #ffdbdb พื้นเพจ
//
// จังหวะรูปทรง: แผงนี้เป็นกล่องสุดท้ายของสายบทความ (docx H2 §11 "คำถามที่พบบ่อย
// เกี่ยวกับ <แบรนด์>") และเป็น **ใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางพร้อมเส้นคาด
// "ใต้" หัวข้อ** (§2 ContentBox3ThreePremium ก็กึ่งกลางแต่เส้นอยู่ "เหนือ")
// text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บน <section> จึงไม่ไหลลงไปจัด
// กึ่งกลางคำตอบในแต่ละแถว
// หัวข้อไล่ แดงคริมสัน #c30303 → หมึกเลือดหมู #4a0f0f → แดงคริมสัน #c30303
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ไม่ใช่พื้นหลัง ทุกสต็อป
// ต้องถือตัวอักษรได้ตาม §2 (6.3 / 15.4 / 6.3 บนพื้นเพจชมพูกุหลาบได้ 4.9 / 12.0 /
// 4.9 — ที่ text-2xl font-black = large text ผ่านทั้งหมด) **ห้ามเอา #e81313 มาเป็น
// สต็อป** (4.0:1 บนขาว · ตก AA และ §2 ห้ามมันถือตัวอักษรเด็ดขาด)
// เส้นกรอบแถวเป็นแดงคริมสันโปร่ง อิ่มขึ้นตอน hover พร้อมพื้นไต่ลงไปเป็นผิวกลาง
// #fff1ef เนื้อความและคำถามใช้สี BRAND_TEXT #4a0f0f (15.4:1 บนผิวขาว) คำถามเปลี่ยน
// เป็นแดงคริมสัน #c30303 (6.3:1) ตอนชี้ และเครื่องหมาย + ตอนเปิดเป็นแดงคริมสันเช่นกัน
// ⚠️ **#8f0505 สงวนไว้ให้ <strong> ในเนื้อความของหน้าเท่านั้น** จึงไม่อยู่ในไฟล์นี้
// และ **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของโครมล้วน ห้ามโผล่ในไฟล์นี้**
// (1.9–3.5:1 บนการ์ดสว่าง)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง เพราะแดงนำมาแล้ว
// มากกว่าฮิวใดในรีโปนี้** การเจอ "แดง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้ **#c30303** (R195 G3 B3) และไม่ใช่ d30304 ff6b6e a00203 4a0202
// (รับตัง168 — ตัวที่ใกล้ที่สุด ห่าง 16) b90203 8c0204 fa0513 ff5a5f ffadaf
// (สมหวัง168 — ห่าง 10) d9212a 8e1a16 (ดวงเศรษฐี168) e4021b (รวยเทพ168) fb1b32
// (มีเฮ168) b3121b (ขวัญใจ168) dc0203 f5282a (หวย365) fb131b (TKB55) fb141b (GT66B)
// d4200d (PIGPG) e8232a (SUPERSLOTCLUB) ff3b14 (FLASH877) หรือ d20a0a (หวย24)
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40, 10/95/28, 12/58/22,
// 174/176/74) และชุดทองสองเฉด-บรอนซ์ของ ufalion168 ที่เคยอยู่ทั้งใบนี้ (d4922c fdfc71
// f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3) ออกครบทุกค่าแล้ว รวมถึง
// ชุดของ มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ดวงเศรษฐี168 (d9212a
// 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) รับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) GT66B (fb141b
// ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd b4bcc2 eceaea 0b0303 130c0c 190505)
// TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206
// 53050a) KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 1d0832 140522 e2b33f ffdf8c
// ece2f8) UFA324 (e5a81b b9c2cc 231c0e 17130a 0d0b06 f0e8d4 ffe08a 7d5a07 43300a
// 464f5a) TND168 (dfa310 ffc93d ffe4a3 c9b88e f0e9dc 8a5c09 43240b 140d02) FLASH877
// (f5c518 ffdd73 ff3b14 8c0f0a 6d0804 5c0000 430000 fdf0e2) PUNPRO168 (f41571 ff5ca8
// fce343 ffd94a f0c3dc fde7f2 8a0a45 2a0012 1c0014) FAH999 (ff3fa4 ff6cbb ffd1ea
// fde8f3 f5c53d b3006a 4a0b42 2e002c) DUCK1688 (f3bb34 fde464 c8901a 8a5f08 5c3f04
// f58b2a a3510c f6ecd9) NAZA168 (fbc134 ffe87a cf9a18 cfd6e3 eef2f8 4e3406 382400
// 241700) หวยคิง (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) และ
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303
// 170504 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีทอง/เหลือง ไม่มีบรอนซ์ ไม่มีม่วง ไม่มีชมพู
// ไม่มีน้ำเงิน/ฟ้า ไม่มีส้มสด และไม่มีเงิน/โครเมียม**
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#c30303] via-[#4a0f0f] to-[#c30303] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c30303] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#c30303]/40 bg-white p-2 shadow-[0_10px_30px_rgba(74,15,15,0.14)] transition-all hover:border-[#c30303]/85 hover:bg-[#fff1ef]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#4a0f0f] transition-colors hover:text-[#c30303]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#4a0f0f]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #c30303;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
