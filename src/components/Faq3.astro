---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <span> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt บรรทัด 24-29,
// คำถาม/คำตอบสามคู่ของบรีฟเอง ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion
// เป็นตัวลิสต์อยู่แล้ว)
//
// ⚠️ คำถามอยู่ใน <span> ภายใน <summary> ไม่ใช่ <p> และไม่ใช่ heading — <summary>
// รับได้แค่ phrasing content (หรือ heading หนึ่งใบ) และการเลื่อนขึ้นเป็น heading
// จะทำให้ inventory h2/h3 ของหน้าไม่ตรงกับบรีฟทันที หัวข้อของแผงมาจาก prop
// `title` + `as` เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// LOTTOPLUS (ดรอป 2026-10-28, .claude/brand-spec-lottoplus.md §2–§4)
// **เขียวมรกตนำ · ทองอำพัน/เงินโครเมียมเป็นวัสดุที่สอง · เนื้อหาบนธีมสว่าง**
// ไฟล์นี้ถือ **docx H2 §8** ("คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>" — content.txt
// บรรทัด 23) และเป็นกล่องสุดท้ายของสายบทความบนหน้าแรก
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **เขียวป่าจมเกือบดำของ ZORO365** ทั้งใบ ซึ่งเป็น
// **ธีมมืด** ที่รอบนี้กลับทิศ 180°: bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#e1fef3"} = **เขียวมินต์จางเกือบขาว** แผงนี้จึงเป็น
// **การ์ดสว่าง + หมึกเข้ม** ⚠️ **ห้ามคงการ์ดเข้ม (073c1a / 0e5424) ของรอบก่อนไว้
// แม้แต่ใบเดียว** — หมึก #0d3326 บนการ์ดเข้มคือตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
// และ **เขียวของรอบก่อนกับเขียวของรอบนี้เป็นคนละค่าทั้งชุด** แม้จะเป็นเขียวเหมือนกัน
// ⚠️ โครมเข้มรอบนี้ (#052e22 / #03201a / #0a4433) เป็นของ navbar · footer · ticker ·
// แถบล่างมือถือ เท่านั้น **ไม่ใช่ไฟล์นี้**
// ลำดับผิว: #ffffff การ์ด (แถวปิด) · **#f0fdf7 ชั้นยก (แถว hover/open)** ·
// #d2f3e4 พื้นถมอ่อน (แป้นเครื่องหมาย +) · #a3ddc3 เส้นบาง · #e1fef3 พื้นเพจ
// (หัวข้อนั่งบนพื้นเพจตรง ๆ ไม่มีการ์ดรอง)
//
// จังหวะรูปทรง: แผงนี้เป็นใบเดียวของหน้าที่ **หัวข้อจัดกึ่งกลางพร้อมขีดใต้จาง
// สองข้าง และไม่มีการ์ดครอบหัวข้อ** ⚠️ §1 ใบสลากเส้นประหัวข้อไล่เฉดสามสต็อป ·
// §2 หัวข้อทึบชิดซ้าย + ขีดใต้ไล่เฉด · §3 มุมตัดเฉียงสันซ้ายหนา · §4 กลีฟ ✦
// นำหน้า · §5 เส้นคาดใต้หัวข้อเต็มคอลัมน์ · §6/§7 เส้นคู่บน-ล่าง
// ⚠️ `text-center` อยู่บน **ตัว HeadingTag เอง** เท่านั้น ไม่ได้อยู่บน <header>
// <section> หรือการ์ดใบไหน จึงไม่ไหลลงไปจัดกึ่งกลางคำตอบในแต่ละแถว
//
// 🚨 **หัวข้อนั่งบนพื้นเพจ #e1fef3 ไม่มีการ์ดรอง** §2 จึงอนุญาตเฉพาะค่าที่ถือ
// ตัวอักษรได้ตรงนั้น — หัวข้อ/ลิงก์ #046c4e (6.27:1) · หมึกหลัก #0d3326 (12.92:1) ·
// หมึกรอง #3f6f5c (5.60:1) · ทองเข้ม #8a6508 (5.03:1)
// **ห้าม #19a97c (3.0:1) · #2fd49b · #a3ddc3 · #d2f3e4 · #e2b32a (2.0:1 บนขาว)
// ถือตัวอักษรเด็ดขาด เป็นเส้น/ออรา/พื้นถมเท่านั้น**
//
// สีที่ใช้และเหตุผล (ทุกค่ามาจากตาราง §2 ไม่มีเฉดคิดเพิ่ม):
//   หัวข้อ — เขียวมรกต #046c4e เป็น **ตัวอักษรทึบค่าเดียว ไม่ใช่ bg-clip-text ไล่เฉด**
//   เพราะการไล่เฉดบนผิวสว่างจะลากค่าที่ห้ามถือตัวอักษร (#19a97c) เข้ามาเป็นพิกเซล
//   ของตัวอักษร
//   เส้นคาดใต้หัวข้อ — ไล่โปร่ง→#19a97c→โปร่ง ซึ่งตรงนี้เป็น **พื้นถม ไม่ใช่
//   ตัวอักษร** จึงใช้ #19a97c ได้
//   คำถาม — #046c4e (6.70:1 บนการ์ดขาว · ~6.5:1 บนชั้นยก #f0fdf7)
//   คำตอบ — #0d3326 = BRAND_TEXT (13.82:1 บนการ์ด · ~13.3:1 บนชั้นยก)
//   เครื่องหมาย + — แป้นพื้นถมอ่อน #d2f3e4 ขอบ #a3ddc3 หมึก #046c4e (5.42:1) ตอนปิด
//   และพลิกเป็น **พื้นถม #046c4e + หมึก #ffffff (6.70:1)** ตอนเปิด
//   ⚠️ **ห้ามพลิกไปถมด้วย #19a97c หรือ #e2b32a** (ขาวบนสองค่านั้นได้ 3.0:1 / 2.0:1)
//   ออรา/เงา — rgba(13,51,38,…) เงาเบาบนการ์ดสว่าง · rgba(4,108,78,…) และ
//   rgba(25,169,124,…) ตอน hover/open เท่านั้น
//   ⚠️ **เงาบนการ์ดสว่างต้องเบา** — รอบก่อนเป็นเงาดำ alpha สูงซึ่งถูกสำหรับการ์ดเข้ม
//   แต่บนการ์ดขาวจะกลายเป็นคราบเทาหนา **ห้ามลอกค่า alpha ของรอบก่อนมา**
// ⚠️ **เงินโครเมียม #c8d4d0 เป็นวัสดุของเวิร์ดมาร์ก (navbar/footer/hero)** และ
// ทองอำพัน #e2b32a เป็นพื้นถม/ออราของโครมเข้ม — **ไม่มีสองค่านั้นในไฟล์นี้เลย**
// แผงสุดท้ายอ่านเป็น **เขียวมรกตบนผิวขาว** ล้วน
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือเขียว เพราะเขียวเป็นสี
// ที่ตาแยกค่าได้ยากที่สุด และรีโปนี้มีเขียวของแบรนด์อื่นอยู่ห้าชุดขึ้นไป** การเจอ
// "เขียว" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบให้ตรงหกหลัก
// เขียวรอบนี้คือ **#046c4e #0c7c58 #03543c #19a97c #2fd49b #a3ddc3 #d2f3e4
// #f0fdf7 #e1fef3** หมึก **#0d3326 #3f6f5c** ทอง **#e2b32a #8a6508**
// และไม่ใช่ 002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 3ddc4a 23823a dfe6e3
// e8c86a eef7f0 9dc2a5 (**ZORO365 — ชุดที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ เสี่ยงหลงเหลือ
// สูงสุด** ⚠️⚠️ **0e5424 ↔ 046c4e · 1e7033 ↔ 0c7c58 · 35a043 ↔ 19a97c · 3ddc4a ↔
// 2fd49b · eef7f0 ↔ f0fdf7 — ห้าคู่นี้ใกล้ที่สุดในลิสต์ทั้งหมด**)
// ไม่ใช่ 1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 fdf0e6 e0bda4 f27a1a
// e5a92b c9d2dc (**WIN8S — แบรนด์ขาออกทันที** ⚠️ **e5a92b ↔ e2b32a**)
// ไม่ใช่ 15401d 28c437 e8fbe4 b4d6ad c6cfd2 e3bb45 0b4a12 116018 051409 10280f
// 3c5b36 f0ffeb e6f7df d7f0cd b2dba3 3f7a2e 1a7d24 8a6a0e 0b2a12 2d6b2f (**TEVA69**
// ⚠️ **116018 ↔ 046c4e · 1a7d24 ↔ 0c7c58 · 28c437 ↔ 19a97c · 3c5b36 ↔ 3f6f5c**)
// ไม่ใช่ 0c3a16 0a5f1c 0b7d28 061f0c 0f9b35 (**สาธุ168**) ไม่ใช่ 143a1c 1fae1c
// 07130a 0d2312 (888PARUAY) ไม่ใช่ 1a5c04 2f8c07 8ce023 e9f7d6 bde397 (KINGKONG555)
// ไม่ใช่ 2fbf6a (KOON234) ไม่ใช่ 117a41 2bb061 de2b1e f2a033 a81410 c81e12 9d140c
// 6f0e08 3f130d 2b100a f6c4a4 fde4d3 fdeee2 fff3ea fef6fb (**MEXICANOSLOT**)
// ไม่ใช่ a30d1a 8a1420 c21325 36080f 6b2b33 7a4a0c dca53a d2d7dd fdf5f6 f7dfe4
// eec3cc d98fa0 f7e4e9 (**123BET**) ไม่ใช่ fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f
// 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c c3ccd6
// (**LOTTO189 — แบรนด์หวยเหมือนกัน**) ไม่ใช่ 7a1bd6 c2178b bb6dff 190b3d f3e8ff
// (ZANE96) ไม่ใช่ 7a3a0c e0b784 c98a24 fa4903 d8dde6 (ZNOVA168)
// ไม่ใช่ cd9a2c fdeb7c ab7314 dc0409 f5363d 8e0206 dc0203 f5282a ffc93c ffeab0
// cf1111 e01f26 ffd94a e3a712 d4922c dde1e7 (**แดง/ทองของแบรนด์หวยเจ้าก่อน ๆ**)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง/ส้ม/พีช ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง ไม่มีชมพู/ฟูเชีย
// ไม่มีครีม/งาช้าง และไม่มีแรมป์เทาเงินในไฟล์นี้**
// ✅ LINE green 00B900 กับเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืน
// เข้าเขียวมรกตของรอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8">
        <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#046c4e] md:text-3xl">{title}</HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#19a97c] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#a3ddc3] bg-white p-2 shadow-[0_10px_30px_rgba(13,51,38,0.10)] transition-all hover:border-[#19a97c] hover:bg-[#f0fdf7]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#046c4e]">
            <span class="block text-left text-base leading-relaxed font-bold">{faq.q}</span>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#a3ddc3] bg-[#d2f3e4] text-xl leading-none text-[#046c4e] transition-all duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#0d3326]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: #19a97c;
    background-color: #f0fdf7;
    box-shadow:
      0 12px 34px rgba(4, 108, 78, 0.18),
      0 0 0 1px rgba(25, 169, 124, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #03543c;
    background-color: #046c4e;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
