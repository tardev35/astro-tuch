---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// หวย24 (รอบแดงแบรนด์-ทอง บนดำอมแดง 2026-10-04): แผงพื้นการ์ดเป็นดำอมแดง #170707
// ในเส้นกรอบ #3d0a0a ที่สว่างขึ้นเป็นแดงแบรนด์ #d20a0a ตอน hover พร้อมพื้นไต่ขึ้นเป็น
// ผิวการ์ดอุ่น #230d0d หัวข้อไล่ทองสว่าง #ffd45e → ทองแบรนด์ #f5c33b → แดงสว่าง
// #ff5c5c ตามโลโก้ที่ตัวอักษร หวย เป็นขาวโครเมียมและวงกลม 24 เป็นแดง ส่วนแบนเนอร์
// เป็นทองบนผ้าไหมแดง — ลำดับนี้ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักตัว เนื้อความใช้สี
// BRAND_TEXT #f7e2d6 คำถามสว่างขึ้นเป็นทองสว่างตอนชี้ และเครื่องหมาย + ตอนเปิด
// เป็นทองแบรนด์
//
// ชุดทอง-เงินโครเมียมของ 1SS365 ที่เคยค้างในไฟล์นี้ (#edbb23 #ffeeb4 #c8cbce
// #121010 #2a2115 #1a1710 #f0e6d2) ออกครบทุกจุดแล้ว
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#ff5c5c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c33b] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay24"
          class="faq-item rounded-3xl border border-[#3d0a0a] bg-[#170707]/90 p-2 shadow-[0_10px_30px_rgba(5,2,2,0.7)] backdrop-blur-xl transition-all hover:border-[#d20a0a]/70 hover:bg-[#230d0d]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f7e2d6] transition-colors hover:text-[#ffd45e]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f7e2d6]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f5c33b;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
