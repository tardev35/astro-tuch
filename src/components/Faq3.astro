---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แผงพื้นการ์ดเป็นพื้นส่วน #1c0606 ใน
// เส้นแดงเข้มสุด #5c0a0a ที่สว่างขึ้นเป็นทองรอง #f4bc5d ตอน hover พร้อมพื้นไต่ขึ้น
// เป็นผิวการ์ด #2b0909 หัวข้อไล่แดงสว่าง #e43434 → ทองอ่อน #ffefc2 → ทองรอง ตาม
// โลโก้ที่คำว่า "หวย" เป็นแดงและ "เฮง789" เป็นทอง — ลำดับนี้ไม่ซ้ำกับกล่องอื่นบน
// หน้าเดียวกันสักตัว เนื้อความใช้สี BRAND_TEXT #fbe3d4 คำถามสว่างขึ้นเป็นทองอ่อน
// ตอนชี้ และเครื่องหมาย + ตอนเปิดเป็นทองรอง
//
// ชุดเขียวนีออน-โครเมียมของ CK268 ที่เคยค้างในไฟล์นี้ (#8bfc13 #c9ff8f #1a7a08
// #e8f0e6 #0b160b #0f1b0e #d5e6cd) ออกครบทุกจุดแล้ว
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#e43434] via-[#ffefc2] to-[#f4bc5d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dc2224] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huayheng789"
          class="faq-item rounded-3xl border border-[#5c0a0a] bg-[#1c0606]/90 p-2 shadow-[0_10px_30px_rgba(11,2,2,0.7)] backdrop-blur-xl transition-all hover:border-[#f4bc5d]/70 hover:bg-[#2b0909]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#fbe3d4] transition-colors hover:text-[#ffefc2]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#fbe3d4]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f4bc5d;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
