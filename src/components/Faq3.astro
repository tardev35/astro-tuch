---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <p> — the docx's H3 tier belongs to the two
   *  bonus sub-sections only, so an FAQ must not add another one. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): แผงพื้นการ์ดดำอมม่วง #170a22 ใน
// เส้นชมพูลึก #4a0e33 ที่สว่างขึ้นเป็นชมพูแบรนด์ #fa42b5 ตอน hover หัวข้อไล่จากชมพู
// อ่อนมาก #ffd6f0 → ชมพูแบรนด์ #fa42b5 → ม่วงแบรนด์ #8b3df3 ตามโลโก้ที่คำว่า SEXY
// เป็นชมพูบานเย็น GAME ไล่ไปม่วง แล้วปิดที่ 666 ซึ่งกลับมาเป็นชมพู เนื้อความใช้สี
// BRAND_TEXT #f2dcee และเครื่องหมาย + ตอนเปิดเป็นชมพูแบรนด์ — ชุดทอง-ดำของ
// KINGDOM66 (#e6bf4e #efe6cf #f2d683 #f5e196 #5c4113 #151109 #0c0b09 #ebe3d3)
// ออกทั้งหมด
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <HeadingTag class="bg-gradient-to-r from-[#ffd6f0] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fa42b5] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-sexygame666"
          class="faq-item rounded-3xl border border-[#4a0e33] bg-[#170a22]/90 p-2 shadow-[0_10px_30px_rgba(8,2,13,0.7)] backdrop-blur-xl transition-all hover:border-[#fa42b5]/70 hover:bg-[#12041c]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f2dcee] transition-colors hover:text-[#ffb3e2]">
            <p class="text-left text-base leading-relaxed font-bold">{faq.q}</p>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f2dcee]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #fa42b5;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
