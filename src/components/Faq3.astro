---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The title comes from the docx heading, so it renders as a real heading.
   *  The questions below it stay <span> — promoting a <summary> to a heading is
   *  what makes the rendered h2/h3 inventory stop matching the brief. */
  as?: "h2" | "h3" | "h4";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;
const sectionLabel = title ?? "คำถามที่พบบ่อย";
// `name` on <details> gives the exclusive-accordion behaviour natively, so this
// FAQ needs no <script> at all. The value only has to be unique on the page, so
// it is deliberately BRAND-NEUTRAL — an older copy of this family shipped
// `faq-789betting`, which is a previous brand's name baked into rendered HTML
// that no rebrand's colour sweep would ever look at. Do not put a brand in it.
//
// `faqs` ships with NO default on purpose: a forgotten prop then renders an
// empty accordion instead of some previous brand's questions. index.astro hands
// it the same array the FAQPage node is built from (content.txt บรรทัด 24-29,
// คำถาม/คำตอบสามคู่ของบรีฟเอง ตัดเฉพาะหมายเลข "1." "2." "3." ออกเพราะ accordion
// เป็นตัวลิสต์อยู่แล้ว)
//
// ⚠️ คำถามอยู่ใน <span> ภายใน <summary> ไม่ใช่ <p> และไม่ใช่ heading — <summary>
// รับได้แค่ phrasing content (หรือ heading หนึ่งใบ) และการเลื่อนขึ้นเป็น heading
// จะทำให้ inventory h2/h3 ของหน้าไม่ตรงกับบรีฟทันที
//
// ───────────────────────────────────────────────────────────────────────────
// MEXICANOSLOT (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-mexicanoslot.md §2
// **แดงเม็กซิกันนำ · ทอง/พีชฟางเป็นวัสดุที่สอง · เนื้อหาเป็นธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจลบนดำอมแดงของ สล็อต168** ทั้งใบ — ซึ่งเป็น
// กับดักที่แหลมที่สุดของรอบนี้ เพราะ "มันก็แดงอยู่แล้ว" **แต่เป็นแดงคนละค่าทั้งชุด
// และเป็นธีมมืดซึ่งรอบนี้กลับทิศ**: bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#fef6fb"} = **ขาวอมชมพูจาง** แผงนี้จึงเป็น
// **การ์ดสว่าง + หมึกเข้ม** ⚠️ **ห้าม "แก้" กลับไปเป็นการ์ดมืด** — การ์ดมืดกับหมึก
// #3f130d จะทำให้ตัวอักษรหายไปทั้งแผง ไม่ใช่แค่จางลง
// ลำดับผิว: #ffffff การ์ด (แถวปิด) · **#fff3ea ยก (แถว hover + แป้นเครื่องหมาย +)** ·
// #fde4d3 wash · #fef6fb พื้นเพจ
//
// จังหวะรูปทรง: แผงนี้เป็นกล่องสุดท้ายของสายบทความ (docx H2 §8 "คำถามที่พบบ่อย
// เกี่ยวกับ <แบรนด์>" — content.txt บรรทัด 23) และเป็นใบเดียวของหน้าที่ **หัวข้อ
// จัดกึ่งกลางพร้อมขีดใต้จางสองข้าง และไม่มีการ์ดครอบหัวข้อ** ⚠️ §2 ก็จัดกึ่งกลาง
// เหมือนกัน แต่แถบของ §2 อยู่ **เหนือ** หัวข้อและอยู่ในการ์ดมุมตัด
// ⚠️ `text-center` อยู่บน **ตัว HeadingTag เอง** เท่านั้น ไม่ได้อยู่บน <header>
// <section> หรือการ์ดใบไหน จึงไม่ไหลลงไปจัดกึ่งกลางคำตอบในแต่ละแถว
//
// 🚨 **หัวข้อนี้นั่งบนพื้นเพจ #fef6fb ตรง ๆ ไม่มีการ์ดรอง** §2 จึงอนุญาตเฉพาะ
// #3f130d (14.4:1) หรือ **#a81410 (7.3:1)** เท่านั้นตรงนั้น — **ห้าม #de2b1e
// (3.9:1) เด็ดขาด**
//
// สีที่ใช้และเหตุผล (ทุกค่ามาจากตาราง §2 ไม่มีเฉดคิดเพิ่ม):
//   หัวข้อ — แดงลึก #a81410 เป็น **ตัวอักษรทึบค่าเดียว ไม่ใช่ bg-clip-text ไล่เฉด**
//   เพราะการไล่เฉดบนผิวสว่างจะลากค่าที่อ่านไม่ออก (#de2b1e / #f2a033) เข้ามาเป็น
//   พิกเซลของตัวอักษรได้ง่ายเกินไป
//   เส้นคาดใต้หัวข้อ — ไล่โปร่ง→#de2b1e→โปร่ง ซึ่งตรงนี้เป็น **พื้นถม ไม่ใช่ตัวอักษร**
//   คำถาม — #a81410 (7.6:1 บนการ์ดขาว · 7.2:1 บนผิวยก) · คำตอบ — #3f130d =
//   BRAND_TEXT (14.9:1 บนการ์ดขาว)
//   เครื่องหมาย + — แป้นอินเซ็ต #fff3ea ขอบ #f6c4a4 หมึก #a81410 ตอนปิด และพลิกเป็น
//   **พื้นถม #c81e12 + หมึกขาว (5.7:1)** ตอนเปิด ซึ่งเป็นคู่ที่ §2 ระบุไว้ตรง ๆ
//   สำหรับพื้นแดงที่รับหมึกขาว **ห้ามพลิกไปใช้ #de2b1e (ขาวบนมันได้แค่ 4.7:1)**
// ⚠️ **ทอง #f2a033 และเขียว #117a41 เป็นวัสดุของ §2/§4/§5/§7 บนหน้าเดียวกัน**
// จึงไม่โผล่ในไฟล์นี้เลยสักค่า เพื่อให้แผงสุดท้ายอ่านเป็นแดงล้วน ·
// **#a81410 ในย่อหน้าเนื้อความเป็นงานของ <strong> บนหน้าเพจ**
// ⚠️ **#f2543f / #2bb061 / #fdeee2 / #2b100a เป็นสีของโครมเข้ม (navbar/footer/
// ticker) เท่านั้น ห้ามหลุดเข้ามาในไฟล์นี้**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง เพราะรีโปนี้มีแดง
// ของแบรนด์อื่นอยู่หกชุดขึ้นไป** การเจอ "แดง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้คือ **#de2b1e (R222 G43 B30) / #a81410 / #c81e12 / #9d140c / #6f0e08**
// และไม่ใช่ fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607 2a0c0d 551c1e 140000 0b0000
// f0e6e4 c9b9b7 e3d6d4 7d6f6e (**สล็อต168 — ชุดที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ**
// ⚠️⚠️ **fb2e33 ↔ #de2b1e ตระกูลเดียวกันและความอิ่มใกล้กัน · cb0b0d / b00d11 ↔
// #c81e12 / #a81410 · 1c0607 ↔ #2b100a ฐานโครมรอบนี้ · f0e6e4 ↔ #fdeee2 หมึกโครม
// รอบนี้ — ทั้งสี่คู่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ**)
// ไม่ใช่ ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5
// ffc2e2 d91a73 b01160 85094a (**okkub88 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด**)
// ไม่ใช่ 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0f5684 1a6ea8 (โบ๊ะบ๊ะ168)
// ไม่ใช่ ff2e52 e01238 c9102f (มาดาม168) ไม่ใช่ c30303 8f0505 e81313 dcb95f 280b0b
// (รวยแท้168) ไม่ใช่ d9212a 8e1a16 f0c878 fff8d8 150303 4e2120 300605 (ดวงเศรษฐี168)
// ไม่ใช่ fb141b ff5f63 ffa0a2 (GT66B — ⚠️ ห่างจากค่าของรอบนี้หนึ่งก้าว **เจอแล้ว
// แปลว่าพิมพ์ผิด**) ไม่ใช่ eb0305 c20305 9b0a0c ff4446 b44c06 f0b46a (โปรดี168 /
// NavbarStyle4) ไม่ใช่ fa0513 ff5a5f ffadaf (สมหวัง168) ไม่ใช่ b3121b f2bba5
// (ขวัญใจ168) ไม่ใช่ fb1b32 ff8f9c 5c0410 (มีเฮ168) ไม่ใช่ e4021b (รวยเทพ168)
// ไม่ใช่ d30304 a00203 (รับตัง168) ไม่ใช่ dc0203 f5282a (หวย365) ไม่ใช่ ff3b14
// 6d0804 2b0000 (FLASH877) ไม่ใช่ fa539c c2185b 8e0f41 fb8cc0 f7bcd9 ffe5ff fff0f8
// ffeef7 3b0b26 (หมูบิน168) และไม่ใช่ 18a5e2 0d6b9b a9d7f2 16294a (ร่ำรวย168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง ไม่มีชมพู/ฟูเชีย ไม่มีแรมป์เทาเงิน
// และไฟล์นี้ยังไม่มีทอง/เขียวด้วย** (ทอง #f2a033 กับเขียว #117a41 อยู่กล่องอื่น)
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8">
        <HeadingTag class="text-center text-2xl leading-normal font-black tracking-wide text-[#a81410] md:text-3xl">{title}</HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#de2b1e] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-accordion"
          class="faq-item rounded-3xl border border-[#f6c4a4] bg-white p-2 shadow-[0_10px_30px_rgba(63,19,13,0.1)] transition-all hover:border-[#de2b1e] hover:bg-[#fff3ea]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#a81410]">
            <span class="block text-left text-base leading-relaxed font-bold">{faq.q}</span>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#f6c4a4] bg-[#fff3ea] text-xl leading-none text-[#a81410] transition-all duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#3f130d]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #c81e12;
    background-color: #c81e12;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
    .faq-icon {
      transition: none;
    }
  }
</style>
