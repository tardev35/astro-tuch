---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-28 จริง (เปิดอ่านด้วย Read ก่อนเขียน
// **500x500 จัตุรัส**) — เวิร์ดมาร์กเฉียงตัดขอบขาวที่มีริ้ววงโค้งทองเป็นฉากของ
// ZNOVA168 รอบก่อนไม่มีอยู่ในรูปรอบนี้เลยสักอย่าง รอบนี้เป็นตราสัญลักษณ์ทรงกลม
// ที่มีเวิร์ดมาร์กวางทับ ไม่ใช่เวิร์ดมาร์กล้วน
// ⚠️⚠️ **อาร์ตเวิร์กพิมพ์ชื่อแบรนด์อีกชื่อไว้บนรูปจริง** (ไฟล์โลโก้ของดรอปนี้ยัง
// เป็นเวิร์ดมาร์กของแบรนด์ก่อน ส่วนแบนเนอร์กับสไลด์เป็นของรอบนี้แล้ว) — alt จึง
// บรรยาย **รูปทรงและวัสดุของตราสัญลักษณ์** แล้วอ้างชื่อด้วย ${BRAND_NAME} เท่านั้น
// **ห้ามพิมพ์ตัวอักษรที่เห็นบนรูปลงใน alt เด็ดขาด** ไม่งั้นชื่อแบรนด์อื่นจะหลุด
// ขึ้น dist/ ทุกหน้า (โลโก้ขึ้นทุกหน้าใน header จึงเป็นจุดรั่วที่กว้างที่สุด
// รองจาก hero alt)
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตราสัญลักษณ์ทรงกลมผิวหินสีดำแตกลายที่มีเสาโทริอิแบบญี่ปุ่นตั้งอยู่ตรงกลาง มีมังกรตัวยาวเกล็ดเงินพ่นเปลวไฟสีส้มพันรอบ และมีดาบใบตรงประดับตราวงกลมสีทองปักลงกลางภาพ ด้านหน้าเป็นตัวอักษรสามมิติตัวหนาวางเฉียงเล็กน้อย ครึ่งแรกเป็นผิวส้มเพลิงไล่เป็นทองหลอมเหลวตัดขอบดำและมีไฮไลต์ขาววาบตามสัน ครึ่งหลังเป็นผิวโครเมียมเงินขัดเงาไล่จากเงินสว่างลงมาหาเทาเข้ม รอบตราสัญลักษณ์มีกลีบดอกซากุระสีชมพูอ่อนปลิวกระจายและมีประกายไฟสีส้มกระเด็นอยู่ตามขอบ`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// ไม่มี /ตรวจหวย กับ /แนวทาง รอบนี้: WIN8S เป็น **เว็บคาสิโนออนไลน์เน้นบาคาร่า**
// ไม่ใช่เว็บหวย และบรีฟรอบนี้ **ไม่มีคำว่าหวยเลยสักคำ** (ต่างจากรอบก่อนที่หวยเป็น
// หนึ่งในเจ็ดหมวดเกม) สองหน้านั้นจอดอยู่ใน src/pages-disabled/ ลิงก์ทั้งคู่จึงไม่มี
// ในเมนู ถ้าเติมเข้ามา verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route
// ที่ไม่มีจริง
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และม่านมือถือ
// จากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไอคอนเลือกให้ตรงหมวดของรอบนี้ (บาคาร่า/คาสิโนสด/สล็อต + โปรโมชั่น + ความ
// น่าเชื่อถือ/ลิขสิทธิ์) และทุกตัวอยู่ใน <span aria-hidden="true"> แยกจาก label
// เสมอ ไม่เคยฝังอยู่ในข้อความ
// ⚠️ 🎰 ของรอบก่อน (ZNOVA168 — เว็บสล็อตล้วน) เปลี่ยนเป็น 🃏 รอบนี้ เพราะบรีฟ
// รอบนี้นำด้วย **บาคาร่า** ไม่ใช่สล็อต — ไอคอนต้องเป็นของรอบนี้เหมือนสี
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🛡️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// WIN8S (รอบส้มเพลิงนำ-ทองอำพันรอง บนดำอมเลือดหมู 2026-10-28): ไฟล์นี้ถูกเลื่อน
// ขึ้นมาเป็น navbar ที่ใช้งานจริงรอบนี้ แทน NavbarPremium ของ 123BET —
// หนึ่งไฟล์ต่อรอบ
// ทรงของไฟล์นี้คือ **แถบ sticky สูง 70px (lg 85px) คุมความกว้างที่ max-w-[1600px]
// + ม่านมือถือที่เปิดด้วย clip-path วงกลมจากปุ่มแฮมเบอร์เกอร์ แล้วไล่รายการขึ้น
// ทีละตัว** ซึ่งคนละแกนกับ NavbarPremium รอบก่อน (แถบเต็มความกว้างสูง 85px
// ที่โค้งมุมล่าง rounded-b-2xl + drawer กางลงมาจากใต้แถบ) ทั้งบนเดสก์ท็อปและมือถือ
//
// พาเลตต์ตาม .claude/brand-spec-win8s.md §2: **ส้มเพลิงเป็นฮิวนำ**
// (#f27a1a / #f0a21e คือตัวอักษรสี่ตัวแรกบนเวิร์ดมาร์ก ข้อความสามมิติบนแบนเนอร์
// และแถบสีทองสาดในภาพ) **ทองอำพันเป็นฮิวที่สอง** (#e5a92b คือขอบตัวอักษร
// มงกุฎบนตราสัญลักษณ์ และกรอบแคปซูลบนสไลด์) และ **โครเมียมเงิน #c9d2dc เป็น
// วัสดุที่สาม** (ตัวอักษรตัวสุดท้ายของเวิร์ดมาร์ก และเกล็ดมังกรบนโลโก้)
// ⚠️ นี่คือการ **สลับฮิวทั้งชุด** จากรอบก่อนที่แดงชาดนำ เงิน/ทองรอง
//
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน: มืดทั้งเว็บ** bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#1e0101"} = **ดำอมเลือดหมูเกือบสนิท** ส่วนแถบนี้
// ไล่ #140302 → #3b130b → #140302 ซึ่งเป็นผิวโครมที่ **สว่างกว่าพื้นเพจหนึ่งระดับ**
// ⚠️⚠️ **ต่างจากรอบก่อนตรงนี้พอดี**: รอบก่อนพื้นเพจสว่าง (f7e4e9) แถบเข้มจึงแยก
// ตัวออกจากหน้าด้วยความต่างของความสว่างเอง **รอบนี้หน้าก็เข้ม** สิ่งที่บอกว่าแถบ
// เริ่มตรงไหนคือ **เส้นขอบล่างสีทองอำพันกับเงาใต้แถบ**
// **ห้ามถอด border-b ออก และห้ามทำให้แถบจมจนเท่าพื้นเพจ**
// ⚠️ **และห้าม "แก้" ให้แถบสว่างตามอาร์ตเวิร์ก** — แบนเนอร์รอบนี้เป็นห้องญี่ปุ่น
// โทนขาวงาช้างที่สว่างมาก แต่นั่นเป็น **วัตถุในภาพ** พื้นเพจมาจาก bg.json เท่านั้น
// ถ้าทำแถบสว่าง ตัวอักษร #fdf0e6 จะเหลือ ~1:1 และหายไปทั้งแถบ
// ขอบและเส้นคั่นเป็นทองอำพัน #e5a92b อัลฟาต่ำ ข้อความ active เป็นทองอำพันเต็มค่า
// (7.8:1 บนสต็อปสว่างสุดของแถบ #3b130b) ข้อความปกติเป็นครีมอุ่น #fdf0e6 (14.6:1)
// ขีดใต้เมนู active ไล่ โครเมียม #c9d2dc → ทองอำพัน #e5a92b → ส้มลึก #e8620e
// ซึ่งคือสามวัสดุของเวิร์ดมาร์กเรียงตามลำดับที่ตาอ่านจริง (ตัวอักษรตัวสุดท้าย
// โครเมียม → ขอบทอง → ผิวส้มเพลิงของสี่ตัวแรก)
// ออร่ากลมหลังโลโก้เป็นส้มเพลิง #f27a1a เรืองแสงใต้โลโก้เป็น rgba(229,169,43,α)
// ⚠️⚠️ **แผ่นถมใต้เมนู hover/active เป็น #5a2410 ไม่ใช่ #8a3a12** — ตรวจแล้ว:
// ตัวอักษร active #e5a92b บน #5a2410 ได้ 5.9:1 (ผ่าน) แต่บน #8a3a12 เหลือ 3.7:1
// (ตก AA) **ห้ามสลับสองค่านี้เพราะ "ดูเข้มพอกัน"**
//
// ปุ่ม "สมัครสมาชิก" เป็นอันเดียวในแถบที่เป็นพื้น **ส้ม-ทองทึบ** (#f0a21e → #e8620e)
// ให้ปุ่ม conversion เด่นออกจากพื้นเกือบดำทั้งแถบ ส่วน "เข้าสู่ระบบ" เป็นปุ่มโครง
// **โครเมียม** ไม่ทึบ จะได้ไม่แย่งสายตากันเอง และคู่ปุ่มต่างกันที่ "พื้นส้มตัน
// vs กรอบเงิน" ซึ่งคือสองวัสดุของเวิร์ดมาร์กจริง ไม่ใช่ความสว่างสองระดับของสีเดียว
// — และการให้ส้มเป็นตัวทึบคือสิ่งที่ทำให้ฮิวนำของรอบนี้อยู่บนปุ่มที่คนกดจริง
// หมึกบนปุ่มส้มเป็น #1e0101 — ตรวจแล้วทั้งสองสต็อป:
// บน #f0a21e 9.3:1 · บนสต็อปเข้มสุด #e8620e 5.8:1
// 🚨🚨 **ทิศของหมึกบนปุ่มนี้กลับด้านจากรอบก่อน** — รอบก่อนปุ่มเป็นแดงชาดเข้มจึงรอง
// หมึกขาวได้ (ขาวบน a30d1a = 8.0:1) **รอบนี้ปุ่มเป็นส้ม-ทองสว่าง หมึกขาวบนนั้น
// เหลือ 2.8:1 — ห้ามใช้ขาวเด็ดขาด**
// ⚠️⚠️ **ปุ่มส้ม+หมึกเข้มของแถบนี้ ใช้ชุดเดียวกับ CTA หลักในเนื้อหารอบนี้** เพราะ
// **รอบนี้เนื้อหาก็เป็นผิวเข้มเหมือนโครม** — ต่างจากรอบก่อนที่ต้องแยกสองชุด
// (ปุ่มโครม vs ปุ่มบนการ์ดขาว) **รอบนี้ไม่มีการ์ดขาวในเว็บเลย**
// ⚠️ ห้ามลากสต็อปเข้มลงไปถึง #8a3a12 ใต้ตัวอักษร — ค่านั้นเป็นเส้น/ออรา/พื้นถม
// เท่านั้น เอามารองหมึก #1e0101 จะเหลือ ~2.5:1
//
// ⚠️⚠️ **กับดักรอบนี้คือส้มกับทอง และไฟล์นี้ค้างสีของแบรนด์อื่นมาแล้วหลายชั้น**
// ชุดทองหลอมเหลว-โครเมียมเงินของ **ZNOVA168 ซึ่งเป็นเจ้าของไฟล์นี้ล่าสุดและเป็น
// ตระกูลสีเดียวกับรอบนี้เป๊ะ** (e8a000 fde90b fa4903 b8300a 7a3a0c d8dde6 8f9aa8
// 0e0602 2b1608 fff3e0 2a1206 9a2a00 d13800 rgba(232,160,0,α) rgba(143,154,168,α))
// ชุดทองคานารี-โครเมียมเงินของ ยูฟ้า168 (fee45d e6a416 b8780d eae3d4 e8ecf1 a8b2bf
// 78828f 5a6472 0a0908 1e1a13 7a4e05 140e02) ชุดแดงชาด-ทองเนยของ มีเฮ168 (fb1b32
// ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1b0308 0c0205 ffe3e6 ffeec0) ชุดฟ้าบับเบิล-ทอง
// ของ สบายเบท168 (2f9ff5 a8dcff e8f4ff ffc82e 5c4a16 0b3f78 0e2238 04121f 040d16)
// ชุดทองไทยนำ-แดงมังกรรองของ รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202
// 9a6c0c cfd9e6 f5ece0 2b100f 140505) ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 (fb131b
// ff8a8f ff4d55 e9eef4 f2e4e5 2a0d0f) และชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571
// ff5ca8 fce343 ffc554 fde7f2 8a0a45) ออกครบทุกจุดแล้ว
// 🚨🚨 **และชุดแดงชาด-ทองอำพัน-เงินโครเมียมของ 123BET รอบก่อนทันที (a30d1a c21325
// 8a1420 ef4a5e dca53a 7a4a0c d2d7dd 36080f 6b2b33 330710 1c050b 4d0c18 fdf5f6
// f7e4e9 f7dfe4 eec3cc d98fa0) ห้ามเหลือแม้แต่ค่าเดียว**
// 🚨🚨 การเจอ "ส้ม" หรือ "ทอง" ตรงนี้จึงไม่พิสูจน์ว่าเป็นของรอบนี้ — ส้มรอบนี้คือ
// **#f27a1a (R242 G122 B26)** กับ **#e8620e (R232 G98 B14)** ซึ่ง **ไม่ใช่**
// fa4903 / c23400 / d13800 / 9a2a00 ของ ZNOVA168 (เพิ่งอยู่ในไฟล์นี้เอง —
// **ใกล้ที่สุดในลิสต์ทั้งหมด ถ้า grep เจอแปลว่าพิมพ์ผิด**) ไม่ใช่ f2543f /
// e2855c ของ MEXICANOSLOT และไม่ใช่ ff5a5f / ef4a5e
// ส่วนทองรอบนี้คือ **#e5a92b (R229 G169 B43)** กับ **#f0a21e (R240 G162 B30)**
// ซึ่ง **ไม่ใช่** e8a000 / fde90b ของ ZNOVA168 (ห่างจาก #e5a92b แค่ R4/G9/B43 —
// ใกล้มาก ต้องเทียบเป็นค่า) ไม่ใช่ dca53a ของ 123BET (ห่างแค่ R7/G8/B15 —
// **ใกล้ที่สุดในลิสต์**) ไม่ใช่ e0b03a / e3bb45 ของ TEVA69 ไม่ใช่ e9b53c ของ
// LOTTO189 ไม่ใช่ fee45d / e6a416 ของ ยูฟ้า168 ไม่ใช่ f2a033 ของ MEXICANOSLOT
// ไม่ใช่ fcd45c ของ มีเฮ168 ไม่ใช่ ffc82e ของ สบายเบท168 ไม่ใช่ f0b429 ของ
// รับตัง168 ไม่ใช่ ffd84d ของ ถอนชัวร์168 ไม่ใช่ fcd434 ของ มีโชค168 ไม่ใช่
// f7c92b ของ ขวัญใจ168 ไม่ใช่ fce343 ของ PUNPRO168 ไม่ใช่ fef54b ของ นินจา168
// ไม่ใช่ e5a81b ของ UFA324 และไม่ใช่ d39c45 ของ ufalion168 — อย่าปล่อยของเก่าไว้
// เพราะ "ดูคล้ายกัน" ให้เทียบเป็นค่าทีละตัวกับตารางใน brand-spec §2
// ส่วนโครเมียมรอบนี้คือ **#c9d2dc** ซึ่ง **ไม่ใช่** d8dde6 / 8f9aa8 ของ ZNOVA168
// (เพิ่งอยู่ในไฟล์นี้) ไม่ใช่ d2d7dd ของ 123BET ไม่ใช่ c3ccd6 ของ LOTTO189
// ไม่ใช่ e8ecf1 / a8b2bf / 78828f ของ ยูฟ้า168 ไม่ใช่ 8792a0 / b9c2cc ของ UFA324
// ไม่ใช่ cfd9e6 ของ รับตัง168 และไม่ใช่ e9eef4 ของ TKB55
// รอบนี้ไม่มีม่วง ไม่มีฟ้า/น้ำเงิน ไม่มีชมพู/แมเจนต้า ไม่มีเขียว และไม่มีแดงชาด
// (แดงที่เห็นในแบนเนอร์เป็น **กิโมโนและซากุระในภาพ** ไม่ใช่สี UI)
// (เฮกซ์ของแบรนด์เก่าเขียนแบบ **ไม่มี #** โดยตั้งใจ เพื่อไม่ให้ sweep สะดุดที่นี่)
//
// โลโก้คง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky) แต่ไม่มี
// fetchpriority="high" — LCP คือ hero banner ใน MainLayout มีภาพเดียวที่ได้ high
// ⚠️ **บิตแมปของดรอปนี้เป็น 500x500 จัตุรัส** (วัดจากเฮดเดอร์ VP8X ของไฟล์เอง)
// โลโก้จึงถูกวาดกว้าง 40px (lg 50px) เท่าความสูง ไม่ใช่ 110px แบบเวิร์ดมาร์กแนวนอน
// ของรอบก่อน — widths/sizes ชุดนี้คิดจากความกว้างที่ถูกวาดจริง **ให้วัดใหม่ทุกรอบ**
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#e5a92b]/45 bg-gradient-to-r from-[#140302] via-[#3b130b] to-[#140302] shadow-[0_4px_25px_rgba(0,0,0,0.92)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#f27a1a]/30 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            widths={[40, 50, 80, 100, 150]}
            sizes="(min-width: 1024px) 50px, 40px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(229,169,43,0.55)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-0.5 lg:flex xl:gap-2">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold transition-all duration-300 xl:px-3 ${isActive(link.path) ? "text-[#e5a92b]" : "text-[#fdf0e6]/80 hover:text-[#e5a92b]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#5a2410]/85 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#c9d2dc] via-[#e5a92b] to-[#e8620e] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#c9d2dc]/80 px-6 py-2.5 text-sm font-bold text-[#c9d2dc] shadow-[0_0_10px_rgba(201,210,220,0.22)] transition-all hover:border-[#c9d2dc] hover:bg-[#5a2410]/60 hover:text-[#fdf0e6] xl:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#f0a21e] to-[#e8620e] px-6 py-2.5 text-sm font-extrabold text-[#1e0101] shadow-[0_0_20px_rgba(242,122,26,0.5)] transition-all hover:scale-105 hover:brightness-110 xl:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#e5a92b] bg-gradient-to-tr from-[#3b130b] to-[#8a3a12] shadow-[0_0_15px_rgba(229,169,43,0.5)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#e5a92b] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#e5a92b] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#e5a92b] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center overflow-y-auto bg-[#140302]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-3 px-6 py-8">
      <Picture
        src={mainLogo!}
        alt=""
        aria-hidden="true"
        widths={[50, 100, 150]}
        sizes="50px"
        class="menu-item mb-2 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(229,169,43,0.6)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-lg font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#e5a92b] drop-shadow-[0_0_8px_rgba(229,169,43,0.8)]" : "text-[#fdf0e6]/80 hover:text-[#e5a92b]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            <span>{link.name}</span>
          </a>
        ))
      }

      <div class="menu-item mt-3 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#e5a92b]/50 pt-6 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#f0a21e] to-[#e8620e] py-3.5 text-lg font-extrabold text-[#1e0101] shadow-[0_0_20px_rgba(242,122,26,0.5)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิก</span>
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#c9d2dc]/80 py-3.5 text-lg font-bold text-[#c9d2dc] hover:bg-[#5a2410]/60">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.24s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.28s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.32s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.36s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.44s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.48s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.52s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
