---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-10 จริง — หัวหมูการ์ตูนกับป้ายแล็กเกอร์
// แดงของ PIGPG ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเหรียญกลมขอบทองหนาเงาวาว พื้นในเหรียญเป็นแดงเข้มไล่เงา มีสายฟ้าขนาดใหญ่สีทองไล่ส้มผ่าทแยงจากมุมขวาบนลงมามุมซ้ายล่างทะลุขอบเหรียญออกไปทั้งสองด้าน และมีประกายไฟแลบรอบสายฟ้า ด้านหน้าคาดคำว่า FLASH เป็นตัวอักษรละตินหนาสามมิติสีทองไล่เงาตัดขอบเข้ม ต่อด้วยตัวเลข 877 สามมิติสีแดงสดตัดขอบเข้ม วางพาดกลางเหรียญในแนวเอียงขึ้นเล็กน้อยไปทางขวา`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// ไม่มี /ตรวจหวย กับ /แนวทาง รอบนี้: FLASH877 เป็นเว็บตรงฐานสล็อตหลัก ไม่ใช่
// เว็บหวย สองหน้านั้นถูกพักไว้ใน src/pages-disabled/ ลิงก์ทั้งคู่จึงไม่มีในเมนู
// ถ้าเติมเข้ามา verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีจริง
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไอคอนเลือกให้ตรงหมวดของเว็บสล็อต และทุกตัวอยู่ใน <span aria-hidden="true">
// แยกจาก label เสมอ ไม่เคยฝังอยู่ในข้อความของ label
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// navbar ที่ใช้งานจริงรอบนี้ แทน NavbarStyle8 ของ SUPERSLOTCLUB — หนึ่งไฟล์ต่อรอบ
//
// พาเลตต์ตาม brand-spec §2: **ทองเป็นฮิวนำ** (#f5c518 สายฟ้าผ่ากลางเหรียญ และ
// คำว่า FLASH บนโลโก้) แดงสายฟ้าเป็นฮิวที่สองจริง (#ff3b14 เลข 877 บนโลโก้)
// แถบไล่จาก #2b0000 → #6d0804 → #2b0000 = แดงเลือดนกเข้มกว่าพื้นเพจของดรอปนี้
// ที่เป็น {"mode":"color","color":"#5c0000"} เพื่อให้แถบ sticky แยกตัวออกจาก
// เนื้อหาที่เลื่อนผ่านใต้มัน ม่านมือถือใช้ #2b0000 ตัวเดียวกัน ขอบและเส้นคั่นเป็น
// ทองแบรนด์ #f5c518 อัลฟาต่ำ ข้อความ active เป็นทองสว่าง #ffdd73 ข้อความปกติเป็น
// สีเนื้อความ #fdf0e2
// ขีดใต้เมนู active ไล่ ครีม #fdf0e2 → ทอง #f5c518 → แดงสด #ff3b14 ซึ่งคือสามสี
// ของโลโก้เรียงตามลำดับที่ตาอ่านจริง (ประกายขอบ → FLASH ทอง → 877 แดง)
// ออร่ากลมหลังโลโก้เป็นทอง #f5c518 เรืองแสงใต้โลโก้เป็น rgba(245,197,24,α)
//
// ปุ่ม "สมัครสมาชิก" เป็นอันเดียวในแถบที่เป็นพื้นทองทึบ (#ffdd73→#f5c518→#b8860f)
// ให้ปุ่ม conversion เด่นออกจากพื้นแดงเข้มทั้งแถบ ส่วน "เข้าสู่ระบบ" เป็นปุ่มโครง
// แดงไม่ทึบ จะได้ไม่แย่งสายตากันเอง หมึกบนปุ่มทองเป็น #2a0300 (แดงเกือบดำ) —
// ตรวจแล้วทั้งสามสต็อป: บน #ffdd73 ≈ 12.9:1 · บน #f5c518 ≈ 11.0:1 · บนสต็อป
// เข้มสุด #b8860f ≈ 5.8:1 ผ่าน AA ทั้งหมด ⚠️ ห้ามลากสต็อปเข้มลงไปถึง #8a6208
// ของ brand-spec — ค่านั้นเป็นสีเงา/ออราเท่านั้น เอามารองหมึกจะเหลือ ~3.4:1
//
// ชุดแดงแล็กเกอร์-ทอง-ครีมงาช้างของ PIGPG ที่เคยอยู่ในไฟล์นี้ (#120302 #3a0d07
// #a30303 #6b0402 #d4200d #f5b61d #ffd87a #fdf9e4 #fdeedd #b07a06 #2a0806
// rgba(245,182,29,α) rgba(212,32,13,α)) ออกครบทุกจุดแล้ว — ทองของรอบนี้
// (#f5c518) เป็นคนละค่ากับทอง #f5b61d ของ PIGPG และแดง #ff3b14 ก็คนละค่ากับ
// #d4200d อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
//
// โลโก้คง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky) แต่ไม่มี
// fetchpriority="high" — LCP คือ hero banner ใน MainLayout มีภาพเดียวที่ได้ high
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#f5c518]/45 bg-gradient-to-r from-[#2b0000] via-[#6d0804] to-[#2b0000] shadow-[0_4px_25px_rgba(20,0,0,0.92)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#f5c518]/35 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            widths={[110, 220, 330]}
            sizes="110px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(245,197,24,0.6)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-0.5 lg:flex xl:gap-2">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold transition-all duration-300 xl:px-3 ${isActive(link.path) ? "text-[#ffdd73]" : "text-[#fdf0e2]/80 hover:text-[#ffdd73]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#8c0f0a]/85 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#fdf0e2] via-[#f5c518] to-[#ff3b14] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#ff3b14]/70 px-6 py-2.5 text-sm font-bold text-[#ffdd73] shadow-[0_0_10px_rgba(255,59,20,0.28)] transition-all hover:border-[#ff3b14] hover:bg-[#8c0f0a] hover:text-[#fdf0e2] xl:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffdd73] via-[#f5c518] to-[#b8860f] px-6 py-2.5 text-sm font-extrabold text-[#2a0300] shadow-[0_0_20px_rgba(245,197,24,0.55)] transition-all hover:scale-105 hover:brightness-110 xl:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#f5c518] bg-gradient-to-tr from-[#6d0804] to-[#8c0f0a] shadow-[0_0_15px_rgba(245,197,24,0.6)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#ffdd73] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#ffdd73] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#ffdd73] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center overflow-y-auto bg-[#2b0000]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-3 px-6 py-8">
      <Picture
        src={mainLogo!}
        alt=""
        aria-hidden="true"
        widths={[110, 220, 330]}
        sizes="110px"
        class="menu-item mb-2 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(245,197,24,0.65)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-lg font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#ffdd73] drop-shadow-[0_0_8px_rgba(245,197,24,0.85)]" : "text-[#fdf0e2]/80 hover:text-[#ffdd73]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            <span>{link.name}</span>
          </a>
        ))
      }

      <div class="menu-item mt-3 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#f5c518]/50 pt-6 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ffdd73] via-[#f5c518] to-[#b8860f] py-3.5 text-lg font-extrabold text-[#2a0300] shadow-[0_0_20px_rgba(245,197,24,0.55)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิก</span>
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#ff3b14]/70 py-3.5 text-lg font-bold text-[#ffdd73] hover:bg-[#8c0f0a]/60">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.24s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.28s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.32s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.36s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.44s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.48s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.52s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
