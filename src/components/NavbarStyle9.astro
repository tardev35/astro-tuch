---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ PIGPG บนพื้นโปร่งใส ด้านบนเป็นหัวหมูการ์ตูนสีชมพูแก้มแดง ขยิบตาและยิ้มกว้าง สวมหมวกทรงจีนสีแดงที่มีเหรียญทองกลางหมวกและยอดทรงกลมสีทองด้านบน รอบหัวหมูมีเหรียญทองและก้อนทองวางเรียงเป็นพัด ด้านล่างเป็นป้ายแล็กเกอร์สีแดงขอบทองหนา คาดคำว่า PIGPG ด้วยตัวอักษรหนาสามมิติสีครีมงาช้าง และมีพลอยสีแดงทรงข้าวหลามตัดอยู่ใต้ป้าย";

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// ไม่มี /ตรวจหวย กับ /แนวทาง รอบนี้: PIGPG เป็นฐานเข้าเล่นสล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นถูกพักไว้ใน src/pages-disabled/ ลิงก์ทั้งคู่จึงไม่มีในเมนู ถ้าเติม
// เข้ามา verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป route ที่ไม่มีจริงใน dist/
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไอคอนเลือกให้ตรงหมวดของเว็บสล็อต และทุกตัวอยู่ใน <span aria-hidden="true">
// แยกจาก label เสมอ ไม่เคยฝังอยู่ในข้อความของ label
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// PIGPG: แดงแล็กเกอร์ + ทอง + ครีมงาช้าง บนแดงเกือบดำ (2026-10-09)
// แถบไล่จาก #120302 → #3a0d07 → #120302 (แดงเกือบดำ เข้มกว่าพื้นเพจที่เป็น
// gradient #6b0000 → #7a4100 เพื่อให้แถบ sticky แยกตัวออกจากเนื้อหาที่เลื่อนผ่าน)
// ม่านมือถือใช้ #120302 ตัวเดียวกัน ขอบและเส้นคั่นเป็นทองแบรนด์ #f5b61d อัลฟาต่ำ
// ข้อความ active เป็นทองอ่อน #ffd87a ข้อความปกติเป็นสีเนื้อความ #fdeedd
// ขีดใต้เมนู active ไล่ ครีม #fdf9e4 → ทอง #f5b61d → แดงสด #d4200d ซึ่งคือสามสี
// ของโลโก้เรียงตามลำดับที่ตาเห็นจริง (ตัวอักษรครีม → ขอบป้ายทอง → ป้ายแดง)
// ออร่ากลมหลังโลโก้เป็นทอง #f5b61d เรืองแสงใต้โลโก้เป็น rgba(245,182,29,α)
//
// ปุ่ม "สมัครสมาชิก" เป็นอันเดียวในแถบที่เป็นพื้นทองทึบ (#ffd87a→#f5b61d→#b07a06)
// ให้ปุ่ม conversion เด่นออกจากพื้นแดงเกือบดำทั้งแถบ ส่วน "เข้าสู่ระบบ" เป็นปุ่ม
// โครงแดงไม่ทึบ จะได้ไม่แย่งสายตากันเอง หมึกบนปุ่มทองเป็น #2a0806 (แดงเกือบดำ)
// ได้คอนทราสต์ 5.0:1 ขึ้นไปทั้งสามสต็อปของไล่เฉด — สต็อปเข้มสุดหยุดที่ #b07a06
// ไม่ลงไปถึง #8a5f05 เพราะคู่นั้นเหลือ 3.6:1 ซึ่งตกเกณฑ์สำหรับ text-sm
// ชุดเขียว-แดง-ทองของ DM899 (#01a326 #12c23a #4ade6b #fb252b #030a05 #0a2410
// #e4f2e4 #ffe9a8 #06140a #0a4a18 #f2b422 #8f0609) ถูกแทนครบทุกจุดแล้ว
//
// โลโก้คง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky) แต่ไม่มี
// fetchpriority="high" — LCP คือ hero banner ใน MainLayout มีภาพเดียวที่ได้ high
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#f5b61d]/45 bg-gradient-to-r from-[#120302] via-[#3a0d07] to-[#120302] shadow-[0_4px_25px_rgba(10,2,1,0.92)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#f5b61d]/35 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            widths={[110, 220, 330]}
            sizes="110px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(245,182,29,0.6)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-0.5 lg:flex xl:gap-2">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold transition-all duration-300 xl:px-3 ${isActive(link.path) ? "text-[#ffd87a]" : "text-[#fdeedd]/80 hover:text-[#ffd87a]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#6b0402]/85 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#fdf9e4] via-[#f5b61d] to-[#d4200d] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#d4200d]/70 px-6 py-2.5 text-sm font-bold text-[#ffd87a] shadow-[0_0_10px_rgba(212,32,13,0.28)] transition-all hover:border-[#d4200d] hover:bg-[#6b0402] hover:text-[#fdf9e4] xl:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffd87a] via-[#f5b61d] to-[#b07a06] px-6 py-2.5 text-sm font-extrabold text-[#2a0806] shadow-[0_0_20px_rgba(245,182,29,0.55)] transition-all hover:scale-105 hover:brightness-110 xl:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#f5b61d] bg-gradient-to-tr from-[#3a0d07] to-[#a30303] shadow-[0_0_15px_rgba(245,182,29,0.6)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#ffd87a] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#ffd87a] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#ffd87a] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center overflow-y-auto bg-[#120302]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-3 px-6 py-8">
      <Picture
        src={mainLogo!}
        alt=""
        aria-hidden="true"
        widths={[110, 220, 330]}
        sizes="110px"
        class="menu-item mb-2 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(245,182,29,0.65)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-lg font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#ffd87a] drop-shadow-[0_0_8px_rgba(245,182,29,0.85)]" : "text-[#fdeedd]/80 hover:text-[#ffd87a]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            <span>{link.name}</span>
          </a>
        ))
      }

      <div class="menu-item mt-3 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#f5b61d]/50 pt-6 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ffd87a] via-[#f5b61d] to-[#b07a06] py-3.5 text-lg font-extrabold text-[#2a0806] shadow-[0_0_20px_rgba(245,182,29,0.55)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิก</span>
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#d4200d]/70 py-3.5 text-lg font-bold text-[#ffd87a] hover:bg-[#6b0402]/60">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.24s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.28s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.32s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.36s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.44s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.48s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.52s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
