---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-13 จริง — เครื่องเล่นเกมพกพาการ์ตูน
// สีชมพูของ PUNPRO168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลยสักอย่าง
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านบนเป็นมาสคอตการ์ตูนรูปโจรเด็กสวมหน้ากากโจรสีดำคาดตาและผ้าโพกหัวสีดำผูกปม ใส่เสื้อแขนยาวสีดำกับถุงมือสีดำ ยิ้มกว้างและชูนิ้วโป้ง พร้อมแบกถุงผ้าใส่เงินสีครีมที่มีเครื่องหมายดอลลาร์สีแดงอยู่บนถุง ด้านล่างถัดลงมาเป็นคำว่า TKB ตัวอักษรละตินหนาสามมิติสีแดงสดไล่เงาตัดขอบแดงเข้ม และต่อท้ายด้วยตัวเลข 55 หนาสามมิติสีเงินโครเมียมขัดเงาตัดขอบแดง มีประกายแสงสีขาวกระจายอยู่บนผิวตัวอักษร`;

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
//
// ไม่มี /ตรวจหวย กับ /แนวทาง รอบนี้: TKB55 เป็นเว็บคาสิโน+กีฬา (บาคาร่า ไฮโล
// บอล สล็อต) ไม่ใช่เว็บหวย สองหน้านั้นถูกพักไว้ใน src/pages-disabled/ ลิงก์ทั้งคู่
// จึงไม่มีในเมนู ถ้าเติมเข้ามา verify-build.mjs จะทำให้ build แดงเพราะ href ชี้ไป
// route ที่ไม่มีจริง
//
// เมนูชุดนี้ถูกประกาศครั้งเดียวตรงนี้ แล้ว render ทั้งแถบ desktop และ drawer
// มือถือจากตัวเดียวกัน — ถ้าแยกสองชุดเมื่อไหร่ มันจะเพี้ยนกันเองรอบถัดไป
//
// ไอคอนเลือกให้ตรงหมวดของเว็บคาสิโน+กีฬา และทุกตัวอยู่ใน <span aria-hidden="true">
// แยกจาก label เสมอ ไม่เคยฝังอยู่ในข้อความของ label
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// navbar ที่ใช้งานจริงรอบนี้ แทน NavbarStyle7 ของ TSDET911 — หนึ่งไฟล์ต่อรอบ
//
// พาเลตต์ตาม brand-spec §2: **แดงเลือดนกเป็นฮิวนำ** (#fb131b คือตัวอักษร TKB
// บนโลโก้) เงินโครเมียมเป็นฮิวที่สอง (#e9eef4 คือเลข 55 บนโลโก้)
//
// ⚠️ แถบนี้ "สว่างกว่า" พื้นเพจ ไม่ใช่เข้มกว่า ซึ่งกลับทางกับ PUNPRO168 ที่เคย
// อยู่ในไฟล์นี้ (แถบ #1c0014 บนพื้นเพจ #2e0022) เพราะ bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#000000"} = **ดำสนิท** ไม่มีอะไรเข้มกว่านั้นให้ใช้แล้ว
// แถบจึงไล่ #1a0708 → #2a0d0f → #1a0708 = แดงเกือบดำที่ยังอ่านออกว่าแยกชั้นจาก
// เนื้อหาที่เลื่อนผ่านใต้มัน ส่วนม่านมือถือใช้ #0d0304 ซึ่งเข้มกว่าแถบแต่ยังไม่ดำสนิท
// ขอบและเส้นคั่นเป็นแดงแบรนด์ #fb131b อัลฟาต่ำ ข้อความ active เป็นเงินโครเมียม
// #e9eef4 (15.2:1 บนแถบ) ข้อความปกติเป็นสีเนื้อความ #f2e4e5
// ขีดใต้เมนู active ไล่ แดงอ่อน #ff8a8f → แดงแบรนด์ #fb131b → เงินโครเมียม #e9eef4
// ซึ่งคือสามสีของโลโก้เรียงตามลำดับที่ตาอ่านจริง (ประกายแดงอ่อน → TKB แดงสด →
// 55 เงินโครเมียม)
// ออร่ากลมหลังโลโก้เป็นแดง #fb131b เรืองแสงใต้โลโก้เป็น rgba(251,19,27,α)
//
// ปุ่ม "สมัครสมาชิก" เป็นอันเดียวในแถบที่เป็นพื้นแดงทึบ (#ff4d55 → #fb131b)
// ให้ปุ่ม conversion เด่นออกจากพื้นแดงเกือบดำทั้งแถบ ส่วน "เข้าสู่ระบบ" เป็นปุ่มโครง
// แดงไม่ทึบ จะได้ไม่แย่งสายตากันเอง หมึกบนปุ่มแดงเป็น #1a0304 (แดงเกือบดำ) —
// ตรวจแล้วทั้งสองสต็อป: บน #ff4d55 ≈ 6.2:1 · บนสต็อปเข้มสุด #fb131b ≈ 4.9:1
// ⚠️ ห้ามลากสต็อปเข้มลงไปถึง #c40304 หรือ #8a0206 ใต้ตัวอักษร — ค่าหลังเป็นสี
// เส้น/ออราเท่านั้น เอามารองหมึกจะตก AA ทันที (2.6:1 และ 1.6:1)
//
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เคยอยู่ในไฟล์นี้ (#f41571 #ff5ca8 #fce343
// #ffc554 #fde7f2 #8a0a45 #4a1038 #2a0012 #1c0014 rgba(244,21,113,α)
// rgba(252,227,67,α)) และชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 ก่อนหน้านั้น
// (#2b0000 #6d0804 #8c0f0a #f5c518 #ffdd73 #ff3b14 #fdf0e2 #b8860f #2a0300)
// ออกครบทุกจุดแล้ว
// ⚠️ **กับดักรอบนี้คือแดง** FLASH877 เคยอยู่ในไฟล์นี้เองและก็เป็นแบรนด์ที่มีแดง
// การเจอแดงตรงนี้จึงไม่พิสูจน์ว่าเป็นของรอบนี้ — แดงรอบนี้ #fb131b (R=251 G=19
// B=27) เป็นแดงสดอิ่ม ส่วน #ff3b14 (R=255 G=59 B=20) ของ FLASH877 เอียงไปทางส้ม
// และ #e8232a ของ SUPERSLOTCLUB กับ #d4200d ของ PIGPG ก็คนละค่าทั้งคู่
// อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
//
// โลโก้คง loading="eager" ไว้ (อยู่เหนือ fold บน header ที่ sticky) แต่ไม่มี
// fetchpriority="high" — LCP คือ hero banner ใน MainLayout มีภาพเดียวที่ได้ high
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#fb131b]/45 bg-gradient-to-r from-[#1a0708] via-[#2a0d0f] to-[#1a0708] shadow-[0_4px_25px_rgba(0,0,0,0.92)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#fb131b]/35 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            widths={[110, 220, 330]}
            sizes="110px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(251,19,27,0.6)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-0.5 lg:flex xl:gap-2">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold transition-all duration-300 xl:px-3 ${isActive(link.path) ? "text-[#e9eef4]" : "text-[#f2e4e5]/80 hover:text-[#e9eef4]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#8a0206]/85 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#ff8a8f] via-[#fb131b] to-[#e9eef4] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#fb131b]/70 px-6 py-2.5 text-sm font-bold text-[#ff8a8f] shadow-[0_0_10px_rgba(251,19,27,0.28)] transition-all hover:border-[#fb131b] hover:bg-[#8a0206] hover:text-[#f2e4e5] xl:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ff4d55] to-[#fb131b] px-6 py-2.5 text-sm font-extrabold text-[#1a0304] shadow-[0_0_20px_rgba(251,19,27,0.55)] transition-all hover:scale-105 hover:brightness-110 xl:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#fb131b] bg-gradient-to-tr from-[#2a0d0f] to-[#8a0206] shadow-[0_0_15px_rgba(251,19,27,0.6)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#e9eef4] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#e9eef4] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#e9eef4] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center overflow-y-auto bg-[#0d0304]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-3 px-6 py-8">
      <Picture
        src={mainLogo!}
        alt=""
        aria-hidden="true"
        widths={[110, 220, 330]}
        sizes="110px"
        class="menu-item mb-2 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(251,19,27,0.65)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-lg font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#e9eef4] drop-shadow-[0_0_8px_rgba(233,238,244,0.85)]" : "text-[#f2e4e5]/80 hover:text-[#e9eef4]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            <span>{link.name}</span>
          </a>
        ))
      }

      <div class="menu-item mt-3 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#fb131b]/50 pt-6 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ff4d55] to-[#fb131b] py-3.5 text-lg font-extrabold text-[#1a0304] shadow-[0_0_20px_rgba(251,19,27,0.55)]">
          <span aria-hidden="true">📝</span>
          <span>สมัครสมาชิก</span>
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#fb131b]/70 py-3.5 text-lg font-bold text-[#ff8a8f] hover:bg-[#8a0206]/60">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.24s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.28s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.32s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.36s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.44s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.48s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.52s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
