---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้ AKA99 ตัวอักษรหนาแบบสามมิติ คำว่า AKA เป็นสีน้ำเงินเมทัลลิกไล่เฉด และเลข 99 เป็นสีเงินโครเมียม มีขอบไล่แสงรอบตัวอักษร";

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ถัดจากโปรโมชั่นทันที เพราะเป็นปุ่ม conversion
// ไม่ใช่หน้าให้อ่าน — ที่เหลือเป็นหน้าเนื้อหาเรียงต่อท้าย
//
// ไม่มี /ทางเข้า ในเมนูโดยตั้งใจ: toggle ของ register/login เปิดอยู่ หน้านั้น
// จึงกลายเป็นลิงก์ที่สามไปยังปลายทางเดียวกัน (ยังถูก route และ index อยู่
// และมีลิงก์จาก footer)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💠" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#0b6cf0]/35 bg-gradient-to-r from-[#03081c] via-[#061436] to-[#03081c] shadow-[0_4px_25px_rgba(0,0,0,0.75)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#0b6cf0]/20 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[110, 220, 330]}
            sizes="110px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(11,108,240,0.45)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-1 lg:flex xl:gap-3">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-2 px-3 text-sm font-bold transition-all duration-300 xl:px-5 xl:text-base ${isActive(link.path) ? "text-[#9dd2fa]" : "text-[#cfdcea]/80 hover:text-[#4aa3ff]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#0b6cf0]/12 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-[#0b6cf0] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`} />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#0b6cf0]/70 px-6 py-2.5 text-sm font-bold text-[#9dd2fa] shadow-[0_0_10px_rgba(11,108,240,0.25)] transition-all hover:bg-[#0b6cf0] hover:text-[#eaf3fd] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#9dd2fa] via-[#0b6cf0] to-[#0a2a6b] px-6 py-2.5 text-sm font-extrabold text-[#03081c] shadow-[0_0_20px_rgba(11,108,240,0.45)] transition-all hover:scale-105 hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#1e4b9e] bg-gradient-to-tr from-[#0a2a6b] to-[#9dd2fa] shadow-[0_0_15px_rgba(11,108,240,0.5)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#eaf3fd] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#eaf3fd] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#eaf3fd] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center bg-[#03081c]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      <Picture
        src={mainLogo!}
        alt=""
        aria-hidden="true"
        widths={[110, 220, 330]}
        sizes="110px"
        class="menu-item mb-4 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(11,108,240,0.55)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-2xl font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#9dd2fa] drop-shadow-[0_0_8px_rgba(11,108,240,0.8)]" : "text-[#cfdcea]/80 hover:text-[#eaf3fd]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            {link.name}
          </a>
        ))
      }

      <div class="menu-item mt-4 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#0a2a6b]/60 pt-8 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#9dd2fa] via-[#0b6cf0] to-[#0a2a6b] py-3.5 text-lg font-extrabold text-[#03081c] shadow-[0_0_20px_rgba(11,108,240,0.45)]">
          <span aria-hidden="true">📝</span> สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#0b6cf0]/50 py-3.5 text-lg font-bold text-[#9dd2fa] hover:bg-[#0b6cf0]/15">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* อนิเมชั่น Hamburger กลายเป็น X (ตัวเส้นเป็น absolute เลยต้องกำหนดองศาใหม่) */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  /* หัวใจสำคัญ: อนิเมชั่น Circular Reveal ด้วย clip-path */
  /* วงกลมเริ่มต้นอยู่ที่มุมขวาบน (ซ่อนไว้ขนาด 0%) */
  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* เมื่อใส่คลาส open วงกลมจะขยายตัวเป็น 150% กินพื้นที่เต็มจอ */
  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto; /* อนุญาตให้คลิกได้ตอนเปิด */
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนู (ลอยขึ้นมาจากข้างล่าง) */
  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important; /* บังคับทับ opacity-0 ของ Tailwind */
    transform: translateY(0);
  }

  /* หน่วงเวลาให้ข้อความเด้งขึ้นมาทีละอัน */
  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  } /* โลโก้ */
  .menu-item:nth-child(2) {
    transition-delay: 0.25s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.3s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.35s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.45s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.5s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.55s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.6s;
  } /* กล่องปุ่ม */

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    // 1. สลับหน้าตาปุ่ม Hamburger
    hamburgerBtn?.classList.toggle("active");

    // 2. ขยายวงกลม (Circular Reveal)
    circularMenu?.classList.toggle("menu-open");

    // 3. ล็อกหน้าจอ & ใส่คลาสให้ตัวหนังสือเด้ง
    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  // ปิดเมนูเวลากดเลือกลิงก์
  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
