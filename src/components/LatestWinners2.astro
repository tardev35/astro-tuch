---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the body colour dimmed
// on the mid surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#ecd5c4]/80 bg-[#332810] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the cream body colour, a row over the threshold lifts to the logo's
// bright gold with a glow. Both class lists live here, and the module only swaps
// between them.
const AMOUNT_CLASS = "text-[#ecd5c4]";
const AMOUNT_BIG_CLASS = "text-[#fcee52] drop-shadow-[0_0_10px_rgba(252,238,82,0.55)]";

// ───────────────────────────────────────────────────────────────────────────
// เงินทอง168 (ดรอป 2026-10-22, .claude/brand-spec-ngernthong168.md §2–§3) —
// **ทองนำ · ครีมอุ่นเป็นวัสดุที่สอง · บนน้ำตาลโอลีฟเข้ม**
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (พักยก168) ใช้ LatestWinners3 จึงหมุนมาที่ไฟล์นี้
// และไฟล์นี้ยังถือพาเลตต์ **ทองคานารี-โครเมียมเงินของ ยูฟ้า168** อยู่ทั้งใบ
// ต้องรีเธมทั้งไฟล์ก่อนใช้
// โลโก้เป็น **ตราชั่งทองสามมิติสองจานมีเหรียญทองกองอยู่ทั้งสองข้าง** ต่อด้วย
// **"เงินทอง" ตัวอักษรไทยสามมิติผิวทองมันวาว** และ **"168" ผิวโครเมียมเงิน**
// ⚠️⚠️ แม้เลข 168 จะเป็นโครเมียม แต่ **วัสดุที่สองของ UI รอบนี้คือครีมอุ่น #ecd5c4
// (ชุดซาตินสีงาช้างของนางแบบ ซึ่งเป็นค่าที่มี share มากที่สุดใน slide1.png)**
// ไม่ใช่แรมป์เทาเงิน — เพราะแรมป์เทาเงิน e0e0df c0c0bf a1a09e เป็นของ **พักยก168
// ซึ่งเป็นแบรนด์ขาออกรอบนี้พอดี** §2 จึงสั่งห้ามไว้ชัด
// แผงนอกเป็นพื้นการ์ดผิวยก #3d3016 ในกรอบทองลึก #b37c0b ออร่าบนหัวเป็นทองแกน
// #f5ba14 การ์ดแต่ละใบตกลงไปที่ผิวอินเซ็ต #201906 ในเส้นขอบ #4d3c15 แล้วอุ่นขึ้น
// เป็นผิวกลาง #332810 ในกรอบทองแกนตอน hover
// ยอดเครดิตเป็นหมึกครีม #ecd5c4 และยกเป็นทองสว่าง #fcee52 พร้อมแสงเมื่อเกินเกณฑ์
// (ตรงกับทองคำแท่งกับเหรียญทองบนอาร์ตเวิร์ก)
// หัวข้อไล่ **ครีมอุ่น #ecd5c4 → ทองสว่าง #fcee52 → ครีมอุ่น #ecd5c4**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (9.1:1 และ 10.7:1 บนผิวยกของแผง) หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ และ
// <section> ถือ aria-label แทน — **ห้ามอัปเป็น h2 เพื่อ "แก้" accessibility**
// เนื้อความ #ecd5c4 (= BRAND_TEXT) ตัวรองใช้ครีมมืด #d2b9a4 (7.1:1 บนผิวยก และ
// สูงกว่านั้นบนผิวอินเซ็ต) ซึ่งเป็นที่ที่วัสดุที่สองของรอบนี้ถือตัวอักษรจริง
// §2 ห้าม #b37c0b (2.0:1) ถือตัวอักษร — ที่นี่มันอยู่ที่กรอบแผงล้วน และ #4d3c15
// อยู่ที่ขอบการ์ด ทั้งคู่เป็นเส้น/พื้นถม
// ⚠️ พื้นเพจรอบนี้เป็น **น้ำตาลโอลีฟเข้ม #29210f** (bg.json) ผิวอินเซ็ต #201906
// ของการ์ดจึงจมกว่าพื้นเพจหนึ่งขั้นพอดี · ป้าย pending ใช้ผิวกลาง #332810 ซึ่ง
// ลอยเหนือผิวอินเซ็ตของการ์ดหนึ่งขั้น
// ⚠️ อีโมจิสองตัวบนหัวแถบเป็น **ตราชั่ง ⚖️ กับ ถุงเงิน 💰** ซึ่งเป็นเอมเบลมของ
// แบรนด์นี้เองกับกองธนบัตรในอาร์ตเวิร์ก — **ห้ามใช้ ⚽ (ยูฟ้า168/ufalion168 และ
// §5 ห้ามคำว่า ฟุตบอล) 🐉 (พักยก168) 🥬 🌽 🚜 (สบาย168) หรือสัญลักษณ์หวย**
// ทั้งคู่อยู่ใน <span aria-hidden="true"> ของตัวเอง ไม่ใช่อักขระในข้อความ
//
// ⚠️ **กับดักรอบนี้คือทอง** เพราะมันผ่านมาแล้วเกือบทุกแบรนด์ในรีโปนี้ และ **รอบนี้
// เป็นทองนำสองรอบติดกัน** เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ:
// ⚠️⚠️ ชุด **ทองแกน-โครเมียมเงินบนน้ำตาลกาแฟ** ของ **พักยก168 ซึ่งเป็นแบรนด์ขาออก
// จึงสำคัญที่สุด** (eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6
// d6c6a8 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04 4e2f11 — eeae12 ห่าง #f5ba14 แค่
// R7/G12/B2 และ fded41 ห่าง #fcee52 แค่ R1/G17/B17) ชุดทองคานารี-โครเมียมเงินของ
// **ยูฟ้า168** ที่เพิ่งค้างในไฟล์นี้ทั้งใบ (fee45d e6a416 b8780d 7a4e05 e8ecf1
// a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000 กับ rgba
// 254/228/93 α) rgba 168/178/191 α)) ชุดฟ้าสกาย-ทองคานารีธีมสว่างของ **สบาย168**
// (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504 ffffff f2fbff
// dff4fd ccf7ff 2a1f02) ชุดทองน้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** (d9212a 8e1a16
// f0c878 fff8d8 2a0608 4e2120 300605 150303) ชุดแดงชาด-ทองเนยของ **มีเฮ168** (fb1b32
// ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205) ชุดบรอนซ์-ทองอำพันของ
// **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601
// 5a3310 1a1000) ชุดทองจักรพรรดิ-แดงชาดของ **รวยเทพ168** (f0bb4e ffeccb e4021b
// d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec) ชุดฟ้า-ทองของ **สบายเบท168** (2f9ff5
// a8dcff d6ecff 0b3f78 ffc82e 5c4a16) ชุดฟ้าอะซัวร์-ทองอำพันของ **รวยแทร่168**
// (039cfa c3ebfc 04366b f9a826 704504) ชุดฟ้าไซยาน-เหลืองมะนาวของ **นินจา168**
// (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28) ชุดแดงคริมสัน-ทองโบราณของ
// **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f ffeee8 fff1ef ffdbdb
// c99a3f) ชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** (eb0305 e40303 c20305 9b0a0c
// ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1
// 1a0802) ชุดทอง-เทาของ **UFA324** (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc
// 464f5a) ชุดชมพูฮอตพิงก์-ทองของ **PUNPRO168** (f41571 ff5ca8 fce343 f0c3dc fde7f2
// 8a0a45 4a0426 3a0a2a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ **SUPERSLOTCLUB** (e8232a
// f2b705 ffd666 f5cbb0 c9a898 301105 180800 3d1709 7d0f12) ชุดฟ้าสด-เหลืองมะนาวของ
// **แตกดี168** (0193fb 7bcffb fce604 064a86 07111d 020609) และชุดทอง-เงินของ **UP555**
// (ebbb54 fce675 d5d4d3 6b4517 130b03 0c0502 241705 f8eed9) ออกครบทุกจุดแล้ว
// **ทองรอบนี้คือ #f5ba14 กับ #fcee52** ไม่ใช่ d4922c fdfc71 ffc82e f9a826 fce343
// fce604 ebbb54 f2b705 ffd84d fcd434 fcd45c f0bb4e f7c92b f0b429 e3b23c f0c878
// dcb95f f0b46a e5a81b fee45d eeae12 หรือ fded41 และ **วัสดุที่สองรอบนี้คือครีมอุ่น
// #ecd5c4 / #d2b9a4** ⚠️ **ไม่ใช่ d5d4d3 ของ UP555 ไม่ใช่ 8792a0 b9c2cc 464f5a ของ
// UFA324 ไม่ใช่ cfd9e6 ของรับตัง168 ไม่ใช่ e8ecf1 a8b2bf ของยูฟ้า168 และไม่ใช่
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 ของพักยก168** รอบนี้ **ไม่มีแดงเลยสักค่า**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีส้ม/ทองแดง ไม่มีโรสโกลด์
// ไม่มีชมพูฟูเชีย ไม่มีบรอนซ์ และไม่มีแรมป์เทาเงิน** — สีเขียวที่เหลืออยู่คือป้าย
// "รับเครดิตแล้ว" ซึ่งเป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool
// คือสีจริงของธนาคาร ห้ามแมปทั้งคู่เข้าพาเลตต์ (ชื่อธนาคารไม่ถูก render เป็นข้อความ
// ที่ไหนเลย — badge ใช้แค่ color กับ icon และ <img> ตัวนั้น alt="" เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — **ไม่มี
// "ฟุตบอล" "บาคาร่า" "ค่าน้ำ" "ราคาต่อรอง"** ซึ่งเป็นคำของยูฟ้า168/ufalion168 ที่
// ค้างอยู่ในไฟล์นี้ ไม่มี "เจ้าดัง" "ไม่ผ่านม้า" "บัญชีม้า" "ค่ายแท้" "ทดลองเล่นฟรี"
// (พักยก168) ไม่มี "เบทต่ำ" "สบายเป๋า" "ทุนน้อย" "งบประมาณ" (สบาย168) ไม่มี "หวย"
// "สลาก" "เลขเด็ด" "3 ตัว 1,000" และไม่มีชื่อค่ายเกม ชื่อธนาคาร หรือชื่อผู้ให้
// บริการใดๆ เพราะบรีฟรอบนี้ไม่ระบุสักราย แผงนี้พูดถึง **เครดิตโปรโมชั่น** ซึ่งเป็น
// คำของบรีฟเอง (คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบสรุปยอด
// · รอบจ่ายเครดิต · เกมสล็อต) ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ควรอ่านประกาศ
// ล่าสุดให้ครบถ้วน · เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการ
// เดิมพันหรือรับประกันผลกำไรในอนาคต · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP) ซึ่ง §4
// สั่งให้ ship ไปด้วย
// ⚠️ ตัวเลขที่อ้างได้มีเฉพาะของบรีฟเอง: 1,000 เกม · 0.3% · 0.8% · 24ชม. ·
// 3 ขั้นตอน · 100% — ยอดเครดิตในแถวเป็นค่าที่สุ่มจาก hash ของโดเมน ไม่ใช่การอ้างอิง
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#b37c0b] bg-[#3d3016]/95 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#f5ba14]/22 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">⚖️</span>
      <p class="bg-gradient-to-r from-[#ecd5c4] via-[#fcee52] to-[#ecd5c4] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}</p>
      <span aria-hidden="true" class="text-2xl">💰</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#4d3c15] bg-[#201906]/95 p-5 shadow-sm transition-all hover:border-[#f5ba14]/70 hover:bg-[#332810]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
