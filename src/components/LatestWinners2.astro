---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the body colour dimmed
// on the warm surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#eae3d4]/80 bg-[#1e1a13] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the cream body colour, a row over the threshold lifts to the logo's
// canary gold with a glow. Both class lists live here, and the module only swaps
// between them.
const AMOUNT_CLASS = "text-[#eae3d4]";
const AMOUNT_BIG_CLASS = "text-[#fee45d] drop-shadow-[0_0_10px_rgba(254,228,93,0.55)]";

// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 (รอบ **ทองคานารีนำ · โครเมียมเงินเป็นสีที่สอง · บนดำสนิท** 2026-10-22,
// brand-spec §2–§3): ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (โปรดี168) ใช้
// LatestWinnersCyber จึงหมุนมาที่ไฟล์นี้ และไฟล์นี้ยังถือพาเลตต์ **ทองน้ำผึ้ง-
// แดงชาดของ ดวงเศรษฐี168** อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
// โลโก้เป็น **ลูกฟุตบอลขาว-ดำลายทองพร้อมหางวงโคจรทองโค้ง** ต่อด้วย **"ยูฟ้า"
// ตัวอักษรไทยสามมิติผิวทองมันวาว** และ **"168" ตัวเลขสามมิติผิวโครเมียมเงิน** —
// สองวัสดุคู่กัน ซึ่งเป็นที่มาของไล่เฉดหัวแถบในไฟล์นี้
// แผงนอกจึงเป็นพื้นการ์ดผิวยก #15130f ในกรอบทองมืด #7a4e05 ออร่าบนหัวเป็น
// ทองคานารี #fee45d การ์ดแต่ละใบตกลงไปที่ผิวจม #0a0908 ในเส้นขอบโครเมียมมืด
// #5a6472 แล้วอุ่นขึ้นเป็นผิว #1e1a13 ในกรอบทองกลางตอน hover
// ยอดเครดิตเป็นหมึกครีม #eae3d4 และยกเป็นทองคานารี #fee45d พร้อมแสงเมื่อเกินเกณฑ์
// (ตรงกับเหรียญทองกับลูกฟุตบอลทองบนอาร์ตเวิร์ก)
// หัวข้อไล่ **โครเมียมสว่าง #e8ecf1 → ทองคานารี #fee45d → โครเมียมสว่าง #e8ecf1**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (17.5 และ 16.6 บนผิวยกของแผง) หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ
// เนื้อความ #eae3d4 (= BRAND_TEXT) ตัวรองใช้โครเมียมกลาง #a8b2bf (8.6:1 บนผิวยก
// และสูงกว่านั้นบนผิวจม) ซึ่งเป็นที่ที่สีที่สองของรอบนี้ถือตัวอักษรจริง
// §2 ห้าม #7a4e05 (2.4:1) และ #5a6472 (3.3:1) ถือตัวอักษร — ที่นี่ #7a4e05 อยู่ที่
// กรอบแผงและ #5a6472 อยู่ที่ขอบการ์ด ทั้งคู่เป็นเส้น/พื้นถมล้วน
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// ป้าย pending ใช้ผิวอุ่น #1e1a13 ซึ่งลอยเหนือผิวจมของการ์ดหนึ่งขั้นพอดี
//
// ⚠️ **กับดักรอบนี้คือทอง** เพราะมันผ่านมาแล้วเกือบทุกแบรนด์ในรีโปนี้ เจอทองที่ไหน
// ห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดทองน้ำผึ้ง-แดงชาดของ
// ดวงเศรษฐี168 ที่เพิ่งค้างในไฟล์นี้ (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120
// 300605 150303 กับ rgba 217/33/42 และ rgba 240/200/120) ชุดแดงชาด-ทองเนยของ
// มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308)
// ชุดบรอนซ์-ทองอำพันของ ufalion168 ⚠️ **แบรนด์บอลเหมือนกัน** (d4922c fdfc71 a25b24
// 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) ชุดทองจักรพรรดิ-แดงชาด
// ของรวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec
// 2b1400) ชุดฟ้า-ทองของสบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff
// 0e2238 081726 040d16 04121f) ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 (039cfa c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดฟ้าไซยาน-เหลืองมะนาว
// ของนินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019
// dceefc) ชุดแดงคริมสัน-ทองโบราณของรวยแท้168 (c30303 8f0505 e81313 dcb95f b8862b
// 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ชุดแดงเชอร์รี่-ทองแดง
// ไหม้ของ **โปรดี168 ซึ่งเป็นแบรนด์ขาออกรอบนี้ จึงสำคัญที่สุด** (eb0305 e40303
// c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4
// fff4ea ffd1d1 1a0802) ชุดทอง-เทาของ UFA324 ⚠️ **ชื่อใกล้ที่สุด** (e5a81b ffe08a
// bb8410 7d5a07 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4 b9c2cc 464f5a)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 f0c3dc fde7f2 8a0a45
// 4a0426 3a0a2a 1c0014 2e0022) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a
// f2b705 ffd666 f5cbb0 c9a898 301105 180800 3d1709 7d0f12 fbe8d5 ff5a46) ชุดฟ้าสด-
// เหลืองมะนาวของ แตกดี168 (0193fb 7bcffb fce604 064a86 07111d 020609 0a1726 dbeafe
// 93b4d4) และชุดทอง-เงินของ UP555 (ebbb54 fce675 d5d4d3 6b4517 130b03 0c0502 241705
// f8eed9) ออกครบทุกจุดแล้ว
// **ทองรอบนี้คือ #fee45d** (R254 G228 B93 — ตัวที่ใกล้ที่สุดในรีโปคือ fef54b ของ
// นินจา168 และ fce675 ของ UP555) ไม่ใช่ d4922c fdfc71 ffc82e f9a826 fce343 fce604
// ebbb54 f2b705 ffd84d fcd434 fcd45c f0bb4e f7c92b f0b429 e3b23c f0c878 dcb95f
// f0b46a หรือ e5a81b และ **สีที่สองรอบนี้คือโครเมียมเงิน #e8ecf1 / #a8b2bf /
// #78828f / #5a6472** ⚠️ **ไม่ใช่ d5d4d3 ของ UP555 ไม่ใช่ 8792a0 b9c2cc 464f5a ของ
// UFA324 และไม่ใช่ cfd9e6 ของรับตัง168** รอบนี้ **ไม่มีแดงเลยสักค่า**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีส้ม/ทองแดง ไม่มีโรสโกลด์
// ไม่มีชมพูฟูเชีย และไม่มีบรอนซ์** — สีเขียวที่เหลืออยู่คือป้าย "รับเครดิตแล้ว" ซึ่ง
// เป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool คือสีจริงของธนาคาร
// ห้ามแมปทั้งคู่เข้าพาเลตต์ (ชื่อธนาคารไม่ถูก render เป็นข้อความที่ไหนเลย — badge
// ใช้แค่ color กับ icon และ <img> ตัวนั้น alt="" เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — ไม่มี
// "สล็อตแท้โปรเด็ด" "ค่ายตรงมาแรง" "ลิขสิทธิ์แท้" "อัปเดตก่อนสิ้นปี" "ปี 2026"
// "ตารางจ่ายรางวัล" ซึ่งเป็นคำของ โปรดี168 ที่ค้าง ไม่มี "หวย" "สลาก" "เลขเด็ด"
// "2 ตัว 100" "3 ตัว 1,000" "บริษัทแม่" (รวยแท้168) ไม่มี "ระบบดูแลการเงิน" /
// "ฝากถอนทุกช่องทาง" / "ปลอดภัยไม่ผ่านม้า" (มีทรัพย์168) ไม่มี "ค่าน้ำ" /
// "การันตีค่าน้ำดี จ่ายสูงสุดในวงการ" (ufalion168) และไม่มีชื่อค่ายเกมใดๆ เพราะ
// บรีฟรอบนี้ไม่ระบุสักค่าย แผงนี้พูดถึง **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง
// (คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบเวลาคำนวณ ·
// รอบจ่ายเครดิต) และ **ฟุตบอล · สล็อต · บาคาร่า** ซึ่งเป็นสามประเภทที่บรีฟระบุเอง
// ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ก่อนเข้าร่วมควรอ่านประกาศล่าสุดให้ครบถ้วน ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกัน
// ผลกำไรในอนาคต · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP) ซึ่ง §6 สั่งให้ ship ไปด้วย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#7a4e05] bg-[#15130f]/95 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#fee45d]/22 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">⚽</span>
      <p class="bg-gradient-to-r from-[#e8ecf1] via-[#fee45d] to-[#e8ecf1] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}</p>
      <span aria-hidden="true" class="text-2xl">🪙</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#5a6472] bg-[#0a0908]/95 p-5 shadow-sm transition-all hover:border-[#e6a416]/70 hover:bg-[#1e1a13]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#a8b2bf]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#eae3d4]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#a8b2bf]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#a8b2bf]">
      ก่อนเข้าร่วมโปรโมชั่นควรอ่านประกาศล่าสุดให้ครบถ้วน ตรวจสอบว่าการเดิมพันฟุตบอล สล็อต หรือบาคาร่าเข้าร่วมรายการใดบ้าง มีรอบเวลาคำนวณยอดเมื่อใด รอบจ่ายเครดิตอยู่ช่วงไหน
      และรับเครดิตด้วยวิธีใด รวมถึงข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกัน ทั้งนี้ เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต
      และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
