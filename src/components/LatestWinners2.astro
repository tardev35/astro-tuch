---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#ca8a04]", icon: ttbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts.
// Rows are server-rendered; values come from the domain hash, never
// Math.random(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) =>
  Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
  amount: (15000 + pick(`card-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `card-pending-${i}`),
}));

// Pending/verified stay semantic (grey / success green), not brand red — a
// status colour that matches the accent tells the reader nothing.
const PENDING_CLASS = "text-[#aeb6c2] bg-[#0d0203] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก LOTTO42"
    class="relative overflow-hidden rounded-[30px] border-2 border-[#e8121d]/30 bg-[#170406]/92 px-4 py-8 shadow-[0_10px_30px_rgba(232,18,29,0.18)] backdrop-blur-md md:p-10">
    <div class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#e8121d]/20 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🎟️</span>
      <p class="bg-gradient-to-r from-[#eef1f6] via-[#ff4d55] to-[#e8121d] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการถอนเงินล่าสุดของสมาชิก LOTTO42</p>
      <span aria-hidden="true" class="text-2xl">🎟️</span>
    </div>

    <div data-winners-feed data-interval="5000" data-max-rows="4" class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#7c0207]/55 bg-[#0d0203]/95 p-5 shadow-sm transition-all hover:border-[#e8121d]/50 hover:bg-[#170406]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังดำเนินการ"
                  data-done-text="ถอนสำเร็จแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#aeb6c2]">
                  ยูสเซอร์: <span data-winner-user class="font-bold text-[#eef1f6]">{row.user}</span>
                </div>
                <div class="mt-1 text-2xl font-black text-[#ff4d55]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#aeb6c2]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#aeb6c2]">
      ก่อนฝากหรือถอนควรตรวจยอด ช่องทาง และชื่อบัญชีรับเงินให้ตรงกับข้อมูลสมาชิก หากรายการยังประมวลผลอยู่ไม่ควรกดซ้ำทันที
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
