---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the body colour dimmed
// on the raised surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#f0e6e4]/80 bg-[#2a0c0d] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the body ink, a row over the threshold lifts to the logo's gel red with
// a glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#f0e6e4]";
const AMOUNT_BIG_CLASS = "text-[#fb2e33] drop-shadow-[0_0_10px_rgba(251,46,51,0.55)]";

// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23, .claude/brand-spec-slot168.md §2–§3) —
// **แดงเจลมันวาวนำ · ขาว/มุกอุ่น (R>G>B) เป็นวัสดุที่สอง · บนดำอมแดงเข้ม**
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (รวย168) ใช้ LatestWinnersHuay จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลต **ทองแกน-ครีมอุ่นบนน้ำตาลโอลีฟของ เงินทอง168**
// อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
// โลโก้รอบนี้เป็น **คำว่า "สล็อต168" ตัวอักษรเจลแดงสามมิติมันวาว ไฮไลต์ขาว
// สเปกคูลาร์ มีมงกุฎเล็กประดับหัวใจแดงบนตัวแรก** ส่วนสไลด์เป็นแคปซูลดำขอบแดง
// เขียน 0.3% / 0.8% ด้วยเลขแดง
// ⚠️⚠️ **มงกุฎทองเล็กเป็นรายละเอียด ~2% ของอาร์ตเวิร์ก ไม่ใช่สี UI** และ **ทองคือ
// ฮิวนำของ รวย168 ซึ่งเป็นแบรนด์ขาออกรอบนี้พอดี** §2 จึงสั่งกวาดทองออกให้หมด —
// วัสดุที่สองรอบนี้คือ **มุกอุ่น R>G>B** ไม่ใช่ทอง ไม่ใช่ครีม และไม่ใช่เงินเย็น
// แผงนอกเป็นพื้นการ์ดผิวการ์ด #1c0607 ในกรอบแดงลึก #cb0b0d ออราบนหัวเป็นแดงเจล
// #fb2e33 การ์ดแต่ละใบตกลงไปที่ผิวจม #0b0000 ในเส้นขอบ #551c1e แล้วอุ่นขึ้นเป็น
// ผิวยก #2a0c0d ในกรอบแดงเจลตอน hover
// ยอดเครดิตเป็นหมึก #f0e6e4 และยกเป็นแดงเจล #fb2e33 พร้อมแสงเมื่อเกินเกณฑ์
// หัวข้อไล่ **แพลทินัม #e3d6d4 → แดงเจล #fb2e33 → แพลทินัม #e3d6d4**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (14.4:1 และ 5.1:1 บนผิวการ์ดของแผง) **ห้ามเอา #cb0b0d (3.3:1) #8a0608
// #7d6f6e #551c1e หรือค่าผิวใดมาเป็นสต็อป** หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ และ
// <section> ถือ aria-label แทน — **ห้ามอัปเป็น h2 เพื่อ "แก้" accessibility**
// เนื้อความ #f0e6e4 (= BRAND_TEXT) ตัวรองใช้หมึกรอง #c9b9b7 (10.3:1 บนผิวการ์ด และ
// สูงกว่านั้นบนผิวจม) ซึ่งเป็นที่ที่วัสดุที่สองของรอบนี้ถือตัวอักษรจริง
// §2 ห้าม #cb0b0d / #8a0608 / #551c1e / #7d6f6e ถือตัวอักษร — ที่นี่อยู่ที่กรอบแผง
// และขอบการ์ด ซึ่งเป็นเส้น/พื้นถมล้วน
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดงเข้มมาก #140000** (bg.json) ผิวจม #0b0000 ของ
// การ์ดจึงจมกว่าพื้นเพจหนึ่งขั้นพอดี · ป้าย pending ใช้ผิวยก #2a0c0d ซึ่งลอยเหนือ
// ผิวจมของการ์ดสองขั้น
// ⚠️ อีโมจิสองตัวบนหัวแถบเป็น **วงล้อสล็อต 🎰 กับ ของขวัญ 🎁** ซึ่งตรงกับแกนของ
// บรีฟรอบนี้ (เกมสล็อต + เครดิตโปรโมชั่น) — **ห้ามใช้ ⚖️ 💰 (เงินทอง168) 🎟️ 🎫 🔢
// (สัญลักษณ์หวยของ รวย168 ซึ่งเป็นแบรนด์ขาออก) ⚽ (ยูฟ้า168/ufalion168) 🐉
// (พักยก168) 🥬 🌽 🚜 (สบาย168)** ทั้งคู่อยู่ใน <span aria-hidden="true"> ของตัวเอง
// ไม่ใช่อักขระในข้อความ
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ทอง (เพราะแบรนด์ขาออกเป็นทองนำ และทองผ่านมาแล้ว
// เกือบทุกแบรนด์ในรีโปนี้) และแดง (เพราะรอบนี้แดงนำ จึงต้องแยกจากแดงของอีกสิบกว่า
// แบรนด์)** การเจอทองหรือแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่าทีละตัว:
// ⚠️⚠️ **ชุดทอง-โครเมียมเงินของ รวย168 ซึ่งเป็นแบรนด์ขาออก สำคัญที่สุด** ffd94a
// e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16 3d3425 f3ece0
// bfb8aa **ห้ามเหลือเด็ดขาด** (⚠️ 1c1a16 ห่างจากผิวการ์ดรอบนี้ 1c0607 แค่ G/B)
// ชุด **ทองแกน-ครีมอุ่นบนน้ำตาลโอลีฟของ เงินทอง168** ที่เพิ่งค้างในไฟล์นี้ทั้งใบ
// (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906 2e2512 1b1407
// 4d3c15 กับ rgba 252/238/82 α) ชุด **ทองแกน-โครเมียมของ พักยก168** (eeae12 fded41
// 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f
// 1f1308 2f1e0f 1f0f04 4e2f11) ชุดทองคานารีของ **ยูฟ้า168** (fee45d e6a416 b8780d
// 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10)
// ชุดบรอนซ์-ทองอำพันของ **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4
// 33200a 1f1304 0a0601 5a3310 1a1000) ชุดทอง-เทาของ **UFA324** (e5a81b ffe08a bb8410
// 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a) และชุดฟ้า-ทองของ **สบาย168 / สบายเบท168 /
// รวยแทร่168 / นินจา168** (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 fdcb0c fefb6b 8a6504 ·
// 2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 · 039cfa c3ebfc 04366b f9a826 704504 ·
// 32bcfb a9e9ff fef54b 07335f 6b5c10) **ออกครบทุกจุดแล้ว**
// ⚠️⚠️ **แดงรอบนี้คือ #fb2e33 (R251 G46 B51) / #cb0b0d / #8a0608 / #d81115 /
// #b00d11** เท่านั้น ไม่ใช่ ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a
// 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6 (มาดาม168) ไม่ใช่ fb141b ff5f63 ffa0a2
// db040b 8a0609 (GT66B — ⚠️ fb141b ห่าง #fb2e33 หนึ่งก้าว และ 8a0609 ห่าง #8a0608
// หนึ่งก้าว **เจอแล้วแปลว่าพิมพ์ผิด**) ไม่ใช่ b3121b 5a0a0e f2bba5 c98a74
// (ขวัญใจ168) c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef ffeee8 dcb95f b8862b 96681f
// (รวยแท้168) eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 (โปรดี168)
// fa0513 ff5a5f ffadaf (สมหวัง168) d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120
// (ดวงเศรษฐี168 — ⚠️ 2a0608 ห่างจากผิวยกรอบนี้ 2a0c0d แค่ G/B) fb1b32 ff8f9c 5c0410
// fcd45c 6b4a08 (มีเฮ168) f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 (รวยเทพ168)
// d30304 a00203 ff6b6e (รับตัง168) dc0203 f5282a (หวย365) f41571 ff5ca8 fce343
// (PUNPRO168) e8232a f2b705 ffd666 (SUPERSLOTCLUB) ff3b14 6d0804 2b0000 (FLASH877)
// ⚠️ **วัสดุที่สองรอบนี้คือมุกอุ่น #e3d6d4 / #c9b9b7 / #7d6f6e (R>G>B)** ไม่ใช่
// ecd5c4 d2b9a4 (เงินทอง168) ไม่ใช่ d9dfe9 b3bdd6 (มาดาม168) ไม่ใช่ f4e4d3 e4cbb3
// (ร่ำรวย168) ไม่ใช่ d5d4d3 (UP555) ไม่ใช่ 8792a0 b9c2cc 464f5a (UFA324) ไม่ใช่
// cfd9e6 (รับตัง168) ไม่ใช่ e8ecf1 a8b2bf (ยูฟ้า168) และไม่ใช่ e0e0df c0c0bf a1a09e
// f4ead6 d6c6a8 (พักยก168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีส้ม/ทองแดง
// ไม่มีโรสโกลด์ ไม่มีชมพูฟูเชีย ไม่มีบรอนซ์ ไม่มีครีม/เบจ/พีช และไม่มีแรมป์
// เทาเงินเย็น** — สีเขียวที่เหลืออยู่คือป้าย "รับเครดิตแล้ว" ซึ่งเป็นสี semantic
// ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool คือสีจริงของธนาคาร ห้ามแมปทั้งคู่
// เข้าพาเลต (ชื่อธนาคารไม่ถูก render เป็นข้อความที่ไหนเลย — badge ใช้แค่ color กับ
// icon และ <img> ตัวนั้น alt="" เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — **ไม่มี
// "หวย" "สลาก" "เลขเด็ด" "งวด" "บาทละ 1,000" "2 ตัว 100" "3 ตัว 1,000"
// "ตารางอัตราจ่าย"** ซึ่งเป็นคำของ รวย168 ที่ค้างอยู่ในรอบก่อน ไม่มี "ฟุตบอล"
// "บาคาร่า" "ค่าน้ำ" "ราคาต่อรอง" (ยูฟ้า168/ufalion168) ไม่มี "เจ้าดัง" "ไม่ผ่านม้า"
// "บัญชีม้า" "ทดลองเล่นฟรี" (พักยก168) ไม่มี "เบทต่ำ" "สบายเป๋า" "ทุนน้อย"
// (สบาย168) และไม่มีชื่อค่ายเกม ชื่อธนาคาร หรือชื่อผู้ให้บริการใด ๆ เพราะบรีฟรอบนี้
// ไม่ระบุสักราย แผงนี้พูดถึง **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง (คืนยอดเสีย
// 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบสรุปยอด · รอบจ่ายเครดิต ·
// เกมสล็อต) ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ควรตรวจสอบประกาศล่าสุดก่อนเข้าร่วม ·
// เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาส
// ชนะในครั้งต่อไป · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP) ซึ่ง brand-spec §5 สั่งให้
// ship ไปด้วย
// ⚠️ **ตัวเลขที่อ้างได้มีเฉพาะของบรีฟเอง: 0.3% · 0.8% · 100% (เฉพาะในวลี
// "ไม่ผ่านเอเย่นต์100%") · 24ชม.** — ยอดเครดิตในแถวเป็นค่าที่ได้จาก hash ของโดเมน
// ไม่ใช่การอ้างอิงสถิติของเว็บไซต์
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#cb0b0d] bg-[#1c0607]/95 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#fb2e33]/22 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🎰</span>
      <p class="bg-gradient-to-r from-[#e3d6d4] via-[#fb2e33] to-[#e3d6d4] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">
        รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl">🎁</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#551c1e] bg-[#0b0000]/95 p-5 shadow-sm transition-all hover:border-[#fb2e33]/70 hover:bg-[#2a0c0d]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#c9b9b7]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f0e6e4]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#c9b9b7]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#c9b9b7]">
      ก่อนเข้าร่วมโปรโมชั่นควรตรวจสอบประกาศล่าสุดให้ครบถ้วน ว่าเกมสล็อตประเภทใดเข้าร่วมรายการบ้าง ยอดที่นำมาคำนวณคิดจากอะไร มีรอบสรุปยอดเวลาใด รอบจ่ายเครดิตอยู่ช่วงไหน
      และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงข้อกำหนดเรื่องจำนวนบัญชีที่เข้าร่วมได้ เงื่อนไขการใช้โบนัสและการถอนเงิน ทั้งนี้
      เครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
      หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
