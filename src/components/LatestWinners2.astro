---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the secondary ink on
// the raised surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
// 🚨 **DONE_CLASS ห้ามแตะ** — เขียว success เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์
// brand-spec §2 สั่งคงไว้ตรง ๆ แม้รอบนี้แบรนด์จะเป็นแดงก็ตาม
const PENDING_CLASS = "text-[#6b2b33] bg-[#f7dfe4] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the body ink, a row over the threshold lifts to the brand crimson
// with a glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#36080f]";
const AMOUNT_BIG_CLASS = "text-[#a30d1a] drop-shadow-[0_0_10px_rgba(163,13,26,0.55)]";

// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28, .claude/brand-spec-123bet.md §2–§3) —
// **แดงชาดนำ · ทองอำพัน/เงินโครเมียมเป็นวัสดุที่สอง · ธีมสว่าง (เนื้อหา)**
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (ZORO365) ใช้ LatestWinnersCyber จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลต **ชมพูบับเบิลกัมของ okkub88** อยู่ทั้งใบ
// ต้องรีเธมทั้งไฟล์ + เขียนถ้อยคำใหม่จากบรีฟรอบนี้ก่อนใช้
// โลโก้รอบนี้เป็น **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบ
// ทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ใต้มงกุฎเงินประดับกำมะหยี่แดง
// และอัญมณีแดง วางบนโล่โครเมียมเงินที่มีเพชรแดง** ส่วนสไลด์เป็นโถงวังหินอ่อน
// สีงาช้างที่พิมพ์เลข 0.3% / 0.8% ด้วยตัวแดงเคลือบเงาตัดขอบทอง
// ⚠️⚠️ **ผนังหินอ่อนสีงาช้าง ลูกไม้ขาว สีผิวนางแบบ และชิปคาสิโนแดง-ขาวในอาร์ตเวิร์ก
// เป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// 🚨🚨 **รอบนี้กลับทิศจากพาเลตที่ค้างในไฟล์นี้ทั้งชุด: จากชมพูบับเบิลกัม เป็น
// แดงชาด** พื้นเพจ **#f7e4e9** (bg.json) = ชมพูบลัชจาง **ห้าม "แก้" ให้กลับไปมืด**
// — แผงนี้ตั้งสีตัวอักษรเองทั้งใบ หมึก #36080f บนการ์ดมืดคือตัวอักษรหายไปเลย
// ลำดับผิว: **#fdf5f6 การ์ด (การ์ดแต่ละแถว) / #f7dfe4 ยก (ป้าย pending + แผงนอก) /
// #eec3cc เส้นบาง** บนพื้นเพจ #f7e4e9
// แผงนอกเป็นผิวยก #f7dfe4 ในกรอบ #d98fa0 ออราบนหัวเป็นแดงชาด #a30d1a
// การ์ดแต่ละใบอยู่ที่ผิวการ์ด #fdf5f6 ในเส้นขอบ #eec3cc แล้วอิ่มเป็นกรอบแดงตอน hover
// ยอดเครดิตเป็นหมึก #36080f และยกเป็นแดงชาด #a30d1a (7.4:1 บนผิวการ์ด) พร้อม
// แสงเมื่อเกินเกณฑ์
// หัวข้อไล่ **แดงเลือดหมู #8a1420 → แดงชาด #a30d1a → #8a1420**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (~8.8:1 และ ~7.0:1 บนผิวยกของแผง) **ห้ามเอา #eec3cc #d98fa0 #dca53a
// #ef4a5e หรือค่าผิวใดมาเป็นสต็อป** หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ และ <section>
// ถือ aria-label แทน — **ห้ามอัปเป็น h2 เพื่อ "แก้" accessibility**
// เนื้อความ #36080f (= BRAND_TEXT) ตัวรองใช้หมึกรอง #6b2b33 (9.7:1 บนผิวการ์ด)
// §2 ห้าม #eec3cc / #d98fa0 / #dca53a / #ef4a5e ถือตัวอักษร — ที่นี่อยู่ที่
// กรอบแผง ขอบการ์ด และออรา ซึ่งเป็นเส้น/พื้นถมล้วน
// ⚠️ อีโมจิสองตัวบนหัวแถบเป็น **ข้าวหลามตัดแดง ♦️ กับ โพดำ ♠️** ซึ่งตรงกับภาษาภาพ
// ของดรอปนี้ (อัญมณีแดงบนมงกุฎและเพชรแดงบนโล่ + ไพ่เอซโพดำที่ขอบแบนเนอร์) —
// **ห้ามใช้ 🩷 🪙 🎀 🍬 🏦 (okkub88 ซึ่งเพิ่งอยู่ในไฟล์นี้) 🎰 🎁 🔐 (สล็อต168)
// 🐷 🪽 💗 (หมูบิน168) 🕹️ 💙 🏧 (โบ๊ะบ๊ะ168) ⚖️ 💰 (เงินทอง168) 🎟️ 🎫 🔢
// (สัญลักษณ์หวยของ LOTTO189) 🗡️ 🎍 (ZORO365)** ทั้งคู่อยู่ใน
// <span aria-hidden="true"> ของตัวเอง ไม่ใช่อักขระในข้อความ
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ชมพู (เพราะชุดที่ค้างในไฟล์นี้เป็นชมพูบับเบิลกัม
// ซึ่งอยู่ตระกูลใกล้แดง) และแดง (เพราะรอบนี้แดงนำ จึงต้องแยกจากแดงของแบรนด์อื่น
// สิบกว่าเจ้า)** การเจอแดงหรือชมพูในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่าทีละตัว:
// ⚠️⚠️ **ชุดชมพูบับเบิลกัมของ okkub88 ที่เพิ่งอยู่ทั้งใบนี้**: ffd6fa fff4fb ffe3f5
// ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73
// b01160 85094a fd6cb2 fc7cba fc4da1 + rgba 251/67/155 — **ออกครบทุกค่าแล้ว**
// ⚠️ **b01160 (okkub88) ↔ b00718 / b00d11 และ 9c0f55 ↔ #a30d1a สี่ตัวแรกใกล้กัน —
// เจอแล้วต้องอ่านทั้งหกหลัก**
// ⚠️⚠️ **ZORO365 แบรนด์ขาออกทันที (เขียวป่าจมเกือบดำ)**: 002908 010d04 031b09
// 073c1a 0e5424 1e7033 35a043 3ddc4a 23823a dfe6e3 e8c86a eef7f0 9dc2a5 —
// **รอบนี้ไม่มีเขียวเป็นสี UI เลยสักเฉด**
// 🚨🚨 **LOTTO189 ตระกูลสีเดียวกับรอบนี้เป๊ะ (แดง/ทอง/ขาวชมพู)**: fff0f0 ffe4e6
// ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436
// e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6 —
// ⚠️⚠️ **c1071b / b00718 ↔ #a30d1a · 7e1221 / 8a0412 ↔ #8a1420 · 6e3b44 ↔ #6b2b33 ·
// ffe4e6 / ffd4d7 ↔ #f7e4e9 / #f7dfe4 · e9b53c ↔ #dca53a**
// ⚠️ **MEXICANOSLOT**: de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
// fdeee2 fde4d3 fff3ea fef6fb f2543f (**a81410 ↔ #a30d1a · fef6fb ↔ #fdf5f6**) ·
// **TEVA69**: f0ffeb e6f7df d7f0cd b2dba3 10280f 3c5b36 116018 0b4a12 1a7d24 28c437
// e3bb45 c6cfd2 · **ZANE96**: 7a1bd6 c2178b f23bb4 bb6dff 5411c4 241046 f8e6f9
// ⚠️ ชมพู/แดงของแบรนด์อื่น: f41571 ff5ca8 · f5469f ff8dc6 8c0f52 · fa63b9 ffb3de ·
// dd1b74 a4186b 4a0d35 2d0720 · ff2e52 e01238 c9102f · fb141b ff5f63 ffa0a2 ·
// b3121b 5a0a0e · c30303 8f0505 e81313 · eb0305 e40303 c20305 · fa0513 ff5a5f ·
// d9212a 8e1a16 · fb1b32 5c0410 · e4021b · d30304 a00203 · dc0203 f5282a ·
// ff3b14 · fb2e33 cb0b0d d81115 b00d11 8a0608 · fa539c c2185b 8e0f41 fb8cc0 fdc6c3
// ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 7a4463
// ⚠️ ทองของแบรนด์อื่น — **ทองรอบนี้คือ #dca53a กับทองเข้ม #7a4a0c เท่านั้น**:
// ffd94a e3a712 9d6f06 eeae12 fded41 9f600d f5ba14 fcee52 b37c0b fee45d e6a416
// b8780d fdcb0c fefb6b d4922c fdfc71 e5a81b ffe08a fbc134 ffe87a fcd434 ffc82e
// f9a826 fef54b cd9a2c e0b03a b07d08 e3bb45 e9b53c e8c86a
// ⚠️ **วัสดุที่สองรอบนี้คือผิวขาวอมชมพู #fdf5f6 / #f7dfe4 / #eec3cc / #d98fa0
// (R≥B>G)** ไม่ใช่ชมพูบับเบิลกัม ffc2e2 fc74b5 fff4fb ffe3f5 (okkub88) ไม่ใช่
// มุกอุ่น f0e6e4 c9b9b7 e3d6d4 7d6f6e (สล็อต168) ไม่ใช่ ecd5c4 d2b9a4 (เงินทอง168)
// ไม่ใช่ d9dfe9 b3bdd6 (มาดาม168) ไม่ใช่ f4e4d3 e4cbb3 (ร่ำรวย168) และไม่ใช่
// e0e0df c0c0bf a1a09e (พักยก168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้า ไม่มีเขียวเป็นสีแบรนด์ ไม่มีฟ้า/น้ำเงิน/ไซแอน
// ไม่มีม่วง ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีครีม/เบจ/พีช** — สีเขียวที่เหลืออยู่คือ
// ป้าย "รับเครดิตแล้ว" ซึ่งเป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง
// bankPool คือสีจริงของธนาคาร **ห้ามแมปทั้งคู่เข้าพาเลต** (ชื่อธนาคารไม่ถูก render
// เป็นข้อความที่ไหนเลย — badge ใช้แค่ color กับ icon และ <img> ตัวนั้น alt=""
// เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — แผงนี้พูดถึง
// **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง (คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เครดิต · ยอดเสีย · รอบเวลาคำนวณยอด · รอบจ่ายเครดิต · บาคาร่าสล็อต ไฮโล รูเล็ต
// ยิงปลา บอล หวยออนไลน์) ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ควรตรวจสอบข้อมูล
// ล่าสุดก่อนรับโบนัสทุกครั้ง · โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืน
// จากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP)
// ซึ่ง brand-spec §5 สั่งให้ ship ไปด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
// 🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — ห้ามเขียน ทรูวอลเลท ·
// ทรูมันนี่ · ฝากถอนออโต้ · ชื่อธนาคาร และห้ามคำของแบรนด์ก่อน: เว็บสล็อตเงินดี ·
// ทางเข้าเล่นง่าย · ยูสใหม่แตกไว · รับโปรไม่อั้น · โบนัสแจกทั้งวันไม่จำกัด ·
// ฝากถอนไม่มีขั้นต่ำ (okkub88) · เกมคาสิโนสายตรง · แทงได้เท่าไหร่ · เว็บจ่ายเต็ม ·
// ไม่มีโกง (ZORO365) · เว็บตรงแตกง่าย · เบทต่ำ · ไม่ทำเทิร์น · ถอนได้ไม่จำกัด ·
// ไม่ผ่านเอเย่นต์100% · และคำหมวดหวยเฉพาะทาง (งวด · เลขเด็ด · สลาก · โพย ·
// บาทละ 1,000 · ตารางอัตราจ่าย)
// ⚠️ **ตัวเลขที่อ้างได้มีเฉพาะของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง** —
// ยอดเครดิตในแถวเป็นค่าที่ได้จาก hash ของโดเมน ไม่ใช่การอ้างอิงสถิติของเว็บไซต์
// และ **ไม่มีจำนวนเกม จำนวนค่าย ค่า RTP หรือ 100%** เพราะบรีฟไม่เอ่ยเลย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#d98fa0] bg-[#f7dfe4] px-4 py-8 shadow-[0_10px_30px_rgba(54,8,15,0.14)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#a30d1a]/22 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">♦️</span>
      <p class="bg-gradient-to-r from-[#8a1420] via-[#a30d1a] to-[#8a1420] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">
        รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl">♠️</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#eec3cc] bg-[#fdf5f6] p-5 shadow-sm transition-all hover:border-[#a30d1a] hover:bg-[#f7dfe4]">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#6b2b33]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#36080f]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#6b2b33]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#6b2b33]">
      ก่อนรับสิทธิ์ควรติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วน ว่าบาคาร่าสล็อต ไฮโล รูเล็ต ยิงปลา บอล หรือหวยออนไลน์ประเภทใดเข้าร่วมรายการบ้าง ยอดที่นำมาคำนวณคิดจากอะไร มีรอบเวลาคำนวณยอดและรอบรับสิทธิ์ช่วงไหน
      และต้องรับเครดิตด้วยวิธีใด รวมถึงจำนวนบัญชีที่เข้าร่วมได้ วงเงินโบนัส เงื่อนไขการใช้เครดิตและข้อจำกัดการถอนเงิน ทั้งนี้
      โปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
      หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

