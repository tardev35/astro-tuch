---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts.
// Rows are server-rendered; values come from the domain hash, never
// Math.random(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing, and this round the accent IS red,
// which would read as "failed" on a status chip. Pending is the body cream
// dimmed on the page surface, so it reads as "not finished yet" without
// borrowing the accent; done keeps the success green every brand on this
// template uses, which the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#fbe8d5]/80 bg-[#241000] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the warm cream, a row over the threshold lifts to the crown gold with a
// glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#f5cbb0]";
const AMOUNT_BIG_CLASS = "text-[#f2b705] drop-shadow-[0_0_10px_rgba(242,183,5,0.55)]";

// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// โลโก้เป็นหัวเสือโคร่งส้ม-ดำบนป้ายโล่แดงกว้าง มีคำว่า SUPERSLOTCLUB เป็นตัวอักษร
// แดงสามมิติขอบโครเมียมแดง และงานอาร์ตทั้งชุดเป็นฉากป่าแดดส่องที่มีเหรียญทองลาย
// รอยเท้าเสือกระจายเต็มภาพ แผงนอกจึงเป็นพื้นการ์ดผิวกลาง #301105 ในกรอบแดงลึก
// #7d0f12 ออร่าบนหัวเป็นแดงแบรนด์ #e8232a การ์ดแต่ละใบตกลงไปที่ผิวลึกสุด #180800
// ในเส้นขอบผิวยก #3d1709 แล้วสว่างเป็นแดงตอน hover ยอดเงินเป็นครีมอุ่น #f5cbb0 และ
// ยกเป็นทองแบรนด์พร้อมแสงเมื่อเกินเกณฑ์ หัวข้อไล่ทองสว่าง #ffd666 → แดงเรืองไฟ
// #ff5a46 → แดงแบรนด์ #e8232a ซึ่งเริ่มที่ทองแล้วไต่ลงแดงตามที่ตาอ่านโลโก้ (อุ้งเท้า
// ทองเกาะอยู่เหนือป้ายโล่แดง) เนื้อความ #fbe8d5 (= BRAND_TEXT) ตัวรองใช้ชมพูอมเทา
// หม่น #c9a898 (8.9:1 บนผิวลึกสุด)
// §2 ห้าม #e8232a กับ #7d0f12 ถือตัวอักษร — ที่นี่อยู่ที่ขอบ ออรา และปลายไล่เฉด
// บนหัวข้อซึ่งเป็น bg-clip-text ขนาด md:text-3xl font-black เท่านั้น
//
// ⚠️ รอบนี้ฮิวแบรนด์เองเป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดง เจอแดงที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคย
// ค้างในไฟล์นี้ (#0193fb #7bcffb #fce604 #064a86 #07111d #020609 #0a1726 #dbeafe
// #93b4d4 rgba(1,147,251,α) rgba(252,230,4,α)) และชุดทอง-เงินของ UP555 ก่อนนั้น
// (#ebbb54 #fce675 #d5d4d3 #6b4517 #130b03 #0c0502 #241705 #f8eed9) ออกครบทุกจุด
// แล้ว — ทองของรอบนี้เป็นคนละค่ากับ #fce604 #ebbb54 และ #fce675
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#7d0f12]/70 bg-[#301105]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#e8232a]/30 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">💸</span>
      <p class="bg-gradient-to-r from-[#ffd666] via-[#ff5a46] to-[#e8232a] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการถอนเงินล่าสุดของสมาชิก {BRAND_NAME}</p>
      <span aria-hidden="true" class="text-2xl">💸</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#3d1709] bg-[#180800]/95 p-5 shadow-sm transition-all hover:border-[#e8232a]/60 hover:bg-[#301105]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังดำเนินการ"
                  data-done-text="ถอนสำเร็จแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#c9a898]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#fbe8d5]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#c9a898]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#c9a898]">
      ก่อนยืนยันรายการฝากถอน ควรตรวจสอบยอดเงิน ชื่อบัญชี และรายละเอียดบัญชีปลายทางให้ตรงกับข้อมูลที่ระบบแจ้งทุกครั้ง หากรายการยังอยู่ระหว่างตรวจสอบไม่ควรกดซ้ำทันที
      และสามารถเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสิ้น ทั้งนี้ผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
