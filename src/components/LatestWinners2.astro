---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the secondary ink on
// the raised surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#95486b] bg-[#fff4fb] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the body ink, a row over the threshold lifts to the deep bubblegum pink
// with a glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#6a0f3c]";
const AMOUNT_BIG_CLASS = "text-[#d91a73] drop-shadow-[0_0_10px_rgba(251,67,155,0.55)]";

// ───────────────────────────────────────────────────────────────────────────
// okkub88 (ดรอป 2026-10-24, .claude/brand-spec-okkub88.md §2–§3) —
// **ชมพูบับเบิลกัมนำ · ชมพูพาสเทล/ขาวอมชมพู (R≥B>G) เป็นวัสดุที่สอง · ธีมสว่าง**
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (โบ๊ะบ๊ะ168) ใช้ LatestWinners3 จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลต **แดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168** อยู่ทั้งใบ
// ต้องรีเธมทั้งไฟล์ + เขียนถ้อยคำใหม่จากบรีฟรอบนี้ก่อนใช้
// โลโก้รอบนี้เป็น **เวิร์ดมาร์กตัวอักษรละตินทรงเจลลี่สามมิติ ชมพูบับเบิลกัม ตัดขอบ
// ขาวหนา โดยตัวแรกเป็นหน้าการ์ตูนกลมสีชมพูขยิบตา มือสวมถุงมือขาวชูสองนิ้ว และมี
// หัวใจชมพูลอยประดับ** ส่วนสไลด์เป็นฉากสตูดิโอขาว-ชมพูพาสเทลที่พิมพ์เลข 0.3% /
// 0.8% ด้วยตัวเจลลี่ชมพู
// ⚠️⚠️ **หมูชมพู เหรียญทอง กล่องของขวัญ และคาร์ดิแกนถักในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — ทองของเหรียญไม่ใช่สีแบรนด์ และ §2 สั่งว่ารอบนี้ไม่มีทองเลยสักเฉด
//
// 🚨🚨 **รอบนี้กลับทิศจากพาเลตที่ค้างในไฟล์นี้ 180 องศา: จากธีมมืด เป็นธีมสว่าง**
// พื้นเพจ **#ffd6fa** (bg.json) = ชมพูบับเบิลกัมพาสเทล ไม่ใช่ดำอมแดง 140000
// **ห้าม "แก้" ให้กลับไปมืด** — แผงนี้ตั้งสีตัวอักษรเองทั้งใบ หมึกเบอร์รี #6a0f3c
// บนการ์ดมืดคือตัวอักษรหายไปเลย
// ลำดับผิว: **#ffffff การ์ด (การ์ดแต่ละแถว) / #fff4fb ยก (ป้าย pending) /
// #ffe3f5 wash (แผงนอก)** บนพื้นเพจ #ffd6fa
// แผงนอกเป็นผิว wash #ffe3f5 ในกรอบชมพูเส้นเข้ม #f479b9 ออราบนหัวเป็นชมพูบับเบิลกัม
// #fb439b การ์ดแต่ละใบอยู่ที่ผิวการ์ดขาว #ffffff ในเส้นขอบ #f9b2d9 แล้วยกขึ้นเป็น
// ผิวยก #fff4fb ในกรอบชมพูสดตอน hover
// ยอดเครดิตเป็นหมึก #6a0f3c และยกเป็นชมพูเข้ม #d91a73 (4.8:1 บนผิวการ์ดขาว) พร้อม
// แสงเมื่อเกินเกณฑ์
// หัวข้อไล่ **ชมพูลึก #9c0f55 → เบอร์รีเข้มสุด #85094a → #9c0f55**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (6.7:1 และ 8.2:1 บนผิว wash ของแผง) **ห้ามเอา #fb439b (2.6:1 บน wash)
// #fc74b5 #ffc2e2 #f9b2d9 #f479b9 หรือค่าผิวใดมาเป็นสต็อป** หัวแถบนี้เป็น <p>
// ไม่ใช่หัวข้อ และ <section> ถือ aria-label แทน — **ห้ามอัปเป็น h2 เพื่อ "แก้"
// accessibility**
// เนื้อความ #6a0f3c (= BRAND_TEXT) ตัวรองใช้หมึกรอง #95486b (6.2:1 บนผิวการ์ดขาว)
// §2 ห้าม #fb439b / #f9b2d9 / #f479b9 / #fc74b5 / #ffc2e2 ถือตัวอักษร — ที่นี่อยู่ที่
// กรอบแผง ขอบการ์ด และออรา ซึ่งเป็นเส้น/พื้นถมล้วน
// ⚠️ อีโมจิสองตัวบนหัวแถบเป็น **หัวใจชมพู 🩷 กับ เหรียญ 🪙** ซึ่งตรงกับภาษาภาพของ
// ดรอปนี้ (หัวใจชมพูในโลโก้ + เหรียญที่โปรยอยู่บนสไลด์) — **ห้ามใช้ 🎰 🎁 🔐
// (สล็อต168 ซึ่งเพิ่งอยู่ในไฟล์นี้) 🐷 🪽 💗 (หมูบิน168) 🕹️ 💙 🏧 (โบ๊ะบ๊ะ168)
// ⚖️ 💰 (เงินทอง168) 🎟️ 🎫 🔢 (สัญลักษณ์หวยของ รวย168) ⚽ (ยูฟ้า168) 🐉 (พักยก168)
// 🥬 🌽 🚜 (สบาย168)** ทั้งคู่อยู่ใน <span aria-hidden="true"> ของตัวเอง ไม่ใช่
// อักขระในข้อความ
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: แดง (เพราะชุดที่ค้างในไฟล์นี้เป็นแดงเจล ซึ่งอยู่
// ตระกูลใกล้ชมพู) และชมพู (เพราะรอบนี้ชมพูนำ จึงต้องแยกจากชมพูของแบรนด์อื่น)**
// การเจอแดงหรือชมพูในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่าทีละตัว:
// ⚠️⚠️ **ชุดแดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168 ที่เพิ่งอยู่ทั้งใบนี้**: fb2e33
// cb0b0d d81115 b00d11 8a0608 c9060a fa292c f92124 f0e6e4 c9b9b7 e3d6d4 7d6f6e
// 140000 0b0000 1c0607 2a0c0d 551c1e + rgba 251/46/51 — **ออกครบทุกค่าแล้ว**
// ⚠️ **b00d11 (สล็อต168) ↔ #b01160 (สต็อปปุ่มรอบนี้) สี่ตัวแรก b01 ตรงกัน — เจอ
// แล้วต้องอ่านทั้งหกหลัก**
// ⚠️⚠️ **หมูบิน168 (สองรอบก่อน) เป็นชมพูเหมือนรอบนี้ = ต้องเทียบด้วยค่าเท่านั้น**:
// fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
// 3b0b26 54123a 7a2350 ffe9f5 7a4463 — **fb8cc0 ↔ #fb439b R ตรงกันเป๊ะ · f7bcd9 ↔
// #f9b2d9 B ตรงกันเป๊ะ · ffe9f5 ↔ #ffe9f7 ต่างแค่ไบต์สุดท้าย**
// ⚠️⚠️ **โบ๊ะบ๊ะ168 แบรนด์ขาออก (ฟ้าสกายบนธีมสว่าง)**: 00bfff 12b4ef b6e3f0 7fcbe8
// 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 —
// **รอบนี้ไม่มีฟ้าเลยสักเฉด**
// ⚠️ ชมพู/แดงของแบรนด์อื่น: f41571 ff5ca8 (PUNPRO168 — **f41571 ใกล้ #fb439b ที่สุด
// ในลิสต์**) · f5469f ff8dc6 8c0f52 (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) ·
// dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) · ff2e52 e01238 c9102f (มาดาม168) ·
// fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B) · b3121b 5a0a0e f2bba5 (ขวัญใจ168) ·
// c30303 8f0505 e81313 (รวยแท้168) · eb0305 e40303 c20305 9b0a0c (โปรดี168) ·
// fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16 (ดวงเศรษฐี168) · fb1b32 ff8f9c
// 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) · d30304 a00203 (รับตัง168) · dc0203 f5282a
// (หวย365) · ff3b14 6d0804 (FLASH877) · ff3fa4 ffd1ea (FAH999)
// ⚠️ ทองของแบรนด์อื่น — **รอบนี้ไม่มีทองเลยสักเฉด**: ffd94a e3a712 9d6f06 eeae12
// fded41 9f600d f5ba14 fcee52 b37c0b fee45d e6a416 b8780d fdcb0c fefb6b d4922c
// fdfc71 e5a81b ffe08a fbc134 ffe87a fcd434 ffc82e f9a826 fef54b cd9a2c
// ⚠️ **วัสดุที่สองรอบนี้คือชมพูพาสเทล/ขาวอมชมพู #ffc2e2 / #fc74b5 / #fff4fb /
// #ffe3f5 (R≥B>G)** ไม่ใช่มุกอุ่น f0e6e4 c9b9b7 e3d6d4 7d6f6e (สล็อต168) ไม่ใช่
// ecd5c4 d2b9a4 (เงินทอง168) ไม่ใช่ d9dfe9 b3bdd6 (มาดาม168) ไม่ใช่ f4e4d3 e4cbb3
// (ร่ำรวย168) ไม่ใช่ e8ecf1 a8b2bf (ยูฟ้า168) และไม่ใช่ e0e0df c0c0bf a1a09e
// f4ead6 d6c6a8 (พักยก168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง ไม่มีส้ม/ทองแดง
// ไม่มีโรสโกลด์ ไม่มีบรอนซ์ ไม่มีครีม/เบจ/พีช และไม่มีแรมป์เทาเงิน** — สีเขียวที่
// เหลืออยู่คือป้าย "รับเครดิตแล้ว" ซึ่งเป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และ
// สีในตาราง bankPool คือสีจริงของธนาคาร ห้ามแมปทั้งคู่เข้าพาเลต (ชื่อธนาคารไม่ถูก
// render เป็นข้อความที่ไหนเลย — badge ใช้แค่ color กับ icon และ <img> ตัวนั้น alt=""
// เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — แผงนี้พูดถึง
// **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง (คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เครดิต · ยอดเสีย · รอบสรุปยอด · รอบจ่ายเครดิต · เกมสล็อต) ประโยคปิดท้ายคือ
// คำกำกับของบรีฟเอง (ควรติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วน
// ก่อนรับสิทธิ์ · การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือ
// เพิ่มโอกาสชนะในครั้งต่อไป · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP) ซึ่ง brand-spec §5
// สั่งให้ ship ไปด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
// 🚨 **ห้ามเขียน "ทรูมันนี่" (คำของโบ๊ะบ๊ะ168) — บรีฟรอบนี้เขียน "ทรูวอลเลท"
// เท่านั้น** และห้ามคำของแบรนด์ก่อน: เกมสล็อตสนุกสุดมันส์ · เว็บตรงแตกง่าย ·
// เบทต่ำ · เบทต่ำ 1 บาท · ไม่ทำเทิร์น · รวมค่ายดัง · ใช้ทุนเล่นน้อย ·
// ถอนได้ไม่จำกัด · สล็อตคลาสสิก · เกมโบนัส (โบ๊ะบ๊ะ168) · เกมสล็อตแท้ ·
// เว็บตรงถูกลิขสิทธิ์ · เชื่อถือได้ · ไม่จำกัดยอด (หมูบิน168) · ระบบสล็อตเว็บนอก ·
// ทางเข้าแท้ · ไม่ผ่านเอเย่นต์100% · ฐานเกมหลัก (สล็อต168) · และไม่มีคำหมวดหวย
// (หวย · สลาก · เลขเด็ด · งวด · บาทละ 1,000 · ตารางอัตราจ่าย) กับหมวดบอล/คาสิโน
// ⚠️ **ตัวเลขที่อ้างได้มีเฉพาะของบรีฟเอง: 0.3% · 0.8% · 3 ขั้นตอน · 24ชม.** —
// ยอดเครดิตในแถวเป็นค่าที่ได้จาก hash ของโดเมน ไม่ใช่การอ้างอิงสถิติของเว็บไซต์
// และ **ไม่มีจำนวนเกม จำนวนค่าย ค่า RTP 100% หรือ 1 บาท** เพราะบรีฟไม่เอ่ยเลย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f479b9] bg-[#ffe3f5] px-4 py-8 shadow-[0_10px_30px_rgba(156,15,85,0.14)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#fb439b]/22 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🩷</span>
      <p class="bg-gradient-to-r from-[#9c0f55] via-[#85094a] to-[#9c0f55] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">
        รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl">🪙</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#f9b2d9] bg-white p-5 shadow-sm transition-all hover:border-[#fb439b] hover:bg-[#fff4fb]">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#95486b]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#6a0f3c]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#95486b]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#95486b]">
      ก่อนรับสิทธิ์ควรติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วน ว่าเกมสล็อตประเภทใดเข้าร่วมรายการบ้าง ยอดที่นำมาคำนวณคิดจากอะไร มีรอบสรุปยอดเวลาใด รอบรับเครดิตอยู่ช่วงไหน
      และต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงจำนวนบัญชีที่เข้าร่วมได้ เงื่อนไขการใช้เครดิตและข้อกำหนดการถอนเงิน ทั้งนี้
      การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
      หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

