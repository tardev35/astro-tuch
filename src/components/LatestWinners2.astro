---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the secondary ink on
// the raised surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
// 🚨 **DONE_CLASS ห้ามแตะ** — เขียว success เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์
// brand-spec §2 สั่งคงไว้ตรง ๆ แม้รอบนี้แบรนด์จะเป็นชมพูก็ตาม
const PENDING_CLASS = "text-[#7a4263] bg-[#fcd9ee] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the body ink, a row over the threshold lifts to the brand pink with a
// glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#3d0a2c]";
const AMOUNT_BIG_CLASS = "text-[#a30d63] drop-shadow-[0_0_10px_rgba(163,13,99,0.45)]";

// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29, .claude/brand-spec-abm96.md §2–§3) —
// **ชมพูบานเย็น #a30d63 นำ · ทองอำพัน #f2c14e (โครมเท่านั้น) และเงินอมชมพู
// #e8c3da เป็นคู่รอง · ธีมสว่างในโซนเนื้อหา**
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (LOTTOPLUS) ใช้ LatestWinnersHuay จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือพาเลต **แดงชาด/ชมพูบลัชของ 123BET** อยู่ทั้งใบ ต้องรีเธม
// ทั้งไฟล์ + เขียนถ้อยคำใหม่จากบรีฟรอบนี้ก่อนใช้
// 🚨🚨 **a30d1a (123BET, แดงชาด) ↔ #a30d63 (รอบนี้, ชมพูบานเย็น) ต่างกันสองหลัก
// ท้ายเท่านั้น** — ตาเปล่าแยกไม่ออก ต้องอ่านให้ครบหกหลักทุกจุด
// โลโก้รอบนี้เป็น **เวิร์ดมาร์กละตินสามมิติตัวอ้วนมน ผิวไล่จากขาวนวลลงชมพูอ่อน
// ตัดขอบชมพูเข้มหนาสองชั้น ตัว A มีหัวใจชมพูเล็กซ้อนในช่องกลางตัวอักษร** คู่กับ
// **มาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก แก้มแดง ขยิบตา เกาะขอบจานวงกลมชมพู
// ขอบขาว** ส่วนสไลด์เป็นฉากผ้าซาตินชมพูนวลที่พิมพ์เลข 0.3% / 0.8% ตัวโตผิวทอง
// ⚠️⚠️ **ผ้าซาติน ดอกไม้ชมพูจาง ลูกไม้ขาว สีผิวนางแบบ ชิปคาสิโนชมพู-ขาว และหัวใจ
// สามมิติในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// 🚨🚨 **รอบนี้กลับทิศจากพาเลตที่ค้างในไฟล์นี้ทั้งชุด: จากแดงชาด เป็นชมพูบานเย็น**
// พื้นเพจ **#f8b9f0** (bg.json) = ชมพูพาสเทลอิ่มตัว **ห้าม "แก้" ให้กลับไปมืด** —
// แผงนี้ตั้งสีตัวอักษรเองทั้งใบ หมึก #3d0a2c บนการ์ดมืดคือตัวอักษรหายไปเลย
// ลำดับผิว: **#ffffff การ์ด (การ์ดแต่ละแถว) / #fcd9ee ยก (ป้าย pending + แผงนอก) /
// #f3a7d3 เส้นบาง** บนพื้นเพจ #f8b9f0
// แผงนอกเป็นผิวยก #fcd9ee ในกรอบ #f3a7d3 ออราบนหัวเป็นชมพูสว่าง #ff7ac2
// การ์ดแต่ละใบอยู่ที่ผิวการ์ด #ffffff ในเส้นขอบ #f3a7d3 แล้วอิ่มเป็นกรอบ #e0509f
// ตอน hover พร้อมผิวจมลงเป็น #fff5fb
// ยอดเครดิตเป็นหมึก #3d0a2c และยกเป็นชมพูบานเย็น #a30d63 (7.5:1 บนผิวการ์ดขาว)
// พร้อมแสงเมื่อเกินเกณฑ์
// หัวข้อไล่ **#7a0449 → #a30d63 → #7a0449**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 บนผิวยก #fcd9ee: **#7a0449 ≈ 8.4:1 · #a30d63 ≈ 5.8:1** ✅
// 🚨🚨 **ห้ามลากสต็อปอ่อนกว่า #a30d63** — #d11a7e บน #fcd9ee ได้แค่ 3.9:1 และ
// **ห้ามเอา #f3a7d3 #fcd9ee #e0509f #ff7ac2 #f2c14e หรือค่าผิวใดมาเป็นสต็อป**
// หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ และ <section> ถือ aria-label แทน — **ห้ามอัปเป็น
// h2 เพื่อ "แก้" accessibility** (brand-spec §4 ตรึงหน้าแรกไว้ที่ h1×1/h2×5/h3×2)
// เนื้อความ #3d0a2c (= BRAND_TEXT) ตัวรองใช้หมึกรอง #7a4263 (7.5:1 บนผิวการ์ดขาว
// และ 5.9:1 บนผิวยก)
// §2 ห้าม #f3a7d3 / #fcd9ee / #e0509f (3.6:1) / #ff7ac2 ถือตัวอักษร — ที่นี่อยู่ที่
// กรอบแผง ขอบการ์ด และออรา ซึ่งเป็นเส้น/พื้นถมล้วน · **#f2c14e ถือตัวอักษรได้
// เฉพาะบนโครมเข้ม จึงไม่อยู่ในไฟล์นี้**
// ⚠️ อีโมจิสองตัวบนหัวแถบเป็น **หัวใจ ♥️ กับ ลูกเต๋า 🎲** ซึ่งตรงกับภาษาภาพของ
// ดรอปนี้จริง (หัวใจชมพูสามมิติลอยกระจายรอบโลโก้ + ลูกเต๋าชมพูจุดขาวบนแบนเนอร์) —
// **ห้ามใช้ ♦️ ♠️ 👑 (123BET ซึ่งเพิ่งอยู่ในไฟล์นี้) 🩷 🪙 🎀 🍬 🏦 (okkub88)
// 🐷 🪽 💗 (หมูบิน168 — ดรอปนี้มีลูกหมูจริงแต่ไม่มีปีก จึงยิ่งต้องไม่หยิบชุดนี้)
// 🎰 🎁 🔐 (สล็อต168) 🕹️ 💙 🏧 (โบ๊ะบ๊ะ168) ⚖️ 💰 (เงินทอง168) 🎟️ 🎫 🔢
// (LOTTO189) 🗡️ 🎍 (ZORO365) ☘️ 🏮 (LOTTOPLUS)** ทั้งคู่อยู่ใน
// <span aria-hidden="true"> ของตัวเอง ไม่ใช่อักขระในข้อความ
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: แดง (เพราะชุดที่ค้างในไฟล์นี้เป็นแดงชาด ซึ่งอยู่
// ตระกูลใกล้ชมพู) และชมพู (เพราะรอบนี้ชมพูนำ จึงต้องแยกจากชมพูของแบรนด์อื่น)**
// การเจอแดงหรือชมพูในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ต้องเทียบค่าทีละตัว:
// ⚠️⚠️ **ชุดแดงชาด/ชมพูบลัชของ 123BET ที่เพิ่งอยู่ทั้งใบนี้**: a30d1a c21325 8a1420
// 36080f 6b2b33 f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 dca53a ef4a5e 330710 1c050b
// + rgba(163,13,26) rgba(54,8,15) — **ออกครบทุกค่าแล้ว**
// ⚠️⚠️ **LOTTOPLUS แบรนด์ขาออกทันที (เขียวมรกต/ทองบนผิวสว่าง)**: 046c4e 0d3326
// 3f6f5c 19a97c 2fd49b a3ddc3 d2f3e4 e1fef3 f0fdf7 052e22 03201a 0a4433 8a6508
// e2b32a c8d4d0 — **รอบนี้ไม่มีเขียวเป็นสี UI เลยสักเฉด**
// 🚨🚨 **okkub88 ตระกูลสีเดียวกับรอบนี้เป๊ะ (ชมพูบับเบิลกัม)**: ffd6fa fff4fb
// ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b d91a73 b01160 85094a fc4da1 —
// ⚠️⚠️ **d91a73 ↔ #d11a7e · 9c0f55 b01160 ↔ #a30d63 · f9b2d9 ↔ #f3a7d3 ·
// ffd6fa ffe3f5 ↔ #fcd9ee #fff5fb · 6a0f3c ↔ #440d31 #3d0a2c**
// ⚠️ **ถอนชัวร์168**: fa63b9 ffb3de ffd84d 0d040a 1a0914 6d0b3f 6b4708 fdeaf5 ·
// **ZANE96**: bb6dff 7aa7ff 5411c4 7a1bd6 190b3d 271257 f3e8ff c0a6e8 2f1766
// c2178b f8e6f9 ffd6fa
// ⚠️ ทองของแบรนด์อื่น — **ทองรอบนี้คือ #f2c14e (โครมเท่านั้น) กับทองเข้ม #6e4705
// เท่านั้น**: ffd84d dca53a e2b32a e9b53c e3bb45 e0b03a ffd94a e3a712 fee45d
// e6a416 b8780d d4922c fdfc71 e5a81b fcd434 ffc82e f9a826 f0b429 e8c86a
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-abm96.md §2b — ไม่ซ้ำลง
// ที่นี่โดยตั้งใจ**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงชาด ไม่มีเขียวเป็นสีแบรนด์ ไม่มีฟ้า/น้ำเงิน/ไซแอน ไม่มีม่วง
// ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีครีม/เบจ/พีช** — สีเขียวที่เหลืออยู่คือป้าย
// "รับเครดิตแล้ว" ซึ่งเป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool
// คือสีจริงของธนาคาร **ห้ามแมปทั้งคู่เข้าพาเลต** (ชื่อธนาคารไม่ถูก render เป็น
// ข้อความที่ไหนเลย — badge ใช้แค่ color กับ icon และ <img> ตัวนั้น alt="" เพราะ
// เป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — แผงนี้พูดถึง
// **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง (คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน ·
// แนะนำเพื่อน 0.8% ไม่จำกัด · เครดิต · ยอดเสีย · รอบเวลาคำนวณเครดิต · รอบจ่ายเครดิต ·
// บาคาร่า สล็อต รูเล็ต ไฮโล คาสิโนสด) ประโยคปิดท้ายคือคำกำกับของบรีฟเอง
// (ควรตรวจสอบประเภทเกมที่เข้าร่วม รอบคำนวณยอด และเงื่อนไขการรับเครดิต ·
// โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่ม
// โอกาสชนะในครั้งถัดไป · แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามี
// วงเงินสูงสุดหรือข้อกำหนดเพิ่มเติมหรือไม่ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP)
// ซึ่ง brand-spec §5 สั่งให้ ship ไปด้วย ไม่ตัดทิ้งเพราะฟังดูลบ
// 🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** — ห้ามเขียน ทรูวอลเลท ·
// ทรูมันนี่ · ฝากถอนออโต้ · ชื่อธนาคาร · ไม่มีขั้นต่ำ และห้ามคำของแบรนด์ก่อน:
// **หวยทุกรูป · อัตราจ่ายสูง · จ่ายเต็ม · โอนไว · ทางเข้าเว็บแม่ · รอบปิดรับ ·
// เลขอั้น (LOTTOPLUS ขาออกทันที)** · เว็บตรง · ไม่ผ่านเอเย่นต์ · ครบทุกค่าย ·
// เซิร์ฟแท้ · ไม่มีโกง (123BET/ZORO365) · ยูสใหม่แตกไว · ฟรีสปิน · ค่า RTP ·
// เบทต่ำ · ไม่ทำเทิร์น · แตกง่าย · ยิงปลา · เดิมพันฟุตบอล
// ⚠️ **ตัวเลขที่อ้างได้มีเฉพาะของบรีฟเอง: 1 บาท · 0.3% · 0.8% · 3 ขั้นตอน ·
// 24 ชั่วโมง** — ยอดเครดิตในแถวเป็นค่าที่ได้จาก hash ของโดเมน ไม่ใช่การอ้างอิง
// สถิติของเว็บไซต์ และ **ไม่มีจำนวนเกม จำนวนค่าย ค่า RTP หรือ 100%** เพราะบรีฟ
// ไม่เอ่ยเลย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f3a7d3] bg-[#fcd9ee] px-4 py-8 shadow-[0_10px_30px_rgba(61,10,44,0.12)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#ff7ac2]/35 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">♥️</span>
      <p class="bg-gradient-to-r from-[#7a0449] via-[#a30d63] to-[#7a0449] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">
        รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl">🎲</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#f3a7d3] bg-[#ffffff] p-5 shadow-sm transition-all hover:border-[#e0509f] hover:bg-[#fff5fb]">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#7a4263]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#3d0a2c]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#7a4263]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#7a4263]">
      ก่อนรับสิทธิ์ควรติดตามประกาศโปรโมชั่นล่าสุดและตรวจสอบข้อกำหนดให้ครบถ้วน ว่าบาคาร่า สล็อต รูเล็ต ไฮโล หรือคาสิโนสดประเภทใดเข้าร่วมรายการบ้าง ยอดที่นำมาคำนวณคิดจากอะไร มีรอบเวลาคำนวณเครดิตและรอบจ่ายเครดิตช่วงไหน
      และต้องรับเครดิตด้วยวิธีใด รวมถึงจำนวนบัญชีที่เข้าร่วมได้ วงเงินโบนัส และเงื่อนไขการถอนเงิน แม้เว็บไซต์จะใช้ข้อความว่าโบนัสไม่อั้น แต่ควรตรวจสอบว่ามีวงเงินสูงสุดหรือข้อกำหนดเพิ่มเติมหรือไม่ ทั้งนี้
      โปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
      หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

