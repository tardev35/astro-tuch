---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation. **Do not move that logic back into this
// file and do not reach for Math.random() in frontmatter.**
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the body colour dimmed
// on the mid surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#fff8d8]/80 bg-[#300605] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the ivory body colour, a row over the threshold lifts to the logo's
// honey gold with a glow. Both class lists live here, and the module only swaps
// between them.
const AMOUNT_CLASS = "text-[#fff8d8]";
const AMOUNT_BIG_CLASS = "text-[#f0c878] drop-shadow-[0_0_10px_rgba(240,200,120,0.55)]";

// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
// 2026-10-20, brand-spec §2-§3): ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (ufalion168) ใช้
// LatestWinnersPremium จึงหมุนมาที่ไฟล์นี้ และไฟล์นี้ยังถือพาเลตต์แดงชาด-ทองเนยของ
// มีเฮ168 อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
// โลโก้เป็น **หัวไฉ่ซิงเอี๊ยยิ้มหัวเราะ สวมหมวกทรงจีนสีแดงขลิบทอง มีลูกปัดทองห้อย
// สองข้าง** ต่อด้วย **"ดวงเศรษฐี" ตัวอักษรไทยสามมิติผิวทองมันวาว** และ **"168"
// สามมิติสีแดงสดขลิบทอง**
// แผงนอกจึงเป็นพื้นการ์ดผิวกลาง #300605 ในกรอบแดงเลือดหมู #8e1a16 ออร่าบนหัวเป็น
// แดงชาด #d9212a การ์ดแต่ละใบตกลงไปที่ผิวจม #150303 ในเส้นขอบแดงเลือดหมู แล้ว
// สว่างเป็นแดงชาดตอน hover
// ยอดเครดิตเป็นงาช้าง #fff8d8 และยกเป็นทองน้ำผึ้ง #f0c878 พร้อมแสงเมื่อเกินเกณฑ์
// (ตรงกับกองเหรียญทองกับมงกุฎทองบนอาร์ตเวิร์ก)
// หัวข้อไล่ งาช้าง #fff8d8 → ทองน้ำผึ้ง #f0c878 → งาช้าง #fff8d8 ⚠️ ไล่เฉดนี้ถูก
// bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2
// (19.7 / 13.2 บนพื้นดำสนิทของแผง) หัวแถบนี้เป็น <p> ไม่ใช่หัวข้อ
// เนื้อความ #fff8d8 (= BRAND_TEXT) ตัวรองใช้ทองน้ำผึ้ง #f0c878 (10.9:1 บนผิวกลาง
// และสูงกว่านั้นบนผิวจม)
// §2 ห้าม #d9212a / #8e1a16 ถือตัวอักษร — ที่นี่ #8e1a16 อยู่ที่ขอบการ์ดกับกรอบแผง
// และ #d9212a อยู่ที่ออร่ากับขอบตอน hover เท่านั้น ทั้งคู่เป็นพื้นถม/เส้น
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// ป้าย pending ใช้ผิวกลาง #300605 ซึ่งลอยเหนือผิวจมของการ์ดหนึ่งขั้นพอดี
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ทอง และ แดง** แทบทุกรอบหลังสุดมีทอง และ มีเฮ168 /
// รวยเทพ168 / สมหวัง168 / รับตัง168 / ขวัญใจ168 เป็นแบรนด์แดงมาก่อน เจอแดงหรือทอง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดแดงชาด-ทองเนยของมีเฮ168
// ที่เพิ่งค้างในไฟล์นี้ (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205
// fdeaec 1b0308 กับ rgba 251/27/50 และ rgba 252/212/92) ชุดบรอนซ์-ทองอำพัน
// ของ ufalion168 ที่เพิ่งออก (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a
// 1f1304 0a0601 5a3310 1a1000) ชุดทองจักรพรรดิ-แดงชาดของรวยเทพ168 (f0bb4e ffeccb
// e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดฟ้า-ทองของสบายเบท168
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 (039cfa c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52 071e38 030f1d 031320) ชุดฟ้าไซยาน-เหลืองมะนาวของนินจา168 (32bcfb a9e9ff
// fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 (f41571 ff5ca8 fce343 f0c3dc fde7f2 8a0a45 4a0426 3a0a2a 1c0014 2e0022)
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a f2b705 ffd666 f5cbb0 c9a898
// 301105 180800 3d1709 7d0f12 fbe8d5 ff5a46) ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168
// (0193fb 7bcffb fce604 064a86 07111d 020609 0a1726 dbeafe 93b4d4) และชุดทอง-เงิน
// ของ UP555 (ebbb54 fce675 d5d4d3 6b4517 130b03 0c0502 241705 f8eed9) ออกครบทุกจุดแล้ว
// **ทองรอบนี้คือ #f0c878** (R240 G200 B120 — ตัวที่ใกล้ที่สุดในรีโปคือ ffdc8c ของ
// รับตัง168 ระยะ 32 และ f6e3b4 ของ ufalion168) ไม่ใช่ d4922c fdfc71 ffc82e f9a826
// fef54b fce343 fce604 ebbb54 fce675 f2b705 ffd84d fcd434 fcd45c f0bb4e f7c92b
// f0b429 หรือ e3b23c และ **แดงรอบนี้คือ #d9212a / #8e1a16** ⚠️ **ไม่ใช่ e4021b ของ
// รวยเทพ168 และไม่ใช่ d30304 ของรับตัง168 ซึ่งห่างกันแค่นิดเดียว** ไม่ใช่ fb1b32
// ff8f9c 5c0410 (มีเฮ168) fa0513 8c0204 (สมหวัง168) b3121b (ขวัญใจ168) e8232a
// ff5a46 (SUPERSLOTCLUB) fb131b (TKB55) หรือ fb141b (GT66B)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีส้มสด ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์
// ไม่มีชมพูฟูเชีย และไม่มีบรอนซ์** — สีเขียวที่เหลืออยู่คือป้าย "รับเครดิตแล้ว" ซึ่ง
// เป็นสี semantic ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool คือสีจริงของธนาคาร
// ห้ามแมปทั้งคู่เข้าพาเลตต์ (ชื่อธนาคารไม่ถูก render เป็นข้อความที่ไหนเลย — badge
// ใช้แค่ color กับ icon และ <img> ตัวนั้น alt="" เพราะเป็นของตกแต่ง)
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — ไม่มี
// "แฟนเพจเว็บบอลยูฟ่า" "แทงบอล" "ทริคแทงบอล" "ค่าน้ำ" "ราคาบอล" "ราคาต่อรอง"
// "ผลการแข่งขัน" หรือ "การันตีค่าน้ำดี จ่ายสูงสุดในวงการ" ซึ่งเป็นคำของ ufalion168
// ที่ค้าง ไม่มี "สล็อตรวมเกมกำไรงาม" / "เล่นง่ายทุกค่าย" (รวยแทร่168) ไม่มี
// "ถอนง่าย" / "ไม่มีรีวิวเสีย" (ถอนชัวร์168) และไม่มีชื่อค่ายเกมใดๆ เพราะบรีฟรอบนี้
// ไม่ระบุสักค่าย แผงนี้พูดถึง **เครดิตโปรโมชั่น** ซึ่งเป็นคำของบรีฟเอง (คืนยอดเสีย
// 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบคำนวณยอด · รอบจ่ายเครดิต)
// ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ก่อนเข้าร่วมควรอ่านรายละเอียดจากประกาศล่าสุด ·
// การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน · ไม่เปิดเผย
// รหัสผ่านหรือรหัส OTP) ซึ่ง §6 สั่งให้ ship ไปด้วย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#8e1a16]/80 bg-[#300605]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#d9212a]/30 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🪙</span>
      <p class="bg-gradient-to-r from-[#fff8d8] via-[#f0c878] to-[#fff8d8] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการรับเครดิตโปรโมชั่นล่าสุดของสมาชิก {BRAND_NAME}</p>
      <span aria-hidden="true" class="text-2xl">🪙</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#8e1a16] bg-[#150303]/95 p-5 shadow-sm transition-all hover:border-[#d9212a]/60 hover:bg-[#300605]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบยอด"
                  data-done-text="รับเครดิตแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบยอด" : "รับเครดิตแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#f0c878]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#fff8d8]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#f0c878]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#f0c878]">
      ก่อนเข้าร่วมโปรโมชั่นควรอ่านรายละเอียดจากประกาศล่าสุด ตรวจสอบว่าเกมประเภทใดร่วมรายการ มีรอบคำนวณยอดเมื่อใด รอบจ่ายเครดิตอยู่ช่วงไหน
      และต้องกดรับเครดิตด้วยตนเองหรือไม่ รวมถึงข้อจำกัดจำนวนบัญชีและการใช้โปรโมชั่นร่วมกัน ทั้งนี้ การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน
      และผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน หากมีข้อสงสัยสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
