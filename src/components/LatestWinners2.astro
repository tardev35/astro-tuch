---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// Real bank brand colours — these stay as they are through every rebrand and
// are never mapped onto the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Runs on src/lib/winnersFeed.ts, NOT on `<script define:vars>` — define:vars
// forces is:inline, which the gate fails on an indexable page, and it used to
// leave the feed container empty in the HTML (nothing for a crawler, nothing
// without JS, a guaranteed layout shift). Rows are server-rendered here and the
// module only takes over the rotation.
//
// Values come from the domain hash via brandPick/brandFlag, never Math.random()
// or Date.now(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
//
// Every tunable the module reads lives on the markup as data-* (interval, row
// cap, amount range, pending chance, username shape, insert mode, big-win
// threshold) plus the per-row text/class pairs. winnersFeed.ts never learns this
// brand's palette or wording, so a rebrand only ever edits this file.
//
// The heading here is a <p>: this feed is chrome, not docx content, so the
// <section> takes its accessible name from aria-label. The brand name comes from
// BRAND_NAME and is never typed into the markup.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;
const BIG_WIN_ABOVE = 70000;

const initialRows = Array.from({ length: 4 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
    user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `card-pending-${i}`),
  };
});

// Pending/verified stay semantic, not the brand hues — a status colour that
// matches the accent tells the reader nothing. Pending is the body colour dimmed
// on the mid surface, so it reads as "not finished yet" without borrowing the
// accent; done keeps the success green every brand on this template uses, which
// the palette rules leave unmapped on purpose.
const PENDING_CLASS = "text-[#e8f4ff]/80 bg-[#081726] animate-pulse";
const DONE_CLASS = "text-[#052e16] bg-gradient-to-r from-[#86efac] via-[#22c55e] to-[#15803d] font-black shadow-md";

// The amount reacts to its own value rather than to a brand colour: an ordinary
// row is the light blue, a row over the threshold lifts to the logo's gold with
// a glow. Both class lists live here, and the module only swaps between them.
const AMOUNT_CLASS = "text-[#a8dcff]";
const AMOUNT_BIG_CLASS = "text-[#ffc82e] drop-shadow-[0_0_10px_rgba(255,200,46,0.55)]";

// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19, brand-spec §2-§3): ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน
// (ถอนชัวร์168) ใช้ LatestWinners ตัวฐาน จึงหมุนมาที่ไฟล์นี้ และไฟล์นี้ยังถือ
// พาเลตต์ชมพูฮอตพิงก์-ทองของ PUNPRO168 อยู่ทั้งใบ ต้องรีเธมทั้งไฟล์ก่อนใช้
// โลโก้เป็นแมวการ์ตูนขนขาวลายส้มสวมปลอกคอฟ้ามีกระดิ่งทอง นั่งคู่มือถือจอฟ้าที่มี
// ลูกศรดาวน์โหลดและปึกแบงก์สีฟ้า เหนือคำว่า "สบาย" ตัวอักษรไทยหนาสามมิติ **สีทอง**
// ต่อด้วย "เบท168" **ฟ้าบับเบิลผิวมันวาว** ล้อมด้วยหัวใจฟ้าและเหรียญบิตคอยน์ทอง
// แผงนอกจึงเป็นพื้นการ์ดผิวกลาง #081726 ในกรอบน้ำเงินลึก #0b3f78 ออร่าบนหัวเป็น
// ฟ้าแบรนด์ #2f9ff5 การ์ดแต่ละใบตกลงไปที่ผิวจม #040d16 ในเส้นขอบน้ำเงินลึก แล้ว
// สว่างเป็นฟ้าแบรนด์ตอน hover
// ยอดเงินเป็นฟ้าอ่อน #a8dcff และยกเป็นทอง #ffc82e พร้อมแสงเมื่อเกินเกณฑ์ (ตรงกับ
// เหรียญบิตคอยน์ทองกับมงกุฎทองบนอาร์ตเวิร์ก)
// หัวข้อไล่ ฟ้าอ่อน #a8dcff → ฟ้าแบรนด์ #2f9ff5 → ทอง #ffc82e ซึ่งเป็นลำดับที่ตา
// อ่านโลโก้จริง (ไฮไลต์มันวาว → เนื้อฟ้าของ เบท168 → คำว่า สบาย สีทอง) ⚠️ ไล่เฉดนี้
// ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2
// (11.6 / 5.9 ที่ md:text-3xl font-black = large text / 11.3) หัวแถบนี้เป็น <p>
// ไม่ใช่หัวข้อ
// เนื้อความ #e8f4ff (= BRAND_TEXT) ตัวรองใช้ฟ้าอ่อน #a8dcff (11.6:1 บนผิวยก และ
// สูงกว่านั้นบนผิวจม)
// §2 ห้าม #0b3f78 / #5c4a16 ถือตัวอักษร — ที่นี่ #0b3f78 อยู่ที่ขอบการ์ดเท่านั้น
// และ #5c4a16 ไม่ปรากฏในไฟล์นี้เลย
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// ป้าย pending ใช้ผิวกลาง #081726 ซึ่งลอยเหนือผิวจมของการ์ดหนึ่งขั้นพอดี
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ทอง และ ฟ้า** แปดในสิบรอบหลังสุดมีทอง และ TSDET911
// กับ แตกดี168 เป็นแบรนด์ฟ้ามาก่อน เจอฟ้าหรือทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้
// ให้เทียบค่าเป็นตัวๆ: ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เพิ่งค้างในไฟล์นี้
// (f41571 ff5ca8 fce343 f0c3dc fde7f2 8a0a45 4a0426 3a0a2a 1c0014 2e0022
// rgba(252,227,67,α) rgba(244,21,113,α)) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (e8232a f2b705 ffd666 f5cbb0 c9a898 301105 180800 3d1709 7d0f12 fbe8d5 ff5a46)
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (0193fb 7bcffb fce604 064a86 07111d 020609
// 0a1726 dbeafe 93b4d4) และชุดทอง-เงินของ UP555 (ebbb54 fce675 d5d4d3 6b4517 130b03
// 0c0502 241705 f8eed9) ออกครบทุกจุดแล้ว
// **ทองรอบนี้คือ #ffc82e** ไม่ใช่ fce343 fce604 ebbb54 fce675 f2b705 ffd84d fcd434
// f7c92b f0b429 หรือ e3b23c และ **ฟ้ารอบนี้คือ #2f9ff5 / #a8dcff / #0b3f78**
// ไม่ใช่ 0193fb 7bcffb 0a1726 (แตกดี168) 0360f3 0292fb 6ec8ff (TSDET911) หรือ
// cfd9e6 (เงินอมฟ้าของรับตัง168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีส้ม ไม่มีเงิน/โครเมียม และไม่มี
// โรสโกลด์** — สีเขียวที่เหลืออยู่คือป้าย "ถอนสำเร็จแล้ว" ซึ่งเป็นสี semantic
// ตาม §2 ไม่ใช่สีแบรนด์ และสีในตาราง bankPool คือสีจริงของธนาคาร ห้ามแมปทั้งคู่
// เข้าพาเลตต์
//
// ⚠️ ถ้อยคำในแผงนี้มาจากบรีฟรอบนี้ (src/assets/content.txt) เท่านั้น — ไม่มี
// "ถอนง่าย" "ได้เงินจริง" "ไม่มีรีวิวเสีย" หรือ "หลักแสนยูสต่อวัน" ซึ่งเป็นคำของ
// ถอนชัวร์168 ที่ค้าง และไม่มีชื่อค่ายเกมใดๆ เพราะบรีฟรอบนี้ไม่ระบุสักค่าย
// ประโยคปิดท้ายคือคำกำกับของบรีฟเอง (ตรวจสอบรายละเอียดก่อนทำรายการ / ผลลัพธ์ของ
// สมาชิกคนหนึ่งไม่ใช่การรับประกันของทุกคน) ซึ่ง §6 สั่งให้ ship ไปด้วย
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#0b3f78]/80 bg-[#081726]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#2f9ff5]/30 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">💸</span>
      <p class="bg-gradient-to-r from-[#a8dcff] via-[#2f9ff5] to-[#ffc82e] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการฝากถอนล่าสุดของสมาชิก {BRAND_NAME}</p>
      <span aria-hidden="true" class="text-2xl">💸</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-big-win-above={BIG_WIN_ABOVE}
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="4"
      data-insert="prepend"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#0b3f78] bg-[#040d16]/95 p-5 shadow-sm transition-all hover:border-[#2f9ff5]/60 hover:bg-[#081726]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-black/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังดำเนินการ"
                  data-done-text="ถอนสำเร็จแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#a8dcff]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#e8f4ff]">
                    {row.user}
                  </span>
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`mt-1 text-2xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#a8dcff]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#a8dcff]">
      ก่อนยืนยันรายการฝากถอน ควรตรวจสอบยอดเงินและรายละเอียดบัญชีปลายทางให้ตรงกับข้อมูลที่ระบบแจ้งทุกครั้ง หากรายการยังอยู่ระหว่างตรวจสอบไม่ควรกดซ้ำทันที
      และสามารถเก็บหลักฐานรายการไว้สำหรับแจ้งเจ้าหน้าที่จนกว่าจะดำเนินการเสร็จสิ้น ทั้งนี้ผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของสมาชิกทุกคน
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
