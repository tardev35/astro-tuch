---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join.
//
// ชุดรายการหวยต้องตรงกับที่ src/assets/content.txt ระบุไว้เท่านั้น คือ หวยลาว ·
// หวยฮานอย · หวยรัฐบาลไทย · หวยหุ้น — ห้ามเติมรายการย่อยที่บรีฟไม่ได้พูดถึง
// (รอบก่อนมี "ลาวพัฒนา / ฮานอยปกติ / ฮานอยพิเศษ / ฮานอยวีไอพี / หวยหุ้นต่างประเทศ"
// ค้างอยู่ ซึ่งเป็นคำของบรีฟรอบนั้น) และห้ามใส่ตัวเลขอัตราจ่ายลงใน pool นี้ เรทที่
// บรีฟระบุคือ 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท ซึ่งอยู่ในเนื้อหาของหน้า
// ไม่ใช่ตัวเลขที่จะสุ่มเปลี่ยนทุกไม่กี่วินาที
const marketPool = [
  "หวยรัฐบาลไทย · เลข 2 ตัว",
  "หวยรัฐบาลไทย · เลข 3 ตัว",
  "หวยลาว · เลข 2 ตัว",
  "หวยลาว · เลข 3 ตัว",
  "หวยฮานอย · เลข 2 ตัว",
  "หวยฮานอย · เลข 3 ตัว",
  "หวยหุ้น · เลข 2 ตัว",
  "หวยหุ้น · เลข 3 ตัว",
];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. Values come from the domain hash, never
// Math.random(), which in frontmatter runs at build time and fails the gate.
//
// The heading used to be an <h2>. It is a <p> with the accessible name on the
// <section>: the h2 inventory is diffed against the docx checklist every
// rebrand, and a widget that supplies its own h2 breaks that check on every
// page it appears on. Do not promote it again to "fix" the missing name.
//
// The brand name is never typed here — it comes from BRAND_NAME, so the
// aria-label cannot rot into a previous brand's.
//
// ธีม Huay แดง-ทอง-ดำ ของหมวดหวย (/ตรวจหวย) คงไว้ตามข้อยกเว้นใน SKILL.md
// Phase 4.5 ข้อ 5 — ไม่ถูกดึงไปพาเลตต์แดงเข้ม-ทองของแบรนด์รอบนี้ แผงพื้นดำอมแดง
// #1f0a0c ในกรอบทองลึก #8a6a0a แถวรายการตกลงไปที่พื้นการ์ด #120b0c ในเส้นขอบ
// #2a0d0f แล้วสว่างขึ้นเป็นทองรอง #f3c623 ตอน hover ยอดเงินเป็นทองรอง ป้าย
// REAL-TIME เป็นแดง #dc020e ชื่อหัวแผงเป็นทองอ่อน #fde79a เนื้อความ #f0e2e2
// สถานะที่เสร็จแล้วใช้สีเน้น #fff4f4 สีเดียวที่ไม่ใช่ของธีมคือโลโก้ธนาคารจริงใน
// bankPool ซึ่งเป็นสีแบรนด์ธนาคารโดยเจตนาและต้องคงไว้
//
// salt ทุกตัวเป็นชื่อกลาง ("huay-winner-*") ไม่ผูกกับชื่อแบรนด์ใด — รอบก่อน ๆ ตั้ง
// salt เป็นชื่อแบรนด์ ทำให้ชื่อแบรนด์ที่ตายแล้วค้างอยู่ในซอร์สข้ามรีแบรนด์เสมอ
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[pick(`huay-winner-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`huay-winner-market-${i}`, marketPool.length)],
  user: `0${pick(`huay-winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`huay-winner-u${i}`, 4)}`,
  amount: (5000 + pick(`huay-winner-amount-${i}`, 145001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `huay-winner-pending-${i}`),
}));

const PENDING_CLASS = "text-[#fde79a] animate-pulse";
const DONE_CLASS = "text-[#fff4f4]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`ยอดถูกรางวัลและรายการโอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative rounded-3xl border border-[#8a6a0a]/60 bg-[#1f0a0c]/90 px-4 py-8 shadow-[0_10px_30px_rgba(5,1,2,0.7)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-[#8a6a0a]/45 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(243,198,35,0.8)]">🎫</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#fde79a] drop-shadow-sm">ยอดถูกรางวัล · โอนล่าสุด</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#dc020e]/70 bg-[#2a0d0f]/85 px-3 py-1 text-[10px] font-bold tracking-widest text-[#fde79a] shadow-[0_0_10px_rgba(220,2,14,0.4)]">
        REAL-TIME
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min="5000"
      data-amount-max="150000"
      data-pending-chance="0.3"
      data-user-style="phone"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#2a0d0f] bg-[#120b0c]/75 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#f3c623]/55 hover:bg-[#2a0d0f]/80 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain grayscale" />
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-medium tracking-widest text-[#f0e2e2]/70">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#f0e2e2]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#f0e2e2]/70">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#2a0d0f] pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจโพย"
                  data-done-text="โอนเข้าบัญชีแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจโพย" : "โอนเข้าบัญชีแล้ว"}
                </div>
                <div class="font-sans text-xl font-black text-[#f3c623] drop-shadow-[0_2px_5px_rgba(243,198,35,0.45)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#f0e2e2]/70">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
