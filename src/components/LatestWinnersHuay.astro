---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// สีใน bankPool คือสีโลโก้ธนาคารจริง — ไม่ใช่สีแบรนด์ ห้าม retheme (brand-spec §2)
// ⚠️ คลาสต้องคงรูป bg-[#......] ไว้ เพราะ winnersFeed.ts ถอดคลาสที่ขึ้นต้นด้วย
// "bg-[" ออกจากป้ายธนาคารตอนสลับแถว
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join.
//
// ป้ายในชุดนี้ใช้ได้แค่คำที่บรีฟรอบนี้ให้มา (brand-spec §5) — บรีฟรอบนี้ระบุประเภท
// หวยไว้เองครบทั้งสี่ (**หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ**)
// และระบุรูปแบบการเดิมพัน (**สองตัวบน/สองตัวล่าง · สามตัวตรง/สามตัวโต๊ด**) จึงใช้
// เป็นชื่อรายการได้
// ⚠️⚠️ **"หวยออมสิน" / "หวยลาวพัฒนา" / "เครดิตคืนยอดเสีย" / "เครดิตแนะนำเพื่อน"
// ไม่มีในบรีฟรอบนี้** (สองคำแรกเป็นของแบรนด์หวยเจ้าก่อน สองคำหลังเป็นคอปปี้
// โปรโมชั่นของแบรนด์ขาออกรอบก่อน) ถอดออกครบแล้ว — **บรีฟรอบนี้ไม่มีหมวดโปรโมชั่น
// และไม่มีหมวดฝากถอน/ธนาคารเลย** ห้ามเขียนกลับเข้ามา
// ⚠️ ห้ามใส่ตัวเลขอัตราจ่ายลงใน pool นี้ — อัตราจ่ายเป็นค่าที่สมาชิกต้องอ่านจากหน้า
// รายการจริง ไม่ใช่ตัวเลขที่จะสุ่มเปลี่ยนทุกไม่กี่วินาที และห้ามใช้ศัพท์สล็อต/
// คาสิโนของแบรนด์ขาออก (บาคาร่า · คาสิโนสด · ฟรีสปิน · ค่า RTP · เบทเริ่มต้น)
const marketPool = ["หวยรัฐบาลไทย · บิลหวย", "หวยฮานอย · บิลหวย", "หวยลาว · บิลหวย", "หวยหุ้นต่างประเทศ · บิลหวย", "หวยรัฐบาลไทย · สองตัวบน", "หวยลาว · สามตัวตรง"];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. ค่าทุกตัวมาจาก hash ของโดเมน ไม่ใช่ Math.random() /
// Date.now() / new Date() ซึ่งใน frontmatter รันตอน build แล้วทำให้ build สองครั้ง
// ของโดเมนเดียวกันไม่เหมือนกัน และ gate จะตีตก แถวแรกทั้งห้าแถว server-render
// เสมอ ห้ามเปลี่ยนเป็นคอนเทนเนอร์เปล่าที่ JS มาเติม และ **ห้าม define:vars**
//
// ชื่อแผงเป็นย่อหน้า ไม่ใช่ heading ระดับไหนเลย และชื่อที่ assistive tech อ่านมาจาก
// aria-label บน <section>: รายการ h2 ถูก diff กับ checklist ของบรีฟทุกรอบ วิดเจ็ตที่
// แจก h2 ของตัวเองจะทำให้เช็กนั้นพังทุกหน้าที่มันโผล่ ห้ามโปรโมตกลับเป็น heading
// เพื่อ "แก้" ชื่อที่หายไป ส่วนชื่อแบรนด์ไม่พิมพ์ทับ — มาจาก BRAND_NAME จึงรอตเป็น
// แบรนด์ก่อนไม่ได้
//
// รอบนี้ (ดรอป 2026-10-28) ไฟล์นี้คือ **ฟีดหลัก** ตามการหมุน variant
// (LatestWinners4 -> LatestWinnersHuay) ถูก render จาก **หน้าแรก** และ
// **/ตรวจหวย** — **ห้ามลบ variant ที่ไม่ได้ใช้** ทุกตัวเป็น inventory ของแบรนด์ถัดไป
//
// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ (Tailwind สแกนคอมเมนต์ด้วย) และ
// **ห้ามเขียน "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้** — การ sweep ไล่หา
// สีของแบรนด์เก่าใน src/ จะสะดุดที่คอมเมนต์ของตัวเองทุกครั้ง
// **ลิสต์ค่าต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lottoplus.md` §2 ที่เดียว**
//
// 🚨 **ไฟล์นี้ยังเป็นผิวสว่างเหมือนรอบก่อน แต่ด้วยเหตุผลที่ต้องอ่านใหม่ทุกรอบ**
// พื้นเพจรอบนี้คือ **เขียวมินต์จาง #e1fef3** (จาก bg.json ซึ่งเป็นแหล่งเดียวของ
// พื้นเพจ) และฟีดนี้อยู่ในโซนเนื้อหา ไม่ใช่โซนโครม (โครมเข้มรอบนี้คือ navbar ·
// footer · ticker · แถบล่างมือถือ เท่านั้น) **ห้าม "แก้" ให้เป็นพื้นมืด**
//
// พาเลตรอบนี้ (`.claude/brand-spec-lottoplus.md` §2 — เขียวมรกตนำ ทองคู่รอง
// **เนื้อหาเป็นผิวสว่าง**): แผงพื้นผิวการ์ด #ffffff ในกรอบ #a3ddc3
// แถวรายการตกลงไปที่การ์ดสำรอง #f0fdf7 แล้วเข้มขึ้นเป็น wash #d2f3e4 ตอน hover
// ยอดเงินเป็นเขียวมรกต #046c4e (6.7:1 บนขาว · 6.4:1 บน #f0fdf7)
// และสลับเป็น **เขียวลึก #03543c** (9.2:1) พร้อม glow แรงขึ้นเมื่อยอดเกิน
// data-big-win-above — คู่ "นำ × ลึก" นี้อ่านมาจากบรรทัดล่างของเวิร์ดมาร์กที่เป็น
// ผิวเขียวมรกตไล่เงา และจากใบโคลเวอร์สี่แฉกที่แทนตัว O ตัวที่สอง
// ป้ายอัปเดตสดเป็น #046c4e บนชั้นยก #f0fdf7 เนื้อความ #0d3326 (13.8:1)
// คำบรรยายย่อยเป็นหมึกรอง #3f6f5c (6.0:1 บนขาว)
// glow เป็น rgba(4,108,78,*) กับ rgba(3,84,60,*)
// ⚠️⚠️ **ขาวบนพื้นเพจ #e1fef3 ได้แค่ 1.07:1** และ **#19a97c (3.0:1) / #e2b32a
// (2.0:1) / #a3ddc3 / #d2f3e4 / #2fd49b / #c8d4d0 ห้ามถือตัวอักษรบนผิวสว่าง** —
// ไฟล์นี้จึงไม่มีตัวอักษรสว่างบนผิวสว่าง และไม่มีพื้นถมเขียวสดที่มีตัวอักษรอยู่เลย
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(3,84,60,α) · rgba(25,169,124,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(163,221,195,α)
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์ชุด Huay เคยเป็นของแบรนด์หวยเจ้า
// ก่อน ๆ หลายเจ้าที่ใช้แดง/ทองใกล้กันมาก **และรอบนี้เป็นแบรนด์เขียว ซึ่งเป็นตระกูล
// เดียวกับ สาธุ168 / TEVA69 / ZORO365 เป๊ะ** → **"เจอเขียว ≠ เป็นของรอบนี้"**
// ทุกค่าในไฟล์นี้ต้องตรงกับตารางใน §2 ของ brand-spec ทีละหกหลัก **ห้ามตัดสินด้วย
// สายตา** และถ้าเจอค่าที่ต่างจาก §2 แค่ไบต์เดียว ให้ถือว่า **พิมพ์ผิด** ก่อนเสมอ
// ⚠️ รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู ไม่มีแดงเลือดนก และไม่มีส้มเพลิง
// เลยสักเฉด
// 🚨🚨 **เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินใน variant อื่น
// อยู่ไฟล์อื่น คงไว้ ห้ามเปลี่ยน และห้ามเอามาใช้เป็นสีแบรนด์** — รอบนี้แบรนด์ก็เป็น
// เขียว จึงเป็นรอบที่สับสนสองค่านี้ได้ง่ายที่สุด
//
// salt ทุกตัวเป็นชื่อกลาง ("huay-winner-*") ไม่ผูกกับชื่อแบรนด์ใด — รอบก่อน ๆ ตั้ง
// salt เป็นชื่อแบรนด์ ทำให้ชื่อแบรนด์ที่ตายแล้วค้างอยู่ในซอร์สข้ามรีแบรนด์เสมอ
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const AMOUNT_MIN = 5000;
const AMOUNT_MAX = 150000;
const BIG_WIN_ABOVE = 100000;

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`huay-winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`huay-winner-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`huay-winner-market-${i}`, marketPool.length)],
    user: `0${pick(`huay-winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`huay-winner-u${i}`, 4)}`,
    amount: amount.toLocaleString("en-US"),
    big: amount > BIG_WIN_ABOVE,
    pending: brandFlag(Astro.site, `huay-winner-pending-${i}`),
  };
});

const PENDING_TEXT = "กำลังตรวจสอบรายการ";
const DONE_TEXT = "โอนเข้าบัญชีแล้ว";
const PENDING_CLASS = "text-[#046c4e] animate-pulse";
const DONE_CLASS = "text-[#0d3326]";
const AMOUNT_CLASS = "text-[#046c4e] drop-shadow-[0_2px_5px_rgba(4,108,78,0.35)]";
const AMOUNT_BIG_CLASS = "text-[#03543c] drop-shadow-[0_2px_10px_rgba(3,84,60,0.55)]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`รายการถอนล่าสุดจากบิลหวยของสมาชิก ${BRAND_NAME}`}
    class="relative rounded-3xl border border-[#a3ddc3] bg-[#ffffff]/95 px-4 py-8 shadow-[0_10px_30px_rgba(4,108,78,0.14)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-[#a3ddc3] pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(4,108,78,0.45)]">🎫</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#046c4e]">รายการถอนล่าสุด · บิลหวย</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#046c4e]/40 bg-[#f0fdf7] px-3 py-1 text-[10px] font-bold tracking-widest text-[#046c4e] shadow-[0_0_10px_rgba(4,108,78,0.2)]">
        อัปเดตสด
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min={String(AMOUNT_MIN)}
      data-amount-max={String(AMOUNT_MAX)}
      data-pending-chance="0.3"
      data-user-style="phone"
      data-user-digits="4"
      data-insert="prepend"
      data-big-win-above={String(BIG_WIN_ABOVE)}
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#a3ddc3] bg-[#f0fdf7]/80 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#046c4e]/55 hover:bg-[#d2f3e4]/85 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#a3ddc3] shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt={`โลโก้ธนาคาร ${row.bank.name}`} width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div class="flex flex-col gap-0.5">
                  <span class="text-[10px] font-medium tracking-widest text-[#3f6f5c]">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#0d3326]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#3f6f5c]">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#a3ddc3] pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </div>
                <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={AMOUNT_BIG_CLASS} class={`text-xl font-black ${row.big ? AMOUNT_BIG_CLASS : AMOUNT_CLASS}`}>
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#3f6f5c]">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
