---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join. บรีฟของ LOTTO24 บอกว่า
// "รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว" และระบุอัตราจ่ายไว้ทั้งเลข 2 ตัว
// และ 3 ตัว ป้ายในฟีดจึงเป็น "ตลาด · ประเภทเลข" ได้ โดยชุดตลาดตรงกับตารางอัตราจ่าย
// ใน LoginRtpSection คือ รัฐบาล ฮานอย ลาว ยี่กี — ห้ามเติมตลาดอื่นนอกชุดนี้ และห้าม
// ใส่ตัวเลขอัตราจ่ายลงใน pool นี้ เรทคือ 3 ตัวสูงสุด 1,000 กับ 2 ตัว 100 ซึ่งอยู่ใน
// หัวข้อ H2 ของหน้าแรกและในตารางอัตราจ่าย ไม่ใช่ตัวเลขที่จะสุ่มเปลี่ยนทุกไม่กี่วินาที
const marketPool = [
  "หวยรัฐบาล · เลข 2 ตัวบน",
  "หวยรัฐบาล · เลข 3 ตัวตรง",
  "หวยฮานอย · เลข 2 ตัวล่าง",
  "หวยฮานอย · เลข 3 ตัวตรง",
  "หวยลาว · เลข 2 ตัวบน",
  "หวยลาว · เลข 3 ตัวโต๊ด",
  "หวยยี่กี · เลข 2 ตัวบน",
  "หวยยี่กี · เลข 3 ตัวตรง",
];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. Values come from the domain hash, never
// Math.random(), which in frontmatter runs at build time and fails the gate.
//
// The heading used to be an <h2>. It is a <p> with the accessible name on the
// <section>: the h2 inventory is diffed against the docx checklist every
// rebrand, and a widget that supplies its own h2 breaks that check on every
// page it appears on. Do not promote it again to "fix" the missing name.
//
// The brand name is never typed here — it comes from BRAND_NAME, so the
// aria-label cannot rot into a previous brand's.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): ธีม Huay คือแดง-ทอง ซึ่งตรงกับแบรนด์นี้พอดี
// แต่ค่าสีสร้างใหม่จากพาเลตต์แบรนด์นี้ทั้งชุด — แผงพื้นการ์ด #2a0405 ในกรอบทองลึก
// #a16207 แถวรายการตกลงไปที่พื้นลึก #140202 ในเส้นพื้นยก #3b0404 แล้วสว่างขึ้นเป็น
// ทองหลัก #fbbf24 ตอน hover ยอดเงินเป็นทองหลักตามกองเหรียญทองในงานอาร์ต ป้าย
// REAL-TIME เป็นแดงแบรนด์ #dc2626 ตามเลข 24 สีแดงบนโลโก้ ชื่อหัวแผงเป็นทองอ่อน
// #fde68a เนื้อความ #f6e2e2 เนื้อความรอง #d9b3b3 — ชุดของ 888PARUAY (#fcdc2b
// #fff6ae #a87d0c #cf1111 #240808 #140404 #3a0f0f #e8e4c6 #c3b98f #fffdf0) ออก
// ทั้งหมด สีเดียวที่ไม่ใช่ของแบรนด์คือโลโก้ธนาคารจริงใน bankPool ซึ่งต้องคงไว้
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[pick(`lotto-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`lotto-market-${i}`, marketPool.length)],
  user: `0${pick(`lotto-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`lotto-u${i}`, 4)}`,
  amount: (5000 + pick(`lotto-amount-${i}`, 145001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `lotto-pending-${i}`),
}));

const PENDING_CLASS = "text-[#fde68a] animate-pulse";
const DONE_CLASS = "text-[#fff1f1]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`ยอดถูกรางวัลและรายการโอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative rounded-3xl border border-[#a16207]/60 bg-[#2a0405]/90 px-4 py-8 shadow-[0_10px_30px_rgba(8,1,1,0.7)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-[#a16207]/45 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(251,191,36,0.8)]">🎫</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#fde68a] drop-shadow-sm">ยอดถูกรางวัล · โอนล่าสุด</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#dc2626]/70 bg-[#3b0404]/85 px-3 py-1 text-[10px] font-bold tracking-widest text-[#fde68a] shadow-[0_0_10px_rgba(220,38,38,0.35)]">
        REAL-TIME
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min="5000"
      data-amount-max="150000"
      data-pending-chance="0.3"
      data-user-style="phone"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#3b0404] bg-[#140202]/70 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#fbbf24]/50 hover:bg-[#3b0404]/80 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain grayscale" />
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-medium tracking-widest text-[#d9b3b3]">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#f6e2e2]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#d9b3b3]">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#3b0404] pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจโพย"
                  data-done-text="โอนเข้าบัญชีแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจโพย" : "โอนเข้าบัญชีแล้ว"}
                </div>
                <div class="font-sans text-xl font-black text-[#fbbf24] drop-shadow-[0_2px_5px_rgba(251,191,36,0.4)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#d9b3b3]">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
