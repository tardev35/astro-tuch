---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join. บรีฟของ 365LOTTO ระบุ
// ตลาดไว้สามรายการเท่านั้น — รัฐบาลไทย ฮานอย ลาวพัฒนา — ป้ายในฟีดจึงเป็น
// "ตลาด · ประเภทเลข" ได้โดยมีบรีฟรองรับ ห้ามเติมตลาดอื่นที่บรีฟไม่ได้ระบุ
// (หวยหุ้นต่างประเทศของแบรนด์ก่อนหน้าออกไปด้วยเหตุนี้) และห้ามใส่ตัวเลขอัตราจ่าย
// ลงใน pool นี้ — เรทคือ 2 ตัวจ่าย 100 กับ 3 ตัวจ่าย 1,000 ซึ่งอยู่ในหัวข้อ H3
// ของหน้า ไม่ใช่ตัวเลขที่จะสุ่มเปลี่ยนทุกไม่กี่วินาทีในฟีด
const marketPool = ["รัฐบาลไทย · เลข 2 ตัวบน", "รัฐบาลไทย · เลข 3 ตัวตรง", "ฮานอย · เลข 2 ตัวล่าง", "ฮานอย · เลข 3 ตัวตรง", "ลาวพัฒนา · เลข 2 ตัวบน", "ลาวพัฒนา · เลข 3 ตัวโต๊ด"];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. Values come from the domain hash, never
// Math.random(), which in frontmatter runs at build time and fails the gate.
//
// The heading used to be an <h2>. It is a <p> with the accessible name on the
// <section>: the h2 inventory is diffed against the docx checklist every
// rebrand, and a widget that supplies its own h2 breaks that check on every
// page it appears on. Do not promote it again to "fix" the missing name.
//
// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): แผงพื้นการ์ด #1a0709 ในกรอบ
// ทองลึก #9c6a12 แถวรายการตกลงไปที่พื้นเพจ #120406 ในเส้นพื้นยก #2a0b0e แล้ว
// สว่างขึ้นเป็นทองหลัก #fadc64 ตอน hover ยอดเงินเป็นทองหลัก ป้าย REAL-TIME เป็น
// แดงสด #e01f26 ตามวง O บนโลโก้ ชื่อหัวแผงเป็นเงินโครเมียม #f3f6fa เนื้อความรอง
// #d8bda6 — ชุดกรมท่า-ทองของหวยพยัคฆ์ (#030b1c #08152f #0f2149 #1c3566 #dbe4f7
// #9fb0d0 #e8eef8 #fadb6c #fdf5a4 #ab6d13) ออกทั้งหมด สีเดียวที่ไม่ใช่ของแบรนด์
// คือโลโก้ธนาคารจริงใน bankPool ซึ่งต้องคงไว้
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[pick(`lotto-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`lotto-market-${i}`, marketPool.length)],
  user: `0${pick(`lotto-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`lotto-u${i}`, 4)}`,
  amount: (5000 + pick(`lotto-amount-${i}`, 145001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `lotto-pending-${i}`),
}));

const PENDING_CLASS = "text-[#fdf3b4] animate-pulse";
const DONE_CLASS = "text-[#f3f6fa]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`ยอดถูกรางวัลและรายการโอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative rounded-3xl border border-[#9c6a12]/60 bg-[#1a0709]/90 px-4 py-8 shadow-[0_10px_30px_rgba(18,4,6,0.7)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-[#9c6a12]/45 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,220,100,0.8)]">🎫</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#f3f6fa] drop-shadow-sm">ยอดถูกรางวัล · โอนล่าสุด</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#e01f26]/70 bg-[#2a0b0e]/85 px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf3b4] shadow-[0_0_10px_rgba(224,31,38,0.35)]">
        REAL-TIME
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min="5000"
      data-amount-max="150000"
      data-pending-chance="0.3"
      data-user-style="phone"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#2a0b0e] bg-[#120406]/70 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#fadc64]/50 hover:bg-[#2a0b0e]/80 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain grayscale" />
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-medium tracking-widest text-[#d8bda6]">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#f0ddc4]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#d8bda6]">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#2a0b0e] pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจโพย"
                  data-done-text="โอนเข้าบัญชีแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจโพย" : "โอนเข้าบัญชีแล้ว"}
                </div>
                <div class="font-sans text-xl font-black text-[#fadc64] drop-shadow-[0_2px_5px_rgba(250,220,100,0.4)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#d8bda6]">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
