---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join. The labels stay
// inside what the brief states — เลข 2 ตัว / เลข 3 ตัว, เลขดัง, เลขอั้น — and
// name no specific lottery market, which the brief never does.
const marketPool = ["เลข 2 ตัว · บาทละ 100", "เลข 3 ตัว · บาทละ 1,000", "เลขดัง · เลข 2 ตัว", "เลขอั้น · เลข 3 ตัว", "เลขกระแส · เลข 2 ตัว", "เลขดัง · เลข 3 ตัว"];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. Values come from the domain hash, never
// Math.random(), which in frontmatter runs at build time and fails the gate.
//
// The heading used to be an <h2>. It is back to a <p> with the accessible name
// on the <section>: the h2 inventory is diffed against the docx checklist every
// rebrand, and a widget that supplies its own h2 breaks that check on every
// page it appears on. Do not promote it again to "fix" the missing name.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[pick(`lotto-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`lotto-market-${i}`, marketPool.length)],
  user: `0${pick(`lotto-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`lotto-u${i}`, 4)}`,
  amount: (5000 + pick(`lotto-amount-${i}`, 145001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `lotto-pending-${i}`),
}));

const PENDING_CLASS = "text-[#f7e8b4] animate-pulse";
const DONE_CLASS = "text-[#2a9d5c]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label="รายการถูกรางวัลล่าสุดของสมาชิก กินดี365"
    class="relative rounded-3xl border border-[#c1121f]/55 bg-[#3d0b0e]/75 px-4 py-8 shadow-[0_10px_30px_rgba(26,4,5,0.6)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-[#c1121f]/50 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(227,197,106,0.8)]">🎉</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#f4e7d3] drop-shadow-sm">รายการถูกรางวัลล่าสุด</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#2a9d5c]/60 bg-[#0d3a22]/70 px-3 py-1 text-[10px] font-bold tracking-widest text-[#2a9d5c] shadow-[0_0_10px_rgba(42,157,92,0.25)]">
        REAL-TIME
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min="5000"
      data-amount-max="150000"
      data-pending-chance="0.3"
      data-user-style="phone"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#8a1017]/70 bg-[#1a0405]/45 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#e3c56a]/45 hover:bg-[#1a0405]/70 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain grayscale" />
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-medium tracking-widest text-[#cbaa8d]">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#f4e7d3]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#cbaa8d]">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#8a1017]/60 pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจโพย"
                  data-done-text="โอนเงินรางวัลแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจโพย" : "โอนเงินรางวัลแล้ว"}
                </div>
                <div class="font-sans text-xl font-black text-[#e3c56a] drop-shadow-[0_2px_5px_rgba(227,197,106,0.35)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#f7e8b4]">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
