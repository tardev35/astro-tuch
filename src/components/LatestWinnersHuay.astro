---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Pre-formatted, because the shared module treats a market as one opaque label
// rather than a name/type pair it has to know how to join. บรีฟของ MHEEPOOH168
// ระบุเพียงว่ามีหมวด "หวย" อยู่ในระบบเดียวกับบาคาร่า สล็อต และบอล โดยไม่ได้ระบุ
// ชื่อตลาดหวยรายตัว ป้ายในฟีดจึงเป็นประเภทของเลขที่แทงเท่านั้น ห้ามเติมชื่อตลาด
// (รัฐบาลไทย ลาว ฮานอย หุ้น ออมสิน ฯลฯ) กลับเข้ามาโดยไม่มีบรีฟรองรับ
// และห้ามใส่ตัวเลขอัตราจ่ายลงใน pool นี้ — เรทเป็นค่าที่ระบบแสดงต่อรอบ ไม่ใช่
// ตัวเลขคงที่ที่จะโชว์ในฟีดซึ่งสุ่มเปลี่ยนทุกไม่กี่วินาที
const marketPool = [
  "หวย · เลข 2 ตัวบน",
  "หวย · เลข 2 ตัวล่าง",
  "หวย · เลข 3 ตัวตรง",
  "หวย · เลข 3 ตัวโต๊ด",
  "หวย · เลขวิ่งบน",
  "หวย · เลขวิ่งล่าง",
  "หวย · ชุดเลข 2 ตัว",
  "หวย · ชุดเลข 3 ตัว",
];

// Ported off `<script define:vars={{ bankPool, marketPool }}>` — see
// src/lib/winnersFeed.ts. Values come from the domain hash, never
// Math.random(), which in frontmatter runs at build time and fails the gate.
//
// The heading used to be an <h2>. It is a <p> with the accessible name on the
// <section>: the h2 inventory is diffed against the docx checklist every
// rebrand, and a widget that supplies its own h2 breaks that check on every
// page it appears on. Do not promote it again to "fix" the missing name.
//
// This feed renders on /ตรวจหวย only, so the row states ถูกรางวัล/โอนเข้าบัญชี
// rather than a casino win — it illustrates the brief's own "ตรวจสอบสถานะรายการ
// และยอดผ่านบัญชีของตัวเองได้" line, not a payout guarantee.
// Palette is red on near-black only (ธีม Huay ของหน้าหวย ซึ่ง playbook ยกเว้นไว้
// ใน Phase 4.5): the pending state is pale rose and the completed state is cream,
// so no second hue (gold or green) survives here.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[pick(`lotto-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`lotto-market-${i}`, marketPool.length)],
  user: `0${pick(`lotto-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`lotto-u${i}`, 4)}`,
  amount: (5000 + pick(`lotto-amount-${i}`, 145001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `lotto-pending-${i}`),
}));

const PENDING_CLASS = "text-[#ff9a9d] animate-pulse";
const DONE_CLASS = "text-[#ffe9ea]";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label="ยอดถูกรางวัลและรายการถอนล่าสุดของสมาชิก MHEEPOOH168"
    class="relative rounded-3xl border border-[#c21e22]/55 bg-[#140a0c]/75 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-[#c21e22]/50 pb-4">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(226,53,58,0.8)]">🎉</span>
        <p class="text-xl leading-normal font-black tracking-widest text-[#ffe9ea] drop-shadow-sm">ยอดถูกรางวัล · ถอนล่าสุด</p>
      </div>
      <span class="animate-pulse rounded-full border border-[#e2353a]/60 bg-[#3a0709]/70 px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff8a8d] shadow-[0_0_10px_rgba(226,53,58,0.25)]">
        REAL-TIME
      </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="5"
      data-amount-min="5000"
      data-amount-max="150000"
      data-pending-chance="0.3"
      data-user-style="phone"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-bottom transition-all duration-500 ease-out">
            <div class="flex flex-col justify-between gap-4 rounded-xl border border-[#7d1114]/70 bg-[#0a0608]/45 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[#e2353a]/45 hover:bg-[#1c0d0f]/70 sm:flex-row sm:items-center">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain grayscale" />
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-medium tracking-widest text-[#bdb4b6]">เบอร์สมาชิก</span>
                  <span data-winner-user class="font-mono text-sm font-bold text-[#ded9da]">
                    {row.user}
                  </span>
                  <span data-winner-market class="text-[10px] tracking-wide text-[#bdb4b6]">
                    {row.market}
                  </span>
                </div>
              </div>
              <div class="flex items-center justify-between gap-6 border-t border-[#7d1114]/60 pt-3 sm:justify-end sm:border-none sm:pt-0">
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจโพย"
                  data-done-text="โอนเข้าบัญชีแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`text-[11px] font-medium tracking-wider ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจโพย" : "โอนเข้าบัญชีแล้ว"}
                </div>
                <div class="font-sans text-xl font-black text-[#e2353a] drop-shadow-[0_2px_5px_rgba(226,53,58,0.35)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs font-bold text-[#ff8a8d]">บาท</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-row.is-entering {
    transform: translateY(1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
