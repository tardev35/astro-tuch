---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — 789BETTING เป็น
// คาสิโนฐานเข้าหลักที่รวมบาคาร่า รูเล็ต บอล หวย สล็อต ส่วน แตกดี168 เป็น
// **เว็บสล็อตออนไลน์ล้วน** ที่พูดถึงเกมสล็อตถูกลิขสิทธิ์ โบนัสสมาชิกทุกวัน และ
// รีวิวถอนจริงเท่านั้น แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบน
// ประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เกมสล็อต · ถูกลิขสิทธิ์ · ทางเข้าเล่นเกมเดิมพัน · ไม่มีขั้นต่ำ · สล็อตคลาสสิก ·
// เกมโบนัส · ฟรีสปิน · ตัวคูณ · เกมเปิดใหม่ · ค่าย/ผู้ให้บริการ ·
// โบนัสสมาชิกทุกวัน · การันตีเว็บแท้ · รีวิวถอนจริง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · รอบตัดยอด · ยอดที่เข้าเกณฑ์ · รอบการรับสิทธิ์ · Login ·
// เครดิต · ประวัติรายการ · สมัครสมาชิก · แอดมิน 24 ชั่วโมง · ฝากถอน · PIN · OTP ·
// หลักฐานธุรกรรม · ช่องทางหลัก
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §6 (คาสิโนฐานเข้าหลัก ·
// เดิมพันตรงกับบริษัท 100% · บาคาร่า · รูเล็ต · ไฮโล · โต๊ะสด · คาสิโนไลฟ์ · บอล ·
// หวย · โพย · เลขเด็ด · แนวทาง · งวด · อัตราจ่าย · ตรวจหวย · เบทต่ำ · ทุนน้อย ·
// ค่ายตรง · VIP · ไฮคลาส · ส่งตรงจากเว็บแม่ · ไม่ผ่านบัญชีม้า · สมัคร 3 ขั้นตอน) —
// ไม่เหลือแม้คำเดียว และรอบนี้ไม่มีคำว่า หวย ที่ไหนบนเว็บเลย เพราะ แตกดี168 เป็น
// เว็บสล็อต ไม่ใช่เว็บหวย (/ตรวจหวย กับ /แนวทาง ยังจอดอยู่ใน src/pages-disabled/)
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้ให้ค่า RTP ของเกมไว้เลย และ §6 ห้ามอ้างตัวเลขที่บรีฟไม่ได้ระบุ
// คำว่า RTP จึงไม่ปรากฏในเนื้อหาแม้แต่ครั้งเดียว แผงขวาเป็น "หมวดเกมสล็อตและสิทธิ์
// ที่เลือกได้" ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ชื่อค่ายเกม · เลขใบอนุญาต · ชื่อผู้ดำเนินงาน ·
// ชื่อนิติบุคคล · ชื่อธนาคาร · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ค่า RTP —
// บรีฟไม่ได้ให้ไว้สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง
// ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีสามตัว: 0.3% · 0.8% · 24 ชั่วโมง
const gameTypes = [
  { icon: "🎰", name: "สล็อตคลาสสิก", detail: "สล็อตคลาสสิกเป็นรูปแบบพื้นฐานที่กติกาเข้าใจง่าย เลือกเข้าเล่นผ่านมือถือจากบัญชีเดียวได้" },
  { icon: "🎁", name: "เกมโบนัส", detail: "เกมโบนัสมีรอบพิเศษตามที่แต่ละเกมกำหนดไว้เอง จึงควรอ่านกติกาภายในเกมก่อนเริ่มเล่น" },
  { icon: "🌀", name: "ฟรีสปิน", detail: "ฟรีสปินเป็นรอบหมุนที่เกมให้ตามเงื่อนไขของตัวเอง จำนวนรอบและวิธีได้มาต่างกันไปตามเกม" },
  { icon: "📈", name: "ตัวคูณ", detail: "ตัวคูณเป็นกลไกภายในเกม ค่าตัวคูณและเงื่อนไขที่ทำให้เกิดขึ้นไม่เหมือนกันในแต่ละรายการ" },
  { icon: "🆕", name: "เกมเปิดใหม่", detail: "เกมเปิดใหม่จะแสดงตามรายการที่ให้บริการในช่วงนั้น จึงควรดูรายการล่าสุดที่ระบบแสดงไว้" },
  { icon: "🏷️", name: "ค่ายและผู้ให้บริการ", detail: "การระบุว่าเกมสล็อตถูกลิขสิทธิ์ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "สมาชิกที่มียอดเสียตรงตามเงื่อนไขตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนดได้" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "เมื่อเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์" },
  { icon: "📑", name: "เครดิตและประวัติรายการ", detail: "เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้สะดวก" },
  { icon: "🏦", name: "ฝากถอน", detail: "รายการฝากถอนติดตามสถานะได้จากบัญชีสมาชิก หากยังอยู่ระหว่างตรวจสอบไม่ควรกดซ้ำทันที" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 4, 6, 16, 19)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้ — บรีฟรอบนี้กำกับตัวเองหนักกว่าปกติ และ §6 สั่งให้
// ship คำกำกับนั้นไปด้วย ไม่ใช่ตัดออกเพราะฟังดูไม่ขายของ
const beforePlayChecks = [
  {
    icon: "🔎",
    name: "วงเงินจริงของแต่ละเกม",
    detail: "สำหรับเกมที่รองรับการเดิมพันยอดต่ำสามารถเลือกเล่นตามงบได้ แต่คำว่าไม่มีขั้นต่ำควรตรวจสอบวงเงินจริงของแต่ละเกม เพราะแต่ละเกมและแต่ละค่ายกำหนดช่วงเดิมพันไว้ไม่เท่ากัน",
    tag: "ดูก่อนเริ่มเล่น",
  },
  {
    icon: "🏷️",
    name: "ข้อมูลค่ายที่ตรวจสอบได้",
    detail: "การระบุว่าเกมสล็อตถูกลิขสิทธิ์ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ ส่วนคำว่าการันตีเว็บแท้และมีรีวิวถอนจริงเพียบ ควรมีข้อมูลที่ตรวจสอบย้อนกลับได้ประกอบด้วย",
    tag: "ตรวจย้อนกลับได้",
  },
  {
    icon: "🧾",
    name: "รายละเอียดโบนัสล่าสุดจากระบบ",
    detail: "โปรโมชั่นที่เปิดให้รับในแต่ละวันมีเงื่อนไข ยอดที่เข้าเกณฑ์ และรอบการรับสิทธิ์ของตัวเอง โบนัสที่ได้รับจริงจึงควรยึดรายละเอียดล่าสุดจากระบบเป็นหลัก",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🔐",
    name: "ช่องทางหลักและรหัสผ่าน",
    detail: "ก่อนสมัครควรตรวจสอบว่าเข้าสู่ช่องทางหลักและกรอกข้อมูลให้ถูกต้อง ควรตั้งรหัสผ่านที่คาดเดายากและไม่ใช้รหัสเดียวกับบริการสำคัญอื่น รวมถึงไม่ส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "เกมสล็อต",
  "ถูกลิขสิทธิ์",
  "ทางเข้าเล่นเกมเดิมพัน",
  "สล็อตคลาสสิก",
  "เกมโบนัส",
  "ฟรีสปิน",
  "ตัวคูณ",
