---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// PREMSUK365 is a เว็บหวย brand, so every row below stays inside what the brief
// states: การรับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ, การแสดงอัตราจ่ายให้
// ตรวจสอบก่อนส่งโพย, การเลือกเลขและกำหนดยอดเอง, การเช็กบิลย้อนหลังได้ด้วยตัวเอง,
// ระบบฝากถอนออโต้ผ่านวอลเลทและธนาคารที่รองรับ, การติดตามสถานะและประวัติธุรกรรม
// และการแจ้งแอดมินพร้อมประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state — the only rates on this page are the brief's own 2 ตัวบาทละ
// 100 และ 3 ตัวบาทละ 1,000 ในตารางอัตราจ่าย.
const menus = [
  { icon: "🔥", name: "เลขดังและเลขกระแส", detail: "ตรวจสอบเลขที่ต้องการจากหน้าส่งโพย ระบบจะแสดงวงเงินที่รับได้ของเลขนั้นก่อนยืนยันรายการ", tag: "ดูวงเงินก่อนยืนยัน" },
  { icon: "🚫", name: "เลขอั้นตามวงเงินที่เปิดรับ", detail: "หากเลขใดมีข้อจำกัดในรอบนั้น ระบบควรแสดงรายละเอียดให้เห็นก่อนสมาชิกกดยืนยันโพย", tag: "ยึดข้อมูลในรอบนั้น" },
  { icon: "🧮", name: "อัตราจ่ายแสดงก่อนส่งโพย", detail: "เรทที่กำหนดสำหรับหน้านี้คือ 2 ตัวบาทละ 100 และ 3 ตัวบาทละ 1,000 ควรตรวจอัตราจ่ายจริงในระบบอีกครั้ง", tag: "ตรวจเรทอีกครั้ง" },
  { icon: "🎯", name: "เลือกเลขและกำหนดยอดเอง", detail: "เลือกประเภทหวย รอบเดิมพัน เลขที่ต้องการ แล้วกำหนดยอดแทงของตัวเองก่อนส่งโพย", tag: "กำหนดยอดเอง" },
  { icon: "🧾", name: "เช็กบิลย้อนหลังได้ด้วยตัวเอง", detail: "เก็บประวัติบิลไว้ตรวจสอบผลและยอดรางวัลภายหลัง ตรวจยอดในบิลให้ตรงกับรายการที่ส่ง", tag: "เก็บประวัติบิล" },
  { icon: "🏦", name: "ฝากถอนออโต้วอลเลท/ธนาคาร", detail: "เลือกช่องทางที่เว็บไซต์เปิดรองรับ ระบุจำนวนเงิน และตรวจรายละเอียดก่อนยืนยันรายการ", tag: "ตรวจก่อนยืนยัน" },
  { icon: "📶", name: "ติดตามสถานะและประวัติ", detail: "ติดตามสถานะฝากถอนและประวัติธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเองตลอดเวลา", tag: "ดูสถานะรายการ" },
  { icon: "🎧", name: "แจ้งแอดมินเมื่อพบปัญหา", detail: "แจ้งประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม เพื่อให้ตรวจสอบได้ตรงจุด", tag: "แจ้งรายละเอียดครบ" },
];

const chips = ["หวยรัฐบาลไทย", "หวยลาว", "หวยฮานอย", "หวยยี่กี่", "หวยหุ้น", "2 ตัวบาทละ 100", "3 ตัวบาทละ 1,000", "ฝากถอนออโต้", "ไม่ลบบิล ไม่เบี้ยวโพย"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PREMSUK365" titleright="จุดที่ควรตรวจสอบก่อนส่งโพยกับ PREMSUK365" label="เข้าสู่ระบบ PREMSUK365 และตารางจุดที่ควรตรวจสอบก่อนส่งโพย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e3c56a]/40 bg-[#082013]/92 p-6 shadow-[0_10px_30px_rgba(227,197,106,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2a9d5c]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e3c56a]/60 bg-gradient-to-br from-[#f7e8b4] via-[#e3c56a] to-[#5c4415] text-xl shadow-inner">
          🎟️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f7e8b4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a9bda9]">เข้าสู่ระบบ PREMSUK365 เพื่อเลือกประเภทหวยและรอบเดิมพัน ตรวจอัตราจ่ายก่อนส่งโพย เช็กบิลย้อนหลัง และจัดการฝากถอนได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9bda9]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#e3c56a]/45 bg-[#03130a]/95 py-3 pr-4 pl-12 text-[#e4e7d8] transition-all outline-none placeholder:text-[#a9bda9] focus:border-[#e3c56a] focus:ring-1 focus:ring-[#e3c56a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9bda9]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#e3c56a]/45 bg-[#03130a]/95 py-3 pr-4 pl-12 text-[#e4e7d8] transition-all outline-none placeholder:text-[#a9bda9] focus:border-[#e3c56a] focus:ring-1 focus:ring-[#e3c56a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e4e7d8]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#e3c56a]/45 bg-[#03130a] accent-[#e3c56a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e4e7d8] transition-colors hover:text-[#f7e8b4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#5c4415]/55 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] p-3.5 text-center font-black text-[#020c06] shadow-[0_10px_30px_rgba(227,197,106,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(227,197,106,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a9bda9]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#e3c56a]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#e3c56a]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2a9d5c]/45 bg-[#03130a] px-2.5 py-1 text-[10px] font-bold text-[#2a9d5c]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e3c56a]/40 bg-[#03130a]/80 px-2.5 py-1 text-[10px] font-bold text-[#e3c56a]"><span aria-hidden="true">🕐</span> แจ้งแอดมินได้ทันที</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e3c56a] transition-colors hover:text-[#f7e8b4]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e3c56a]/40 bg-[#082013]/92 p-5 shadow-[0_10px_30px_rgba(227,197,106,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e4e7d8]">แทงหวยออนไลน์ผ่านระบบที่ใช้งานง่าย เลือกเลข กำหนดยอด และเช็กบิลย้อนหลังได้ด้วยตัวเอง</span>
          <div class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#2a9d5c]/55 bg-[#0d3a22]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2a9d5c] shadow-[0_0_8px_rgba(42,157,92,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#2a9d5c] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a9bda9] uppercase">
        <span>ขั้นตอนส่งโพย ฝากถอน และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1c6b3f]/60 bg-[#03130a]/95 px-3.5 py-2.5 transition-colors hover:border-[#e3c56a]/60 hover:bg-[#0d3a22]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e4e7d8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e3c56a]/45 bg-[#020c06] px-2.5 py-0.5 text-[10px] font-bold text-[#e3c56a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a9bda9]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e3c56a]/35 bg-[#020c06] px-3 py-1 text-[10px] font-bold text-[#e3c56a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a9bda9]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนส่งโพย หวยแต่ละประเภทและแต่ละรอบอาจมีเงื่อนไข อัตราจ่าย และวงเงินรับต่างกัน ให้ยึดข้อมูลที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
