---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// YADOM168 is a slot brand — slots only, NOT บาคาร่า/บอล/หวย. Every row below
// stays inside what the brief states: การรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว
// ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ ๆ, การเล่นผ่านมือถือ
// แท็บเล็ต และคอมพิวเตอร์โดยไม่ต้องสลับสมัครหลายเว็บไซต์, ระบบออโต้สำหรับจัดการ
// เครดิต ฝากถอน และตรวจสอบรายการ, การ Login เพื่อตรวจสอบโบนัสที่มีสิทธิ์รับในแต่
// ละวัน, โบนัสแนะนำเพื่อน 0.8% ที่คำนวณจากยอดเข้าเงื่อนไข, และแอดมินที่ช่วยเหลือ
// ด้านการใช้งานได้ตลอด 24 ชั่วโมง.
// No licence, no member count, no cashback promotion and no guaranteed payout —
// the brief says ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin ทุกครั้ง, ว่าผลลัพธ์ของ
// เกมสล็อตรับประกันไม่ได้, และว่าคำว่า "ไม่มีขั้นต่ำ" ต้องยึดเงื่อนไขของเกมและ
// ช่องทางฝากถอนจริง.
const menus = [
  {
    icon: "🎰",
    name: "สล็อตคลาสสิกจากหลายค่าย",
    detail: "หมวดสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ เลือกเกมและดูรูปแบบการจ่ายของเกมนั้นได้ก่อนกด Spin ทุกครั้ง",
    tag: "หลายค่าย",
  },
  {
    icon: "🎁",
    name: "เกมโบนัสและฟรีสปิน",
    detail: "ฟีเจอร์โบนัสและรอบฟรีสปินเป็นไปตามกติกาที่แต่ละเกมกำหนด ควรอ่านเงื่อนไขของฟีเจอร์ในเกมให้ครบก่อนเริ่มเล่น",
    tag: "ตามเงื่อนไขเกม",
  },
  {
    icon: "💎",
    name: "แจ็กพอตและเกมธีมใหม่",
    detail: "เกมแจ็กพอตและเกมธีมใหม่ ๆ เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ รายการที่เปิดให้เล่นในแต่ละช่วงจึงเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมเป็นหลัก",
    tag: "อัปเดตตามค่าย",
  },
  {
    icon: "🪙",
    name: "เกมที่รองรับเบทต่ำ 1 บาท",
    detail: "มีเกมที่รองรับช่วงเดิมพันเริ่มต้นระดับ 1 บาทให้เลือก แต่ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin เพราะแต่ละค่ายกำหนดช่วงเดิมพันไม่เท่ากัน",
    tag: "ตรวจในเกมก่อน",
  },
  {
    icon: "🔀",
    name: "เลือกเกมได้จากบัญชีเดียว",
    detail: "รวมเกมจากหลายค่ายไว้ในบัญชีเดียว ค้นหาและสลับเกมได้โดยไม่ต้องสลับสมัครหลายเว็บไซต์ในทุกครั้งที่ย้ายไปเล่นอีกค่ายหนึ่ง",
    tag: "บัญชีเดียว",
  },
  {
    icon: "📱",
    name: "เข้าเล่นได้ทั้งมือถือ แท็บเล็ต และคอม",
    detail: "รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน และตรวจสอบรายการได้จากหน้าเว็บไซต์เดียวกัน",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "🎫",
    name: "Login ตรวจโบนัสที่มีสิทธิ์รับ",
    detail: "เข้าสู่ระบบเพื่อดูโบนัสที่มีสิทธิ์รับในแต่ละวัน เช่น โบนัสแนะนำเพื่อน 0.8% โดยสิทธิ์จริงขึ้นอยู่กับกิจกรรมและเงื่อนไขของโปรโมชั่นในช่วงนั้น",
    tag: "แนะนำเพื่อน 0.8%",
  },
  {
    icon: "💳",
    name: "ระบบออโต้ ฝากถอนและเครดิต",
    detail: "เติมเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการผ่านบัญชีสมาชิกได้เอง ก่อนยืนยันควรดูวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือก",
    tag: "ทำรายการเอง",
  },
];

const chips = ["สล็อตคลาสสิก", "เกมโบนัส", "ฟรีสปิน", "แจ็กพอต", "เกมธีมใหม่", "ระบบออโต้", "แนะนำเพื่อน 0.8%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ YADOM168" titleright="จุดที่ควรตรวจสอบก่อนกด Spin และก่อนกดรับโบนัส" label="เข้าสู่ระบบ YADOM168 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0f3d0d]/55 bg-[#071508]/92 p-6 shadow-[0_10px_30px_rgba(92,194,63,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#5cc23f]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e6bd5c]/50 bg-gradient-to-br from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f2fbef]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fe06f]">เข้าสู่ระบบ YADOM168 เพื่อเลือกเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว ตรวจสอบเครดิต ดูโบนัสที่มีสิทธิ์รับในแต่ละวัน และจัดการฝากถอนได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d4e8cb]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0f3d0d]/55 bg-[#040d04]/95 py-3 pr-4 pl-12 text-[#d4e8cb] transition-all outline-none placeholder:text-[#d4e8cb]/45 focus:border-[#5cc23f] focus:ring-1 focus:ring-[#5cc23f]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d4e8cb]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0f3d0d]/55 bg-[#040d04]/95 py-3 pr-4 pl-12 text-[#d4e8cb] transition-all outline-none placeholder:text-[#d4e8cb]/45 focus:border-[#5cc23f] focus:ring-1 focus:ring-[#5cc23f]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d4e8cb]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0f3d0d]/55 bg-[#040d04] accent-[#5cc23f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d4e8cb] transition-colors hover:text-[#f2fbef]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#0f3d0d]/60 bg-gradient-to-r from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] p-3.5 text-center font-black text-[#040d04] shadow-[0_10px_30px_rgba(92,194,63,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(143,224,111,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d4e8cb]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f3d0d]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f3d0d]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e6bd5c]/40 bg-[#040d04] px-2.5 py-1 text-[10px] font-bold text-[#e6bd5c]"><span aria-hidden="true">🎰</span> รวมเกมหลายค่าย</span>
            <span class="rounded-full border border-[#0f3d0d]/50 bg-[#040d04]/80 px-2.5 py-1 text-[10px] font-bold text-[#8fe06f]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#8fe06f] transition-colors hover:text-[#f2fbef]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0f3d0d]/55 bg-[#071508]/92 p-5 shadow-[0_10px_30px_rgba(92,194,63,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d4e8cb]">เลือกเกมสล็อตจากหลายค่ายได้ผ่านบัญชีเดียว และตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขของเกมนั้นที่ระบบแสดงก่อนกด Spin ทุกครั้ง</span>
          <div class="bg-gradient-to-r from-[#8fe06f] via-[#f2fbef] to-[#e6bd5c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว เลือกเกมได้ทุกค่ายที่ระบบเปิด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e6bd5c]/45 bg-[#0f2a10]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6bd5c] shadow-[0_0_8px_rgba(230,189,92,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e6bd5c] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d4e8cb]/60 uppercase">
        <span>หมวดสล็อต โบนัส และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0f3d0d]/70 bg-[#040d04]/95 px-3.5 py-2.5 transition-colors hover:border-[#e6bd5c]/45 hover:bg-[#0f2a10]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d4e8cb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e6bd5c]/40 bg-[#040d04] px-2.5 py-0.5 text-[10px] font-bold text-[#e6bd5c]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d4e8cb]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0f3d0d]/45 bg-[#040d04] px-3 py-1 text-[10px] font-bold text-[#8fe06f]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d4e8cb]/60">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น แต่ละค่ายและแต่ละเกมสล็อตอาจกำหนดกติกา ช่วงเดิมพัน และรูปแบบการจ่ายไม่เท่ากัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
        ส่วนยอดที่ใช้คำนวณ รอบรับโบนัส และประเภทเกมที่เข้าร่วมรายการ ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
