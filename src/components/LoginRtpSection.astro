---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the brief states: บาคาร่า รูเล็ต เสือมังกร
// แบล็กแจ็ก สล็อต หลายค่าย, โบนัสค่าแนะนำจากกิจกรรมแนะนำเพื่อน, โบนัสยอดฝาก,
// ฝากถอนอัตโนมัติ และแอดมิน 24 ชั่วโมง.
const menus = [
  { icon: "🃏", name: "คาสิโนสด", detail: "ถ่ายทอดสดจากห้องเกม เลือกโต๊ะและวางเดิมพันได้จากหน้าเดียว", tag: "ถ่ายทอดสด" },
  { icon: "🀄", name: "บาคาร่า", detail: "เลือกห้องและวงเงินที่เปิดให้บริการ ตรวจสอบเงื่อนไขก่อนวางเดิมพัน", tag: "หลายห้องให้เลือก" },
  { icon: "🎡", name: "รูเล็ต", detail: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดง", tag: "ตามอัตราที่ระบบแสดง" },
  { icon: "🐯", name: "เสือมังกร", detail: "เกมไพ่ใบเดียวรู้ผลไว เลือกโต๊ะที่เปิดอยู่ได้ทันที", tag: "รู้ผลไว" },
  { icon: "🎴", name: "แบล็กแจ็ก", detail: "เกมไพ่คลาสสิก ดูกติกาและอัตราจ่ายของแต่ละโต๊ะก่อนเริ่มเดิมพัน", tag: "ดูกติกาก่อนเล่น" },
  { icon: "🎰", name: "สล็อตหลายค่าย", detail: "รวมเกมสล็อตจากหลายค่ายในบัญชีเดียว พร้อมอัปเดตเกมใหม่ต่อเนื่อง", tag: "อัปเดตเกมใหม่" },
  { icon: "⚡", name: "ฝากถอนออโต้", detail: "ฝากเครดิตผ่านระบบอัตโนมัติแล้วเข้าเล่นได้ทันที ติดตามสถานะรายการเองได้", tag: "จัดการเครดิตเอง" },
  { icon: "🛎️", name: "แอดมินบริการ 24 ชั่วโมง", detail: "แจ้งได้ทั้งเรื่องสมัครสมาชิก ฝากถอน เครดิตไม่เข้า และการรับโบนัสค่าแนะนำ", tag: "แจ้งปัญหาได้ตลอด" },
];

const chips = ["บาคาร่า", "รูเล็ต", "เสือมังกร", "แบล็กแจ็ก", "สล็อต", "ฝากถอนออโต้", "มือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ 12PLAY" titleright="หมวดเกมและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ 12PLAY และหมวดเกมคาสิโนที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8a0710]/50 bg-[#1a0304]/92 p-6 shadow-[0_10px_30px_rgba(224,16,32,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#4b0304]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e01020]/50 bg-gradient-to-br from-[#ff5a63] via-[#e01020] to-[#4b0304] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff5a63]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8f959f]">เข้าสู่ระบบ 12PLAY ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8f959f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8a0710] bg-[#0a0102]/95 py-3 pr-4 pl-12 text-[#f4eff0] transition-all outline-none placeholder:text-[#8f959f]/70 focus:border-[#e01020] focus:ring-1 focus:ring-[#e01020]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8f959f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#8a0710] bg-[#0a0102]/95 py-3 pr-4 pl-12 text-[#f4eff0] transition-all outline-none placeholder:text-[#8f959f]/70 focus:border-[#e01020] focus:ring-1 focus:ring-[#e01020]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e0d7d8]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8a0710] bg-[#0a0102] accent-[#e01020]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e0d7d8] transition-colors hover:text-[#ff5a63]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ff5a63]/50 bg-gradient-to-r from-[#ff5a63] via-[#e01020] to-[#8a0710] p-3.5 text-center font-black text-[#f4eff0] shadow-[0_10px_30px_rgba(224,16,32,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(224,16,32,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8f959f]">
          <span class="h-px flex-1 bg-[#8a0710]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#8a0710]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#8a0710]/60 bg-[#0a0102] px-2.5 py-1 text-[10px] font-bold text-[#ff5a63]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e01020]/30 bg-[#0a0102]/80 px-2.5 py-1 text-[10px] font-bold text-[#e0d7d8]"><span aria-hidden="true">🕐</span> แอดมินดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff5a63] transition-colors hover:text-[#f4eff0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e01020]/25 bg-[#1a0304]/92 p-5 shadow-[0_10px_30px_rgba(224,16,32,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e0d7d8]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#8a0710] via-[#e01020] to-[#f4eff0] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8f959f] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#8a0710] bg-[#0a0102]/95 px-3.5 py-2.5 transition-colors hover:border-[#e01020]/50 hover:bg-[#1a0304]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4eff0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#8a0710]/60 bg-[#0a0102] px-2.5 py-0.5 text-[10px] font-bold text-[#ff5a63]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e0d7d8]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e01020]/25 bg-[#0a0102] px-3 py-1 text-[10px] font-bold text-[#ff5a63]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8f959f]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
