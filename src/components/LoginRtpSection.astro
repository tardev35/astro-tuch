// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// โลโก้รอบนี้เป็นคำว่า แตกดี สีเหลืองมะนาวแบนๆ วางเหนือเลข 168 สีฟ้าสด แบนเนอร์กับ
// สไลด์เป็นฉากท้องฟ้าฟ้า-ขาว เหรียญทอง มงกุฎ กล่องของขวัญ และตัวละครผมขาวเงินในชุด
// ฟ้า-ขาว แบรนด์จึงมีสองฮิวจริง — ฟ้าสดนำ เหลืองมะนาวรอง — ไม่ใช่โลหะเดียวแบบ
// 789BETTING สองแผงถูกแยกด้วย "ฟ้า vs เหลือง" ตรงๆ และจงใจให้ตรงกับ ContentBoxTwo
// ที่ครอบอยู่ ซึ่งให้ป้ายคอลัมน์ซ้ายเป็นฟ้าอ่อน #7bcffb กับป้ายไอคอนแผ่นฟ้าทึบ และ
// ป้ายคอลัมน์ขวาเป็นเหลืองมะนาว #fce604 กับป้ายไอคอนแผ่นกรมท่าลึก — แผงล็อกอิน (ซ้าย)
// จึงอยู่ในกรอบฟ้าแบรนด์ #0193fb ส่วนแผงหมวดเกมและสิทธิ์ (ขวา) อยู่ในกรอบเหลืองเข้ม
// #c9a703 ทั้งคู่วางบนผิวยก #0a1726 ช่องกรอกและชิปตกลงไปที่ผิวลึกสุด #020609 และผิว
// ที่ hover ขึ้นมาเป็นผิวกลาง #07111d บรรทัดเด่นไล่เหลืองอ่อน #fff48a → เหลืองมะนาว
// #fce604 → ฟ้าอ่อน #7bcffb
//
// สีของแบรนด์แยกหน้าที่กันตาม §2: #0193fb ถือขอบ/โฟกัส/ออรา · #7bcffb เป็นตัวอักษร
// เน้นและปลายสว่างของไล่เฉด · #d4ecfd เป็นทินต์สว่างสุด · #0b6fc4 กับ #064a86 เป็น
// ปลายเข้มและเส้นไรผม (ไม่เคยถือตัวอักษร) · #fce604 เป็นฮิวที่สอง ใช้เป็นตัวอักษรบน
// พื้นมืดได้ · #c9a703 เป็นขอบเหลืองเข้ม ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ"
// เป็นปุ่มรอง จึงเป็นพื้นไล่ผิวยก #0a1726 → ผิวลึกสุด #020609 ขอบฟ้าแบรนด์ หมึก
// เนื้อความ #dbeafe — ไม่ใช่ปุ่มหลักพื้นสีทึบ ซึ่งถูกเก็บไว้ให้ปุ่มสมัครสมาชิกบนหน้าอื่น
// ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบ
// ป้ายสถานะข้างบรรทัดโบนัสรอบนี้เป็นเหลืองมะนาว ไม่ใช่จุดเขียว — ข้อความ
// "ตามรอบที่โปรโมชั่นกำหนด" เป็นป้ายบอกเงื่อนไข ไม่ใช่ตัวบ่งชี้สถานะ live/success
// ที่ §2 ยกเว้นให้คงสีเขียวไว้ได้
// ข้อความรองใช้ฟ้าหม่น #93b4d4 (9.4:1 บนผิวลึกสุด) ไม่ใช่สีเนื้อความแบบลดความทึบ
// เนื้อความ #dbeafe (= BRAND_TEXT) หมึกบนแผ่นสีสดเป็น #031018 เสมอ
//
// ชุดทองเมทัลลิกของ 789BETTING ที่เคยค้างในไฟล์นี้ (#fad354 #ffe79a #ddab33 #8a6410
// #c9881f #4a3407 #17130a #0e0b05 #060402 #0a0802 #b5a888 #f3e7cd
// rgba(250,211,84,…)) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมสล็อตและสิทธิ์ที่ ${BRAND_NAME} รวมไว้`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหมวดเกมสล็อตที่ระบบรวมไว้ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ เกมเปิดใหม่ ฝากถอน โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และจุดที่ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0193fb]/50 bg-[#0a1726] p-6 shadow-[0_0_28px_rgba(1,147,251,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0b6fc4]/35 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#0b6fc4] bg-gradient-to-br from-[#d4ecfd] via-[#7bcffb] to-[#0193fb] text-xl text-[#031018] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#7bcffb]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#93b4d4]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือได้สะดวก แล้วเลือกเกมสล็อตที่สนใจ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ พร้อมตรวจสอบเครดิต โปรโมชั่น ยอดที่เข้าเกณฑ์ รอบการรับสิทธิ์
            และประวัติรายการผ่านบัญชีเดียวได้ทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#93b4d4]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#064a86] bg-[#020609] py-3 pr-4 pl-12 text-[#dbeafe] transition-all outline-none placeholder:text-[#93b4d4] focus:border-[#0193fb] focus:ring-1 focus:ring-[#0193fb]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#93b4d4]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#064a86] bg-[#020609] py-3 pr-4 pl-12 text-[#dbeafe] transition-all outline-none placeholder:text-[#93b4d4] focus:border-[#0193fb] focus:ring-1 focus:ring-[#0193fb]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#93b4d4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#064a86] bg-[#020609] accent-[#0193fb]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#93b4d4] transition-colors hover:text-[#7bcffb]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#0193fb]/60 bg-gradient-to-b from-[#0a1726] to-[#020609] p-3.5 text-center font-black text-[#dbeafe] shadow-[0_0_12px_rgba(1,147,251,0.25)] transition-all hover:scale-[1.02] hover:border-[#0193fb] hover:text-[#7bcffb]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#93b4d4]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#064a86]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#064a86]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0193fb]/50 bg-[#020609] px-2.5 py-1 text-[10px] font-bold text-[#7bcffb]"><span aria-hidden="true">🎰</span> เกมสล็อตในบัญชีเดียว</span>
            <span class="rounded-full border border-[#c9a703]/55 bg-[#020609] px-2.5 py-1 text-[10px] font-bold text-[#fce604]"><span aria-hidden="true">📱</span> เข้าเล่นผ่านมือถือได้สะดวก</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#7bcffb] transition-colors hover:text-[#fce604]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c9a703]/40 bg-[#0a1726] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#93b4d4]">
            {BRAND_NAME} รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ เลือกเกมที่สนใจได้จากบัญชีเดียวผ่านมือถือ
          </span>
          <div class="bg-gradient-to-r from-[#fff48a] via-[#fce604] to-[#7bcffb] bg-clip-text text-xl font-black text-transparent sm:text-2xl">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#c9a703] bg-[#020609] px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#fce604] shadow-[0_0_8px_rgba(252,230,4,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fce604] uppercase">ตามรอบที่โปรโมชั่นกำหนด</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#93b4d4] uppercase">
        <span>หมวดเกมสล็อตและสิทธิ์ที่เลือกได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameTypes.map((t) => (
            <div class="rounded-xl border border-[#064a86] bg-[#020609] px-3.5 py-2.5 transition-colors hover:border-[#0193fb]/80 hover:bg-[#07111d]">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#7bcffb]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#93b4d4]">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#93b4d4]">
        จำนวนเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนเริ่มเล่น ส่วนการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้
        รองรับ ไม่ควรพิจารณาจากข้อความบนหน้าเว็บเพียงอย่างเดียว
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#93b4d4] uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforePlayChecks.map((k) => (
            <div class="rounded-xl border border-[#064a86] bg-[#020609] px-3.5 py-2.5 transition-colors hover:border-[#c9a703]/70 hover:bg-[#07111d]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbeafe]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#0193fb]/50 bg-[#07111d] px-2.5 py-0.5 text-[10px] font-bold text-[#7bcffb]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#93b4d4]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#064a86] bg-[#020609] px-3 py-1 text-[10px] font-bold text-[#dbeafe]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#93b4d4]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว การเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียว และการตรวจสอบวงเงินจริงของแต่ละเกม
        ก่อนเริ่มเล่น ส่วนโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่โปรโมชั่นกำหนด แต่ละรายการอาจมีรอบตัดยอด ค่ายเกม และเงื่อนไขรับโบนัสแตกต่างกัน จึงควรยึดรายละเอียด
        ล่าสุดจากระบบเป็นหลักก่อนกดรับสิทธิ์ ก่อนทำรายการฝากถอนควรตรวจสอบข้อมูลให้ตรงกับบัญชีสมาชิกและเก็บหลักฐานธุรกรรมไว้ หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน
        PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
