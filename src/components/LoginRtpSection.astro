---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก ไม่อั้น" ทุกแถวจึงเป็น
// ข้อเท็จจริงที่ brief ระบุไว้เองล้วนๆ — ไม่ล็อคยูส, สิทธิ์โบนัสฝากแรกตามเงื่อนไข
// ที่กำหนด, สิทธิพิเศษเฉพาะสมาชิกทั้งยูสใหม่และยูสเดิม, เกมจากหลายค่ายให้เลือก,
// ระบบจัดหมวดเกมชัดเจนจนค้นหาจากหน้าเดียวได้, ตัวเลือกการเดิมพันหลากหลายตาม
// แต่ละเกม, รองรับทั้งมือถือและคอมพิวเตอร์, ระบบบัญชีที่จัดการได้สะดวก, โบนัส
// คืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้า
// โปรโมชั่น, ช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งานพร้อม
// ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง และแอดมินที่ให้บริการ 24 ชั่วโมง
// (brief รอบนี้ระบุ 24 ชั่วโมงไว้เอง)
// ไม่มีแถวไหนคิดตัวเลข ค่ายเกม ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง
const menus = [
  {
    icon: "🔓",
    name: "ไม่ล็อคยูส เลือกเกมได้เอง",
    detail: "จุดเด่นของระบบคือการใช้งานแบบไม่ล็อคยูส เลือกเกมและค่ายที่ต้องการได้ตามรายการที่รองรับ ควรตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่น",
    tag: "ไม่ล็อค",
  },
  {
    icon: "🎁",
    name: "โบนัสฝากแรกสำหรับยูสใหม่",
    detail: "ยูสใหม่ตรวจสอบสิทธิ์โบนัสฝากแรกได้จากหน้าโปรโมชั่น รายละเอียดของโบนัส ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับต่างกันตามรายการที่เปิดให้ใช้งานในช่วงนั้น",
    tag: "ฝากแรก",
  },
  {
    icon: "⭐",
    name: "สิทธิพิเศษเฉพาะสมาชิก",
    detail: "มีสิทธิพิเศษสำหรับสมาชิกทั้งยูสใหม่และยูสเดิม ตรวจสอบเงื่อนไขของแต่ละรายการได้ก่อนนำไปใช้งาน",
    tag: "สมาชิก",
  },
  {
    icon: "🎰",
    name: "เกมสล็อตจากหลายค่าย",
    detail: "มีเกมจากหลายค่ายให้เลือก ตรวจสอบเงื่อนไขของแต่ละเกมได้จากหน้าเดียวก่อนเข้าเล่น",
    tag: "หลายค่าย",
  },
  {
    icon: "🗂️",
    name: "จัดหมวดเกมไว้ชัดเจน",
    detail: "ระบบจัดหมวดเกมชัดเจน ช่วยให้ค้นหาเกมที่ต้องการได้ง่ายจากหน้าเดียวโดยไม่ต้องไล่หาทีละรายการ",
    tag: "แยกหมวด",
  },
  {
    icon: "🎚️",
    name: "ตัวเลือกการเดิมพันหลากหลาย",
    detail: "มีตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม เดิมพันไม่อั้น ไม่จำกัดยอดเดิมพัน ตามเงื่อนไขที่ระบบกำหนด",
    tag: "ไม่อั้น",
  },
  {
    icon: "📱",
    name: "รองรับมือถือและคอมพิวเตอร์",
    detail: "รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมระบบบัญชีที่จัดการได้สะดวก เหมาะกับยูสใหม่ที่เพิ่งเริ่มต้น",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "💰",
    name: "โบนัสคืนยอดเสีย 0.3%",
    detail: "รับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนด ระบบแสดงรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์",
    tag: "0.3%",
  },
  {
    icon: "🤝",
    name: "โบนัสแนะนำเพื่อน 0.8%",
    detail: "ชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ รับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม ตรวจสอบยอดสิทธิ์ได้จากบัญชีสมาชิก",
    tag: "0.8%",
  },
  {
    icon: "🏦",
    name: "ธนาคารและวอลเลท ฝากถอนไม่จำกัด",
    detail: "รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง",
    tag: "ฝากถอน",
  },
  {
    icon: "💬",
    name: "แอดมินให้บริการ 24 ชั่วโมง",
    detail: "สอบถามแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน",
    tag: "24 ชม.",
  },
];

const chips = [
  "สมัครยูสใหม่",
  "ไม่ล็อคยูส",
  "โบนัสฝากแรก",
  "สิทธิพิเศษสมาชิก",
  "เกมหลายค่าย",
  "จัดหมวดเกมชัดเจน",
  "เดิมพันไม่อั้น",
  "มือถือและคอมพิวเตอร์",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ธนาคารและวอลเลท",
  "ฝากถอนไม่จำกัด",
];

// HENG35 palette (ดำ-ทอง): ทั้งสองแผงวางบนพื้นการ์ด #12100b เหนือพื้นเพจดำ
// #070605 แผงล็อกอินอยู่ในกรอบทองหลัก #ecc55c ส่วนแผงรายการจุดเด่นอยู่ในกรอบ
// บรอนซ์ #a3732c — แบรนด์นี้มีทองสีเดียว จึงแยกสองแผงด้วยความสว่างของกรอบ
// ไม่ใช่ด้วยสีที่สอง ช่องกรอกและชิปตกลงไปที่แผงยก #1c1710 ในเส้นบรอนซ์เข้ม
// #5e4418 ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์มไว้ตามเดิม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`จุดเด่นของ ${BRAND_NAME} ที่เว็บระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการจุดเด่นเรื่องการสมัครยูสใหม่แบบไม่ล็อคยูส โบนัสฝากแรก โปรโมชั่น และช่องทางธนาคารกับวอลเลทที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ecc55c]/40 bg-[#12100b]/94 p-6 shadow-[0_10px_30px_rgba(7,6,5,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ecc55c]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ecc55c]/70 bg-gradient-to-br from-[#fefac4] via-[#ecc55c] to-[#a3732c] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffdf8a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ece1cb]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกเกมจากหลายค่ายที่จัดหมวดไว้ชัดเจน ตรวจสอบเงื่อนไขของแต่ละเกมกับสิทธิ์โบนัสที่เปิดให้ใช้งาน และดูยอดกับสถานะฝากถอนของบัญชีตัวเองได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece1cb]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5e4418] bg-[#070605]/95 py-3 pr-4 pl-12 text-[#ece1cb] transition-all outline-none placeholder:text-[#ece1cb]/50 focus:border-[#ecc55c] focus:ring-1 focus:ring-[#ffdf8a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece1cb]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5e4418] bg-[#070605]/95 py-3 pr-4 pl-12 text-[#ece1cb] transition-all outline-none placeholder:text-[#ece1cb]/50 focus:border-[#ecc55c] focus:ring-1 focus:ring-[#ffdf8a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ece1cb]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5e4418] bg-[#070605] accent-[#ecc55c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ece1cb]/80 transition-colors hover:text-[#ffdf8a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fefac4]/70 bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] p-3.5 text-center font-black text-[#0d0b0a] shadow-[0_10px_30px_rgba(236,197,92,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(254,250,196,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ece1cb]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e4418]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e4418]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5e4418] bg-[#070605] px-2.5 py-1 text-[10px] font-bold text-[#ece1cb]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#ecc55c]/50 bg-[#070605]/85 px-2.5 py-1 text-[10px] font-bold text-[#ffdf8a]"><span aria-hidden="true">🔓</span> ไม่ล็อคยูส</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffdf8a] transition-colors hover:text-[#ecc55c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a3732c]/55 bg-[#12100b]/94 p-5 shadow-[0_10px_30px_rgba(7,6,5,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ece1cb]/70">สมัครสล็อตยูสใหม่ ไม่ล็อค</span>
          <div class="bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#ffdf8a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">โบนัสฝากแรก ฝากถอนไม่จำกัด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5e4418] bg-[#070605]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ecc55c] shadow-[0_0_8px_rgba(236,197,92,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffdf8a] uppercase">ไม่ล็อค</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ece1cb]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#5e4418] bg-[#1c1710]/95 px-3.5 py-2.5 transition-colors hover:border-[#ecc55c]/70 hover:bg-[#12100b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece1cb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffdf8a]/45 bg-[#070605] px-2.5 py-0.5 text-[10px] font-bold text-[#ffdf8a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ece1cb]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5e4418] bg-[#070605] px-3 py-1 text-[10px] font-bold text-[#ece1cb]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ece1cb]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการสมัครยูสใหม่แบบไม่ล็อคยูส เกมจากหลายค่ายที่จัดหมวดไว้ชัดเจน ช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน และโปรโมชั่นที่เปิดให้ตรวจสอบรายละเอียดก่อนกดรับ
        ส่วนรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และเงื่อนไขของแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
