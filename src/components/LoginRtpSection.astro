---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// NEXT55 is a คาสิโนออนไลน์เว็บตรงครบวงจร — เว็บตรง 100% ไม่ผ่านเอเย่นต์ แบบ
// One-Stop Service. Every row below stays inside what the brief states:
// เดิมพันเริ่มต้นเพียง 1 บาท, ไม่มีขั้นต่ำฝาก-ถอน, บาคาร่าและคาสิโนสดระดับ
// Full HD, สล็อตลิขสิทธิ์แท้, เกมยิงปลา, หวยรัฐบาล ลาว ฮานอย ที่จ่ายเต็มไม่มีเลข
// อั้น, แทงบอลทุกลีกค่าน้ำดี, แนะนำเพื่อน 0.8%, คืนยอดเสีย 0.3%, ระบบฝาก-ถอน
// ออโต้ภายใน 5 วินาที ที่รองรับทุกธนาคารและ TrueMoney Wallet, การเข้าใช้งานได้ทั้ง
// iOS Android แท็บเล็ต และพีซี ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอป, และแอดมินผ่าน
// Line Official ตลอด 24 ชั่วโมง.
// No licence number, no member count and no guaranteed payout — nothing here
// goes beyond what the brief itself says.
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรง 100% ไม่ผ่านเอเย่นต์",
    detail: "แพลตฟอร์มเดิมพันครบวงจรที่ไม่ผ่านเอเย่นต์หรือตัวแทนใดๆ มุ่งเน้นมาตรฐานความปลอดภัยระดับสากล โปร่งใส ยุติธรรม และเชื่อถือได้",
    tag: "เว็บตรง 100%",
  },
  {
    icon: "🪙",
    name: "เดิมพันเริ่มต้นเพียง 1 บาท",
    detail: "รวบรวมเกมยอดฮิตจากทุกค่ายดังทั่วโลกไว้ในเว็บเดียวแบบ One-Stop Service เปิดโอกาสให้ทุกคนเข้าถึงความสนุกได้ด้วยเงินทุนเริ่มต้นเพียง 1 บาท",
    tag: "ขั้นต่ำ 1 บาท",
  },
  {
    icon: "🃏",
    name: "บาคาร่าและคาสิโนสด Full HD",
    detail: "ถ่ายทอดสดจากคาสิโนชั้นนำ ภาพคมชัดระดับ Full HD สัมผัสบรรยากาศสมจริงเหมือนนั่งอยู่ในคาสิโนวีไอพี",
    tag: "ภาพสดคมชัด",
  },
  {
    icon: "🎰",
    name: "สล็อตลิขสิทธิ์แท้และเกมยิงปลา",
    detail: "รวบรวมค่ายเกมสล็อตลิขสิทธิ์แท้ แจ็คพอตแตกง่าย ฟีเจอร์แน่น พร้อมเกมยิงปลาที่เล่นง่าย ตายไว กราฟิกสวยงาม",
    tag: "ลิขสิทธิ์แท้",
  },
  {
    icon: "🎫",
    name: "หวยรัฐบาล ลาว และฮานอย",
    detail: "รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล ลาว ฮานอย จ่ายหนัก จ่ายเต็ม ไม่มีเลขอั้น",
    tag: "ไม่มีเลขอั้น",
  },
  {
    icon: "⚽",
    name: "แทงบอลและกีฬาทุกลีกดัง",
    detail: "ค่าน้ำดีที่สุด เปิดรับเดิมพันทุกลีกดังทั่วโลก พร้อมรูปแบบการแทงที่หลากหลาย",
    tag: "ค่าน้ำดีที่สุด",
  },
  {
    icon: "🎁",
    name: "ตรวจสิทธิ์แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    detail: "เข้าสู่ระบบเพื่อคัดลอกลิงก์ส่วนตัวรับคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน และตรวจเครดิตคืนยอดเสีย 0.3% ในทุกยอดการเล่น",
    tag: "รับได้ทุกวัน",
  },
  {
    icon: "💳",
    name: "ฝาก-ถอนออโต้ ไม่มีขั้นต่ำ ภายใน 5 วินาที",
    detail: "ไม่มีขั้นต่ำในการฝาก-ถอน ทุน 1 บาทก็ฝากเข้ามาเล่นได้ รองรับทุกธนาคารชั้นนำรวมถึง TrueMoney Wallet ด้วยระบบออโต้ที่รวดเร็วภายใน 5 วินาที",
    tag: "ออโต้ 5 วินาที",
  },
];

const chips = ["เว็บตรง 100%", "ไม่ผ่านเอเย่นต์", "เดิมพัน 1 บาท", "ไม่มีขั้นต่ำ", "บาคาร่า Full HD", "สล็อตลิขสิทธิ์แท้", "เกมยิงปลา", "หวยไม่มีเลขอั้น", "บอลค่าน้ำดี", "ออโต้ 5 วินาที", "Line 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ NEXT55"
  titleright="สิ่งที่สมาชิกได้รับจากเว็บตรง NEXT55"
  label="เข้าสู่ระบบ NEXT55 และรายการสิทธิประโยชน์ที่สมาชิกได้รับจากเว็บตรงหลัก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#3a3d45] bg-[#17181c]/92 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#cd1437]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#cd1437]/60 bg-gradient-to-br from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#e7eaef]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c3c8d1]">
            ล็อคอินเข้าเว็บตรงของ NEXT55 เพื่อเลือกเกมบาคาร่า คาสิโนสด สล็อต ยิงปลา หวย และกีฬา ตรวจสิทธิ์แนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% เติมเครดิต และทำรายการฝาก-ถอนออโต้แบบไม่มีขั้นต่ำได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c3c8d1]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a3d45] bg-[#0c0d10]/95 py-3 pr-4 pl-12 text-[#d5dae2] transition-all outline-none placeholder:text-[#c3c8d1]/45 focus:border-[#cd1437] focus:ring-1 focus:ring-[#f0435f]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c3c8d1]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a3d45] bg-[#0c0d10]/95 py-3 pr-4 pl-12 text-[#d5dae2] transition-all outline-none placeholder:text-[#c3c8d1]/45 focus:border-[#cd1437] focus:ring-1 focus:ring-[#f0435f]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c3c8d1]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a3d45] bg-[#0c0d10] accent-[#cd1437]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c3c8d1] transition-colors hover:text-[#e7eaef]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#cd1437]/70 bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#cd1437] p-3.5 text-center font-black text-[#0c0d10] shadow-[0_10px_30px_rgba(205,20,55,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(205,20,55,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c3c8d1]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a3d45]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a3d45]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3a3d45] bg-[#0c0d10] px-2.5 py-1 text-[10px] font-bold text-[#c3c8d1]"><span aria-hidden="true">🎮</span> ครบทุกค่ายเกม</span>
            <span class="rounded-full border border-[#cd1437]/45 bg-[#0c0d10]/80 px-2.5 py-1 text-[10px] font-bold text-[#ffb3bf]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffb3bf] transition-colors hover:text-[#e7eaef]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#3a3d45] bg-[#17181c]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c3c8d1]">คาสิโนออนไลน์เว็บตรงครบวงจร ที่รวมทุกความบันเทิงไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffb3bf] via-[#e7eaef] to-[#f0435f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกเกม ไม่มีขั้นต่ำ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#3a3d45] bg-[#22242a]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f0435f] shadow-[0_0_8px_rgba(240,67,95,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffb3bf] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c3c8d1]/60 uppercase">
        <span>เกมและสิทธิประโยชน์ที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#3a3d45] bg-[#0c0d10]/95 px-3.5 py-2.5 transition-colors hover:border-[#cd1437]/60 hover:bg-[#22242a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d5dae2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#cd1437]/40 bg-[#0c0d10] px-2.5 py-0.5 text-[10px] font-bold text-[#ffb3bf]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c3c8d1]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3a3d45] bg-[#0c0d10] px-3 py-1 text-[10px] font-bold text-[#c3c8d1]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c3c8d1]/60">
        รายการข้างต้นสรุปสิ่งที่ NEXT55 ประกาศไว้ ทั้งการเป็นเว็บตรง 100% ที่ไม่ผ่านเอเย่นต์ เกมลิขสิทธิ์แท้ที่เริ่มเดิมพันได้ตั้งแต่ 1 บาท ระบบฝาก-ถอนออโต้แบบไม่มีขั้นต่ำภายใน 5 วินาที
        และโปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ส่วนขั้นต่ำของแต่ละเกม รอบคำนวณและเงื่อนไขของแต่ละโปรโมชั่น ให้ยึดข้อกำหนดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP
        ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
