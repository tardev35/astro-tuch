---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// CK268 เป็นเว็บเกมสล็อตออนไลน์ แผงฝั่งขวาจึงเป็น "กลุ่มเกมสล็อต" ได้ตามบรีฟ — แต่สร้าง
// จากคำที่บรีฟระบุชื่อไว้เองเท่านั้น คือเกมยอดนิยม สล็อตเปิดใหม่ เกมวงล้อแบบคลาสสิก
// สล็อตโบนัส เกมฟรีสปิน และตัวคูณ กับจุดที่สมาชิกต้องตรวจก่อนเริ่มเล่น คือช่วงเดิมพันจริง
// ที่แสดงในเกม จำนวนเงิน กติกา รายละเอียดของเกม เงื่อนไขของโปรโมชั่น และเครดิตกับประวัติ
// รายการในบัญชี ทั้งหมดเป็นประโยคของบรีฟเอง ไม่มีตัวเลขใหม่สักตัว
//
// ห้ามใส่ RTP ค่าความผันผวน ชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวน
// สมาชิกลงในไฟล์นี้ — บรีฟ CK268 ไม่ได้ให้ไว้เลยสักอย่าง และห้ามมีคำของแบรนด์ลอตเตอรีรอบก่อน
// (ดูรายการคำต้องห้ามใน rebrand spec) ตัวเลขที่ใช้ได้มีเท่าที่บรีฟระบุ คือ
// เดิมพันเริ่มต้น 1 บาท · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง · เลข 268 ในชื่อแบรนด์ และห้ามแตกเป็นเงื่อนไข/รอบตัดยอดที่บรีฟไม่ได้บอก
const gameCategories = [
  { icon: "🔥", name: "เกมยอดนิยม", detail: "กลุ่มที่บรีฟระบุว่ารวมไว้ให้เลือกผ่านบัญชีเดียว เลือกได้จากหน้าเกมสล็อต" },
  { icon: "🆕", name: "สล็อตเปิดใหม่", detail: "รายการเกมใหม่ทยอยเพิ่มตลอดสัปดาห์ตามค่ายที่เปิดให้บริการในขณะนั้น" },
  { icon: "🎡", name: "เกมวงล้อแบบคลาสสิก", detail: "รูปแบบดั้งเดิมที่บรีฟระบุว่ามีให้เลือก สลับเกมหรือสลับค่ายจากบัญชีเดียวได้" },
  { icon: "🎁", name: "สล็อตโบนัส", detail: "เกมที่มีฟีเจอร์โบนัสในตัว รายละเอียดฟีเจอร์ให้ดูจากข้อมูลภายในเกมนั้น" },
  { icon: "🔄", name: "เกมฟรีสปิน", detail: "บางเกมมีรอบฟรีสปินให้ลุ้น โดยรูปแบบต่างกันไปตามการอัปเดตของแต่ละค่าย" },
  { icon: "✖️", name: "ตัวคูณ", detail: "ฟีเจอร์ตัวคูณที่บรีฟระบุไว้ เปิดให้เล่นตามเกมและค่ายที่ระบบรองรับ" },
];

// สี่ข้อนี้ประกอบจากประโยคของบรีฟเองทั้งหมด — ตรวจช่วงเดิมพันจริงที่แสดงในเกม, ตรวจจำนวนเงิน
// กติกา และรายละเอียดของเกม, ตรวจรอบคำนวณกับยอดที่เข้าเกณฑ์ของโปรโมชั่น และตรวจเครดิตกับ
// ประวัติรายการจากบัญชีสมาชิก
const beforeSpinChecks = [
  {
    icon: "🪙",
    name: "ช่วงเดิมพันจริงในเกม",
    detail: "คำว่า 1 บาททุกเกม และ ไม่มีขั้นต่ำ ควรอ้างอิงช่วงเดิมพันจริงที่แสดงภายในเกม เพราะแต่ละค่ายกำหนดยอดเดิมพันขั้นต่ำและสูงสุดแตกต่างกัน",
    tag: "ดูตัวเลขในเกม",
  },
  {
    icon: "📜",
    name: "จำนวนเงิน กติกา และรายละเอียดเกม",
    detail: "ก่อนเริ่มเล่นควรตรวจสอบจำนวนเงิน กติกา และรายละเอียดของเกมทุกครั้ง ตามที่บรีฟของเว็บไซต์ระบุไว้เป็นข้อควรระวัง",
    tag: "ตรวจก่อนเริ่มเล่น",
  },
  {
    icon: "🎯",
    name: "เงื่อนไขของโปรโมชั่น",
    detail: "แต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ ประเภทเกมสล็อต และระยะเวลารับสิทธิ์แตกต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับโบนัส",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🧾",
    name: "เครดิตและประวัติรายการ",
    detail: "สมาชิกค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว หากรายการถอนยังอยู่ระหว่างตรวจสอบสามารถแจ้งแอดมินให้ตรวจสอบได้ตรงรายการ",
    tag: "ตรวจจากบัญชีสมาชิก",
  },
];

const chips = ["เกมยอดนิยม", "สล็อตเปิดใหม่", "เกมวงล้อแบบคลาสสิก", "สล็อตโบนัส", "ฟรีสปิน", "ตัวคูณ", "เดิมพันเริ่มต้น 1 บาท", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];

// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): โลโก้เป็นเวิร์ดมาร์กสองโทน ตัว C กับเลข 68
// เป็นโครเมียมขาวเงิน ส่วนตัว K กับเลข 2 เป็นเขียวนีออนไล่เฉด งานอาร์ตเป็นพื้นดำสนิทที่มี
// ริ้วแสงเขียวนีออนพาดโค้ง ชิปคาสิโนเขียว-ดำ ไพ่โพดำ และเหรียญทองประปราย สองแผงจึงถูกแยก
// ด้วยคู่เขียว/โครเมียมตามงานอาร์ตจริง ไม่ใช่น้ำหนักของสีเดียว — แผงล็อกอินอยู่ในกรอบเขียว
// นีออนแบรนด์ #8bfc13 ส่วนแผงหมวดเกมอยู่ในกรอบโครเมียมหม่น #8fa38a ทั้งคู่วางบนผิวการ์ด
// #0b160b เหนือพื้นเพจ #030703 ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิวแผงยก #0f1b0e
// บรรทัดเด่นไล่เฉดไฮไลต์ #eaffd6 → เขียวอ่อน #c9ff8f → เขียวนีออน ปุ่มเข้าสู่ระบบเป็นเขียว
// เต็มตัว (#c9ff8f → #8bfc13 → #1a7a08) บนหมึกเข้ม #030703 ตามกฎคอนทราสต์ที่ว่าพื้นเขียว
// นีออนต้องใช้หมึกเข้ม (14.9:1) ห้ามใช้ตัวอักษรขาว (1.3:1) ปุ่มไลน์ยังคงสีเขียว #00B900
// ของแพลตฟอร์มซึ่งห้ามรีแมป — ชุดทอง-แดงของ GOT777 ที่ค้างในไฟล์นี้ (#f5c518 #ffe9a8
// #96690f #d21622 #7b0304 #fff6dd #ece0cb #bdae92 #160b06 #241108 #0a0503) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`เกมสล็อตที่เปิดให้เล่น ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมกลุ่มเกมสล็อตที่เปิดให้เล่นทั้งเกมยอดนิยม สล็อตเปิดใหม่ เกมวงล้อแบบคลาสสิก สล็อตโบนัส เกมฟรีสปิน ตัวคูณ และจุดที่ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8bfc13]/45 bg-[#0b160b]/94 p-6 shadow-[0_10px_30px_rgba(1,4,1,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8bfc13]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#8bfc13]/70 bg-gradient-to-br from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] text-xl text-[#030703] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eaffd6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fa38a]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ เพื่อค้นหาเกมสล็อตที่ต้องการ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fa38a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0f1b0e] bg-[#030703]/95 py-3 pr-4 pl-12 text-[#d5e6cd] transition-all outline-none placeholder:text-[#8fa38a]/70 focus:border-[#8bfc13] focus:ring-1 focus:ring-[#c9ff8f]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fa38a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0f1b0e] bg-[#030703]/95 py-3 pr-4 pl-12 text-[#d5e6cd] transition-all outline-none placeholder:text-[#8fa38a]/70 focus:border-[#8bfc13] focus:ring-1 focus:ring-[#c9ff8f]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#8fa38a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0f1b0e] bg-[#030703] accent-[#8bfc13]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#8fa38a] transition-colors hover:text-[#c9ff8f]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c9ff8f]/70 bg-gradient-to-r from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] p-3.5 text-center font-black text-[#030703] shadow-[0_10px_30px_rgba(139,252,19,0.4)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(201,255,143,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8fa38a]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f1b0e]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f1b0e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0f1b0e] bg-[#030703] px-2.5 py-1 text-[10px] font-bold text-[#d5e6cd]"><span aria-hidden="true">🎰</span> เกมสล็อตออนไลน์</span>
            <span class="rounded-full border border-[#8bfc13]/40 bg-[#030703]/85 px-2.5 py-1 text-[10px] font-bold text-[#8bfc13]"><span aria-hidden="true">📱</span> เล่นผ่านเบราว์เซอร์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#8bfc13] transition-colors hover:text-[#c9ff8f]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8fa38a]/60 bg-[#0b160b]/94 p-5 shadow-[0_10px_30px_rgba(1,4,1,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#8fa38a]">
            {BRAND_NAME} รวมเกมสล็อตออนไลน์จากหลายค่ายไว้ให้เลือกผ่านบัญชีเดียว สมาชิกค้นหาเกม สลับค่าย ตรวจสอบเครดิต และดูประวัติรายการได้จากหน้าเว็บไซต์ พร้อมอัปเดตรายการเกมใหม่ตลอดสัปดาห์
          </span>
          <div class="bg-gradient-to-r from-[#eaffd6] via-[#c9ff8f] to-[#8bfc13] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">ฟรีสปิน · ตัวคูณ · ฟีเจอร์โบนัส</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#0f1b0e] bg-[#030703]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#8bfc13] shadow-[0_0_8px_rgba(139,252,19,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#c9ff8f] uppercase">ตามค่ายที่เปิดให้บริการ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fa38a] uppercase">
        <span>กลุ่มเกมสล็อตในระบบ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameCategories.map((g) => (
            <div class="rounded-xl border border-[#0f1b0e] bg-[#030703]/95 px-3.5 py-2.5 transition-colors hover:border-[#8bfc13]/70 hover:bg-[#0f1b0e]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#eaffd6]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {g.icon}
                </span>
                <span class="truncate">{g.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#8fa38a]">{g.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#8fa38a]">
        จำนวนเกมและช่วงเวลาที่เพิ่มเข้าระบบขึ้นอยู่กับการอัปเดตของแต่ละค่ายผู้ให้บริการ ก่อนเริ่มเล่นจึงควรตรวจสอบจำนวนเงิน กติกา และรายละเอียดของเกมทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fa38a] uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSpinChecks.map((k) => (
            <div class="rounded-xl border border-[#0f1b0e] bg-[#030703]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8f0e6]/50 hover:bg-[#0f1b0e]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d5e6cd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#8bfc13]/50 bg-[#030703] px-2.5 py-0.5 text-[10px] font-bold text-[#8bfc13]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8fa38a]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0f1b0e] bg-[#030703] px-3 py-1 text-[10px] font-bold text-[#d5e6cd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8fa38a]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว การอัปเดตรายการเกมใหม่ตลอดสัปดาห์ การรองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ และการค้นหาเกม
