---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งเป็นบรีฟฉบับ
// เดียวกับที่รอบก่อนใช้ — จึงไม่ถูกเขียนใหม่ทั้งแผงรอบนี้ แต่ถูกไล่ตรวจคำต่อคำกับ
// brand-spec §4 อีกครั้ง และมีสองจุดที่หลุดออกไป: คำว่า "วงล้อ" กับ "เกมเปิดใหม่"
// ไม่ได้อยู่ในบรีฟเลย (บรีฟเขียนว่า "สล็อตเปิดใหม่" และไม่เคยเอ่ยถึงวงล้อ) ทั้งสองคำ
// ถูกถอดออกแล้ว
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §4 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// สล็อต · เบทต่ำ · ทุนน้อย · ไม่มีขั้นต่ำ · ค่ายตรง · ถูกลิขสิทธิ์ · เกมคลาสสิก ·
// ฟรีสปิน · โบนัส · ตัวคูณ · ตารางจ่าย · ช่วงเดิมพัน · สล็อตเปิดใหม่ · บัญชีเดียว ·
// เครดิต · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · Login ·
// แอดมิน 24 ชั่วโมง · PIN · OTP · ประวัติรายการ · ฝากถอน
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §4 (ไฮคลาส · VIP · ส่งตรงจากเว็บแม่ ·
// ยอดเข้าบริษัทตรง · ไม่ผ่านบัญชีม้า · ค่ายเกมพรีเมียม) และคำหวยทั้งหมด (หวย · โพย ·
// เลขเด็ด · แนวทาง · งวด · อัตราจ่าย · ตรวจหวย) — ไม่เหลือแม้คำเดียว
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้ให้ค่า RTP ของเกมไว้เลย และ §4 ห้ามอ้างตัวเลขที่บรีฟไม่ได้ระบุ
// คำว่า RTP จึงไม่ปรากฏในเนื้อหาแม้แต่ครั้งเดียว แผงขวาเป็น "เกมและสิทธิ์ที่เลือกได้"
// ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ชื่อค่ายเกม · เลขใบอนุญาต · ชื่อผู้ดำเนินงาน ·
// ชื่อธนาคาร · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ค่า RTP · ความผันผวน —
// บรีฟไม่ได้ให้ไว้สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง
// ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีเท่านี้: 0.3% · 0.8% · 100% · 24 ชั่วโมง ·
// 3 ขั้นตอน
const gameTypes = [
  { icon: "🎰", name: "สล็อตเบทต่ำ", detail: "เลือกเกมสล็อตที่รองรับการเดิมพันยอดต่ำได้จากบัญชีเดียว เหมาะกับผู้ที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ" },
  { icon: "🕹️", name: "เกมคลาสสิก", detail: "เกมคลาสสิกเป็นหนึ่งในรูปแบบที่ระบบรวมไว้ แต่ละเกมมีตารางจ่ายและช่วงเดิมพันของตัวเอง" },
  { icon: "🆕", name: "สล็อตเปิดใหม่", detail: "สล็อตเปิดใหม่เพิ่มเข้ามาจากค่ายที่ระบบรองรับ ควรตรวจสอบรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์" },
  { icon: "🌀", name: "ฟรีสปิน", detail: "ฟีเจอร์ฟรีสปินมีเงื่อนไขต่างกันในแต่ละเกม สามารถตรวจสอบรายละเอียดของเกมก่อนเริ่มได้" },
  { icon: "⚡", name: "ตัวคูณ", detail: "ตัวคูณเป็นฟีเจอร์ที่แต่ละเกมกำหนดไว้ไม่เหมือนกัน ควรดูรายละเอียดของเกมนั้นก่อนเริ่มเล่น" },
  { icon: "🎁", name: "โบนัส", detail: "ฟีเจอร์โบนัสมีหลายรูปแบบตามที่แต่ละเกมกำหนด ดูได้จากรายละเอียดของเกมก่อนยืนยันยอดในแต่ละรอบ" },
  { icon: "📊", name: "ตารางจ่าย", detail: "ตรวจสอบตารางจ่ายของแต่ละเกมก่อนเริ่ม เพื่อดูว่าเกมนั้นคิดจากอะไรและจ่ายในรูปแบบใด" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "สมาชิกที่มียอดเสียตรงตามเงื่อนไขตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนดได้" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "เมื่อเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณโบนัสแนะนำเพื่อน 0.8%" },
  { icon: "📑", name: "เครดิตและประวัติรายการ", detail: "ใช้บัญชีเดียวค้นหาเกมสล็อต ดูเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีที่ใช้เข้าเล่น" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 6, 7, 11, 19)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforePlayChecks = [
  {
    icon: "🔎",
    name: "ตารางจ่ายและรายละเอียดของแต่ละเกม",
    detail: "ควรตรวจสอบตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน และรายละเอียดของแต่ละเกมก่อนเริ่ม ทำให้ควบคุมจำนวนเงินต่อรอบได้ง่ายกว่าเลือกเกมโดยไม่ดูช่วงเดิมพัน",
    tag: "ดูก่อนกดเล่น",
  },
  {
    icon: "💹",
    name: "ยอดเดิมพันต่ำสุดของเกมนั้น",
    detail: "เกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน บางเกมอาจเริ่มด้วยยอดต่ำมาก ขณะที่บางเกมใช้ขั้นต่ำสูงกว่า จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลักและกำหนดงบก่อนเล่นทุกครั้ง",
    tag: "กำหนดงบก่อนเล่น",
  },
  {
    icon: "🧾",
    name: "ค่ายเกม รอบตัดยอด และเงื่อนไขการรับโบนัส",
    detail: "ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงจำนวนโบนัสที่รับได้ จึงควรตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขการรับโบนัสก่อนกดรับสิทธิ์ทุกครั้ง",
    tag: "เช็กเงื่อนไขจริง",
  },
  {
    icon: "🔐",
    name: "รหัสผ่าน PIN และ OTP",
    detail: "กรณีเกมมีปัญหาควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ หากเป็นเรื่องธุรกรรมควรเตรียมเวลา จำนวนเงิน และหลักฐานรายการไว้ และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่นไม่ว่ากรณีใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "สล็อต",
  "เบทต่ำ",
  "ทุนน้อย",
  "ไม่มีขั้นต่ำ",
  "ค่ายตรง",
  "ถูกลิขสิทธิ์",
  "เกมคลาสสิก",
  "สล็อตเปิดใหม่",
  "ฟรีสปิน",
  "ตัวคูณ",
  "โบนัส",
  "ตารางจ่าย",
  "ช่วงเดิมพัน",
  "บัญชีเดียว",
  "เครดิต",
  "โปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ฝากถอน",
  "ประวัติรายการ",
  "Login",
  "สมัคร 3 ขั้นตอน",
  "แอดมิน 24 ชั่วโมง",
];

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// โลโก้รอบนี้เขียน "UOK" ด้วยทองเมทัลลิกและ "365" ด้วยเงินโครเมียม ในวงแหวนทอง
// คู่โลหะจริงจึงเป็นทองแบรนด์ #c8912f (สีหลัก จาก vivid #a46b25 ของโลโก้) กับเงิน
// โครเมียม #d8dbe0 (โลหะคู่ ใช้อย่างประหยัด) และทั้งเว็บรอบนี้เป็น "การ์ดมืด" ตาม
// แบนเนอร์โถงดำที่ส่องด้วยแสงทอง กับพื้นเพจดำสนิท #000000
// สองแผงถูกแยกด้วยคู่นั้นตรงๆ และจงใจให้ตรงกับ ContentBoxTwo ที่ครอบอยู่ ซึ่งให้ป้าย
// คอลัมน์ซ้ายเป็นทองอ่อนและป้ายคอลัมน์ขวาเป็นเงินโครเมียม — แผงล็อกอิน (ซ้าย) จึงอยู่
// ในกรอบทอง ส่วนแผงเกมและสิทธิ์ (ขวา) อยู่ในกรอบเงินโครเมียม ทั้งคู่วางบนผิวยก
// #191108 ช่องกรอกและชิปตกลงไปที่ผิวลึกสุด #070504 บรรทัดเด่นไล่ทองอ่อน #f5d98a →
// เงินโครเมียม #d8dbe0 → ทองแบรนด์ #c8912f
//
// ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรองตามสูตร §2 จึงเป็นพื้นไล่ผิวยก
// #191108 → ผิวลึกสุด #070504 ขอบทองแบรนด์ หมึกเนื้อความ #ece1cc — ไม่ใช่ปุ่มหลักพื้น
// ทอง ซึ่งถูกเก็บไว้ให้ปุ่มสมัครสมาชิกบนหน้าแรก ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900
// แบบพื้นทึบไม่ไล่เฉด
// ข้อความรองใช้งาช้างหม่น #b7a58a (7.8:1 บนผิวยก) ไม่ใช่สีเนื้อความแบบลดความทึบ
// เนื้อความ #ece1cc (= BRAND_TEXT) glow เป็น rgba(200,145,47,…)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #04ab3a #036b26 #03150a
// #0b231b #041109 #07170f #cfe9d7 #dadcdc #f3c44a #9fb8aa rgba(66,251,90,…))
// ออกครบทุกจุดแล้ว — รอบนี้เป็นการพลิกฮิวจากเขียวนีออนเป็นทองเมทัลลิก ไม่ใช่การยกค่า
// เดิมมาเปลี่ยนแค่เบอร์สี
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`เกมและสิทธิ์ที่ ${BRAND_NAME} รวมไว้`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการเกมสล็อตเบทต่ำที่ระบบรวมไว้ ทั้งเกมคลาสสิก สล็อตเปิดใหม่ ฟรีสปิน ตัวคูณ โบนัส ตารางจ่าย โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และจุดที่ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c8912f]/45 bg-[#191108] p-6 shadow-[0_0_28px_rgba(200,145,47,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c8912f]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#6d4412] bg-gradient-to-br from-[#f5d98a] via-[#c8912f] to-[#6d4412] text-xl text-[#191005] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5d98a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b7a58a]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือได้สะดวก แล้วเลือกค่ายและเกมสล็อตที่ต้องการ ตรวจสอบช่วงเดิมพัน เครดิต โปรโมชั่น ยอดคำนวณ สถานะการรับสิทธิ์ และประวัติรายการจากบัญชีเดียวได้ทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b7a58a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6d4412] bg-[#070504] py-3 pr-4 pl-12 text-[#ece1cc] transition-all outline-none placeholder:text-[#b7a58a] focus:border-[#c8912f] focus:ring-1 focus:ring-[#c8912f]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b7a58a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6d4412] bg-[#070504] py-3 pr-4 pl-12 text-[#ece1cc] transition-all outline-none placeholder:text-[#b7a58a] focus:border-[#c8912f] focus:ring-1 focus:ring-[#c8912f]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#b7a58a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6d4412] bg-[#070504] accent-[#c8912f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#b7a58a] transition-colors hover:text-[#f5d98a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c8912f]/60 bg-gradient-to-b from-[#191108] to-[#070504] p-3.5 text-center font-black text-[#ece1cc] shadow-[0_0_12px_rgba(200,145,47,0.22)] transition-all hover:scale-[1.02] hover:border-[#c8912f] hover:text-[#f5d98a]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b7a58a]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d4412]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d4412]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c8912f]/40 bg-[#070504] px-2.5 py-1 text-[10px] font-bold text-[#f5d98a]"><span aria-hidden="true">🎰</span> สล็อตเบทต่ำในบัญชีเดียว</span>
            <span class="rounded-full border border-[#d8dbe0]/40 bg-[#070504] px-2.5 py-1 text-[10px] font-bold text-[#d8dbe0]"><span aria-hidden="true">📱</span> เข้าเล่นผ่านมือถือได้สะดวก</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5d98a] transition-colors hover:text-[#d8dbe0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
