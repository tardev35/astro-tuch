const chips = [
  "ไม่ติดเทิร์น",
  "ถอนได้ทุกยอด",
  "ไม่จำกัดรอบถอน",
  "เริ่มต้น 1 บาท",
  "PG SLOT",
  "Pragmatic Play",
  "Joker Gaming",
  "JILI",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "TrueMoney Wallet",
  "Line 24 ชม.",
