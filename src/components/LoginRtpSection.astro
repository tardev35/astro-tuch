---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// NATO168 เป็นเว็บสล็อตออนไลน์ ไม่ใช่เว็บหวยและไม่ใช่เว็บบอล แผงฝั่งขวารอบนี้ถูกเขียนใหม่
// ทั้งแผงจากคำของบรีฟรอบนี้เอง บรีฟ NATO168 ไม่ได้ระบุชื่อเกมไว้เลยสักเกม (ต่างจากบรีฟ
// รอบก่อนของ NAZA99 ที่ระบุสามเกมมาเอง) ป้ายทุกใบจึงเป็น "รูปแบบเกม" ตามที่บรีฟเขียนไว้
// ในบรรทัดทางเข้าเล่น คือ สล็อตวงล้อทั่วไป · ฟรีสปิน · ตัวคูณ · เกมที่มีฟีเจอร์โบนัส
// ไม่ใช่ชื่อเกมหรือชื่อค่ายที่คิดขึ้นเอง ส่วนแผง "จุดที่ควรตรวจก่อนเริ่มเล่น" ประกอบจาก
// ประโยคเตือนของบรีฟล้วนๆ คือ ควรอ่านกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกม รวมถึง
// กำหนดงบก่อนเริ่มทุกครั้ง, คำว่ารับโบนัสทุกยูสและไม่มีล็อคยูสควรอ้างอิงเงื่อนไขจริงของ
// เว็บไซต์, แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัส และ
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากรอบเก่า แต่ค่า RTP เป็นตัวเลขที่บรีฟรอบนี้ไม่ได้ให้ไว้
// จึงไม่มีอยู่ในเนื้อหา และไฟล์นี้เคยเป็นตารางรายการหวยเมื่อหลายรอบก่อน — คำว่า หวย /
// โพย / งวด / อัตราจ่าย ไม่เหลืออยู่ในไฟล์นี้แล้ว
//
// ห้ามใส่ชื่อเกม ชื่อค่าย เลข RTP รายเกม ชื่อผู้ให้บริการ ชื่อธนาคาร เลขใบอนุญาต ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือเวลาฝากถอนออโต้ — บรีฟ NATO168 ไม่ได้ให้ไว้เลย
// สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลข
// ที่ใช้ได้มีเท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง
const gameFormats = [
  { icon: "🎰", name: "สล็อตวงล้อทั่วไป", detail: "รูปแบบพื้นฐานที่มีกติกาไม่ซับซ้อน เหมาะสำหรับมือใหม่ที่ต้องการเริ่มจากเกมที่เข้าใจง่ายก่อน" },
  { icon: "🔄", name: "ฟรีสปิน", detail: "อีกหนึ่งรูปแบบที่เลือกได้จากบัญชีเดียวหลัง Login รายละเอียดฟีเจอร์ต่างกันไปตามแต่ละเกม" },
  { icon: "✖️", name: "ตัวคูณ", detail: "รูปแบบที่ระบบเปิดให้เลือกเช่นกัน ควรอ่านกติกาและช่วงเดิมพันของเกมก่อนเริ่มเล่นทุกครั้ง" },
  { icon: "🎁", name: "เกมที่มีฟีเจอร์โบนัส", detail: "กลุ่มเกมที่มีฟีเจอร์โบนัสภายในเกม เลือกได้จากบัญชีเดียวเช่นเดียวกับสล็อตพีจีและเกมจากค่ายอื่นที่เปิดให้บริการ" },
];

// สี่ข้อนี้ประกอบจากประโยคเตือนของบรีฟเองทั้งหมด ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforeSpinChecks = [
  {
    icon: "📋",
    name: "กติกา ฟีเจอร์ และช่วงเดิมพัน",
    detail: "ควรอ่านกติกา ฟีเจอร์ และช่วงเดิมพันของแต่ละเกม รวมถึงกำหนดงบก่อนเริ่มทุกครั้ง เพราะแต่ละเกมมีรูปแบบไม่เหมือนกัน",
    tag: "อ่านก่อนเริ่มเล่น",
  },
  {
    icon: "🏷️",
    name: "เงื่อนไขของโบนัสทุกยูส",
    detail: "คำว่า “รับโบนัสทุกยูส” และ “ไม่มีล็อคยูส” ควรอ้างอิงเงื่อนไขจริงของเว็บไซต์ เพราะบางโปรโมชั่นอาจกำหนดประเภทสมาชิก เกมที่ร่วมรายการ หรือยอดที่ใช้คำนวณแตกต่างกัน",
    tag: "อ้างอิงเงื่อนไขจริง",
  },
  {
    icon: "🧾",
    name: "รอบคำนวณของแต่ละโปรโมชั่น",
    detail: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัส จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🔐",
    name: "ความปลอดภัยของบัญชีสมาชิก",
    detail: "ควรใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    tag: "ไม่บอกใคร",
  },
];

const chips = ["สล็อตพีจี", "ค่ายเกมที่เปิดรองรับ", "โบนัสไทม์", "ฟรีสปิน", "ตัวคูณ", "วงล้อ", "สัญลักษณ์", "ปั่น", "โบนัสทุกยูส", "ไม่มีล็อคยูส", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%", "สมัครสมาชิก", "Login", "แอดมิน 24 ชั่วโมง"];

// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): โลโก้เป็นเวิร์ดมาร์กสองโทน คำว่า NATO เป็นเงิน
// เมทัลลิก ส่วนเลข 168 กับวงกลมตัว N เป็นทอง (vivid #edb543 รองด้วย #fcdc73 #fde8a8)
// งานอาร์ตเป็นฉากผ้าซาตินทองกับเหรียญทองลอยบนพื้นดำ สองแผงจึงถูกแยกด้วยสองโทนนั้นตรงๆ
// ไม่ใช่ด้วยระดับความสว่างของทองเหมือนรอบ NAZA99 — แผงล็อกอินอยู่ในกรอบทองแบรนด์
// #edb543 ส่วนแผงรูปแบบเกมอยู่ในกรอบเงิน #e6e6e6 แบบโปร่ง ทั้งคู่วางบนผิวการ์ดดำสนิท
// #101010 ช่องกรอกและชิปตกลงไปที่พื้นเพจ #070707 บรรทัดเด่นไล่เฉดทองอ่อน #fde8a8 →
// ทองแบรนด์ #edb543 → เงิน #e6e6e6 ปุ่มเข้าสู่ระบบเป็นทองเต็มตัวบนหมึกบนพื้นทอง #1a1203
// ตามกฎคอนทราสต์ที่ว่าพื้นทองต้องใช้หมึกเข้มเสมอ และไล่เฉดใต้หมึกเข้มห้ามจบมืดกว่า
// ทองลึก #a9761f (4.7:1) ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์มซึ่งห้ามรีแมป
// ข้อความรองใช้สีข้อความรอง #bdb49f ซึ่งเป็นโทเคนในพาเลตต์ ไม่ใช่ BRAND_TEXT ที่ลดความทึบ
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #140c02
// #0a0501 #241404 #1a1000 #f3e8cf) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รูปแบบเกมสล็อต ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรูปแบบเกมสล็อตที่เว็บไซต์เปิดให้เลือก ตั้งแต่สล็อตวงล้อทั่วไป ฟรีสปิน ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์โบนัส และจุดที่ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#edb543]/45 bg-[#101010]/94 p-6 shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#edb543]/24 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#edb543]/70 bg-gradient-to-br from-[#fde8a8] via-[#edb543] to-[#a9761f] text-xl text-[#1a1203] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fde8a8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bdb49f]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านเว็บเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ แล้วเลือกสล็อตพีจีหรือเกมสล็อตจากค่ายอื่นที่เปิดให้บริการได้จากบัญชีเดียว พร้อมตรวจสอบโบนัส เครดิต และรายละเอียดโปรโมชั่นก่อนเริ่มเล่น
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb49f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a2a0d] bg-[#070707]/95 py-3 pr-4 pl-12 text-[#f4ead3] transition-all outline-none placeholder:text-[#bdb49f]/70 focus:border-[#edb543] focus:ring-1 focus:ring-[#fde8a8]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb49f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a2a0d] bg-[#070707]/95 py-3 pr-4 pl-12 text-[#f4ead3] transition-all outline-none placeholder:text-[#bdb49f]/70 focus:border-[#edb543] focus:ring-1 focus:ring-[#fde8a8]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bdb49f]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a2a0d] bg-[#070707] accent-[#edb543]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bdb49f] transition-colors hover:text-[#fde8a8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fde8a8]/70 bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#a9761f] p-3.5 text-center font-black text-[#1a1203] shadow-[0_10px_30px_rgba(237,181,67,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,232,168,0.55)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#bdb49f]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a2a0d]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a2a0d]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3a2a0d] bg-[#070707] px-2.5 py-1 text-[10px] font-bold text-[#f4ead3]"><span aria-hidden="true">🎰</span> สล็อตพีจี</span>
            <span class="rounded-full border border-[#e6e6e6]/40 bg-[#070707]/85 px-2.5 py-1 text-[10px] font-bold text-[#e6e6e6]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#edb543] transition-colors hover:text-[#fde8a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e6e6e6]/35 bg-[#101010]/94 p-5 shadow-[0_10px_30px_rgba(4,3,0,0.85)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bdb49f]">
            {BRAND_NAME} รวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเริ่มต้นเล่นผ่านระบบที่ใช้งานไม่ซับซ้อน มีทั้งสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับ เข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายแพลตฟอร์ม
          </span>
          <div class="bg-gradient-to-r from-[#fde8a8] via-[#edb543] to-[#e6e6e6] bg-clip-text text-xl font-black text-transparent sm:text-2xl">สล็อตพีจี · ค่ายที่เปิดรองรับ · หมวดโบนัสไทม์</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#3a2a0d] bg-[#070707]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#edb543] shadow-[0_0_8px_rgba(237,181,67,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fde8a8] uppercase">ตามรายการที่เว็บไซต์เปิดรองรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdb49f] uppercase">
        <span>รูปแบบเกมที่เปิดให้เลือก</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameFormats.map((g) => (
            <div class="rounded-xl border border-[#3a2a0d] bg-[#070707]/95 px-3.5 py-2.5 transition-colors hover:border-[#edb543]/70 hover:bg-[#17120a]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fde8a8]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {g.icon}
                </span>
                <span class="truncate">{g.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#bdb49f]">{g.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#bdb49f]">
        รายการเกมที่เปิดให้ใช้งานจริงขึ้นอยู่กับค่ายที่เว็บไซต์เปิดรองรับในแต่ละช่วง มือใหม่จึงควรเลือกเกมที่มีกติกาเข้าใจง่ายและตรวจสอบข้อมูลของเกมก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdb49f] uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSpinChecks.map((k) => (
            <div class="rounded-xl border border-[#3a2a0d] bg-[#070707]/95 px-3.5 py-2.5 transition-colors hover:border-[#e6e6e6]/50 hover:bg-[#17120a]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4ead3]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#edb543]/50 bg-[#070707] px-2.5 py-0.5 text-[10px] font-bold text-[#edb543]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bdb49f]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3a2a0d] bg-[#070707] px-3 py-1 text-[10px] font-bold text-[#f4ead3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#bdb49f]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมสล็อตพีจีและเกมจากค่ายที่เว็บไซต์เปิดรองรับไว้ในบัญชีเดียว การเข้าเล่นผ่านมือถือโดยไม่ต้องสลับหลายแพลตฟอร์ม และหมวดโบนัสไทม์สำหรับติดตามเกมและกิจกรรมที่เปิดสิทธิ์ในแต่ละช่วง
        ส่วนโบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเงื่อนไขตามรอบที่เว็บไซต์กำหนด แต่ละรายการอาจมีเงื่อนไขเกี่ยวกับค่ายเกม รอบคำนวณ หรือยอดที่นำมาคิดโบนัส จึงควรตรวจสอบรายละเอียดก่อนกดรับทุกครั้ง
        และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
