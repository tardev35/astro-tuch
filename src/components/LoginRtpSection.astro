---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// WIN8S is a สล็อตออนไลน์ เว็บตรง brand, so every row below stays inside what the
// brief states: หมวดสล็อตจากหลายค่าย ทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน
// และเกมธีมต่าง ๆ, การเลือกเกมและปรับระดับเดิมพันตามช่วงที่แต่ละเกมกำหนด, การเล่น
// ผ่านมือถือโดยไม่ต้องติดตั้งหลายระบบ, การ Login เพื่อตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ
// ผ่านบัญชีของตนเอง, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% พร้อมรอบคำนวณ ยอด
// ขั้นต่ำ เกมที่เข้าร่วม และเงื่อนไขการถอน, ระบบวอลเลทหรือธนาคารตามช่องทางที่เปิด
// รองรับ, และทีมงานที่ช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed win — the brief states none of them
// and says the "ไม่มีขั้นต่ำ" wording must follow what the system shows at the
// time of the transaction.
const menus = [
  {
    icon: "🎁",
    name: "Login ตรวจโปรโมชั่นที่มีสิทธิ์รับ",
    detail: "สมาชิกที่มีบัญชีเข้าสู่ระบบเพื่อดูโปรโมชั่นที่มีสิทธิ์รับผ่านบัญชีของตนเองได้ แต่ละรายการอาจกำหนดรอบคำนวณและยอดขั้นต่ำต่างกัน",
    tag: "ดูจากบัญชี",
  },
  { icon: "👥", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส 0.8% ตามยอดที่เข้าเกณฑ์", tag: "0.8%" },
  { icon: "💠", name: "โบนัสคืนยอดเสีย 0.3%", detail: "ตรวจสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ก่อนกดรับควรดูประเภทเกม รอบคำนวณ และเงื่อนไขของโปรโมชั่นให้ครบถ้วน", tag: "0.3%" },
  { icon: "🎰", name: "สล็อตหลายค่ายในบัญชีเดียว", detail: "จัดหมวดเกมสล็อตจากหลายค่ายไว้ให้เลือกตามรูปแบบที่สนใจ สลับเกมและสลับค่ายได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง", tag: "หลายค่าย" },
  {
    icon: "🕹️",
    name: "ช่วงเดิมพันของแต่ละเกม",
    detail: "ปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด ควรตรวจสอบตัวเลขเดิมพันในเกมก่อนเริ่มเล่น เพราะขั้นต่ำจริงต่างกันตามค่ายและเกม",
    tag: "ตรวจก่อนเล่น",
  },
  { icon: "🌌", name: "เกมโบนัส ฟรีสปิน และเกมธีม", detail: "หมวดเกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ ให้เลือกตามความสนใจ ฟีเจอร์ในเกมเปิดตามเงื่อนไขที่แต่ละเกมกำหนดไว้", tag: "ตามเงื่อนไขเกม" },
  { icon: "📱", name: "เล่นผ่านมือถือได้ทันที", detail: "รองรับการเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องติดตั้งหลายระบบ เลือกเกมและจัดการบัญชีได้จากหน้าเว็บไซต์", tag: "ไม่ต้องติดตั้ง" },
  {
    icon: "💳",
    name: "ฝากถอนวอลเลทและธนาคาร",
    detail: "ฝากถอนผ่านวอลเลทหรือธนาคารตามช่องทางที่ระบบเปิดรองรับ ควรตรวจสอบยอดขั้นต่ำ วงเงิน และสถานะของช่องทางก่อนทำรายการ",
    tag: "ทำรายการเอง",
  },
];

const chips = ["สล็อตคลาสสิก", "สล็อตวิดีโอ", "เกมโบนัส", "ฟรีสปิน", "เกมธีมต่าง ๆ", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "ทีมงาน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ WIN8S" titleright="จุดที่ควรตรวจสอบก่อนกดรับโปรโมชั่นและเริ่มเล่น" label="เข้าสู่ระบบ WIN8S และรายการจุดที่ควรตรวจสอบก่อนกดรับโปรโมชั่น">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8a3103]/55 bg-[#1c0a02]/92 p-6 shadow-[0_10px_30px_rgba(243,100,3,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f36403]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#9aa3ad]/60 bg-gradient-to-br from-[#fff2e6] via-[#e3e7ec] to-[#8a3103] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff2e6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#fd9a1e]">เข้าสู่ระบบ WIN8S เพื่อเลือกเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว ตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ ฝากถอนวอลเลท และติดตามสถานะรายการได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9aa3ad]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8a3103]/55 bg-[#140300]/95 py-3 pr-4 pl-12 text-[#f6e4d6] transition-all outline-none placeholder:text-[#9aa3ad] focus:border-[#f36403] focus:ring-1 focus:ring-[#f36403]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9aa3ad]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#8a3103]/55 bg-[#140300]/95 py-3 pr-4 pl-12 text-[#f6e4d6] transition-all outline-none placeholder:text-[#9aa3ad] focus:border-[#f36403] focus:ring-1 focus:ring-[#f36403]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f6e4d6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8a3103]/55 bg-[#140300] accent-[#f36403]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f6e4d6] transition-colors hover:text-[#fff2e6]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#8a3103]/60 bg-gradient-to-r from-[#fd9a1e] via-[#f36403] to-[#ec5402] p-3.5 text-center font-black text-[#140300] shadow-[0_10px_30px_rgba(243,100,3,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(252,141,19,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9aa3ad]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a3103]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a3103]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อทีมงานผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#9aa3ad]/45 bg-[#140300] px-2.5 py-1 text-[10px] font-bold text-[#e3e7ec]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#8a3103]/50 bg-[#140300]/80 px-2.5 py-1 text-[10px] font-bold text-[#fd9a1e]"><span aria-hidden="true">🕐</span> ทีมงาน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fd9a1e] transition-colors hover:text-[#fff2e6]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a3103]/55 bg-[#1c0a02]/92 p-5 shadow-[0_10px_30px_rgba(243,100,3,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f6e4d6]">
            เลือกเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว และตรวจสอบช่วงเดิมพันของแต่ละเกมก่อนเริ่มเล่นทุกครั้ง เพราะขั้นต่ำจริงอาจแตกต่างกันตามค่ายและเกม
          </span>
          <div class="bg-gradient-to-r from-[#fd9a1e] via-[#e3e7ec] to-[#f36403] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกค่ายสล็อต</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#9aa3ad]/55 bg-[#2a0f03]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e3e7ec] shadow-[0_0_8px_rgba(227,231,236,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e3e7ec] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9aa3ad] uppercase">
        <span>โปรโมชั่น หมวดเกมสล็อต และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#8a3103] bg-[#140300]/95 px-3.5 py-2.5 transition-colors hover:border-[#e3e7ec]/45 hover:bg-[#2a0f03]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f6e4d6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#9aa3ad]/45 bg-[#140300] px-2.5 py-0.5 text-[10px] font-bold text-[#e3e7ec]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9aa3ad]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8a3103]/45 bg-[#140300] px-3 py-1 text-[10px] font-bold text-[#fd9a1e]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9aa3ad]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น แต่ละค่ายและแต่ละเกมอาจกำหนดช่วงเดิมพันและเงื่อนไขของฟีเจอร์ไม่เท่ากัน ให้ยึดรายละเอียดที่แสดงในเกม ณ เวลาเล่นเป็นหลัก ส่วนรอบคำนวณ ยอดขั้นต่ำ
        เกมที่เข้าร่วม และเงื่อนไขการถอนของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
