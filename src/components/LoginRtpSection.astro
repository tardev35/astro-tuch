---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// BETPLAY369 is a casino brand, so every row below stays inside what the docx
// states: บาคาร่าและคาสิโนสดแบบ Live, สล็อตออนไลน์หลากหลายค่าย, หวยออนไลน์หลายรอบ,
// การเดิมพันมวยและฟุตบอล, การตรวจกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนยืนยัน,
// โปรคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไข, การสมัคร/Login และแอดมินที่ดูแล
// ตลอด 24 ชั่วโมง. No payout claim, no RTP figure and no studio the brief does not
// state appears anywhere in this file.
const menus = [
  { icon: "🃏", name: "บาคาร่า", detail: "เดิมพันหลักมีทั้ง Player, Banker และ Tie ตรวจกติกาและอัตราจ่ายของโต๊ะที่เลือกก่อนลงเดิมพัน", tag: "อ่านกติกาก่อน" },
  { icon: "🎥", name: "คาสิโนสด (Live)", detail: "โต๊ะ Live เปิดให้บริการตามระบบ แต่ละโต๊ะอาจมาจากผู้ให้บริการและสถานที่ต่างกัน", tag: "ดูผู้ให้บริการ" },
  { icon: "🎰", name: "สล็อตหลายค่าย", detail: "เลือกสล็อตจากหลายค่ายในบัญชีเดียว ดูเพย์ไลน์ ฟีเจอร์ และช่วงเดิมพันได้ก่อนเริ่มเล่น", tag: "หลายผู้ให้บริการ" },
  { icon: "🎟️", name: "หวยออนไลน์หลายรอบ", detail: "รายละเอียดรอบ อัตราจ่าย และเวลาปิดรับของแต่ละรอบแสดงไว้ในหน้าเกมโดยตรง", tag: "ดูรอบก่อนแทง" },
  { icon: "🥊", name: "มวย", detail: "เลือกคู่และรูปแบบการเดิมพันได้ตามความสนใจ ตรวจเงื่อนไขของรายการนั้นก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "⚽", name: "ฟุตบอล", detail: "เดิมพันจากรายการที่เปิดให้บริการ ผลการแข่งขันไม่สามารถรับประกันล่วงหน้าได้", tag: "ตามรายการในระบบ" },
  { icon: "🎁", name: "โปรคืนยอดเสียและแนะนำเพื่อน", detail: "โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณตามรอบและเงื่อนไขที่ระบบกำหนด", tag: "ตามเงื่อนไข" },
  { icon: "🎧", name: "แอดมินดูแล 24 ชั่วโมง", detail: "สมัครไม่ได้ Login ไม่ผ่าน เครดิตไม่เข้า หรือเข้าโต๊ะ Live ไม่ได้ แจ้งเวลาและรายละเอียดได้", tag: "ตลอด 24 ชม." },
];

const chips = ["บาคาร่า", "คาสิโนสด", "สล็อต", "หวย", "มวย", "ฟุตบอล", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ BETPLAY369" titleright="เกมเดิมพันที่ใช้ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์" label="เข้าสู่ระบบ BETPLAY369 และหมวดเกมเดิมพันที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6d1750]/70 bg-[#10041d]/92 p-6 shadow-[0_10px_30px_rgba(229,57,159,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e5399f]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e5399f]/55 bg-gradient-to-br from-[#ff35b4] via-[#e5399f] to-[#6d1750] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f4ebff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a48fc4]">เข้าสู่ระบบ BETPLAY369 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a48fc4]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6d1750] bg-[#08030f]/95 py-3 pr-4 pl-12 text-[#dfd0ee] transition-all outline-none placeholder:text-[#a48fc4] focus:border-[#e5399f] focus:ring-1 focus:ring-[#e5399f]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a48fc4]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6d1750] bg-[#08030f]/95 py-3 pr-4 pl-12 text-[#dfd0ee] transition-all outline-none placeholder:text-[#a48fc4] focus:border-[#e5399f] focus:ring-1 focus:ring-[#e5399f]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dfd0ee]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6d1750] bg-[#08030f] accent-[#e5399f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dfd0ee] transition-colors hover:text-[#22c6f0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#e5399f]/50 bg-gradient-to-r from-[#22c6f0] via-[#ff35b4] to-[#e5399f] p-3.5 text-center font-black text-[#08030f] shadow-[0_10px_30px_rgba(229,57,159,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(229,57,159,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a48fc4]">
          <span class="h-px flex-1 bg-[#6d1750]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6d1750]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6d1750]/80 bg-[#08030f] px-2.5 py-1 text-[10px] font-bold text-[#f4ebff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e5399f]/35 bg-[#08030f]/80 px-2.5 py-1 text-[10px] font-bold text-[#dfd0ee]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f4ebff] transition-colors hover:text-[#22c6f0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e5399f]/35 bg-[#10041d]/92 p-5 shadow-[0_10px_30px_rgba(229,57,159,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dfd0ee]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#f4ebff] via-[#22c6f0] to-[#e5399f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a48fc4] uppercase">
        <span>ประเภทเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6d1750] bg-[#08030f]/95 px-3.5 py-2.5 transition-colors hover:border-[#e5399f]/60 hover:bg-[#1a0730]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dfd0ee]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6d1750]/80 bg-[#08030f] px-2.5 py-0.5 text-[10px] font-bold text-[#f4ebff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a48fc4]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e5399f]/30 bg-[#08030f] px-3 py-1 text-[10px] font-bold text-[#f4ebff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a48fc4]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
