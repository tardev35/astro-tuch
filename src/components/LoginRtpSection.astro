---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// UFA168 is a casino + sportsbook aggregator, so every row below stays inside
// what the brief states: การรวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว, การรองรับ
// มือถือ แท็บเล็ต และคอมพิวเตอร์, การตรวจสอบกติกา อัตราจ่าย และรายละเอียดการ
// เดิมพันก่อนเริ่มเล่น, โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข,
// การสมัครและ Login ด้วยตัวเอง 3 ขั้นตอน, การไม่เปิดเผยรหัสผ่านหรือ OTP และการ
// ติดต่อแอดมินพร้อมแจ้งรายละเอียดและเวลาที่เกิดรายการ.
// Nothing here quotes a return-to-player figure, a payout, or a promotion the
// brief does not state.
const menus = [
  { icon: "🎮", name: "หมวดเกมในบัญชีเดียว", detail: "สล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา และหวย เลือกค่ายและเกมที่สนใจได้จากบัญชีเดียวกัน", tag: "เลือกจากบัญชีเดียว" },
  { icon: "📋", name: "กติกาและอัตราจ่าย", detail: "เปิดดูกติกา อัตราจ่าย และรายละเอียดการเดิมพันของเกมนั้นให้ครบก่อนเริ่มเล่นทุกครั้ง", tag: "อ่านก่อนเริ่มเล่น" },
  { icon: "🏷️", name: "ข้อมูลค่ายผู้ให้บริการเกม", detail: "แต่ละเกมอาจมาจากผู้พัฒนาหรือผู้ให้บริการต่างกัน ควรตรวจจากข้อมูลของค่ายที่แสดงในระบบโดยตรง", tag: "ตรวจจากในระบบ" },
  { icon: "🤝", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "คัดลอกลิงก์แนะนำส่วนตัวไปแชร์ ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมียอดตรงตามข้อกำหนด", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจรอบเวลา ประเภทเกม และยอดที่นำมาคำนวณจากหน้าโปรโมชั่น ก่อนกดรับสิทธิ์ในแต่ละรอบ", tag: "ตรวจรอบก่อนกดรับ" },
  { icon: "📝", name: "สมัครและฝากถอน 3 ขั้นตอน", detail: "กรอกข้อมูลให้ครบ Login เข้าบัญชีแล้วทำรายการฝากผ่านช่องทางที่เปิดให้บริการ จากนั้นเลือกเกม", tag: "ทำเองได้ทั้ง 2 อุปกรณ์" },
  { icon: "🔒", name: "รหัสผ่านและ OTP", detail: "ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่เปิดเผยรหัสผ่านหรือ OTP และตรวจว่าใช้ช่องทางที่ถูกต้องก่อนทำธุรกรรม", tag: "ห้ามบอกผู้อื่น" },
  { icon: "🎧", name: "แอดมิน UFA168 หลังบ้าน", detail: "ติดปัญหาสมัคร Login เครดิตไม่เข้า ถอนล่าช้า หรือโปรไม่แสดง ให้แจ้งรายละเอียดและเวลาที่เกิดรายการ", tag: "แจ้งเวลาทุกครั้ง" },
];

const chips = ["สล็อต", "บาคาร่า", "คาสิโนสด", "เกมไพ่", "กีฬา", "หวย", "โบนัส 0.8%", "คืนยอดเสีย 0.3%"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ UFA168"
  titleright="จุดที่ควรตรวจสอบก่อนเริ่มเดิมพันกับ UFA168"
  label="เข้าสู่ระบบ UFA168 และตารางจุดที่ควรตรวจสอบก่อนเริ่มเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b5316]/80 bg-[#14100a]/92 p-6 shadow-[0_10px_30px_rgba(243,219,91,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a37c14]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d4af37]/60 bg-gradient-to-br from-[#fff3bf] via-[#f3db5b] to-[#a37c14] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f3db5b]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bdb08c]">เข้าสู่ระบบ UFA168 เพื่อเลือกเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการข้อมูลบัญชีผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb08c]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b5316] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e6dcc2] transition-all outline-none placeholder:text-[#bdb08c] focus:border-[#f3db5b] focus:ring-1 focus:ring-[#f3db5b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb08c]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b5316] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e6dcc2] transition-all outline-none placeholder:text-[#bdb08c] focus:border-[#f3db5b] focus:ring-1 focus:ring-[#f3db5b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e6dcc2]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b5316] bg-[#050403] accent-[#d4af37]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e6dcc2] transition-colors hover:text-[#f3db5b]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#d4af37]/55 bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] p-3.5 text-center font-black text-[#050403] shadow-[0_10px_30px_rgba(243,219,91,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(243,219,91,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#bdb08c]">
          <span class="h-px flex-1 bg-[#6b5316]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b5316]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b5316]/80 bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#f3db5b]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#d4af37]/40 bg-[#050403]/80 px-2.5 py-1 text-[10px] font-bold text-[#e6dcc2]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f3db5b] transition-colors hover:text-[#fff3bf]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b5316]/70 bg-[#14100a]/92 p-5 shadow-[0_10px_30px_rgba(243,219,91,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e6dcc2]">รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ใช้งานได้ทุกอุปกรณ์</span>
          <div class="bg-gradient-to-r from-[#d8dce2] via-[#f3db5b] to-[#a37c14] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdb08c] uppercase">
        <span>เกม โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b5316] bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#d4af37]/60 hover:bg-[#241a08]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e6dcc2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6b5316]/80 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#f3db5b]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bdb08c]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d4af37]/35 bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#f3db5b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#bdb08c]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเดิมพัน โปรโมชั่นแต่ละรายการมีวิธีคำนวณ รอบการรับ และข้อกำหนดแตกต่างกัน และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </div>
    </div>
  </div>
</ContentBoxTwo>
