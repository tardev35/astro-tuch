---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// OCZPLUS is a slot brand — สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุด ที่
// วางระบบนิเวศการเดิมพันแบบ Portal & Privilege. Every row below stays inside what
// the brief states: การันตียอดถอนทุกวัน จ่ายเต็มจำนวนไร้ประวัติการโกง, แจกโบนัส
// หนักทุกยูสเซอร์แบบไม่ล็อคยูสด้วยระบบสุ่ม RNG 100%, แนะนำเพื่อนรับคอมมิชชั่น
// 0.8% จากทุกยอดการเล่นของเพื่อน, คืนยอดเสีย 0.3% ในทุกยอดการเล่น, ระบบฝาก-ถอน
// อัตโนมัติบนมือถือที่รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ประมวลผลภายใน
// 3-5 วินาที ไม่ต้องส่งสลิป ไม่มีขั้นต่ำ, ถอนได้ตลอด 24 ชั่วโมงโดยไม่จำกัดจำนวน
// ครั้งและไม่จำกัดยอดสูงสุดต่อวัน, กราฟิกระดับ Cinematic Lighting ที่ Optimize มา
// ให้เล่นลื่นทั้ง iOS และ Android, และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// No licence number, no member count and no guaranteed payout — nothing here
// goes beyond what the brief itself says.
const menus = [
  {
    icon: "🏆",
    name: "แหล่งเดิมพันแบบ Portal & Privilege",
    detail: "ระบบนิเวศการเดิมพันที่รวมเอกสิทธิ์และผลตอบแทนของสมาชิกไว้ในบัญชีเดียว เข้าใช้งานผ่านหน้าอินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค",
    tag: "สล็อตอันดับหนึ่ง",
  },
  {
    icon: "💰",
    name: "การันตียอดถอนทุกวัน จ่ายเต็มจำนวน",
    detail: "ทำกำไรได้หลักหมื่นหรือหลักล้าน ระบบพร้อมจ่ายเต็มจำนวน ไร้ประวัติการโกง พิสูจน์ได้จากรีวิวของสมาชิกตัวจริงที่แบ่งปันเข้ามาอย่างล้นหลาม",
    tag: "ถอนได้ทุกวัน",
  },
  {
    icon: "🔓",
    name: "แจกทุกยูส ไม่มีล็อค RNG 100%",
    detail: "เกมลิขสิทธิ์แท้ควบคุมด้วยระบบสุ่ม RNG 100% ทั้งลูกค้าเก่าที่สะสมยอดฝากมานานและสมาชิกใหม่มีโอกาสชนะและรับแจ็คพอตเท่าเทียมกัน",
    tag: "เก่า-ใหม่เท่ากัน",
  },
  {
    icon: "🤝",
    name: "Login ตรวจสิทธิ์แนะนำเพื่อน 0.8%",
    detail: "เข้าสู่ระบบเพื่อรับลิงก์แนะนำเพื่อนของคุณเอง แล้วรับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อนแบบ Passive Income",
    tag: "0.8% ทุกยอดเล่น",
  },
  {
    icon: "🎁",
    name: "กดรับคืนยอดเสีย 0.3% ผ่านหน้าเว็บ",
    detail: "ระบบซัพพอร์ตเงินทุนคืนยอดเสีย 0.3% ในทุกยอดการเล่น เก็บเป็นเครดิตสำรองไว้กลับไปแก้มือและต่อยอดกำไรได้ต่อเนื่อง",
    tag: "กดรับเองได้",
  },
  {
    icon: "💳",
    name: "ฝาก-ถอนออโต้ทุกธนาคารและวอลเลท",
    detail: "ระบบธุรกรรมอัตโนมัติที่ออกแบบมาเพื่อมือถือโดยเฉพาะ รองรับทุกธนาคารชั้นนำในประเทศไทยรวมถึง TrueMoney Wallet ไม่ต้องส่งสลิปให้แอดมิน ไม่มีขั้นต่ำ",
    tag: "ไม่มีขั้นต่ำ",
  },
  {
    icon: "⏱️",
    name: "ถอน 3-5 วินาที ไม่จำกัดรอบต่อวัน",
    detail: "ระบบประมวลผลรายการภายใน 3-5 วินาที ทำรายการถอนได้ตลอด 24 ชั่วโมง โดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดถอนสูงสุดต่อวัน",
    tag: "24 ชั่วโมง",
  },
  {
    icon: "📱",
    name: "กราฟิก Cinematic เล่นลื่นไม่กระตุก",
    detail: "แพลตฟอร์มถูกปรับแต่ง (Optimize) มาอย่างดี แม้เกมจะจัดเต็มด้วยภาพระดับพรีเมียมและเอฟเฟกต์อลังการ ก็เล่นได้ไหลลื่นทั้ง iOS และ Android",
    tag: "ทุกสมาร์ทโฟน",
  },
];

const chips = ["สล็อตอันดับหนึ่ง", "การันตียอดถอนทุกวัน", "ไม่ล็อคยูส RNG 100%", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "ทุกธนาคาร + วอลเลท", "ออโต้ 3-5 วินาที", "ไม่มีขั้นต่ำ", "Line 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ OCZPLUS"
  titleright="สิ่งที่สมาชิกได้รับจาก Portal ของ OCZPLUS"
  label="เข้าสู่ระบบ OCZPLUS และรายการสิทธิประโยชน์ที่สมาชิกได้รับจาก Portal หลัก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8a6b2c]/55 bg-[#071a36]/92 p-6 shadow-[0_10px_30px_rgba(217,180,94,0.16)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d9b45e]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c0202b]/45 bg-gradient-to-br from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f7eed6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e4c67f]">
            ล็อคอินเข้าสู่ Portal ของ OCZPLUS เพื่อเลือกเกมสล็อต ตรวจสิทธิ์แนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% เติมเครดิต และทำรายการฝาก-ถอนอัตโนมัติได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ccd6e6]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8a6b2c]/55 bg-[#02101f]/95 py-3 pr-4 pl-12 text-[#ccd6e6] transition-all outline-none placeholder:text-[#ccd6e6]/45 focus:border-[#d9b45e] focus:ring-1 focus:ring-[#d9b45e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ccd6e6]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#8a6b2c]/55 bg-[#02101f]/95 py-3 pr-4 pl-12 text-[#ccd6e6] transition-all outline-none placeholder:text-[#ccd6e6]/45 focus:border-[#d9b45e] focus:ring-1 focus:ring-[#d9b45e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ccd6e6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8a6b2c]/55 bg-[#02101f] accent-[#d9b45e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ccd6e6] transition-colors hover:text-[#f7eed6]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#8a6b2c]/60 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] p-3.5 text-center font-black text-[#03101f] shadow-[0_10px_30px_rgba(217,180,94,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(217,180,94,0.40)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ccd6e6]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a6b2c]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a6b2c]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#d9b45e]/45 bg-[#02101f] px-2.5 py-1 text-[10px] font-bold text-[#e4c67f]"><span aria-hidden="true">🎰</span> สล็อตอันดับหนึ่ง</span>
            <span class="rounded-full border border-[#8b939c]/45 bg-[#02101f]/80 px-2.5 py-1 text-[10px] font-bold text-[#e6ebf0]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e4c67f] transition-colors hover:text-[#f7eed6]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a6b2c]/55 bg-[#071a36]/92 p-5 shadow-[0_10px_30px_rgba(217,180,94,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ccd6e6]">ระบบนิเวศการเดิมพันแบบ Portal &amp; Privilege ที่มอบเอกสิทธิ์และผลตอบแทนสูงสุดให้กับสมาชิก</span>
          <div class="bg-gradient-to-r from-[#f2dc9a] via-[#e6ebf0] to-[#d9b45e] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกเอกสิทธิ์ระดับลักชูรี</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#d9b45e]/45 bg-[#0b2547]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d9b45e] shadow-[0_0_8px_rgba(217,180,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e4c67f] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ccd6e6]/60 uppercase">
        <span>สิทธิประโยชน์และระบบที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#8a6b2c]/55 bg-[#02101f]/95 px-3.5 py-2.5 transition-colors hover:border-[#d9b45e]/60 hover:bg-[#0b2547]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ccd6e6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d9b45e]/40 bg-[#02101f] px-2.5 py-0.5 text-[10px] font-bold text-[#e4c67f]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ccd6e6]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8a6b2c]/45 bg-[#02101f] px-3 py-1 text-[10px] font-bold text-[#e4c67f]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ccd6e6]/60">
        รายการข้างต้นสรุปสิ่งที่ OCZPLUS ประกาศไว้ ทั้งการการันตียอดถอนทุกวัน ระบบสุ่ม RNG 100% ที่ไม่ล็อคยูสเซอร์ ระบบฝาก-ถอนอัตโนมัติที่รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet
        และโปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ส่วนรอบคำนวณและเงื่อนไขของแต่ละโปรโมชั่น ให้ยึดข้อกำหนดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
