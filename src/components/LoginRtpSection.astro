---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ (หวยดีใจ 2026-10-04) เนื้อหาในไฟล์นี้ถูก **เขียนใหม่ทั้งแผง** ไม่ได้
// find-and-replace ทับประโยคของรอบก่อน เพราะบรีฟรอบนี้เปิดรายการหวยกว้างกว่ารอบ
// หวย24 (เพิ่ม รัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. เข้ามาเป็นรายการหลัก) และเปลี่ยนคำ
// โฆษณาหลักจาก "รับไม่อั้น/จ่ายเต็มทุกโพย" เป็น "ไม่อั้นจ่าย" กับ "ไม่มีลบโพย" ซึ่ง
// มีประโยคกำกับของตัวเองในบรีฟทั้งคู่
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก src/assets/content.txt ทั้งหมด:
// แทงหวย · ส่งโพย · โพย · รอบ · รายการหวย · รัฐบาลไทย · หวยลาว · หวยฮานอย ·
// หวยออมสิน · หวย ธ.ก.ส. · เลข 2 ตัว · เลข 3 ตัว · เลขเด็ด · แนวทาง ·
// สถิติย้อนหลัง · อัตราจ่าย · เรทจ่าย · ไม่อั้นจ่าย · ไม่มีลบโพย ·
// วงเงินที่ระบบเปิดรับ · ผลรางวัล · ประวัติรายการ · สมัคร 3 ขั้นตอน · Login ·
// แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// "RTP" เป็นคำของเว็บสล็อตและ brand-spec §6 แบนไว้ จึงไม่ปรากฏในเนื้อหาแม้แต่
// ครั้งเดียว แผงขวาเป็น "รายการหวยที่เปิดรับ" ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: เวลาออกรางวัลของแต่ละรอบ · ชื่อตลาดหวยอื่น
// นอกจากห้ารายการข้างบน (ห้ามเติม ลาวพัฒนา หวยหุ้น ยี่กี) · ชื่อธนาคาร ·
// เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง — บรีฟไม่ได้ให้ไว้สักอย่าง
// และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่
// ใช้ได้มีเท่านี้: 2 ตัว · 3 ตัว · 100 · 1,000 · 3 ขั้นตอน · 24 ชั่วโมง
//
// แผงฝั่งขวาแถวบนคือ "รายการหวยที่ระบบเปิดรับ" ซึ่งเป็นคำของบรีฟตรงๆ และชื่อ
// รายการห้าชื่อ (รัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส.) ก็มาจากบรีฟ
const betTypes = [
  { icon: "🏛️", name: "รัฐบาลไทย", detail: "เปิดรับตามกำหนดออกรางวัล ควรตรวจสอบรอบและอัตราจ่ายบนหน้าส่งโพยก่อนยืนยันรายการ" },
  { icon: "🗓️", name: "หวยลาว", detail: "เลือกได้ตามรอบที่เปิดให้บริการ ควรดูเวลาเปิดรับและเวลาปิดรับที่ระบบแสดงก่อนส่งโพย" },
  { icon: "⏱️", name: "หวยฮานอย", detail: "มีหลายรอบตามรายการที่เปิดให้บริการ แต่ละรอบอาจกำหนดรายละเอียดแตกต่างกัน" },
  { icon: "🏦", name: "หวยออมสิน", detail: "เปิดรับตามรายการที่ระบบกำหนด ควรตรวจสอบรอบเวลาและเรทของรายการนั้นก่อนยืนยัน" },
  { icon: "🌾", name: "หวย ธ.ก.ส.", detail: "เปิดรับตามรายการที่ระบบกำหนดเช่นกัน รายละเอียดของแต่ละรายการอาจไม่เหมือนกัน" },
  { icon: "🎟️", name: "เลข 2 ตัว", detail: "รายการที่เข้าเงื่อนไขมีเรท 2 ตัว จ่าย 100 บาท ก่อนกดยืนยันควรตรวจสอบเลขให้ครบทั้งสองหลัก" },
  { icon: "🎫", name: "เลข 3 ตัว", detail: "รายการที่เข้าเงื่อนไขมีเรท 3 ตัว จ่าย 1,000 บาท เลข 3 ตัวมีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันทุกรายการ" },
  { icon: "🔢", name: "เลขเด็ด", detail: "เลือกเลขที่มีผู้เลือกจำนวนมากได้ตามรายการที่เปิดรับ แต่ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน" },
  { icon: "🧭", name: "แนวทาง และสถิติย้อนหลัง", detail: "ดูแนวทางและสถิติประกอบการเลือกเลขได้จากบัญชีเดียว เป็นข้อมูลประกอบเท่านั้น ไม่การันตีเลขเข้าทุกงวด" },
  { icon: "📑", name: "ผลรางวัล และประวัติรายการ", detail: "ตรวจผลรางวัลและย้อนดูประวัติรายการของโพยที่ระบบยืนยันแล้วได้จากบัญชีเดียวกับที่ใช้ส่งโพย" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 6, 7, 9, 10, 17)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforeSlipChecks = [
  {
    icon: "⏰",
    name: "เวลาเปิดรับและเวลาปิดรับของรอบ",
    detail: "สมาชิกสามารถตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลขที่ต้องการ และยอดเดิมพันได้ก่อนส่งโพย จึงควรดูรอบเวลาของรายการที่เลือกให้ตรงก่อนกดยืนยันทุกครั้ง",
    tag: "ดูรอบเวลาให้ตรง",
  },
  {
    icon: "🧾",
    name: "อัตราจ่ายของรายการนั้น",
    detail: "อัตรา 2 ตัว 100 บาท และ 3 ตัว 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพย",
    tag: "ยึดหน้าส่งโพย",
  },
  {
    icon: "📊",
    name: "วงเงินที่ระบบเปิดรับ",
    detail: "คำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน",
    tag: "เช็กวงเงินจริง",
  },
  {
    icon: "🔐",
    name: "รหัสผ่าน PIN และ OTP",
    detail: "ควรตั้งรหัสผ่านที่คาดเดายาก ตรวจสอบเลขและยอดก่อนยืนยันโพยทุกครั้ง และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่นไม่ว่าจะติดต่อผ่านช่องทางใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "แทงหวย",
  "ส่งโพย",
  "โพย",
  "รายการหวย",
  "รอบ",
  "รัฐบาลไทย",
  "หวยลาว",
  "หวยฮานอย",
  "หวยออมสิน",
  "หวย ธ.ก.ส.",
  "เลข 2 ตัว",
  "เลข 3 ตัว",
  "เลขเด็ด",
  "แนวทาง",
  "สถิติย้อนหลัง",
  "อัตราจ่าย",
  "เรทจ่าย",
  "วงเงินที่ระบบเปิดรับ",
  "ผลรางวัล",
  "ประวัติรายการ",
  "สมัคร 3 ขั้นตอน",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// โลโก้รอบนี้เขียนคำว่า "หวย" ด้วยเงินโครเมียมและคำว่า "ดีใจ" ด้วยแดงเมทัลลิก มีมงกุฎ
// ทอง #f3c54e อยู่เหนือทั้งสองคำ คู่สีจริงจึงเป็น แดงแบรนด์ #dc0409 (สีหลัก) กับ
// เงินโครเมียม #eef0f4 / #c3c7d1 (สีคู่) และทองเป็นสีรองเท่านั้น — ไม่ใช่คู่ แดง+ทอง
// แบบ หวย24 สองแผงถูกแยกด้วยคู่นั้นตรงๆ และจงใจให้ตรงกับ ContentBoxTwo ที่ครอบอยู่
// ซึ่งให้ป้ายคอลัมน์ซ้ายเป็นแดงและป้ายคอลัมน์ขวาเป็นเงิน — แผงล็อกอิน (ซ้าย) จึงอยู่
// ในกรอบแดงแบรนด์ ส่วนแผงรายการหวย (ขวา) อยู่ในกรอบเงินโครเมียม ทั้งคู่วางบนผิว
// การ์ด #17080c ช่องกรอกและชิปตกลงไปที่พื้นลึกสุด #0d0407 บรรทัดเด่นไล่เงินสว่าง
// #eef0f4 → ทอง #f3c54e → แดงสว่าง #f5363d
//
// ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นโครงไม่ทึบ ขอบแดงแบรนด์
// #dc0409 หมึกแดงสว่าง #f5363d ตามกฎคอนทราสต์ของ §2 ที่ว่าปุ่มรองคือขอบสีบนพื้น
// ดำอมแดง ไม่ใช่ถมสีอีกใบ ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบไม่ไล่เฉด
// ซึ่งต่างจากปุ่มสมัครสมาชิกพื้นไล่เฉดแดงบนหน้าแรก
// ข้อความรองใช้สีเนื้อความ #edeaf0 แบบลดความทึบ และ caption ที่จางที่สุดใช้เงินหม่น
// #8d93a1 ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง เนื้อความ #edeaf0 (= BRAND_TEXT)
// glow เป็น rgba(220,4,9,…) / rgba(195,199,209,…)
//
// ชุดแดง + ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#d20a0a #f5c33b #ffd45e #a9761a
// #ff3b3b #ff5c5c #7a0505 #3d0a0a #170707 #0a0303 #1a0303 #f7e2d6
// rgba(210,10,10,…) rgba(245,195,59,…)) ออกครบทุกจุดแล้ว — รอบนี้คู่สีหลักคือ
// แดง/เงิน ไม่ใช่ แดง/ทอง จึงไม่ใช่การยกค่าเดิมมาเปลี่ยนแค่เบอร์
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการหวยที่ ${BRAND_NAME} เปิดรับ`}
  iconleft="🔐"
  iconright="🎟️"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหวยที่ระบบเปิดรับ ทั้งรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส. เลข 2 ตัว เลข 3 ตัว และจุดที่ควรตรวจสอบก่อนส่งโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#dc0409]/60 bg-[#17080c]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#dc0409]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5363d]/70 bg-gradient-to-br from-[#f5363d] via-[#dc0409] to-[#8e0206] text-xl text-[#edeaf0] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5363d]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#edeaf0]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แล้วเลือกประเภทหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่าย ยอดเดิมพัน สถานะรายการ ผลรางวัล และประวัติรายการจากบัญชีเดียวได้ทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#edeaf0]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4b0205] bg-[#0d0407]/95 py-3 pr-4 pl-12 text-[#edeaf0] transition-all outline-none placeholder:text-[#edeaf0]/55 focus:border-[#dc0409] focus:ring-1 focus:ring-[#f5363d]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#edeaf0]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4b0205] bg-[#0d0407]/95 py-3 pr-4 pl-12 text-[#edeaf0] transition-all outline-none placeholder:text-[#edeaf0]/55 focus:border-[#dc0409] focus:ring-1 focus:ring-[#f5363d]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#edeaf0]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4b0205] bg-[#0d0407] accent-[#dc0409]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#edeaf0]/75 transition-colors hover:text-[#f5363d]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border-2 border-[#dc0409]/60 bg-transparent p-3.5 text-center font-black text-[#f5363d] transition-all hover:scale-[1.02] hover:border-[#f5363d] hover:bg-[#dc0409]/12">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#edeaf0]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#4b0205]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#4b0205]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#4b0205] bg-[#0d0407] px-2.5 py-1 text-[10px] font-bold text-[#edeaf0]"><span aria-hidden="true">🎟️</span> เลข 2 ตัว และเลข 3 ตัว</span>
            <span class="rounded-full border border-[#c3c7d1]/40 bg-[#0d0407]/85 px-2.5 py-1 text-[10px] font-bold text-[#c3c7d1]"><span aria-hidden="true">📱</span> ส่งโพยผ่านมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#dc0409] transition-colors hover:text-[#f5363d]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c3c7d1]/35 bg-[#17080c]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#edeaf0]/75">
