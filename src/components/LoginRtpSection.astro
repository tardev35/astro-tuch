---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อนเป็น
// "ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้" ซึ่งเป็น **เว็บสล็อตล้วน** ส่วนรอบนี้เป็น
// **เว็บเล่นเกมกีฬาออนไลน์** ที่พูดถึงทางเข้าเดิมพันฟุตบอล มวย และเกมคาสิโน
// (เกมไพ่ เกมโต๊ะ สล็อตจากค่ายต่างๆ) ในแพลตฟอร์มเดียว ข้อมูลคู่แข่งขัน ประเภทการ
// เดิมพันกับอัตราต่อรอง กติกา อัตราจ่าย และเงื่อนไขการตัดสินผล โปรโมชั่นสองรายการ
// (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%) ระบบฝากถอนที่ไม่มีขั้นต่ำ และแอดมิน
// 24 ชั่วโมงเท่านั้น แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบน
// ประโยคเดิม — บรีฟรอบนี้ **ไม่มี** เรื่องสล็อตคลาสสิก ฟรีสปิน โบนัสตัวคูณ
// ตารางจ่ายของวงล้อ อัตราการคืนเงินผู้เล่น หรือการสมัคร 3 ขั้นตอนเลยสักบรรทัด
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §7 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เว็บเล่นเกมกีฬาออนไลน์ · ทางเข้าเดิมพัน · ฐานเกมแท้ · จ่ายตรง · ไม่บิทยูส /
// ไม่บิดยูส · ไม่มีขั้นต่ำ · ไม่ผ่าน บช. ม้า / บัญชีม้า · ฟุตบอล · มวย ·
// เกมคาสิโน · เกมไพ่ · เกมโต๊ะ · สล็อต · ค่ายต่างๆ · คู่แข่งขัน ·
// ประเภทการเดิมพัน · อัตราต่อรอง · กติกา · อัตราจ่าย · เงื่อนไขการตัดสินผล ·
// หมายเลขรายการ · เว็บตรงในตำนาน · คืนยอดเสีย 0.3% · เข้ายูสทุกวัน · รอบคำนวณ ·
// เวลาตัดรอบ · ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน · โบนัส 0.8% · ไม่จำกัด · ลิงก์แนะนำ ·
// ฝากถอน · ช่องทางชำระเงิน · สถานะรายการ · ชื่อบัญชีผู้รับเงิน ·
// ระยะเวลาดำเนินการ · แอดมิน 24 ชั่วโมง · ช่องทางติดต่อหลัก · PIN · OTP
// ⚠️ "ไม่มีขั้นต่ำ" "ไม่ผ่าน บช. ม้า" และ "เว็บตรงในตำนาน" เป็นคำของบรีฟรอบนี้เอง
// (content.txt บรรทัด 2, 8, 14, 16) จึง ship ตามตัว แม้เคยอยู่ใน ban list ของแบรนด์
// ก่อน — ข้อห้ามครอบคลุมคำที่แต่งขึ้น ไม่ใช่คำที่บรีฟให้มา และบรีฟเองก็กำกับคำพวกนี้
// ไว้ทันทีในย่อหน้าเดียวกัน (บรรทัด 16) คำกำกับนั้น ship ไปด้วย ไม่ใช่ตัดออกเพราะ
// ฟังดูไม่ขายของ
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §7 (ฟาสล็อตเว็บตรง · เล่นสล็อตระบบแท้ ·
// Login ใช้งานง่าย · สมัคร 3 ขั้นตอน · แตกง่ายทุกเกม · ผลการหมุนเป็นแบบสุ่ม ·
// สล็อตคลาสสิก · ฟรีสปิน · โบนัสตัวคูณ · เว็บสล็อตนาซ่า · สล็อตพีจีเว็บเป็ด ·
// เว็บเป็ด · คลับคนเล่นสล็อตซุปเปอร์ · ส่งตรงจากเมกา · ส่งตรงจากอเมริกา ·
// ฐานเกมหลัก 100% · เครือหลัก · ไม่ผ่านเว็บเอเย่นต์ · ไม่ผ่านเอเย่นต์ · เบทต่ำ ·
// เดิมพันเริ่มต้น 1 บาท · ทุนน้อยกำไรงาม · ดับเบิ้ลโบนัส · การันตีความน่าเชื่อถือ ·
// การันตีเว็บแท้ · จ่ายไว · ค่ายตรง · ส่งตรงจากเว็บแม่ · เว็บตรงฐานสล็อตหลัก ·
// ฐานเว็บสล็อตหลัก · รีวิวถอนจริง · ถูกลิขสิทธิ์ · ไฮคลาส · VIP) — ไม่เหลือแม้คำเดียว
// และรอบนี้ไม่มีคำว่า หวย โพย เลขเด็ด งวด แนวทาง หรือ ตรวจหวย ที่ไหนบนเว็บเลย
// (/ตรวจหวย กับ /แนวทาง ยังจอดอยู่ใน src/pages-disabled/ ตาม brand-spec §6)
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้เอ่ยถึงค่า RTP เลยแม้แต่คำเดียว §7 จึงห้ามอ้างตัวเลข RTP ที่นี่
// แผงขวาเป็น "หมวดเดิมพันและโปรโมชั่นที่รวบรวมไว้" ไม่ใช่ตารางค่าของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ใบอนุญาต · หน่วยงานกำกับ · ชื่อผู้ให้บริการ ·
// ชื่อค่ายเกม · ชื่อธนาคาร · ชื่อลีก/ทีม/นักมวย · ยอดฝากถอนขั้นต่ำเป็นตัวเลข ·
// ค่า RTP · จำนวนสมาชิก · ปีก่อตั้ง · วันหมดเขตแคมเปญ — บรีฟไม่ได้ให้ไว้สักอย่าง
// ตัวเลขที่ใช้ได้มีสามตัว: 0.3% · 0.8% · 24 ชั่วโมง
