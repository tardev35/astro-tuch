---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสดแบบ VIP" ตารางฝั่งขวา
// จึงเป็นรายการเมนู/หมวดเกมกับสิทธิ์ที่ brief ระบุไว้เอง ไม่ใช่ตารางบาคาร่า/หวย/
// ไฮโล/บอลอย่างรอบ ABM96 (brief รอบนี้ไม่ได้พูดถึงหวยหรือบอลเลย) ทุกแถวอ้างจาก
// ประโยคของ brief ล้วนๆ — เว็บรวมเกมออนไลน์ที่เน้นทางเข้าเล่นรูปแบบ VIP สำหรับ
// ยูสไทย, ปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม, รองรับทั้งมือถือและ
// คอมพิวเตอร์, เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว, ค้นหาเกมและสลับหมวด
// ได้ง่ายกว่าเดิม, สิทธิ์บางประเภทตรวจสอบและกดรับหลังสมัครได้ตามที่ระบบกำหนด,
// โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย 0.3%, สมัครเองได้ใน 3 ขั้นตอน และ
// สอบถามแอดมินได้ตลอด 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย จำนวนเกม ค่า RTP
// อัตราจ่าย ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
const catalogue = [
  {
    icon: "🎥",
    name: "เกมสด",
    detail: "เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว ไม่ต้องสลับไปเปิดหลายระบบ",
    rate: "บัญชีเดียว",
  },
  {
    icon: "👑",
    name: "ทางเข้าเล่นรูปแบบ VIP",
    detail: "ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย จัดองค์ประกอบการใช้งานให้เป็นระเบียบ",
    rate: "รูปแบบ VIP",
  },
  {
    icon: "🧭",
    name: "เมนูเกมและระบบสมาชิกใหม่",
    detail: "หน้าหลัก เมนูเกม และระบบสมาชิกถูกปรับให้ทันสมัยขึ้น ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม",
    rate: "อัปเกรดใหม่",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "หลังยืนยันบัญชีเรียบร้อยแล้วเข้าสู่ระบบ เลือกสล็อตหรือหมวดที่ต้องการได้ทันที",
    rate: "เลือกได้ทันที",
  },
  {
    icon: "📱",
    name: "รองรับมือถือและคอมพิวเตอร์",
    detail: "รองรับทั้งมือถือและคอมพิวเตอร์ ยูสไทยที่เข้าถึงเกมผ่านมือถือใช้งานได้อย่างคล่องตัว",
    rate: "ทุกอุปกรณ์",
  },
  {
    icon: "🎁",
    name: "สิทธิ์ที่กดรับหลังสมัครได้",
    detail: "สิทธิ์บางประเภทสามารถตรวจสอบและกดรับหลังสมัครได้ตามที่ระบบกำหนด ควรอ่านเงื่อนไขของแต่ละรายการก่อน",
    rate: "ตามเงื่อนไข",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น ตรวจสอบยอดที่เข้าเกณฑ์และรอบรับสิทธิ์ผ่านบัญชีสมาชิกได้",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้",
    rate: "0.3%",
  },
  {
    icon: "📝",
    name: "สมัครเองได้ใน 3 ขั้นตอน",
    detail: "กรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจสอบรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน แล้วเข้าสู่ระบบเลือกเกมที่ต้องการได้ทันที",
    rate: "3 ขั้นตอน",
  },
  {
    icon: "💬",
    name: "สอบถามแอดมินคาสิโน",
    detail: "ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทีมงานช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง",
    rate: "24 ชั่วโมง",
  },
];

const chips = [
  "เว็บเล่นพนันอันดับ1ในไทย",
  "เกมสดแบบ VIP",
  "ทางเข้าเล่นใหม่",
  "เมนูเกมอัปเกรด",
  "สล็อต",
  "บัญชีเดียวครบ",
  "มือถือและคอมพิวเตอร์",
  "สำหรับยูสไทย",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัคร 3 ขั้นตอน",
  "แอดมิน 24 ชั่วโมง",
];

// WY88 palette (ชมพูมาเจนตา-ทอง): ทั้งสองแผงวางบนพื้นการ์ดพลัม #24081a เหนือ
// พื้นเพจ #170411 แผงล็อกอินอยู่ในกรอบมาเจนตาหลัก #ec2b84 ส่วนแผงรายการอยู่ใน
// กรอบมาเจนตาเข้ม #a3145a — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไป
// ที่พื้นเพจในเส้นมาเจนตาเข้ม ตัวเน้นที่เป็นตัวเลขรับทองโลโก้ #e8b33a ตามเลข 88
// บนโลโก้ ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการและเงื่อนไขที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการเมนูเกมสด สล็อต ทางเข้ารูปแบบ VIP พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ec2b84]/40 bg-[#24081a]/94 p-6 shadow-[0_10px_30px_rgba(23,4,17,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ec2b84]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ec2b84]/70 bg-gradient-to-br from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f9a8cd]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#fce9f3]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิมทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fce9f3]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a3145a] bg-[#170411]/95 py-3 pr-4 pl-12 text-[#fce9f3] transition-all outline-none placeholder:text-[#fce9f3]/50 focus:border-[#ec2b84] focus:ring-1 focus:ring-[#f9a8cd]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fce9f3]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#a3145a] bg-[#170411]/95 py-3 pr-4 pl-12 text-[#fce9f3] transition-all outline-none placeholder:text-[#fce9f3]/50 focus:border-[#ec2b84] focus:ring-1 focus:ring-[#f9a8cd]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#fce9f3]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a3145a] bg-[#170411] accent-[#ec2b84]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#fce9f3]/70 transition-colors hover:text-[#f9a8cd]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f9a8cd]/70 bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] p-3.5 text-center font-black text-[#170411] shadow-[0_10px_30px_rgba(236,43,132,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(249,168,205,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#fce9f3]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#a3145a]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#a3145a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a3145a] bg-[#170411] px-2.5 py-1 text-[10px] font-bold text-[#fce9f3]"><span aria-hidden="true">🎥</span> เกมสดในบัญชีเดียว</span>
            <span class="rounded-full border border-[#e8b33a]/50 bg-[#170411]/85 px-2.5 py-1 text-[10px] font-bold text-[#e8b33a]"><span aria-hidden="true">👑</span> ทางเข้ารูปแบบ VIP</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f9a8cd] transition-colors hover:text-[#ec2b84]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a3145a]/55 bg-[#24081a]/94 p-5 shadow-[0_10px_30px_rgba(23,4,17,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#fce9f3]/70">เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสดแบบ VIP จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#a3145a] bg-[#170411]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8b33a] shadow-[0_0_8px_rgba(232,179,58,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f9a8cd] uppercase">อัปเกรดใหม่</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#fce9f3]/70 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#a3145a] bg-[#170411]/95 px-3.5 py-2.5 transition-colors hover:border-[#ec2b84]/70 hover:bg-[#24081a]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fce9f3]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e8b33a]/45 bg-[#170411] px-2.5 py-0.5 text-[10px] font-bold text-[#e8b33a]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#fce9f3]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a3145a] bg-[#170411] px-3 py-1 text-[10px] font-bold text-[#fce9f3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#fce9f3]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งทางเข้าเล่นรูปแบบ VIP การปรับหน้าระบบและเมนูให้ใช้งานสะดวกกว่าเดิม การเลือกเกมสดและหมวดเกมจากบัญชีเดียว โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        ส่วนรายการเกม รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
