---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บสล็อต "เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง การันตีระบบAPI100%
// ส่งตรงจากบริษัทแม่" ตารางฝั่งขวาจึงเป็นรายการเกมกับเงื่อนไขของ brief เอง ไม่ใช่
// ตารางตลาดหวยกับอัตราจ่ายอย่างรอบก่อน (ซึ่งนอกเรื่องสำหรับแบรนด์สล็อต) ทุกแถว
// อ้างจากประโยคของ brief ล้วนๆ — ระบบ API เชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุ,
// เปิดเกมและสลับค่ายจากหน้าเดียว, เกมยอดนิยม/เกมใหม่/เกมโบนัส/สล็อตหลายรูปแบบ,
// เมนูจัดหมวดหมู่ชัดเจนใช้ได้ทั้งมือถือและคอมพิวเตอร์, บัญชีเดียวไม่ต้องสลับเว็บ,
// โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย 0.3%, เดิมพันเริ่มต้นตามเงื่อนไขของแต่ละ
// เกม, สมัครเองได้ใน 3 ขั้นตอน และแอดมินออนไลน์ 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย
// จำนวนเกม ค่า RTP ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
const catalogue = [
  {
    icon: "🔗",
    name: "ระบบ API ส่งตรงจากบริษัทแม่",
    detail: "เชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุ พร้อมรูปแบบการเชื่อมต่อจากระบบบริษัทแม่เพื่อให้สมาชิกเข้าถึงรายการเกมได้สะดวก",
    rate: "API 100%",
  },
  {
    icon: "🔀",
    name: "เปิดเกมและสลับค่ายจากหน้าเดียว",
    detail: "การเปิดเกมและสลับค่ายทำได้จากหน้าเดียว ก่อนเข้าเล่นตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้จากหน้าระบบ",
    rate: "หน้าเดียวจบ",
  },
  {
    icon: "🔥",
    name: "เกมยอดนิยม",
    detail: "หมวดเกมยอดนิยมที่แยกไว้ชัดเจน เปิดดูรายละเอียดของแต่ละเกมก่อนเลือกเล่นได้จากหน้ารวมเกม",
    rate: "เกมแท้ค่ายดัง",
  },
  {
    icon: "✨",
    name: "เกมใหม่",
    detail: "รายการเกมอาจมีการอัปเดตตามช่วงเวลา สามารถตรวจสอบค่ายและเกมที่เปิดให้ใช้งานได้จากหน้ารวมเกม",
    rate: "อัปเดตตามช่วงเวลา",
  },
  {
    icon: "🎁",
    name: "เกมโบนัส",
    detail: "รวมเกมโบนัสจากหลายค่ายไว้ในระบบเดียว ดูรายละเอียดของรอบโบนัสได้จากหน้าเกมโดยตรง",
    rate: "หลายค่าย",
  },
  {
    icon: "🎰",
    name: "สล็อตหลายรูปแบบ",
    detail: "มีสล็อตหลายรูปแบบให้เลือกตามสไตล์ที่ต้องการ เมนูจัดหมวดหมู่ชัดเจน ใช้งานได้ทั้งมือถือและคอมพิวเตอร์",
    rate: "เลือกตามสไตล์",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น ตรวจสอบยอดที่เข้าเกณฑ์ผ่านบัญชีสมาชิกได้โดยตรง",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ตรวจสอบรอบคำนวณและรายละเอียดของยอดที่เข้าเกณฑ์ก่อนกดรับได้",
    rate: "0.3%",
  },
  {
    icon: "🪙",
    name: "เดิมพันเริ่มต้นของแต่ละเกม",
    detail: "เกมสล็อตหลายรายการรองรับการเดิมพันเริ่มต้นในระดับต่างกันตามที่แต่ละค่ายกำหนด ตรวจสอบขั้นต่ำได้จากหน้าเกมโดยตรง",
    rate: "ดูก่อนเล่น",
  },
  {
    icon: "📝",
    name: "สมัครเองได้ใน 3 ขั้นตอน",
    detail: "กรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้อง แล้วยืนยันการสมัครและเข้าสู่ระบบได้ทันที",
    rate: "3 ขั้นตอน",
  },
  {
    icon: "💬",
    name: "แอดมินออนไลน์ 24 ชั่วโมง",
    detail: "ติดต่อได้ตลอดทั้งเรื่องการสมัคร การเข้าเกม โปรโมชั่น ระบบเครดิต หรือการใช้งานภายในเว็บไซต์",
    rate: "24 ชม.",
  },
];

const chips = [
  "เกมแท้ค่ายดัง",
  "ระบบAPI100%",
  "ส่งตรงจากบริษัทแม่",
  "เกมยอดนิยม",
  "เกมใหม่",
  "เกมโบนัส",
  "สล็อตหลายรูปแบบ",
  "เมนูจัดหมวดหมู่ชัดเจน",
  "บัญชีเดียวครบ",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "แอดมิน 24 ชั่วโมง",
];

// HENG38 palette (มรกต-ทอง): ทั้งสองแผงวางบนพื้นการ์ด #061f0f เหนือพื้นเพจเขียว
// เกือบดำ #03140a แผงล็อกอินอยู่ในกรอบทองหลัก #f3cf63 ส่วนแผงรายการเกมอยู่ในกรอบ
// ทองบรอนซ์ #a5761a — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นยก
// #0a2d16 ในเส้นมรกตกลาง #0f4423 ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการเกมและเงื่อนไขที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการเกมสล็อตที่เชื่อมต่อผ่านระบบ API พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f3cf63]/40 bg-[#061f0f]/94 p-6 shadow-[0_10px_30px_rgba(3,20,10,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f3cf63]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f3cf63]/70 bg-gradient-to-br from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbeeb0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b6c4ac]">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกเกมสล็อตจากค่ายที่เว็บไซต์ระบุไว้ ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตหลายรูปแบบ เปิดเกมและสลับค่ายได้จากหน้าเดียวผ่านบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b6c4ac]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0f4423] bg-[#03140a]/95 py-3 pr-4 pl-12 text-[#e6e2d2] transition-all outline-none placeholder:text-[#b6c4ac]/70 focus:border-[#f3cf63] focus:ring-1 focus:ring-[#fbeeb0]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b6c4ac]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0f4423] bg-[#03140a]/95 py-3 pr-4 pl-12 text-[#e6e2d2] transition-all outline-none placeholder:text-[#b6c4ac]/70 focus:border-[#f3cf63] focus:ring-1 focus:ring-[#fbeeb0]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#b6c4ac]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0f4423] bg-[#03140a] accent-[#f3cf63]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#b6c4ac] transition-colors hover:text-[#fbeeb0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fbeeb0]/70 bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] p-3.5 text-center font-black text-[#03140a] shadow-[0_10px_30px_rgba(243,207,99,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(251,238,176,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b6c4ac]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f4423]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#0f4423]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0f4423] bg-[#03140a] px-2.5 py-1 text-[10px] font-bold text-[#e6e2d2]"><span aria-hidden="true">🎰</span> ครบทุกเกมฮิต</span>
            <span class="rounded-full border border-[#f3cf63]/50 bg-[#03140a]/85 px-2.5 py-1 text-[10px] font-bold text-[#fbeeb0]"><span aria-hidden="true">💯</span> ระบบAPI100%</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fbeeb0] transition-colors hover:text-[#f3cf63]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a5761a]/55 bg-[#061f0f]/94 p-5 shadow-[0_10px_30px_rgba(3,20,10,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#b6c4ac]">เว็บรวมสล็อตใหญ่ ครบทุกเกมฮิต</span>
          <div class="bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#1faa4e] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#0f4423] bg-[#03140a]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f3cf63] shadow-[0_0_8px_rgba(243,207,99,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fbeeb0] uppercase">API 100%</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b6c4ac] uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#0f4423] bg-[#0a2d16]/95 px-3.5 py-2.5 transition-colors hover:border-[#f3cf63]/70 hover:bg-[#061f0f]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e6e2d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fbeeb0]/45 bg-[#03140a] px-2.5 py-0.5 text-[10px] font-bold text-[#fbeeb0]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b6c4ac]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0f4423] bg-[#03140a] px-3 py-1 text-[10px] font-bold text-[#e6e2d2]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b6c4ac]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการเชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุผ่านระบบบริษัทแม่ โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        ส่วนรายการเกม รอบคำนวณ ขั้นต่ำของแต่ละเกม และเงื่อนไขของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
