---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// SUPERMAX168 is a คาสิโนเว็บตรง brand, so every row below stays inside what the
// brief states: บาคาร่า สล็อต บอล หวย และไฮโล รวมไว้ในบัญชีเดียว, การเข้าใช้งาน
// ผ่านมือถือและคอมพิวเตอร์ตลอด 24 ชั่วโมง, การ Login แล้วเลือกเกมผ่านบัญชีเดียว
// พร้อมตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันก่อนทำรายการ, โบนัสแนะนำเพื่อน 0.8%
// และคืนยอดเสีย 0.3% พร้อมรอบคำนวณ ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับโบนัส, ระบบ
// ฝากถอนที่รองรับวอลเลทและบัญชีธนาคารตามช่องทางที่เว็บไซต์เปิดรองรับ, และแอดมินที่
// ดูแลออนไลน์ตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed payout — the brief states none of
// them and says คำว่า "เว็บตรง 100%" หรือ "ทางเข้าแท้" ต้องมีข้อมูลที่ตรวจสอบได้
// บนเว็บไซต์รองรับ.
const menus = [
  {
    icon: "🃏",
    name: "บาคาร่าออนไลน์",
    detail: "หมวดเกมไพ่สำหรับผู้ที่ชอบบาคาร่า เลือกโต๊ะที่ต้องการผ่านบัญชีเดียว และตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันก่อนลงเดิมพันทุกครั้ง",
    tag: "เกมไพ่",
  },
  { icon: "🎰", name: "สล็อตออนไลน์จากหลายค่าย", detail: "รวมสล็อตจากหลายค่ายไว้ให้เลือกตามรูปแบบที่สนใจ สลับเกมและสลับค่ายได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง", tag: "หลายค่าย" },
  { icon: "⚽", name: "เดิมพันฟุตบอลตามรายการแข่งขัน", detail: "เลือกคู่และรูปแบบเดิมพันตามรายการแข่งขันที่ระบบเปิดรับ ควรตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละรายการก่อนทำรายการ", tag: "ตามรายการ" },
  { icon: "🔢", name: "หวยออนไลน์ตามรอบที่เปิดรับ", detail: "แต่ละรอบเปิดรับตามช่วงเวลาที่ระบบกำหนด ก่อนส่งรายการควรดูรอบที่เปิดรับ อัตราจ่าย และวงเงินของประเภทที่เลือกให้ครบถ้วน", tag: "ตามรอบ" },
  { icon: "🎲", name: "ไฮโลในหมวดคาสิโน", detail: "หมวดไฮโลอยู่ในกลุ่มเกมคาสิโน เลือกโต๊ะและรูปแบบเดิมพันได้จากบัญชีเดียวกัน โดยดูกติกาและอัตราจ่ายของโต๊ะนั้นก่อนเริ่ม", tag: "คาสิโนสด" },
  {
    icon: "🎁",
    name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ",
    detail: "เข้าสู่ระบบเพื่อดูโปรโมชั่นที่เปิดให้รับในแต่ละช่วง ทั้งแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% แต่ละรายการมีรอบคำนวณและยอดที่เข้าเกณฑ์ต่างกัน",
    tag: "0.8% · 0.3%",
  },
  {
    icon: "💳",
    name: "ฝากถอนวอลเลทและธนาคาร",
    detail: "ทำรายการฝาก ส่งคำขอถอน และติดตามสถานะผ่านบัญชีสมาชิกได้เอง ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของช่องทางที่เลือก",
    tag: "ทำรายการเอง",
  },
  { icon: "🛟", name: "แอดมินดูแลออนไลน์ 24 ชั่วโมง", detail: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น", tag: "ตลอด 24 ชม." },
];

const chips = ["บาคาร่า", "สล็อต", "บอล", "หวย", "ไฮโล", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ SUPERMAX168" titleright="จุดที่ควรตรวจสอบก่อนเดิมพันและก่อนกดรับโปรโมชั่น" label="เข้าสู่ระบบ SUPERMAX168 และรายการจุดที่ควรตรวจสอบก่อนเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ba8219]/55 bg-[#0d0904]/92 p-6 shadow-[0_10px_30px_rgba(236,201,100,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ecc964]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e3e3e4]/50 bg-gradient-to-br from-[#fff8e2] via-[#e3e3e4] to-[#ba8219] text-xl shadow-inner">
          🎴
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff8e2]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f9e38b]">
            เข้าสู่ระบบ SUPERMAX168 เพื่อเลือกบาคาร่า สล็อต บอล หวย และไฮโล จากบัญชีเดียว ตรวจสอบเครดิต รับโปรโมชั่น และจัดการฝากถอนได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f3e6c8]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#ba8219]/55 bg-[#030201]/95 py-3 pr-4 pl-12 text-[#f3e6c8] transition-all outline-none placeholder:text-[#f3e6c8]/45 focus:border-[#ecc964] focus:ring-1 focus:ring-[#ecc964]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f3e6c8]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#ba8219]/55 bg-[#030201]/95 py-3 pr-4 pl-12 text-[#f3e6c8] transition-all outline-none placeholder:text-[#f3e6c8]/45 focus:border-[#ecc964] focus:ring-1 focus:ring-[#ecc964]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f3e6c8]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#ba8219]/55 bg-[#030201] accent-[#ecc964]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f3e6c8] transition-colors hover:text-[#fff8e2]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ba8219]/60 bg-gradient-to-r from-[#f9e38b] via-[#ecc964] to-[#ba8219] p-3.5 text-center font-black text-[#030201] shadow-[0_10px_30px_rgba(236,201,100,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(249,227,139,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f3e6c8]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#ba8219]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#ba8219]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e3e3e4]/40 bg-[#030201] px-2.5 py-1 text-[10px] font-bold text-[#e3e3e4]"><span aria-hidden="true">🎴</span> ครบทุกหมวดเกม</span>
            <span class="rounded-full border border-[#ba8219]/50 bg-[#030201]/80 px-2.5 py-1 text-[10px] font-bold text-[#f9e38b]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f9e38b] transition-colors hover:text-[#fff8e2]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ba8219]/55 bg-[#0d0904]/92 p-5 shadow-[0_10px_30px_rgba(236,201,100,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f3e6c8]">
            เลือกบาคาร่า สล็อต บอล หวย และไฮโล ได้จากบัญชีเดียว และตรวจสอบกติกา อัตราจ่าย และวงเงินเดิมพันของเกมนั้นก่อนทำรายการทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#f9e38b] via-[#e3e3e4] to-[#ecc964] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกรูปแบบการเดิมพัน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e3e3e4]/45 bg-[#1b140b]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e3e3e4] shadow-[0_0_8px_rgba(227,227,228,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e3e3e4] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f3e6c8]/60 uppercase">
        <span>หมวดเกม โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#ba8219]/70 bg-[#030201]/95 px-3.5 py-2.5 transition-colors hover:border-[#e3e3e4]/45 hover:bg-[#1b140b]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e6c8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e3e3e4]/40 bg-[#030201] px-2.5 py-0.5 text-[10px] font-bold text-[#e3e3e4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f3e6c8]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ba8219]/45 bg-[#030201] px-3 py-1 text-[10px] font-bold text-[#f9e38b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f3e6c8]/60">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเดิมพัน แต่ละหมวดเกมและแต่ละรายการอาจกำหนดกติกา อัตราจ่าย และวงเงินไม่เท่ากัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ส่วนรอบคำนวณ
        ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับโบนัสของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
