---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// BRAZIL999 เป็นคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรงตามข้อมูลของเว็บไซต์ แผงฝั่งขวาจึงมี
// แค่สองกลุ่มที่บรีฟระบุไว้จริง คือ สามสิ่งที่บรีฟบอกว่าตรวจสอบได้ก่อนเริ่มเล่น (รายละเอียดเกม
// โปรโมชั่น และข้อมูลการใช้งาน) กับสี่เรื่องที่บรีฟบอกว่าจัดการผ่านบัญชีส่วนตัว (ขั้นตอนเข้าสู่
// ระบบ การจัดการรายการ การยึดช่องทางอย่างเป็นทางการก่อนทำรายการ และการเข้าถึงเมนูได้ทั้ง
// บนมือถือและคอมพิวเตอร์)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกม ชื่อเกม ประเภทเกม ค่า RTP ความผันผวน ขั้นต่ำการเดิมพัน ช่องทาง
// ฝากถอน ชื่อธนาคาร หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่
// บรีฟให้คือโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้าแล้ว การเติม
// ชื่อค่ายหรือรายชื่อเกมลงตารางนี้คือการแต่งข้อมูลขึ้นมา
//
// คำศัพท์ตามบรีฟรอบนี้คือ "ช่องทางไลน์" ไม่ใช่ "ไลน์แอด" (คำของ MIRACLE55) และไม่ใช่
// "LINE OFFICIAL" (คำของ KINGDOM66) และไม่มีคำว่า หวย บอล บาคาร่า สล็อต หรือเครดิตฟรี
// อยู่ในบรีฟเลย
const checkBeforePlay = [
  {
    icon: "🎮",
    name: "รายละเอียดเกม",
    detail: "เปิดดูรายละเอียดของเกมแต่ละรายการได้ก่อนเริ่มเล่น ตามข้อมูลที่เว็บไซต์ระบุไว้",
    tag: "ดูก่อนเริ่มเล่น",
  },
  {
    icon: "🎁",
    name: "โปรโมชั่น",
    detail: "ตรวจสอบโปรโมชั่นที่อัปเดตตามช่วงเวลา พร้อมยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์ของแต่ละรายการ",
    tag: "อัปเดตตามช่วงเวลา",
  },
  {
    icon: "🧾",
    name: "ข้อมูลการใช้งาน",
    detail: "ดูข้อมูลการใช้งานของระบบได้ก่อนเริ่มเล่น ช่วยให้เข้าถึงแต่ละเมนูได้ง่ายขึ้น",
    tag: "อ่านได้ก่อนสมัคร",
  },
];

const accountChecks = [
  {
    icon: "🔑",
    name: "ขั้นตอนเข้าสู่ระบบ",
    detail: "เข้าสู่ระบบผ่านบัญชีส่วนตัวตามขั้นตอนที่เว็บไซต์กำหนด ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    tag: "บัญชีส่วนตัว",
  },
  {
    icon: "📋",
    name: "จัดการรายการ",
    detail: "จัดการรายการต่างๆ ผ่านบัญชีส่วนตัวได้จากระบบเดียว ตามที่เว็บไซต์จัดไว้ให้",
    tag: "จบจากบัญชีเดียว",
  },
  {
    icon: "🛡️",
    name: "ช่องทางอย่างเป็นทางการ",
    detail: "ตรวจสอบข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการของเว็บไซต์ก่อนทำรายการทุกครั้ง",
    tag: "ลดความเสี่ยง",
  },
  {
    icon: "📱",
    name: "มือถือและคอมพิวเตอร์",
    detail: "เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ ใช้บัญชีเดียวกันได้ทั้งสองอุปกรณ์",
    tag: "ใช้ได้ทั้งสองจอ",
  },
];

const chips = [
  "คาสิโนแท้จากบริษัทโดยตรง",
  "ไม่มีประวัติโกง ตรวจสอบได้",
  "รวมเกมหลายประเภทในบัญชีเดียว",
  "ตรวจสอบก่อนเริ่มเล่น",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัครเอง 3 ขั้นตอน",
  "ช่องทางไลน์ 24 ชั่วโมง",
];

// BRAZIL999 (รอบเขียว-โครเมียม-ดำ 2026-09-25): โลโก้เป็นเวิร์ดมาร์กสองวัสดุ BRAZIL เป็น
// โครเมียมขัดเงา 999 เป็นเขียวสด สองแผงจึงถูกแยกด้วยวัสดุคนละชนิด ไม่ใช่แค่ความสว่างของ
// กรอบ — แผงล็อกอินอยู่ในกรอบเขียวแบรนด์ #22c55e ส่วนแผงตรวจสอบอยู่ในกรอบโครเมียม
// #aab4bf ทั้งคู่วางบนผิวการ์ด #0a1a0c เหนือพื้นเพจดำอมเขียว #040a05 ช่องกรอกและชิปตกลง
// ไปที่พื้นเพจในเส้นผิวการ์ดยก #123a18 บรรทัดเด่นรับไล่เฉดสองวัสดุตามลำดับบนโลโก้ คือ
// โครเมียมสว่าง #f1f5f9 → เขียวสว่าง #b6ff9c → เขียวแบรนด์ #22c55e ปุ่มเข้าสู่ระบบเป็น
// เขียวเต็มตัว (#7cf25c → #22c55e → #0a6b18) บนตัวอักษร #040a05 ตามกฎคอนทราสต์ที่ว่า
// ตัวอักษรบนพื้นสว่างต้องเกือบดำ ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์มซึ่งเป็นคนละสีกับ
// เขียวแบรนด์และห้ามรีแมป — ชุดทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b #8c5f14
// #d9a62b #fcfcfc #d2d3d4 #a8acb1 #14100a #2c241c #0d0a06 #050403 #e8e6e1) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`สิ่งที่ ${BRAND_NAME} ให้ตรวจสอบได้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีส่วนตัว พร้อมรายการสิ่งที่เว็บไซต์เปิดให้ตรวจสอบก่อนเริ่มเล่น ทั้งรายละเอียดเกม โปรโมชั่น ข้อมูลการใช้งาน และการจัดการรายการผ่านช่องทางอย่างเป็นทางการ`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#22c55e]/45 bg-[#0a1a0c]/94 p-6 shadow-[0_10px_30px_rgba(4,10,5,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#22c55e]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22c55e]/70 bg-gradient-to-br from-[#7cf25c] via-[#22c55e] to-[#0a6b18] text-xl text-[#040a05] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f4fbf2]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#dfeadd]/75">
            เข้าสู่ระบบ {BRAND_NAME} ผ่านบัญชีส่วนตัวเพื่อเลือกเกมจากบัญชีเดียว พร้อมตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dfeadd]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#123a18] bg-[#040a05]/95 py-3 pr-4 pl-12 text-[#dfeadd] transition-all outline-none placeholder:text-[#dfeadd]/50 focus:border-[#22c55e] focus:ring-1 focus:ring-[#7cf25c]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dfeadd]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#123a18] bg-[#040a05]/95 py-3 pr-4 pl-12 text-[#dfeadd] transition-all outline-none placeholder:text-[#dfeadd]/50 focus:border-[#22c55e] focus:ring-1 focus:ring-[#7cf25c]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dfeadd]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#123a18] bg-[#040a05] accent-[#22c55e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dfeadd]/75 transition-colors hover:text-[#7cf25c]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7cf25c]/70 bg-gradient-to-r from-[#7cf25c] via-[#22c55e] to-[#0a6b18] p-3.5 text-center font-black text-[#040a05] shadow-[0_10px_30px_rgba(34,197,94,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(124,242,92,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dfeadd]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#123a18]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#123a18]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#123a18] bg-[#040a05] px-2.5 py-1 text-[10px] font-bold text-[#dfeadd]"><span aria-hidden="true">🏢</span> บริษัทโดยตรง</span>
            <span class="rounded-full border border-[#aab4bf]/40 bg-[#040a05]/85 px-2.5 py-1 text-[10px] font-bold text-[#aab4bf]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#aab4bf] transition-colors hover:text-[#f1f5f9]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#aab4bf]/40 bg-[#0a1a0c]/94 p-5 shadow-[0_10px_30px_rgba(4,10,5,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dfeadd]/75">
            ผู้ใช้งานสามารถตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานก่อนเริ่มเล่น แล้วจัดการรายการผ่านบัญชีส่วนตัวจากระบบเดียว
          </span>
          <div class="bg-gradient-to-r from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">ตรวจสอบได้ · บริษัทโดยตรง · บัญชีเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#123a18] bg-[#040a05]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#aab4bf] shadow-[0_0_8px_rgba(170,180,191,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#aab4bf] uppercase">ไม่มีประวัติโกง</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dfeadd]/75 uppercase">
        <span>ตรวจสอบได้ก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          checkBeforePlay.map((c) => (
            <div class="rounded-xl border border-[#1c5a26]/60 bg-[#040a05]/95 px-3.5 py-2.5 transition-colors hover:border-[#22c55e]/70 hover:bg-[#123a18]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4fbf2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#22c55e]/60 bg-gradient-to-r from-[#22c55e] to-[#0a6b18] px-2.5 py-0.5 text-[10px] font-black text-[#040a05]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#dfeadd]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dfeadd]/75 uppercase">
        <span>จัดการผ่านบัญชีส่วนตัว</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          accountChecks.map((k) => (
            <div class="rounded-xl border border-[#123a18] bg-[#040a05]/95 px-3.5 py-2.5 transition-colors hover:border-[#aab4bf]/70 hover:bg-[#123a18]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dfeadd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#aab4bf]/50 bg-[#040a05] px-2.5 py-0.5 text-[10px] font-bold text-[#aab4bf]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#dfeadd]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#123a18] bg-[#040a05] px-3 py-1 text-[10px] font-bold text-[#dfeadd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dfeadd]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งระบบคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรงตามข้อมูลของเว็บไซต์ การรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว การเปิดให้ตรวจสอบรายละเอียดเกม โปรโมชั่น
        และข้อมูลการใช้งานก่อนเริ่มเล่น และการเข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ ส่วนเงื่อนไขของแต่ละรายการอาจแตกต่างกันตามที่ระบบกำหนด ให้ยึดข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการของเว็บไซต์
        ก่อนทำรายการทุกครั้ง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
