---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "เว็บรวมเกมคาสิโนที่มีทั้งบาคาร่า รูเล็ต และเกมโต๊ะยอดนิยมจาก
// หลายค่ายให้เลือกในระบบเดียว" ตารางฝั่งขวาจึงเป็นหมวดเกมกับรายการที่ brief ระบุไว้
// เอง ทุกแถวอ้างจากประโยคของ brief ล้วนๆ — บาคาร่า รูเล็ต คาสิโนสด และเกมเดิมพัน
// ประเภทอื่นตามรายการที่เปิดให้บริการ, ค่ายมาตรฐานสากลปี 2026, เมนูจัดหมวดหมู่
// ชัดเจนค้นหาเกมง่าย, ตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม, รองรับ
// มือถือและคอมพิวเตอร์, โปรโมชั่นบางรายการกดรับหลังสมัครได้โดยไม่ต้องฝากก่อน,
// โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย 0.3%, สมัครผ่านมือถือ 3 ขั้นตอน และแอดมิน
// ดูแลตลอด 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย จำนวนเกม ค่า RTP อัตราจ่าย ใบอนุญาต
// หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้ และไม่มีหมวดลอตเตอรี่หรือกีฬาที่
// ไหนเลย เพราะ brief ของ SAGAME66 ไม่ได้พูดถึงมัน
const catalogue = [
  {
    icon: "🃏",
    name: "บาคาร่า",
    detail: "เลือกโต๊ะบาคาร่าจากหลายค่ายได้ในระบบเดียว ตรวจสอบชื่อค่ายและรายละเอียดเกมได้ก่อนเข้าเล่น",
    rate: "หลายค่าย",
  },
  {
    icon: "🎡",
    name: "รูเล็ต",
    detail: "อยู่ในหน้ารวมเกมเดียวกับบาคาร่า เมนูจัดหมวดหมู่ชัดเจนจึงค้นหาโต๊ะที่ต้องการได้ง่าย",
    rate: "ค้นหาง่าย",
  },
  {
    icon: "🎥",
    name: "คาสิโนสด",
    detail: "รวมอยู่ในระบบเดียวกับบาคาร่าและรูเล็ต เข้าใช้งานจากบัญชีเดิมได้ตามรายการที่เปิดให้บริการ",
    rate: "ระบบเดียว",
  },
  {
    icon: "🎲",
    name: "เกมเดิมพันประเภทอื่น",
    detail: "เกมโต๊ะยอดนิยมและเกมประเภทอื่นตามรายการที่เปิดให้บริการ ตรวจสอบได้จากหน้ารวมเกมก่อนเลือกเข้าเล่น",
    rate: "ตามรายการที่เปิด",
  },
  {
    icon: "🏷️",
    name: "ค่ายมาตรฐานสากล 2026",
    detail: "รวมเกมเดิมพันจากหลายค่ายที่มีรูปแบบการเล่นแตกต่างกันภายในปี 2026 ตรวจสอบชื่อค่ายได้ก่อนเข้าเล่น",
    rate: "หลายรูปแบบ",
  },
  {
    icon: "🎚️",
    name: "ระดับเดิมพันหลายระดับ",
    detail: "มีตัวเลือกการเดิมพันหลายระดับตามเงื่อนไขของแต่ละเกม ดูระดับเดิมพันได้ก่อนเข้าเล่น",
    rate: "ตามเงื่อนไขเกม",
  },
  {
    icon: "📱",
    name: "มือถือและคอมพิวเตอร์",
    detail: "รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ เมนูจัดหมวดหมู่ชัดเจนจึงหาเกมที่ต้องการได้ง่าย",
    rate: "ทั้งสองอุปกรณ์",
  },
  {
    icon: "🎁",
    name: "สิทธิ์ที่กดรับหลังสมัครได้",
    detail: "โปรโมชั่นบางรายการตรวจสอบและกดรับหลังสมัครได้โดยไม่ต้องทำรายการฝากก่อน ควรอ่านเงื่อนไขก่อนกดรับ",
    rate: "ไม่ต้องฝากก่อน",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น ตรวจสอบยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ผ่านบัญชีสมาชิกได้",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับสิทธิ์ได้",
    rate: "0.3%",
  },
];

const chips = [
  "บาคาร่า",
  "รูเล็ต",
  "คาสิโนสด",
  "เกมโต๊ะยอดนิยม",
  "หลายค่ายในระบบเดียว",
  "ค่ายมาตรฐานสากล 2026",
  "เมนูจัดหมวดหมู่ชัดเจน",
  "ระดับเดิมพันหลายระดับ",
  "มือถือและคอมพิวเตอร์",
  "สมัครผ่านมือถือ 3 ขั้นตอน",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "แอดมิน 24 ชั่วโมง",
];

// SAGAME66 palette (ทอง-เงินโครเมียม): ทั้งสองแผงวางบนพื้นการ์ด #171006 เหนือพื้น
// เพจ #0d0903 แผงล็อกอินอยู่ในกรอบทองหลัก #e8b93f ส่วนแผงรายการอยู่ในกรอบทองลึก
// #96671a — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นพื้น
// ยก #2a1d0b ตัวเน้นที่เป็นตัวเลขรับไล่เฉดทอง-เงิน-ทองตามลำดับสีในโลโก้ ปุ่มเข้าสู่
// ระบบเป็นทองเต็มตัว (#ffe9a3 → #e8b93f → #96671a) บนตัวอักษรสีพื้นเพจ เพราะทองคือ
// สีประจำแบรนด์ เงินโครเมียมเป็นสีรอง ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมและรายการที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการหมวดเกมบาคาร่า รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่น พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e8b93f]/40 bg-[#171006]/94 p-6 shadow-[0_10px_30px_rgba(13,9,3,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e8b93f]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8b93f]/70 bg-gradient-to-br from-[#ffe9a3] via-[#e8b93f] to-[#96671a] text-xl shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a3]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e3d8c0]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกบาคาร่า รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่นตามรายการที่เปิดให้บริการ ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e3d8c0]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2a1d0b] bg-[#0d0903]/95 py-3 pr-4 pl-12 text-[#e3d8c0] transition-all outline-none placeholder:text-[#e3d8c0]/50 focus:border-[#e8b93f] focus:ring-1 focus:ring-[#eef3f8]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e3d8c0]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2a1d0b] bg-[#0d0903]/95 py-3 pr-4 pl-12 text-[#e3d8c0] transition-all outline-none placeholder:text-[#e3d8c0]/50 focus:border-[#e8b93f] focus:ring-1 focus:ring-[#eef3f8]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e3d8c0]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2a1d0b] bg-[#0d0903] accent-[#e8b93f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e3d8c0]/70 transition-colors hover:text-[#ffe9a3]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe9a3]/70 bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#96671a] p-3.5 text-center font-black text-[#0d0903] shadow-[0_10px_30px_rgba(232,185,63,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,233,163,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e3d8c0]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a1d0b]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a1d0b]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2a1d0b] bg-[#0d0903] px-2.5 py-1 text-[10px] font-bold text-[#e3d8c0]"><span aria-hidden="true">🃏</span> ครบทุกค่ายในระบบเดียว</span>
            <span class="rounded-full border border-[#eef3f8]/40 bg-[#0d0903]/85 px-2.5 py-1 text-[10px] font-bold text-[#b6c1cd]"><span aria-hidden="true">📱</span> มือถือและคอม</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe9a3] transition-colors hover:text-[#eef3f8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#96671a]/70 bg-[#171006]/94 p-5 shadow-[0_10px_30px_rgba(13,9,3,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e3d8c0]/70">รวมเกมเดิมพันจากหลายค่ายไว้ในระบบเดียว เลือกบาคาร่า รูเล็ต และคาสิโนสดได้จากหน้าเดียว</span>
          <div class="bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#2a1d0b] bg-[#0d0903]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8b93f] shadow-[0_0_8px_rgba(232,185,63,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffe9a3] uppercase">ค่ายมาตรฐานสากล</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e3d8c0]/70 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#2a1d0b] bg-[#0d0903]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8b93f]/70 hover:bg-[#171006]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e3d8c0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#96671a]/55 bg-[#0d0903] px-2.5 py-0.5 text-[10px] font-bold text-[#b6c1cd]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e3d8c0]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2a1d0b] bg-[#0d0903] px-3 py-1 text-[10px] font-bold text-[#e3d8c0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e3d8c0]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมบาคาร่า รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่นจากหลายค่ายไว้ในระบบเดียว การรองรับทั้งมือถือและคอมพิวเตอร์ โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย
        0.3% ส่วนรายการเกม ค่ายที่เปิดให้บริการ ระดับเดิมพัน รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ
        OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
