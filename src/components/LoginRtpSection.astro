// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2-§3):
// โลโก้รอบนี้เป็นเลข 789 ทองขัดเงาสามมิติ ทับคำว่า BETTING สีดำบนแถบขีดขาว แบนเนอร์กับ
// สไลด์เป็นโถงคาสิโนดำ-ทอง เสาร่องทอง โคมระย้า ชิปดำ-ทอง ลูกเต๋าทอง และวงล้อรูเล็ต
// แบรนด์จึงมีฮิวเดียว — ทองเมทัลลิกบนดำสนิท — ไม่ใช่สามสีแบบชุดตรุษจีนของ GUCCI168
// สองแผงถูกแยกด้วย "โลหะสว่าง vs โลหะลึก" ตรงๆ และจงใจให้ตรงกับ ContentBoxTwo ที่ครอบ
// อยู่ ซึ่งให้ป้ายคอลัมน์ซ้ายเป็นทองแชมเปญ #ffe79a กับป้ายไอคอนแผ่นทองทึบ และป้าย
// คอลัมน์ขวาเป็นทองแบรนด์ #fad354 กับป้ายไอคอนแผ่นดำลึก — แผงล็อกอิน (ซ้าย) จึงอยู่ใน
// กรอบทองแบรนด์ #fad354 ส่วนแผงหมวดเดิมพันและสิทธิ์ (ขวา) อยู่ในกรอบบรอนซ์ #c9881f
// ทั้งคู่วางบนผิวยก #17130a ช่องกรอกและชิปตกลงไปที่ผิวลึกสุด #060402 และผิวที่ hover
// ขึ้นมาเป็นผิวกลาง #0e0b05 บรรทัดเด่นไล่ทองแชมเปญ #ffe79a → ทองแบรนด์ #fad354 →
// บรอนซ์ #c9881f
//
// ทองของแบรนด์แยกหน้าที่กันตาม §2: #fad354 ถือขอบ/ไอคอน/จุด · #ffe79a เป็นตัวอักษรเน้น
// และปลายสว่างของไล่เฉด · #ddab33 กับ #8a6410 เป็นปลายเข้ม · #c9881f เป็นบรอนซ์อุ่น ·
// #4a3407 เป็นเส้นไรผม ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นพื้นไล่
// ผิวยก #17130a → ผิวลึกสุด #060402 ขอบทองแบรนด์ หมึกเนื้อความ #f3e7cd — ไม่ใช่ปุ่มหลัก
// พื้นทองทึบ ซึ่งถูกเก็บไว้ให้ปุ่มสมัครสมาชิกใน ContentBoxSpecial บนหน้าแรก ส่วนปุ่มไลน์
// คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบ
// ป้ายสถานะข้างบรรทัดโบนัสรอบนี้เป็นทองแบรนด์ ไม่ใช่จุดเขียว — ข้อความ "ตามแคมเปญที่เปิด
// ในแต่ละช่วง" เป็นป้ายบอกเงื่อนไขของโปรโมชั่น ไม่ใช่ตัวบ่งชี้สถานะ live/success ที่ §2
// ยกเว้นให้คงสีเขียวไว้ได้
// ข้อความรองใช้งาช้างหม่น #b5a888 (8.1:1 บนผิวยก) ไม่ใช่สีเนื้อความแบบลดความทึบ
// เนื้อความ #f3e7cd (= BRAND_TEXT)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f #7a0505
// #0b7a33 #2bbf63 #063f1c #ffdf91 #d9a521 #8c6410 #1d0b08 #140705 #090302 #3d0a09
// #1a0604 #f6e3cf #a8897f rgba(196,17,21,…) rgba(217,165,33,…) rgba(43,191,99,…))
// ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเดิมพันและสิทธิ์ที่ ${BRAND_NAME} รวมไว้`}
  iconleft="🔐"
  iconright="🎴"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหมวดเดิมพันที่ระบบรวมไว้ ทั้งบาคาร่า รูเล็ต บอล หวย สล็อต ตลาดเดิมพัน ช่องทางฝากถอน โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และจุดที่ควรตรวจสอบก่อนยืนยันการเดิมพันทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fad354]/45 bg-[#17130a] p-6 shadow-[0_0_28px_rgba(250,211,84,0.16)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c9881f]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#8a6410] bg-gradient-to-br from-[#ffe79a] via-[#ddab33] to-[#c9881f] text-xl text-[#0a0802] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe79a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b5a888]">
