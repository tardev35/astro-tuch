                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece1cc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d8dbe0]/40 bg-[#120c07] px-2.5 py-0.5 text-[10px] font-bold text-[#d8dbe0]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b7a58a]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6d4412] bg-[#070504] px-3 py-1 text-[10px] font-bold text-[#ece1cc]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b7a58a]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมสล็อตเบทต่ำหลายรูปแบบไว้ในระบบเดียว การเลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนด การตรวจสอบตารางจ่ายและรายละเอียดของแต่ละเกม และการใช้บัญชีเดียวดูเครดิต
        โปรโมชั่น และประวัติรายการ ส่วนโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่โปรโมชั่นกำหนด แต่ละรายการมีเกณฑ์คำนวณและเงื่อนไข แตกต่างกัน จึงควรตรวจสอบรายละเอียดล่าสุดก่อนกดรับโบนัส
        หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
