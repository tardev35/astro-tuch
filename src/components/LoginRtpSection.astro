---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the brief states: เกมสล็อต บาคาร่า คาสิโนสด
// รูเล็ต เสือมังกร เกมไพ่ หวย และการเดิมพันกีฬา, ระบบจัดหมวดหมู่ให้ค้นหาง่าย,
// คืนยอดเสียทุกวัน 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไข, ระบบฝากถอนอัตโนมัติ,
// รองรับสมาร์ตโฟน แท็บเล็ต คอมพิวเตอร์ และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
const menus = [
  { icon: "🎰", name: "เกมสล็อต", detail: "หมวดเกมสล็อตหลายรูปแบบ ตรวจสอบกติกาและอัตราการจ่ายได้จากหน้ารายละเอียดของแต่ละเกม", tag: "เลือกได้หลายเกม" },
  { icon: "🃏", name: "บาคาร่า", detail: "โต๊ะบาคาร่าออนไลน์พร้อมกติกาและรูปแบบการเดิมพันของแต่ละโต๊ะแสดงไว้ในระบบ", tag: "ดูกติกาก่อนลง" },
  { icon: "🎥", name: "คาสิโนสด", detail: "ห้องคาสิโนถ่ายทอดสด เลือกโต๊ะและตรวจสอบเงื่อนไขการเดิมพันได้จากหน้าเกมโดยตรง", tag: "ถ่ายทอดสด" },
  { icon: "🎡", name: "รูเล็ต และเสือมังกร", detail: "หมวดเกมที่จบรอบไว อัตราการจ่ายและตัวเลือกการเดิมพันแยกตามแต่ละโต๊ะ", tag: "จบรอบไว" },
  { icon: "🎫", name: "หวย และเกมไพ่", detail: "ตรวจสอบรอบ อัตราการจ่าย และเงื่อนไขของแต่ละประเภทได้ก่อนเริ่มเดิมพันทุกครั้ง", tag: "ตรวจรอบก่อนแทง" },
  { icon: "⚽", name: "เดิมพันกีฬา", detail: "เลือกคู่แข่งขันและรูปแบบการเดิมพัน โดยเงื่อนไขของแต่ละรายการแสดงไว้ในระบบ", tag: "หลายรายการ" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการได้เองตลอด 24 ชั่วโมง", tag: "จัดการเครดิตเอง" },
  { icon: "🤝", name: "โปรโมชั่นสมาชิก", detail: "ตรวจสอบยอดที่นำมาคำนวณ รอบการรับ และข้อกำหนดการถอนของคืนยอดเสียและแนะนำเพื่อนก่อนกดรับ", tag: "ตามเงื่อนไขแต่ละรายการ" },
];

const chips = ["สล็อต", "บาคาร่า", "คาสิโนสด", "รูเล็ต", "เสือมังกร", "เกมไพ่", "หวย", "กีฬา", "ฝากถอนออโต้", "แอดมิน 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ HENGDEE89"
  titleright="หมวดการเดิมพันและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ HENGDEE89 และหมวดเกมเดิมพันออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a97a08]/55 bg-[#1c0707]/92 p-6 shadow-[0_10px_30px_rgba(211,20,17,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8e0c0a]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fdd32d]/50 bg-gradient-to-br from-[#ffe98a] via-[#fdd32d] to-[#6b4c05] text-xl shadow-inner">
          🧧
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe98a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9a29a]">เข้าสู่ระบบ HENGDEE89 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c9a29a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a97a08] bg-[#0d0303]/95 py-3 pr-4 pl-12 text-[#f7e4dc] transition-all outline-none placeholder:text-[#c9a29a]/70 focus:border-[#fdd32d] focus:ring-1 focus:ring-[#fdd32d]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c9a29a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#a97a08] bg-[#0d0303]/95 py-3 pr-4 pl-12 text-[#f7e4dc] transition-all outline-none placeholder:text-[#c9a29a]/70 focus:border-[#fdd32d] focus:ring-1 focus:ring-[#fdd32d]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f7e4dc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a97a08] bg-[#0d0303] accent-[#fdd32d]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f7e4dc] transition-colors hover:text-[#ffe98a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe98a]/50 bg-gradient-to-r from-[#ffe98a] via-[#fdd32d] to-[#a97a08] p-3.5 text-center font-black text-[#0d0303] shadow-[0_10px_30px_rgba(253,211,45,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,211,45,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9a29a]">
          <span class="h-px flex-1 bg-[#a97a08]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#a97a08]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a97a08]/60 bg-[#0d0303] px-2.5 py-1 text-[10px] font-bold text-[#ffe98a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#fdd32d]/30 bg-[#0d0303]/80 px-2.5 py-1 text-[10px] font-bold text-[#f7e4dc]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe98a] transition-colors hover:text-[#f5322e]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#fdd32d]/25 bg-[#1c0707]/92 p-5 shadow-[0_10px_30px_rgba(253,211,45,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f7e4dc]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#a97a08] via-[#fdd32d] to-[#f5322e] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9a29a] uppercase">
        <span>หมวดเดิมพัน / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#a97a08] bg-[#0d0303]/95 px-3.5 py-2.5 transition-colors hover:border-[#fdd32d]/50 hover:bg-[#2a0b0b]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e4dc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a97a08]/60 bg-[#0d0303] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe98a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f7e4dc]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#fdd32d]/25 bg-[#0d0303] px-3 py-1 text-[10px] font-bold text-[#ffe98a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9a29a]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
