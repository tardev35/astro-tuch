---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// GPSS789 is a คาสิโนตรง brand, so every row below stays inside what the brief
// states: รวมเกมเดิมพันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่าและคาสิโนสด
// แทงบอลตามรายการที่เปิดให้บริการ สล็อตออนไลน์หลายค่าย และหวยออนไลน์ตามรอบที่
// กำหนด, การเลือกหมวดเกมผ่านบัญชีเดียว, การตรวจกติกา อัตราจ่าย และรายละเอียดการ
// เดิมพันก่อนยืนยันรายการ, การรองรับมือถือ แท็บเล็ต และคอมพิวเตอร์, โบนัสแนะนำ
// เพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, ระบบฝากถอนออโต้ที่รองรับธนาคารและ
// วอลเลทตามช่องทางที่เปิดให้บริการ และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state.
const menus = [
  { icon: "🃏", name: "บาคาร่าและคาสิโนสด", detail: "หมวดเกมโต๊ะถ่ายทอดสด ตรวจกติกา อัตราจ่าย และขั้นต่ำของแต่ละโต๊ะให้ครบก่อนยืนยันรายการ", tag: "ดูอัตราจ่าย" },
  { icon: "⚽", name: "แทงบอลตามรายการที่เปิด", detail: "เลือกรายการแข่งขันที่ระบบเปิดให้บริการ แล้วตรวจรูปแบบการเดิมพันและขั้นต่ำของบิลก่อนส่งรายการ", tag: "ตรวจก่อนส่งบิล" },
  { icon: "🎰", name: "สล็อตออนไลน์หลายค่าย", detail: "เลือกค่ายและเกมสล็อตจากหมวดที่ระบบเปิดให้บริการ ดูรายละเอียดเกมและช่วงเดิมพันก่อนเริ่มหมุน", tag: "ดูช่วงเดิมพัน" },
  { icon: "🎫", name: "หวยออนไลน์ตามรอบ", detail: "หวยออนไลน์เปิดตามรอบที่กำหนด ควรตรวจอัตราจ่ายและเวลาปิดรับของแต่ละรอบก่อนส่งโพย", tag: "ตามรอบที่กำหนด" },
  { icon: "🔑", name: "บัญชีเดียวใช้ได้ทุกหมวด", detail: "เข้าสู่ระบบเพื่อเลือกหมวดเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการบัญชีได้จากหน้าเดียว", tag: "บัญชีเดียวครบ" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมีรายการตรงตามข้อกำหนด", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจประเภทเกม รอบคำนวณ และข้อกำหนดของโปรโมชั่นให้เรียบร้อยก่อนกดรับสิทธิ์ในแต่ละรอบ", tag: "ตรวจรอบก่อนกดรับ" },
  { icon: "🏦", name: "ฝากถอนออโต้ทุกช่องทาง", detail: "ฝากเงิน ส่งคำขอถอน และตรวจสถานะรายการผ่านมือถือ ตามธนาคารและวอลเลทที่ระบบเปิดให้บริการ", tag: "ดูสถานะรายการ" },
];

const chips = ["บาคาร่า", "คาสิโนสด", "แทงบอล", "สล็อตออนไลน์", "หวยออนไลน์", "โบนัส 0.8%", "คืนยอดเสีย 0.3%", "ฝากถอนออโต้", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ GPSS789" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเดิมพันกับ GPSS789" label="เข้าสู่ระบบ GPSS789 และตารางจุดที่ควรตรวจสอบก่อนเริ่มเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#d9a441]/40 bg-[#14100a]/92 p-6 shadow-[0_10px_30px_rgba(217,164,65,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d9a441]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d9a441]/60 bg-gradient-to-br from-[#ffeec2] via-[#d9a441] to-[#7a5312] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f2c14e]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8b939c]">เข้าสู่ระบบ GPSS789 เพื่อเลือกหมวดเกม ตรวจสอบโปรโมชั่น ฝากถอน และจัดการบัญชีได้จากหน้าเดียว ผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8b939c]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#d9a441]/45 bg-[#060402]/95 py-3 pr-4 pl-12 text-[#e8dcc4] transition-all outline-none placeholder:text-[#8b939c] focus:border-[#d9a441] focus:ring-1 focus:ring-[#d9a441]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8b939c]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#d9a441]/45 bg-[#060402]/95 py-3 pr-4 pl-12 text-[#e8dcc4] transition-all outline-none placeholder:text-[#8b939c] focus:border-[#d9a441] focus:ring-1 focus:ring-[#d9a441]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8dcc4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#d9a441]/45 bg-[#060402] accent-[#d9a441]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8dcc4] transition-colors hover:text-[#f5d98a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7a5312]/55 bg-gradient-to-r from-[#ffeec2] via-[#d9a441] to-[#7a5312] p-3.5 text-center font-black text-[#0a0704] shadow-[0_10px_30px_rgba(217,164,65,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(217,164,65,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8b939c]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#d9a441]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#d9a441]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c2cad3]/40 bg-[#060402] px-2.5 py-1 text-[10px] font-bold text-[#c2cad3]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#d9a441]/40 bg-[#060402]/80 px-2.5 py-1 text-[10px] font-bold text-[#f2c14e]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f2c14e] transition-colors hover:text-[#f5d98a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d9a441]/40 bg-[#14100a]/92 p-5 shadow-[0_10px_30px_rgba(217,164,65,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8dcc4]">รวมเกมเดิมพันออนไลน์ไว้ในระบบเดียว เลือกหมวดเกมและทำรายการได้จากอุปกรณ์ที่สะดวก</span>
          <div class="bg-gradient-to-r from-[#ffeec2] via-[#d9a441] to-[#7a5312] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8b939c] uppercase">
        <span>หมวดเกม โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#d9a441]/40 bg-[#060402]/95 px-3.5 py-2.5 transition-colors hover:border-[#f2c14e]/60 hover:bg-[#221a0e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8dcc4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d9a441]/45 bg-[#060402] px-2.5 py-0.5 text-[10px] font-bold text-[#f2c14e]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8b939c]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d9a441]/35 bg-[#060402] px-3 py-1 text-[10px] font-bold text-[#f2c14e]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8b939c]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเดิมพัน แต่ละเกมมีรูปแบบและความเสี่ยงแตกต่างกัน กติกา อัตราจ่าย และเงื่อนไขโปรโมชั่นขึ้นอยู่กับรายละเอียดของแต่ละรายการ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
