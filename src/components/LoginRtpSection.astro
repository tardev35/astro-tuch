---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// KINGDOM66 เป็นแบรนด์รวมเกมคาสิโนหลายหมวด ไม่ใช่เว็บหวยล้วน แผงฝั่งขวาจึงเป็นสอง
// กลุ่มที่บรีฟระบุไว้จริงเท่านั้น คือ หกหมวดที่บรีฟเอ่ยชื่อ (บาคาร่า ไพ่ สล็อต หวย
// บอล และคาสิโนไลฟ์สดจากผู้ให้บริการต่างประเทศ) และสามสิ่งที่บรีฟบอกว่าตรวจสอบได้จาก
// หน้าเดียวก่อนเข้าเล่น (รายละเอียดเกม ค่ายที่ให้บริการ รูปแบบเดิมพัน)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกม ชื่อเกม ค่า RTP ความผันผวน ขั้นต่ำการเดิมพัน ช่องทาง
// ฝากถอน หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่
// บรีฟให้คือโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้า
// แล้ว การเติมตัวเลขหรือชื่อค่ายลงตารางนี้คือการแต่งข้อมูลขึ้นมา
const categories = [
  {
    icon: "🎴",
    name: "บาคาร่า",
    detail: "อยู่ในหมวดที่ระบบจัดไว้ ตรวจสอบรายละเอียดเกมและรูปแบบเดิมพันก่อนเข้าเล่นได้",
    tag: "เลือกจากหมวดหมู่",
  },
  {
    icon: "🃏",
    name: "ไพ่",
    detail: "เปิดให้เลือกจากหน้ารวมเกม อยู่ในบัญชีเดียวกับหมวดอื่นที่เว็บไซต์เปิดให้บริการ",
    tag: "อยู่ในบัญชีเดียว",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "รวมอยู่ในระบบเดียวกับหมวดอื่น ค้นหาได้ง่ายจากการจัดหมวดหมู่ของระบบ",
    tag: "ค้นหาได้ง่าย",
  },
  {
    icon: "🎫",
    name: "หวย",
    detail: "เป็นหนึ่งในหมวดที่รวมไว้ในระบบเดียว เข้าถึงได้จากบัญชีสมาชิกเดียวกัน",
    tag: "รวมไว้ในเว็บเดียว",
  },
  {
    icon: "⚽",
    name: "บอล",
    detail: "อยู่ในหมวดหมู่เดียวกับเกมอื่น เลือกรายการที่ต้องการได้จากหน้ารวมเกม",
    tag: "เลือกจากหน้าเดียว",
  },
  {
    icon: "📺",
    name: "คาสิโนไลฟ์สด",
    detail: "ถ่ายทอดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการในแต่ละช่วง",
    tag: "ส่งตรงจากต่างประเทศ",
  },
];

const checks = [
  {
    icon: "🧾",
    name: "รายละเอียดเกม",
    detail: "เปิดดูรายละเอียดของแต่ละรายการได้ก่อนกดเข้าเล่น ตามข้อมูลที่เว็บไซต์ระบุไว้",
    tag: "ดูก่อนกดเข้าเล่น",
  },
  {
    icon: "🏷️",
    name: "ค่ายที่ให้บริการ",
    detail: "ตรวจสอบได้ว่าแต่ละรายการมาจากผู้ให้บริการใด ตามรายการที่ระบบเปิดไว้",
    tag: "ดูจากหน้ารวมเกม",
  },
  {
    icon: "🎯",
    name: "รูปแบบเดิมพัน",
    detail: "ดูรูปแบบเดิมพันของหมวดที่สนใจได้จากหน้าเดียว ไม่ต้องไล่เปิดหลายหน้า",
    tag: "จบจากหน้าเดียว",
  },
];

const chips = ["บาคาร่า", "ไพ่", "สล็อต", "หวย", "บอล", "คาสิโนไลฟ์สด", "ระบบจัดหมวดหมู่ค้นหาง่าย", "เลือกหมวดจากบัญชีเดียว", "รองรับมือถือและคอมพิวเตอร์", "LINE OFFICIAL 24 ชั่วโมง"];

// KINGDOM66 (รอบทอง-ดำ 2026-09-25): ทั้งสองแผงวางบนผิวการ์ด #151109 เหนือพื้นเพจดำ
// สนิท #050403 แผงล็อกอินอยู่ในกรอบทองแบรนด์ #e6bf4e ส่วนแผงหมวดเกมอยู่ในกรอบทองลึก
// #5c4113 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิว
// การ์ดยก #241c13 ตัวเน้นที่เป็นชื่อหมวดรับไล่เฉดตามลำดับสีในโลโก้ คือครีมแพลตินัมอุ่น
// #efe6cf → ทองสว่าง #f2d683 → ทองแบรนด์ #e6bf4e ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#f2d683 → #e6bf4e → #5c4113) บนตัวอักษรสีดำอมทอง #1a1206 ตามกฎคอนทราสต์ที่ว่า
// ตัวอักษรบนพื้นทองต้องเกือบดำ ปุ่ม LINE ยังคงสีเขียว #00B900 ของแพลตฟอร์ม — ชุดทอง
// -เงินโครเมียมเย็นของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec #161106 #26200e
// #080602 #ece6d8 #fff8e6) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในบัญชีเดียว`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} พร้อมรายการหมวดเกมที่รวมไว้ในบัญชีเดียว ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดจากผู้ให้บริการต่างประเทศ พร้อมสิ่งที่ตรวจสอบได้ก่อนเข้าเล่นจากหน้าเดียว`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e6bf4e]/45 bg-[#151109]/94 p-6 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e6bf4e]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e6bf4e]/70 bg-gradient-to-br from-[#f2d683] via-[#e6bf4e] to-[#5c4113] text-xl shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf6e0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ebe3d3]/75">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกบาคาร่า ไพ่ สล็อต หวย บอล หรือคาสิโนไลฟ์สด จากระบบที่จัดหมวดหมู่ให้ค้นหาได้ง่าย เลือกหมวดที่สนใจได้จากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ebe3d3]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#241c13] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#ebe3d3] transition-all outline-none placeholder:text-[#ebe3d3]/50 focus:border-[#e6bf4e] focus:ring-1 focus:ring-[#f2d683]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ebe3d3]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#241c13] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#ebe3d3] transition-all outline-none placeholder:text-[#ebe3d3]/50 focus:border-[#e6bf4e] focus:ring-1 focus:ring-[#f2d683]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ebe3d3]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#241c13] bg-[#050403] accent-[#e6bf4e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ebe3d3]/75 transition-colors hover:text-[#f2d683]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f2d683]/70 bg-gradient-to-r from-[#f2d683] via-[#e6bf4e] to-[#5c4113] p-3.5 text-center font-black text-[#1a1206] shadow-[0_10px_30px_rgba(230,191,78,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(242,214,131,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ebe3d3]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#241c13]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#241c13]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE OFFICIAL
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#241c13] bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#ebe3d3]"><span aria-hidden="true">🎴</span> รวมทุกหมวดเกมในระบบเดียว</span>
            <span class="rounded-full border border-[#e6bf4e]/45 bg-[#050403]/85 px-2.5 py-1 text-[10px] font-bold text-[#efe6cf]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#efe6cf] transition-colors hover:text-[#fdf6e0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#5c4113]/80 bg-[#151109]/94 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ebe3d3]/75">หมวดเกมที่ระบบจัดหมวดหมู่ไว้ให้ค้นหาง่าย ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันได้ก่อนเข้าเล่น</span>
          <div class="bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">บาคาร่า · ไพ่ · สล็อต · หวย · บอล · ไลฟ์สด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#241c13] bg-[#050403]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6bf4e] shadow-[0_0_8px_rgba(230,191,78,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#efe6cf] uppercase">รวมครบในบัญชีเดียว</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ebe3d3]/75 uppercase">
        <span>หมวดเกมตามรายการที่เปิดให้บริการ</span>
        <span>การเข้าถึง</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          categories.map((c) => (
            <div class="rounded-xl border border-[#e6bf4e]/35 bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#e6bf4e]/70 hover:bg-[#241c13]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fdf6e0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e6bf4e]/60 bg-gradient-to-r from-[#f2d683] to-[#5c4113] px-2.5 py-0.5 text-[10px] font-black text-[#1a1206]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ebe3d3]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ebe3d3]/75 uppercase">
        <span>ตรวจสอบได้ก่อนเข้าเล่นจากหน้าเดียว</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          checks.map((k) => (
            <div class="rounded-xl border border-[#241c13] bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#e6bf4e]/70 hover:bg-[#241c13]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ebe3d3]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#5c4113]/80 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#efe6cf]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ebe3d3]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#241c13] bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#ebe3d3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ebe3d3]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดจากผู้ให้บริการต่างประเทศไว้ในบัญชีเดียว ระบบที่จัดหมวดหมู่ให้ค้นหาได้ง่าย การรองรับทั้งมือถือและคอมพิวเตอร์
        และการตรวจสอบ รายละเอียดเกม ค่ายที่ให้บริการ กับรูปแบบเดิมพันก่อนเข้าเล่นจากหน้าเดียว ส่วนรายการที่เปิดให้บริการในแต่ละช่วงอาจแตกต่างกันตามที่ระบบกำหนด ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมก่อนเข้าใช้งาน
        และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
