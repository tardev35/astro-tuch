---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บเดิมพันออนไลน์ "เจ้าของเดิม อัปเดตระบบใหม่ ความปลอดภัยสูงขึ้น"
// ตารางฝั่งขวาจึงเป็นรายการระบบกับหมวดเกมของ brief เอง ไม่ใช่ตารางค่ายสล็อตกับระบบ
// API อย่างรอบก่อน (ซึ่ง brief รอบนี้ไม่ได้ระบุไว้เลย) ทุกแถวอ้างจากประโยคของ brief
// ล้วนๆ — อัปเกรดโครงสร้างเว็บไซต์และระบบหลังบ้านให้เสถียรและเป็นขั้นตอนมากขึ้น,
// จัดการสิทธิ์บัญชีและข้อมูลภายในระบบอย่างเหมาะสม, ปรับทางเข้าให้ทันสมัยรองรับมือถือ,
// รวมบาคาร่า/สล็อต/หวย/ไฮโล/บอล ไว้ในบัญชีเดียว, เลือกหมวดจากเมนูหลักและสลับเกมได้
// สะดวก, ระบบจัดหมวดหมู่ชัดเจนค้นหาง่าย, โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย
// 0.3% และสมัครเองได้ใน 3 ขั้นตอน ไม่มีแถวไหนคิดชื่อค่าย จำนวนเกม ค่า RTP อัตราจ่าย
// ใบอนุญาต เวลาทำการของแอดมิน หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
const catalogue = [
  {
    icon: "🛡️",
    name: "อัปเกรดโครงสร้างและระบบหลังบ้าน",
    detail: "อัปเกรดโครงสร้างเว็บไซต์และระบบหลังบ้านเพื่อให้การใช้งานมีความเสถียรและเป็นขั้นตอนมากขึ้นในแต่ละส่วน",
    rate: "อัปเดตใหม่",
  },
  {
    icon: "🔐",
    name: "จัดการสิทธิ์บัญชีและข้อมูล",
    detail: "มีการจัดการสิทธิ์บัญชีและข้อมูลภายในระบบอย่างเหมาะสม ช่วยลดความเสี่ยงจากการเข้าถึงข้อมูลโดยไม่ได้รับอนุญาต",
    rate: "ตามระบบ",
  },
  {
    icon: "📱",
    name: "ทางเข้าใหม่ รองรับมือถือ",
    detail: "ปรับทางเข้าให้ทันสมัย ทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือใช้งานได้สะดวกขึ้นกว่าเดิม",
    rate: "ทางเข้าใหม่",
  },
  {
    icon: "🃏",
    name: "บาคาร่า",
    detail: "เลือกหมวดบาคาร่าได้จากหน้าเมนูหลัก แล้วสลับไปเกมประเภทอื่นในบัญชีเดียวได้สะดวก",
    rate: "บัญชีเดียว",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "รวมเกมสล็อตไว้ในหมวดของตัวเอง ระบบจัดหมวดหมู่ชัดเจน ค้นหาเกมที่ต้องการได้ง่าย",
    rate: "จัดหมวดหมู่ชัดเจน",
  },
  {
    icon: "🎫",
    name: "หวย",
    detail: "เปิดหมวดหวยจากหน้าเมนูหลักได้ในบัญชีเดียว โดยไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์",
    rate: "เลือกจากเมนูหลัก",
  },
  {
    icon: "🎲",
    name: "ไฮโล",
    detail: "เลือกหมวดไฮโลได้จากเมนูหลัก พร้อมสลับระหว่างเกมแต่ละประเภทได้สะดวกในระบบเดียว",
    rate: "สลับเกมสะดวก",
  },
  {
    icon: "⚽",
    name: "บอล",
    detail: "เลือกรายการในหมวดบอลได้จากหน้าเมนูหลัก ระบบจัดหมวดหมู่ช่วยให้ค้นหารายการที่ต้องการได้ง่าย",
    rate: "ค้นหาง่าย",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขที่กำหนด ตรวจสอบยอดที่เข้าเกณฑ์ผ่านบัญชีสมาชิกได้โดยตรง",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขของระบบ ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้",
    rate: "0.3%",
  },
  {
    icon: "📝",
    name: "สมัครเองได้ใน 3 ขั้นตอน",
    detail: "กรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจสอบข้อมูลและรายละเอียดบัญชีให้ถูกต้องก่อนยืนยัน แล้วเข้าสู่ระบบเลือกเกมที่ต้องการได้ทันที",
    rate: "3 ขั้นตอน",
  },
];

const chips = [
  "เจ้าของเดิม",
  "ทางเข้าอัปเดตใหม่",
  "อัปเกรดระบบหลังบ้าน",
  "บาคาร่า",
  "สล็อต",
  "หวย",
  "ไฮโล",
  "บอล",
  "บัญชีเดียวครบ",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัคร 3 ขั้นตอน",
];

// ABM96 palette (ชมพู-เหลือง): ทั้งสองแผงวางบนพื้นการ์ด #1d0611 เหนือพื้นเพจชมพู
// เกือบดำ #12030a แผงล็อกอินอยู่ในกรอบชมพูหลัก #fd6494 ส่วนแผงรายการอยู่ในกรอบชมพู
// เข้ม #b8325f — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นยก
// #2a0a1a ในเส้นพื้นการ์ดสว่าง #3d0f26 ตัวเน้นที่เป็นตัวเลขรับเหลืองโลโก้ #feda2a
// ตามเลข 96 บนโลโก้ ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการและเงื่อนไขที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการหมวดเกมทั้งบาคาร่า สล็อต หวย ไฮโล บอล พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fd6494]/40 bg-[#1d0611]/94 p-6 shadow-[0_10px_30px_rgba(18,3,10,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fd6494]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fd6494]/70 bg-gradient-to-br from-[#ffc9dc] via-[#fd6494] to-[#b8325f] text-xl shadow-inner">
          💖
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffc9dc]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#fbe3ee]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกหมวดเกมที่สนใจจากหน้าเมนูหลัก ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล สลับระหว่างเกมแต่ละประเภทได้สะดวกในบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fbe3ee]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3d0f26] bg-[#12030a]/95 py-3 pr-4 pl-12 text-[#fbe3ee] transition-all outline-none placeholder:text-[#fbe3ee]/50 focus:border-[#fd6494] focus:ring-1 focus:ring-[#ffc9dc]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fbe3ee]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3d0f26] bg-[#12030a]/95 py-3 pr-4 pl-12 text-[#fbe3ee] transition-all outline-none placeholder:text-[#fbe3ee]/50 focus:border-[#fd6494] focus:ring-1 focus:ring-[#ffc9dc]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#fbe3ee]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3d0f26] bg-[#12030a] accent-[#fd6494]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#fbe3ee]/70 transition-colors hover:text-[#ffc9dc]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffc9dc]/70 bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#b8325f] p-3.5 text-center font-black text-[#12030a] shadow-[0_10px_30px_rgba(253,100,148,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,201,220,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#fbe3ee]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#3d0f26]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#3d0f26]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3d0f26] bg-[#12030a] px-2.5 py-1 text-[10px] font-bold text-[#fbe3ee]"><span aria-hidden="true">🎴</span> รวมเกมครบบัญชีเดียว</span>
            <span class="rounded-full border border-[#feda2a]/50 bg-[#12030a]/85 px-2.5 py-1 text-[10px] font-bold text-[#feda2a]"><span aria-hidden="true">🛡️</span> อัปเดตระบบใหม่</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffc9dc] transition-colors hover:text-[#fd6494]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#b8325f]/55 bg-[#1d0611]/94 p-5 shadow-[0_10px_30px_rgba(18,3,10,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#fbe3ee]/70">เว็บเดิมพันออนไลน์เจ้าของเดิม รวมเกมครบในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#3d0f26] bg-[#12030a]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#feda2a] shadow-[0_0_8px_rgba(254,218,42,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffc9dc] uppercase">อัปเดตใหม่</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#fbe3ee]/70 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#3d0f26] bg-[#2a0a1a]/95 px-3.5 py-2.5 transition-colors hover:border-[#fd6494]/70 hover:bg-[#1d0611]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fbe3ee]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#feda2a]/45 bg-[#12030a] px-2.5 py-0.5 text-[10px] font-bold text-[#feda2a]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#fbe3ee]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3d0f26] bg-[#12030a] px-3 py-1 text-[10px] font-bold text-[#fbe3ee]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#fbe3ee]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการอัปเกรดระบบการใช้งานและระบบหลังบ้าน การรวมบาคาร่า สล็อต หวย ไฮโล และบอล ไว้ในบัญชีเดียว โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        ส่วนรายการเกม รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
