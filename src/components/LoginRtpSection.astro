---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// PGW44 เป็นเว็บที่อัปเดตค่ายสล็อตย่อยและรวมเกมหลายแนวไว้ให้เลือกจากระบบเดียว แผงฝั่งขวาจึงมี
// แค่สองกลุ่มที่บรีฟระบุไว้จริง คือ สามสิ่งที่บรีฟบอกว่าตรวจสอบได้ก่อนเริ่มใช้งาน (ค่ายสล็อตย่อย
// ที่รวมมาให้, แนวเกมที่เลือกได้ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา,
// ระดับเดิมพันและรูปแบบการเล่นที่แต่ละเกมต่างกันซึ่งดูได้จากหน้าเกมโดยตรง) กับสี่เรื่องที่บรีฟบอก
// ว่าใช้งานผ่านระบบและบัญชีสมาชิก (เมนูจัดหมวดหมู่ชัดเจน, มือถือและคอมพิวเตอร์, รายการที่ระบบ
// เปิดให้บริการตลอดทั้งวัน, ยอดที่เข้าเกณฑ์กับขั้นตอนรับสิทธิ์ที่ตรวจผ่านบัญชีสมาชิก)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกมเจาะจง ชื่อเกม ค่า RTP ขั้นต่ำการเดิมพัน ชื่อธนาคาร เลขใบอนุญาต
// หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่บรีฟให้คือโบนัสแนะนำ
// เพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้าแล้ว การเติมชื่อค่ายหรือรายชื่อเกม
// ลงตารางนี้คือการแต่งข้อมูลขึ้นมา
//
// บรีฟรอบนี้ระบุไลน์ไว้เองว่า "ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง" ต่างจากรอบก่อน
// จึงเขียนคำว่าไลน์ / Line Official ได้ตามบรีฟ และยังไม่มีคำว่า คาสิโน บาคาร่า เกมสด เกมโต๊ะ
// หวย บอล เครดิตฟรี หรือฝากถอนออโต้ อยู่ในบรีฟเลย จึงไม่มีในหน้านี้
const checkBeforePlay = [
  {
    icon: "🏷️",
    name: "ค่ายสล็อตย่อยที่รวมมาให้",
    detail: "รวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว ไม่ต้องเปลี่ยนหลายเว็บไซต์",
    tag: "ระบบเดียวจบ",
  },
  {
    icon: "🎰",
    name: "แนวเกมที่เลือกได้",
    detail: "มีทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา",
    tag: "อัปเดตตามช่วงเวลา",
  },
  {
    icon: "📑",
    name: "ระดับเดิมพันและรูปแบบการเล่น",
    detail: "แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นแตกต่างกัน ตรวจสอบรายละเอียดก่อนเริ่มใช้งานได้จากหน้าเกมโดยตรง",
    tag: "ดูจากหน้าเกม",
  },
];

const accountChecks = [
  {
    icon: "🗂️",
    name: "เมนูจัดหมวดหมู่ชัดเจน",
    detail: "ค้นหาเกมที่สนใจได้สะดวกจากเมนูที่จัดหมวดหมู่ไว้ชัดเจน",
    tag: "หาเกมได้ไว",
  },
  {
    icon: "📱",
    name: "มือถือและคอมพิวเตอร์",
    detail: "รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ ใช้บัญชีเดียวกันได้ทั้งสองอุปกรณ์",
    tag: "ใช้ได้ทั้งสองจอ",
  },
  {
    icon: "🕒",
    name: "รายการที่ระบบเปิดให้บริการ",
    detail: "เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ",
    tag: "เลือกได้ทั้งวัน",
  },
  {
    icon: "🎁",
    name: "ยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์",
    detail: "รายละเอียดยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ของโปรโมชั่น ตรวจสอบได้ผ่านบัญชีสมาชิก",
    tag: "ตรวจก่อนกดรับ",
  },
];

const chips = [
  "ค่ายสล็อตย่อยครบทุกแนวเกม",
  "เลือกได้จากระบบเดียว",
  "เมนูจัดหมวดหมู่ชัดเจน",
  "มือถือและคอมพิวเตอร์",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัครเอง 3 ขั้นตอน",
  "ไลน์ 24 ชั่วโมง",
];

// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): โลโก้เป็นเวิร์ดมาร์กสองสี P กับ G เป็นทอง ส่วน W เป็น
// เขียวสด แล้วเลข 44 ไล่จากทองไปเขียว สองแผงจึงถูกแยกด้วยสีคนละตัว ไม่ใช่แค่ความสว่างของกรอบ
// — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #fde90e ส่วนแผงรายการตรวจสอบอยู่ในกรอบเขียวแบรนด์ #35d413
// ทั้งคู่วางบนผิวการ์ด #0b1408 เหนือพื้นเพจ #050803 ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิวแผง
// ยก #101a0b บรรทัดเด่นรับไล่เฉดตามลำดับบนโลโก้ คือทองอ่อน #fff89a → ทองกลาง #f5c518 →
// เขียวแบรนด์ ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว (#fff89a → #fde90e → #a86f02) บนหมึกเข้ม #10160a
// ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่างต้องเกือบดำ ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์ม
// ซึ่งเป็นคนละเขียวกับเขียวแบรนด์และห้ามรีแมป — ชุดทอง-โครเมียมของแบรนด์รอบก่อน (#fdd32a
// #ffe27a #c8920a #c2c8d0 #f2f4f7 #ffeeb8 #4a3a12 #2a2110 #12100a #15110a #fff8e1 #efe6d2
// #080602) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`สิ่งที่ ${BRAND_NAME} ให้ตรวจสอบได้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการสิ่งที่ระบบเปิดให้ตรวจสอบก่อนเริ่มใช้งาน ทั้งค่ายสล็อตย่อยที่รวมมาให้ แนวเกมที่เลือกได้ ระดับเดิมพันของแต่ละเกม และยอดที่เข้าเกณฑ์ของโปรโมชั่น`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fde90e]/45 bg-[#0b1408]/94 p-6 shadow-[0_10px_30px_rgba(3,6,2,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fde90e]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fde90e]/70 bg-gradient-to-br from-[#fff89a] via-[#fde90e] to-[#a86f02] text-xl text-[#10160a] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbffe8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e9f0dd]/75">
            เข้าสู่ระบบ {BRAND_NAME} ผ่านบัญชีสมาชิกเพื่อเลือกค่ายสล็อตย่อยและเกมหลายแนวจากระบบเดียว เมนูจัดหมวดหมู่ชัดเจน ค้นหาเกมที่สนใจได้สะดวกโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ และใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e9f0dd]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#101a0b] bg-[#050803]/95 py-3 pr-4 pl-12 text-[#e9f0dd] transition-all outline-none placeholder:text-[#e9f0dd]/50 focus:border-[#fde90e] focus:ring-1 focus:ring-[#fff89a]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e9f0dd]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#101a0b] bg-[#050803]/95 py-3 pr-4 pl-12 text-[#e9f0dd] transition-all outline-none placeholder:text-[#e9f0dd]/50 focus:border-[#fde90e] focus:ring-1 focus:ring-[#fff89a]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e9f0dd]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#101a0b] bg-[#050803] accent-[#fde90e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e9f0dd]/75 transition-colors hover:text-[#fff89a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fff89a]/70 bg-gradient-to-r from-[#fff89a] via-[#fde90e] to-[#a86f02] p-3.5 text-center font-black text-[#10160a] shadow-[0_10px_30px_rgba(253,233,14,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,248,154,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e9f0dd]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#101a0b]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#101a0b]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#101a0b] bg-[#050803] px-2.5 py-1 text-[10px] font-bold text-[#e9f0dd]"><span aria-hidden="true">🎰</span> ค่ายสล็อตย่อย</span>
            <span class="rounded-full border border-[#35d413]/40 bg-[#050803]/85 px-2.5 py-1 text-[10px] font-bold text-[#5df53a]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#5df53a] transition-colors hover:text-[#fff89a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#35d413]/45 bg-[#0b1408]/94 p-5 shadow-[0_10px_30px_rgba(3,6,2,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e9f0dd]/75">
            สมาชิกตรวจสอบค่ายสล็อตย่อยที่รวมมาให้ แนวเกมที่เลือกได้ และระดับเดิมพันของแต่ละเกมได้ก่อนเริ่มใช้งาน แล้วดูยอดที่เข้าเกณฑ์กับขั้นตอนรับสิทธิ์ของโปรโมชั่นผ่านบัญชีสมาชิก
          </span>
          <div class="bg-gradient-to-r from-[#fff89a] via-[#f5c518] to-[#35d413] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">ค่ายสล็อตย่อย · ครบทุกแนวเกม · ระบบเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#101a0b] bg-[#050803]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#35d413] shadow-[0_0_8px_rgba(53,212,19,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#5df53a] uppercase">อัปเดตตามช่วงเวลา</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e9f0dd]/75 uppercase">
        <span>ตรวจสอบได้ก่อนเริ่มใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          checkBeforePlay.map((c) => (
            <div class="rounded-xl border border-[#1f5a16]/70 bg-[#050803]/95 px-3.5 py-2.5 transition-colors hover:border-[#fde90e]/70 hover:bg-[#101a0b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fbffe8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fde90e]/60 bg-gradient-to-r from-[#fde90e] to-[#a86f02] px-2.5 py-0.5 text-[10px] font-black text-[#10160a]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e9f0dd]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e9f0dd]/75 uppercase">
        <span>ใช้งานผ่านระบบและบัญชีสมาชิก</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          accountChecks.map((k) => (
            <div class="rounded-xl border border-[#101a0b] bg-[#050803]/95 px-3.5 py-2.5 transition-colors hover:border-[#35d413]/70 hover:bg-[#101a0b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9f0dd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#35d413]/50 bg-[#050803] px-2.5 py-0.5 text-[10px] font-bold text-[#5df53a]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e9f0dd]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#101a0b] bg-[#050803] px-3 py-1 text-[10px] font-bold text-[#e9f0dd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e9f0dd]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียว การมีเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา เมนูที่จัดหมวดหมู่ชัดเจน
        และการรองรับทั้งมือถือและคอมพิวเตอร์ ส่วนระดับเดิมพันและรูปแบบการเล่นของแต่ละเกมแตกต่างกัน ให้ตรวจสอบรายละเอียดก่อนเริ่มใช้งานได้จากหน้าเกมโดยตรง และตรวจเงื่อนไขของโปรโมชั่นแต่ละรายการก่อนกดรับสิทธิ์
        ทุกครั้ง โดยไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
