---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// MHEEPOOH168 เป็นเว็บรวมคาสิโนเกมที่รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว
// รายการฝั่งขวาจึงเป็นข้อเท็จจริงที่ brief ระบุไว้เองล้วนๆ — ความบันเทิงหลายรูปแบบใน
// ระบบเดียว, ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์, ระบบจัดหมวดหมู่เกมชัดเจน, แต่ละ
// ประเภทแยกเป็นเมนูและสลับได้จากบัญชีเดียว, ตัวเลือกจากหลายค่ายและหลายตลาด,
// โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่มีเงื่อนไขแยกไว้ชัดเจนและตรวจสอบ
// สิทธิ์ได้ก่อนรับ, ช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์, การตรวจสอบ
// สถานะรายการและยอดผ่านบัญชีของตัวเอง, และแอดมินที่ให้บริการตลอด 24 ชั่วโมง
// ไม่มีการคิดตัวเลข ค่ายเกม หรือเงื่อนไขขึ้นมาเอง
const menus = [
  {
    icon: "🎴",
    name: "รวมความบันเทิงไว้ในระบบเดียว",
    detail: "บาคาร่า สล็อต หวย และบอล ถูกรวบรวมไว้ในระบบเดียว ไม่ต้องสลับไปใช้งานหลายเว็บไซต์เพื่อเข้าถึงเกมที่สนใจ",
    tag: "4 หมวด",
  },
  {
    icon: "🗂️",
    name: "ระบบจัดหมวดหมู่เกมชัดเจน",
    detail: "แต่ละประเภทถูกแยกเป็นเมนูอย่างชัดเจน ช่วยให้สมาชิกเลือกประเภทที่ต้องการได้สะดวกโดยไม่ต้องไล่หา",
    tag: "แยกเมนู",
  },
  {
    icon: "🔁",
    name: "สลับรูปแบบการเล่นจากบัญชีเดียว",
    detail: "เปลี่ยนจากบาคาร่าไปสล็อต หวย หรือบอลได้จากบัญชีเดียวกัน ไม่ต้องเปิดบัญชีแยกตามประเภทเกม",
    tag: "บัญชีเดียว",
  },
  {
    icon: "🏷️",
    name: "ตัวเลือกจากหลายค่ายและหลายตลาด",
    detail: "แต่ละหมวดมีตัวเลือกจากหลายค่ายและหลายตลาดให้เลือก ตรวจสอบรายการที่เปิดให้ใช้งานได้จากหน้าเกมของเว็บไซต์",
    tag: "หลายค่าย",
  },
  {
    icon: "📱",
    name: "ใช้งานได้ทั้งมือถือและคอมพิวเตอร์",
    detail: "รูปแบบการใช้งานออกแบบให้เข้าถึงได้ง่ายทั้งบนมือถือและคอมพิวเตอร์ ตามมาตรฐานการใช้งานที่เน้นความเป็นระบบในปี 2026",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "💰",
    name: "โบนัสคืนยอดเสีย 0.3%",
    detail: "รับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ตรวจสอบรอบคำนวณและขั้นตอนรับสิทธิ์ได้จากหน้าโปรโมชั่น",
    tag: "0.3%",
  },
  {
    icon: "🤝",
    name: "โบนัสแนะนำเพื่อน 0.8%",
    detail: "ชวนคนรู้จักสมัครผ่านช่องทางที่ระบบรองรับ รับโบนัส 0.8% ตามเงื่อนไขที่กำหนด ตรวจสอบยอดสิทธิ์ได้จากบัญชีสมาชิก",
    tag: "0.8%",
  },
  {
    icon: "📋",
    name: "เงื่อนไขโปรโมชั่นแยกไว้ชัดเจน",
    detail: "แต่ละโปรโมชั่นมีรายละเอียดและเงื่อนไขแยกไว้อย่างชัดเจน สามารถตรวจสอบสิทธิ์ก่อนรับเพื่อเลือกรายการที่เหมาะกับรูปแบบการเล่น",
    tag: "ตรวจก่อนรับ",
  },
  {
    icon: "🏦",
    name: "รองรับธนาคารและวอลเลทที่กำหนดไว้",
    detail: "ระบบรองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ ให้เลือกวิธีจัดการเครดิตได้ตามความสะดวก ขั้นตอนจัดวางให้เข้าใจง่าย",
    tag: "หลายช่องทาง",
  },
  {
    icon: "🕐",
    name: "แอดมินให้บริการ 24 ชั่วโมง",
    detail: "ติดต่อแอดมินได้ตลอด 24 ชั่วโมง เรื่องการสมัคร เกม โปรโมชั่น ระบบเครดิต หรือการเข้าใช้งาน รวมถึงช่วยตรวจสอบปัญหาเบื้องต้น",
    tag: "24 ชม.",
  },
];

const chips = ["บาคาร่า", "สล็อต", "หวย", "บอล", "ระบบเดียว", "บัญชีเดียว", "หลายค่าย", "หลายตลาด", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%", "ธนาคารและวอลเลท", "แอดมิน 24 ชั่วโมง"];

// MHEEPOOH168 palette: both panels sit on the inner-panel red (#2b0101) over the
// page near-black, with the login plate framed in mid gold (#f5b70a) and the
// service list framed in bright red (#c4161c) — the logo's gold-on-red pair, one
// hue per half. The LINE button keeps the platform's own green.
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ MHEEPOOH168"
  titleright="จุดเด่นของ MHEEPOOH168 ที่เว็บระบุไว้"
  label="เข้าสู่ระบบ MHEEPOOH168 และรายการจุดเด่นเรื่องหมวดเกม โปรโมชั่น ช่องทางธนาคารและวอลเลท ที่เว็บระบุไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f5b70a]/40 bg-[#2b0101]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c4161c]/35 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5b70a]/70 bg-gradient-to-br from-[#fced74] via-[#f5b70a] to-[#8a5a06] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fced74]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f1dccd]/70">
            ล็อคอินเข้า MHEEPOOH168 เพื่อเลือกเล่นบาคาร่า สล็อต หวย และบอลจากบัญชีเดียว ตรวจสอบสิทธิ์โปรโมชั่น และดูสถานะรายการเครดิตของตัวเองได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f1dccd]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#540202] bg-[#120303]/95 py-3 pr-4 pl-12 text-[#f1dccd] transition-all outline-none placeholder:text-[#f1dccd]/50 focus:border-[#f5b70a] focus:ring-1 focus:ring-[#fced74]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f1dccd]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#540202] bg-[#120303]/95 py-3 pr-4 pl-12 text-[#f1dccd] transition-all outline-none placeholder:text-[#f1dccd]/50 focus:border-[#f5b70a] focus:ring-1 focus:ring-[#fced74]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f1dccd]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#540202] bg-[#120303] accent-[#c4161c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f1dccd]/80 transition-colors hover:text-[#fced74]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fced74]/70 bg-gradient-to-r from-[#c4161c] via-[#8f0505] to-[#540202] p-3.5 text-center font-black text-[#fced74] shadow-[0_10px_30px_rgba(196,22,28,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(252,237,116,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f1dccd]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#540202]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#540202]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#540202] bg-[#120303] px-2.5 py-1 text-[10px] font-bold text-[#f1dccd]"><span aria-hidden="true">🎴</span> คาสิโนเกมครบวงจร</span>
            <span class="rounded-full border border-[#f5b70a]/50 bg-[#120303]/85 px-2.5 py-1 text-[10px] font-bold text-[#fced74]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fced74] transition-colors hover:text-[#f5b70a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c4161c]/45 bg-[#2b0101]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f1dccd]/70">เว็บรวมคาสิโนเกม มาตรฐานสากล 2026</span>
          <div class="bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บาคาร่า สล็อต หวย บอล ครบในระบบเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#540202] bg-[#120303]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c4161c] shadow-[0_0_8px_rgba(196,22,28,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fced74] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f1dccd]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#540202] bg-[#120303]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5b70a]/70 hover:bg-[#540202]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f1dccd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fced74]/45 bg-[#120303] px-2.5 py-0.5 text-[10px] font-bold text-[#fced74]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f1dccd]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#540202] bg-[#120303] px-3 py-1 text-[10px] font-bold text-[#f1dccd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f1dccd]/70">
        รายการข้างต้นสรุปสิ่งที่ MHEEPOOH168 ระบุไว้ ทั้งการรวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียวที่สลับเล่นได้จากบัญชีเดียว ช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์
        และโปรโมชั่นที่เปิดให้ตรวจสอบสิทธิ์ก่อนรับ ส่วนรอบคำนวณและเงื่อนไขของโปรโมชั่นแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
