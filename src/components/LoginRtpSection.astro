      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#b7a58a]">
            {BRAND_NAME} รวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูง มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ พร้อมเลือกเกมตามช่วงเดิมพันที่ต้องการ
          </span>
          <div class="bg-gradient-to-r from-[#f5d98a] via-[#d8dbe0] to-[#c8912f] bg-clip-text text-xl font-black text-transparent sm:text-2xl">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#6d4412] bg-[#070504] px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5d98a] shadow-[0_0_8px_rgba(245,217,138,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f5d98a] uppercase">ตามแคมเปญที่เปิดในแต่ละช่วง</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b7a58a] uppercase">
        <span>เกมและสิทธิ์ที่เลือกได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameTypes.map((t) => (
            <div class="rounded-xl border border-[#6d4412] bg-[#070504] px-3.5 py-2.5 transition-colors hover:border-[#c8912f]/80 hover:bg-[#120c07]">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#f5d98a]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#b7a58a]">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#b7a58a]">
        รายชื่อค่ายและจำนวนเกมอาจมีการอัปเดต จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมสล็อตของเว็บไซต์ ส่วนการระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์
        การให้บริการที่สามารถตรวจสอบได้ประกอบ และคำว่า ไม่มีขั้นต่ำ ควรอ้างอิงจากเกมที่เปิดให้บริการจริง เพราะเกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b7a58a] uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforePlayChecks.map((k) => (
            <div class="rounded-xl border border-[#6d4412] bg-[#070504] px-3.5 py-2.5 transition-colors hover:border-[#d8dbe0]/60 hover:bg-[#120c07]">
