---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// หวยกินดี365 is a เว็บหวย brand, so every row below stays inside what the brief
// states: หมวดหวยรัฐบาลไทย ลาวพัฒนา ฮานอย 3 รูปแบบ และหุ้นต่างประเทศ, การเลือก
// ตลาดหวย รอบเดิมพัน เลขที่ต้องการ และจำนวนเงินผ่านมือถือ, การตรวจเวลาเปิด-ปิด
// เลขที่เลือก อัตราจ่าย และยอดรวมก่อนยืนยันโพย, วงเงินรับที่ระบบแสดง ณ เวลาส่งโพย,
// เรท 2 ตัวบาทละ 100 และ 3 ตัวบาทละ 1,000, การฝากเครดิตออโต้ผ่านธนาคารและวอลเลท,
// การติดตามเครดิตและประวัติธุรกรรมผ่านบัญชีสมาชิก และการติดต่อเจ้าหน้าที่ตลอด 24
// ชั่วโมงพร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดรายการ.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state — the only rates on this page are the brief's own 2 ตัวบาทละ
// 100 และ 3 ตัวบาทละ 1,000 ในตารางอัตราจ่าย.
const menus = [
  { icon: "🏛️", name: "เลือกตลาดหวยที่เปิดบริการ", detail: "หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย 3 รูปแบบ และหวยหุ้นต่างประเทศ เลือกได้จากระบบเดียว", tag: "เลือกตลาดหวย" },
  { icon: "🕐", name: "ตรวจเวลาเปิด-ปิดของรอบ", detail: "หวยแต่ละประเภทมีเวลาเปิดรับต่างกัน ควรดูรอบที่ระบบเปิดอยู่ก่อนเพื่อไม่ให้ส่งผิดรอบ", tag: "กันส่งผิดรอบ" },
  { icon: "🧮", name: "อัตราจ่ายแสดงก่อนส่งโพย", detail: "เรทที่กำหนดสำหรับหน้านี้คือ 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100 ควรตรวจอัตราจ่ายจริงบนหน้าแทงหวยอีกครั้ง", tag: "ตรวจเรทอีกครั้ง" },
  { icon: "🎯", name: "เลือกเลขและระบุยอดเอง", detail: "เลือกเลขที่ต้องการและจำนวนเงินผ่านมือถือได้ด้วยตัวเอง แล้วตรวจยอดรวมก่อนยืนยันโพย", tag: "กำหนดยอดเอง" },
  { icon: "📌", name: "ยึดวงเงินที่ระบบแสดง", detail: "คำว่ารับแทงไม่อั้นให้ยึดวงเงินที่ระบบแสดง ณ เวลาส่งโพย เพราะบางรอบหรือบางหมายเลขอาจรับต่างกัน", tag: "ดูวงเงินรับ" },
  { icon: "🏦", name: "ฝากเครดิตออโต้ทุกช่องทาง", detail: "เลือกช่องทางธนาคารหรือวอลเลทที่เว็บไซต์เปิดรองรับ ตรวจจำนวนเงินและรายละเอียดบัญชีก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "🧾", name: "ติดตามเครดิตและประวัติธุรกรรม", detail: "เมื่อทำรายการแล้วติดตามเครดิตและประวัติธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเอง", tag: "เช็กประวัติเอง" },
  { icon: "🎧", name: "แจ้งเจ้าหน้าที่ตลอด 24 ชั่วโมง", detail: "แจ้งประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดรายการให้ครบ เพื่อให้ค้นหาข้อมูลได้ตรงจุด", tag: "แจ้งรายละเอียดครบ" },
];

const chips = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย 3 รูปแบบ", "หวยหุ้นต่างประเทศ", "3 ตัวบาทละ 1,000", "2 ตัวบาทละ 100", "ฝากออโต้ธนาคารและวอลเลท", "ดูแลตลอด 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ หวยกินดี365" titleright="จุดที่ควรตรวจสอบก่อนส่งโพยกับ หวยกินดี365" label="เข้าสู่ระบบ หวยกินดี365 และตารางจุดที่ควรตรวจสอบก่อนส่งโพย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f6db6b]/40 bg-[#062a6b]/92 p-6 shadow-[0_10px_30px_rgba(246,219,107,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1baafa]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f6db6b]/60 bg-gradient-to-br from-[#fbe473] via-[#f6db6b] to-[#c9a23a] text-xl shadow-inner">
          🎟️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbe473]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#93a8ce]">เข้าสู่ระบบ หวยกินดี365 เพื่อเลือกตลาดหวยและรอบเดิมพัน ตรวจอัตราจ่ายก่อนส่งโพย ติดตามประวัติธุรกรรม และฝากเครดิตออโต้ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#93a8ce]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f6db6b]/45 bg-[#03153b]/95 py-3 pr-4 pl-12 text-[#dce7fb] transition-all outline-none placeholder:text-[#93a8ce] focus:border-[#f6db6b] focus:ring-1 focus:ring-[#f6db6b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#93a8ce]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#f6db6b]/45 bg-[#03153b]/95 py-3 pr-4 pl-12 text-[#dce7fb] transition-all outline-none placeholder:text-[#93a8ce] focus:border-[#f6db6b] focus:ring-1 focus:ring-[#f6db6b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dce7fb]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f6db6b]/45 bg-[#03153b] accent-[#f6db6b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dce7fb] transition-colors hover:text-[#fbe473]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c9a23a]/55 bg-gradient-to-r from-[#fbe473] via-[#f6db6b] to-[#c9a23a] p-3.5 text-center font-black text-[#03153b] shadow-[0_10px_30px_rgba(246,219,107,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(246,219,107,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#93a8ce]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#f6db6b]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#f6db6b]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5ec2f5]/45 bg-[#03153b] px-2.5 py-1 text-[10px] font-bold text-[#5ec2f5]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#f6db6b]/40 bg-[#03153b]/80 px-2.5 py-1 text-[10px] font-bold text-[#f6db6b]"><span aria-hidden="true">🕐</span> ดูแลตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f6db6b] transition-colors hover:text-[#fbe473]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f6db6b]/40 bg-[#062a6b]/92 p-5 shadow-[0_10px_30px_rgba(246,219,107,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dce7fb]">แทงหวยออนไลน์หลายประเภทในระบบเดียว เลือกเลข ส่งโพย และติดตามประวัติธุรกรรมได้ด้วยตัวเอง</span>
          <div class="bg-gradient-to-r from-[#fbe473] via-[#f6db6b] to-[#c9a23a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5ec2f5]/55 bg-[#041b44]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5ec2f5] shadow-[0_0_8px_rgba(94,194,245,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#5ec2f5] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#93a8ce] uppercase">
        <span>ขั้นตอนส่งโพย ฝากถอน และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0534ba]/60 bg-[#03153b]/95 px-3.5 py-2.5 transition-colors hover:border-[#f6db6b]/60 hover:bg-[#041b44]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dce7fb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f6db6b]/45 bg-[#03153b] px-2.5 py-0.5 text-[10px] font-bold text-[#f6db6b]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#93a8ce]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f6db6b]/35 bg-[#03153b] px-3 py-1 text-[10px] font-bold text-[#f6db6b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#93a8ce]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนส่งโพย หวยแต่ละประเภทและแต่ละรอบอาจมีเวลาเปิด-ปิด อัตราจ่าย และเงื่อนไขต่างกัน ให้ยึดรายละเอียดที่หน้าส่งโพยแสดง ณ เวลานั้นเป็นหลัก
        ส่วนรายชื่อธนาคาร วอลเลท ยอดฝากขั้นต่ำ และวงเงินถอน ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
