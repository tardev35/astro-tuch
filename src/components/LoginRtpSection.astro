import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็น
// **บรีฟคนละฉบับ** กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน
// (ขวัญใจ168) ขายคำว่า "ศูนย์บริการหลัก · ศูนย์รวมช่องทางบริการ · ลิขสิทธิ์เว็บ
// แท้100%" ส่วนรอบนี้เป็น **ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์**
// ที่พูดเรื่อง **ค่ายเกมมาตรฐานสากล PG SOFT / JOKER / JILI 3 ค่ายหลัก** พร้อม
// โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8%
// ไม่จำกัด) ขั้นตอนสมัครสามขั้น และช่องทาง LINE Official
// แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// ฐานหลัก · เว็บสล็อตลิขสิทธิ์แท้ · นำเข้าตรงจากสิงคโปร์ · ค่ายเกมมาตรฐานสากล ·
// PG SOFT · JOKER · JILI · 3 ค่ายหลัก · เกมสล็อตออนไลน์ · สมัครสมาชิก · ลงทะเบียน ·
// เข้าใช้งาน · เข้าสู่ระบบ · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// เครดิต · ยอดเดิมพัน · รอบการคำนวณ · รหัสแนะนำ · ตารางการจ่ายรางวัล · ฟีเจอร์ ·
// กติกา · LINE Official · QR Code · บัญชีแอบอ้าง · รหัสผ่าน · รหัส OTP · ฝากถอน ·
// เจ้าหน้าที่ · หลักฐาน · ผู้ให้บริการ · สถานะลิขสิทธิ์ · ข้อกำหนดบริการ ·
