---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// WIN999 เป็นเว็บคาสิโนออนไลน์ ไม่ใช่เว็บหวย แผงฝั่งขวาของรอบก่อนเป็น "ตารางอัตราจ่าย"
// เลข 3 ตัว/2 ตัวของหวย ซึ่งไม่มีความหมายใดๆ บนเว็บคาสิโน — รอบนี้จึงถูกเขียนใหม่เป็น
// สองอย่างที่บรีฟพูดถึงจริง คือ (1) หมวดเกมที่บรีฟระบุชื่อไว้เอง ได้แก่ บาคาร่า สล็อต
// เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ กับ (2) สิ่งที่สมาชิกตรวจสอบได้จากบัญชีของตนเอง
// ได้แก่ เครดิต ประวัติรายการ รายละเอียดเกมก่อนเริ่มเดิมพัน โปรโมชั่นที่เปิดให้รับ และ
// สถานะรายการถอน ทั้งหมดเป็นประโยคของบรีฟเอง ไม่มีตัวเลขใหม่สักตัว
//
// ห้ามใส่ RTP ค่าความผันผวน ชื่อค่ายเกม ชื่อโต๊ะบาคาร่า ชื่อธนาคาร เลขใบอนุญาต ขั้นต่ำ
// การเดิมพัน หรืออัตราจ่ายลงในไฟล์นี้ — บรีฟ WIN999 ไม่ได้ให้ไว้เลยสักอย่าง และคำเหล่านั้น
// เป็นคำศัพท์ของสองแบรนด์ก่อนหน้า (สล็อต แล้วหวย) ไม่ใช่ของแบรนด์นี้ ตัวเลข 0.3% กับ
// 0.8% เป็นชื่อโปรโมชั่นของบรีฟเองจึงใช้ได้ แต่ห้ามแตกเป็นเงื่อนไข/รอบตัดยอดที่บรีฟไม่ได้บอก
const gameCategories = [
  { icon: "🃏", name: "บาคาร่า", detail: "หนึ่งในหมวดเดิมพันที่เว็บไซต์ระบุว่าเปิดให้สมาชิกเลือกเล่นจากบัญชีเดียว" },
  { icon: "🎰", name: "สล็อต", detail: "เลือกเกมและตรวจสอบรายละเอียดเกมได้ก่อนเริ่มเดิมพันด้วยตัวเอง" },
  { icon: "🎴", name: "เกมไพ่", detail: "อีกหมวดที่บรีฟระบุไว้ เข้าเล่นผ่านเว็บเบราว์เซอร์ได้เช่นเดียวกัน" },
  { icon: "🕹️", name: "เกมอื่นตามค่ายที่ระบบรองรับ", detail: "รายการเกมที่เปิดให้เล่นขึ้นอยู่กับค่ายที่ระบบรองรับในขณะนั้น" },
];

// สี่ข้อนี้ประกอบจากประโยคของบรีฟเองทั้งหมด — ตรวจเครดิตและประวัติรายการจากบัญชีเดียว,
// ตรวจโปรโมชั่นที่เปิดให้รับ, ตรวจสถานะรายการถอนและเก็บหลักฐานไว้จนกว่าจะเสร็จสมบูรณ์,
// และบันทึกทางเข้าล่าสุดจากช่องทางหลักของเว็บไซต์
const accountChecks = [
  {
    icon: "💳",
    name: "เครดิตและประวัติรายการ",
    detail: "ตรวจสอบเครดิต ประวัติรายการ และรายละเอียดเกมก่อนเริ่มเดิมพันได้ด้วยตัวเองจากบัญชีเดียว",
    tag: "บัญชีเดียว",
  },
  {
    icon: "🎁",
    name: "โปรโมชั่นที่เปิดให้รับ",
    detail: "ตรวจสอบโปรโมชั่นที่เปิดให้รับจากบัญชีของตนเอง และอ่านรายละเอียดล่าสุดก่อนกดรับทุกครั้ง",
    tag: "อ่านเงื่อนไขก่อนรับ",
  },
  {
    icon: "🏦",
    name: "สถานะฝากถอนผ่านบัญชีบริษัท",
    detail: "ก่อนฝากควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางให้ตรงกับที่เว็บไซต์แสดง ส่วนรายการถอนควรตรวจสถานะผ่านระบบและเก็บหลักฐานไว้จนกว่าจะเสร็จสมบูรณ์",
    tag: "ตรวจก่อนโอน",
  },
  {
    icon: "🔗",
    name: "ทางเข้าล่าสุดจากช่องทางหลัก",
    detail: "บันทึกทางเข้าล่าสุดจากช่องทางหลักของเว็บไซต์ไว้ใช้ Login หากลิงก์เดิมใช้งานไม่ได้ ควรตรวจสอบประกาศหรือติดต่อแอดมินก่อนกรอกข้อมูลผ่านลิงก์อื่น",
    tag: "ลดความเสี่ยงเว็บปลอม",
  },
];

const chips = ["บาคาร่า", "สล็อต", "เกมไพ่", "เล่นผ่านมือถือ", "ฝากถอนออโต้", "บัญชีบริษัท", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];

// WIN999 (รอบทอง-ดำ 2026-09-29): โลโก้เป็นเวิร์ดมาร์กสองสี WIN เป็นทองสด #fcc403 แล้ว
// 999 เป็นขาว งานอาร์ตเป็นพื้นดำสนิทประดับทอง ชิปคาสิโนดำขอบทอง และมงกุฎทอง สองแผงจึง
// ถูกแยกด้วยน้ำหนักของทองคนละระดับ ไม่ใช่คนละสี — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #fcc403
// ส่วนแผงหมวดเกมอยู่ในกรอบทองลึก #8a6502 ทั้งคู่วางบนผิวการ์ด #101010 เหนือพื้นเพจ
// #050505 ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิวแผงยก #4a3402 บรรทัดเด่นไล่เฉดขาว
// ไฮไลต์ #fffbea → ทองสว่าง #fdda04 → ทองแบรนด์ #fcc403 ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#fdda04 → #fcc403 → #8a6502) บนหมึกเข้ม #120d02 ปุ่มไลน์ยังคงสีเขียว #00B900 ของ
// แพลตฟอร์มซึ่งห้ามรีแมป — ชุดแดง-ทองของ LOTTO24 (#dc2626 #fc2b2c #b40102 #7f1d1d
// #fbbf24 #fde68a #a16207 #2a0405 #3b0404 #140202 #fff1f1 #f6e2e2) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกม ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎲"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมหมวดเกมที่เปิดให้เลือกทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ และรายการที่สมาชิกตรวจสอบได้จากบัญชีของตนเอง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fcc403]/45 bg-[#101010]/94 p-6 shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fcc403]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcc403]/70 bg-gradient-to-br from-[#fdda04] via-[#fcc403] to-[#8a6502] text-xl text-[#120d02] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fffbea]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e9e4d6]/75">
            Login เข้าบัญชี {BRAND_NAME} ผ่านเว็บเบราว์เซอร์เพื่อเลือกหมวดเดิมพันจากบัญชีเดียว ตรวจสอบเครดิต ประวัติรายการ และรายละเอียดเกมก่อนเริ่มเดิมพันได้ด้วยตัวเอง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e9e4d6]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4a3402] bg-[#050505]/95 py-3 pr-4 pl-12 text-[#e9e4d6] transition-all outline-none placeholder:text-[#e9e4d6]/50 focus:border-[#fcc403] focus:ring-1 focus:ring-[#fdda04]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e9e4d6]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4a3402] bg-[#050505]/95 py-3 pr-4 pl-12 text-[#e9e4d6] transition-all outline-none placeholder:text-[#e9e4d6]/50 focus:border-[#fcc403] focus:ring-1 focus:ring-[#fdda04]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e9e4d6]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4a3402] bg-[#050505] accent-[#fcc403]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e9e4d6]/75 transition-colors hover:text-[#fdda04]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fcc403]/70 bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#8a6502] p-3.5 text-center font-black text-[#120d02] shadow-[0_10px_30px_rgba(252,196,3,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,218,4,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e9e4d6]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#4a3402]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#4a3402]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#4a3402] bg-[#050505] px-2.5 py-1 text-[10px] font-bold text-[#e9e4d6]"><span aria-hidden="true">🎲</span> คาสิโนออนไลน์</span>
            <span class="rounded-full border border-[#fcc403]/40 bg-[#050505]/85 px-2.5 py-1 text-[10px] font-bold text-[#fdda04]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdda04] transition-colors hover:text-[#fcc403]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a6502]/70 bg-[#101010]/94 p-5 shadow-[0_10px_30px_rgba(3,2,0,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e9e4d6]/75">
            {BRAND_NAME} รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้สำหรับสมาชิกที่ต้องการเข้าเล่นผ่านมือถือ เลือกหมวดเดิมพันจากบัญชีเดียวได้โดยไม่ต้องสลับเว็บไซต์
          </span>
          <div class="bg-gradient-to-r from-[#fffbea] via-[#fdda04] to-[#fcc403] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">บาคาร่า · สล็อต · เกมไพ่</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#4a3402] bg-[#050505]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcc403] shadow-[0_0_8px_rgba(252,196,3,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fdda04] uppercase">ตามค่ายที่ระบบรองรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e9e4d6]/75 uppercase">
        <span>หมวดเกมที่เปิดให้เลือก</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameCategories.map((g) => (
            <div class="rounded-xl border border-[#4a3402] bg-[#050505]/95 px-3.5 py-2.5 transition-colors hover:border-[#fcc403]/70 hover:bg-[#191712]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fffbea]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {g.icon}
                </span>
                <span class="truncate">{g.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#e9e4d6]/75">{g.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#e9e4d6]/75">
        การเปิดให้บริการตลอด 24 ชั่วโมงขึ้นอยู่กับสถานะของเว็บไซต์และผู้ให้บริการเกม หากบางค่ายมีการปิดปรับปรุง สมาชิกอาจไม่สามารถเข้าเกมดังกล่าวได้เป็นการชั่วคราว
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e9e4d6]/75 uppercase">
        <span>ตรวจสอบได้จากบัญชีสมาชิก</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          accountChecks.map((k) => (
            <div class="rounded-xl border border-[#4a3402] bg-[#050505]/95 px-3.5 py-2.5 transition-colors hover:border-[#fcc403]/70 hover:bg-[#191712]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9e4d6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fcc403]/50 bg-[#050505] px-2.5 py-0.5 text-[10px] font-bold text-[#fdda04]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e9e4d6]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#4a3402] bg-[#050505] px-3 py-1 text-[10px] font-bold text-[#e9e4d6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e9e4d6]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในบัญชีเดียว การ Login ผ่านเว็บเบราว์เซอร์เพื่อเลือกหมวดเดิมพัน การตรวจสอบเครดิต ประวัติรายการ และรายละเอียดเกมก่อนเริ่มเดิมพัน
        และการทำรายการฝากถอนผ่านช่องทางบัญชีบริษัทที่ควรตรวจชื่อบัญชีและข้อมูลปลายทางให้ตรงกับที่เว็บไซต์แสดงก่อนทุกครั้ง โดยไม่ควรส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้บุคคลดังกล่าวจะอ้างว่าเป็นเจ้าหน้าที่ก็ตาม
      </div>
    </div>
  </div>
</ContentBoxTwo>
