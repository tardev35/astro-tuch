---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// HIX168 is a slot brand, so every row below stays inside what the brief states:
// การเล่นสล็อตออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์, เกมสล็อตหลาย
// รูปแบบให้เลือก, การ Login เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และ
// ประวัติรายการ, การรองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์, การตรวจกติกา ช่วง
// เดิมพัน และรายละเอียดเกมก่อนเล่น, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
// ตามเงื่อนไข, ระบบฝากถอนออโต้ที่รองรับช่องทางตามที่ระบบเปิดให้บริการ และแอดมิน
// หลังบ้านตลอด 24 ชั่วโมง.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state.
const menus = [
  { icon: "🎰", name: "เกมสล็อตหลายรูปแบบ", detail: "เลือกเกมสล็อตจากรูปแบบที่ระบบเปิดให้บริการ แล้วดูกติกา ช่วงเดิมพัน และรายละเอียดของเกมให้ครบก่อนเริ่มหมุน", tag: "ดูช่วงเดิมพัน" },
  { icon: "🔑", name: "Login เข้าบัญชีสมาชิก", detail: "เข้าสู่ระบบเพื่อจัดการบัญชีของตัวเอง ทั้งเลือกค่าย ค้นหาเกม และดูข้อมูลที่ระบบแสดงไว้ในหน้าสมาชิก", tag: "บัญชีเดียวครบ" },
  { icon: "🔍", name: "ค้นหาเกมและเลือกค่าย", detail: "ระบบอัปเดตให้ค้นหาเกมและเลือกค่ายได้สะดวกขึ้น ช่วยลดเวลาไล่หาเกมที่ต้องการในแต่ละรอบ", tag: "อัปเดตระบบใหม่" },
  { icon: "💳", name: "ตรวจสอบเครดิตคงเหลือ", detail: "ตรวจยอดเครดิตในบัญชีก่อนเริ่มเล่นและหลังทำรายการ เพื่อให้ยอดที่เห็นตรงกับรายการจริงทุกครั้ง", tag: "เช็กก่อนเล่น" },
  { icon: "📱", name: "มือถือ แท็บเล็ต คอม", detail: "รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ จัดการบัญชีได้จากอุปกรณ์ที่สะดวกที่สุด", tag: "ใช้ได้ทุกอุปกรณ์" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมีรายการตรงตามข้อกำหนด", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจประเภทเกม รอบเวลา และเงื่อนไขการถอนโบนัสให้เรียบร้อยก่อนกดรับสิทธิ์ในแต่ละรอบ", tag: "ตรวจรอบก่อนกดรับ" },
  { icon: "🏦", name: "ฝากถอนออโต้ทุกช่องทาง", detail: "ตรวจช่องทางฝากเงิน ส่งคำขอถอน และติดตามสถานะรายการผ่านหน้าเว็บไซต์ตามช่องทางที่ระบบเปิดให้บริการ", tag: "ดูสถานะรายการ" },
];

const chips = ["สล็อตออนไลน์", "ค้นหาเกม", "เลือกค่าย", "ตรวจสอบเครดิต", "ประวัติรายการ", "โบนัส 0.8%", "คืนยอดเสีย 0.3%", "ฝากถอนออโต้", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ HIX168" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อตกับ HIX168" label="เข้าสู่ระบบ HIX168 และตารางจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#1e7bf5]/40 bg-[#060c1c]/92 p-6 shadow-[0_10px_30px_rgba(30,123,245,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1e7bf5]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#1e7bf5]/60 bg-gradient-to-br from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#6fb4ff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#7f8ea3]">เข้าสู่ระบบ HIX168 เพื่อเลือกค่าย ค้นหาเกมสล็อต ตรวจสอบเครดิต ดูโปรโมชั่น และประวัติรายการผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7f8ea3]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1e7bf5]/45 bg-[#01030d]/95 py-3 pr-4 pl-12 text-[#d6e2f5] transition-all outline-none placeholder:text-[#7f8ea3] focus:border-[#1e7bf5] focus:ring-1 focus:ring-[#1e7bf5]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7f8ea3]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1e7bf5]/45 bg-[#01030d]/95 py-3 pr-4 pl-12 text-[#d6e2f5] transition-all outline-none placeholder:text-[#7f8ea3] focus:border-[#1e7bf5] focus:ring-1 focus:ring-[#1e7bf5]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d6e2f5]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1e7bf5]/45 bg-[#01030d] accent-[#1e7bf5]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d6e2f5] transition-colors hover:text-[#8ec5ff]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#0a3fa8]/55 bg-gradient-to-r from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] p-3.5 text-center font-black text-[#02060f] shadow-[0_10px_30px_rgba(30,123,245,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(30,123,245,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#7f8ea3]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#1e7bf5]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#1e7bf5]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#cfd8e6]/40 bg-[#01030d] px-2.5 py-1 text-[10px] font-bold text-[#cfd8e6]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#1e7bf5]/40 bg-[#01030d]/80 px-2.5 py-1 text-[10px] font-bold text-[#6fb4ff]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#6fb4ff] transition-colors hover:text-[#8ec5ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#1e7bf5]/40 bg-[#060c1c]/92 p-5 shadow-[0_10px_30px_rgba(30,123,245,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d6e2f5]">เล่นสล็อตออนไลน์ผ่านระบบที่ใช้งานง่าย จัดการบัญชีและทำรายการได้จากอุปกรณ์ที่สะดวก</span>
          <div class="bg-gradient-to-r from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#7f8ea3] uppercase">
        <span>ฟังก์ชันเกม โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1e7bf5]/40 bg-[#01030d]/95 px-3.5 py-2.5 transition-colors hover:border-[#6fb4ff]/60 hover:bg-[#0d1730]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d6e2f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#1e7bf5]/45 bg-[#01030d] px-2.5 py-0.5 text-[10px] font-bold text-[#6fb4ff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#7f8ea3]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1e7bf5]/35 bg-[#01030d] px-3 py-1 text-[10px] font-bold text-[#6fb4ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#7f8ea3]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น เกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน กติกา ช่วงเดิมพัน และเงื่อนไขโปรโมชั่นขึ้นอยู่กับรายละเอียดของแต่ละรายการ และไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
