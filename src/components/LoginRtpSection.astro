---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// MEPAY77 is a คาสิโนออนไลน์ brand covering บาคาร่า / สล็อต / หวย / บอล, so every
// row below stays inside what the brief states: เกมเดิมพันหลักทั้งบาคาร่าออนไลน์และ
// คาสิโนสด สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ และการเดิมพัน
// ฟุตบอลตามรายการแข่งขัน, การสลับหมวดเกมผ่านบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง,
// การตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละเกมก่อนยืนยันเดิมพัน, การ Login เพื่อ
// ตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละช่วง, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
// พร้อมยอดที่ใช้คำนวณ รอบรับโบนัส ประเภทเกม และเงื่อนไข, ระบบฝากถอนผ่านวอลเลทหรือ
// ธนาคารตามช่องทางที่เปิดรองรับ, และแอดมินที่รับเรื่องตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed win — the brief states none of them
// and says outright that no game guarantees a profit.
const menus = [
  {
    icon: "🎁",
    name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ",
    detail: "สมาชิกที่มีบัญชีเข้าสู่ระบบเพื่อดูโปรโมชั่นที่เปิดให้รับในแต่ละช่วงได้เอง แต่ละสิทธิ์อาจกำหนดยอดที่ใช้คำนวณและรอบรับต่างกัน",
    tag: "ดูจากบัญชี",
  },
  { icon: "👥", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส 0.8% ตามข้อกำหนด", tag: "0.8%" },
  { icon: "💠", name: "โบนัสคืนยอดเสีย 0.3%", detail: "ตรวจสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ก่อนกดรับควรดูประเภทเกม รอบเวลา และข้อกำหนดเกี่ยวกับโบนัสให้เรียบร้อย", tag: "0.3%" },
  {
    icon: "🃏",
    name: "บาคาร่าออนไลน์และคาสิโนสด",
    detail: "เลือกโต๊ะบาคาร่าและคาสิโนสดตามที่ระบบเปิดให้บริการ ตรวจกติกาและอัตราจ่ายของโต๊ะนั้นก่อนยืนยันเดิมพันทุกครั้ง",
    tag: "ถ่ายทอดสด",
  },
  { icon: "🎰", name: "สล็อตออนไลน์จากหลายค่าย", detail: "สลับค่ายและเกมสล็อตผ่านบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง ดูรูปแบบการเดิมพันและวงเงินของเกมได้ก่อนเริ่มหมุน", tag: "หลายค่าย" },
  { icon: "🎱", name: "หวยออนไลน์ตามรอบที่เปิด", detail: "หวยออนไลน์เปิดรับตามรอบที่ระบบกำหนด ควรตรวจเวลาปิดรับ ประเภทการแทง และอัตราจ่ายของรอบนั้นก่อนส่งรายการ", tag: "ตามรอบ" },
  { icon: "⚽", name: "เดิมพันฟุตบอลตามรายการแข่ง", detail: "เดิมพันฟุตบอลตามรายการแข่งขันที่เปิดให้บริการ ตรวจรูปแบบการเดิมพัน อัตราจ่าย และวงเงินของคู่นั้นก่อนยืนยัน", tag: "ตามรายการแข่ง" },
  {
    icon: "💳",
    name: "ฝากถอนวอลเลทและธนาคาร",
    detail: "ฝากเครดิต ส่งคำขอถอน และตรวจสถานะรายการผ่านมือถือได้เอง แต่ละช่องทางอาจมีขั้นต่ำ วงเงินสูงสุด หรือข้อกำหนดต่างกัน",
    tag: "ทำรายการเอง",
  },
];

const chips = ["บาคาร่า", "คาสิโนสด", "สล็อตหลายค่าย", "หวยออนไลน์", "เดิมพันฟุตบอล", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ MEPAY77" titleright="จุดที่ควรตรวจสอบก่อนกดรับโปรโมชั่นและเริ่มเดิมพัน" label="เข้าสู่ระบบ MEPAY77 และรายการจุดที่ควรตรวจสอบก่อนกดรับโปรโมชั่น">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a3701c]/40 bg-[#1b1206]/92 p-6 shadow-[0_10px_30px_rgba(163,112,28,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f2ae35]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#aab0b8]/60 bg-gradient-to-br from-[#fff6e0] via-[#dfe3e8] to-[#a3701c] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff6e0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#fdcc5c]">
            เข้าสู่ระบบ MEPAY77 เพื่อสลับหมวดเกมบาคาร่า สล็อต หวย และบอลผ่านบัญชีเดียว ตรวจโปรโมชั่นที่เปิดให้รับ ฝากถอนวอลเลท และติดตามสถานะรายการได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a08a5c]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a3701c]/45 bg-[#130c01]/95 py-3 pr-4 pl-12 text-[#f1e5cd] transition-all outline-none placeholder:text-[#a08a5c] focus:border-[#f2ae35] focus:ring-1 focus:ring-[#f2ae35]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a08a5c]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#a3701c]/45 bg-[#130c01]/95 py-3 pr-4 pl-12 text-[#f1e5cd] transition-all outline-none placeholder:text-[#a08a5c] focus:border-[#f2ae35] focus:ring-1 focus:ring-[#f2ae35]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f1e5cd]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a3701c]/45 bg-[#130c01] accent-[#a3701c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f1e5cd] transition-colors hover:text-[#fff6e0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#a3701c]/55 bg-gradient-to-r from-[#fdcc5c] via-[#dfe3e8] to-[#f2ae35] p-3.5 text-center font-black text-[#130c01] shadow-[0_10px_30px_rgba(242,174,53,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,204,92,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a08a5c]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#a3701c]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#a3701c]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#aab0b8]/45 bg-[#130c01] px-2.5 py-1 text-[10px] font-bold text-[#dfe3e8]"><span aria-hidden="true">🎰</span> ครบทุกหมวดเกม</span>
            <span class="rounded-full border border-[#a3701c]/40 bg-[#130c01]/80 px-2.5 py-1 text-[10px] font-bold text-[#fdcc5c]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdcc5c] transition-colors hover:text-[#fff6e0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a3701c]/40 bg-[#1b1206]/92 p-5 shadow-[0_10px_30px_rgba(163,112,28,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f1e5cd]">
            สลับหมวดเกมผ่านบัญชีเดียวได้โดยไม่ต้องสมัครหลายครั้ง และตรวจสอบกติกา อัตราจ่าย และวงเงินของแต่ละเกมก่อนยืนยันเดิมพันทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#fdcc5c] via-[#dfe3e8] to-[#f2ae35] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกหมวดเกม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#aab0b8]/55 bg-[#241503]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dfe3e8] shadow-[0_0_8px_rgba(223,227,232,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#dfe3e8] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a08a5c] uppercase">
        <span>โปรโมชั่น หมวดเกม และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#5c3a08] bg-[#130c01]/95 px-3.5 py-2.5 transition-colors hover:border-[#dfe3e8]/45 hover:bg-[#241503]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f1e5cd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#aab0b8]/45 bg-[#130c01] px-2.5 py-0.5 text-[10px] font-bold text-[#dfe3e8]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cdb98a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a3701c]/35 bg-[#130c01] px-3 py-1 text-[10px] font-bold text-[#fdcc5c]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a08a5c]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนยืนยันเดิมพัน แต่ละเกมและแต่ละรอบอาจกำหนดกติกา อัตราจ่าย และวงเงินไม่เท่ากัน ให้ยึดรายละเอียดที่แสดงในระบบ ณ เวลาเล่นเป็นหลัก ส่วนยอดที่ใช้คำนวณ
        รอบรับโบนัส และเงื่อนไขของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
