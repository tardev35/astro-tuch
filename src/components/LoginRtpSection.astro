---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the JADTEM88 brief states: เกมเดิมพัน
// ออนไลน์หลากหลายประเภทในระบบเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต
// เสือมังกร แบล็กแจ็ก และเกมยอดนิยมจากหลายค่าย, การ Login เข้าบัญชีเพื่อฝาก
// เครดิตและตรวจสอบโปรโมชั่นสำหรับสมาชิกใหม่, การจัดการบัญชีและดูประวัติรายการ
// ผ่านระบบสมาชิก, และการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์. No
// provider name appears here — the brief names none.
const menus = [
  { icon: "🎰", name: "เกมสล็อตจากหลายค่าย", detail: "รวมเกมสล็อตที่เปิดให้บริการไว้ในระบบเดียว ตรวจสอบฟีเจอร์ อัตราเดิมพัน และรายละเอียดของเกมได้ก่อนเข้าเล่น", tag: "รวมค่ายชั้นนำ" },
  { icon: "🃏", name: "บาคาร่าออนไลน์", detail: "รวมโต๊ะบาคาร่าที่เปิดให้บริการไว้ในระบบเดียว ดูกติกาและอัตราเดิมพันได้จากหน้ารายละเอียดของแต่ละโต๊ะ", tag: "หลายโต๊ะให้เลือก" },
  { icon: "🎥", name: "คาสิโนสด", detail: "ห้องถ่ายทอดสดพร้อมรายละเอียดวงเงินเดิมพันและกติกาให้ดูก่อนเข้าโต๊ะ", tag: "ถ่ายทอดสด" },
  { icon: "🎡", name: "รูเล็ตและเสือมังกร", detail: "เกมรอบสั้นที่ตัดสินผลรวดเร็ว ศึกษาอัตราจ่ายและรูปแบบการวางเดิมพันได้ก่อนเริ่ม", tag: "อ่านกติกาก่อน" },
  { icon: "♠️", name: "แบล็กแจ็ก", detail: "เกมไพ่ที่มีกติกาการเรียกไพ่เฉพาะตัว เงื่อนไขของแต่ละโต๊ะแสดงไว้ในหน้าเกม", tag: "ผลลัพธ์ไม่การันตี" },
  { icon: "🔍", name: "ค้นหาเกมในระบบ", detail: "ค้นหาเกมตามชื่อหรือหมวดหมู่ และเปิดดูรายละเอียดของเกมได้ก่อนเข้าเล่นจริง", tag: "ดูก่อนเข้าเล่น" },
  { icon: "⚡", name: "ฝากเครดิตและถอน", detail: "Login เพื่อฝากเครดิต ตรวจสอบสถานะรายการ และดูช่องทางที่เปิดให้บริการจากบัญชีของตนเอง", tag: "ตรวจสอบสถานะเอง" },
  { icon: "🎁", name: "โปรโมชั่นสมาชิกใหม่", detail: "ตรวจสอบโบนัสและสิทธิ์ที่บัญชีรับได้หลังสมัคร พร้อมยอดฝาก ยอดเทิร์น และเงื่อนไขการถอนของแต่ละรายการ", tag: "ตามเงื่อนไขแต่ละรายการ" },
];

const chips = ["สล็อต", "บาคาร่า", "คาสิโนสด", "รูเล็ต", "เสือมังกร", "แบล็กแจ็ก", "แอดมินช่วยตรวจสอบ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ JADTEM88"
  titleright="หมวดเกมและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ JADTEM88 และหมวดเกมเดิมพันออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#1d4ed8]/70 bg-[#0f1e3d]/92 p-6 shadow-[0_10px_30px_rgba(59,130,246,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3b82f6]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3b82f6]/55 bg-gradient-to-br from-[#2563eb] via-[#3b82f6] to-[#1d4ed8] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f1f5f9]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#cbd5e1]/80">เข้าสู่ระบบ JADTEM88 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cbd5e1]/80">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1d4ed8] bg-[#0a142c]/95 py-3 pr-4 pl-12 text-[#cbd5e1] transition-all outline-none placeholder:text-[#cbd5e1]/60 focus:border-[#3b82f6] focus:ring-1 focus:ring-[#3b82f6]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cbd5e1]/80">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1d4ed8] bg-[#0a142c]/95 py-3 pr-4 pl-12 text-[#cbd5e1] transition-all outline-none placeholder:text-[#cbd5e1]/60 focus:border-[#3b82f6] focus:ring-1 focus:ring-[#3b82f6]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cbd5e1]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1d4ed8] bg-[#0a142c] accent-[#3b82f6]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cbd5e1] transition-colors hover:text-[#60a5fa]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#2563eb]/50 bg-gradient-to-r from-[#2563eb] via-[#3b82f6] to-[#1d4ed8] p-3.5 text-center font-black text-[#03060f] shadow-[0_10px_30px_rgba(59,130,246,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(59,130,246,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cbd5e1]/80">
          <span class="h-px flex-1 bg-[#1d4ed8]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#1d4ed8]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#1d4ed8]/80 bg-[#0a142c] px-2.5 py-1 text-[10px] font-bold text-[#f1f5f9]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#3b82f6]/35 bg-[#0a142c]/80 px-2.5 py-1 text-[10px] font-bold text-[#cbd5e1]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f1f5f9] transition-colors hover:text-[#60a5fa]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#3b82f6]/30 bg-[#0f1e3d]/92 p-5 shadow-[0_10px_30px_rgba(59,130,246,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cbd5e1]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#3b82f6] via-[#f1f5f9] to-[#cbd5e1] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cbd5e1]/80 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1d4ed8] bg-[#0a142c]/95 px-3.5 py-2.5 transition-colors hover:border-[#3b82f6]/60 hover:bg-[#132447]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cbd5e1]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#1d4ed8]/80 bg-[#0a142c] px-2.5 py-0.5 text-[10px] font-bold text-[#f1f5f9]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cbd5e1]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3b82f6]/30 bg-[#0a142c] px-3 py-1 text-[10px] font-bold text-[#f1f5f9]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cbd5e1]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
