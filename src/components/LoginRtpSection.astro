---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน (UFA324)
// เป็น **เว็บเล่นเกมกีฬาออนไลน์** ที่พูดถึงทางเข้าเดิมพันฟุตบอลกับมวย ส่วนรอบนี้
// เป็น **เกมคาสิโนรวม** ที่รวมบาคาร่า สล็อต บอลออนไลน์ ไฮโล และเกมยิงปลาไว้ใน
