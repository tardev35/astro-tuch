---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// PLUSPSG is a slot brand, so every row below stays inside what the docx
// states: สล็อตหลายค่ายและหลายระดับการเดิมพัน, เกมเบทต่ำ เกมโบนัส สล็อตแจ็คพอต และ
// เกมใหม่ที่อัปเดตต่อเนื่อง, การตรวจกติกา เพย์ไลน์ ฟีเจอร์ และช่วงเดิมพันก่อนเล่น,
// โปรแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, การสมัคร ฝากเครดิต และโบนัส
// ฝากแรก, และแอดมินที่ดูแลตลอด 24 ชั่วโมง. No payout claim, no RTP figure and no
// game name the brief does not state appears anywhere in this file.
const menus = [
  { icon: "🎰", name: "สล็อตหลายค่าย", detail: "เลือกเล่นสล็อตจากหลายค่ายในบัญชีเดียว โดยแต่ละเกมมีกติกาและฟีเจอร์ต่างกัน", tag: "หลายผู้ให้บริการ" },
  { icon: "🪙", name: "สล็อตเบทต่ำ", detail: "มีเกมที่รองรับการเดิมพันเริ่มต้นในจำนวนต่ำ ขั้นต่ำต่างกันตามเกมและผู้ให้บริการ", tag: "ทุนน้อยเล่นได้" },
  { icon: "🎁", name: "เกมฟีเจอร์โบนัส", detail: "เกมที่มีฟีเจอร์โบนัสจะระบุเงื่อนไขการเข้าฟีเจอร์ไว้ในหน้ากติกาของเกมนั้น", tag: "ดูเงื่อนไขในเกม" },
  { icon: "💎", name: "สล็อตแจ็คพอต", detail: "รางวัลแจ็คพอตขึ้นอยู่กับเงื่อนไขของแต่ละเกม ตรวจรายละเอียดก่อนเริ่มเดิมพัน", tag: "ตามเงื่อนไขเกม" },
  { icon: "🆕", name: "เกมใหม่อัปเดตต่อเนื่อง", detail: "มีเกมใหม่เข้าระบบอย่างต่อเนื่อง สามารถเปิดดูกติกาและช่วงเดิมพันได้ก่อนเล่น", tag: "อัปเดตสม่ำเสมอ" },
  { icon: "🔍", name: "ตรวจเพย์ไลน์และช่วงเดิมพัน", detail: "ก่อนเริ่มเล่นสามารถตรวจกติกา จำนวนเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของเกมได้", tag: "ตรวจก่อนเริ่มเล่น" },
  { icon: "🤝", name: "โปรแนะนำเพื่อนและคืนยอดเสีย", detail: "โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% คำนวณตามเงื่อนไขที่ระบบกำหนด", tag: "ตามเงื่อนไข" },
  { icon: "🎧", name: "แอดมินดูแล 24 ชั่วโมง", detail: "สมัครไม่ได้ Login ไม่ผ่าน เครดิตไม่เข้า หรือถอนล่าช้า แจ้งรายละเอียดและเวลาที่พบปัญหาได้", tag: "ตลอด 24 ชม." },
];

const chips = ["สล็อตเบทต่ำ", "เกมโบนัส", "สล็อตแจ็คพอต", "เกมใหม่", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ PLUSPSG"
  titleright="บริการสล็อตที่ใช้ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์"
  label="เข้าสู่ระบบ PLUSPSG และบริการสล็อตออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7a0304]/70 bg-[#140502]/92 p-6 shadow-[0_10px_30px_rgba(226,6,10,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e2060a]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e2060a]/55 bg-gradient-to-br from-[#ff4b18] via-[#e2060a] to-[#7a0304] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff6e0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c2a878]">เข้าสู่ระบบ PLUSPSG ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c2a878]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a0304] bg-[#0b0402]/95 py-3 pr-4 pl-12 text-[#e9d6ac] transition-all outline-none placeholder:text-[#c2a878] focus:border-[#e2060a] focus:ring-1 focus:ring-[#e2060a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c2a878]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a0304] bg-[#0b0402]/95 py-3 pr-4 pl-12 text-[#e9d6ac] transition-all outline-none placeholder:text-[#c2a878] focus:border-[#e2060a] focus:ring-1 focus:ring-[#e2060a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e9d6ac]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a0304] bg-[#0b0402] accent-[#e2060a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e9d6ac] transition-colors hover:text-[#fbbf14]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#e2060a]/50 bg-gradient-to-r from-[#fbbf14] via-[#ff4b18] to-[#e2060a] p-3.5 text-center font-black text-[#0b0402] shadow-[0_10px_30px_rgba(226,6,10,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(226,6,10,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c2a878]">
          <span class="h-px flex-1 bg-[#7a0304]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#7a0304]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7a0304]/80 bg-[#0b0402] px-2.5 py-1 text-[10px] font-bold text-[#fff6e0]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e2060a]/35 bg-[#0b0402]/80 px-2.5 py-1 text-[10px] font-bold text-[#e9d6ac]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fff6e0] transition-colors hover:text-[#fbbf14]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e2060a]/35 bg-[#140502]/92 p-5 shadow-[0_10px_30px_rgba(226,6,10,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e9d6ac]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#fff6e0] via-[#fbbf14] to-[#e2060a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c2a878] uppercase">
        <span>ประเภทเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7a0304] bg-[#0b0402]/95 px-3.5 py-2.5 transition-colors hover:border-[#e2060a]/60 hover:bg-[#240803]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9d6ac]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7a0304]/80 bg-[#0b0402] px-2.5 py-0.5 text-[10px] font-bold text-[#fff6e0]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c2a878]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e2060a]/30 bg-[#0b0402] px-3 py-1 text-[10px] font-bold text-[#fff6e0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c2a878]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
