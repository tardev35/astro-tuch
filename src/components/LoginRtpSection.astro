---
// ContentBoxTwo (the plain sibling) still carries the previous brand's gold and
// is inventory now; this box uses the CyberCut two-column shell, whose column
// labels render as <p> so a login widget never emits a heading.
import ContentBoxTwoCyberCut from "./ContentBoxTwoCyberCut.astro";

const menus = [
  { icon: "🎫", name: "หวยรัฐบาลไทย", detail: "เลือกรอบที่เปิดรับ ใส่เลขและจำนวนเงิน ตรวจโพยก่อนกดยืนยัน", tag: "รอบทางการ" },
  { icon: "🏦", name: "หวยออมสิน / ธ.ก.ส.", detail: "ตรวจรอบเปิดรับและเวลาปิดรับของแต่ละงวดได้ในระบบ", tag: "ตรวจรอบก่อนแทง" },
  { icon: "🏵️", name: "หวยลาว / หวยฮานอย", detail: "จัดหมวดหมู่ไว้ให้ค้นหาง่าย มีหลายรอบต่อวันให้เลือกส่งโพย", tag: "หลายรอบต่อวัน" },
  { icon: "📈", name: "หวยหุ้น", detail: "อ้างอิงผลตามตลาดหุ้นที่ระบบกำหนด ดูรอบที่เปิดรับได้ล่วงหน้า", tag: "อ้างอิงตลาดหุ้น" },
  { icon: "💵", name: "เรท 2 ตัว 100 3 ตัว 1,000", detail: "ตรวจอัตราจ่ายและวงเงินรับแทงที่แสดงในระบบก่อนยืนยันโพย", tag: "จ่ายเต็มจริง" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ทำรายการฝากเครดิตผ่านระบบอัตโนมัติแล้วเริ่มส่งโพยได้ทันที", tag: "ปล่อยยอดทันที" },
  { icon: "🛎️", name: "เจ้าหน้าที่ดูแลตลอดเวลา", detail: "ติดต่อได้ทั้งเรื่องสมัครสมาชิก ฝากถอน และการส่งโพย", tag: "แจ้งปัญหาได้" },
];

const chips = ["หวยรัฐบาล", "หวยออมสิน", "หวย ธ.ก.ส.", "หวยลาว", "หวยฮานอย", "หวยหุ้น", "มือถือ"];
---

<ContentBoxTwoCyberCut titleleft="เข้าสู่ระบบ 7LOTTO" titleright="ประเภทหวยและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ 7LOTTO และประเภทหวยที่เปิดรับแทงทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a3060c]/40 bg-[#0d0304]/92 p-6 shadow-[0_10px_30px_rgba(255,42,48,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#5c0203]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a3060c]/50 bg-gradient-to-br from-[#ff6b70] via-[#ff2a30] to-[#5c0203] text-xl shadow-inner">
          🎫
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff2a30]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9aa1ad]">เข้าสู่ระบบ 7LOTTO ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a3060c]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2b0a0c] bg-[#0a0304]/95 py-3 pr-4 pl-12 text-[#d8dae0] transition-all outline-none placeholder:text-[#9aa1ad]/60 focus:border-[#ff2a30] focus:ring-1 focus:ring-[#ff2a30]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a3060c]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2b0a0c] bg-[#0a0304]/95 py-3 pr-4 pl-12 text-[#d8dae0] transition-all outline-none placeholder:text-[#9aa1ad]/60 focus:border-[#ff2a30] focus:ring-1 focus:ring-[#ff2a30]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9aa1ad]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2b0a0c] bg-[#0a0304] accent-[#ff2a30]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9aa1ad] transition-colors hover:text-[#ff6b70]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#a3060c]/50 bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] p-3.5 text-center font-black text-[#2b070a] shadow-[0_10px_30px_rgba(255,42,48,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,42,48,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9aa1ad]/70">
          <span class="h-px flex-1 bg-[#2b0a0c]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2b0a0c]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a3060c]/40 bg-[#0a0304] px-2.5 py-1 text-[10px] font-bold text-[#ff2a30]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#d3d6db]/30 bg-[#0a0304]/80 px-2.5 py-1 text-[10px] font-bold text-[#d3d6db]"><span aria-hidden="true">🕐</span> เจ้าหน้าที่ดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff2a30] transition-colors hover:text-[#ff6b70]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d3d6db]/25 bg-[#0d0304]/92 p-5 shadow-[0_10px_30px_rgba(211,214,219,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9aa1ad]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9aa1ad]/80 uppercase">
        <span>ประเภทหวย / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2b0a0c] bg-[#0a0304]/95 px-3.5 py-2.5 transition-colors hover:border-[#ff2a30]/50 hover:bg-[#1a0507]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d8dae0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a3060c]/40 bg-[#0a0304] px-2.5 py-0.5 text-[10px] font-bold text-[#ff2a30]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9aa1ad]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d3d6db]/25 bg-[#0a0304] px-3 py-1 text-[10px] font-bold text-[#d3d6db]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9aa1ad]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwoCyberCut>
