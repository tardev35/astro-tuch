---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the brief states: เกมสล็อต PGSOFT ทั้งเกม
// ยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอต, ค้นหาเกมและตรวจสอบรายละเอียดก่อน
// เข้าเล่นได้, รูปแบบ/อัตราเดิมพัน/ฟีเจอร์/เงื่อนไขต่างกันไปในแต่ละเกม,
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%, ฝากถอนผ่านระบบอัตโนมัติ และรองรับ
// สมาร์ตโฟน แท็บเล็ต คอมพิวเตอร์.
const menus = [
  { icon: "🎰", name: "สล็อต PGSOFT", detail: "หมวดเกมสล็อตจากค่าย PGSOFT ตรวจสอบรูปแบบเกมและอัตราเดิมพันได้จากหน้ารายละเอียดของแต่ละเกม", tag: "ค่ายหลัก" },
  { icon: "🔥", name: "เกมยอดนิยม", detail: "รวมเกมที่สมาชิกเปิดเล่นบ่อยไว้ในหมวดเดียว พร้อมรายละเอียดกติกาให้ดูก่อนเริ่มเดิมพัน", tag: "เปิดเล่นบ่อย" },
  { icon: "🆕", name: "เกมใหม่", detail: "เกมที่เพิ่งเปิดให้บริการ ตรวจสอบฟีเจอร์และเงื่อนไขของเกมได้ก่อนกดเข้าเล่น", tag: "อัปเดตต่อเนื่อง" },
  { icon: "🎁", name: "เกมโบนัส", detail: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว เงื่อนไขการเข้าฟีเจอร์แสดงไว้ในหน้าเกมแต่ละเกม", tag: "อ่านเงื่อนไขก่อน" },
  { icon: "💎", name: "สล็อตแจ็คพอต", detail: "เกมสล็อตที่มีรางวัลแจ็คพอต ควรศึกษากติกาและอัตราเดิมพันของเกมก่อนลงเดิมพันทุกครั้ง", tag: "ผลลัพธ์ไม่การันตี" },
  { icon: "🔍", name: "ค้นหาเกม", detail: "ค้นหาเกมตามชื่อหรือหมวดหมู่ และเปิดดูรายละเอียดของเกมได้ก่อนเข้าเล่นจริง", tag: "ดูก่อนเข้าเล่น" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะธุรกรรมได้เองตลอด 24 ชั่วโมง", tag: "จัดการเครดิตเอง" },
  { icon: "🤝", name: "โปรโมชั่นสมาชิก", detail: "ตรวจสอบเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขของแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก่อนกดรับ", tag: "ตามเงื่อนไขแต่ละรายการ" },
];

const chips = ["สล็อต PGSOFT", "เกมยอดนิยม", "เกมใหม่", "เกมโบนัส", "สล็อตแจ็คพอต", "ฝากถอนออโต้", "แอดมิน LINE 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ AKA99"
  titleright="หมวดเกมสล็อตและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ AKA99 และหมวดเกมสล็อตออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#1e4b9e]/70 bg-[#061436]/92 p-6 shadow-[0_10px_30px_rgba(11,108,240,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0b6cf0]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#0b6cf0]/55 bg-gradient-to-br from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eaf3fd]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c3ced9]/80">เข้าสู่ระบบ AKA99 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c3ced9]/80">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1e4b9e] bg-[#03081c]/95 py-3 pr-4 pl-12 text-[#cfdcea] transition-all outline-none placeholder:text-[#c3ced9]/60 focus:border-[#0b6cf0] focus:ring-1 focus:ring-[#0b6cf0]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c3ced9]/80">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1e4b9e] bg-[#03081c]/95 py-3 pr-4 pl-12 text-[#cfdcea] transition-all outline-none placeholder:text-[#c3ced9]/60 focus:border-[#0b6cf0] focus:ring-1 focus:ring-[#0b6cf0]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfdcea]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1e4b9e] bg-[#03081c] accent-[#0b6cf0]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfdcea] transition-colors hover:text-[#9dd2fa]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#4aa3ff]/50 bg-gradient-to-r from-[#4aa3ff] via-[#0b6cf0] to-[#0a2a6b] p-3.5 text-center font-black text-[#02060f] shadow-[0_10px_30px_rgba(11,108,240,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(11,108,240,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c3ced9]/80">
          <span class="h-px flex-1 bg-[#1e4b9e]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#1e4b9e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#1e4b9e]/80 bg-[#03081c] px-2.5 py-1 text-[10px] font-bold text-[#eaf3fd]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#0b6cf0]/35 bg-[#03081c]/80 px-2.5 py-1 text-[10px] font-bold text-[#cfdcea]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#eaf3fd] transition-colors hover:text-[#9dd2fa]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0b6cf0]/30 bg-[#061436]/92 p-5 shadow-[0_10px_30px_rgba(11,108,240,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfdcea]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#0b6cf0] via-[#eaf3fd] to-[#c3ced9] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c3ced9]/80 uppercase">
        <span>หมวดเกมสล็อต / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1e4b9e] bg-[#03081c]/95 px-3.5 py-2.5 transition-colors hover:border-[#0b6cf0]/60 hover:bg-[#0a1836]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfdcea]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#1e4b9e]/80 bg-[#03081c] px-2.5 py-0.5 text-[10px] font-bold text-[#eaf3fd]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cfdcea]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0b6cf0]/30 bg-[#03081c] px-3 py-1 text-[10px] font-bold text-[#eaf3fd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c3ced9]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
