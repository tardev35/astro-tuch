---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// MGM9 is a full-service casino brand, so every row below stays inside what the
// brief states: หมวดเกมบาคาร่า คาสิโนสด สล็อต ฟุตบอล และหวยออนไลน์ในบัญชีเดียว,
// การตรวจกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกมก่อนยืนยันรายการ,
// การยึดวงเงินและข้อกำหนดที่ระบบแสดง ณ เวลาทำรายการ, ระบบฝากถอนที่รองรับทั้ง
// วอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด, การตรวจยอด ส่งคำขอถอน และติดตามสถานะ
// ธุรกรรมผ่านบัญชีสมาชิก, การ Login เพื่อตรวจสอบโปรโมชั่นและสิทธิ์โบนัสในแต่ละรอบ,
// โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ตามเงื่อนไขและรอบที่กำหนด.
// Nothing here quotes a payout figure, a win rate, or a promotion the brief does
// not state — the only two bonus figures on this page are the brief's own 0.8%
// และ 0.3%.
const menus = [
  { icon: "🎴", name: "เลือกหมวดเกมที่เปิดบริการ", detail: "บาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอล และหวยออนไลน์ตามรอบที่เปิด เลือกได้จากบัญชีเดียว", tag: "บัญชีเดียวครบ" },
  { icon: "📋", name: "ตรวจกติกาและอัตราจ่ายก่อน", detail: "ตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกมก่อนกดยืนยันรายการทุกครั้ง", tag: "ดูก่อนยืนยัน" },
  { icon: "📌", name: "ยึดวงเงินที่ระบบแสดง", detail: "เงื่อนไขไม่อั้นจ่ายและไม่มีขั้นต่ำให้ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการ เพราะแต่ละเกมหรือโต๊ะอาจกำหนดต่างกัน", tag: "ดูวงเงินจริง" },
  { icon: "🏦", name: "ฝากถอนวอลเลทและธนาคาร", detail: "รองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด ตรวจสอบยอด ฝากเครดิต และส่งคำขอถอนได้ด้วยตัวเอง", tag: "รองรับทุกธนาคาร" },
  { icon: "🧾", name: "ติดตามสถานะธุรกรรมเอง", detail: "ตรวจสอบยอดคงเหลือ ประวัติธุรกรรม และสถานะคำขอถอนผ่านบัญชีสมาชิกได้จากหน้าเดียว", tag: "เช็กสถานะเอง" },
  { icon: "🎁", name: "Login เพื่อดูสิทธิ์โบนัส", detail: "Login เข้าบัญชีเพื่อตรวจสอบโปรโมชั่นและสิทธิ์โบนัสที่พร้อมให้กดรับได้ในแต่ละรอบ", tag: "ดูสิทธิ์ทุกรอบ" },
  { icon: "👥", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัว เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัส 0.8% ตามเงื่อนไข", tag: "ตรวจรอบคำนวณ" },
  { icon: "🔄", name: "คืนยอดเสีย 0.3% ตามรอบ", detail: "สมาชิกที่มียอดเสียเข้าเงื่อนไขตรวจสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ได้ ควรอ่านเงื่อนไขรอบรับและการถอนก่อนใช้สิทธิ์", tag: "อ่านเงื่อนไข" },
];

const chips = ["บาคาร่าออนไลน์", "คาสิโนสด", "สล็อตออนไลน์", "เดิมพันฟุตบอล", "หวยออนไลน์", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมินดูแล 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ MGM9" titleright="จุดที่ควรตรวจสอบก่อนยืนยันรายการกับ MGM9" label="เข้าสู่ระบบ MGM9 และรายการจุดที่ควรตรวจสอบก่อนยืนยันรายการ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#4aa4f4]/40 bg-[#062a72]/92 p-6 shadow-[0_10px_30px_rgba(74,164,244,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#5ee7ff]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#4aa4f4]/60 bg-gradient-to-br from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#9ad4ff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a8c8ea]">เข้าสู่ระบบ MGM9 เพื่อเลือกเกมบาคาร่า สล็อต บอล หรือหวย ตรวจกติกาและอัตราจ่ายก่อนยืนยัน ติดตามประวัติธุรกรรม และกดรับโปรโมชั่นได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8c8ea]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4aa4f4]/45 bg-[#01102e]/95 py-3 pr-4 pl-12 text-[#d3e6ff] transition-all outline-none placeholder:text-[#a8c8ea] focus:border-[#4aa4f4] focus:ring-1 focus:ring-[#4aa4f4]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8c8ea]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4aa4f4]/45 bg-[#01102e]/95 py-3 pr-4 pl-12 text-[#d3e6ff] transition-all outline-none placeholder:text-[#a8c8ea] focus:border-[#4aa4f4] focus:ring-1 focus:ring-[#4aa4f4]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d3e6ff]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4aa4f4]/45 bg-[#01102e] accent-[#4aa4f4]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d3e6ff] transition-colors hover:text-[#9ad4ff]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#1f74d6]/55 bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] p-3.5 text-center font-black text-[#01102e] shadow-[0_10px_30px_rgba(74,164,244,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(74,164,244,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a8c8ea]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#4aa4f4]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#4aa4f4]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5ee7ff]/45 bg-[#01102e] px-2.5 py-1 text-[10px] font-bold text-[#5ee7ff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#4aa4f4]/40 bg-[#01102e]/80 px-2.5 py-1 text-[10px] font-bold text-[#4aa4f4]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#4aa4f4] transition-colors hover:text-[#9ad4ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#4aa4f4]/40 bg-[#062a72]/92 p-5 shadow-[0_10px_30px_rgba(74,164,244,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d3e6ff]">เล่นบาคาร่า สล็อต บอล และหวยจากบัญชีเดียว ตรวจกติกาและอัตราจ่ายก่อนยืนยัน แล้วติดตามธุรกรรมได้ด้วยตัวเอง</span>
          <div class="bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5ee7ff]/55 bg-[#021b43]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5ee7ff] shadow-[0_0_8px_rgba(94,231,255,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#5ee7ff] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a8c8ea] uppercase">
        <span>ขั้นตอนเลือกเกม ฝากถอน และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0b4ea8]/60 bg-[#01102e]/95 px-3.5 py-2.5 transition-colors hover:border-[#4aa4f4]/60 hover:bg-[#021b43]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d3e6ff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#4aa4f4]/45 bg-[#01102e] px-2.5 py-0.5 text-[10px] font-bold text-[#4aa4f4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a8c8ea]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#4aa4f4]/35 bg-[#01102e] px-3 py-1 text-[10px] font-bold text-[#4aa4f4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a8c8ea]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนยืนยันรายการ เกม โต๊ะ หรือประเภทการเดิมพันแต่ละรายการอาจกำหนดกติกา อัตราจ่าย และวงเงินต่างกัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
        ส่วนรายชื่อธนาคาร วอลเลท ยอดฝากขั้นต่ำ และวงเงินถอน ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
