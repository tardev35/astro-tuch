---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// NAZA99 เป็นเว็บสล็อตออนไลน์ ไม่ใช่เว็บหวยและไม่ใช่เว็บบอล แผงฝั่งขวารอบนี้ถูกเขียนใหม่
// ทั้งแผงจากคำของบรีฟรอบนี้เอง คือ เกมสล็อตหลายสไตล์จากค่ายยอดนิยมในระบบเดียว · เกมโบนัส
// ฟรีสปิน ตัวคูณ · และสามเกมที่บรีฟระบุชื่อไว้เองคือ Mahjong Ways 2 (ธีมไพ่นกกระจอก
// ตัวคูณ+ฟรีสปิน), Fortune Tiger (ธีมเสือนำโชค วงล้อเข้าใจง่าย) และ Sweet Bonanza
// (ธีมขนม/ผลไม้ จ่ายแบบกลุ่มสัญลักษณ์ + ฟรีสปิน + ตัวคูณ) ส่วนแผง "จุดที่ควรตรวจก่อนเริ่มเล่น"
// ประกอบจากประโยคเตือนของบรีฟล้วนๆ คือ ผลลัพธ์ของเกมสล็อตเป็นแบบสุ่มจึงใช้คำว่าแตกหนัก
// รับประกันผลลัพธ์ไม่ได้, ควรตรวจกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ก่อนเริ่มเล่น,
// แต่ละรายการโปรโมชั่นอาจกำหนดค่ายเกมและเงื่อนไขต่างกันจึงควรอ่านก่อนกดรับ และจำนวนเกม
// กับช่วงอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ
//
// ไฟล์นี้เคยเป็นตารางรายการหวย ซึ่งเป็นศัพท์ของเว็บหวย ไม่ใช่ของเว็บสล็อต — ป้ายทุกใบเป็น
// ศัพท์สล็อตทั้งหมด และคำว่า หวย/โพย/งวด/อัตราจ่าย ไม่เหลืออยู่ในไฟล์นี้แล้ว ชื่อไฟล์ยังมีคำว่า
// Rtp ติดมาจากรอบเก่า แต่คำว่า RTP ของค่ายเป็นคำที่บรีฟรอบนี้ห้ามอ้าง จึงไม่มีอยู่ในเนื้อหา
//
// รอบก่อน (หวย365) แผงนี้ขายมุม "แนวทางหวย / สถิติย้อนหลัง" และรอบก่อนหน้านั้นขาย
// "เลขเด็ด / เลขดัง" — บรีฟรอบนี้ไม่ได้เขียนมุมไหนไว้เลย ทั้งหมดจึงถูกถอดออก ไม่ใช่เขียนใหม่
// ด้วยชื่อแบรนด์ใหม่
// ห้ามใส่ชื่อค่ายเกมอื่นนอกจากสามเกมที่บรีฟระบุ ห้ามใส่เลข RTP รายเกม ชื่อผู้ให้บริการ
// ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือเวลาฝากถอนออโต้ — บรีฟ NAZA99
// ไม่ได้ให้ไว้เลยสักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ
// ตัวเลขที่ใช้ได้มีเท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 เกม ·
// สมัคร 3 ขั้นตอน · 24 ชั่วโมง
const gameHighlights = [
  { icon: "🀄", name: "Mahjong Ways 2", detail: "ธีมไพ่นกกระจอก จุดเด่นอยู่ที่ระบบตัวคูณและฟีเจอร์ฟรีสปิน แต่ละรอบจึงมีรายละเอียดให้ติดตามมากกว่าสล็อตพื้นฐาน" },
  { icon: "🐯", name: "Fortune Tiger", detail: "ธีมเสือนำโชคและรูปแบบวงล้อที่เข้าใจง่าย มีฟีเจอร์ภายในเกมที่ช่วยเพิ่มจังหวะการเล่น" },
  { icon: "🍬", name: "Sweet Bonanza", detail: "ธีมขนมและผลไม้ ใช้ระบบจ่ายแบบกลุ่มสัญลักษณ์ พร้อมฟรีสปินและตัวคูณเป็นองค์ประกอบหลัก" },
  { icon: "🆕", name: "หมวดเกมใหม่", detail: "จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ จึงควรดูรายการล่าสุดจากหมวดเกมใหม่" },
];

// สี่ข้อนี้ประกอบจากประโยคเตือนของบรีฟเองทั้งหมด — ผลลัพธ์ของเกมสล็อตเป็นแบบสุ่ม,
// ควรตรวจกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น, แต่ละรายการ
// โปรโมชั่นอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน และช่วงอัปเดตเกมขึ้นอยู่กับค่าย
const beforeSpinChecks = [
  {
    icon: "🎲",
    name: "ผลลัพธ์ของเกมเป็นแบบสุ่ม",
    detail: "คำว่า “แตกหนัก” หรือ “ปั่นแตกง่ายที่สุด” ไม่สามารถใช้รับประกันผลลัพธ์ได้ เนื่องจากเกมสล็อตมีผลลัพธ์แบบสุ่ม",
    tag: "อ่านก่อนปั่น",
  },
  {
    icon: "📋",
    name: "กติกาและช่วงเดิมพันของเกม",
    detail: "ควรตรวจสอบกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่น เพราะแต่ละเกมมีรูปแบบการจ่ายไม่เหมือนกัน",
    tag: "ดูก่อนเริ่มเล่น",
  },
  {
    icon: "🎁",
    name: "เงื่อนไขของแต่ละโปรโมชั่น",
    detail: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% เป็นสิทธิ์ตามแคมเปญที่เปิดในแต่ละเดือน แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🔐",
    name: "ความปลอดภัยของบัญชีสมาชิก",
    detail: "ควรตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น ทั้งตอนสมัครและตอนติดต่อแอดมิน",
    tag: "ไม่บอกใคร",
  },
];

const chips = ["สล็อตออนไลน์", "ค่ายเกม", "เกมโบนัส", "ฟรีสปิน", "ตัวคูณ", "วงล้อ", "สัญลักษณ์", "อัปเดตเกมใหม่", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%", "สมัครสมาชิก", "Login", "แอดมิน 24 ชั่วโมง"];

// NAZA99 (รอบทอง-ดำ 2026-10-02): โลโก้เป็นตัวอักษรทองเมทัลลิกล้วนบนพื้นโปร่ง (#e4b34d นำ
// รองด้วยแชมเปญ #fdf2ac) งานอาร์ตเป็นฉากทองอร่ามบนพื้นดำอมน้ำตาล มีเหรียญทองลอยเต็มภาพ
// ริ้วแสงทอง วงล้อสล็อต 777 และกองชิป แบรนด์นี้จึงเป็นสีเดียว: ทอง ไม่มีสีคู่ตรงข้าม สองแผง
// ถูกแยกด้วยระดับความสว่างของทองแทน — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #e4b34d ส่วนแผง
// เกมแนะนำอยู่ในกรอบทองลึก #8a5f12 ทั้งคู่วางบนผิวการ์ด #140c02 ช่องกรอกและชิปตกลงไปที่
// พื้นดำสนิท #0a0501 บรรทัดเด่นไล่เฉดแชมเปญ #fdf2ac → ทองแบรนด์ #e4b34d → ทองเข้ม
// #c08f2b ปุ่มเข้าสู่ระบบเป็นทองเต็มตัวบนหมึกบนพื้นทอง #1a1000 ตามกฎคอนทราสต์ที่ว่าพื้นทอง
// ต้องใช้หมึกเข้มเสมอ และไล่เฉดใต้หมึกเข้มห้ามจบมืดกว่า #c08f2b (7.0:1) ปุ่มไลน์ยังคงสีเขียว
// #00B900 ของแพลตฟอร์มซึ่งห้ามรีแมป ข้อความรองใช้สีเนื้อความ #f3e8cf แบบลดความทึบ
// ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
//
// ชุดแดงสด-ทองของ หวย365 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406
// #180303 #f6e7e0 #d9b9b1) และชุดแดงหม่นของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4
// #1c0606 #2b0909) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`เกมสล็อตแนะนำ ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมเกมสล็อตแนะนำประจำหมวดทั้ง Mahjong Ways 2 Fortune Tiger และ Sweet Bonanza รวมถึงจุดที่ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e4b34d]/45 bg-[#140c02]/94 p-6 shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e4b34d]/24 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4b34d]/70 bg-gradient-to-br from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] text-xl text-[#1a1000] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf2ac]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f3e8cf]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือเพื่อเลือกค่ายและเกมสล็อตที่ต้องการ พร้อมตรวจสอบกติกาและช่วงเดิมพันของเกมก่อนเริ่มเล่น แล้วกลับมาติดตามเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f3e8cf]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8a5f12] bg-[#0a0501]/95 py-3 pr-4 pl-12 text-[#f3e8cf] transition-all outline-none placeholder:text-[#f3e8cf]/50 focus:border-[#e4b34d] focus:ring-1 focus:ring-[#fdf2ac]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f3e8cf]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#8a5f12] bg-[#0a0501]/95 py-3 pr-4 pl-12 text-[#f3e8cf] transition-all outline-none placeholder:text-[#f3e8cf]/50 focus:border-[#e4b34d] focus:ring-1 focus:ring-[#fdf2ac]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f3e8cf]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8a5f12] bg-[#0a0501] accent-[#e4b34d]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f3e8cf]/70 transition-colors hover:text-[#fdf2ac]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fdf2ac]/70 bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] p-3.5 text-center font-black text-[#1a1000] shadow-[0_10px_30px_rgba(228,179,77,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,242,172,0.55)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f3e8cf]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a5f12]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a5f12]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#8a5f12] bg-[#0a0501] px-2.5 py-1 text-[10px] font-bold text-[#f3e8cf]"><span aria-hidden="true">🎰</span> สล็อตออนไลน์</span>
            <span class="rounded-full border border-[#e4b34d]/40 bg-[#0a0501]/85 px-2.5 py-1 text-[10px] font-bold text-[#e4b34d]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e4b34d] transition-colors hover:text-[#fdf2ac]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a5f12] bg-[#140c02]/94 p-5 shadow-[0_10px_30px_rgba(10,5,1,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f3e8cf]/70">
            {BRAND_NAME} รวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว ทั้งเกมโบนัส ฟรีสปิน ตัวคูณ และฟีเจอร์ใหม่ที่ช่วยเพิ่มรูปแบบการเล่น เลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียวได้สะดวก
          </span>
          <div class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] bg-clip-text text-xl font-black text-transparent sm:text-2xl">Mahjong Ways 2 · Fortune Tiger · Sweet Bonanza</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#8a5f12] bg-[#0a0501]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e4b34d] shadow-[0_0_8px_rgba(228,179,77,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fdf2ac] uppercase">ตามรายการที่ค่ายเปิดให้</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f3e8cf]/65 uppercase">
        <span>เกมแนะนำประจำหมวด</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameHighlights.map((g) => (
            <div class="rounded-xl border border-[#8a5f12] bg-[#0a0501]/95 px-3.5 py-2.5 transition-colors hover:border-[#e4b34d]/70 hover:bg-[#241404]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fdf2ac]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {g.icon}
                </span>
                <span class="truncate">{g.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f3e8cf]/70">{g.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f3e8cf]/70">
        รายการเกมที่เปิดให้ใช้งานจริงขึ้นอยู่กับค่ายและผู้ให้บริการในแต่ละช่วง จึงควรตรวจสอบว่าเกมที่สนใจเปิดให้บริการอยู่ในระบบหรือไม่ก่อนเริ่มเล่นทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f3e8cf]/65 uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSpinChecks.map((k) => (
            <div class="rounded-xl border border-[#8a5f12] bg-[#0a0501]/95 px-3.5 py-2.5 transition-colors hover:border-[#c08f2b]/70 hover:bg-[#241404]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e8cf]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e4b34d]/50 bg-[#0a0501] px-2.5 py-0.5 text-[10px] font-bold text-[#e4b34d]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f3e8cf]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8a5f12] bg-[#0a0501] px-3 py-1 text-[10px] font-bold text-[#f3e8cf]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f3e8cf]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว การรองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ และการเลือกเกม ตรวจสอบโปรโมชั่น พร้อมติดตามรายการจากบัญชีเดียว
        ส่วนโบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% เป็นสิทธิ์ตามแคมเปญที่เปิดในแต่ละเดือน แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับ จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ
        และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
