// แล้ว จุดเขียวตรงนี้จึงจะอ่านเป็นสีแบรนด์มากกว่าสถานะ
//
// ชุดม่วงนีออน-ทองของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05 #190633 #1e0a3c #17062e #0a0117
// rgba(164,53,240,α) rgba(251,228,85,α) rgba(255,210,61,α)) ชุดแดงแล็กเกอร์-ทองของ
// PIGPG (#d4200d #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402 #fdc4a3 #3a0d07
// #2a0806 #120302 #fdeedd) ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #cc920a #f7d14e
// #0d2414 #e8f2e6) ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #fce604 #fff48a
// #c9a703 #0a1726 #dbeafe) และชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33
// #8a6410 #c9881f #4a3407 #17130a #060402 #f3e7cd) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`ระบบและสิทธิ์ที่ ${BRAND_NAME} รวมไว้ในบัญชีเดียว`}
  iconleft="🔐"
  iconright="🦍"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการระบบและสิทธิ์ที่รวบรวมไว้ในบัญชีเดียว ทั้งเกมสล็อตหลายรูปแบบในแพลตฟอร์มเดียว สล็อตเบทต่ำที่เริ่มต้น 1 บาท การตรวจสอบเครดิต การติดตามรายการต่างๆ ตารางจ่าย โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ระบบฝากถอนเข้าบริษัทโดยตรง และจุดที่ควรตรวจสอบก่อนใช้งานทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f2c230]/50 bg-[#14380a] p-6 shadow-[0_0_28px_rgba(242,194,48,0.2)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1a5c04]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a87a08] bg-gradient-to-br from-[#e9f7d6] via-[#ffe066] to-[#f2c230] text-xl text-[#06220a] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f2c230]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bde397]">
            เข้าสู่ระบบ {BRAND_NAME} ผ่านทางเข้าเล่นบนมือถือได้ตลอด 24 ชั่วโมง แล้วเลือกค่าย ดูรายการเกมสล็อต ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bde397]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1a5c04] bg-[#051400] py-3 pr-4 pl-12 text-[#e9f7d6] transition-all outline-none placeholder:text-[#bde397]/70 focus:border-[#8ce023] focus:ring-1 focus:ring-[#8ce023]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bde397]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1a5c04] bg-[#051400] py-3 pr-4 pl-12 text-[#e9f7d6] transition-all outline-none placeholder:text-[#bde397]/70 focus:border-[#8ce023] focus:ring-1 focus:ring-[#8ce023]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bde397]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1a5c04] bg-[#051400] accent-[#8ce023]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bde397] transition-colors hover:text-[#8ce023]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#5cc211]/60 bg-gradient-to-b from-[#14380a] to-[#051400] p-3.5 text-center font-black text-[#e9f7d6] shadow-[0_0_12px_rgba(140,224,35,0.28)] transition-all hover:scale-[1.02] hover:border-[#8ce023] hover:text-[#f2c230]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#bde397]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#1a5c04]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#1a5c04]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a87a08]/55 bg-[#051400] px-2.5 py-1 text-[10px] font-bold text-[#f2c230]"><span aria-hidden="true">🎰</span> ฐานเว็บสล็อตหลัก</span>
            <span class="rounded-full border border-[#5cc211]/60 bg-[#051400] px-2.5 py-1 text-[10px] font-bold text-[#8ce023]"><span aria-hidden="true">📱</span> เข้าเล่น 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f2c230] transition-colors hover:text-[#ffe066]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#5cc211]/55 bg-[#14380a] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bde397]">
            {BRAND_NAME} รวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว เลือกค่าย ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียว พร้อมทางเข้าเล่นผ่านมือถือตลอด 24 ชั่วโมง
          </span>
          <div class="bg-gradient-to-r from-[#e9f7d6] via-[#ffe066] to-[#f2c230] bg-clip-text text-xl font-black text-transparent sm:text-2xl">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#a87a08] bg-[#051400] px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f2c230] shadow-[0_0_8px_rgba(242,194,48,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f2c230] uppercase">ตามรอบที่เว็บไซต์กำหนด</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bde397] uppercase">
        <span>ระบบและสิทธิ์ที่รวมไว้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          systemFeatures.map((t) => (
            <div class="rounded-xl border border-[#1a5c04] bg-[#051400] px-3.5 py-2.5 transition-colors hover:border-[#8ce023]/80 hover:bg-[#0f2e05]">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#f2c230]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#bde397]">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#bde397]">
        การยืนยันว่าเป็นเว็บแท้และปลอดภัยควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ จึงควรดูรายละเอียดที่แสดงในระบบก่อนใช้งานทุกครั้ง ส่วนการเลือกเกมสล็อตเบทต่ำช่วยให้แบ่งงบสำหรับแต่ละรอบได้ชัดเจนขึ้น
        แต่ไม่ได้ หมายความว่าจะมีโอกาสชนะมากกว่าเกมเดิมพันสูง เนื่องจากผลการหมุนเป็นแบบสุ่ม และแต่ละเกมอาจกำหนดยอดขั้นต่ำแตกต่างกัน
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bde397] uppercase">
        <span>จุดที่ควรตรวจก่อนใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeUseChecks.map((k) => (
            <div class="rounded-xl border border-[#1a5c04] bg-[#051400] px-3.5 py-2.5 transition-colors hover:border-[#a87a08]/80 hover:bg-[#0f2e05]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9f7d6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#5cc211]/60 bg-[#0f2e05] px-2.5 py-0.5 text-[10px] font-bold text-[#8ce023]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bde397]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1a5c04] bg-[#051400] px-3 py-1 text-[10px] font-bold text-[#e9f7d6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#bde397]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวบรวมเกมสล็อตหลายรูปแบบไว้ในแพลตฟอร์มเดียว ตั้งแต่เกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ ไปจนถึงเกมที่มีฟีเจอร์พิเศษ พร้อมการเลือกค่าย การตรวจสอบเครดิต
        และการติดตาม รายการต่างๆ จากบัญชีเดียว บางเกมรองรับการเดิมพันเริ่มต้นที่ 1 บาท ตามช่วงเดิมพันที่ผู้ให้บริการกำหนด และควรตรวจตารางจ่ายกับรายละเอียดของแต่ละเกมก่อนเริ่มเล่น ส่วนโบนัสคืนยอดเสีย 0.3%
        และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด จึงควรตรวจสอบรอบตัดยอด ค่ายเกมที่เข้าร่วม และเงื่อนไขของแต่ละโปรโมชั่นก่อนกดรับ ฝั่งธุรกรรมควรตรวจยอดเงิน ชื่อบัญชี และรายละเอียดปลายทางก่อนยืนยันรายการทุกครั้ง
        หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม
      </div>
    </div>
  </div>
</ContentBoxTwo>
