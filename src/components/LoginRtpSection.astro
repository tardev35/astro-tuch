---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "กีฬาคาสิโนเว็บตรงที่รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว
// ในเครือตรงแบรนด์ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์" ตารางฝั่งขวาจึงเป็นหมวดเกมกับ
// รายการที่ brief ระบุไว้เอง ทุกแถวอ้างจากประโยคของ brief ล้วนๆ — กีฬา คาสิโนสด
// สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ, เครือตรงแบรนด์ลิขสิทธิ์แท้ไม่ผ่าน
// เอเย่นต์, บัญชีเดียวใช้ได้ทั้งมือถือและคอมพิวเตอร์, โปรโมชั่นบางรายการกดรับหลัง
// สมัครได้โดยไม่ต้องฝากก่อน, โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย 0.3%, สมัคร
// ผ่านมือถือ 3 ขั้นตอน และแอดมินดูแลตลอด 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย จำนวน
// เกม ค่า RTP อัตราจ่าย ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
// และไม่มีหมวดลอตเตอรี่ที่ไหนเลย เพราะ brief ของ UFAGOOL ไม่ได้พูดถึงมัน
const catalogue = [
  {
    icon: "⚽",
    name: "กีฬา",
    detail: "เลือกการเดิมพันกีฬาได้จากหน้าเดียวกับเกมหมวดอื่น ใช้งานผ่านบัญชีเดียวโดยไม่ต้องสลับหลายระบบ",
    rate: "บัญชีเดียว",
  },
  {
    icon: "🎴",
    name: "คาสิโนสด",
    detail: "อยู่ในชุดเดียวกับกีฬาและสล็อต เข้าใช้งานจากบัญชีเดิมได้ทันทีตามรายการที่เปิดให้บริการ",
    rate: "ระบบเดียว",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "เลือกเกมจากหลายค่ายได้จากหน้าเดียว ตรวจสอบหมวดเกมและค่ายที่รองรับได้ก่อนเข้าใช้งาน",
    rate: "หลายค่าย",
  },
  {
    icon: "🎮",
    name: "เกมรูปแบบอื่น",
    detail: "เกมออนไลน์ประเภทอื่นตามรายการที่เปิดให้บริการ ดูหมวดที่รองรับได้จากหน้าเว็บไซต์ก่อนเข้าเล่น",
    rate: "ตามรายการที่เปิด",
  },
  {
    icon: "🏷️",
    name: "เครือตรงแบรนด์ลิขสิทธิ์แท้",
    detail: "เชื่อมต่อผ่านเครือแบรนด์โดยตรงตามข้อมูลของเว็บไซต์ ไม่ผ่านเอเย่นต์ ช่วยลดขั้นตอนการใช้งาน",
    rate: "ไม่ผ่านเอเย่นต์",
  },
  {
    icon: "📱",
    name: "บัญชีเดียวทุกอุปกรณ์",
    detail: "เข้าถึงเกมต่าง ๆ ได้สะดวกผ่านบัญชีเดียวทั้งบนมือถือและคอมพิวเตอร์",
    rate: "มือถือและคอม",
  },
  {
    icon: "🎁",
    name: "สิทธิ์ที่กดรับหลังสมัครได้",
    detail: "โปรโมชั่นบางรายการตรวจสอบและกดรับหลังสมัครได้โดยไม่ต้องฝากก่อนตามที่ระบบกำหนด ควรอ่านเงื่อนไขก่อนรับ",
    rate: "ไม่ต้องฝากก่อน",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม ตรวจสอบยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ผ่านบัญชีสมาชิกได้",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้จากหน้าโปรโมชั่น",
    rate: "0.3%",
  },
  {
    icon: "💬",
    name: "แอดมินดูแลตลอดเวลา",
    detail: "ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทีมงานช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง",
    rate: "24 ชั่วโมง",
  },
];

const chips = [
  "กีฬา",
  "คาสิโนสด",
  "สล็อต",
  "เกมรูปแบบอื่น",
  "บัญชีเดียวครบ",
  "เครือตรงลิขสิทธิ์แท้",
  "ไม่ผ่านเอเย่นต์",
  "มือถือและคอมพิวเตอร์",
  "สมัครผ่านมือถือ 3 ขั้นตอน",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "แอดมิน 24 ชั่วโมง",
];

// UFAGOOL palette (แดง-เงินโครเมียม): ทั้งสองแผงวางบนพื้นการ์ด #16100f เหนือพื้น
// เพจ #0a0708 แผงล็อกอินอยู่ในกรอบแดงแบรนด์ #c50d12 ส่วนแผงรายการอยู่ในกรอบแดงลึก
// #5e0507 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นแดง
// ลึก ตัวเน้นที่เป็นตัวเลขรับเงินโครเมียม #b8c3cf ตาม GOOL บนโลโก้ที่เป็นเงิน ปุ่ม
// เข้าสู่ระบบใช้ปุ่มโครเมียมอ่อน #f4f7fa → #b8c3cf → #5c6672 บนตัวอักษรสีพื้นเพจ
// ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมและรายการที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการหมวดเกมกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่น พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c50d12]/40 bg-[#16100f]/94 p-6 shadow-[0_10px_30px_rgba(10,7,8,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c50d12]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c50d12]/70 bg-gradient-to-br from-[#ef1f25] via-[#c50d12] to-[#7a0103] text-xl shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f4f7fa]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#cdd5dd]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ ผ่านบัญชีเดียวทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cdd5dd]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5e0507] bg-[#0a0708]/95 py-3 pr-4 pl-12 text-[#cdd5dd] transition-all outline-none placeholder:text-[#cdd5dd]/50 focus:border-[#c50d12] focus:ring-1 focus:ring-[#b8c3cf]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cdd5dd]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5e0507] bg-[#0a0708]/95 py-3 pr-4 pl-12 text-[#cdd5dd] transition-all outline-none placeholder:text-[#cdd5dd]/50 focus:border-[#c50d12] focus:ring-1 focus:ring-[#b8c3cf]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cdd5dd]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5e0507] bg-[#0a0708] accent-[#c50d12]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cdd5dd]/70 transition-colors hover:text-[#f4f7fa]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f4f7fa]/70 bg-gradient-to-r from-[#f4f7fa] via-[#b8c3cf] to-[#5c6672] p-3.5 text-center font-black text-[#0a0708] shadow-[0_10px_30px_rgba(184,195,207,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(244,247,250,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cdd5dd]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e0507]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e0507]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5e0507] bg-[#0a0708] px-2.5 py-1 text-[10px] font-bold text-[#cdd5dd]"><span aria-hidden="true">🎮</span> ทุกหมวดในบัญชีเดียว</span>
            <span class="rounded-full border border-[#b8c3cf]/50 bg-[#0a0708]/85 px-2.5 py-1 text-[10px] font-bold text-[#b8c3cf]"><span aria-hidden="true">🏷️</span> ไม่ผ่านเอเย่นต์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f4f7fa] transition-colors hover:text-[#ef1f25]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#5e0507]/70 bg-[#16100f]/94 p-5 shadow-[0_10px_30px_rgba(10,7,8,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cdd5dd]/70">รวมเกมพนันหลายหมวดไว้ในระบบเดียว เลือกจากหน้าเดียวผ่านบัญชีเดียวได้ทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5e0507] bg-[#0a0708]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ef1f25] shadow-[0_0_8px_rgba(239,31,37,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f4f7fa] uppercase">เครือตรงลิขสิทธิ์แท้</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cdd5dd]/70 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#5e0507] bg-[#0a0708]/95 px-3.5 py-2.5 transition-colors hover:border-[#c50d12]/70 hover:bg-[#241a1a]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cdd5dd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#b8c3cf]/45 bg-[#0a0708] px-2.5 py-0.5 text-[10px] font-bold text-[#b8c3cf]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cdd5dd]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5e0507] bg-[#0a0708] px-3 py-1 text-[10px] font-bold text-[#cdd5dd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cdd5dd]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นไว้ในบัญชีเดียว การเชื่อมต่อเครือตรงแบรนด์ลิขสิทธิ์แท้ที่ไม่ผ่านเอเย่นต์ โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        ส่วนรายการเกม ค่ายที่เปิดให้บริการ รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
