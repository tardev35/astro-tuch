// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน (TSDET911)
// เป็นเว็บที่ขาย **ความเป็นเว็บพนันลิขสิทธิ์ไทยแท้ที่วิ่งผ่านเซิร์ฟไทย 100%**
// พร้อมคำว่า ทางเข้าเดิมพัน · ไม่มีขั้นต่ำ · สมัครเล่น 3 ขั้นตอน ส่วนรอบนี้เป็น
// **เว็บคาสิโนไทยที่รวมคาสิโนกับกีฬาไว้ในแพลตฟอร์มเดียว และวิ่งบนเซิร์ฟเวอร์
// ต่างประเทศ** คือ บาคาร่า · ไฮโล · บอล · สล็อต พร้อม ยอดเข้าบริษัทโดยตรง ·
// ฝากถอนทุกธนาคาร · แอดมิน 24 ชั่วโมง และโปรโมชั่นสองรายการ (คืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8%)
// แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม — กรอบเล่า
// เรื่องของรอบก่อนถูกถอดออกทั้งชุด **ไม่เหลือคำว่า ลิขสิทธิ์ไทยแท้ · เซิร์ฟไทย
// 100% · ทางเข้าเดิมพัน · ไม่มีขั้นต่ำ · สมัครเล่น 3 ขั้นตอน แม้คำเดียว**
// (ของรอบนี้เซิร์ฟเวอร์อยู่ "ต่างประเทศ" ซึ่งเป็นคำตรงข้ามกับของรอบก่อน และ
// "ยอดเดิมพันขั้นต่ำ" รอบนี้เป็นสิ่งที่บรีฟสั่งให้ไปตรวจ ไม่ใช่สิ่งที่บรีฟบอกว่าไม่มี)
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §7 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เว็บคาสิโนไทย · เซิร์ฟเวอร์ต่างประเทศ · ยอดเข้าบริษัทโดยตรง · ฝากถอนทุกธนาคาร ·
// แพลตฟอร์มเดียว · บัญชีเดียว · หมวดเกม · เกมไพ่ · ลูกเต๋า · เกมวงล้อทั่วไป ·
// ฟรีสปิน · ฟีเจอร์โบนัส · รายการแข่งขัน · อัตราต่อรอง · ตารางจ่าย · กติกา ·
// ยอดเดิมพันขั้นต่ำ · วิธีตัดสินผล · ตรวจสอบเครดิต · 24 ชั่วโมง ·
// โบนัสคืนยอดเสีย 0.3% · เข้ายูสทุกวัน · รอบประจำวัน · เวลาตัดยอด · ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน · โบนัส 0.8% · ไม่จำกัด · ลิงก์แนะนำ · ชื่อนิติบุคคล ·
// ชื่อบัญชีรับเงิน · หลักฐานธุรกรรม · แอดมิน · รหัสผ่าน · PIN · OTP ·
// ชื่อคู่แข่งขัน · หมายเลขรายการ
// คำเกมมีได้สี่คำเท่านั้น: บาคาร่า · ไฮโล · บอล (บอลออนไลน์/ฟุตบอล) · สล็อต
// และ **ไม่มีคำเกี่ยวกับหวยที่ไหนเลย** (สองหน้านั้นจอดอยู่ใน src/pages-disabled/)
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: เลขที่ใบอนุญาต · ชื่อหน่วยงานกำกับ ·
// ชื่อนิติบุคคลจริง · ชื่อค่ายเกม · ชื่อธนาคาร · ค่า RTP · ยอดฝากขั้นต่ำเป็นตัวเลข ·
// จำนวนสมาชิก · ปีที่ก่อตั้ง · ที่ตั้งเซิร์ฟเวอร์ที่เจาะจงกว่า "ต่างประเทศ"
// โดยเฉพาะ **ชื่อธนาคาร** — บรีฟพูดว่า "ฝากถอนทุกธนาคาร" และ "ยอดเข้าบริษัท
// โดยตรง" แต่ไม่ได้เอ่ยชื่อธนาคารไหนเลยสักแห่ง และ "ชื่อนิติบุคคล" ในบรีฟเป็น
// สิ่งที่บรีฟสั่งให้ไปตรวจ ไม่ใช่ชื่อที่บรีฟให้มา — คงไว้เป็นคำกำกับ ไม่ใช่คำอ้าง
// ตัวเลขที่อ้างได้มีสามตัวเท่านั้น: 0.3% · 0.8% · 24 ชั่วโมง
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
