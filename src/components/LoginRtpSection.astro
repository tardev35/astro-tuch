---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// JOKERSLOTZ เป็นเว็บโจ๊กเกอร์สล็อตที่เพิ่งอัปเดตทางเข้าสำรอง ตารางฝั่งขวาจึงเป็น
// ข้อเท็จจริงเรื่องลิ้งก์ ความปลอดภัย และการสมัคร/ฝาก-ถอน ที่ brief ระบุไว้เองล้วนๆ
// ไม่มีการคิดตัวเลขขึ้นมาเอง — เปอร์เซ็นต์สองตัวที่มีอยู่จริงในเอกสารคือแนะนำเพื่อน
// 0.8% กับคืนยอดเสีย 0.3% และทั้งคู่เป็นหัวข้อ #4/#5 ของบทความอยู่แล้ว จึงพูดถึงที่นี่
// ในฐานะรายการสิทธิ์ ไม่ใช่การเพิ่มเรทใหม่
const menus = [
  {
    icon: "🔗",
    name: "ทางเข้าสำรอง ล่าสุด",
    detail: "อัปเดตลิ้งก์ทางเข้าสำรองใหม่ เพื่อแก้ปัญหาลิ้งก์เข้าใช้งานไม่ได้หรือเว็บโดนบล็อก เข้าถึงหน้าเกมได้อย่างรวดเร็วและเสถียรที่สุด",
    tag: "ไม่กลัวเว็บปลิว",
  },
  {
    icon: "🛡️",
    name: "เซิร์ฟเวอร์ใหม่ ปลอดภัยขึ้น 100%",
    detail: "พัฒนาระบบเซิร์ฟเวอร์ใหม่ทั้งหมด ข้อมูลส่วนตัวและข้อมูลทางการเงินได้รับการเข้ารหัสความปลอดภัย (Encryption) ที่แน่นหนาขึ้น 100%",
    tag: "ใช้ยูสใหม่",
  },
  {
    icon: "🃏",
    name: "สล็อตลิขสิทธิ์แท้ค่าย Joker Gaming",
    detail: "เข้าถึงหน้าเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming ได้โดยตรง หมดปัญหายูสเซอร์ค้าง เครดิตหาย หรือเกมสะดุดหลุดออกจากระบบ",
    tag: "ลิขสิทธิ์แท้",
  },
  {
    icon: "🤝",
    name: "โปรโมชั่นแนะนำเพื่อน 0.8%",
    detail: "คัดลอกลิ้งก์แนะนำส่วนตัวส่งให้เพื่อนสมัครผ่านทางเข้าใหม่ เมื่อเพื่อนเข้าเล่นจะได้รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเดิมพันของเพื่อน",
    tag: "ถอนเป็นเงินสดได้",
  },
  {
    icon: "💰",
    name: "โปรโมชั่นคืนยอดเสีย 0.3%",
    detail: "คืนยอดเสีย 0.3% ในทุกรอบบิล เป็นเงินทุนสำรองให้กดรับและนำกลับไปแก้มือในเกมสล็อตโจ๊กเกอร์ที่ชื่นชอบได้ใหม่",
    tag: "กดรับทุกวัน",
  },
  {
    icon: "⚡",
    name: "สมัครออโต้เสร็จใน 1 นาที",
    detail: "ระบบสมัครสมาชิกอัตโนมัติ (Auto) ที่ใช้งานง่าย สามขั้นตอน กรอกเบอร์รับ OTP ผูกบัญชีธนาคาร แล้วตั้งรหัสผ่าน ทำรายการเสร็จสิ้นภายใน 1 นาที",
    tag: "ระบบออโต้",
  },
  {
    icon: "💳",
    name: "ทุกธนาคารและ TrueMoney Wallet",
    detail: "รองรับทุกธนาคารและ TrueMoney Wallet โดยชื่อ-นามสกุลและเลขบัญชีต้องตรงกัน เพื่อใช้กับระบบฝาก-ถอนออโต้",
    tag: "ฝาก-ถอนออโต้",
  },
  {
    icon: "📱",
    name: "เล่นผ่านมือถือทุกรุ่น",
    detail: "รองรับการเล่นผ่านมือถือทุกรุ่น ทั้ง iOS และ Android กดเข้าลิ้งก์ผ่านเว็บบราว์เซอร์ได้ทันที ไม่ต้องดาวน์โหลดหรือติดตั้งแอปพลิเคชันใดๆ",
    tag: "ไม่ต้องโหลดแอป",
  },
];

const chips = [
  "ทางเข้าสำรองล่าสุด",
  "ใช้ยูสใหม่",
  "ปลอดภัยขึ้น 100%",
  "Joker Gaming",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัครออโต้ 1 นาที",
  "ทุกธนาคาร",
  "TrueMoney Wallet",
  "Line 24 ชม.",
];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ JOKERSLOTZ"
  titleright="ลิ้งก์ทางเข้าสำรองและความปลอดภัยของ JOKERSLOTZ"
  label="เข้าสู่ระบบ JOKERSLOTZ และรายการลิ้งก์ทางเข้าสำรองกับระบบความปลอดภัยที่เว็บประกาศไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a51515]/40 bg-[#2b0204]/92 p-6 shadow-[0_10px_30px_rgba(13,1,1,0.6)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a51515]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a51515]/70 bg-gradient-to-br from-[#c81e1e] via-[#a51515] to-[#6d0d0d] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f2dc9a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ecdfd0]/75">
            ล็อคอินเข้าลิ้งก์ทางเข้าสำรองล่าสุดของ JOKERSLOTZ เพื่อเข้าเล่นเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming กดรับโปรโมชั่น และทำรายการฝาก-ถอนออโต้ได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecdfd0]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6d0d0d] bg-[#1c0202]/95 py-3 pr-4 pl-12 text-[#ecdfd0] transition-all outline-none placeholder:text-[#ecdfd0]/50 focus:border-[#a51515] focus:ring-1 focus:ring-[#d9b45e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecdfd0]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6d0d0d] bg-[#1c0202]/95 py-3 pr-4 pl-12 text-[#ecdfd0] transition-all outline-none placeholder:text-[#ecdfd0]/50 focus:border-[#a51515] focus:ring-1 focus:ring-[#d9b45e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ecdfd0]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6d0d0d] bg-[#1c0202] accent-[#a51515]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ecdfd0]/80 transition-colors hover:text-[#f2dc9a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#bc9b5b]/70 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#bc9b5b] p-3.5 text-center font-black text-[#1c0202] shadow-[0_10px_30px_rgba(217,180,94,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(217,180,94,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ecdfd0]/60">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d0d0d]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d0d0d]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6d0d0d] bg-[#1c0202] px-2.5 py-1 text-[10px] font-bold text-[#ecdfd0]"><span aria-hidden="true">🃏</span> Joker Gaming</span>
            <span class="rounded-full border border-[#a51515]/50 bg-[#1c0202]/85 px-2.5 py-1 text-[10px] font-bold text-[#f2dc9a]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f2dc9a] transition-colors hover:text-[#d9b45e]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#bc9b5b]/40 bg-[#2b0204]/92 p-5 shadow-[0_10px_30px_rgba(13,1,1,0.55)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ecdfd0]/80">เว็บโจ๊กเกอร์สล็อตอันดับ 1 ในไทย ที่อัปเดตทางเข้าสำรองล่าสุดแล้ว</span>
          <div class="bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c81e1e] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ลิ้งก์ใหม่ ใช้ยูสใหม่ ปลอดภัยขึ้น 100%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#6d0d0d] bg-[#1c0202]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c81e1e] shadow-[0_0_8px_rgba(200,30,30,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f2dc9a] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ecdfd0]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งานบนทางเข้าใหม่</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6d0d0d] bg-[#1c0202]/95 px-3.5 py-2.5 transition-colors hover:border-[#a51515]/70 hover:bg-[#3d0507]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ecdfd0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#bc9b5b]/45 bg-[#1c0202] px-2.5 py-0.5 text-[10px] font-bold text-[#f2dc9a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ecdfd0]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6d0d0d] bg-[#1c0202] px-3 py-1 text-[10px] font-bold text-[#ecdfd0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ecdfd0]/70">
        รายการข้างต้นสรุปสิ่งที่ JOKERSLOTZ ประกาศไว้ ทั้งการอัปเดตลิ้งก์ทางเข้าสำรองล่าสุด ระบบเซิร์ฟเวอร์ใหม่ที่เข้ารหัสความปลอดภัยแน่นหนาขึ้น 100% เมื่อสมัครใช้ยูสใหม่ และโปรโมชั่นที่เปิดให้กดรับทุกวัน
        ส่วนรอบคำนวณและเงื่อนไขของโปรโมชั่นแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
