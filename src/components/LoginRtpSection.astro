---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// UP555 เป็นเว็บคาสิโนที่รวมเกมหลายประเภทไว้ในบัญชีเดียว ไม่ใช่เว็บหวยและไม่ใช่
// เว็บบอลเฉพาะทาง — บรีฟระบุหมวดเกมไว้สี่อย่างตรงๆ คือ สล็อต บาคาร่าออนไลน์
// ตลาดเดิมพันฟุตบอล และหวยตามรายการที่ระบบเปิดให้บริการ บวกกับการรองรับการใช้งาน
// ผ่านมือถือ ป้ายทุกใบจึงเป็นสี่อย่างนั้นบวกมือถือ ไม่ใช่ชื่อเกมหรือชื่อค่ายที่คิดขึ้นเอง
// แผงฝั่งขวารอบนี้เขียนใหม่ทั้งแผงจากคำของบรีฟรอบนี้ ไม่ได้ find-and-replace ทับ
// ประโยคของรอบก่อน ส่วนแผง "จุดที่ควรตรวจก่อนเริ่มใช้งาน" ประกอบจากประโยคกำกับของ
// บรีฟล้วนๆ คือ ความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้ จึงไม่ควรใช้คำว่า
// ปลอดภัยแน่นอนเป็นการรับประกัน, แต่ละโปรโมชั่นอาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ
// รอบตัดยอด และระยะเวลารับโบนัสแตกต่างกัน, ทางเข้าใหม่ควรตรวจสอบประกาศจากช่องทาง
// หลักและหลีกเลี่ยงลิงก์ที่ยืนยันแหล่งที่มาไม่ได้ และการตั้งรหัสผ่านที่คาดเดายาก
// พร้อมไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากรอบเก่า แต่บรีฟรอบนี้ไม่ได้ระบุตัวเลข RTP ไว้ จึง
// ไม่มีตัวเลขนั้นอยู่ในเนื้อหา — คำของรอบก่อนๆ (เว็บตรงต่างประเทศ, บัญชีบริษัทแท้
// 100%, ค่ายเกม, คาสิโนสด, ไม่ผ่านเอเย่นต์ ของรอบ DM899/1SS365 รวมถึง หวย โพย งวด
// อัตราจ่าย เลข 2 ตัว/3 ตัว ฮานอย ลาวพัฒนา หวยหุ้น ของรอบหวย) ไม่เหลืออยู่ในไฟล์นี้
// แล้ว คำว่า "หวย" ที่เหลืออยู่คือหมวดเกมหนึ่งที่บรีฟ UP555 ระบุเอง ไม่ใช่คำของรอบเก่า
//
// ห้ามใส่ชื่อค่ายเกม ชื่อเกม ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟ UP555 ไม่ได้ให้ไว้เลยสักอย่าง และตัวเลขที่
// แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีสี่ตัว
// เท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง
const gameShapes = [
  { icon: "🎰", name: "เกมสล็อต", detail: "หนึ่งในหมวดที่บรีฟระบุไว้ มีธีมและฟีเจอร์แตกต่างกันตามรายการที่ระบบเปิดให้บริการในแต่ละช่วง" },
  { icon: "🃏", name: "บาคาร่าออนไลน์", detail: "อีกหมวดที่บรีฟระบุไว้ เลือกเข้าเล่นได้จากบัญชีเดียวกัน ไม่ต้องสมัครใหม่หลายครั้ง" },
  { icon: "⚽", name: "ตลาดเดิมพันฟุตบอล", detail: "หมวดเดิมพันฟุตบอลตามตลาดที่เว็บไซต์เปิดให้บริการ สลับเข้าจากบัญชีเดียวกับหมวดอื่น" },
  { icon: "🎟️", name: "หวยตามรายการที่ระบบเปิด", detail: "หวยตามรายการที่ระบบเปิดให้บริการ รายการที่เปิดจริงอาจเปลี่ยนแปลงได้ตามช่วงเวลา" },
  { icon: "📱", name: "ใช้งานผ่านมือถือ", detail: "ทางเข้าใหม่ปรับให้รองรับการใช้งานผ่านมือถือสะดวกขึ้น เลือกหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากระบบเดียว" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองทั้งหมด ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforePlayChecks = [
  {
    icon: "🛡️",
    name: "มาตรการความปลอดภัยที่ตรวจสอบได้",
    detail:
      "ด้านความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน และข้อมูลผู้ดำเนินงาน จึงไม่ควรใช้คำว่าปลอดภัยแน่นอนเป็นการรับประกันโดยไม่มีข้อมูลดังกล่าวรองรับ",
    tag: "ตรวจก่อนเชื่อ",
  },
  {
    icon: "🔗",
    name: "ทางเข้าที่ยืนยันแหล่งที่มาได้",
    detail: "หากมีการอัปเกรดทางเข้าใหม่ ควรตรวจสอบประกาศจากช่องทางหลักของเว็บไซต์เพื่อดูรายละเอียดการเปลี่ยนแปลง เช่น หน้า Login เมนูเกม หรือระบบบัญชี และควรหลีกเลี่ยงลิงก์ที่ไม่สามารถยืนยันแหล่งที่มาได้",
    tag: "เช็กช่องทางหลัก",
  },
  {
    icon: "🧾",
    name: "เงื่อนไขของโปรโมชั่นแต่ละรายการ",
    detail: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% อาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ รอบตัดยอด และระยะเวลารับโบนัสแตกต่างกัน จึงควรอ่านรายละเอียดก่อนเลือกรับโปรโมชั่นทุกครั้ง",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🔐",
    name: "ความปลอดภัยของบัญชีสมาชิก",
    detail: "ควรใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น ไม่ว่าจะติดต่อผ่านช่องทางใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "สล็อต",
  "บาคาร่า",
  "บอล",
  "หวย",
  "บัญชีเดียว",
  "หมวดเกม",
  "เครดิต",
  "โปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "รอบตัดยอด",
  "ยอดที่เข้าเกณฑ์",
  "ประวัติรายการ",
  "สมัครสมาชิก",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): โลโก้เป็นคู่โลหะจริง — ตัว U
// กับ UP เป็นเงินโครเมียม (dominant #d5d4d3 #f3f3f2) ส่วนลูกศร วงรี และเลข 555 เป็น
// ทอง (vivid #ebbb54 #fce675 #ab6d24) ส่วน banner1.png พื้นเป็นดำอมน้ำตาล
// (#130b03 #030102 #1b130c) และ bg.json กำหนดพื้นหลังเว็บเป็น #000000 สองแผงจึงถูก
// แยกด้วยคู่โลหะนั้นตรงๆ — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #ebbb54 ส่วนแผงหมวดเกมอยู่
// ในกรอบเงินโครเมียม #d5d4d3 ทั้งคู่วางบนผิวการ์ด #241705 ช่องกรอกและชิปตกลงไปที่
// พื้นลึกสุด #0c0502 บรรทัดเด่นไล่ทองสว่าง #fce675 → ทองแบรนด์ #ebbb54 → เงิน #d5d4d3
//
// ปุ่มในแผงนี้แยกตามหน้าที่ตามกฎพาเลตต์: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นโครงไม่ทึบ
// ขอบทอง #ebbb54/60 หมึกทองสว่าง #fce675 ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้น
// ทึบไม่ไล่เฉด ซึ่งจงใจให้ต่างจากปุ่มสมัครสมาชิกบนหน้าแรกที่เป็นพื้นไล่เฉดทองแบรนด์
// เพราะรอบนี้สีแบรนด์เองก็เป็นทอง ถ้าทั้งสองปุ่มเป็นทองไล่เฉดเหมือนกันจะแยกไม่ออก
// ข้อความรองใช้สีเนื้อความ #f8eed9 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
// เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #12c23a
// #fb252b #ff6b6e #102a16 #030a05 #0a4a18 #06140a #ffe9a8 #f2b422 #e4f2e4)
// ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือก`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมหมวดเกมที่เว็บไซต์เปิดให้เลือก ทั้งสล็อต บาคาร่า เดิมพันฟุตบอล และหวยตามรายการที่ระบบเปิดให้บริการ และจุดที่ควรตรวจสอบก่อนเริ่มใช้งานทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ebbb54]/55 bg-[#241705]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ebbb54]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fce675]/70 bg-gradient-to-br from-[#fce675] via-[#ebbb54] to-[#ab6d24] text-xl text-[#160d02] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fce675]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f8eed9]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือหรือคอมพิวเตอร์ แล้วเลือกหมวดเกมที่ต้องการได้จากบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากระบบเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f8eed9]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b4517] bg-[#0c0502]/95 py-3 pr-4 pl-12 text-[#f8eed9] transition-all outline-none placeholder:text-[#f8eed9]/55 focus:border-[#ebbb54] focus:ring-1 focus:ring-[#fce675]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f8eed9]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b4517] bg-[#0c0502]/95 py-3 pr-4 pl-12 text-[#f8eed9] transition-all outline-none placeholder:text-[#f8eed9]/55 focus:border-[#ebbb54] focus:ring-1 focus:ring-[#fce675]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f8eed9]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b4517] bg-[#0c0502] accent-[#ebbb54]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f8eed9]/75 transition-colors hover:text-[#fce675]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border-2 border-[#ebbb54]/60 bg-transparent p-3.5 text-center font-black text-[#fce675] transition-all hover:scale-[1.02] hover:border-[#ebbb54] hover:bg-[#ebbb54]/10">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f8eed9]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b4517]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b4517]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b4517] bg-[#0c0502] px-2.5 py-1 text-[10px] font-bold text-[#f8eed9]"><span aria-hidden="true">🎰</span> บัญชีเดียวครบทุกหมวดเกม</span>
            <span class="rounded-full border border-[#d5d4d3]/50 bg-[#0c0502]/85 px-2.5 py-1 text-[10px] font-bold text-[#f3f3f2]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ebbb54] transition-colors hover:text-[#fce675]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d5d4d3]/45 bg-[#241705]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f8eed9]/75">
            {BRAND_NAME} รวมเกมเดิมพันหลายรูปแบบไว้ในบัญชีเดียว ทางเข้าใหม่ปรับให้รองรับการใช้งานผ่านมือถือสะดวกขึ้น สลับประเภทเกม ตรวจสอบเครดิต และดูประวัติรายการได้โดยไม่ต้องสมัครใหม่หลายครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#fce675] via-[#ebbb54] to-[#d5d4d3] bg-clip-text text-xl font-black text-transparent sm:text-2xl">สล็อต · บาคาร่า · บอล · หวย</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#6b4517] bg-[#0c0502]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ebbb54] shadow-[0_0_8px_rgba(235,187,84,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fce675] uppercase">ตามรายการที่ระบบเปิด</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f8eed9]/70 uppercase">
        <span>หมวดเกมที่เลือกได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameShapes.map((t) => (
            <div class="rounded-xl border border-[#6b4517] bg-[#0c0502]/95 px-3.5 py-2.5 transition-colors hover:border-[#ebbb54]/75 hover:bg-[#241705]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fce675]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f8eed9]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f8eed9]/70">
        รายการเกมและผู้ให้บริการที่เปิดจริงอาจมีการอัปเดตหรือเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมก่อนเริ่มใช้งานทุกครั้ง ทั้งนี้ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f8eed9]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforePlayChecks.map((k) => (
            <div class="rounded-xl border border-[#6b4517] bg-[#0c0502]/95 px-3.5 py-2.5 transition-colors hover:border-[#d5d4d3]/60 hover:bg-[#241705]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f8eed9]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ebbb54]/50 bg-[#0c0502] px-2.5 py-0.5 text-[10px] font-bold text-[#ebbb54]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f8eed9]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b4517] bg-[#0c0502] px-3 py-1 text-[10px] font-bold text-[#f8eed9]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f8eed9]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมหลายประเภทไว้ในบัญชีเดียว และการตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากระบบเดียว ส่วนด้านความปลอดภัยควรพิจารณาจากมาตรการที่ตรวจสอบได้ เช่น การรักษาความปลอดภัยของบัญชี ระบบยืนยันตัวตน
        และข้อมูลผู้ดำเนินงาน จึงไม่ควรใช้คำว่าปลอดภัยแน่นอนเป็นการรับประกันโดยไม่มีข้อมูลดังกล่าวรองรับ แต่ละโปรโมชั่นอาจกำหนดประเภทเกม ยอดที่ใช้คำนวณ และรอบตัดยอดต่างกัน จึงควรอ่านรายละเอียดก่อนเลือกรับทุกครั้ง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
