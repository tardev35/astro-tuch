---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — GUCCI168 เป็นเว็บ
// คาสิโนไลฟ์ 24 ชม. ที่ชูบาคาร่า รูเล็ต ไฮโล ส่วน 789BETTING เป็น "คาสิโนฐานเข้าหลัก"
// ที่รวมบาคาร่า รูเล็ต บอล หวย สล็อต ไว้ในบัญชีเดียว และเป็นบรีฟที่มีคำกำกับของตัวเอง
// เยอะกว่ารอบก่อนมาก แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §4 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// คาสิโน · คาสิโนออนไลน์ · คาสิโนฐานเข้าหลัก · บาคาร่า · รูเล็ต · บอล · หวย · สล็อต ·
// โต๊ะ · ตลาดเดิมพัน · คู่แข่งขัน · รอบเปิดรับ · ฟรีสปิน · โบนัส · ตัวคูณ · เกมคลาสสิก ·
// บัญชีเดียว · เครดิต · ประวัติการเดิมพัน · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · รอบตัดยอด · ยอดที่เข้าเกณฑ์ · Login · ฝากถอน · ช่องทางฝากถอน ·
// ชื่อบัญชีปลายทาง · นิติบุคคล · เดิมพันตรงกับบริษัท 100% · ยอดเข้าบริษัทตรง ·
// แอดมิน 24 ชั่วโมง · PIN · OTP · หลักฐานธุรกรรม · วงเงิน · เวลาเปิด-ปิด
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §4 (ไฮโล · โต๊ะสด · หมวดเกม · Limit ·
// ไม่มีขั้นต่ำทุกรูปแบบเกม · คาสิโนไม่จำกัดยอด · สมัคร 3 ขั้นตอน · คาสิโนไลฟ์24ชม ·
// เบทต่ำ · ทุนน้อย · ค่ายตรง · เว็บตรง · ถูกลิขสิทธิ์ · ไฮคลาส · VIP ·
// ส่งตรงจากเว็บแม่ · ไม่ผ่านบัญชีม้า · จ่ายจริง) และคำหวยเฉพาะทางทั้งหมด (โพย ·
// เลขเด็ด · แนวทาง · งวด · อัตราจ่าย · ตรวจหวย) — ไม่เหลือแม้คำเดียว
// คำว่า "หวย" เองยังอยู่ เพราะบรีฟรอบนี้ระบุหวยเป็นหนึ่งในหมวดที่ฐานเข้าหลักนี้รวมไว้
// (content.txt บรรทัด 4, 6, 22) ที่ §7 สั่งปิดคือ "หน้าหวย" /ตรวจหวย กับ /แนวทาง
// ไม่ใช่คำว่าหวยในเนื้อหา
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้ให้ค่า RTP ของเกมไว้เลย และ §4 ห้ามอ้างตัวเลขที่บรีฟไม่ได้ระบุ
// คำว่า RTP จึงไม่ปรากฏในเนื้อหาแม้แต่ครั้งเดียว แผงขวาเป็น "หมวดเดิมพันและสิทธิ์ที่
// เลือกได้" ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ชื่อค่ายเกม · เลขใบอนุญาต · ชื่อผู้ดำเนินงาน ·
// ชื่อนิติบุคคล · ชื่อธนาคาร · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ค่า RTP —
// บรีฟไม่ได้ให้ไว้สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง
// ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีเท่านี้: 0.3% · 0.8% · 100% · 24 ชั่วโมง
const gameTypes = [
  { icon: "🎴", name: "บาคาร่า", detail: "บาคาร่ามีโต๊ะตามรายการที่เปิดให้บริการ เลือกเข้าเล่นจากบัญชีเดียวได้ทั้งมือถือและคอมพิวเตอร์" },
  { icon: "🎡", name: "รูเล็ต", detail: "รูเล็ตมีโต๊ะตามรายการที่เปิดให้บริการ ควรตรวจสอบราคาและวงเงินที่แสดงในระบบก่อนยืนยันการเดิมพัน" },
  { icon: "⚽", name: "บอล", detail: "บอลเลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลา โดยอ้างอิงตามตารางของแต่ละรายการ" },
  { icon: "🎫", name: "หวย", detail: "หวยแบ่งรอบเปิดรับตามประเภท จึงควรดูเวลาเปิด-ปิดของแต่ละรอบที่แสดงในระบบก่อนส่งรายการ" },
  { icon: "🎰", name: "สล็อต", detail: "สล็อตมีทั้งเกมคลาสสิก ฟรีสปิน โบนัส และตัวคูณ แต่ละเกมกำหนดกติกาและช่วงเดิมพันของตัวเองไว้ไม่เหมือนกัน" },
  { icon: "🗂️", name: "ตลาดเดิมพัน", detail: "จำนวนเกม โต๊ะ และตลาดเดิมพันอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบรายละเอียดที่แสดงในระบบทุกครั้ง" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "สมาชิกที่มียอดเสียตรงตามข้อกำหนดตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนดได้" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "เมื่อเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์" },
  { icon: "📑", name: "เครดิตและประวัติการเดิมพัน", detail: "เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติการเดิมพันผ่านบัญชีเดียวได้สะดวก" },
  { icon: "🏦", name: "ช่องทางฝากถอน", detail: "รองรับช่องทางฝากถอนตามที่ระบบเปิดให้บริการ ควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางก่อนยืนยันธุรกรรม" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 7, 4+15, 16, 19)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้ — บรีฟรอบนี้เป็นบรีฟที่กำกับตัวเองหนักกว่าปกติ
// และ §4 สั่งให้ ship คำกำกับนั้นไปด้วย ไม่ใช่ตัดออกเพราะฟังดูไม่ขายของ
