---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the brief states: เกมสล็อต บาคาร่า
// คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย, โบนัสคืนยอดเสีย 0.3%, โบนัสสมาชิกใหม่,
// ระบบฝากถอนอัตโนมัติ และทีมงานที่ช่วยตรวจสอบรายการ.
const menus = [
  { icon: "🎰", name: "เกมสล็อต", detail: "รวมเกมสล็อตหลายรูปแบบในบัญชีเดียว พร้อมอัปเดตเกมใหม่เข้าระบบต่อเนื่อง", tag: "อัปเดตเกมใหม่" },
  { icon: "🀄", name: "บาคาร่า", detail: "เลือกห้องและวงเงินที่เปิดให้บริการ ตรวจสอบเงื่อนไขก่อนวางเดิมพัน", tag: "หลายห้องให้เลือก" },
  { icon: "🃏", name: "คาสิโนสด", detail: "ถ่ายทอดสดจากห้องเกม เลือกโต๊ะและวางเดิมพันได้จากหน้าเดียว", tag: "ถ่ายทอดสด" },
  { icon: "🎡", name: "รูเล็ต", detail: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดง", tag: "ตามอัตราที่ระบบแสดง" },
  { icon: "🐯", name: "เสือมังกร", detail: "เกมไพ่ใบเดียวรู้ผลไว เลือกโต๊ะที่เปิดอยู่ได้ทันที", tag: "รู้ผลไว" },
  { icon: "🎴", name: "เกมไพ่ และ หวย", detail: "เกมไพ่หลายชนิดและหวยตามรอบที่เปิดรับ ดูกติกากับอัตราจ่ายก่อนยืนยัน", tag: "ดูกติกาก่อนเล่น" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการได้เองตลอด 24 ชั่วโมง", tag: "จัดการเครดิตเอง" },
  { icon: "🎁", name: "คืนยอดเสีย 0.3%", detail: "ตรวจสอบยอดที่เข้าเงื่อนไข รอบคำนวณ และข้อกำหนดการถอนก่อนกดรับสิทธิ์", tag: "ตามรอบที่กำหนด" },
];

const chips = ["สล็อต", "บาคาร่า", "คาสิโนสด", "รูเล็ต", "เสือมังกร", "เกมไพ่", "หวย", "ฝากถอนออโต้"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ JUMBOBET" titleright="หมวดเกมและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ JUMBOBET และหมวดเกมพนันออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0b7a06]/50 bg-[#031204]/92 p-6 shadow-[0_10px_30px_rgba(37,203,14,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#063f04]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#25cb0e]/50 bg-gradient-to-br from-[#6ef25a] via-[#25cb0e] to-[#063f04] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#6ef25a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fa08c]">เข้าสู่ระบบ JUMBOBET ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fa08c]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0b7a06] bg-[#010301]/95 py-3 pr-4 pl-12 text-[#f0f7ee] transition-all outline-none placeholder:text-[#8fa08c]/70 focus:border-[#25cb0e] focus:ring-1 focus:ring-[#25cb0e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fa08c]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0b7a06] bg-[#010301]/95 py-3 pr-4 pl-12 text-[#f0f7ee] transition-all outline-none placeholder:text-[#8fa08c]/70 focus:border-[#25cb0e] focus:ring-1 focus:ring-[#25cb0e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d5e8d0]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0b7a06] bg-[#010301] accent-[#25cb0e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d5e8d0] transition-colors hover:text-[#6ef25a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#6ef25a]/50 bg-gradient-to-r from-[#6ef25a] via-[#25cb0e] to-[#0b7a06] p-3.5 text-center font-black text-[#031204] shadow-[0_10px_30px_rgba(37,203,14,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(37,203,14,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8fa08c]">
          <span class="h-px flex-1 bg-[#0b7a06]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0b7a06]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อทีมงานผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0b7a06]/60 bg-[#010301] px-2.5 py-1 text-[10px] font-bold text-[#6ef25a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#25cb0e]/30 bg-[#010301]/80 px-2.5 py-1 text-[10px] font-bold text-[#d5e8d0]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#6ef25a] transition-colors hover:text-[#f0f7ee]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#25cb0e]/25 bg-[#031204]/92 p-5 shadow-[0_10px_30px_rgba(37,203,14,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d5e8d0]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#0b7a06] via-[#25cb0e] to-[#f0f7ee] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fa08c] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0b7a06] bg-[#010301]/95 px-3.5 py-2.5 transition-colors hover:border-[#25cb0e]/50 hover:bg-[#052008]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0f7ee]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#0b7a06]/60 bg-[#010301] px-2.5 py-0.5 text-[10px] font-bold text-[#6ef25a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d5e8d0]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#25cb0e]/25 bg-[#010301] px-3 py-1 text-[10px] font-bold text-[#6ef25a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8fa08c]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
