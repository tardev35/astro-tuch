---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// DM899 เป็นเว็บสล็อตคาสิโนออนไลน์ เว็บตรงต่างประเทศ ไม่ใช่เว็บหวยและไม่ใช่เว็บบอล
// แผงฝั่งขวารอบนี้ถูกเขียนใหม่ทั้งแผงจากคำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace
// ทับประโยคของรอบก่อน บรีฟระบุหมวดเกมไว้สามอย่าง คือ เกมสล็อต เกมคาสิโนสด และหมวด
// เกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ บวกกับการรองรับเว็บเบราว์เซอร์บนมือถือ
// ป้ายทุกใบจึงเป็นสี่อย่างนั้น ไม่ใช่ชื่อเกมหรือชื่อค่ายที่คิดขึ้นเอง ส่วนแผง
// "จุดที่ควรตรวจก่อนเริ่มใช้งาน" ประกอบจากประโยคกำกับของบรีฟล้วนๆ คือ คำว่าบัญชี
// บริษัทแท้ 100% ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับ, คำว่าการันตีระบบ
// เกมมาตรฐานควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้, แต่ละโปรโมชั่นอาจ
// กำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ และระยะเวลารับสิทธิ์แตกต่างกัน
// และการตั้งรหัสผ่านที่คาดเดายากพร้อมไม่เปิดเผย PIN รหัสผ่าน หรือ OTP
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากรอบเก่า แต่บรีฟรอบนี้ไม่ได้ระบุตัวเลข RTP ไว้ จึง
// ไม่มีตัวเลขนั้นอยู่ในเนื้อหา — คำของรอบก่อนๆ (หวย โพย งวด อัตราจ่าย เลข 2 ตัว/
// 3 ตัว ฮานอย ลาวพัฒนา หวยหุ้น ตรวจหวย รวมถึง ฟรีสปิน ตัวคูณ เกมโบนัส และ
// "ไม่ผ่านเอเย่นต์" ของรอบสล็อตก่อนหน้า) ไม่เหลืออยู่ในไฟล์นี้แล้ว
//
// ห้ามใส่ชื่อค่ายเกม ชื่อเกม ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟ DM899 ไม่ได้ให้ไว้เลยสักอย่าง และตัวเลขที่
// แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีห้าตัว
// เท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง · บัญชีบริษัทแท้ 100%
const gameShapes = [
  { icon: "🎰", name: "เกมสล็อต", detail: "หนึ่งในหมวดที่บรีฟระบุไว้ รวมไว้ให้เลือกผ่านบัญชีเดียว รายการที่เปิดจริงขึ้นอยู่กับผู้ให้บริการที่เชื่อมต่อกับระบบในแต่ละช่วง" },
  { icon: "🃏", name: "เกมคาสิโนสด", detail: "อีกหมวดที่บรีฟระบุไว้ เลือกเข้าเล่นได้จากบัญชีเดียวกัน ไม่ต้องสมัครบัญชีใหม่แยกตามค่าย" },
  { icon: "🎲", name: "หมวดเกมอื่นตามผู้ให้บริการ", detail: "หมวดเกมอื่นเปิดตามผู้ให้บริการที่เชื่อมต่อกับระบบ จำนวนค่ายและเกมสามารถเพิ่มหรือลดได้ตามช่วงเวลา" },
  { icon: "📱", name: "ใช้งานผ่านเบราว์เซอร์บนมือถือ", detail: "รองรับการใช้งานผ่านเว็บเบราว์เซอร์บนมือถือ สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้จากบัญชีเดียว" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองทั้งหมด ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforePlayChecks = [
  {
    icon: "🏢",
    name: "ข้อมูลของบัญชีบริษัทที่ตรวจสอบได้",
    detail: "คำว่าบัญชีบริษัทแท้ 100% ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับก่อนนำมาใช้ยืนยันด้านความปลอดภัย ควรตรวจชื่อบัญชี ชื่อนิติบุคคล และข้อมูลบริษัทให้ตรงกันก่อนทำธุรกรรมทุกครั้ง",
    tag: "ตรวจก่อนโอน",
  },
  {
    icon: "📋",
    name: "มาตรฐานที่อ้างอิงได้ของระบบเกม",
    detail:
      "หากต้องการใช้ข้อความว่าการันตีระบบเกมมาตรฐาน ควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ",
    tag: "ไม่รับประกันเอง",
  },
  {
    icon: "🧾",
    name: "เงื่อนไขของโปรโมชั่นแต่ละรายการ",
    detail: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% อาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ และระยะเวลารับสิทธิ์แตกต่างกัน จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับโบนัส",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🔐",
    name: "ความปลอดภัยของบัญชีสมาชิก",
    detail: "ควรใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผย PIN รหัสผ่าน หรือ OTP ให้บุคคลอื่น ไม่ว่าจะติดต่อผ่านช่องทางใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "สล็อต",
  "คาสิโนสด",
  "เว็บตรงต่างประเทศ",
  "บัญชีบริษัทแท้ 100%",
  "ค่ายเกม",
  "เครดิต",
  "โปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "รอบคำนวณ",
  "ยอดที่เข้าเกณฑ์",
  "ฝากถอน",
  "ประวัติรายการ",
  "สมัครสมาชิก",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): โลโก้เป็นคู่สีจริง — ตัว D
// เขียว (vivid #01841b #018b1b) ซ้อนตัว M แดง (#fb252b #bb0303 #f91c20) ตามด้วย
// เลข 899 โครเมียม ส่วน banner1.png พื้นเป็นดำอมเขียว (#05140c #0b1b13 #031404)
// และ bg.json กำหนดพื้นหลังเว็บเป็น #000000 สองแผงจึงถูกแยกด้วยคู่ D/M นั้นตรงๆ —
// แผงล็อกอินอยู่ในกรอบเขียวแบรนด์ #01a326 ส่วนแผงหมวดเกมอยู่ในกรอบแดงแบรนด์
// #fb252b ทั้งคู่วางบนผิวการ์ด #102a16 ช่องกรอกและชิปตกลงไปที่พื้นลึกสุด #030a05
// บรรทัดเด่นไล่ทองอ่อน #ffe9a8 → ทองแบรนด์ #f2b422 → เขียวสว่าง #12c23a
//
// ปุ่มในแผงนี้แยกตามหน้าที่ตามกฎพาเลตต์: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นโครงไม่ทึบ
// ขอบทอง #f2b422/60 หมึกทองอ่อน #ffe9a8 ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้น
// ทึบไม่ไล่เฉด ซึ่งจงใจให้ต่างจากปุ่มสมัครสมาชิกบนหน้าแรกที่เป็นพื้นไล่เฉดเขียวแบรนด์
// เพราะรอบนี้สีแบรนด์เองก็เป็นเขียว ถ้าทั้งสองปุ่มเป็นเขียวไล่เฉดเหมือนกันจะแยกไม่ออก
// ข้อความรองใช้สีเนื้อความ #e4f2e4 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
// เนื้อความ #e4f2e4 (BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ 1SS365 ที่เคยค้างในไฟล์นี้ (#edbb23 #ffeeb4 #a87708
// #c8cbce #f1f2f3 #2a2115 #1a1710 #050505 #cfc2a6 #f0e6d2) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือก`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมหมวดเกมที่เว็บไซต์เปิดให้เลือก ทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ และจุดที่ควรตรวจสอบก่อนเริ่มใช้งานทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#01a326]/55 bg-[#102a16]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#01a326]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#4ade6b]/70 bg-gradient-to-br from-[#4ade6b] via-[#12c23a] to-[#01a326] text-xl text-[#06140a] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e4f2e4]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือหรือคอมพิวเตอร์ แล้วเลือกประเภทเกมที่ต้องการได้จากบัญชีเดียว พร้อมตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากระบบเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e4f2e4]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0a4a18] bg-[#030a05]/95 py-3 pr-4 pl-12 text-[#e4f2e4] transition-all outline-none placeholder:text-[#e4f2e4]/55 focus:border-[#01a326] focus:ring-1 focus:ring-[#4ade6b]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e4f2e4]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0a4a18] bg-[#030a05]/95 py-3 pr-4 pl-12 text-[#e4f2e4] transition-all outline-none placeholder:text-[#e4f2e4]/55 focus:border-[#01a326] focus:ring-1 focus:ring-[#4ade6b]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e4f2e4]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0a4a18] bg-[#030a05] accent-[#01a326]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e4f2e4]/75 transition-colors hover:text-[#ffe9a8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border-2 border-[#f2b422]/60 bg-transparent p-3.5 text-center font-black text-[#ffe9a8] transition-all hover:scale-[1.02] hover:border-[#f2b422] hover:bg-[#f2b422]/10">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e4f2e4]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#0a4a18]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#0a4a18]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0a4a18] bg-[#030a05] px-2.5 py-1 text-[10px] font-bold text-[#e4f2e4]"><span aria-hidden="true">🎰</span> บัญชีเดียวครบทุกหมวดเกม</span>
            <span class="rounded-full border border-[#fb252b]/50 bg-[#030a05]/85 px-2.5 py-1 text-[10px] font-bold text-[#ff6b6e]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#4ade6b] transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#fb252b]/45 bg-[#102a16]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e4f2e4]/75">
            {BRAND_NAME} รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว รองรับการเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย
          </span>
          <div class="bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#12c23a] bg-clip-text text-xl font-black text-transparent sm:text-2xl">เกมสล็อต · เกมคาสิโนสด · หมวดเกมอื่น</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#0a4a18] bg-[#030a05]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#12c23a] shadow-[0_0_8px_rgba(18,194,58,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffe9a8] uppercase">ตามผู้ให้บริการที่เชื่อมต่อ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e4f2e4]/70 uppercase">
        <span>หมวดเกมที่เลือกได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameShapes.map((t) => (
            <div class="rounded-xl border border-[#0a4a18] bg-[#030a05]/95 px-3.5 py-2.5 transition-colors hover:border-[#01a326]/75 hover:bg-[#102a16]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#ffe9a8]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#e4f2e4]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#e4f2e4]/70">
        หมวดเกมที่เปิดให้เลือกจริงขึ้นอยู่กับผู้ให้บริการที่เชื่อมต่อกับระบบในแต่ละช่วง จำนวนค่ายและเกมสามารถเพิ่มหรือลดได้ตามช่วงเวลา จึงควรตรวจสอบรายการล่าสุดจากหน้าเกมก่อนเริ่มใช้งานทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e4f2e4]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนเริ่มใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforePlayChecks.map((k) => (
            <div class="rounded-xl border border-[#0a4a18] bg-[#030a05]/95 px-3.5 py-2.5 transition-colors hover:border-[#fb252b]/60 hover:bg-[#102a16]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e4f2e4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f2b422]/50 bg-[#030a05] px-2.5 py-0.5 text-[10px] font-bold text-[#f2b422]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e4f2e4]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0a4a18] bg-[#030a05] px-3 py-1 text-[10px] font-bold text-[#e4f2e4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e4f2e4]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว และการตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว ส่วนคำว่าบัญชีบริษัทแท้ 100% ควรมีชื่อนิติบุคคลและข้อมูลที่ตรวจสอบได้รองรับ
        และคำว่าการันตีระบบเกมมาตรฐานควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ จึงควรตรวจสอบเงื่อนไขล่าสุดก่อนกดรับโบนัส
        และไม่ควรเปิดเผย PIN รหัสผ่าน หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
