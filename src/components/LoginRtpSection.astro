---
// ContentBoxTwo (the plain sibling) still carries a previous brand's gold and
// is inventory now; this box uses the CyberCut two-column shell, whose column
// labels render as <p> so a login widget never emits a heading.
import ContentBoxTwoCyberCut from "./ContentBoxTwoCyberCut.astro";

// Every row below stays inside what the brief states: คาสิโนสด บาคาร่า รูเล็ต
// เสือมังกร สล็อต หลายค่าย, โบนัสแนะนำเพื่อน 0.8%, ฝากถอนอัตโนมัติ และแอดมิน
// 24 ชั่วโมง.
const menus = [
  { icon: "🃏", name: "คาสิโนสด", detail: "ถ่ายทอดสดจากห้องเกม เลือกโต๊ะและวางเดิมพันได้จากหน้าเดียว", tag: "ถ่ายทอดสด" },
  { icon: "🀄", name: "บาคาร่า", detail: "เลือกห้องและวงเงินที่เปิดให้บริการ ตรวจสอบเงื่อนไขก่อนวางเดิมพัน", tag: "หลายห้องให้เลือก" },
  { icon: "🎡", name: "รูเล็ต", detail: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดง", tag: "ตามอัตราที่ระบบแสดง" },
  { icon: "🐯", name: "เสือมังกร", detail: "เกมไพ่ใบเดียวรู้ผลไว เลือกโต๊ะที่เปิดอยู่ได้ทันที", tag: "รู้ผลไว" },
  { icon: "🎰", name: "สล็อตทุกค่าย", detail: "รวมเกมสล็อตจากหลายค่ายในบัญชีเดียว พร้อมอัปเดตเกมใหม่ต่อเนื่อง", tag: "อัปเดตเกมใหม่" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิตผ่านระบบอัตโนมัติแล้วเข้าเล่นได้ทันที ติดตามสถานะรายการเองได้", tag: "จัดการเครดิตเอง" },
  { icon: "🛎️", name: "แอดมินบริการ 24 ชั่วโมง", detail: "แจ้งได้ทั้งเรื่องสมัครสมาชิก ฝากถอน เครดิตไม่เข้า และการรับโบนัสแนะนำเพื่อน", tag: "แจ้งปัญหาได้ตลอด" },
];

const chips = ["คาสิโนสด", "บาคาร่า", "รูเล็ต", "เสือมังกร", "สล็อต", "ฝากถอนอัตโนมัติ", "มือถือ"];
---

<ContentBoxTwoCyberCut
  titleleft="เข้าสู่ระบบ SUPERWIN9"
  titleright="หมวดเกมและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ SUPERWIN9 และหมวดเกมคาสิโนที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7a0d10]/40 bg-[#170405]/92 p-6 shadow-[0_10px_30px_rgba(200,17,24,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3d0407]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ebbb4a]/50 bg-gradient-to-br from-[#f5333c] via-[#c81118] to-[#3d0407] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ebbb4a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9b489]">เข้าสู่ระบบ SUPERWIN9 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a7112]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#33110d] bg-[#0a0202]/95 py-3 pr-4 pl-12 text-[#efe3d2] transition-all outline-none placeholder:text-[#c9b489]/60 focus:border-[#ebbb4a] focus:ring-1 focus:ring-[#ebbb4a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a7112]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#33110d] bg-[#0a0202]/95 py-3 pr-4 pl-12 text-[#efe3d2] transition-all outline-none placeholder:text-[#c9b489]/60 focus:border-[#ebbb4a] focus:ring-1 focus:ring-[#ebbb4a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9b489]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#33110d] bg-[#0a0202] accent-[#c81118]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9b489] transition-colors hover:text-[#fbe289]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ebbb4a]/50 bg-gradient-to-r from-[#f5333c] via-[#c81118] to-[#7a0d10] p-3.5 text-center font-black text-[#2a0a02] shadow-[0_10px_30px_rgba(200,17,24,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(235,187,74,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9b489]/70">
          <span class="h-px flex-1 bg-[#33110d]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#33110d]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7a0d10]/40 bg-[#0a0202] px-2.5 py-1 text-[10px] font-bold text-[#f5333c]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#ebbb4a]/30 bg-[#0a0202]/80 px-2.5 py-1 text-[10px] font-bold text-[#ebbb4a]"><span aria-hidden="true">🕐</span> แอดมินดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ebbb4a] transition-colors hover:text-[#fbe289]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ebbb4a]/25 bg-[#170405]/92 p-5 shadow-[0_10px_30px_rgba(235,187,74,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9b489]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#c81118] via-[#f5333c] to-[#fbe289] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9b489]/80 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#33110d] bg-[#0a0202]/95 px-3.5 py-2.5 transition-colors hover:border-[#ebbb4a]/50 hover:bg-[#240607]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efe3d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7a0d10]/40 bg-[#0a0202] px-2.5 py-0.5 text-[10px] font-bold text-[#ebbb4a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9b489]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ebbb4a]/25 bg-[#0a0202] px-3 py-1 text-[10px] font-bold text-[#ebbb4a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9b489]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwoCyberCut>
