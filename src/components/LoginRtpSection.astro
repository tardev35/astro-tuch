---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// CASINO888 is a full-service casino brand, so every row below stays inside what
// the brief states: การรวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต
// หวย และฟุตบอล, การรองรับมือถือ แท็บเล็ต และคอมพิวเตอร์, การจัดหมวดหมู่เกมให้
// ค้นหาง่าย, การตรวจอัตราจ่าย กติกา และขั้นต่ำก่อนยืนยันรายการ, ขั้นต่ำที่บางเกม
// เริ่มประมาณ 1 บาทตามข้อกำหนดของผู้ให้บริการแต่ละราย, โบนัสแนะนำเพื่อน 0.8%
// และคืนยอดเสีย 0.3% ตามรอบและเงื่อนไข, การสมัคร 3 ขั้นตอน และแอดมินที่ให้
// บริการตลอด 24 ชั่วโมง.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state.
const menus = [
  { icon: "🃏", name: "บาคาร่าและคาสิโนสด", detail: "หมวดบาคาร่าและเกมคาสิโนสดจัดไว้ให้ค้นหาง่าย ตรวจอัตราจ่าย กติกา และขั้นต่ำของโต๊ะได้ก่อนยืนยันรายการ", tag: "ตรวจกติกาก่อนลง" },
  { icon: "🎰", name: "สล็อตออนไลน์", detail: "เลือกเกมสล็อตจากหมวดที่ระบบเปิดให้บริการ แล้วดูรายละเอียดเกมและช่วงเดิมพันที่รองรับก่อนเริ่มหมุน", tag: "ดูช่วงเดิมพัน" },
  { icon: "🎫", name: "หวยออนไลน์หลายประเภท", detail: "หวยออนไลน์มีหลายประเภทตามที่ระบบเปิดให้บริการ ควรตรวจอัตราจ่ายและรอบที่เปิดรับก่อนส่งโพย", tag: "ตรวจรอบที่เปิด" },
  { icon: "⚽", name: "เดิมพันฟุตบอล", detail: "เดิมพันฟุตบอลตามรายการที่เปิดให้บริการ ตรวจรูปแบบการเดิมพันและขั้นต่ำของบิลก่อนยืนยันทุกครั้ง", tag: "ตามรายการที่เปิด" },
  { icon: "📱", name: "มือถือ แท็บเล็ต คอม", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้จากบัญชีเดียว ทั้งเลือกเกม จัดการเครดิต และดูประวัติรายการ", tag: "บัญชีเดียวครบ" },
  { icon: "💰", name: "ขั้นต่ำประมาณ 1 บาท", detail: "บางเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท ขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย ควรตรวจตัวเลขจริงก่อนทำรายการ", tag: "ต่างกันตามเกม" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามเงื่อนไข", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจประเภทเกม รอบคำนวณ และข้อกำหนดของโปรโมชั่นให้เรียบร้อยก่อนกดยืนยันรับสิทธิ์ในแต่ละรอบ", tag: "ตรวจรอบก่อนกดรับ" },
];

const chips = ["บาคาร่า", "คาสิโนสด", "สล็อตออนไลน์", "หวยออนไลน์", "ฟุตบอล", "ขั้นต่ำ 1 บาท", "โบนัส 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ CASINO888" titleright="จุดที่ควรตรวจสอบก่อนยืนยันรายการเดิมพันกับ CASINO888" label="เข้าสู่ระบบ CASINO888 และตารางจุดที่ควรตรวจสอบก่อนยืนยันรายการเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b5216]/85 bg-[#0d0a06]/92 p-6 shadow-[0_10px_30px_rgba(228,194,90,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e4c25a]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4c25a]/60 bg-gradient-to-br from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fae582]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8a8a8a]">เข้าสู่ระบบ CASINO888 เพื่อเลือกหมวดบาคาร่า สล็อต หวย หรือฟุตบอล ตรวจสอบโปรโมชั่น จัดการเครดิต และดูประวัติรายการผ่านมือถือหรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8a8a8a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b5216] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e9ddc4] transition-all outline-none placeholder:text-[#8a8a8a] focus:border-[#e4c25a] focus:ring-1 focus:ring-[#e4c25a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8a8a8a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b5216] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e9ddc4] transition-all outline-none placeholder:text-[#8a8a8a] focus:border-[#e4c25a] focus:ring-1 focus:ring-[#e4c25a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e9ddc4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b5216] bg-[#050403] accent-[#e4c25a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e9ddc4] transition-colors hover:text-[#fdf49c]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#b28a2a]/55 bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] p-3.5 text-center font-black text-[#050403] shadow-[0_10px_30px_rgba(228,194,90,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(228,194,90,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8a8a8a]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b5216]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b5216]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c9c9c9]/40 bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#c9c9c9]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e4c25a]/40 bg-[#050403]/80 px-2.5 py-1 text-[10px] font-bold text-[#fae582]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fae582] transition-colors hover:text-[#fdf49c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b5216]/75 bg-[#0d0a06]/92 p-5 shadow-[0_10px_30px_rgba(228,194,90,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e9ddc4]">รวมเกมเดิมพันหลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล</span>
          <div class="bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8a8a8a] uppercase">
        <span>หมวดเกม โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b5216] bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#e4c25a]/60 hover:bg-[#17120a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9ddc4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6b5216]/85 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#fae582]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8a8a8a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e4c25a]/35 bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#fae582]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8a8a8a]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนยืนยันรายการ อัตราจ่าย กติกา และขั้นต่ำจริงขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
