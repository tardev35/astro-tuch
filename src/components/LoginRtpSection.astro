---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟคือ "365LOTTO รวมทั้งหวยและคาสิโนไว้ในระบบเดียว มีให้เลือกตั้งแต่หวย
// บาคาร่า ไพ่ สล็อต ไปจนถึงเกมรูปแบบอื่นอีกหลายประเภท" ตารางฝั่งขวาจึงเป็นหมวด
// และรายการที่บรีฟระบุไว้เอง ทุกแถวอ้างจากประโยคของบรีฟล้วนๆ — หวยรัฐบาลไทย ฮานอย
// ลาวพัฒนา, บาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่น, เลือกหมวดที่สนใจผ่านบัญชีเดียว,
// รองรับมือถือและคอมพิวเตอร์, เมนูจัดหมวดชัดเจน, แยกรอบเปิดรับของแต่ละประเภท,
// 2 ตัวจ่าย 100, 3 ตัวจ่าย 1,000, แนะนำเพื่อน 0.8%, คืนยอดเสีย 0.3%, สมัครผ่าน
// มือถือ 3 ขั้นตอน และแอดมินตลอด 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย จำนวนเกม ค่า
// RTP วันออกรางวัล ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง — บรีฟไม่ได้ระบุไว้
const catalogue = [
  {
    icon: "🏛️",
    name: "หวยรัฐบาลไทย",
    detail: "รายการหวยยอดนิยมที่เปิดรับในระบบเดียวกับตลาดอื่น แยกรอบเปิดรับไว้อย่างชัดเจน",
    rate: "บริการหลัก",
  },
  {
    icon: "🏮",
    name: "หวยฮานอย",
    detail: "อยู่ในหน้ารวมหวยเดียวกัน ตรวจสอบเลข รอบเวลา และรายละเอียดของรายการก่อนยืนยันได้",
    rate: "แยกรอบชัดเจน",
  },
  {
    icon: "🎫",
    name: "หวยลาวพัฒนา",
    detail: "ติดตามหวยหลายประเภทได้จากหน้าเดียวโดยไม่ต้องเปลี่ยนหลายเว็บไซต์",
    rate: "หน้าเดียวจบ",
  },
  {
    icon: "💯",
    name: "เลข 2 ตัว",
    detail: "ระบุอัตราจ่ายไว้ที่ 100 ตามเงื่อนไขของรายการ เลือกชุดตัวเลขและเช็กรายละเอียดบิลก่อนยืนยันได้",
    rate: "จ่าย 100",
  },
  {
    icon: "🔢",
    name: "เลข 3 ตัว",
    detail: "ระบุอัตราจ่ายไว้ที่ 1,000 ตามเงื่อนไขที่กำหนด ตรวจสอบเลข ประเภทหวย และรอบเวลาได้อีกครั้งก่อนทำรายการ",
    rate: "จ่าย 1,000",
  },
  {
    icon: "🃏",
    name: "บาคาร่า ไพ่ สล็อต",
    detail: "หมวดคาสิโนที่รวมอยู่ในระบบเดียวกับหวย เลือกหมวดที่สนใจผ่านบัญชีเดียวได้",
    rate: "บัญชีเดียว",
  },
  {
    icon: "🎲",
    name: "เกมรูปแบบอื่น",
    detail: "ตามรายการที่เปิดให้บริการ เมนูจัดหมวดชัดเจนจึงเข้าถึงรายการต่าง ๆ ได้สะดวกขึ้น",
    rate: "ตามรายการที่เปิด",
  },
  {
    icon: "📱",
    name: "มือถือและคอมพิวเตอร์",
    detail: "รองรับการใช้งานทั้งสองอุปกรณ์ สมัครผ่านมือถือเองได้ด้วย 3 ขั้นตอนหลัก",
    rate: "ทั้งสองอุปกรณ์",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของโปรโมชั่น ตรวจสอบยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ผ่านบัญชีได้",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้",
    rate: "0.3%",
  },
];

const chips = [
  "หวยรัฐบาลไทย",
  "หวยฮานอย",
  "ลาวพัฒนา",
  "บาคาร่า",
  "ไพ่",
  "สล็อต",
  "เกมรูปแบบอื่น",
  "บัญชีเดียวครบทุกหมวด",
  "เมนูจัดหมวดชัดเจน",
  "2 ตัวจ่าย 100",
  "3 ตัวจ่าย 1,000",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "แอดมิน 24 ชั่วโมง",
];

// 365LOTTO palette (แดง-ทอง-เงินโครเมียม): ทั้งสองแผงวางบนพื้นการ์ด #1a0709 เหนือ
// พื้นเพจ #120406 แผงล็อกอินอยู่ในกรอบทองหลัก #fadc64 ส่วนแผงรายการอยู่ในกรอบ
// ทองลึก #9c6a12 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจ
// ในเส้นพื้นยก #2a0b0e ตัวเน้นที่เป็นตัวเลขรับไล่เฉดทอง-เงิน-แดงตามลำดับสีในโลโก้
// ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว (#fdf3b4 → #fadc64 → #e0b03a) บนตัวอักษรสีพื้นเพจ
// เพราะทองคือสีประจำแบรนด์ แดงเป็นสีคู่ ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดและรายการที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการหมวดหวยรัฐบาลไทย ฮานอย ลาวพัฒนา พร้อมบาคาร่า ไพ่ สล็อต อัตราจ่ายเลข 2 ตัวและ 3 ตัว โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fadc64]/45 bg-[#1a0709]/94 p-6 shadow-[0_10px_30px_rgba(18,4,6,0.7)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fadc64]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fadc64]/70 bg-gradient-to-br from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] text-xl shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf3b4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f0ddc4]/75">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หรือบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นผ่านบัญชีเดียว ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f0ddc4]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2a0b0e] bg-[#120406]/95 py-3 pr-4 pl-12 text-[#f0ddc4] transition-all outline-none placeholder:text-[#f0ddc4]/50 focus:border-[#fadc64] focus:ring-1 focus:ring-[#f3f6fa]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f0ddc4]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2a0b0e] bg-[#120406]/95 py-3 pr-4 pl-12 text-[#f0ddc4] transition-all outline-none placeholder:text-[#f0ddc4]/50 focus:border-[#fadc64] focus:ring-1 focus:ring-[#f3f6fa]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f0ddc4]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2a0b0e] bg-[#120406] accent-[#fadc64]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f0ddc4]/75 transition-colors hover:text-[#fdf3b4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fdf3b4]/70 bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] p-3.5 text-center font-black text-[#120406] shadow-[0_10px_30px_rgba(250,220,100,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,243,180,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f0ddc4]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a0b0e]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a0b0e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2a0b0e] bg-[#120406] px-2.5 py-1 text-[10px] font-bold text-[#f0ddc4]"><span aria-hidden="true">🎫</span> หวยและคาสิโนในระบบเดียว</span>
            <span class="rounded-full border border-[#e01f26]/45 bg-[#120406]/85 px-2.5 py-1 text-[10px] font-bold text-[#f3f6fa]"><span aria-hidden="true">📱</span> มือถือและคอม</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdf3b4] transition-colors hover:text-[#f3f6fa]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#9c6a12]/70 bg-[#1a0709]/94 p-5 shadow-[0_10px_30px_rgba(18,4,6,0.65)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f0ddc4]/75">รวมหวยและคาสิโนไว้ในระบบเดียว เลือกหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หรือบาคาร่า ไพ่ สล็อต ได้จากหน้าเดียว</span>
          <div class="bg-gradient-to-r from-[#fdf3b4] via-[#f3f6fa] to-[#e01f26] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#2a0b0e] bg-[#120406]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01f26] shadow-[0_0_8px_rgba(224,31,38,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fdf3b4] uppercase">รอบที่เปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f0ddc4]/75 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#2a0b0e] bg-[#120406]/95 px-3.5 py-2.5 transition-colors hover:border-[#fadc64]/70 hover:bg-[#2a0b0e]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0ddc4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#9c6a12]/60 bg-[#120406] px-2.5 py-0.5 text-[10px] font-bold text-[#f3f6fa]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f0ddc4]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2a0b0e] bg-[#120406] px-3 py-1 text-[10px] font-bold text-[#f0ddc4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f0ddc4]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมหวยรัฐบาลไทย ฮานอย ลาวพัฒนา เข้ากับบาคาร่า ไพ่ สล็อต และเกมรูปแบบอื่นไว้ในระบบเดียว การรองรับทั้งมือถือและคอมพิวเตอร์ อัตราจ่ายเลข 2 ตัวที่
        100 และเลข 3 ตัวที่ 1,000 โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ส่วนรอบที่เปิดรับ ประเภทหวย รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจแตกต่างกันตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมหวยและหน้าโปรโมชั่น
        และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
