---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// BRAVO168 เป็นเว็บแทงบอลออนไลน์ ไม่ใช่เว็บสล็อตและไม่ใช่เว็บหวย แผงฝั่งขวารอบนี้จึงถูก
// เขียนใหม่ทั้งแผงจากคำของบรีฟเอง คือ บอลเดี่ยว บอลสเต็ป บอลสด ตลาดตามฤดูกาลที่ระบบ
// เปิดรับ ค่าน้ำกับอัตราต่อรอง และการตรวจคู่บอล ราคา กับรายละเอียดบิลผ่านมือถือก่อนยืนยัน
// ส่วนแผง "จุดที่ควรตรวจก่อนยืนยันบิล" ประกอบจากประโยคเตือนของบรีฟล้วนๆ คือ ราคาที่แสดง
// จริงในขณะนั้น เวลาปิดรับ เงื่อนไขโปรโมชั่น และประวัติบิลในบัญชีสมาชิก
//
// ห้ามใส่ชื่อลีกจริง ชื่อคู่แข่งขันจริง ตัวเลขอัตราต่อรอง ตารางค่าน้ำ ชื่อผู้ให้บริการ ชื่อธนาคาร
// เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิกลงในไฟล์นี้ — บรีฟ BRAVO168 ไม่ได้ให้ไว้เลย
// สักอย่าง และตัวเลขอัตราต่อรองที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ
// ป้ายกำกับทุกใบจึงเป็น "ชนิดของการเดิมพัน" แบบบรรยาย ไม่ใช่ตัวเลข ตัวเลขที่ใช้ได้มีเท่าที่
// บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · 24 ชั่วโมง ·
// เลข 168 ในชื่อแบรนด์ และห้ามแตกเป็นเงื่อนไข/รอบตัดยอดที่บรีฟไม่ได้บอก
const betMarkets = [
  { icon: "🎯", name: "บอลเดี่ยว", detail: "เหมาะกับผู้ที่ต้องการเลือกผลจากคู่ใดคู่หนึ่ง ตามรายการที่ระบบเปิดรับในช่วงเวลานั้น" },
  { icon: "🧾", name: "บอลสเต็ป", detail: "รวมหลายคู่ไว้ในบิลเดียว โดยควรตรวจรายละเอียดบิลทุกคู่ก่อนกดยืนยันรายการ" },
  { icon: "📡", name: "บอลสด", detail: "เปิดตัวเลือกเดิมพันระหว่างการแข่งขันตามตลาดที่ระบบรองรับ ราคาเปลี่ยนได้ระหว่างเกม" },
  { icon: "🗓️", name: "ตลาดตามฤดูกาล", detail: "รายการแข่งขันทยอยแสดงตามช่วงเวลาที่กำหนด เมื่อแต่ละลีกเริ่มเปิดตลาดในฤดูกาลนั้น" },
  { icon: "⚖️", name: "ค่าน้ำและอัตราต่อรอง", detail: "แสดงอยู่บนคู่แข่งขันที่เลือก และเปลี่ยนแปลงได้ตามตลาด เวลา และคู่แข่งขัน" },
  { icon: "📱", name: "ตรวจบิลผ่านมือถือ", detail: "ตรวจสอบคู่บอล ราคา อัตราต่อรอง และรายละเอียดบิลจากบัญชีเดียวก่อนยืนยันการเดิมพัน" },
];

// สี่ข้อนี้ประกอบจากประโยคเตือนของบรีฟเองทั้งหมด — อ้างอิงราคาที่แสดงจริงในขณะนั้น, ตรวจ
// เวลาปิดรับกับกติกาของตลาด, ตรวจรอบคำนวณกับยอดที่เข้าเกณฑ์ของโปรโมชั่น และตรวจประวัติ
// บิลกับข้อมูลบัญชีสมาชิก
const beforeBillChecks = [
  {
    icon: "💧",
    name: "ราคาที่แสดงจริงในขณะนั้น",
    detail: "คำว่า ค่าน้ำดีที่สุด ควรอ้างอิงราคาที่แสดงจริงในขณะนั้น เพราะค่าน้ำและอัตราต่อรองเปลี่ยนแปลงได้ตามตลาด เวลา และคู่แข่งขัน",
    tag: "ดูราคาบนบิล",
  },
  {
    icon: "⏱️",
    name: "เวลาปิดรับและกติกาของตลาด",
    detail: "ควรตรวจสอบเวลาปิดรับ อัตราต่อรอง และรายละเอียดบิลก่อนกดยืนยัน โดยเฉพาะบอลสดที่ราคาและตลาดเปลี่ยนได้ระหว่างการแข่งขัน",
    tag: "ตรวจก่อนกดยืนยัน",
  },
  {
    icon: "🎁",
    name: "เงื่อนไขของโปรโมชั่น",
    detail: "โปรโมชั่นอาจกำหนดประเภทการเดิมพัน ลีก ยอดที่เข้าเกณฑ์ และรอบคำนวณแตกต่างกัน ก่อนรับโบนัสจึงควรอ่านเงื่อนไขล่าสุดให้ครบถ้วน",
    tag: "อ่านก่อนกดรับ",
  },
  {
    icon: "🗂️",
    name: "ประวัติบิลในบัญชีสมาชิก",
    detail: "ติดตามรายการฟุตบอล อัตราต่อรอง โปรโมชั่น และประวัติบิลได้จากบัญชีเดียว หากผลเดิมพันยังไม่อัปเดตสามารถแจ้งแอดมินพร้อมเลขบิลได้",
    tag: "ตรวจจากบัญชีสมาชิก",
  },
];

const chips = ["บอลเดี่ยว", "บอลสเต็ป", "บอลสด", "ค่าน้ำ", "อัตราต่อรอง", "เวลาปิดรับ", "รายละเอียดบิล", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];

// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): โลโก้เป็นเวิร์ดมาร์กสองโทน ตัวอักษร BRAVO
// เป็นโครเมียมไล่น้ำเงินรอยัล #1558c4 ส่วนเลข 168 เป็นทองตัน #f4cb69 งานอาร์ตเป็นสนาม
// กลางคืนพื้นกรมท่าที่มีริ้วแสงทองพาดโค้ง ลูกฟุตบอลทอง-กรมท่า เหรียญทองกองสูง กล่องของขวัญ
// กรมท่า-ทอง และถ้วยรางวัลทอง สองแผงจึงถูกแยกด้วยคู่ทอง/น้ำเงินตามงานอาร์ตจริง ไม่ใช่
// น้ำหนักของสีเดียว — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #f4cb69 ส่วนแผงตลาดบอลอยู่ในกรอบ
// น้ำเงินรอยัล #1558c4 ทั้งคู่วางบนผิวการ์ด #04142f เหนือพื้นเพจ #02081a ช่องกรอกและชิป
// ตกลงไปที่พื้นเพจในเส้นผิวแผงยก #072247 บรรทัดเด่นไล่เฉดทองอ่อน #ffe39a → ทองแบรนด์
// #f4cb69 → ทองลึก #c9922e ปุ่มเข้าสู่ระบบเป็นทองเต็มตัวบนหมึกเข้ม #0a1020 ตามกฎ
// คอนทราสต์ที่ว่าพื้นทองต้องใช้หมึกเข้ม (12.9:1) ห้ามใช้ตัวอักษรขาว (1.6:1) ปุ่มไลน์ยังคง
// สีเขียว #00B900 ของแพลตฟอร์มซึ่งห้ามรีแมป — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างใน
// ไฟล์นี้ (#8bfc13 #c9ff8f #1a7a08 #eaffd6 #e8f0e6 #8fa38a #0b160b #0f1b0e #030703
// #d5e6cd) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`ตลาดบอลที่เปิดให้เลือก ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="⚽"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรูปแบบการเดิมพันที่เปิดให้เลือกทั้งบอลเดี่ยว บอลสเต็ป บอลสด ตลาดตามฤดูกาล ค่าน้ำกับอัตราต่อรอง และจุดที่ควรตรวจสอบก่อนกดยืนยันบิลทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f4cb69]/45 bg-[#04142f]/94 p-6 shadow-[0_10px_30px_rgba(1,3,10,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f4cb69]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f4cb69]/70 bg-gradient-to-br from-[#ffe39a] via-[#f4cb69] to-[#c9922e] text-xl text-[#0a1020] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe39a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#dbe5f5]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ เพื่อเลือกลีก คู่แข่งขัน และรูปแบบเดิมพันที่ต้องการ พร้อมตรวจอัตราต่อรอง โปรโมชั่น และประวัติบิลจากบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbe5f5]/60">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#072247] bg-[#02081a]/95 py-3 pr-4 pl-12 text-[#dbe5f5] transition-all outline-none placeholder:text-[#dbe5f5]/45 focus:border-[#f4cb69] focus:ring-1 focus:ring-[#2f86f0]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbe5f5]/60">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#072247] bg-[#02081a]/95 py-3 pr-4 pl-12 text-[#dbe5f5] transition-all outline-none placeholder:text-[#dbe5f5]/45 focus:border-[#f4cb69] focus:ring-1 focus:ring-[#2f86f0]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dbe5f5]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#072247] bg-[#02081a] accent-[#f4cb69]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dbe5f5]/70 transition-colors hover:text-[#ffe39a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe39a]/70 bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] p-3.5 text-center font-black text-[#0a1020] shadow-[0_10px_30px_rgba(244,203,105,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,227,154,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dbe5f5]/60">
          <span aria-hidden="true" class="h-px flex-1 bg-[#072247]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#072247]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#072247] bg-[#02081a] px-2.5 py-1 text-[10px] font-bold text-[#dbe5f5]"><span aria-hidden="true">⚽</span> แทงบอลออนไลน์</span>
            <span class="rounded-full border border-[#f4cb69]/40 bg-[#02081a]/85 px-2.5 py-1 text-[10px] font-bold text-[#f4cb69]"><span aria-hidden="true">📱</span> เล่นผ่านเบราว์เซอร์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f4cb69] transition-colors hover:text-[#ffe39a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#1558c4]/70 bg-[#04142f]/94 p-5 shadow-[0_10px_30px_rgba(1,3,10,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dbe5f5]/70">
            {BRAND_NAME} รวบรวมตลาดฟุตบอลจากหลายรายการแข่งขันให้สมาชิกเลือกตามสไตล์การเดิมพัน ดูราคาและรูปแบบเดิมพันได้หลากหลายจากบัญชีเดียว พร้อมรายการแข่งขันตามฤดูกาลที่ระบบเปิดรับ
          </span>
          <div class="bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">บอลเดี่ยว · บอลสเต็ป · บอลสด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#072247] bg-[#02081a]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f4cb69] shadow-[0_0_8px_rgba(244,203,105,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffe39a] uppercase">ตามตารางแข่งขันที่เปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dbe5f5]/65 uppercase">
        <span>รูปแบบเดิมพันในระบบ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          betMarkets.map((m) => (
            <div class="rounded-xl border border-[#072247] bg-[#02081a]/95 px-3.5 py-2.5 transition-colors hover:border-[#f4cb69]/70 hover:bg-[#072247]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#ffe39a]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {m.icon}
                </span>
                <span class="truncate">{m.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#dbe5f5]/70">{m.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#dbe5f5]/70">
        รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการ ก่อนกดยืนยันจึงควรตรวจสอบเวลาปิดรับ อัตราต่อรอง และรายละเอียดบิลทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dbe5f5]/65 uppercase">
        <span>จุดที่ควรตรวจก่อนยืนยันบิล</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeBillChecks.map((k) => (
            <div class="rounded-xl border border-[#072247] bg-[#02081a]/95 px-3.5 py-2.5 transition-colors hover:border-[#2f86f0]/60 hover:bg-[#072247]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe5f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f4cb69]/50 bg-[#02081a] px-2.5 py-0.5 text-[10px] font-bold text-[#f4cb69]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#dbe5f5]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#072247] bg-[#02081a] px-3 py-1 text-[10px] font-bold text-[#dbe5f5]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dbe5f5]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมตลาดฟุตบอลจากหลายรายการแข่งขันไว้ในบัญชีเดียว การเปิดรับบอลเดี่ยว บอลสเต็ป และบอลสดตามตลาดที่ระบบรองรับ การตรวจคู่บอล ราคา อัตราต่อรอง
