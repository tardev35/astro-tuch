// rgba(1,147,251,…) rgba(252,230,4,…)) และชุดทองเมทัลลิกของ 789BETTING ก่อนหน้านั้น
// (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #17130a #0e0b05 #060402 #0a0802
// #b5a888 #f3e7cd) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`ระบบและสิทธิ์ที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`}
  iconleft="🔐"
  iconright="🧭"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการระบบและสิทธิ์ที่รวบรวมไว้ในระบบเดียว ทั้งการจัดการบัญชีสมาชิก การตรวจสอบรายการ การเข้ารหัสข้อมูล การจัดการสิทธิ์เข้าถึง การแจ้งเตือนรายการผิดปกติ โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และจุดที่ควรตรวจสอบก่อนใช้งานทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#cc920a]/50 bg-[#0d2414] p-6 shadow-[0_0_28px_rgba(204,146,10,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8a6204]/40 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#8a6204] bg-gradient-to-br from-[#fde9a6] via-[#f7d14e] to-[#cc920a] text-xl text-[#07170c] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f7d14e]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e8f2e6]/70">
            เข้าสู่ระบบ {BRAND_NAME} ผ่านมือถือหรือคอมพิวเตอร์ได้สะดวก แล้วจัดการบัญชีสมาชิก ตรวจสอบรายการใช้งาน โปรโมชั่น ยอดที่เข้าเกณฑ์ และประวัติการรับสิทธิ์ได้จากหน้าเดียวทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8f2e6]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#043d1c] bg-[#020803] py-3 pr-4 pl-12 text-[#e8f2e6] transition-all outline-none placeholder:text-[#e8f2e6]/60 focus:border-[#cc920a] focus:ring-1 focus:ring-[#cc920a]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8f2e6]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#043d1c] bg-[#020803] py-3 pr-4 pl-12 text-[#e8f2e6] transition-all outline-none placeholder:text-[#e8f2e6]/60 focus:border-[#cc920a] focus:ring-1 focus:ring-[#cc920a]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8f2e6]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#043d1c] bg-[#020803] accent-[#cc920a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8f2e6]/70 transition-colors hover:text-[#f7d14e]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#cc920a]/60 bg-gradient-to-b from-[#0d2414] to-[#020803] p-3.5 text-center font-black text-[#e8f2e6] shadow-[0_0_12px_rgba(204,146,10,0.25)] transition-all hover:scale-[1.02] hover:border-[#cc920a] hover:text-[#f7d14e]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e8f2e6]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#043d1c]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#043d1c]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#cc920a]/50 bg-[#020803] px-2.5 py-1 text-[10px] font-bold text-[#f7d14e]"><span aria-hidden="true">🧭</span> ช่องทางเข้าเล่นในระบบเดียว</span>
            <span class="rounded-full border border-[#0a6b32]/60 bg-[#020803] px-2.5 py-1 text-[10px] font-bold text-[#2fbf6a]"><span aria-hidden="true">📱</span> มือถือและคอมพิวเตอร์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f7d14e] transition-colors hover:text-[#2fbf6a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0a6b32]/50 bg-[#0d2414] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8f2e6]/70">
            {BRAND_NAME} รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว ตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว รองรับทั้งมือถือและคอมพิวเตอร์โดยไม่ต้องสลับหลายหน้าจอ
          </span>
          <div class="bg-gradient-to-r from-[#fde9a6] via-[#f7d14e] to-[#2fbf6a] bg-clip-text text-xl font-black text-transparent sm:text-2xl">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#cc920a] bg-[#020803] px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f7d14e] shadow-[0_0_8px_rgba(247,209,78,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f7d14e] uppercase">ตามรอบคำนวณที่กำหนด</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8f2e6]/70 uppercase">
        <span>ระบบและสิทธิ์ที่รวมไว้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          systemFeatures.map((t) => (
            <div class="rounded-xl border border-[#043d1c] bg-[#020803] px-3.5 py-2.5 transition-colors hover:border-[#cc920a]/80 hover:bg-[#09190d]">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#f7d14e]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#e8f2e6]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#e8f2e6]/70">
        รายการที่เปิดให้บริการอาจเปลี่ยนแปลงตามช่วงเวลา จึงควรตรวจสอบรายละเอียดที่แสดงในระบบก่อนใช้งานทุกครั้ง ส่วนการระบุว่าเป็นเว็บไม่ผ่านเอเย่นต์ ควรมีข้อมูลผู้ดำเนินงานและช่องทางหลักที่ตรวจสอบ
        ได้รองรับ ไม่ควรพิจารณาจากข้อความบนหน้าเว็บเพียงอย่างเดียว
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8f2e6]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeUseChecks.map((k) => (
            <div class="rounded-xl border border-[#043d1c] bg-[#020803] px-3.5 py-2.5 transition-colors hover:border-[#2fbf6a]/70 hover:bg-[#09190d]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8f2e6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#0a6b32]/60 bg-[#09190d] px-2.5 py-0.5 text-[10px] font-bold text-[#2fbf6a]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e8f2e6]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#043d1c] bg-[#020803] px-3 py-1 text-[10px] font-bold text-[#e8f2e6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e8f2e6]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว การเข้าสู่ระบบ จัดการบัญชีสมาชิก และตรวจสอบรายการจากหน้าเดียว พร้อมมาตรการที่ตรวจสอบได้อย่าง
        การเข้ารหัสข้อมูล การจัดการสิทธิ์เข้าถึง และการแจ้งเตือนรายการผิดปกติ ส่วนโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ไม่ใช่ทุกการเดิมพันจะได้รับโบนัส
        โดยอัตโนมัติ จึงควรตรวจสอบเวลาตัดรอบและข้อกำหนดก่อนใช้งานโบนัสทุกครั้ง หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้บุคคลนั้นจะอ้าง
        ว่าเป็นแอดมินก็ตาม
      </div>
    </div>
  </div>
</ContentBoxTwo>
