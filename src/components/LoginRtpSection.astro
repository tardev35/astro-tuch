---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// PKG44 เป็นเว็บเกมปั่นสล็อตที่รวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมรูปแบบการเชื่อมต่อ API
// และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ แผงฝั่งขวาจึงมีแค่สองกลุ่มที่บรีฟระบุไว้จริง คือ สามสิ่งที่
// บรีฟบอกว่าตรวจสอบได้ก่อนเริ่มเล่น (ชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้อง) กับสี่เรื่องที่
// บรีฟบอกว่าจัดการผ่านระบบบัญชีสมาชิก (ขั้นตอนเข้าสู่ระบบ การจัดการรายการเป็นขั้นตอน เมนูที่
// แบ่งหมวดหมู่ชัดเจน และการใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกมเจาะจง ชื่อเกม ค่า RTP ขั้นต่ำการเดิมพัน ช่องทางฝากถอน ชื่อธนาคาร
// หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่บรีฟให้คือโบนัสแนะนำ
// เพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้าแล้ว การเติมชื่อค่ายหรือรายชื่อเกม
// ลงตารางนี้คือการแต่งข้อมูลขึ้นมา
//
// บรีฟรอบนี้พูดแค่ "ติดต่อเจ้าหน้าที่ PKG44 ได้ตลอด 24 ชั่วโมง" และไม่ได้ระบุไลน์ เนื้อความจึง
// ไม่เขียนว่าไลน์/ไลน์แอด — มีแค่ป้ายบนปุ่มที่ลิงก์ /line ซึ่งเขียนตามปลายทางจริงของปุ่ม และ
// ไม่มีคำว่า คาสิโน บาคาร่า เกมสด เกมโต๊ะ หวย บอล หรือเครดิตฟรี อยู่ในบรีฟเลย
const checkBeforePlay = [
  {
    icon: "🏷️",
    name: "ชื่อค่ายสล็อต",
    detail: "ตรวจสอบชื่อค่ายที่เปิดให้บริการได้ก่อนเริ่มเล่น ตามรายการที่เว็บไซต์ระบุไว้",
    tag: "ดูก่อนเริ่มเล่น",
  },
  {
    icon: "🎰",
    name: "รายละเอียดเกม",
    detail: "เปิดดูรายละเอียดของเกมปั่นสล็อตแต่ละรายการได้ ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา",
    tag: "อัปเดตตามช่วงเวลา",
  },
  {
    icon: "🎁",
    name: "ข้อมูลโปรโมชั่น",
    detail: "ตรวจสอบยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขของแต่ละโปรโมชั่นได้ก่อนกดรับ",
    tag: "อ่านเงื่อนไขก่อนกดรับ",
  },
];

const accountChecks = [
  {
    icon: "🔑",
    name: "ขั้นตอนเข้าสู่ระบบ",
    detail: "เข้าสู่ระบบผ่านบัญชีสมาชิกตามขั้นตอนที่เว็บไซต์กำหนด ไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    tag: "บัญชีสมาชิก",
  },
  {
    icon: "📋",
    name: "จัดการรายการเป็นขั้นตอน",
    detail: "ระบบบัญชีช่วยให้จัดการรายการต่าง ๆ ได้เป็นขั้นตอนมากขึ้น จบจากบัญชีเดียว",
    tag: "จบจากบัญชีเดียว",
  },
  {
    icon: "🗂️",
    name: "เมนูแบ่งหมวดหมู่",
    detail: "เมนูแบ่งหมวดหมู่ชัดเจน ช่วยให้เข้าถึงเกมสล็อตแต่ละค่ายได้สะดวกจากบัญชีเดียว",
    tag: "หาค่ายได้ไว",
  },
  {
    icon: "📱",
    name: "มือถือและคอมพิวเตอร์",
    detail: "รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์ ใช้บัญชีเดียวกันได้ทั้งสองอุปกรณ์",
    tag: "ใช้ได้ทั้งสองจอ",
  },
];

const chips = [
  "เกมปั่นสล็อต API แท้",
  "สล็อตหลายค่ายในระบบเดียว",
  "ข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ",
  "เมนูแบ่งหมวดหมู่ชัดเจน",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "สมัครเอง 3 ขั้นตอน",
  "เจ้าหน้าที่ 24 ชั่วโมง",
];

// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): โลโก้เป็นเวิร์ดมาร์กสองวัสดุ P กับ G44
// เป็นทองเมทัลลิก ส่วน K เป็นโครเมียมขัดเงา สองแผงจึงถูกแยกด้วยวัสดุคนละชนิด ไม่ใช่แค่
// ความสว่างของกรอบ — แผงล็อกอินอยู่ในกรอบทองแบรนด์ #fdd32a ส่วนแผงตรวจสอบอยู่ในกรอบ
// โครเมียม #c2c8d0 ทั้งคู่วางบนผิวการ์ด #12100a เหนือพื้นเพจ #080602 ช่องกรอกและชิปตกลง
// ไปที่พื้นเพจในเส้นผิวการ์ดยก #2a2110 บรรทัดเด่นรับไล่เฉดสองวัสดุตามลำดับบนโลโก้ คือ
// โครเมียมสว่าง #f2f4f7 → ทองอ่อน #ffeeb8 → ทองแบรนด์ #fdd32a ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#ffe27a → #fdd32a → #c8920a) บนตัวอักษร #15110a ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้น
// สว่างต้องเกือบดำ ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์มซึ่งเป็นคนละสีกับสีแบรนด์และ
// ห้ามรีแมป — ชุดเขียวมรกตของ BRAZIL999 (#22c55e #7cf25c #b6ff9c #0a6b18 #04380c
// #1c5a26 #123a18 #0a1a0c #040a05 #aab4bf #f1f5f9 #6b7580 #dfeadd #f4fbf2) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`สิ่งที่ ${BRAND_NAME} ให้ตรวจสอบได้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการสิ่งที่เว็บไซต์เปิดให้ตรวจสอบก่อนเริ่มเล่น ทั้งชื่อค่ายสล็อต รายละเอียดเกม ข้อมูลโปรโมชั่น และการจัดการรายการผ่านระบบบัญชี`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fdd32a]/45 bg-[#12100a]/94 p-6 shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fdd32a]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fdd32a]/70 bg-gradient-to-br from-[#ffe27a] via-[#fdd32a] to-[#c8920a] text-xl text-[#15110a] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff8e1]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#efe6d2]/75">
            เข้าสู่ระบบ {BRAND_NAME} ผ่านบัญชีสมาชิกเพื่อเลือกเกมสล็อตแต่ละค่ายจากบัญชีเดียว พร้อมตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องก่อนเริ่มเล่น เมนูแบ่งหมวดหมู่ชัดเจนและรองรับทั้งมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#efe6d2]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2a2110] bg-[#080602]/95 py-3 pr-4 pl-12 text-[#efe6d2] transition-all outline-none placeholder:text-[#efe6d2]/50 focus:border-[#fdd32a] focus:ring-1 focus:ring-[#ffe27a]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#efe6d2]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2a2110] bg-[#080602]/95 py-3 pr-4 pl-12 text-[#efe6d2] transition-all outline-none placeholder:text-[#efe6d2]/50 focus:border-[#fdd32a] focus:ring-1 focus:ring-[#ffe27a]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#efe6d2]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2a2110] bg-[#080602] accent-[#fdd32a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#efe6d2]/75 transition-colors hover:text-[#ffe27a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe27a]/70 bg-gradient-to-r from-[#ffe27a] via-[#fdd32a] to-[#c8920a] p-3.5 text-center font-black text-[#15110a] shadow-[0_10px_30px_rgba(253,211,42,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,226,122,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#efe6d2]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a2110]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#2a2110]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2a2110] bg-[#080602] px-2.5 py-1 text-[10px] font-bold text-[#efe6d2]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#c2c8d0]/40 bg-[#080602]/85 px-2.5 py-1 text-[10px] font-bold text-[#c2c8d0]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c2c8d0] transition-colors hover:text-[#f2f4f7]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c2c8d0]/40 bg-[#12100a]/94 p-5 shadow-[0_10px_30px_rgba(8,6,2,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#efe6d2]/75">
            สมาชิกตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องได้ก่อนเริ่มเล่น แล้วจัดการรายการต่าง ๆ ผ่านระบบบัญชีได้เป็นขั้นตอนจากบัญชีเดียว
          </span>
          <div class="bg-gradient-to-r from-[#f2f4f7] via-[#ffeeb8] to-[#fdd32a] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สล็อตหลายค่าย · เชื่อมต่อ API · บัญชีเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#2a2110] bg-[#080602]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c2c8d0] shadow-[0_0_8px_rgba(194,200,208,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#c2c8d0] uppercase">ลิขสิทธิ์ตามที่เว็บไซต์ระบุ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#efe6d2]/75 uppercase">
        <span>ตรวจสอบได้ก่อนเริ่มเล่น</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          checkBeforePlay.map((c) => (
            <div class="rounded-xl border border-[#4a3a12]/60 bg-[#080602]/95 px-3.5 py-2.5 transition-colors hover:border-[#fdd32a]/70 hover:bg-[#2a2110]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fff8e1]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fdd32a]/60 bg-gradient-to-r from-[#fdd32a] to-[#c8920a] px-2.5 py-0.5 text-[10px] font-black text-[#15110a]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#efe6d2]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#efe6d2]/75 uppercase">
        <span>จัดการผ่านระบบบัญชีสมาชิก</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          accountChecks.map((k) => (
            <div class="rounded-xl border border-[#2a2110] bg-[#080602]/95 px-3.5 py-2.5 transition-colors hover:border-[#c2c8d0]/70 hover:bg-[#2a2110]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efe6d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c2c8d0]/50 bg-[#080602] px-2.5 py-0.5 text-[10px] font-bold text-[#c2c8d0]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#efe6d2]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2a2110] bg-[#080602] px-3 py-1 text-[10px] font-bold text-[#efe6d2]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#efe6d2]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ การเลือกได้ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่
        อัปเดตตามช่วงเวลา และการใช้งานผ่านเมนูที่จัดไว้ชัดเจนทั้งบนมือถือและคอมพิวเตอร์ ส่วนเงื่อนไขของแต่ละโปรโมชั่นอาจแตกต่างกันตามที่ระบบกำหนด ให้ยึดข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการของเว็บไซต์
        ก่อนทำรายการทุกครั้ง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
