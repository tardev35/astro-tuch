---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief เปลี่ยนเป็น "สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง" ทุกแถวจึงเป็น
// ข้อเท็จจริงที่ brief ระบุไว้เองล้วนๆ — รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว,
// เน้นทางเข้าเว็บตรงที่ใช้งานง่าย, จัดหมวดเกมไว้อย่างชัดเจน, ระบบออโต้ที่ช่วย
// จัดการบัญชีและเข้าเล่นได้สะดวกทั้งบนมือถือและคอมพิวเตอร์, เกมยอดนิยมหลายสไตล์
// ทั้งสล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอต, เปิดดูข้อมูลของแต่ละเกมกับรอบโบนัส
// และระดับเดิมพันก่อนเลือกเล่น, โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่
// ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น, ช่องทางธนาคารและวอลเลทตาม
// รายการที่เว็บไซต์เปิดให้ใช้งาน และการติดต่อแอดมินเรื่องสมัคร ทางเข้าเว็บ
// โปรโมชั่น เกม หรือระบบฝากถอน
// brief รอบนี้ไม่ได้ระบุ "24 ชั่วโมง" หรือยอดขั้นต่ำ/ขั้นสูงไว้ จึงไม่มีแถวไหนพูดถึง
// และไม่มีการคิดตัวเลข ค่ายเกม หรือเงื่อนไขขึ้นมาเอง
const menus = [
  {
    icon: "🎰",
    name: "รวมเกมสล็อตจากหลายค่าย",
    detail: "รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว เลือกดูตามหมวดหมู่และตรวจสอบรายละเอียดของแต่ละเกมได้ก่อนเข้าเล่น",
    tag: "หลายค่าย",
  },
  {
    icon: "🚪",
    name: "เน้นทางเข้าเว็บตรง",
    detail: "เน้นทางเข้าเว็บตรงที่ใช้งานง่าย แนะนำให้เลือกใช้ทางเข้าที่เว็บไซต์ประกาศไว้ทุกครั้งที่เข้าใช้งาน",
    tag: "เว็บตรง",
  },
  {
    icon: "⚙️",
    name: "ระบบออโต้จัดการบัญชี",
    detail: "ระบบออโต้ช่วยให้จัดการบัญชีและเข้าเล่นได้สะดวกมากขึ้น ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์",
    tag: "ออโต้",
  },
  {
    icon: "🗂️",
    name: "จัดหมวดเกมไว้ชัดเจน",
    detail: "จัดหมวดเกมไว้อย่างชัดเจน เหมาะกับคนที่ต้องการค้นหาเกมยอดนิยมจากหน้าเดียวโดยไม่ต้องไล่หาทีละรายการ",
    tag: "แยกหมวด",
  },
  {
    icon: "🔥",
    name: "เกมยอดนิยมหลายสไตล์",
    detail: "รวบรวมเกมยอดนิยมหลายสไตล์ ทั้งสล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอตจากหลายค่าย",
    tag: "ติดอันดับ",
  },
  {
    icon: "🔎",
    name: "เปิดดูข้อมูลเกมก่อนเลือกเล่น",
    detail: "เปิดดูข้อมูลของแต่ละเกมก่อนเลือกเล่น พร้อมตรวจสอบรายละเอียดของรอบโบนัสและระดับเดิมพันได้จากหน้าเกมโดยตรง",
    tag: "ดูก่อนเล่น",
  },
  {
    icon: "💰",
    name: "โบนัสคืนยอดเสีย 0.3%",
    detail: "รับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ได้ก่อนรับสิทธิ์",
    tag: "0.3%",
  },
  {
    icon: "🤝",
    name: "โบนัสแนะนำเพื่อน 0.8%",
    detail: "ชวนคนรู้จักเข้ามาสมัครผ่านช่องทางที่ระบบรองรับ รับโบนัส 0.8% ตามเงื่อนไขที่กำหนด ตรวจสอบยอดสิทธิ์ได้จากบัญชีสมาชิก",
    tag: "0.8%",
  },
  {
    icon: "🏦",
    name: "รองรับธนาคารและวอลเลท",
    detail: "รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบสถานะฝากถอนและยอดเครดิตจากบัญชีได้โดยตรง",
    tag: "ฝากถอน",
  },
  {
    icon: "💬",
    name: "ติดต่อแอดมินได้โดยตรง",
    detail: "สอบถามแอดมินได้โดยตรงทั้งเรื่องการสมัคร ทางเข้าเว็บ โปรโมชั่น เกม หรือระบบฝากถอน",
    tag: "แอดมิน",
  },
];

const chips = [
  "สล็อตออโต้Top3",
  "เว็บตรง",
  "ติดอันดับมาแรง",
  "เกมยอดนิยม",
  "สล็อตโบนัส",
  "เกมฟีเจอร์",
  "เกมแจ็คพอต",
  "หลายค่าย",
  "จัดหมวดเกมชัดเจน",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ธนาคารและวอลเลท",
];

// FAH999 palette (royal purple + gold): both panels sit on the card surface
// (#2a0a4d) over the page purple-black (#0d0119), with the login plate framed in
// primary gold (#fbbf13) and the service list framed in purple-mid (#7c2fd4) —
// the logo's two hues, not one hue twice. Inputs and chips drop to the card base
// (#180430) inside purple-deep hairlines (#4a1188). The LINE button keeps the
// platform's own green.
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`จุดเด่นของ ${BRAND_NAME} ที่เว็บระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการจุดเด่นเรื่องสล็อตออโต้เว็บตรง การจัดหมวดเกม โปรโมชั่น และช่องทางธนาคารกับวอลเลทที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fbbf13]/40 bg-[#2a0a4d]/94 p-6 shadow-[0_10px_30px_rgba(13,1,25,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a855f7]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fbbf13]/70 bg-gradient-to-br from-[#fef354] via-[#fbbf13] to-[#7c2fd4] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffdf6b]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ecdcff]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกเกมจากหลายค่ายที่จัดหมวดไว้ชัดเจน ตรวจสอบรอบโบนัสกับระดับเดิมพันของแต่ละเกม และดูสถานะฝากถอนกับยอดเครดิตของบัญชีตัวเองได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecdcff]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4a1188] bg-[#0d0119]/95 py-3 pr-4 pl-12 text-[#ecdcff] transition-all outline-none placeholder:text-[#ecdcff]/50 focus:border-[#fbbf13] focus:ring-1 focus:ring-[#ffdf6b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecdcff]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4a1188] bg-[#0d0119]/95 py-3 pr-4 pl-12 text-[#ecdcff] transition-all outline-none placeholder:text-[#ecdcff]/50 focus:border-[#fbbf13] focus:ring-1 focus:ring-[#ffdf6b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ecdcff]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4a1188] bg-[#0d0119] accent-[#fbbf13]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ecdcff]/80 transition-colors hover:text-[#ffdf6b]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fef354]/70 bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#7c2fd4] p-3.5 text-center font-black text-[#180430] shadow-[0_10px_30px_rgba(251,191,19,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(168,85,247,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ecdcff]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#4a1188]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#4a1188]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#4a1188] bg-[#0d0119] px-2.5 py-1 text-[10px] font-bold text-[#ecdcff]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#fbbf13]/50 bg-[#0d0119]/85 px-2.5 py-1 text-[10px] font-bold text-[#ffdf6b]"><span aria-hidden="true">⚙️</span> ระบบออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffdf6b] transition-colors hover:text-[#fbbf13]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7c2fd4]/55 bg-[#2a0a4d]/94 p-5 shadow-[0_10px_30px_rgba(13,1,25,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ecdcff]/70">สล็อตออโต้Top3 เว็บตรง</span>
          <div class="bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#a855f7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ติดอันดับมาแรง รวมเกมยอดนิยม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#4a1188] bg-[#0d0119]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fbbf13] shadow-[0_0_8px_rgba(251,191,19,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffdf6b] uppercase">ออโต้</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ecdcff]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#4a1188] bg-[#180430]/95 px-3.5 py-2.5 transition-colors hover:border-[#fbbf13]/70 hover:bg-[#2a0a4d]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ecdcff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffdf6b]/45 bg-[#0d0119] px-2.5 py-0.5 text-[10px] font-bold text-[#ffdf6b]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ecdcff]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#4a1188] bg-[#0d0119] px-3 py-1 text-[10px] font-bold text-[#ecdcff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ecdcff]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียวที่จัดหมวดไว้ชัดเจน ช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน และโปรโมชั่นที่เปิดให้ตรวจสอบรายละเอียดก่อนกดรับ
        ส่วนรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และเงื่อนไขของแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
