---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the brief states: เกมสล็อตหลากหลายค่ายใน
// บัญชีเดียว, เกมยอดนิยม/เกมใหม่/เกมโบนัส/สล็อตแจ็คพอต, โปรโมชั่นและคอมมิชชั่น
// ตามเงื่อนไขของแต่ละกิจกรรม, ระบบฝากถอนอัตโนมัติ และแอดมินที่ช่วยตรวจสอบรายการ
// ตลอด 24 ชั่วโมง.
const menus = [
  { icon: "🎰", name: "สล็อตเกมยอดนิยม", detail: "หมวดเกมที่สมาชิกเลือกเล่นมากที่สุด ตรวจสอบกติกาและอัตราเดิมพันได้จากหน้ารายละเอียดเกม", tag: "ยอดนิยมในระบบ" },
  { icon: "🆕", name: "สล็อตเกมใหม่", detail: "ดูรายชื่อค่ายและเกมสล็อตที่เพิ่งเปิดให้บริการล่าสุดได้จากหน้าเกมในบัญชีของตนเอง", tag: "อัปเดตต่อเนื่อง" },
  { icon: "🎁", name: "สล็อตเกมโบนัส", detail: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว อ่านรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มหมุน", tag: "อ่านฟีเจอร์ก่อนเล่น" },
  { icon: "💎", name: "สล็อตแจ็คพอต", detail: "รวมเกมแจ็คพอตหลายรูปแบบ ตรวจสอบรอบการจ่ายและอัตราเดิมพันของแต่ละเกมได้ในระบบ", tag: "หลายรูปแบบ" },
  { icon: "🏷️", name: "รวมค่ายเกมครบทุกแบรนด์", detail: "สลับค่ายและสลับเกมได้จากบัญชีเดียว จัดหมวดหมู่ให้ค้นหาเกมที่ต้องการได้ง่าย", tag: "บัญชีเดียวครบ" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "เล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ผ่านเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรม", tag: "ไม่ต้องติดตั้ง" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิต ส่งคำขอถอน และตรวจสอบสถานะรายการได้เองตลอด 24 ชั่วโมง", tag: "จัดการเครดิตเอง" },
  { icon: "🤝", name: "โปรโมชั่นและคอมมิชชั่น", detail: "ตรวจสอบเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขการถอนผ่านหน้าโปรโมชั่นก่อนกดรับ", tag: "ตามเงื่อนไขแต่ละรายการ" },
];

const chips = ["สล็อตยอดนิยม", "เกมใหม่", "เกมโบนัส", "แจ็คพอต", "รวมทุกค่าย", "คอมมิชชั่น", "ฝากถอนออโต้", "แอดมิน 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ JAIDEE928"
  titleright="หมวดเกมสล็อตและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ JAIDEE928 และหมวดเกมสล็อตออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#4a0b8f]/50 bg-[#150726]/92 p-6 shadow-[0_10px_30px_rgba(157,22,241,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2c045c]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#9d16f1]/50 bg-gradient-to-br from-[#e0b7ff] via-[#9d16f1] to-[#2c045c] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#c47bff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a892bd]">เข้าสู่ระบบ JAIDEE928 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a892bd]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4a0b8f] bg-[#06020e]/95 py-3 pr-4 pl-12 text-[#f5ebff] transition-all outline-none placeholder:text-[#a892bd]/70 focus:border-[#9d16f1] focus:ring-1 focus:ring-[#9d16f1]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a892bd]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#4a0b8f] bg-[#06020e]/95 py-3 pr-4 pl-12 text-[#f5ebff] transition-all outline-none placeholder:text-[#a892bd]/70 focus:border-[#9d16f1] focus:ring-1 focus:ring-[#9d16f1]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ece0fb]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4a0b8f] bg-[#06020e] accent-[#9d16f1]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ece0fb] transition-colors hover:text-[#c47bff]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#e0b7ff]/50 bg-gradient-to-r from-[#e0b7ff] via-[#9d16f1] to-[#4a0b8f] p-3.5 text-center font-black text-[#06020e] shadow-[0_10px_30px_rgba(157,22,241,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(157,22,241,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a892bd]">
          <span class="h-px flex-1 bg-[#4a0b8f]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#4a0b8f]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#4a0b8f]/60 bg-[#06020e] px-2.5 py-1 text-[10px] font-bold text-[#c47bff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#9d16f1]/30 bg-[#06020e]/80 px-2.5 py-1 text-[10px] font-bold text-[#ece0fb]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c47bff] transition-colors hover:text-[#e8e6ee]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#9d16f1]/25 bg-[#150726]/92 p-5 shadow-[0_10px_30px_rgba(157,22,241,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ece0fb]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#4a0b8f] via-[#9d16f1] to-[#e8e6ee] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a892bd] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#4a0b8f] bg-[#06020e]/95 px-3.5 py-2.5 transition-colors hover:border-[#9d16f1]/50 hover:bg-[#1c0b33]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f5ebff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#4a0b8f]/60 bg-[#06020e] px-2.5 py-0.5 text-[10px] font-bold text-[#c47bff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ece0fb]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#9d16f1]/25 bg-[#06020e] px-3 py-1 text-[10px] font-bold text-[#c47bff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a892bd]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
