---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// กินดี365 is a เว็บหวย brand, so every row below stays inside what the brief
// states: หมวดหวยรัฐบาลไทย ลาวพัฒนา ฮานอย VIP และหุ้นต่างประเทศ, การเลือกรอบและ
// เลข 2 ตัว/3 ตัวพร้อมระบุยอดเดิมพันผ่านมือถือ, การตรวจเวลาเปิด-ปิดและอัตราจ่าย
// ก่อนยืนยันโพย, เรท 2 ตัวบาทละ 100 และ 3 ตัวบาทละ 1,000, การฝากเครดิตผ่าน
// ธนาคารและวอลเลท, การตรวจยอด ส่งคำขอถอน และติดตามสถานะด้วยตัวเอง และการติดต่อ
// เจ้าหน้าที่ตลอด 24 ชั่วโมงพร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการ.
// Nothing here quotes a payout figure, a guarantee, or a promotion the brief
// does not state — the only rates on this page are the brief's own 2 ตัวบาทละ
// 100 และ 3 ตัวบาทละ 1,000 ในตารางอัตราจ่าย.
const menus = [
  { icon: "🏛️", name: "เลือกหมวดหวยที่เปิดบริการ", detail: "หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP และหวยหุ้นต่างประเทศ เลือกได้จากบัญชีเดียว", tag: "เลือกประเภทหวย" },
  { icon: "🕐", name: "ตรวจเวลาเปิด-ปิดของรอบ", detail: "แต่ละตลาดหวยมีเวลาเปิดรับต่างกัน ควรดูรอบที่ระบบเปิดอยู่ก่อนเพื่อไม่ให้ส่งผิดรอบ", tag: "กันส่งผิดรอบ" },
  { icon: "🧮", name: "อัตราจ่ายแสดงก่อนส่งโพย", detail: "เรทที่กำหนดสำหรับหน้านี้คือ 2 ตัวบาทละ 100 และ 3 ตัวบาทละ 1,000 ควรตรวจตัวเลขที่ระบบแสดงจริงอีกครั้ง", tag: "ตรวจเรทอีกครั้ง" },
  { icon: "🎯", name: "เลือกเลขและระบุยอดเอง", detail: "เลือกเลข 2 ตัวหรือ 3 ตัว แล้วระบุยอดเดิมพันผ่านมือถือได้โดยตรงก่อนยืนยันโพย", tag: "กำหนดยอดเอง" },
  { icon: "🧾", name: "ดูประวัติรายการย้อนหลัง", detail: "ตรวจสอบเรท เลือกเลข ส่งโพย และเช็กประวัติรายการของตัวเองได้จากบัญชีสมาชิก", tag: "เช็กประวัติเอง" },
  { icon: "🏦", name: "ฝากเครดิตธนาคารและวอลเลท", detail: "เติมเครดิตผ่านช่องทางการเงินที่ระบบเปิดรองรับ ตรวจชื่อบัญชี จำนวนเงิน และช่องทางก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "📶", name: "ส่งคำขอถอนและติดตามสถานะ", detail: "ตรวจสอบยอด ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านบัญชีสมาชิกได้ด้วยตัวเอง", tag: "ดูสถานะรายการ" },
  { icon: "🎧", name: "แจ้งเจ้าหน้าที่ตลอด 24 ชั่วโมง", detail: "แจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการให้ครบ เพื่อให้ค้นหาธุรกรรมได้ตรงจุด", tag: "แจ้งรายละเอียดครบ" },
];

const chips = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย VIP", "หวยหุ้นต่างประเทศ", "2 ตัวบาทละ 100", "3 ตัวบาทละ 1,000", "ธนาคารและวอลเลท", "ดูแลฝากถอน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ กินดี365" titleright="จุดที่ควรตรวจสอบก่อนส่งโพยกับ กินดี365" label="เข้าสู่ระบบ กินดี365 และตารางจุดที่ควรตรวจสอบก่อนส่งโพย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e9c55d]/40 bg-[#062052]/92 p-6 shadow-[0_10px_30px_rgba(233,197,93,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#5ec2f5]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e9c55d]/60 bg-gradient-to-br from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] text-xl shadow-inner">
          🎟️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbeeb8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a9c4e8]">เข้าสู่ระบบ กินดี365 เพื่อเลือกประเภทหวยและรอบเดิมพัน ตรวจอัตราจ่ายก่อนส่งโพย เช็กประวัติรายการ และจัดการฝากถอนได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9c4e8]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#e9c55d]/45 bg-[#00081f]/95 py-3 pr-4 pl-12 text-[#dbe4f5] transition-all outline-none placeholder:text-[#a9c4e8] focus:border-[#e9c55d] focus:ring-1 focus:ring-[#e9c55d]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a9c4e8]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#e9c55d]/45 bg-[#00081f]/95 py-3 pr-4 pl-12 text-[#dbe4f5] transition-all outline-none placeholder:text-[#a9c4e8] focus:border-[#e9c55d] focus:ring-1 focus:ring-[#e9c55d]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dbe4f5]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#e9c55d]/45 bg-[#00081f] accent-[#e9c55d]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dbe4f5] transition-colors hover:text-[#fbeeb8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7e5f1f]/55 bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] p-3.5 text-center font-black text-[#00081f] shadow-[0_10px_30px_rgba(233,197,93,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(233,197,93,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a9c4e8]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#e9c55d]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#e9c55d]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5ec2f5]/45 bg-[#00081f] px-2.5 py-1 text-[10px] font-bold text-[#5ec2f5]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e9c55d]/40 bg-[#00081f]/80 px-2.5 py-1 text-[10px] font-bold text-[#e9c55d]"><span aria-hidden="true">🕐</span> ดูแลตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e9c55d] transition-colors hover:text-[#fbeeb8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e9c55d]/40 bg-[#062052]/92 p-5 shadow-[0_10px_30px_rgba(233,197,93,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dbe4f5]">แทงหวยออนไลน์ผ่านบัญชีเดียว เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง</span>
          <div class="bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5ec2f5]/55 bg-[#0a2f7a]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5ec2f5] shadow-[0_0_8px_rgba(94,194,245,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#5ec2f5] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a9c4e8] uppercase">
        <span>ขั้นตอนส่งโพย ฝากถอน และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1c47a8]/60 bg-[#00081f]/95 px-3.5 py-2.5 transition-colors hover:border-[#e9c55d]/60 hover:bg-[#0a2f7a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe4f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e9c55d]/45 bg-[#00081f] px-2.5 py-0.5 text-[10px] font-bold text-[#e9c55d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a9c4e8]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e9c55d]/35 bg-[#00081f] px-3 py-1 text-[10px] font-bold text-[#e9c55d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a9c4e8]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนส่งโพย หวยแต่ละประเภทและแต่ละรอบอาจมีเวลาเปิด-ปิด อัตราจ่าย และเงื่อนไขต่างกัน ให้ยึดรายละเอียดที่หน้าส่งโพยแสดง ณ เวลานั้นเป็นหลัก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
