---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// TIGER88 is a slot brand, so every row below stays inside what the brief
// states: การรวมเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ในระบบเดียว, สล็อตธีมยอดนิยม
// เกมโบนัส ฟรีสปิน และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ, เกมแนะนำ Fortune
// Tiger, Mahjong Ways 2, Lucky Neko และ Wild Bandito, การเลือกจากรูปแบบเกม RTP
// ความผันผวน และขนาดเดิมพันที่เหมาะกับเงินทุน, การเปิด Paytable ก่อนเล่น,
// ขั้นต่ำจริงที่ขึ้นอยู่กับเกมและผู้ให้บริการแต่ละราย, โบนัสแนะนำเพื่อน 0.8%
// และคืนยอดเสีย 0.3% ตามเงื่อนไข, การสมัคร 3 ขั้นตอน และแอดมินที่ให้บริการ
// ออนไลน์ตลอด 24 ชั่วโมง.
// Nothing here quotes a return-to-player figure, a payout, a guarantee, or a
// promotion the brief does not state.
const menus = [
  { icon: "🎰", name: "รวมเกมสล็อตในระบบเดียว", detail: "สล็อตธีมยอดนิยม เกมโบนัส ฟรีสปิน และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ เลือกได้จากบัญชีสมาชิกเดียว", tag: "เลือกจากบัญชีเดียว" },
  { icon: "🐯", name: "เกมแนะนำ 4 อันดับ", detail: "Fortune Tiger, Mahjong Ways 2, Lucky Neko และ Wild Bandito แต่ละเกมมีกติกาและฟีเจอร์ต่างกัน", tag: "กติกาไม่เหมือนกัน" },
  { icon: "📋", name: "Paytable และช่วงเดิมพัน", detail: "เปิด Paytable ตรวจสัญลักษณ์ ฟีเจอร์ และช่วงเดิมพันที่เกมรองรับให้ครบก่อนกด Spin รอบแรก", tag: "อ่านก่อนเริ่มเล่น" },
  { icon: "📊", name: "RTP และความผันผวน", detail: "เลือกเกมจากรูปแบบเกม RTP ความผันผวน และขนาดเดิมพันที่เหมาะกับเงินทุน มากกว่าตัดสินจากคำว่าแตกง่าย", tag: "เลือกตามเงินทุน" },
  { icon: "💰", name: "ขั้นต่ำประมาณ 1 บาท", detail: "ขั้นต่ำจริงขึ้นอยู่กับเกมและผู้ให้บริการแต่ละราย ควรตรวจตัวเลขเดิมพันบนหน้าเกมก่อนเริ่มเล่นจริง", tag: "ต่างกันตามเกม" },
  { icon: "🤝", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำของตนเองให้เพื่อน ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมีรายการตรงตามเงื่อนไข", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจประเภทเกม ยอดที่ใช้คำนวณ และเงื่อนไขของโปรโมชั่นให้ครบถ้วนก่อนกดรับสิทธิ์ในแต่ละรอบ", tag: "ตรวจรอบก่อนกดรับ" },
  { icon: "🎧", name: "แอดมิน TIGER88 ออนไลน์", detail: "สมัครไม่ได้ Login ไม่ผ่าน เครดิตไม่เข้า ถอนค้าง หรือโปรไม่แสดง ให้แจ้งเวลา จำนวนเงิน และรายละเอียดรายการ", tag: "แจ้งเวลาทุกครั้ง" },
];

const chips = ["Fortune Tiger", "Mahjong Ways 2", "Lucky Neko", "Wild Bandito", "ฟรีสปิน", "เกมโบนัส", "Paytable", "โบนัส 0.8%", "คืนยอดเสีย 0.3%"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ TIGER88" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อตกับ TIGER88" label="เข้าสู่ระบบ TIGER88 และตารางจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#5e0505]/85 bg-[#120404]/92 p-6 shadow-[0_10px_30px_rgba(239,22,34,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#b00a12]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#b00a12]/60 bg-gradient-to-br from-[#ff2a36] via-[#ef1622] to-[#5e0505] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff2a36]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d6bf95]">เข้าสู่ระบบ TIGER88 เพื่อเลือกเกมสล็อต ตรวจสอบโปรโมชั่น จัดการเครดิต และดูประวัติรายการผ่านมือถือหรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d6bf95]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5e0505] bg-[#070202]/95 py-3 pr-4 pl-12 text-[#f2e3c9] transition-all outline-none placeholder:text-[#d6bf95] focus:border-[#ef1622] focus:ring-1 focus:ring-[#ef1622]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d6bf95]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5e0505] bg-[#070202]/95 py-3 pr-4 pl-12 text-[#f2e3c9] transition-all outline-none placeholder:text-[#d6bf95] focus:border-[#ef1622] focus:ring-1 focus:ring-[#ef1622]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f2e3c9]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5e0505] bg-[#070202] accent-[#ef1622]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f2e3c9] transition-colors hover:text-[#ff2a36]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#b00a12]/55 bg-gradient-to-r from-[#ff2a36] via-[#ef1622] to-[#b00a12] p-3.5 text-center font-black text-[#f2e3c9] shadow-[0_10px_30px_rgba(239,22,34,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(239,22,34,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d6bf95]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e0505]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#5e0505]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5e0505]/85 bg-[#070202] px-2.5 py-1 text-[10px] font-bold text-[#ff2a36]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#fdd121]/40 bg-[#070202]/80 px-2.5 py-1 text-[10px] font-bold text-[#fdd121]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff2a36] transition-colors hover:text-[#fdd121]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#5e0505]/75 bg-[#120404]/92 p-5 shadow-[0_10px_30px_rgba(239,22,34,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f2e3c9]">รวมเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ในระบบเดียว เลือกผ่านมือถือได้สะดวก</span>
          <div class="bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#ef1622] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d6bf95] uppercase">
        <span>เกมสล็อต โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#5e0505] bg-[#070202]/95 px-3.5 py-2.5 transition-colors hover:border-[#ef1622]/60 hover:bg-[#1c0606]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2e3c9]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#5e0505]/85 bg-[#070202] px-2.5 py-0.5 text-[10px] font-bold text-[#fdd121]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d6bf95]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#fdd121]/35 bg-[#070202] px-3 py-1 text-[10px] font-bold text-[#fdd121]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d6bf95]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น ไม่มีเกมสล็อตใดรับประกันผลรางวัลหรือจังหวะการจ่ายได้ ขั้นต่ำจริงแตกต่างกันตามเกมและผู้ให้บริการ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
