---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// JUDTEM168 is a slot-only brand and the brief is about the provider line-up, so
// every row below stays inside what the docx states: รวมเกมสล็อตหลายรูปแบบไว้ใน
// บัญชีเดียว, ค่าย PG SOFT / Pragmatic Play / JILI / JDB / Habanero, เกมที่ถูกระบุ
// ชื่อไว้ (Mahjong Ways, Fortune Tiger, Lucky Neko), ระบบฝากถอนออโต้ที่ทำรายการได้
// ตลอดทั้งวัน, โปรแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, การรองรับมือถือ
// แท็บเล็ตและคอมพิวเตอร์ และแอดมินที่ตรวจสอบรายการให้ตลอดทั้งวัน.
// No payout claim, no RTP figure and no lottery product appears anywhere here.
const menus = [
  { icon: "🎰", name: "สล็อตออนไลน์", detail: "รวมเกมสล็อตหลายรูปแบบไว้ให้เลือกเล่นผ่านบัญชีเดียว ทั้งสล็อตธีมเอเชีย เกมโบนัส และเกมฟีเจอร์พิเศษ", tag: "บัญชีเดียว" },
  { icon: "📱", name: "PG SOFT", detail: "เกมสล็อตที่ออกแบบให้รองรับการเล่นผ่านมือถือ มีหลายธีม เช่น Mahjong Ways, Fortune Tiger และ Lucky Neko", tag: "เน้นมือถือ" },
  { icon: "🎁", name: "Pragmatic Play", detail: "ครอบคลุมทั้งสล็อตคลาสสิก เกมที่มี Free Spins และฟีเจอร์โบนัสหลายรูปแบบ ตรวจข้อมูลของเกมได้ก่อนเดิมพัน", tag: "ฟีเจอร์โบนัส" },
  { icon: "🃏", name: "JILI, JDB และ Habanero", detail: "เพิ่มตัวเลือกให้สมาชิกที่ต้องการเปลี่ยนแนวเกม แต่ละค่ายมีธีมและระบบโบนัสแตกต่างกัน", tag: "หลากหลายธีม" },
  { icon: "💳", name: "ฝากถอนออโต้", detail: "ทำรายการฝากถอนผ่านระบบออโต้ได้ตลอดทั้งวัน ตรวจสอบเครดิต ประวัติรายการ และสถานะได้จากบัญชีของตนเอง", tag: "ตลอดทั้งวัน" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำของตนเอง เมื่อเพื่อนสมัครและมียอดตรงตามข้อกำหนด ระบบจะคำนวณโบนัสตามเงื่อนไข", tag: "ตามเงื่อนไข" },
  { icon: "↩️", name: "คืนยอดเสีย 0.3%", detail: "สมาชิกที่มียอดเสียเข้าเงื่อนไขตรวจสอบสิทธิ์ได้ตามรอบที่กำหนด ควรอ่านเงื่อนไขการถอนให้ครบก่อนกดรับ", tag: "ตามรอบที่กำหนด" },
  { icon: "🎧", name: "แอดมินตรวจสอบรายการ", detail: "แจ้งรายละเอียดและเวลาที่เกิดปัญหาให้แอดมิน เพื่อให้ทีมงานค้นหารายการและตรวจสอบได้ตรงจุด", tag: "ไม่ข้ามวัน" },
];

const chips = ["สล็อตออนไลน์", "PG SOFT", "Pragmatic Play", "JILI", "JDB", "Habanero", "ฝากถอนออโต้", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ JUDTEM168"
  titleright="ค่ายเกมและบริการที่เลือกใช้ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์"
  label="เข้าสู่ระบบ JUDTEM168 และรายการค่ายเกมสล็อตที่เลือกเล่นได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6a5115]/75 bg-[#120c04]/92 p-6 shadow-[0_10px_30px_rgba(204,156,45,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#cc9c2d]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#cc9c2d]/60 bg-gradient-to-br from-[#fae27c] via-[#e8bf4e] to-[#6a5115] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff6d4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b9a67d]">เข้าสู่ระบบ JUDTEM168 ผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b9a67d]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6a5115] bg-[#050301]/95 py-3 pr-4 pl-12 text-[#f0e2bd] transition-all outline-none placeholder:text-[#b9a67d] focus:border-[#e8bf4e] focus:ring-1 focus:ring-[#e8bf4e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b9a67d]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6a5115] bg-[#050301]/95 py-3 pr-4 pl-12 text-[#f0e2bd] transition-all outline-none placeholder:text-[#b9a67d] focus:border-[#e8bf4e] focus:ring-1 focus:ring-[#e8bf4e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f0e2bd]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6a5115] bg-[#050301] accent-[#e8bf4e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f0e2bd] transition-colors hover:text-[#fae27c]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#cc9c2d]/55 bg-gradient-to-r from-[#fae27c] via-[#e8bf4e] to-[#cc9c2d] p-3.5 text-center font-black text-[#050301] shadow-[0_10px_30px_rgba(204,156,45,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,191,78,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b9a67d]">
          <span class="h-px flex-1 bg-[#6a5115]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6a5115]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6a5115]/80 bg-[#050301] px-2.5 py-1 text-[10px] font-bold text-[#fff6d4]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#cc9c2d]/40 bg-[#050301]/80 px-2.5 py-1 text-[10px] font-bold text-[#f0e2bd]"><span aria-hidden="true">🕐</span> ทำรายการได้ตลอดทั้งวัน</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fff6d4] transition-colors hover:text-[#fae27c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#cc9c2d]/40 bg-[#120c04]/92 p-5 shadow-[0_10px_30px_rgba(204,156,45,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f0e2bd]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b9a67d] uppercase">
        <span>ค่ายเกมและบริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6a5115] bg-[#050301]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8bf4e]/60 hover:bg-[#1d1407]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0e2bd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6a5115]/80 bg-[#050301] px-2.5 py-0.5 text-[10px] font-bold text-[#fff6d4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b9a67d]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#cc9c2d]/35 bg-[#050301] px-3 py-1 text-[10px] font-bold text-[#fff6d4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b9a67d]">
        สมาชิกเข้าสู่ระบบผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </div>
    </div>
  </div>
</ContentBoxTwo>
