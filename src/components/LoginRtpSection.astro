---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อนเป็นเว็บที่ขาย
// **ระบบทำรายการอัตโนมัติและช่องทางการเงินแบบบัญชีองค์กร** ส่วนรอบนี้เป็น
// **เว็บพนันลิขสิทธิ์ไทยแท้ที่รวมหมวดเกมคาสิโนและกีฬาไว้ในแพลตฟอร์มเดียว** คือ
// บาคาร่า · ไฮโล · สล็อต · แทงบอล พร้อมคำว่า ไม่มีขั้นต่ำ โปรโมชั่นสองรายการ
// (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%) การสมัครเล่น 3 ขั้นตอน และแอดมิน 24 ชั่วโมง
// แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §7 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เว็บพนันลิขสิทธิ์ไทยแท้ · ผ่านเซิร์ฟไทย 100% · ทางเข้าเดิมพัน · บาคาร่า · ไฮโล ·
// สล็อต · แทงบอล · ไม่มีขั้นต่ำ · หมวดเกม · แพลตฟอร์มเดียว · เกมไพ่ · ลูกเต๋า ·
// เกมวงล้อทั่วไป · ฟีเจอร์โบนัส · รายการแข่งขัน · อัตราต่อรอง · ตารางจ่าย · กติกา ·
// เงื่อนไขการตัดสินผล · ยอดเดิมพัน · บัญชีเดียว · 24 ชั่วโมง ·
// โบนัสคืนยอดเสีย 0.3% · เข้ายูสทุกวัน · รอบประจำวัน · เวลาตัดยอด · ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน · โบนัส 0.8% · ไม่จำกัด · ลิงก์แนะนำ · สมัครเล่น 3 ขั้นตอน ·
// ยืนยันบัญชี · รหัสผ่าน · PIN · OTP · แอดมิน · หมายเลขรายการ · คู่แข่งขัน
//
// ศัพท์ของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §7 (ชุดคำระบบทำรายการอัตโนมัติ ชุดคำช่องทาง
// การเงินแบบบัญชีองค์กร ชุดเกมถ่ายทอดสดและเกมที่บรีฟรอบนี้ไม่มี ชุดคำโฆษณาแบบ
// "แตก/ตรง/ไว" และชุดคำระดับสมาชิกพิเศษ) — ไม่เหลือแม้คำเดียว และไม่มีคำในกลุ่ม
// ลอตเตอรีที่ §7 ห้ามอยู่ที่ไหนบนเว็บเลย (สองหน้านั้นยังจอดอยู่ใน src/pages-disabled/
// ตาม §7)
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้เอ่ยถึงอัตราคืนเงินของเกมเลยแม้แต่คำเดียว §7 จึงห้ามอ้างตัวเลขนั้น
// ที่นี่ แผงขวาเป็น "หมวดเกมและโปรโมชั่นที่รวบรวมไว้" ไม่ใช่ตารางค่าของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: เลขที่ใบอนุญาต · หน่วยงานกำกับ · ชื่อค่ายเกม ·
// ชื่อผู้ให้บริการ · ชื่อธนาคาร · อัตราคืนเงินของเกม · ยอดเดิมพันขั้นต่ำเป็นตัวเลข ·
// จำนวนสมาชิก · ปีก่อตั้ง · ที่ตั้งเซิร์ฟเวอร์ (บรีฟสั่งให้ "ตรวจสอบ" ไม่ใช่ให้ประกาศ
// จึงคงคำกำกับไว้ ไม่ใช่คำอ้าง) — บรีฟไม่ได้ให้ไว้สักอย่าง
// ตัวเลขที่ใช้ได้มีสามตัว: 0.3% · 0.8% · 24 ชั่วโมง (บวก "3 ขั้นตอน" และ "100%" ซึ่ง
// เป็นถ้อยคำในหัวข้อของบรีฟเอง)
