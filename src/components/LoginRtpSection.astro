---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "สล็อตค่ายแท้ดั้งเดิม", detail: "รวมค่ายสล็อตลิขสิทธิ์แท้ไว้ในบัญชีเดียว สลับค่ายได้โดยไม่ต้องสมัครซ้ำ", tag: "ยอดนิยม" },
  { icon: "🎁", name: "เกมโบนัสและฟรีสปิน", detail: "ดูฟีเจอร์โบนัสและจำนวนฟรีสปินของแต่ละเกมก่อนลงเครดิตจริง", tag: "ดูก่อนหมุน" },
  { icon: "🏆", name: "เกมแจ็คพอต", detail: "ตรวจกติกาและเงื่อนไขการเข้าถึงแจ็คพอตของแต่ละเกมให้ครบก่อนเริ่มหมุน", tag: "เช็กกติกาก่อนเล่น" },
  { icon: "🆕", name: "เกมใหม่อัปเดตต่อเนื่อง", detail: "มีเกมสล็อตเข้าใหม่เป็นระยะ ค้นหาและเลือกตามสไตล์ที่ชอบได้สะดวก", tag: "อัปเดตเรื่อย ๆ" },
  { icon: "📱", name: "รองรับ Android และ iOS", detail: "เข้าเล่นผ่านเบราว์เซอร์ได้ทันที ไม่ต้องติดตั้งโปรแกรมเพิ่มเติม", tag: "ใช้งานได้ทุกเครื่อง" },
  { icon: "💰", name: "โบนัสคืนยอดเสีย 0.3%", detail: "ตรวจสอบยอดและรอบเวลาการกดรับสิทธิ์ได้เองผ่านระบบสมาชิก", tag: "รับได้ทุกวัน" },
  { icon: "🛎️", name: "แอดมินดูแล 24 ชม.", detail: "ติดต่อได้ทุกขั้นตอน ตั้งแต่สมัครสมาชิก ฝากถอน จนถึงการเข้าเล่นเกม", tag: "ไม่ต้องรอคิว" },
];

const chips = ["สล็อตออนไลน์", "ค่ายแท้ดั้งเดิม", "ฟรีสปิน", "แจ็คพอต", "Android", "iOS", "มือถือ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ UFASLOT"
  titleright="หมวดเกมสล็อตและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ UFASLOT และหมวดเกมสล็อตที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#b6821d]/40 bg-[#0d0b06]/92 p-6 shadow-[0_10px_30px_rgba(245,197,24,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#845914]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#b6821d]/50 bg-gradient-to-br from-[#fff2c3] via-[#f5c518] to-[#845914] text-xl shadow-inner">🎰</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c518]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9bfa6]">เข้าสู่ระบบ UFASLOT ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b6821d]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2b2110] bg-[#0a0704]/95 py-3 pr-4 pl-12 text-[#f2e6cd] transition-all outline-none placeholder:text-[#c9bfa6]/60 focus:border-[#f5c518] focus:ring-1 focus:ring-[#f5c518]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b6821d]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2b2110] bg-[#0a0704]/95 py-3 pr-4 pl-12 text-[#f2e6cd] transition-all outline-none placeholder:text-[#c9bfa6]/60 focus:border-[#f5c518] focus:ring-1 focus:ring-[#f5c518]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9bfa6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2b2110] bg-[#0a0704] accent-[#f5c518]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9bfa6] transition-colors hover:text-[#fff2c3]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#b6821d]/50 bg-gradient-to-r from-[#fff2c3] via-[#f5c518] to-[#b6821d] p-3.5 text-center font-black text-[#2b1c05] shadow-[0_10px_30px_rgba(245,197,24,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,24,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9bfa6]/70">
          <span class="h-px flex-1 bg-[#2b2110]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2b2110]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#b6821d]/40 bg-[#0a0704] px-2.5 py-1 text-[10px] font-bold text-[#f5c518]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#d3d3d3]/30 bg-[#0a0704]/80 px-2.5 py-1 text-[10px] font-bold text-[#d3d3d3]"><span aria-hidden="true">🕐</span> แอดมินดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5c518] transition-colors hover:text-[#fff2c3]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d3d3d3]/25 bg-[#0d0b06]/92 p-5 shadow-[0_10px_30px_rgba(211,211,211,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9bfa6]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#f5c518] via-[#fff2c3] to-[#d3d3d3] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9bfa6]/80 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2b2110] bg-[#0a0704]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c518]/50 hover:bg-[#171208]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2e6cd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#b6821d]/40 bg-[#0a0704] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c518]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9bfa6]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d3d3d3]/25 bg-[#0a0704] px-3 py-1 text-[10px] font-bold text-[#d3d3d3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9bfa6]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
