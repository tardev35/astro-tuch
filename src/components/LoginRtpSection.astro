---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// MIRACLE55 เป็นแบรนด์คาสิโนฐานหลักที่รวมเกมจากหลายค่ายไว้ในระบบเดียว แผงฝั่งขวาจึงมีแค่
// สองกลุ่มที่บรีฟระบุไว้จริง คือ สามหมวดเกมที่บรีฟเอ่ยชื่อ (เกมสด เกมโต๊ะ และหมวดเกม
// ยอดนิยม) กับสี่สิ่งที่บรีฟบอกว่าระบบจัดไว้ให้ตรวจสอบก่อนเข้าใช้งาน (รายละเอียดเกม
// ค่ายที่ให้บริการ เมนูที่จัดไว้ชัดเจน และการจัดการบัญชีผ่านระบบเดียว)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกม ชื่อเกม ค่า RTP ความผันผวน ขั้นต่ำการเดิมพัน ช่องทางฝากถอน
// ชื่อธนาคาร หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่บรีฟให้
// คือโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้าแล้ว การเติม
// ตัวเลขหรือชื่อค่ายลงตารางนี้คือการแต่งข้อมูลขึ้นมา
//
// คำศัพท์ตามบรีฟรอบนี้คือ "ไลน์แอด" ไม่ใช่ LINE OFFICIAL และไม่มีคำว่า หวย บอล บาคาร่า
// หรือเครดิตฟรี อยู่ในบรีฟเลย — ชุดคำเหล่านั้นเป็นของ KINGDOM66 รอบก่อน
const categories = [
  {
    icon: "📺",
    name: "เกมสด",
    detail: "คาสิโนสดตามรายการที่เว็บไซต์เปิดให้บริการ เลือกค่ายที่สนใจได้จากเมนูที่ระบบจัดแยกไว้",
    tag: "ถ่ายทอดสดจากหลายค่าย",
  },
  {
    icon: "🎴",
    name: "เกมโต๊ะ",
    detail: "อยู่ในหมวดที่ระบบจัดไว้ ตรวจสอบรายละเอียดของแต่ละเกมได้ก่อนเข้าใช้งาน",
    tag: "ดูรายละเอียดก่อนเข้าเล่น",
  },
  {
    icon: "🎰",
    name: "หมวดเกมยอดนิยม",
    detail: "รวมอยู่ในระบบเดียวกับหมวดอื่น ค้นหาได้ง่ายจากการจัดแยกค่ายของระบบ",
    tag: "ค้นหาได้จากเมนูเดียว",
  },
];

const checks = [
  {
    icon: "🧾",
    name: "รายละเอียดเกม",
    detail: "เปิดดูรายละเอียดของแต่ละเกมได้ก่อนเข้าใช้งาน ตามข้อมูลที่เว็บไซต์ระบุไว้",
    tag: "ดูก่อนกดเข้าเล่น",
  },
  {
    icon: "🏷️",
    name: "ค่ายที่ให้บริการ",
    detail: "ระบบจัดแยกแต่ละค่ายไว้ ตรวจสอบได้ว่าเกมที่เลือกมาจากค่ายใดตามรายการที่เปิดไว้",
    tag: "ระบบจัดแยกให้แล้ว",
  },
  {
    icon: "🧭",
    name: "เมนูที่จัดไว้ชัดเจน",
    detail: "เลือกประเภทที่เหมาะกับตัวเองได้จากเมนูเดียว ไม่ต้องไล่เปิดหลายหน้า",
    tag: "จบจากหน้าเดียว",
  },
  {
    icon: "👤",
    name: "จัดการบัญชีระบบเดียว",
    detail: "เลือกเกมและตรวจสอบโปรโมชั่นที่เปิดให้รับได้จากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์",
    tag: "บัญชีเดียวครบ",
  },
];

const chips = [
  "เกมสด",
  "เกมโต๊ะ",
  "หมวดเกมยอดนิยม",
  "เล่นผ่านบริษัทตรง",
  "ระบบจัดแยกค่ายให้ค้นหาง่าย",
  "จัดการบัญชีผ่านระบบเดียว",
  "รองรับมือถือและคอมพิวเตอร์",
  "ไลน์แอด 24 ชั่วโมง",
];

// MIRACLE55 (รอบทอง-โครเมียม-ดำ 2026-09-25): โลโก้เป็นเวิร์ดมาร์กสองโลหะ MI/55 เป็นทอง
// RACLE เป็นโครเมียม สองแผงจึงถูกแยกด้วยโลหะคนละชนิด ไม่ใช่แค่ความสว่างของกรอบ — แผง
// ล็อกอินอยู่ในกรอบทองแบรนด์ #fcda65 ส่วนแผงหมวดเกมอยู่ในกรอบเงินโครเมียม #a8acb1
// ทั้งคู่วางบนผิวการ์ด #14100a เหนือพื้นเพจดำสนิท #050403 ช่องกรอกและชิปตกลงไปที่พื้นเพจ
// ในเส้นผิวการ์ดยก #2c241c ชื่อหมวดเกมรับไล่เฉดสองโลหะตามลำดับบนโลโก้ คือทองแบรนด์
// #fcda65 → ขาวโครเมียม #fcfcfc → ทองเข้ม #d9a62b ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#fee47b → #fcda65 → #8c5f14) บนตัวอักษร #0d0a06 ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้น
// ทองต้องเกือบดำ ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์ม — ชุดทอง-ครีมอุ่นของ
// KINGDOM66 (#e6bf4e #f2d683 #5c4113 #efe6cf #fdf6e0 #241c13 #1a1206 #ebe3d3)
// ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในระบบเดียว`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} พร้อมรายการหมวดเกมที่รวมไว้ในระบบเดียว ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยมจากหลายค่าย พร้อมสิ่งที่ระบบจัดไว้ให้ตรวจสอบก่อนเข้าใช้งาน`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fcda65]/45 bg-[#14100a]/94 p-6 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fcda65]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcda65]/70 bg-gradient-to-br from-[#fee47b] via-[#fcda65] to-[#8c5f14] text-xl text-[#0d0a06] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fcfcfc]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e8e6e1]/75">
            เข้าสู่ระบบ {BRAND_NAME} เพื่อเลือกเกมสด เกมโต๊ะ หรือหมวดเกมยอดนิยมจากหลายค่าย ผ่านเมนูที่ระบบจัดแยกไว้ให้ค้นหาได้ง่าย จัดการบัญชีได้จากระบบเดียว รองรับทั้งมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8e6e1]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2c241c] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e8e6e1] transition-all outline-none placeholder:text-[#e8e6e1]/50 focus:border-[#fcda65] focus:ring-1 focus:ring-[#fee47b]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8e6e1]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2c241c] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#e8e6e1] transition-all outline-none placeholder:text-[#e8e6e1]/50 focus:border-[#fcda65] focus:ring-1 focus:ring-[#fee47b]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8e6e1]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2c241c] bg-[#050403] accent-[#fcda65]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8e6e1]/75 transition-colors hover:text-[#fee47b]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fee47b]/70 bg-gradient-to-r from-[#fee47b] via-[#fcda65] to-[#8c5f14] p-3.5 text-center font-black text-[#0d0a06] shadow-[0_10px_30px_rgba(252,218,101,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(254,228,123,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e8e6e1]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#2c241c]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#2c241c]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่านไลน์แอด
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2c241c] bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#e8e6e1]"><span aria-hidden="true">🎴</span> รวมหลายค่ายในระบบเดียว</span>
            <span class="rounded-full border border-[#d2d3d4]/40 bg-[#050403]/85 px-2.5 py-1 text-[10px] font-bold text-[#d2d3d4]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#d2d3d4] transition-colors hover:text-[#fcfcfc]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a8acb1]/40 bg-[#14100a]/94 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8e6e1]/75">ระบบจัดแยกแต่ละค่ายไว้ให้ค้นหาได้ง่าย พร้อมรายละเอียดเกมก่อนเข้าใช้งาน เลือกประเภทที่เหมาะกับตัวเองแล้วจัดการบัญชีผ่านระบบเดียว</span>
          <div class="bg-gradient-to-r from-[#fcda65] via-[#fcfcfc] to-[#d9a62b] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">เกมสด · เกมโต๊ะ · เกมยอดนิยม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#2c241c] bg-[#050403]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d2d3d4] shadow-[0_0_8px_rgba(210,211,212,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#d2d3d4] uppercase">รวมครบในระบบเดียว</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8e6e1]/75 uppercase">
        <span>หมวดเกมตามรายการที่เปิดให้บริการ</span>
        <span>การเข้าถึง</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          categories.map((c) => (
            <div class="rounded-xl border border-[#d9a62b]/40 bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#fcda65]/70 hover:bg-[#1b140b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fcfcfc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fcda65]/60 bg-gradient-to-r from-[#fcda65] to-[#8c5f14] px-2.5 py-0.5 text-[10px] font-black text-[#0d0a06]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e8e6e1]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8e6e1]/75 uppercase">
        <span>สิ่งที่ระบบจัดไว้ให้ตรวจสอบก่อนเข้าใช้งาน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          checks.map((k) => (
            <div class="rounded-xl border border-[#2c241c] bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#a8acb1]/70 hover:bg-[#1b140b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8e6e1]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a8acb1]/50 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#d2d3d4]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e8e6e1]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2c241c] bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#e8e6e1]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e8e6e1]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมจากหลายค่ายไว้ในระบบเดียว ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม ระบบที่จัดแยกแต่ละค่ายให้ค้นหาได้ง่ายพร้อมรายละเอียดเกมก่อนเข้าใช้งาน
        การเข้าเล่นผ่านระบบบริษัทตรงตามข้อมูลของเว็บไซต์ และการรองรับทั้งมือถือและคอมพิวเตอร์ ส่วนรายการที่เปิดให้บริการในแต่ละช่วงอาจแตกต่างกันตามที่ระบบกำหนด ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมก่อนเข้าใช้งาน
        และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
