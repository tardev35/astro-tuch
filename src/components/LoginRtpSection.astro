---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// HERO1688 is a สล็อตออโต้เว็บตรง brand — slots only, NOT บาคาร่า/บอล/หวย. Every
// row below stays inside what the brief states: เกมสล็อตจากหลายค่ายรวมไว้ในบัญชี
// เดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมรูปแบบใหม่ตามที่แต่ละค่ายเปิดให้
// บริการ, การเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์, ระบบ
// ออโต้ที่ให้สมาชิกทำรายการฝาก ส่งคำขอถอน และตรวจสถานะได้เอง, การ Login เพื่อดู
// เครดิต ประวัติฝากถอน และโปรโมชั่นที่มีสิทธิ์รับ, โบนัสแนะนำเพื่อน 0.8% และ
// คืนยอดเสีย 0.3% พร้อมรอบคำนวณและยอดที่เข้าเกณฑ์, ช่องทางวอลเลทและบัญชีธนาคาร
// ตามที่ระบบรองรับ, และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed payout — the brief says คำว่า
// "ค่ายแท้", "ไม่ผ่านเว็บตัวแทน", "ไม่มีขั้นต่ำ" และ "รองรับทุกธนาคาร" ต้องยึด
// ข้อมูลที่ตรวจสอบได้บนเว็บไซต์ ณ เวลาทำรายการ.
const menus = [
  {
    icon: "🎰",
    name: "สล็อตคลาสสิกจากหลายค่าย",
    detail: "หมวดสล็อตรูปแบบคลาสสิกจากผู้ให้บริการที่ระบบเปิดให้บริการ เลือกเกมและดูรูปแบบการจ่ายของเกมนั้นได้ก่อนเริ่มหมุนทุกครั้ง",
    tag: "หลายค่าย",
  },
  {
    icon: "🎁",
    name: "เกมโบนัสและฟรีสปิน",
    detail: "ฟีเจอร์โบนัสและฟรีสปินเป็นไปตามกติกาที่แต่ละเกมกำหนด ควรอ่านเงื่อนไขของฟีเจอร์ในเกมให้ครบก่อนเริ่มเล่น",
    tag: "ตามเงื่อนไขเกม",
  },
  {
    icon: "🕹️",
    name: "เกมสล็อตรูปแบบใหม่",
    detail: "เกมรูปแบบใหม่เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ รายการที่เปิดให้เล่นในแต่ละช่วงจึงเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมเป็นหลัก",
    tag: "อัปเดตตามค่าย",
  },
  {
    icon: "🔀",
    name: "สลับค่ายจากบัญชีเดียว",
    detail: "จัดเกมเป็นหมวดหมู่เพื่อให้ค้นหาและสลับค่ายผ่านบัญชีเดียวได้ ไม่ต้องสมัครใหม่ทุกครั้งที่ย้ายไปเล่นอีกค่ายหนึ่ง",
    tag: "บัญชีเดียว",
  },
  {
    icon: "📱",
    name: "เข้าเล่นผ่านเบราว์เซอร์ได้ทุกอุปกรณ์",
    detail: "รองรับการเข้าเล่นผ่านเว็บเบราว์เซอร์ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน และดูโปรโมชั่นได้จากหน้าเว็บไซต์เดียวกัน",
    tag: "มือถือ · คอม",
  },
  {
    icon: "🎫",
    name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ",
    detail: "เข้าสู่ระบบเพื่อดูสิทธิ์ที่รับได้ในแต่ละช่วง ทั้งแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% แต่ละรายการมีรอบคำนวณและยอดที่เข้าเกณฑ์ต่างกัน",
    tag: "0.8% · 0.3%",
  },
  {
    icon: "💳",
    name: "ฝากถอนวอลเลทและธนาคาร",
    detail: "ทำรายการฝาก ส่งคำขอถอน และติดตามสถานะผ่านบัญชีสมาชิกได้เอง ก่อนทำธุรกรรมควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ และวงเงินของช่องทางที่เลือก",
    tag: "ทำรายการเอง",
  },
  {
    icon: "🛟",
    name: "แอดมินดูแลออนไลน์ 24 ชั่วโมง",
    detail: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้ครบ เพื่อให้เจ้าหน้าที่ตรวจสอบได้ตรงจุด และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    tag: "ตลอด 24 ชม.",
  },
];

const chips = ["สล็อตคลาสสิก", "เกมโบนัส", "ฟรีสปิน", "เกมรูปแบบใหม่", "ระบบออโต้", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ HERO1688" titleright="จุดที่ควรตรวจสอบก่อนหมุนสล็อตและก่อนกดรับโปรโมชั่น" label="เข้าสู่ระบบ HERO1688 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7d0507]/55 bg-[#080a12]/92 p-6 shadow-[0_10px_30px_rgba(225,16,21,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e11015]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c4c5ca]/50 bg-gradient-to-br from-[#f4f7fb] via-[#c4c5ca] to-[#7d0507] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f4f7fb]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ff5a5d]">เข้าสู่ระบบ HERO1688 เพื่อเลือกเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว ตรวจสอบเครดิต ดูโปรโมชั่นที่มีสิทธิ์รับ และจัดการฝากถอนได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbe1ea]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7d0507]/55 bg-[#010207]/95 py-3 pr-4 pl-12 text-[#dbe1ea] transition-all outline-none placeholder:text-[#dbe1ea]/45 focus:border-[#e11015] focus:ring-1 focus:ring-[#e11015]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbe1ea]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7d0507]/55 bg-[#010207]/95 py-3 pr-4 pl-12 text-[#dbe1ea] transition-all outline-none placeholder:text-[#dbe1ea]/45 focus:border-[#e11015] focus:ring-1 focus:ring-[#e11015]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dbe1ea]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7d0507]/55 bg-[#010207] accent-[#e11015]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dbe1ea] transition-colors hover:text-[#f4f7fb]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7d0507]/60 bg-gradient-to-r from-[#ff5a5d] via-[#e11015] to-[#7d0507] p-3.5 text-center font-black text-[#f4f7fb] shadow-[0_10px_30px_rgba(225,16,21,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,90,93,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dbe1ea]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#7d0507]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#7d0507]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c4c5ca]/40 bg-[#010207] px-2.5 py-1 text-[10px] font-bold text-[#e3e7ec]"><span aria-hidden="true">🎰</span> รวมสล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#7d0507]/50 bg-[#010207]/80 px-2.5 py-1 text-[10px] font-bold text-[#ff5a5d]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff5a5d] transition-colors hover:text-[#f4f7fb]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7d0507]/55 bg-[#080a12]/92 p-5 shadow-[0_10px_30px_rgba(225,16,21,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dbe1ea]">
            เลือกเกมสล็อตจากหลายค่ายได้ผ่านบัญชีเดียว และตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขของเกมนั้นที่ระบบแสดงก่อนเริ่มหมุนทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#ff5a5d] via-[#f4f7fb] to-[#c4c5ca] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกค่ายสล็อตที่ระบบเปิด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#c4c5ca]/45 bg-[#1a0509]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e3e7ec] shadow-[0_0_8px_rgba(196,197,202,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e3e7ec] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dbe1ea]/60 uppercase">
        <span>หมวดสล็อต โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7d0507]/70 bg-[#010207]/95 px-3.5 py-2.5 transition-colors hover:border-[#c4c5ca]/45 hover:bg-[#1a0509]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe1ea]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c4c5ca]/40 bg-[#010207] px-2.5 py-0.5 text-[10px] font-bold text-[#e3e7ec]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#dbe1ea]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#7d0507]/45 bg-[#010207] px-3 py-1 text-[10px] font-bold text-[#ff5a5d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dbe1ea]/60">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น แต่ละค่ายและแต่ละเกมสล็อตอาจกำหนดกติกา ช่วงเดิมพัน และรูปแบบการจ่ายไม่เท่ากัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ส่วนรอบคำนวณ
        ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับโบนัสของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
