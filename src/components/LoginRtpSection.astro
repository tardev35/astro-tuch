---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// ขวัญใจ168 is a slot/casino brand and this brief is about the backup entrance,
// so every row below stays inside what the docx states: ทางเข้าสำรองเมื่อช่องทาง
// หลักใช้งานไม่ได้, การตรวจสอบลิงก์จากช่องทางที่ผู้ให้บริการประกาศ, การสมัครยูสเซอร์
// ใหม่หรือใช้บัญชีเดิมตามที่ระบบกำหนด, Login และการตรวจเครดิต, ช่องทางฝากถอนอัตโนมัติ,
// คอมมิชชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, การรองรับมือถือ แท็บเล็ต
// และคอมพิวเตอร์ และแอดมินที่ดูแลตลอด 24 ชั่วโมง. No payout claim, no RTP figure, no
// game provider and no lottery product appears anywhere in this file.
const menus = [
  { icon: "🎰", name: "สล็อตออนไลน์", detail: "เข้าเล่นผ่านทางเข้าสำรองได้ทันที ตรวจเครดิตและรายละเอียดเกมก่อนเริ่มเดิมพันทุกครั้ง", tag: "ทางเข้าสำรอง" },
  { icon: "🔗", name: "ตรวจลิงก์ก่อนเข้า", detail: "ยืนยันทางเข้าจากช่องทางที่ผู้ให้บริการประกาศ เพื่อเลี่ยงเว็บไซต์เลียนแบบ", tag: "ยืนยันช่องทาง" },
  { icon: "📝", name: "สมัครยูสเซอร์ใหม่", detail: "กรอกข้อมูลตามที่ระบบร้องขอ หรือสอบถามเจ้าหน้าที่ว่าบัญชีเดิมยังใช้งานต่อได้หรือไม่", tag: "ใช้ยูสใหม่ได้" },
  { icon: "🔑", name: "เข้าสู่ระบบ", detail: "Login แล้วตรวจสอบเครดิต โปรโมชั่น และรายละเอียดเกมก่อนเริ่มเดิมพัน", tag: "ตรวจก่อนเล่น" },
  { icon: "💳", name: "ฝากถอนอัตโนมัติ", detail: "ตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการในบัญชีสมาชิกก่อนทำรายการ", tag: "ระบบออโต้" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "ระบบคำนวณคอมมิชชั่นแนะนำ 0.8% ตามเงื่อนไข ตรวจยอดการแนะนำในบัญชีได้ก่อนกดรับ", tag: "ตามเงื่อนไข" },
  { icon: "🎁", name: "คืนยอดเสีย 0.3%", detail: "โบนัสคืนยอดเสีย 0.3% ตามรอบประจำวัน ควรอ่านยอดที่นำมาคำนวณก่อนรับสิทธิ์", tag: "รับได้ทุกวัน" },
  { icon: "🎧", name: "แอดมินดูแล 24 ชั่วโมง", detail: "Login ไม่ได้ สมัครไม่สำเร็จ หรือเครดิตไม่เข้า แจ้งรายละเอียดและเวลาที่ทำรายการได้", tag: "ตลอด 24 ชม." },
];

const chips = ["สล็อตออนไลน์", "ทางเข้าสำรอง", "สมัครยูสใหม่", "ฝากถอนออโต้", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม.", "รองรับทุกอุปกรณ์"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ ขวัญใจ168"
  titleright="ทางเข้าสำรองและบริการที่ใช้ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์"
  label="เข้าสู่ระบบ ขวัญใจ168 และบริการที่เปิดให้ตรวจสอบผ่านทางเข้าสำรองทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0e4f7a]/75 bg-[#02142b]/92 p-6 shadow-[0_10px_30px_rgba(22,135,201,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1687c9]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#1687c9]/60 bg-gradient-to-br from-[#9df1ff] via-[#4bdbee] to-[#0e4f7a] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eafcff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fb6cc]">เข้าสู่ระบบ ขวัญใจ168 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fb6cc]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0e4f7a] bg-[#01050b]/95 py-3 pr-4 pl-12 text-[#cfe7f2] transition-all outline-none placeholder:text-[#8fb6cc] focus:border-[#4bdbee] focus:ring-1 focus:ring-[#4bdbee]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fb6cc]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0e4f7a] bg-[#01050b]/95 py-3 pr-4 pl-12 text-[#cfe7f2] transition-all outline-none placeholder:text-[#8fb6cc] focus:border-[#4bdbee] focus:ring-1 focus:ring-[#4bdbee]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfe7f2]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0e4f7a] bg-[#01050b] accent-[#4bdbee]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfe7f2] transition-colors hover:text-[#4bdbee]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#1687c9]/55 bg-gradient-to-r from-[#9df1ff] via-[#4bdbee] to-[#1687c9] p-3.5 text-center font-black text-[#01050b] shadow-[0_10px_30px_rgba(22,135,201,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(75,219,238,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8fb6cc]">
          <span class="h-px flex-1 bg-[#0e4f7a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0e4f7a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0e4f7a]/80 bg-[#01050b] px-2.5 py-1 text-[10px] font-bold text-[#eafcff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#1687c9]/40 bg-[#01050b]/80 px-2.5 py-1 text-[10px] font-bold text-[#cfe7f2]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#eafcff] transition-colors hover:text-[#4bdbee]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#1687c9]/40 bg-[#02142b]/92 p-5 shadow-[0_10px_30px_rgba(22,135,201,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfe7f2]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#eafcff] via-[#4bdbee] to-[#1687c9] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fb6cc] uppercase">
        <span>บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0e4f7a] bg-[#01050b]/95 px-3.5 py-2.5 transition-colors hover:border-[#4bdbee]/60 hover:bg-[#083b5c]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfe7f2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#0e4f7a]/80 bg-[#01050b] px-2.5 py-0.5 text-[10px] font-bold text-[#eafcff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8fb6cc]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1687c9]/35 bg-[#01050b] px-3 py-1 text-[10px] font-bold text-[#eafcff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8fb6cc]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </div>
    </div>
  </div>
</ContentBoxTwo>
