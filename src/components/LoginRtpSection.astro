---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// TTN69 is a สล็อตออโต้เกม brand — slots only, NOT บาคาร่า/บอล/หวย. Every row
// below stays inside what the brief states: รวมเกมจากหลายแบรนด์ไว้ในบัญชีเดียว
// ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ตามที่แต่ละค่ายเปิดให้
// บริการ, การเข้าใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์, ระบบออโต้ที่ให้สมาชิก
// ฝากเครดิต ส่งคำขอถอน และตรวจสถานะรายการได้เอง, การ Login เพื่อดูเครดิต ประวัติ
// ฝากถอน และโปรโมชั่นที่เปิดให้รับ, โบนัสแนะนำเพื่อน 0.8% พร้อมรอบคำนวณและยอดที่
// เข้าเกณฑ์, ช่องทางธนาคารและวอลเลทตามที่ระบบรองรับ, และ LINE OFFICIAL ที่ติดต่อ
// แอดมินได้ตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed payout — the brief says คำว่า
// "ขั้นต่ำ 1 บาททุกค่าย" ต้องดูช่วงเดิมพันของแต่ละเกมก่อน, คำว่า "แตกง่าย"/
// "แตกหนัก" รับประกันไม่ได้, และ "รองรับทุกธนาคาร" ต้องยึดช่องทางที่เปิดใช้งาน
// จริง ณ เวลานั้น.
const menus = [
  {
    icon: "🎰",
    name: "สล็อตคลาสสิกจากหลายแบรนด์",
    detail: "หมวดสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ เลือกเกมและดูรูปแบบการจ่ายของเกมนั้นได้ก่อนเริ่มหมุนทุกครั้ง",
    tag: "หลายค่าย",
  },
  {
    icon: "🎁",
    name: "เกมโบนัสและฟรีสปิน",
    detail: "ฟีเจอร์โบนัสและฟรีสปินเป็นไปตามกติกาที่แต่ละเกมกำหนด ควรอ่านเงื่อนไขของฟีเจอร์ในเกมให้ครบก่อนเริ่มเล่น",
    tag: "ตามเงื่อนไขเกม",
  },
  {
    icon: "💎",
    name: "แจ็กพอตและเกมธีมใหม่",
    detail: "เกมแจ็กพอตและเกมธีมใหม่เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ รายการที่เปิดให้เล่นในแต่ละช่วงจึงเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมเป็นหลัก",
    tag: "อัปเดตตามค่าย",
  },
  {
    icon: "🪙",
    name: "ช่วงเดิมพันเริ่มต้นระดับ 1 บาท",
    detail: "บางเกมมีช่วงเดิมพันเริ่มต้นระดับ 1 บาท แต่ขั้นต่ำจริงต่างกันตามผู้ให้บริการ ควรตรวจช่วงเดิมพันของเกมนั้นก่อนเริ่มเล่นเสมอ",
    tag: "ดูในเกมก่อน",
  },
  {
    icon: "🔀",
    name: "สลับค่ายจากบัญชีเดียว",
    detail: "จัดเกมเป็นหมวดหมู่เพื่อให้ค้นหาและสลับค่ายผ่านบัญชีเดียวได้ ไม่ต้องสมัครใหม่ทุกครั้งที่ย้ายไปเล่นอีกค่ายหนึ่ง",
    tag: "บัญชีเดียว",
  },
  {
    icon: "📱",
    name: "เข้าเล่นได้ทั้งมือถือ แท็บเล็ต และคอม",
    detail: "รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน และดูโปรโมชั่นได้จากหน้าเว็บไซต์เดียวกัน",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "🎫",
    name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ",
    detail: "เข้าสู่ระบบเพื่อดูสิทธิ์ที่รับได้ในแต่ละช่วง เช่น โบนัสแนะนำเพื่อน 0.8% ที่คำนวณจากยอดเข้าเกณฑ์ตามรอบและเงื่อนไขที่กำหนด",
    tag: "แนะนำเพื่อน 0.8%",
  },
  {
    icon: "💳",
    name: "ฝากถอนผ่านธนาคารและวอลเลท",
    detail: "ฝากเครดิต ส่งคำขอถอน และติดตามสถานะผ่านบัญชีสมาชิกได้เอง ก่อนทำธุรกรรมควรตรวจรายชื่อธนาคาร ยอดขั้นต่ำ วงเงิน และสถานะของช่องทางล่าสุด",
    tag: "ทำรายการเอง",
  },
];

const chips = ["สล็อตคลาสสิก", "เกมโบนัส", "ฟรีสปิน", "แจ็กพอต", "เกมธีมใหม่", "ระบบออโต้", "แนะนำเพื่อน 0.8%", "LINE OFFICIAL 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ TTN69" titleright="จุดที่ควรตรวจสอบก่อนหมุนสล็อตและก่อนกดรับโปรโมชั่น" label="เข้าสู่ระบบ TTN69 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#046b3a]/55 bg-[#061309]/92 p-6 shadow-[0_10px_30px_rgba(2,185,97,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#02b961]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4ece7]/50 bg-gradient-to-br from-[#f1faf4] via-[#c9f7dd] to-[#046b3a] text-xl shadow-inner">
          🏔️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f1faf4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#4ce68f]">เข้าสู่ระบบ TTN69 เพื่อเลือกเกมสล็อตจากหลายแบรนด์ผ่านบัญชีเดียว ตรวจสอบเครดิต ดูโปรโมชั่นที่มีสิทธิ์รับ และจัดการฝากถอนได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d5e6da]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#046b3a]/55 bg-[#020805]/95 py-3 pr-4 pl-12 text-[#d5e6da] transition-all outline-none placeholder:text-[#d5e6da]/45 focus:border-[#02b961] focus:ring-1 focus:ring-[#02b961]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d5e6da]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#046b3a]/55 bg-[#020805]/95 py-3 pr-4 pl-12 text-[#d5e6da] transition-all outline-none placeholder:text-[#d5e6da]/45 focus:border-[#02b961] focus:ring-1 focus:ring-[#02b961]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d5e6da]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#046b3a]/55 bg-[#020805] accent-[#02b961]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d5e6da] transition-colors hover:text-[#f1faf4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#046b3a]/60 bg-gradient-to-r from-[#4ce68f] via-[#02b961] to-[#046b3a] p-3.5 text-center font-black text-[#020805] shadow-[0_10px_30px_rgba(2,185,97,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(76,230,143,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d5e6da]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#046b3a]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#046b3a]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE OFFICIAL
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e4ece7]/40 bg-[#020805] px-2.5 py-1 text-[10px] font-bold text-[#e4ece7]"><span aria-hidden="true">🎰</span> รวมสล็อตหลายแบรนด์</span>
            <span class="rounded-full border border-[#046b3a]/50 bg-[#020805]/80 px-2.5 py-1 text-[10px] font-bold text-[#4ce68f]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#4ce68f] transition-colors hover:text-[#f1faf4]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#046b3a]/55 bg-[#061309]/92 p-5 shadow-[0_10px_30px_rgba(2,185,97,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d5e6da]">
            เลือกเกมสล็อตจากหลายแบรนด์ได้ผ่านบัญชีเดียว และตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขของเกมนั้นที่ระบบแสดงก่อนเริ่มหมุนทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#4ce68f] via-[#f1faf4] to-[#e4ece7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกค่ายสล็อตที่ระบบเปิด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e4ece7]/45 bg-[#0c2214]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e4ece7] shadow-[0_0_8px_rgba(228,236,231,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e4ece7] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d5e6da]/60 uppercase">
        <span>หมวดสล็อต โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#046b3a]/70 bg-[#020805]/95 px-3.5 py-2.5 transition-colors hover:border-[#e4ece7]/45 hover:bg-[#0c2214]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d5e6da]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e4ece7]/40 bg-[#020805] px-2.5 py-0.5 text-[10px] font-bold text-[#e4ece7]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d5e6da]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#046b3a]/45 bg-[#020805] px-3 py-1 text-[10px] font-bold text-[#4ce68f]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d5e6da]/60">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น แต่ละค่ายและแต่ละเกมสล็อตอาจกำหนดกติกา ช่วงเดิมพัน และรูปแบบการจ่ายไม่เท่ากัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ส่วนรอบคำนวณ
        ยอดที่เข้าเกณฑ์ และเงื่อนไขการรับโบนัสของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
