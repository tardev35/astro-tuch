---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// GOT777 เป็นเว็บเกมสล็อตออนไลน์ แผงฝั่งขวาจึงกลับมาเป็น "หมวดเกม" ได้ตามบรีฟ — แต่สร้าง
// จากคำที่บรีฟระบุชื่อไว้เองเท่านั้น คือเกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย เกมที่มี
// ฟรีสปิน ตัวคูณ สล็อตแจ็กพอต และเกมโบนัส กับจุดที่สมาชิกต้องตรวจในเกมก่อนเดิมพัน คือกติกา
// ช่วงเดิมพัน ฟีเจอร์โบนัส และเงื่อนไขของแจ็กพอต ทั้งหมดเป็นประโยคของบรีฟเอง ไม่มีตัวเลขใหม่
// สักตัว
//
// ห้ามใส่ RTP ค่าความผันผวน ชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต ยอดเดิมพันขั้นต่ำ หรือชื่อ
// ผู้ให้บริการเกมลงในไฟล์นี้ — บรีฟ GOT777 ไม่ได้ให้ไว้เลยสักอย่าง แม้เว็บนี้จะเป็นเว็บสล็อต
// จริงก็ตาม และห้ามมีคำของแบรนด์หวยรอบก่อน (หวย โพย งวด อัตราจ่าย 2 ตัว/3 ตัว รอบออกรางวัล)
// ตัวเลขที่ใช้ได้มีสี่ตัวเท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง ·
// เลข 777 ในชื่อแบรนด์ และห้ามแตกเป็นเงื่อนไข/รอบตัดยอดที่บรีฟไม่ได้บอก
const gameCategories = [
  { icon: "🎡", name: "เกมวงล้อแบบดั้งเดิม", detail: "สล็อตคลาสสิกที่บรีฟระบุว่าเปิดให้เลือกเล่น เลือกเกมได้จากหน้าเกมสล็อต" },
  { icon: "🏮", name: "สล็อตธีมเอเชีย", detail: "อีกกลุ่มที่บรีฟระบุว่ามีให้เลือกตามสไตล์ที่ชอบ สลับเกมจากบัญชีเดียวได้" },
  { icon: "🗺️", name: "เกมผจญภัย", detail: "เกมตามธีมที่ระบบเปิดให้บริการ ค้นหาเกมใหม่หรือเกมยอดนิยมได้จากหน้าเดียว" },
  { icon: "🎁", name: "เกมโบนัส", detail: "เกมที่มีฟีเจอร์โบนัสในตัว รายละเอียดฟีเจอร์ให้ดูจากข้อมูลภายในเกมนั้น" },
  { icon: "🔄", name: "ฟรีสปินและตัวคูณ", detail: "บางเกมมีฟรีสปินหรือตัวคูณให้ลุ้น โดยรูปแบบต่างกันไปตามแต่ละค่าย" },
  { icon: "💎", name: "สล็อตแจ็กพอต", detail: "เปิดให้เล่นตามค่ายที่ระบบรองรับ ไม่ใช่ทุกค่ายที่มีระบบแจ็กพอตเหมือนกัน" },
];

// สี่ข้อนี้ประกอบจากประโยคของบรีฟเองทั้งหมด — ตรวจกติกาและช่วงเดิมพันก่อนยืนยัน, อ่าน
// ฟีเจอร์โบนัสและฟรีสปินจากข้อมูลในเกม, ตรวจเงื่อนไขของแจ็กพอตตามค่าย และตรวจเครดิตกับ
// ประวัติรายการจากบัญชีสมาชิก
const beforeSpinChecks = [
  {
    icon: "📜",
    name: "กติกาและช่วงเดิมพัน",
    detail: "ก่อนเดิมพันควรตรวจกติกาและช่วงเดิมพันที่แสดงในเกมก่อนยืนยันทุกครั้ง เพราะยอดเดิมพันขั้นต่ำอาจแตกต่างกันตามผู้ให้บริการ",
    tag: "ตรวจในเกมก่อน",
  },
  {
    icon: "✨",
    name: "ฟีเจอร์โบนัสและฟรีสปิน",
    detail: "ฟีเจอร์โบนัส ฟรีสปิน และตัวคูณมีรูปแบบต่างกันในแต่ละเกม จึงควรอ่านรายละเอียดที่เกมแสดงไว้ก่อนเริ่มหมุนวงล้อ",
    tag: "อ่านรายละเอียดเกม",
  },
  {
    icon: "💎",
    name: "เงื่อนไขของแจ็กพอต",
    detail: "จำนวนเกมและแจ็กพอตที่เปิดให้เล่นจริงขึ้นอยู่กับแต่ละค่าย ไม่ใช่เกมสล็อตทุกเกมหรือทุกค่ายที่จะมีระบบแจ็กพอตเหมือนกัน",
    tag: "ขึ้นอยู่กับค่าย",
  },
  {
    icon: "🧾",
    name: "เครดิตและประวัติรายการ",
    detail: "สมาชิกเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว หากรายการยังอยู่ระหว่างตรวจสอบสามารถแจ้งแอดมินเพื่อให้ตรวจสอบได้ตรงจุด",
    tag: "ตรวจจากบัญชีสมาชิก",
  },
];

const chips = ["เกมวงล้อแบบดั้งเดิม", "สล็อตธีมเอเชีย", "เกมผจญภัย", "ฟรีสปิน", "ตัวคูณ", "สล็อตแจ็กพอต", "เกมโบนัส", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];

// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): โลโก้เป็นเวิร์ดมาร์กสองส่วน GOT เป็นทอง
// เมทัลลิก #f5c518 มีอัญมณีแดงฝังกลางตัว O แล้วปิดด้วยเลข 777 สีแดงเลือดหมู #d21622 ขอบทอง
// งานอาร์ตเป็นพื้นดำที่มีเหรียญทอง ชิปคาสิโนสีดำแดง ไพ่โพดำ และวงล้อรูเล็ต สองแผงจึงถูกแยก
// ด้วยคู่ทอง/แดงตามงานอาร์ตจริง ไม่ใช่น้ำหนักของสีเดียว — แผงล็อกอินอยู่ในกรอบทองแบรนด์
// ส่วนแผงหมวดเกมอยู่ในกรอบแดงลึก #7b0304 ทั้งคู่วางบนผิวการ์ด #160b06 เหนือพื้นเพจ
// #0a0503 ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิวแผงยก #241108 บรรทัดเด่นไล่เฉดขาว
// ไฮไลต์ #fff6dd → ทองอ่อน #ffe9a8 → ทองแบรนด์ #f5c518 ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#ffe9a8 → #f5c518 → #96690f) บนหมึกเข้ม #0a0503 ตามกฎคอนทราสต์ที่ว่าพื้นทองต้องใช้
// หมึกเข้ม (12.7:1) ห้ามใช้ตัวอักษรขาว (1.6:1) ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์ม
// ซึ่งห้ามรีแมป — ชุดแดง-ทองของ LOTTOPLUS ที่ค้างในไฟล์นี้ (#dc020e #ff2d38 #6b0207
// #f3c623 #fde79a #8a6a0a #fff4f4 #f0e2e2 #120b0c #1f0a0c #050505) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`เกมสล็อตที่เปิดให้เล่น ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎰"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมกลุ่มเกมสล็อตที่เปิดให้เล่นทั้งเกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย ฟรีสปิน ตัวคูณ สล็อตแจ็กพอต เกมโบนัส และจุดที่ควรตรวจในเกมก่อนเดิมพันทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f5c518]/45 bg-[#160b06]/94 p-6 shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f5c518]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/70 bg-gradient-to-br from-[#ffe9a8] via-[#f5c518] to-[#96690f] text-xl text-[#0a0503] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff6dd]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bdae92]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์เพื่อเลือกเกมสล็อตที่ต้องการ ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียวโดยไม่ต้องสมัครหลายบัญชี
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdae92]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#241108] bg-[#0a0503]/95 py-3 pr-4 pl-12 text-[#ece0cb] transition-all outline-none placeholder:text-[#bdae92]/70 focus:border-[#f5c518] focus:ring-1 focus:ring-[#ffe9a8]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdae92]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#241108] bg-[#0a0503]/95 py-3 pr-4 pl-12 text-[#ece0cb] transition-all outline-none placeholder:text-[#bdae92]/70 focus:border-[#f5c518] focus:ring-1 focus:ring-[#ffe9a8]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bdae92]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#241108] bg-[#0a0503] accent-[#f5c518]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bdae92] transition-colors hover:text-[#ffe9a8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe9a8]/70 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] p-3.5 text-center font-black text-[#0a0503] shadow-[0_10px_30px_rgba(245,197,24,0.4)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,233,168,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#bdae92]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#241108]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#241108]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#241108] bg-[#0a0503] px-2.5 py-1 text-[10px] font-bold text-[#ece0cb]"><span aria-hidden="true">🎰</span> เกมสล็อตออนไลน์</span>
            <span class="rounded-full border border-[#f5c518]/40 bg-[#0a0503]/85 px-2.5 py-1 text-[10px] font-bold text-[#f5c518]"><span aria-hidden="true">📱</span> เล่นผ่านเบราว์เซอร์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5c518] transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7b0304] bg-[#160b06]/94 p-5 shadow-[0_10px_30px_rgba(5,2,1,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bdae92]">
            {BRAND_NAME} รวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว สมาชิกเลือกเกม สลับค่าย ตรวจสอบเครดิต และดูประวัติรายการได้จากหน้าเว็บไซต์โดยไม่ต้องสมัครหลายบัญชี
          </span>
          <div class="bg-gradient-to-r from-[#fff6dd] via-[#ffe9a8] to-[#f5c518] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">ฟรีสปิน · ตัวคูณ · แจ็กพอต</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#241108] bg-[#0a0503]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d21622] shadow-[0_0_8px_rgba(210,22,34,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f5c518] uppercase">ตามค่ายที่เปิดให้บริการ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdae92] uppercase">
        <span>กลุ่มเกมสล็อตในระบบ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameCategories.map((g) => (
            <div class="rounded-xl border border-[#241108] bg-[#0a0503]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c518]/70 hover:bg-[#241108]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fff6dd]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {g.icon}
                </span>
                <span class="truncate">{g.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#bdae92]">{g.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#bdae92]">
        จำนวนเกมและแจ็กพอตที่เปิดให้เล่นจริงขึ้นอยู่กับแต่ละค่าย จึงควรตรวจสอบข้อมูลภายในเกมก่อนเดิมพัน โดยเฉพาะกติกา ช่วงเดิมพัน ฟีเจอร์โบนัส และเงื่อนไขของแจ็กพอต
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdae92] uppercase">
        <span>จุดที่ควรตรวจก่อนเดิมพัน</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSpinChecks.map((k) => (
            <div class="rounded-xl border border-[#241108] bg-[#0a0503]/95 px-3.5 py-2.5 transition-colors hover:border-[#d21622]/70 hover:bg-[#241108]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece0cb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c518]/50 bg-[#0a0503] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c518]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bdae92]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#241108] bg-[#0a0503] px-3 py-1 text-[10px] font-bold text-[#ece0cb]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#bdae92]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว การรองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ การเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากระบบเดียว
