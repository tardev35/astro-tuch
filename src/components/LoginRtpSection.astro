---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// ENTER55 เป็นเว็บสล็อต + หวยออนไลน์ในทางเข้าเดียว รายการฝั่งขวาจึงเป็นข้อเท็จจริง
// ที่ brief ระบุไว้เองล้วนๆ — เว็บตรงไม่ผ่านเอเย่นต์ที่มั่นคงทางการเงินระดับประเทศ,
// ระบบกระเป๋าเดียว Single Wallet, หวยสี่ประเภทที่เปิดรับ, นโยบายจ่ายเต็มทุกบิลไม่หัก
// เปอร์เซ็นต์, อัตราจ่าย 2 ตัวบาทละ 100 กับ 3 ตัวตรงบาทละ 1,000, โปรแนะนำเพื่อน
// 0.8% กับคืนยอดเสีย 0.3%, ฝาก-ถอนออโต้ไม่มีขั้นต่ำภายใน 3-5 วินาที, ทุกธนาคาร
// ชั้นนำและ TrueMoney Wallet, ถอนเต็มจำนวนไม่มีอั้นยอดถอนต่อวัน และการสมัครออโต้
// สามขั้นตอน ไม่มีการคิดตัวเลขหรือเงื่อนไขขึ้นมาเอง
const menus = [
  {
    icon: "👛",
    name: "กระเป๋าเดียว (Single Wallet)",
    detail: "ฝากเงินเพียงครั้งเดียว นำเครดิตไปเล่นได้ทั้งสล็อตและหวย สลับหน้าเล่นได้ทันทีโดยไม่ต้องกดย้ายเงินหรือโยกเครดิตระหว่างค่ายเกม",
    tag: "ไม่ต้องโยกเงิน",
  },
  {
    icon: "🏛️",
    name: "เว็บตรงไม่ผ่านเอเย่นต์",
    detail: "มีความมั่นคงทางการเงินระดับประเทศ จึงกล้าให้เรทอัตราจ่ายที่สูงกว่าเว็บทั่วไปในตลาด การันตีความปลอดภัย 100% ไม่มีประวัติการโกง",
    tag: "เรทจ่ายสูง",
  },
  {
    icon: "🎟️",
    name: "เปิดรับหวยครบทุกประเภท",
    detail: "ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น เลือกแทงได้ครบจากทางเข้าเดียวกับที่ใช้เล่นสล็อต",
    tag: "4 ประเภท",
  },
  {
    icon: "💯",
    name: "จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์",
    detail: "แม้จะเป็นเลขเด็ด เลขดัง หรือเลขอั้น เว็บก็พร้อมให้เรทราคาที่ยุติธรรมและคุ้มค่าที่สุด ไม่มีการหักเปอร์เซ็นต์จากยอดรางวัล",
    tag: "ไม่หัก %",
  },
  {
    icon: "2️⃣",
    name: "หวย 2 ตัวบน-ล่าง บาทละ 100",
    detail: "อัตราการจ่ายรางวัลหวยประเภท 2 ตัวบน และ 2 ตัวล่าง สูงสุดถึงบาทละ 100 ลงทุนหลักสิบก็เปลี่ยนเป็นเงินหลักพันได้",
    tag: "บาทละ 100",
  },
  {
    icon: "3️⃣",
    name: "หวย 3 ตัวตรง บาทละ 1,000",
    detail: "ทายผลเลข 3 ตัวตรงถูกต้อง รับเงินรางวัลในอัตราสูงที่สุดในตลาดถึงบาทละ 1,000 ระบบปรับยอดเครดิตให้ทันที ถอนไปใช้ได้เลย",
    tag: "บาทละ 1,000",
  },
  {
    icon: "🤝",
    name: "โปรโมชั่นแนะนำเพื่อน 0.8%",
    detail: "นำลิงก์ส่วนตัวไปแชร์ให้เพื่อนสมัครและเข้าเล่นสล็อต รับค่าคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเล่นของเพื่อน ถอนเป็นเงินสดได้จริง",
    tag: "Passive Income",
  },
  {
    icon: "💰",
    name: "โปรโมชั่นคืนยอดเสีย 0.3%",
    detail: "คืนยอดเสีย 0.3% ในทุกรอบบิล ให้มีทุนสำรองไว้แก้มือและต่อยอดสร้างกำไรในเกมสล็อตได้อย่างต่อเนื่อง",
    tag: "ทุกรอบบิล",
  },
  {
    icon: "⚡",
    name: "ฝาก-ถอนออโต้ ไม่มีขั้นต่ำ",
    detail: "ทุน 1 บาทก็ฝากเข้ามาเดิมพันได้ ทำรายการได้ตลอด 24 ชั่วโมง ใช้เวลาเพียง 3-5 วินาที รองรับทุกธนาคารชั้นนำ รวมถึง TrueMoney Wallet",
    tag: "3-5 วินาที",
  },
  {
    icon: "🏆",
    name: "ถอนได้ 100% ไม่มีอั้นยอดต่อวัน",
    detail: "ไม่ว่ายอดถอนของคุณจะรวมกันหลักหมื่น หลักแสน หรือหลักล้าน เว็บพร้อมโอนจ่ายให้เต็มจำนวน ไม่มีอั้นยอดถอนต่อวัน",
    tag: "เต็มจำนวน",
  },
];

const chips = [
  "เว็บตรงไม่ผ่านเอเย่นต์",
  "กระเป๋าเดียว Single Wallet",
  "หวยรัฐบาลไทย",
  "หวยลาว",
  "หวยฮานอย",
  "หวยหุ้น",
  "2 ตัว บาทละ 100",
  "3 ตัวตรง บาทละ 1,000",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "ฝาก-ถอนไม่มีขั้นต่ำ",
  "TrueMoney Wallet",
];

// ENTER55 palette: both panels sit on the card surface (#0b0b0a) over the page
// black, with the login plate in the core gold (#c4a255) and the service list in
// the bright champagne (#ebd484) — brightness, not a second hue. The LINE button
// keeps the platform's own green.
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ ENTER55"
  titleright="จุดเด่นของ ENTER55 ที่เว็บประกาศไว้"
  label="เข้าสู่ระบบ ENTER55 และรายการจุดเด่นเรื่องระบบกระเป๋าเดียว อัตราจ่ายหวย กับโปรโมชั่นที่เว็บประกาศไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c4a255]/40 bg-[#0b0b0a]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c4a255]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c4a255]/70 bg-gradient-to-br from-[#ebd484] via-[#c4a255] to-[#8a6d2c] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ebd484]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a1937a]">ล็อคอินเข้า ENTER55 เพื่อเล่นสล็อตและแทงหวยออนไลน์ด้วยเครดิตกระเป๋าเดียว กดรับโปรโมชั่น และทำรายการฝาก-ถอนออโต้แบบไม่มีขั้นต่ำได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a1937a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#26200f] bg-[#000000]/95 py-3 pr-4 pl-12 text-[#ded8cb] transition-all outline-none placeholder:text-[#a1937a]/70 focus:border-[#c4a255] focus:ring-1 focus:ring-[#ebd484]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a1937a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#26200f] bg-[#000000]/95 py-3 pr-4 pl-12 text-[#ded8cb] transition-all outline-none placeholder:text-[#a1937a]/70 focus:border-[#c4a255] focus:ring-1 focus:ring-[#ebd484]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ded8cb]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#26200f] bg-[#000000] accent-[#c4a255]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ded8cb]/80 transition-colors hover:text-[#ebd484]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ebd484]/70 bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#c4a255] p-3.5 text-center font-black text-[#000000] shadow-[0_10px_30px_rgba(196,162,85,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(235,212,132,0.5)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a1937a]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#26200f]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#26200f]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#26200f] bg-[#000000] px-2.5 py-1 text-[10px] font-bold text-[#ded8cb]"><span aria-hidden="true">🎰</span> สล็อต + หวย</span>
            <span class="rounded-full border border-[#c4a255]/50 bg-[#000000]/85 px-2.5 py-1 text-[10px] font-bold text-[#ebd484]"><span aria-hidden="true">🕐</span> ออโต้ 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ebd484] transition-colors hover:text-[#d2b262]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ebd484]/40 bg-[#0b0b0a]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a1937a]">เว็บเล่นสล็อตและหวยออนไลน์ รวมครบในทางเข้าเดียว</span>
          <div class="bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#8a6d2c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เรทจ่ายสูง จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#26200f] bg-[#000000]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c4a255] shadow-[0_0_8px_rgba(196,162,85,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ebd484] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a1937a] uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#26200f] bg-[#000000]/95 px-3.5 py-2.5 transition-colors hover:border-[#c4a255]/70 hover:bg-[#16140f]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ded8cb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ebd484]/45 bg-[#000000] px-2.5 py-0.5 text-[10px] font-bold text-[#ebd484]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a1937a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#26200f] bg-[#000000] px-3 py-1 text-[10px] font-bold text-[#ded8cb]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a1937a]">
        รายการข้างต้นสรุปสิ่งที่ ENTER55 ประกาศไว้ ทั้งระบบกระเป๋าเดียวที่ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวย นโยบายจ่ายเต็มทุกบิลไม่หักเปอร์เซ็นต์ ระบบฝาก-ถอนออโต้ที่ไม่มีขั้นต่ำ และโปรโมชั่นที่เปิดให้กดรับผ่านหน้าเว็บ
        ส่วนรอบคำนวณและเงื่อนไขของโปรโมชั่นแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
