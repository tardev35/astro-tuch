---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// KINDEE365 is a LOTTERY brand, so every row below describes ส่งโพย / รอบหวย /
// เรท / ฝากถอนออโต้ — never baccarat, slots or football. Each one stays inside
// what the brief states: หวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นต่างประเทศตามรอบที่
// เปิดบริการ, การเลือกประเภทหวย เลขที่ต้องการ และจำนวนเงินเดิมพันจากระบบโดยตรง,
// การตรวจเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของรอบก่อนยืนยันโพย, การยึด
// วงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพยสำหรับข้อความ "รับทุกเลข"/"จ่ายไม่อั้น",
// เรทเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100, ฝากถอนออโต้ผ่านธนาคารหรือวอลเลท
// ตามช่องทางที่เปิดรองรับ, การตรวจสถานะรายการเองและเก็บหลักฐานไว้ประกอบการตรวจสอบ,
// และเจ้าหน้าที่ที่รับเรื่องตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed win — the brief states none of them.
const menus = [
  { icon: "🏛️", name: "เลือกประเภทหวยที่เปิดรอบ", detail: "หวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ เลือกได้จากระบบเดียวตามรอบที่เปิดให้บริการ", tag: "4 ประเภท" },
  { icon: "🔢", name: "กรอกเลขและจำนวนเงินเดิมพัน", detail: "เลือกประเภทหวย เลขที่ต้องการ และจำนวนเงินเดิมพันได้จากระบบโดยตรงก่อนกดยืนยันโพย", tag: "ส่งโพยเอง" },
  { icon: "⏰", name: "ตรวจเวลาเปิด-ปิดของรอบ", detail: "ก่อนยืนยันโพยควรดูเวลาเปิด-ปิดของรอบนั้นให้ครบถ้วน เพื่อให้รายละเอียดตรงกับรายการที่ต้องการส่ง", tag: "ดูรอบก่อน" },
  { icon: "🚫", name: "ดูเลขอั้นและวงเงินของรอบ", detail: "ข้อความรับทุกเลขหรือจ่ายไม่อั้นให้ยึดวงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพย เพราะบางเลขหรือบางรอบอาจมีข้อกำหนดเฉพาะ", tag: "ยึดระบบจริง" },
  { icon: "💵", name: "ตรวจอัตราจ่ายก่อนยืนยัน", detail: "หน้านี้กำหนดเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 ควรตรวจตัวเลขที่แสดงจริงในระบบก่อนยืนยันทุกครั้ง", tag: "เช็กเรทก่อน" },
  { icon: "🏦", name: "ฝากถอนออโต้ธนาคารและวอลเลท", detail: "เลือกใช้ธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ ฝากเครดิตและส่งคำขอถอนได้จากบัญชีของตนเอง", tag: "ระบบออโต้" },
  { icon: "🧾", name: "ตรวจสถานะรายการด้วยตัวเอง", detail: "ตรวจสอบสถานะธุรกรรมและประวัติรายการผ่านบัญชีของตนเอง หากยอดไม่ตรงหรือรายการค้าง ให้เก็บหลักฐานไว้ประกอบการตรวจสอบ", tag: "เช็กเองได้" },
  { icon: "🕐", name: "แจ้งเจ้าหน้าที่ได้ 24 ชั่วโมง", detail: "แจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดของรายการ เพื่อให้ทีมงานช่วยตรวจสอบได้ตรงจุด", tag: "ตลอด 24 ชม." },
];

const chips = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย", "หวยหุ้นต่างประเทศ", "3 ตัวบาทละ 1,000", "2 ตัวบาทละ 100", "ฝากถอนออโต้", "เจ้าหน้าที่ 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ KINDEE365" titleright="จุดที่ควรตรวจสอบก่อนยืนยันโพยกับ KINDEE365" label="เข้าสู่ระบบ KINDEE365 และรายการจุดที่ควรตรวจสอบก่อนยืนยันโพย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#2b8ae9]/40 bg-[#083163]/92 p-6 shadow-[0_10px_30px_rgba(43,138,233,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e8bb4a]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8bb4a]/60 bg-gradient-to-br from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] text-xl shadow-inner">
          🎫
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f8dc8c]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fb3d9]">เข้าสู่ระบบ KINDEE365 เพื่อเลือกประเภทหวย กรอกเลข ส่งโพย ตรวจอัตราจ่ายและเลขอั้นของรอบนั้น ฝากถอนออโต้ และติดตามประวัติรายการได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fb3d9]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2b8ae9]/45 bg-[#010b26]/95 py-3 pr-4 pl-12 text-[#cfe3f7] transition-all outline-none placeholder:text-[#8fb3d9] focus:border-[#2b8ae9] focus:ring-1 focus:ring-[#2b8ae9]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#8fb3d9]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2b8ae9]/45 bg-[#010b26]/95 py-3 pr-4 pl-12 text-[#cfe3f7] transition-all outline-none placeholder:text-[#8fb3d9] focus:border-[#2b8ae9] focus:ring-1 focus:ring-[#2b8ae9]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfe3f7]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2b8ae9]/45 bg-[#010b26] accent-[#2b8ae9]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfe3f7] transition-colors hover:text-[#f8dc8c]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#b98213]/55 bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] p-3.5 text-center font-black text-[#010b26] shadow-[0_10px_30px_rgba(232,187,74,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,187,74,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8fb3d9]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#2b8ae9]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#2b8ae9]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e8bb4a]/45 bg-[#010b26] px-2.5 py-1 text-[10px] font-bold text-[#e8bb4a]"><span aria-hidden="true">🎫</span> ส่งโพยออนไลน์</span>
            <span class="rounded-full border border-[#2b8ae9]/40 bg-[#010b26]/80 px-2.5 py-1 text-[10px] font-bold text-[#a3dbfb]"><span aria-hidden="true">🕐</span> เจ้าหน้าที่ 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a3dbfb] transition-colors hover:text-[#f8dc8c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#2b8ae9]/40 bg-[#083163]/92 p-5 shadow-[0_10px_30px_rgba(43,138,233,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfe3f7]">ส่งโพยหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศจากบัญชีเดียว ตรวจเรท เลขอั้น และวงเงินของรอบนั้นก่อนยืนยันโพยทุกครั้ง</span>
          <div class="bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">3 ตัว 1,000 • 2 ตัว 100</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e8bb4a]/55 bg-[#02153c]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8bb4a] shadow-[0_0_8px_rgba(232,187,74,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e8bb4a] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fb3d9] uppercase">
        <span>ขั้นตอนส่งโพย ฝากถอน และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1f6fd0]/60 bg-[#010b26]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8bb4a]/60 hover:bg-[#02153c]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfe3f7]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e8bb4a]/45 bg-[#010b26] px-2.5 py-0.5 text-[10px] font-bold text-[#e8bb4a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8fb3d9]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2b8ae9]/35 bg-[#010b26] px-3 py-1 text-[10px] font-bold text-[#a3dbfb]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8fb3d9]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนยืนยันโพย หวยแต่ละประเภทและแต่ละรอบอาจมีเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินต่างกัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก
        ส่วนรายชื่อธนาคาร วอลเลท ยอดขั้นต่ำ และวงเงินต่อรายการ ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
