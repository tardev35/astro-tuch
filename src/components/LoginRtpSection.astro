---
// ContentBoxTwo (the plain sibling) still carries a previous brand's gold and
// is inventory now; this box uses the CyberCut two-column shell, whose column
// labels render as <p> so a login widget never emits a heading.
import ContentBoxTwoCyberCut from "./ContentBoxTwoCyberCut.astro";

// Every row below stays inside what the brief states: 2 ตัว / 3 ตัว / เลขอั้น /
// วิ่งบน-วิ่งล่าง, เรทจ่ายสูงสุด 1,000, ฝากถอนออโต้ และแอดมิน 24 ชั่วโมง.
const menus = [
  { icon: "🎱", name: "หวย 2 ตัว", detail: "เลือกเลขบนหรือเลขล่าง ใส่ยอดแทงแล้วตรวจโพยก่อนกดยืนยัน", tag: "ตามเรทที่ระบบแสดง" },
  { icon: "🎯", name: "หวย 3 ตัว", detail: "กรอกเลขและยอดแทง ตรวจอัตราจ่ายบนหน้าส่งโพยก่อนยืนยัน", tag: "จ่ายสูงสุด 1,000" },
  { icon: "🚦", name: "เลขอั้น", detail: "วงเงินรับของเลขนั้นแสดงในระบบ ณ เวลาส่งโพย", tag: "ตรวจวงเงินก่อนแทง" },
  { icon: "⬆️", name: "วิ่งบน", detail: "แทงเลขวิ่งตำแหน่งบนตามเงื่อนไขของรอบนั้น", tag: "ตามเรทที่ระบบแสดง" },
  { icon: "⬇️", name: "วิ่งล่าง", detail: "แทงเลขวิ่งตำแหน่งล่างตามเงื่อนไขของรอบนั้น", tag: "ตามเรทที่ระบบแสดง" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติ", detail: "ฝากเครดิตผ่านระบบอัตโนมัติแล้วเริ่มส่งโพยได้ทันที", tag: "จัดการเครดิตเอง" },
  { icon: "🛎️", name: "แอดมินบริการ 24 ชั่วโมง", detail: "แจ้งได้ทั้งเรื่องสมัครสมาชิก ฝากถอน เครดิตไม่เข้า และการส่งโพย", tag: "แจ้งปัญหาได้ตลอด" },
];

const chips = ["2 ตัว", "3 ตัว", "เลขอั้น", "วิ่งบน", "วิ่งล่าง", "ตรวจโพย", "มือถือ"];
---

<ContentBoxTwoCyberCut titleleft="เข้าสู่ระบบ HSOD" titleright="ประเภทการแทงและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ HSOD และประเภทการแทงหวยที่เปิดรับทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7c0207]/40 bg-[#170406]/92 p-6 shadow-[0_10px_30px_rgba(232,18,29,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3d0104]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7c0207]/50 bg-gradient-to-br from-[#ff4d55] via-[#e8121d] to-[#3d0104] text-xl shadow-inner">
          🎫
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#e8121d]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#aeb6c2]">เข้าสู่ระบบ HSOD ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7c0207]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2a0508] bg-[#0b0203]/95 py-3 pr-4 pl-12 text-[#dfe3ea] transition-all outline-none placeholder:text-[#aeb6c2]/60 focus:border-[#e8121d] focus:ring-1 focus:ring-[#e8121d]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7c0207]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2a0508] bg-[#0b0203]/95 py-3 pr-4 pl-12 text-[#dfe3ea] transition-all outline-none placeholder:text-[#aeb6c2]/60 focus:border-[#e8121d] focus:ring-1 focus:ring-[#e8121d]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#aeb6c2]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2a0508] bg-[#0b0203] accent-[#e8121d]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#aeb6c2] transition-colors hover:text-[#ff4d55]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7c0207]/50 bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] p-3.5 text-center font-black text-[#1a0204] shadow-[0_10px_30px_rgba(232,18,29,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,18,29,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#aeb6c2]/70">
          <span class="h-px flex-1 bg-[#2a0508]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2a0508]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7c0207]/40 bg-[#0b0203] px-2.5 py-1 text-[10px] font-bold text-[#e8121d]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#c2c9d4]/30 bg-[#0b0203]/80 px-2.5 py-1 text-[10px] font-bold text-[#c2c9d4]"><span aria-hidden="true">🕐</span> แอดมินดูแล 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e8121d] transition-colors hover:text-[#ff4d55]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c2c9d4]/25 bg-[#170406]/92 p-5 shadow-[0_10px_30px_rgba(194,201,212,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#aeb6c2]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#e8121d] via-[#ff4d55] to-[#c2c9d4] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#aeb6c2]/80 uppercase">
        <span>ประเภทการแทง / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2a0508] bg-[#0b0203]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8121d]/50 hover:bg-[#260609]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dfe3ea]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7c0207]/40 bg-[#0b0203] px-2.5 py-0.5 text-[10px] font-bold text-[#e8121d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#aeb6c2]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c2c9d4]/25 bg-[#0b0203] px-3 py-1 text-[10px] font-bold text-[#c2c9d4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#aeb6c2]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwoCyberCut>
