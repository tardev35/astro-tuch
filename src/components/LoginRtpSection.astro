// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — SUPERSLOTCLUB เป็น
// "คลับคนเล่นสล็อตซุปเปอร์ / กลุ่มลับคนดังวงการสล็อตออนไลน์" ที่พูดถึงรูปแบบชุมชนและ
// ดับเบิ้ลโบนัส ส่วน FLASH877 เป็น **เว็บตรงฐานสล็อตหลัก ไม่ผ่านเอเย่นต์ ไม่ผ่านม้า**
// ที่พูดถึงการอัปเดตระบบเข้าเล่นใหม่ปี 2026 การรวมเกมหลายประเภทไว้ในบัญชีเดียว
// การค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น ประวัติรายการ การจัดหมวดเกม หน้าเข้าสู่ระบบ
// เมนูเลือกเกม ส่วนจัดการบัญชี โปรโมชั่นสองรายการ ระบบฝากถอนเข้าบัญชีบริษัทโดยตรง
// กับการตรวจชื่อบัญชีปลายทาง และแอดมิน 24 ชั่วโมงเท่านั้น แผงนี้จึงถูกเขียนใหม่ทั้งแผง
// จากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เว็บตรงฐานสล็อตหลัก · ไม่ผ่านเอเย่นต์ · ไม่ผ่านม้า/บัญชีม้า · เว็บฐานหลัก 100% ·
// อัปเดตระบบเข้าเล่นใหม่ 2026 · สล็อตคลาสสิก · เกมฟรีสปิน · โบนัสตัวคูณ ·
// เกมใหม่จากค่ายที่เปิดให้บริการ · บัญชีเดียว · ค้นหาเกม · ตรวจสอบเครดิต ·
// ประวัติรายการ · จัดหมวดเกม · หน้าเข้าสู่ระบบ · เมนูเลือกเกม · ส่วนจัดการบัญชี ·
// ช่องทางหลัก · ผู้ดำเนินงาน · รายชื่อค่ายเกมที่ตรวจสอบได้ · คืนยอดเสีย 0.3% ·
// เข้ายูส · รอบตัดยอด · รอบคำนวณ · ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน 0.8% · แชร์ลิงก์ ·
// ลิงก์แนะนำ · ฝากถอนเข้าบัญชีบริษัทโดยตรง · บัญชีปลายทาง · นิติบุคคล ·
// หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง · PIN · OTP · ช่องทางติดต่อหลัก
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §6 (คลับคนเล่นสล็อตซุปเปอร์ ·
// กลุ่มลับคนดังวงการสล็อตออนไลน์ · ชุมชน · ดับเบิ้ลโบนัส · เครือเว็บหลัก ·
// สล็อตเว็บหลัก · ฐานเว็บสล็อตหลัก · แพลตฟอร์มเดียว · เดิมพันเริ่มต้น 1 บาท ·
// สล็อตเบทต่ำ · ทุนน้อย · ตารางจ่าย · ช่วงเดิมพัน · ผลการหมุนเป็นแบบสุ่ม ·
// เล่นสล็อตออโต้ทุกค่าย · แตกง่าย · ไม่มีขั้นต่ำ · ค่ายตรง · ส่งตรงจากเว็บแม่ ·
// ศูนย์รวมเกมสล็อตค่ายแท้ · การันตีเว็บแท้ · รีวิวถอนจริง · ถูกลิขสิทธิ์ · ไฮคลาส ·
