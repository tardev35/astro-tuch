---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// LOTTOKA เป็นเว็บแทงหวยออนไลน์ ไม่ใช่คาสิโน — ตารางฝั่งขวาเดิมเป็นค่า RTP ของเกม
// สล็อต ซึ่งไม่มีความหมายกับแบรนด์หวย จึงถูกแทนด้วยข้อเท็จจริงด้านการเงินและความ
// ปลอดภัยที่ brief ระบุไว้เอง: ยอดเข้าบัญชีบริษัทโดยตรง, ไม่ผ่านบัญชีม้า, รับเงิน
// เข้าเต็ม 100% ไม่หักค่าธรรมเนียม, ไม่มีขั้นต่ำในการฝาก, ทุกธนาคาร + TrueMoney
// Wallet, ระบบออโต้ และนโยบายรับแทงทุกเลข ไม่มีปิดกั้น
//
// ไม่มีการคิดตัวเลขขึ้นมาเองในบล็อกนี้ — เรทเดียวที่มีอยู่จริงในเอกสารคือ
// 2 ตัวบาทละ 100 กับ 3 ตัวบาทละ 1,000 และทั้งคู่อยู่ในหัวข้อ #4/#5 ของบทความ
// จึงไม่ถูกพูดซ้ำที่นี่
const menus = [
  {
    icon: "🏦",
    name: "ยอดเข้าบัญชีบริษัทโดยตรง",
    detail: "ทุกยอดการฝาก-ถอนของคุณจะถูกโอนเข้าสู่บัญชีของบริษัทโดยตรง ทำรายการอย่างถูกต้องและโปร่งใส",
    tag: "เว็บหลัก",
  },
  {
    icon: "🛡️",
    name: "ไม่ผ่านบัญชีม้าหรือบุคคลที่สาม",
    detail: "ไม่มีการใช้บัญชีม้าหรือผ่านบุคคลที่สาม เพิ่มความปลอดภัยขั้นสูงสุดให้กับสมาชิก ป้องกันปัญหาเว็บโดนบล็อกหรือการทุจริต",
    tag: "ปลอดภัยสูงสุด",
  },
  {
    icon: "💯",
    name: "รับเงินเข้าเต็ม 100%",
    detail: "รับประกันยอดเงินเข้าเต็ม 100% ไม่มีหักค่าธรรมเนียม จ่ายไว จ่ายตรง",
    tag: "ไม่หักค่าธรรมเนียม",
  },
  {
    icon: "🪙",
    name: "ไม่มีขั้นต่ำในการฝากเงิน",
    detail: "ฝากเครดิตเข้าระบบได้โดยไม่มีขั้นต่ำ ล็อคอินเข้าสู่ระบบ เติมเงินฝากเครดิต แล้วเริ่มแทงหวยได้ทันที",
    tag: "ไม่มีขั้นต่ำ",
  },
  {
    icon: "💳",
    name: "ทุกธนาคารและ TrueMoney Wallet",
    detail: "รองรับการทำธุรกรรมผ่านทุกธนาคารชั้นนำในประเทศไทย และระบบ TrueMoney Wallet โดยชื่อบัญชีต้องตรงกับชื่อที่ใช้สมัคร",
    tag: "ครบทุกช่องทาง",
  },
  {
    icon: "⚡",
    name: "ระบบออโต้และแอดมิน 24 ชั่วโมง",
    detail: "ดำเนินการด้วยระบบออโต้ที่รวดเร็วทันใจ พร้อมทีมงานแอดมินสแตนด์บายดูแลผ่าน Line Official ตลอด 24 ชั่วโมง",
    tag: "ออโต้",
  },
  {
    icon: "🎯",
    name: "รับแทงทุกเลข ไม่มีปิดกั้น",
    detail: "มีนโยบายรับแทงทุกเลข ไม่มีปิดกั้น หากทำรายการแทงสำเร็จก่อนระบบปิดรับโพย เมื่อถูกรางวัลจะจ่ายเต็มจำนวนตามเรทราคาที่กำหนดไว้ในบิล",
    tag: "ไม่มีเลขอั้น",
  },
];

const chips = ["เว็บหลักเว็บตรง", "ไม่ผ่านเอเย่นต์", "เข้าบัญชีบริษัทโดยตรง", "ไม่ผ่านบัญชีม้า", "รับเข้าเต็ม 100%", "ไม่มีขั้นต่ำ", "ทุกธนาคาร", "TrueMoney Wallet", "ระบบออโต้", "Line 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ LOTTOKA" titleright="ระบบการเงินและความปลอดภัยของ LOTTOKA" label="เข้าสู่ระบบ LOTTOKA และรายการระบบการเงินกับความปลอดภัยที่เว็บหลักประกาศไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c21e22]/35 bg-[#140a0c]/92 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c21e22]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c21e22]/60 bg-gradient-to-br from-[#ff9a9d] via-[#e2353a] to-[#7d1114] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9ea]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bdb4b6]">
            ล็อคอินเข้าเว็บหลักของ LOTTOKA เพื่อเลือกแทงหวยรัฐบาลไทย ลาว ออมสิน ฮานอย และหวยหุ้น ตรวจโพย เติมเงินฝากเครดิต และทำรายการฝาก-ถอนออโต้แบบไม่มีขั้นต่ำได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb4b6]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7d1114]/60 bg-[#0a0608]/95 py-3 pr-4 pl-12 text-[#ded9da] transition-all outline-none placeholder:text-[#bdb4b6]/50 focus:border-[#c21e22] focus:ring-1 focus:ring-[#e2353a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#bdb4b6]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7d1114]/60 bg-[#0a0608]/95 py-3 pr-4 pl-12 text-[#ded9da] transition-all outline-none placeholder:text-[#bdb4b6]/50 focus:border-[#c21e22] focus:ring-1 focus:ring-[#e2353a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bdb4b6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7d1114] bg-[#0a0608] accent-[#c21e22]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bdb4b6] transition-colors hover:text-[#ffe9ea]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c21e22]/70 bg-gradient-to-r from-[#ff9a9d] via-[#e2353a] to-[#c21e22] p-3.5 text-center font-black text-[#0a0608] shadow-[0_10px_30px_rgba(194,30,34,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(194,30,34,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#bdb4b6]/60">
          <span aria-hidden="true" class="h-px flex-1 bg-[#7d1114]/70"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#7d1114]/70"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7d1114]/70 bg-[#0a0608] px-2.5 py-1 text-[10px] font-bold text-[#bdb4b6]"><span aria-hidden="true">🎫</span> ครบทุกแนวหวย</span>
            <span class="rounded-full border border-[#c21e22]/45 bg-[#0a0608]/80 px-2.5 py-1 text-[10px] font-bold text-[#ff9a9d]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff9a9d] transition-colors hover:text-[#ffe9ea]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c21e22]/35 bg-[#140a0c]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bdb4b6]">เว็บแทงหวยออนไลน์แพลตฟอร์มหลักเว็บตรง ที่ไม่ผ่านเอเย่นต์</span>
          <div class="bg-gradient-to-r from-[#ff9a9d] via-[#ffe9ea] to-[#e2353a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ยอดเข้าบัญชีบริษัทโดยตรง รับเต็ม 100%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#7d1114]/70 bg-[#1c0d0f]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e2353a] shadow-[0_0_8px_rgba(226,53,58,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ff9a9d] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#bdb4b6]/70 uppercase">
        <span>ระบบการเงินและความปลอดภัยที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7d1114]/60 bg-[#0a0608]/95 px-3.5 py-2.5 transition-colors hover:border-[#c21e22]/60 hover:bg-[#1c0d0f]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ded9da]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c21e22]/40 bg-[#0a0608] px-2.5 py-0.5 text-[10px] font-bold text-[#ff9a9d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bdb4b6]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#7d1114]/70 bg-[#0a0608] px-3 py-1 text-[10px] font-bold text-[#bdb4b6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#bdb4b6]/70">
        รายการข้างต้นสรุปสิ่งที่ LOTTOKA ประกาศไว้ ทั้งการเป็นแพลตฟอร์มหลักเว็บตรงที่ไม่ผ่านเอเย่นต์ ระบบการเงินที่โอนเข้าบัญชีของบริษัทโดยตรงโดยไม่ผ่านบัญชีม้า และการรับเงินเข้าเต็ม 100%
        โดยไม่หักค่าธรรมเนียม ส่วนเวลาเปิด-ปิดรับแทงและเงื่อนไขของหวยแต่ละรอบ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
