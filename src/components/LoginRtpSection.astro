---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// FAH999 เป็นเว็บสล็อตที่รับสมัครยูสใหม่แบบไม่ล็อคยูส รายการฝั่งขวาจึงเป็นข้อเท็จจริง
// ที่ brief ระบุไว้เองล้วนๆ — ระบบที่ใช้งานง่ายและไม่ล็อคยูส, สิทธิ์โบนัสฝากแรกตาม
// เงื่อนไขที่กำหนด, รองรับทั้งมือถือและคอมพิวเตอร์, เกมจากหลายค่ายให้เลือก, ระบบ
// บัญชีที่จัดการได้สะดวก, สิทธิพิเศษสำหรับทั้งยูสใหม่และยูสเดิม, ระบบจัดหมวดเกม
// ชัดเจนและตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว, ตัวเลือกการเดิมพันที่
// หลากหลายตามแต่ละเกม, โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่ตรวจสอบ
// รายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น, ช่องทางธนาคารและวอลเลทตามรายการที่
// เปิดให้ใช้งาน และแอดมินที่ให้บริการตลอด 24 ชั่วโมง
// ไม่มีการคิดตัวเลข ค่ายเกม หรือเงื่อนไขขึ้นมาเอง
const menus = [
  {
    icon: "🆕",
    name: "สมัครยูสใหม่ ไม่ล็อคยูส",
    detail: "เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย โดยเน้นการใช้งานแบบไม่มีล็อคยูสตามที่เว็บไซต์ระบุไว้",
    tag: "ยูสใหม่",
  },
  {
    icon: "🎁",
    name: "สิทธิ์โบนัสฝากแรก",
    detail: "ยูสใหม่มีสิทธิ์รับโบนัสฝากแรกตามเงื่อนไขที่กำหนด ตรวจสอบรายละเอียดของโบนัสและยอดที่เข้าเกณฑ์ได้จากหน้าโปรโมชั่น",
    tag: "ฝากแรก",
  },
  {
    icon: "🎰",
    name: "เกมจากหลายค่ายให้เลือก",
    detail: "เลือกเกมจากหลายค่ายได้ตามรายการที่รองรับ พร้อมตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่นได้จากหน้าเดียว",
    tag: "หลายค่าย",
  },
  {
    icon: "🗂️",
    name: "ระบบจัดหมวดเกมชัดเจน",
    detail: "ระบบจัดหมวดเกมไว้ชัดเจน ช่วยให้ค้นหาเกมที่ต้องการได้ง่ายโดยไม่ต้องไล่หาทีละรายการ",
    tag: "แยกหมวด",
  },
  {
    icon: "🎚️",
    name: "ตัวเลือกการเดิมพันหลากหลาย",
    detail: "แต่ละเกมมีตัวเลือกการเดิมพันที่หลากหลายตามที่เกมนั้นรองรับ เลือกรูปแบบที่เหมาะกับตัวเองได้ก่อนเข้าเล่น",
    tag: "ไม่อั้น",
  },
  {
    icon: "📱",
    name: "ใช้งานได้ทั้งมือถือและคอมพิวเตอร์",
    detail: "รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมระบบบัญชีที่จัดการได้สะดวกจากอุปกรณ์ที่ใช้งานอยู่",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "💰",
    name: "โบนัสคืนยอดเสีย 0.3%",
    detail: "รับโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่กำหนด ระบบแสดงรอบคำนวณและยอดที่เข้าเกณฑ์ให้ตรวจสอบก่อนรับสิทธิ์",
    tag: "0.3%",
  },
  {
    icon: "🤝",
    name: "โบนัสแนะนำเพื่อน 0.8%",
    detail: "ชวนคนรู้จักสมัครผ่านช่องทางที่ระบบรองรับ รับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม ตรวจสอบยอดสิทธิ์ได้จากบัญชีสมาชิก",
    tag: "0.8%",
  },
  {
    icon: "🏦",
    name: "รองรับธนาคารและวอลเลท",
    detail: "รองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง",
    tag: "ฝากถอนไม่จำกัด",
  },
  {
    icon: "🕐",
    name: "แอดมินให้บริการ 24 ชั่วโมง",
    detail: "ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน",
    tag: "24 ชม.",
  },
];

const chips = ["สล็อต", "ยูสใหม่", "ไม่ล็อคยูส", "โบนัสฝากแรก", "หลายค่าย", "จัดหมวดเกมชัดเจน", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%", "ธนาคารและวอลเลท", "ฝากถอนไม่จำกัด", "มือถือและคอมพิวเตอร์", "แอดมิน 24 ชั่วโมง"];

// FAH999 palette: both panels sit on the raised panel (#1c160e) over the page
// black, with the login plate framed in primary gold (#e8c25a) and the service
// list framed in deep bronze (#a3732c) — one hue, separated by brightness, which
// is how the logo's gold-on-black artwork reads. The LINE button keeps the
// platform's own green.
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ FAH999"
  titleright="จุดเด่นของ FAH999 ที่เว็บระบุไว้"
  label="เข้าสู่ระบบ FAH999 และรายการจุดเด่นเรื่องยูสใหม่ไม่ล็อคยูส โบนัสฝากแรก โปรโมชั่น และช่องทางธนาคารกับวอลเลทที่เว็บระบุไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e8c25a]/40 bg-[#1c160e]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e8c25a]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8c25a]/70 bg-gradient-to-br from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f7e7a8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e7dcc4]/70">
            ล็อคอินเข้า FAH999 เพื่อเลือกเกมจากหลายค่ายแบบไม่ล็อคยูส ตรวจสอบสิทธิ์โบนัสฝากแรกกับโปรโมชั่น และดูยอดกับสถานะฝากถอนของบัญชีตัวเองได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e7dcc4]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b4a18] bg-[#0a0907]/95 py-3 pr-4 pl-12 text-[#e7dcc4] transition-all outline-none placeholder:text-[#e7dcc4]/50 focus:border-[#e8c25a] focus:ring-1 focus:ring-[#f7e7a8]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e7dcc4]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b4a18] bg-[#0a0907]/95 py-3 pr-4 pl-12 text-[#e7dcc4] transition-all outline-none placeholder:text-[#e7dcc4]/50 focus:border-[#e8c25a] focus:ring-1 focus:ring-[#f7e7a8]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e7dcc4]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b4a18] bg-[#0a0907] accent-[#e8c25a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e7dcc4]/80 transition-colors hover:text-[#f7e7a8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f7e7a8]/70 bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] p-3.5 text-center font-black text-[#140f06] shadow-[0_10px_30px_rgba(232,194,90,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(247,231,168,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e7dcc4]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b4a18]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b4a18]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b4a18] bg-[#0a0907] px-2.5 py-1 text-[10px] font-bold text-[#e7dcc4]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#e8c25a]/50 bg-[#0a0907]/85 px-2.5 py-1 text-[10px] font-bold text-[#f7e7a8]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f7e7a8] transition-colors hover:text-[#e8c25a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a3732c]/55 bg-[#1c160e]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e7dcc4]/70">สมัครสล็อตยูสใหม่ ไม่ล็อคยูส</span>
          <div class="bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">โบนัสฝากแรก ฝากถอนไม่จำกัด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#6b4a18] bg-[#0a0907]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8c25a] shadow-[0_0_8px_rgba(232,194,90,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f7e7a8] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e7dcc4]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b4a18] bg-[#12100b]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8c25a]/70 hover:bg-[#1c160e]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e7dcc4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f7e7a8]/45 bg-[#0a0907] px-2.5 py-0.5 text-[10px] font-bold text-[#f7e7a8]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e7dcc4]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b4a18] bg-[#0a0907] px-3 py-1 text-[10px] font-bold text-[#e7dcc4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e7dcc4]/70">
        รายการข้างต้นสรุปสิ่งที่ FAH999 ระบุไว้ ทั้งการสมัครยูสใหม่แบบไม่ล็อคยูสที่เลือกเกมจากหลายค่ายได้ ช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน
        และโปรโมชั่นที่เปิดให้ตรวจสอบรายละเอียดก่อนกดรับ ส่วนรอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และเงื่อนไขของแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
