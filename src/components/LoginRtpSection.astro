---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// OSAKA198 is a SLOT brand, so every row below describes เกมสล็อตหลายค่าย /
// ช่วงเดิมพันของแต่ละเกม / โปรโมชั่น / สมัคร 3 ขั้นตอน / ฝากถอน — never บาคาร่า,
// โต๊ะไลฟ์สด, แทงบอล or หวย. Each one stays inside what the brief states:
// เกมสล็อตจากหลายค่ายในบัญชีเดียว ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อต
// หลายรูปแบบ, การรองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์โดยไม่ต้องสมัครแยกหลายบัญชี,
// การตรวจช่วงเดิมพันของเกมก่อนเริ่มเล่นเพราะขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการและแต่ละเกม,
// การยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการสำหรับเงื่อนไขไม่จำกัดยอด, การ Login เพื่อดู
// โปรโมชั่นที่เปิดให้รับผ่านบัญชีของตนเอง, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
// พร้อมยอดที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอน, การสมัคร 3 ขั้นตอน, การตรวจเครดิต
// โปรโมชั่น ประวัติรายการ และสถานะฝากถอนจากบัญชีสมาชิก, และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed win — the brief states none of them.
const menus = [
  {
    icon: "🎰",
    name: "เลือกค่ายและเกมสล็อตจากบัญชีเดียว",
    detail: "เกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อตหลายรูปแบบ เลือกได้จากค่ายที่ระบบเปิดให้บริการโดยไม่ต้องสมัครแยกหลายบัญชี",
    tag: "ทุกค่ายในเว็บเดียว",
  },
  { icon: "📱", name: "เล่นผ่านมือถือ แท็บเล็ต และคอม", detail: "รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดียวเข้าเล่นได้จากทุกอุปกรณ์", tag: "ทุกอุปกรณ์" },
  {
    icon: "🪙",
    name: "ตรวจช่วงเดิมพันของเกมก่อนเริ่มเล่น",
    detail: "หากต้องการเล่นสล็อตเริ่มต้น 1 บาท ควรตรวจช่วงเดิมพันของเกมนั้นก่อน เพราะขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการและแต่ละเกม",
    tag: "ดูก่อนหมุน",
  },
  { icon: "🎚️", name: "ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการ", detail: "เงื่อนไข “ไม่จำกัดยอด” หรือ “ไม่อั้น” ให้ยึดวงเงินที่ระบบแสดงในขณะทำรายการนั้นเป็นหลัก", tag: "เช็กวงเงิน" },
  { icon: "🎁", name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ", detail: "สมาชิกตรวจโปรโมชั่นที่เปิดให้รับผ่านบัญชีของตนเองได้ แต่ละรายการอาจกำหนดยอดที่ใช้คำนวณและรอบรับต่างกัน", tag: "ดูจากบัญชี" },
  { icon: "👥", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "แชร์ลิงก์แนะนำส่วนตัวให้เพื่อน เมื่อเพื่อนสมัครและมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัส 0.8% ตามเงื่อนไข", tag: "0.8%" },
  { icon: "💠", name: "โบนัสคืนยอดเสีย 0.3%", detail: "ตรวจสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ก่อนกดรับควรดูประเภทเกม รอบเวลา และเงื่อนไขให้ครบถ้วน", tag: "0.3%" },
  {
    icon: "🏦",
    name: "สมัคร 3 ขั้นตอนแล้วจัดการจากบัญชี",
    detail: "สมัครผ่านมือถือหรือคอมพิวเตอร์ด้วย 3 ขั้นตอน จากนั้นตรวจเครดิต โปรโมชั่น ประวัติรายการ และสถานะฝากถอนได้จากบัญชีของตนเอง",
    tag: "3 ขั้นตอน",
  },
];

const chips = ["สล็อตหลายค่าย", "เกมยอดนิยม", "เกมใหม่", "เกมโบนัส", "ฟรีสปิน", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ OSAKA198" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อตกับ OSAKA198" label="เข้าสู่ระบบ OSAKA198 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a37c4b]/40 bg-[#1c1509]/92 p-6 shadow-[0_10px_30px_rgba(163,124,75,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d1ae72]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c7b895]/60 bg-gradient-to-br from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f7f1e4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e4cc95]">
            เข้าสู่ระบบ OSAKA198 เพื่อเลือกค่ายและเกมสล็อต ตรวจช่วงเดิมพันของแต่ละเกม ดูโปรโมชั่นที่เปิดให้รับ ฝากถอน และติดตามประวัติรายการได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a8a68]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a37c4b]/45 bg-[#0b0906]/95 py-3 pr-4 pl-12 text-[#e8ddc8] transition-all outline-none placeholder:text-[#9a8a68] focus:border-[#d1ae72] focus:ring-1 focus:ring-[#d1ae72]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a8a68]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#a37c4b]/45 bg-[#0b0906]/95 py-3 pr-4 pl-12 text-[#e8ddc8] transition-all outline-none placeholder:text-[#9a8a68] focus:border-[#d1ae72] focus:ring-1 focus:ring-[#d1ae72]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8ddc8]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a37c4b]/45 bg-[#0b0906] accent-[#a37c4b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8ddc8] transition-colors hover:text-[#f7f1e4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#a37c4b]/55 bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] p-3.5 text-center font-black text-[#0b0906] shadow-[0_10px_30px_rgba(209,174,114,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(209,174,114,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9a8a68]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#a37c4b]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#a37c4b]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c7b895]/45 bg-[#0b0906] px-2.5 py-1 text-[10px] font-bold text-[#c7b895]"><span aria-hidden="true">🎰</span> สล็อตหลายค่าย</span>
            <span class="rounded-full border border-[#a37c4b]/40 bg-[#0b0906]/80 px-2.5 py-1 text-[10px] font-bold text-[#e4cc95]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e4cc95] transition-colors hover:text-[#f7f1e4]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a37c4b]/40 bg-[#1c1509]/92 p-5 shadow-[0_10px_30px_rgba(163,124,75,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8ddc8]">
            เลือกเกมสล็อตจากหลายค่ายผ่านบัญชีเดียว ตรวจช่วงเดิมพันของเกมนั้นก่อนเริ่มเล่นทุกครั้ง และยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก
          </span>
          <div class="bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เล่นได้ทุกค่าย ในเว็บเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#c7b895]/55 bg-[#141210]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e4cc95] shadow-[0_0_8px_rgba(228,204,149,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#c7b895] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9a8a68] uppercase">
        <span>ขั้นตอนเข้าเล่น โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#a37c4b]/60 bg-[#0b0906]/95 px-3.5 py-2.5 transition-colors hover:border-[#c7b895]/60 hover:bg-[#141210]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8ddc8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c7b895]/45 bg-[#0b0906] px-2.5 py-0.5 text-[10px] font-bold text-[#c7b895]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e4cc95]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a37c4b]/35 bg-[#0b0906] px-3 py-1 text-[10px] font-bold text-[#e4cc95]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9a8a68]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น แต่ละค่ายและแต่ละเกมอาจกำหนดช่วงเดิมพันและเงื่อนไขไม่เท่ากัน ให้ยึดรายละเอียดที่แสดงในเกม ณ เวลาเล่นเป็นหลัก ส่วนยอดที่ใช้คำนวณ รอบรับ
        และเงื่อนไขการถอนของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
