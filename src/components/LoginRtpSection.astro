---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// FAH999 is a slot/casino brand and the brief is about the game line-up, so every
// row below stays inside what the docx states: จุดรวมเกมสล็อตออนไลน์ที่เล่นผ่าน
// มือถือและคอมพิวเตอร์, สล็อตธีมเอเชีย เกมโบนัส, สามเกมของ PG SOFT (Mahjong Ways 2,
// Fortune Tiger, Lucky Neko) พร้อมฟีเจอร์ตามที่ระบุ, ระบบฝากถอนและการจัดการบัญชี
// ออนไลน์, โบนัส 0.8% ตามเงื่อนไขของกิจกรรม และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No payout claim, no RTP figure and no lottery product appears anywhere here.
const menus = [
  { icon: "🎰", name: "สล็อตออนไลน์", detail: "รวมเกมสล็อตหลากหลายรูปแบบ ทั้งธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือ", tag: "เล่นได้ทุกวัน" },
  { icon: "🀄", name: "Mahjong Ways 2", detail: "สล็อตธีมไพ่นกกระจอกของ PG SOFT ใช้รูปแบบ 5 รีล พร้อมฟีเจอร์ Wild และ Free Spins", tag: "ฟรีสปิน + ตัวคูณ" },
  { icon: "🐯", name: "Fortune Tiger", detail: "ธีมเสือทองและสัญลักษณ์มงคล รูปแบบ 3 รีล 3 แถว มีฟีเจอร์ Respin และตัวคูณ x10 ตามเงื่อนไขของเกม", tag: "3 รีล เข้าใจง่าย" },
  { icon: "🐱", name: "Lucky Neko", detail: "สล็อตธีมญี่ปุ่นแมวกวักนำโชค มีระบบ Free Spins และตัวคูณภายในเกม ตรวจรายละเอียด RTP ได้ก่อนเลือกเดิมพัน", tag: "ธีมมงคลญี่ปุ่น" },
  { icon: "💳", name: "ฝากถอนและจัดการบัญชี", detail: "ระบบรองรับการฝากถอนและการจัดการบัญชีออนไลน์ ตรวจสอบสถานะรายการในบัญชีได้ด้วยตนเอง", tag: "ออนไลน์" },
  { icon: "🎁", name: "โบนัส 0.8%", detail: "โปรโมชั่นหลักตามข้อมูลที่กำหนดคือโบนัส 0.8% สิทธิ์ในการรับเป็นไปตามยอดและเงื่อนไขของกิจกรรม", tag: "รับได้ทุกวัน" },
  { icon: "📱", name: "เล่นผ่านมือถือและคอม", detail: "เลือกเล่นเกมหลากหลายรูปแบบผ่านมือถือและคอมพิวเตอร์ได้จากบัญชีเดียวกัน", tag: "ทุกอุปกรณ์" },
  { icon: "🎧", name: "แอดมินดูแล 24 ชั่วโมง", detail: "ติดต่อแอดมินเพื่อขอคำแนะนำและตรวจสอบรายการได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม." },
];

const chips = ["สล็อตออนไลน์", "PG SOFT", "Mahjong Ways 2", "Fortune Tiger", "Lucky Neko", "โบนัส 0.8%", "ฝากถอนออนไลน์", "แอดมิน 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ FAH999"
  titleright="เกมและบริการที่เลือกเล่นได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ FAH999 และรายการเกมสล็อตที่เลือกเล่นได้ทั้งบนมือถือและคอมพิวเตอร์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b1fa8]/75 bg-[#180226]/92 p-6 shadow-[0_10px_30px_rgba(194,36,155,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c2249b]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c2249b]/60 bg-gradient-to-br from-[#ffb3e2] via-[#fb44b3] to-[#6b1fa8] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdeaf8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#b48fd0]">เข้าสู่ระบบ FAH999 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b48fd0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b1fa8] bg-[#0d0114]/95 py-3 pr-4 pl-12 text-[#e6cfe9] transition-all outline-none placeholder:text-[#b48fd0] focus:border-[#fb44b3] focus:ring-1 focus:ring-[#fb44b3]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#b48fd0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b1fa8] bg-[#0d0114]/95 py-3 pr-4 pl-12 text-[#e6cfe9] transition-all outline-none placeholder:text-[#b48fd0] focus:border-[#fb44b3] focus:ring-1 focus:ring-[#fb44b3]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e6cfe9]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b1fa8] bg-[#0d0114] accent-[#fb44b3]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e6cfe9] transition-colors hover:text-[#fb44b3]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c2249b]/55 bg-gradient-to-r from-[#ffb3e2] via-[#fb44b3] to-[#c2249b] p-3.5 text-center font-black text-[#0d0114] shadow-[0_10px_30px_rgba(194,36,155,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(251,68,179,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#b48fd0]">
          <span class="h-px flex-1 bg-[#6b1fa8]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b1fa8]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b1fa8]/80 bg-[#0d0114] px-2.5 py-1 text-[10px] font-bold text-[#fdeaf8]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#c2249b]/40 bg-[#0d0114]/80 px-2.5 py-1 text-[10px] font-bold text-[#e6cfe9]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdeaf8] transition-colors hover:text-[#fb44b3]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c2249b]/40 bg-[#180226]/92 p-5 shadow-[0_10px_30px_rgba(194,36,155,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e6cfe9]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#fdeaf8] via-[#fb44b3] to-[#c2249b] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#b48fd0] uppercase">
        <span>เกมและบริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b1fa8] bg-[#0d0114]/95 px-3.5 py-2.5 transition-colors hover:border-[#fb44b3]/60 hover:bg-[#2a0640]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e6cfe9]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6b1fa8]/80 bg-[#0d0114] px-2.5 py-0.5 text-[10px] font-bold text-[#fdeaf8]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#b48fd0]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c2249b]/35 bg-[#0d0114] px-3 py-1 text-[10px] font-bold text-[#fdeaf8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#b48fd0]">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </div>
    </div>
  </div>
</ContentBoxTwo>
