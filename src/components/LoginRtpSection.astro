---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน (PUNPRO168)
// เป็น **เว็บเล่นสล็อตออนไลน์ล้วน** ("สล็อตปันโปรในตำนาน") ส่วนรอบนี้เป็น
// **คาสิโนออนไลน์รวมทุกหมวด** (แบรนด์คาสิโนเซิร์ฟไทย) ที่รวมบาคาร่า สล็อต รูเล็ต
// ไฮโล และแทงบอล ไว้ในแพลตฟอร์มเดียว พร้อมหมวดคาสิโนไลฟ์สดจากโต๊ะจริง โปรโมชั่น
// สองรายการ (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%) การสมัคร 3 ขั้นตอน และแอดมิน
// 24 ชั่วโมง แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม —
// บรีฟรอบนี้ **ไม่มี** คำว่า สล็อตปันโปรในตำนาน เว็บเล่นสล็อตออนไลน์ ทางเข้าเล่นใหม่
// 2026 สล็อตคลาสสิก เกมวงล้อแบบดั้งเดิม สล็อตภาพสมัยใหม่ เว็บตรงในตำนาน
// เว็บคนนิยมเล่นมายาวนาน หรือ ฝากถอนเข้า บช. บริษัทตรง เลยสักบรรทัด
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// แบรนด์คาสิโนเซิร์ฟไทย · เข้าเล่นเดิมพันได้ทุกค่าย · บาคาร่า · สล็อต · รูเล็ต ·
// ไฮโล · แทงบอล · คาสิโนไลฟ์สด · เกมถ่ายทอดสดจากโต๊ะจริง · โต๊ะจริง ·
// แพลตฟอร์มเดียว · รองรับมือถือและคอมพิวเตอร์ · Login · ค้นหาเกม · ตรวจสอบเครดิต ·
// เกมไพ่ · ฟรีสปิน · ฟีเจอร์ตัวคูณ · เกมวงล้อทั่วไป · ทายผล · ข้อมูลคู่แข่งขัน ·
// อัตราต่อรอง · ตารางจ่าย · ยอดเดิมพัน · มีโบนัสทุกเกม · รอบโบนัส ·
// โบนัสคืนยอดเสีย 0.3% · เข้ายูสทุกวัน · รอบประจำวัน · เวลาตัดยอด ·
// เกมที่ร่วมรายการ · ยอดที่เข้าเกณฑ์ · แนะนำเพื่อน · โบนัส 0.8% · ไม่จำกัด ·
// ลิงก์แนะนำ · สมัครสมาชิก 3 ขั้นตอน · ยืนยันบัญชี · ตารางเปิดโต๊ะ · รอบถ่ายทอดสด ·
// แอดมิน 24 ชั่วโมง · ช่องทางหลัก · หมายเลขรายการ · PIN · OTP · โดเมนหลัก ·
// ข้อมูลผู้ดำเนินงาน
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §6 (สล็อตปันโปรในตำนาน · เว็บเล่นสล็อตออนไลน์ ·
// ทางเข้าเล่นใหม่ 2026 · สล็อตคลาสสิก · เกมวงล้อแบบดั้งเดิม · สล็อตภาพสมัยใหม่ ·
// เว็บตรงในตำนาน · เว็บคนนิยมเล่นมายาวนาน · ฝากถอนเข้า บช. บริษัทตรง ·
// เว็บไซต์เลียนแบบ · ปันโปร · แตกง่ายทุกเกม · ส่งตรงจากเมกา · ฐานเกมหลัก 100% ·
// เครือหลัก · ไม่ผ่านเอเย่นต์ · เดิมพันเริ่มต้น 1 บาท · ทุนน้อยกำไรงาม ·
// ดับเบิ้ลโบนัส · การันตีเว็บแท้ · จ่ายไว · ค่ายตรง · ส่งตรงจากเว็บแม่ ·
// เว็บตรงฐานสล็อตหลัก · รีวิวถอนจริง · ถูกลิขสิทธิ์ · ไฮคลาส · VIP ·
// คลับคนเล่นสล็อต · เว็บดังของแท้ในตำนาน · เบทต่ำ · ทุนน้อย · ไม่บิทยูส ·
// ไม่ผ่าน บช. ม้า · จ่ายตรง · ฐานเกมแท้ · เว็บเป็ด · สล็อตพีจี · เว็บสล็อตนาซ่า)
// — ไม่เหลือแม้คำเดียว และรอบนี้ไม่มีคำว่า หวย โพย เลขเด็ด งวด แนวทาง หรือ ตรวจหวย
// ที่ไหนบนเว็บเลย (/ตรวจหวย กับ /แนวทาง ยังจอดอยู่ใน src/pages-disabled/ ตาม §7)
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้เอ่ยถึงค่า RTP เลยแม้แต่คำเดียว §6 จึงห้ามอ้างตัวเลข RTP ที่นี่
// แผงขวาเป็น "หมวดเกมและโปรโมชั่นที่รวบรวมไว้" ไม่ใช่ตารางค่าของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ใบอนุญาต · หน่วยงานกำกับ · ชื่อค่ายเกม ·
// ชื่อผู้ดำเนินงาน · ชื่อธนาคาร · ค่า RTP · ยอดฝากถอนขั้นต่ำเป็นตัวเลข ·
// จำนวนสมาชิก · ปีก่อตั้ง · ที่ตั้งเซิร์ฟเวอร์ (บรีฟสั่งให้ "ตรวจสอบ" ไม่ใช่ให้
// ประกาศ จึงคงคำกำกับไว้ ไม่ใช่คำอ้าง) — บรีฟไม่ได้ให้ไว้สักอย่าง
// ตัวเลขที่ใช้ได้มีสี่ตัว: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง (ไม่มี "2026"
// รอบนี้ บรีฟไม่ได้เขียนปีไว้)
