---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// UWIN33 เป็นแบรนด์รวมเกมเดิมพันหลายประเภท ไม่ใช่เว็บหวยล้วน แผงฝั่งขวาจึงเป็นสอง
// กลุ่มที่บรีฟระบุไว้จริงเท่านั้น คือ หมวดเกมทั้งหกที่บรีฟเอ่ยชื่อ (บาคาร่า รูเล็ต
// ไฮโล สล็อต บอล หวย) และสิ่งที่บรีฟบอกว่าผู้ใช้งานทำได้ (เลือกดูเกมตามประเภท
// ตรวจสอบรายละเอียด สลับไปยังหมวดที่สนใจ)
//
// ไม่มีแถวไหนระบุชื่อค่ายเกม ชื่อเกม ค่า RTP ความผันผวน ขั้นต่ำการเดิมพัน ช่องทาง
// ฝากถอน หรือตัวเลขอัตราจ่ายใดๆ เพราะบรีฟไม่ได้ให้ไว้เลย — ตัวเลขสองตัวเดียวที่
// บรีฟให้คือโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งอยู่ในหัวข้อ H3 ของหน้า
// แล้ว การเติมตัวเลขหรือชื่อค่ายลงตารางนี้คือการแต่งข้อมูลขึ้นมา
const categories = [
  {
    icon: "🃏",
    name: "บาคาร่า",
    detail: "อยู่ในหมวดที่ระบบจัดไว้ เลือกดูตามประเภทและตรวจสอบรายละเอียดก่อนเข้าเล่นได้",
    tag: "เลือกจากเมนูหมวดหมู่",
  },
  {
    icon: "🎡",
    name: "รูเล็ต",
    detail: "เปิดให้เลือกจากหน้ารวมเกม อยู่ในบัญชีเดียวกับหมวดอื่นที่เว็บไซต์เปิดให้บริการ",
    tag: "อยู่ในบัญชีเดียว",
  },
  {
    icon: "🎲",
    name: "ไฮโล",
    detail: "จัดอยู่ในเมนูที่แบ่งหมวดชัดเจน สลับไปยังหมวดที่สนใจได้จากหน้าเดียว",
    tag: "สลับหมวดได้ง่าย",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "รวมอยู่ในระบบเดียวกับหมวดอื่น ตรวจสอบรายละเอียดที่เกี่ยวข้องได้ก่อนเข้าใช้งาน",
    tag: "ตรวจรายละเอียดก่อนเล่น",
  },
  {
    icon: "⚽",
    name: "บอล",
    detail: "อยู่ในเมนูหมวดหมู่เดียวกับเกมอื่น เลือกรายการที่ต้องการได้จากหน้ารวมเกม",
    tag: "เมนูแบ่งหมวดชัดเจน",
  },
  {
    icon: "🎫",
    name: "หวย",
    detail: "เป็นหนึ่งในหมวดที่รวมไว้ในระบบเดียว เข้าถึงได้จากบัญชีสมาชิกเดียวกัน",
    tag: "รวมไว้ในเว็บเดียว",
  },
];

const checks = [
  {
    icon: "🗂️",
    name: "เลือกดูเกมตามประเภท",
    detail: "เมนูแบ่งหมวดไว้ชัดเจน จึงเปิดดูเฉพาะหมวดที่สนใจได้โดยไม่ต้องไล่ทั้งหน้า",
    tag: "ดูจากหน้ารวมเกม",
  },
  {
    icon: "🧾",
    name: "ตรวจสอบรายละเอียด",
    detail: "เปิดดูรายละเอียดของแต่ละรายการได้ก่อนกดเข้าเล่น ตามข้อมูลที่เว็บไซต์ระบุไว้",
    tag: "ดูก่อนกดเข้าเล่น",
  },
  {
    icon: "🔁",
    name: "สลับไปยังหมวดที่สนใจ",
    detail: "ย้ายระหว่างหมวดได้จากบัญชีเดียว ไม่ต้องสลับใช้งานหลายเว็บไซต์",
    tag: "จากบัญชีเดียว",
  },
];

const chips = ["บาคาร่า", "รูเล็ต", "ไฮโล", "สล็อต", "บอล", "หวย", "เมนูแบ่งหมวดชัดเจน", "รองรับมือถือและคอมพิวเตอร์", "จัดการบัญชีจากที่เดียว", "LINE OFFICIAL 24 ชั่วโมง"];

// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): ทั้งสองแผงวางบนผิวการ์ด #161106 เหนือ
// พื้นเพจเกือบดำ #080602 แผงล็อกอินอยู่ในกรอบทองแบรนด์ #e0b429 ส่วนแผงหมวดเกมอยู่ใน
// กรอบทองลึก #7a5407 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจ
// ในเส้นผิวการ์ดยก #26200e ตัวเน้นที่เป็นชื่อหมวดรับไล่เฉดตามลำดับสีในโลโก้ ที่ตัว U
// เป็นทอง WIN เป็นเงินโครเมียม และ 33 กลับมาเป็นทอง ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// (#fbd564 → #e0b429 → #7a5407) บนตัวอักษรสีพื้นเพจ #080602 ตามกฎคอนทราสต์ที่ว่า
// ตัวอักษรบนพื้นทองต้องเกือบดำ ปุ่ม LINE ยังคงสีเขียว #00B900 ของแพลตฟอร์ม — ชุด
// แดง-ดำ-เงินโครเมียมของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #16090a
// #26100f #080506 #e8e3e1 #fff6f5) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมที่ ${BRAND_NAME} รวมไว้ในเว็บเดียว`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} พร้อมรายการหมวดเกมที่รวมไว้ในเว็บเดียว ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย พร้อมสิ่งที่ผู้ใช้งานตรวจสอบและสลับหมวดได้จากบัญชีเดียว`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e0b429]/45 bg-[#161106]/94 p-6 shadow-[0_10px_30px_rgba(8,6,2,0.8)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e0b429]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e0b429]/70 bg-gradient-to-br from-[#fbd564] via-[#e0b429] to-[#7a5407] text-xl shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff8e6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ece6d8]/75">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกบาคาร่า รูเล็ต ไฮโล สล็อต บอล หรือหวย จากเมนูที่แบ่งหมวดชัดเจน จัดการบัญชีได้จากที่เดียวโดยไม่ต้องสลับใช้งานหลายเว็บไซต์ รองรับทั้งมือถือและคอมพิวเตอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece6d8]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#26200e] bg-[#080602]/95 py-3 pr-4 pl-12 text-[#ece6d8] transition-all outline-none placeholder:text-[#ece6d8]/50 focus:border-[#e0b429] focus:ring-1 focus:ring-[#fbd564]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece6d8]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#26200e] bg-[#080602]/95 py-3 pr-4 pl-12 text-[#ece6d8] transition-all outline-none placeholder:text-[#ece6d8]/50 focus:border-[#e0b429] focus:ring-1 focus:ring-[#fbd564]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ece6d8]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#26200e] bg-[#080602] accent-[#e0b429]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ece6d8]/75 transition-colors hover:text-[#fbd564]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fbd564]/70 bg-gradient-to-r from-[#fbd564] via-[#e0b429] to-[#7a5407] p-3.5 text-center font-black text-[#080602] shadow-[0_10px_30px_rgba(224,180,41,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(251,213,100,0.36)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ece6d8]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#26200e]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#26200e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE OFFICIAL
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#26200e] bg-[#080602] px-2.5 py-1 text-[10px] font-bold text-[#ece6d8]"><span aria-hidden="true">🎴</span> รวมทุกหมวดเกมในระบบเดียว</span>
            <span class="rounded-full border border-[#e0b429]/45 bg-[#080602]/85 px-2.5 py-1 text-[10px] font-bold text-[#dfe4ec]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#dfe4ec] transition-colors hover:text-[#fff8e6]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7a5407]/70 bg-[#161106]/94 p-5 shadow-[0_10px_30px_rgba(8,6,2,0.78)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ece6d8]/75">หมวดเกมที่ระบบจัดไว้ เลือกดูตามประเภทและตรวจสอบรายละเอียดได้ก่อนเข้าเล่นทุกครั้ง</span>
          <div class="bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">บาคาร่า · รูเล็ต · ไฮโล · สล็อต · บอล · หวย</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#26200e] bg-[#080602]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e0b429] shadow-[0_0_8px_rgba(224,180,41,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#dfe4ec] uppercase">รวมครบในเว็บเดียว</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ece6d8]/75 uppercase">
        <span>หมวดเกมตามรายการที่เปิดให้บริการ</span>
        <span>การเข้าถึง</span>
      </div>

      <div class="mb-4 flex flex-col gap-2.5">
        {
          categories.map((c) => (
            <div class="rounded-xl border border-[#e0b429]/35 bg-[#080602]/95 px-3.5 py-2.5 transition-colors hover:border-[#e0b429]/70 hover:bg-[#26200e]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fff8e6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {c.icon}
                  </span>{" "}
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e0b429]/60 bg-gradient-to-r from-[#fbd564] to-[#7a5407] px-2.5 py-0.5 text-[10px] font-black text-[#080602]">{c.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ece6d8]/75">{c.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ece6d8]/75 uppercase">
        <span>สิ่งที่ทำได้จากบัญชีเดียว</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          checks.map((k) => (
            <div class="rounded-xl border border-[#26200e] bg-[#080602]/95 px-3.5 py-2.5 transition-colors hover:border-[#e0b429]/70 hover:bg-[#26200e]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece6d8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7a5407]/70 bg-[#080602] px-2.5 py-0.5 text-[10px] font-bold text-[#dfe4ec]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ece6d8]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#26200e] bg-[#080602] px-3 py-1 text-[10px] font-bold text-[#ece6d8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ece6d8]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยไว้ในเว็บเดียว เมนูที่แบ่งหมวดชัดเจน การรองรับทั้งมือถือและคอมพิวเตอร์ และการเลือกดูเกมตามประเภท ตรวจสอบรายละเอียด
        กับสลับไปยังหมวดที่สนใจจากบัญชี เดียว ส่วนรายการที่เปิดให้บริการในแต่ละช่วงอาจแตกต่างกันตามที่ระบบกำหนด ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมก่อนเข้าใช้งาน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP
        ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
