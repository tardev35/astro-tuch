---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// LOTTOPLUS เป็นเว็บหวยออนไลน์ ไม่ใช่เว็บคาสิโน แผงฝั่งขวาของรอบก่อน (WIN999) เป็น
// "หมวดเกม" บาคาร่า/สล็อต/เกมไพ่ + รายการที่ตรวจได้จากบัญชี ซึ่งไม่มีความหมายใดๆ บน
// เว็บหวย — รอบนี้จึงถูกเขียนใหม่เป็นสองอย่างที่บรีฟพูดถึงจริง คือ (1) ประเภทหวยที่
// บรีฟระบุชื่อไว้เอง ได้แก่ หวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น กับ (2) จุดที่
// สมาชิกต้องตรวจก่อนส่งโพย ได้แก่ รอบหวยและเวลาปิดรับ อัตราจ่ายของรอบนั้น โพย/เลข/
// ยอดเดิมพันหลังส่งรายการ และชื่อบัญชีบริษัทปลายทาง ทั้งหมดเป็นประโยคของบรีฟเอง
// ไม่มีตัวเลขใหม่สักตัว
//
// ห้ามใส่ RTP ค่าความผันผวน ชื่อค่ายเกม ชื่อธนาคาร เลขใบอนุญาต ขั้นต่ำการเดิมพัน หรือ
// ผู้ให้บริการเกมลงในไฟล์นี้ — บรีฟ LOTTOPLUS ไม่ได้ให้ไว้เลยสักอย่าง และคำเหล่านั้น
// เป็นคำศัพท์ของแบรนด์คาสิโนรอบก่อน ไม่ใช่ของแบรนด์นี้ ตัวเลขที่ใช้ได้มีห้าตัวเท่าที่
// บรีฟระบุ คือ 2 ตัว 100 · 3 ตัว 1,000 · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// 24 ชั่วโมง และห้ามแตกเป็นเงื่อนไข/รอบตัดยอดที่บรีฟไม่ได้บอก
const lotteryMarkets = [
  { icon: "🇹🇭", name: "หวยรัฐบาลไทย", detail: "เปิดรับตามรอบออกรางวัลของหวยรัฐบาลไทย เลือกประเภทเลขได้จากหน้าเว็บไซต์" },
  { icon: "🇱🇦", name: "หวยลาวพัฒนา", detail: "อีกรายการที่บรีฟระบุว่าเปิดรับ ส่งโพยจากบัญชีเดียวกันได้เช่นเดียวกัน" },
  { icon: "🇻🇳", name: "หวยฮานอย", detail: "เปิดรับตามรายการที่ระบบแสดงในแต่ละวัน ควรดูชื่อรายการให้ตรงรอบ" },
  { icon: "📈", name: "หวยหุ้น", detail: "มีรอบเดิมพันแตกต่างกันในแต่ละวัน ควรตรวจสอบเวลาปิดรับก่อนส่งโพย" },
];

// สี่ข้อนี้ประกอบจากประโยคของบรีฟเองทั้งหมด — ตรวจเวลาปิดรับก่อนส่งโพย, ยึดตัวเลขที่
// ระบบแสดงก่อนยืนยันโพย, กลับมาตรวจโพย/เลข/ยอดเดิมพัน/สถานะรายการ, และเปรียบเทียบ
// ชื่อบัญชีปลายทางกับข้อมูลที่เว็บไซต์ประกาศก่อนโอน
const beforeSlipChecks = [
  {
    icon: "⏰",
    name: "รอบหวยและเวลาปิดรับ",
    detail: "เลือกประเภทเลขและตรวจสอบเวลาปิดรับก่อนส่งโพยได้จากหน้าเว็บไซต์ หากมีหลายรอบต่อวันควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกัน",
    tag: "ตรวจก่อนส่งโพย",
  },
  {
    icon: "🧮",
    name: "อัตราจ่ายของรอบนั้น",
    detail: "อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก",
    tag: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    icon: "🧾",
    name: "โพย เลขที่เลือก และยอดเดิมพัน",
    detail: "หลังส่งรายการแล้วควรกลับมาตรวจสอบโพย เลขที่เลือก ยอดเดิมพัน และสถานะรายการให้เรียบร้อย ส่วนการตรวจผลควรอ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท",
    tag: "ตรวจหลังส่งโพย",
  },
  {
    icon: "🏦",
    name: "ชื่อบัญชีบริษัทปลายทาง",
    detail: "ก่อนโอนเงินควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลที่เว็บไซต์ประกาศ หากชื่อไม่ตรงหรือมีการแจ้งให้โอนไปยังบัญชีอื่นผิดปกติ ควรหยุดทำรายการและติดต่อช่องทางหลักเพื่อยืนยันก่อน",
    tag: "ไม่ผ่านตัวแทน",
  },
];

const chips = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย", "หวยหุ้น", "ส่งโพยผ่านมือถือ", "บัญชีบริษัท", "คืนยอดเสีย 0.3%", "แนะนำเพื่อน 0.8%"];

// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): โลโก้เป็นตัวอักษรขาวบนบล็อกแดง #dc020e งาน
// อาร์ตเป็นพื้นดำที่มีริ้วแสงแดงลึก ลูกหวยแดง-ขาว เหรียญทองและมงกุฎทอง สองแผงจึงถูก
// แยกด้วยคู่แดง/ทองตามงานอาร์ตจริง ไม่ใช่น้ำหนักของสีเดียว — แผงล็อกอินอยู่ในกรอบแดง
// แบรนด์ ส่วนแผงหวยที่เปิดรับอยู่ในกรอบทองลึก #8a6a0a ทั้งคู่วางบนผิวการ์ด #120b0c
// เหนือพื้นเพจ #050505 ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้นผิวแผงยก #1f0a0c บรรทัด
// เด่นไล่เฉดขาวไฮไลต์ #fff4f4 → ทองอ่อน #fde79a → ทองรอง #f3c623 ปุ่มเข้าสู่ระบบ
// เป็นแดงเต็มตัว (#ff2d38 → #dc020e → #6b0207) บนตัวอักษรขาว ตามกฎคอนทราสต์ที่ว่า
// พื้นแดงต้องใช้ตัวอักษรขาว (5.17:1) ห้ามใช้หมึกเข้ม (3.85:1) ปุ่มไลน์ยังคงสีเขียว
// #00B900 ของแพลตฟอร์มซึ่งห้ามรีแมป — ชุดทอง-ดำของ WIN999 ที่ค้างในไฟล์นี้ (#fcc403
// #fdda04 #8a6502 #4a3402 #fffbea #120d02 #101010 #191712 #e9e4d6) ออกทั้งหมด
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หวยที่เปิดรับ ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎫"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหวยที่เปิดรับทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น และจุดที่ควรตรวจสอบก่อนส่งโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#dc020e]/45 bg-[#120b0c]/94 p-6 shadow-[0_10px_30px_rgba(5,1,2,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#dc020e]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff2d38]/70 bg-gradient-to-br from-[#ff2d38] via-[#dc020e] to-[#6b0207] text-xl text-white shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff4f4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f0e2e2]/75">
            Login เข้าบัญชี {BRAND_NAME} ผ่านเว็บเบราว์เซอร์บนมือถือเพื่อเลือกประเภทหวยที่ต้องการ ตรวจสอบรอบหวย อัตราจ่าย โปรโมชั่น เครดิต และประวัติโพยผ่านบัญชีของตนเองได้โดยไม่ต้องติดตั้งแอปเพิ่มเติม
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f0e2e2]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1f0a0c] bg-[#050505]/95 py-3 pr-4 pl-12 text-[#f0e2e2] transition-all outline-none placeholder:text-[#f0e2e2]/50 focus:border-[#dc020e] focus:ring-1 focus:ring-[#ff2d38]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f0e2e2]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1f0a0c] bg-[#050505]/95 py-3 pr-4 pl-12 text-[#f0e2e2] transition-all outline-none placeholder:text-[#f0e2e2]/50 focus:border-[#dc020e] focus:ring-1 focus:ring-[#ff2d38]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f0e2e2]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1f0a0c] bg-[#050505] accent-[#dc020e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f0e2e2]/75 transition-colors hover:text-[#ff2d38]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ff2d38]/70 bg-gradient-to-r from-[#ff2d38] via-[#dc020e] to-[#6b0207] p-3.5 text-center font-black text-white shadow-[0_10px_30px_rgba(220,2,14,0.45)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,45,56,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f0e2e2]/75">
          <span aria-hidden="true" class="h-px flex-1 bg-[#1f0a0c]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#1f0a0c]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#1f0a0c] bg-[#050505] px-2.5 py-1 text-[10px] font-bold text-[#f0e2e2]"><span aria-hidden="true">🎫</span> หวยออนไลน์</span>
            <span class="rounded-full border border-[#f3c623]/40 bg-[#050505]/85 px-2.5 py-1 text-[10px] font-bold text-[#f3c623]"><span aria-hidden="true">📱</span> ไม่ต้องติดตั้งแอป</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff2d38] transition-colors hover:text-[#f3c623]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a6a0a]/70 bg-[#120b0c]/94 p-5 shadow-[0_10px_30px_rgba(5,1,2,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f0e2e2]/75">
            {BRAND_NAME} รวมหวยหลายประเภทไว้ในบัญชีเดียว สมาชิกเลือกเลข ส่งโพย ตรวจสอบรายการ และตรวจผลหวยได้จากหน้าเว็บไซต์โดยไม่ต้องสลับบัญชี
          </span>
          <div class="bg-gradient-to-r from-[#fff4f4] via-[#fde79a] to-[#f3c623] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">2 ตัว 100 · 3 ตัว 1,000</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#1f0a0c] bg-[#050505]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dc020e] shadow-[0_0_8px_rgba(220,2,14,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f3c623] uppercase">ตามรอบที่เปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f0e2e2]/75 uppercase">
        <span>หวยที่เปิดรับในระบบ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          lotteryMarkets.map((m) => (
            <div class="rounded-xl border border-[#1f0a0c] bg-[#050505]/95 px-3.5 py-2.5 transition-colors hover:border-[#dc020e]/70 hover:bg-[#1f0a0c]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fff4f4]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {m.icon}
                </span>
                <span class="truncate">{m.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f0e2e2]/75">{m.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f0e2e2]/75">
        รายการที่เปิดรับและอัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับในแต่ละวัน จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f0e2e2]/75 uppercase">
        <span>จุดที่ต้องตรวจก่อนส่งโพย</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSlipChecks.map((k) => (
            <div class="rounded-xl border border-[#1f0a0c] bg-[#050505]/95 px-3.5 py-2.5 transition-colors hover:border-[#f3c623]/70 hover:bg-[#1f0a0c]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0e2e2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f3c623]/50 bg-[#050505] px-2.5 py-0.5 text-[10px] font-bold text-[#f3c623]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f0e2e2]/75">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1f0a0c] bg-[#050505] px-3 py-1 text-[10px] font-bold text-[#f0e2e2]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f0e2e2]/75">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ในบัญชีเดียว การสมัครและ Login ผ่านเบราว์เซอร์บนมือถือโดยไม่ต้องติดตั้งแอป การเลือกเลข ส่งโพย ตรวจสอบรายการ และตรวจผลหวยจากหน้าเว็บไซต์
        และการฝากเข้าบัญชีบริษัทโดยตรงไม่ผ่านตัวแทน ซึ่งควรเปรียบเทียบชื่อบัญชีปลายทางกับข้อมูลที่เว็บไซต์ประกาศก่อนโอนทุกครั้ง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
