// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็น
// **บรีฟคนละฉบับ** กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน
// (มีโชค168) ขายคำว่า "ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรงจากสิงคโปร์" พร้อมชื่อ
// ค่ายเกมสามค่าย ส่วนรอบนี้เป็น **เว็บสล็อตฐานหลักถอนง่าย ได้เงินจริง ไม่มีรีวิวเสีย**
// ที่พูดเรื่อง **ความง่ายในการถอนเงิน** เป็นแกนหลัก พร้อมโปรโมชั่นสองรายการ
// (คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน โบนัส 0.8% ไม่จำกัด) ขั้นตอนสมัคร
// สามขั้น และช่องทาง LINE Official
// แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// ⚠️ **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** (brand-spec §6) จึงห้ามเขียน
// ชื่อค่ายใดๆ ลงไป ให้ใช้คำกลางว่า "ค่ายเกม" ตามบรีฟ — PG SOFT / JOKER / JILI ที่
// เพิ่งเต็มไฟล์นี้เป็นของบรีฟรอบก่อน ออกหมดแล้ว เช่นเดียวกับ ลิขสิทธิ์ /
// สถานะลิขสิทธิ์ / นำเข้าตรงจากสิงคโปร์ / ตารางการจ่ายรางวัล / ผู้ให้บริการ
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §6 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// ฐานหลัก · เว็บสล็อตฐานหลัก · ถอนง่าย · ได้เงินจริง · ไม่มีรีวิวเสีย ·
// การันตีเว็บแท้ · ผู้ใช้งานหลักแสนยูสต่อวัน · เกมสล็อตออนไลน์ · สมัครสมาชิก ·
// เข้าสู่ระบบ · ฝากถอน · เงื่อนไขการถอนเงิน · ทำรายการ · สถานะรายการ · หลักฐาน ·
// โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เครดิต · ยอดเสีย · รอบเวลา ·
// รหัสแนะนำ · เชื่อมโยงบัญชี · ค่ายเกม · กติกา · LINE Official · QR Code ·
// บัญชีแอบอ้าง · รหัสผ่าน · รหัส OTP · เจ้าหน้าที่ ·
// นโยบายการจัดเก็บข้อมูลส่วนบุคคล · คุณสมบัติผู้ใช้งาน
//
// ⚠️ ห้ามโผล่แม้คำเดียว (§6): คาสิโน · บาคาร่า · รูเล็ต · ไฮโล · ยิงปลา ·
// บอล/แทงบอล/กีฬา/อัตราต่อรอง · หวย/ตรวจหวย/แนวทาง · เว็บตรง · ไม่ผ่านเอเย่นต์ ·
// แตกง่าย · ไม่มีขั้นต่ำ · บัญชีม้า · ออโต้ 1 วินาที · เลขใบอนุญาต · ชื่อนิติบุคคล ·
// ชื่อธนาคาร · ตัวเลข RTP · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีที่ก่อตั้ง
// ตัวเลขที่อ้างได้มีหกตัวเท่านั้น: 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24 ชม. ·
// หลักแสนยูสต่อวัน
//
// ⚠️ ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้เอ่ยถึงอัตราคืนเงินของเกมเลยแม้แต่คำเดียว §6 จึงห้ามอ้างตัวเลขนั้น
// ที่นี่ และแผงขวาไม่มีตัวเลข RTP อยู่เลยสักค่า มันคือ "เรื่องที่สอบถามเจ้าหน้าที่ได้"
// ไม่ใช่ตารางค่าของเกม
// ⚠️ บรีฟรอบนี้ **hedge หนักผิดปกติ** และ §6 สั่งให้ ship คำกำกับทุกประโยค ไม่ใช่ตัด
// ทิ้งเพราะฟังดูไม่ขายของ — แผงนี้จึงไม่ประกาศ "ถอนได้จริงทุกครั้ง" "ไม่มีรีวิวเสีย"
// หรือ "ผู้ใช้งานหลักแสนยูสต่อวัน" เป็นข้อเท็จจริงของตัวเอง สามวลีนั้นอยู่ในหัวข้อ
