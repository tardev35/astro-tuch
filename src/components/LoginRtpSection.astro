---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — UOK365 เป็นเว็บสล็อต
// เบทต่ำ ส่วน GUCCI168 เป็นเว็บคาสิโนไลฟ์ 24 ชม. ที่รวมบาคาร่า รูเล็ต ไฮโล สล็อต และ
// บอล แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่ไล่แทนคำบนประโยคเดิม
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §4 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// คาสิโนไลฟ์ · คาสิโนออนไลน์ · บาคาร่า · รูเล็ต · ไฮโล · สล็อต · บอล/แทงบอล ·
// โต๊ะสด · หมวดเกม · ไม่มีขั้นต่ำทุกรูปแบบเกม · วงเงิน · Limit · บัญชีเดียว ·
// เครดิต · โปรโมชั่น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// Login · แอดมิน 24 ชั่วโมง · PIN · OTP · ประวัติรายการ · ฝากถอน · คู่แข่งขัน ·
// ตลาดเดิมพัน · ฟรีสปิน · ตัวคูณ · โบนัส · รอบตัดยอด
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §4 (เบทต่ำ · ทุนน้อย · ค่ายตรง · ถูกลิขสิทธิ์ ·
// เกมคลาสสิก · สล็อตเปิดใหม่ · ตารางจ่าย · ไฮคลาส · VIP · ส่งตรงจากเว็บแม่ ·
// ไม่ผ่านบัญชีม้า) และคำหวยทั้งหมด (หวย · โพย · เลขเด็ด · แนวทาง · งวด · อัตราจ่าย ·
// ตรวจหวย) — ไม่เหลือแม้คำเดียว
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้ให้ค่า RTP ของเกมไว้เลย และ §4 ห้ามอ้างตัวเลขที่บรีฟไม่ได้ระบุ
// คำว่า RTP จึงไม่ปรากฏในเนื้อหาแม้แต่ครั้งเดียว แผงขวาเป็น "เกมและสิทธิ์ที่เลือกได้"
// ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ชื่อค่ายเกม · เลขใบอนุญาต · ชื่อผู้ดำเนินงาน ·
// ชื่อธนาคาร · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง · ค่า RTP · ความผันผวน —
// บรีฟไม่ได้ให้ไว้สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง
// ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีเท่านี้: 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน
const gameTypes = [
  { icon: "🎴", name: "บาคาร่า", detail: "บาคาร่ามีโต๊ะสดให้เลือกตามรายการที่เปิดบริการ เข้าเล่นผ่านมือถือและคอมพิวเตอร์จากบัญชีเดียวได้" },
  { icon: "🎡", name: "รูเล็ต", detail: "รูเล็ตมีโต๊ะให้เลือกตามรายการที่ระบบเปิดบริการ ควรตรวจสอบสถานะของโต๊ะจากระบบก่อนเริ่มเดิมพัน" },
  { icon: "🎲", name: "ไฮโล", detail: "ไฮโลเน้นรูปแบบการเดิมพันที่เข้าใจง่าย เลือกเข้าโต๊ะได้จากหมวดคาสิโนไลฟ์ของเว็บไซต์" },
  { icon: "🎰", name: "สล็อต", detail: "สล็อตมีทั้งเกมโบนัส ฟรีสปิน และตัวคูณ แต่ละเกมกำหนดเงื่อนไขและช่วงเดิมพันของตัวเองไว้ไม่เหมือนกัน" },
  { icon: "⚽", name: "แทงบอล", detail: "แทงบอลเลือกคู่แข่งขันและตลาดเดิมพันได้ตามช่วงเวลาที่ระบบเปิดรับในแต่ละรายการ" },
  { icon: "📺", name: "โต๊ะสด", detail: "เกมไลฟ์และการแข่งขันบางรายการมีเวลาเปิดให้เดิมพันแตกต่างกัน ควรตรวจสอบสถานะจากระบบก่อนเริ่มทุกครั้ง" },
  { icon: "🗂️", name: "หมวดเกม", detail: "ระบบจัดหมวดหมู่ชัดเจน ช่วยให้สลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวกจากบัญชีเดียว" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "สมาชิกที่มียอดเสียตรงตามข้อกำหนดตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนดได้" },
  { icon: "🤝", name: "แนะนำเพื่อน 0.8%", detail: "เมื่อเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์" },
  { icon: "📑", name: "เครดิตและประวัติรายการ", detail: "หลังเปิดบัญชีสามารถเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 7, 16, 11, 19)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforePlayChecks = [
  {
    icon: "🔎",
    name: "วงเงินจริงของโต๊ะและเกม",
    detail: "คำว่า ไม่มีขั้นต่ำทุกรูปแบบเกม ควรอ้างอิงวงเงินจริงภายในระบบ เพราะบาคาร่า รูเล็ต ไฮโล สล็อต และบอลสามารถกำหนดยอดเดิมพันขั้นต่ำแตกต่างกันตามโต๊ะ เกม หรือผู้ให้บริการ",
    tag: "ดูก่อนลงเดิมพัน",
  },
  {
    icon: "💹",
    name: "Limit ของโต๊ะหรือเกม",
    detail: "เกมคาสิโนแต่ละรายการสามารถกำหนดยอดขั้นต่ำและสูงสุดแตกต่างกัน สมาชิกควรตรวจสอบ Limit ของโต๊ะหรือเกมก่อนเดิมพัน พร้อมกำหนดงบสำหรับการเล่นไว้ล่วงหน้า",
    tag: "กำหนดงบก่อนเล่น",
  },
  {
    icon: "🧾",
    name: "ประเภทเกม รอบตัดยอด และเงื่อนไขโบนัส",
    detail: "ระบบจะคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงจำนวนโบนัสที่รับได้ จึงควรตรวจสอบประเภทเกม รอบตัดยอด และเงื่อนไขการใช้โบนัสก่อนกดรับทุกครั้ง",
    tag: "เช็กเงื่อนไขจริง",
  },
  {
    icon: "🔐",
    name: "รหัสผ่าน PIN และ OTP",
    detail: "กรณีคาสิโนไลฟ์มีปัญหาควรแจ้งชื่อเกม โต๊ะ และเวลาที่เกิดเหตุ ส่วนแทงบอลควรระบุคู่แข่งขันและรายการที่เกี่ยวข้อง หากเป็นเรื่องธุรกรรมควรเตรียมเวลา จำนวนเงิน และหลักฐานไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "คาสิโนไลฟ์",
  "คาสิโนออนไลน์",
  "บาคาร่า",
  "รูเล็ต",
  "ไฮโล",
  "สล็อต",
  "แทงบอล",
  "โต๊ะสด",
  "หมวดเกม",
  "ไม่มีขั้นต่ำทุกรูปแบบเกม",
  "วงเงิน",
  "Limit",
  "ฟรีสปิน",
  "ตัวคูณ",
  "โบนัส",
  "รอบตัดยอด",
  "บัญชีเดียว",
  "เครดิต",
  "โปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ฝากถอน",
  "ประวัติรายการ",
  "Login",
  "สมัคร 3 ขั้นตอน",
  "แอดมิน 24 ชั่วโมง",
];

// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §2-§3):
// โลโก้รอบนี้เป็นเทพเจ้าโชคลาภจีนสวมหมวกทรงจีนสีเขียวมรกตคาดแถบแดง กับตัวอักษร GUCCI
// ขาวเงินขอบเขียวทับเลข 168 แดงเมทัลลิกขอบทอง แบรนด์จึงมีสามสีจริง — แดงนำ เขียวมรกต
// รอง ทองเป็นโลหะคั่น — ไม่ใช่คู่โลหะทอง-เงินแบบ UOK365
// สองแผงถูกแยกด้วยคู่แดง/เขียวนั้นตรงๆ และจงใจให้ตรงกับ ContentBoxTwo ที่ครอบอยู่
// ซึ่งให้ป้ายคอลัมน์ซ้ายเป็นแดงสว่าง #e0201f กับป้ายไอคอนไล่แดง และป้ายคอลัมน์ขวาเป็น
// เขียวสว่าง #2bbf63 กับป้ายไอคอนไล่เขียว — แผงล็อกอิน (ซ้าย) จึงอยู่ในกรอบแดงแบรนด์
// #c41115 ส่วนแผงเกมและสิทธิ์ (ขวา) อยู่ในกรอบเขียวมรกต #0b7a33 ทั้งคู่วางบนผิวยก
// #1d0b08 ช่องกรอกและชิปตกลงไปที่ผิวลึกสุด #090302 และผิวที่ hover ขึ้นมาเป็น #3d0a09
// (ผิวแดงกลางชุดเดียวกับ NavbarStyle8 / FooterStyle3 / Announcement3 ที่ shared chrome
// ใช้อยู่แล้ว) บรรทัดเด่นไล่ทองอ่อน #ffdf91 → เขียวสว่าง #2bbf63 → แดงสว่าง #e0201f
//
// ทองของแบรนด์ (#ffdf91 / #d9a521 / #8c6410 ตามขอบทองของเลข 168 และเหรียญทองจีนในภาพ)
// ถูกเก็บไว้เป็น "โลหะคั่น" ที่ป้ายไอคอนต้อนรับและสีตัวอักษรเน้น ไม่ได้ขึ้นเป็นกรอบแผง
// ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นพื้นไล่ผิวยก #1d0b08 →
// ผิวลึกสุด #090302 ขอบแดงแบรนด์ หมึกเนื้อความ #f6e3cf — ไม่ใช่ปุ่มหลักพื้นทอง ซึ่งถูก
// เก็บไว้ให้ปุ่มสมัครสมาชิกบนหน้าแรก ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบ
// ข้อความรองใช้ชมพูอมน้ำตาลหม่น #a8897f (6.4:1 บนผิวเข้ม ค่าเดียวกับเมนูปกติของ
// NavbarStyle8) ไม่ใช่สีเนื้อความแบบลดความทึบ เนื้อความ #f6e3cf (= BRAND_TEXT)
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #6d4412
// #d8dbe0 #191108 #070504 #120c07 #191005 #ece1cc #b7a58a rgba(200,145,47,…)
// rgba(245,217,138,…)) ออกครบทุกจุดแล้ว — รอบนี้เป็นการพลิกฮิวจากทองเมทัลลิกมาเป็นชุด
// ตรุษจีนสามสี ไม่ใช่การยกค่าเดิมมาเปลี่ยนแค่เบอร์สี
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`เกมและสิทธิ์ที่ ${BRAND_NAME} รวมไว้`}
  iconleft="🔐"
  iconright="🎴"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการเกมคาสิโนไลฟ์ที่ระบบรวมไว้ ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต แทงบอล โต๊ะสด หมวดเกม โปรโมชั่นคืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% และจุดที่ควรตรวจสอบก่อนเริ่มเดิมพันทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c41115]/45 bg-[#1d0b08] p-6 shadow-[0_0_28px_rgba(196,17,21,0.2)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c41115]/32 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#8c6410] bg-gradient-to-br from-[#ffdf91] via-[#d9a521] to-[#8c6410] text-xl text-[#1a0604] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffdf91]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a8897f]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือหรือคอมพิวเตอร์ได้สะดวก แล้วเลือกโต๊ะสดหรือหมวดเกมที่สนใจ ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล พร้อมตรวจสอบเครดิต โปรโมชั่น สถานะการรับสิทธิ์
            และประวัติรายการจากบัญชีเดียวได้ทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8897f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a0505] bg-[#090302] py-3 pr-4 pl-12 text-[#f6e3cf] transition-all outline-none placeholder:text-[#a8897f] focus:border-[#c41115] focus:ring-1 focus:ring-[#c41115]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a8897f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a0505] bg-[#090302] py-3 pr-4 pl-12 text-[#f6e3cf] transition-all outline-none placeholder:text-[#a8897f] focus:border-[#c41115] focus:ring-1 focus:ring-[#c41115]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a8897f]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a0505] bg-[#090302] accent-[#c41115]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a8897f] transition-colors hover:text-[#ffdf91]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c41115]/60 bg-gradient-to-b from-[#1d0b08] to-[#090302] p-3.5 text-center font-black text-[#f6e3cf] shadow-[0_0_12px_rgba(196,17,21,0.25)] transition-all hover:scale-[1.02] hover:border-[#c41115] hover:text-[#ffdf91]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a8897f]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#7a0505]"></span>
          หรือ
