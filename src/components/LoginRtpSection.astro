---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// LION991 is a LIVE-CASINO brand, so every row below describes โต๊ะไลฟ์สด /
// กติกาและวงเงินของโต๊ะ / โปรโมชั่น / สมัครเอง 3 ขั้นตอน / ฝากถอน — never หวย,
// รอบหวย or เรทบาทละ. Each one stays inside what the brief states: บาคาร่า รูเล็ต
// เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น ๆ ตามโต๊ะและผู้ให้บริการที่เปิดให้บริการ,
// การรับชมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์แบบเรียลไทม์, การตรวจกติกา อัตราจ่าย
// วงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะก่อนเดิมพัน, การยึดข้อมูลสตูดิโอที่แสดงในเกมโดยตรง,
// การ Login เพื่อดูโปรโมชั่นที่เปิดให้รับในช่วงเวลานั้นพร้อมเปอร์เซ็นต์ วิธีคำนวณ รอบรับ
// โบนัส และข้อกำหนดในการถอน, การสมัครออนไลน์ด้วยตัวเอง 3 ขั้นตอนโดยไม่ต้องผ่าน
// แอดมิน, การตรวจเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนจากบัญชีสมาชิก,
// และแอดมินที่รับเรื่องตลอด 24 ชั่วโมง.
// No licence, no member count, no guaranteed win — the brief states none of them.
const menus = [
  { icon: "🃏", name: "เลือกโต๊ะคาสิโนสดที่เปิดให้บริการ", detail: "บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น ๆ เลือกได้ตามโต๊ะและผู้ให้บริการที่ระบบเปิดให้บริการ", tag: "ห้องไลฟ์สด" },
  { icon: "📱", name: "รับชมผ่านมือถือ แท็บเล็ต และคอม", detail: "รองรับการรับชมผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ ทำให้ติดตามการดำเนินเกมแบบเรียลไทม์ได้อย่างสะดวก", tag: "เรียลไทม์" },
  { icon: "📖", name: "ตรวจกติกาและอัตราจ่ายของโต๊ะ", detail: "ก่อนเดิมพันควรตรวจสอบกติกาและอัตราจ่าย เนื่องจากรายละเอียดอาจแตกต่างกันตามเกมและผู้ให้บริการ", tag: "ดูก่อนเดิมพัน" },
  { icon: "🎚️", name: "ดูวงเงินขั้นต่ำและสูงสุดของแต่ละโต๊ะ", detail: "แต่ละโต๊ะกำหนดวงเงินขั้นต่ำและสูงสุดไม่เท่ากัน ควรตรวจให้ครบก่อนเลือกโต๊ะที่เหมาะกับการใช้งานของตนเอง", tag: "เช็กวงเงิน" },
  { icon: "🎥", name: "ยึดข้อมูลที่แสดงในเกมโดยตรง", detail: "ข้อมูลเกี่ยวกับสตูดิโอหรือแหล่งถ่ายทอดสดของแต่ละโต๊ะ ควรยึดข้อมูลที่แสดงอยู่ในเกมนั้นเป็นหลัก", tag: "ตามหน้าเกม" },
  { icon: "🎁", name: "Login ตรวจโปรโมชั่นที่เปิดให้รับ", detail: "สิทธิ์สมาชิกใหม่ โปรโมชั่นยอดฝาก กิจกรรมแนะนำเพื่อน หรือโบนัสอื่น ๆ เปิดให้รับต่างกันในแต่ละช่วงเวลา", tag: "ดูจากบัญชี" },
  { icon: "🧮", name: "อ่านเงื่อนไขก่อนกดรับโบนัส", detail: "แต่ละโปรโมชั่นมีเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส ยอดขั้นต่ำ ประเภทเกมที่ร่วมรายการ และข้อกำหนดในการถอนต่างกัน", tag: "อ่านให้ครบ" },
  { icon: "🏦", name: "สมัครเองและฝากถอนจากบัญชีสมาชิก", detail: "สมัครออนไลน์ได้เองโดยไม่ต้องผ่านแอดมิน จากนั้นตรวจเครดิต ประวัติรายการ และสถานะฝากถอนได้จากบัญชีของตนเอง", tag: "3 ขั้นตอน" },
];

const chips = ["บาคาร่า", "รูเล็ต", "เสือมังกร", "แบล็กแจ็ก", "ห้องไลฟ์สด 24 ชม.", "สมัครเอง 3 ขั้นตอน", "ฝากถอนจากบัญชีสมาชิก", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ LION991" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเดิมพันกับ LION991" label="เข้าสู่ระบบ LION991 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#1046e0]/40 bg-[#041640]/92 p-6 shadow-[0_10px_30px_rgba(16,70,224,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3d82ff]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#b7c6dd]/60 bg-gradient-to-br from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#e6ecf7]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fc2ff]">เข้าสู่ระบบ LION991 เพื่อเข้าโต๊ะคาสิโนสด ตรวจกติกาและวงเงินของแต่ละโต๊ะ ดูโปรโมชั่นที่เปิดให้รับ ฝากถอน และติดตามประวัติรายการได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7d90ad]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1046e0]/45 bg-[#01041c]/95 py-3 pr-4 pl-12 text-[#d6e2f5] transition-all outline-none placeholder:text-[#7d90ad] focus:border-[#3d82ff] focus:ring-1 focus:ring-[#3d82ff]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7d90ad]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1046e0]/45 bg-[#01041c]/95 py-3 pr-4 pl-12 text-[#d6e2f5] transition-all outline-none placeholder:text-[#7d90ad] focus:border-[#3d82ff] focus:ring-1 focus:ring-[#3d82ff]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d6e2f5]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1046e0]/45 bg-[#01041c] accent-[#1046e0]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d6e2f5] transition-colors hover:text-[#e6ecf7]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#7d90ad]/55 bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] p-3.5 text-center font-black text-[#01041c] shadow-[0_10px_30px_rgba(183,198,221,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(183,198,221,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#7d90ad]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#1046e0]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#1046e0]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#b7c6dd]/45 bg-[#01041c] px-2.5 py-1 text-[10px] font-bold text-[#b7c6dd]"><span aria-hidden="true">🎥</span> ห้องไลฟ์สด</span>
            <span class="rounded-full border border-[#1046e0]/40 bg-[#01041c]/80 px-2.5 py-1 text-[10px] font-bold text-[#8fc2ff]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#8fc2ff] transition-colors hover:text-[#e6ecf7]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#1046e0]/40 bg-[#041640]/92 p-5 shadow-[0_10px_30px_rgba(16,70,224,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d6e2f5]">เข้าโต๊ะบาคาร่า รูเล็ต เสือมังกร และแบล็กแจ็กจากบัญชีเดียว ตรวจกติกา อัตราจ่าย และวงเงินขั้นต่ำ-สูงสุดของโต๊ะนั้นก่อนเดิมพันทุกครั้ง</span>
          <div class="bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ห้องไลฟ์สด 24 ชั่วโมง</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#b7c6dd]/55 bg-[#020a2b]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#b7c6dd] shadow-[0_0_8px_rgba(183,198,221,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#b7c6dd] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#7d90ad] uppercase">
        <span>ขั้นตอนเข้าเล่น โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1046e0]/60 bg-[#01041c]/95 px-3.5 py-2.5 transition-colors hover:border-[#b7c6dd]/60 hover:bg-[#020a2b]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d6e2f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#b7c6dd]/45 bg-[#01041c] px-2.5 py-0.5 text-[10px] font-bold text-[#b7c6dd]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8fc2ff]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1046e0]/35 bg-[#01041c] px-3 py-1 text-[10px] font-bold text-[#8fc2ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#7d90ad]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเดิมพัน โต๊ะและผู้ให้บริการแต่ละรายอาจมีกติกา อัตราจ่าย และวงเงินขั้นต่ำ-สูงสุดต่างกัน ให้ยึดรายละเอียดที่แสดงในเกม ณ เวลาเดิมพันเป็นหลัก
        ส่วนเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และข้อกำหนดในการถอนของแต่ละโปรโมชั่น ควรยึดข้อมูลล่าสุดที่ปรากฏในระบบ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
