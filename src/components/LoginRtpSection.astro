          <span class="text-xs font-bold tracking-wide text-[#9fb8aa]">
            {BRAND_NAME} รวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูง มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ พร้อมเลือกเกมตามช่วงเดิมพันที่ต้องการ
          </span>
          <div class="bg-gradient-to-r from-[#ffffff] via-[#f3c44a] to-[#42fb5a] bg-clip-text text-xl font-black text-transparent sm:text-2xl">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#036b26] bg-[#041109] px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#42fb5a] shadow-[0_0_8px_rgba(66,251,90,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#42fb5a] uppercase">ตามแคมเปญที่เปิดในแต่ละช่วง</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9fb8aa] uppercase">
        <span>เกมและสิทธิ์ที่เลือกได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gameTypes.map((t) => (
            <div class="rounded-xl border border-[#036b26] bg-[#041109] px-3.5 py-2.5 transition-colors hover:border-[#42fb5a]/80 hover:bg-[#07170f]">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#42fb5a]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#9fb8aa]">{t.detail}</span>
            </div>
          ))
