---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// เนื้อหาในไฟล์นี้มาจาก src/assets/content.txt ของดรอปนี้ทั้งหมด ซึ่งรอบนี้เป็นบรีฟ
// "คนละเว็บ" กับรอบก่อน ไม่ใช่บรีฟเดิมที่เปลี่ยนแค่ชื่อแบรนด์ — รอบก่อน (TND168)
// เป็น **คาสิโนรวมทุกหมวดพร้อมคาสิโนไลฟ์สด** (แบรนด์คาสิโนเซิร์ฟไทย เล่นได้ทุกค่าย)
// ส่วนรอบนี้เป็น **เว็บลิขสิทธิ์ไทยแท้ที่เปิดระบบเดิมพันออนไลน์ ออโต้ทุกประเภท** ซึ่ง
// รวมเฉพาะ บาคาร่า สล็อต และบอลออนไลน์ ไว้ในแพลตฟอร์มเดียว พร้อมเมนูจัดการบัญชี
// โปรโมชั่นสองรายการ (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%) ระบบฝากถอนเข้าบริษัท
// เจ้าของโดยตรง และแอดมิน 24 ชั่วโมง แผงนี้จึงถูกเขียนใหม่ทั้งแผงจากบรีฟรอบนี้ ไม่ใช่
// ไล่แทนคำบนประโยคเดิม — บรีฟรอบนี้ **ไม่มี** คำว่า รูเล็ต ไฮโล คาสิโนไลฟ์สด
// เกมถ่ายทอดสดจากโต๊ะจริง ตารางเปิดโต๊ะ รอบถ่ายทอดสด มีโบนัสทุกเกม เล่นได้ทุกค่าย
// แบรนด์คาสิโนเซิร์ฟไทย ฟีเจอร์ตัวคูณ หรือ สมัคร 3 ขั้นตอน เลยสักบรรทัด
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §1 ระบุ ซึ่งมาจาก content.txt ทั้งหมด:
// เว็บลิขสิทธิ์ไทยแท้ · ระบบเดิมพันออนไลน์ · ออโต้ทุกประเภท · คาสิโนรวมเกม ·
// บาคาร่า · สล็อต · บอลออนไลน์ / แทงบอล · แพลตฟอร์มเดียว · เมนูจัดการบัญชี ·
// ตรวจสอบเครดิต · เกมไพ่ · เกมวงล้อทั่วไป · ฟรีสปิน · ฟีเจอร์โบนัส · คู่แข่งขัน ·
// อัตราต่อรอง · ตารางจ่าย · กติกา · ยืนยันรายการ · ยอดเครดิต · ประวัติธุรกรรม ·
// คืนยอดเสีย 0.3% · เข้ายูสทุกวัน · รอบประจำวัน · เวลาตัดยอด · ยอดที่เข้าเกณฑ์ ·
// แนะนำเพื่อน · โบนัส 0.8% · ไม่จำกัด · ลิงก์แนะนำ · ฝากถอนเข้าบริษัทเจ้าของโดยตรง ·
// บัญชีบริษัท · นิติบุคคล · ชื่อบัญชีปลายทาง · หลักฐานธุรกรรม · แอดมิน 24 ชั่วโมง ·
// PIN · OTP
//
// คำของแบรนด์ก่อนๆ ถูกถอดออกทั้งชุดตาม §1 (แบรนด์คาสิโนเซิร์ฟไทย · เล่นได้ทุกค่าย ·
// มีโบนัสทุกเกม · คาสิโนไลฟ์สด · เกมถ่ายทอดสดจากโต๊ะจริง · รูเล็ต · ไฮโล ·
// สล็อตปันโปรในตำนาน · เว็บเล่นสล็อตออนไลน์ · ทางเข้าเล่นใหม่ 2026 · สล็อตคลาสสิก ·
// เว็บตรงในตำนาน · เว็บคนนิยมเล่นมายาวนาน · ฝากถอนเข้า บช. บริษัทตรง ·
// เว็บไซต์เลียนแบบ · ปันโปร · แตกง่ายทุกเกม · ส่งตรงจากเมกา · ไม่ผ่านเอเย่นต์ ·
// เดิมพันเริ่มต้น 1 บาท · ทุนน้อยกำไรงาม · การันตีเว็บแท้ · จ่ายไว · ค่ายตรง ·
// เว็บตรง · จ่ายตรง · ไม่บิดยูส · ไม่ผ่าน บช. ม้า · ฐานเกมแท้ · ยิงปลา · เสือมังกร ·
// รีวิวถอนจริง · VIP · เว็บเป็ด · สล็อตพีจี · เว็บสล็อตนาซ่า) — ไม่เหลือแม้คำเดียว
// และรอบนี้ไม่มีคำว่า หวย โพย เลขเด็ด งวด แนวทาง หรือ ตรวจหวย ที่ไหนบนเว็บเลย
// (/ตรวจหวย กับ /แนวทาง ยังจอดอยู่ใน src/pages-disabled/ ตาม §7)
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// บรีฟรอบนี้ไม่ได้เอ่ยถึงค่า RTP เลยแม้แต่คำเดียว §1 จึงห้ามอ้างตัวเลข RTP ที่นี่
// แผงขวาเป็น "หมวดเกมและโปรโมชั่นที่รวบรวมไว้" ไม่ใช่ตารางค่าของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: เลขที่ใบอนุญาต · หน่วยงานกำกับ · ชื่อค่ายเกม ·
// ชื่อบริษัท/นิติบุคคล · ชื่อธนาคาร · ค่า RTP · ยอดฝากถอนขั้นต่ำเป็นตัวเลข ·
// จำนวนสมาชิก · ปีก่อตั้ง (บรีฟสั่งให้ "ตรวจสอบ" ไม่ใช่ให้ประกาศ จึงคงคำกำกับไว้
// ไม่ใช่คำอ้าง) — บรีฟไม่ได้ให้ไว้สักอย่าง
// ตัวเลขที่ใช้ได้มีสามตัว: 0.3% · 0.8% · 24 ชั่วโมง (ไม่มีปี และไม่มี "3 ขั้นตอน"
// รอบนี้ บรีฟไม่ได้เขียนไว้)
