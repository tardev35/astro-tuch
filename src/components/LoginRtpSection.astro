---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// VAK88 is a slot brand — เกมสล็อตเว็บตรงเจ้าแรก ที่ให้บริการผ่านช่องทางเข้าเล่น
// หลักอย่างเป็นทางการ โดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์. Every row below stays
// inside what the brief states: เกมสล็อตจากค่ายยักษ์ใหญ่ระดับโลกที่ได้รับอนุญาต
// จากลิขสิทธิ์แท้ 100% (Certified API), กราฟิกคมชัดระดับ Cinematic Lighting,
// อัตราการชนะ (RTP) ที่เป็นมาตรฐานสากลและไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ, การ
// ไม่ล็อคยูสเซอร์ทั้งลูกค้าเก่าและลูกค้าใหม่, โบนัสแนะนำเพื่อน 0.8% จากทุกยอดการ
// เล่นของเพื่อน, โบนัสคืนยอดเสีย 0.3% ในทุกรอบบิล, ระบบสมัครสมาชิกอัตโนมัติ 3
// ขั้นตอน, ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาทีที่รองรับทุกธนาคารชั้นนำและไม่มี
// ขั้นต่ำ, การรองรับคอมพิวเตอร์ แท็บเล็ต และสมาร์ทโฟนผ่านเว็บเบราว์เซอร์โดยไม่ต้อง
// ดาวน์โหลดแอปพลิเคชัน, และแอดมินที่ให้บริการผ่าน Line Official ตลอด 24 ชั่วโมง.
// No licence number, no member count and no guaranteed payout — nothing here
// goes beyond what the brief itself says.
const menus = [
  {
    icon: "🎰",
    name: "สล็อตจากค่ายยักษ์ใหญ่ระดับโลก",
    detail: "เลือกเกมสล็อตจากค่ายยักษ์ใหญ่ระดับโลกที่ระบบเปิดให้บริการ ทุกค่ายผ่านการตรวจสอบและได้รับอนุญาตจากลิขสิทธิ์แท้",
    tag: "ลิขสิทธิ์แท้ 100%",
  },
  {
    icon: "🛡️",
    name: "Certified API ไม่ผ่านเอเย่นต์",
    detail: "ให้บริการผ่านช่องทางเข้าเล่นหลักอย่างเป็นทางการ โดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์ เกมทุกค่ายนำเข้าด้วย Certified API",
    tag: "เว็บตรงเจ้าแรก",
  },
  {
    icon: "📊",
    name: "อัตราการชนะ (RTP) มาตรฐานสากล",
    detail: "RTP ของเกมเป็นไปตามมาตรฐานสากล ไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ ตรวจสอบความโปร่งใสได้จากหน้าเกมของแต่ละค่าย",
    tag: "โปร่งใส ยุติธรรม",
  },
  {
    icon: "🎬",
    name: "กราฟิกคมชัดระดับ Cinematic",
    detail: "คุณภาพกราฟิกคมชัดพร้อมการจัดแสงเงาระดับ Cinematic Lighting ที่สมจริงในทุกการสปิน บนอินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค",
    tag: "ทุกการสปิน",
  },
  {
    icon: "🔓",
    name: "ไม่ล็อคยูสเซอร์ทุกบัญชี",
    detail: "แจกโบนัสหนักแบบไม่มีการล็อคยูสเซอร์ ทั้งผู้เล่นใหม่และยูสเซอร์เก่าที่อยู่ด้วยกันมานาน ยิ่งเล่นยิ่งได้สิทธิประโยชน์",
    tag: "เก่า-ใหม่เท่ากัน",
  },
  {
    icon: "🎁",
    name: "Login ตรวจสิทธิ์โบนัสที่มี",
    detail: "เข้าสู่ระบบเพื่อดูสิทธิ์ที่มี ทั้งค่าคอมมิชชั่นแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน และคืนยอดเสีย 0.3% ในทุกรอบบิล",
    tag: "0.8% และ 0.3%",
  },
  {
    icon: "💳",
    name: "ฝาก-ถอนออโต้ 3-5 วินาที",
    detail: "ระบบฝาก-ถอนอัตโนมัติประมวลผลภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำ และไม่มีการกำหนดขั้นต่ำในการทำรายการ",
    tag: "ไม่มีขั้นต่ำ",
  },
  {
    icon: "📱",
    name: "เข้าเล่นได้ทุกอุปกรณ์",
    detail: "รองรับทั้งคอมพิวเตอร์ แท็บเล็ต และสมาร์ทโฟนทั้ง iOS และ Android เข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทันทีโดยไม่ต้องดาวน์โหลดแอปพลิเคชัน",
    tag: "ไม่ต้องโหลดแอป",
  },
];

const chips = ["เว็บตรงเจ้าแรก", "ลิขสิทธิ์แท้ 100%", "Certified API", "RTP มาตรฐานสากล", "ไม่ล็อคยูส", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "ออโต้ 3-5 วินาที", "Line 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ VAK88"
  titleright="สิ่งที่สมาชิกได้รับจาก Portal หลักของ VAK88"
  label="เข้าสู่ระบบ VAK88 และรายการสิทธิประโยชน์ที่สมาชิกได้รับจาก Portal หลัก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8a5f14]/55 bg-[#0b1020]/92 p-6 shadow-[0_10px_30px_rgba(230,178,60,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e6b23c]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#cf2027]/50 bg-gradient-to-br from-[#ffd873] via-[#e6b23c] to-[#8a5f14] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff4dd]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ffd873]">
            ล็อคอินเข้าสู่หน้า Portal หลักของ VAK88 เพื่อเลือกเกมสล็อตจากค่ายลิขสิทธิ์แท้ ตรวจสอบสิทธิ์โบนัสที่มี เติมเครดิต และทำรายการฝาก-ถอนอัตโนมัติได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ded8ca]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8a5f14]/55 bg-[#060913]/95 py-3 pr-4 pl-12 text-[#ded8ca] transition-all outline-none placeholder:text-[#ded8ca]/45 focus:border-[#e6b23c] focus:ring-1 focus:ring-[#e6b23c]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ded8ca]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#8a5f14]/55 bg-[#060913]/95 py-3 pr-4 pl-12 text-[#ded8ca] transition-all outline-none placeholder:text-[#ded8ca]/45 focus:border-[#e6b23c] focus:ring-1 focus:ring-[#e6b23c]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ded8ca]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8a5f14]/55 bg-[#060913] accent-[#e6b23c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ded8ca] transition-colors hover:text-[#fff4dd]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#8a5f14]/60 bg-gradient-to-r from-[#ffd873] via-[#e6b23c] to-[#8a5f14] p-3.5 text-center font-black text-[#060913] shadow-[0_10px_30px_rgba(230,178,60,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(230,178,60,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ded8ca]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a5f14]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#8a5f14]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e6b23c]/45 bg-[#060913] px-2.5 py-1 text-[10px] font-bold text-[#e6b23c]"><span aria-hidden="true">🎰</span> เว็บตรงเจ้าแรก</span>
            <span class="rounded-full border border-[#cf2027]/50 bg-[#060913]/80 px-2.5 py-1 text-[10px] font-bold text-[#ee3a34]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffd873] transition-colors hover:text-[#fff4dd]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8a5f14]/55 bg-[#0b1020]/92 p-5 shadow-[0_10px_30px_rgba(230,178,60,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ded8ca]">ระบบนิเวศการเดิมพันแบบ Portal &amp; Privilege ที่รวมความบันเทิงระดับลักชูรีไว้ในที่เดียว</span>
          <div class="bg-gradient-to-r from-[#ffd873] via-[#fff4dd] to-[#cf2027] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกสิทธิประโยชน์ระดับพรีเมียม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e6b23c]/45 bg-[#121a2e]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6b23c] shadow-[0_0_8px_rgba(230,178,60,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e6b23c] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ded8ca]/60 uppercase">
        <span>เกม โปรโมชั่น และระบบที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#8a5f14]/60 bg-[#060913]/95 px-3.5 py-2.5 transition-colors hover:border-[#e6b23c]/55 hover:bg-[#121a2e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ded8ca]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e6b23c]/40 bg-[#060913] px-2.5 py-0.5 text-[10px] font-bold text-[#e6b23c]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ded8ca]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8a5f14]/45 bg-[#060913] px-3 py-1 text-[10px] font-bold text-[#ffd873]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ded8ca]/60">
        รายการข้างต้นสรุปสิ่งที่ VAK88 ให้บริการตามที่ประกาศไว้ ทั้งเกมลิขสิทธิ์แท้ 100% อัตราการชนะ (RTP) ตามมาตรฐานสากล ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาทีที่ไม่มีขั้นต่ำ และโปรโมชั่นแนะนำเพื่อน 0.8%
        กับคืนยอดเสีย 0.3% ส่วนรอบคำนวณและเงื่อนไขของแต่ละโปรโมชั่น ให้ยึดข้อกำหนดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
