---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ (หวย24 2026-10-04) เนื้อหาในไฟล์นี้ถูก **เขียนใหม่ทั้งแผง** ไม่ได้
// find-and-replace ทับประโยคของรอบก่อน เพราะมุมของแบรนด์ก่อน (หวยคิง) คนละเรื่อง
// กันทั้งชุด — บาทละ 1,000 เป็นคำโฆษณาหลัก, เว็บแม่, จ่ายไม่อั้น,
// ยอดเข้าบริษัทโดยตรง, ชื่อนิติบุคคล/บัญชีบริษัท, เครดิต/วอลเลท/ธนาคาร —
// บรีฟรอบนี้ไม่ได้พูดสักคำ มุมของรอบนี้คือ ลาว/ฮานอย/รัฐบาลไทย · แนวทางหวย ·
// 24 ชั่วโมง · เรทจ่ายสูง · รับไม่อั้น/จ่ายเต็มทุกโพย
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §5 ระบุ ซึ่งมาจาก src/assets/content.txt ทั้งหมด:
// แทงหวย · ส่งโพย · โพย · รอบ · รายการหวย · หวยลาว · หวยฮานอย · รัฐบาลไทย ·
// เลข 2 ตัว · เลข 3 ตัว · เลขเด็ด · เลขดัง · แนวทางหวย · อัตราจ่าย · เรทจ่าย ·
// 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · วงเงินรับแทง ·
// ยอดสูงสุดที่ระบบเปิดรับ · ผลรางวัล · ประวัติโพย · สมัคร 3 ขั้นตอน · Login ·
// แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากแบรนด์คาสิโนรอบเก่าๆ — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่
// "RTP" เป็นคำของเว็บสล็อตและ brand-spec §5 แบนไว้ จึงไม่ปรากฏในเนื้อหาแม้แต่
// ครั้งเดียว แผงขวาเป็น "รายการหวยที่เปิดรับ" ไม่ใช่ตารางค่า RTP ของเกม
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: เวลาเปิด-ปิดของแต่ละรอบ · ชื่อตลาดหวยอื่น
// นอกจาก ลาว/ฮานอย/รัฐบาลไทย (ห้ามเติม ลาวพัฒนา หวยหุ้น ยี่กี) · ชื่อธนาคาร ·
// เลขใบอนุญาต · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง — บรีฟไม่ได้ให้ไว้สักอย่าง
// และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่
// ใช้ได้มีเท่านี้: 2 ตัว · 3 ตัว · 100 · 1,000 · 3 ขั้นตอน · 24 ชั่วโมง
//
// แผงฝั่งขวาแถวบนคือ "รายการหวยที่ระบบเปิดรับ" ซึ่งเป็นคำของบรีฟตรงๆ และชื่อ
// รายการสามชื่อ (หวยลาว หวยฮานอย รัฐบาลไทย) ก็มาจากบรีฟ ไม่ได้เติมเอง
const betTypes = [
  { icon: "🗓️", name: "หวยลาว", detail: "เปิดรับตามรอบที่ระบบกำหนด ควรตรวจสอบรอบเปิดรับและเวลาที่ระบบแสดงก่อนส่งโพยทุกครั้ง" },
  { icon: "⏱️", name: "หวยฮานอย", detail: "มีหลายช่วงเวลา แต่ละรอบอาจกำหนดรายละเอียดและอัตราจ่ายแตกต่างกัน จึงควรดูรอบที่เลือกให้ตรง" },
  { icon: "🏛️", name: "รัฐบาลไทย", detail: "เปิดรับตามกำหนดออกรางวัล ตรวจสอบรอบและอัตราจ่ายบนหน้าส่งโพยก่อนยืนยันรายการ" },
  { icon: "🎟️", name: "เลข 2 ตัว", detail: "รายการที่เข้าเงื่อนไขมีเรท 2 ตัว จ่าย 100 บาท ก่อนส่งโพยควรตรวจสอบเลขให้ครบทั้งสองหลัก" },
  { icon: "🎫", name: "เลข 3 ตัว", detail: "รายการที่เข้าเงื่อนไขมีเรท 3 ตัว จ่าย 1,000 บาท เลข 3 ตัวมีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันเสมอ" },
  { icon: "🔢", name: "เลขเด็ด และเลขดัง", detail: "เลือกเลขที่กำลังได้รับความสนใจตามรายการที่เปิดรับ เลขที่มียอดเดิมพันสูงอาจมีวงเงินรับต่างจากเลขทั่วไป" },
  { icon: "🧭", name: "แนวทางหวย", detail: "ติดตามแนวทางหวยได้จากบัญชีเดียว เป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้" },
  { icon: "📑", name: "ผลรางวัล และประวัติโพย", detail: "ตรวจผลรางวัลและย้อนดูประวัติโพยของตัวเองได้จากบัญชีเดียวกับที่ใช้ส่งโพย" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 4, 7, 9, 17)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforeSlipChecks = [
  {
    icon: "⏰",
    name: "รอบเปิดและปิดของแต่ละรายการ",
    detail: "ระบบเว็บไซต์เข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ สมาชิกจึงควรตรวจสอบเวลาที่ระบบแสดงก่อนส่งโพย",
    tag: "ดูเวลาที่ระบบแสดง",
  },
  {
    icon: "🧾",
    name: "อัตราจ่ายบนหน้าส่งโพย",
    detail: "อัตราจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เลือก จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก ส่วนคำว่าเรทจ่ายสูงที่สุดควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้",
    tag: "ยึดหน้าส่งโพย",
  },
  {
    icon: "📊",
    name: "วงเงินรับแทงของเลขนั้น",
    detail: "คำว่ารับไม่อั้นและจ่ายเต็มทุกโพย ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง เพราะเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป ควรดูยอดสูงสุดที่ระบบเปิดรับก่อนยืนยัน",
    tag: "เช็กวงเงินจริง",
  },
  {
    icon: "🔐",
    name: "รหัสผ่าน PIN และ OTP",
    detail: "ควรตรวจสอบเลขและจำนวนเงินก่อนยืนยันทุกครั้ง รวมถึงไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น ไม่ว่าจะติดต่อผ่านช่องทางใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "แทงหวย",
  "ส่งโพย",
  "โพย",
  "รายการหวย",
  "รอบ",
  "หวยลาว",
  "หวยฮานอย",
  "รัฐบาลไทย",
  "เลข 2 ตัว",
  "เลข 3 ตัว",
  "เลขเด็ด",
  "เลขดัง",
  "แนวทางหวย",
  "อัตราจ่าย",
  "วงเงินรับแทง",
  "ผลรางวัล",
  "ประวัติโพย",
  "สมัคร 3 ขั้นตอน",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): brand-spec §2
// งานอาร์ตรอบนี้เป็นผ้าไหมแดงบนพื้นดำกับเหรียญทอง และโลโก้เป็นวงกลมแดงเลข 24
// คู่สีจริงจึงเป็น แดงแบรนด์ #d20a0a (สีหลัก) กับ ทองแบรนด์ #f5c33b (สีรอง)
// ไม่ใช่ทองโลหะ + ครีมอมพีชแบบ หวยคิง สองแผงถูกแยกด้วยคู่นั้นตรงๆ และจงใจให้ตรง
// กับ ContentBoxTwo ที่ครอบอยู่ ซึ่ง orchestrator รีธีมไว้ให้ป้ายคอลัมน์ซ้ายเป็น
// ทองและป้ายคอลัมน์ขวาเป็นแดง — แผงล็อกอิน (ซ้าย) จึงอยู่ในกรอบทองแบรนด์ ส่วน
// แผงรายการหวย (ขวา) อยู่ในกรอบแดงแบรนด์ ทั้งคู่วางบนผิวการ์ด #170707 ช่องกรอก
// และชิปตกลงไปที่พื้นลึกสุด #0a0303 บรรทัดเด่นไล่ทองสว่าง #ffd45e → ทองแบรนด์
// #f5c33b → แดงสว่าง #ff3b3b
//
// ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นโครงไม่ทึบ ขอบทอง
// #f5c33b/60 หมึกทองสว่าง #ffd45e ตามกฎคอนทราสต์ของ §2 ที่ว่าปุ่มรองคือขอบทอง/แดง
// บนพื้นดำอมแดง ไม่ใช่ถมทองอีกใบ ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบ
// ไม่ไล่เฉด ซึ่งต่างจากปุ่มสมัครสมาชิกพื้นไล่เฉดทองบนหน้าแรก
// ข้อความรองใช้สีเนื้อความ #f7e2d6 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
// เนื้อความ #f7e2d6 (= BRAND_TEXT) glow เป็น rgba(210,10,10,…) / rgba(245,195,59,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…))
// ออกครบทุกจุดแล้ว — รอบนี้สีหลักคือแดง ทองเป็นสีรอง ไม่ใช่การยกค่าเดิมมาเปลี่ยน
// แค่เบอร์
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการหวยที่ ${BRAND_NAME} เปิดรับ`}
  iconleft="🔐"
  iconright="🎟️"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหวยที่ระบบเปิดรับ ทั้งหวยลาว หวยฮานอย รัฐบาลไทย เลข 2 ตัว เลข 3 ตัว และจุดที่ควรตรวจสอบก่อนส่งโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f5c33b]/55 bg-[#170707]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f5c33b]/24 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd45e]/70 bg-gradient-to-br from-[#ffd45e] via-[#f5c33b] to-[#a9761a] text-xl text-[#1a0303] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffd45e]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f7e2d6]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แล้วเลือกหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่าย ยอดเดิมพัน ผลรางวัล และประวัติโพยจากบัญชีเดียวได้ทันที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7e2d6]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3d0a0a] bg-[#0a0303]/95 py-3 pr-4 pl-12 text-[#f7e2d6] transition-all outline-none placeholder:text-[#f7e2d6]/55 focus:border-[#f5c33b] focus:ring-1 focus:ring-[#ffd45e]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7e2d6]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3d0a0a] bg-[#0a0303]/95 py-3 pr-4 pl-12 text-[#f7e2d6] transition-all outline-none placeholder:text-[#f7e2d6]/55 focus:border-[#f5c33b] focus:ring-1 focus:ring-[#ffd45e]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f7e2d6]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3d0a0a] bg-[#0a0303] accent-[#d20a0a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f7e2d6]/75 transition-colors hover:text-[#ffd45e]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border-2 border-[#f5c33b]/60 bg-transparent p-3.5 text-center font-black text-[#ffd45e] transition-all hover:scale-[1.02] hover:border-[#f5c33b] hover:bg-[#f5c33b]/10">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f7e2d6]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#3d0a0a]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#3d0a0a]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3d0a0a] bg-[#0a0303] px-2.5 py-1 text-[10px] font-bold text-[#f7e2d6]"><span aria-hidden="true">🎟️</span> เลข 2 ตัว และเลข 3 ตัว</span>
            <span class="rounded-full border border-[#d20a0a]/50 bg-[#0a0303]/85 px-2.5 py-1 text-[10px] font-bold text-[#ff5c5c]"><span aria-hidden="true">📱</span> ส่งโพยผ่านมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5c33b] transition-colors hover:text-[#ffd45e]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d20a0a]/45 bg-[#170707]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f7e2d6]/75">
            {BRAND_NAME} รวบรวมหวยยอดนิยมหลายรายการไว้ในบัญชีเดียว ทั้งหวยลาว หวยฮานอย และรัฐบาลไทย เลือกเลขเองหรือเลือกเลขเด็ด เลขดัง แล้วตรวจสอบวงเงินกับอัตราจ่ายจากระบบก่อนส่งโพยทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#ffd45e] via-[#f5c33b] to-[#ff3b3b] bg-clip-text text-xl font-black text-transparent sm:text-2xl">2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#3d0a0a] bg-[#0a0303]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d20a0a] shadow-[0_0_8px_rgba(210,10,10,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffd45e] uppercase">ตามรอบที่ระบบเปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f7e2d6]/70 uppercase">
        <span>รายการที่เลือกแทงได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          betTypes.map((t) => (
            <div class="rounded-xl border border-[#3d0a0a] bg-[#0a0303]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c33b]/70 hover:bg-[#170707]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#ffd45e]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f7e2d6]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f7e2d6]/70">
        รายการและรอบหวยที่เปิดรับจริงเป็นไปตามที่เว็บไซต์กำหนด จึงควรตรวจสอบรายการล่าสุดบนหน้าส่งโพยก่อนยืนยันทุกครั้ง ส่วนแนวทางหวยและเลขดังเป็นข้อมูลประกอบเท่านั้น
        ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้ และหากใช้ข้อความว่าเรทจ่ายสูงที่สุด ควรมีข้อมูลเปรียบเทียบกับผู้ให้บริการรายอื่นที่ตรวจสอบได้ หากไม่มีข้อมูลดังกล่าว การใช้คำว่าเรทจ่ายสูงจะเหมาะสมกว่า
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f7e2d6]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนส่งโพย</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSlipChecks.map((k) => (
            <div class="rounded-xl border border-[#3d0a0a] bg-[#0a0303]/95 px-3.5 py-2.5 transition-colors hover:border-[#d20a0a]/60 hover:bg-[#170707]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e2d6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d20a0a]/55 bg-[#0a0303] px-2.5 py-0.5 text-[10px] font-bold text-[#ff5c5c]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f7e2d6]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3d0a0a] bg-[#0a0303] px-3 py-1 text-[10px] font-bold text-[#f7e2d6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f7e2d6]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการเลือกเลขและส่งโพยผ่านระบบบนมือถือ การติดตามรอบเปิดรับ อัตราจ่าย ผลรางวัล และประวัติโพยจากบัญชีเดียว และการสมัครผ่านมือถือใน 3 ขั้นตอน ส่วนอัตราจริงอาจแตกต่างตามประเภทหวย
        รูปแบบการแทง และรอบที่เลือก จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก ระบบเว็บไซต์เข้าใช้งานได้ 24 ชั่วโมง แต่เวลารับแทงจริงขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด
        24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
