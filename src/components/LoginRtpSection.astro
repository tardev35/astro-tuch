---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// PAOTUNG is a multi-game portal — รวมเกมออนไลน์ สล็อต บาคาร่า หวย มวย บอล ใน
// รูปแบบ Portal & Privilege แบบ One-Stop Service. Every row below stays inside
// what the brief states: เดิมพันเริ่มต้นเพียง 1 บาท ทุกค่ายเกม, เกมลิขสิทธิ์แท้
// ครบทุกค่าย, สล็อตกราฟิกระดับ Cinematic Lighting, บาคาร่าและคาสิโนสดจากโต๊ะ
// วีไอพีที่ส่งสัญญาณภาพสดจากคาสิโนชั้นนำ, หวยรัฐบาล หวยลาว หวยฮานอย ที่จ่ายเต็ม
// ไม่มีอั้น, เดิมพันกีฬา มวย และฟุตบอล ครบทุกลีก, โปรโมชั่นอัตโนมัติ 100% ที่
// ไม่ล็อคยูส, แนะนำเพื่อน 0.8% จากทุกยอดการเดิมพันของเพื่อน, คืนยอดเสีย 0.3% ใน
// ทุกยอดการเล่น, ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำ
// ตลอด 24 ชั่วโมง, การเข้าใช้งานได้ทั้ง iOS Android แท็บเล็ต และพีซี โดยไม่ต้อง
// โหลดแอปพลิเคชัน, และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// No licence number, no member count and no guaranteed payout — nothing here
// goes beyond what the brief itself says.
const menus = [
  {
    icon: "🏛️",
    name: "Portal & Privilege รวมทุกเกมในบัญชีเดียว",
    detail: "อาณาจักรความบันเทิงแบบครบวงจร (One-Stop Service) ที่รวบรวมเกมยอดฮิตจากทุกมุมโลกไว้ในเว็บเดียว ผ่านอินเทอร์เฟซโทนกรมท่าสลับลวดลายสีทองเมทัลลิค",
    tag: "One-Stop Service",
  },
  {
    icon: "🪙",
    name: "เดิมพันเริ่มต้นเพียง 1 บาท ทุกค่ายเกม",
    detail: "เปิดโอกาสให้ทุกคนเข้าถึงความสนุกได้ด้วยเดิมพันขั้นต่ำเพียง 1 บาทเท่านั้น ทุนหลักสิบก็นำมาต่อยอดได้ ทั้งสล็อต บาคาร่า และหวย",
    tag: "ขั้นต่ำ 1 บาท",
  },
  {
    icon: "🎰",
    name: "สล็อตออนไลน์ลิขสิทธิ์แท้ครบทุกค่าย",
    detail: "รวมค่ายสล็อตระดับโลกที่มาพร้อมภาพกราฟิกคมชัด จัดเต็มด้วยแสงเงาสมจริงแบบ Cinematic Lighting ให้ทุกการสปินตื่นตาตื่นใจ",
    tag: "Cinematic Lighting",
  },
  {
    icon: "🃏",
    name: "บาคาร่าและคาสิโนสดโต๊ะวีไอพี",
    detail: "สัมผัสบรรยากาศโต๊ะวีไอพีเสมือนจริง ส่งตรงสัญญาณภาพสดจากคาสิโนชั้นนำ เล่นง่าย จ่ายไว",
    tag: "ภาพสดจากคาสิโน",
  },
  {
    icon: "🎫",
    name: "หวยออนไลน์ รัฐบาล ลาว และฮานอย",
    detail: "รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล หวยลาว หวยฮานอย ให้อัตราจ่ายสูง จ่ายเต็มไม่มีอั้น",
    tag: "จ่ายเต็มไม่มีอั้น",
  },
  {
    icon: "⚽",
    name: "เดิมพันกีฬา มวย และฟุตบอลทุกลีก",
    detail: "อัปเดตราคาค่าน้ำดีที่สุด ครบทุกแมตช์ ทุกลีกดัง ให้คอกีฬาได้ลุ้นมันส์ทุกวินาที",
    tag: "ค่าน้ำดีที่สุด",
  },
  {
    icon: "🎁",
    name: "ตรวจสิทธิ์แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    detail: "เข้าสู่ระบบเพื่อคัดลอกลิงก์ส่วนตัวรับคอมมิชชั่นสูงถึง 0.8% จากทุกยอดการเดิมพันของเพื่อน และตรวจเครดิตคืนยอดเสีย 0.3% ในทุกยอดการเล่น",
    tag: "แจกทุกยูส ไม่ล็อค",
  },
  {
    icon: "💳",
    name: "ฝาก-ถอนอัตโนมัติ 3-5 วินาที ตลอด 24 ชม.",
    detail: "ระบบฝาก-ถอนเงินอัตโนมัติ (Auto) ทำรายการเสร็จสิ้นภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำ และทำรายการได้ด้วยตัวเองตลอด 24 ชั่วโมง",
    tag: "ออโต้ 3-5 วินาที",
  },
];

const chips = ["One-Stop Service", "เดิมพัน 1 บาท", "สล็อตลิขสิทธิ์แท้", "บาคาร่า-คาสิโนสด", "หวยรัฐบาล ลาว ฮานอย", "มวยและฟุตบอล", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "ออโต้ 3-5 วินาที", "Line 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ PAOTUNG"
  titleright="สิ่งที่สมาชิกได้รับจาก Portal ของ PAOTUNG"
  label="เข้าสู่ระบบ PAOTUNG และรายการสิทธิประโยชน์ที่สมาชิกได้รับจาก Portal หลัก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#226ca9]/55 bg-[#04203c]/92 p-6 shadow-[0_10px_30px_rgba(34,108,169,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3b9ddd]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#226ca9]/55 bg-gradient-to-br from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eef6fd]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#7fc4f0]">
            ล็อคอินเข้าสู่ Portal ของ PAOTUNG เพื่อเลือกเกมสล็อต บาคาร่า หวย และกีฬา ตรวจสิทธิ์แนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% เติมเครดิต และทำรายการฝาก-ถอนอัตโนมัติได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cfdeed]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#226ca9]/55 bg-[#020f1e]/95 py-3 pr-4 pl-12 text-[#cfdeed] transition-all outline-none placeholder:text-[#cfdeed]/45 focus:border-[#3b9ddd] focus:ring-1 focus:ring-[#3b9ddd]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#cfdeed]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#226ca9]/55 bg-[#020f1e]/95 py-3 pr-4 pl-12 text-[#cfdeed] transition-all outline-none placeholder:text-[#cfdeed]/45 focus:border-[#3b9ddd] focus:ring-1 focus:ring-[#3b9ddd]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfdeed]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#226ca9]/55 bg-[#020f1e] accent-[#226ca9]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfdeed] transition-colors hover:text-[#eef6fd]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#e0bd72]/60 bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] p-3.5 text-center font-black text-[#020f1e] shadow-[0_10px_30px_rgba(224,189,114,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(224,189,114,0.40)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cfdeed]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#226ca9]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#226ca9]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#226ca9]/45 bg-[#020f1e] px-2.5 py-1 text-[10px] font-bold text-[#7fc4f0]"><span aria-hidden="true">🎮</span> ครบทุกค่ายเกม</span>
            <span class="rounded-full border border-[#e0bd72]/45 bg-[#020f1e]/80 px-2.5 py-1 text-[10px] font-bold text-[#f5e3b3]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#7fc4f0] transition-colors hover:text-[#eef6fd]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#226ca9]/55 bg-[#04203c]/92 p-5 shadow-[0_10px_30px_rgba(34,108,169,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfdeed]">แพลตฟอร์มในรูปแบบ Portal &amp; Privilege ที่เชื่อมต่อทุกความบันเทิงไว้ในที่เดียว</span>
          <div class="bg-gradient-to-r from-[#f5e3b3] via-[#eef6fd] to-[#3b9ddd] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกเกมระดับลักชูรี</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#226ca9]/45 bg-[#0a325a]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#3b9ddd] shadow-[0_0_8px_rgba(59,157,221,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#7fc4f0] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cfdeed]/60 uppercase">
        <span>เกมและสิทธิประโยชน์ที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#226ca9]/55 bg-[#020f1e]/95 px-3.5 py-2.5 transition-colors hover:border-[#3b9ddd]/60 hover:bg-[#0a325a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfdeed]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e0bd72]/40 bg-[#020f1e] px-2.5 py-0.5 text-[10px] font-bold text-[#f5e3b3]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cfdeed]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#226ca9]/45 bg-[#020f1e] px-3 py-1 text-[10px] font-bold text-[#7fc4f0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cfdeed]/60">
        รายการข้างต้นสรุปสิ่งที่ PAOTUNG ประกาศไว้ ทั้งเกมลิขสิทธิ์แท้ครบทุกค่ายที่เดิมพันเริ่มต้นเพียง 1 บาท โปรโมชั่นอัตโนมัติ 100% ที่ไม่ล็อคยูส ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาที
        และโปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ส่วนขั้นต่ำของแต่ละเกม รอบคำนวณและเงื่อนไขของแต่ละโปรโมชั่น ให้ยึดข้อกำหนดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP
        ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
