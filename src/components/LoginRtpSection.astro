---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Every row below stays inside what the CAMPING289 brief states: เกมสล็อต
// หลากหลายรูปแบบให้เลือก, ข้อมูลกติกา ฟีเจอร์ และแนวทางการบริหารงบประมาณ,
// การ Login เพื่อตรวจสอบโปรโมชั่นและสิทธิพิเศษรายวัน, ช่องทางฝากเครดิตที่เปิด
// ให้บริการ, และรองรับเว็บเบราว์เซอร์ทั้ง Android และ iOS รวมถึงแท็บเล็ตและ
// คอมพิวเตอร์. No provider name appears here — the brief names none.
const menus = [
  { icon: "🎰", name: "หมวดเกมสล็อต", detail: "รวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว ตรวจสอบกติกาและอัตราเดิมพันได้จากหน้ารายละเอียดของแต่ละเกม", tag: "หลากหลายรูปแบบ" },
  { icon: "🔥", name: "เกมยอดนิยม", detail: "รวมเกมที่สมาชิกเปิดเล่นบ่อยไว้ในหมวดเดียว พร้อมรายละเอียดกติกาให้ดูก่อนเริ่มเดิมพัน", tag: "เปิดเล่นบ่อย" },
  { icon: "🆕", name: "เกมใหม่", detail: "เกมที่เพิ่งเปิดให้บริการ ตรวจสอบฟีเจอร์และเงื่อนไขของเกมได้ก่อนกดเข้าเล่น", tag: "อัปเดตต่อเนื่อง" },
  { icon: "🎁", name: "เกมที่มีฟีเจอร์โบนัส", detail: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว เงื่อนไขการเข้าฟีเจอร์แสดงไว้ในหน้าเกมแต่ละเกม", tag: "อ่านเงื่อนไขก่อน" },
  { icon: "📘", name: "คู่มือกติกาและเทคนิค", detail: "วิธีอ่านกติกา การทำความเข้าใจฟีเจอร์โบนัส การเลือกขนาดเดิมพัน และการกำหนดงบประมาณ", tag: "ไม่การันตีผลกำไร" },
  { icon: "🔍", name: "ค้นหาเกม", detail: "ค้นหาเกมตามชื่อหรือหมวดหมู่ และเปิดดูรายละเอียดของเกมได้ก่อนเข้าเล่นจริง", tag: "ดูก่อนเข้าเล่น" },
  { icon: "⚡", name: "ฝากถอนในระบบ", detail: "ตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการและสถานะรายการได้จากบัญชีของตนเอง", tag: "ตรวจสอบสถานะเอง" },
  { icon: "🎯", name: "สิทธิพิเศษรายวัน", detail: "ตรวจสอบยอดที่ใช้คำนวณ รอบการรับ และเงื่อนไขของแต่ละกิจกรรมให้ครบก่อนกดรับสิทธิ์", tag: "ตามเงื่อนไขแต่ละรายการ" },
];

const chips = ["เกมสล็อต", "เกมยอดนิยม", "เกมใหม่", "ฟีเจอร์โบนัส", "คู่มือกติกา", "ฝากถอนในระบบ", "แอดมิน LINE 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ CAMPING289"
  titleright="หมวดเกมสล็อตและบริการที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ CAMPING289 และหมวดเกมสล็อตออนไลน์ที่เปิดให้บริการทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#2f7a2a]/70 bg-[#072a13]/92 p-6 shadow-[0_10px_30px_rgba(105,181,34,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#69b522]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#69b522]/55 bg-gradient-to-br from-[#9ada4e] via-[#69b522] to-[#0b5232] text-xl shadow-inner">
          🏕️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eefae4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#dbaa8a]/80">เข้าสู่ระบบ CAMPING289 ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbaa8a]/80">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2f7a2a] bg-[#04120a]/95 py-3 pr-4 pl-12 text-[#d6e6cc] transition-all outline-none placeholder:text-[#dbaa8a]/60 focus:border-[#69b522] focus:ring-1 focus:ring-[#69b522]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#dbaa8a]/80">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2f7a2a] bg-[#04120a]/95 py-3 pr-4 pl-12 text-[#d6e6cc] transition-all outline-none placeholder:text-[#dbaa8a]/60 focus:border-[#69b522] focus:ring-1 focus:ring-[#69b522]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d6e6cc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2f7a2a] bg-[#04120a] accent-[#69b522]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d6e6cc] transition-colors hover:text-[#b6e87a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#9ada4e]/50 bg-gradient-to-r from-[#9ada4e] via-[#69b522] to-[#0b5232] p-3.5 text-center font-black text-[#020a05] shadow-[0_10px_30px_rgba(105,181,34,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(105,181,34,0.38)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dbaa8a]/80">
          <span class="h-px flex-1 bg-[#2f7a2a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2f7a2a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2f7a2a]/80 bg-[#04120a] px-2.5 py-1 text-[10px] font-bold text-[#eefae4]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#69b522]/35 bg-[#04120a]/80 px-2.5 py-1 text-[10px] font-bold text-[#d6e6cc]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#eefae4] transition-colors hover:text-[#b6e87a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#69b522]/30 bg-[#072a13]/92 p-5 shadow-[0_10px_30px_rgba(105,181,34,0.12)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d6e6cc]">รองรับทุกอุปกรณ์ เข้าใช้งานได้สะดวกตลอดทั้งวัน</span>
          <div class="bg-gradient-to-r from-[#69b522] via-[#eefae4] to-[#dbaa8a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">Android • iOS • เว็บ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#22c55e]/45 bg-[#052e16]/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#86efac] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dbaa8a]/80 uppercase">
        <span>หมวดเกมสล็อต / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2f7a2a] bg-[#04120a]/95 px-3.5 py-2.5 transition-colors hover:border-[#69b522]/60 hover:bg-[#0b2415]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d6e6cc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#2f7a2a]/80 bg-[#04120a] px-2.5 py-0.5 text-[10px] font-bold text-[#eefae4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d6e6cc]/85">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#69b522]/30 bg-[#04120a] px-3 py-1 text-[10px] font-bold text-[#eefae4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dbaa8a]/80">
        สมาชิกสามารถเข้าสู่ระบบผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม พร้อมปรับการแสดงผลให้เหมาะกับทุกขนาดหน้าจอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
