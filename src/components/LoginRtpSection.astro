---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "ผู้ให้บริการระบบพนันออนไลน์ที่รวมเกมหลายประเภทไว้ในระบบเดียว
// จากบริษัทหลักโดยตรง" ตารางฝั่งขวาจึงเป็นหมวดเกมกับรายการที่ brief ระบุไว้เอง
// ทุกแถวอ้างจากประโยคของ brief ล้วนๆ — บาคาร่า สล็อต หวย บอล ไฮโล ผ่านบัญชีเดียว,
// รองรับมือถือและคอมพิวเตอร์, เมนูจัดหมวดหมู่ชัดเจนและเข้าถึงง่าย, ตรวจสอบ
// รายละเอียดเกมและค่ายที่เปิดให้บริการก่อนเข้าเล่น, โปรโมชั่นที่กดรับหลังสมัครได้
// ตามเงื่อนไข, โบนัสแนะนำเพื่อน 0.8%, โบนัสคืนยอดเสีย 0.3%, ฝากถอนผ่านวอลเลทและ
// ธนาคารที่เว็บไซต์กำหนด, ตรวจสอบยอดเครดิตและสถานะรายการผ่านบัญชีตัวเอง และ
// ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ไม่มีแถวไหนคิดชื่อค่าย จำนวนเกม ค่า RTP
// อัตราจ่าย ใบอนุญาต หรือจำนวนสมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
const catalogue = [
  {
    icon: "🃏",
    name: "บาคาร่า",
    detail: "หนึ่งในหมวดเกมที่เปิดให้เลือกเล่นผ่านบัญชีเดียว ตรวจสอบรายละเอียดของแต่ละรายการได้ก่อนเข้าเล่น",
    rate: "บัญชีเดียว",
  },
  {
    icon: "🎰",
    name: "สล็อต",
    detail: "เลือกจากหมวดสล็อตที่จัดไว้ในเมนู พร้อมดูค่ายที่เปิดให้บริการก่อนตัดสินใจเข้าเล่น",
    rate: "แบ่งหมวดชัดเจน",
  },
  {
    icon: "🎫",
    name: "หวย",
    detail: "อยู่ในชุดเกมเดียวกับบาคาร่า สล็อต บอล และไฮโล เข้าใช้งานจากบัญชีเดิมโดยไม่ต้องเปิดระบบใหม่",
    rate: "ระบบเดียว",
  },
  {
    icon: "⚽",
    name: "บอล",
    detail: "เลือกได้จากเมนูที่จัดหมวดหมู่ไว้ชัดเจน ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์",
    rate: "ทุกอุปกรณ์",
  },
  {
    icon: "🎲",
    name: "ไฮโล",
    detail: "อีกหนึ่งหมวดที่ระบบเปิดให้เลือก ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการได้ก่อนเข้าเล่น",
    rate: "ตรวจก่อนเล่น",
  },
  {
    icon: "🎁",
    name: "สิทธิ์ที่กดรับหลังสมัครได้",
    detail: "โปรโมชั่นบางรายการสามารถตรวจสอบและกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด ควรอ่านรายละเอียดของแต่ละรายการก่อนรับ",
    rate: "ตามเงื่อนไข",
  },
  {
    icon: "👥",
    name: "โบนัสแนะนำเพื่อน",
    detail: "สมาชิกที่แนะนำเพื่อนเข้ามาสมัครรับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม ตรวจสอบยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ผ่านบัญชีสมาชิกได้",
    rate: "0.8%",
  },
  {
    icon: "↩️",
    name: "โบนัสคืนยอดเสีย",
    detail: "ให้โบนัส 0.3% ตามยอดและเงื่อนไขที่กำหนด ตรวจสอบรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับได้จากหน้าโปรโมชั่น",
    rate: "0.3%",
  },
  {
    icon: "💳",
    name: "ฝากถอนวอลเลทและธนาคาร",
    detail: "รองรับช่องทางฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด เลือกช่องทางที่สะดวกได้จากหน้าเว็บไซต์",
    rate: "ตามที่เว็บกำหนด",
  },
  {
    icon: "💬",
    name: "แอดมินดูแลตลอดเวลา",
    detail: "ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทีมงานช่วยตรวจสอบข้อมูลและแนะนำขั้นตอนตามปัญหาที่แจ้ง",
    rate: "24 ชั่วโมง",
  },
];

const chips = [
  "บาคาร่า",
  "สล็อต",
  "หวย",
  "บอล",
  "ไฮโล",
  "บัญชีเดียวครบ",
  "จากบริษัทหลักโดยตรง",
  "มือถือและคอมพิวเตอร์",
  "เมนูจัดหมวดชัดเจน",
  "แนะนำเพื่อน 0.8%",
  "คืนยอดเสีย 0.3%",
  "แอดมิน 24 ชั่วโมง",
];

// THE88 palette (แดง-ทอง): ทั้งสองแผงวางบนพื้นการ์ดแดงเข้ม #2d0908 เหนือพื้นเพจ
// #1c0504 แผงล็อกอินอยู่ในกรอบแดงแบรนด์ #a40201 ส่วนแผงรายการอยู่ในกรอบแดงเข้ม
// #6b0302 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไปที่พื้นเพจในเส้น
// แดงเข้ม ตัวเน้นที่เป็นตัวเลขรับทองโลโก้ #f2c14e ตามเลข 88 บนโลโก้ที่เป็นครีม
// ขอบทอง ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`หมวดเกมและรายการที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการหมวดเกมบาคาร่า สล็อต หวย บอล ไฮโล พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a40201]/40 bg-[#2d0908]/94 p-6 shadow-[0_10px_30px_rgba(28,5,4,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a40201]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a40201]/70 bg-gradient-to-br from-[#dd0503] via-[#a40201] to-[#6b0302] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe7a6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f7e3dd]/70">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกเล่นบาคาร่า สล็อต หวย บอล และไฮโล ผ่านบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมเมนูที่จัดหมวดหมู่ไว้ชัดเจน
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7e3dd]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b0302] bg-[#1c0504]/95 py-3 pr-4 pl-12 text-[#f7e3dd] transition-all outline-none placeholder:text-[#f7e3dd]/50 focus:border-[#a40201] focus:ring-1 focus:ring-[#f2c14e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7e3dd]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b0302] bg-[#1c0504]/95 py-3 pr-4 pl-12 text-[#f7e3dd] transition-all outline-none placeholder:text-[#f7e3dd]/50 focus:border-[#a40201] focus:ring-1 focus:ring-[#f2c14e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f7e3dd]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b0302] bg-[#1c0504] accent-[#a40201]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f7e3dd]/70 transition-colors hover:text-[#f2c14e]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffe7a6]/70 bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] p-3.5 text-center font-black text-[#1c0504] shadow-[0_10px_30px_rgba(242,193,78,0.5)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,231,166,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f7e3dd]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b0302]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6b0302]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b0302] bg-[#1c0504] px-2.5 py-1 text-[10px] font-bold text-[#f7e3dd]"><span aria-hidden="true">🃏</span> ห้าหมวดในบัญชีเดียว</span>
            <span class="rounded-full border border-[#f2c14e]/50 bg-[#1c0504]/85 px-2.5 py-1 text-[10px] font-bold text-[#f2c14e]"><span aria-hidden="true">🏢</span> จากบริษัทหลักโดยตรง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe7a6] transition-colors hover:text-[#f2c14e]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b0302]/55 bg-[#2d0908]/94 p-5 shadow-[0_10px_30px_rgba(28,5,4,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f7e3dd]/70">รวมเกมหลายประเภทไว้ในระบบเดียว เข้าเล่นผ่านบัญชีเดียวได้ทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#6b0302] bg-[#1c0504]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f2c14e] shadow-[0_0_8px_rgba(242,193,78,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffe7a6] uppercase">บริษัทหลัก</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f7e3dd]/70 uppercase">
        <span>รายการที่เปิดให้ใช้งานและเงื่อนไขที่เว็บระบุ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          catalogue.map((m) => (
            <div class="rounded-xl border border-[#6b0302] bg-[#1c0504]/95 px-3.5 py-2.5 transition-colors hover:border-[#a40201]/70 hover:bg-[#2d0908]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e3dd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f2c14e]/45 bg-[#1c0504] px-2.5 py-0.5 text-[10px] font-bold text-[#f2c14e]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f7e3dd]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b0302] bg-[#1c0504] px-3 py-1 text-[10px] font-bold text-[#f7e3dd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f7e3dd]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมบาคาร่า สล็อต หวย บอล และไฮโลไว้ในบัญชีเดียว เมนูที่จัดหมวดหมู่ชัดเจน ช่องทางฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3%
        ส่วนรายการเกม ค่ายที่เปิดให้บริการ รอบคำนวณ ยอดที่เข้าเกณฑ์ และข้อกำหนดของแต่ละโปรโมชั่นอาจมีการอัปเดตตามช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมเกมและหน้าโปรโมชั่น และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
