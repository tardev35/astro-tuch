---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// UVO88 is a multi-product casino — บาคาร่า เกมไพ่ สล็อตออนไลน์ หวยออนไลน์ และ
// การเดิมพันฟุตบอล inside ONE account. Every row below stays inside what the
// brief states: การสลับประเภทเกมโดยไม่ต้องสมัครหลายบัญชี, การใช้งานผ่านมือถือ
// แท็บเล็ต และคอมพิวเตอร์, การตรวจสอบเครดิต ฝากถอน โปรโมชั่น และประวัติรายการ
// จากหน้าเว็บไซต์, โบนัสแนะนำเพื่อน 0.8% ตามยอดที่เข้าเงื่อนไข, โบนัสคืนยอดเสีย
// 0.3% ตามรอบที่กำหนด, และแอดมินที่ให้บริการได้ตลอด 24 ชั่วโมง.
// No licence, no member count and no guaranteed payout — the brief says ควร
// ตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของแต่ละเกมก่อนเริ่ม, ว่าผลลัพธ์ของ
// เกมรับประกันกำไรหรือผลชนะไม่ได้, และว่าคำว่า "ไม่มีขั้นต่ำ" ต้องยึดตัวเลขที่เกม
// หรือระบบแสดง ณ เวลาทำรายการ.
const menus = [
  {
    icon: "🃏",
    name: "บาคาร่าออนไลน์",
    detail: "หมวดบาคาร่าที่ระบบเปิดให้บริการ ดูกติกา อัตราจ่าย และช่วงเดิมพันของโต๊ะนั้นได้ก่อนลงเงินทุกครั้ง",
    tag: "ดูอัตราจ่าย",
  },
  {
    icon: "♠️",
    name: "เกมไพ่ในหมวดคาสิโน",
    detail: "เกมไพ่หมวดคาสิโนหลายรูปแบบ เงื่อนไขและวงเงินของแต่ละเกมกำหนดไว้ไม่เท่ากัน ควรอ่านกติกาให้ครบก่อนเริ่มเดิมพัน",
    tag: "ตามกติกาเกม",
  },
  {
    icon: "🎰",
    name: "สล็อตออนไลน์จากหลายค่าย",
    detail: "สล็อตออนไลน์จากค่ายที่ระบบเปิดให้บริการ รายการที่เปิดให้เล่นในแต่ละช่วงเปลี่ยนแปลงได้ ให้ยึดหน้าเลือกเกมเป็นหลัก",
    tag: "หลายค่าย",
  },
  {
    icon: "🎫",
    name: "หวยออนไลน์ตามรอบที่เปิดรับ",
    detail: "หวยออนไลน์เปิดรับตามรอบที่ระบบกำหนด รายการและเวลาปิดรับของแต่ละรอบต่างกัน ให้ยึดข้อมูลที่หน้าแทงแสดง ณ เวลาทำรายการ",
    tag: "ตามรอบที่เปิด",
  },
  {
    icon: "⚽",
    name: "เดิมพันฟุตบอลตามรายการแข่ง",
    detail: "เดิมพันฟุตบอลตามรายการแข่งขันที่เปิดให้บริการ ควรตรวจสอบรูปแบบการเดิมพัน อัตราจ่าย และวงเงินของคู่นั้นก่อนยืนยัน",
    tag: "ตรวจก่อนยืนยัน",
  },
  {
    icon: "📱",
    name: "ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอม",
    detail: "รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน และตรวจสอบรายการได้จากหน้าเว็บไซต์เดียวกัน",
    tag: "ทุกอุปกรณ์",
  },
  {
    icon: "🎁",
    name: "Login ตรวจโบนัสที่มีสิทธิ์รับ",
    detail: "เข้าสู่ระบบเพื่อดูโปรโมชั่นที่มีสิทธิ์รับ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยควรตรวจสอบวิธีคำนวณและข้อกำหนดก่อนกดรับ",
    tag: "0.8% และ 0.3%",
  },
  {
    icon: "💳",
    name: "ฝากถอนและตรวจสอบเครดิตเอง",
    detail: "เติมเครดิต ส่งคำขอถอน และตรวจสอบเครดิตกับประวัติรายการผ่านบัญชีสมาชิกได้เอง ก่อนยืนยันควรดูยอดขั้นต่ำของช่องทางที่เลือก",
    tag: "ทำรายการเอง",
  },
];

const chips = ["บาคาร่า", "เกมไพ่", "สล็อตออนไลน์", "หวยออนไลน์", "ฟุตบอล", "บัญชีเดียว", "แนะนำเพื่อน 0.8%", "คืนยอดเสีย 0.3%", "แอดมิน 24 ชม."];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ UVO88" titleright="จุดที่ควรตรวจสอบก่อนเดิมพันและก่อนกดรับโบนัส" label="เข้าสู่ระบบ UVO88 และรายการจุดที่ควรตรวจสอบก่อนเริ่มเดิมพัน">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0a3b1c]/55 bg-[#051a0e]/92 p-6 shadow-[0_10px_30px_rgba(15,157,71,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0f9d47]/28 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f2c230]/50 bg-gradient-to-br from-[#57dd8f] via-[#0f9d47] to-[#116330] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f3fbf5]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#57dd8f]">
            เข้าสู่ระบบ UVO88 เพื่อเลือกหมวดเกมทั้งบาคาร่า ไพ่ สล็อต หวย และบอลผ่านบัญชีเดียว ตรวจสอบเครดิต ดูโปรโมชั่นที่มีสิทธิ์รับ และจัดการฝากถอนได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c8e3d0]/55">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0a3b1c]/55 bg-[#03110a]/95 py-3 pr-4 pl-12 text-[#c8e3d0] transition-all outline-none placeholder:text-[#c8e3d0]/45 focus:border-[#0f9d47] focus:ring-1 focus:ring-[#0f9d47]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c8e3d0]/55">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0a3b1c]/55 bg-[#03110a]/95 py-3 pr-4 pl-12 text-[#c8e3d0] transition-all outline-none placeholder:text-[#c8e3d0]/45 focus:border-[#0f9d47] focus:ring-1 focus:ring-[#0f9d47]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c8e3d0]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0a3b1c]/55 bg-[#03110a] accent-[#0f9d47]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c8e3d0] transition-colors hover:text-[#f3fbf5]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#0a3b1c]/60 bg-gradient-to-r from-[#57dd8f] via-[#0f9d47] to-[#116330] p-3.5 text-center font-black text-[#03110a] shadow-[0_10px_30px_rgba(15,157,71,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(87,221,143,0.35)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c8e3d0]/55">
          <span aria-hidden="true" class="h-px flex-1 bg-[#0a3b1c]/50"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#0a3b1c]/50"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f2c230]/40 bg-[#03110a] px-2.5 py-1 text-[10px] font-bold text-[#f2c230]"><span aria-hidden="true">🃏</span> ครบทุกการเดิมพัน</span>
            <span class="rounded-full border border-[#0a3b1c]/50 bg-[#03110a]/80 px-2.5 py-1 text-[10px] font-bold text-[#57dd8f]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#57dd8f] transition-colors hover:text-[#f3fbf5]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0a3b1c]/55 bg-[#051a0e]/92 p-5 shadow-[0_10px_30px_rgba(15,157,71,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c8e3d0]">สลับหมวดเกมได้จากบัญชีเดียว และตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินที่ระบบแสดงก่อนยืนยันทุกครั้ง</span>
          <div class="bg-gradient-to-r from-[#57dd8f] via-[#f3fbf5] to-[#f2c230] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">บัญชีเดียว ครบทุกการเดิมพันที่ระบบเปิด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#f2c230]/45 bg-[#0b2c17]/80 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f2c230] shadow-[0_0_8px_rgba(242,194,48,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f2c230] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c8e3d0]/60 uppercase">
        <span>หมวดเดิมพัน โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0a3b1c]/70 bg-[#03110a]/95 px-3.5 py-2.5 transition-colors hover:border-[#f2c230]/45 hover:bg-[#0b2c17]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#c8e3d0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f2c230]/40 bg-[#03110a] px-2.5 py-0.5 text-[10px] font-bold text-[#f2c230]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c8e3d0]/65">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0a3b1c]/45 bg-[#03110a] px-3 py-1 text-[10px] font-bold text-[#57dd8f]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c8e3d0]/60">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเดิมพัน แต่ละเกมและผู้ให้บริการอาจกำหนดกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินไม่เท่ากัน ให้ยึดรายละเอียดที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ส่วนวิธีคำนวณ
        รอบรับโบนัส และประเภทเกมที่ร่วมรายการของโปรโมชั่น 0.8% และ 0.3% ควรยึดข้อกำหนดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
