---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บหวย "รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ จ่ายเต็ม
// ไม่อั้นเลข" ตารางฝั่งขวาจึงเป็นรายการตลาดกับอัตราจ่ายของ brief เอง ไม่ใช่ตาราง
// RTP ของค่ายสล็อตอย่างรอบก่อน (ซึ่งนอกเรื่องสำหรับแบรนด์หวย) ทุกแถวอ้างจาก
// ประโยคของ brief ล้วนๆ — สี่ตลาดที่เปิดรับ, เลข 2 ตัวอัตราจ่าย 100, เลข 3 ตัว
// อัตราจ่าย 1,000, เปิดรับทุกเลขเด็ดเลขดังไม่อั้นเลข, แสดงอัตราจ่ายไว้ชัดเจนก่อน
// ยืนยันรายการ, ตรวจสอบรอบหวยและประเภทบิลได้จากหน้าเดียว, สมัครเองได้ใน 3 ขั้นตอน
// และแอดมินออนไลน์ 24 ชั่วโมง ไม่มีแถวไหนคิดวันออกรางวัล ใบอนุญาต หรือจำนวน
// สมาชิกขึ้นมาเอง — brief ไม่ได้ระบุไว้
const markets = [
  {
    icon: "🏛️",
    name: "หวยรัฐบาลไทย",
    detail: "หนึ่งในรายการที่หวยพยัคฆ์รวมไว้ในระบบเดียว เลือกดูรอบที่เปิดรับและตรวจสอบเลขที่ต้องการก่อนยืนยันได้จากหน้าเดียว",
    rate: "เปิดรับ",
  },
  {
    icon: "🏮",
    name: "หวยฮานอย",
    detail: "รายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา ตรวจสอบรอบล่าสุดได้จากหน้ารวมหวยก่อนทำรายการ",
    rate: "เปิดรับ",
  },
  {
    icon: "🎫",
    name: "หวยลาวพัฒนา",
    detail: "เปิดรับผ่านหน้าเดียวกับตลาดอื่น เลือกประเภทการแทงและตรวจสอบรายละเอียดของบิลได้ก่อนส่งรายการ",
    rate: "เปิดรับ",
  },
  {
    icon: "📈",
    name: "หวยหุ้นต่างประเทศ",
    detail: "รวมอยู่ในระบบเดียวกัน เหมาะกับคนที่ต้องการติดตามหวยหลายประเภทโดยไม่ต้องสลับหลายเว็บไซต์",
    rate: "เปิดรับ",
  },
  {
    icon: "2️⃣",
    name: "เลข 2 ตัว",
    detail: "ระบุอัตราจ่ายไว้ที่ 100 ตามเงื่อนไขของแต่ละรายการ เลือกเลข ตรวจสอบรอบเปิดรับ และเช็กรายละเอียดของบิลก่อนยืนยันได้",
    rate: "จ่าย 100",
  },
  {
    icon: "3️⃣",
    name: "เลข 3 ตัว",
    detail: "ระบุอัตราจ่ายไว้ที่ 1,000 ตามเงื่อนไขของระบบ ก่อนยืนยันตรวจสอบเลข ประเภทหวย รอบเวลา และรายละเอียดของรายการได้อีกครั้ง",
    rate: "จ่าย 1,000",
  },
  {
    icon: "🔢",
    name: "เลขเด็ด เลขดัง ไม่อั้นเลข",
    detail: "เปิดให้เลือกเลขเด็ดและเลขดังจากหลายรายการตามรอบที่ระบบกำหนด ตรวจสอบเลขที่เปิดรับและประเภทการแทงได้ทุกครั้งก่อนยืนยัน",
    rate: "ไม่อั้นเลข",
  },
  {
    icon: "📋",
    name: "อัตราจ่ายแสดงก่อนยืนยัน",
    detail: "แสดงอัตราจ่ายของแต่ละประเภทเลขไว้อย่างชัดเจนก่อนยืนยันรายการ ทั้งเลข 2 ตัวและเลข 3 ตัว",
    rate: "ดูก่อนแทง",
  },
  {
    icon: "🗂️",
    name: "รอบหวยและประเภทบิล",
    detail: "ตรวจสอบอัตรา รอบหวย และประเภทบิลได้จากหน้าเดียว ช่วยให้เปรียบเทียบรายละเอียดและเลือกวิธีแทงที่เหมาะกับเลขที่ต้องการ",
    rate: "หน้าเดียวจบ",
  },
  {
    icon: "📝",
    name: "สมัครเองได้ใน 3 ขั้นตอน",
    detail: "กรอกข้อมูลในหน้าสมัคร ตรวจสอบรายละเอียดให้ถูกต้อง แล้วกดยืนยันบัญชี จากนั้นเข้าสู่ระบบเพื่อเลือกรายการหวยได้ทันที",
    rate: "3 ขั้นตอน",
  },
  {
    icon: "💬",
    name: "แอดมินออนไลน์ 24 ชั่วโมง",
    detail: "สอบถามได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร รอบหวย อัตราจ่าย วิธีเลือกเลข หรือการใช้งานเมนูภายในเว็บไซต์",
    rate: "24 ชม.",
  },
];

const chips = [
  "รัฐบาลไทย",
  "ฮานอย",
  "ลาวพัฒนา",
  "หวยหุ้นต่างประเทศ",
  "2 ตัวจ่าย 100",
  "3 ตัวจ่าย 1,000",
  "เลขเด็ด เลขดัง",
  "ไม่อั้นเลข",
  "จ่ายเต็ม",
  "ดูรอบที่เปิดรับ",
  "สมัคร 3 ขั้นตอน",
  "แอดมิน 24 ชั่วโมง",
];

// หวยพยัคฆ์ palette (กรมท่า-ทอง): ทั้งสองแผงวางบนพื้นการ์ด #08152f เหนือพื้นเพจ
// กรมท่าเข้ม #030b1c แผงล็อกอินอยู่ในกรอบทองหลัก #fadb6c ส่วนแผงรายการตลาดอยู่ใน
// กรอบทองบรอนซ์ #ab6d13 — แยกสองแผงด้วยความสว่างของกรอบ ช่องกรอกและชิปตกลงไป
// ที่พื้นยก #0f2149 ในเส้นน้ำเงินคั่น #1c3566 ปุ่ม LINE ยังคงสีเขียวของแพลตฟอร์ม
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`ตลาดหวยและอัตราจ่ายที่ ${BRAND_NAME} ระบุไว้`}
  label={`เข้าสู่ระบบ ${BRAND_NAME} และรายการตลาดหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ พร้อมอัตราจ่ายเลข 2 ตัวและเลข 3 ตัวที่เว็บระบุไว้`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#fadb6c]/40 bg-[#08152f]/94 p-6 shadow-[0_10px_30px_rgba(3,11,28,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fadb6c]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fadb6c]/70 bg-gradient-to-br from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] text-xl shadow-inner">
          🐅
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf5a4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9fb0d0]">
            ล็อคอินเข้า {BRAND_NAME} เพื่อเลือกรายการหวยที่เปิดรับ ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ ตรวจสอบรอบหวย อัตราจ่าย และรายละเอียดของบิลก่อนยืนยันรายการได้จากหน้าเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9fb0d0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1c3566] bg-[#030b1c]/95 py-3 pr-4 pl-12 text-[#dbe4f7] transition-all outline-none placeholder:text-[#9fb0d0]/70 focus:border-[#fadb6c] focus:ring-1 focus:ring-[#fdf5a4]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9fb0d0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1c3566] bg-[#030b1c]/95 py-3 pr-4 pl-12 text-[#dbe4f7] transition-all outline-none placeholder:text-[#9fb0d0]/70 focus:border-[#fadb6c] focus:ring-1 focus:ring-[#fdf5a4]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9fb0d0]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1c3566] bg-[#030b1c] accent-[#fadb6c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9fb0d0] transition-colors hover:text-[#fdf5a4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fdf5a4]/70 bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] p-3.5 text-center font-black text-[#030b1c] shadow-[0_10px_30px_rgba(250,219,108,0.38)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,245,164,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9fb0d0]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#1c3566]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#1c3566]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#1c3566] bg-[#030b1c] px-2.5 py-1 text-[10px] font-bold text-[#dbe4f7]"><span aria-hidden="true">🎫</span> ครบทุกประเภท</span>
            <span class="rounded-full border border-[#fadb6c]/50 bg-[#030b1c]/85 px-2.5 py-1 text-[10px] font-bold text-[#fdf5a4]"><span aria-hidden="true">💯</span> ไม่อั้นเลข</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdf5a4] transition-colors hover:text-[#fadb6c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ab6d13]/55 bg-[#08152f]/94 p-5 shadow-[0_10px_30px_rgba(3,11,28,0.6)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9fb0d0]">แทงหวย อันดับ1 ครบทุกประเภท</span>
          <div class="bg-gradient-to-r from-[#e8eef8] via-[#fadb6c] to-[#fdf5a4] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#1c3566] bg-[#030b1c]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fadb6c] shadow-[0_0_8px_rgba(250,219,108,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fdf5a4] uppercase">จ่ายเต็ม</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9fb0d0] uppercase">
        <span>รายการที่เปิดรับและเงื่อนไขที่เว็บระบุ</span>
        <span>อัตราจ่าย</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          markets.map((m) => (
            <div class="rounded-xl border border-[#1c3566] bg-[#0f2149]/95 px-3.5 py-2.5 transition-colors hover:border-[#fadb6c]/70 hover:bg-[#08152f]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe4f7]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fdf5a4]/45 bg-[#030b1c] px-2.5 py-0.5 text-[10px] font-bold text-[#fdf5a4]">{m.rate}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9fb0d0]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1c3566] bg-[#030b1c] px-3 py-1 text-[10px] font-bold text-[#dbe4f7]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9fb0d0]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งตลาดหวยที่รวมไว้ในระบบเดียว อัตราจ่ายเลข 2 ตัวที่ 100 และเลข 3 ตัวที่ 1,000 และการแสดงอัตราจ่ายไว้ก่อนยืนยันรายการ
        ส่วนรอบที่เปิดรับ ประเภทบิล และเงื่อนไขของแต่ละรายการอาจแตกต่างกันตามวันและช่วงเวลา ให้ยึดรายละเอียดล่าสุดที่ปรากฏในหน้ารวมหวย และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
