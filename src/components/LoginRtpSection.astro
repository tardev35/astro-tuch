---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่เว็บบอลและไม่ใช่เว็บสล็อต แผงฝั่งขวารอบนี้ถูกเขียนใหม่
// ทั้งแผงจากคำของบรีฟรอบนี้เอง คือ แนวทางหวย · กลุ่มหวย · สถิติหวยย้อนหลัง · ผลหวยตามรอบ
// ที่ประกาศ — รัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยหลายรอบ หวยลาวพัฒนา และหวยหุ้น
// ต่างประเทศตามตลาดที่เปิดให้บริการ ส่วนแผง "จุดที่ควรตรวจก่อนยืนยันโพย" ประกอบจากประโยค
// เตือนของบรีฟล้วนๆ คือ สถิติและแนวทางเป็นข้อมูลประกอบที่รับประกันงวดถัดไปไม่ได้,
// ตารางหวยกับเวลาเปิดรับ/ปิดรับ, อัตราจ่ายที่ให้ยึดจากหน้าส่งโพย และวงเงินที่แต่ละรายการ
// กำหนดต่างกัน
//
// ไฟล์นี้เคยเป็นตาราง RTP/ความผันผวน ซึ่งเป็นศัพท์ของเว็บสล็อต ไม่ใช่ของเว็บหวย — ป้าย
// ทุกใบเป็นศัพท์หวยทั้งหมด และคำว่า RTP ไม่เหลืออยู่ในไฟล์นี้แล้ว
//
// รอบก่อน (หวยเฮง789) แผงนี้ขายมุม "เลขเด็ด / เลขดัง" กับ "ไม่จำกัด / แทงได้ไม่อั้น" และ
// รอบก่อนหน้านั้น (หวยเฮง24) ขาย "ฝากถอนวอลเลทและธนาคาร" กับ "เช็คผลทันที" — บรีฟรอบนี้
// ไม่ได้เขียนมุมไหนไว้เลย ทั้งหมดจึงถูกถอดออก ไม่ใช่เขียนใหม่ด้วยชื่อแบรนด์ใหม่ และบรีฟรอบนี้
// เขียน "หวยลาวพัฒนา" ไม่ใช่ "หวยลาว" เฉยๆ
// ห้ามใส่ตารางเวลาออกรางวัลจริง เลขงวดจริง ตัวเลขอัตราจ่ายรายประเภท ชื่อเจ้ามือ ชื่อธนาคาร
// เลขใบอนุญาต ยอดฝากขั้นต่ำ หรือจำนวนสมาชิกลงในไฟล์นี้ — บรีฟไม่ได้ให้ไว้เลยสักอย่าง และ
// ตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีเท่าที่
// บรีฟระบุ คือ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · 24 ชั่วโมง
const lotteryMarkets = [
  { icon: "🇹🇭", name: "หวยรัฐบาลไทย", detail: "เปิดรับตามกำหนดออกรางวัลของแต่ละงวด ควรดูตารางหวยและเวลาปิดรับของรอบนั้นก่อนเลือกตัวเลข" },
  { icon: "🕐", name: "หวยฮานอย", detail: "เปิดรับหลายรอบตามที่ระบบกำหนดในแต่ละวัน จึงควรตรวจชื่อรายการและรอบให้ตรงกันก่อนส่งโพย" },
  { icon: "🌙", name: "หวยลาวพัฒนา", detail: "เปิดรับตามรอบที่ระบบกำหนด โดยแต่ละรอบมีเวลาปิดรับและเงื่อนไขของตัวเอง" },
  { icon: "📈", name: "หวยหุ้นต่างประเทศ", detail: "เปิดรับตามตลาดที่เปิดให้บริการ จึงควรตรวจชื่อรายการและรอบเวลาให้ตรงกันก่อนส่งโพย" },
];

// สี่ข้อนี้ประกอบจากประโยคเตือนของบรีฟเองทั้งหมด — แนวทางหวยกับสถิติย้อนหลังเป็นข้อมูล
// ประกอบที่รับประกันผลงวดถัดไปไม่ได้, ตารางหวยกับเวลาเปิดรับ/ปิดรับต่างกันในแต่ละประเภท,
// อัตราจ่ายให้ยึดที่หน้าส่งโพยของรอบนั้น และวงเงินที่แต่ละรายการกำหนดอาจแตกต่างกัน
const beforeSlipChecks = [
  {
    icon: "🧭",
    name: "แนวทางหวยและกลุ่มหวย",
    detail: "แนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ จึงใช้ดูประกอบได้ แต่ไม่สามารถรับประกันผลของงวดถัดไปได้",
    tag: "ข้อมูลประกอบ",
  },
  {
    icon: "📊",
    name: "สถิติหวยย้อนหลัง",
    detail: "สถิติย้อนหลังช่วยให้ย้อนดูผลและรูปแบบตัวเลขที่เคยออกในรอบที่ผ่านมา แต่ผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา",
    tag: "ย้อนดูผลเก่า",
  },
  {
    icon: "⏱️",
    name: "ตารางหวยและเวลาปิดรับ",
    detail: "หวยแต่ละประเภทมีตารางรอบ เวลาเปิดรับ และเวลาปิดรับของตัวเอง จึงควรตรวจสอบรายการล่าสุดก่อนเลือกตัวเลขในแต่ละรอบ",
    tag: "ดูก่อนเลือกเลข",
  },
  {
    icon: "💰",
    name: "อัตราจ่ายและวงเงินของรายการ",
    detail: "อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข และบางรายการอาจกำหนดอัตราหรือวงเงินแตกต่างกัน จึงควรยึดที่แสดงในหน้าส่งโพยของรอบนั้น",
    tag: "ยึดหน้าส่งโพย",
  },
];

const chips = ["แนวทางหวย", "กลุ่มหวย", "สถิติหวยย้อนหลัง", "ผลหวยตามรอบ", "หวยรัฐบาลไทย", "หวยฮานอย", "หวยลาวพัฒนา", "หวยหุ้นต่างประเทศ", "ส่งโพย", "เวลาปิดรับ", "อัตราจ่าย", "2 ตัว จ่าย 100 บาท", "3 ตัว จ่าย 1,000 บาท"];

// หวย365 (รอบแดงสด-ทอง 2026-10-02): โลโก้เป็นเวิร์ดมาร์กแดงสด #dc0203 ล้วนบนพื้นขาว คำว่า
// "หวย" กับเลข 6 เป็นแดง เลข 3 กับ 5 เป็นดำ งานอาร์ตเป็นผ้าซาตินแดงเข้มที่มีลายไทยสีทอง
// เงาปราสาททอง เหรียญทองกองสูง ลูกหวยแดง-ขาว และสลากกินแบ่ง สองแผงจึงถูกแยกด้วยคู่
// ทอง/แดงตามงานอาร์ตจริง — แผงล็อกอินอยู่ในกรอบทอง #ffc93c ส่วนแผงรายการหวยอยู่ในกรอบ
// แดงแบรนด์ #dc0203 ทั้งคู่วางบนผิวการ์ด #240406 ช่องกรอกและชิปตกลงไปที่ผิวแถบ #180303
// ในเส้นแดงลึก #9c0201 บรรทัดเด่นไล่เฉดทองอ่อน #ffeab0 → ทอง #ffc93c → ทองลึก #c08a07
// ปุ่มเข้าสู่ระบบเป็นทองเต็มตัวบนหมึกเข้ม #1a0303 ตามกฎคอนทราสต์ที่ว่าพื้นทองต้องใช้หมึกเข้ม
// และไล่เฉดใต้หมึกเข้มห้ามจบมืดกว่า #c08a07 (6.4:1) ปุ่มไลน์ยังคงสีเขียว #00B900 ของ
// แพลตฟอร์มซึ่งห้ามรีแมป
//
// ชุดแดง-ทองของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #e43434 #d99a10 #1c0606
// #2b0909 #0b0202 #4a0f0f) และของ หวยเฮง24 (#e0a52a #fdea83 #8b0302 #c01616 #2e0707
// #1a0505 #f6e6cf) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการหวยที่เปิดรับ ${BRAND_NAME}`}
  iconleft="🔐"
  iconright="🎟️"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหวยที่เปิดรับทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ รวมถึงจุดที่ควรตรวจสอบก่อนยืนยันโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ffc93c]/45 bg-[#240406]/94 p-6 shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ffc93c]/24 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffc93c]/70 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-xl text-[#1a0303] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffeab0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d9b9b1]">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือเพื่อเลือกประเภทหวย รอบ และตัวเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย แล้วกลับมาติดตามแนวทางหวย สถิติย้อนหลัง และผลหวยของแต่ละรอบได้จากบัญชีเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d9b9b1]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#9c0201] bg-[#180303]/95 py-3 pr-4 pl-12 text-[#f6e7e0] transition-all outline-none placeholder:text-[#d9b9b1]/70 focus:border-[#ffc93c] focus:ring-1 focus:ring-[#f5282a]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d9b9b1]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#9c0201] bg-[#180303]/95 py-3 pr-4 pl-12 text-[#f6e7e0] transition-all outline-none placeholder:text-[#d9b9b1]/70 focus:border-[#ffc93c] focus:ring-1 focus:ring-[#f5282a]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d9b9b1]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#9c0201] bg-[#180303] accent-[#ffc93c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d9b9b1] transition-colors hover:text-[#ffeab0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffeab0]/70 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] p-3.5 text-center font-black text-[#1a0303] shadow-[0_10px_30px_rgba(255,201,60,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,234,176,0.55)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d9b9b1]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#9c0201]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#9c0201]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#9c0201] bg-[#180303] px-2.5 py-1 text-[10px] font-bold text-[#f6e7e0]"><span aria-hidden="true">🎟️</span> แทงหวยออนไลน์</span>
            <span class="rounded-full border border-[#ffc93c]/40 bg-[#180303]/85 px-2.5 py-1 text-[10px] font-bold text-[#ffc93c]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffc93c] transition-colors hover:text-[#ffeab0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#dc0203] bg-[#240406]/94 p-5 shadow-[0_10px_30px_rgba(8,1,1,0.82)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d9b9b1]">
            {BRAND_NAME} รวมข้อมูลและรายการหวยไว้ในหน้าเดียว ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้สะดวก
          </span>
          <div class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หุ้นต่างประเทศ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#9c0201] bg-[#180303]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffc93c] shadow-[0_0_8px_rgba(255,201,60,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffeab0] uppercase">ตามรอบที่ระบบเปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d9b9b1] uppercase">
        <span>ประเภทหวยในระบบ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          lotteryMarkets.map((m) => (
            <div class="rounded-xl border border-[#9c0201] bg-[#180303]/95 px-3.5 py-2.5 transition-colors hover:border-[#ffc93c]/70 hover:bg-[#240406]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#ffeab0]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {m.icon}
                </span>
                <span class="truncate">{m.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#d9b9b1]">{m.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#d9b9b1]">
        รายการหวยและรอบที่เปิดรับจริงขึ้นอยู่กับตารางของแต่ละประเภทในวันนั้น จึงควรตรวจสอบตารางหวย เวลาปิดรับ และอัตราจ่ายล่าสุดของแต่ละรายการก่อนส่งโพยทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d9b9b1] uppercase">
        <span>จุดที่ควรตรวจก่อนยืนยันโพย</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSlipChecks.map((k) => (
            <div class="rounded-xl border border-[#9c0201] bg-[#180303]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5282a]/70 hover:bg-[#240406]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f6e7e0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffc93c]/50 bg-[#180303] px-2.5 py-0.5 text-[10px] font-bold text-[#ffc93c]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d9b9b1]">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#9c0201] bg-[#180303] px-3 py-1 text-[10px] font-bold text-[#f6e7e0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d9b9b1]">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศไว้ในบัญชีเดียว การรองรับการใช้งานผ่านมือถือ และการติดตามแนวทางหวย สถิติย้อนหลัง และผลหวยตามรอบจากหน้าเว็บไซต์ ส่วนอัตรา 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท
        ใช้กับรายการที่เข้าเงื่อนไข จึงควรตรวจสอบอัตราที่แสดงก่อนยืนยันโพยทุกครั้ง สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบที่ไม่สามารถรับประกันผลของงวดถัดไปได้ และไม่ควรส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
