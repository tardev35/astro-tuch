---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ (หวยคิง 2026-10-04) เนื้อหาในไฟล์นี้ถูก **เขียนใหม่ทั้งแผง** ไม่ได้
// find-and-replace ทับประโยคของรอบก่อน เพราะรอบก่อน (UP555) เป็นเว็บคาสิโน และ
// คำศัพท์ของมันทั้งชุด — สล็อต บาคาร่า บอล/เดิมพันฟุตบอล หมวดเกม ค่ายเกม
// คาสิโนสด RTP คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ทางเข้าใหม่ — ใช้กับรอบนี้ไม่ได้
// เลยแม้คำเดียว แบรนด์รอบนี้เป็น **เว็บรับแทงหวยล้วน**
//
// คำที่ใช้ได้มีเท่าที่ brand-spec §4 ("คำศัพท์ที่ใช้ได้") ระบุ ซึ่งมาจาก
// src/assets/content.txt ทั้งหมด: แทงหวย · ส่งโพย · โพย · รอบ · รายการหวย ·
// เลข 2 ตัว · เลข 3 ตัว · เลขเด็ด · เลขดัง · อัตราจ่าย · บาทละ 1,000 ·
// 2 ตัวจ่าย 100 บาท · 3 ตัวจ่าย 1,000 บาท · วงเงินรับแทง · ยอดสูงสุดที่ระบบเปิดรับ ·
// เครดิต · วอลเลท · ธนาคาร · บัญชีบริษัท · ชื่อนิติบุคคล · สมัคร 3 ขั้นตอน · Login ·
// ประวัติโพย · แอดมิน 24 ชั่วโมง · PIN · OTP
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากรอบเก่า — ชื่อไฟล์ไม่ถูกเปลี่ยน แต่ "RTP" ไม่ปรากฏ
// ในเนื้อหาแล้วแม้แต่ครั้งเดียว เพราะเป็นคำของเว็บสล็อต ไม่ใช่ของบรีฟนี้
//
// ห้ามแต่งข้อเท็จจริงที่บรีฟไม่ได้ให้: ชื่อตลาดหวย (ฮานอย ลาวพัฒนา หวยหุ้น ยี่กี)
// เวลาเปิด-ปิดรับ ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง —
// บรีฟไม่ได้ให้ไว้สักอย่าง และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง
// ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มีเท่านี้: 2 ตัว · 3 ตัว · 100 · 1,000 ·
// บาทละ 1,000 · 3 ขั้นตอน · 24 ชั่วโมง
//
// แผงฝั่งขวาแถวบนคือ "รายการที่ระบบเปิดรับ" ซึ่งเป็นคำของบรีฟตรงๆ ไม่ใช่ชื่อตลาด
const betTypes = [
  { icon: "🎟️", name: "เลข 2 ตัว", detail: "รายการที่เข้าเงื่อนไขกำหนดอัตรา 2 ตัว จ่าย 100 บาท ก่อนส่งโพยควรตรวจสอบเลขให้ครบทั้งสองหลัก" },
  { icon: "🎫", name: "เลข 3 ตัว", detail: "รายการที่เข้าเงื่อนไขกำหนดอัตรา 3 ตัว จ่าย 1,000 บาท เลข 3 ตัวมีการเดิมพันหลายรูปแบบ ควรดูว่าอัตรานี้ใช้กับรูปแบบใด" },
  { icon: "🔢", name: "เลขเด็ด และเลขดัง", detail: "เลือกเลขที่กำลังได้รับความสนใจตามรายการที่ระบบเปิดรับ เลขที่มีผู้เลือกจำนวนมากอาจมีวงเงินรับแทงต่างกันในแต่ละรอบ" },
  { icon: "🗓️", name: "รายการหวยตามรอบ", detail: "รายการและรอบหวยตามที่เว็บไซต์เปิดให้บริการ ควรตรวจสอบยอดสูงสุดที่ระบบเปิดรับในรอบนั้นก่อนยืนยัน" },
  { icon: "💳", name: "เครดิต วอลเลท และธนาคาร", detail: "จัดการเครดิตผ่านวอลเลทและธนาคารที่ระบบกำหนด ควรเช็กชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่ประกาศก่อนทำธุรกรรม" },
];

// สี่ข้อนี้ประกอบจากประโยคกำกับของบรีฟเองล้วนๆ (content.txt บรรทัด 5, 8, 11, 18)
// ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforeSlipChecks = [
  {
    icon: "🧾",
    name: "อัตราจ่ายบนหน้าส่งโพย",
    detail:
      "อัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง หรือเงื่อนไขของแต่ละรอบ หากข้อมูลบนหน้าส่งโพยแตกต่างจากข้อความประชาสัมพันธ์ ควรยึดอัตราล่าสุดที่ระบบแสดงก่อนยืนยันรายการ",
    tag: "ยึดหน้าส่งโพย",
  },
  {
    icon: "📊",
    name: "วงเงินรับแทงของแต่ละรอบ",
    detail:
      "สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ คำว่าจ่ายไม่อั้นจึงควรยึดวงเงินจริงที่เว็บไซต์แสดง และควรตรวจสอบยอดสูงสุดที่ระบบเปิดรับก่อนส่งโพยทุกครั้ง",
    tag: "เช็กวงเงินจริง",
  },
  {
    icon: "🏦",
    name: "บัญชีปลายทางก่อนทำธุรกรรม",
    detail:
      "กรณีระบุว่ายอดฝากเข้าบริษัทโดยตรง ควรแสดงชื่อนิติบุคคลและรายละเอียดบัญชีที่ตรวจสอบได้ สมาชิกควรเช็กชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่ประกาศก่อนทำธุรกรรม",
    tag: "ตรวจชื่อบัญชี",
  },
  {
    icon: "🔐",
    name: "รหัสผ่าน PIN และ OTP",
    detail: "ควรตรวจสอบข้อมูลทุกครั้งก่อนกดยืนยัน รวมถึงไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น ไม่ว่าจะติดต่อผ่านช่องทางใด",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "แทงหวย",
  "ส่งโพย",
  "โพย",
  "รายการหวย",
  "รอบ",
  "เลข 2 ตัว",
  "เลข 3 ตัว",
  "เลขเด็ด",
  "เลขดัง",
  "อัตราจ่าย",
  "บาทละ 1,000",
  "วงเงินรับแทง",
  "เครดิต",
  "วอลเลท",
  "ธนาคาร",
  "ประวัติโพย",
  "สมัคร 3 ขั้นตอน",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): brand-spec §2
// งานอาร์ตรอบนี้เป็นทองโลหะบนดำอมน้ำตาล คู่สีรองคือครีมอมพีช (ชุดขาวของนางแบบใน
// slide1/slide2) ไม่ใช่เงินโครเมียมแบบ UP555 สองแผงจึงถูกแยกด้วยคู่นั้นตรงๆ —
// แผงล็อกอินอยู่ในกรอบทองแบรนด์ #cd9a2c ส่วนแผงรายการหวยอยู่ในกรอบครีมอมพีช
// #fcd4c3 ทั้งคู่วางบนผิวการ์ด #1c140b ช่องกรอกและชิปตกลงไปที่พื้นลึกสุด #0c0b0a
// บรรทัดเด่นไล่ทองสว่าง #fdeb7c → ทองแบรนด์ #cd9a2c → ครีมอมพีช #fcd4c3
//
// ปุ่มในแผงนี้แยกตามหน้าที่: "เข้าสู่ระบบ" เป็นปุ่มรอง จึงเป็นโครงไม่ทึบ ขอบทอง
// #cd9a2c/60 หมึกทองสว่าง #fdeb7c ส่วนปุ่มไลน์คงสีแพลตฟอร์ม #00B900 แบบพื้นทึบ
// ไม่ไล่เฉด ซึ่งจงใจให้ต่างจากปุ่มสมัครสมาชิกบนหน้าแรกที่เป็นพื้นไล่เฉดทองแบรนด์
// เพราะรอบนี้สีแบรนด์เองก็เป็นทอง ถ้าทั้งสองปุ่มเป็นทองไล่เฉดเหมือนกันจะแยกไม่ออก
// ข้อความรองใช้สีเนื้อความ #f5e7c8 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
// เนื้อความ #f5e7c8 (= BRAND_TEXT) glow เป็น rgba(205,154,44,…)
//
// ชุดทอง + เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#ebbb54 #fce675 #ab6d24
// #d5d4d3 #f3f3f2 #6b4517 #241705 #0c0502 #160d02 #f8eed9 rgba(235,187,84,…))
// ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`รายการหวยที่ ${BRAND_NAME} เปิดรับ`}
  iconleft="🔐"
  iconright="🎟️"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมรายการหวยที่ระบบเปิดรับ ทั้งเลข 2 ตัว เลข 3 ตัว เลขเด็ด และเลขดัง และจุดที่ควรตรวจสอบก่อนส่งโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#cd9a2c]/55 bg-[#1c140b]/94 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#cd9a2c]/26 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fdeb7c]/70 bg-gradient-to-br from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] text-xl text-[#120a02] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdeb7c]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f5e7c8]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือ แล้วเลือกรายการหวยตามรอบที่ระบบเปิดรับ กรอกเลขและยอดที่ต้องการ พร้อมตรวจสอบอัตราจ่าย เครดิต และประวัติโพยจากบัญชีของตนเองได้
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5e7c8]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5c3f12] bg-[#0c0b0a]/95 py-3 pr-4 pl-12 text-[#f5e7c8] transition-all outline-none placeholder:text-[#f5e7c8]/55 focus:border-[#cd9a2c] focus:ring-1 focus:ring-[#fdeb7c]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5e7c8]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5c3f12] bg-[#0c0b0a]/95 py-3 pr-4 pl-12 text-[#f5e7c8] transition-all outline-none placeholder:text-[#f5e7c8]/55 focus:border-[#cd9a2c] focus:ring-1 focus:ring-[#fdeb7c]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f5e7c8]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5c3f12] bg-[#0c0b0a] accent-[#cd9a2c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f5e7c8]/75 transition-colors hover:text-[#fdeb7c]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border-2 border-[#cd9a2c]/60 bg-transparent p-3.5 text-center font-black text-[#fdeb7c] transition-all hover:scale-[1.02] hover:border-[#cd9a2c] hover:bg-[#cd9a2c]/10">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f5e7c8]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#5c3f12]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#5c3f12]"></span>
        </div>

        <a href="/line" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00B900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5c3f12] bg-[#0c0b0a] px-2.5 py-1 text-[10px] font-bold text-[#f5e7c8]"><span aria-hidden="true">🎟️</span> เลข 2 ตัว และเลข 3 ตัว</span>
            <span class="rounded-full border border-[#fcd4c3]/40 bg-[#0c0b0a]/85 px-2.5 py-1 text-[10px] font-bold text-[#fcd4c3]"><span aria-hidden="true">📱</span> ส่งโพยผ่านมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#cd9a2c] transition-colors hover:text-[#fdeb7c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#fcd4c3]/35 bg-[#1c140b]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f5e7c8]/75">
            {BRAND_NAME} รับแทงหวยตามรายการและรอบที่ระบบกำหนด เลือกเลขเองหรือเลือกเลขเด็ด เลขดัง กรอกเลขและยอดที่ต้องการ แล้วตรวจสอบอัตราจ่ายกับวงเงินรับแทงจากระบบก่อนส่งโพยทุกครั้ง
          </span>
          <div class="bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#fcd4c3] bg-clip-text text-xl font-black text-transparent sm:text-2xl">2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5c3f12] bg-[#0c0b0a]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#cd9a2c] shadow-[0_0_8px_rgba(205,154,44,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fdeb7c] uppercase">ตามรายการที่ระบบเปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f5e7c8]/70 uppercase">
        <span>รายการที่เลือกแทงได้</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          betTypes.map((t) => (
            <div class="rounded-xl border border-[#5c3f12] bg-[#0c0b0a]/95 px-3.5 py-2.5 transition-colors hover:border-[#cd9a2c]/75 hover:bg-[#1c140b]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#fdeb7c]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f5e7c8]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f5e7c8]/70">
        รายการและรอบหวยที่เปิดรับจริงเป็นไปตามที่เว็บไซต์กำหนด จึงควรตรวจสอบรายการล่าสุดบนหน้าส่งโพยก่อนยืนยันทุกครั้ง ส่วนข้อความว่าอัตราจ่ายสูงที่สุดในวงการ ควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ หากไม่มีหลักฐานดังกล่าว คำว่าอัตราจ่ายสูงจะเหมาะกับเนื้อหาเว็บไซต์มากกว่า
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f5e7c8]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนส่งโพย</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSlipChecks.map((k) => (
            <div class="rounded-xl border border-[#5c3f12] bg-[#0c0b0a]/95 px-3.5 py-2.5 transition-colors hover:border-[#fcd4c3]/50 hover:bg-[#1c140b]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f5e7c8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#cd9a2c]/50 bg-[#0c0b0a] px-2.5 py-0.5 text-[10px] font-bold text-[#cd9a2c]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f5e7c8]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5c3f12] bg-[#0c0b0a] px-3 py-1 text-[10px] font-bold text-[#f5e7c8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f5e7c8]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการเลือกเลขและส่งโพยผ่านระบบบนมือถือ การตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยก่อนยืนยัน และการจัดการเครดิตผ่านวอลเลทและธนาคารที่ระบบกำหนด ส่วนอัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบการแทง
        หรือเงื่อนไขของแต่ละรอบ จึงควรยึดอัตราล่าสุดที่ระบบแสดงก่อนยืนยันรายการ และเลขที่มีผู้เลือกจำนวนมากอาจมีวงเงินรับแทงต่างกันตามรอบ หากพบปัญหาสามารถติดต่อแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
