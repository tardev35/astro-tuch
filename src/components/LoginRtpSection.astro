---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// หวย365 เป็นเว็บแทงหวยออนไลน์ ไม่ใช่เว็บสล็อตและไม่ใช่เว็บบอล แผงฝั่งขวารอบนี้ถูกเขียน
// ใหม่ทั้งแผงจากคำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace ทับประโยคของรอบก่อน บรีฟ
// ระบุประเภทหวยไว้สี่รายการ คือ รัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ ป้ายทุกใบ
// จึงเป็นสี่รายการนั้น ไม่ใช่ชื่อรายการหรือชื่อตลาดที่คิดขึ้นเอง ส่วนแผง "จุดที่ควรตรวจก่อน
// ส่งโพย" ประกอบจากประโยคเตือนของบรีฟล้วนๆ คือ ควรตรวจสอบอัตราที่แสดงในระบบ รวมถึงเลข
// ที่เลือก ยอดเดิมพัน และรอบหวยให้ถูกต้อง, แต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน,
// สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบที่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกใน
// งวดถัดไปได้, ควรยึดรายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ และไม่เปิดเผยรหัสผ่าน
// PIN หรือ OTP ให้บุคคลอื่น
//
// ชื่อไฟล์ยังมีคำว่า Rtp ติดมาจากรอบเก่า แต่ RTP เป็นศัพท์ของเว็บสล็อตและบรีฟรอบนี้ไม่ได้
// เขียนไว้ จึงไม่มีอยู่ในเนื้อหา — คำว่า สล็อต พีจี ค่ายเกม ฟรีสปิน ตัวคูณ วงล้อ โบนัสไทม์
// คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ไม่เหลืออยู่ในไฟล์นี้แล้ว
//
// ห้ามใส่เวลาเปิด/ปิดรับเป็นตัวเลข ชื่อตลาดหุ้นรายตลาด ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้
// บริการ ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟ หวย365 ไม่ได้ให้ไว้เลยสักอย่าง
// และตัวเลขที่แต่งขึ้นบนหน้าเว็บพนันคือการกล่าวอ้างจริง ไม่ใช่ของประดับ ตัวเลขที่ใช้ได้มี
// เท่าที่บรีฟระบุ คือ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง
const lotteryTypes = [
  { icon: "🏛️", name: "หวยรัฐบาลไทย", detail: "รายการตามกำหนดออกรางวัลของรัฐบาลไทย ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของรอบนั้นได้ก่อนเลือกแทง" },
  { icon: "🕛", name: "หวยฮานอย", detail: "เปิดรับหลายรอบตามรายการที่ระบบเปิดในแต่ละวัน ควรดูรอบและเวลาปิดรับของแต่ละรายการก่อนส่งโพย" },
  { icon: "🎯", name: "หวยลาวพัฒนา", detail: "อีกหนึ่งรายการที่รวมไว้ในบัญชีเดียว ตรวจสอบอัตราจ่ายและผลของแต่ละรอบได้จากหน้าเว็บไซต์" },
  { icon: "📈", name: "หวยหุ้นต่างประเทศ", detail: "ตามตลาดที่เปิดให้บริการ รายการที่เปิดรับจริงขึ้นอยู่กับรอบที่ระบบกำหนดในแต่ละวัน" },
];

// สี่ข้อนี้ประกอบจากประโยคเตือนของบรีฟเองทั้งหมด ไม่มีข้อไหนที่บรีฟไม่ได้เขียนไว้
const beforeSlipChecks = [
  {
    icon: "🧾",
    name: "อัตราจ่ายของรายการนั้น",
    detail: "อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข เพราะแต่ละประเภทหวยและรูปแบบการเดิมพันอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน",
    tag: "ดูก่อนส่งโพย",
  },
  {
    icon: "🔢",
    name: "เลขที่เลือก ยอดเดิมพัน และรอบหวย",
    detail: "ก่อนส่งโพยควรตรวจสอบอัตราที่แสดงในระบบ รวมถึงเลขที่เลือก ยอดเดิมพัน และรอบหวยให้ถูกต้อง หากระบบแสดงอัตราที่แตกต่างจากข้อมูลประชาสัมพันธ์ ควรยึดรายละเอียดล่าสุดในหน้าส่งโพย",
    tag: "ยึดหน้าส่งโพย",
  },
  {
    icon: "📊",
    name: "สถิติและแนวทางเป็นข้อมูลประกอบ",
    detail: "สถิติย้อนหลังช่วยย้อนดูผลในรอบที่ผ่านมา ส่วนแนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้",
    tag: "ไม่รับประกันผล",
  },
  {
    icon: "🔐",
    name: "ความปลอดภัยของบัญชีสมาชิก",
    detail: "ควรใช้ข้อมูลของตนเองในการสมัคร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    tag: "ไม่บอกใคร",
  },
];

const chips = [
  "หวยรัฐบาลไทย",
  "หวยฮานอย",
  "หวยลาวพัฒนา",
  "หวยหุ้นต่างประเทศ",
  "แนวทางหวย",
  "กลุ่มหวย",
  "สถิติหวยย้อนหลัง",
  "ผลหวย",
  "ส่งโพย",
  "2 ตัว จ่าย 100 บาท",
  "3 ตัว จ่าย 1,000 บาท",
  "สมัครสมาชิก",
  "Login",
  "แอดมิน 24 ชั่วโมง",
];

// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): โลโก้เป็นสองสีจริง — คำว่า หวย เป็นแดงสด
// (vivid #dc0203 #e00104 #e2020a แดงล้วนทั้งชุด) เลข 365 เป็นดำ #020202 ส่วนทองมาจาก
// ตัวอักษรสามมิติบนแบนเนอร์และเหรียญทองในงานอาร์ต สองแผงจึงถูกแยกด้วยสองสีนั้นตรงๆ —
// แผงล็อกอินอยู่ในกรอบทองแบรนด์ #ffc93c ส่วนแผงประเภทหวยอยู่ในกรอบแดงแบรนด์ #dc0203
// ทั้งคู่วางบนผิวการ์ด #240406 ช่องกรอกและชิปตกลงไปที่พื้นลึกสุด #140203 บรรทัดเด่น
// ไล่ทองอ่อน #ffeab0 → ทองแบรนด์ #ffc93c → แดงสว่าง #f5282a ปุ่มเข้าสู่ระบบเป็นทองเต็มตัว
// บนหมึกบนพื้นทอง #1a0303 ตามกฎคอนทราสต์ที่ว่าพื้นทองต้องใช้หมึกเข้มเสมอ และไล่เฉดใต้
// หมึกเข้มห้ามจบเข้มกว่าทองลึก #c08a07 (6.4:1) ส่วนป้ายพื้นแดงต้องใช้ตัวอักษรขาวเสมอ
// เพราะหมึกเข้มบนแดงแบรนด์ได้แค่ 2.8:1 ปุ่มไลน์ยังคงสีเขียว #00B900 ของแพลตฟอร์ม
// ซึ่งห้ามรีแมป ข้อความรองใช้ #f6e7e0 (BRAND_TEXT) แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#edb543 #fde8a8 #a9761f #e6e6e6 #101010
// #070707 #3a2a0d #1a1203 #17120a #bdb49f #f4ead3) ออกครบทุกจุดแล้ว
---

<ContentBoxTwo
  titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`}
  titleright={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับ`}
  iconleft="🔐"
  iconright="🎲"
  label={`เข้าสู่ระบบ ${BRAND_NAME} ผ่านบัญชีสมาชิก พร้อมประเภทหวยที่เว็บไซต์เปิดรับ ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ และจุดที่ควรตรวจสอบก่อนส่งโพยทุกครั้ง`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ffc93c]/45 bg-[#240406]/94 p-6 shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ffc93c]/24 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffc93c]/70 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-xl text-[#1a0303] shadow-inner">
          👋
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffeab0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f6e7e0]/70">
            Login เข้าบัญชี {BRAND_NAME} ผ่านมือถือหรือคอมพิวเตอร์ แล้วเลือกเลข ส่งโพย และตรวจสอบรายการได้จากบัญชีเดียว พร้อมดูแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f6e7e0]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a0a0c] bg-[#140203]/95 py-3 pr-4 pl-12 text-[#f6e7e0] transition-all outline-none placeholder:text-[#f6e7e0]/55 focus:border-[#ffc93c] focus:ring-1 focus:ring-[#ffeab0]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f6e7e0]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a0a0c] bg-[#140203]/95 py-3 pr-4 pl-12 text-[#f6e7e0] transition-all outline-none placeholder:text-[#f6e7e0]/55 focus:border-[#ffc93c] focus:ring-1 focus:ring-[#ffeab0]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f6e7e0]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a0a0c] bg-[#140203] accent-[#ffc93c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f6e7e0]/70 transition-colors hover:text-[#ffeab0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffeab0]/70 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] p-3.5 text-center font-black text-[#1a0303] shadow-[0_10px_30px_rgba(255,201,60,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,234,176,0.55)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f6e7e0]/70">
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a0a0c]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#3a0a0c]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อผ่าน Line Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3a0a0c] bg-[#140203] px-2.5 py-1 text-[10px] font-bold text-[#f6e7e0]"><span aria-hidden="true">🎟️</span> ส่งโพยออนไลน์</span>
            <span class="rounded-full border border-[#dc0203]/50 bg-[#140203]/85 px-2.5 py-1 text-[10px] font-bold text-[#f5282a]"><span aria-hidden="true">📱</span> รองรับมือถือ</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffc93c] transition-colors hover:text-[#ffeab0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#dc0203]/45 bg-[#240406]/94 p-5 shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f6e7e0]/70">
            {BRAND_NAME} รวบรวมรายการหวยหลายประเภทสำหรับผู้ที่ต้องการติดตามหลายรอบในบัญชีเดียว ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง
          </span>
          <div class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-xl font-black text-transparent sm:text-2xl">รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หวยหุ้นต่างประเทศ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#3a0a0c] bg-[#140203]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dc0203] shadow-[0_0_8px_rgba(220,2,3,0.85)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#ffeab0] uppercase">ตามรายการที่ระบบเปิดรับ</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f6e7e0]/70 uppercase">
        <span>ประเภทหวยที่เปิดรับ</span>
        <span>รายละเอียด</span>
      </div>

      <div class="mb-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          lotteryTypes.map((t) => (
            <div class="rounded-xl border border-[#3a0a0c] bg-[#140203]/95 px-3.5 py-2.5 transition-colors hover:border-[#ffc93c]/70 hover:bg-[#3a0a0c]/85">
              <span class="flex min-w-0 items-center gap-2 text-sm font-bold text-[#ffeab0]">
                <span aria-hidden="true" class="w-5 shrink-0 text-center">
                  {t.icon}
                </span>
                <span class="truncate">{t.name}</span>
              </span>
              <span class="mt-1.5 block text-[11px] tracking-wide text-[#f6e7e0]/70">{t.detail}</span>
            </div>
          ))
        }
      </div>

      <p class="mb-4 text-[11px] leading-relaxed tracking-wide text-[#f6e7e0]/70">
        รายการที่เปิดรับจริงขึ้นอยู่กับรอบที่ระบบกำหนดในแต่ละวัน จึงควรตรวจสอบตารางหวย เวลาปิดรับ อัตราจ่าย และผลของแต่ละรอบจากหน้าเว็บไซต์ก่อนเลือกแทงทุกครั้ง
      </p>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f6e7e0]/70 uppercase">
        <span>จุดที่ควรตรวจก่อนส่งโพย</span>
        <span>รายละเอียด</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          beforeSlipChecks.map((k) => (
            <div class="rounded-xl border border-[#3a0a0c] bg-[#140203]/95 px-3.5 py-2.5 transition-colors hover:border-[#dc0203]/70 hover:bg-[#3a0a0c]/85">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f6e7e0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {k.icon}
                  </span>{" "}
                  <span class="truncate">{k.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffc93c]/50 bg-[#140203] px-2.5 py-0.5 text-[10px] font-bold text-[#ffc93c]">{k.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f6e7e0]/70">{k.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3a0a0c] bg-[#140203] px-3 py-1 text-[10px] font-bold text-[#f6e7e0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f6e7e0]/70">
        รายการข้างต้นสรุปสิ่งที่ {BRAND_NAME} ระบุไว้ ทั้งการรวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว และการเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้จากบัญชีเดียว
        ส่วนอัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข เพราะแต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน จึงควรยึดรายละเอียดล่าสุดในหน้าส่งโพยก่อนยืนยันรายการ และไม่ควรเปิดเผยรหัสผ่าน
        PIN หรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
