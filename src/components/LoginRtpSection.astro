---
// The two-column chrome shell. Its column labels render as <p> and the section
// carries an aria-label, so a login widget never emits a heading tag.
import ContentBoxTwo from "./ContentBoxTwo.astro";

// LUCKY88 is a slot brand, so every row below stays inside what the brief
// states: การรวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว, การรองรับมือถือ แท็บเล็ต และ
// คอมพิวเตอร์, สล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส และสล็อตแจ็กพอต, การตรวจช่วง
// เดิมพัน อัตราจ่าย Paytable และฟีเจอร์ก่อนเริ่มเล่น, การยึดเงื่อนไขวงเงินถอน
// ล่าสุดจากหน้าฝากถอน, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข,
// การสมัครบนมือถือ 3 ขั้นตอน, การไม่เปิดเผยรหัสผ่านหรือ OTP และการติดต่อแอดมิน
// พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ.
// Nothing here quotes a return-to-player figure, a payout, or a promotion the
// brief does not state.
const menus = [
  { icon: "🎰", name: "รวมเกมสล็อตในระบบเดียว", detail: "สล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส สล็อตแจ็กพอต และเกมจากค่ายต่าง ๆ เลือกได้จากบัญชีสมาชิกเดียว", tag: "เลือกจากบัญชีเดียว" },
  { icon: "📋", name: "ช่วงเดิมพันและ Paytable", detail: "ตรวจสอบช่วงเดิมพัน อัตราจ่าย Paytable และรายละเอียดฟีเจอร์ของแต่ละเกมให้ครบก่อนเริ่มเล่น", tag: "อ่านก่อนเริ่มเล่น" },
  { icon: "💳", name: "วงเงินถอนและจำนวนครั้ง", detail: "ยึดเงื่อนไขล่าสุดที่แสดงในหน้าฝากถอนเป็นหลัก เพราะวงเงินอาจต่างกันตามช่องทางหรือข้อกำหนดของระบบ", tag: "ยึดหน้าฝากถอน" },
  { icon: "🤝", name: "โบนัสแนะนำเพื่อน 0.8%", detail: "นำลิงก์แนะนำส่วนตัวไปแชร์ ระบบคำนวณโบนัสให้เมื่อเพื่อนสมัครและมียอดการใช้งานตรงตามข้อกำหนด", tag: "ตามเงื่อนไขกิจกรรม" },
  { icon: "💸", name: "คืนยอดเสีย 0.3%", detail: "ตรวจประเภทเกมสล็อต รอบคำนวณ และข้อกำหนดเกี่ยวกับการถอนโบนัสให้ครบถ้วนก่อนกดรับสิทธิ์", tag: "ตรวจรอบก่อนกดรับ" },
  { icon: "📝", name: "สมัครบนมือถือ 3 ขั้นตอน", detail: "กรอกข้อมูลที่ระบบกำหนด Login เข้าบัญชีแล้วฝากเครดิต จากนั้นเลือกค่ายเกมสล็อตที่ต้องการเล่น", tag: "รองรับ Android และ iOS" },
  { icon: "🔒", name: "รหัสผ่านและ OTP", detail: "ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นไม่ว่ากรณีใดก็ตาม", tag: "ห้ามบอกผู้อื่น" },
  { icon: "🎧", name: "แอดมิน LUCKY88 หลังบ้าน", detail: "ติดปัญหาสมัคร Login ไม่ได้ เครดิตฝากไม่เข้า ถอนค้าง หรือโปรไม่แสดง ให้แจ้งเวลา จำนวนเงิน และรายละเอียด", tag: "แจ้งเวลาทุกครั้ง" },
];

const chips = ["สล็อตเบทต่ำ", "ฟรีสปิน", "เกมโบนัส", "สล็อตแจ็กพอต", "Paytable", "ฝากถอน", "โบนัส 0.8%", "คืนยอดเสีย 0.3%"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ LUCKY88" titleright="จุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อตกับ LUCKY88" label="เข้าสู่ระบบ LUCKY88 และตารางจุดที่ควรตรวจสอบก่อนเริ่มเล่นสล็อต">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#7a1219]/80 bg-[#170a0b]/92 p-6 shadow-[0_10px_30px_rgba(224,26,43,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8e0407]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c1121f]/60 bg-gradient-to-br from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff3b4d]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9aa2ab]">เข้าสู่ระบบ LUCKY88 เพื่อเลือกเกมสล็อต ตรวจสอบโปรโมชั่น จัดการเครดิต และส่งคำขอถอนผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9aa2ab]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a1219] bg-[#040202]/95 py-3 pr-4 pl-12 text-[#e8dadb] transition-all outline-none placeholder:text-[#9aa2ab] focus:border-[#e01a2b] focus:ring-1 focus:ring-[#e01a2b]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9aa2ab]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a1219] bg-[#040202]/95 py-3 pr-4 pl-12 text-[#e8dadb] transition-all outline-none placeholder:text-[#9aa2ab] focus:border-[#e01a2b] focus:ring-1 focus:ring-[#e01a2b]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8dadb]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a1219] bg-[#040202] accent-[#e01a2b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8dadb] transition-colors hover:text-[#ff3b4d]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#c1121f]/55 bg-gradient-to-r from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] p-3.5 text-center font-black text-[#f4f6f8] shadow-[0_10px_30px_rgba(224,26,43,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(224,26,43,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9aa2ab]">
          <span class="h-px flex-1 bg-[#7a1219]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#7a1219]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE Official
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#7a1219]/80 bg-[#040202] px-2.5 py-1 text-[10px] font-bold text-[#ff3b4d]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#c1121f]/40 bg-[#040202]/80 px-2.5 py-1 text-[10px] font-bold text-[#e8dadb]"><span aria-hidden="true">🕐</span> แอดมินตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff3b4d] transition-colors hover:text-[#f4f6f8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#7a1219]/70 bg-[#170a0b]/92 p-5 shadow-[0_10px_30px_rgba(224,26,43,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8dadb]">รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว ใช้งานได้ทุกอุปกรณ์</span>
          <div class="bg-gradient-to-r from-[#cfd4da] via-[#ff3b4d] to-[#8e0407] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">มือถือ • แท็บเล็ต • คอม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/45 bg-green-950/70 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9aa2ab] uppercase">
        <span>เกมสล็อต โปรโมชั่น และการใช้งานบัญชี</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7a1219] bg-[#040202]/95 px-3.5 py-2.5 transition-colors hover:border-[#e01a2b]/60 hover:bg-[#3b0303]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8dadb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#7a1219]/80 bg-[#040202] px-2.5 py-0.5 text-[10px] font-bold text-[#ff3b4d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9aa2ab]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c1121f]/35 bg-[#040202] px-3 py-1 text-[10px] font-bold text-[#ff3b4d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9aa2ab]">
        ข้อมูลข้างต้นใช้ประกอบการตรวจสอบก่อนเริ่มเล่น เกมสล็อตไม่สามารถรับประกันผลกำไรหรือรางวัลได้ โปรโมชั่นแต่ละรายการมีวิธีคำนวณ รอบการรับ และข้อกำหนดต่างกัน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP
        ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
