// GODBET88 palette: both panels sit on the card surface (#0a0806) over the page
// black, with the login plate in deep gold (#9a7f3f) and the service list in the
// sheen (#f6e7b8) — brightness, not a second hue. The LINE button keeps the
// platform's own green.
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ GODBET88"
  titleright="จุดเด่นของ GODBET88 ที่เว็บประกาศไว้"
  label="เข้าสู่ระบบ GODBET88 และรายการจุดเด่นเรื่องการไม่ติดเทิร์น การถอนไม่จำกัดรอบ กับโปรโมชั่นที่เว็บประกาศไว้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c2a55c]/40 bg-[#0a0806]/92 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c2a55c]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c2a55c]/70 bg-gradient-to-br from-[#e2c87f] via-[#c2a55c] to-[#5c4418] text-xl shadow-inner">
          ⚡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f6e7b8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#ece1cc]/75">ล็อคอินเข้า GODBET88 เพื่อปั่นสล็อตลิขสิทธิ์แท้ได้ครบทุกค่าย กดรับโปรโมชั่น และทำรายการฝาก-ถอนออโต้แบบไม่มีขั้นต่ำได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece1cc]/70">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ หรือ ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5c4418] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#ece1cc] transition-all outline-none placeholder:text-[#ece1cc]/50 focus:border-[#c2a55c] focus:ring-1 focus:ring-[#f6e7b8]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ece1cc]/70">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5c4418] bg-[#050403]/95 py-3 pr-4 pl-12 text-[#ece1cc] transition-all outline-none placeholder:text-[#ece1cc]/50 focus:border-[#c2a55c] focus:ring-1 focus:ring-[#f6e7b8]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#ece1cc]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5c4418] bg-[#050403] accent-[#c2a55c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#ece1cc]/80 transition-colors hover:text-[#f6e7b8]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f6e7b8]/70 bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] p-3.5 text-center font-black text-[#050403] shadow-[0_10px_30px_rgba(194,165,92,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(246,231,184,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#ece1cc]/60">
          <span aria-hidden="true" class="h-px flex-1 bg-[#5c4418]"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#5c4418]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5c4418] bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#ece1cc]"><span aria-hidden="true">🎰</span> ไม่ติดเทิร์น</span>
            <span class="rounded-full border border-[#c2a55c]/50 bg-[#050403]/85 px-2.5 py-1 text-[10px] font-bold text-[#f6e7b8]"><span aria-hidden="true">🕐</span> แอดมิน 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f6e7b8] transition-colors hover:text-[#e2c87f]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f6e7b8]/40 bg-[#0a0806]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#ece1cc]/80">เว็บสล็อตเว็บตรงที่เข้าใจคอสล็อตมากที่สุด</span>
          <div class="bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#9a7f3f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ไม่ติดเทิร์น ถอนได้ทุกยอด ไม่มีขั้นต่ำ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#5c4418] bg-[#050403]/85 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c2a55c] shadow-[0_0_8px_rgba(194,165,92,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f6e7b8] uppercase">24 ชม.</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#ece1cc]/70 uppercase">
        <span>สิ่งที่เปิดให้สมาชิกใช้งาน</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#5c4418] bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#c2a55c]/70 hover:bg-[#161208]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece1cc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f6e7b8]/45 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#f6e7b8]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#ece1cc]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5c4418] bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#ece1cc]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#ece1cc]/70">
        รายการข้างต้นสรุปสิ่งที่ GODBET88 ประกาศไว้ ทั้งการเล่นแบบไม่ต้องทำยอดเทิร์นโอเวอร์ การสั่งถอนได้ตลอดเวลาโดยไม่จำกัดรอบบิลต่อวัน ระบบฝาก-ถอนไม่มีขั้นต่ำ และโปรโมชั่นที่เปิดให้กดรับผ่านหน้าเว็บ
        ส่วนรอบคำนวณและเงื่อนไขของโปรโมชั่นแต่ละรายการ ให้ยึดรายละเอียดล่าสุดที่ปรากฏในบัญชีสมาชิก และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      </div>
    </div>
  </div>
</ContentBoxTwo>
