---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ HONGHAO ตัวอักษรสีเขียวหยกไล่เฉดสลับเงิน มีไพ่ดอกจิกอยู่ในตัว O และประกายเพชรในตัว A";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#62ae2d]/45 bg-[#040803] pt-16 pb-8 font-sans text-[#dbe5d3] shadow-[0_-15px_40px_rgba(98,174,45,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#62ae2d]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(98,174,45,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#a8e37c] to-[#2f6a0c] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                HONG<span class="bg-gradient-to-r from-[#f0dca0] to-[#d9b95c] bg-clip-text text-transparent">HAO</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#62ae2d]/55 pl-4 text-sm leading-relaxed text-[#a9bd9c]">
          HONGHAO คาสิโนออนไลน์เว็บตรง รวมเกมจากหลากหลายค่ายไว้ในบัญชีเดียว ทั้งบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อต รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ ระบบฝากถอนอัตโนมัติ พร้อมทีมงานดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#62ae2d]/40 bg-[#12290a]/50 px-4 py-1 text-xs font-medium text-[#a8e37c] backdrop-blur-sm">คาสิโนมือถือ</span>
          <span class="rounded-full border border-[#d9b95c]/35 bg-[#1c1607]/60 px-4 py-1 text-xs font-medium text-[#d9b95c] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#a8e37c] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#62ae2d]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#a9bd9c]">
          <li><a href="/" class="transition-colors hover:text-[#a8e37c]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#a8e37c]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#a8e37c]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#a8e37c]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#a8e37c]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#a8e37c]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#a8e37c]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#a8e37c]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#a8e37c] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#62ae2d]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d9b95c]/70 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#25460f]/70 pt-8 text-xs font-medium tracking-wide text-[#a9bd9c]/60 md:flex-row">
      <p>&copy; {new Date().getFullYear()} HONGHAO CASINO. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#a8e37c]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#a8e37c]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
