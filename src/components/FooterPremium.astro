---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ JOKERSLOTZ หมวกตัวตลกสามแฉกสีทองมีใบหน้าโจ๊กเกอร์ยิ้มอยู่ด้านล่าง ถัดลงมาเป็นคำว่า JOKER ตัวอักษรหนาสีแดงเลือดหมูขอบทอง และคำว่า SLOTZ สีทองด้านล่าง";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: JOKERSLOTZ เป็นเว็บสล็อตโจ๊กเกอร์ ไม่ใช่เว็บหวย
// สองหน้านั้นถูกพักไว้ที่ src/pages-disabled/ จึงไม่มี route อยู่จริง — ลิงก์ไป
// จะเป็น href ตาย ซึ่ง verify-build.mjs ทำให้ build แดง
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d9b45e]/45 bg-[#1c0202] pt-16 pb-8 font-sans text-[#ecdfd0] shadow-[0_-15px_40px_rgba(165,21,21,0.28)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#a51515]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(217,180,94,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#c81e1e] to-[#6d0d0d] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                JOKER<span class="bg-gradient-to-r from-[#f2dc9a] to-[#bc9b5b] bg-clip-text text-transparent">SLOTZ</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d9b45e]/55 pl-4 text-sm leading-relaxed text-[#ecdfd0]/75">
          {BRAND_NAME} ให้บริการเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming ผ่านบัญชีเดียว พร้อมอัปเดตลิ้งก์ทางเข้าสำรองล่าสุดให้เข้าใช้งานได้ต่อเนื่องแม้ลิ้งก์หลักถูกบล็อก รองรับการเล่นผ่านมือถือทุกรุ่นทั้ง iOS และ Android แท็บเล็ต และคอมพิวเตอร์ โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต ฝากถอนออโต้ รับโปรโมชั่น และจัดการบัญชีได้จากหน้าเว็บไซต์ รองรับทุกธนาคารและ TrueMoney Wallet พร้อม LINE OFFICIAL สำหรับติดต่อแอดมินตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#d9b45e]/45 bg-[#2b0204]/60 px-4 py-1 text-xs font-medium text-[#f2dc9a] backdrop-blur-sm">โจ๊กเกอร์สล็อต · ทางเข้าสำรอง · ฝากถอนออโต้</span>
          <span class="rounded-full border border-[#ecdfd0]/25 bg-[#0f0101]/60 px-4 py-1 text-xs font-medium text-[#ecdfd0]/70 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#d9b45e] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#a51515]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ecdfd0]/75">
          <li><a href="/" class="transition-colors hover:text-[#f2dc9a]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f2dc9a]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f2dc9a]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f2dc9a]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f2dc9a]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f2dc9a]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f2dc9a]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f2dc9a]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#d9b45e] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#a51515]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ecdfd0]/60 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6d0d0d]/80 pt-8 text-xs font-medium tracking-wide text-[#ecdfd0]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f2dc9a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f2dc9a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
