---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-22 จริง — ถุงเงินสีฟ้ากับปึกธนบัตรของ
// รวยแทร่168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย ไม่มีลายกนกไทยกับเปลวไฟแดง
// ของ สมหวัง168 ไม่มีหัวสิงโตสวมมงกุฎของ ufalion168 และไม่มีลูกฟุตบอลลายทองของ
// ยูฟ้า168 — รอบนี้เป็น **เวิร์ดมาร์กล้วน ไม่มีมาสคอตและไม่มีสัญลักษณ์ประกอบ**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นคำว่า สบาย เขียนด้วยตัวอักษรไทยหนาสามมิติผิวมันวาวสีทองคานารี ไล่เฉดจากเหลืองอ่อนด้านบนลงมาเป็นทองเข้มด้านล่าง ตัดขอบดำหนาและมีแสงสะท้อนสีขาวพาดอยู่บนตัวอักษร ต่อท้ายด้วยตัวเลข 168 ตัวหนาสามมิติผิวมันวาวสีฟ้าสกาย ไล่เฉดจากฟ้าอ่อนด้านบนลงมาเป็นฟ้าเข้มด้านล่าง ตัดขอบดำหนาและมีแสงสะท้อนสีขาวเช่นกัน ไม่มีสัญลักษณ์หรือมาสคอตอื่นประกอบ`;

// สบาย168 (รอบฟ้าสกายนำ-ทองคานารีรอง บนธีมสว่าง 2026-10-22): ไฟล์นี้ถูกเลื่อน
// ขึ้นมาเป็น footer ที่ใช้งานจริงรอบนี้ แทน FooterCyber ของ ยูฟ้า168 — หนึ่งไฟล์
// ต่อรอบ ทรงก็คนละตัว: FooterCyber เป็นแผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลม
// กลางจอ มีตารางเส้นพื้นหลัง และปุ่มตัดมุมทแยง ส่วนไฟล์นี้เป็นแผ่น
// rounded-t-[3rem] เต็มความกว้างที่มีออราเรืองแสงเบลอคร่อมขอบบน และเนื้อในเป็น
// กริด 12 คอลัมน์แบบ 5/3/4
//
// ⚠️⚠️ **พื้นเพจรอบนี้สว่าง (#ccf7ff จาก bg.json) แต่ footer เป็นโครม จึงเป็น
// น้ำเงินมหาสมุทรลึก #04293d** — ทิศของธีมรอบนี้คือ **เนื้อหาเป็นการ์ดขาว
// หมึกน้ำเงิน ส่วนหัว-ท้ายเป็นสมอน้ำเงินลึกขอบฟ้า-ทอง** ห้าม "แก้" ครึ่งใดครึ่งหนึ่ง
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: สบาย168 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ สบาย168 (.claude/brand-spec-sabai168.md §2): **ฟ้าสกาย + ทองคานารี
// อ่านจาก palette.json ที่วัด vivid ของ logo.webp เอง** โลโก้เป็นคำว่า สบาย สีทอง
// คานารีคู่กับเลข 168 สีฟ้าสกาย และอาร์ตเวิร์กเป็นโรงเรือนปลูกผักกลางวันแดดจัด
// ฟุตเตอร์จึงเดินฟ้าแบรนด์ #2cc3fc เป็นขอบ/ออรา · ฟ้าน้ำแข็ง #6bdcfb เป็นลิงก์ตอน
// hover · ทองคานารี #fdcb0c เป็นหัวคอลัมน์และกรอบชิปใบที่สอง · น้ำเงินยก #0a4f74
// เป็นปลายเข้มของเส้นไล่เฉดและเส้นคั่นล่าง พื้นเป็นน้ำเงินหมึก #04293d (จม) /
// #063a57 (กลาง) / #0a4f74 (ยก)
// เนื้อความฟ้าขาว #eafaff (14.4:1 บน #04293d) ตัวรอง #a9e3f9 (10.8:1)
//
// ⚠️ ชุดฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168 ที่เคยอยู่ในไฟล์นี้ (039cfa / 0494f5 /
// c3ebfc / 04366b / f9a826 / 704504 / e3f2fc / 0b2d52 / 071e38 / 030f1d / 031320 /
// 7fa8cc / 9dc4e4) ชุดแดงมังกร-ทองไทยของ สมหวัง168 (fa0513 / ff5a5f / ffadaf /
// e3b23c / ffe5a8 / 8c0204 / 8a6210 / 140706 / 2c1413 / 1f0d0c / 170504 / f4ecea /
// ccb9b6) ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3 / 0292fb / 6ec8ff /
// cfdcec / 9db4d4 / dde8f7 / 102a5e / 0a1c42 / 040e26 / 00081f / 032dad / 04186e)
// ชุดทองอำพันเสือของ TIGERWIN369 (d98324 / ffd98a / 8a5214 / f7b733 / 0f0903 /
// 2d1c0a / 1c1206 / f7e4c0 / e3cfae) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877
// (f5c518 / ffdd73 / b8860f / ff3b14 / 2b0000 / 6d0804 / 430000 / fdf0e2 / f8d2bb)
// และชุดทอง-มรกตของ KOON234 (cc920a / f7d14e / 8a6204 / 2fbf6a / 020803 / 09190d /
// 051007) ออกครบทุกจุดแล้ว **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม และไม่มีเงิน/โครเมียมเลยสักจุด**
// ⚠️⚠️ ฟ้าของรอบนี้ (#2cc3fc) กับทองคานารี (#fdcb0c) อ่านมาจาก palette.json ของดรอป
// นี้และจากอาร์ตเวิร์กโดยตรง ไม่ใช่ "ฟ้าทั่วไป" หรือ "ทองทั่วไป" — **สามแบรนด์ใน
// รีโปนี้เคยเป็นฟ้าคู่ทองเหมือนกันเป๊ะในเชิงตระกูลสี** (รวยแทร่168 039cfa+f9a826,
// นินจา168 32bcfb+fef54b, **สบายเบท168 2f9ff5+ffc82e ซึ่งชื่อใกล้ที่สุดในรีโปนี้
// ด้วย**) และ ยูฟ้า168 รอบก่อนก็มีทอง (fee45d) การมีฟ้าหรือทองอยู่แล้วจึงไม่พิสูจน์
// อะไร ให้เทียบเป็นตัวเลขทีละค่า (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หา
// สีแบรนด์เก่าไม่สะดุดที่คอมเมนต์ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §4 §5): เกมสล็อตออนไลน์ที่มีรูปแบบการ
// เดิมพันหลากหลาย รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ · ข้อมูลการสมัคร
// สมาชิก โปรโมชั่น และช่องทางฝากถอน · คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ·
// เจ้าหน้าที่ 24ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ธนาคาร หรือยอดขั้นต่ำเป็น
// ตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง (แม้เดิมพันด้วยเงินจำนวน
// น้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงิน · คำกล่าวอ้างว่ายอดเงินเข้าบริษัทโดยตรงควร
// ยืนยันจากข้อมูลนิติบุคคลและบัญชีรับเงินที่ตรวจสอบได้ · ไม่เปิดเผยรหัสผ่านหรือรหัส
// OTP ให้บุคคลอื่น) ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
// ⚠️ แบรนด์นี้เป็นเว็บเกมสล็อตเบทต่ำล้วน คำของรอบก่อนๆ (ฐานหลักเว็บพนันออนไลน์
// แทงบอล ฟุตบอล ราคาต่อรอง ค่าน้ำ บาคาร่า เกมไพ่ คาสิโน เว็บตรง100% ไม่ผ่านม้า
// ไม่มีขั้นต่ำ แฟนเพจเว็บบอลยูฟ่า PG SOFT JOKER JILI ยิงปลา ไฮโล หวยออนไลน์)
// **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออกทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
//
// BankStrip เป็นแถบโลโก้ธนาคารที่ variant นี้ import มาเองตามทรงของมัน —
// **ไฟล์นั้นไม่มีสีของแบรนด์และต้องไม่มีตลอดไป** สีที่เห็นเป็นสีซีแมนติกของแบรนด์
// ธนาคารซึ่งอบมาใน PNG แล้ว รีแบรนด์รอบไหนก็ต้องข้ามไฟล์นั้นไป สิ่งที่ปรับได้คือ
// ป้ายกำกับกับกรอบรอบๆ ซึ่งอยู่ในไฟล์นี้ และบรีฟรอบนี้พูดถึง "ช่องทางฝากถอน" จริง
// (content.txt บรรทัด 4) จึงมีเหตุผลให้คงแถบนี้ไว้
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#2cc3fc]/50 bg-[#04293d] pt-16 pb-8 font-sans text-[#eafaff] shadow-[0_-15px_40px_rgba(44,195,252,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#2cc3fc]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(44,195,252,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fefb6b] via-[#fdcb0c] to-[#2cc3fc] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#2cc3fc]/60 pl-4 text-sm leading-relaxed text-[#eafaff]/85">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ที่มีรูปแบบการเดิมพันหลากหลาย รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ สำหรับผู้ที่ต้องการศึกษารูปแบบเกมและจัดการงบประมาณของตนเอง ภายในเว็บไซต์มีข้อมูลเกี่ยวกับการสมัครสมาชิก
          โปรโมชั่น และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน โปรโมชั่นตามข้อมูลที่ระบุมีคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% โดยแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม
          และรอบเวลารับเครดิตแตกต่างกัน จึงควรตรวจสอบจากประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง ทั้งนี้ควรเข้าใจว่าแม้เดิมพันด้วยเงินจำนวนน้อยก็ยังมีความเสี่ยงต่อการสูญเสียเงิน ส่วนคำกล่าวอ้างว่ายอดเงินเข้าบริษัทโดยตรงควรยืนยันจากข้อมูลนิติบุคคล
          และบัญชีรับเงินที่ตรวจสอบได้ เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ผู้ให้บริการก็ตาม
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#6bdcfb]/50 bg-[#063a57]/70 px-4 py-1 text-xs font-medium text-[#a9e3f9] backdrop-blur-sm">เกมสล็อตเบทต่ำ · ช่องทางติดต่อผู้ให้บริการ</span>
          <span class="rounded-full border border-[#fdcb0c]/55 bg-[#063a57]/70 px-4 py-1 text-xs font-medium text-[#fdcb0c] backdrop-blur-sm">LINE OFFICIAL 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fdcb0c] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#2cc3fc] to-[#0a4f74]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#eafaff]/85">
          <li><a href="/" class="transition-colors hover:text-[#6bdcfb]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#6bdcfb]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#6bdcfb]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#6bdcfb]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#6bdcfb]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#6bdcfb]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#6bdcfb]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#6bdcfb]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fdcb0c] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#2cc3fc] to-[#0a4f74]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#a9e3f9] uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#0a4f74] pt-8 text-xs font-medium tracking-wide text-[#eafaff]/75 md:flex-row">
