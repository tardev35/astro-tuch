---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ SUPERMAX168 คำว่า SUPER เป็นตัวอักษรเอียงหนาสีทองไล่เฉด ต่อด้วยคำว่า MAX สีเงินโครเมียม ด้านล่างเป็นชิปคาสิโนสีทองที่มีสัญลักษณ์โพดำอยู่ตรงกลาง ตามด้วยเลข 168 สีทองมันวาว";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d2a43b]/45 bg-[#0d0904] pt-16 pb-8 font-sans text-[#f3e6c8] shadow-[0_-15px_40px_rgba(236,201,100,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ecc964]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(236,201,100,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fff8e2] to-[#ba8219] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                SUPERMAX<span class="bg-gradient-to-r from-[#fff8e2] to-[#e3e3e4] bg-clip-text text-transparent">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d2a43b]/55 pl-4 text-sm leading-relaxed text-[#f3e6c8]/75">
          {BRAND_NAME} เว็บคาสิโนออนไลน์ที่รวมหลายรูปแบบการเดิมพันไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต บอล หวย และไฮโล รองรับการใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ตลอด 24 ชั่วโมง สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต รับโปรโมชั่น และจัดการฝากถอนได้จากหน้าเว็บไซต์ พร้อมระบบรองรับวอลเลทและธนาคาร รวมถึงมีแอดมินคอยช่วยเหลือเมื่อพบปัญหาระหว่างใช้งาน
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#d2a43b]/40 bg-[#1b140b]/50 px-4 py-1 text-xs font-medium text-[#ecc964] backdrop-blur-sm">เว็บตรง 100% ทางเข้าแท้</span>
          <span class="rounded-full border border-[#e3e3e4]/35 bg-[#030201]/60 px-4 py-1 text-xs font-medium text-[#cbb98d] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ecc964] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#d2a43b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f3e6c8]/75">
          <li><a href="/" class="transition-colors hover:text-[#ecc964]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ecc964]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ecc964]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ecc964]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ecc964]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ecc964]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ecc964]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ecc964]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ecc964] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#d2a43b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#cbb98d]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#5a4212]/80 pt-8 text-xs font-medium tracking-wide text-[#f3e6c8]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ecc964]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ecc964]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
