---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ HENG35 มงกุฎทองประดับอัญมณีสีดำอยู่ด้านบนสุดบนวงแหวนทองโค้ง ใต้ลงมาเป็นตัวอักษร HENG สีเงินโครเมียมขอบทอง และตัวเลข 35 สีทองสามมิติ ขนาบสองข้างด้วยโล่ทองที่มีลายไพ่โพดำและดอกจิกสีดำ ฐานล่างเป็นลวดลายทองแบบคลาสสิก";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: HENG35 เป็นเว็บสล็อต บรีฟไม่มีหัวข้อหวย
// สองหน้านั้นจอดอยู่ที่ src/pages-disabled/ จึงไม่มี route — ถ้าเหลือลิงก์ไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ HENG35 (ดำ-ทอง 2026-09-21): พื้นดำ #070605 ออร่าและขอบเป็นทองหลัก
// #ecc55c หัวคอลัมน์และลิงก์ hover เป็นทองสว่าง #fefac4 เส้นคั่นล่างบรอนซ์
// #5e4418 เนื้อความ #ece1cb — โทนทองของแบรนด์ก่อนหน้าที่เคยอยู่ในไฟล์นี้
// ถูกแทนครบทุกจุดแล้ว
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#ecc55c]/45 bg-[#070605] pt-16 pb-8 font-sans text-[#ece1cb] shadow-[0_-15px_40px_rgba(236,197,92,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ecc55c]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(254,250,196,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fefac4] to-[#5e4418] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ecc55c]/55 pl-4 text-sm leading-relaxed text-[#ece1cb]/75">
          {BRAND_NAME} เปิดรับสมาชิกใหม่ที่ต้องการเริ่มเล่นสล็อตผ่านระบบที่ใช้งานง่าย ไม่ล็อคยูส พร้อมสิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด รองรับทั้งมือถือและคอมพิวเตอร์ มีเกมจากหลายค่ายให้เลือกและจัดหมวดหมู่ไว้ชัดเจน ค้นหาเกมที่ต้องการได้จากหน้าเดียว พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน ตรวจสอบยอดและสถานะฝากถอนได้จากบัญชีสมาชิกโดยตรง และมีแอดมินดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#ecc55c]/45 bg-[#1c1710]/60 px-4 py-1 text-xs font-medium text-[#fefac4] backdrop-blur-sm">สล็อตหลายค่าย · ไม่ล็อคยูส · ฝากถอนไม่จำกัด</span>
          <span class="rounded-full border border-[#ece1cb]/25 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#ece1cb]/70 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fefac4] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#ecc55c]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ece1cb]/75">
          <li><a href="/" class="transition-colors hover:text-[#fefac4]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fefac4]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fefac4]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fefac4]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fefac4]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fefac4]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fefac4]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fefac4]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fefac4] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#ecc55c]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ece1cb]/60 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#5e4418]/60 pt-8 text-xs font-medium tracking-wide text-[#ece1cb]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fefac4]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fefac4]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
