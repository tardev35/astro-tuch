---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นวงแหวนทองเมทัลลิกเปิดช่องด้านบนและล่าง ภายในวงมีตัวอักษร UOK ตัวหนาสีทองไล่เงาวาวเรียงอยู่แถวบน และตัวเลข 365 ตัวหนาสีเงินโครเมียมเรียงอยู่แถวล่าง`;

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียมบนดำ 2026-10-07): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// footer ที่ใช้งานจริงรอบนี้ แทน FooterCyber ของ BOOM369 — หนึ่งไฟล์ต่อหนึ่งรอบ
//
// ⚠️ ถอดลิงก์ /ตรวจหวย และ /แนวทาง ออกแล้ว: ของเดิมในไฟล์นี้เป็นของ หวยดีใจ ซึ่ง
// เป็นเว็บหวย สองหน้านั้นจอดอยู่ใน src/pages-disabled/ สำหรับแบรนด์สล็อตอย่าง
// UOK365 จึงไม่มี route จริง ถ้าเหลือไว้ verify-build จะจับเป็น href ไปยังหน้าที่
// ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ UOK365 (brand-spec §2): ทองเป็นฮิวเดียว เงินโครเมียมเป็นโลหะที่สอง ตาม
// โลโก้ที่เป็นตัว UOK ทองวางทับเลข 365 เงิน — ฟุตเตอร์จึงเดินทองเป็นหลัก (#c8912f
// ขอบ/ออรา · #f5d98a หัวคอลัมน์และลิงก์ตอน hover · #6d4412 เส้นคั่นล่าง · #a46b25
// ปลายเข้มของเส้นไล่เฉด) และให้ชิปใบที่สองถือเงินโครเมียม #d8dbe0 เพื่อให้คู่ป้าย
// อ่านเป็น "ทอง-เงิน" ตามโลโก้จริง พื้นเป็นน้ำตาลเกือบดำ #0a0806 / #19100a
// เนื้อความ #ece1cc (BRAND_TEXT)
//
// ชุดแดง-เงินของ หวยดีใจ ที่เคยอยู่ในไฟล์นี้ (#0d0407 #dc0409 #f5363d #4b0205
// #211016 #17080c #c3c7d1 #eef0f4 #edeaf0 #f3c54e) ออกครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §4 §6): เว็บสล็อตเบทต่ำ ทุนน้อยก็เล่นได้
// รวมเกมหลายรูปแบบในระบบเดียว ทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่ ·
// เลือกเกมจากช่วงเดิมพันและตรวจตารางจ่ายก่อนเริ่ม · โปรโมชั่นคืนยอดเสีย 0.3% และ
// แนะนำเพื่อน 0.8% · แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ธนาคาร
// หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// ("ไม่มีขั้นต่ำ" ควรอ้างอิงจากเกมที่เปิดให้บริการจริง เพราะแต่ละค่ายกำหนดยอดต่ำสุด
// ไม่เท่ากัน) ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#c8912f]/50 bg-[#0a0806] pt-16 pb-8 font-sans text-[#ece1cc] shadow-[0_-15px_40px_rgba(200,145,47,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#c8912f]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(200,145,47,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#f5d98a] via-[#d8dbe0] to-[#6d4412] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#c8912f]/60 pl-4 text-sm leading-relaxed text-[#ece1cc]/75">
          {BRAND_NAME} เป็นเว็บเล่นสล็อตเบทต่ำที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ เหมาะกับผู้ที่มีทุนน้อยและต้องการแบ่งงบเล่นเป็นรอบ สมาชิกเลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนด ตรวจสอบตารางจ่าย ฟีเจอร์โบนัส และช่วงเดิมพันของแต่ละเกมก่อนเริ่มได้ และใช้บัญชีเดียวดูเครดิต โปรโมชั่น และประวัติรายการผ่านมือถือ โดยมีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์ตามรอบที่กำหนด พร้อมแอดมินดูแลตลอด 24 ชั่วโมง ทั้งนี้คำว่าไม่มีขั้นต่ำควรอ้างอิงจากเกมที่เปิดให้บริการจริง เนื่องจากเกมสล็อตแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดและสูงสุดไม่เท่ากัน จึงควรยึดตัวเลขที่แสดงภายในเกมเป็นหลักและกำหนดงบก่อนเล่นทุกครั้ง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#c8912f]/50 bg-[#19100a]/70 px-4 py-1 text-xs font-medium text-[#f5d98a] backdrop-blur-sm">สล็อตเบทต่ำ · ฟรีสปิน · โบนัส · ตัวคูณ</span>
          <span class="rounded-full border border-[#d8dbe0]/45 bg-[#120c07]/70 px-4 py-1 text-xs font-medium text-[#d8dbe0]/90 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f5d98a] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f5d98a] to-[#6d4412]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ece1cc]/75">
          <li><a href="/" class="transition-colors hover:text-[#f5d98a]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f5d98a]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f5d98a]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f5d98a]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f5d98a]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f5d98a]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f5d98a]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f5d98a]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f5d98a] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f5d98a] to-[#6d4412]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d8dbe0]/75 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6d4412]/70 pt-8 text-xs font-medium tracking-wide text-[#ece1cc]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f5d98a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5d98a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
