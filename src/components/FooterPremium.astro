---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-10 จริง — วงแหวนเขียวมรกตกับตัว KOON
// เงินโครเมียมของ KOON234 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเหรียญกลมขอบทองหนาเงาวาว พื้นในเหรียญเป็นแดงเข้มไล่เงา มีสายฟ้าขนาดใหญ่สีทองไล่ส้มผ่าทแยงจากมุมขวาบนลงมามุมซ้ายล่างทะลุขอบเหรียญออกไปทั้งสองด้าน และมีประกายไฟแลบรอบสายฟ้า ด้านหน้าคาดคำว่า FLASH เป็นตัวอักษรละตินหนาสามมิติสีทองไล่เงาตัดขอบเข้ม ต่อด้วยตัวเลข 877 สามมิติสีแดงสดตัดขอบเข้ม วางพาดกลางเหรียญในแนวเอียงขึ้นเล็กน้อยไปทางขวา`;

// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// footer ที่ใช้งานจริงรอบนี้ แทน FooterStyle2 ของ SUPERSLOTCLUB — หนึ่งไฟล์ต่อรอบ
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: FLASH877 เป็นเว็บตรงฐานสล็อตหลัก ไม่ใช่
// เว็บหวย สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ FLASH877 (brand-spec §2): **ทองเป็นฮิวนำ** แดงสายฟ้าเป็นฮิวที่สองจริง
// ตามโลโก้ที่เป็นสายฟ้าทองผ่ากลางเหรียญแดง คำว่า FLASH ทอง เลข 877 แดง —
// ฟุตเตอร์จึงเดินทองเป็นหลัก (#f5c518 ขอบ/ออรา · #ffdd73 หัวคอลัมน์และลิงก์ตอน
// hover · #b8860f เส้นคั่นล่างและปลายเข้มของเส้นไล่เฉด) และให้ชิปใบที่สองถือ
// กรอบแดงสายฟ้า #ff3b14 เพื่อให้คู่ป้ายอ่านเป็น "ทอง-แดง" ตามโลโก้จริง
// พื้นแดงเลือดนก #2b0000 / #6d0804 / #430000 เนื้อความ #fdf0e2 (BRAND_TEXT)
//
// ⚠️ ตัวอักษรในชิปใบที่สองเป็นเนื้อความรอง #f8d2bb ไม่ใช่ #ff3b14 เอง — #ff3b14
// บนพื้น #430000 เหลือ ≈4.75:1 ซึ่งหมิ่นเกินไปสำหรับ text-xs แดงรอบนี้จึงถือแค่
// "กรอบ" ของชิป ไม่ถือตัวอักษร (brand-spec §2 เตือนข้อนี้ไว้แล้ว)
//
// ชุดทอง-มรกตของ KOON234 ที่เคยอยู่ในไฟล์นี้ (#cc920a #f7d14e #8a6204 #2fbf6a
// #020803 #09190d #051007 #e8f2e6 #e9eef0 rgba(204,146,10,α)) ออกครบทุกจุดแล้ว
// ⚠️ ทองของรอบนี้ (#f5c518) เป็นคนละค่ากับทอง #cc920a ของ KOON234 และแบรนด์
// รอบก่อนหน้า (SUPERSLOTCLUB) ก็เป็นคู่แดง-ทองเหมือนกัน — อย่าปล่อยค่าเก่าไว้
// เพราะ "ดูคล้ายกัน" ให้เทียบเป็นตัวเลขทีละค่า
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §5 §6): เว็บตรงฐานสล็อตหลักที่รวม
// เกมสล็อตหลายประเภทไว้ในบัญชีเดียว · รองรับมือถือและคอมพิวเตอร์ · ค้นหาเกม
// ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากหน้าเดียว · อัปเดตระบบเข้าเล่นใหม่
// 2026 ครอบคลุมหน้าเข้าสู่ระบบ เมนูเลือกเกม ส่วนจัดการบัญชี · คืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8% · แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม
// ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// (ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานยืนยัน · ควรตรวจสอบช่องทางหลักก่อน
// Login ทุกครั้ง · ห้ามเปิดเผยรหัสผ่าน PIN หรือ OTP) ติดมาด้วย ไม่ถูกตัดทิ้ง
// เพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f5c518]/50 bg-[#2b0000] pt-16 pb-8 font-sans text-[#fdf0e2] shadow-[0_-15px_40px_rgba(245,197,24,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f5c518]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(245,197,24,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fdf0e2] via-[#f5c518] to-[#ff3b14] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f5c518]/60 pl-4 text-sm leading-relaxed text-[#fdf0e2]/75">
          {BRAND_NAME} เป็นเว็บตรงฐานสล็อตหลักที่รวบรวมเกมสล็อตหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากหน้าเดียว
          การอัปเดตระบบเข้าเล่นใหม่ในปี 2026 ครอบคลุมทั้งหน้าเข้าสู่ระบบ เมนูเลือกเกม และส่วนจัดการบัญชี โดยมีโปรโมชั่นคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% สำหรับยอดที่เข้าเกณฑ์ตามรอบคำนวณที่เว็บไซต์กำหนด พร้อมแอดมินดูแลตลอด 24 ชั่วโมง
          ทั้งนี้ข้อความว่าไม่ผ่านเอเย่นต์และเว็บฐานหลัก 100% ควรมีข้อมูลผู้ดำเนินงานและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ ไม่ควรใช้คำโฆษณาเพียงอย่างเดียวเป็นหลักฐานยืนยัน สมาชิกจึงควรตรวจสอบช่องทางหลักก่อน Login ทุกครั้ง และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f5c518]/50 bg-[#6d0804]/70 px-4 py-1 text-xs font-medium text-[#ffdd73] backdrop-blur-sm">เว็บตรงฐานสล็อตหลัก · ไม่ผ่านเอเย่นต์</span>
          <span class="rounded-full border border-[#ff3b14]/55 bg-[#430000]/70 px-4 py-1 text-xs font-medium text-[#f8d2bb] backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffdd73] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#ffdd73] to-[#b8860f]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fdf0e2]/75">
          <li><a href="/" class="transition-colors hover:text-[#ffdd73]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffdd73]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffdd73]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffdd73]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffdd73]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffdd73]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffdd73]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffdd73]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffdd73] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#ffdd73] to-[#b8860f]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#f8d2bb]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#b8860f]/70 pt-8 text-xs font-medium tracking-wide text-[#fdf0e2]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffdd73]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffdd73]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
