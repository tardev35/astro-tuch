---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ FAH999 รูปโพดำสีชมพูนีออนขอบม่วง ตามด้วยตัวอักษร FAH สีชมพูบานเย็นและเลข 999 สีม่วงเมทัลลิก";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#c2249b]/45 bg-[#0d0114] pt-16 pb-8 font-sans text-[#e6cfe9] shadow-[0_-15px_40px_rgba(194,36,155,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#c2249b]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(251,68,179,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffb3e2] to-[#c2249b] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                FAH<span class="bg-gradient-to-r from-[#c98cff] to-[#6b1fa8] bg-clip-text text-transparent">999</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#c2249b]/55 pl-4 text-sm leading-relaxed text-[#e6cfe9]/75">
          FAH999 จุดรวมเกมสล็อตออนไลน์สำหรับผู้ที่ต้องการเลือกเล่นหลากหลายรูปแบบผ่านมือถือและคอมพิวเตอร์ ทั้งสล็อตธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือ พร้อมโปรโมชั่นสำหรับสมาชิกตามเงื่อนไข ระบบรองรับการฝากถอนและการจัดการบัญชีออนไลน์ ติดต่อแอดมินได้ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#c2249b]/40 bg-[#2a0640]/50 px-4 py-1 text-xs font-medium text-[#ffb3e2] backdrop-blur-sm">สล็อตมือถือ</span>
          <span class="rounded-full border border-[#c98cff]/35 bg-[#1c0430]/60 px-4 py-1 text-xs font-medium text-[#c98cff] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffb3e2] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#c2249b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e6cfe9]/75">
          <li><a href="/" class="transition-colors hover:text-[#ffb3e2]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffb3e2]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffb3e2]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffb3e2]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffb3e2]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffb3e2]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffb3e2]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffb3e2]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffb3e2] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#c2249b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c98cff]/70 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6b1fa8]/70 pt-8 text-xs font-medium tracking-wide text-[#e6cfe9]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} FAH999 SLOT. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffb3e2]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffb3e2]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
