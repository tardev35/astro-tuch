---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ TTN69 เป็นรูปทิวเขาสูงหลายยอดสีขาวมีร่องเขาสีเขียวมรกต ด้านล่างเป็นตัวอักษร TTN สีขาวโครเมียมวางเอียง ตามด้วยเลข 69 สีขาวบนแถบโค้งสีเขียวมรกต";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: TTN69 เป็นเว็บสล็อต สองหน้านั้นถูกพักไว้ที่
// src/pages-disabled/ จึงไม่มี route อยู่จริง — ลิงก์ไปจะเป็น href ตาย ซึ่ง
// verify-build.mjs ทำให้ build แดง
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#02b961]/45 bg-[#061309] pt-16 pb-8 font-sans text-[#d5e6da] shadow-[0_-15px_40px_rgba(2,185,97,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#02b961]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(2,185,97,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#f1faf4] to-[#e4ece7] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                TTN<span class="bg-gradient-to-r from-[#4ce68f] to-[#046b3a] bg-clip-text text-transparent">69</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#02b961]/55 pl-4 text-sm leading-relaxed text-[#d5e6da]/75">
          {BRAND_NAME} เว็บสล็อตออโต้ที่รวมเกมจากหลายแบรนด์ไว้ให้เลือกในบัญชีเดียว รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบเครดิต ฝากถอน และรับโปรโมชั่นได้จากหน้าเว็บไซต์ พร้อมช่องทางธนาคารและวอลเลทตามที่ระบบรองรับ รวมถึงมี LINE OFFICIAL สำหรับติดต่อแอดมินและสอบถามปัญหาการใช้งานได้ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#02b961]/40 bg-[#0c2214]/50 px-4 py-1 text-xs font-medium text-[#4ce68f] backdrop-blur-sm">สล็อตออโต้เกม รวมแบรนด์ดัง</span>
          <span class="rounded-full border border-[#e4ece7]/35 bg-[#020805]/60 px-4 py-1 text-xs font-medium text-[#9bb0a4] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#4ce68f] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#02b961]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d5e6da]/75">
          <li><a href="/" class="transition-colors hover:text-[#4ce68f]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#4ce68f]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#4ce68f]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#4ce68f]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#4ce68f]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#4ce68f]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#4ce68f]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#4ce68f]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#4ce68f] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#02b961]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#9bb0a4]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#046b3a]/80 pt-8 text-xs font-medium tracking-wide text-[#d5e6da]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#4ce68f]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#4ce68f]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
