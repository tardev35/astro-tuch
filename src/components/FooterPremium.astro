---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ ENTER55 ตัวอักษรภาษาอังกฤษ ENTER55 แบบหนาสีทองเมทัลลิก ไล่เฉดจากทองอ่อนถึงทองเข้ม บนพื้นหลังโปร่งใส";

// มีลิงก์ /ตรวจหวย และ /แนวทาง: ENTER55 รับแทงหวยด้วย (บรีฟมีหัวข้ออัตราจ่าย
// หวย 2 ตัว/3 ตัว) สองหน้านั้นถูกย้ายกลับมาที่ src/pages/ แล้ว จึงมี route จริง
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#c4a255]/45 bg-[#0b0b0a] pt-16 pb-8 font-sans text-[#ded8cb] shadow-[0_-15px_40px_rgba(196,162,85,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#c4a255]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(235,212,132,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ebd484] to-[#8a6d2c] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#c4a255]/55 pl-4 text-sm leading-relaxed text-[#ded8cb]/75">
          {BRAND_NAME} รวมเกมสล็อตและหวยออนไลน์ไว้ครบในทางเข้าเดียว เป็นเว็บตรงไม่ผ่านเอเย่นต์ ใช้ระบบกระเป๋าเดียว Single Wallet ฝากเงินครั้งเดียวก็สลับไปเล่นได้ทั้งสล็อตและแทงหวยโดยไม่ต้องโยกเครดิต เปิดรับหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น จ่ายเต็มทุกบิลไม่หักเปอร์เซ็นต์ เล่นผ่านมือถือทั้ง iOS และ Android แท็บเล็ต หรือคอมพิวเตอร์ได้โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน ฝาก-ถอนอัตโนมัติไม่มีขั้นต่ำตลอด 24 ชั่วโมง รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet พร้อม LINE OFFICIAL สำหรับติดต่อแอดมินตลอดเวลา
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#c4a255]/45 bg-[#16140f]/60 px-4 py-1 text-xs font-medium text-[#ebd484] backdrop-blur-sm">สล็อต · หวยออนไลน์ · กระเป๋าเดียว</span>
          <span class="rounded-full border border-[#ded8cb]/25 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#ded8cb]/70 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ebd484] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#c4a255]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ded8cb]/75">
          <li><a href="/" class="transition-colors hover:text-[#ebd484]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ebd484]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ebd484]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ebd484]">เข้าสู่ระบบ</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-[#ebd484]">ตรวจหวย</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-[#ebd484]">แนวทาง</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ebd484]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ebd484]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ebd484]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ebd484]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ebd484] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#c4a255]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ded8cb]/60 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#26200f] pt-8 text-xs font-medium tracking-wide text-[#ded8cb]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ebd484]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ebd484]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
