---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ WY88 ตัวอักษร WY สีชมพูมาเจนตาไล่เฉดจากอ่อนไปเข้มพร้อมขอบทองสามชั้น ต่อด้วยตัวเลข 88 สีทองสามมิติเงาวาวขอบชมพูมาเจนตา วางเรียงกันบนพื้นโปร่ง";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: WY88 เป็นเว็บคาสิโน/สล็อตและเกมสด บรีฟไม่มี
// หัวข้อหวย สองหน้านั้นจอดอยู่ที่ src/pages-disabled/ จึงไม่มี route — ถ้าเหลือ
// ลิงก์ไว้ verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ WY88 (ชมพูมาเจนตา-ทอง 2026-09-23): พื้นพลัมเกือบดำ #170411 ออร่าและ
// ขอบเป็นมาเจนตาหลัก #ec2b84 หัวคอลัมน์และลิงก์ hover เป็นทองสว่าง #fced94
// เส้นคั่นล่างทองเข้ม #c3832b เนื้อความ #fce9f3 — โทนดำ-ทองล้วนของแบรนด์
// ก่อนหน้าที่เคยอยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e8b33a]/45 bg-[#170411] pt-16 pb-8 font-sans text-[#fce9f3] shadow-[0_-15px_40px_rgba(236,43,132,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ec2b84]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(236,43,132,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ec2b84]/55 pl-4 text-sm leading-relaxed text-[#fce9f3]/75">
          {BRAND_NAME} เว็บรวมเกมออนไลน์ที่เน้นทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย ปรับหน้าระบบและเมนูใหม่ให้ใช้งานสะดวกกว่าเดิม รองรับทั้งมือถือและคอมพิวเตอร์ เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของแต่ละรายการ สมัครเองผ่านหน้าเว็บไซต์ได้ใน 3 ขั้นตอน ตรวจสอบยอดและสิทธิ์ที่เข้าเกณฑ์ได้จากบัญชีสมาชิกโดยตรง และมีแอดมินคาสิโนดูแลผ่าน LINE Official ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e8b33a]/45 bg-[#2e0a20]/60 px-4 py-1 text-xs font-medium text-[#fced94] backdrop-blur-sm">ทางเข้า VIP · เกมสดครบหมวด · บัญชีเดียวเล่นได้ทุกเกม</span>
          <span class="rounded-full border border-[#fce9f3]/25 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#fce9f3]/70 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fced94] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#e8b33a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fce9f3]/75">
          <li><a href="/" class="transition-colors hover:text-[#fced94]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fced94]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fced94]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fced94]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fced94]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fced94]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fced94]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fced94]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fced94] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#e8b33a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#fce9f3]/60 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#c3832b]/60 pt-8 text-xs font-medium tracking-wide text-[#fce9f3]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fced94]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fced94]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
