---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-17 จริง — ปีกเหยี่ยวน้ำเงินของ TSDET911
// ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย ไม่มีเหรียญตราหัวเสือ ไม่มีมงกุฎ
// ไม่มีกองชิป และไม่มีสายฟ้าของ FLASH877 ด้วย — รอบนี้เป็นเวิร์ดมาร์กไทยล้วน
// ที่มีลายกนกกับเปลวไฟประกอบ
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นคำว่า สมหวัง เขียนด้วยตัวอักษรสามมิติสีขาวอมเงินไล่เฉดฟ้าอ่อนและมีขอบสีแดงสด ต่อด้วยตัวเลข 168 สีแดงสดตัวหนาสามมิติที่มีขอบขาว ด้านบนของตัวอักษรเป็นลายกนกไทยสีแดงม้วนเป็นเกลียวคล้ายยอดเจดีย์ ด้านขวาบนเป็นเปลวไฟสีแดง และมีเส้นโค้งสีแดงพาดอยู่ใต้คำทั้งหมด`;

// สมหวัง168 (รอบแดงมังกร-ทองไทย บนดำอมแดง 2026-10-17): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// footer ที่ใช้งานจริงรอบนี้ แทน FooterStyle3 ของ GT66B — หนึ่งไฟล์ต่อรอบ
// ทรงก็คนละตัว: FooterStyle3 เป็น "การ์ด CTA ลอยคร่อมขอบบน" แล้วเว้น pt-64 ไว้รับ
// ส่วนไฟล์นี้เป็นแผ่น rounded-t-[3rem] เต็มความกว้างที่มีออราเรืองแสงคร่อมขอบบน
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: สมหวัง168 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ สมหวัง168 (.claude/brand-spec-somwang168.md §2): **แดงมังกร + ทองไทย
// ไม่มีฮิวเย็นเลยสักจุด** ตามงานศิลป์ที่โลโก้เป็นคำว่า สมหวัง โครเมียมขาวขอบแดง
// คู่กับเลข 168 แดงสด และแบนเนอร์มีลายกนก/นาคทองไทยขนาบสองข้าง ฟุตเตอร์จึงเดิน
// แดงแบรนด์ #fa0513 เป็นขอบ/ออรา · แดงสว่าง #ff5a5f เป็นลิงก์ตอน hover และกรอบ
// ชิปใบแรก · ทองสว่าง #ffe5a8 เป็นหัวคอลัมน์ · ทองไทย #e3b23c เป็นต้นของเส้น
// ไล่เฉดและกรอบชิปใบที่สอง · แดงลึก #8c0204 เป็นเส้นคั่นล่างและปลายเข้มของเส้น
// ไล่เฉด พื้นเป็นดำอมแดง #140706 (จม) / #2c1413 (ยก) / #1f0d0c (กลาง)
// เนื้อความขาวนวลอมอุ่น #f4ecea (= BRAND_TEXT) ตัวรอง #ccb9b6
//
// ⚠️ ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 ที่เคยอยู่ในไฟล์นี้ (0360f3 /
// 0292fb / 6ec8ff / cfdcec / 9db4d4 / dde8f7 / 102a5e / 0a1c42 / 040e26 /
// 00081f / 032dad / 04186e) ชุดทองอำพันเสือของ TIGERWIN369 ก่อนหน้านั้น
// (d98324 / ffd98a / 8a5214 / f7b733 / 0f0903 / 2d1c0a / 1c1206 / f7e4c0 /
// e3cfae) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (f5c518 / ffdd73 / b8860f /
// ff3b14 / 2b0000 / 6d0804 / 430000 / fdf0e2 / f8d2bb) และชุดทอง-มรกตของ
// KOON234 (cc920a / f7d14e / 8a6204 / 2fbf6a / 020803 / 09190d / 051007)
// ออกครบทุกจุดแล้ว **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีเขียว และ
// ไม่มีส้มเลยสักจุด**
// ⚠️ แดงของรอบนี้ (#fa0513) กับทอง (#e3b23c) อ่านมาจาก palette.json ของดรอปนี้
// และจากอาร์ตเวิร์กโดยตรง ไม่ใช่ "แดงทั่วไป" หรือ "ทองทั่วไป" — สองแบรนด์
// ก่อนหน้าทันที (GT66B fb141b, TKB55 fb131b) ก็เป็นแดง และ FLASH877 กับ
// TIGERWIN369 ก็มีทอง การมีแดงหรือทองอยู่แล้วจึงไม่พิสูจน์อะไร ให้เทียบเป็น
// ตัวเลขทีละค่า (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่า
// ไม่สะดุดที่คอมเมนต์ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §5 §7): ช่องทางติดต่อผู้ให้บริการ
// สำหรับผู้ที่ต้องการสอบถามข้อมูลและขอความช่วยเหลือเกี่ยวกับการใช้งานเว็บเกม
// สล็อต · ปัญหาการเข้าสู่ระบบ การตรวจสอบบัญชี การใช้งานเกม การสอบถามโปรโมชั่น ·
// คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% · LINE Official 24 ชม. — บรีฟไม่ได้ระบุ
// ใบอนุญาต ชื่อค่ายเกม ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้
// และข้อความกำกับของบรีฟเอง (ควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูล
// ส่วนตัว · ควรตรวจสอบเวลาตอบกลับจริง · ควรเลือกบัญชี LINE จากแหล่งข้อมูลทางการ
// เพื่อหลีกเลี่ยงบัญชีปลอม · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP) ติดมาด้วย
// ไม่ถูกตัดทิ้งเพราะฟังดูลบ
// ⚠️ แบรนด์นี้เป็นเว็บเกมสล็อตล้วน คำของสองรอบก่อน (บาคาร่า ไฮโล แทงบอล คาสิโน
// เซิร์ฟเวอร์ต่างประเทศ ยอดเข้าบริษัทโดยตรง ฝากถอนทุกธนาคาร ถูกลิขสิทธิ์
// ค่ายระดับเอเชีย) ไม่เหลือในไฟล์นี้แล้ว
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#fa0513]/50 bg-[#140706] pt-16 pb-8 font-sans text-[#f4ecea] shadow-[0_-15px_40px_rgba(250,5,19,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fa0513]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(250,5,19,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffe5a8] via-[#e3b23c] to-[#ff5a5f] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fa0513]/60 pl-4 text-sm leading-relaxed text-[#f4ecea]/75">
          {BRAND_NAME} เป็นช่องทางติดต่อผู้ให้บริการสำหรับผู้ที่ต้องการสอบถามข้อมูลและขอความช่วยเหลือเกี่ยวกับการใช้งานเว็บเกมสล็อต ไม่ว่าจะเป็นปัญหาการเข้าสู่ระบบ การตรวจสอบบัญชี การใช้งานเกม หรือการสอบถามโปรโมชั่น ผู้เล่นสามารถแจ้งรายละเอียดและติดตามสถานะการแก้ไขปัญหาได้สะดวก
          โปรโมชั่นตามข้อมูลที่กำหนดมีคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของกิจกรรม โดยควรตรวจสอบยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์จากช่องทางบริการที่เว็บไซต์แจ้งไว้ก่อนเข้าร่วมทุกครั้ง
          ทั้งนี้ควรตรวจสอบข้อมูลติดต่อจากช่องทางหลักก่อนส่งข้อมูลส่วนตัว และพิจารณาเวลาตอบกลับจริงจากหน้าเว็บไซต์ หากต้องส่งหลักฐานประกอบ ควรปิดบังข้อมูลสำคัญที่ไม่จำเป็น และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ผู้ให้บริการก็ตาม
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#ff5a5f]/50 bg-[#2c1413]/70 px-4 py-1 text-xs font-medium text-[#ff5a5f] backdrop-blur-sm">เว็บเกมสล็อต · ช่องทางติดต่อผู้ให้บริการ</span>
          <span class="rounded-full border border-[#e3b23c]/55 bg-[#1f0d0c]/70 px-4 py-1 text-xs font-medium text-[#ffe5a8] backdrop-blur-sm">LINE OFFICIAL 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe5a8] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#e3b23c] to-[#8c0204]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f4ecea]/75">
          <li><a href="/" class="transition-colors hover:text-[#ff5a5f]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ff5a5f]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ff5a5f]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ff5a5f]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ff5a5f]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ff5a5f]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ff5a5f]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ff5a5f]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe5a8] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#e3b23c] to-[#8c0204]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ccb9b6]/85 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8c0204]/80 pt-8 text-xs font-medium tracking-wide text-[#f4ecea]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ff5a5f]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ff5a5f]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
