---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ UP555 เป็นตัว U สีเงินโครเมียมที่มีลูกศรสีทองพุ่งขึ้นอยู่ข้างใน ล้อมรอบด้วยวงรีสีทองวางเอียง ถัดมาเป็นตัวอักษร UP สีเงินโครเมียมและเลข 555 สีทองเมทัลลิก ตัวหนาทรงเอียงเรียงติดกันเป็นบรรทัดเดียว";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: UP555 เป็นเว็บคาสิโน บรีฟพูดถึงหวยในฐานะหนึ่งใน
// หมวดเกมที่ระบบเปิดให้บริการเท่านั้น ไม่ใช่เว็บหวย สองหน้านั้นจอดอยู่ที่
// src/pages-disabled/ จึงไม่มี route — ถ้าเหลือลิงก์ไว้ verify-build จะจับเป็น href
// ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า จึงผิดทั้งเว็บพร้อมกัน)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ UP555 (ทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): โลโก้เป็นสองโทนจริง —
// ตัว U กับ UP เป็นเงินโครเมียม ส่วนลูกศร วงรี และเลข 555 เป็นทอง ฟุตเตอร์จึงเดิน
// ทองเป็นหลัก (#ebbb54 ขอบ/ออรา · #fce675 หัวคอลัมน์ · #6b4517 เส้นคั่นล่าง) และให้
// ชิปใบที่สองถือเงินโครเมียม #d5d4d3 เพื่อให้คู่ป้ายอ่านเป็น "ทอง-เงิน" ตามโลโก้จริง
// ไม่ใช่ทองอ่อน-ทองเข้มอย่างแบรนด์ทองรอบก่อนๆ พื้นเป็นดำอมน้ำตาล #130b03 / #241705
// ตามสีที่วัดได้จาก banner1 กับ slide1 เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทองของ NAZA99 ที่เคยอยู่ในไฟล์นี้ (#140c02 #e4b34d #fdf2ac #8a5f12 #f3e8cf
// #241404 #c08f2b #0a0501) ออกครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟ UP555: คาสิโนอัปเดตล่าสุด ปรับปรุงทางเข้าเล่นเกมใหม่ให้รองรับ
// มือถือ · รวมสล็อต บาคาร่า บอล หวย ไว้ในบัญชีเดียว · เลือกหมวดเกม ตรวจสอบเครดิต
// โปรโมชั่น และประวัติรายการผ่านระบบเดียว · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต ค่ายเกม ธนาคาร ยอดขั้นต่ำ หรือ RTP เป็นชื่อๆ
// จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง ("ผลการเดิมพันมีความไม่แน่นอน จึง
// ไม่สามารถรับประกันผลกำไรได้") ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#ebbb54]/45 bg-[#130b03] pt-16 pb-8 font-sans text-[#f8eed9] shadow-[0_-15px_40px_rgba(235,187,84,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ebbb54]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(235,187,84,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#f3f3f2] via-[#ebbb54] to-[#ab6d24] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ebbb54]/55 pl-4 text-sm leading-relaxed text-[#f8eed9]/75">
          {BRAND_NAME} เป็นเว็บคาสิโนที่ปรับปรุงทางเข้าเล่นเกมใหม่ให้รองรับการใช้งานผ่านมือถือได้สะดวกขึ้น รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งสล็อต บาคาร่า เดิมพันฟุตบอล และหวยตามรายการที่ระบบเปิดให้บริการ สมาชิกเลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และดูประวัติรายการได้จากระบบเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการมีประเภทเกม รอบตัดยอด และระยะเวลารับสิทธิ์ของตัวเอง จึงควรอ่านเงื่อนไขก่อนกดรับทุกครั้ง มีแอดมินดูแลตลอด 24 ชั่วโมง ทั้งนี้ผลการเดิมพันมีความไม่แน่นอน จึงไม่สามารถรับประกันผลกำไรหรือเงินรางวัลจากการเล่นได้
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#ebbb54]/45 bg-[#241705]/60 px-4 py-1 text-xs font-medium text-[#fce675] backdrop-blur-sm">สล็อต · บาคาร่า · บอล · หวย ในบัญชีเดียว</span>
          <span class="rounded-full border border-[#d5d4d3]/45 bg-[#0c0502]/60 px-4 py-1 text-xs font-medium text-[#d5d4d3]/85 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fce675] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fce675] to-[#6b4517]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f8eed9]/75">
          <li><a href="/" class="transition-colors hover:text-[#fce675]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fce675]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fce675]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fce675]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fce675]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fce675]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fce675]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fce675]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fce675] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fce675] to-[#6b4517]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ebbb54]/70 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6b4517]/60 pt-8 text-xs font-medium tracking-wide text-[#f8eed9]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fce675]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fce675]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
