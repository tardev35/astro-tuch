---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-23 จริง — เวิร์ดมาร์กทองคานารีล้วนของ
// สบาย168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย ไม่มีถุงเงินสีฟ้าของ
// รวยแทร่168 ไม่มีลายกนกไทยกับเปลวไฟแดงของ สมหวัง168 ไม่มีหัวสิงโตสวมมงกุฎของ
// ufalion168 และไม่มีลูกฟุตบอลลายทองของ ยูฟ้า168 — รอบนี้เป็น
// **ภาพคนจริงคู่เวิร์ดมาร์กสองสี (ฟ้าอมน้ำเงิน + แดงสด) ไม่มีทองสักจุด**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นภาพครึ่งตัวผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน ขยิบตาข้างหนึ่งและยิ้มกว้าง ทาลิปสติกสีแดง ใส่ต่างหูห่วงสีเงินและเสื้อสีน้ำเงิน ยกมือขวาขึ้นทำท่ามินิฮาร์ทใกล้คาง ถัดมาทางขวาเป็นเวิร์ดมาร์ก ${BRAND_NAME} โดยคำว่า มาดาม เป็นตัวอักษรไทยหนาสามมิติผิวมันวาวสีฟ้าอมน้ำเงิน ต่อท้ายด้วยเลข 168 ผิวมันวาวสีแดงสด ทั้งชุดตัดขอบเงินโครเมียมซ้อนขอบน้ำเงินเข้ม และมีแสงสะท้อนสีขาวพาดอยู่บนตัวอักษร`;

// มาดาม168 (รอบแดงคริมสันนำ-น้ำเงินอะซัวร์รอง บน **ธีมมืด** 2026-10-23): ไฟล์นี้ถูก
// เลื่อนขึ้นมาเป็น footer ที่ใช้งานจริงรอบนี้ แทน FooterCyber ของ นาซ่า168 — หนึ่ง
// ไฟล์ต่อรอบ ทรงก็คนละตัว: FooterCyber เป็นแผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลม
// กลางจอ มีตารางเส้นพื้นหลัง และปุ่มตัดมุมทแยง ส่วนไฟล์นี้เป็นแผ่น
// rounded-t-[3rem] เต็มความกว้างที่มีออราเรืองแสงเบลอคร่อมขอบบน และเนื้อในเป็น
// กริด 12 คอลัมน์แบบ 5/3/4
//
// ⚠️ **พื้นเพจรอบนี้มืด (#00091f จาก bg.json) และ footer ก็เป็นผิวมืดเช่นกัน**
// ทิศของธีมรอบนี้คือ **ทั้งเนื้อหาและโครมเป็นผิวมืดหมึกสว่าง** — ห้าม "แก้"
// ครึ่งใดครึ่งหนึ่งให้สว่าง
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: มาดาม168 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ มาดาม168 (.claude/brand-spec-madum168.md §2): **แดงคริมสัน + น้ำเงิน
// อะซัวร์ อ่านจาก palette.json ที่วัด vivid ของ logo.webp เอง และจากอาร์ตเวิร์ก
// โดยตรง** โลโก้เป็นคำว่า มาดาม สีฟ้าอมน้ำเงินคู่กับเลข 168 สีแดงสด และอาร์ตเวิร์ก
// เป็นโถงห้างสรรพสินค้าหรูโทนขาว-ดำ ฟุตเตอร์จึงเดินแดงแบรนด์ #ff2e52 เป็นขอบ/ออรา/
// หัวคอลัมน์ · แพลทินัม #d9dfe9 เป็นเส้นโครเมียมและลิงก์ตอน hover · น้ำเงินอะซัวร์
// #1177e8 / #0a4ea8 เป็นปลายเข้มของเส้นไล่เฉดและกรอบชิปใบที่สอง · เส้นคั่นล่าง
// #2a3c70 พื้นเป็นน้ำเงินหมึก #050e26 (จม) / #0b1733 (กลาง) / #16234a (ยก)
// เนื้อความไข่มุก #f4eef1 (16.6:1 บน #050e26) ตัวรอง #b3bdd6 (10.0:1)
// ⚠️ **#1177e8 #0e68cc #0a4ea8 #c9102f #2a3c70 ห้ามถือตัวอักษรในไฟล์นี้**
//
// ⚠️ ชุดฟ้าสกาย-ทองคานารีของ สบาย168 ที่เคยอยู่ในไฟล์นี้ (2cc3fc 6bdcfb 9ae0fa
// 0a7fbd 063a57 04293d 0a4f74 0f3a4a 06293c fdcb0c fefb6b 8a6504 eafaff a9e3f9
// cdf2ff ccf7ff + rgba 44/195/252 α)) ชุดฟ้าอะซัวร์-ทองอำพันของ รวยแทร่168
// (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320
// 7fa8cc 9dc4e4) ชุดแดงมังกร-ทองไทยของ สมหวัง168 (fa0513 ff5a5f ffadaf e3b23c
// ffe5a8 8c0204 8a6210 140706 2c1413 1f0d0c 170504 f4ecea ccb9b6) ชุดน้ำเงินไฟฟ้า-
// เงินโครเมียมของ TSDET911 (0360f3 0292fb 6ec8ff cfdcec 9db4d4 dde8f7 102a5e
// 0a1c42 040e26 00081f 032dad 04186e) ชุดทองอำพันเสือของ TIGERWIN369 (d98324
// ffd98a 8a5214 f7b733 0f0903 2d1c0a 1c1206 f7e4c0 e3cfae) ชุดทองสายฟ้า-แดงเลือดนก
// ของ FLASH877 (f5c518 ffdd73 b8860f ff3b14 2b0000 6d0804 430000 fdf0e2 f8d2bb)
// และชุดทอง-มรกตของ KOON234 (cc920a f7d14e 8a6204 2fbf6a 020803 09190d 051007)
// ออกครบทุกจุดแล้ว **รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีม่วง ไม่มีเขียว
// (ยกเว้น LINE green บนปุ่ม LINE ซึ่งเป็นสีของแบรนด์ LINE เอง) ไม่มีครีม
// และไม่มีแรมป์เทาเงิน**
// ⚠️⚠️ **แดงรอบนี้ (#ff2e52) ไม่ใช่ "แดงทั่วไป" — รีโปนี้มีแดงมาแล้วหลายเจ้า**
// เพื่อนบ้านที่ต้องเทียบเป็นค่า: ff4446 ของโปรดี168 (R0/G22/B12) · fb1b32 ของ
// มีเฮ168 (R4/G19/B32) · f5282a ของหวย365 (R10/G6/B40) · ff5f63 ของ GT66B
// (R0/G49/B11) · fa0513 ของสมหวัง168 (R5/G41/B39) · ff3b14 ของ FLASH877
// (R0/G13/B62) **การมีแดงอยู่แล้วจึงไม่พิสูจน์อะไร ให้เทียบเป็นตัวเลขทีละค่า**
// ⚠️⚠️ **และน้ำเงิน/ฟ้าเคยนำมาแล้วเจ็ดเจ้า** (1fd8f0 ของนาซ่า168 รอบก่อนทันที ·
// 18a5e2 ของร่ำรวย168 · 2cc3fc ของสบาย168 · 32bcfb ของนินจา168 · 039cfa ของ
// รวยแทร่168 · 2f9ff5 ของสบายเบท168 · 0360f3 ของ TSDET911) ซึ่งเป็นเหตุผลที่รอบนี้
// **ลดน้ำเงินลงเป็นวัสดุที่สองที่ไม่ถือตัวอักษร และยกแดงคริมสันขึ้นเป็นฮิวนำ**
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์
// ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (src/assets/content.txt · brand-spec §4 §5):
// เกมสล็อตออนไลน์พร้อมข้อมูลโปรโมชั่นสำหรับสมาชิก · รายละเอียดเกม การสมัครสมาชิก
// และช่องทางฝากถอน · คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% · ระบบฝากถอนผ่านธนาคาร
// และทรูมันนี่ · เจ้าหน้าที่ 24ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร
// จำนวนเกม หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// (โปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน · ไม่สามารถรับประกัน
// ระยะเวลาหรือจำนวนเงินที่ถอนได้จากข้อความโฆษณาเพียงอย่างเดียว · การคืนเครดิตไม่ได้
// หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น) ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
// ⚠️ แบรนด์นี้เป็นเว็บเกมสล็อตล้วน คำของแบรนด์ขาออก นาซ่า168 (สล็อตนาซ่าเซิร์ฟไทย
// ลิขสิทธิ์แท้จากอเมริกา ฝากถอนเข้าบริษัทตรง ไม่ผ่านม้า ระบบเล่นง่าย รองรับภาษาไทย
// กดรับได้ไม่จำกัด) และคำของรอบก่อนๆ (เบทต่ำ สบายเป๋า ทุนน้อย เว็บตรง100% ไม่มี
// ขั้นต่ำ แทงบอล ฟุตบอล ราคาต่อรอง ค่าน้ำ บาคาร่า เกมไพ่ คาสิโน ยิงปลา ไฮโล
// หวยออนไลน์ PG SOFT JOKER JILI) **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออก
// ทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
//
// BankStrip เป็นแถบโลโก้ธนาคารที่ variant นี้ import มาเองตามทรงของมัน —
// **ไฟล์นั้นไม่มีสีของแบรนด์และต้องไม่มีตลอดไป** สีที่เห็นเป็นสีซีแมนติกของแบรนด์
// ธนาคารซึ่งอบมาใน PNG แล้ว รีแบรนด์รอบไหนก็ต้องข้ามไฟล์นั้นไป สิ่งที่ปรับได้คือ
// ป้ายกำกับกับกรอบรอบๆ ซึ่งอยู่ในไฟล์นี้ และบรีฟรอบนี้มี **หัวข้อ H2 เต็มหัวข้อ
// เรื่องระบบฝากถอนผ่านธนาคารและทรูมันนี่** (content.txt บรรทัด 13-14) จึงมีเหตุผล
// ให้คงแถบนี้ไว้ชัดเจนกว่ารอบก่อนเสียอีก
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#ff2e52]/50 bg-[#050e26] pt-16 pb-8 font-sans text-[#f4eef1] shadow-[0_-15px_40px_rgba(255,46,82,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ff2e52]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(255,46,82,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#d9dfe9] via-[#ff2e52] to-[#c9102f] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ff2e52]/60 pl-4 text-sm leading-relaxed text-[#f4eef1]/85">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์พร้อมข้อมูลโปรโมชั่นสำหรับสมาชิกที่ต้องการติดตามสิทธิพิเศษในแต่ละวัน ภายในเว็บไซต์มีรายละเอียดเกี่ยวกับเกม การสมัครสมาชิก และช่องทางฝากถอนให้ตรวจสอบก่อนใช้งาน โปรโมชั่นตามข้อมูลที่ระบุมีคืนยอดเสีย 0.3%
          เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% โดยแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม และรอบเวลารับเครดิตแตกต่างกัน จึงควรตรวจสอบจากประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง ส่วนระบบฝากถอนรองรับธนาคารและทรูมันนี่
          ควรตรวจสอบยอดฝากขั้นต่ำ วงเงินถอนสูงสุด ระยะเวลาดำเนินการ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ก่อนทำธุรกรรม ทั้งนี้โปรโมชั่นไม่ได้รับประกันว่าจะได้รับผลกำไรจากการเดิมพัน และไม่สามารถรับประกันระยะเวลาหรือจำนวนเงินที่ถอนได้
          จากข้อความโฆษณาเพียงอย่างเดียว หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ ควรหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ผู้ให้บริการก็ตาม
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#ff2e52]/50 bg-[#0b1733]/70 px-4 py-1 text-xs font-medium text-[#f4eef1] backdrop-blur-sm">เกมสล็อตออนไลน์ · ช่องทางติดต่อผู้ให้บริการ</span>
          <span class="rounded-full border border-[#1177e8]/55 bg-[#0b1733]/70 px-4 py-1 text-xs font-medium text-[#d9dfe9] backdrop-blur-sm">LINE OFFICIAL 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ff2e52] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#ff2e52] to-[#0a4ea8]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f4eef1]/85">
          <li><a href="/" class="transition-colors hover:text-[#ff2e52]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ff2e52]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ff2e52]">สมัครสมาชิก</a></li>
