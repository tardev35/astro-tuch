---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-19 จริง — ลายกนกไทยกับเปลวไฟแดงของ
// สมหวัง168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย ไม่มีปีกเหยี่ยวน้ำเงิน
// ไม่มีเหรียญตราหัวเสือ ไม่มีมงกุฎ ไม่มีกองชิป และไม่มีนินจากับชูริเคนฟ้าของ
// นินจา168 ด้วย — รอบนี้เป็นเวิร์ดมาร์กไทยคู่กับถุงเงินและกองเหรียญ
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ฝั่งซ้ายเป็นถุงเงินสีฟ้าผูกเชือกทองสลักเครื่องหมายดอลลาร์สีขาว วางซ้อนกับปึกธนบัตรสีฟ้า-ขาวและกองเหรียญทองสลักสัญลักษณ์ดอลลาร์ที่ไหลลงมาด้านล่าง ถัดมาทางขวาเป็นคำว่า รวย เขียนด้วยตัวอักษรไทยหนาสามมิติสีทองอำพันตัดขอบขาว ต่อด้วยคำว่า แทร่168 ตัวอักษรหนาสามมิติผิวมันวาวสีฟ้าอะซัวร์ตัดขอบขาว มีหัวใจสีฟ้าและประกายดาวสีฟ้ากับสีทองลอยกระจายอยู่รอบตัวอักษร`;

// รวยแทร่168 (รอบฟ้าอะซัวร์นำ-ทองอำพันรอง บนดำสนิท 2026-10-19): ไฟล์นี้ถูกเลื่อน
// ขึ้นมาเป็น footer ที่ใช้งานจริงรอบนี้ แทน FooterCyber ของ นินจา168 — หนึ่งไฟล์
// ต่อรอบ ทรงก็คนละตัว: FooterCyber เป็นแผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลม
// กลางจอ มีตารางเส้นพื้นหลัง และปุ่มตัดมุมทแยง ส่วนไฟล์นี้เป็นแผ่น
// rounded-t-[3rem] เต็มความกว้างที่มีออราเรืองแสงเบลอคร่อมขอบบน และเนื้อในเป็น
// กริด 12 คอลัมน์แบบ 5/3/4
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: รวยแทร่168 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ รวยแทร่168 (.claude/brand-spec-ruaythear168.md §2): **ฟ้าอะซัวร์ +
// ทองอำพัน ไม่มีฮิวอุ่นแดงเลยสักจุด** ตามงานศิลป์ที่โลโก้เป็นคำว่า รวย สีทองอำพัน
// คู่กับ แทร่168 สีฟ้าอะซัวร์บับเบิล และมีถุงเงินฟ้ากับกองเหรียญทองขนาบ ฟุตเตอร์
// จึงเดินฟ้าแบรนด์ #039cfa เป็นขอบ/ออรา · ฟ้าน้ำแข็ง #c3ebfc เป็นลิงก์ตอน hover
// และกรอบชิปใบแรก · ทองอำพัน #f9a826 เป็นหัวคอลัมน์และกรอบชิปใบที่สอง ·
// น้ำเงินลึก #04366b เป็นเส้นคั่นล่างและปลายเข้มของเส้นไล่เฉด พื้นเป็นน้ำเงินหมึก
// #030f1d (จม) / #0b2d52 (ยก) / #071e38 (กลาง)
// เนื้อความขาวอมฟ้า #e3f2fc (= BRAND_TEXT) ตัวรอง #9dc4e4
//
// ⚠️ ชุดแดงมังกร-ทองไทยของ สมหวัง168 ที่เคยอยู่ในไฟล์นี้ (fa0513 / ff5a5f /
// ffadaf / e3b23c / ffe5a8 / 8c0204 / 8a6210 / 140706 / 2c1413 / 1f0d0c / 170504 /
// f4ecea / ccb9b6) ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3 / 0292fb /
// 6ec8ff / cfdcec / 9db4d4 / dde8f7 / 102a5e / 0a1c42 / 040e26 / 00081f / 032dad /
// 04186e) ชุดทองอำพันเสือของ TIGERWIN369 (d98324 / ffd98a / 8a5214 / f7b733 /
// 0f0903 / 2d1c0a / 1c1206 / f7e4c0 / e3cfae) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877
// (f5c518 / ffdd73 / b8860f / ff3b14 / 2b0000 / 6d0804 / 430000 / fdf0e2 / f8d2bb)
// และชุดทอง-มรกตของ KOON234 (cc920a / f7d14e / 8a6204 / 2fbf6a / 020803 / 09190d /
// 051007) ออกครบทุกจุดแล้ว **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม และไม่มีเงิน/โครเมียมเลยสักจุด**
// ⚠️ ฟ้าของรอบนี้ (#039cfa) กับทองอำพัน (#f9a826) อ่านมาจาก palette.json ของดรอป
// นี้และจากอาร์ตเวิร์กโดยตรง ไม่ใช่ "ฟ้าทั่วไป" หรือ "ทองทั่วไป" — **สองแบรนด์
// ก่อนหน้าทันที (นินจา168 32bcfb+fef54b, สบายเบท168 2f9ff5+ffc82e) ก็เป็นฟ้าคู่
// ทองเหมือนกันเป๊ะในเชิงตระกูลสี** และ TIGERWIN369 กับ FLASH877 ก็มีทอง การมีฟ้า
// หรือทองอยู่แล้วจึงไม่พิสูจน์อะไร ให้เทียบเป็นตัวเลขทีละค่า (เขียนเฮกซ์เก่าแบบ
// ไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §4 §6): เกมสล็อตออนไลน์หลากหลายรูปแบบ
// สำหรับผู้ที่สนใจศึกษาระบบเกมและเลือกเล่นตามงบประมาณของตนเอง · ข้อมูลการสมัคร
// สมาชิก การเข้าสู่ระบบ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ · คืนยอดเสีย 0.3%
// และแนะนำเพื่อน 0.8% · LINE Official 24ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม
// ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// (ควรเข้าใจว่าเกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้ · ควรตรวจสอบ
// ช่องทางติดต่อจากหน้าเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคล
// ที่แอบอ้างชื่อบริการ · ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น) ติดมาด้วย
// ไม่ถูกตัดทิ้งเพราะฟังดูลบ
// ⚠️ แบรนด์นี้เป็นเว็บเกมสล็อตล้วน คำของรอบก่อนๆ (สล็อตโปรแรงโบนัส0.8%ทุกวัน
// แค่แนะนำง่ายๆ รับได้ไม่อั้น PG SOFT JOKER JILI นำเข้าตรงจากสิงคโปร์ บาคาร่า
// ไฮโล แทงบอล คาสิโน เซิร์ฟเวอร์ต่างประเทศ ฝากถอนทุกธนาคาร ถูกลิขสิทธิ์
// ค่ายระดับเอเชีย) ไม่เหลือในไฟล์นี้แล้ว
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#039cfa]/50 bg-[#030f1d] pt-16 pb-8 font-sans text-[#e3f2fc] shadow-[0_-15px_40px_rgba(3,156,250,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#039cfa]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(3,156,250,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#c3ebfc] via-[#039cfa] to-[#f9a826] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#039cfa]/60 pl-4 text-sm leading-relaxed text-[#e3f2fc]/75">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบสำหรับผู้ที่สนใจศึกษาระบบเกมและเลือกเล่นตามงบประมาณของตนเอง ภายในเว็บไซต์มีข้อมูลเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ผู้เล่นสามารถตรวจสอบรายละเอียดของแต่ละเกม ทั้งกติกา อัตราเดิมพัน และเงื่อนไขการจ่ายรางวัลก่อนเริ่มใช้งาน
          โปรโมชั่นตามข้อมูลที่กำหนดมีคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% โดยแต่ละรายการอาจมีเงื่อนไขเกี่ยวกับยอดเดิมพัน รอบคำนวณเครดิต และระยะเวลารับสิทธิ์แตกต่างกัน จึงควรตรวจสอบรายละเอียดจากประกาศล่าสุดก่อนเข้าร่วมทุกครั้ง
          ทั้งนี้ควรเข้าใจว่าเกมสล็อตมีความเสี่ยงและไม่สามารถรับประกันผลตอบแทนได้ ควรตรวจสอบช่องทางติดต่อจากหน้าเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีหรือบุคคลที่แอบอ้างชื่อบริการ และไม่ควรเปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ผู้ให้บริการก็ตาม
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#c3ebfc]/50 bg-[#0b2d52]/70 px-4 py-1 text-xs font-medium text-[#c3ebfc] backdrop-blur-sm">เว็บเกมสล็อต · ช่องทางติดต่อผู้ให้บริการ</span>
          <span class="rounded-full border border-[#f9a826]/55 bg-[#071e38]/70 px-4 py-1 text-xs font-medium text-[#f9a826] backdrop-blur-sm">LINE OFFICIAL 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f9a826] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#039cfa] to-[#04366b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e3f2fc]/75">
          <li><a href="/" class="transition-colors hover:text-[#c3ebfc]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#c3ebfc]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#c3ebfc]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#c3ebfc]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#c3ebfc]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#c3ebfc]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#c3ebfc]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#c3ebfc]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f9a826] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#039cfa] to-[#04366b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#9dc4e4]/85 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#04366b]/80 pt-8 text-xs font-medium tracking-wide text-[#e3f2fc]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#c3ebfc]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#c3ebfc]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
