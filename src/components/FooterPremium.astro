---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นวงแหวนหนาสีเขียวมรกตเข้มไล่เงาทองวางอยู่ด้านหลัง ด้านหน้าเป็นตัวอักษรละตินหนาสามมิติคำว่า KOON สีเงินโครเมียมตัดขอบเขียวมรกตเข้ม ต่อด้วยตัวเลข 234 สามมิติสีทองไล่เงาวาวตัดขอบเขียวเข้ม ทั้งแถบเอียงขึ้นเล็กน้อยไปทางขวา`;

// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// footer ที่ใช้งานจริงรอบนี้ แทน FooterStyle3 ของ แตกดี168 — หนึ่งไฟล์ต่อหนึ่งรอบ
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: KOON234 เป็นเว็บพนันออนไลน์ ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ KOON234 (brand-spec §2): ทองเป็นฮิวนำ เขียวมรกตเป็นฮิวที่สองจริง ตาม
// โลโก้ที่เป็นตัว KOON เงินโครเมียมติดเลข 234 ทอง คร่อมวงแหวนเขียวมรกต — ฟุตเตอร์
// จึงเดินทองเป็นหลัก (#cc920a ขอบ/ออรา · #f7d14e หัวคอลัมน์และลิงก์ตอน hover ·
// #8a6204 เส้นคั่นล่างและปลายเข้มของเส้นไล่เฉด) และให้ชิปใบที่สองถือเขียวสว่าง
// #2fbf6a เพื่อให้คู่ป้ายอ่านเป็น "ทอง-มรกต" ตามโลโก้จริง พื้นเขียวเกือบดำ
// #020803 / #09190d / #051007 เนื้อความ #e8f2e6 (BRAND_TEXT)
//
// ชุดทอง-เงินของ UOK365 ที่เคยอยู่ในไฟล์นี้ (#c8912f #f5d98a #6d4412 #a46b25
// #d8dbe0 #ece1cc #0a0806 #19100a #120c07 rgba(200,145,47,α)) ออกครบทุกจุดแล้ว
// ⚠️ ทองของรอบนี้เป็นคนละค่ากับทองของ UOK365 — อย่าปล่อยค่าเก่าไว้เพราะ "ดูคล้ายกัน"
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §5 §6): เว็บพนันฐานเล่นหลักที่รวบรวม
// ช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว · รองรับมือถือและคอมพิวเตอร์ · ตรวจบัญชี
// โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว · คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
// สำหรับยอดที่เข้าเกณฑ์ · แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต ชื่อค่ายเกม
// ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// (ข้อความ "ปลอดภัยขึ้น 100%" ไม่สามารถใช้รับรองว่าไม่มีความเสี่ยงได้ทั้งหมด และ
// การระบุว่าไม่ผ่านเอเย่นต์ควรมีข้อมูลผู้ดำเนินงานที่ตรวจสอบได้รองรับ) ติดมาด้วย
// ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#cc920a]/50 bg-[#020803] pt-16 pb-8 font-sans text-[#e8f2e6] shadow-[0_-15px_40px_rgba(204,146,10,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#cc920a]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(204,146,10,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#e9eef0] via-[#f7d14e] to-[#8a6204] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#cc920a]/60 pl-4 text-sm leading-relaxed text-[#e8f2e6]/75">
          {BRAND_NAME} เป็นเว็บพนันฐานเล่นหลักที่รวบรวมช่องทางเข้าเล่นออนไลน์ไว้ในระบบเดียว รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ จัดรูปแบบเว็บไซต์ให้เข้าถึงเมนูต่างๆ ได้สะดวก สมาชิกตรวจสอบบัญชี โปรโมชั่น และรายการใช้งานได้จากหน้าเดียว
          ระบบฝั่งสมาชิกครอบคลุมตั้งแต่หน้าเข้าสู่ระบบ การจัดการบัญชี ไปจนถึงการตรวจสอบรายการ โดยมีโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% สำหรับยอดที่เข้าเกณฑ์ตามรอบที่กำหนด พร้อมแอดมินดูแลตลอด 24 ชั่วโมง
          ทั้งนี้ข้อความว่าปลอดภัยขึ้น 100% ไม่สามารถใช้รับรองว่าไม่มีความเสี่ยงได้ทั้งหมด และการระบุว่าเป็นเว็บไม่ผ่านเอเย่นต์ควรมีข้อมูลผู้ดำเนินงานและช่องทางหลักที่ตรวจสอบได้รองรับ สมาชิกจึงควรตรวจสอบทางเข้าเว็บไซต์และรักษาข้อมูลบัญชีของตนเองอยู่เสมอ
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#cc920a]/50 bg-[#09190d]/70 px-4 py-1 text-xs font-medium text-[#f7d14e] backdrop-blur-sm">ทางเข้าเล่นออนไลน์ · ไม่ผ่านเอเย่นต์</span>
          <span class="rounded-full border border-[#2fbf6a]/45 bg-[#051007]/70 px-4 py-1 text-xs font-medium text-[#2fbf6a]/90 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f7d14e] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f7d14e] to-[#8a6204]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e8f2e6]/75">
          <li><a href="/" class="transition-colors hover:text-[#f7d14e]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f7d14e]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f7d14e]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f7d14e]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f7d14e]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f7d14e]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f7d14e]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f7d14e]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f7d14e] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f7d14e] to-[#8a6204]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#2fbf6a]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a6204]/70 pt-8 text-xs font-medium tracking-wide text-[#e8f2e6]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f7d14e]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f7d14e]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
