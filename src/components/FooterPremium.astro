---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ กินดี365 คำว่า กินดี เป็นตัวอักษรไทยสีทองเมทัลลิกวางเหนือเลข 365 สีฟ้าเงิน ล้อมด้วยวงกลมเส้นทองที่ปลายแตกเป็นใบไม้สามใบ";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d0a63a]/45 bg-[#00081f] pt-16 pb-8 font-sans text-[#dbe4f5] shadow-[0_-15px_40px_rgba(208,166,58,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d0a63a]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(208,166,58,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fbeeb8] to-[#7e5f1f] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                กินดี<span class="bg-gradient-to-r from-[#dbe4f5] to-[#5ec2f5] bg-clip-text text-transparent">365</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d0a63a]/55 pl-4 text-sm leading-relaxed text-[#dbe4f5]/75">
          {BRAND_NAME} เว็บหวยราคาจ่ายดีที่สุด รวมหวยออนไลน์ครบวงจรไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย VIP และหวยหุ้นต่างประเทศ อัตราจ่ายตามที่กำหนดสำหรับหน้านี้คือเลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง รองรับการฝากเครดิตผ่านธนาคารและวอลเลท พร้อมเจ้าหน้าที่ดูแลเรื่องฝากถอนตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#d0a63a]/40 bg-[#062052]/50 px-4 py-1 text-xs font-medium text-[#e9c55d] backdrop-blur-sm">เว็บหวยจ่ายจริง เข้าไว</span>
          <span class="rounded-full border border-[#5ec2f5]/35 bg-[#031234]/60 px-4 py-1 text-xs font-medium text-[#a9c4e8] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#e9c55d] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-[#d0a63a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dbe4f5]/75">
          <li><a href="/" class="transition-colors hover:text-[#e9c55d]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#e9c55d]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#e9c55d]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#e9c55d]">เข้าสู่ระบบ</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-[#e9c55d]">ตรวจหวย</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-[#e9c55d]">แนวทาง</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#e9c55d]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#e9c55d]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#e9c55d]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#e9c55d]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#e9c55d] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-[#d0a63a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#a9c4e8]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#1c47a8]/80 pt-8 text-xs font-medium tracking-wide text-[#dbe4f5]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#e9c55d]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#e9c55d]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
