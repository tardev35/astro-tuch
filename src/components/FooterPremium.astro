---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-11 จริง — เหรียญขอบทองพื้นแดงเข้มที่มี
// สายฟ้าทองผ่าทแยงของ FLASH877 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
// และไม่มีถ้วยรางวัล/ลูกฟุตบอลของ UFA324 ด้วย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเหรียญตรากลมสีดำสลับทอง กลางเหรียญเป็นหัวเสือขนสีทองอำพันสวมมงกุฎทองใบเล็ก ล้อมด้วยวงแหวนสีดำที่ประดับสัญลักษณ์ไพ่โพดำ ดอกจิก ข้าวหลามตัด และโพแดงสีทอง ด้านซ้ายมีไพ่สีดำสองใบกางออกโชว์เอซสีทอง ด้านขวาเป็นกองชิปคาสิโนสีดำขอบทอง ใต้ลงมาเป็นคำว่า ${BRAND_NAME} ตัวหนาสามมิติสีทองวาว และมีมงกุฎทองใบเล็กอยู่ใต้สุด`;

// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// footer ที่ใช้งานจริงรอบนี้ แทน FooterStyle3 ของ UFA324 — หนึ่งไฟล์ต่อรอบ
// ทรงก็คนละตัว: FooterStyle3 เป็น "การ์ด CTA ลอยคร่อมขอบบน" แล้วเว้น pt-64 ไว้รับ
// ส่วนไฟล์นี้เป็นแผ่น rounded-t-[3rem] เต็มความกว้างที่มีออราเรืองแสงคร่อมขอบบน
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: TIGERWIN369 เป็นเกมคาสิโนรวม ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ TIGERWIN369 (brand-spec §2): **ทองล้วนสองระดับ ไม่มีฮิวเย็นและไม่มีแดง**
// ตามโลโก้ที่เป็นหัวเสือขนทองอำพันสวมมงกุฎทองกลางเหรียญตราดำ-ทอง ฟุตเตอร์จึง
// เดินทองอำพัน #d98324 เป็นขอบ/ออรา · ทองซีด #ffd98a เป็นหัวคอลัมน์และลิงก์ตอน
// hover · อำพันลึก #8a5214 เป็นเส้นคั่นล่างและปลายเข้มของเส้นไล่เฉด · ทองสว่าง
// #f7b733 เป็นกรอบชิปใบที่สองและกลางเกรเดียนต์ชื่อแบรนด์
// พื้นเป็นน้ำตาลอุ่น #0f0903 (จม) / #2d1c0a (ยก) / #1c1206 (กลาง)
// เนื้อความครีมอมทอง #f7e4c0 (= BRAND_TEXT) ตัวรอง #e3cfae
//
// ⚠️ ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 ที่เคยอยู่ในไฟล์นี้ (f5c518 / ffdd73 /
// b8860f / ff3b14 / 2b0000 / 6d0804 / 430000 / fdf0e2 / f8d2bb) และชุดทอง-มรกต
// ของ KOON234 ก่อนหน้านั้น (cc920a / f7d14e / 8a6204 / 2fbf6a / 020803 / 09190d /
// 051007 / e8f2e6 / e9eef0) ออกครบทุกจุดแล้ว **รอบนี้ไม่มีแดงเลยสักจุด** — แดง
// สายฟ้า ff3b14 ที่เคยถือกรอบชิปใบที่สองถูกแทนด้วยทองสว่าง #f7b733
// ⚠️ ทองของรอบนี้ (#d98324) เป็นคนละค่ากับทอง f5c518 ของ FLASH877 และกับทอง
// e5a81b ของ UFA324 รอบก่อน — รอบนี้เป็นทองรอบที่แปดในสิบรอบ "มีทองอยู่" จึงไม่ได้
// พิสูจน์อะไร ให้เทียบเป็นตัวเลขทีละค่า (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อให้ sweep
// ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §5 §7): เกมคาสิโนรวมที่นำเสนอทางเลือก
// การเดิมพันครบวงจรในแพลตฟอร์มเดียว ทั้งบาคาร่า สล็อต บอลออนไลน์ ไฮโล และยิงปลา ·
// หมวดเกมจัดเรียงให้ค้นหาสะดวก · รองรับมือถือและคอมพิวเตอร์ · คืนยอดเสีย 0.3%
// เข้ายูสทุกวัน และแนะนำเพื่อน 0.8% · แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต
// ชื่อค่ายเกม ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับ
// ของบรีฟเอง (แต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน · ความนิยมและความน่าเชื่อถือ
// ไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ
// OTP) ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d98324]/50 bg-[#0f0903] pt-16 pb-8 font-sans text-[#f7e4c0] shadow-[0_-15px_40px_rgba(217,131,36,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d98324]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(217,131,36,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffd98a] via-[#f7b733] to-[#d98324] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d98324]/60 pl-4 text-sm leading-relaxed text-[#f7e4c0]/75">
          {BRAND_NAME} เป็นเกมคาสิโนรวมที่นำเสนอทางเลือกการเดิมพันครบวงจรในแพลตฟอร์มเดียว ทั้งบาคาร่า สล็อต บอลออนไลน์ ไฮโล และเกมยิงปลา พร้อมหมวดเกมที่จัดเรียงให้ค้นหาได้สะดวก รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์
          โปรโมชั่นตามข้อมูลที่กำหนดมีคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามรอบคำนวณที่เว็บไซต์กำหนด พร้อมแอดมินระบุเวลาให้บริการตลอด 24 ชั่วโมง โดยแต่ละเกมมีเงื่อนไขและยอดขั้นต่ำแตกต่างกัน จึงควรตรวจสอบรายละเอียดในระบบก่อนทำรายการ
          ทั้งนี้ภาพลักษณ์เว็บดังของแท้ในตำนานควรมีข้อมูลประวัติการเปิดให้บริการ รายชื่อผู้ให้บริการเกม และรายละเอียดผู้ดำเนินงานที่ตรวจสอบได้ประกอบ เพราะความนิยมและความน่าเชื่อถือไม่สามารถยืนยันจากข้อความโฆษณาเพียงอย่างเดียว และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#d98324]/50 bg-[#2d1c0a]/70 px-4 py-1 text-xs font-medium text-[#ffd98a] backdrop-blur-sm">เกมคาสิโนรวม · เดิมพันไม่มีขั้นต่ำ</span>
          <span class="rounded-full border border-[#f7b733]/55 bg-[#1c1206]/70 px-4 py-1 text-xs font-medium text-[#e3cfae] backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffd98a] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#ffd98a] to-[#8a5214]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f7e4c0]/75">
          <li><a href="/" class="transition-colors hover:text-[#ffd98a]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffd98a]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffd98a]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffd98a]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffd98a]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffd98a]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffd98a]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffd98a]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffd98a] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#ffd98a] to-[#8a5214]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#e3cfae]/80 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a5214]/70 pt-8 text-xs font-medium tracking-wide text-[#f7e4c0]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffd98a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd98a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
