---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ MIRACLE55 ตัวอักษร MI สีทองสามมิติเงาวาว ต่อด้วยคำว่า RACLE สีเงินโครเมียม และตัวเลข 55 สีทองสามมิติ เรียงติดกันเป็นบรรทัดเดียวบนพื้นโปร่ง";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: MIRACLE55 เป็นคาสิโนฐานหลัก (เกมสด เกมโต๊ะ)
// บรีฟไม่มีหัวข้อหวย สองหน้านั้นจอดอยู่ที่ src/pages-disabled/ จึงไม่มี route —
// ถ้าเหลือลิงก์ไว้ verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้
// ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ MIRACLE55 (ทอง + เงินโครเมียม 2026-09-25): โลโก้เป็นสองโลหะ (MI ทอง /
// RACLE เงิน / 55 ทอง) เงินจึงเป็นแอ็กเซนต์ที่สองจริง พื้นดำ #080604 ออร่าและขอบ
// ทองหลัก #d9a62b หัวคอลัมน์ทองสว่าง #fee47b เส้นคั่นล่างทองลึก #8c5f14 เนื้อความ
// #e8e6e1 ชิปเป็น #1b140b โดยชิปใบที่สองใช้ขอบโครเมียม #d2d3d4 ให้คู่ป้ายอ่านเป็น
// ทอง-เงิน — โทนทอง #e8b93f/#ffe9a3/#96671a บนพื้น #0d0903 ของ SAGAME66 ที่เคย
// อยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d9a62b]/45 bg-[#080604] pt-16 pb-8 font-sans text-[#e8e6e1] shadow-[0_-15px_40px_rgba(252,218,101,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d9a62b]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(252,218,101,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fee47b] via-[#eaeaea] to-[#d9a62b] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d9a62b]/55 pl-4 text-sm leading-relaxed text-[#e8e6e1]/75">
          {BRAND_NAME} คาสิโนฐานหลักที่รวมเกมจากหลายแบรนด์ไว้ในระบบเดียว เข้าเล่นผ่านระบบบริษัทตรงตามข้อมูลของเว็บไซต์ มีทั้งคาสิโนสด เกมโต๊ะ และหมวดเกมยอดนิยมให้เลือก เมนูจัดแยกแต่ละค่ายไว้ชัดเจน ตรวจสอบรายละเอียดเกมก่อนเข้าใช้งานได้ รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของแต่ละรายการ สมัครเองได้ใน 3 ขั้นตอน ตรวจสอบยอดที่เข้าเกณฑ์และสิทธิ์ที่เปิดให้รับได้จากบัญชีสมาชิกโดยตรง และมีเจ้าหน้าที่ดูแลผ่านไลน์แอดตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#d9a62b]/45 bg-[#1b140b]/60 px-4 py-1 text-xs font-medium text-[#fee47b] backdrop-blur-sm">คาสิโนสด · เกมโต๊ะ · ครบทุกค่ายในระบบเดียว</span>
          <span class="rounded-full border border-[#d2d3d4]/30 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#d2d3d4]/80 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fee47b] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#d9a62b] to-[#d2d3d4]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e8e6e1]/75">
          <li><a href="/" class="transition-colors hover:text-[#fee47b]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fee47b]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fee47b]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fee47b]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fee47b]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fee47b]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fee47b]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fee47b]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fee47b] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#d9a62b] to-[#d2d3d4]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมินผ่านไลน์แอด
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d2d3d4]/65 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8c5f14]/60 pt-8 text-xs font-medium tracking-wide text-[#e8e6e1]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fee47b]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fee47b]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
