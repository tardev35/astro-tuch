---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ PKG44 ตัวอักษร P สีทองสามมิติเงาวาว ต่อด้วยตัว K สีเงินโครเมียม ตัว G สีทองขอบเงิน และตัวเลข 44 สีทองสามมิติ เรียงติดกันเป็นบรรทัดเดียวบนพื้นโปร่ง";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: PKG44 เป็นเว็บสล็อต บรีฟไม่มีหัวข้อหวย สองหน้านั้น
// จอดอยู่ที่ src/pages-disabled/ จึงไม่มี route — ถ้าเหลือลิงก์ไว้ verify-build จะจับ
// เป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ PKG44 (ทองเมทัลลิก + เงินโครเมียม 2026-09-27): โลโก้เป็นสองโลหะ (P ทอง /
// K เงิน / G 44 ทอง) เงินจึงเป็นแอ็กเซนต์ที่สองจริง พื้นดำ #080602 ออร่าและขอบทอง
// หลัก #fdd32a หัวคอลัมน์ทองอ่อน #ffeeb8 เส้นคั่นล่างทองลึก #c8920a เนื้อความ
// #efe6d2 ชิปเป็น #2a2110 โดยชิปใบที่สองใช้ขอบโครเมียม #c2c8d0 ให้คู่ป้ายอ่านเป็น
// ทอง-เงิน — โทนทอง #d9a62b/#fee47b/#8c5f14 บนพื้น #080604 ของ MIRACLE55 ที่เคย
// อยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟ PKG44: เกมปั่นสล็อตหลายค่าย · API + ลิขสิทธิ์ตามที่
// เว็บไซต์ระบุ · สล็อตยอดนิยม/เกมโบนัส/เกมใหม่ · บัญชีเดียว มือถือ+คอมพิวเตอร์ ·
// โบนัสแนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · สมัครเอง 3 ขั้นตอน · เจ้าหน้าที่ 24 ชม.
// บรีฟไม่ได้ระบุ "ไลน์" ในเนื้อความ ป้ายบนปุ่มจึงพูดถึงไลน์ได้ (นั่นคือปลายทางจริง
// ของ /line) แต่ย่อหน้าบรรยายแบรนด์ห้ามอ้างช่องทางที่บรีฟไม่ได้พูดถึง
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#fdd32a]/45 bg-[#080602] pt-16 pb-8 font-sans text-[#efe6d2] shadow-[0_-15px_40px_rgba(253,211,42,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fdd32a]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(253,211,42,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffeeb8] via-[#f2f4f7] to-[#fdd32a] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fdd32a]/55 pl-4 text-sm leading-relaxed text-[#efe6d2]/75">
          {BRAND_NAME} รวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว พร้อมรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ สมาชิกเลือกได้ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา เมนูแบ่งหมวดหมู่ไว้ชัดเจน ตรวจสอบชื่อค่ายและรายละเอียดเกมก่อนเริ่มเล่นได้ รองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดียว พร้อมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไขของแต่ละรายการ สมัครเองได้ใน 3 ขั้นตอน ตรวจสอบยอดที่เข้าเกณฑ์และรอบรับสิทธิ์ได้จากบัญชีสมาชิกโดยตรง และมีเจ้าหน้าที่ดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#fdd32a]/45 bg-[#2a2110]/60 px-4 py-1 text-xs font-medium text-[#ffeeb8] backdrop-blur-sm">เกมปั่นสล็อต · API แท้ · หลายค่ายในระบบเดียว</span>
          <span class="rounded-full border border-[#c2c8d0]/30 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#c2c8d0]/80 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffeeb8] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fdd32a] to-[#c2c8d0]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#efe6d2]/75">
          <li><a href="/" class="transition-colors hover:text-[#ffeeb8]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffeeb8]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffeeb8]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffeeb8]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffeeb8]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffeeb8]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffeeb8]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffeeb8]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffeeb8] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fdd32a] to-[#c2c8d0]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c2c8d0]/65 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#c8920a]/60 pt-8 text-xs font-medium tracking-wide text-[#efe6d2]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffeeb8]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffeeb8]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
