---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ หวยดีใจ บนพื้นโปร่งใส ด้านซ้ายเป็นมงกุฎทองห้าแฉกประดับลูกกลมที่ปลายแต่ละแฉก ถัดมาเป็นตัวอักษรไทยคำว่า หวย ตัวหนาสามมิติสีเงินโครเมียมไล่แสง ต่อด้วยคำว่า ดีใจ ตัวหนาสามมิติสีแดงเมทัลลิกเรียงติดกันเป็นบรรทัดเดียว";

// มีลิงก์ /ตรวจหวย และ /แนวทาง รอบนี้: หวยดีใจ เป็นเว็บรับแทงหวยออนไลน์เต็มตัว
// สองหน้านั้นอยู่ใน src/pages/ จึงมี route จริง ถ้าแบรนด์ถัดไปเป็นสล็อต/คาสิโนต้อง
// ถอดคู่นี้ออกพร้อมกับย้ายไฟล์กลับไป src/pages-disabled/ ไม่งั้น verify-build จะจับ
// เป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า จึงผิดทั้งเว็บพร้อมกัน)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ หวยดีใจ (แดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): โลโก้เป็นสองโทน
// จริง — คำว่า "หวย" เป็นเงินโครเมียม ส่วน "ดีใจ" เป็นแดงเมทัลลิก และมงกุฎด้านหน้า
// เป็นทอง ฟุตเตอร์จึงเดินแดงเป็นหลัก (#dc0409 ขอบ/ออรา · #f5363d หัวคอลัมน์ ·
// #4b0205 เส้นคั่นล่าง) และให้ชิปใบที่สองถือเงินโครเมียม #c3c7d1 เพื่อให้คู่ป้ายอ่าน
// เป็น "แดง-เงิน" ตามโลโก้จริง ไม่ใช่แดง-ทองอย่างแบรนด์หวยรอบก่อน ทอง #f3c54e
// เหลือบทบาทแค่จุดเน้นเล็กตามมงกุฎ พื้นเป็นดำอมแดง #0d0407 / #211016 เนื้อความ
// #edeaf0 (BRAND_TEXT)
//
// ชุดทอง-เงินของ UP555 ที่เคยอยู่ในไฟล์นี้ (#130b03 #ebbb54 #fce675 #ab6d24 #6b4517
// #f8eed9 #d5d4d3 #241705 #0c0502 #f3f3f2) ออกครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟ หวยดีใจ: รับแทงหวยออนไลน์ รวมรัฐบาลไทย ลาว ฮานอย ออมสิน
// ธ.ก.ส. ในบัญชีเดียว · เลือกเลข ตรวจรอบ อัตราจ่าย และส่งโพยผ่านมือถือ · เรท 2 ตัว
// 100 บาท / 3 ตัว 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข · แนวทางและสถิติเป็นข้อมูล
// ประกอบ · แอดมิน 24 ชม. — บรีฟไม่ได้ระบุใบอนุญาต ผู้ให้บริการ ธนาคาร ยอดขั้นต่ำ
// หรือเวลาออกรางวัลเป็นตัวเลข จึงไม่มีในข้อความนี้ และข้อความกำกับของบรีฟเอง
// ("แนวทางหวยเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกัน
// ผลรางวัลล่วงหน้าได้") ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#dc0409]/50 bg-[#0d0407] pt-16 pb-8 font-sans text-[#edeaf0] shadow-[0_-15px_40px_rgba(220,4,9,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#dc0409]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(220,4,9,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#eef0f4] via-[#c3c7d1] to-[#dc0409] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#dc0409]/60 pl-4 text-sm leading-relaxed text-[#edeaf0]/75">
          {BRAND_NAME} เป็นเว็บรับแทงหวยออนไลน์ที่รวมรายการยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ สมาชิกเลือกเลข ตรวจสอบรอบเปิดรับและปิดรับ ดูอัตราจ่าย และส่งโพยผ่านมือถือได้จากบัญชีเดียว โดยรายการที่เข้าเงื่อนไขมีเรท 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่งหวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีอัตราแตกต่างกัน จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก มีแอดมินดูแลตลอด 24 ชั่วโมง ทั้งนี้แนวทางหวยและสถิติย้อนหลังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#dc0409]/50 bg-[#211016]/70 px-4 py-1 text-xs font-medium text-[#f5363d] backdrop-blur-sm">รัฐบาลไทย · ลาว · ฮานอย · ออมสิน · ธ.ก.ส.</span>
          <span class="rounded-full border border-[#c3c7d1]/45 bg-[#17080c]/70 px-4 py-1 text-xs font-medium text-[#c3c7d1]/90 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f5363d] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f5363d] to-[#4b0205]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#edeaf0]/75">
          <li><a href="/" class="transition-colors hover:text-[#f5363d]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f5363d]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f5363d]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f5363d]">เข้าสู่ระบบ</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-[#f5363d]">ตรวจหวย</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-[#f5363d]">แนวทาง</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f5363d]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f5363d]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f5363d]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f5363d]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f5363d] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f5363d] to-[#4b0205]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c3c7d1]/75 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#4b0205]/70 pt-8 text-xs font-medium tracking-wide text-[#edeaf0]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f5363d]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5363d]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
