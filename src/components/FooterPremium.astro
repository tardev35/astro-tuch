---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ BRAVO168 ตัวอักษร B R A V O ตัวหนาทรงเหลี่ยมไล่เฉดจากโครเมียมขาวเงินลงเป็นน้ำเงินรอยัลเข้ม มีเส้นขอบทองบางล้อมทุกตัว ต่อท้ายด้วยเลข 168 สีทองตันเงาวาว เรียงติดกันเป็นบรรทัดเดียว";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: BRAVO168 เป็นเว็บแทงบอล บรีฟไม่มีหัวข้อหวย สองหน้านั้น
// จอดอยู่ที่ src/pages-disabled/ จึงไม่มี route — ถ้าเหลือลิงก์ไว้ verify-build จะจับ
// เป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ BRAVO168 (น้ำเงินรอยัล-ทอง 2026-09-30): โลโก้เป็นโครเมียมไล่น้ำเงินรอยัลที่
// คำว่า BRAVO และทองตันที่เลข 168 โครเมียมฟ้าขาวจึงเป็นแอ็กเซนต์ที่สองจริง พื้นกรมท่า
// เกือบดำ #02081a ออร่าและขอบทองหลัก #f4cb69 หัวคอลัมน์ทองอ่อน #ffe39a เส้นคั่นล่างทองลึก
// #c9922e เนื้อความ #dbe5f5 ชิปเป็น #072247 โดยชิปใบที่สองใช้ขอบโครเมียมฟ้า #a8bedd ให้คู่
// ป้ายอ่านเป็นทอง-โครเมียม — โทนทอง-ดำของ WIN999 (#fcc403 #fff0a8 #a87d02 #251d06 #c2c8d0
// #060502) ที่เคยอยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟ BRAVO168: เดิมพันฟุตบอลออนไลน์ (บอลเดี่ยว บอลสเต็ป บอลสด) ·
// ตรวจคู่บอล ราคา อัตราต่อรอง และรายละเอียดบิลผ่านมือถือก่อนยืนยัน · รายการลีกที่เปิดรับ
// ขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการ · โบนัสคืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// แอดมิน 24 ชม. บรีฟไม่ได้ระบุ "ไลน์" ในเนื้อความ ป้ายบนปุ่มจึงพูดถึงไลน์ได้ (นั่นคือ
// ปลายทางจริงของ /line) แต่ย่อหน้าบรรยายแบรนด์ห้ามอ้างช่องทางที่บรีฟไม่ได้พูดถึง — และ
// ห้ามรับประกันว่าค่าน้ำคงที่หรือเปิดรับทุกลีกเสมอ เพราะบรีฟระบุข้อจำกัดทั้งสองข้อไว้ชัดเจน
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f4cb69]/45 bg-[#02081a] pt-16 pb-8 font-sans text-[#dbe5f5] shadow-[0_-15px_40px_rgba(244,203,105,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f4cb69]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(244,203,105,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#e8f1ff] via-[#ffe39a] to-[#f4cb69] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f4cb69]/55 pl-4 text-sm leading-relaxed text-[#dbe5f5]/75">
          {BRAND_NAME} ให้บริการเดิมพันฟุตบอลออนไลน์ผ่านระบบเว็บไซต์ มีทั้งบอลเดี่ยว บอลสเต็ป และบอลสด พร้อมรายการแข่งขันตามฤดูกาลที่ระบบเปิดรับ สมาชิกตรวจสอบคู่บอล ราคา อัตราต่อรอง และรายละเอียดบิลผ่านมือถือได้ก่อนยืนยันการเดิมพัน รายการลีกและแมตช์ที่เปิดรับจริงขึ้นอยู่กับตารางแข่งขันและผู้ให้บริการ จึงควรตรวจสอบเวลาปิดรับและราคาล่าสุดก่อนกดยืนยันทุกครั้ง โดยเฉพาะบอลสดที่ตลาดเปลี่ยนได้ระหว่างการแข่งขัน พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ และมีแอดมินดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f4cb69]/45 bg-[#072247]/60 px-4 py-1 text-xs font-medium text-[#ffe39a] backdrop-blur-sm">บอลเดี่ยว · บอลสเต็ป · บอลสด ในบัญชีเดียว</span>
          <span class="rounded-full border border-[#a8bedd]/30 bg-[#000000]/60 px-4 py-1 text-xs font-medium text-[#a8bedd]/85 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe39a] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f4cb69] to-[#a8bedd]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dbe5f5]/75">
          <li><a href="/" class="transition-colors hover:text-[#ffe39a]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffe39a]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffe39a]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffe39a]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffe39a]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffe39a]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffe39a]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffe39a]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe39a] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#f4cb69] to-[#a8bedd]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#a8bedd]/70 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#c9922e]/60 pt-8 text-xs font-medium tracking-wide text-[#dbe5f5]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe39a]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe39a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
