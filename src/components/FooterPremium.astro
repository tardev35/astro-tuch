---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-13 จริง — เหรียญตราหัวเสือทองอำพันของ
// TIGERWIN369 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย ไม่มีมงกุฎ ไม่มีไพ่
// ไม่มีกองชิป และไม่มีสายฟ้าของ FLASH877 ด้วย — รอบนี้เป็นเวิร์ดมาร์กล้วน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นเครื่องหมายปีกเหยี่ยวสีน้ำเงินไฟฟ้าซ้อนกับแถบโลหะสีเงินโครเมียมเป็นรูปตัว T ต่อด้วยตัวอักษร TSDET สีเงินโครเมียมขัดเงาแบบสามมิติ และตัวเลข 911 สีน้ำเงินไฟฟ้าที่ไล่เฉดเข้มขึ้นทางขอบล่าง ทั้งหมดเรียงติดกันเป็นบรรทัดเดียว`;

// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม บนกรมเกือบดำ 2026-10-13): ไฟล์นี้ถูก
// เลื่อนขึ้นมาเป็น footer ที่ใช้งานจริงรอบนี้ แทน FooterStyle3 ของ KMD88 —
// หนึ่งไฟล์ต่อรอบ ทรงก็คนละตัว: FooterStyle3 เป็น "การ์ด CTA ลอยคร่อมขอบบน"
// แล้วเว้น pt-64 ไว้รับ ส่วนไฟล์นี้เป็นแผ่น rounded-t-[3rem] เต็มความกว้างที่มี
// ออราเรืองแสงคร่อมขอบบน
//
// ⚠️ ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: TSDET911 เป็นคาสิโน+กีฬา ไม่ใช่เว็บหวย
// สองหน้านั้นจอดอยู่ใน src/pages-disabled/ จึงไม่มี route จริง ถ้าเหลือไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ และผิดพร้อมกันทั้งเว็บเพราะ
// ฟุตเตอร์ขึ้นทุกหน้า
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ TSDET911 (.claude/brand-spec-tsdet911.md §2): **น้ำเงินไฟฟ้า +
// เงินโครเมียม ไม่มีฮิวอุ่นเลยสักจุด** ตามโลโก้ที่เป็นเวิร์ดมาร์ก TSDET เงิน
// โครเมียมคู่กับเลข 911 น้ำเงินไฟฟ้า ฟุตเตอร์จึงเดินน้ำเงินแบรนด์ #0360f3 เป็น
// ขอบ/ออรา · ฟ้าสว่าง #6ec8ff เป็นลิงก์ตอน hover และกรอบชิปใบแรก · เงินสว่าง
// #cfdcec เป็นหัวคอลัมน์ · น้ำเงินลึก #04186e เป็นเส้นคั่นล่างและปลายเข้มของ
// เส้นไล่เฉด · ฟ้าสด #0292fb เป็นกรอบชิปใบที่สอง
// พื้นเป็นกรมเกือบดำ #040e26 (จม) / #102a5e (ยก) / #0a1c42 (กลาง)
// เนื้อความขาวอมฟ้า #dde8f7 (= BRAND_TEXT) ตัวรอง #9db4d4
//
// ⚠️ ชุดทองอำพันเสือของ TIGERWIN369 ที่เคยอยู่ในไฟล์นี้ (d98324 / ffd98a /
// 8a5214 / f7b733 / 0f0903 / 2d1c0a / 1c1206 / f7e4c0 / e3cfae) ชุดทองสายฟ้า-
// แดงเลือดนกของ FLASH877 ก่อนหน้านั้น (f5c518 / ffdd73 / b8860f / ff3b14 /
// 2b0000 / 6d0804 / 430000 / fdf0e2 / f8d2bb) และชุดทอง-มรกตของ KOON234
// (cc920a / f7d14e / 8a6204 / 2fbf6a / 020803 / 09190d / 051007) ออกครบทุกจุดแล้ว
// **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีแดง และไม่มีส้มเลยสักจุด**
// ⚠️ น้ำเงินของรอบนี้ (#0360f3) อ่านมาจาก palette.json ของดรอปนี้โดยตรง ไม่ใช่
// "น้ำเงินทั่วไป" — ไฟล์ inventory หลายตัวเคยเป็นของแบรนด์น้ำเงินมาก่อน การมี
// น้ำเงินอยู่แล้วจึงไม่พิสูจน์อะไร ให้เทียบเป็นตัวเลขทีละค่า (เขียนเฮกซ์เก่าแบบ
// ไม่มี # เพื่อให้ sweep ที่ไล่หาสีแบรนด์เก่าไม่สะดุดที่คอมเมนต์ประวัติบรรทัดนี้)
//
// คอปปี้ทุกบรรทัดยึดบรีฟรอบนี้ (brand-spec §5 §7): เว็บพนันที่รองรับเกมหลาย
// ประเภททั้งบาคาร่า ไฮโล สล็อต และแทงบอล · จัดหมวดเกมให้เลือกผ่านมือถือและ
// คอมพิวเตอร์ · ตรวจสอบข้อมูลเกม ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว ·
// คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อน 0.8% · แอดมิน 24 ชม. — บรีฟไม่ได้
// ระบุใบอนุญาต ชื่อค่ายเกม ธนาคาร หรือยอดขั้นต่ำเป็นตัวเลข จึงไม่มีในข้อความนี้
// และข้อความกำกับของบรีฟเอง (การกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้
// เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตที่ตรวจสอบได้ · การเดิมพันทุก
// ประเภทมีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร · ไม่ควรเปิดเผย
// รหัสผ่าน PIN หรือ OTP) ติดมาด้วย ไม่ถูกตัดทิ้งเพราะฟังดูลบ
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#0360f3]/50 bg-[#040e26] pt-16 pb-8 font-sans text-[#dde8f7] shadow-[0_-15px_40px_rgba(3,96,243,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#0360f3]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(3,96,243,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#cfdcec] via-[#6ec8ff] to-[#0360f3] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#0360f3]/60 pl-4 text-sm leading-relaxed text-[#dde8f7]/75">
          {BRAND_NAME} เป็นเว็บพนันออนไลน์ที่นำเสนอระบบเข้าเดิมพันผ่านเว็บไซต์ รองรับเกมหลายประเภททั้งบาคาร่า ไฮโล สล็อต และแทงบอล พร้อมจัดหมวดเกมให้เลือกใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก สมาชิกสามารถตรวจสอบข้อมูลเกม ยอดเดิมพัน และรายการต่างๆ ผ่านบัญชีเดียว
          โปรโมชั่นตามข้อมูลที่กำหนดมีคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามรอบคำนวณที่เว็บไซต์กำหนด พร้อมแอดมินระบุเวลาให้บริการตลอด 24 ชั่วโมง โดยแต่ละเกมอาจกำหนดวงเงินเริ่มต้นแตกต่างกัน จึงควรตรวจสอบกติกาและตารางจ่ายในระบบก่อนทำรายการ
          ทั้งนี้การกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้และใช้เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ เพราะการเดิมพันทุกประเภทมีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#6ec8ff]/50 bg-[#102a5e]/70 px-4 py-1 text-xs font-medium text-[#6ec8ff] backdrop-blur-sm">บาคาร่า · ไฮโล · สล็อต · แทงบอล</span>
          <span class="rounded-full border border-[#0292fb]/55 bg-[#0a1c42]/70 px-4 py-1 text-xs font-medium text-[#9db4d4] backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#cfdcec] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#6ec8ff] to-[#04186e]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dde8f7]/75">
          <li><a href="/" class="transition-colors hover:text-[#6ec8ff]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#6ec8ff]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#6ec8ff]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#6ec8ff]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#6ec8ff]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#6ec8ff]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#6ec8ff]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#6ec8ff]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#cfdcec] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#6ec8ff] to-[#04186e]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#9db4d4]/85 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#04186e]/80 pt-8 text-xs font-medium tracking-wide text-[#dde8f7]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#6ec8ff]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#6ec8ff]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
