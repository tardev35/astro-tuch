---
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ NAZA99 สัญลักษณ์ตัว N สีทองในวงกลมทองเงาวาว ตามด้วยตัวอักษร N A Z A 9 9 ตัวหนาทรงเหลี่ยมสีทองเมทัลลิกไล่เฉดจากทองอ่อนลงทองเข้ม เรียงติดกันเป็นบรรทัดเดียว";

// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง: NAZA99 เป็นเว็บสล็อต บรีฟไม่มีหัวข้อหวย สองหน้านั้น
// ถูกย้ายกลับไปจอดที่ src/pages-disabled/ รอบนี้ จึงไม่มี route — ถ้าเหลือลิงก์ไว้
// verify-build จะจับเป็น href ไปยังหน้าที่ไม่มีอยู่ (ฟุตเตอร์นี้ขึ้นทุกหน้า)
//
// /ทางเข้า ยังอยู่ในลิสต์: หน้านั้นยัง route และ index อยู่ ถูกถอดออกแค่จากเมนู
// navbar เท่านั้น เพราะ toggle cta เปิด /register กับ /login เป็นเมนูไปแล้ว
//
// พาเลตต์ NAZA99 (ทอง-ดำ 2026-10-02): โลโก้เป็นตัวอักษรทองเมทัลลิกล้วนบนพื้นโปร่ง และ
// แบนเนอร์เป็นฉากทองอร่ามบนพื้นดำอมน้ำตาล แบรนด์นี้จึงเป็น "สีเดียว" ไม่มีฮิวที่สอง
// ความต่างมาจากระดับความสว่างของทองแทน: พื้นดำอมทอง #140c02 ออร่าและขอบทองหลัก
// #e4b34d หัวคอลัมน์ทองอ่อน #fdf2ac เส้นคั่นล่างทองลึก #8a5f12 เนื้อความ #f3e8cf
// (BRAND_TEXT) ชิปเป็น #241404 โดยชิปใบที่สองใช้ขอบทองเข้ม #c08f2b ให้คู่ป้ายอ่าน
// เป็นทองสว่าง-ทองเข้มแทนที่จะเป็นทอง-โครเมียม — โทนน้ำเงินรอยัล-ทองของ BRAVO168
// (#02081a #072247 #f4cb69 #ffe39a #e8f1ff #a8bedd #dbe5f5 #c9922e #0a1020)
// ที่เคยอยู่ในไฟล์นี้ถูกแทนครบทุกจุดแล้ว
//
// คอปปี้ทุกบรรทัดยึดบรีฟ NAZA99: สล็อตเว็บใหม่รวมค่ายฮิตติดอันดับ · เกมโบนัส ฟรีสปิน
// ตัวคูณ และฟีเจอร์ใหม่ · รองรับมือถือและคอมพิวเตอร์ บัญชีเดียว · อัปเดตเกมตามรายการ
// ที่ผู้ให้บริการเปิดให้ใช้งานในแต่ละช่วง · โบนัสคืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// แอดมิน 24 ชม. บรีฟไม่ได้ระบุ "ไลน์" ในเนื้อความ ป้ายบนปุ่มจึงพูดถึงไลน์ได้ (นั่นคือ
// ปลายทางจริงของ /line) แต่ย่อหน้าบรรยายแบรนด์ห้ามอ้างช่องทางที่บรีฟไม่ได้พูดถึง — และ
// ห้ามรับประกันว่าแตกหนักหรือปั่นแตกง่าย เพราะบรีฟระบุเองว่าผลลัพธ์ของสล็อตเป็นแบบสุ่ม
//
// บล็อก <address> ด้านล่างห้ามใส่สีของแบรนด์: border-white/15 + bg-black/20 +
// opacity ทำงานได้กับ footer ทุกตัวในไลบรารี (พื้นเข้มหมด) การพิมพ์เฮกซ์ลงไป
// คือวิธีที่ทำให้สีของแบรนด์นี้ค้างอยู่ในรอบหน้า
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e4b34d]/45 bg-[#140c02] pt-16 pb-8 font-sans text-[#f3e8cf] shadow-[0_-15px_40px_rgba(228,179,77,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e4b34d]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(228,179,77,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e4b34d]/55 pl-4 text-sm leading-relaxed text-[#f3e8cf]/75">
          {BRAND_NAME} เป็นเว็บสล็อตที่รวบรวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว มีทั้งเกมโบนัส ฟรีสปิน ตัวคูณ และฟีเจอร์ใหม่ที่ช่วยเพิ่มรูปแบบการเล่นให้หลากหลาย รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกเลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียวได้สะดวก จำนวนเกมและช่วงเวลาอัปเดตขึ้นอยู่กับค่ายและผู้ให้บริการ จึงควรตรวจสอบรายการล่าสุดจากหมวดเกมใหม่ก่อนเริ่มเล่น พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไขของแต่ละรายการ และมีแอดมินดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e4b34d]/45 bg-[#241404]/60 px-4 py-1 text-xs font-medium text-[#fdf2ac] backdrop-blur-sm">เกมโบนัส · ฟรีสปิน · ตัวคูณ ในบัญชีเดียว</span>
          <span class="rounded-full border border-[#c08f2b]/45 bg-[#0a0501]/60 px-4 py-1 text-xs font-medium text-[#e4b34d]/85 backdrop-blur-sm">SUPPORT 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fdf2ac] uppercase drop-shadow-sm">ลิงก์ด่วน</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fdf2ac] to-[#8a5f12]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f3e8cf]/75">
          <li><a href="/" class="transition-colors hover:text-[#fdf2ac]">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fdf2ac]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fdf2ac]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fdf2ac]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fdf2ac]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fdf2ac]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fdf2ac]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fdf2ac]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fdf2ac] uppercase drop-shadow-sm">ฝ่ายบริการลูกค้า</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#fdf2ac] to-[#8a5f12]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อเจ้าหน้าที่ผ่าน Line Official
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#e4b34d]/70 uppercase">ช่องทางฝาก-ถอน</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a5f12]/60 pt-8 text-xs font-medium tracking-wide text-[#f3e8cf]/55 md:flex-row">
      <p>&copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fdf2ac]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fdf2ac]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
