---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading beside an image. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Flattened columns: each <article> carries the text classes itself and the slot
// is a direct child, so the headings need `leading-normal` to stop the hoisted
// `leading-relaxed` leaking into them. Do not re-add a wrapper <div>.
//
// Column order here is TEXT (7fr) then IMAGE (3fr) — the mirror of its pair
// ContentBoxSevenThreePremium, which runs IMAGE (3fr) then TEXT (7fr). The two
// image+text blocks sit back to back on the homepage, so running them the same
// way round would stack both slides down the left edge and make the pair read as
// one card repeated twice. The flip is why `titleleft` is the wide text column's
// heading in this file and the narrow column is the one that takes the picture.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr) ที่หน้าแรกคิด `sizes` จาก — ถ้าแก้ค่าใดต่อไปนี้
// ต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย:
//   section max-w-[1400px] + px-4(16) · card md:p-10(40) · gap-8(32) · คอลัมน์แคบ md:pl-6(24)
//   ≥1400px: (1400 − 32 − 80 − 32) × 0.3 − 24 = 1256 × 0.3 − 24 = 353px
//   768–1399px: (100vw − 144) × 0.3 − 24 = calc(30vw − 67px)
//   ≤767px: ยุบเหลือคอลัมน์เดียว card p-8(32) → 100vw − 32 − 64 = calc(100vw − 96px)
// md:border-r 1px อยู่ในกล่องของคอลัมน์ซ้าย (border-box) จึงไม่กินความกว้างคอลัมน์ขวา
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H3 #5 ("3ตัว จ่าย1,000บาท") คู่กับ slide1 ซึ่งเป็น
// งานอาร์ตที่พิมพ์ข้อความนั้นไว้บนตัวภาพเอง
//
// การ์ดใบนี้เป็น "การ์ดทึบ" ของคู่ — ผิวการ์ด #17080c ทึบ ไม่ไล่เฉดอย่างใบคู่ และ
// กรอบเป็นแดงแบรนด์ #dc0409 ไม่ใช่แดงดำ เพื่อให้สองบล็อกต่างกันตั้งแต่ขอบ
// กรอบสว่างขึ้นเป็นแดงสว่าง #f5363d ตอน hover ออร่ามุมขวาบนเป็นแดงแบรนด์ตามริบบิ้น
// แดงในงานอาร์ต มุมซ้ายล่างเป็นเงินกลาง #c3c7d1 ตามชุดเงินเมทัลลิกของนางแบบ
// เส้นคั่นสองคอลัมน์เป็นแดงดำ #4b0205 หัวข้อไล่ทอง #f3c54e → แดงแบรนด์ #dc0409 →
// เงินสว่าง #eef0f4 เนื้อความ #edeaf0 (= BRAND_TEXT) glow เป็น rgba(220,4,9,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #5c3f12 #f5e7c8 rgba(205,154,44,…) rgba(12,11,10,…))
// ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#dc0409]/55 bg-[#17080c]/92 p-8 text-[#edeaf0] shadow-[0_10px_30px_rgba(13,4,7,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5363d]/70 hover:shadow-[0_15px_40px_rgba(220,4,9,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#dc0409]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#f5363d]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c3c7d1]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#eef0f4]/26">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-3 border-b border-[#4b0205] pb-6 text-left text-base leading-relaxed text-[#edeaf0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="mb-1 bg-gradient-to-r from-[#f3c54e] via-[#dc0409] to-[#eef0f4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#edeaf0] md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f3c54e] via-[#dc0409] to-[#eef0f4] bg-clip-text text-center text-xl leading-normal font-black tracking-wide text-transparent uppercase drop-shadow-[0_0_5px_rgba(220,4,9,0.3)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
