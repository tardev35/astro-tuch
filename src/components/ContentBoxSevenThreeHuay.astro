---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading beside an image. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Flattened columns: each <article> carries the text classes itself and the slot
// is a direct child, so the headings need `leading-normal` to stop the hoisted
// `leading-relaxed` leaking into them. Do not re-add a wrapper <div>.
//
// Column order here is TEXT (7fr) then IMAGE (3fr). Its pair on the home page
// this round is ContentBoxSevenThreeCyberCut, which runs the same way round but
// is separated from this one by shape, surface depth and corner treatment — see
// that file's frontmatter. `titleleft` is therefore the wide text column's
// heading and the narrow column is the one that takes the picture; no
// `titleright` is ever passed, so this block emits exactly one docx heading.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอปนี้ ห้ามลอกของรอบก่อนหรือของไฟล์พี่น้อง** ถ้าแก้ค่า
// ใดต่อไปนี้ ต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย
// (section max-w-[1400px] + px-4 = 32 · card border 1x2 = 2 · md:p-10 = 80 ·
//  grid gap-8 = 32 · คอลัมน์รูปมี md:pl-6 = 24 อยู่ในกล่องของมันเอง · Tailwind
//  เป็น border-box ทั่วทั้งโปรเจกต์ max-w/padding จึงนับรวมกัน):
//   ≥1400px   : (1400 − 32 − 2 − 80 − 32) × 0.3 − 24 = 1254 × 0.3 − 24 = 352px
//   768–1399  : (100vw − 146) × 0.3 − 24             = calc(30vw − 68px)
//   638–767   : ยุบเหลือคอลัมน์เดียวที่ card p-8 → 100vw − 98 ซึ่งเกิน 540 จึงติด
//               เพดาน max-w-[540px] ของบิตแมป                = 540px
//   <638      : คอลัมน์เดียวที่ p-8                           = calc(100vw − 98px)
// md:border-r 1px อยู่ในกล่องของคอลัมน์ซ้าย (border-box) จึงไม่กินความกว้างคอลัมน์ขวา
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (md:p-10 / gap-8 / md:pl-6) ไม่ใช่ของ
// ContentBoxSevenThreeCyberCut ที่เป็น p-8 / gap-8 / md:pl-8 + md:border-l แล้ว
// ออกมา 312px / calc(30vw − 72px) — **ห้ามลอกตัวเลขข้ามไฟล์** และสองใบนั้นคือคู่
// บล็อกรูปของรอบนี้ (brand-spec §3) จึงอยู่บนหน้าเดียวกันติดกันเลย
// ⚠️ สไลด์ดรอปนี้เป็น **แนวตั้ง 540x600** (รอบก่อนเป็นแนวนอน 600x334) เพดานความ
// กว้างจึงเป็น 540 ไม่ใช่ 600 และ 1x ของใบนี้คือ 352px ซึ่ง 2x = 704 เกินบิตแมป
// จึงตกลงมาที่ 540 — ไม่มี candidate ไหนสูงกว่า 540 ได้ และห้าม upscale
//
// สาธุ168 (รอบ **เขียวมรกตนำ · ทองสัมฤทธิ์รอง · ธีมสว่าง** 2026-10-21,
// brand-spec §2–§5): กล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3%
// เข้ายูสทุกวัน") คู่กับ **slide2.png**
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide2 มีแผ่นป้ายพื้นดำขอบทองเขียนว่า **คืนยอดเสีย** ต่อด้วย **0.3%** (ใบนี้)
// ส่วน slide1 เขียนว่า **แนะนำเพื่อน 0.8%** (§5) — uploader เขียนทับทั้งสองไฟล์
// ทุกดรอป เลขไฟล์จึงไม่มีความหมายข้ามแบรนด์ และ banner2/banner3/slide3/slide4
// เป็นอาร์ตเวิร์กของแบรนด์ก่อน **ห้าม import ที่ไหนเลย** (eager import = emit
// แม้ไม่ render) นี่คือบล็อก SevenThree ใบแรกของสองใบตามเพดานของ playbook
//
// ⚠️ **ธีมสว่าง** — bg.json = #d8ffc7 ลำดับความลึก: #ffffff ผิวยก / #e9fbdd
// ชั้นกลาง / #d8ffc7 พื้นเพจ หมึก **เขียวป่า #0c3a16** (= BRAND_TEXT, 12.9:1)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมกลม rounded-3xl บนผิวยก #ffffff** ทึบ
// มีออราสองมุมเฉียง ส่วนใบคู่ของมัน (§5) เป็น **การ์ดมุมตัด clip-path บนผิว
// อินเซ็ต #e9fbdd** ที่ตกแต่งด้วยเส้นรูดสี่มุม — สองบล็อกรูปที่อยู่ติดกันจึงถูก
// แยกสามอย่างพร้อมกัน: **รูปทรง** (มุมกลม vs มุมตัดเฉียง) **ความลึกของผิว**
// (ยก vs อินเซ็ต) และ **การจัดหัวข้อ** (เขียวเข้มทึบคู่เส้นคั่นเต็ม vs เขียวมรกต
// ทึบคู่เครื่องหมาย ✦)
// หัวข้อเป็น **เขียวเข้ม #0a5f1c ทึบสีเดียว** (7.9:1 บนผิวยก) — ไม่ใช่ไล่เฉดอย่าง
// §1/§3 เพื่อไม่ให้สี่กล่องแรกของหน้าอ่านเป็นแบบเดียวกันหมด
// กรอบเป็นเขียวมรกต #0b7d28 ที่เข้มขึ้นเป็นเขียวเข้ม #0a5f1c ตอน hover ออรามุม
// ขวาบนเป็นเขียวมรกตตามใบบัวและเครื่องประดับในงานอาร์ต มุมซ้ายล่างเป็น
// **เขียวใบตอง #0f9b35** ซึ่ง §2 อนุญาตให้เป็นออรา/พื้นถมเท่านั้น (3.7:1 ห้าม
// ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร) เส้นคั่นสองคอลัมน์เป็นเขียวมรกตโปร่ง
// ⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ไม่มีในไฟล์นี้เลย** แม้ป้ายบนรูปจะเป็น
// ขอบทอง — ทองในภาพเป็น **พิกเซลของบิตแมป** ไม่ใช่คลาสของ UI และบนการ์ดขาวทอง
// ได้แค่ 1.7–2.8:1
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เทียบง่ายเพราะ **ไม่มีแบรนด์ไหน
// ในรีโปนี้เคยใช้เขียวเป็นสีนำเลยสักเฉด** ชุดแดงแบรนด์-เงินโครเมียมของ **หวยดีใจ**
// ที่เพิ่งอยู่ในไฟล์นี้ทั้งไฟล์ (dc0409 f5363d 17080c c3c7d1 eef0f4 edeaf0 f3c54e
// 4b0205 rgba(220,4,9,…) rgba(13,4,7,…)) ชุดทองโลหะ-ครีมอมพีชของ **หวยคิง** ซึ่ง
// เป็นเจ้าของเดิมของตระกูล *Huay (cd9a2c fdeb7c ab7314 fcd4c3 fce2d4 1c140b
// 5c3f12 f5e7c8 rgba(205,154,44,…)) และชุดชมพูบานเย็นของรอบขาออก **มีทรัพย์168**
// (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีเงิน/โครเมียม ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง
// ไม่มีบรอนซ์ส้ม และไม่มีทองบนการ์ด**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0b7d28]/55 bg-[#ffffff] p-8 text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.16)] transition-all duration-500 hover:border-[#0a5f1c]/75 hover:shadow-[0_15px_40px_rgba(11,125,40,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#0b7d28]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#0b7d28]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0f9b35]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#0f9b35]/26">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-3 border-b border-[#0b7d28]/35 pb-6 text-left text-base leading-relaxed text-[#0c3a16] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <HeadingTag class="mb-1 text-2xl leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-2 text-left text-base leading-relaxed text-[#0c3a16] md:pl-6">
        {titleright && <HeadingTag class="text-center text-xl leading-normal font-black tracking-wide text-[#0a5f1c] uppercase md:text-left">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
