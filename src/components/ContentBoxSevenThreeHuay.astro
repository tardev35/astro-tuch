---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading beside an image. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Flattened columns: each <article> carries the text classes itself and the slot
// is a direct child, so the headings need `leading-normal` to stop the hoisted
// `leading-relaxed` leaking into them. Do not re-add a wrapper <div>.
//
// Column order here is IMAGE (3fr) then TEXT (7fr). Its sibling
// ContentBoxSevenThreeNeumorphism runs the other way round so the page's two
// image+text blocks do not stack the artwork down one edge.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): การ์ดแดงเกือบดำ #2a0405 ในกรอบทองลึก #a16207
// ที่สว่างขึ้นเป็นทองหลัก #fbbf24 ตอน hover ออร่ามุมขวาบนเป็นทองหลัก มุมซ้ายล่าง
// เป็นแดงสว่าง #fc2b2c ตามเลข 24 สีแดงบนโลโก้และลูกหวยแดง-ขาวในงานอาร์ต เส้นคั่น
// สองคอลัมน์เป็นทองลึก คอลัมน์ซ้าย (รูปสไลด์) ใช้สีรอง #d9b3b3 ส่วนคอลัมน์ขวาเป็น
// เนื้อความ #f6e2e2 หัวข้อไล่เฉดทองอ่อน #fde68a → ทองหลัก → แดงสว่าง — ชุดของ
// 365LOTTO (#fadc64 #fdf3b4 #9c6a12 #e01f26 #f0ddc4 #1a0709 #d8bda6 #f3f6fa)
// ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a16207]/45 bg-[#2a0405]/90 p-8 text-[#f6e2e2] shadow-[0_10px_30px_rgba(8,1,1,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbbf24]/60 hover:shadow-[0_15px_40px_rgba(251,191,36,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#fbbf24]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fde68a]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fc2b2c]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fc2b2c]/28">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2 border-b border-[#a16207]/60 pb-6 text-left text-base leading-relaxed font-medium text-[#d9b3b3] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text text-center text-3xl leading-normal font-black tracking-wider text-transparent uppercase drop-shadow-sm md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e2e2] md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text text-xl leading-normal font-black tracking-wide text-transparent uppercase drop-shadow-[0_0_5px_rgba(251,191,36,0.3)] md:text-2xl">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
