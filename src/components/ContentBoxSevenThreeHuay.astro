---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading beside an image. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Flattened columns: each <article> carries the text classes itself and the slot
// is a direct child, so the headings need `leading-normal` to stop the hoisted
// `leading-relaxed` leaking into them. Do not re-add a wrapper <div>.
//
// Column order here is TEXT (7fr) then IMAGE (3fr) — the mirror of its pair
// ContentBoxSevenThreePremium, which runs IMAGE (3fr) then TEXT (7fr). The two
// image+text blocks sit back to back on the homepage, so running them the same
// way round would stack both slides down the left edge and make the pair read as
// one card repeated twice. The flip is why `titleleft` is the wide text column's
// heading in this file and the narrow column is the one that takes the picture.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): เว็บแทงหวยออนไลน์ พาเลตต์จาก logo.webp ที่
// vivid เป็นแดงล้วน (#dc0203 #e00104 #e2020a) และ dominant เป็นดำ #020202 ส่วนทอง
// มาจากตัวอักษรบนสไลด์ การ์ดใบนี้เป็น "การ์ดทึบ" ของคู่ — พื้นการ์ด #240406 ทึบ ไม่ไล่เฉด
// อย่างใบคู่ และกรอบเป็นแดงแบรนด์ #dc0203 ไม่ใช่ทองลึก เพื่อให้สองบล็อกต่างกันตั้งแต่ขอบ
// กรอบสว่างขึ้นเป็นทองแบรนด์ #ffc93c ตอน hover ออร่ามุมขวาบนเป็นแดงแบรนด์ตามผ้าซาติน
// แดงในงานอาร์ต มุมซ้ายล่างเป็นทองแบรนด์ตามเหรียญทอง เส้นคั่นสองคอลัมน์เป็นทองลึก
// #c08a07 หัวข้อไล่กลับทางกับใบคู่ คือแดงสว่าง #f5282a → ทองแบรนด์ #ffc93c → ทองอ่อน
// #ffeab0 (ปลายแดงสว่างได้ 4.8:1 บนผิวการ์ด ส่วนแดงแบรนด์ #dc0203 ได้ 3.7:1 จึงไม่เอามา
// เป็นสีตัวอักษร ใช้เป็นเส้นกับออร่าเท่านั้น) คอลัมน์แคบใช้ #f6e7e0 แบบลดความทึบ ไม่ใช่เฉดใหม่
// ที่คิดขึ้นเอง เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดของ LOTTO24 ที่เคยค้างในไฟล์นี้ (#2a0405 #a16207 #fbbf24 #fde68a #fc2b2c #d9b3b3
// #f6e2e2) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#dc0203]/55 bg-[#240406]/90 p-8 text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,2,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/65 hover:shadow-[0_15px_40px_rgba(255,201,60,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#dc0203]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#f5282a]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ffc93c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeab0]/30">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-3 border-b border-[#c08a07]/60 pb-6 text-left text-base leading-relaxed text-[#f6e7e0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="mb-1 bg-gradient-to-r from-[#f5282a] via-[#ffc93c] to-[#ffeab0] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-2 text-left text-base leading-relaxed font-medium text-[#f6e7e0]/80 md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f5282a] via-[#ffc93c] to-[#ffeab0] bg-clip-text text-center text-xl leading-normal font-black tracking-wide text-transparent uppercase drop-shadow-[0_0_5px_rgba(255,201,60,0.3)] md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
