---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading beside an image. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Flattened columns: each <article> carries the text classes itself and the slot
// is a direct child, so the headings need `leading-normal` to stop the hoisted
// `leading-relaxed` leaking into them. Do not re-add a wrapper <div>.
//
// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): การ์ดแดงเกือบดำ #1a0709 ในกรอบ
// ทองลึก #9c6a12 ที่สว่างขึ้นเป็นทองหลัก #fadc64 ตอน hover ออร่ามุมขวาบนเป็นทองหลัก
// มุมซ้ายล่างเป็นแดงสด #e01f26 ตามวง O ของคำว่า LOTTO เส้นคั่นสองคอลัมน์เป็นทองลึก
// คอลัมน์ซ้าย (รูปสไลด์) ใช้สีรอง #d8bda6 ส่วนคอลัมน์ขวาเป็นเนื้อความ #f0ddc4
// หัวข้อไล่เฉดตามลำดับสีบนโลโก้ — ทองสว่าง #fdf3b4 → เงินโครเมียม #f3f6fa →
// แดงสด #e01f26 — ชุดกรมท่า-ทองของหวยพยัคฆ์ (#030b1c #08152f #0f2149 #1c3566
// #dbe4f7 #9fb0d0 #fadb6c #fdf5a4 #ab6d13) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#9c6a12]/45 bg-[#1a0709]/90 p-8 text-[#f0ddc4] shadow-[0_10px_30px_rgba(18,4,6,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadc64]/60 hover:shadow-[0_15px_40px_rgba(250,220,100,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#fadc64]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf3b4]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e01f26]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#e01f26]/28">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2 border-b border-[#9c6a12]/60 pb-6 text-left text-base leading-relaxed font-medium text-[#d8bda6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fdf3b4] via-[#f3f6fa] to-[#e01f26] bg-clip-text text-center text-3xl leading-normal font-black tracking-wider text-transparent uppercase drop-shadow-sm md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0ddc4] md:pl-6">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#fdf3b4] via-[#f3f6fa] to-[#e01f26] bg-clip-text text-xl leading-normal font-black tracking-wide text-transparent uppercase drop-shadow-[0_0_5px_rgba(250,220,100,0.3)] md:text-2xl">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
