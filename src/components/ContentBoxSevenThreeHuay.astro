---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#dfb455]/30 bg-[#04122b]/70 p-8 text-[#d5e3f7] shadow-[0_10px_30px_rgba(1,9,27,0.55)] backdrop-blur-xl transition-all duration-500 hover:border-[#f7d979]/50 hover:shadow-[0_15px_40px_rgba(223,180,85,0.2)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#12508f]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#3d8fd8]/35">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2 border-b border-[#2c4d84]/50 pb-6 text-left text-base leading-relaxed font-medium text-[#8fa5c4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#fdf1cd] via-[#f7d979] to-[#a87a1e] bg-clip-text text-center text-3xl leading-normal font-black tracking-wider text-transparent uppercase drop-shadow-sm md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5e3f7] md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-xl leading-normal font-black text-[#fdf1cd] drop-shadow-[0_0_5px_rgba(223,180,85,0.55)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
