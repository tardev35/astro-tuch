---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-amber-500/30 bg-[#120b06]/60 p-8 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-amber-400/50 hover:shadow-[0_15px_40px_rgba(251,191,36,0.18)] md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2 border-b border-amber-500/30 pb-6 text-left text-base leading-relaxed font-medium text-amber-100/80 md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-center text-3xl leading-normal font-black tracking-wider text-transparent uppercase drop-shadow-sm md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-amber-50/85 md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-xl leading-normal font-black text-white drop-shadow-[0_0_5px_rgba(251,191,36,0.55)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
