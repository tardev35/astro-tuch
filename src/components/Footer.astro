---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// FAH999 (รอบชมพูบานเย็น-ทอง 2026-10-11): ฟุตเตอร์ที่ใช้งานรอบนี้ หมุนมาจาก
// FooterPremiumSumo ของ DUCK1688 — เป็นแผ่น rounded-t-[3rem] กริด 12 คอลัมน์
// แบ่ง 5/3/4 มีออราชมพูเรืองลอยเหนือขอบบน และมี BankStrip อยู่ในคอลัมน์ขวา
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน BPLAY639 ซึ่ง **ก็เป็นแบรนด์ชมพูเหมือนกัน** —
// "มีชมพูอยู่แล้ว" ไม่ได้แปลว่าเป็นชมพูของรอบนี้ ต้องเทียบเป็นค่า ชุดชมพู-ม่วงของ
// BPLAY639 (#f472b6 #14061f #fdf2f8 #e9d5f5 #7e22ce #c4b5fd #ddd6fe #fbcfe8
// #b79ac9) ถอดออกครบแล้ว และข้อความของมัน (คาสิโนออนไลน์ลิขสิทธิ์แท้จากอเมริกา
// บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด) ถูกเขียนใหม่จากบรีฟรอบนี้ทั้งหมด
// ไม่ใช่ find-and-replace ทับประโยคเดิม — FAH999 เป็น "ฟาสล็อตเว็บตรง" เว็บสล็อต
// ล้วน ไม่มีโต๊ะคาสิโนและไม่มีหวย
//
// พาเลตต์ตาม brand-spec §2: ชมพูบานเย็น #ff3fa4 ฮิวนำ · ชมพูอ่อน #ffd1ea hover ·
// ทอง #f5c53d ฮิวที่สอง · พื้น #210220 · เนื้อความ #fde8f3 · รอง #e8b9d4
// #b3006a / #9c6f08 ไม่มีในไฟล์นี้เพราะไม่มีไล่เฉดที่ต้องใช้
//
// สีเขียว LINE เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: ฟุตเตอร์ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง — FAH999 เป็นเว็บสล็อต สองหน้านั้นอยู่ใน
// src/pages-disabled/ จึงไม่มี route และ verify-build จะแดงถ้าลิงก์ไปหา
//
// บล็อก <address> ด้านล่างคัดมาตรงตัวจาก SKILL.md ห้าม retheme และห้ามใส่ hex
// ลงไป — border-white/15 + bg-black/20 + opacity ลงตัวกับฟุตเตอร์ทุกตัวในคลัง
// ซึ่งเข้มหมด การพิมพ์สีรอบนี้ทับลงไปคือวิธีที่ทำให้ hex ของแบรนด์นี้ค้างรอบหน้า
const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt =
  "โลโก้ FAH999 เป็นสาวผมน้ำตาลใส่หูกระต่ายสีชมพู เท้าแก้มทั้งสองข้างและขยิบตา มีไพ่เอซโพดำกับเอซโพแดง ชิปคาสิโนชมพูขอบทอง เหรียญทอง และตู้สล็อต 777 สีทองล้อมอยู่ ด้านล่างเป็นตัวอักษร FAH999 สีชมพูประกายสามมิติขอบขาว-ทอง บนแผ่นป้ายสีเข้มขอบทอง";
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#ff3fa4] bg-[#210220] pt-16 pb-8 font-sans text-[#fde8f3] shadow-[0_-10px_30px_rgba(255,63,164,0.20)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#ff3fa4]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#ff3fa4]/35 bg-white px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[150, 300, 450]} sizes="150px" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#2b0019]">
                FAH<span class="text-[#ff3fa4]">999</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#ff3fa4] pl-4 text-sm leading-relaxed text-[#e8b9d4]">
          {BRAND_NAME} ฟาสล็อตเว็บตรง รวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปิน ระบบ Login ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมแอดมินคอยบริการออนไลน์ 24 ชั่วโมง
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-[#ff3fa4]/35 bg-[#4a0b42]/70 px-3 py-1 text-[10px] font-bold text-[#ffd1ea]">HTTPS / SSL</span>
          <span class="rounded-sm border border-[#f5c53d]/40 bg-[#f5c53d]/10 px-3 py-1 text-[10px] font-bold text-[#f5c53d]">แอดมิน 24 ชั่วโมง</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#ff3fa4]/30 pb-2 text-base font-black tracking-widest text-[#fde8f3] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e8b9d4]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#ffd1ea]">
                  <span aria-hidden="true" class="text-[#ff3fa4]">
                    ▸
                  </span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#ff3fa4]/30 pb-2 text-base font-black tracking-widest text-[#fde8f3] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#e8b9d4]">ธนาคารและวอลเล็ตที่รองรับ:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#ff3fa4]/15 pt-6 text-xs font-medium text-[#e8b9d4] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffd1ea]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd1ea]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
