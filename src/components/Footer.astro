---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// สล็อต168 (รอบแดงเจล-มุกขาวบนดำอมแดง 2026-10-23): ฟุตเตอร์ที่ใช้งานรอบนี้
// หมุนมาจาก FooterHuay ของ รวย168 — ไฟล์นี้เป็นแผ่น rounded-t-[3rem] กริด 12
// คอลัมน์ แบ่ง 5/3/4 มีออราเรืองลอยเหนือขอบบน และมี BankStrip อยู่ในคอลัมน์ขวา
// (FooterHuay เป็นแผ่นเหลี่ยมมีลายธีมหวย — คนละทรงกันชัดเจน)
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอนแบรนด์ **ทองจักรพรรดิ-แดงชาด** — "มีแดงอยู่แล้ว"
// ไม่ได้แปลว่าเป็นแดงของรอบนี้ ต้องเทียบเป็นค่า ชุดทอง-แดงเดิม (f0bb4e / ffeccb /
// e4021b / d9701a / 260d04 / 3b1b0e / fff8ec / 0d0501) ถอดออกครบแล้ว และก่อนหน้า
// นั้นเป็นชุดชมพู-ทองของ FAH999 (ff3fa4 / ffd1ea / f5c53d / 210220 / fde8f3 /
// e8b9d4 / 4a0b42 / 2b0019) กับชุดชมพู-ม่วงของ BPLAY639 (f472b6 / 14061f /
// fdf2f8 / e9d5f5 / 7e22ce / c4b5fd / ddd6fe / fbcfe8 / b79ac9) ซึ่งถอดออกไปแล้ว
// (เขียนไม่มี # เพื่อให้ sweep ที่ไล่หา "#hex ของแบรนด์เก่า" ไม่สะดุดที่คอมเมนต์นี้)
// ⚠️⚠️ **ทองคือฮิวนำของรวย168 รอบก่อนทันที — รอบนี้ไม่มีทองเลยสักเฉด**
//
// ข้อความทั้งหมดเขียนใหม่จากบรีฟรอบนี้ (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับประโยคเดิม — ของรอบก่อนพูดถึง "ยิงปลา / ไฮโล /
// หวยออนไลน์ / แทงเลข" ซึ่ง **ไม่มีคำไหนอยู่ในบรีฟรอบนี้เลย** รอบนี้เป็น
// **เว็บสล็อตล้วน** คำนิยามตัวเองคือ "ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก"
//
// พาเลตต์ตาม brand-spec §2: แดงสด #fb2e33 ฮิวนำ (ถือตัวอักษรได้ 5.1:1 บนพื้นนี้) ·
// มุกอุ่น #f0e6e4 เนื้อความ (= BRAND_TEXT, 16.0:1) · แพลทินัม #e3d6d4 hover และ
// ตัวอักษรรอง · แดงลึก #cb0b0d (ขอบ/พื้นถมเท่านั้น) · มุกเข้ม #7d6f6e เฉดเงา ·
// พื้นฟุตเตอร์ #1c0607 (ชั้นการ์ดของ depth ramp) · ผิวยก #2a0c0d · ผิวจม #0b0000
// ⚠️ #cb0b0d ได้คอนทราสต์ 3.5:1 บนพื้นเพจ = **ตกเกณฑ์ AA** จึงไม่ถือตัวอักษร
// เลยสักจุดในไฟล์นี้ ป้ายที่ใช้แดงลึกเป็นขอบ+พื้นถมจาง แต่ตัวอักษรเป็นแพลทินัม
//
// ⚠️ แผ่นรองโลโก้เป็น **พื้นเข้ม ไม่ใช่ bg-white แบบที่ไฟล์นี้เคยเป็น** — โลโก้
// รอบนี้เป็นตัวอักษรเจลแดงที่มีไฮไลต์ขาว ถ้าวางบนแผ่นขาวไฮไลต์จะหายไปทั้งชุด
// และขอบขาวของตัวอักษรจะกลืนพื้น
//
// สีเขียว LINE เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: ฟุตเตอร์ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง — **รอบนี้กลับทิศจากรอบก่อน** สล็อต168 เป็น
// เว็บสล็อตล้วน สองหน้านั้นถูกย้ายกลับไป src/pages-disabled/ แล้ว จึงไม่มี route
// และ verify-build จะแดงถ้าลิงก์ไปหา (FooterHuay ของรอบก่อนลิงก์ทั้งคู่ไว้ใต้
// "ทางลัดหน้าเว็บ" — ไฟล์นั้นปล่อยไว้เฉยๆ ในฐานะ inventory ของแบรนด์หวยตัวถัดไป)
//
// บล็อก <address> ด้านล่างคัดมาตรงตัวจาก SKILL.md ห้าม retheme และห้ามใส่ hex
// ลงไป — border-white/15 + bg-black/20 + opacity ลงตัวกับฟุตเตอร์ทุกตัวในคลัง
// ซึ่งเข้มหมด การพิมพ์สีรอบนี้ทับลงไปคือวิธีที่ทำให้ hex ของแบรนด์นี้ค้างรอบหน้า
const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตัวอักษรไทยผสมเลขสามมิติทรงอ้วนมน ผิวเจลสีแดงสดมันวาวมีไฮไลต์สีขาวพาดบนตัวอักษรทุกตัว ตัวอักษรตัวแรกมีมงกุฎทองขนาดเล็กประดับหัวใจสีแดงวางอยู่ด้านบน และมีขีดเฉียงสีแดงสั้น ๆ อยู่ท้ายคำ`;
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#fb2e33] bg-[#1c0607] pt-16 pb-8 font-sans text-[#f0e6e4] shadow-[0_-10px_30px_rgba(251,46,51,0.20)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#cb0b0d]/14 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#fb2e33]/35 bg-[#0b0000] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[150, 300, 450]} sizes="150px" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#fb2e33]">
                สล็อต<span class="text-[#f0e6e4]">168</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#fb2e33] pl-4 text-sm leading-relaxed text-[#f0e6e4]/75">
          {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศไว้ในเว็บไซต์เดียว ทั้งรายละเอียดระบบเกม โปรโมชั่น และช่องทางฝากถอนสำหรับสมาชิก
          พร้อมเมนูสำหรับศึกษากติกาเกมและตรวจสอบเงื่อนไขการเดิมพัน ผู้ใช้งานควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งานทุกครั้ง
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="rounded-sm border border-[#fb2e33]/40 bg-[#2a0c0d]/70 px-3 py-1 text-[10px] font-bold text-[#e3d6d4]">แอดมิน 24ชม.</span>
          <span class="rounded-sm border border-[#cb0b0d]/50 bg-[#cb0b0d]/15 px-3 py-1 text-[10px] font-bold text-[#e3d6d4]">คืนยอดเสีย 0.3%</span>
          <span class="rounded-sm border border-[#7d6f6e]/50 bg-[#7d6f6e]/12 px-3 py-1 text-[10px] font-bold text-[#e3d6d4]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#fb2e33]/30 pb-2 text-base font-black tracking-widest text-[#f0e6e4] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f0e6e4]/75">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#fb2e33]">
                  <span aria-hidden="true" class="text-[#fb2e33]">
                    ▸
                  </span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#fb2e33]/30 pb-2 text-base font-black tracking-widest text-[#f0e6e4] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#f0e6e4]/75">ธนาคารและวอลเล็ตที่รองรับ:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#fb2e33]/15 pt-6 text-xs font-medium text-[#f0e6e4]/75 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fb2e33]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fb2e33]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
