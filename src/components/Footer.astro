---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#f472b6] bg-[#14061f] pt-16 pb-8 font-sans text-[#fdf2f8] shadow-[0_-10px_30px_rgba(244,114,182,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#f472b6]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f472b6]/35 bg-white px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ BPLAY639 ตัวอักษรหนาทรงป่องโทนพาสเทล คำว่า BPLAY สลับสีชมพู ม่วงลาเวนเดอร์ และครีม ตามด้วยเลข 639 สีครีม ชมพู และม่วง"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#14061f]">
                BPLAY<span class="text-[#f472b6]">639</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#f472b6] pl-4 text-sm leading-relaxed text-[#e9d5f5]">
          BPLAY639 คาสิโนออนไลน์ลิขสิทธิ์แท้จากอเมริกา รวมบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด และสล็อตไว้ในบัญชีเดียว พร้อมโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียสูงถึง 0.3% ตามเงื่อนไข
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-[#f472b6]/35 bg-[#7e22ce]/40 px-3 py-1 text-[10px] font-bold text-[#fbcfe8]">HTTPS / SSL</span>
          <span class="rounded-sm border border-[#c4b5fd]/30 bg-[#c4b5fd]/10 px-3 py-1 text-[10px] font-bold text-[#ddd6fe]">AUTO 24 HR</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#f472b6]/30 pb-2 text-base font-black tracking-widest text-[#fdf2f8] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e9d5f5]">
          <li><a href="/" class="flex items-center gap-2 transition-colors hover:text-[#f9a8d4]"><span aria-hidden="true" class="text-[#f472b6]">▸</span> หน้าแรก</a></li>
          <li>
            <a href="/ทดลองเล่น" class="flex items-center gap-2 transition-colors hover:text-[#f9a8d4]"><span aria-hidden="true" class="text-[#f472b6]">▸</span> ทดลองเล่น</a>
          </li>
          <li>
            <a href="/promotion" class="flex items-center gap-2 transition-colors hover:text-[#f9a8d4]"><span aria-hidden="true" class="text-[#f472b6]">▸</span> โปรโมชั่น</a>
          </li>
          <li>
            <a href="/ทางเข้า" class="flex items-center gap-2 transition-colors hover:text-[#f9a8d4]"><span aria-hidden="true" class="text-[#f472b6]">▸</span> ทางเข้า</a>
          </li>
          <li>
            <a href="/register" class="flex items-center gap-2 transition-colors hover:text-[#f9a8d4]"><span aria-hidden="true" class="text-[#f472b6]">▸</span> สมัครสมาชิก</a>
          </li>
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#f472b6]/30 pb-2 text-base font-black tracking-widest text-[#fdf2f8] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#b79ac9]">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#f472b6]/15 pt-6 text-xs font-medium text-[#b79ac9] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fdf2f8]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fdf2f8]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
