---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// รวยเทพ168 (รอบทองจักรพรรดิ-แดงชาดบนดำสนิท 2026-10-20): ฟุตเตอร์ที่ใช้งานรอบนี้
// หมุนมาจาก FooterStyle3 ของ มีเฮ168 — เป็นแผ่น rounded-t-[3rem] กริด 12 คอลัมน์
// แบ่ง 5/3/4 มีออราเรืองลอยเหนือขอบบน และมี BankStrip อยู่ในคอลัมน์ขวา
//
// ⚠️ ไฟล์นี้ล่าสุดถูกใช้ตอน FAH999 ซึ่งเป็นแบรนด์ **ชมพูบานเย็น-ทอง** — "มีทอง
// อยู่แล้ว" ไม่ได้แปลว่าเป็นทองของรอบนี้ ต้องเทียบเป็นค่า ชุดชมพู-ทองของ FAH999
// (ff3fa4 / ffd1ea / f5c53d / 210220 / fde8f3 / e8b9d4 / 4a0b42 / 2b0019) ถอดออก
// ครบแล้ว และก่อนหน้านั้นเป็นชุดชมพู-ม่วงของ BPLAY639 (f472b6 / 14061f / fdf2f8 /
// e9d5f5 / 7e22ce / c4b5fd / ddd6fe / fbcfe8 / b79ac9) ซึ่งก็ถอดออกไปแล้วเช่นกัน
// (เขียนไม่มี # เพื่อให้ sweep ที่ไล่หา "#hex ของแบรนด์เก่า" ไม่สะดุดที่คอมเมนต์นี้)
//
// ข้อความทั้งหมดเขียนใหม่จากบรีฟรอบนี้ (src/assets/content.txt) ไม่ใช่
// find-and-replace ทับประโยคเดิม — ของ FAH999 พูดถึง "ฟาสล็อตเว็บตรง / สล็อต
// คลาสสิก / เกมโบนัส / ฟรีสปิน / ระบบ Login" ซึ่ง **ไม่มีคำไหนอยู่ในบรีฟรอบนี้เลย**
// โดยเฉพาะ "เว็บตรง" ที่ brand-spec §6 ห้ามไว้ชัดเจน
//
// พาเลตต์ตาม brand-spec §2: ทองน้ำผึ้ง #f0bb4e ฮิวนำ · ครีมทอง #ffeccb hover และ
// ตัวอักษรรอง · แดงชาด #e4021b ฮิวที่สอง (ขอบ/พื้นถมเท่านั้น) · ทองแดง #d9701a
// เฉดเงา · พื้นฟุตเตอร์ #260d04 (ชั้นกลางของ depth ramp) · ผิวยก #3b1b0e ·
// เนื้อความ #fff8ec (= BRAND_TEXT)
// ⚠️ #e4021b ได้คอนทราสต์ 3.8:1 บนพื้นฟุตเตอร์นี้ = **ตกเกณฑ์ AA** จึงไม่ถือ
// ตัวอักษรเลยสักจุดในไฟล์นี้ ป้ายที่ใช้แดงเป็นขอบ+พื้นถมจาง แต่ตัวอักษรเป็นครีม
//
// ⚠️ แผ่นรองโลโก้เป็น **พื้นเข้ม ไม่ใช่ bg-white แบบที่ไฟล์นี้เคยเป็น** — โลโก้
// รอบนี้มีคำว่า "เทพ" เป็นตัวอักษรสีขาวมุก ถ้าวางบนแผ่นขาวจะจมหายไปทั้งคำ
// (ของ FAH999 เป็นโลโก้บนแผ่นป้ายสีเข้มในตัวเองอยู่แล้วจึงไม่เจอปัญหานี้)
//
// สีเขียว LINE เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์ — คงไว้ตามเดิม
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ heading: ฟุตเตอร์ขึ้นทุกหน้า heading ตรงนี้หนึ่งตัว
// = heading เกินทุกหน้าในเว็บ และ inventory h2 จะไม่ตรงกับ docx ตลอดไป
//
// ไม่มีลิงก์ /ตรวจหวย และ /แนวทาง — รวยเทพ168 เป็นเว็บเกมสล็อต (ถึงบรีฟจะระบุ
// หวยออนไลน์เป็นหนึ่งในสี่หมวดเกมก็ตาม) สองหน้านั้นอยู่ใน src/pages-disabled/
// จึงไม่มี route และ verify-build จะแดงถ้าลิงก์ไปหา
//
// บล็อก <address> ด้านล่างคัดมาตรงตัวจาก SKILL.md ห้าม retheme และห้ามใส่ hex
// ลงไป — border-white/15 + bg-black/20 + opacity ลงตัวกับฟุตเตอร์ทุกตัวในคลัง
// ซึ่งเข้มหมด การพิมพ์สีรอบนี้ทับลงไปคือวิธีที่ทำให้ hex ของแบรนด์นี้ค้างรอบหน้า
const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภของจีนกำลังหัวเราะ สวมหมวกปีกสีทองแต่งสีแดงและเสื้อคลุมสีแดงปักทอง นั่งอยู่บนริ้วทองโค้ง ถัดมาเป็นคำว่า รวย ตัวอักษรไทยหนาสามมิติสีทองไล่เฉด ต่อด้วยคำว่า เทพ สีขาวมุกตัดขอบเทา และเลข 168 สีแดงชาดผิวมันวาว ล้อมด้วยประกายดาวสีทองและเหรียญทอง`;
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#f0bb4e] bg-[#260d04] pt-16 pb-8 font-sans text-[#fff8ec] shadow-[0_-10px_30px_rgba(240,187,78,0.20)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#f0bb4e]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f0bb4e]/35 bg-[#0d0501] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[150, 300, 450]} sizes="150px" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f0bb4e]">
                รวยเทพ<span class="text-[#ffeccb]">168</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#f0bb4e] pl-4 text-sm leading-relaxed text-[#fff8ec]/75">
          {BRAND_NAME} รวมช่องทางบริการเกมออนไลน์หลายประเภทไว้ในเว็บไซต์เดียว ทั้งเกมสล็อต ยิงปลา ไฮโล และหวยออนไลน์ พร้อมเมนูสมัครสมาชิก เข้าสู่ระบบ ฝากถอน และรายละเอียดโปรโมชั่น
          ผู้ใช้งานควรตรวจสอบกติกา เงื่อนไขการเดิมพัน และข้อมูลผู้ให้บริการก่อนเริ่มใช้งานทุกครั้ง
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="rounded-sm border border-[#f0bb4e]/40 bg-[#3b1b0e]/70 px-3 py-1 text-[10px] font-bold text-[#ffeccb]">แอดมิน 24ชม.</span>
          <span class="rounded-sm border border-[#e4021b]/50 bg-[#e4021b]/15 px-3 py-1 text-[10px] font-bold text-[#ffeccb]">คืนยอดเสีย 0.3%</span>
          <span class="rounded-sm border border-[#d9701a]/50 bg-[#d9701a]/12 px-3 py-1 text-[10px] font-bold text-[#ffeccb]">แนะนำเพื่อน 0.8%</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#f0bb4e]/30 pb-2 text-base font-black tracking-widest text-[#fff8ec] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fff8ec]/75">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#ffeccb]">
                  <span aria-hidden="true" class="text-[#f0bb4e]">
                    ▸
                  </span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#f0bb4e]/30 pb-2 text-base font-black tracking-widest text-[#fff8ec] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#fff8ec]/75">ธนาคารและวอลเล็ตที่รองรับ:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#f0bb4e]/15 pt-6 text-xs font-medium text-[#fff8ec]/75 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffeccb]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffeccb]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
