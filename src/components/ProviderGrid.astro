---
// The rows come straight from the brief's "เว็บพนัน HENGDEE89 รวมเกมครบทุกการ
// เดิมพันออนไลน์" section — เกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย
// และการเดิมพันกีฬา จัดหมวดหมู่ให้ค้นหาง่าย รองรับสมาร์ตโฟน แท็บเล็ต และ
// คอมพิวเตอร์ — so the grid and the paragraph above it never contradict each
// other. Every tile also repeats the brief's own caution to check กติกา อัตรา
// การจ่าย และเงื่อนไข ก่อนเดิมพัน.
const providers = [
  { name: "เกมสล็อต", desc: "หมวดเกมสล็อตหลายรูปแบบ ตรวจสอบกติกาและอัตราการจ่ายของแต่ละเกมได้จากหน้ารายละเอียด", tag: "เลือกได้หลายเกม", icon: "🎰" },
  { name: "บาคาร่า", desc: "โต๊ะบาคาร่าออนไลน์พร้อมรายละเอียดกติกาและรูปแบบการเดิมพันของแต่ละโต๊ะในระบบ", tag: "ดูกติกาก่อนลง", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ห้องคาสิโนถ่ายทอดสด เลือกโต๊ะและตรวจสอบเงื่อนไขการเดิมพันได้จากหน้าเกมโดยตรง", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "รูเล็ต", desc: "หมวดรูเล็ตหลายรูปแบบ อัตราการจ่ายและตัวเลือกการเดิมพันแสดงไว้ในแต่ละโต๊ะ", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมเสือมังกรที่จบรอบไว ควรอ่านกติกาและอัตราการจ่ายของโต๊ะก่อนเริ่มเดิมพัน", tag: "จบรอบไว", icon: "🐯" },
  { name: "เกมไพ่", desc: "รวมเกมไพ่หลายประเภทไว้ในหมวดเดียว รายละเอียดและเงื่อนไขแยกตามแต่ละเกม", tag: "หลายประเภท", icon: "🀄" },
  { name: "หวย", desc: "หมวดหวยพร้อมรายละเอียดรอบ อัตราการจ่าย และเงื่อนไขของแต่ละประเภทให้ตรวจสอบก่อนแทง", tag: "ตรวจรอบก่อนแทง", icon: "🎫" },
  { name: "เดิมพันกีฬา", desc: "เลือกคู่แข่งขันและรูปแบบการเดิมพันกีฬา โดยเงื่อนไขของแต่ละรายการแสดงไว้ในระบบ", tag: "หลายรายการ", icon: "⚽" },
];
---

<section aria-label="หมวดเกมเดิมพันออนไลน์ที่ HENGDEE89 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdd32d] via-[#ffe98a] to-[#f5322e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมเดิมพันออนไลน์ที่ <span class="text-[#ffe98a]">HENGDEE89</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdd32d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#a97a08]/40 bg-[#0d0303]/92 p-5 shadow-[0_10px_30px_rgba(211,20,17,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fdd32d]/60 hover:bg-[#2a0b0b] hover:shadow-[0_15px_40px_rgba(253,211,45,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#d31411]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe98a] via-[#fdd32d] to-[#a97a08] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0d0303] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7e4dc] transition-colors group-hover:text-[#ffe98a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9a29a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a97a08]/40 bg-[#0d0303] py-1.5 text-center text-[11px] font-bold text-[#ffe98a] shadow-inner transition-colors duration-300 group-hover:border-[#fdd32d]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffe98a] group-hover:via-[#fdd32d] group-hover:to-[#a97a08] group-hover:text-[#0d0303]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
