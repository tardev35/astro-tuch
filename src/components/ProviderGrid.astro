---
// YADOM168 is a slot brand — NOT a lottery and not a multi-product casino.
// Every tile below stays inside what the brief states: การรวมเกมสล็อตจากหลายค่าย
// ไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ ๆ,
// การใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์, เกมที่รองรับเบทต่ำ 1 บาทตามช่วง
// เดิมพันของแต่ละค่าย, ระบบออโต้สำหรับจัดการเครดิต ฝากถอน และตรวจสอบรายการ,
// การ Login เพื่อตรวจสอบโบนัสที่มีสิทธิ์รับในแต่ละวัน, โบนัสแนะนำเพื่อน 0.8%,
// และแอดมินที่ช่วยเหลือด้านการใช้งานได้ตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence, a founding year, or a cashback
// promotion — the brief says outright that ผลลัพธ์ของเกมสล็อตรับประกันไม่ได้ว่า
// เกมใดจะแตกง่ายหรือทำกำไรได้ทุกครั้ง, and that ขั้นต่ำในเกมต่างกันตามค่าย.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "เกมสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ ดูช่วงเดิมพันและรูปแบบการจ่ายของเกมนั้นได้ก่อนกด Spin ทุกครั้ง", tag: "เลือกตามค่าย", icon: "🎰" },
  { name: "เกมโบนัสและฟรีสปิน", desc: "หมวดเกมที่มีฟีเจอร์โบนัสและรอบฟรีสปินในตัวเกม เงื่อนไขการเข้าฟีเจอร์เป็นไปตามที่แต่ละเกมกำหนด ควรอ่านกติกาก่อนเริ่มเล่น", tag: "ตามเงื่อนไขเกม", icon: "🎁" },
  {
    name: "แจ็กพอตและเกมธีมใหม่",
    desc: "เกมแจ็กพอตและเกมธีมใหม่ ๆ เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ เลือกและสลับเกมได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายเว็บไซต์",
    tag: "หลายค่ายในบัญชีเดียว",
    icon: "💎",
  },
  {
    name: "เกมที่รองรับเบทต่ำ 1 บาท",
    desc: "มีเกมที่รองรับช่วงเดิมพันเริ่มต้นระดับ 1 บาทให้เลือก แต่ควรตรวจสอบขั้นต่ำภายในเกมก่อนกด Spin เพราะแต่ละค่ายกำหนดช่วงเดิมพันไม่เท่ากัน",
    tag: "ตรวจในเกมก่อน",
    icon: "🪙",
  },
  {
    name: "ระบบออโต้ ฝากถอนและเครดิต",
    desc: "จัดการเครดิต ทำรายการฝากถอน และตรวจสอบสถานะรายการผ่านบัญชีของตนเองได้ ควรดูวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยัน",
    tag: "ทำรายการเอง",
    icon: "💳",
  },
  { name: "แอดมินช่วยเหลือ 24 ชั่วโมง", desc: "สอบถามขั้นตอนใช้งาน ระบบฝากถอน วิธีรับโปรโมชั่น หรือการเข้าเกมสล็อตแต่ละค่ายกับแอดมิน YADOM168 ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการของ YADOM168 ที่ตรวจสอบได้ก่อนเริ่มเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f2fbef] uppercase">
      หมวดเกมสล็อตและบริการของ YADOM<span class="text-[#5cc23f]">168</span> ที่ตรวจสอบได้ก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#5cc23f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0f3d0d] bg-[#071508]/92 p-5 shadow-[0_10px_30px_rgba(2,8,3,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#5cc23f]/80 hover:bg-[#0f2a10] hover:shadow-[0_15px_40px_rgba(92,194,63,0.30)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#5cc23f]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#8fe06f] via-[#e6bd5c] to-[#5cc23f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#040d04] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d4e8cb] transition-colors group-hover:text-[#f2fbef]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9bb38d]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0f3d0d] bg-[#040d04] py-1.5 text-center text-[11px] font-bold text-[#8fe06f] shadow-inner transition-colors duration-300 group-hover:border-[#e6bd5c]/70 group-hover:bg-gradient-to-r group-hover:from-[#8fe06f] group-hover:via-[#e6bd5c] group-hover:to-[#5cc23f] group-hover:text-[#040d04]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
