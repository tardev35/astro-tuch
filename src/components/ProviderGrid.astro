---
const providers = [
  { name: "คาสิโนสด", desc: "ห้องถ่ายทอดสดจากดีลเลอร์จริง เลือกโต๊ะและวงเงินที่เปิดให้บริการได้เอง", tag: "ถ่ายทอดสด", icon: "🃏" },
  { name: "บาคาร่า", desc: "เลือกห้องที่เปิดอยู่ ตรวจสอบวงเงินและเงื่อนไขก่อนวางเดิมพันทุกครั้ง", tag: "ยอดนิยม", icon: "🀄" },
  { name: "รูเล็ต", desc: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดงได้ก่อนยืนยัน", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่ใบเดียวรู้ผลไว เหมาะกับสมาชิกที่ต้องการรอบการเล่นสั้น", tag: "รู้ผลไว", icon: "🐯" },
  { name: "แบล็กแจ็ก", desc: "เกมไพ่คลาสสิก ตรวจสอบกติกาและอัตราจ่ายของแต่ละโต๊ะก่อนเริ่มเดิมพัน", tag: "ดูกติกาก่อนเล่น", icon: "🎴" },
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตหลายรูปแบบ พร้อมอัปเดตเกมใหม่เข้าระบบอย่างต่อเนื่อง", tag: "อัปเดตเกมใหม่", icon: "🎰" },
  { name: "รวมค่ายเกมชั้นนำ", desc: "PG SOFT · Pragmatic Play · Joker · Evolution · SA Gaming · Sexy Baccarat ตามค่ายที่เปิดให้บริการ", tag: "ครบทุกค่าย", icon: "🏆" },
];
---

<section aria-label="หมวดเกมคาสิโนที่ 12PLAY เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e01020] via-[#ff5a63] to-[#f4eff0] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนที่ <span class="text-[#ff5a63]">12PLAY</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01020] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a0710]/35 bg-[#0a0102]/92 p-5 shadow-[0_10px_30px_rgba(224,16,32,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e01020]/60 hover:bg-[#1a0304] hover:shadow-[0_15px_40px_rgba(224,16,32,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e01020]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff5a63] via-[#e01020] to-[#8a0710] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#f4eff0] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e0d7d8] transition-colors group-hover:text-[#ff5a63]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#8f959f]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a0710]/35 bg-[#0a0102] py-1.5 text-center text-[11px] font-bold text-[#ff5a63] shadow-inner transition-colors duration-300 group-hover:border-[#e01020]/60 group-hover:bg-gradient-to-r group-hover:from-[#ff5a63] group-hover:via-[#e01020] group-hover:to-[#8a0710] group-hover:text-[#f4eff0]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
