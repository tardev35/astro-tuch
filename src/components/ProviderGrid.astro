---
// OCZPLUS is a slot brand — สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุด ที่
// วางระบบนิเวศการเดิมพันแบบ Portal & Privilege — so the tiles are the
// capabilities the brief itself names: การันตียอดถอนทุกวันและจ่ายเต็มจำนวน,
// เกมลิขสิทธิ์แท้ที่ควบคุมด้วยระบบสุ่ม RNG 100% แบบไม่ล็อคยูสเซอร์, กราฟิกระดับ
// Cinematic Lighting บนอินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค, ระบบฝาก-ถอนอัตโนมัติ
// ที่รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet โดยไม่ต้องส่งสลิปและไม่มีขั้นต่ำ,
// การเล่นได้ไหลลื่นทั้ง iOS และ Android, และแอดมินผ่าน Line Official ตลอด 24
// ชั่วโมง. No tile quotes a payout figure, a licence number, a founding year, or
// a member count — the brief states none of those.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "การันตียอดถอนทุกวัน จ่ายเต็มจำนวน",
    desc: "ทำกำไรหลักหมื่นหรือหลักล้าน ระบบพร้อมจ่ายเต็มจำนวน ไร้ประวัติการโกง พิสูจน์ได้จากรีวิวของสมาชิกตัวจริง",
    tag: "ได้เงินชัวร์ 100%",
    icon: "💰",
  },
  {
    name: "ไม่ล็อคยูสเซอร์ ควบคุมด้วย RNG 100%",
    desc: "เกมลิขสิทธิ์แท้ที่ควบคุมด้วยระบบสุ่ม RNG 100% ลูกค้าเก่าและใหม่มีโอกาสชนะและรับแจ็คพอตเท่าเทียมกัน",
    tag: "แจกทุกยูส",
    icon: "🔓",
  },
  {
    name: "กราฟิกระดับ Cinematic Lighting",
    desc: "กราฟิกเกมสล็อตจัดเต็มด้วยแสงเงาระดับ Cinematic Lighting บนอินเทอร์เฟซโทนกรมท่าตัดสีทองเมทัลลิคสุดพรีเมียม",
    tag: "ลักชูรีทุกสปิน",
    icon: "🎬",
  },
  {
    name: "ฝาก-ถอนออโต้ทุกธนาคารและวอลเลท",
    desc: "รองรับทุกธนาคารชั้นนำในประเทศไทยรวมถึง TrueMoney Wallet ทำรายการภายในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่มีขั้นต่ำ",
    tag: "ออโต้ 3-5 วินาที",
    icon: "💳",
  },
  {
    name: "ถอนได้ไม่จำกัดรอบตลอด 24 ชั่วโมง",
    desc: "ทำรายการถอนเงินได้ตลอด 24 ชั่วโมง โดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดถอนสูงสุดต่อวัน",
    tag: "ไม่จำกัดยอด",
    icon: "⏱️",
  },
  {
    name: "แอดมินผ่าน Line Official 24 ชั่วโมง",
    desc: "ทีมงานดูแลลูกค้ามืออาชีพสแตนด์บายให้บริการและคำปรึกษาผ่านช่องทาง Line Official ตลอด 24 ชั่วโมง",
    tag: "ตอบไว ตรงจุด",
    icon: "🎧",
  },
];
---

<section aria-label="จุดเด่นของแพลตฟอร์ม OCZPLUS ที่ตรวจสอบได้ก่อนเข้าเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f7eed6] uppercase">
      จุดเด่นของแพลตฟอร์ม OCZ<span class="text-[#d9b45e]">PLUS</span> ที่ตรวจสอบได้ก่อนเข้าเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d9b45e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a6b2c]/65 bg-[#071a36]/92 p-5 shadow-[0_10px_30px_rgba(2,16,31,0.7)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#d9b45e]/80 hover:bg-[#0b2547] hover:shadow-[0_15px_40px_rgba(217,180,94,0.26)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#d9b45e]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#03101f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ccd6e6] transition-colors group-hover:text-[#f7eed6]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#ccd6e6]/60">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a6b2c]/65 bg-[#02101f] py-1.5 text-center text-[11px] font-bold text-[#e4c67f] shadow-inner transition-colors duration-300 group-hover:border-[#d9b45e]/70 group-hover:bg-gradient-to-r group-hover:from-[#f2dc9a] group-hover:via-[#d9b45e] group-hover:to-[#8a6b2c] group-hover:text-[#03101f]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
