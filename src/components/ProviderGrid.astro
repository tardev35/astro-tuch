---
// The tiles stay inside what the BETPLAY369 brief actually states: รวมเกมเดิมพัน
// หลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอล — so this
// grid never claims a game category or a provider name the brief does not have.
// Each tile repeats the brief's own caution: สมาชิกสามารถเลือกหมวดเกม ตรวจสอบกติกา
// อัตราจ่าย และรายละเอียดการเดิมพันก่อนยืนยันทุกครั้ง.
const providers = [
  { name: "บาคาร่า", desc: "เดิมพันหลักมีทั้ง Player, Banker และ Tie ตรวจสอบกติกาและอัตราจ่ายของโต๊ะที่เลือกก่อนลงเดิมพัน", tag: "อ่านกติกาก่อน", icon: "🃏" },
  { name: "คาสิโนสด", desc: "หมวดโต๊ะ Live ที่เปิดให้บริการตามระบบ ตรวจสอบผู้ให้บริการของแต่ละโต๊ะได้ก่อนเข้าเล่น", tag: "รูปแบบ Live", icon: "🎥" },
  { name: "สล็อต", desc: "สล็อตออนไลน์หลากหลายค่าย ดูเพย์ไลน์ ฟีเจอร์ และช่วงการเดิมพันของเกมได้ก่อนเริ่มเล่น", tag: "หลายค่าย", icon: "🎰" },
  { name: "หวย", desc: "หวยออนไลน์หลายรอบในระบบเดียวกับเกมอื่น รายละเอียดรอบและอัตราจ่ายแสดงไว้ในหน้าเกม", tag: "ดูรอบก่อนแทง", icon: "🎟️" },
  { name: "มวย", desc: "เลือกคู่และรูปแบบการเดิมพันได้ตามความสนใจ ตรวจสอบเงื่อนไขของแต่ละรายการก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน", icon: "🥊" },
  { name: "ฟุตบอล", desc: "เดิมพันฟุตบอลจากรายการที่เปิดให้บริการ ผลการแข่งขันไม่สามารถรับประกันล่วงหน้าได้", tag: "ตามรายการในระบบ", icon: "⚽" },
];
---

<section aria-label="หมวดเดิมพันที่ BETPLAY369 เปิดให้ตรวจสอบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#22c6f0] via-[#f4ebff] to-[#e5399f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเดิมพันที่ <span class="text-[#f4ebff]">BETPLAY369</span> เปิดให้ตรวจสอบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e5399f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6d1750]/60 bg-[#08030f]/92 p-5 shadow-[0_10px_30px_rgba(6,2,11,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e5399f]/70 hover:bg-[#3a1566] hover:shadow-[0_15px_40px_rgba(229,57,159,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#dfd0ee]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff35b4] via-[#e5399f] to-[#6d1750] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#06020b] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dfd0ee] transition-colors group-hover:text-[#f4ebff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#22c6f0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6d1750]/70 bg-[#08030f] py-1.5 text-center text-[11px] font-bold text-[#f4ebff] shadow-inner transition-colors duration-300 group-hover:border-[#e5399f]/70 group-hover:bg-gradient-to-r group-hover:from-[#ff35b4] group-hover:via-[#e5399f] group-hover:to-[#6d1750] group-hover:text-[#06020b]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
