---
import { BRAND_NAME } from "../lib/brandProfile";

// วิดเจ็ตนี้ถูกวาง **ต่อท้าย docx H2 §2 ทันที** ("<แบรนด์> บาคาร่า สล็อต ไฮโล
// รูเล็ต ยิงปลา บอล หวย เซิร์ฟแท้ ปลอดภัยในไทย" — content.txt บรรทัด 5-6) เพราะ
// หัวข้อนั้นคือหัวข้อเดียวของบรีฟที่ไล่ชื่อ **หมวดเกม** และพูดถึง **ผู้พัฒนาเกม
// ระบบเซิร์ฟเวอร์ และนโยบายคุ้มครองข้อมูลส่วนบุคคล**
//
// 🚨🚨 **ทุกไทล์เขียนจากคลังคำของบรีฟรอบนี้ล้วน** (src/assets/content.txt) และ
// **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมรายใดเลย** — มันเขียนแค่ "ครบทุกค่าย" ไว้
// บรรทัดที่ 2 → **ห้ามแต่งชื่อสตูดิโอขึ้นมาเอง** ไทล์ทั้งเจ็ดจึงเป็น
// **เจ็ดหมวดเกมที่บรีฟระบุชื่อไว้ตรงตัว**: บาคาร่า · สล็อตออนไลน์ · ไฮโล · รูเล็ต ·
// ยิงปลา · เดิมพันฟุตบอล · หวยออนไลน์ (⚠️ รอบก่อนมีห้าหมวด **ห้ามสืบทอดลิสต์ข้ามรอบ**)
// 🚨 **บรีฟรอบนี้ไม่ระบุจำนวนค่าย จำนวนเกม ค่า RTP เลขใบอนุญาต หรือยอดขั้นต่ำ
// เป็นตัวเลข** → **ไม่มีไทล์ไหนอ้างสิ่งเหล่านั้น** ตัวเลขที่ใช้ได้รอบนี้มีแค่
// **0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง** และหมวดนี้ไม่มีตัวเลขไหนเลยสักตัว
// 🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลท** → ไม่มีไทล์ไหนพูดถึง
// 🚨 **`หวยออนไลน์` รอบนี้เป็นแค่ "หนึ่งในเจ็ดหมวดเกม"** — บรีฟไม่มีคำว่า สลาก ·
// งวด · เลขเด็ด · ลอตโต้ · โพย · รอบปิดรับ · สองตัวบน-ล่าง · สามตัวตรง-โต๊ด ·
// อัตราจ่าย 2 ตัว 100 · 3 ตัว 1,000 เลยสักคำ **และห้ามเติมกลับ**
//
// ⚠️ **บรีฟรอบนี้โฆษณาและกำกับในย่อหน้าเดียวกัน (brand-spec §5) และต้อง ship
// ทั้งสองครึ่ง** ไทล์จึงบอกทั้ง "สิ่งที่เว็บไซต์ระบุ" และ "สิ่งที่ผู้ใช้งานควร
// ตรวจสอบ" ตามที่บรีฟเขียนไว้เอง — **ห้ามตัดครึ่งกำกับทิ้งเพราะฟังดูไม่ขายของ และ
// ห้ามขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่**
//
// ⚠️ ป้ายหัวแผงเป็น **<p>** และ <section> รับชื่อที่เข้าถึงได้จาก **aria-label** —
// วิดเจ็ตนี้เป็น chrome ไม่ใช่หัวข้อของบทความ จึง **ไม่ปล่อย heading tag ระดับไหน
// เลย** (h1 ถึง h6 = ศูนย์แท็ก) **ห้ามเลื่อน <p> ใบนี้ขึ้นเป็น h2 เพื่อ "แก้ชื่อ
// ที่ขาด"** — inventory ของหน้าแรกรอบนี้ถูกตรึงไว้ที่ h1x1 / h2x5 / h3x2 ตาม
// brand-spec §4
// ⚠️ อีโมจิทุกตัวอยู่ใน <div aria-hidden="true"> ที่เป็น **พี่น้อง** ของชื่อหมวด
// ไม่ใช่อักขระในข้อความ · ชื่อแบรนด์ interpolate จาก BRAND_NAME ทุกจุดรวมถึงใน
// aria-label **ไม่พิมพ์ตรง ๆ ที่ไหนเลย** และไม่มีโดเมนในไฟล์นี้
// ⚠️ ลิงก์ทุกใบชี้ /register ซึ่งเป็น route ที่มีอยู่จริงรอบนี้ — **ห้าม href="#"**
// ⚠️ กริดเป็น 2 / 3 / 4 คอลัมน์ (ไม่ใช่ 5 แบบรอบก่อน) เพราะรอบนี้มี **เจ็ด** ไทล์
// — 4+3 ที่ lg อ่านเป็นสองแถวเต็ม ส่วน 5 คอลัมน์จะทิ้งช่องว่างสองช่องกลางแถวท้าย
const providers = [
  {
    name: "บาคาร่า",
    desc: "บรีฟระบุว่าเป็นหมวดที่มีกติกาเฉพาะตัว ควรศึกษารูปแบบการเล่นและอัตราจ่ายก่อนเดิมพัน",
    tag: "มีกติกาเฉพาะตัว",
    icon: "🃏",
  },
  {
    name: "สล็อตออนไลน์",
    desc: "ระบุว่าแต่ละเกมมีฟีเจอร์แตกต่างกัน ควรอ่านรายละเอียดเกมและเงื่อนไขการใช้บริการก่อนเริ่ม",
    tag: "ฟีเจอร์ต่างกัน",
    icon: "🎰",
  },
  {
    name: "ไฮโล",
    desc: "เป็นหนึ่งในหมวดที่เว็บไซต์ระบุไว้ รูปแบบการเล่นและอัตราจ่ายไม่เหมือนหมวดอื่น",
    tag: "ตรวจกติกาก่อนเล่น",
    icon: "🎲",
  },
  {
    name: "รูเล็ต",
    desc: "ระบุไว้ว่ามีกติกาเฉพาะตัวเช่นเดียวกับบาคาร่า ควรศึกษาวิธีเดิมพันแต่ละแบบก่อนใช้งาน",
    tag: "มีกติกาเฉพาะตัว",
    icon: "🎡",
  },
  {
    name: "ยิงปลา",
    desc: "เป็นหมวดที่บรีฟระบุชื่อไว้ โดยมีรูปแบบการเล่นและอัตราจ่ายต่างจากหมวดอื่น",
    tag: "คนละรูปแบบการเล่น",
    icon: "🐟",
  },
  {
    name: "เดิมพันฟุตบอล",
    desc: "ระบุไว้เป็นหนึ่งในหมวดเดิมพัน ควรตรวจรูปแบบการเดิมพันและเงื่อนไขของแต่ละรายการ",
    tag: "ตรวจเงื่อนไขรายการ",
    icon: "⚽",
  },
  {
    name: "หวยออนไลน์",
    desc: "เป็นหมวดสุดท้ายที่บรีฟระบุไว้ ควรตรวจรายชื่อผู้พัฒนาเกมและความน่าเชื่อถือของระบบเซิร์ฟเวอร์",
    tag: "ตรวจผู้พัฒนาเกม",
    icon: "🧮",
  },
];

// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-123bet.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ไทล์เขียวป่าบนผิวมิ้นต์ของ TEVA69** ทั้งใบ จึง
// รีเธมทั้งไฟล์ — แผงนี้นั่งคั่นกลางระหว่างการ์ด docx §2 กับ §3 ซึ่งเป็น
// **ผิวเนื้อหา** ทั้งคู่ ไทล์พื้นมืดตรงนี้จะอ่านเป็นแถบแปลกปลอมกลางบทความ
// ส่วนผิวโครมเข้มของรอบนี้สงวนไว้ให้ navbar/footer/ticker/ฟีด
// ลำดับผิว: **#fdf5f6 ไทล์** · #f7dfe4 ยก (ชิปป้ายมุม) · #eec3cc เส้นบาง ·
// #f7e4e9 พื้นเพจ (หัวแผงนั่งบนพื้นเพจตรง ๆ)
// ⚠️⚠️ **หัวแผงไม่มีการ์ดครอบ มันนั่งบนพื้นเพจ #f7e4e9 ตรง ๆ** ซึ่ง §2 สั่งว่าตรงนั้น
// **ต้องเป็นหมึกเข้มเท่านั้น** (ขาวบนพื้นเพจได้แค่ 1.1:1) จึงใช้ **#36080f
// (14.4:1)** ส่วนชื่อแบรนด์ในหัวแผงเป็น **#a30d1a (6.6:1 บนพื้นเพจ)**
// ชื่อหมวดเป็น #a30d1a (7.4:1 บนไทล์) · คำอธิบายเป็นหมึกรอง #6b2b33 (9.7:1) ·
// ป้ายมุมเป็นชิปผิวยก #f7dfe4 หมึก #36080f (~15.5:1) · ปุ่มท้ายไทล์เป็นสูตร
// **"CTA หลัก" ของ §2** คือพื้นไล่ #8a1420 → #a30d1a → #c21325 + หมึกขาว
// (9.5 / 8.0 / 6.2:1 — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามลากปลายเฉดของปุ่มสว่างกว่า #c21325** — §2 ระบุไว้ตรง ๆ และ
// **#eec3cc (1.5:1) / #d98fa0 (2.3:1) / #dca53a / #ef4a5e ห้ามถือตัวอักษรบนผิว
// สว่างทุกกรณี** ในไฟล์นี้มันอยู่ที่ขอบ เส้นคาดใต้หัวแผง และแผ่นเรืองตอน hover
// ซึ่งเป็นพื้นถมล้วน
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — แดงรอบนี้คือ **#a30d1a / #8a1420 /
// #c21325 / #36080f / #6b2b33 / #330710 / #1c050b** ทองคือ **#dca53a / #7a4a0c**
// ค่าที่กวาดออกจากไฟล์นี้แล้วและห้ามกลับเข้ามา (เขียนแบบไม่มี # โดยตั้งใจ):
//   **TEVA69 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — f0ffeb ffffff e6f7df d7f0cd b2dba3
//     3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24 8a6a0e 28c437 e3bb45 c6cfd2
//   **ZORO365 (แบรนด์ขาออกทันที)** — 002908 010d04 031b09 073c1a 0e5424 1e7033
//     35a043 3ddc4a 23823a dfe6e3 e8c86a eef7f0 9dc2a5
//   🚨🚨 **LOTTO189 (ตระกูลสีเดียวกับรอบนี้เป๊ะ)** — fff0f0 ffe4e6 ffd4d7 f5b9bd
//     a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c 24060c
//     3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//     ⚠️⚠️ **c1071b / b00718 ↔ #a30d1a · 7e1221 / 8a0412 ↔ #8a1420 · 6e3b44 ↔
//     #6b2b33 · e9b53c ↔ #dca53a · ffe4e6 / ffd4d7 ↔ #f7e4e9 / #f7dfe4**
//   **MEXICANOSLOT** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
//     fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb f2543f 117a41
//   **แบรนด์หวยเก่าที่เคยอยู่ในไฟล์นี้** — 1a0709 2a0b0e 120406 9c6a12 fadc64
//     fdf3b4 e01f26 f0ddc4 f3f6fa · และ **SAGAME66** e8b93f ffe9a3 96671a 171006
//     0d0903 e3d8c0 eef3f8
//   **ZNOVA168 / ZANE96 / okkub88 / โบ๊ะบ๊ะ168** — 2a1206 7a3a0c fff3e0 e0b784
//     c98a24 c23400 d13800 fa4903 fde90b e8a000 ff8a2b d8dde6 6a4a30 · 7a1bd6
//     2b3fd9 c2178b f23bb4 bb6dff 7aa7ff 5411c4 241046 f8e6f9 f6edfe ece0fb dcc6f4 ·
//     ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b d91a73 b01160 ·
//     00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 eaf7ff
//   **แดงของแบรนด์เก่ากว่านั้น** — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238
//     c9102f c30303 8f0505 e81313 eb0305 e40303 c20305 fa0513 ff5a5f d9212a 8e1a16
//     fb141b ff5f63 d30304 a00203 dc0203 f5282a b3121b ff3b14 fb1b32 cf1111
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีส้ม ไม่มีชมพู/แมเจนต้า ไม่มีม่วง ไม่มีฟ้า/ไซแอน
// และไม่มีพื้นมืดในไฟล์นี้** — ทองอำพัน #dca53a เป็นเครื่องประดับ (มงกุฎทองและ
// ขอบตัวเลขบนอาร์ตเวิร์ก) และ **ถือตัวอักษรบนผิวสว่างไม่ได้** ส่วนเงินโครเมียม
// #d2d7dd เป็นลายเซ็นของเวิร์ดมาร์กและอยู่บนโครมเข้มเท่านั้น จึงไม่อยู่ในไฟล์นี้
---

<section aria-label={`หมวดเกมเดิมพันที่ ${BRAND_NAME} ระบุไว้ และสิ่งที่ควรตรวจสอบก่อนใช้งาน`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-2xl font-black tracking-wide text-[#36080f] sm:text-3xl">
      หมวดเกมเดิมพันที่ <span class="text-[#a30d1a]">{BRAND_NAME}</span> ระบุไว้
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a30d1a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#eec3cc] bg-[#fdf5f6] p-5 shadow-[0_10px_30px_rgba(54,8,15,0.12)] transition-all duration-300 hover:-translate-y-2 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(163,13,26,0.26)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#a30d1a]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full border border-[#eec3cc] bg-[#f7dfe4] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#36080f] transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mt-4 mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#a30d1a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] leading-relaxed text-[#6b2b33]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a1420] bg-gradient-to-r from-[#8a1420] via-[#a30d1a] to-[#c21325] py-1.5 text-center text-[11px] font-bold text-white transition-colors duration-300 group-hover:border-[#a30d1a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
