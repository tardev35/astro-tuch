---
// PAOTUNG is a multi-game portal — รวมเกมออนไลน์ สล็อต บาคาร่า หวย มวย บอล แบบ
// One-Stop Service ในรูปแบบ Portal & Privilege — so the tiles are the four game
// types the brief lists plus the capabilities it names alongside them:
// เดิมพันเริ่มต้นเพียง 1 บาท ทุกค่ายเกม, ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาที ที่
// รองรับทุกธนาคารชั้นนำตลอด 24 ชั่วโมง, และแอดมินผ่าน Line Official ตลอด 24
// ชั่วโมง. No tile quotes a payout figure, a licence number, a founding year, or
// a member count — the brief states none of those.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "สล็อตออนไลน์ลิขสิทธิ์แท้ทุกค่าย",
    desc: "รวมค่ายสล็อตระดับโลก ภาพกราฟิกคมชัด จัดเต็มด้วยแสงเงาสมจริงแบบ Cinematic Lighting ให้ทุกการสปินตื่นตาตื่นใจ",
    tag: "Cinematic Lighting",
    icon: "🎰",
  },
  {
    name: "บาคาร่าและคาสิโนสดโต๊ะวีไอพี",
    desc: "สัมผัสบรรยากาศโต๊ะวีไอพีเสมือนจริง ส่งตรงสัญญาณภาพสดจากคาสิโนชั้นนำ เล่นง่าย จ่ายไว",
    tag: "ภาพสดจากคาสิโน",
    icon: "🃏",
  },
  {
    name: "หวยออนไลน์ รัฐบาล ลาว ฮานอย",
    desc: "รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล หวยลาว หวยฮานอย ให้อัตราจ่ายสูง จ่ายเต็มไม่มีอั้น",
    tag: "จ่ายเต็มไม่มีอั้น",
    icon: "🎫",
  },
  {
    name: "เดิมพันกีฬา มวย และฟุตบอล",
    desc: "อัปเดตราคาค่าน้ำดีที่สุด ครบทุกแมตช์ ทุกลีกดัง ให้คอกีฬาได้ลุ้นมันส์ทุกวินาที",
    tag: "ค่าน้ำดีที่สุด",
    icon: "⚽",
  },
  {
    name: "ฝาก-ถอนอัตโนมัติ 3-5 วินาที",
    desc: "ระบบฝาก-ถอนเงินอัตโนมัติ (Auto) รองรับทุกธนาคารชั้นนำ ทำรายการได้ด้วยตัวเองตลอด 24 ชั่วโมง",
    tag: "ทุกธนาคารชั้นนำ",
    icon: "💳",
  },
  {
    name: "แอดมิน Line Official 24 ชั่วโมง",
    desc: "ทีมงานแอดมินมืออาชีพดูแลสมาชิกอย่างใกล้ชิด ตอบกลับอย่างรวดเร็ว สุภาพ และใส่ใจ ตลอด 24 ชั่วโมง",
    tag: "ดูแลระดับ VIP",
    icon: "🎧",
  },
];
---

<section aria-label="เกมและบริการของ PAOTUNG ที่เปิดให้ใช้งานในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#eef6fd] uppercase">
      เกมและบริการของ PAO<span class="text-[#e0bd72]">TUNG</span> ที่เปิดให้ใช้งานในบัญชีเดียว
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e0bd72] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#226ca9]/65 bg-[#04203c]/92 p-5 shadow-[0_10px_30px_rgba(2,15,30,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#3b9ddd]/80 hover:bg-[#0a325a] hover:shadow-[0_15px_40px_rgba(34,108,169,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#3b9ddd]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#020f1e] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#cfdeed] transition-colors group-hover:text-[#eef6fd]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#cfdeed]/60">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#226ca9]/65 bg-[#020f1e] py-1.5 text-center text-[11px] font-bold text-[#7fc4f0] shadow-inner transition-colors duration-300 group-hover:border-[#e0bd72]/70 group-hover:bg-gradient-to-r group-hover:from-[#f5e3b3] group-hover:via-[#e0bd72] group-hover:to-[#a5813a] group-hover:text-[#020f1e]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
