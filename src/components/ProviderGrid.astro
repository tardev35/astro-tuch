---
// MHEEPOOH168 is a เว็บรวมคาสิโนเกม, so these tiles are the four game categories
// the brief names by hand — บาคาร่า, สล็อต, หวย, บอล — and nothing else. The
// brief lists no provider brand, no game count, no RTP figure, no payout rate
// and no licence number, so no tile states one. Every tile's copy stays inside
// what the brief supports: แต่ละประเภทถูกแยกเป็นเมนูอย่างชัดเจน, สลับรูปแบบการเล่น
// ได้จากบัญชีเดียว, ตัวเลือกจากหลายค่ายและหลายตลาด, และเข้าถึงได้ง่ายทั้งบนมือถือและ
// คอมพิวเตอร์.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "บาคาร่า",
    desc: "หมวดบาคาร่าที่แยกเมนูไว้ชัดเจน เลือกโต๊ะที่ต้องการได้จากบัญชีเดียวกับที่ใช้เล่นหมวดอื่น",
    tag: "แยกเมนูชัดเจน",
    icon: "🃏",
  },
  {
    name: "สล็อต",
    desc: "รวมเกมสล็อตจากหลายค่ายไว้ในหมวดเดียว เข้าถึงได้ง่ายทั้งบนมือถือและคอมพิวเตอร์",
    tag: "หลายค่าย",
    icon: "🎰",
  },
  {
    name: "หวย",
    desc: "หมวดหวยที่เปิดให้เลือกตามรายการซึ่งระบบกำหนดไว้ ตรวจสอบรายการที่เปิดใช้งานได้จากหน้าเกม",
    tag: "เลือกตามหมวด",
    icon: "🔢",
  },
  {
    name: "บอล",
    desc: "หมวดบอลที่รวมตัวเลือกจากหลายตลาด สลับจากหมวดอื่นมาเล่นได้ทันทีโดยไม่ต้องเปลี่ยนเว็บไซต์",
    tag: "หลายตลาด",
    icon: "⚽",
  },
];

// MHEEPOOH168 palette: tiles are the inner-panel red (#2b0101) inside a deep
// gold hairline (#8a5a06) on the page near-black, with the tag chip and the
// hover CTA running the bright -> mid gold gradient and the hover border
// stepping up to mid gold. The previous brand's brown-black and champagne are
// gone.
---

<section aria-label="หมวดเกมที่ MHEEPOOH168 เปิดให้เลือกเล่นจากบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f1dccd] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน MHEEPOOH<span class="text-[#f5b70a]">168</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5b70a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a5a06] bg-[#2b0101]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5b70a]/80 hover:bg-[#540202] hover:shadow-[0_15px_40px_rgba(245,183,10,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#c4161c]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#8a5a06] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#120303] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f1dccd] transition-colors group-hover:text-[#fced74]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f1dccd]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a5a06] bg-[#120303] py-1.5 text-center text-[11px] font-bold text-[#fced74] shadow-inner transition-colors duration-300 group-hover:border-[#f5b70a]/70 group-hover:bg-gradient-to-r group-hover:from-[#fced74] group-hover:via-[#f5b70a] group-hover:to-[#8a5a06] group-hover:text-[#120303]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
