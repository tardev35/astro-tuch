---
import { BRAND_NAME } from "../lib/brandProfile";

// 365LOTTO's brief names its categories outright — "มีให้เลือกตั้งแต่หวย บาคาร่า
// ไพ่ สล็อต ไปจนถึงเกมรูปแบบอื่นอีกหลายประเภท" — so these five tiles are exactly
// that list, in the brief's own order, and nothing else. The brief names no
// provider brand, no game count, no RTP figure and no licence number, so no tile
// states one. The only payout figures in the whole brief are 2 ตัวจ่าย 100 and
// 3 ตัวจ่าย 1,000, which belong to the H3 sections, not to a category tile.
//
// This grid sits under the docx's "โปรเล่นสล็อต 365LOTTO ที่ดีที่สุด" section and
// names the หมวดเกม a member reaches from the same account. The section title is
// a <p>: these tiles are chrome, not a docx heading, so the <section> takes its
// accessible name from aria-label.
const providers = [
  {
    name: "หวย",
    desc: "รัฐบาลไทย ฮานอย และลาวพัฒนา แยกรอบเปิดรับของแต่ละประเภทไว้ชัดเจน",
    tag: "บริการหลัก",
    icon: "🎫",
  },
  {
    name: "บาคาร่า",
    desc: "อยู่ในระบบเดียวกับหวย เลือกหมวดที่สนใจผ่านบัญชีเดียวได้ทันที",
    tag: "บัญชีเดียว",
    icon: "🃏",
  },
  {
    name: "ไพ่",
    desc: "อีกหนึ่งหมวดที่เปิดให้เลือกจากเมนูเดียวกัน เมนูจัดหมวดชัดเจนจึงหาเจอเร็ว",
    tag: "เมนูจัดหมวดชัดเจน",
    icon: "🎴",
  },
  {
    name: "สล็อต",
    desc: "หมวดที่มีโปรโมชั่นสำหรับสมาชิกหลายรูปแบบ ตรวจสอบเงื่อนไขได้ก่อนกดรับ",
    tag: "มีโปรโมชั่น",
    icon: "🎰",
  },
  {
    name: "เกมรูปแบบอื่น",
    desc: "ตามรายการที่เปิดให้บริการ รองรับทั้งมือถือและคอมพิวเตอร์จากบัญชีเดิม",
    tag: "ตามรายการที่เปิด",
    icon: "🎲",
  },
];

// 365LOTTO palette (แดง-ทอง-เงินโครเมียม): แผ่นกระเบื้องเป็นพื้นการ์ด #1a0709 ใน
// เส้นทองลึก #9c6a12 บนพื้นเพจ #120406 ป้ายมุมขวากับปุ่มตอน hover ไล่จากทองสว่าง
// #fdf3b4 ลงทองหลัก #fadc64 ไปจบที่แดงสด #e01f26 ซึ่งเป็นลำดับสีเดียวกับโลโก้ที่
// เลข 365 เป็นทองแล้วคำว่า LOTTO มีวง O สีแดงสองวง กรอบตอน hover ยกขึ้นเป็นทองหลัก
// ชื่อหมวดเป็นทองสว่าง คำอธิบายเป็น BRAND_TEXT #f0ddc4 — ทอง-เงินโครเมียมของ
// SAGAME66 (#e8b93f #ffe9a3 #96671a #171006 #0d0903 #e3d8c0 #eef3f8) ออกทั้งหมด
---

<section aria-label={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือกเล่นในระบบเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#f3f6fa] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#fadc64]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01f26] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#9c6a12] bg-[#1a0709]/92 p-5 shadow-[0_10px_30px_rgba(18,4,6,0.7)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fadc64]/80 hover:bg-[#2a0b0e] hover:shadow-[0_15px_40px_rgba(250,220,100,0.4)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#e01f26]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e01f26] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#120406] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fdf3b4] transition-colors group-hover:text-[#f3f6fa]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f0ddc4]/75">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#9c6a12] bg-[#120406] py-1.5 text-center text-[11px] font-bold text-[#fadc64] shadow-inner transition-colors duration-300 group-hover:border-[#fadc64]/70 group-hover:bg-gradient-to-r group-hover:from-[#fdf3b4] group-hover:via-[#fadc64] group-hover:to-[#e01f26] group-hover:text-[#120406]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
