---
import { BRAND_NAME } from "../lib/brandProfile";

// WY88 is a casino/live-game brand, and its brief names what the menu holds
// rather than a provider list — "เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว",
// "เลือกสล็อต เกมสด หรือหมวดที่ต้องการได้ทันที", "ทางเข้าเล่นรูปแบบ VIP",
// "หน้าหลัก เมนูเกม และระบบสมาชิก ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม" และ
// "รองรับทั้งมือถือและคอมพิวเตอร์" — so these five tiles are exactly that and
// nothing else. The brief names no provider brand, no game count, no RTP figure,
// no payout rate and no licence number, so no tile states one. หวย is NOT one of
// them: this brief never mentions lottery.
//
// This grid belongs to the docx's "ทางเข้าเล่น WY88 ใหม่" section and sits
// directly under it. The section title is a <p>: these tiles are chrome, not a
// docx heading, so the <section> takes its accessible name from aria-label.
const providers = [
  {
    name: "เกมสด",
    desc: "เลือกเกมสดที่สนใจได้จากบัญชีเดียว ไม่ต้องสลับไปเปิดหลายระบบ",
    tag: "บัญชีเดียว",
    icon: "🎥",
  },
  {
    name: "สล็อต",
    desc: "หลังยืนยันบัญชีเรียบร้อย เข้าสู่ระบบแล้วเลือกหมวดสล็อตที่ต้องการได้ทันที",
    tag: "เลือกได้ทันที",
    icon: "🎰",
  },
  {
    name: "ทางเข้ารูปแบบ VIP",
    desc: "ทางเข้าเล่นรูปแบบ VIP จัดองค์ประกอบการใช้งานให้เป็นระเบียบสำหรับยูสไทย",
    tag: "รูปแบบ VIP",
    icon: "👑",
  },
  {
    name: "เมนูเกมอัปเกรดใหม่",
    desc: "หน้าหลัก เมนูเกม และระบบสมาชิกถูกปรับใหม่ ค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิม",
    tag: "สลับหมวดง่าย",
    icon: "🧭",
  },
  {
    name: "รองรับมือถือและคอม",
    desc: "รองรับทั้งมือถือและคอมพิวเตอร์ เข้าถึงเกมผ่านมือถือได้อย่างคล่องตัว",
    tag: "ใช้ได้ทุกจอ",
    icon: "📱",
  },
];

// WY88 palette (ชมพูมาเจนตา-ทอง): แผ่นกระเบื้องเป็นพื้นการ์ดพลัม #24081a ในเส้น
// มาเจนตาเข้ม #a3145a บนพื้นเพจ #170411 ป้ายมุมขวากับปุ่มตอน hover ไล่จากชมพู
// กุหลาบ #f9a8cd ลงมาเจนตาหลัก #ec2b84 ไปจบที่ทองหลัก #e8b33a ซึ่งเป็นคู่สี
// เดียวกับโลโก้ที่ตัว WY เป็นชมพูมาเจนตาและเลข 88 เป็นทอง ส่วนกรอบตอน hover
// ยกขึ้นเป็นมาเจนตาหลัก ชมพู-เหลืองของ ABM96 หายไปทั้งหมด
---

<section aria-label={`หมวดเกมและเมนูที่ ${BRAND_NAME} เปิดให้เลือกใช้งานจากบัญชีเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#fce9f3] uppercase">
      หมวดเกมและเมนูที่เลือกใช้งานได้ใน <span class="text-[#ec2b84]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b33a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#a3145a] bg-[#24081a]/92 p-5 shadow-[0_10px_30px_rgba(23,4,17,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ec2b84]/80 hover:bg-[#170411] hover:shadow-[0_15px_40px_rgba(236,43,132,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#ec2b84]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f9a8cd] via-[#ec2b84] to-[#e8b33a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170411] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fce9f3] transition-colors group-hover:text-[#f9a8cd]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#fce9f3]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a3145a] bg-[#170411] py-1.5 text-center text-[11px] font-bold text-[#e8b33a] shadow-inner transition-colors duration-300 group-hover:border-[#ec2b84]/70 group-hover:bg-gradient-to-r group-hover:from-[#f9a8cd] group-hover:via-[#ec2b84] group-hover:to-[#e8b33a] group-hover:text-[#170411]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
