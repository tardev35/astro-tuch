---
import { BRAND_NAME } from "../lib/brandProfile";

// THE88's brief names its game categories outright — "สมาชิกสามารถเลือกเล่นได้
// ทั้งบาคาร่า สล็อต หวย บอล และไฮโล ผ่านบัญชีเดียว" and "รวมเกมยอดนิยมไว้ครบทั้ง
// บาคาร่า สล็อต หวย บอล และไฮโล โดยแบ่งหมวดหมู่ให้เลือกอย่างชัดเจน" — so these
// five tiles are exactly that list, in the brief's own order, and nothing else.
// The brief names no provider brand, no game count, no RTP figure, no payout
// rate and no licence number, so no tile states one.
//
// This grid belongs to the docx's "เว็บ THE88 บาคาร่า สล็อต หวย บอล ไฮโล …"
// section and sits directly under it. The section title is a <p>: these tiles
// are chrome, not a docx heading, so the <section> takes its accessible name
// from aria-label.
const providers = [
  {
    name: "บาคาร่า",
    desc: "หนึ่งในหมวดเกมยอดนิยมที่เปิดให้เลือกเล่นผ่านบัญชีเดียว",
    tag: "บัญชีเดียว",
    icon: "🃏",
  },
  {
    name: "สล็อต",
    desc: "แบ่งหมวดหมู่ไว้ชัดเจน ตรวจสอบค่ายที่เปิดให้บริการได้ก่อนเข้าเล่น",
    tag: "แบ่งหมวดชัดเจน",
    icon: "🎰",
  },
  {
    name: "หวย",
    desc: "อยู่ในระบบเดียวกับเกมประเภทอื่น เข้าใช้งานจากบัญชีเดิมได้ทันที",
    tag: "ระบบเดียว",
    icon: "🎫",
  },
  {
    name: "บอล",
    desc: "เลือกได้จากเมนูที่จัดหมวดหมู่ชัดเจนและเข้าถึงง่าย",
    tag: "เมนูเข้าถึงง่าย",
    icon: "⚽",
  },
  {
    name: "ไฮโล",
    desc: "รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์ผ่านบัญชีเดียว",
    tag: "ทุกอุปกรณ์",
    icon: "🎲",
  },
];

// THE88 palette (แดง-ทอง): แผ่นกระเบื้องเป็นพื้นการ์ดแดงเข้ม #2d0908 ในเส้นแดง
// เข้ม #6b0302 บนพื้นเพจ #1c0504 ป้ายมุมขวากับปุ่มตอน hover ไล่จากแดงสด #dd0503
// ลงแดงแบรนด์ #a40201 ไปจบที่ทองหลัก #f2c14e ซึ่งเป็นคู่สีเดียวกับโลโก้ที่ตัว THE
// เป็นแดงเงาขอบทองและเลข 88 เป็นครีมขอบทอง ส่วนกรอบตอน hover ยกขึ้นเป็นแดงแบรนด์
// ชมพูมาเจนตา-ทองของ WY88 หายไปทั้งหมด
---

<section aria-label={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือกเล่นผ่านบัญชีเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#f7e3dd] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#f2c14e]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f2c14e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b0302] bg-[#2d0908]/92 p-5 shadow-[0_10px_30px_rgba(28,5,4,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#a40201]/80 hover:bg-[#1c0504] hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#a40201]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#dd0503] via-[#a40201] to-[#f2c14e] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1c0504] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7e3dd] transition-colors group-hover:text-[#ffe7a6]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f7e3dd]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b0302] bg-[#1c0504] py-1.5 text-center text-[11px] font-bold text-[#f2c14e] shadow-inner transition-colors duration-300 group-hover:border-[#a40201]/70 group-hover:bg-gradient-to-r group-hover:from-[#dd0503] group-hover:via-[#a40201] group-hover:to-[#f2c14e] group-hover:text-[#1c0504]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
