---
// The rows come straight from the brief's "DARK168 ดาร์คสล็อต เว็บตรงค่ายหลัก"
// section — เกมยอดนิยม เกมใหม่ สล็อตโบนัส เกมแจ็คพอต, Login เลือกค่ายและค้นหาเกม
// จากบัญชีเดียว, รองรับสมาร์ตโฟน แท็บเล็ต คอมพิวเตอร์ และตรวจสอบกติกา อัตราเดิมพัน
// รายละเอียดของเกมก่อนเริ่มเล่น — so the grid and the paragraph above it never
// contradict each other. DARK168 is a slot brand: no lottery rows here.
const providers = [
  { name: "สล็อตเกมยอดนิยม", desc: "หมวดเกมสล็อตที่สมาชิกเลือกเล่นมากที่สุด ตรวจสอบกติกาและอัตราเดิมพันได้จากหน้ารายละเอียดเกม", tag: "ยอดนิยม", icon: "🎰" },
  { name: "สล็อตเกมใหม่", desc: "รวมเกมสล็อตที่เพิ่งเปิดให้บริการล่าสุด ดูรายชื่อค่ายและเกมที่เพิ่มเข้ามาได้จากในบัญชี", tag: "อัปเดตใหม่", icon: "🆕" },
  { name: "สล็อตโบนัส", desc: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว อ่านรายละเอียดฟีเจอร์และเงื่อนไขของแต่ละเกมก่อนเริ่มหมุน", tag: "มีฟีเจอร์โบนัส", icon: "🎁" },
  { name: "เกมแจ็คพอต", desc: "รวมเกมสล็อตแจ็คพอตหลายรูปแบบ ตรวจสอบรอบการจ่ายและอัตราเดิมพันของแต่ละเกมได้จากระบบ", tag: "แจ็คพอต", icon: "💎" },
  { name: "เว็บตรงค่ายหลัก", desc: "เกมสล็อตจากค่ายหลักรวมไว้ในระบบเดียว Login ครั้งเดียวสลับค่ายและสลับเกมได้ต่อเนื่อง", tag: "บัญชีเดียวครบ", icon: "🏷️" },
  { name: "ค้นหาเกมได้จากบัญชีเดียว", desc: "เลือกค่ายและค้นหาเกมที่ต้องการได้จากหน้าเกมในบัญชีของตนเอง ไม่ต้องเปิดหลายระบบ", tag: "ค้นหาไว", icon: "🔎" },
  { name: "รองรับทุกอุปกรณ์", desc: "เข้าเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ปรับการแสดงผลให้พอดีกับทุกขนาดหน้าจอ", tag: "ครบทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="หมวดเกมสล็อตออนไลน์ที่ DARK168 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e6b74e] via-[#f6dfa4] to-[#c8cfd8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตออนไลน์ที่ <span class="text-[#f6dfa4]">DARK168</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e6b74e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a6320]/35 bg-[#050505]/92 p-5 shadow-[0_10px_30px_rgba(230,183,78,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e6b74e]/60 hover:bg-[#1c170d] hover:shadow-[0_15px_40px_rgba(230,183,78,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e6b74e]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f6dfa4] via-[#e6b74e] to-[#8a6320] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050505] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece3d1] transition-colors group-hover:text-[#f6dfa4]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a89b80]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a6320]/35 bg-[#050505] py-1.5 text-center text-[11px] font-bold text-[#f6dfa4] shadow-inner transition-colors duration-300 group-hover:border-[#e6b74e]/60 group-hover:bg-gradient-to-r group-hover:from-[#f6dfa4] group-hover:via-[#e6b74e] group-hover:to-[#8a6320] group-hover:text-[#050505]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
