---
// The tiles stay inside what the BPLAY639 brief actually states: รวบรวมเกม
// คาสิโนออนไลน์หลายหมวดหมู่ไว้ภายในบัญชีเดียว ทั้งบาคาร่า รูเล็ต เสือมังกร
// แบล็กแจ็ก คาสิโนสด สล็อต และเกมใหม่จากผู้ให้บริการที่เปิดให้ใช้งาน — so this
// grid never claims a game category or a provider name the brief does not have.
// Each tile repeats the brief's own caution: เกมคาสิโนมีผลลัพธ์ที่ไม่แน่นอน จึง
// ไม่มีเกมใดรับประกันการแตกรางวัลหรือกำไรได้ทุกครั้ง.
const providers = [
  { name: "บาคาร่าออนไลน์", desc: "หมวดเกมไพ่ที่สมาชิกเปิดเล่นบ่อย ตรวจสอบกติกาและอัตราเดิมพันของแต่ละโต๊ะได้ก่อนเริ่มเล่น", tag: "เปิดเล่นบ่อย", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ห้องถ่ายทอดสดที่เปิดให้ใช้งาน พร้อมรายละเอียดกติกาและวงเงินเดิมพันให้ดูก่อนเข้าโต๊ะ", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "รูเล็ต", desc: "เลือกรูปแบบการวางเดิมพันได้หลายแบบ ศึกษาอัตราจ่ายและกติกาของวงล้อก่อนลงเดิมพัน", tag: "อ่านกติกาก่อน", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่รอบสั้นที่ตัดสินผลรวดเร็ว ตรวจสอบเงื่อนไขและอัตราจ่ายในหน้าเกมได้โดยตรง", tag: "รอบสั้น", icon: "🐉" },
  { name: "แบล็กแจ็ก", desc: "เกมไพ่ที่มีกติกาการเรียกไพ่เฉพาะตัว ควรศึกษารายละเอียดของโต๊ะก่อนเริ่มเดิมพันทุกครั้ง", tag: "ผลลัพธ์ไม่การันตี", icon: "♠️" },
  { name: "สล็อตและเกมใหม่", desc: "เกมสล็อตและเกมที่เพิ่งเปิดให้บริการ พร้อมข้อมูลฟีเจอร์และเงื่อนไขให้ศึกษาก่อนเข้าเล่น", tag: "อัปเดตต่อเนื่อง", icon: "🎰" },
];
---

<section aria-label="หมวดเกมคาสิโนที่ BPLAY639 เปิดให้ตรวจสอบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4c1d6b] via-[#fdf2f8] to-[#fcd34d] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนที่ <span class="text-[#fdf2f8]">BPLAY639</span> เปิดให้ตรวจสอบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f472b6] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7e22ce]/60 bg-[#150724]/92 p-5 shadow-[0_10px_30px_rgba(10,3,19,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f472b6]/70 hover:bg-[#35134f] hover:shadow-[0_15px_40px_rgba(244,114,182,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#fcd34d]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ec4899] via-[#f472b6] to-[#4c1d6b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#150724] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2e3f7] transition-colors group-hover:text-[#fdf2f8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b79ac9]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7e22ce]/70 bg-[#150724] py-1.5 text-center text-[11px] font-bold text-[#fdf2f8] shadow-inner transition-colors duration-300 group-hover:border-[#f472b6]/70 group-hover:bg-gradient-to-r group-hover:from-[#ec4899] group-hover:via-[#f472b6] group-hover:to-[#4c1d6b] group-hover:text-[#150724]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
