---
const providers = [
  { name: "บาคาร่าห้องสด", desc: "โต๊ะสดหลายค่าย ต่างกันที่ภาษา วงเงิน และความเร็วรอบ", tag: "เกมโต๊ะยอดนิยม", icon: "🎴" },
  { name: "คาสิโนสดครบวงจร", desc: "รูเล็ต เสือมังกร และเกมโต๊ะไลฟ์ เลือกจากวงเงินที่รับได้ก่อน", tag: "ดูจังหวะรอบ", icon: "🎡" },
  { name: "สล็อตหลายค่าย", desc: "ดูเดิมพันเริ่มต้น ความผันผวน และฟีเจอร์โบนัสก่อนลงเครดิต", tag: "เริ่มจากงบจริง", icon: "🎰" },
  { name: "กีฬาและบอลสด", desc: "ตรวจคู่แข่งขัน ตลาด และราคาปัจจุบันให้ครบก่อนส่งบิล", tag: "เช็กราคาก่อนส่ง", icon: "⚽" },
  { name: "เกมยิงปลาและอาร์เคด", desc: "รอบสั้น จบไว เหมาะกับการลองระบบก่อนขยับวงเงิน", tag: "รอบสั้น", icon: "🐟" },
  { name: "รองรับมือถือและคอมพิวเตอร์", desc: "เข้าเล่นผ่านเบราว์เซอร์ได้ทันที ไม่ต้องติดตั้งโปรแกรมเพิ่ม", tag: "ทุกอุปกรณ์", icon: "📱" },
  { name: "ฝากถอนอัตโนมัติ 24 ชม.", desc: "ทำรายการเองได้ตลอดเวลา รองรับบัญชีธนาคารและวอลเลท", tag: "ออโต้ตลอด 24 ชม.", icon: "🏧" },
];
---

<section aria-label="คาสิโนสด สล็อต และหมวดเกมที่ FUN24 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fb923c] via-[#fbe6d8] to-[#ea580c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      คาสิโนสด สล็อต และหมวดเกมที่ <span class="text-[#fb923c]">FUN24</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f97316] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ea580c]/25 bg-[#170a03]/92 p-5 shadow-[0_10px_30px_rgba(234,88,12,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ea580c]/50 hover:bg-[#2a1206]/95 hover:shadow-[0_15px_40px_rgba(234,88,12,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ea580c]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#b45309] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170a03] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fbe6d8] transition-colors group-hover:text-[#fb923c]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#fdba74]/90">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ea580c]/25 bg-[#2a1206] py-1.5 text-center text-[11px] font-bold text-[#fb923c] shadow-inner transition-colors duration-300 group-hover:border-[#ea580c]/50 group-hover:bg-gradient-to-r group-hover:from-[#fb923c] group-hover:via-[#fbe6d8] group-hover:to-[#ea580c] group-hover:text-[#170a03]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
