---
const providers = [
  { name: "บาคาร่าสด", desc: "โต๊ะบาคาร่าถ่ายสดภาพคมชัด เดิมพันได้ทุกรอบแบบเรียลไทม์", tag: "เกมยอดนิยม", icon: "🃏" },
  { name: "รูเล็ต", desc: "หมุนวงล้อรูเล็ตออนไลน์ เลือกแทงได้หลายรูปแบบในโต๊ะเดียว", tag: "คลาสสิก", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่จังหวะไว เข้าใจง่าย เลือกฝั่งเสือหรือมังกรได้ทันที", tag: "จังหวะไว", icon: "🐉" },
  { name: "แบล็กแจ็ก", desc: "ท้าดวลไพ่กับเจ้ามือ นับแต้มให้ใกล้ 21 มากที่สุด", tag: "วัดไหวพริบ", icon: "♠️" },
  { name: "ไฮโล", desc: "เขย่าลูกเต๋าออนไลน์ เลือกแทงสูง-ต่ำได้จากมือถือ", tag: "เล่นง่าย", icon: "🎲" },
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตหลากค่าย หมุนได้ทุกวันในบัญชีเดียว", tag: "หลากหลาย", icon: "🎰" },
  { name: "ฝากถอนอัตโนมัติ 24 ชม.", desc: "ทำรายการฝากถอนเองได้ตลอดเวลาผ่านระบบออโต้", tag: "ออโต้ตลอด 24 ชม.", icon: "🏧" },
];
---

<section aria-label="หมวดหมู่เกมคาสิโนที่ WE168 มีให้เลือกเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4ade80] via-[#e9f7e6] to-[#ec4899] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดหมู่เกมคาสิโนที่ <span class="text-[#ec4899]">WE168</span> มีให้เลือกเล่น
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#22c55e]/25 bg-[#0a1207]/92 p-5 shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#22c55e]/50 hover:bg-[#0a1207] hover:shadow-[0_15px_40px_rgba(34,197,94,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#22c55e]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f9a8d4] via-[#ec4899] to-[#db2777] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#fdeaf4] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e9f7e6] transition-colors group-hover:text-[#4ade80]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#bbf7d0]/90">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#22c55e]/25 bg-[#04120a] py-1.5 text-center text-[11px] font-bold text-[#4ade80] shadow-inner transition-colors duration-300 group-hover:border-[#22c55e]/50 group-hover:bg-gradient-to-r group-hover:from-[#4ade80] group-hover:via-[#e9f7e6] group-hover:to-[#22c55e] group-hover:text-[#04120a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
