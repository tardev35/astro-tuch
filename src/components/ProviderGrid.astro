---
// MEPAY77 is a คาสิโนออนไลน์ brand covering บาคาร่า / สล็อต / หวย / บอล. Every
// tile below stays inside what the brief states: เกมเดิมพันหลักทั้งบาคาร่าออนไลน์
// และคาสิโนสด สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ และการ
// เดิมพันฟุตบอลตามรายการแข่งขัน, การสลับหมวดเกมผ่านบัญชีเดียวโดยไม่ต้องสมัคร
// หลายครั้ง, การตรวจสอบกติกา อัตราจ่าย และวงเงินก่อนยืนยันเดิมพัน, ระบบฝากถอน
// ผ่านวอลเลทหรือธนาคารตามช่องทางที่เปิดรองรับ, และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence, or a guarantee — the brief states
// none of them, and it says outright that no game guarantees a profit.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "บาคาร่าและคาสิโนสด", desc: "บาคาร่าออนไลน์และโต๊ะคาสิโนสดตามที่ระบบเปิดให้บริการ ตรวจกติกาและอัตราจ่ายของโต๊ะได้ก่อนยืนยันเดิมพัน", tag: "ถ่ายทอดสด", icon: "🃏" },
  { name: "สล็อตออนไลน์หลายค่าย", desc: "เลือกเกมสล็อตจากค่ายที่ระบบเปิดให้บริการผ่านบัญชีเดียว ดูรูปแบบการเดิมพันและวงเงินของเกมได้ก่อนเริ่มหมุน", tag: "หลายค่ายในบัญชีเดียว", icon: "🎰" },
  { name: "หวยออนไลน์ตามรอบ", desc: "หวยออนไลน์เปิดรับตามรอบที่ระบบกำหนด ควรตรวจเวลาปิดรับ ประเภทการแทง และอัตราจ่ายของรอบนั้นก่อนส่งโพย", tag: "ตามรอบที่เปิด", icon: "🎱" },
  { name: "เดิมพันฟุตบอล", desc: "เดิมพันฟุตบอลตามรายการแข่งขันที่เปิดให้บริการ ตรวจรูปแบบการเดิมพัน อัตราจ่าย และวงเงินของคู่นั้นก่อนยืนยัน", tag: "ตามรายการแข่ง", icon: "⚽" },
  { name: "ฝากถอนวอลเลทและธนาคาร", desc: "จัดการเครดิตผ่านบัญชีของตนเอง เลือกวอลเลทหรือธนาคารจากช่องทางที่เปิดรองรับ และตรวจสถานะรายการจากมือถือ", tag: "ทำรายการเอง", icon: "💳" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "สอบถามวิธีใช้งาน ขั้นตอนฝากถอน โปรโมชั่น หรือข้อมูลเกมแต่ละหมวดกับแอดมิน MEPAY77 ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมและบริการของ MEPAY77 ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f1e5cd] uppercase">
      หมวดเกมและบริการของ <span class="text-[#fdcc5c]">ME</span><span class="text-[#dfe3e8]">PAY</span><span class="text-[#fdcc5c]">77</span> ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f2ae35] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5c3a08] bg-[#1b1206]/92 p-5 shadow-[0_10px_30px_rgba(10,6,1,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f2ae35]/70 hover:bg-[#241503] hover:shadow-[0_15px_40px_rgba(242,174,53,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#f2ae35]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fdcc5c] via-[#dfe3e8] to-[#f2ae35] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#130c01] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f1e5cd] transition-colors group-hover:text-[#fff6e0]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a08a5c]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a3701c] bg-[#130c01] py-1.5 text-center text-[11px] font-bold text-[#fdcc5c] shadow-inner transition-colors duration-300 group-hover:border-[#dfe3e8]/70 group-hover:bg-gradient-to-r group-hover:from-[#fdcc5c] group-hover:via-[#dfe3e8] group-hover:to-[#f2ae35] group-hover:text-[#130c01]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
