---
// UFA168 is a casino + sportsbook aggregator whose brief covers: รวมเกมเดิมพัน
// ออนไลน์หลายประเภทไว้ในบัญชีเดียว (สล็อต บาคาร่า คาสิโนสด เกมไพ่ กีฬา หวย),
// การตรวจสอบกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนเริ่มเล่น, โปรโมชั่นแนะนำ
// เพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No tile claims a payout figure, an RTP number or a game the brief does not
// state, and no tile links to a lottery route — the หวย category is one of the
// brief's own game headings, not a เว็บหวย section.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ตรวจสอบกติกาและรายละเอียดการจ่ายของแต่ละเกมได้ก่อนเริ่มเดิมพัน", tag: "หลายค่ายในบัญชีเดียว", icon: "🎰" },
  { name: "บาคาร่าและเกมไพ่", desc: "เลือกโต๊ะบาคาร่าและเกมไพ่ที่เปิดให้บริการในระบบ พร้อมอ่านกติกาและรูปแบบการเดิมพันก่อนลงเงินจริง", tag: "อ่านกติกาก่อนเล่น", icon: "🃏" },
  { name: "คาสิโนสด", desc: "หมวดคาสิโนสดที่เลือกโต๊ะและรูปแบบการเดิมพันได้ผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ในบัญชีเดียวกัน", tag: "เล่นได้ทุกอุปกรณ์", icon: "🎲" },
  { name: "กีฬาและหวย", desc: "หมวดกีฬาและหวยที่เปิดให้บริการในระบบ ตรวจสอบอัตราจ่ายและเงื่อนไขของแต่ละรายการก่อนยืนยันการเดิมพัน", tag: "ตรวจอัตราจ่ายก่อน", icon: "⚽" },
  { name: "โปรโมชั่นสมาชิก", desc: "แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ควรอ่านวิธีคำนวณและรอบการรับก่อนกดรับทุกครั้ง", tag: "0.8% และ 0.3%", icon: "🎁" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "ติดต่อแอดมินเพื่อขอคำแนะนำและตรวจสอบรายการสมัคร ฝากถอน หรือโปรโมชั่นได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมและบริการของ UFA168 ที่ตรวจสอบได้ก่อนเลือกเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการของ <span class="text-[#d8dce2]">UFA168</span> ที่ตรวจสอบได้ก่อนเลือกเดิมพัน
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f3db5b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b5316]/70 bg-[#050403]/92 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f3db5b]/70 hover:bg-[#241a08] hover:shadow-[0_15px_40px_rgba(212,175,55,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f3db5b]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050403] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e6dcc2] transition-colors group-hover:text-[#fff3bf]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#bdb08c]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b5316]/80 bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#f3db5b] shadow-inner transition-colors duration-300 group-hover:border-[#f3db5b]/70 group-hover:bg-gradient-to-r group-hover:from-[#fff3bf] group-hover:via-[#f3db5b] group-hover:to-[#a37c14] group-hover:text-[#050403]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
