---
// TTN69 is a สล็อตออโต้เกม brand — NOT a lottery and not a multi-product casino.
// Every tile below stays inside what the brief states: การรวบรวมเกมสล็อตจากหลาย
// ค่ายไว้ให้เลือกตามสไตล์ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่
// จากผู้ให้บริการต่าง ๆ, การสลับค่ายผ่านบัญชีเดียว, ช่วงเดิมพันเริ่มต้นระดับ 1 บาท
// ในบางเกม, ระบบฝากถอนผ่านธนาคารและวอลเลทตามช่องทางที่เปิดรองรับ, และ LINE
// OFFICIAL ที่ติดต่อแอดมินได้ตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence, or a guarantee — the brief says
// คำว่า "แตกง่าย" หรือ "แตกหนัก" รับประกันผลลัพธ์ไม่ได้ เพราะแต่ละเกมมีระบบและ
// ความผันผวนต่างกัน, and that ขั้นต่ำจริงอาจต่างกันตามผู้ให้บริการ.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "เกมสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ ดูช่วงเดิมพันและรูปแบบการจ่ายของเกมได้ก่อนเริ่มหมุนทุกครั้ง", tag: "เลือกตามค่าย", icon: "🎰" },
  { name: "เกมโบนัสในเกมสล็อต", desc: "หมวดเกมที่มีฟีเจอร์โบนัสในตัวเกม เงื่อนไขการเข้าฟีเจอร์เป็นไปตามที่แต่ละเกมกำหนด ควรอ่านกติกาก่อนเริ่มเล่น", tag: "ตามเงื่อนไขเกม", icon: "🎁" },
  { name: "ฟรีสปิน", desc: "รอบฟรีสปินขึ้นกับกติกาของแต่ละเกมและแต่ละค่าย จำนวนรอบและเงื่อนไขที่ได้รับจึงต่างกัน ให้ยึดข้อมูลที่ระบบแสดงในเกมนั้น", tag: "ต่างกันตามเกม", icon: "🔄" },
  { name: "แจ็กพอตและเกมธีมใหม่", desc: "เกมแจ็กพอตและเกมธีมใหม่เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ สลับเกมและสลับค่ายได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง", tag: "หลายแบรนด์ในบัญชีเดียว", icon: "💎" },
  { name: "ฝากถอนธนาคารและวอลเลท", desc: "จัดการเครดิตผ่านบัญชีของตนเอง เลือกธนาคารหรือวอลเลทจากช่องทางที่เปิดรองรับ และตรวจสถานะรายการได้จากมือถือ", tag: "ทำรายการเอง", icon: "💳" },
  { name: "LINE OFFICIAL 24 ชั่วโมง", desc: "สอบถามขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าเกมแต่ละค่ายกับแอดมิน TTN69 ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการของ TTN69 ที่ตรวจสอบได้ก่อนเริ่มเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f1faf4] uppercase">
      หมวดเกมสล็อตและบริการของ <span class="text-[#e4ece7]">TTN</span><span class="text-[#02b961]">69</span> ที่ตรวจสอบได้ก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#02b961] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#046b3a] bg-[#061309]/92 p-5 shadow-[0_10px_30px_rgba(2,8,5,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#02b961]/80 hover:bg-[#0c2214] hover:shadow-[0_15px_40px_rgba(2,185,97,0.30)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#02b961]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#4ce68f] via-[#e4ece7] to-[#02b961] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#020805] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d5e6da] transition-colors group-hover:text-[#f1faf4]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9db0a4]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#046b3a] bg-[#020805] py-1.5 text-center text-[11px] font-bold text-[#4ce68f] shadow-inner transition-colors duration-300 group-hover:border-[#e4ece7]/70 group-hover:bg-gradient-to-r group-hover:from-[#4ce68f] group-hover:via-[#e4ece7] group-hover:to-[#02b961] group-hover:text-[#020805]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
