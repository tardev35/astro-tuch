---
import { BRAND_NAME } from "../lib/brandProfile";

// UFAGOOL's brief names its game categories outright — "ทั้งการเดิมพันกีฬา
// คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ" — so these four tiles
// are exactly that list, in the brief's own order, and nothing else. The brief
// names no provider brand, no game count, no RTP figure, no payout rate and no
// licence number, so no tile states one. It never mentions lottery either, so
// there is no lottery tile here; the previous brand's fifth tile went with it.
//
// This grid belongs to the docx's "UFAGOOL รวมเกมพนันครบทุกประเภท เครือตรงแบรนด์
// ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์" section and sits directly under it. The section
// title is a <p>: these tiles are chrome, not a docx heading, so the <section>
// takes its accessible name from aria-label.
const providers = [
  {
    name: "กีฬา",
    desc: "เลือกการเดิมพันกีฬาได้จากหน้าเดียว ผ่านบัญชีเดียวกับเกมหมวดอื่น",
    tag: "บัญชีเดียว",
    icon: "⚽",
  },
  {
    name: "คาสิโนสด",
    desc: "อยู่ในระบบเดียวกับกีฬาและสล็อต เข้าใช้งานจากบัญชีเดิมได้ทันที",
    tag: "ระบบเดียว",
    icon: "🎴",
  },
  {
    name: "สล็อต",
    desc: "เลือกเกมจากหลายค่ายได้โดยไม่ต้องสลับหลายระบบ",
    tag: "หลายค่าย",
    icon: "🎰",
  },
  {
    name: "เกมรูปแบบอื่น",
    desc: "ตามรายการที่เปิดให้บริการ ตรวจสอบหมวดเกมที่รองรับได้ก่อนเข้าใช้งาน",
    tag: "ตามรายการที่เปิด",
    icon: "🎮",
  },
];

// UFAGOOL palette (แดง-เงินโครเมียม): แผ่นกระเบื้องเป็นพื้นการ์ด #16100f ในเส้นแดง
// ลึก #5e0507 บนพื้นเพจ #0a0708 ป้ายมุมขวากับปุ่มตอน hover ไล่จากแดงสด #ef1f25 ลง
// แดงแบรนด์ #c50d12 ไปจบที่เงินโครเมียม #b8c3cf ซึ่งเป็นลำดับสีเดียวกับโลโก้ที่ตัว
// UFA เป็นแดงเงาวาวแล้ว GOOL เป็นเงินโครเมียม ส่วนกรอบตอน hover ยกขึ้นเป็นแดงแบรนด์
// — แดง-ทอง (#2d0908 #6b0302 #dd0503 #a40201 #f2c14e #1c0504 #f7e3dd #ffe7a6)
// ของแบรนด์ก่อนหน้า (รอบแดง-ทอง) หายไปทั้งหมด
---

<section aria-label={`หมวดเกมที่ ${BRAND_NAME} เปิดให้เลือกเล่นผ่านบัญชีเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#f4f7fa] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#ef1f25]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c50d12] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5e0507] bg-[#16100f]/92 p-5 shadow-[0_10px_30px_rgba(10,7,8,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#c50d12]/80 hover:bg-[#0a0708] hover:shadow-[0_15px_40px_rgba(197,13,18,0.45)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#c50d12]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ef1f25] via-[#c50d12] to-[#b8c3cf] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0a0708] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f4f7fa] transition-colors group-hover:text-[#ef1f25]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#cdd5dd]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5e0507] bg-[#0a0708] py-1.5 text-center text-[11px] font-bold text-[#b8c3cf] shadow-inner transition-colors duration-300 group-hover:border-[#c50d12]/70 group-hover:bg-gradient-to-r group-hover:from-[#ef1f25] group-hover:via-[#c50d12] group-hover:to-[#b8c3cf] group-hover:text-[#0a0708]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
