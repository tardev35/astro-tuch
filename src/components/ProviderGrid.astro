---
// The tiles stay inside what the JADTEM88 brief actually states: รวบรวมเกม
// เดิมพันออนไลน์หลากหลายประเภทไว้ภายในระบบเดียว ทั้งเกมสล็อต บาคาร่า คาสิโนสด
// รูเล็ต เสือมังกร แบล็กแจ็ก และเกมยอดนิยมจากหลายค่าย — so this grid never
// claims a game category or a provider name the brief does not have. Each tile
// repeats the brief's own caution: ผลลัพธ์และรางวัลขึ้นอยู่กับระบบและกติกาของ
// ผู้ให้บริการแต่ละราย ไม่มีรูปแบบการเดิมพันใดรับประกันรางวัลหรือผลกำไรได้.
const providers = [
  { name: "เกมสล็อตจากหลายค่าย", desc: "รวมเกมสล็อตที่เปิดให้บริการไว้ในระบบเดียว ตรวจสอบฟีเจอร์และอัตราเดิมพันของแต่ละเกมได้ก่อนเริ่มเล่น", tag: "รวมค่ายชั้นนำ", icon: "🎰" },
  { name: "บาคาร่าออนไลน์", desc: "หมวดเกมไพ่ที่สมาชิกเปิดเล่นบ่อย ดูกติกาและอัตราเดิมพันของแต่ละโต๊ะได้ก่อนลงเดิมพัน", tag: "เปิดเล่นบ่อย", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ห้องถ่ายทอดสดที่เปิดให้ใช้งาน พร้อมรายละเอียดกติกาและวงเงินเดิมพันให้ดูก่อนเข้าโต๊ะ", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "รูเล็ต", desc: "เลือกรูปแบบการวางเดิมพันได้หลายแบบ ศึกษาอัตราจ่ายและกติกาของวงล้อก่อนลงเดิมพัน", tag: "อ่านกติกาก่อน", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่รอบสั้นที่ตัดสินผลรวดเร็ว ตรวจสอบเงื่อนไขและอัตราจ่ายในหน้าเกมได้โดยตรง", tag: "รอบสั้น", icon: "🐉" },
  { name: "แบล็กแจ็ก", desc: "เกมไพ่ที่มีกติกาการเรียกไพ่เฉพาะตัว ควรศึกษารายละเอียดของโต๊ะก่อนเริ่มเดิมพันทุกครั้ง", tag: "ผลลัพธ์ไม่การันตี", icon: "♠️" },
];
---

<section aria-label="หมวดเกมที่ JADTEM88 เปิดให้ตรวจสอบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#1d4ed8] via-[#f1f5f9] to-[#cbd5e1] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมที่ <span class="text-[#f1f5f9]">JADTEM88</span> เปิดให้ตรวจสอบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3b82f6] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#1d4ed8]/60 bg-[#0a142c]/92 p-5 shadow-[0_10px_30px_rgba(3,6,15,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#3b82f6]/70 hover:bg-[#132447] hover:shadow-[0_15px_40px_rgba(59,130,246,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#cbd5e1]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#2563eb] via-[#3b82f6] to-[#1d4ed8] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#03060f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#cbd5e1] transition-colors group-hover:text-[#f1f5f9]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#93c5fd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#1d4ed8]/70 bg-[#0a142c] py-1.5 text-center text-[11px] font-bold text-[#f1f5f9] shadow-inner transition-colors duration-300 group-hover:border-[#3b82f6]/70 group-hover:bg-gradient-to-r group-hover:from-[#2563eb] group-hover:via-[#3b82f6] group-hover:to-[#1d4ed8] group-hover:text-[#03060f]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
