---
// The rows come straight from the brief's "เข้าเล่น CREEKBET เว็บพนันคาสิโน
// อัตราจ่ายสูง แบรนด์แท้ ไม่จำกัดขั้นต่ำ" section — บาคาร่า รูเล็ต เสือมังกร
// คาสิโนสด สล็อต และเกมเดิมพันอื่น ๆ จัดหมวดหมู่ให้เลือกใช้งานง่ายผ่านบัญชีเดียว
// — so the grid and the paragraph above it never contradict each other. Every
// tile also repeats the brief's own caution: อัตราการจ่าย ยอดเดิมพันขั้นต่ำ และ
// วงเงินต่างกันตามเกมและผู้ให้บริการ ควรตรวจสอบก่อนยืนยันการเดิมพัน.
const providers = [
  { name: "บาคาร่า", desc: "โต๊ะบาคาร่าออนไลน์พร้อมกติกาและรูปแบบการเดิมพันของแต่ละโต๊ะแสดงไว้ในระบบ", tag: "ดูกติกาก่อนลง", icon: "🃏" },
  { name: "รูเล็ต", desc: "หมวดรูเล็ตหลายรูปแบบ อัตราการจ่ายและตัวเลือกการเดิมพันแสดงไว้ในแต่ละโต๊ะ", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมเสือมังกรที่จบรอบไว ควรอ่านกติกาและอัตราการจ่ายของโต๊ะก่อนเริ่มเดิมพัน", tag: "จบรอบไว", icon: "🐯" },
  { name: "คาสิโนสด", desc: "ห้องคาสิโนถ่ายทอดสด เลือกโต๊ะและตรวจสอบเงื่อนไขการเดิมพันได้จากหน้าเกมโดยตรง", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "เกมสล็อต", desc: "หมวดเกมสล็อตหลายรูปแบบ ตรวจสอบกติกาและอัตราการจ่ายของแต่ละเกมได้จากหน้ารายละเอียด", tag: "เลือกได้หลายเกม", icon: "🎰" },
  { name: "เกมเดิมพันอื่น ๆ", desc: "หมวดเกมเดิมพันอื่นที่เปิดให้บริการ ยอดขั้นต่ำและวงเงินแยกตามผู้ให้บริการแต่ละราย", tag: "ดูวงเงินก่อนเล่น", icon: "🎯" },
];
---

<section aria-label="หมวดเกมคาสิโนออนไลน์ที่ CREEKBET เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9aa2ab] via-[#f4f6f8] to-[#c02434] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนออนไลน์ที่ <span class="text-[#f4f6f8]">CREEKBET</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#cfd4da] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5b636b]/50 bg-[#0a0b0d]/92 p-5 shadow-[0_10px_30px_rgba(10,11,13,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#cfd4da]/60 hover:bg-[#1c1f24] hover:shadow-[0_15px_40px_rgba(207,212,218,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#c02434]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#9aa2ab] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0a0b0d] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dfe4ea] transition-colors group-hover:text-[#f4f6f8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#98a0aa]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5b636b]/60 bg-[#0a0b0d] py-1.5 text-center text-[11px] font-bold text-[#f4f6f8] shadow-inner transition-colors duration-300 group-hover:border-[#cfd4da]/60 group-hover:bg-gradient-to-r group-hover:from-[#f4f6f8] group-hover:via-[#cfd4da] group-hover:to-[#9aa2ab] group-hover:text-[#0a0b0d]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
