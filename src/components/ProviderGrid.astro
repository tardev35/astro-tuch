---
const providers = [
  { name: "สล็อตค่ายแท้ดั้งเดิม", desc: "รวมสล็อตลิขสิทธิ์แท้จากหลายค่ายไว้ในบัญชีเดียว", tag: "ครบทุกค่าย", icon: "🎰" },
  { name: "เกมโบนัสและฟรีสปิน", desc: "ดูฟีเจอร์โบนัสและจำนวนฟรีสปินของแต่ละเกมก่อนหมุนจริง", tag: "โบนัสหนัก", icon: "🎁" },
  { name: "เกมแจ็คพอต", desc: "ตรวจกติกาและเงื่อนไขการเข้าถึงแจ็คพอตได้ก่อนเริ่มเดิมพัน", tag: "รางวัลใหญ่", icon: "🏆" },
  { name: "เกมสล็อตยอดนิยม", desc: "เกมที่สมาชิกเลือกเล่นบ่อย ค้นหาและเข้าเล่นได้สะดวก", tag: "เล่นกันเยอะ", icon: "🔥" },
  { name: "เกมใหม่อัปเดตต่อเนื่อง", desc: "มีเกมสล็อตเข้าใหม่เป็นระยะ เลือกตามสไตล์ที่ชอบได้", tag: "อัปเดตใหม่", icon: "🆕" },
  { name: "โบนัสคืนยอดเสีย 0.3%", desc: "ตรวจสอบยอดและรอบเวลาการกดรับสิทธิ์ได้ผ่านระบบสมาชิก", tag: "รับได้ทุกวัน", icon: "💰" },
  { name: "เข้าเล่นผ่านมือถือ 24 ชม.", desc: "รองรับ Android และ iOS เปิดผ่านเบราว์เซอร์ได้ทันที", tag: "ตลอด 24 ชม.", icon: "📱" },
];
---

<section aria-label="หมวดหมู่เกมสล็อตและบริการที่ UFASLOT มีให้เลือกเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5c518] via-[#fff2c3] to-[#d3d3d3] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดหมู่เกมสล็อตที่ <span class="text-[#f5c518]">UFASLOT</span> มีให้เลือกเล่น
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c518] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#b6821d]/35 bg-[#0d0b06]/92 p-5 shadow-[0_10px_30px_rgba(245,197,24,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c518]/60 hover:bg-[#141009] hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f5c518]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff2c3] via-[#f5c518] to-[#b6821d] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2b1c05] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2e6cd] transition-colors group-hover:text-[#f5c518]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9bfa6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#b6821d]/35 bg-[#0a0704] py-1.5 text-center text-[11px] font-bold text-[#f5c518] shadow-inner transition-colors duration-300 group-hover:border-[#f5c518]/60 group-hover:bg-gradient-to-r group-hover:from-[#fff2c3] group-hover:via-[#f5c518] group-hover:to-[#b6821d] group-hover:text-[#2b1c05]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
