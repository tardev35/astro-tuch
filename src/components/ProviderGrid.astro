---
// TIGER88 is a slot brand. Every tile below stays inside what the brief states:
// รวมเกมสล็อตออนไลน์หลากหลายรูปแบบไว้ในระบบเดียว, สล็อตธีมยอดนิยม เกมโบนัส
// ฟรีสปิน และเกมที่รองรับการเดิมพันเริ่มต้นระดับต่ำ, เกมแนะนำ Fortune Tiger /
// Mahjong Ways 2 / Lucky Neko / Wild Bandito, การเลือกจาก RTP ความผันผวน และ
// ขนาดเดิมพันที่เหมาะกับเงินทุน, โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%
// ตามเงื่อนไข และแอดมินที่ให้บริการออนไลน์ตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, an RTP number, a guarantee, or a game the
// brief does not name.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "Fortune Tiger", desc: "สล็อตธีมเสือมงคล หน้าจอเข้าใจง่าย เปิด Paytable ตรวจสัญลักษณ์ ฟีเจอร์ และช่วงเดิมพันได้ก่อนหมุน", tag: "ธีมเสือมงคล", icon: "🐯" },
  { name: "Mahjong Ways 2", desc: "ธีมไพ่นกกระจอก มีระบบ Free Spins และตัวคูณตามกลไกของเกม ควรอ่านเงื่อนไขเข้าสู่รอบโบนัสก่อนเดิมพัน", tag: "Free Spins", icon: "🀄" },
  { name: "Lucky Neko", desc: "ธีมแมวกวักนำโชคแบบญี่ปุ่น มีทั้งรอบปกติและฟีเจอร์โบนัสในเกม ตรวจ Paytable และช่วงเดิมพันก่อนเริ่มเล่น", tag: "ธีมญี่ปุ่น", icon: "🐱" },
  { name: "Wild Bandito", desc: "ธีมเม็กซิกันที่ภาพต่างจากสล็อตเอเชีย พร้อมกลไกโบนัสตามกติกาของเกม เหมาะกับคนอยากสลับบรรยากาศ", tag: "ธีมเม็กซิกัน", icon: "🤠" },
  { name: "โปรโมชั่นสมาชิก", desc: "แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ควรอ่านยอดที่ใช้คำนวณและรอบการรับก่อนกดรับ", tag: "0.8% และ 0.3%", icon: "🎁" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "สอบถามกติกา โปรโมชั่น และตรวจสอบรายการสมัคร ฝากถอน ได้ตลอด 24 ชั่วโมงผ่านระบบออนไลน์", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="เกมสล็อตแนะนำและบริการของ TIGER88 ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#c99a10] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เกมสล็อตแนะนำและบริการของ <span class="text-[#ff2a36]">TIGER88</span> ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdd121] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5e0505]/80 bg-[#070202]/92 p-5 shadow-[0_10px_30px_rgba(7,2,2,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fdd121]/70 hover:bg-[#1c0606] hover:shadow-[0_15px_40px_rgba(253,209,33,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#ef1622]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#c99a10] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#070202] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2e3c9] transition-colors group-hover:text-[#ffe98a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d6bf95]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5e0505] bg-[#070202] py-1.5 text-center text-[11px] font-bold text-[#fdd121] shadow-inner transition-colors duration-300 group-hover:border-[#fdd121]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffe98a] group-hover:via-[#fdd121] group-hover:to-[#c99a10] group-hover:text-[#070202]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
