---
import { BRAND_NAME } from "../lib/brandProfile";

// FAH999 is a สล็อตออโต้ site, so these tiles are the game categories the brief
// names by hand — เกมยอดนิยม, สล็อตโบนัส, เกมฟีเจอร์, เกมแจ็คพอต — and nothing
// else. The brief lists no provider brand, no game count, no RTP figure, no
// payout rate and no licence number, so no tile states one. Every tile's copy
// stays inside what the brief supports: รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว,
// จัดหมวดเกมไว้อย่างชัดเจน, เปิดดูข้อมูลของแต่ละเกมก่อนเลือกเล่น, ตรวจสอบรอบโบนัส
// และระดับเดิมพันได้จากหน้าเกมโดยตรง, และเกมใหม่ที่อัปเดตตามช่วงเวลา
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "เกมยอดนิยม",
    desc: "หมวดเกมยอดนิยมที่แยกไว้ชัดเจน เปิดดูข้อมูลของแต่ละเกมก่อนเลือกเล่นได้จากหน้าเดียว",
    tag: "ติดอันดับมาแรง",
    icon: "🔥",
  },
  {
    name: "สล็อตโบนัส",
    desc: "รวมสล็อตโบนัสจากหลายค่ายไว้ในระบบเดียว ตรวจสอบรายละเอียดของรอบโบนัสได้จากหน้าเกมโดยตรง",
    tag: "หลายค่าย",
    icon: "🎰",
  },
  {
    name: "เกมฟีเจอร์",
    desc: "หมวดเกมฟีเจอร์ที่จัดไว้ให้เลือกตามสไตล์การเล่น พร้อมดูระดับเดิมพันของแต่ละเกมก่อนเข้าเล่น",
    tag: "แยกหมวดชัดเจน",
    icon: "🕹️",
  },
  {
    name: "เกมแจ็คพอต",
    desc: "หมวดเกมแจ็คพอตจากหลายค่าย รวมถึงเกมใหม่ที่อัปเดตตามช่วงเวลาที่ระบบเปิดให้ใช้งาน",
    tag: "อัปเดตต่อเนื่อง",
    icon: "💎",
  },
];

// FAH999 palette (royal purple + gold): tiles are the card base (#180430) inside
// a purple-deep hairline (#4a1188) on the page purple-black, with the tag chip
// and the hover CTA running the bright -> primary gold gradient into purple-mid
// and the hover border stepping up to primary gold. The previous brand's reds
// and its warm golds are gone.
---

<section aria-label={`หมวดเกมสล็อตที่ ${BRAND_NAME} จัดไว้ให้เลือกจากหน้าเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#ecdcff] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#fbbf13]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fbbf13] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#4a1188] bg-[#180430]/92 p-5 shadow-[0_10px_30px_rgba(13,1,25,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fbbf13]/80 hover:bg-[#2a0a4d] hover:shadow-[0_15px_40px_rgba(251,191,19,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#a855f7]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#7c2fd4] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#180430] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ecdcff] transition-colors group-hover:text-[#fef354]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#ecdcff]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#4a1188] bg-[#0d0119] py-1.5 text-center text-[11px] font-bold text-[#ffdf6b] shadow-inner transition-colors duration-300 group-hover:border-[#fbbf13]/70 group-hover:bg-gradient-to-r group-hover:from-[#fef354] group-hover:via-[#fbbf13] group-hover:to-[#7c2fd4] group-hover:text-[#180430]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
