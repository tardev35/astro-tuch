---
// The categories come straight from the brief's §2 list — เกมยอดนิยม เกมใหม่
// เกมโบนัส และสล็อตแจ็คพอต จัดหมวดหมู่ให้ค้นหาง่าย รองรับสมาร์ตโฟน แท็บเล็ต
// และคอมพิวเตอร์ — so the grid and the paragraph above it never contradict
// each other. JAIDEE928 is a slot brand: no lottery or table-game rows here.
const providers = [
  { name: "เกมสล็อตยอดนิยม", desc: "รวมเกมสล็อตที่สมาชิกเลือกเล่นมากที่สุดไว้ในหมวดเดียว ค้นหาและเข้าเล่นได้จากบัญชีเดียว", tag: "ยอดนิยม", icon: "🎰" },
  { name: "เกมสล็อตใหม่", desc: "อัปเดตเกมใหม่จากหลายค่ายเข้าระบบต่อเนื่อง พร้อมรายละเอียดฟีเจอร์ให้อ่านก่อนเริ่มเล่น", tag: "อัปเดตต่อเนื่อง", icon: "✨" },
  { name: "เกมโบนัส", desc: "หมวดเกมที่มีฟีเจอร์โบนัสและฟรีสปิน ตรวจสอบกติกาและเงื่อนไขของแต่ละเกมก่อนหมุน", tag: "มีฟีเจอร์โบนัส", icon: "🎁" },
  { name: "สล็อตแจ็คพอต", desc: "เกมที่สะสมรางวัลแจ็คพอตตามเงื่อนไขของเกม ดูอัตราจ่ายได้จากหน้ารายละเอียดเกม", tag: "รางวัลสะสม", icon: "💎" },
  { name: "ค่ายเกมครบทุกแบรนด์", desc: "เลือกเกมตามค่ายผู้ให้บริการที่เปิดอยู่ในระบบ ใช้บัญชีเดียวเข้าเล่นได้ทุกค่าย", tag: "บัญชีเดียวครบ", icon: "🏷️" },
  { name: "เล่นผ่านมือถือ", desc: "รองรับสมาร์ตโฟนและแท็บเล็ตผ่านเบราว์เซอร์ ปรับการแสดงผลให้พอดีทุกขนาดหน้าจอ", tag: "ไม่ต้องติดตั้ง", icon: "📱" },
  { name: "เลือกตามอัตราเดิมพัน", desc: "ตรวจสอบอัตราเดิมพันและฟีเจอร์ของแต่ละเกม เพื่อเลือกให้เหมาะกับรูปแบบการเล่นของตนเอง", tag: "ดูก่อนเริ่มเล่น", icon: "🎯" },
];
---

<section aria-label="หมวดเกมสล็อตออนไลน์ที่ JAIDEE928 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a855f7] via-[#d8a7ff] to-[#e6e8ec] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตออนไลน์ที่ <span class="text-[#d8a7ff]">JAIDEE928</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a855f7] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#4c1095]/35 bg-[#060210]/92 p-5 shadow-[0_10px_30px_rgba(168,85,247,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#a855f7]/60 hover:bg-[#1c0b2a] hover:shadow-[0_15px_40px_rgba(168,85,247,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#a855f7]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#d8a7ff] via-[#a855f7] to-[#4c1095] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#060210] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e4d9f5] transition-colors group-hover:text-[#d8a7ff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a897c4]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#4c1095]/35 bg-[#060210] py-1.5 text-center text-[11px] font-bold text-[#d8a7ff] shadow-inner transition-colors duration-300 group-hover:border-[#a855f7]/60 group-hover:bg-gradient-to-r group-hover:from-[#d8a7ff] group-hover:via-[#a855f7] group-hover:to-[#4c1095] group-hover:text-[#060210]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
