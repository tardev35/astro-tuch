---
// HERO1688 is a สล็อตออโต้เว็บตรง brand — NOT a lottery and not a multi-product
// casino. Every tile below stays inside what the brief states: การรวบรวมเกม
// สล็อตจากหลายผู้ให้บริการไว้เป็นหมวดหมู่ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และ
// เกมรูปแบบใหม่ตามที่แต่ละค่ายเปิดให้บริการ, การค้นหาเกมและสลับค่ายผ่านบัญชีเดียว,
// การเข้าเล่นผ่านเว็บเบราว์เซอร์บนอุปกรณ์หลากหลายประเภท, ระบบฝากถอนที่รองรับ
// วอลเลทและบัญชีธนาคารตามช่องทางที่เปิดรองรับ, และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence, or a guarantee — the brief says
// ผลลัพธ์ของเกมสล็อตเป็นไปตามระบบของแต่ละเกม จึงรับประกันไม่ได้ว่าเกมใดจะแตกไว,
// and that "ค่ายแท้" / "ไม่ผ่านเว็บตัวแทน" ต้องมีข้อมูลที่ตรวจสอบได้บนเว็บไซต์.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "เกมสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ ดูช่วงเดิมพันและรูปแบบการจ่ายของเกมได้ก่อนเริ่มหมุนทุกครั้ง", tag: "เลือกตามค่าย", icon: "🎰" },
  { name: "เกมโบนัสในเกมสล็อต", desc: "หมวดเกมที่มีฟีเจอร์โบนัสในตัวเกม เงื่อนไขการเข้าฟีเจอร์เป็นไปตามที่แต่ละเกมกำหนด ควรอ่านกติกาก่อนเริ่มเล่น", tag: "ตามเงื่อนไขเกม", icon: "🎁" },
  { name: "ฟรีสปิน", desc: "รอบฟรีสปินขึ้นกับกติกาของแต่ละเกมและแต่ละค่าย จำนวนรอบและเงื่อนไขที่ได้รับจึงต่างกัน ให้ยึดข้อมูลที่ระบบแสดงในเกมนั้น", tag: "ต่างกันตามเกม", icon: "🔄" },
  { name: "เกมสล็อตรูปแบบใหม่", desc: "เกมรูปแบบใหม่เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ สลับเกมและสลับค่ายได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง", tag: "หลายค่ายในบัญชีเดียว", icon: "🌌" },
  { name: "ฝากถอนวอลเลทและธนาคาร", desc: "จัดการเครดิตผ่านบัญชีของตนเอง เลือกวอลเลทหรือธนาคารจากช่องทางที่เปิดรองรับ และตรวจสถานะรายการจากมือถือ", tag: "ทำรายการเอง", icon: "💳" },
  { name: "แอดมินดูแล 24 ชั่วโมง", desc: "สอบถามขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าเกมแต่ละค่ายกับแอดมิน HERO1688 ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการของ HERO1688 ที่ตรวจสอบได้ก่อนเริ่มเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f4f7fb] uppercase">
      หมวดเกมสล็อตและบริการของ <span class="text-[#ff5a5d]">HERO</span><span class="text-[#c4c5ca]">1688</span> ที่ตรวจสอบได้ก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e11015] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7d0507] bg-[#080a12]/92 p-5 shadow-[0_10px_30px_rgba(1,2,7,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e11015]/80 hover:bg-[#1a0509] hover:shadow-[0_15px_40px_rgba(225,16,21,0.30)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#e11015]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff5a5d] via-[#e3e7ec] to-[#e11015] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#010207] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dbe1ea] transition-colors group-hover:text-[#f4f7fb]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a9b2c0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7d0507] bg-[#010207] py-1.5 text-center text-[11px] font-bold text-[#ff5a5d] shadow-inner transition-colors duration-300 group-hover:border-[#e3e7ec]/70 group-hover:bg-gradient-to-r group-hover:from-[#ff5a5d] group-hover:via-[#e3e7ec] group-hover:to-[#e11015] group-hover:text-[#010207]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
