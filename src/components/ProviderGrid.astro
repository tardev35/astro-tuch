---
// FAH999 is a slot/casino brand whose brief covers: จุดรวมเกมสล็อตออนไลน์ที่เล่นผ่าน
// มือถือและคอมพิวเตอร์, สล็อตธีมเอเชียและเกมโบนัส, สามเกมของ PG SOFT (Mahjong Ways 2,
// Fortune Tiger, Lucky Neko) พร้อมฟีเจอร์ตามที่ระบุ, ระบบฝากถอนและการจัดการบัญชี
// ออนไลน์, โบนัส 0.8% ตามเงื่อนไขของกิจกรรม และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// No tile claims a payout figure, an RTP number or a lottery product the brief
// does not state — this is not a หวย site.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตหลากหลายรูปแบบ ทั้งธีมเอเชีย เกมโบนัส และเกมที่ออกแบบมาให้เล่นบนมือถือ", tag: "เล่นได้ทุกวัน", icon: "🎰" },
  { name: "Mahjong Ways 2", desc: "สล็อตธีมไพ่นกกระจอกของ PG SOFT รูปแบบ 5 รีล พร้อมฟีเจอร์ Wild และ Free Spins ที่ตัวคูณเพิ่มขึ้นตามรูปแบบของเกม", tag: "ฟรีสปิน + ตัวคูณ", icon: "🀄" },
  { name: "Fortune Tiger", desc: "ธีมเสือทองและสัญลักษณ์มงคล รูปแบบ 3 รีล 3 แถว มีฟีเจอร์ Respin และตัวคูณ x10 ตามเงื่อนไขของเกม", tag: "3 รีล เข้าใจง่าย", icon: "🐯" },
  { name: "Lucky Neko", desc: "สล็อตธีมญี่ปุ่นแมวกวักนำโชค มีระบบ Free Spins และตัวคูณภายในเกม ตรวจรายละเอียด RTP ได้ก่อนเลือกเดิมพัน", tag: "ธีมมงคลญี่ปุ่น", icon: "🐱" },
  { name: "โบนัส 0.8%", desc: "โปรโมชั่นหลักตามข้อมูลที่กำหนดคือโบนัส 0.8% ควรอ่านรอบคำนวณและข้อกำหนดการถอนก่อนกดรับทุกครั้ง", tag: "รับได้ทุกวัน", icon: "🎁" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "ติดต่อแอดมินเพื่อขอคำแนะนำและตรวจสอบรายการฝากถอนได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="เกมและบริการของ FAH999 ที่ตรวจสอบได้ก่อนเลือกเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fb44b3] via-[#ffb3e2] to-[#c2249b] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เกมและบริการของ <span class="text-[#fdeaf8]">FAH999</span> ที่ตรวจสอบได้ก่อนเลือกเดิมพัน
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb44b3] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b1fa8]/70 bg-[#0d0114]/92 p-5 shadow-[0_10px_30px_rgba(13,1,20,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fb44b3]/70 hover:bg-[#2a0640] hover:shadow-[0_15px_40px_rgba(194,36,155,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e6cfe9]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffb3e2] via-[#fb44b3] to-[#c2249b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0d0114] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e6cfe9] transition-colors group-hover:text-[#fdeaf8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c98cff]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b1fa8]/80 bg-[#0d0114] py-1.5 text-center text-[11px] font-bold text-[#fdeaf8] shadow-inner transition-colors duration-300 group-hover:border-[#fb44b3]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffb3e2] group-hover:via-[#fb44b3] group-hover:to-[#c2249b] group-hover:text-[#0d0114]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
