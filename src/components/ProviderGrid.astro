---
// The tiles stay inside what the CAMPING289 brief actually states: เกมสล็อต
// หลากหลายรูปแบบให้เลือก พร้อมข้อมูลเกี่ยวกับกติกา ฟีเจอร์ และแนวทางการบริหาร
// งบประมาณสำหรับผู้เล่น — so this grid never claims a game category or a
// provider name the brief does not have. Each tile repeats the brief's own
// caution: เทคนิคต่าง ๆ ใช้เป็นข้อมูลประกอบการเล่นเท่านั้น ไม่สามารถรับประกัน
// ผลกำไรได้.
const providers = [
  { name: "เกมสล็อตยอดนิยม", desc: "หมวดเกมที่สมาชิกเปิดเล่นบ่อย ตรวจสอบกติกาและฟีเจอร์ของแต่ละเกมได้ก่อนเริ่มเดิมพัน", tag: "เปิดเล่นบ่อย", icon: "🎰" },
  { name: "เกมใหม่ล่าสุด", desc: "เกมที่เพิ่งเปิดให้บริการ พร้อมรายละเอียดฟีเจอร์และเงื่อนไขให้ศึกษาก่อนเข้าเล่น", tag: "อัปเดตต่อเนื่อง", icon: "🆕" },
  { name: "เกมที่มีฟีเจอร์โบนัส", desc: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว เงื่อนไขการเข้าฟีเจอร์แสดงไว้ในหน้าเกมแต่ละเกม", tag: "อ่านเงื่อนไขก่อน", icon: "🎁" },
  { name: "สล็อตแจ็คพอต", desc: "เกมที่มีรางวัลแจ็คพอต ควรศึกษากติกาและอัตราเดิมพันของเกมก่อนลงเดิมพันทุกครั้ง", tag: "ผลลัพธ์ไม่การันตี", icon: "💎" },
  { name: "คู่มือกติกาและเทคนิค", desc: "ข้อมูลวิธีอ่านกติกา การทำความเข้าใจฟีเจอร์ การเลือกขนาดเดิมพัน และการกำหนดงบประมาณ", tag: "ใช้ประกอบการเล่น", icon: "📘" },
  { name: "ค้นหาเกมในระบบ", desc: "ค้นหาเกมตามชื่อหรือหมวดหมู่ และเปิดดูรายละเอียดของเกมได้ก่อนเข้าเล่นจริง", tag: "ดูก่อนเข้าเล่น", icon: "🔍" },
];
---

<section aria-label="หมวดเกมสล็อตและข้อมูลที่ CAMPING289 เปิดให้ตรวจสอบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#0b5232] via-[#eefae4] to-[#dbaa8a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตและข้อมูลที่ <span class="text-[#eefae4]">CAMPING289</span> เปิดให้ตรวจสอบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#69b522] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#2f7a2a]/60 bg-[#04120a]/92 p-5 shadow-[0_10px_30px_rgba(2,10,5,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#69b522]/70 hover:bg-[#0a2c18] hover:shadow-[0_15px_40px_rgba(105,181,34,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#dbaa8a]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#9ada4e] via-[#69b522] to-[#0b5232] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04120a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d6e6cc] transition-colors group-hover:text-[#eefae4]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a9c49a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#2f7a2a]/70 bg-[#04120a] py-1.5 text-center text-[11px] font-bold text-[#eefae4] shadow-inner transition-colors duration-300 group-hover:border-[#69b522]/70 group-hover:bg-gradient-to-r group-hover:from-[#9ada4e] group-hover:via-[#69b522] group-hover:to-[#0b5232] group-hover:text-[#04120a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
