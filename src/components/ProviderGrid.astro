---
const providers = [
  { name: "คาสิโนสด", desc: "ห้องถ่ายทอดสดจากดีลเลอร์จริง เลือกโต๊ะและวงเงินที่เปิดให้บริการได้เอง", tag: "ถ่ายทอดสด", icon: "🃏" },
  { name: "บาคาร่า", desc: "เลือกห้องที่เปิดอยู่ ตรวจสอบวงเงินและเงื่อนไขก่อนวางเดิมพันทุกครั้ง", tag: "ยอดนิยม", icon: "🀄" },
  { name: "รูเล็ต", desc: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดงได้ก่อนยืนยัน", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่ใบเดียวรู้ผลไว เหมาะกับสมาชิกที่ต้องการรอบการเล่นสั้น", tag: "รู้ผลไว", icon: "🐯" },
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตหลายรูปแบบ พร้อมอัปเดตเกมใหม่เข้าระบบอย่างต่อเนื่อง", tag: "อัปเดตเกมใหม่", icon: "🎰" },
  { name: "เกมยิงปลาและมินิเกม", desc: "หมวดเกมเดิมพันเบา ๆ เข้าเล่นได้จากบัญชีเดียวกับหมวดอื่น", tag: "เล่นง่าย", icon: "🐟" },
  { name: "รวมค่ายเกมชั้นนำ", desc: "PG SOFT · Pragmatic Play · Joker · Evolution · SA Gaming · Sexy Baccarat ตามค่ายที่เปิดให้บริการ", tag: "ครบทุกค่าย", icon: "🏆" },
];
---

<section aria-label="หมวดเกมคาสิโนที่ SUPERWIN9 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5333c] via-[#ebbb4a] to-[#fbe289] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนที่ <span class="text-[#ebbb4a]">SUPERWIN9</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebbb4a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7a0d10]/35 bg-[#0a0202]/92 p-5 shadow-[0_10px_30px_rgba(200,17,24,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ebbb4a]/60 hover:bg-[#170405] hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#c81118]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbe289] via-[#ebbb4a] to-[#c81118] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2a0a02] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#efe3d2] transition-colors group-hover:text-[#ebbb4a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9b489]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7a0d10]/35 bg-[#0a0202] py-1.5 text-center text-[11px] font-bold text-[#ebbb4a] shadow-inner transition-colors duration-300 group-hover:border-[#ebbb4a]/60 group-hover:bg-gradient-to-r group-hover:from-[#fbe289] group-hover:via-[#ebbb4a] group-hover:to-[#c81118] group-hover:text-[#2a0a02]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
