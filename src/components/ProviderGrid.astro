---
// The rows come straight from the brief's "คาสิโนออนไลน์เว็บตรง HONGHAO
// รวมเกมค่ายดังครบวงจร" section — บาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก
// สล็อต และเกมเดิมพันประเภทอื่น ๆ จัดหมวดหมู่ให้ค้นหาได้ง่ายภายในบัญชีเดียว —
// so the grid and the paragraph above it never contradict each other. Every
// tile also repeats the brief's own caution: ควรตรวจสอบกติกา อัตราการจ่าย และ
// เงื่อนไขของแต่ละเกม เพราะรายละเอียดต่างกันตามค่ายและประเภทการเดิมพัน.
const providers = [
  { name: "บาคาร่า", desc: "โต๊ะบาคาร่าออนไลน์พร้อมกติกาและรูปแบบการเดิมพันของแต่ละโต๊ะแสดงไว้ในระบบ", tag: "ดูกติกาก่อนลง", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ห้องคาสิโนถ่ายทอดสด เลือกโต๊ะและตรวจสอบเงื่อนไขการเดิมพันได้จากหน้าเกมโดยตรง", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "รูเล็ต", desc: "หมวดรูเล็ตหลายรูปแบบ อัตราการจ่ายและตัวเลือกการเดิมพันแสดงไว้ในแต่ละโต๊ะ", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมเสือมังกรที่จบรอบไว ควรอ่านกติกาและอัตราการจ่ายของโต๊ะก่อนเริ่มเดิมพัน", tag: "จบรอบไว", icon: "🐯" },
  { name: "แบล็กแจ็ก", desc: "โต๊ะแบล็กแจ็กพร้อมกติกาการเรียกไพ่และเงื่อนไขการจ่ายของแต่ละโต๊ะในระบบ", tag: "อ่านกติกาก่อนเล่น", icon: "♠️" },
  { name: "เกมสล็อต", desc: "หมวดเกมสล็อตจากหลายค่าย ตรวจสอบกติกาและอัตราการจ่ายได้จากหน้ารายละเอียดของแต่ละเกม", tag: "รวมค่ายดัง", icon: "🎰" },
];
---

<section aria-label="หมวดเกมคาสิโนออนไลน์ที่ HONGHAO เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#2f6a0c] via-[#f2f8ec] to-[#d9b95c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนออนไลน์ที่ <span class="text-[#f2f8ec]">HONGHAO</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#62ae2d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#3f6b23]/60 bg-[#060a04]/92 p-5 shadow-[0_10px_30px_rgba(4,8,3,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#62ae2d]/70 hover:bg-[#1a2c0d] hover:shadow-[0_15px_40px_rgba(98,174,45,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#d9b95c]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#060a04] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dbe5d3] transition-colors group-hover:text-[#f2f8ec]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a9bd9c]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#3f6b23]/70 bg-[#060a04] py-1.5 text-center text-[11px] font-bold text-[#f2f8ec] shadow-inner transition-colors duration-300 group-hover:border-[#62ae2d]/70 group-hover:bg-gradient-to-r group-hover:from-[#a8e37c] group-hover:via-[#62ae2d] group-hover:to-[#2f6a0c] group-hover:text-[#060a04]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
