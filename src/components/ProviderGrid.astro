---
// WIN8S is a สล็อตออนไลน์ เว็บตรง brand — NOT a lottery or a multi-product
// casino. Every tile below stays inside what the brief states: หมวดสล็อตจาก
// หลายค่ายทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ,
// การเลือกเกมและปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด, การเล่นผ่านมือถือ
// โดยไม่ต้องติดตั้งหลายระบบ, การ Login เพื่อตรวจสอบโปรโมชั่นที่มีสิทธิ์รับ,
// ระบบวอลเลทและธนาคารตามช่องทางที่เปิดรองรับ, และทีมงานที่ช่วยเหลือตลอด
// 24 ชั่วโมง. No tile quotes a payout figure, a licence, or a guarantee — the
// brief says the 1-บาท minimum and the "ไม่มีขั้นต่ำ" wording must be checked
// against what each game and the system actually show.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "เกมสล็อตรูปแบบคลาสสิกจากค่ายที่ระบบเปิดให้บริการ ดูช่วงเดิมพันและรูปแบบการจ่ายของเกมได้ก่อนเริ่มหมุนทุกครั้ง", tag: "เลือกตามค่าย", icon: "🎰" },
  { name: "สล็อตวิดีโอ", desc: "สล็อตวิดีโอหลายรูปแบบพร้อมฟีเจอร์ในเกม เลือกเกมและปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนดไว้", tag: "ปรับเดิมพันได้", icon: "🕹️" },
  { name: "เกมโบนัสและฟรีสปิน", desc: "หมวดเกมโบนัสและฟรีสปินตามเงื่อนไขที่แต่ละเกมกำหนด ควรอ่านกติกาของฟีเจอร์ในเกมก่อนเริ่มเล่น", tag: "ตามเงื่อนไขเกม", icon: "🎁" },
  { name: "สล็อตเกมธีมต่าง ๆ", desc: "จัดหมวดเกมสล็อตตามธีมให้เลือกตามรูปแบบที่สนใจ สลับเกมและสลับค่ายได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง", tag: "หลายค่ายในบัญชีเดียว", icon: "🌌" },
  { name: "ฝากถอนวอลเลทและธนาคาร", desc: "จัดการเครดิตผ่านบัญชีของตนเอง เลือกวอลเลทหรือธนาคารจากช่องทางที่เปิดรองรับ และตรวจสถานะรายการจากมือถือ", tag: "ทำรายการเอง", icon: "💳" },
  { name: "ทีมงานดูแล 24 ชั่วโมง", desc: "สอบถามขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าเกมแต่ละค่ายกับทีมงาน WIN8S ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการของ WIN8S ที่ตรวจสอบได้ก่อนเริ่มเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f6e4d6] uppercase">
      หมวดเกมสล็อตและบริการของ <span class="text-[#f36403]">WIN</span><span class="text-[#e3e7ec]">8S</span> ที่ตรวจสอบได้ก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f36403] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a3103] bg-[#1c0a02]/92 p-5 shadow-[0_10px_30px_rgba(5,2,1,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f36403]/80 hover:bg-[#2a0f03] hover:shadow-[0_15px_40px_rgba(243,100,3,0.30)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#f36403]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fd9a1e] via-[#e3e7ec] to-[#f36403] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#140300] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f6e4d6] transition-colors group-hover:text-[#fff2e6]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9aa3ad]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a3103] bg-[#140300] py-1.5 text-center text-[11px] font-bold text-[#fd9a1e] shadow-inner transition-colors duration-300 group-hover:border-[#e3e7ec]/70 group-hover:bg-gradient-to-r group-hover:from-[#fd9a1e] group-hover:via-[#e3e7ec] group-hover:to-[#f36403] group-hover:text-[#140300]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
