---
// The categories come straight from the brief's §2 list — สล็อต บาคาร่า
// คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ หวย — so the grid and the paragraph above it
// never contradict each other.
const providers = [
  { name: "เกมสล็อต", desc: "รวมเกมสล็อตหลายรูปแบบไว้ในบัญชีเดียว พร้อมอัปเดตเกมใหม่เข้าระบบต่อเนื่อง", tag: "อัปเดตเกมใหม่", icon: "🎰" },
  { name: "บาคาร่า", desc: "เลือกห้องที่เปิดอยู่ ตรวจสอบวงเงินและเงื่อนไขก่อนวางเดิมพันทุกครั้ง", tag: "ยอดนิยม", icon: "🀄" },
  { name: "คาสิโนสด", desc: "ห้องถ่ายทอดสดจากดีลเลอร์จริง เลือกโต๊ะและวงเงินที่เปิดให้บริการได้เอง", tag: "ถ่ายทอดสด", icon: "🃏" },
  { name: "รูเล็ต", desc: "วางเดิมพันตามช่องที่เปิดรับ ดูรอบและอัตราจ่ายที่ระบบแสดงได้ก่อนยืนยัน", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่ใบเดียวรู้ผลไว เหมาะกับสมาชิกที่ต้องการรอบการเล่นสั้น", tag: "รู้ผลไว", icon: "🐯" },
  { name: "เกมไพ่", desc: "เกมไพ่หลายชนิดในหมวดเดียวกัน ตรวจสอบกติกาและอัตราจ่ายของแต่ละโต๊ะก่อนเริ่ม", tag: "ดูกติกาก่อนเล่น", icon: "🎴" },
  { name: "หวย", desc: "เลือกประเภทหวยที่เปิดรับตามรอบที่ระบบกำหนด พร้อมดูอัตราจ่ายก่อนยืนยันโพย", tag: "ตามรอบที่เปิดรับ", icon: "🎫" },
];
---

<section aria-label="หมวดเกมพนันออนไลน์ที่ UFA99 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#25cb0e] via-[#6ef25a] to-[#f0f7ee] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมพนันออนไลน์ที่ <span class="text-[#6ef25a]">UFA99</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#25cb0e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0b7a06]/35 bg-[#010301]/92 p-5 shadow-[0_10px_30px_rgba(37,203,14,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#25cb0e]/60 hover:bg-[#052008] hover:shadow-[0_15px_40px_rgba(37,203,14,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#25cb0e]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#6ef25a] via-[#25cb0e] to-[#0b7a06] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#031204] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d5e8d0] transition-colors group-hover:text-[#6ef25a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#8fb08a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0b7a06]/35 bg-[#010301] py-1.5 text-center text-[11px] font-bold text-[#6ef25a] shadow-inner transition-colors duration-300 group-hover:border-[#25cb0e]/60 group-hover:bg-gradient-to-r group-hover:from-[#6ef25a] group-hover:via-[#25cb0e] group-hover:to-[#0b7a06] group-hover:text-[#031204]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
