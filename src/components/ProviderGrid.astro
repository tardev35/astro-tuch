---
// GODBET88 is a เว็บสล็อตไม่ติดเทิร์น, so these tiles are the game providers the
// brief names by hand — PG SLOT, Pragmatic Play, Joker Gaming, JILI — and
// nothing else. `Joker Gaming` here is a provider the docx lists, not this
// site's identity. Every tile's copy stays inside what the brief supports:
// เกมสล็อตลิขสิทธิ์แท้, เริ่มต้นเดิมพันเพียง 1 บาท, ฝาก-ถอนไม่มีขั้นต่ำ, และ
// ถอนได้ทุกยอดโดยไม่ต้องทำยอดเทิร์นโอเวอร์. No tile quotes an RTP figure, a
// payout rate, a licence number or a game count — the brief states none of those.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "PG SLOT",
    desc: "เกมสล็อตลิขสิทธิ์แท้จากค่าย PG SLOT เริ่มต้นเดิมพันเพียง 1 บาท เล่นได้ทุกเกมในค่ายจากบัญชีเดียว",
    tag: "ลิขสิทธิ์แท้",
    icon: "🎰",
  },
  {
    name: "Pragmatic Play",
    desc: "รวมเกมสล็อตค่าย Pragmatic Play ไว้ครบ ปั่นได้ทั้งวันโดยไม่ต้องทำยอดเทิร์นโอเวอร์",
    tag: "ไม่ติดเทิร์น",
    icon: "🕹️",
  },
  {
    name: "Joker Gaming",
    desc: "เกมสล็อตจากค่าย Joker Gaming เข้าเล่นได้ทันทีหลังสมัคร ทุนน้อยก็ฝากเข้ามาเล่นได้",
    tag: "เริ่มต้น 1 บาท",
    icon: "🃏",
  },
  {
    name: "JILI",
    desc: "เกมสล็อตค่าย JILI พร้อมระบบฝาก-ถอนไม่มีขั้นต่ำ แจ็คพอตแตกแล้วถอนได้ทุกยอดเต็มจำนวน",
    tag: "ไม่มีขั้นต่ำ",
    icon: "🎴",
  },
];

// GODBET88 palette: tiles are the raised brown-black (#161208) inside a deep
// gold hairline (#9a7f3f) on the page black, with the tag chip and the hover
// CTA running the sheen -> primary gold gradient. One hue only — the previous
// brand's crimson and graphite greys are gone.
---

<section aria-label="ค่ายเกมสล็อตลิขสิทธิ์แท้ที่ GODBET88 เปิดให้เล่นครบในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#ece1cc] uppercase">
      ค่ายเกมสล็อตลิขสิทธิ์แท้ที่เล่นได้ครบใน GODBET<span class="text-[#c2a55c]">88</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c2a55c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#9a7f3f] bg-[#161208]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#c2a55c]/80 hover:bg-[#0a0806] hover:shadow-[0_15px_40px_rgba(194,165,92,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#c2a55c]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050403] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece1cc] transition-colors group-hover:text-[#f6e7b8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b9ad98]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#9a7f3f] bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#e2c87f] shadow-inner transition-colors duration-300 group-hover:border-[#c2a55c]/70 group-hover:bg-gradient-to-r group-hover:from-[#f6e7b8] group-hover:via-[#e2c87f] group-hover:to-[#c2a55c] group-hover:text-[#050403]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
