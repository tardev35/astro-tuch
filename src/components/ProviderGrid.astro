---
// The rows come straight from the brief's "รวมค่ายเกมฮิตสุดมันส์ครบทุกแบรนด์"
// section — เกมยอดนิยม เกมใหม่ เกมโบนัส สล็อตแจ็คพอต จัดหมวดหมู่ให้ค้นหาง่าย
// รองรับสมาร์ตโฟน แท็บเล็ต คอมพิวเตอร์ และตรวจสอบกติกา ฟีเจอร์ อัตราเดิมพัน
// ได้ก่อนเริ่มเล่น — so the grid and the paragraph above it never contradict
// each other. JAIDEE928 is a slot brand this run: no lottery rows here.
const providers = [
  { name: "สล็อตเกมยอดนิยม", desc: "หมวดเกมสล็อตที่สมาชิกเลือกเล่นมากที่สุด ตรวจสอบกติกาและอัตราเดิมพันได้จากหน้ารายละเอียดเกม", tag: "ยอดนิยม", icon: "🎰" },
  { name: "สล็อตเกมใหม่", desc: "รวมเกมสล็อตที่เพิ่งเปิดให้บริการล่าสุด ดูรายชื่อค่ายและเกมที่เพิ่มเข้ามาได้จากในบัญชี", tag: "อัปเดตใหม่", icon: "🆕" },
  { name: "สล็อตเกมโบนัส", desc: "หมวดเกมที่มีฟีเจอร์โบนัสในตัว อ่านรายละเอียดฟีเจอร์และเงื่อนไขของแต่ละเกมก่อนเริ่มหมุน", tag: "มีฟีเจอร์โบนัส", icon: "🎁" },
  { name: "สล็อตแจ็คพอต", desc: "รวมเกมสล็อตแจ็คพอตหลายรูปแบบ ตรวจสอบรอบการจ่ายและอัตราเดิมพันของแต่ละเกมได้จากระบบ", tag: "แจ็คพอต", icon: "💎" },
  { name: "รวมค่ายเกมครบทุกแบรนด์", desc: "เกมสล็อตจากหลากหลายค่ายรวมไว้ในบัญชีเดียว สลับค่ายและสลับเกมได้โดยไม่ต้องเปิดหลายระบบ", tag: "บัญชีเดียวครบ", icon: "🏷️" },
  { name: "จัดหมวดหมู่ให้ค้นหาง่าย", desc: "แยกหมวดเกมยอดนิยม เกมใหม่ เกมโบนัส และแจ็คพอต ให้เลือกเกมที่เหมาะกับรูปแบบการเล่นของตนเอง", tag: "ค้นหาไว", icon: "🔎" },
  { name: "รองรับทุกอุปกรณ์", desc: "เข้าเล่นผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ปรับการแสดงผลให้พอดีกับทุกขนาดหน้าจอ", tag: "ครบทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="หมวดเกมสล็อตออนไลน์ที่ JAIDEE928 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9d16f1] via-[#c47bff] to-[#e8e6ee] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตออนไลน์ที่ <span class="text-[#c47bff]">JAIDEE928</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#9d16f1] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#4a0b8f]/35 bg-[#06020e]/92 p-5 shadow-[0_10px_30px_rgba(157,22,241,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#9d16f1]/60 hover:bg-[#1c0b33] hover:shadow-[0_15px_40px_rgba(157,22,241,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#9d16f1]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#e0b7ff] via-[#9d16f1] to-[#4a0b8f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#06020e] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece0fb] transition-colors group-hover:text-[#c47bff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a892bd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#4a0b8f]/35 bg-[#06020e] py-1.5 text-center text-[11px] font-bold text-[#c47bff] shadow-inner transition-colors duration-300 group-hover:border-[#9d16f1]/60 group-hover:bg-gradient-to-r group-hover:from-[#e0b7ff] group-hover:via-[#9d16f1] group-hover:to-[#4a0b8f] group-hover:text-[#06020e]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
