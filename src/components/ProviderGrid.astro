---
import { BRAND_NAME } from "../lib/brandProfile";

// HENG38 is a สล็อต site whose brief names its game categories by hand — the FAQ
// block says "ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตหลายรูปแบบ" — so these four
// tiles are exactly that list and nothing else. The brief names no provider
// brand, no game count, no RTP figure, no payout rate and no licence number, so
// no tile states one. Every tile's copy stays inside what the brief supports:
// รวบรวมเกมแท้จากค่ายดังไว้ในระบบเดียว, เมนูจัดหมวดหมู่ชัดเจน, รายการเกมอาจมีการ
// อัปเดตตามช่วงเวลา, ตรวจสอบค่ายและเกมที่เปิดให้ใช้งานได้จากหน้ารวมเกม และ
// ตรวจสอบขั้นต่ำกับรายละเอียดเดิมพันของเกมที่สนใจก่อนเข้าเล่นได้จากหน้าเกม
//
// This grid belongs to the docx's ระบบ API section and sits directly under it.
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "เกมยอดนิยม",
    desc: "หมวดเกมยอดนิยมที่แยกไว้ชัดเจน เปิดดูรายละเอียดของแต่ละเกมก่อนเลือกเล่นได้จากหน้าเดียว",
    tag: "เกมแท้ค่ายดัง",
    icon: "🔥",
  },
  {
    name: "เกมใหม่",
    desc: "รายการเกมอาจมีการอัปเดตตามช่วงเวลา ตรวจสอบค่ายและเกมที่เปิดให้ใช้งานได้จากหน้ารวมเกม",
    tag: "อัปเดตตามช่วงเวลา",
    icon: "✨",
  },
  {
    name: "เกมโบนัส",
    desc: "รวมเกมโบนัสจากหลายค่ายไว้ในระบบเดียว ดูรายละเอียดของรอบโบนัสได้จากหน้าเกมโดยตรง",
    tag: "หลายค่าย",
    icon: "🎁",
  },
  {
    name: "สล็อตหลายรูปแบบ",
    desc: "เลือกสล็อตตามสไตล์ที่ต้องการ พร้อมตรวจสอบขั้นต่ำและรายละเอียดเดิมพันของเกมที่สนใจก่อนเข้าเล่น",
    tag: "เลือกตามสไตล์",
    icon: "🎰",
  },
];

// HENG38 palette (มรกต-ทอง): แผ่นกระเบื้องเป็นพื้นการ์ด #061f0f ในเส้นมรกตกลาง
// #0f4423 บนพื้นเพจเขียวเกือบดำ ป้ายมุมขวากับปุ่มตอน hover ไล่จากทองอ่อน #fbeeb0
// ลงทองหลัก #f3cf63 ไปจบที่มรกตสด #15833c ส่วนกรอบตอน hover ยกขึ้นเป็นทองหลัก
// และพื้นยกขึ้นเป็น #0a2d16 ม่วง-ทองของ FAH999 หายไปทั้งหมด
---

<section aria-label={`ค่ายเกมและหมวดเกมสล็อตที่ ${BRAND_NAME} เชื่อมต่อไว้ในระบบเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#e6e2d2] uppercase">
      หมวดเกมสล็อตที่เลือกเล่นได้ใน <span class="text-[#f3cf63]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f3cf63] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0f4423] bg-[#061f0f]/92 p-5 shadow-[0_10px_30px_rgba(3,20,10,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f3cf63]/80 hover:bg-[#0a2d16] hover:shadow-[0_15px_40px_rgba(243,207,99,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#15833c]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#15833c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#03140a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e6e2d2] transition-colors group-hover:text-[#fbeeb0]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e6e2d2]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0f4423] bg-[#03140a] py-1.5 text-center text-[11px] font-bold text-[#e0b23c] shadow-inner transition-colors duration-300 group-hover:border-[#f3cf63]/70 group-hover:bg-gradient-to-r group-hover:from-[#fbeeb0] group-hover:via-[#f3cf63] group-hover:to-[#15833c] group-hover:text-[#03140a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
