---
// The tiles stay inside what the FIN444 brief actually states: รวมเกมเดิมพัน
// ออนไลน์หลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้งสล็อต บาคาร่า ยิงปลา เดิมพันกีฬา
// และหวย (และ "เกมประเภทอื่น ๆ" ตามคำถามที่พบบ่อยข้อแรก) — so this grid never
// claims a game category or a provider name the brief does not have. Each tile
// repeats the brief's own caution: แต่ละหมวดมีรูปแบบ กติกา และอัตราการจ่าย
// แตกต่างกัน ควรตรวจสอบรายละเอียดก่อนยืนยันการเดิมพันทุกครั้ง.
const providers = [
  { name: "สล็อต", desc: "มีทั้งเกมทั่วไป เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ตรวจสอบเพย์ไลน์และขนาดเดิมพันได้ก่อนเริ่มเล่น", tag: "หลายรูปแบบ", icon: "🎰" },
  { name: "บาคาร่า", desc: "เดิมพันหลักมีทั้ง Player, Banker และ Tie ควรศึกษากติกาและค่าคอมมิชชั่นของโต๊ะที่เลือกก่อนลงเดิมพัน", tag: "อ่านกติกาก่อน", icon: "🃏" },
  { name: "ยิงปลา", desc: "หมวดเกมที่เปิดให้เลือกเล่นผ่านบัญชีเดียวกัน ดูอัตราการจ่ายและรายละเอียดของแต่ละห้องได้ในหน้าเกม", tag: "เล่นได้ทุกอุปกรณ์", icon: "🐟" },
  { name: "เดิมพันกีฬา", desc: "เลือกรายการและรูปแบบการเดิมพันได้ตามความสนใจ ตรวจสอบเงื่อนไขของแต่ละรายการก่อนยืนยันทุกครั้ง", tag: "ตรวจสอบก่อนยืนยัน", icon: "⚽" },
  { name: "หวย", desc: "หมวดหวยที่เปิดให้เลือกผ่านระบบเดียวกับเกมอื่น รายละเอียดรอบและอัตราการจ่ายแสดงไว้ในหน้าเกม", tag: "ดูรอบก่อนแทง", icon: "🎟️" },
  { name: "เกมประเภทอื่น ๆ", desc: "ตรวจสอบหมวดหมู่และรายการเกมที่เปิดให้บริการล่าสุดได้จากหน้าเว็บไซต์โดยตรง", tag: "อัปเดตในระบบ", icon: "🎯" },
];
---

<section aria-label="หมวดเกมที่ FIN444 เปิดให้ตรวจสอบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#0a7c8c] via-[#eafcff] to-[#c3e6ec] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมที่ <span class="text-[#eafcff]">FIN444</span> เปิดให้ตรวจสอบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0bcacd] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0a7c8c]/60 bg-[#04161d]/92 p-5 shadow-[0_10px_30px_rgba(1,6,9,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#0bcacd]/70 hover:bg-[#0a3d49] hover:shadow-[0_15px_40px_rgba(11,202,205,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#c3e6ec]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#0aabda] via-[#0bcacd] to-[#0a7c8c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#02171c] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#c3e6ec] transition-colors group-hover:text-[#eafcff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#7df3f5]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0a7c8c]/70 bg-[#04161d] py-1.5 text-center text-[11px] font-bold text-[#eafcff] shadow-inner transition-colors duration-300 group-hover:border-[#0bcacd]/70 group-hover:bg-gradient-to-r group-hover:from-[#0aabda] group-hover:via-[#0bcacd] group-hover:to-[#0a7c8c] group-hover:text-[#02171c]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
