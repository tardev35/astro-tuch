---
// CASINO888 is a full-service casino brand. Every tile below stays inside what
// the brief states: รวมเกมเดิมพันออนไลน์หลายประเภทไว้ให้เลือกผ่านบัญชีเดียว ทั้ง
// บาคาร่า สล็อต หวย และฟุตบอล, การจัดหมวดหมู่เกมให้ค้นหาได้ง่าย, การตรวจอัตราจ่าย
// กติกา และขั้นต่ำก่อนยืนยันรายการ, ขั้นต่ำที่บางเกมเริ่มประมาณ 1 บาทตามข้อกำหนด
// ของผู้ให้บริการแต่ละราย, โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตาม
// เงื่อนไข และแอดมินที่ให้บริการตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a guarantee, or a product the brief does not
// name.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "บาคาร่าและคาสิโนสด", desc: "หมวดบาคาร่าและเกมคาสิโนสดจัดไว้ให้ค้นหาง่าย ตรวจอัตราจ่าย กติกา และขั้นต่ำของแต่ละโต๊ะได้ก่อนยืนยันรายการ", tag: "ถ่ายทอดสด", icon: "🃏" },
  { name: "สล็อตออนไลน์", desc: "เลือกเกมสล็อตจากหมวดที่ระบบเปิดให้บริการ ดูรายละเอียดเกมและช่วงเดิมพันที่รองรับก่อนเริ่มหมุนรอบแรก", tag: "หลายรูปแบบ", icon: "🎰" },
  { name: "หวยออนไลน์", desc: "หวยออนไลน์มีหลายประเภทตามที่ระบบเปิดให้บริการ ควรตรวจอัตราจ่ายและรอบที่เปิดรับก่อนส่งโพยทุกครั้ง", tag: "หลายประเภท", icon: "🎫" },
  { name: "เดิมพันฟุตบอล", desc: "เดิมพันฟุตบอลตามรายการที่เปิดให้บริการ ตรวจรูปแบบการเดิมพันและขั้นต่ำของบิลก่อนยืนยันรายการ", tag: "ตามรายการที่เปิด", icon: "⚽" },
  { name: "โปรโมชั่นสมาชิก", desc: "แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ควรอ่านยอดที่ใช้คำนวณและรอบการรับก่อนกดรับ", tag: "0.8% และ 0.3%", icon: "🎁" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "สอบถามกติกา โปรโมชั่น และตรวจสอบรายการสมัคร ฝากถอน ได้ตลอด 24 ชั่วโมงผ่านระบบออนไลน์", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมเดิมพันและบริการของ CASINO888 ที่ตรวจสอบได้ก่อนยืนยันรายการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมเดิมพันและบริการของ <span class="text-[#c9c9c9]">CASINO888</span> ที่ตรวจสอบได้ก่อนยืนยันรายการ
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e4c25a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b5216]/80 bg-[#0d0a06]/92 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e4c25a]/70 hover:bg-[#17120a] hover:shadow-[0_15px_40px_rgba(228,194,90,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#e4c25a]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050403] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e9ddc4] transition-colors group-hover:text-[#fdf49c]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#8a8a8a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b5216] bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#fae582] shadow-inner transition-colors duration-300 group-hover:border-[#e4c25a]/70 group-hover:bg-gradient-to-r group-hover:from-[#fdf49c] group-hover:via-[#e4c25a] group-hover:to-[#b28a2a] group-hover:text-[#050403]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
