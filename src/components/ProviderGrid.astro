---
// The categories come straight from the brief's "รวมเกมคาสิโน" section —
// บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก คาสิโนสด สล็อต และเกมเดิมพันประเภทอื่น ๆ
// จัดหมวดหมู่ให้ค้นหาง่าย ตรวจสอบกติกาและอัตราจ่ายได้จากระบบ — so the grid and
// the paragraph above it never contradict each other. JAIDEE928 is a casino
// brand this run: no lottery rows here.
const providers = [
  { name: "บาคาร่าออนไลน์", desc: "เกมไพ่ยอดนิยมที่สมาชิกเลือกเล่นมากที่สุด ตรวจสอบกติกาและอัตราจ่ายได้จากหน้ารายละเอียดเกม", tag: "ยอดนิยม", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ถ่ายทอดจากโต๊ะเดิมพันจริงแบบเรียลไทม์ เลือกโต๊ะและวางเดิมพันได้จากบัญชีเดียว", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "รูเล็ต", desc: "หมวดวงล้อรูเล็ตหลายรูปแบบ ดูรูปแบบการวางเดิมพันและอัตราจ่ายของแต่ละโต๊ะก่อนเริ่ม", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เสือมังกร", desc: "เกมไพ่กติกาไม่ซับซ้อน จบรอบเร็ว เหมาะกับสมาชิกที่เพิ่งเริ่มเล่นคาสิโนออนไลน์", tag: "จบรอบเร็ว", icon: "🐉" },
  { name: "แบล็กแจ็ก", desc: "เกมไพ่ที่ใช้การตัดสินใจในแต่ละมือ ศึกษากติกาและตัวเลือกการเล่นได้จากในระบบ", tag: "วางแผนได้", icon: "♠️" },
  { name: "สล็อตออนไลน์", desc: "รวมเกมสล็อตหลายรูปแบบไว้ในหมวดเดียว พร้อมรายละเอียดฟีเจอร์ให้อ่านก่อนเริ่มเล่น", tag: "หลากหลายเกม", icon: "🎰" },
  { name: "เกมเดิมพันอื่น ๆ", desc: "เข้าเล่นได้ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ จัดหมวดหมู่ให้ค้นหาเกมได้ง่าย", tag: "ครบทุกอุปกรณ์", icon: "🎯" },
];
---

<section aria-label="หมวดเกมคาสิโนออนไลน์ที่ JAIDEE928 เปิดให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#0e6efb] via-[#7db4ff] to-[#e6e8ec] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนออนไลน์ที่ <span class="text-[#7db4ff]">JAIDEE928</span> เปิดให้บริการ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0e6efb] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#062d94]/35 bg-[#01050f]/92 p-5 shadow-[0_10px_30px_rgba(14,110,251,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#0e6efb]/60 hover:bg-[#08203f] hover:shadow-[0_15px_40px_rgba(14,110,251,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0e6efb]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#a9ccff] via-[#0e6efb] to-[#062d94] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#01050f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dce9ff] transition-colors group-hover:text-[#7db4ff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#93a7c6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#062d94]/35 bg-[#01050f] py-1.5 text-center text-[11px] font-bold text-[#7db4ff] shadow-inner transition-colors duration-300 group-hover:border-[#0e6efb]/60 group-hover:bg-gradient-to-r group-hover:from-[#a9ccff] group-hover:via-[#0e6efb] group-hover:to-[#062d94] group-hover:text-[#01050f]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
