---
// VAK88 is a slot brand — เกมสล็อตเว็บตรงเจ้าแรก ที่ให้บริการผ่านช่องทางเข้าเล่น
// หลักอย่างเป็นทางการ โดยไม่ต้องผ่านตัวแทนหรือเอเย่นต์ — so the tiles are the
// capabilities the brief itself names: เกมสล็อตจากค่ายยักษ์ใหญ่ระดับโลกที่ได้รับ
// อนุญาตจากลิขสิทธิ์แท้ 100% (Certified API), กราฟิกคมชัดระดับ Cinematic Lighting,
// อัตราการชนะ (RTP) ที่เป็นมาตรฐานสากล, ระบบฝาก-ถอนอัตโนมัติภายใน 3-5 วินาทีที่
// รองรับทุกธนาคารชั้นนำและไม่มีขั้นต่ำ, การเข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทุกอุปกรณ์
// โดยไม่ต้องดาวน์โหลดแอปพลิเคชัน, และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence number, a founding year, or a member
// count — the brief states none of those.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "สล็อตค่ายยักษ์ใหญ่ระดับโลก",
    desc: "รวมเกมสล็อตจากค่ายยักษ์ใหญ่ระดับโลก ทุกค่ายผ่านการตรวจสอบและได้รับอนุญาตจากลิขสิทธิ์แท้ 100% แบบ Certified API",
    tag: "ลิขสิทธิ์แท้ 100%",
    icon: "🎰",
  },
  {
    name: "ช่องทางเข้าเล่นหลักอย่างเป็นทางการ",
    desc: "ให้บริการผ่านช่องทางเข้าเล่นหลักของ VAK88 โดยตรง ไม่ต้องผ่านตัวแทนหรือเอเย่นต์ในการเข้าใช้งาน",
    tag: "เว็บตรงเจ้าแรก",
    icon: "🛡️",
  },
  {
    name: "กราฟิกระดับ Cinematic Lighting",
    desc: "คุณภาพกราฟิกคมชัด พร้อมการจัดแสงเงาระดับ Cinematic Lighting ที่สมจริงในทุกการสปิน",
    tag: "คมชัดทุกสปิน",
    icon: "🎬",
  },
  {
    name: "อัตราการชนะ (RTP) มาตรฐานสากล",
    desc: "RTP ของเกมเป็นไปตามมาตรฐานสากล ไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ โปร่งใสและยุติธรรมในทุกการเดิมพัน",
    tag: "โปร่งใส ยุติธรรม",
    icon: "📊",
  },
  {
    name: "ฝาก-ถอนอัตโนมัติ 3-5 วินาที",
    desc: "ระบบฝาก-ถอนอัตโนมัติประมวลผลภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำ และไม่กำหนดขั้นต่ำในการทำรายการ",
    tag: "ไม่มีขั้นต่ำ",
    icon: "💳",
  },
  {
    name: "แอดมินผ่าน Line Official 24 ชั่วโมง",
    desc: "ทีมงานผู้เชี่ยวชาญของ VAK88 สแตนด์บายให้คำปรึกษาและแก้ไขปัญหาผ่าน Line Official ตลอด 24 ชั่วโมง",
    tag: "ตลอด 24 ชม.",
    icon: "🎧",
  },
];
---

<section aria-label="จุดเด่นของแพลตฟอร์ม VAK88 ที่ตรวจสอบได้ก่อนเข้าเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#fff4dd] uppercase">
      จุดเด่นของแพลตฟอร์ม VAK<span class="text-[#e6b23c]">88</span> ที่ตรวจสอบได้ก่อนเข้าเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e6b23c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8a5f14]/70 bg-[#0b1020]/92 p-5 shadow-[0_10px_30px_rgba(3,6,14,0.7)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e6b23c]/80 hover:bg-[#121a2e] hover:shadow-[0_15px_40px_rgba(230,178,60,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#e6b23c]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffd873] via-[#e6b23c] to-[#cf2027] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#060913] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ded8ca] transition-colors group-hover:text-[#fff4dd]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#ded8ca]/60">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#8a5f14]/70 bg-[#060913] py-1.5 text-center text-[11px] font-bold text-[#ffd873] shadow-inner transition-colors duration-300 group-hover:border-[#e6b23c]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffd873] group-hover:via-[#e6b23c] group-hover:to-[#8a5f14] group-hover:text-[#060913]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
