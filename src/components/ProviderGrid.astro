---
const providers = [
  { name: "หวยรัฐบาลไทย", desc: "แทง 2 ตัวบน-ล่าง 3 ตัวบน 3 ตัวโต๊ด วิ่งบน วิ่งล่าง ตามรอบที่เปิดรับ", tag: "รอบทางการ", icon: "🎫" },
  { name: "หวยออมสิน", desc: "ตรวจรอบเปิดรับและเวลาปิดรับของแต่ละงวดได้ก่อนส่งโพย", tag: "ตรวจรอบก่อนแทง", icon: "🏦" },
  { name: "หวย ธ.ก.ส.", desc: "เลือกประเภทการเดิมพัน ใส่เลขและจำนวนเงินได้จากหน้าเดียว", tag: "ครบทุกรูปแบบ", icon: "🌾" },
  { name: "หวยลาว", desc: "จัดหมวดหมู่รอบหวยลาวไว้ให้ค้นหาและส่งโพยได้สะดวก", tag: "ออกถี่", icon: "🏵️" },
  { name: "หวยฮานอย", desc: "มีหลายรอบต่อวัน ตรวจเวลาปิดรับของแต่ละรอบก่อนยืนยันโพย", tag: "หลายรอบต่อวัน", icon: "⭐" },
  { name: "หวยหุ้น", desc: "อ้างอิงผลตามตลาดหุ้นที่ระบบกำหนด ดูรอบที่เปิดรับได้ล่วงหน้า", tag: "อ้างอิงตลาดหุ้น", icon: "📈" },
  { name: "เรท 2 ตัว 100 3 ตัว 1,000", desc: "ตรวจอัตราจ่ายและวงเงินรับแทงที่แสดงในระบบก่อนยืนยันทุกครั้ง", tag: "จ่ายเต็มจริง", icon: "💵" },
];
---

<section aria-label="ประเภทหวยที่ 7LOTTO เปิดรับแทง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ประเภทหวยที่ <span class="text-[#ff2a30]">7LOTTO</span> เปิดรับแทง
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2a30] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#a3060c]/35 bg-[#0d0304]/92 p-5 shadow-[0_10px_30px_rgba(255,42,48,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2a30]/60 hover:bg-[#150406] hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ff2a30]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff6b70] via-[#ff2a30] to-[#a3060c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2b070a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d8dae0] transition-colors group-hover:text-[#ff2a30]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9aa1ad]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a3060c]/35 bg-[#0a0304] py-1.5 text-center text-[11px] font-bold text-[#ff2a30] shadow-inner transition-colors duration-300 group-hover:border-[#ff2a30]/60 group-hover:bg-gradient-to-r group-hover:from-[#ff6b70] group-hover:via-[#ff2a30] group-hover:to-[#a3060c] group-hover:text-[#2b070a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
