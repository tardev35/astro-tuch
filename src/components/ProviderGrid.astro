---
import { BRAND_NAME } from "../lib/brandProfile";

// วิดเจ็ตนี้ถูกวาง **ต่อท้าย docx H2 §2 ทันที** ("<แบรนด์> บาคาร่า สล็อต รูเล็ต
// ไฮโล เริ่มต้น1บาท ไลฟ์เดิมพัน 24 ชั่วโมง" — content.txt บรรทัด 5-6) เพราะหัวข้อ
// นั้นคือหัวข้อเดียวของบรีฟที่ **ไล่ชื่อหมวดเกม** และพูดถึงกติกา อัตราจ่าย และ
// ยอดเดิมพันขั้นต่ำของแต่ละค่าย
//
// 🚨🚨 **ทุกไทล์เขียนจากคลังคำของบรีฟรอบนี้ล้วน** (src/assets/content.txt) และ
// **บรีฟรอบนี้ไม่ได้ระบุชื่อค่ายเกมรายใดเลย** → **ห้ามแต่งชื่อสตูดิโอขึ้นมาเอง**
// ไทล์ทั้ง **ห้า** ใบจึงเป็น **ห้าหมวดเกมที่บรีฟระบุชื่อไว้ตรงตัว**: บาคาร่า ·
// สล็อตออนไลน์ · รูเล็ต · ไฮโล · คาสิโนสด
// ⚠️⚠️ รอบก่อน (123BET) ไฟล์นี้มี **เจ็ด** ไทล์ รวม **ยิงปลา · เดิมพันฟุตบอล ·
// หวยออนไลน์** ซึ่ง **ไม่มีในบรีฟรอบนี้เลยสักคำ** — **ห้ามสืบทอดลิสต์ข้ามรอบ**
// และรอบก่อนหน้านั้น (LOTTOPLUS) เป็นเว็บหวย → **คำว่าหวย สลาก งวด โพย เลขอั้น
// รอบปิดรับ สองตัวบน-ล่าง สามตัวตรง-โต๊ด ห้ามกลับเข้ามาเด็ดขาด**
// 🚨 **บรีฟรอบนี้ไม่ระบุจำนวนค่าย จำนวนเกม ค่า RTP เลขใบอนุญาต หรือยอดฝากขั้นต่ำ
// เป็นตัวเลข** → **ไม่มีไทล์ไหนอ้างสิ่งเหล่านั้น** ตัวเลขที่ใช้ได้รอบนี้มีแค่
// **1 บาท · 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง** และหมวดนี้อ้างแค่ 1 บาท กับ
// 24 ชั่วโมง ซึ่งเป็นถ้อยคำของบรรทัด 6 ตรงตัว
// 🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยสักคำ** → ไม่มีไทล์ไหนพูดถึง
//
// ⚠️ **บรีฟรอบนี้โฆษณาและกำกับในย่อหน้าเดียวกัน (brand-spec §5) และต้อง ship
// ทั้งสองครึ่ง** ไทล์จึงบอกทั้ง "สิ่งที่เว็บไซต์ระบุ" และ "สิ่งที่ผู้ใช้งานควร
// ตรวจสอบ" ตามที่บรีฟเขียนไว้เอง — **ห้ามตัดครึ่งกำกับทิ้งเพราะฟังดูไม่ขายของ และ
// ห้ามขยายคำโฆษณาเป็นคำกล่าวอ้างใหม่**
//
// ⚠️ ป้ายหัวแผงเป็น **<p>** และ <section> รับชื่อที่เข้าถึงได้จาก **aria-label** —
// วิดเจ็ตนี้เป็น chrome ไม่ใช่หัวข้อของบทความ จึง **ไม่ปล่อย heading tag ระดับไหน
// เลย** (h1 ถึง h6 = ศูนย์แท็ก) **ห้ามเลื่อน <p> ใบนี้ขึ้นเป็น h2 เพื่อ "แก้ชื่อ
// ที่ขาด"** — inventory ของหน้าแรกรอบนี้ถูกตรึงไว้ที่ h1x1 / h2x5 / h3x2 ตาม
// brand-spec §4
// ⚠️ อีโมจิทุกตัวอยู่ใน <div aria-hidden="true"> ที่เป็น **พี่น้อง** ของชื่อหมวด
// ไม่ใช่อักขระในข้อความ · ชื่อแบรนด์ interpolate จาก BRAND_NAME ทุกจุดรวมถึงใน
// aria-label **ไม่พิมพ์ตรง ๆ ที่ไหนเลย** และไม่มีโดเมนในไฟล์นี้
// ⚠️ ลิงก์ทุกใบชี้ /register ซึ่งเป็น route ที่มีอยู่จริงรอบนี้ — **ห้าม href="#"**
// ⚠️ กริดเป็น 2 / 3 / 5 คอลัมน์ (รอบก่อนเป็น 2/3/4 เพราะมีเจ็ดไทล์) — รอบนี้มี
// **ห้า** ไทล์ 5 คอลัมน์ที่ lg จึงอ่านเป็นแถวเดียวเต็มพอดี ไม่มีช่องว่างค้างท้ายแถว
const providers = [
  {
    name: "บาคาร่า",
    desc: "บรีฟระบุว่าเป็นบาคาร่าออนไลน์ที่มีตัวเลือกเดิมพันตามกติกา ควรศึกษากติกาและอัตราจ่ายของแต่ละโต๊ะก่อนเดิมพัน",
    tag: "เดิมพันตามกติกา",
    icon: "🃏",
  },
  {
    name: "สล็อตออนไลน์",
    desc: "ระบุว่าแต่ละเกมมีธีมและฟีเจอร์แตกต่างกัน ควรอ่านรายละเอียดเกมและข้อกำหนดการใช้งานจริงก่อนเริ่ม",
    tag: "ธีมและฟีเจอร์ต่างกัน",
    icon: "🎰",
  },
  {
    name: "รูเล็ต",
    desc: "เป็นหมวดที่ใช้การหมุนวงล้อตามที่บรีฟระบุ ควรศึกษารูปแบบการเดิมพันและอัตราจ่ายแต่ละแบบก่อนใช้งาน",
    tag: "ใช้การหมุนวงล้อ",
    icon: "🎡",
  },
  {
    name: "ไฮโล",
    desc: "เป็นหมวดที่อ้างอิงผลจากลูกเต๋า รูปแบบการเดิมพันและวงเงินไม่เหมือนหมวดอื่น ควรตรวจกติกาก่อนลง",
    tag: "อ้างอิงผลจากลูกเต๋า",
    icon: "🎲",
  },
  {
    name: "คาสิโนสด",
    desc: "มีการถ่ายทอดเกมจากโต๊ะเดิมพันแบบเรียลไทม์ ควรตรวจตารางเวลาเปิดโต๊ะและยอดเดิมพันขั้นต่ำของแต่ละค่าย",
    tag: "ถ่ายทอดจากโต๊ะเดิมพัน",
    icon: "📹",
  },
];

// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงชาด/ชมพูบลัชของ 123BET** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ — **รอบนี้ยังเป็นธีมสว่าง แต่คนละค่าทุกตัว** พื้นเพจมาจาก bg.json =
// {"mode":"color","color":"#f8b9f0"} = ชมพูพาสเทลอิ่มตัว **ห้ามอนุมานพื้นจากรูป**
// 🚨🚨 **a30d1a (123BET, แดงชาด) ↔ #a30d63 (รอบนี้, ชมพูบานเย็น) ต่างกันสองหลัก
// ท้ายเท่านั้น** — ตาเปล่าแยกไม่ออก ต้องอ่านค่าให้ครบหกหลักทุกจุด และ
// **f7e4e9 fdf5f6 f7dfe4 (123BET) ↔ #fff5fb #fcd9ee** ก็ใกล้กันมาก
// แผงนี้นั่งคั่นระหว่างการ์ด docx §2 กับ §3 ซึ่งเป็น **ผิวเนื้อหา** ทั้งคู่ ไทล์
// พื้นมืดตรงนี้จะอ่านเป็นแถบแปลกปลอมกลางบทความ **ห้ามแก้ไปเป็นพื้นมืด** ส่วนผิว
// โครมเข้มของรอบนี้ (#440d31 #2b0620 #5e1746) สงวนไว้ให้ navbar/footer/ticker/Navfoot
// ลำดับผิว: **#ffffff ไทล์** · #fcd9ee ยก (ชิปป้ายมุม) · #f3a7d3 เส้นบาง ·
// #f8b9f0 พื้นเพจ (หัวแผงนั่งบนพื้นเพจตรง ๆ)
// ⚠️⚠️ **หัวแผงไม่มีการ์ดครอบ มันนั่งบนพื้นเพจ #f8b9f0 ตรง ๆ** ซึ่ง §2 สั่งว่าตรงนั้น
// **ต้องเป็นหมึกเข้มเท่านั้น** (ตัวอักษรขาวบนพื้นเพจได้แค่ 1.6:1) จึงใช้ **#3d0a2c
// (10.3:1)** ส่วนชื่อแบรนด์ในหัวแผงเป็น **#a30d63 (4.7:1 บนพื้นเพจ)**
// ชื่อหมวดเป็น #a30d63 (7.5:1 บนไทล์ขาว) · คำอธิบายเป็นหมึกรอง #7a4263 (7.5:1) ·
// ป้ายมุมเป็นชิปผิวยก #fcd9ee หมึก #3d0a2c (~12.7:1) · ปุ่มท้ายไทล์เป็นสูตร
// **"CTA หลัก" ของ §2** คือพื้นไล่ #d11a7e → #a30d63 → #7a0449 + หมึกขาว
// (5.0 / 7.5 / 10.8:1 — ผ่าน AA ทุก stop)
// 🚨🚨 **ห้ามลากปลายอ่อนกว่า #d11a7e** (#e0509f + หมึกขาว = 3.6:1 ตก) และ
// **ห้ามวางหมึกเข้ม #3d0a2c บนไล่เฉดนี้** (บน #7a0449 ได้ 1.5:1)
// ⚠️⚠️ **#f3a7d3 / #fcd9ee / #e0509f (3.6:1) / #ff7ac2 ห้ามถือตัวอักษรบนผิวสว่าง
// ทุกกรณี** — ในไฟล์นี้มันอยู่ที่ขอบ เส้นคาดใต้หัวแผง ชิปป้ายมุม และแผ่นเรือง
// ตอน hover ซึ่งเป็นเส้น/พื้นถมล้วน
// ⚠️ **#f2c14e ถือตัวอักษรได้เฉพาะบนโครมเข้ม (1.7:1 บนการ์ดขาว)** จึงไม่อยู่ในไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α)
// **เงาบนการ์ดสว่างต้องเบา**: ปกติ rgba(61,10,44,0.10) · hover rgba(163,13,99,0.18)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์ชมพูจริง และรีโป
// นี้มีชมพู/แดงของแบรนด์อื่นอยู่สิบชุดขึ้นไป** "มีชมพูอยู่แล้ว" จึงไม่พิสูจน์อะไร
// ชมพูรอบนี้คือ **#a30d63 / #d11a7e / #7a0449 / #e0509f / #ff7ac2 / #f3a7d3 /
// #fcd9ee / #fff5fb / #f8b9f0** หมึกคือ **#3d0a2c / #7a4263** ทองคือ
// **#6e4705 (ผิวสว่าง) / #f2c14e (โครมเท่านั้น)**
// ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (**123BET**): a30d1a c21325 8a1420
// 36080f 6b2b33 f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 dca53a ef4a5e
// + rgba(163,13,26) rgba(54,8,15)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์ที่ต้องกวาดออกอยู่ที่ .claude/brand-spec-abm96.md §2b
// — ไม่ซ้ำลงที่นี่โดยตั้งใจ** ตัวที่เสี่ยงสูงสุดรอบนี้คือ **LOTTOPLUS (ขาออกทันที
// เขียว-ทอง) · okkub88 + ถอนชัวร์168 (ชมพูเหมือนกัน) · 123BET + ZANE96 (เจ้าของ
// ไฟล์ที่หมุนเข้ามารอบนี้)**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีส้ม ไม่มีแดงชาด ไม่มีม่วง ไม่มีฟ้า/ไซแอน และไม่มี
// พื้นมืดในไฟล์นี้** — ชิปคาสิโนชมพู-ขาว ไพ่เอซ ลูกเต๋าชมพู วงล้อรูเล็ตขอบทอง และ
// หัวใจชมพูสามมิติบนอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// ⚠️ เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้
// ห้ามกลืนเข้าพาเลตชมพูของรอบนี้**
---

<section aria-label={`หมวดเกมคาสิโนที่ ${BRAND_NAME} ระบุไว้ และสิ่งที่ควรตรวจสอบก่อนใช้งาน`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-2xl font-black tracking-wide text-[#3d0a2c] sm:text-3xl">
      หมวดเกมคาสิโนที่ <span class="text-[#a30d63]">{BRAND_NAME}</span> ระบุไว้
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d11a7e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f3a7d3] bg-[#ffffff] p-5 shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-300 hover:-translate-y-2 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#ff7ac2]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full border border-[#f3a7d3] bg-[#fcd9ee] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#3d0a2c] transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mt-5 mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#a30d63]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] leading-relaxed text-[#7a4263]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7a0449] bg-gradient-to-r from-[#d11a7e] via-[#a30d63] to-[#7a0449] py-1.5 text-center text-[11px] font-bold text-[#ffffff] transition-colors duration-300 group-hover:border-[#a30d63]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
