---
import { BRAND_NAME } from "../lib/brandProfile";

// ABM96 is a casino/betting site whose brief names its game types by hand — the
// docx H2 reads "รูปแบบเกมครบ ทั้ง บาคาร่า สล็อต หวย ไฮโล บอล" and the FAQ repeats
// the same five — so these five tiles are exactly that list and nothing else.
// The brief names no provider brand, no game count, no RTP figure, no payout
// rate and no licence number, so no tile states one. Every tile's copy stays
// inside what the brief supports: รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว,
// เลือกหมวดที่สนใจได้จากหน้าเมนูหลัก, สลับระหว่างเกมแต่ละประเภทได้สะดวก,
// ระบบจัดหมวดหมู่ชัดเจน ช่วยให้ค้นหาเกมหรือรายการที่ต้องการได้ง่าย และ
// ไม่ต้องเปลี่ยนหลายเว็บไซต์
//
// This grid belongs to the docx's "รูปแบบเกมครบ" section and sits directly under
// it. The section title is a <p>: these tiles are chrome, not a docx heading, so
// the <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "บาคาร่า",
    desc: "เลือกหมวดบาคาร่าได้จากหน้าเมนูหลัก แล้วสลับไปเกมประเภทอื่นในบัญชีเดียวได้สะดวก",
    tag: "บัญชีเดียว",
    icon: "🃏",
  },
  {
    name: "สล็อต",
    desc: "รวมเกมสล็อตไว้ในหมวดของตัวเอง ระบบจัดหมวดหมู่ชัดเจน ค้นหาเกมที่ต้องการได้ง่าย",
    tag: "จัดหมวดหมู่ชัดเจน",
    icon: "🎰",
  },
  {
    name: "หวย",
    desc: "เปิดหมวดหวยจากหน้าเมนูหลักได้ในบัญชีเดียว โดยไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์",
    tag: "เลือกจากเมนูหลัก",
    icon: "🎫",
  },
  {
    name: "ไฮโล",
    desc: "เลือกหมวดไฮโลได้จากเมนูหลัก พร้อมสลับระหว่างเกมแต่ละประเภทได้สะดวกในระบบเดียว",
    tag: "สลับเกมสะดวก",
    icon: "🎲",
  },
  {
    name: "บอล",
    desc: "เลือกรายการในหมวดบอลได้จากหน้าเมนูหลัก ระบบจัดหมวดหมู่ช่วยให้ค้นหารายการที่ต้องการได้ง่าย",
    tag: "ค้นหาง่าย",
    icon: "⚽",
  },
];

// ABM96 palette (ชมพู-เหลือง): แผ่นกระเบื้องเป็นพื้นการ์ด #1d0611 ในเส้นพื้นการ์ด
// สว่าง #3d0f26 บนพื้นเพจชมพูเกือบดำ ป้ายมุมขวากับปุ่มตอน hover ไล่จากชมพูอ่อน
// #ffc9dc ลงชมพูหลัก #fd6494 ไปจบที่เหลืองโลโก้ #feda2a ซึ่งเป็นคู่สีเดียวกับโลโก้
// ที่ตัว ABM เป็นชมพูและเลข 96 เป็นเหลือง ส่วนกรอบตอน hover ยกขึ้นเป็นชมพูหลัก
// และพื้นยกขึ้นเป็น #2a0a1a มรกต-ทองของ HENG38 หายไปทั้งหมด
---

<section aria-label={`หมวดเกมเดิมพันที่ ${BRAND_NAME} รวมไว้ในบัญชีเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#fbe3ee] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#fd6494]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fd6494] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#3d0f26] bg-[#1d0611]/92 p-5 shadow-[0_10px_30px_rgba(18,3,10,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fd6494]/80 hover:bg-[#2a0a1a] hover:shadow-[0_15px_40px_rgba(253,100,148,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#d92e6e]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#12030a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fbe3ee] transition-colors group-hover:text-[#ffc9dc]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#fbe3ee]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#3d0f26] bg-[#12030a] py-1.5 text-center text-[11px] font-bold text-[#feda2a] shadow-inner transition-colors duration-300 group-hover:border-[#fd6494]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffc9dc] group-hover:via-[#fd6494] group-hover:to-[#feda2a] group-hover:text-[#12030a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
