---
// UVO88 is a multi-product casino brand — the brief names บาคาร่า, เกมไพ่,
// สล็อตออนไลน์, หวยออนไลน์ and การเดิมพันฟุตบอล as categories inside ONE account,
// so the tiles are the docx's own game categories plus the two service rows it
// describes. Everything below stays inside what the brief states: การสลับประเภท
// เกมได้โดยไม่ต้องสมัครหลายบัญชี, การใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์,
// การตรวจสอบเครดิต ฝากถอน โปรโมชั่น และประวัติรายการจากหน้าเว็บไซต์, และแอดมินที่
// ให้บริการได้ตลอด 24 ชั่วโมง.
// No tile quotes a payout figure, a licence, a founding year, or a member count
// — the brief says outright that ควรตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงิน
// ของแต่ละเกมก่อนเริ่ม, และว่าผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือผลชนะได้
// ทุกครั้ง.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "บาคาร่าออนไลน์", desc: "หมวดบาคาร่าที่ระบบเปิดให้บริการ ตรวจสอบกติกา อัตราจ่าย และช่วงเดิมพันของโต๊ะนั้นได้ก่อนลงเงินทุกครั้ง", tag: "ดูอัตราจ่ายก่อน", icon: "🃏" },
  { name: "เกมไพ่ในหมวดคาสิโน", desc: "เกมไพ่หมวดคาสิโนหลายรูปแบบให้เลือก เงื่อนไขและวงเงินของแต่ละเกมกำหนดไว้ไม่เท่ากัน ควรอ่านกติกาให้ครบก่อนเริ่มเดิมพัน", tag: "ตามกติกาแต่ละเกม", icon: "♠️" },
  {
    name: "สล็อตออนไลน์จากหลายค่าย",
    desc: "สล็อตออนไลน์จากค่ายที่ระบบเปิดให้บริการ เลือกและสลับเกมได้จากบัญชีเดียวโดยไม่ต้องสมัครหลายบัญชี",
    tag: "หลายค่ายบัญชีเดียว",
    icon: "🎰",
  },
  {
    name: "หวยออนไลน์ตามรอบที่เปิดรับ",
    desc: "หวยออนไลน์เปิดรับตามรอบที่ระบบกำหนด รายการและช่วงเวลาปิดรับของแต่ละรอบต่างกัน ให้ยึดข้อมูลที่หน้าแทงแสดง ณ เวลาทำรายการ",
    tag: "ตามรอบที่เปิดรับ",
    icon: "🎫",
  },
  {
    name: "เดิมพันฟุตบอลตามรายการแข่ง",
    desc: "เดิมพันฟุตบอลตามรายการแข่งขันที่เปิดให้บริการ ควรตรวจสอบรูปแบบการเดิมพัน อัตราจ่าย และวงเงินของคู่นั้นก่อนยืนยัน",
    tag: "ตรวจก่อนยืนยัน",
    icon: "⚽",
  },
  { name: "แอดมินให้บริการ 24 ชั่วโมง", desc: "สอบถามขั้นตอนสมัคร วิธีฝากถอน การรับโปรโมชั่น หรือการเข้าใช้งานเกมแต่ละประเภทกับแอดมิน UVO88 ได้ตลอด 24 ชั่วโมง", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมและบริการของ UVO88 ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#f3fbf5] uppercase">
      หมวดเกมและบริการของ UVO<span class="text-[#f2c230]">88</span> ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f2c230] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0a3b1c] bg-[#051a0e]/92 p-5 shadow-[0_10px_30px_rgba(2,13,7,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#0f9d47]/80 hover:bg-[#0b2c17] hover:shadow-[0_15px_40px_rgba(15,157,71,0.30)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#0f9d47]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#57dd8f] via-[#f2c230] to-[#0f9d47] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#03110a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#c8e3d0] transition-colors group-hover:text-[#f3fbf5]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#93b8a0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0a3b1c] bg-[#03110a] py-1.5 text-center text-[11px] font-bold text-[#57dd8f] shadow-inner transition-colors duration-300 group-hover:border-[#f2c230]/70 group-hover:bg-gradient-to-r group-hover:from-[#57dd8f] group-hover:via-[#f2c230] group-hover:to-[#0f9d47] group-hover:text-[#03110a]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
