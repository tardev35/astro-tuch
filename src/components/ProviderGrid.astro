---
// NEXT55 is a คาสิโนออนไลน์เว็บตรงครบวงจร — เว็บตรง 100% ไม่ผ่านเอเย่นต์ แบบ
// One-Stop Service — so the tiles are the five game types the brief lists plus
// the financial capability it names alongside them: ไม่มีขั้นต่ำฝาก-ถอน เริ่มต้น
// 1 บาท ด้วยระบบออโต้ภายใน 5 วินาที ที่รองรับทุกธนาคารชั้นนำและ TrueMoney
// Wallet. No tile quotes a payout figure, a licence number, a founding year, or
// a member count — the brief states none of those.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  {
    name: "บาคาร่าและคาสิโนสด",
    desc: "ถ่ายทอดสดจากคาสิโนชั้นนำ ภาพคมชัดระดับ Full HD สัมผัสบรรยากาศสมจริงเหมือนนั่งอยู่ในคาสิโนวีไอพี",
    tag: "Full HD",
    icon: "🃏",
  },
  {
    name: "สล็อตออนไลน์ลิขสิทธิ์แท้",
    desc: "รวบรวมค่ายเกมสล็อตลิขสิทธิ์แท้ แจ็คพอตแตกง่าย ฟีเจอร์แน่น ภาพสวยงามตระการตา",
    tag: "ลิขสิทธิ์แท้",
    icon: "🎰",
  },
  {
    name: "เกมยิงปลา",
    desc: "สนุกไปกับเกมยิงปลาที่เล่นง่าย ตายไว กราฟิกสวยงาม ทำกำไรได้รวดเร็ว",
    tag: "เล่นง่าย ตายไว",
    icon: "🐟",
  },
  {
    name: "หวยออนไลน์ รัฐบาล ลาว ฮานอย",
    desc: "รับแทงหวยทุกประเภท ทั้งหวยรัฐบาล ลาว ฮานอย จ่ายหนัก จ่ายเต็ม ไม่มีเลขอั้น",
    tag: "ไม่มีเลขอั้น",
    icon: "🎫",
  },
  {
    name: "แทงบอลและกีฬาทุกลีก",
    desc: "ค่าน้ำดีที่สุด เปิดรับเดิมพันทุกลีกดังทั่วโลก พร้อมรูปแบบการแทงที่หลากหลาย",
    tag: "ค่าน้ำดีที่สุด",
    icon: "⚽",
  },
  {
    name: "ฝาก-ถอนออโต้ ไม่มีขั้นต่ำ",
    desc: "ไม่มีขั้นต่ำในการฝาก-ถอน ทุน 1 บาทก็ฝากเข้ามาเล่นได้ รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ภายใน 5 วินาที",
    tag: "ออโต้ 5 วินาที",
    icon: "💳",
  },
];
---

<section aria-label="เกมและบริการของ NEXT55 ที่เปิดให้ใช้งานในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl font-black tracking-widest text-[#e7eaef] uppercase">
      เกมและบริการของ NEXT<span class="text-[#f0435f]">55</span> ที่เปิดให้ใช้งานในบัญชีเดียว
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#cd1437] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#3a3d45] bg-[#17181c]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#cd1437]/80 hover:bg-[#22242a] hover:shadow-[0_15px_40px_rgba(205,20,55,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#cd1437]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#cd1437] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0c0d10] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#c3c8d1] transition-colors group-hover:text-[#e7eaef]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c3c8d1]/60">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#3a3d45] bg-[#0c0d10] py-1.5 text-center text-[11px] font-bold text-[#ffb3bf] shadow-inner transition-colors duration-300 group-hover:border-[#cd1437]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffb3bf] group-hover:via-[#f0435f] group-hover:to-[#cd1437] group-hover:text-[#0c0d10]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
