---
// ขวัญใจ168 is a slot/casino brand whose brief is specifically about the backup
// entrance: ทางเข้าสำรองเมื่อช่องทางหลักใช้งานไม่ได้, การสมัครยูสเซอร์ใหม่, ฝากถอน
// อัตโนมัติ, โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, การรองรับมือถือ
// แท็บเล็ต และคอมพิวเตอร์, และแอดมินที่ดูแลตลอด 24 ชั่วโมง. No tile claims a game
// category, a provider name, a payout figure or a lottery product the brief does
// not state — this is not a หวย site.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตออนไลน์", desc: "เข้าเล่นสล็อตผ่านทางเข้าสำรองได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ ตรวจรายละเอียดเกมก่อนเริ่มเดิมพัน", tag: "ทางเข้าสำรอง", icon: "🎰" },
  { name: "ตรวจลิงก์ก่อนเข้า", desc: "ตรวจสอบทางเข้าสำรองจากช่องทางที่ผู้ให้บริการประกาศทุกครั้ง ก่อนกรอกข้อมูลบัญชีหรือทำธุรกรรม", tag: "ยืนยันช่องทาง", icon: "🔗" },
  { name: "สมัครยูสเซอร์ใหม่", desc: "กรอกข้อมูลตามที่ระบบร้องขอ จากนั้น Login เข้าใช้งานได้ตามที่ระบบกำหนดในรอบนั้น", tag: "ใช้ยูสใหม่ได้", icon: "📝" },
  { name: "ฝากถอนอัตโนมัติ", desc: "ตรวจสอบช่องทางฝากเครดิตที่เปิดให้บริการในบัญชีสมาชิกก่อนทำรายการทุกครั้ง", tag: "ระบบออโต้", icon: "💳" },
  { name: "แนะนำเพื่อน 0.8%", desc: "แชร์ลิงก์แนะนำของตนเอง ระบบจะคำนวณคอมมิชชั่นแนะนำ 0.8% ตามข้อกำหนดที่ประกาศไว้", tag: "ตามเงื่อนไข", icon: "🤝" },
  { name: "คืนยอดเสีย 0.3%", desc: "ตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวัน พร้อมยอดที่นำมาคำนวณก่อนกดรับ", tag: "รับได้ทุกวัน", icon: "🎁" },
];
---

<section aria-label="บริการของ ขวัญใจ168 ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4bdbee] via-[#eafcff] to-[#1687c9] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      บริการของ <span class="text-[#eafcff]">ขวัญใจ168</span> ที่ตรวจสอบได้ก่อนเริ่มเดิมพัน
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#4bdbee] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0e4f7a]/70 bg-[#01050b]/92 p-5 shadow-[0_10px_30px_rgba(1,5,11,0.5)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#4bdbee]/70 hover:bg-[#083b5c] hover:shadow-[0_15px_40px_rgba(22,135,201,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#cfe7f2]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#9df1ff] via-[#4bdbee] to-[#1687c9] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#01050b] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#cfe7f2] transition-colors group-hover:text-[#eafcff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#7fe6fa]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#0e4f7a]/80 bg-[#01050b] py-1.5 text-center text-[11px] font-bold text-[#eafcff] shadow-inner transition-colors duration-300 group-hover:border-[#4bdbee]/70 group-hover:bg-gradient-to-r group-hover:from-[#9df1ff] group-hover:via-[#4bdbee] group-hover:to-[#1687c9] group-hover:text-[#01050b]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
