---
import { BRAND_NAME } from "../lib/brandProfile";

// SAGAME66's brief names its game categories outright — "ภายในระบบมีทั้งบาคาร่า
// รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่นตามรายการที่เปิดให้บริการ" — so these four
// tiles are exactly that list, in the brief's own order, and nothing else. The
// brief names no provider brand, no game count, no RTP figure, no payout rate and
// no licence number, so no tile states one. It never mentions lottery or sport
// either, so there is no lottery or sport tile here; the previous brand's กีฬา
// tile went with it.
//
// This grid belongs to the docx's "SAGAME66 แหล่งรวมเกมเดิมพัน ค่ายมาตรฐานสากล
// 2026" section and sits directly under it. The section title is a <p>: these
// tiles are chrome, not a docx heading, so the <section> takes its accessible
// name from aria-label.
const providers = [
  {
    name: "บาคาร่า",
    desc: "เลือกโต๊ะบาคาร่าจากหลายค่ายได้ในระบบเดียว ตรวจสอบระดับเดิมพันก่อนเข้าเล่นได้",
    tag: "หลายค่าย",
    icon: "🃏",
  },
  {
    name: "รูเล็ต",
    desc: "เมนูจัดหมวดหมู่ชัดเจน ค้นหาโต๊ะรูเล็ตที่ต้องการได้จากหน้ารวมเกม",
    tag: "ค้นหาง่าย",
    icon: "🎡",
  },
  {
    name: "คาสิโนสด",
    desc: "อยู่ในระบบเดียวกับบาคาร่าและรูเล็ต ใช้งานผ่านมือถือและคอมพิวเตอร์ได้",
    tag: "ระบบเดียว",
    icon: "🎥",
  },
  {
    name: "เกมเดิมพันประเภทอื่น",
    desc: "ตามรายการที่เปิดให้บริการ ตรวจสอบชื่อค่ายและรายละเอียดเกมได้ก่อนเลือกเข้าเล่น",
    tag: "ตามรายการที่เปิด",
    icon: "🎲",
  },
];

// SAGAME66 palette (ทอง-เงินโครเมียม): แผ่นกระเบื้องเป็นพื้นการ์ด #171006 ในเส้น
// ทองลึก #96671a บนพื้นเพจ #0d0903 ป้ายมุมขวากับปุ่มตอน hover ไล่จากทองสว่าง
// #ffe9a3 ลงทองหลัก #e8b93f ไปจบที่เงินโครเมียม #eef3f8 ซึ่งเป็นลำดับสีเดียวกับ
// โลโก้ที่ตัว SA เป็นทองสามมิติแล้ว GAME เป็นเงินโครเมียม ส่วนกรอบตอน hover ยกขึ้น
// เป็นทองหลัก ชื่อหมวดเป็นทองสว่าง คำอธิบายเป็น BRAND_TEXT #e3d8c0 — แดง-เงินเย็น
// ของ UFAGOOL (#c50d12 #ef1f25 #5e0507 #16100f #0a0708 #f4f7fa #b8c3cf #cdd5dd)
// หายไปทั้งหมด
---

<section aria-label={`หมวดเกมคาสิโนที่ ${BRAND_NAME} เปิดให้เลือกเล่นในระบบเดียว`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2">
    <p class="text-center text-3xl font-black tracking-widest text-[#eef3f8] uppercase">
      หมวดเกมที่เลือกเล่นได้ใน <span class="text-[#e8b93f]">{BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b93f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#96671a] bg-[#171006]/92 p-5 shadow-[0_10px_30px_rgba(13,9,3,0.72)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e8b93f]/80 hover:bg-[#0d0903] hover:shadow-[0_15px_40px_rgba(232,185,63,0.42)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#e8b93f]/14 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe9a3] via-[#e8b93f] to-[#eef3f8] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0d0903] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe9a3] transition-colors group-hover:text-[#eef3f8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e3d8c0]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#96671a] bg-[#0d0903] py-1.5 text-center text-[11px] font-bold text-[#e8b93f] shadow-inner transition-colors duration-300 group-hover:border-[#e8b93f]/70 group-hover:bg-gradient-to-r group-hover:from-[#ffe9a3] group-hover:via-[#e8b93f] group-hover:to-[#eef3f8] group-hover:text-[#0d0903]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
