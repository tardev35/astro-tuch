---
// OSAKA198 is a สล็อต brand. Every tile below stays inside what the brief
// states: เกมสล็อตจากหลายค่ายให้เลือกในบัญชีเดียว, เกมยอดนิยม เกมใหม่ เกมโบนัส
// ฟรีสปิน และสล็อตหลายรูปแบบ, เดิมพันเริ่มต้นระดับต่ำตามเงื่อนไขของแต่ละเกมโดยขั้นต่ำ
// จริงขึ้นอยู่กับผู้ให้บริการ, การรองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์โดยไม่ต้อง
// สมัครแยกหลายบัญชี, โปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข,
// การตรวจโปรโมชั่น ฝากถอน และประวัติการใช้งานผ่านระบบ และแอดมินที่ดูแลตลอด
// 24 ชั่วโมง.
// No tile quotes a payout figure, a guarantee, or a product the brief does not
// name — no บาคาร่า, no แทงบอล, no หวย.
//
// The section title is a <p>: these tiles are chrome, not a docx heading, so the
// <section> takes its accessible name from aria-label instead.
const providers = [
  { name: "สล็อตหลายค่ายในบัญชีเดียว", desc: "เลือกเกมสล็อตจากค่ายที่ระบบเปิดให้บริการได้ผ่านบัญชีเดียว โดยไม่ต้องสมัครแยกหลายบัญชี", tag: "ทุกค่ายในเว็บเดียว", icon: "🎰" },
  { name: "เกมยอดนิยมและเกมใหม่", desc: "หมวดเกมยอดนิยมและเกมที่เพิ่งเปิดให้บริการ ดูรายละเอียดเกมและรูปแบบการเล่นได้ก่อนเริ่มหมุนรอบแรก", tag: "อัปเดตตามค่าย", icon: "🕹️" },
  { name: "เกมโบนัสและฟรีสปิน", desc: "สล็อตที่มีฟีเจอร์โบนัสและฟรีสปินตามที่แต่ละเกมกำหนด ควรอ่านเงื่อนไขของฟีเจอร์ในหน้าเกมก่อนเล่น", tag: "ตามเงื่อนไขเกม", icon: "✨" },
  { name: "เดิมพันเริ่มต้น 1 บาท", desc: "หากเกมที่เลือกเปิดช่วงเดิมพันเริ่มต้น 1 บาทก็เลือกได้ แต่ขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการและแต่ละเกม", tag: "ตรวจช่วงเดิมพันก่อน", icon: "🪙" },
  { name: "โปรโมชั่นสมาชิก", desc: "แนะนำเพื่อนรับโบนัส 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข ควรอ่านยอดที่ใช้คำนวณและรอบการรับก่อนกดรับ", tag: "0.8% และ 0.3%", icon: "🎁" },
  { name: "แอดมิน 24 ชั่วโมง", desc: "สอบถามการเลือกเกม โปรโมชั่น และตรวจสอบรายการสมัคร ฝากถอน ได้ตลอด 24 ชั่วโมงผ่านระบบออนไลน์", tag: "ตลอด 24 ชม.", icon: "🎧" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการของ OSAKA198 ที่ตรวจสอบได้ก่อนเริ่มเล่น" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตและบริการของ <span class="text-[#d8d8d8]">OSAKA198</span> ที่ตรวจสอบได้ก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d1ae72] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#a37c4b]/80 bg-[#141210]/92 p-5 shadow-[0_10px_30px_rgba(11,9,6,0.65)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#d1ae72]/70 hover:bg-[#2c2214] hover:shadow-[0_15px_40px_rgba(209,174,114,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#d1ae72]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f7f1e4] via-[#e4cc95] to-[#a37c4b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0b0906] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e8ddc8] transition-colors group-hover:text-[#f7f1e4]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9a8a68]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a37c4b] bg-[#0b0906] py-1.5 text-center text-[11px] font-bold text-[#e4cc95] shadow-inner transition-colors duration-300 group-hover:border-[#d1ae72]/70 group-hover:bg-gradient-to-r group-hover:from-[#f7f1e4] group-hover:via-[#e4cc95] group-hover:to-[#a37c4b] group-hover:text-[#0b0906]">
            สมัครสมาชิก
          </span>
        </a>
      ))
    }
  </div>
</section>
