---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading across two columns. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { titleleft, titleright, as: HeadingTag = "h2", iconleft = "🎯", iconright = "🏆" } = Astro.props;

// หวยพยัคฆ์ (รอบกรมท่า-ทอง 2026-09-22): การ์ดสองใบเป็นกรมท่า ใบซ้ายอยู่ในกรอบ
// ทองบรอนซ์ #ab6d13 บนพื้นการ์ด #08152f ใบขวาอยู่ในกรอบทองหลัก #fadb6c บนพื้นยก
// #0f2149 — แยกสองใบด้วยความสว่างในโทนเดียวกัน หัวข้อเป็นทองสว่าง #fdf5a4 ตาม
// คำว่า พยัคฆ์ บนโลโก้ ส่วนป้ายไอคอนไล่ทองสว่าง → ทองบรอนซ์ ตัวอักษรบนป้ายใช้
// สีพื้นเพจ #030b1c แดง LOTTOKA เดิมออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#ab6d13]/70 bg-[#08152f]/85 p-6 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.6)] backdrop-blur-md md:p-7">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#fadb6c]/35 pb-3">
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#fdf5a4] to-[#ab6d13] text-sm text-[#030b1c] shadow-[0_0_10px_rgba(250,219,108,0.5)]">
              {iconleft}
            </span>
            <HeadingTag class="text-xl leading-normal font-black tracking-widest text-[#fdf5a4] uppercase drop-shadow-md">{titleleft}</HeadingTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#fadb6c]/45 bg-[#0f2149]/80 p-6 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.6)] backdrop-blur-md md:p-7">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#fadb6c]/35 pb-3">
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#fadb6c] to-[#ab6d13] text-sm text-[#030b1c] shadow-[0_0_10px_rgba(250,219,108,0.5)]">
              {iconright}
            </span>
            <HeadingTag class="text-xl leading-normal font-black tracking-widest text-[#fdf5a4] uppercase drop-shadow-md">{titleright}</HeadingTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
