---
export interface Props {
  /** The section's own docx heading — the ONLY heading this box ever emits.
   *  The two column labels below are chrome (they name a card, not a section
   *  of the brief), so they render as <p> no matter what is passed here. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  /** Accessible name for the <section> when no `title` is passed. With a
   *  `title` the heading names the region and the aria-label is dropped. */
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🎫", iconright = "🔎" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Shape change 2026-09-24: the docx heading used to be duplicated into both
// column headings, which put two tags on one brief section. One section header
// above the grid carries it now, and the per-card labels dropped to <p>.
//
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H2 #2 — บรีฟมีสองย่อหน้าในหัวข้อนั้น (content.txt
// บรรทัด 6 กับ 7) จึงลงคอลัมน์ละย่อหน้า กล่องนี้ปล่อย heading ของบรีฟออกมาใบเดียว
// ส่วนป้ายสองคอลัมน์เป็นถ้อยคำจัดเลย์เอาต์ของหน้าเอง ไม่ใช่หัวข้อในบรีฟ จึงเป็น <p>
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// สองใบแยกกันด้วย "คู่โลหะ" ของโลโก้เอง ไม่ใช่ด้วยความสว่างของสีเดียว — โลโก้เขียน
// คำว่า "ดีใจ" ด้วยแดงเมทัลลิกและคำว่า "หวย" ด้วยเงินโครเมียม ใบซ้ายจึงเป็นฝั่งแดง
// ผิวการ์ด #17080c ในกรอบแดงแบรนด์ #dc0409 ป้ายไอคอนไล่แดงสว่าง #f5363d → แดงลึก
// #8e0206 บนหมึกสว่าง #edeaf0 (พื้นแดงเข้มต้องใช้หมึกสว่างเสมอ) ป้ายคอลัมน์เป็นแดง
// สว่าง #f5363d ส่วนใบขวาเป็นฝั่งเงินโครเมียม ผิวการ์ดลึกกว่าเป็น #0d0407 ในกรอบ
// เงินกลาง #c3c7d1 ป้ายไอคอนไล่เงินสว่าง #eef0f4 → เงินหม่น #8d93a1 บนหมึกเข้ม
// #0d0407 (พื้นเงินสว่างต้องใช้หมึกเข้มเสมอ) ป้ายคอลัมน์เป็นเงินกลาง #c3c7d1
// หัวข้อ docx ไล่แดงสว่าง #f5363d → ทอง #f3c54e → เงินสว่าง #eef0f4 ซึ่งกลับทางกับ
// ContentBox / Faq4 ที่ไล่เงินสว่างไปหาแดง จะได้ไม่อ่านเป็นการ์ดใบเดิมซ้ำ
// เนื้อความ #edeaf0 (= BRAND_TEXT) glow เป็น rgba(220,4,9,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…)
// rgba(252,212,195,…) rgba(12,11,10,…)) ออกครบทุกจุดแล้ว
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex flex-col gap-3 border-b border-[#4b0205] pb-4">
        <HeadingTag class={`bg-gradient-to-r from-[#f5363d] via-[#f3c54e] to-[#eef0f4] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="h-[3px] w-24 rounded-full bg-gradient-to-r from-[#f5363d] via-[#dc0409] to-[#c3c7d1] shadow-[0_0_10px_rgba(220,4,9,0.55)]" />
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#dc0409]/70 bg-[#17080c]/92 p-6 text-left text-base leading-relaxed text-[#edeaf0] shadow-[0_10px_30px_rgba(13,4,7,0.72)] backdrop-blur-md md:p-7">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#dc0409]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5363d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5363d]/60 bg-gradient-to-br from-[#f5363d] to-[#8e0206] text-sm text-[#edeaf0] shadow-[0_0_10px_rgba(220,4,9,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#c3c7d1]/40 bg-[#0d0407]/92 p-6 text-left text-base leading-relaxed text-[#edeaf0] shadow-[0_10px_30px_rgba(13,4,7,0.72)] backdrop-blur-md md:p-7">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#c3c7d1]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#c3c7d1] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#eef0f4]/70 bg-gradient-to-br from-[#eef0f4] to-[#8d93a1] text-sm text-[#0d0407] shadow-[0_0_10px_rgba(195,199,209,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
