---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article class="flex flex-col gap-4 rounded-2xl border border-[#2c4d84]/55 bg-[#04122b]/85 p-6 text-left text-base leading-relaxed text-[#d5e3f7] shadow-[0_10px_30px_rgba(1,9,27,0.5)] backdrop-blur-md md:p-7">
      {
        titleleft && (
          <h2 class="flex items-center gap-3 border-b border-[#dfb455]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#f7d979] uppercase drop-shadow-md">
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#f7d979] to-[#a87a1e] text-sm text-[#01091b] shadow-[0_0_10px_rgba(223,180,85,0.5)]">
              🎧
            </span>
            {titleleft}
          </h2>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 rounded-2xl border border-[#1d3a68]/70 bg-[#061733]/85 p-6 text-left text-base leading-relaxed text-[#d5e3f7] shadow-[0_10px_30px_rgba(1,9,27,0.5)] backdrop-blur-md md:p-7">
      {
        titleright && (
          <h2 class="flex items-center gap-3 border-b border-[#dfb455]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#f7d979] uppercase drop-shadow-md">
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#8fc3ec] to-[#12508f] text-sm text-[#01091b] shadow-[0_0_10px_rgba(61,143,216,0.5)]">
              🛡️
            </span>
            {titleright}
          </h2>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
