---
export interface Props {
  /** The section's own docx heading — the ONLY heading this box ever emits.
   *  The two column labels below are chrome (they name a card, not a section
   *  of the brief), so they render as <p> no matter what is passed here. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  /** Accessible name for the <section> when no `title` is passed. With a
   *  `title` the heading names the region and the aria-label is dropped. */
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🎫", iconright = "🔎" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Shape change 2026-09-24: the docx heading used to be duplicated into both
// column headings, which put two tags on one brief section. One section header
// above the grid carries it now, and the per-card labels dropped to <p>.
//
// รวย168 (ดรอป 2026-10-23, .claude/brand-spec-ruay168.md §2–§4): กล่องนี้ถือ
// **docx H2 §2** ของหน้าแรก (รัฐบาลไทย ลาว ฮานอย ออมสิน บาทละ1,000 —
// content.txt บรรทัด 6) บรีฟเขียนหัวข้อนั้นเป็นย่อหน้าเดียวยาว หน้าแรกจึงผ่าครึ่ง
// ลงคอลัมน์ละครึ่ง: ซีกซ้าย = ประเภทหวยกับวันประกาศผล · ซีกขวา = อัตราจ่ายบาทละ
// 1,000 ฐานเงินเดิมพัน และวงเงินจ่ายสูงสุด และ **ไม่ส่ง titleleft/titleright**
// เพราะบรีฟไม่ได้ตั้งชื่อย่อยให้สองครึ่งนั้น การคิดป้ายขึ้นมาเองจะเป็นถ้อยคำของหน้า
// ไม่ใช่ของบรีฟ (คลาสของป้ายสองใบยัง retheme ไว้ครบในฐานะ inventory ของแบรนด์ถัดไป)
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ⚠️ **ธีมมืดสนิท** — bg.json = {"mode":"color","color":"#000000"} ลำดับผิว:
// #1c1a16 ยก (ใบขวา) · #121110 การ์ด (ใบซ้าย) · #070707 จม · #000000 พื้นเพจ
// หมึก **#f3ece0** (= BRAND_TEXT, 16.0:1 บนใบซ้าย · 14.5:1 บนใบขวา)
// **ห้ามแก้การ์ดกลับไปเป็นพื้นสว่าง** — รอบก่อนของไฟล์นี้เป็นธีมสว่างการ์ดขาว
//
// สองใบในกล่องนี้แยกกันด้วย **วัสดุ** ตรงตามอาร์ตเวิร์กที่เป็นคู่ ทอง×โครเมียมเงิน:
// ใบซ้ายเป็น **ใบทอง** (ผิวการ์ด #121110 ในกรอบทองลึก #9d6f06 ป้ายไอคอนเป็นแผ่นถม
// ทองไล่ #ffd94a → #e3a712 บนหมึกดำ #0a0a0a) ส่วนใบขวาเป็น **ใบโครเมียม** (ผิวยก
// #1c1a16 ในกรอบเทาเงิน #6b7079 ป้ายไอคอนเป็นแผ่นจม #070707 ขอบเงินบนหมึกแพลทินัม
// #dde1e7) — ทองลอยอยู่ซ้าย เงินจมอยู่ขวา อ่านออกทันทีโดยไม่ต้องใช้ฮิวที่สาม
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1** — แผ่นถมทองใบซ้ายจึงถือหมึก **#0a0a0a**
// (14.6:1 ใต้ #ffd94a · 9.2:1 ใต้ #e3a712) **ห้ามพลิกไปใช้หมึกขาวเด็ดขาด**
// หัวข้อ docx เป็น **ทอง #ffd94a ทึบสีเดียว** (15.4:1 บนพื้นเพจ) ไม่ใช่ไล่เฉด —
// ต่างจาก §1 (ContentBoxHuay) ที่ไล่ ทอง→เงิน→ทอง และ §5 ที่ไล่สามสต็อปคนละชุด
// จึงไม่อ่านเป็นการ์ดใบเดิมซ้ำบนหน้าเดียวกัน ขีดใต้หัวข้อเป็น **พื้นถม** จึงไล่
// #ffd94a → #e3a712 → #e8eaee ได้
// ⚠️ ค่าที่ **ห้ามถือตัวอักษร** รอบนี้: #9d6f06 (4.7:1) · #6b7079 (4.2:1) ·
// #b4b9c2 · #3d3425 · ทุกผิว — เป็นขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #ffd94a** และเป็นงานของหน้าเพจ
// ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(157,111,6,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทอง/เหลืองเคยนำมาแล้วเกือบทุกแบรนด์
// ในรีโปนี้** ทองรอบนี้คือ #ffd94a / #e3a712 / #9d6f06 เท่านั้น
// ⚠️⚠️ **มาดาม168 เป็นแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**: ff2e52 e01238 c9102f
// 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9
// ชุดที่เพิ่งอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้ว: **สาธุ168** เขียวมรกตธีมสว่าง
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ·
// **หวยดีใจ** แดงแบรนด์-เงินโครเมียม (dc0409 f5363d 8e0206 17080c 0d0407 c3c7d1
// eef0f4 8d93a1 edeaf0 f3c54e 4b0205) · **หวยคิง** ทองโลหะ-ครีมอมพีช ซึ่งเป็น
// เจ้าของเดิมของตระกูล *Huay (cd9a2c fdeb7c ab7314 fcd4c3 fce2d4 1c140b 0c0b0a
// 5c3f12 120a02 f5e7c8) · **มีทรัพย์168** ชมพูบานเย็น (dd1b74 a4186b 4a0d35 2d0720
// f7dcf6 f0ccf5)
// ⚠️ ทองของแบรนด์อื่นที่ต้อง grep ทีละค่า: fbc134 ffe87a cf9a18 96690a (NAZA168
// ตัวละติน) · f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12 fded41 9f600d (พักยก168) ·
// f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71 (ufalion168) · e5a81b ffe08a bb8410
// 7d5a07 (UFA324) · fee45d e6a416 b8780d (ยูฟ้า168) · fef54b (นินจา168) · fdcb0c
// fefb6b 8a6504 (สบาย168) · f9a826 (รวยแทร่168) · ffc82e (สบายเบท168) · e3b23c
// (สมหวัง168) · dcb95f b8862b 96681f (รวยแท้168) · fcd434 (มีโชค168) · f0bb4e
// (รวยเทพ168) · fcd45c (มีเฮ168) · f0b429 ffdc8c (รับตัง168) · f0c878
// (ดวงเศรษฐี168) · ffc93c ffeab0 (หวย365) · f5b61d (PIGPG)
// ⚠️⚠️ **ffd84d ของ ถอนชัวร์168 ห่างจาก #ffd94a แค่ G1** — เจอที่ไหนคือพิมพ์ผิด
// ⚠️ แรมป์เทาเงินของแบรนด์อื่น: e0e0df c0c0bf a1a09e (พักยก168) · e8ecf1 a8b2bf
// 78828f 5a6472 (ยูฟ้า168) · 8792a0 b9c2cc 464f5a (UFA324) · cfd9e6 (รับตัง168) ·
// fdfcfd b4bcc2 eceaea (GT66B) · d9c9a6 cfd6e3 (NAZA168 ตัวละติน) · cfdcec 9db4d4
// dde8f7 (TSDET911)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** (แดงคือสีของแบรนด์ขาออก และตระกูล *Huay เคย
// ship เป็นแดง/ทอง) **ไม่มีชมพู ไม่มีน้ำเงิน/ฟ้า/ไซยาน ไม่มีม่วง ไม่มีส้ม
// ไม่มีเขียว ไม่มีครีม ไม่มีพีช ไม่มีน้ำตาล**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex flex-col gap-3 border-b border-[#3d3425] pb-4">
        <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#ffd94a] uppercase`}>{title}</HeadingTag>
        <div aria-hidden="true" class="h-[3px] w-24 rounded-full bg-gradient-to-r from-[#ffd94a] via-[#e3a712] to-[#e8eaee] shadow-[0_0_10px_rgba(227,167,18,0.45)]" />
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article class="flex flex-col gap-4 rounded-2xl border border-[#9d6f06]/65 bg-[#121110] p-6 text-left text-base leading-relaxed text-[#f3ece0] shadow-[0_10px_30px_rgba(0,0,0,0.55)] md:p-7">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3d3425] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd94a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9d6f06] bg-gradient-to-br from-[#ffd94a] to-[#e3a712] text-sm text-[#0a0a0a] shadow-[0_0_10px_rgba(227,167,18,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 rounded-2xl border border-[#6b7079]/55 bg-[#1c1a16] p-6 text-left text-base leading-relaxed text-[#f3ece0] shadow-[0_10px_30px_rgba(0,0,0,0.5)] md:p-7">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b7079]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#dde1e7] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6b7079] bg-[#070707] text-sm text-[#dde1e7] shadow-[0_0_10px_rgba(232,234,238,0.18)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
