---
export interface Props {
  titleleft?: string;
  titleright?: string;
  /** Both column headings render at this level, set from the docx's outline.
   *  Pass only the heading(s) the docx actually has — an unpassed title emits
   *  no tag at all, so this box can carry one docx heading across two columns. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { titleleft, titleright, as: HeadingTag = "h2", iconleft = "🎯", iconright = "🏆" } = Astro.props;

// LOTTOKA: การ์ดสองใบเป็นดำอมแดง ใบซ้ายขอบแดงโลโก้ ใบขวาขอบแดงสด หัวข้อเป็นครีม
// #ffe9ea ตามตัว KA ขาวของโลโก้ — ทอง/เขียวของแบรนด์หวยรุ่นก่อนถูกถอดออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#c21e22]/70 bg-[#140a0c]/85 p-6 text-left text-base leading-relaxed text-[#ded9da] shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-md md:p-7">
      {
        titleleft && (
          <HeadingTag class="flex items-center gap-3 border-b border-[#e2353a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9ea] uppercase drop-shadow-md">
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#ffe9ea] to-[#7d1114] text-sm text-[#0a0608] shadow-[0_0_10px_rgba(226,53,58,0.5)]">
              {iconleft}
            </span>
            {titleleft}
          </HeadingTag>
        )
      }
      <slot name="left" />
    </article>

    <article
      class="flex flex-col gap-4 rounded-2xl border border-[#e2353a]/45 bg-[#3a0709]/70 p-6 text-left text-base leading-relaxed text-[#ded9da] shadow-[0_10px_30px_rgba(0,0,0,0.55)] backdrop-blur-md md:p-7">
      {
        titleright && (
          <HeadingTag class="flex items-center gap-3 border-b border-[#e2353a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9ea] uppercase drop-shadow-md">
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#e2353a] to-[#7d1114] text-sm text-[#ffe9ea] shadow-[0_0_10px_rgba(226,53,58,0.5)]">
              {iconright}
            </span>
            {titleright}
          </HeadingTag>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
