---
export interface Props {
  /** The section's own docx heading — the ONLY heading this box ever emits.
   *  The two column labels below are chrome (they name a card, not a section
   *  of the brief), so they render as <p> no matter what is passed here. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  /** Accessible name for the <section> when no `title` is passed. With a
   *  `title` the heading names the region and the aria-label is dropped. */
  label?: string;
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label, iconleft = "🎫", iconright = "🔎" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Shape change 2026-09-24: the docx heading used to be duplicated into both
// column headings, which put two tags on one brief section. One section header
// above the grid carries it now, and the per-card labels dropped to <p>.
//
// บนหน้าแรกรอบนี้กล่องนี้ถือ **docx H2 §3** (โปรโมชั่นแทงหวย…รับได้ไม่จำกัดยูส) —
// บรีฟเขียนหัวข้อนั้นเป็นย่อหน้าเดียวยาว (content.txt บรรทัด 8) หน้าแรกจึงผ่าครึ่ง
// ลงคอลัมน์ละครึ่ง และ **ไม่ส่ง titleleft/titleright** เพราะบรีฟไม่ได้ตั้งชื่อย่อย
// ให้สองครึ่งนั้น การคิดป้ายขึ้นมาเองจะเป็นถ้อยคำของหน้า ไม่ใช่ของบรีฟ
// (คลาสของป้ายสองใบยังถูก retheme ไว้ครบ เพราะมันเป็น inventory ของแบรนด์ถัดไป)
//
// สาธุ168 (รอบ **เขียวมรกตนำ · ทองสัมฤทธิ์รอง · ธีมสว่าง** 2026-10-21,
// brand-spec §2): ⚠️ **ธีมสว่าง** — bg.json = #d8ffc7 ลำดับความลึกคือ
// #ffffff ผิวยก / #e9fbdd ชั้นกลาง / #d8ffc7 พื้นเพจ หมึก **เขียวป่า #0c3a16**
// (= BRAND_TEXT, 12.9:1 บนผิวยก และ 11.8:1 บนผิวอินเซ็ต)
//
// สองใบในกล่องนี้แยกกันด้วย **ความลึกของผิว** ไม่ใช่ด้วยฮิวคนละตัว เพราะรอบนี้มี
// ฮิวเดียวจริงๆ บนโซนเนื้อหา (ทองเป็นของโครมเท่านั้น): ใบซ้ายเป็น **ผิวยก #ffffff**
// ในกรอบเขียวมรกต #0b7d28 ส่วนใบขวาเป็น **ผิวอินเซ็ต #e9fbdd** ในกรอบเขียวเข้ม
// #0a5f1c — ขาวลอยขึ้น มิ้นต์จมลง เป็นคู่ที่อ่านออกทันทีโดยไม่ต้องใช้สีที่สอง
// ป้ายไอคอนก็กลับขั้วกันตามผิว: ใบซ้ายเป็นแผ่นถมเขียวไล่ #0b7d28 → #0a5f1c บน
// ตัวอักษรขาว (5.3:1 / 7.9:1) ใบขวาเป็นแผ่นขาวขอบเขียวบนหมึก #0c3a16 (12.9:1)
// หัวข้อ docx ไล่ **เขียวมรกต #0b7d28 → เขียวเข้ม #0a5f1c → #0b7d28** ซึ่งเป็น
// ลำดับย้อนศรของ ContentBoxHuay (§1) ที่ไล่ #0a5f1c → #0b7d28 → #0a5f1c จะได้ไม่
// อ่านเป็นการ์ดใบเดิมซ้ำบนหน้าเดียวกัน
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ไม่ใช่พื้นหลัง ทุกสต็อป
// ต้องถือตัวอักษรได้ — ห้ามเอา **เขียวใบตอง #0f9b35** (3.7:1) มาเป็นสต็อป ในไฟล์นี้
// มันอยู่ที่ **ขีดใต้หัวข้อ** ซึ่งเป็นพื้นถม ไม่ใช่ตัวอักษร
// ⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ไม่มีในไฟล์นี้เลยสักค่า** — บนการ์ดขาว
// ทองได้ 1.7–2.8:1 §2 จึงให้ทองอยู่ได้เฉพาะบนโครมเข้ม
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — รอบนี้เทียบง่ายเพราะ **ไม่มีแบรนด์ไหน
// ในรีโปนี้เคยใช้เขียวเป็นสีนำ** (ระยะใกล้สุดมากกว่า 100) ชุดแดงแบรนด์-เงินโครเมียม
// ของ **หวยดีใจ** ที่เพิ่งอยู่ในไฟล์นี้ทั้งไฟล์ (dc0409 f5363d 8e0206 17080c 0d0407
// c3c7d1 eef0f4 8d93a1 edeaf0 f3c54e 4b0205 rgba(220,4,9,…) rgba(13,4,7,…)
// rgba(195,199,209,…)) ชุดทองโลหะ-ครีมอมพีชของ **หวยคิง** ซึ่งเป็นเจ้าของเดิมของ
// ตระกูล *Huay (cd9a2c fdeb7c ab7314 fcd4c3 fce2d4 1c140b 0c0b0a 5c3f12 120a02
// f5e7c8) และชุดชมพูบานเย็นของรอบขาออก **มีทรัพย์168** (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีเงิน/โครเมียม ไม่มีฟ้า/น้ำเงิน
// ไม่มีม่วง ไม่มีบรอนซ์ส้ม ไม่มีโรสโกลด์ และไม่มีทองบนการ์ด**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex flex-col gap-3 border-b border-[#0b7d28]/40 pb-4">
        <HeadingTag class={`bg-gradient-to-r from-[#0b7d28] via-[#0a5f1c] to-[#0b7d28] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="h-[3px] w-24 rounded-full bg-gradient-to-r from-[#0a5f1c] via-[#0f9b35] to-[#0b7d28] shadow-[0_0_10px_rgba(11,125,40,0.45)]" />
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article class="flex flex-col gap-4 rounded-2xl border border-[#0b7d28]/55 bg-[#ffffff] p-6 text-left text-base leading-relaxed text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.14)] md:p-7">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#0b7d28]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0a5f1c]/60 bg-gradient-to-br from-[#0b7d28] to-[#0a5f1c] text-sm text-[#ffffff] shadow-[0_0_10px_rgba(11,125,40,0.35)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 rounded-2xl border border-[#0a5f1c]/40 bg-[#e9fbdd] p-6 text-left text-base leading-relaxed text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.12)] md:p-7">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#0a5f1c]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#0a5f1c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0b7d28]/60 bg-[#ffffff] text-sm text-[#0c3a16] shadow-[0_0_10px_rgba(10,95,28,0.22)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
