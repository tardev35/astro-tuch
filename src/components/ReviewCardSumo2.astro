---
// Casino brand — every row stays inside what the brief names: บาคาร่า คาสิโนสด
// สล็อต หวย มวย และฟุตบอล ในบัญชีเดียว, การตรวจกติกา อัตราจ่าย และรายละเอียดการเดิมพัน
// ก่อนยืนยัน, โปรคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไข, การสมัคร/Login และ
// แอดมิน 24 ชั่วโมง. Nothing here promises a payout, an RTP figure, or a studio the
// brief does not state.
const reviews = [
  {
    name: "สมาชิกที่สลับเล่นหลายหมวดในบัญชีเดียว",
    role: "เปิดบาคาร่า สล็อต และบอลจากระบบเดียวกัน",
    stars: 5,
    tag: "ครบทุกแนวในบัญชีเดียว",
    content:
      "เปิดผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม ในระบบแบ่งหมวดไว้ทั้งบาคาร่า คาสิโนสด สล็อต หวย มวย และฟุตบอล จึงเลือกหมวดแล้วดูกติกากับอัตราจ่ายของรายการนั้นก่อนยืนยันการเดิมพันได้ทุกครั้ง",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่อ่านเงื่อนไขโบนัสก่อนกดรับ",
    role: "ตรวจรอบคำนวณและยอดที่เข้าเงื่อนไขก่อนรับสิทธิ์",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%",
    content:
      "โบนัส 0.3% เป็นโปรคืนยอดเสียสำหรับยอดที่เข้าเงื่อนไข ส่วน 0.8% มาจากกิจกรรมแนะนำเพื่อน ในบัญชีสมาชิกแสดงยอดที่ใช้คำนวณและสิทธิ์ที่รับได้ให้ตรวจก่อน จึงเห็นรอบคำนวณ ยอดขั้นต่ำ และเงื่อนไขการถอนของแต่ละรายการชัดเจนก่อนตัดสินใจ",
    avatar: "🤝",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนเข้าโต๊ะ Live",
    role: "แจ้งเวลาและรายละเอียดปัญหาแล้วได้รับการตรวจสอบ",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "เข้าโต๊ะคาสิโนสดไม่ได้และเครดิตยังไม่ขึ้น จึงแจ้งเวลาและรายละเอียดให้แอดมิน ทีมงานช่วยตรวจสอบระบบและแนะนำขั้นตอนต่อจนจบ พร้อมย้ำว่าแต่ละโต๊ะ Live มาจากผู้ให้บริการต่างกัน และผลของเกมไม่สามารถรับประกันล่วงหน้าได้ ควรกำหนดงบประมาณก่อนเล่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BETPLAY369" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f4ebff] via-[#22c6f0] to-[#e5399f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f4ebff]">BETPLAY369</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e5399f] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e5399f]/40 bg-[#10041d]/92 px-6 py-4 shadow-[0_10px_30px_rgba(229,57,159,0.16)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd54a] to-[#e5399f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a48fc4] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#6d1750]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd54a]" : "text-[#1a0730]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dfd0ee]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#6d1750]/65 bg-[#10041d]/92 p-6 text-left shadow-[0_10px_30px_rgba(6,2,11,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e5399f]/70 hover:shadow-[0_15px_40px_rgba(229,57,159,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#22c6f0] to-[#e5399f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1a0730]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#e5399f]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#6d1750]/70 bg-[#08030f] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f4ebff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e5399f]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd54a]" : "text-[#1a0730]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dfd0ee]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6d1750] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e5399f]/45 bg-gradient-to-br from-[#ff35b4] via-[#e5399f] to-[#6d1750] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#22c6f0] transition-colors group-hover:text-[#f4ebff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a48fc4] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
