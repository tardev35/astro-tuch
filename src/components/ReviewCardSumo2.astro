---
// คาสิโนตรง brand — every row stays inside what the brief names: รวมเกมเดิมพัน
// ออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่าและคาสิโนสด แทงบอลตามรายการที่เปิด
// ให้บริการ สล็อตออนไลน์หลายค่าย และหวยออนไลน์ตามรอบที่กำหนด, การเลือกหมวดเกม
// ผ่านบัญชีเดียวและการตรวจกติกา อัตราจ่าย รายละเอียดการเดิมพันก่อนยืนยันรายการ,
// ความเสี่ยงที่ต่างกันของแต่ละเกมและการกำหนดงบประมาณของตัวเอง, โบนัสแนะนำเพื่อน
// 0.8% ที่ผู้ถูกแนะนำต้องมีรายการตามข้อกำหนด, คืนยอดเสีย 0.3% ตามรอบ, ระบบฝากถอน
// ออโต้ และการติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ตรวจกติกาและอัตราจ่ายก่อนยืนยันรายการทุกครั้ง",
    stars: 5,
    tag: "บาคาร่า · แทงบอล",
    content:
      "เข้ามาเพราะอยากได้ที่เดียวที่มีทั้งบาคาร่าและแทงบอล ไม่ต้องสลับหลายบัญชี พอเลือกหมวดเกมจากหน้าเดียวได้ก็ไล่ดูกติกา อัตราจ่าย และรายละเอียดการเดิมพันก่อนยืนยันรายการได้ครบ เข้าใจตรงกันว่าแต่ละเกมมีรูปแบบและความเสี่ยงต่างกัน เลยกำหนดงบประมาณของตัวเองไว้ก่อนเริ่มทุกครั้ง",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ว.",
    role: "อ่านยอดที่ใช้คำนวณและรอบการรับก่อนกดรับสิทธิ์",
    stars: 5,
    tag: "โบนัส 0.8% · คืนยอดเสีย 0.3%",
    content:
      "แชร์ลิงก์แนะนำให้เพื่อนแล้วเข้าใจว่าการแชร์อย่างเดียวยังไม่ได้โบนัสทันที เพราะโปรกำหนดให้เพื่อนต้องสมัครและมีรายการตรงตามข้อกำหนดก่อน ระบบถึงคำนวณโบนัส 0.8% ให้ ส่วนคืนยอดเสีย 0.3% ก็ตรวจประเภทเกม รอบคำนวณ และเงื่อนไขการถอนจากหน้าโปรโมชั่นให้เรียบร้อยก่อนกดรับทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการให้แอดมิน",
    stars: 4,
    tag: "ฝากถอนออโต้ · แอดมิน 24 ชม.",
    content:
      "ฝากผ่านวอลเลทแล้วเครดิตยังไม่เข้า เลยเช็กสถานะรายการในหน้าฝากถอนก่อน จากนั้นทักแอดมินพร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ ทีมงานตรวจสอบให้ได้ตรงจุดและติดต่อได้ตลอด 24 ชั่วโมง ทีมงานยังย้ำว่าไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่นไม่ว่ากรณีใด",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GPSS789" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffeec2] via-[#e8bf5f] to-[#a67a2a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#c2cad3]">GPSS789</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d9a441] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#d9a441]/40 bg-[#14100a]/92 px-6 py-4 shadow-[0_10px_30px_rgba(217,164,65,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffeec2] to-[#a67a2a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8b939c] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#d9a441]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d9a441]" : "text-[#4a300a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8dcc4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#d9a441]/40 bg-[#14100a]/92 p-6 text-left shadow-[0_10px_30px_rgba(6,4,2,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f2c14e]/70 hover:shadow-[0_15px_40px_rgba(217,164,65,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffeec2] to-[#7a5312] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#d9a441]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#c2cad3]/22"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#d9a441]/45 bg-[#060402] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2c14e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#d9a441]" : "text-[#4a300a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8dcc4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#d9a441]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d9a441]/55 bg-gradient-to-br from-[#ffeec2] via-[#d9a441] to-[#7a5312] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2c14e] transition-colors group-hover:text-[#f5d98a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8b939c] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
