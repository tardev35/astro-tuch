---
const reviews = [
  {
    name: "สมาชิกที่ปั่นสล็อตผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้วเข้าสู่ระบบได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ระบบจัดหมวดหมู่ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส และสล็อตแจ็คพอตไว้ให้ค้นหาง่าย สลับค่ายเกมได้จากบัญชีเดียว",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามโปรโมชั่นเป็นประจำ",
    role: "ตรวจสอบเงื่อนไขก่อนกดรับโบนัสทุกครั้ง",
    stars: 5,
    tag: "โปรโมชั่นและคอมมิชชั่น",
    content:
      "หน้าโปรโมชั่นแสดงเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และเงื่อนไขการถอนไว้ครบ ทำให้ดูได้ว่าสิทธิ์คอมมิชชั่นของตนเองอยู่ที่เท่าไร และยอดส่วนไหนเข้าเงื่อนไข จึงตรวจสอบรายละเอียดให้ครบก่อนเข้าร่วมได้ทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ฝากถอนอัตโนมัติ",
    content:
      "ส่งคำขอถอนผ่านระบบอัตโนมัติแล้วรายการยังค้าง จึงแจ้งเวลาที่ทำรายการกับรายละเอียดไป แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาปั่นเกมรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JAIDEE928" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4a0b8f] via-[#9d16f1] to-[#e8e6ee] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#c47bff]">JAIDEE928</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#9d16f1] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#9d16f1]/35 bg-[#150726]/92 px-6 py-4 shadow-[0_10px_30px_rgba(157,22,241,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#e8e6ee] to-[#4a0b8f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a892bd] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a0b8f]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#c47bff]" : "text-[#2c045c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece0fb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#4a0b8f]/50 bg-[#150726]/92 p-6 text-left shadow-[0_10px_30px_rgba(157,22,241,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#9d16f1]/60 hover:shadow-[0_15px_40px_rgba(157,22,241,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#4a0b8f] to-[#c47bff] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2c045c]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#e53cfe]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#4a0b8f]/50 bg-[#06020e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c47bff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#9d16f1]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#c47bff]" : "text-[#2c045c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece0fb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a0b8f] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#9d16f1]/40 bg-gradient-to-br from-[#e0b7ff] via-[#9d16f1] to-[#2c045c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e8e6ee] transition-colors group-hover:text-[#c47bff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a892bd] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
