---
// PAOTUNG is a multi-game portal — every row stays inside what the brief states:
// ศูนย์รวมเกมออนไลน์แบบ One-Stop Service ในรูปแบบ Portal & Privilege, เดิมพัน
// เริ่มต้นเพียง 1 บาท ทุกค่ายเกม, สล็อตลิขสิทธิ์แท้ที่จัดเต็มด้วยแสงเงาแบบ
// Cinematic Lighting, บาคาร่าและคาสิโนสดจากโต๊ะวีไอพีที่ส่งสัญญาณภาพสดจาก
// คาสิโนชั้นนำ, หวยรัฐบาล หวยลาว หวยฮานอย ที่จ่ายเต็มไม่มีอั้น, เดิมพันกีฬา มวย
// และฟุตบอลครบทุกลีก, โปรโมชั่นอัตโนมัติ 100% ที่ไม่ล็อคยูส, แนะนำเพื่อน 0.8%
// จากทุกยอดการเดิมพันของเพื่อน, คืนยอดเสีย 0.3% ในทุกยอดการเล่น, ระบบฝาก-ถอน
// อัตโนมัติภายใน 3-5 วินาที ตลอด 24 ชั่วโมง, การเข้าใช้งานได้ทุกอุปกรณ์โดยไม่ต้อง
// โหลดแอปพลิเคชัน, และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// Nothing here promises a payout or a win rate.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Gold metallic carries
// the score/quote furniture and the logo's primary blue carries the identity
// rail, so the navy + gold pairing the brief names is doing work on both halves.
// The previous brand's red ledger tag is now blue.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ทุนหลักสิบที่เริ่มจากเดิมพัน 1 บาท",
    stars: 5,
    tag: "เดิมพันเริ่มต้น 1 บาท",
    content:
      "ที่ตัดสินใจสมัครเพราะขั้นต่ำเริ่มที่ 1 บาทจริงตามที่ประกาศไว้ ทุนหลักสิบก็เข้ามาลองได้ทั้งสล็อต บาคาร่า และหวย ไม่ต้องเติมก้อนใหญ่ก่อนถึงจะเล่นได้ เกมเป็นลิขสิทธิ์แท้ครบทุกค่ายจากในเว็บเดียว เลือกได้จากหน้า Portal หน้าเดียวไม่ต้องสลับหลายเว็บ",
    avatar: "🪙",
  },
  {
    name: "คุณศิริพร ว.",
    role: "เล่นครบทั้งสี่หมวดจากบัญชีเดียว",
    stars: 5,
    tag: "One-Stop Service",
    content:
      "ชอบที่ PAOTUNG รวมทุกอย่างไว้ที่เดียวแบบ One-Stop Service สล็อตกราฟิกคมชัดจัดเต็มด้วยแสงเงาแบบ Cinematic Lighting โต๊ะบาคาร่าคาสิโนสดส่งสัญญาณภาพสดจากคาสิโนชั้นนำ หวยมีทั้งรัฐบาล ลาว และฮานอย จ่ายเต็มไม่มีอั้น ส่วนคอกีฬาก็มีมวยกับฟุตบอลครบทุกลีก อินเทอร์เฟซโทนกรมท่าสลับสีทองเมทัลลิคดูพรีเมียมทุกครั้งที่เข้าใช้งาน",
    avatar: "🃏",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ทำรายการเองและกดรับสิทธิ์โปรโมชั่นผ่านหน้าเว็บ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ฝาก-ถอนเป็นระบบอัตโนมัติ (Auto) ทั้งหมด รองรับทุกธนาคารชั้นนำ ทำรายการเสร็จภายใน 3-5 วินาที และทำเองได้ตลอด 24 ชั่วโมง โปรโมชั่นก็ทำงานอัตโนมัติ 100% แบบไม่ล็อคยูส ทั้งคอมมิชชั่นแนะนำเพื่อน 0.8% จากทุกยอดการเดิมพันของเพื่อน และคืนยอดเสีย 0.3% ในทุกยอดการเล่น เข้าเล่นผ่านมือถือทั้ง iOS และ Android แท็บเล็ต หรือพีซี ก็ไหลลื่นโดยไม่ต้องโหลดแอปพลิเคชัน ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PAOTUNG" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5e3b3] via-[#e0bd72] to-[#054e83] shadow-[0_0_12px_rgba(224,189,114,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#eef6fd] uppercase sm:text-3xl">
        เสียงจากสมาชิก PAO<span class="text-[#e0bd72]">TUNG</span>
      </p>
      <span class="text-xs tracking-wide text-[#cfdeed]/60">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเริ่มเดิมพันที่ 1 บาท การเล่นครบทั้งสี่หมวดเกมจากบัญชีเดียว และการทำรายการฝาก-ถอนอัตโนมัติด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#226ca9] border-l-[#e0bd72] bg-[#04203c]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,15,30,0.72)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f5e3b3] to-[#e0bd72] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#cfdeed]/60">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#226ca9] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e0bd72]" : "text-[#226ca9]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cfdeed]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#226ca9]/50 bg-[#020f1e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#7fc4f0] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#226ca9] bg-[#04203c]/92 p-5 shadow-[0_10px_30px_rgba(2,15,30,0.72)] backdrop-blur-xl transition-all duration-300 hover:border-[#3b9ddd]/70 hover:shadow-[0_15px_40px_rgba(34,108,169,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e0bd72]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#e0bd72]/22"
          />

          <div class="flex items-center gap-4 border-b border-[#226ca9] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#226ca9]/60 bg-gradient-to-br from-[#7fc4f0] via-[#3b9ddd] to-[#054e83] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f5e3b3] transition-colors group-hover:text-[#eef6fd]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#cfdeed]/60">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e0bd72]" : "text-[#226ca9]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e0bd72]/60 bg-[#020f1e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5e3b3] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e0bd72]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#cfdeed]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
