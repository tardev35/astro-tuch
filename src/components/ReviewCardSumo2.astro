---
import { BRAND_NAME } from "../lib/brandProfile";

// BRAVO168 (รอบทอง-กรมท่า "stadium night" 2026-09-30): รอบนี้บรีฟเป็นเว็บแทงบอล/กีฬาออนไลน์
// เท่านั้น ไม่ใช่สินค้าหมวดอื่นของแบรนด์ก่อนๆ ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง:
// บอลเดี่ยวและบอลสเต็ปในบิลเดียว, บอลสดระหว่างเกม, ราคาบอล/ค่าน้ำ/อัตราต่อรองที่แสดงก่อน
// ยืนยันบิล, ตรวจสอบเวลาปิดรับของแต่ละคู่แข่งขัน, ดูประวัติบิลย้อนหลังได้เอง, เข้าใช้งานผ่าน
// มือถือ แท็บเล็ต และคอมพิวเตอร์, สมัครออนไลน์ 3 ขั้นตอนแล้ว Login เข้าเลือกคู่, โบนัสคืนยอดเสีย
// 0.3% กับแนะนำเพื่อน 0.8% ที่ต้องตรวจรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับ และการติดต่อ
// แอดมินได้ตลอด 24 ชั่วโมง
//
// ห้ามพูดถึงสินค้าหมวดอื่นนอกจากกีฬา (เกมหมุน โต๊ะสด เลขท้าย ฯลฯ) ห้ามอ้างชื่อธนาคาร
// เลขใบอนุญาต ชื่อผู้ให้บริการรายอื่น ยอดฝากขั้นต่ำ ยอดจ่าย จำนวนสมาชิก หรือปีที่ก่อตั้ง —
// บรีฟ BRAVO168 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัวเท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า
// จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุด BRAVO168: ทองแบรนด์ #f4cb69 เป็นตัวระบุตัวตน (สันนำหน้าหัวข้อ ป้ายสมาชิก ดาว)
// ไล่จากทองอ่อน #ffe39a → ทองแบรนด์ #f4cb69 → ทองลึก #c9922e / #96690f ส่วนน้ำเงิน
// #1558c4 เป็นแอ็กเซนต์รอง ใช้กับจุดสถานะและแสงตอน hover ผิวการ์ดเป็นกรมท่า #04142f
// กรอบและเส้นคั่น #072247 บนพื้นเพจน้ำเงินลึกสุด #02081a เนื้อความ #dbe5f5 ตัวรอง #a8bedd
// ชื่อสมาชิกและบรรทัดคะแนนรับ near-white #e8f1ff — ชุดทอง-แดงของแบรนด์ก่อนหน้าออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ดูราคาบอลและค่าน้ำก่อนยืนยันบิลบอลเดี่ยว",
    stars: 5,
    tag: "บอลเดี่ยว · ราคาบอล · ค่าน้ำ",
    content:
      "ที่ใช้ต่อเพราะหน้าคู่แข่งขันแสดงราคาบอลกับค่าน้ำของแต่ละตัวเลือกไว้ก่อนกดยืนยันบิล เลยเทียบอัตราต่อรองของคู่ที่สนใจได้ครบก่อนตัดสินใจ ลีกและคู่ที่เปิดให้เดิมพันรวมอยู่ในบัญชีเดียว ไม่ต้องสลับหลายบัญชี เข้าใช้งานจากมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็เห็นรายการชุดเดียวกัน แต่ราคาและค่าน้ำมีการขยับได้ตามเวลา จึงเช็กตัวเลขในบิลอีกรอบก่อนยืนยันทุกครั้ง และไม่ได้คาดหวังว่าจะอ่านผลถูกได้ทุกคู่",
    avatar: "⚽",
  },
  {
    name: "คุณศิริพร ก.",
    role: "รวมบอลสเต็ปหลายคู่ในบิลเดียว แล้วตามบอลสดต่อ",
    stars: 5,
    tag: "บอลสเต็ป · บอลสด · เวลาปิดรับ",
    content:
      "ชอบที่ใส่หลายคู่รวมเป็นบิลสเต็ปเดียวได้ ระบบสรุปจำนวนคู่และอัตราต่อรองรวมให้เห็นก่อนยืนยัน ส่วนบอลสดก็ตามราคาระหว่างเกมได้จากหน้าเดียวกัน แต่คู่ที่เปิดให้เดิมพันสดและตัวเลือกที่มีจะไม่เท่ากันทุกคู่ และแต่ละคู่มีเวลาปิดรับของตัวเอง เลยกลายเป็นนิสัยว่าจะดูเวลาปิดรับกับเงื่อนไขของตลาดนั้นก่อนใส่ลงบิล เพราะบิลสเต็ปพลาดคู่เดียวก็จบทั้งบิล",
    avatar: "🧾",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัคร 3 ขั้นตอนผ่านมือถือ แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "สมัครเองผ่านระบบออนไลน์บนมือถือได้ใน 3 ขั้นตอน กรอกข้อมูลที่จำเป็น ยืนยันตามขั้นตอน แล้ว Login เข้าไปเลือกคู่แข่งขัน ตรวจโปรโมชั่น และดูประวัติบิลย้อนหลังได้จากหน้าเดียว ย้อนดูบิลเดี่ยวกับบิลสเต็ปที่ผ่านมาได้ว่าลงคู่ไหนที่ราคาเท่าไร ฝั่งโปรโมชั่นมีคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการกำหนดประเภทเดิมพัน รอบคำนวณ และยอดที่เข้าเกณฑ์ไม่เหมือนกัน จึงควรอ่านรายละเอียดล่าสุดจากหน้าเว็บไซต์ก่อนกดรับ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง โดยไม่บอกรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe39a] via-[#f4cb69] to-[#96690f] shadow-[0_0_12px_rgba(244,203,105,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#e8f1ff] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f4cb69]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#a8bedd]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเทียบราคาบอลและค่าน้ำก่อนยืนยันบิล การรวมบอลสเต็ปหลายคู่พร้อมตามบอลสดและเวลาปิดรับ และการตรวจรอบคำนวณกับเงื่อนไขโปรโมชั่นก่อนกดรับ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#072247] border-l-[#f4cb69] bg-[#04142f]/94 px-6 py-4 shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe39a] to-[#96690f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#a8bedd]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#072247] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f4cb69]" : "text-[#072247]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbe5f5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#f4cb69]/50 bg-[#02081a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f4cb69] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#072247] bg-[#04142f]/94 p-5 shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#f4cb69]/70 hover:shadow-[0_15px_40px_rgba(244,203,105,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f4cb69]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#1558c4]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#072247] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f4cb69]/65 bg-gradient-to-br from-[#ffe39a] via-[#f4cb69] to-[#c9922e] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e8f1ff] transition-colors group-hover:text-[#f4cb69]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a8bedd]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f4cb69]" : "text-[#072247]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f4cb69]/45 bg-[#02081a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f4cb69] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#1558c4]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dbe5f5]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
