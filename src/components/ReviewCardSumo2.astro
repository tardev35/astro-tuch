---
const reviews = [
  {
    name: "สมาชิกที่ส่งโพยผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด เลือกรอบหวย ใส่เลข และตรวจโพยก่อนยืนยันได้จากเครื่องเดียว เหมาะกับคนที่สลับไปมาระหว่างมือถือกับคอมพิวเตอร์",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่แทงหลายตลาดในบัญชีเดียว",
    role: "ตรวจอัตราจ่ายและวงเงินก่อนยืนยันโพยทุกครั้ง",
    stars: 5,
    tag: "เรท 2 ตัว 100 3 ตัว 1,000",
    content: "หวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย และหวยหุ้น อยู่ในบัญชีเดียวกัน จัดหมวดหมู่ไว้ให้ค้นหาง่าย อัตราจ่ายกับวงเงินรับแทงของแต่ละรอบแสดงอยู่ในระบบ อ่านซ้ำได้ก่อนกดยืนยันโพย",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่เคยติดต่อเจ้าหน้าที่ตอนฝากถอน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "เจ้าหน้าที่ดูแลตลอดเวลา",
    content: "ตอนทำรายการฝากแล้วเครดิตยังไม่เข้า แจ้งเวลาที่โอนกับรายละเอียดรายการไป เจ้าหน้าที่ช่วยตรวจสอบให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาส่งโพยรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก 7LOTTO" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff2a30]">7LOTTO</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2a30] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#a3060c]/35 bg-[#0d0304]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,42,48,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ff6b70] to-[#a3060c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9aa1ad] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2b0a0c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff2a30]" : "text-[#2b0a0c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9aa1ad]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#a3060c]/35 bg-[#0d0304]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,42,48,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff2a30]/60 hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ff2a30] to-[#d3d6db] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#5c0203]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#ff2a30]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#a3060c]/35 bg-[#0a0304] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff2a30] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff2a30]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff2a30]" : "text-[#2b0a0c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d8dae0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2b0a0c] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a3060c]/40 bg-gradient-to-br from-[#ff6b70] via-[#ff2a30] to-[#d3d6db] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#d8dae0] transition-colors group-hover:text-[#ff2a30]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9aa1ad] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
