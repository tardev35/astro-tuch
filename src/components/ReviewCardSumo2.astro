---
// OCZPLUS is a slot brand — every row stays inside what the brief states:
// สล็อตอันดับหนึ่งที่วางระบบนิเวศการเดิมพันแบบ Portal & Privilege, การันตียอดถอน
// ทุกวันและจ่ายเต็มจำนวนไร้ประวัติการโกง, เกมลิขสิทธิ์แท้ที่ควบคุมด้วยระบบสุ่ม
// RNG 100% แบบไม่ล็อคยูสเซอร์ทั้งลูกค้าเก่าและใหม่, กราฟิกระดับ Cinematic
// Lighting บนอินเทอร์เฟซโทนกรมท่าตัดทองเมทัลลิค, โบนัสแนะนำเพื่อน 0.8% จากทุกยอด
// การเล่นของเพื่อน, คืนยอดเสีย 0.3% ในทุกยอดการเล่น, ระบบฝาก-ถอนอัตโนมัติบนมือถือ
// ที่รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ภายใน 3-5 วินาทีโดยไม่ต้องส่งสลิป
// และไม่มีขั้นต่ำ, การถอนได้ตลอด 24 ชั่วโมงโดยไม่จำกัดรอบ, และแอดมินผ่าน Line
// Official ตลอด 24 ชั่วโมง. Nothing here promises a payout or a win rate.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Metallic gold carries
// the score/quote furniture, chrome silver carries the identity rail, so both
// halves of the OCZPLUS wordmark — the silver OCZ and the gold PLUS — are doing
// work. The logo's red "+" shows up once, on the ledger's own tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ถอนกำไรก้อนใหญ่และได้รับเต็มจำนวน",
    stars: 5,
    tag: "การันตียอดถอนทุกวัน",
    content:
      "สิ่งที่ทำให้ตัดสินใจอยู่ยาวคือเรื่องยอดถอน ทำกำไรได้เท่าไหร่ก็ได้รับเต็มจำนวนตามที่ประกาศไว้ ไม่มีการบ่ายเบี่ยงหรือถ่วงเวลา ระบบทำรายการถอนได้ตลอด 24 ชั่วโมงโดยไม่จำกัดจำนวนครั้งและไม่จำกัดยอดสูงสุดต่อวัน อ่านรีวิวของสมาชิกคนอื่นก่อนสมัครแล้วก็ตรงกับที่เจอเองทุกอย่าง",
    avatar: "💰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ยูสเซอร์เก่าที่ยังได้สิทธิ์เท่าสมาชิกใหม่",
    stars: 5,
    tag: "ไม่ล็อคยูส · RNG 100%",
    content:
      "สะสมยอดฝากมานานแต่ยังได้โบนัสเท่ากับสมาชิกที่เพิ่งสมัครเข้ามา เพราะ OCZPLUS ใช้เกมลิขสิทธิ์แท้ที่ควบคุมด้วยระบบสุ่ม RNG 100% ไม่มีการปรับลดอัตราการชนะ ทั้งลูกค้าเก่าและใหม่จึงมีโอกาสคว้ารางวัลใหญ่เท่ากัน ตัวเกมเองก็จัดเต็มด้วยแสงเงาระดับ Cinematic Lighting เห็นความต่างตั้งแต่สปินแรก",
    avatar: "🔓",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ทำรายการเองและกดรับสิทธิ์โปรโมชั่นผ่านหน้าเว็บ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ฝาก-ถอนผ่านมือถือเป็นระบบอัตโนมัติทั้งหมด รองรับทุกธนาคารชั้นนำรวมถึง TrueMoney Wallet ประมวลผลภายใน 3-5 วินาที ไม่ต้องส่งสลิปให้แอดมินและไม่มีขั้นต่ำ ส่วนโปรโมชั่นก็กดรับสิทธิ์เองได้ผ่านหน้าเว็บ ทั้งคอมมิชชั่นแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน และคืนยอดเสีย 0.3% ในทุกยอดการเล่น ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก OCZPLUS" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] shadow-[0_0_12px_rgba(217,180,94,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f7eed6] uppercase sm:text-3xl">
        เสียงจากสมาชิก OCZ<span class="text-[#d9b45e]">PLUS</span>
      </p>
      <span class="text-xs tracking-wide text-[#ccd6e6]/60">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการถอนกำไรที่ได้รับเต็มจำนวน การรับสิทธิ์โบนัสแบบไม่ล็อคยูสเซอร์ และการทำรายการฝาก-ถอนอัตโนมัติด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#8a6b2c] border-l-[#d9b45e] bg-[#071a36]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,16,31,0.65)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f7eed6] to-[#d9b45e] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ccd6e6]/60">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#8a6b2c] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d9b45e]" : "text-[#8a6b2c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ccd6e6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#c0202b]/50 bg-[#02101f] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dd3a3f] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#8a6b2c] bg-[#071a36]/92 p-5 shadow-[0_10px_30px_rgba(2,16,31,0.65)] backdrop-blur-xl transition-all duration-300 hover:border-[#d9b45e]/70 hover:shadow-[0_15px_40px_rgba(217,180,94,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#d9b45e]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#d9b45e]/22"
          />

          <div class="flex items-center gap-4 border-b border-[#8a6b2c] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#8b939c]/50 bg-gradient-to-br from-[#e6ebf0] via-[#c9d2dc] to-[#8b939c] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e4c67f] transition-colors group-hover:text-[#f7eed6]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ccd6e6]/60">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#d9b45e]" : "text-[#8a6b2c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#8a6b2c]/60 bg-[#02101f] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e4c67f] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d9b45e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ccd6e6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
