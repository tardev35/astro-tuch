---
import { BRAND_NAME } from "../lib/brandProfile";

// หวย365 (รอบแดงสด-ทอง 2026-10-02): บรีฟรอบนี้เป็นเว็บแทงหวยออนไลน์ล้วน ทุกแถวจึงถูก
// เขียนใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิม กรอบที่
// บรีฟระบุไว้เองคือ: รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบไว้ในหน้าเดียว ·
// รัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศในบัญชีเดียว · เลือกเลข ส่งโพย และตรวจสอบ
// รายการผ่านมือถือ · เวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการ · อัตรา 2 ตัว จ่าย
// 100 บาท กับ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข · สมัครผ่านมือถือ 3 ขั้นตอน ·
// ติดต่อแอดมินได้ตลอด 24 ชั่วโมง · และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// มุมของรอบก่อนๆ ที่บรีฟนี้ไม่ได้เขียนไว้ (เลขเด็ด/เลขดัง, ไม่จำกัด/แทงได้ไม่อั้น, ฝากถอน
// วอลเลทและธนาคาร, ฮานอยปกติ/พิเศษ/วีไอพี) ถูกถอดออกทั้งหมด และบรีฟนี้เขียน
// "หวยลาวพัฒนา" ไม่ใช่ "หวยลาว" เฉยๆ
//
// ห้ามพูดถึงสินค้าหมวดอื่นนอกจากหวย (สล็อต ฟรีสปิน บอล คาสิโน บาคาร่า ฯลฯ) ห้ามอ้างชื่อ
// ธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือรอบเวลา
// ออกรางวัลจริง — บรีฟ หวย365 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัวเท่าที่บรีฟระบุ
// คือ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · 24 ชั่วโมง และบรีฟ
// เป็นโทน hedged ทุกย่อหน้า จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้: ทอง #ffc93c เป็นตัวระบุตัวตน (สันนำหน้าหัวข้อ ป้ายสมาชิก ดาว) ไล่จากทองอ่อน
// #ffeab0 → ทอง #ffc93c → ทองลึก #c08a07 ตามลายไทยทองในงานอาร์ต ส่วนแดงแบรนด์ #dc0203
// / แดงสว่าง #f5282a เป็นแอ็กเซนต์รอง ใช้กับจุดสถานะและแสงตอน hover ตามเวิร์ดมาร์กที่คำว่า
// "หวย" เป็นแดงสด ผิวการ์ด #240406 กรอบและเส้นคั่นแดงลึก #9c0201 ชิปตกลงไปที่ผิวแถบ
// #180303 เนื้อความและชื่อสมาชิก #f6e7e0 (BRAND_TEXT) ตัวรอง #d9b9b1 — ชุดแดง-ทองของ
// หวยเฮง24/หวยเฮง789 (#e0a52a #fdea83 #a46304 #8b0302 #c01616 #2e0707 #1a0505 #720202
// #f6e6cf #dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ติดตามรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นจากบัญชีเดียว",
    stars: 5,
    tag: "รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หวยหุ้น",
    content:
      "ที่ใช้ต่อเพราะรายการหวยที่สนใจรวมอยู่ในหน้าเดียว ทั้งหวยรัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยที่มีหลายรอบ หวยลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ ไม่ต้องสลับหลายเว็บไซต์ เข้าใช้งานผ่านมือถือก็เห็นรายการชุดเดียวกัน ก่อนเลือกเลขจะเปิดดูเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการจากหน้าเดียวก่อนทุกครั้ง เพราะรอบที่เปิดรับจริงในแต่ละวันไม่ได้เหมือนกันทุกประเภท",
    avatar: "🎟️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ใช้แนวทางหวยและสถิติย้อนหลังเป็นข้อมูลประกอบก่อนส่งโพย",
    stars: 5,
    tag: "แนวทางหวย · กลุ่มหวย · สถิติย้อนหลัง · ผลหวย",
    content:
      "ที่ชอบคือแนวทางหวย กลุ่มหวย และสถิติย้อนหลังถูกจัดหมวดแยกตามประเภท เลยหาข้อมูลได้ง่ายกว่าเดิม สถิติย้อนหลังใช้ย้อนดูผลและรูปแบบตัวเลขที่เคยออกได้ ส่วนแนวทางหวยก็เป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ไม่ได้ถือว่าใช้ยืนยันเลขของงวดถัดไปได้ เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา พอประกาศผลแล้วก็กลับมาดูผลหวยตามรอบและสถานะโพยจากบัญชีสมาชิกได้",
    avatar: "📊",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · อัตราจ่าย · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชี จากนั้นเลือกประเภทหวย รอบ และตัวเลขที่ต้องการได้เลย ก่อนยืนยันจะตรวจอัตราจ่ายที่ระบบแสดงอีกรอบ เพราะอัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข และบางรายการกำหนดอัตราหรือวงเงินไม่เท่ากัน ตอนที่ส่งโพยไม่สำเร็จและรายการยังไม่แสดง ติดต่อแอดมินได้ตลอด 24 ชั่วโมง โดยแจ้งชื่อหวย รอบเวลา และเลขที่เลือกไป ส่วนปัญหาด้านธุรกรรมก็เตรียมเวลา จำนวนเงิน และหลักฐานไว้ให้ตรวจสอบ และไม่ส่งรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_12px_rgba(255,201,60,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f6e7e0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ffc93c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#d9b9b1]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นจากบัญชีเดียว การใช้แนวทางหวย กลุ่มหวย และสถิติย้อนหลังเป็นข้อมูลประกอบก่อนส่งโพย และการสมัครผ่านมือถือ 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#9c0201] border-l-[#ffc93c] bg-[#240406]/94 px-6 py-4 shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffeab0] to-[#c08a07] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#d9b9b1]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#9c0201] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffc93c]" : "text-[#9c0201]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e7e0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#ffc93c]/50 bg-[#180303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc93c] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#9c0201] bg-[#240406]/94 p-5 shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.30)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#f5282a]/30"
          />

          <div class="flex items-center gap-4 border-b border-[#9c0201] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ffc93c]/65 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f6e7e0] transition-colors group-hover:text-[#ffeab0]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#d9b9b1]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ffc93c]" : "text-[#9c0201]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#ffc93c]/45 bg-[#180303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc93c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5282a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e7e0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
