    role: "ไล่อ่านรายละเอียดระบบเกมกับรายชื่อค่ายผู้พัฒนาให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "เกมสล็อตออนไลน์ · ค่ายแท้ถูกลิขสิทธิ์ · กติกาเกม",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศ พร้อมรายละเอียดระบบเกม โปรโมชั่น และช่องทางฝากถอนสำหรับสมาชิกไว้ในที่เดียว ภายในเว็บไซต์มีเมนูสำหรับศึกษากติกาเกม ตรวจสอบเงื่อนไขการเดิมพัน และเลือกดูข้อมูลค่ายเกมที่สนใจ โดยเกมแต่ละแบบมีรูปแบบการเล่นและฟีเจอร์ต่างกัน ทั้งสล็อตคลาสสิก เกมที่มีรอบโบนัส และเกมที่ใช้สัญลักษณ์พิเศษในการจ่ายรางวัล ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างเกี่ยวกับการเป็นทางเข้าเว็บหลักหรือไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลผู้ให้บริการและหลักฐานความเกี่ยวข้องกับค่ายเกมโดยตรงก่อนใช้งาน เพราะคำกล่าวอ้างว่าเป็นเกมลิขสิทธิ์แท้หรือยอดเงินเข้าบริษัทแม่โดยตรง ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว",
    avatar: "🎰",
    accent: "crimson" as const,
  },
  {
    name: "คุณพิมพ์ชนก ส.",
    role: "อ่านประกาศล่าสุดของโปรโมชั่นให้ครบ แล้วค่อยตรวจรอบรับเครดิตอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เงื่อนไขการใช้โบนัส",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือข้อมูลโปรโมชั่นสำหรับสมาชิก ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน และโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ แต่ละรายการอาจมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ รอบเวลารับเครดิต และเงื่อนไขการถอนเงินแตกต่างกัน จึงต้องดูว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด ต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัสจากประกาศล่าสุดทุกครั้ง แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้และรอบจ่ายเครดิตก่อนตัดสินใจ ที่ต้องเข้าใจตรงกันคือไม่ควรตีความข้อความว่าจ่ายสูงเป็นการรับประกันผลกำไรจากเกมสล็อต และเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป",
    avatar: "🎁",
    accent: "pearl" as const,
  },
  {
    name: "คุณอรรถพล ม.",
    role: "ตรวจชื่อบัญชีปลายทางและช่องทางติดต่อจากเว็บไซต์ทางการก่อนทำรายการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใคร",
    stars: 4,
    tag: "ระบบฝากถอน · ธนาคารและทรูมันนี่ · ติดต่อแอดมิน 24ชม.",
    content:
      "ก่อนฝากเงินจะตรวจรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้เสมอ รวมถึงศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ จะหยุดทำรายการและติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการเข้าสู่ระบบ รายชื่อค่ายเกม รายการฝากถอน และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🔐",
    accent: "crimson" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb2e33] via-[#cb0b0d] to-[#8a0608] shadow-[0_0_12px_rgba(251,46,51,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#e3d6d4] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#fb2e33]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#c9b9b7]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตออนไลน์จากค่ายต่างประเทศ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบฝากถอนผ่านธนาคารและทรูมันนี่ พร้อมช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#551c1e] border-l-[#fb2e33] bg-[#0b0000] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.5)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fb2e33] to-[#e3d6d4] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#fb2e33]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#551c1e] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fb2e33]" : "text-[#fb2e33]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f0e6e4]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#551c1e] bg-[#2a0c0d] px-3 py-1 text-[10px] font-bold tracking-wide text-[#c9b9b7] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#551c1e] bg-[#1c0607] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.45)] transition-all duration-300 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(251,46,51,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fb2e33]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#fb2e33]/25"
          />

          <div class="flex items-center gap-4 border-b border-[#551c1e] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "crimson"
                  ? "border border-[#8a0608] bg-gradient-to-br from-[#d81115] to-[#b00d11] text-white"
                  : "border border-[#7d6f6e] bg-gradient-to-br from-[#f0e6e4] to-[#c9b9b7] text-[#0a0a0a]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f0e6e4] transition-colors group-hover:text-[#fb2e33]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#c9b9b7]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fb2e33]" : "text-[#fb2e33]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#551c1e] bg-[#0b0000] px-3 py-1 text-[10px] font-bold tracking-wide text-[#c9b9b7] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fb2e33]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f0e6e4]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
