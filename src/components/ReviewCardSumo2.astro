---
import { BRAND_NAME } from "../lib/brandProfile";

// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): บรีฟรอบนี้เป็นเว็บสล็อต
// คาสิโนเว็บตรงต่างประเทศ ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้
// find-and-replace ชื่อแบรนด์ทับประโยคเดิมของรอบหวย กรอบที่บรีฟระบุไว้เองคือ:
// รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่น
// ตามผู้ให้บริการที่เชื่อมต่อกับระบบ · รองรับเว็บเบราว์เซอร์บนมือถือ สลับหมวดเกม
// ตรวจสอบเครดิต และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย ·
// โปรโมชั่นตามแคมเปญรายเดือน มีคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอด
// ที่เข้าเกณฑ์ตามรอบ · สมัครผ่านมือถือ 3 ขั้นตอน · ติดต่อแอดมินได้ 24 ชั่วโมง ·
// และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// มุมของรอบก่อนๆ ที่บรีฟนี้ไม่ได้เขียนไว้ (หวยทุกประเภท โพย งวด อัตราจ่าย เลข 2 ตัว
// /3 ตัว ฮานอย ลาวพัฒนา หวยหุ้น แนวทางหวย สถิติหวย ตรวจหวย รวมถึงฟรีสปิน ตัวคูณ
// เกมโบนัส และ "ไม่ผ่านเอเย่นต์" ของรอบสล็อตก่อนหน้า) ถูกถอดออกทั้งหมด
//
// ห้ามใส่ชื่อค่ายเกม ชื่อเกม ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ
// ค่า RTP จำนวนสมาชิก หรือปีที่ก่อตั้ง — บรีฟ DM899 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลข
// ที่ใช้ได้มีห้าตัวคือ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง · 100% และบรีฟเป็นโทน
// hedged ทุกย่อหน้า จึงต้องคงประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้: แบรนด์มีสามสี (logo.webp เป็นตัว D เขียว vivid #01841b #018b1b ซ้อน
// ตัว M แดง #fb252b #bb0303 #f91c20 ตามด้วยเลข 899 โครเมียม ส่วนทองมาจากตัวอักษร
// ไล่เฉดบน banner1.png ที่พื้นเป็นดำอมเขียว #05140c) เขียวแบรนด์ #01a326 จึงเป็น
// ตัวระบุตัวตนของบล็อกนี้ — สันนำหน้าหัวข้อและป้ายอวาตาร์เป็นเขียว ไล่เขียวสว่าง
// #4ade6b → เขียวแบรนด์ #01a326 → เขียวแกน #01841b ส่วนแดงแบรนด์ถือออรามุมขวาบน
// กับขอบป้ายแท็ก (คู่ D/M ของโลโก้) และทองเป็นสีเน้นที่อ่านเป็นตัวอักษร คือชื่อ
// แบรนด์ ดาวที่ติด และคะแนนเฉลี่ย (ทอง #f2b422 บนผิวการ์ด #0a1a0e ได้ 9.7:1 ส่วน
// เขียวแบรนด์ได้ 5.4:1 จึงใช้เป็นเส้นกับพื้นเป็นหลัก) ดาวที่ยังไม่ติดใช้พื้นยกระดับ
// #102a16 กรอบเป็นเขียวลึก #0a4a18 ชิปตกลงไปที่พื้นลึกสุด #030a05 เนื้อความและชื่อ
// สมาชิก #e4f2e4 (BRAND_TEXT) ตัวรองใช้ #e4f2e4 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิด
// ขึ้นเอง
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #8c0402 #ffc93c
// #ffeab0 #c08a07 #240406 #140203 #3a0a0c #f6e7e0) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกหมวดเกมจากบัญชีเดียวผ่านมือถือ",
    stars: 5,
    tag: "เกมสล็อต · เกมคาสิโนสด · หมวดเกมอื่นตามผู้ให้บริการ",
    content:
      "ที่ใช้ต่อเพราะเกมเดิมพันหลายรูปแบบรวมอยู่ในระบบเดียว ทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ เข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือได้ สลับหมวดเกม ตรวจสอบเครดิต และดูประวัติรายการได้โดยไม่ต้องสมัครบัญชีใหม่แยกตามค่าย ส่วนข้อความว่าการันตีระบบเกมมาตรฐาน ส่วนตัวมองว่าควรระบุมาตรฐาน ใบอนุญาต หรือหน่วยงานที่ตรวจสอบได้อย่างชัดเจน เพราะการเป็นแพลตฟอร์มต่างประเทศไม่ได้ยืนยันมาตรฐานหรือความปลอดภัยของระบบโดยอัตโนมัติ",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสอบสิทธิ์โปรโมชั่นจากบัญชีก่อนกดรับ",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · รอบคำนวณ · ยอดที่เข้าเกณฑ์",
    content:
      "โปรโมชั่นเปิดตามแคมเปญของแต่ละเดือน เลยใช้วิธี Login เข้าไปดูว่าบัญชีมีสิทธิ์รับรายการไหนบ้างก่อนทุกครั้ง มีทั้งโบนัสคืนยอดเสีย 0.3% ที่คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด และโบนัสแนะนำเพื่อน 0.8% ที่คำนวณจากยอดใช้งานของเพื่อนที่สมัครผ่านลิงก์แนะนำ ตรวจสอบจำนวนเพื่อนและสถานะโบนัสได้จากบัญชีสมาชิก แต่ละโปรโมชั่นอาจกำหนดรอบคำนวณ ยอดที่เข้าเกณฑ์ เกมที่ร่วมรายการ และระยะเวลารับสิทธิ์แตกต่างกัน จึงควรอ่านเงื่อนไขล่าสุดก่อนกดรับโบนัสเสมอ",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · บัญชีบริษัทแท้ 100% · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลเพื่อเปิดบัญชีแล้ว Login เข้าสู่ระบบ จากนั้นเลือกประเภทเกมที่ต้องการพร้อมตรวจสอบโปรโมชั่นก่อนเริ่มใช้งาน ตอนที่เครดิตไม่แสดงหรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ติดต่อแอดมินผ่านช่องทางบริการหลักได้ตลอด 24 ชั่วโมง เรื่องเกมก็แจ้งชื่อเกม ค่าย และเวลาที่พบปัญหา ส่วนเรื่องฝากถอนก็เตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้ให้ตรวจสอบ ถ้ามีการเปลี่ยนบัญชีรับเงินจากข้อมูลเดิมควรตรวจสอบกับช่องทางหลักก่อนทำรายการ และไม่ส่ง OTP หรือรหัสผ่านให้เจ้าหน้าที่ ส่วนคำว่าบัญชีบริษัทแท้ 100% ควรตรวจชื่อบัญชี ชื่อนิติบุคคล และข้อมูลบริษัทให้ตรงกันก่อนโอนทุกครั้ง เพราะข้อความเพียงอย่างเดียวไม่เพียงพอสำหรับยืนยันความปลอดภัย",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_12px_rgba(1,163,38,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#e4f2e4] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f2b422]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e4f2e4]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกหมวดเกมทั้งเกมสล็อต เกมคาสิโนสด และหมวดเกมอื่นตามผู้ให้บริการที่เชื่อมต่อกับระบบ การตรวจสอบสิทธิ์โปรโมชั่นคืนยอดเสียและแนะนำเพื่อนจากบัญชีสมาชิก
        และการสมัครผ่านมือถือ 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0a4a18] border-l-[#01a326] bg-[#0a1a0e]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#f2b422] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e4f2e4]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#0a4a18] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2b422]" : "text-[#102a16]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e4f2e4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#fb252b]/60 bg-[#030a05] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2b422] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0a4a18] bg-[#0a1a0e]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-300 hover:border-[#12c23a]/75 hover:shadow-[0_15px_40px_rgba(1,163,38,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fb252b]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#ff6b6e]/30"
          />

          <div class="flex items-center gap-4 border-b border-[#0a4a18] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#4ade6b]/65 bg-gradient-to-br from-[#4ade6b] via-[#01a326] to-[#01841b] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e4f2e4] transition-colors group-hover:text-[#ffe9a8]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e4f2e4]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f2b422]" : "text-[#102a16]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fb252b]/55 bg-[#030a05] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2b422] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fb252b]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e4f2e4]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
