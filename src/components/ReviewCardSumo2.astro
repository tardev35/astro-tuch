---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "กีฬาคาสิโนเว็บตรงที่รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว
// ในเครือตรงแบรนด์ลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์" ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้
// เอง: กีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ, บัญชีเดียวใช้
// ได้ทั้งมือถือและคอมพิวเตอร์, เลือกเกมจากหลายค่ายโดยไม่ต้องสลับหลายระบบ,
// โปรโมชั่นบางรายการกดรับหลังสมัครได้โดยไม่ต้องฝากก่อน, โบนัสแนะนำเพื่อน 0.8% กับ
// คืนยอดเสีย 0.3%, สมัครผ่านมือถือ 3 ขั้นตอน และแอดมินตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนรับปากว่าจะชนะ บอกอัตราการจ่าย อ้างใบอนุญาต หรือพูดถึงลอตเตอรี่
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): แถบระบุตัวสมาชิกไล่จากแดงสด #ef1f25
// ลงแดงแบรนด์ #c50d12 ไปหาแดงลึก #7a0103 ตามตัวอักษร UFA บนโลโก้ ส่วนดาวและป้าย
// แท็กรับเงินโครเมียม #b8c3cf ตาม GOOL ที่เป็นเงิน กรอบการ์ดกับเส้นคั่นเป็นแดงลึก
// #5e0507 บนพื้นการ์ด #16100f เหนือพื้นเพจ #0a0708 ชื่อหัวข้อเป็นขาวเงิน #f4f7fa
// — แดง-ทองของแบรนด์ก่อนหน้า (#dd0503 #a40201 #6b0302 #f2c14e #ffe7a6 #2d0908 #1c0504
// #f7e3dd) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นกีฬาและคาสิโนสดจากบัญชีเดียว",
    stars: 5,
    tag: "รวมเกมไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมพนันหลายหมวดไว้ในระบบเดียวจริง เลือกได้ทั้งการเดิมพันกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นตามรายการที่เปิดให้บริการ จากบัญชีเดียว ไม่ต้องสลับหลายระบบให้วุ่นวาย เปิดจากมือถือก็ได้ สลับไปใช้คอมพิวเตอร์ก็บัญชีเดิม",
    avatar: "⚽",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูหมวดเกมและค่ายที่รองรับก่อนเข้าใช้งานทุกครั้ง",
    stars: 5,
    tag: "เครือตรงลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์",
    content:
      "ชอบตรงที่ตรวจสอบหมวดเกมและค่ายที่รองรับได้จากหน้าเว็บไซต์ก่อนเข้าใช้งาน เลยเลือกประเภทที่เหมาะกับตัวเองได้ ระบบเชื่อมต่อผ่านเครือแบรนด์โดยตรงตามข้อมูลของเว็บไซต์ ไม่ผ่านเอเย่นต์ ขั้นตอนการใช้งานเลยสั้นลง เลือกเกมจากหลายค่ายได้โดยไม่ต้องเปิดหลายระบบ",
    avatar: "🎴",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือแล้วเช็กเงื่อนไขโปรโมชั่นก่อนกดรับ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "สมัครผ่านมือถือเองได้ กรอกข้อมูล ตรวจความถูกต้อง แล้วยืนยันบัญชี สามขั้นตอนจบ โปรโมชั่นมีทั้งของสมาชิกใหม่และสมาชิกเดิม บางรายการกดรับหลังสมัครได้โดยไม่ต้องฝากก่อนตามที่ระบบกำหนด ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก็ดูรอบคำนวณกับยอดที่เข้าเกณฑ์ก่อนได้ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef1f25] via-[#c50d12] to-[#7a0103] shadow-[0_0_12px_rgba(197,13,18,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f4f7fa] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ef1f25]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#cdd5dd]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมกีฬา คาสิโนสด สล็อต และเกมรูปแบบอื่นไว้ในบัญชีเดียว การเชื่อมต่อเครือตรงที่ไม่ผ่านเอเย่นต์ และการสมัครผ่านมือถือกับการเช็กเงื่อนไขโปรโมชั่น
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#5e0507] border-l-[#c50d12] bg-[#16100f]/94 px-6 py-4 shadow-[0_10px_30px_rgba(10,7,8,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#cdd5dd]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5e0507] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#b8c3cf]" : "text-[#5e0507]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cdd5dd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#5e0507] bg-[#0a0708] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f4f7fa] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#5e0507] bg-[#16100f]/94 p-5 shadow-[0_10px_30px_rgba(10,7,8,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#c50d12]/75 hover:shadow-[0_15px_40px_rgba(197,13,18,0.42)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c50d12]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#b8c3cf]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#5e0507] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#c50d12]/60 bg-gradient-to-br from-[#ef1f25] via-[#c50d12] to-[#7a0103] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f4f7fa] transition-colors group-hover:text-[#ef1f25]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#cdd5dd]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#b8c3cf]" : "text-[#5e0507]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c50d12]/65 bg-[#0a0708] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f4f7fa] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ef1f25]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#cdd5dd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
