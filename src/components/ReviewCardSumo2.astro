---
import { BRAND_NAME } from "../lib/brandProfile";

// TSDET911 (2026-10-13): รอบนี้ **เขียนตัวบทรีวิวใหม่ทั้งแผง** ไม่ใช่รีเธมสีล้วน เพราะ
// บรีฟรอบนี้เป็นบรีฟคนละเว็บกับรอบก่อน ซึ่งเป็นแบรนด์สล็อตที่ขายคำศัพท์ชุดอื่นทั้งชุด
// ส่วนรอบนี้เป็น **เว็บพนันคาสิโน + กีฬา** ที่บรีฟระบุสี่หมวดตรงๆ คือ บาคาร่า · ไฮโล ·
// สล็อต · แทงบอล พร้อมคำว่า ไม่มีขั้นต่ำ
// ทุกประโยคในสามรีวิวด้านล่างถอดมาจาก src/assets/content.txt ของดรอปนี้ (บรรทัด 4, 6,
// 7, 9, 11, 13, 15–18, 20, 21) และ **คำกำกับของบรีฟถูกคงไว้ครบทั้งห้าข้อ** ไม่ตัดออก
// เพราะฟังดูไม่ขายของ
//
// ศัพท์การตลาดของแบรนด์ก่อนๆ (ชุดคำโฆษณาแบบ "แตก/ตรง/ไว" ชุดเกมถ่ายทอดสด ชุดคำ
// ช่องทางการเงินแบบบัญชีองค์กร และคำที่ผูกกับชื่อแบรนด์เก่า) ถูกถอดออกครบตาม §7 — ไม่เหลือ
// แม้คำเดียว และไม่มีคำในกลุ่มลอตเตอรีที่ §7 ห้ามอยู่ในไฟล์นี้เลย (แบรนด์รอบนี้เป็น
// คาสิโน + กีฬา)
// ตัวเลขที่ปรากฏมีแค่สามตัวของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง (บวก "3 ขั้นตอน" และ
// "100%" ซึ่งเป็นถ้อยคำในหัวข้อของบรีฟ ไม่ใช่ตัวเลขเคลม) ไม่มีค่าอัตราคืนเงินของเกม
// ไม่มียอดขั้นต่ำเป็นตัวเลข ไม่มีเลขที่ใบอนุญาต ไม่มีชื่อผู้ให้บริการหรือค่ายเกม
// ไม่มีจำนวนสมาชิก และไม่มีปี
// คะแนนดาวกับค่าเฉลี่ยคำนวณจากรายการที่แสดงอยู่ในไฟล์นี้เอง และหัวแผงระบุว่าเป็น
// "ความคิดเห็นตัวอย่าง" จึงไม่ใช่การอ้างสถิติของเว็บไซต์
//
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// หัวข้อบล็อกเป็น <p> และ <section> ถือ aria-label ไว้ — ตารางรีวิวคือ chrome
// จึงไม่ปล่อยแท็กหัวข้อออกมาเลยสักระดับ (h1 ถึง h6 = ศูนย์แท็ก) ชื่อสมาชิกทุกคนและ
// ป้ายทุกใบเป็น <span> ที่ถือคลาสหน้าตาเดิม ชื่อแบรนด์ interpolate จาก BRAND_NAME
// ทั้งในข้อความและใน aria-label ไม่พิมพ์ตรงๆ ที่ไหนเลย
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// ── สีรอบนี้: น้ำเงินไฟฟ้า + เงินโครเมียม บนกรมเกือบดำ ──────────────────────
// ⚠️ **รอบนี้ไม่มีทองที่ไหนเลย** เป็นสองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง
// โลโก้คือตัวอักษร TSDET สามมิติสีเงินโครเมียม ต่อด้วยเลข 911 น้ำเงินไฟฟ้า
// พื้นเพจกรมเกือบดำ #00081f (bg.json) ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง /
// #040e26 จม / #00081f พื้น — ไม่มีชั้นไหนจมต่ำกว่าพื้น
//
// รูปทรงของแผงนี้คือ **บัญชีแยกรายการเต็มความกว้าง** (รางซ้ายถือตัวตน + คำพูดกินที่
// เหลือ) ซึ่งไม่ซ้ำกับกล่องเนื้อหาใบไหนบนหน้า การ์ดรีวิวนั่งบน **ผิวจม #040e26** ใน
// กรอบฟ้าสด #0292fb แบบโปร่ง (อิ่มขึ้นตอน hover) ต่างจากแถบคะแนนด้านบนที่เป็น
// **ผิวกลาง #0a1c42 พร้อมรางซ้ายน้ำเงินแบรนด์ #0360f3 หนาสี่พิกเซล**
// สันหัวแผงไล่ตั้ง เงินโครเมียมสว่าง #cfdcec → ฟ้าสว่าง #6ec8ff → น้ำเงินแบรนด์
// #0360f3 (ตัวอักษรเงินของโลโก้ไล่ลงไปหาเลข 911 สีน้ำเงิน)
// ค่าเฉลี่ยไล่ เงินโครเมียมสว่าง #cfdcec → ฟ้าอ่อน #4fb4ff · ดาวที่ติดเป็นฟ้าสว่าง
// #6ec8ff (7.4:1) ดาวที่ยังไม่ติดเป็น #6ec8ff/25 (ลดความทึบของสีเดียวกัน ไม่สร้างสี
// นอกพาเลตต์) · เนื้อความและชื่อสมาชิก #dde8f7 (= BRAND_TEXT) · ตัวรองเงินโครเมียม
// หม่น #9db4d4 (~6:1) · เส้นคั่นและขอบในเป็นน้ำเงินลึก #04186e
// ป้ายอวาตาร์เป็น **แผ่นโครเมียมทึบ** ไล่ #cfdcec → #6ec8ff → #0292fb บนหมึก #021026
// ซึ่งเป็นหมึกตัวเดียวที่วางบนพื้นถมสว่างได้ตาม §2 (6.0:1 ที่ปลายเข้มสุดของแผ่น) —
// ห้ามพลิกแผ่นนี้ไปใช้หมึกสว่าง
// glow ทั้งหมดเป็น rgba(3,96,243,α) · rgba(2,146,251,α) หรือ rgba(0,0,0,α)
// §2 ห้าม #0360f3 #0292fb #032dad #04186e #041a43 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งห้า
// ค่าอยู่ที่ขอบ เส้นคั่น สันหัวแผง จุดบนป้าย ออรา และ **พื้น** ของแผ่นโครเมียมเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ทองมาเกือบทุกรอบ ไฟล์นี้จึง "ดูทองถูกแล้ว"
// มาก่อนที่จะถูกแบรนด์ด้วย ชุดที่ถอดออกรอบนี้คือชุด **ทองมังกรบนดำสนิท** (ทองหลักที่
// ขอบ/ไอคอน/ดาว + ทองสว่างปลายไล่สี + ทองไฮไลต์ที่ชื่อแบรนด์ + ผิวการ์ดน้ำตาลเข้ม +
// เนื้อความครีม + เส้นบรอนซ์) และก่อนนั้นเป็นชุดชมพูฮอต-ทองบนพลัมดำ — ออกครบทุกค่า
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีชมพู/พลัม ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม/อำพัน และไม่มีแดง
// เลย** และเงินโครเมียม #cfdcec / #9db4d4 ของรอบนี้ไม่ใช่เทาอมฟ้าของแบรนด์เงินรอบก่อนๆ
// ส่วนฟ้าสด #0292fb (R=2 G=146 B=251) ไม่ใช่ฟ้าของแบรนด์ "แตกดี168" (R=1 G=147 B=251)
// — ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกหมวดเกมและตรวจสอบยอดเดิมพันจากบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า · ไฮโล · สล็อต · แทงบอล",
    content:
      "ที่ใช้ต่อเพราะทางเข้าเดิมพันรวบรวมหมวดเกมคาสิโนและกีฬาไว้ในแพลตฟอร์มเดียว เข้าใช้งานผ่านมือถือและคอมพิวเตอร์ได้สะดวก โดยบาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา ไฮโลใช้ผลจากลูกเต๋าเป็นตัวตัดสิน สล็อตมีทั้งเกมวงล้อทั่วไปและเกมที่มีฟีเจอร์โบนัส ส่วนแทงบอลมีรายการแข่งขันพร้อมข้อมูลอัตราต่อรองให้ศึกษาก่อนทำรายการ ตัวที่ชอบที่สุดคือการจัดหมวดเกม เพราะค้นหาประเภทเกมที่สนใจได้โดยไม่ต้องสลับหลายหน้าเว็บไซต์ แล้วตรวจสอบข้อมูลเกม ยอดเดิมพัน และรายการต่างๆ ได้จากบัญชีเดียว ส่วนเรื่องที่อยากให้อ่านกันก่อนคือการเดิมพันแบบไม่มีขั้นต่ำ ควรตรวจสอบข้อกำหนดของแต่ละเกมและผู้ให้บริการ เพราะบาคาร่า ไฮโล สล็อต และแทงบอลอาจกำหนดวงเงินเริ่มต้นแตกต่างกัน จึงควรศึกษากติกา ตารางจ่าย และเงื่อนไขการตัดสินผลก่อนทำรายการ เนื่องจากการเดิมพันทุกประเภทมีความเสี่ยงและไม่มีระบบใดรับประกันว่าจะได้รับกำไร และการกล่าวอ้างว่าเป็นเว็บลิขสิทธิ์ไทยแท้ที่ใช้เซิร์ฟเวอร์ในประเทศไทย 100% ควรมีข้อมูลใบอนุญาตและผู้ให้บริการระบบที่ตรวจสอบได้ประกอบ",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณของแต่ละกิจกรรม",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เข้ายูสทุกวัน",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบรายการสิทธิพิเศษตามกิจกรรมที่เว็บไซต์กำหนดได้เอง ทั้งยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับสิทธิ์ผ่านบัญชีสมาชิก ฝั่งคืนยอดเสียคือสมาชิกที่มียอดเสียตรงตามข้อกำหนดสามารถตรวจสอบสิทธิ์รับโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด โดยระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณก่อนแสดงจำนวนโบนัส และถ้ารองรับการโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดกับประวัติการรับสิทธิ์ได้จากบัญชี ส่วนแนะนำเพื่อนระบุอัตราโบนัส 0.8% จากยอดที่เข้าเกณฑ์ตามข้อกำหนด แล้วดูรายละเอียดลิงก์แนะนำ จำนวนเพื่อนที่สมัคร และวิธีคำนวณโบนัสผ่านระบบสมาชิกได้ ข้อควรรู้คือควรตรวจสอบว่าโปรโมชั่นครอบคลุมบาคาร่า ไฮโล สล็อต หรือแทงบอลประเภทใดบ้าง เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขไม่เหมือนกัน ควรอ่านรายละเอียดประเภทเกมที่ร่วมรายการ เวลาตัดยอด และเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง และคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด เพื่อให้เข้าใจข้อกำหนดของกิจกรรมตรงกัน",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจชื่อโดเมนและข้อมูลผู้ดำเนินงานก่อนส่งข้อมูลส่วนตัว",
    stars: 4,
    tag: "สมัครเล่น 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง",
    content:
      "การสมัครเล่นดำเนินการผ่านหน้าสมัครสมาชิกของเว็บไซต์ที่เปิดให้บริการ มีขั้นตอนตั้งแต่กรอกข้อมูลจนถึงยืนยันบัญชี ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิกโดยเลือกเมนูสมัครจากทางเข้าหลัก พร้อมตรวจสอบชื่อเว็บไซต์และข้อมูลผู้ให้บริการให้ถูกต้องก่อนดำเนินการต่อ ขั้นตอนที่ 2 กรอกข้อมูลบัญชีตามแบบฟอร์มที่ระบบกำหนด พร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น เพื่อช่วยลดความเสี่ยงในการเข้าถึงบัญชีโดยไม่ได้รับอนุญาต ขั้นตอนที่ 3 ตรวจสอบและยืนยันการสมัคร ทบทวนข้อมูล อ่านข้อกำหนดให้ครบถ้วน แล้วยืนยันบัญชีตามขั้นตอนของเว็บไซต์ก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและรายละเอียดการใช้งาน ข้อที่อยากกำกับไว้คือผู้สมัครควรตรวจสอบชื่อโดเมน ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งานก่อนส่งข้อมูลส่วนตัว รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตน เรื่องติดต่อก็แจ้งแอดมินผ่านช่องทางหลักที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง หากพบปัญหาเกี่ยวกับบาคาร่า ไฮโล หรือสล็อต ควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ส่วนการเดิมพันฟุตบอลควรเตรียมชื่อคู่แข่งขันและหมายเลขรายการ หากเป็นเรื่องโปรโมชั่นควรระบุชื่อกิจกรรมและรอบรับสิทธิ์ โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#cfdcec] via-[#6ec8ff] to-[#0360f3] shadow-[0_0_12px_rgba(3,96,243,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#dde8f7] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#6ec8ff]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#9db4d4]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมทางเข้าเดิมพันและหมวดเกมทั้งบาคาร่า ไฮโล สล็อต แทงบอล การตรวจสอบยอดเดิมพันจากบัญชีเดียว โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์
        พร้อมการสมัครเล่น 3 ขั้นตอนและช่องทางแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0360f3]/30 border-l-[#0360f3] bg-[#0a1c42] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#cfdcec] to-[#4fb4ff] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9db4d4]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#04186e] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#6ec8ff]" : "text-[#6ec8ff]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dde8f7]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#0292fb]/45 bg-[#040e26] px-3 py-1 text-[10px] font-bold tracking-widest text-[#6ec8ff] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0292fb]/25 bg-[#040e26] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#0292fb]/70 hover:shadow-[0_15px_40px_rgba(2,146,251,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#0360f3]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#0360f3]/34"
          />

          <div class="flex items-center gap-4 border-b border-[#04186e] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#032dad] bg-gradient-to-br from-[#cfdcec] via-[#6ec8ff] to-[#0292fb] text-2xl text-[#021026] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#dde8f7] transition-colors group-hover:text-[#6ec8ff]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9db4d4]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#6ec8ff]" : "text-[#6ec8ff]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#0292fb]/45 bg-[#0a1c42] px-3 py-1 text-[10px] font-bold tracking-widest text-[#6ec8ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#0292fb]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dde8f7]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
