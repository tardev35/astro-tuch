---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "ผู้ให้บริการระบบพนันออนไลน์ที่รวมเกมหลายประเภทไว้ในระบบเดียว
// จากบริษัทหลักโดยตรง" ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้เอง: บาคาร่า สล็อต หวย
// บอล ไฮโล ผ่านบัญชีเดียว, รองรับมือถือและคอมพิวเตอร์, เมนูจัดหมวดหมู่ชัดเจนและ
// เข้าถึงง่าย, ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการก่อนเข้าเล่น, โปรโมชั่น
// ที่กดรับหลังสมัครได้ตามเงื่อนไข, โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3%,
// ฝากถอนผ่านวอลเลทและธนาคารที่เว็บไซต์กำหนด และแอดมินตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนรับปากว่าจะชนะ บอกอัตราการจ่าย หรืออ้างใบอนุญาต
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// THE88 (รอบแดง-ทอง 2026-09-23): แถบระบุตัวสมาชิกไล่จากแดงสด #dd0503 ลงแดง
// แบรนด์ #a40201 ไปหาแดงเข้ม #6b0302 ตามตัวอักษร THE บนโลโก้ ส่วนดาวและป้ายแท็ก
// รับทองหลัก #f2c14e ตามเลข 88 ที่เป็นครีมขอบทอง กรอบการ์ดกับเส้นคั่นเป็นแดงเข้ม
// บนพื้นการ์ด #2d0908 เหนือพื้นเพจ #1c0504 ชื่อหัวข้อเป็นทองอ่อน #ffe7a6 —
// ชมพูมาเจนตา-ทองของ WY88 ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นบาคาร่าและสล็อตจากบัญชีเดียว",
    stars: 5,
    tag: "รวมเกมไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมหลายประเภทไว้ในระบบเดียวจริง เลือกได้ทั้งบาคาร่า สล็อต หวย บอล และไฮโล จากบัญชีเดียว ไม่ต้องเปิดหลายระบบให้วุ่นวาย เมนูจัดหมวดหมู่ไว้ชัดเจน กดเข้าหมวดที่อยากเล่นได้เลย เปิดจากมือถือก็ได้ สลับไปใช้คอมพิวเตอร์ก็หน้าตาเดียวกัน",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูรายละเอียดเกมและค่ายก่อนเข้าเล่นทุกครั้ง",
    stars: 5,
    tag: "ตรวจรายละเอียดก่อนเข้าเล่น",
    content:
      "ชอบตรงที่ตรวจสอบรายละเอียดเกมและค่ายที่เปิดให้บริการได้ก่อนเข้าเล่น เลยเลือกประเภทที่เหมาะกับรูปแบบการใช้งานของตัวเองได้ ระบบออกแบบมาให้รองรับหลายอุปกรณ์ เปิดจากมือถือระหว่างวันแล้วค่อยมาต่อบนคอมพิวเตอร์ก็ไม่มีปัญหา เมนูอยู่ที่เดิมและเข้าถึงง่าย",
    avatar: "🎰",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "เช็กเงื่อนไขโปรโมชั่นและช่องทางฝากถอนก่อนใช้งาน",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "โปรโมชั่นมีให้เลือกหลายรูปแบบตามเงื่อนไขของแต่ละรายการ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ที่ดีคือบางรายการตรวจสอบและกดรับหลังสมัครได้ตามเงื่อนไขที่กำหนด เลยดูรอบคำนวณกับยอดที่เข้าเกณฑ์ก่อนได้ ส่วนฝากถอนใช้วอลเลทหรือธนาคารที่เว็บไซต์กำหนด ตรวจยอดเครดิตและสถานะรายการจากบัญชีตัวเองได้ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dd0503] via-[#a40201] to-[#6b0302] shadow-[0_0_12px_rgba(164,2,1,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ffe7a6] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f2c14e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f7e3dd]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมบาคาร่า สล็อต หวย บอล และไฮโลไว้ในบัญชีเดียว การตรวจสอบรายละเอียดเกมก่อนเข้าเล่น และการเช็กเงื่อนไขโปรโมชั่นกับช่องทางฝากถอน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#6b0302] border-l-[#a40201] bg-[#2d0908]/94 px-6 py-4 shadow-[0_10px_30px_rgba(28,5,4,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe7a6] to-[#f2c14e] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f7e3dd]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#6b0302] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2c14e]" : "text-[#6b0302]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f7e3dd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#6b0302] bg-[#1c0504] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe7a6] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#6b0302] bg-[#2d0908]/94 p-5 shadow-[0_10px_30px_rgba(28,5,4,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#a40201]/75 hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a40201]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#f2c14e]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#6b0302] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#a40201]/60 bg-gradient-to-br from-[#dd0503] via-[#a40201] to-[#6b0302] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ffe7a6] transition-colors group-hover:text-[#f2c14e]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f7e3dd]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f2c14e]" : "text-[#6b0302]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a40201]/65 bg-[#1c0504] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe7a6] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f2c14e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f7e3dd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
