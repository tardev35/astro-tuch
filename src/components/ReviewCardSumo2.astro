---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "เว็บรวมเกมคาสิโนที่มีทั้งบาคาร่า รูเล็ต และเกมโต๊ะยอดนิยมจาก
// หลายค่ายให้เลือกในระบบเดียว" ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้เอง: บาคาร่า
// รูเล็ต คาสิโนสด และเกมเดิมพันประเภทอื่นตามรายการที่เปิดให้บริการ, รองรับทั้ง
// มือถือและคอมพิวเตอร์, เมนูจัดหมวดหมู่ชัดเจนจึงค้นหาเกมได้ง่าย, ตรวจสอบชื่อค่าย
// รายละเอียดเกม และระดับเดิมพันก่อนเข้าเล่น, โปรโมชั่นบางรายการกดรับหลังสมัครได้
// โดยไม่ต้องฝากก่อน, โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3%, สมัครผ่านมือถือ
// 3 ขั้นตอน และแอดมินตลอด 24 ชั่วโมง ไม่มีข้อความไหนรับปากว่าจะชนะ บอกอัตราการจ่าย
// อ้างใบอนุญาต หรือพูดถึงลอตเตอรี่กับกีฬา
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// SAGAME66 (รอบทอง-เงินโครเมียม 2026-09-23): แถบระบุตัวสมาชิกไล่จากทองสว่าง
// #ffe9a3 ลงทองหลัก #e8b93f ไปหาทองลึก #96671a ตามตัวอักษร SA บนโลโก้ที่เป็นทอง
// สามมิติ ส่วนดาวและป้ายแท็กรับเงินโครเมียม #eef3f8 กับเงินกลาง #b6c1cd ตาม GAME
// ที่เป็นเงิน กรอบการ์ดกับเส้นคั่นเป็นพื้นยก #2a1d0b บนพื้นการ์ด #171006 เหนือพื้น
// เพจ #0d0903 เนื้อความเป็น BRAND_TEXT #e3d8c0 — แดง-เงินเย็นของ UFAGOOL (#ef1f25
// #c50d12 #7a0103 #5e0507 #16100f #0a0708 #f4f7fa #b8c3cf #cdd5dd) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นบาคาร่าและรูเล็ตจากระบบเดียว",
    stars: 5,
    tag: "รวมเกมคาสิโนไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมคาสิโนไว้ในระบบเดียวจริง มีทั้งบาคาร่า รูเล็ต และเกมโต๊ะยอดนิยมจากหลายค่ายให้เลือก ไม่ต้องสลับไปมาหลายที่ เปิดจากมือถือก็ได้ สลับมาใช้คอมพิวเตอร์ก็ใช้งานได้เหมือนกัน",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูชื่อค่ายและระดับเดิมพันก่อนเข้าเล่นทุกครั้ง",
    stars: 5,
    tag: "ค่ายมาตรฐานสากล ตรวจสอบก่อนเข้าเล่น",
    content:
      "ชอบตรงที่ระบบจัดหน้าเกมให้ค้นหาได้ง่าย เมนูแบ่งหมวดหมู่ชัดเจน เลยหาเกมที่ต้องการเจอเร็ว ก่อนเข้าเล่นยังตรวจสอบชื่อค่าย รายละเอียดเกม และระดับเดิมพันได้ เลือกเกมที่ตรงกับสไตล์ตัวเองได้สะดวกขึ้นมาก",
    avatar: "🎡",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือแล้วเช็กเงื่อนไขโปรโมชั่นก่อนกดรับ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "สมัครผ่านมือถือเองได้ กรอกข้อมูล ตรวจความถูกต้อง แล้วยืนยันบัญชี สามขั้นตอนจบ โปรโมชั่นบางรายการกดรับหลังสมัครได้โดยไม่ต้องทำรายการฝากก่อนตามเงื่อนไขที่กำหนด ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ก็ดูรอบคำนวณกับยอดที่เข้าเกณฑ์ก่อนได้ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#e8b93f] to-[#96671a] shadow-[0_0_12px_rgba(232,185,63,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#eef3f8] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e8b93f]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e3d8c0]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมบาคาร่า รูเล็ต คาสิโนสด และเกมโต๊ะยอดนิยมไว้ในระบบเดียว การตรวจสอบชื่อค่ายกับระดับเดิมพันก่อนเข้าเล่น และการสมัครผ่านมือถือกับการเช็กเงื่อนไขโปรโมชั่น
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#2a1d0b] border-l-[#e8b93f] bg-[#171006]/94 px-6 py-4 shadow-[0_10px_30px_rgba(13,9,3,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe9a3] to-[#e8b93f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e3d8c0]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#2a1d0b] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#eef3f8]" : "text-[#2a1d0b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e3d8c0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#2a1d0b] bg-[#0d0903] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe9a3] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#2a1d0b] bg-[#171006]/94 p-5 shadow-[0_10px_30px_rgba(13,9,3,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#e8b93f]/75 hover:shadow-[0_15px_40px_rgba(232,185,63,0.4)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e8b93f]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#eef3f8]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#2a1d0b] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e8b93f]/60 bg-gradient-to-br from-[#ffe9a3] via-[#e8b93f] to-[#96671a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#eef3f8] transition-colors group-hover:text-[#ffe9a3]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e3d8c0]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#eef3f8]" : "text-[#2a1d0b]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e8b93f]/65 bg-[#0d0903] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe9a3] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8b93f]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e3d8c0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
