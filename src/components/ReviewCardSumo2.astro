---
// Slot brand — every row stays inside what the brief names: การเลือกเกมสล็อตจาก
// หลายค่ายในระบบเดียว, สล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส และสล็อตแจ็กพอต, การตรวจ
// ช่วงเดิมพัน อัตราจ่าย Paytable และรายละเอียดฟีเจอร์ก่อนเริ่มเล่น, การยึดเงื่อนไข
// วงเงินถอนล่าสุดจากหน้าฝากถอน, โบนัสแนะนำเพื่อน 0.8% ที่ผู้ถูกแนะนำต้องมียอด
// ตามเกณฑ์, คืนยอดเสีย 0.3% ตามรอบ และการติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน
// และรายละเอียดของรายการ.
// The brief is explicit that เกมสล็อตไม่สามารถรับประกันผลกำไรหรือรางวัลได้, so
// nothing here promises a payout, a win rate, or a product the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่อ่านรายละเอียดเกมก่อนกด Spin",
    role: "เปิดช่วงเดิมพันและ Paytable ทุกครั้งก่อนเลือกเกม",
    stars: 5,
    tag: "ช่วงเดิมพัน · Paytable · ฟีเจอร์",
    content:
      "ในระบบมีทั้งสล็อตเบทต่ำ เกมฟรีสปิน เกมโบนัส และสล็อตแจ็กพอตจากหลายค่าย เลยไล่ดูช่วงเดิมพัน อัตราจ่าย Paytable และรายละเอียดฟีเจอร์ของแต่ละเกมก่อนเริ่มเล่นทุกครั้ง พอเห็นว่าเกมจ่ายรางวัลอย่างไรก็เลือกขนาดเดิมพันให้เหมาะกับเครดิตที่มีได้ ถึงอย่างนั้นเกมสล็อตก็ไม่สามารถรับประกันผลกำไรหรือรางวัลได้",
    avatar: "📖",
  },
  {
    name: "สมาชิกที่เช็กเงื่อนไขก่อนกดรับโบนัส",
    role: "อ่านยอดที่นำมาคำนวณและรอบการรับก่อนทุกครั้ง",
    stars: 5,
    tag: "โบนัส 0.8% · คืนยอดเสีย 0.3%",
    content:
      "แชร์ลิงก์แนะนำให้เพื่อนแล้วเข้าใจว่าการแชร์อย่างเดียวอาจยังไม่ได้โบนัส เพราะโปรกำหนดให้ผู้ถูกแนะนำต้องสมัคร ฝากเงิน หรือมียอดเล่นตามเกณฑ์ก่อน ส่วนโบนัสคืนยอดเสีย 0.3% ก็ตรวจประเภทเกมสล็อต รอบคำนวณ และข้อกำหนดการถอนโบนัสจากบัญชีสมาชิกก่อนกดรับสิทธิ์",
    avatar: "🤝",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนรายการมีปัญหา",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ",
    stars: 4,
    tag: "แอดมิน LUCKY88 หลังบ้าน",
    content:
      "ฝากแล้วเครดิตยังไม่เข้า เลยตรวจสถานะธุรกรรมในบัญชีก่อน จากนั้นทักแอดมิน LUCKY88 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ ทำให้ทีมงานตรวจสอบระบบหลังบ้านได้ตรงจุดตลอด 24 ชั่วโมง ทีมงานยังย้ำให้ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP หรือรหัสผ่านให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LUCKY88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f4f6f8] via-[#ff3b4d] to-[#c1121f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff3b4d]">LUCKY88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01a2b] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#7a1219]/70 bg-[#170a0b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(224,26,43,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ff3b4d] to-[#8e0407] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9aa2ab] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a1219]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff3b4d]" : "text-[#5c0f14]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8dadb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7a1219]/70 bg-[#170a0b]/92 p-6 text-left shadow-[0_10px_30px_rgba(4,2,2,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e01a2b]/70 hover:shadow-[0_15px_40px_rgba(224,26,43,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ff3b4d] to-[#8e0407] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8e0407]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#e01a2b]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7a1219]/80 bg-[#040202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff3b4d] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff3b4d]" : "text-[#5c0f14]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8dadb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a1219] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e01a2b]/55 bg-gradient-to-br from-[#ff3b4d] via-[#e01a2b] to-[#8e0407] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ff3b4d] transition-colors group-hover:text-[#f4f6f8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9aa2ab] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
