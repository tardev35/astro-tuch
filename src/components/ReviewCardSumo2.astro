  {
    name: "คุณธนากร ว.",
    role: "ไล่อ่านราคาต่อรองของฟุตบอล ธีมและฟีเจอร์ของสล็อต และกติกาเฉพาะของบาคาร่าให้จบก่อน แล้วค่อยทำรายการ",
    stars: 5,
    tag: "ฟุตบอล · สล็อตออนไลน์ · บาคาร่า",
    content:
      "ที่ใช้งานต่อเพราะเว็บไซต์รวบรวมข้อมูลเกมเดิมพันออนไลน์หลายประเภทไว้ในช่องทางเดียว ทั้งฟุตบอลที่มีรูปแบบราคาต่อรองแตกต่างกัน สล็อตออนไลน์ที่มีธีมและฟีเจอร์ให้ศึกษา และบาคาร่าซึ่งเป็นเกมไพ่ที่มีกติกาเฉพาะ ทำให้เทียบอัตราจ่ายและเงื่อนไขการเดิมพันของแต่ละประเภทได้ก่อนใช้งาน โดยไม่ต้องไล่เปิดทีละหน้า ส่วนที่อยากกำกับไว้ให้ตรงกันคือควรตรวจสอบรายชื่อค่ายเกมที่เปิดให้บริการจริง และข้อมูลเกี่ยวกับการเป็นเว็บตรงหรือเชื่อมต่อค่ายเกมโดยตรงควรตรวจสอบจากหลักฐานของผู้ให้บริการ เพราะไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว",
    avatar: "⚽",
    accent: "gold" as const,
  },
  {
    name: "คุณพิมพ์ชนก ส.",
    role: "อ่านประกาศล่าสุดของโปรโมชั่นให้ครบ แล้วค่อยตรวจรอบเวลารับเครดิตอีกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เงื่อนไขการใช้โบนัส",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือข้อมูลโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตตามยอดเสียที่เข้าเงื่อนไขในแต่ละวัน และโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ แต่ละรายการมีข้อกำหนดเกี่ยวกับประเภทเกม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน จึงต้องตรวจสอบวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี รอบจ่ายเครดิต และดูว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่จากประกาศล่าสุดทุกครั้ง ที่ต้องเข้าใจตรงกันคือเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต",
    avatar: "🎁",
    accent: "chrome" as const,
  },
  {
    name: "คุณอรรถพล ม.",
    role: "ตรวจชื่อบัญชีปลายทางกับข้อมูลผู้ให้บริการก่อนโอน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใคร",
    stars: 4,
    tag: "สมัครสมาชิก · ฝากถอน · ติดต่อแอดมิน 24ชม.",
    content:
      "ตอนเริ่มใช้งานได้อ่านคุณสมบัติผู้สมัคร อายุที่ได้รับอนุญาต และข้อกำหนดการเปิดบัญชีจากเว็บไซต์ทางการก่อนลงทะเบียน จากนั้นจึงตั้งรหัสผ่านที่ปลอดภัยและเข้าสู่ระบบเพื่อศึกษาประเภทเกม กติกา อัตราเดิมพัน และเงื่อนไขฝากถอน ก่อนทำธุรกรรมจะตรวจสอบยอดขั้นต่ำและชื่อบัญชีรับเงินให้ตรงกับข้อมูลผู้ให้บริการเสมอ เพื่อหลีกเลี่ยงความเสี่ยงจากบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเก็บหลักฐานรายการไว้แล้วติดต่อเจ้าหน้าที่ และหากข้อมูลบัญชีผิดปกติก็หยุดทำรายการแล้วติดต่อธนาคาร เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามแอดมินเกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงและระยะเวลาตอบกลับจากประกาศล่าสุดอีกครั้ง",
    avatar: "💬",
    accent: "gold" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8ecf1] via-[#fee45d] to-[#7a4e05] shadow-[0_0_12px_rgba(254,228,93,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#eae3d4] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#fee45d]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#a8b2bf]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลฟุตบอลที่มีรูปแบบราคาต่อรองแตกต่างกัน สล็อตออนไลน์ที่มีธีมและฟีเจอร์ให้ศึกษา และบาคาร่าเกมไพ่ที่มีกติกาเฉพาะ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครสมาชิกและเงื่อนไขฝากถอน พร้อมช่องทางติดต่อเจ้าหน้าที่ที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#e6a416]/35 border-l-[#e6a416] bg-[#1e1a13] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.5)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fee45d] to-[#e6a416] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e6a416]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5a6472] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fee45d]" : "text-[#fee45d]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#eae3d4]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#e6a416]/50 bg-[#0a0908] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fee45d] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#e6a416]/30 bg-[#15130f] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-[#fee45d]/75 hover:shadow-[0_15px_40px_rgba(254,228,93,0.2)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a8b2bf]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#fee45d]/22"
          />

          <div class="flex items-center gap-4 border-b border-[#5a6472]/50 pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "gold" ? "border border-[#7a4e05] bg-gradient-to-br from-[#fee45d] to-[#e6a416] text-[#140e02]" : "border border-[#5a6472] bg-gradient-to-br from-[#e8ecf1] to-[#a8b2bf] text-[#0b0d10]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#eae3d4] transition-colors group-hover:text-[#fee45d]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a8b2bf]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fee45d]" : "text-[#fee45d]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e6a416]/45 bg-[#0a0908] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fee45d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fee45d]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#eae3d4]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
