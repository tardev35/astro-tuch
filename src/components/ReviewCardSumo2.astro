---
import { BRAND_NAME } from "../lib/brandProfile";

// SUPERSLOTCLUB (2026-10-09): บรีฟรอบนี้เป็น **คลับ/ชุมชนคนเล่นสล็อตซุปเปอร์ ภายใต้
// แนวคิดกลุ่มลับคนดังวงการสล็อตออนไลน์** ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจากคำของบรีฟรอบ
// นี้เอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิมของ KINGKONG555 ที่พูดถึง
// "ฐานเว็บสล็อตหลัก / เบทต่ำ 1 บาท / ตารางจ่าย / ช่วงเดิมพัน" หรือของ WEPLAY168 ก่อน
// หน้านั้นที่พูดถึงสล็อตออโต้ แตกง่าย ไม่มีขั้นต่ำ และอัตราการคืนเงินผู้เล่น — คำชุดนั้น
// เป็นของบรีฟรอบก่อน ไม่ใช่ของบรีฟนี้ และ brand-spec §6 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: คลับคนเล่นสล็อตซุปเปอร์ที่นำเสนอรูปแบบชุมชนสำหรับ
// ผู้สนใจเกมสล็อตออนไลน์ · รวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่น
// ที่เปิดให้รับในแต่ละช่วง · ติดตามเกมใหม่ ตรวจสอบรายละเอียดโบนัส และเลือกหมวดเกมที่
// สนใจผ่านระบบเดียว · สล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ เกมใหม่จากค่ายที่เปิดให้
// บริการ · จัดหมวดหมู่ให้ค้นหาเกมสะดวก · ดับเบิ้ลโบนัสคือโปรโมชั่นมากกว่าหนึ่งรูปแบบ
// ให้เลือกตามเงื่อนไข · คืนยอดเสีย 0.3% ตามรอบประจำวัน · แนะนำเพื่อน 0.8% จากยอดที่
// เข้าเกณฑ์ผ่านลิงก์แนะนำ · ฝากถอนเข้าบัญชีบริษัทโดยตรง ตรวจชื่อบัญชีปลายทางก่อน
// ยืนยันรายการ · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP เป็นตัวเลข ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก ปีก่อตั้ง หรือชื่อบุคคลมีชื่อเสียงที่อ้างว่าอยู่ในกลุ่มลับ — บรีฟ
// รอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสามตัว: 0.3% · 0.8% · 24 ชั่วโมง
// (ไม่มี "1 บาท" ซึ่งเป็นตัวเลขพาดหัวของ KINGKONG555 รอบก่อน) และบรีฟเป็นโทน hedged
// ทุกย่อหน้า จึงคงประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว (การกล่าวถึงกลุ่มลับหรือ
// บุคคลมีชื่อเสียงควรมีข้อมูลที่ตรวจสอบได้ · ดับเบิ้ลโบนัสไม่ได้แปลว่าได้โบนัสสองเท่า
// ทุกเกม · คำว่าไม่จำกัดควรระบุให้ชัด · ชื่อบัญชีบริษัทอย่างเดียวไม่รับประกันว่าธุรกรรม
// จะไม่มีความเสี่ยง)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 แดงเสือโคร่ง-ทองถ่านไฟบนน้ำตาลถ่านเกือบดำ): สีหลักคือ
// **แดงเสือโคร่ง** #e8232a สีรองคือ **ทองถ่านไฟ** #f2b705 บนผิวการ์ดยก #3d1709
// ไม่ใช่ผิวม่วงแบบรอบ WEPLAY168 — สันนำหน้าหัวข้อไล่ครีมอุ่น #f5cbb0 → แดงเรืองไฟ
// #ff5a46 → แดงแบรนด์ #e8232a ชื่อแบรนด์ในหัวข้อใช้แดงเรืองไฟ #ff5a46 ซึ่ง §2
// อนุญาตให้ถือตัวอักษรขนาดใหญ่/หนาได้ (5.2:1) ขณะที่ #e8232a ใช้ไม่ได้เลย (3.5:1)
// ป้ายอวาตาร์เป็นแผ่นทองทึบ ไล่ทองสว่าง #ffd666 → ทองแบรนด์ #f2b705 → ทองกลางเข้ม
// #c08a0b บนหมึก #2b0a00 (6.0:1 ที่ปลายเข้มสุด — ห้ามใช้ #a8730a เป็นปลายเข้มของ
// แผ่นที่มีหมึก เพราะได้แค่ 4.48:1 และห้ามพลิกแผ่นทองไปใช้ตัวอักษรสว่าง)
// คะแนนเฉลี่ยไล่ครีมอุ่น → ทองแบรนด์ ดาวที่ติดเป็นทองแบรนด์ ดาวที่ยังไม่ติดเป็นแดงลึก
// #7d0f12 จุดกะพริบบนป้ายใช้แดงเรืองไฟ ออรามุมขวาบนเป็นแดงแบรนด์โปร่ง กรอบการ์ดเป็น
// แดงแบรนด์โปร่ง ชิปตกลงไปที่ผิวลึกสุด #180800 เนื้อความและชื่อสมาชิก #fbe8d5
// (= BRAND_TEXT) ตัวรองใช้ชมพูอมเทาหม่น #c9a898 ซึ่ง §2 พินไว้ให้คำบรรยายโดยเฉพาะ
// glow เป็น rgba(232,35,42,…)
//
// ⚠️ รอบนี้ฮิวแบรนด์เองเป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดง เจอแดงที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่
// เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #5b1a75 #d2a6ff #efe6ff #fbe455 #ffd23d #c98a05
// #17062e #0a0117 #190633 #ece2ff rgba(164,53,240,α)) และชุดฟ้าสด-เหลืองมะนาวของ
// แตกดี168 ก่อนนั้น (#0193fb #7bcffb #d4ecfd #0b6fc4 #064a86 #fce604 #c9a703
// #07111d #020609 #031018 #dbeafe #93b4d4) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ติดตามเกมใหม่และเลือกหมวดเกมผ่านระบบเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมฟรีสปิน · โบนัสตัวคูณ · เกมใหม่จากค่ายที่เปิดให้บริการ",
    content:
      "ที่ใช้ต่อเพราะเป็นคลับคนเล่นสล็อตซุปเปอร์ที่นำเสนอรูปแบบชุมชนสำหรับผู้สนใจเกมสล็อตออนไลน์ มีการรวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่นที่เปิดให้รับในแต่ละช่วงมาไว้ด้วยกัน เลยติดตามเกมใหม่จากค่ายที่เปิดให้บริการ ตรวจสอบรายละเอียดโบนัส และเลือกหมวดเกมที่สนใจได้ผ่านระบบเดียวโดยไม่ต้องสลับไปมา เกมที่เปิดให้เลือกมีทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ ตัวที่ชอบที่สุดคือการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก เพราะเวลาอยากหาเกมฟรีสปินหรือเกมที่มีโบนัสตัวคูณก็กดเข้าหมวดได้ตรงๆ ข้อที่อยากให้อ่านกันก่อนคือเรื่องแนวคิดกลุ่มลับคนดังวงการสล็อตออนไลน์ การกล่าวถึงกลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลกิจกรรมและผู้เข้าร่วมที่ตรวจสอบได้ประกอบ เพื่อไม่ให้เกิดความเข้าใจคลาดเคลื่อน ส่วนรายการเกมและกิจกรรมที่เปิดให้บริการจริงตรวจสอบได้จากหน้าเว็บไซต์",
    avatar: "🐯",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณ",
    stars: 5,
    tag: "ดับเบิ้ลโบนัส · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบโปรโมชั่นตามแคมเปญที่เปิดให้บริการได้เอง ทั้งยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะโบนัสจากบัญชีสมาชิกโดยตรง ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามเงื่อนไขจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด ถ้ามีการโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดและประวัติการรับสิทธิ์จากบัญชีได้ ส่วนแนะนำเพื่อนคือใช้ลิงก์แนะนำเชิญเพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ แล้วดูจำนวนเพื่อนและสถานะโบนัสผ่านบัญชีสมาชิกได้ ข้อควรรู้คือคำว่าดับเบิ้ลโบนัสไม่ได้หมายความว่าจะได้รับโบนัสสองเท่าจากทุกเกมหรือทุกรายการเสมอไป ควรตรวจสอบว่าโปรโมชั่นใดสามารถรับร่วมกันได้ รวมถึงค่ายเกมที่เข้าร่วม ระยะเวลา และข้อกำหนดของแต่ละกิจกรรมก่อนรับสิทธิ์ และคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจชื่อบัญชีปลายทางก่อนยืนยันรายการทุกครั้ง",
    stars: 4,
    tag: "ฝากถอนเข้าบัญชีบริษัทโดยตรง · บัญชีปลายทาง · แอดมิน 24 ชั่วโมง",
    content:
      "ก่อนยืนยันรายการจะตรวจยอดเงิน ชื่อบัญชี และรายละเอียดปลายทางผ่านระบบก่อนทุกครั้ง ถ้าเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ก็ควรมีชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้ เพื่อเอามาเปรียบเทียบกับชื่อบัญชีรับเงินได้อย่างถูกต้อง ข้อที่อยากกำกับไว้คือข้อความไม่ผ่านบัญชีม้า ควรมีข้อมูลผู้รับเงินและหลักฐานการดำเนินงานประกอบ เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ถ้าพบว่าชื่อบัญชีปลายทางไม่ตรงกับข้อมูลที่ระบบแจ้ง ควรสอบถามฝ่ายบริการผ่านช่องทางหลักก่อนทำรายการ และเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสิ้น เรื่องติดต่อก็แจ้งแอดมินได้ตลอด 24 ชั่วโมง ปัญหาเกี่ยวกับเกมสล็อตให้แจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ปัญหาโปรโมชั่นให้ระบุชื่อกิจกรรมและรอบรับสิทธิ์ ส่วนเรื่องฝากถอนให้เตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้สำหรับตรวจสอบ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5cbb0] via-[#ff5a46] to-[#e8232a] shadow-[0_0_12px_rgba(232,35,42,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fbe8d5] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ff5a46]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#c9a898]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามเกมใหม่และเลือกหมวดเกมทั้งสล็อตคลาสสิก เกมฟรีสปิน และโบนัสตัวคูณผ่านระบบเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
        จากยอดที่เข้าเกณฑ์ และการตรวจชื่อบัญชีปลายทางก่อนยืนยันรายการพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#e8232a]/30 border-l-[#e8232a] bg-[#3d1709] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f5cbb0] to-[#f2b705] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#c9a898]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7d0f12] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2b705]" : "text-[#7d0f12]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#fbe8d5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#a8730a]/45 bg-[#180800] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2b705] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#e8232a]/25 bg-[#3d1709] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#e8232a]/70 hover:shadow-[0_15px_40px_rgba(232,35,42,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e8232a]/26 blur-[60px] transition-all duration-300 group-hover:bg-[#e8232a]/40"
          />

          <div class="flex items-center gap-4 border-b border-[#7d0f12] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#a8730a] bg-gradient-to-br from-[#ffd666] via-[#f2b705] to-[#c08a0b] text-2xl text-[#2b0a00] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fbe8d5] transition-colors group-hover:text-[#f2b705]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#c9a898]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f2b705]" : "text-[#7d0f12]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a8730a]/45 bg-[#180800] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2b705] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff5a46]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#fbe8d5]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
