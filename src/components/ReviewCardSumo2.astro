---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นแบรนด์คาสิโนฐานหลัก ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง: เกมจากหลายค่าย
// ในระบบเดียว ทั้งเกมสด เกมโต๊ะ และหมวดเกมยอดนิยม, ระบบจัดแยกแต่ละค่ายให้ค้นหาได้ง่าย
// พร้อมรายละเอียดเกมก่อนเข้าใช้งาน, การเข้าเล่นผ่านระบบบริษัทตรงตามข้อมูลของเว็บไซต์,
// โปรโมชั่นที่อัปเดตตามช่วงเวลาโดยมีโบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่
// เข้าเงื่อนไขและวิธีรับสิทธิ์, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน, การรองรับมือถือและ
// คอมพิวเตอร์ และเจ้าหน้าที่ผ่านไลน์แอดตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้างชื่อค่ายเกม
// ชื่อเกม ค่า RTP ชื่อธนาคาร ช่องทางฝากถอน ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// MIRACLE55 (รอบทอง-โครเมียม-ดำ 2026-09-25): โลโก้เป็นเวิร์ดมาร์กสองโลหะ MI/55 ทอง
// RACLE โครเมียม การ์ดรีวิวจึงใช้ทองกับเงินแยกหน้าที่กัน — สันนำหน้าหัวข้อ ป้ายระบุตัว
// สมาชิก และดาว เป็นทอง (ทองสว่าง #fee47b → ทองแบรนด์ #fcda65 → ทองลึก #8c5f14) ส่วน
// ชื่อสมาชิก คะแนนเฉลี่ย และป้ายแท็กรับโครเมียม (#fcfcfc #d2d3d4 #a8acb1) ตามคำว่า
// RACLE กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #2c241c บนผิวการ์ด #14100a เหนือพื้นเพจ
// #050403 เนื้อความเป็น BRAND_TEXT #e8e6e1 และตัวเน้นเป็น #fcfcfc — ชุดทอง-ครีมอุ่นของ
// KINGDOM66 (#e6bf4e #f2d683 #5c4113 #efe6cf #fdf6e0 #241c13 #151109 #ebe3d3)
// ออกทั้งหมด แบรนด์นี้ไม่มีครีมอุ่น มีแต่เงินเย็น
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมสด เกมโต๊ะ และหมวดเกมยอดนิยมจากระบบเดียว",
    stars: 5,
    tag: "รวมหลายค่ายในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมจากหลายค่ายไว้ในระบบเดียวจริง ทั้งคาสิโนสด เกมโต๊ะ และหมวดที่ได้รับความนิยมตามรายการที่เว็บไซต์เปิดให้บริการ ระบบจัดแยกแต่ละค่ายไว้จนค้นหาหมวดที่สนใจได้เร็ว เปิดจากมือถือหรือคอมพิวเตอร์ก็เลือกเกมได้จากบัญชีเดียวเหมือนกัน",
    avatar: "📺",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจรายละเอียดเกมและค่ายที่ให้บริการก่อนเข้าใช้งาน",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ชอบตรงที่เปิดดูรายละเอียดเกมและดูได้ว่าแต่ละรายการมาจากค่ายใดก่อนกดเข้าใช้งาน ฝั่งโปรโมชั่นก็อัปเดตตามช่วงเวลา มีทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งหน้าโปรโมชั่นแสดงยอดที่เข้าเงื่อนไข รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจก่อนกดรับทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามผ่านไลน์แอด",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้แค่ 3 ขั้นตอนตามที่เว็บไซต์บอกไว้ พอยืนยันบัญชีเสร็จก็เข้าสู่ระบบเลือกเกมกับตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้ทันที ติดตรงไหนเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี ก็ถามเจ้าหน้าที่ผ่านไลน์แอดได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💬",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fee47b] via-[#fcda65] to-[#8c5f14] shadow-[0_0_12px_rgba(252,218,101,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fcfcfc] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fcda65]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e8e6e1]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมเกมสด เกมโต๊ะ และหมวดเกมยอดนิยมจากหลายค่ายไว้ในระบบเดียว การค้นหาเกมจากเมนูที่ระบบจัดแยกไว้ และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#2c241c] border-l-[#fcda65] bg-[#14100a]/94 px-6 py-4 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fcfcfc] to-[#a8acb1] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e8e6e1]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#2c241c] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcda65]" : "text-[#2c241c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8e6e1]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#2c241c] bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d2d3d4] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#2c241c] bg-[#14100a]/94 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fcda65]/70 hover:shadow-[0_15px_40px_rgba(252,218,101,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fcda65]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#d2d3d4]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#2c241c] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fcda65]/65 bg-gradient-to-br from-[#fee47b] via-[#fcda65] to-[#8c5f14] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fcfcfc] transition-colors group-hover:text-[#d2d3d4]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e8e6e1]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fcda65]" : "text-[#2c241c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a8acb1]/45 bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d2d3d4] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcda65]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e8e6e1]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
