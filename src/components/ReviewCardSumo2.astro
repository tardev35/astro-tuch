// c0c0bf a1a09e (พักยก168) e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) **ห้ามกลับเข้ามา**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีเขียว
// ไม่มีบรอนซ์ ไม่มีม่วง/ไวโอเลต ไม่มีส้ม ไม่มีโรสโกลด์ ไม่มีครีม/เบจ/พีช และ
// ไม่มีแรมป์เทาเงินเย็น** (ดาวเหลือง เหรียญทอง เสื้อคลุมถักฟ้าอ่อน ฉากสตูดิโอขาว
// และสีผิวนักแสดงเป็น **วัตถุในภาพ** ไม่ใช่สีแบรนด์)
const reviews = [
  {
    name: "คุณชัชวาล พ.",
    role: "ไล่อ่านรายละเอียดเกมและยอดเดิมพันขั้นต่ำของแต่ละค่ายให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "เกมสล็อตออนไลน์ · รวมค่ายดัง · เบทต่ำ 1 บาท",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอเกมสล็อตออนไลน์หลายรูปแบบไว้ในที่เดียว ทั้งสล็อตคลาสสิก เกมโบนัส และเกมสล็อตจากค่ายต่าง ๆ พร้อมข้อมูลการเดิมพันเริ่มต้นระดับต่ำสำหรับคนที่อยากศึกษารูปแบบเกมด้วยงบประมาณจำกัด ตามข้อมูลที่ระบุมีเกมที่กำหนดระดับการเดิมพันเริ่มต้น 1 บาทอยู่ด้วย แต่ก่อนใช้งานก็ยังต้องตรวจยอดเดิมพันขั้นต่ำของแต่ละเกม ตารางจ่ายรางวัล และค่า RTP จากผู้พัฒนาเกมอยู่ดี เพราะเกมบางประเภทอาจกำหนดระดับการเดิมพันแตกต่างกัน ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างว่าแตกง่ายหรือถอนได้ไม่จำกัด ควรพิจารณาจากข้อมูลและเงื่อนไขจริง เพราะเกมสล็อตไม่สามารถรับประกันผลรางวัล และการถอนเงินอาจมีข้อจำกัดตามผู้ให้บริการ",
    avatar: "🕹️",
    accent: "sky" as const,
  },
  {
    name: "คุณนฤมล จ.",
    role: "อ่านประกาศล่าสุดของแต่ละโปรโมชั่นให้ครบ แล้วค่อยตรวจรอบรับเครดิตอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "ฝากรับโบนัสไม่ต้องทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุว่ารับโบนัสจากการฝากเงินได้ตลอดวันโดยไม่ต้องทำเทิร์น และยังมีรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าโปรโมชั่นใดได้รับการยกเว้นข้อกำหนดยอดเดิมพัน และมีเงื่อนไขเรื่องจำนวนครั้งที่รับสิทธิ์ วงเงินโบนัสสูงสุด หรือการถอนเงินหรือไม่ รวมถึงเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด ต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ และวิธีรับลิงก์แนะนำกับฐานยอดที่ใช้คำนวณโบนัส แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้และรอบจ่ายเครดิตจากประกาศล่าสุดก่อนตัดสินใจ ที่ต้องเข้าใจตรงกันคือการไม่ต้องทำเทิร์นไม่ได้หมายความว่าไม่มีข้อจำกัดทุกประเภท และเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป",
    avatar: "💙",
    accent: "frost" as const,
  },
  {
    name: "คุณเกรียงไกร ส.",
    role: "ตรวจชื่อบัญชีปลายทางและช่องทางติดต่อจากเว็บไซต์ทางการก่อนทำรายการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใคร",
    stars: 4,
    tag: "ระบบฝากถอน · ธนาคารและทรูมันนี่ · ติดต่อแอดมิน 24ชม.",
    content:
      "ก่อนฝากเงินจะตรวจรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ทุกครั้ง รวมถึงศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน หากพบชื่อบัญชีไม่ตรงกับข้อมูลทางการหรือมีการแจ้งเปลี่ยนบัญชีอย่างผิดปกติ จะหยุดทำรายการแล้วติดต่อธนาคารหรือผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อนโอนเงิน เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับรายชื่อเกมสล็อต การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น โดยเฉพาะเงื่อนไขโบนัสไม่ต้องทำเทิร์นและวิธีรับเครดิตคืนยอดเสีย ซึ่งควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🏧",
    accent: "sky" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#12b4ef] via-[#4fb8ea] to-[#b6e3f0] shadow-[0_0_12px_rgba(18,180,239,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#06283f] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#0f5684]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#06283f]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตออนไลน์จากค่ายต่าง ๆ โปรโมชั่นฝากรับโบนัสไม่ต้องทำเทิร์น คืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ระบบฝากถอนผ่านธนาคารและทรูมันนี่ พร้อมช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#7fcbe8] border-l-[#12b4ef] bg-[#f0faff] px-6 py-4 shadow-[0_10px_30px_rgba(15,86,132,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#0f5684]">{average}</span>
      <span class="text-sm font-black text-[#355f7d]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7fcbe8] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#0f5684]" : "text-[#0f5684]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#06283f]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#7fcbe8] bg-white px-3 py-1 text-[10px] font-bold tracking-wide text-[#355f7d] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#7fcbe8] bg-white p-5 shadow-[0_10px_30px_rgba(15,86,132,0.1)] transition-all duration-300 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#12b4ef]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#12b4ef]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#7fcbe8] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "sky"
                  ? "border border-[#0f5684] bg-gradient-to-br from-[#1a6ea8] to-[#0f5684] text-white"
                  : "border border-[#7fcbe8] bg-gradient-to-br from-white to-[#e4f6fb] text-[#06283f]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#06283f] transition-colors group-hover:text-[#0f5684]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#355f7d]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#0f5684]" : "text-[#0f5684]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#7fcbe8] bg-[#f0faff] px-3 py-1 text-[10px] font-bold tracking-wide text-[#355f7d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#12b4ef]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#06283f]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
