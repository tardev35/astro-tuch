---
import { BRAND_NAME } from "../lib/brandProfile";

// หวยคิง (2026-10-04): บรีฟรอบนี้เป็น **เว็บรับแทงหวยล้วน** ทุกแถวจึงถูกเขียนใหม่
// ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคคาสิโนของรอบ
// UP555 ก่อนหน้า กรอบที่บรีฟระบุไว้เองคือ: เลือกเลขและส่งโพยผ่านระบบบนมือถือ มีทั้ง
// เลข 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ · อัตราจ่ายสำหรับ
// รายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท · เลขที่มี
// ผู้เลือกจำนวนมากอาจมีวงเงินรับแทงต่างกันตามรอบ · สมัครผ่านมือถือ 3 ขั้นตอน ·
// ตรวจรายการหวย อัตราจ่าย เครดิต และประวัติโพยจากบัญชีตนเอง · แอดมิน 24 ชั่วโมง ·
// และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// คำของรอบก่อนๆ ถูกถอดออกทั้งชุด (สล็อต บาคาร่า บอล/เดิมพันฟุตบอล หมวดเกม ค่ายเกม
// คาสิโนสด RTP คืนยอดเสีย 0.3% แนะนำเพื่อน 0.8% ทางเข้าใหม่ ระบบอัปเกรด
// บัญชีบริษัทแท้ 100% เว็บตรงต่างประเทศ) — ไม่เหลือแม้คำเดียว
//
// ห้ามใส่ชื่อตลาดหวย (ฮานอย ลาวพัฒนา หวยหุ้น ยี่กี) เวลาเปิด-ปิดรับ ชื่อธนาคาร
// เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลย
// สักอย่าง ตัวเลขที่ใช้ได้คือ 2 ตัว · 3 ตัว · 100 · 1,000 · บาทละ 1,000 ·
// 3 ขั้นตอน · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคงประโยคกำกับของบรีฟ
// เองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล): ทองแบรนด์ #cd9a2c
// เป็นตัวระบุตัวตนของบล็อกนี้ — สันนำหน้าหัวข้อและป้ายอวาตาร์เป็นทอง ไล่ทองสว่าง
// #fdeb7c → ทองแบรนด์ #cd9a2c → ทองลึก #ab7314 บนหมึกเข้ม #120a02 ส่วนครีมอมพีช
// #fcd4c3 (ชุดขาวของนางแบบใน slide1/slide2) ถือออรามุมขวาบนกับขอบป้ายแท็ก และ
// ทองสว่าง #fdeb7c เป็นสีที่อ่านเป็นตัวอักษร คือชื่อแบรนด์ ดาวที่ติด และคะแนนเฉลี่ย
// (#fdeb7c บนผิวการ์ด #1c140b ได้ 15:1 ส่วนทองแบรนด์ได้ 7.3:1 จึงใช้เป็นเส้นกับพื้น
// เป็นหลัก) ดาวที่ยังไม่ติดใช้เส้นจาง #5c3f12 กรอบการ์ดเป็น #5c3f12 ชิปตกลงไปที่
// พื้นลึกสุด #0c0b0a เนื้อความและชื่อสมาชิก #f5e7c8 (= BRAND_TEXT) ตัวรองใช้
// #f5e7c8 แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง glow เป็น rgba(205,154,44,…)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #12c23a
// #01841b #fb252b #ff6b6e #0a4a18 #0a1a0e #102a16 #030a05 #ffe9a8 #f2b422
// #e4f2e4) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเลขและส่งโพยผ่านระบบบนมือถือ",
    stars: 5,
    tag: "เลข 2 ตัว · เลข 3 ตัว · รายการหวยตามรอบ",
    content:
      "ที่ใช้ต่อเพราะเลือกเลขและส่งโพยผ่านระบบบนมือถือได้เลย มีทั้งเลข 2 ตัว เลข 3 ตัว และรายการหวยตามรอบที่เว็บไซต์เปิดให้บริการ ก่อนกดยืนยันจะตรวจสอบเลข ยอดแทง อัตราจ่าย และสถานะโพยได้ครบจากหน้าเดียว รายการที่เข้าเงื่อนไขก็เห็นชัดว่า 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ส่วนข้อความว่าอัตราจ่ายสูงที่สุดในวงการ ส่วนตัวมองว่าควรมีข้อมูลเปรียบเทียบที่ตรวจสอบได้รองรับ ถ้าไม่มีหลักฐานดังกล่าว คำว่าอัตราจ่ายสูงจะเหมาะกับเนื้อหาเว็บไซต์มากกว่า",
    avatar: "🎟️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เลือกเลขเด็ดและเลขดังก่อนเช็กวงเงินรับแทง",
    stars: 5,
    tag: "เลขเด็ด · เลขดัง · วงเงินรับแทง · ยอดสูงสุดที่ระบบเปิดรับ",
    content:
      "ชอบที่เลือกได้ทั้งเลขที่คิดเองและเลขเด็ด เลขดังที่กำลังได้รับความสนใจ ตามรายการและรอบที่ระบบเปิดรับ พอกรอกเลขกับยอดที่ต้องการแล้วระบบจะแสดงสถานะการรับแทงให้เห็นก่อน ทำให้ทราบวงเงินและรายละเอียดของโพยก่อนกดยืนยันทุกครั้ง แต่สำหรับเลขที่มีผู้เลือกจำนวนมาก ระบบอาจกำหนดวงเงินรับแทงตามแต่ละรอบ คำว่าจ่ายไม่อั้นจึงควรยึดวงเงินจริงที่เว็บไซต์แสดง และควรดูยอดสูงสุดที่ระบบเปิดรับในรอบนั้นก่อนส่งโพยด้วย เพราะอัตราจ่ายอาจแตกต่างตามประเภทหวยและรูปแบบการแทง",
    avatar: "🔢",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ประวัติโพย · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลเพื่อสร้างบัญชีแล้ว Login เข้าสู่ระบบ จากนั้นเลือกรายการหวย กรอกตัวเลขและยอดที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย หลังเปิดบัญชีก็ตรวจรายการหวย อัตราจ่าย เครดิต และประวัติโพยจากบัญชีของตนเองได้ ตอนส่งโพยไม่สำเร็จหรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องโพยก็เตรียมชื่อรายการ รอบเวลา เลขที่เลือก และข้อมูลโพยไว้ ส่วนเรื่องฝากถอนก็เตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรม ถ้าบัญชีปลายทางเปลี่ยนจากข้อมูลเดิมควรยืนยันกับช่องทางหลักก่อนทำรายการ และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้ใคร ส่วนกรณีที่ระบุว่ายอดฝากเข้าบัญชีบริษัทโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลให้ตรวจสอบก่อนโอนทุกครั้ง",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] shadow-[0_0_12px_rgba(205,154,44,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f5e7c8] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fdeb7c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f5e7c8]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเลข 2 ตัวและเลข 3 ตัวแล้วส่งโพยผ่านมือถือ การตรวจอัตราจ่ายกับวงเงินรับแทงของแต่ละรอบ และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#5c3f12] border-l-[#cd9a2c] bg-[#1c140b]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdeb7c] to-[#cd9a2c] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f5e7c8]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5c3f12] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fdeb7c]" : "text-[#5c3f12]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f5e7c8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#fcd4c3]/45 bg-[#0c0b0a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdeb7c] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#5c3f12] bg-[#1c140b]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-300 hover:border-[#cd9a2c]/75 hover:shadow-[0_15px_40px_rgba(205,154,44,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fcd4c3]/18 blur-[60px] transition-all duration-300 group-hover:bg-[#fce2d4]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#5c3f12] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fdeb7c]/65 bg-gradient-to-br from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] text-2xl text-[#120a02] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f5e7c8] transition-colors group-hover:text-[#fdeb7c]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f5e7c8]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fdeb7c]" : "text-[#5c3f12]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fcd4c3]/45 bg-[#0c0b0a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdeb7c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#cd9a2c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f5e7c8]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
