---
import { BRAND_NAME } from "../lib/brandProfile";

// FAH999 (2026-10-11): บรีฟรอบนี้เป็น **ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ Login
// ใช้งานง่าย ออนไลน์ 24 ชั่วโมง** ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจากคำของบรีฟรอบนี้เอง
// ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิมของ NAZA168 ที่พูดถึง "เว็บสล็อต
// นาซ่า / ส่งตรงจากเมกา / ฐานเกมหลัก 100% / ฝากถอนเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า"
// หรือของ SUPERSLOTCLUB ก่อนหน้านั้น — คำชุดนั้นเป็นของบรีฟรอบก่อน ไม่ใช่ของบรีฟนี้
// และ brand-spec §7 สั่งห้ามไว้ตรงๆ บรีฟรอบนี้ไม่มีเรื่องฝากถอน บัญชีบริษัท หรือ
// บัญชีม้าเลยสักบรรทัด
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: ฟาสล็อตเว็บตรงที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ผ่าน
// ระบบ Login ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์ · รวมเกมสล็อตหลายแนวไว้ใน
// แพลตฟอร์มเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปิน · เลือกค่าย ค้นหาเกม และ
// ตรวจสอบข้อมูลบัญชีได้สะดวกตลอดวัน · ทางเข้าหลักที่เน้นการจัดหมวดหมู่ให้ค้นหาเกมได้
// สะดวก มีทั้งสล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ และเกมโบนัส · ระบบ Login เข้าถึง
// ข้อมูลเครดิต ประวัติรายการ และหมวดเกมจากบัญชีเดียว · ตรวจสอบตารางจ่าย อัตราการ
// คืนเงินผู้เล่น และช่วงเดิมพันก่อนเริ่มเล่น · คืนยอดเสีย 0.3% ตามรอบประจำวัน เข้ายูส ·
// แนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ผ่านลิงก์แนะนำ · สมัคร 3 ขั้นตอน · แอดมิน
// 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม ชื่อผู้พัฒนาเกม เลขใบอนุญาต ชื่อผู้ให้บริการ ชื่อนิติบุคคล ชื่อ
// ธนาคาร ค่า RTP เป็นตัวเลข ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้
// ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัว: 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
// (ไม่มี "100%" ซึ่งเป็นตัวเลขของ NAZA168 รอบก่อน) และบรีฟเป็นโทน hedged ทุกย่อหน้า
// จึงคงประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว (การยืนยันว่าเป็นสล็อตระบบแท้หรือ
// เว็บตรงควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริง · ผลการหมุนเป็นแบบสุ่ม
// และไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง · ควรอ่านรายละเอียดก่อนกดรับทุกครั้ง · คำว่า
// ไม่จำกัดควรระบุให้ชัด · ไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ชมพูฮอต-ทอง บนพลัมดำ): สีหลักคือ **ชมพูฮอต** #ff3fa4
// สีรองคือ **ทอง** #f5c53d บนผิวการ์ดยก #4a0b42 ไม่ใช่ผิวน้ำตาลแบบรอบ NAZA168 —
// สันนำหน้าหัวข้อไล่ทองสว่าง #ffe49a → ชมพูอ่อน #ff6cbb → ชมพูแบรนด์ #ff3fa4 ซึ่งเป็น
// ลำดับเดียวกับโลโก้ (ขอบทองของแผ่นป้าย → ตัวอักษร FAH999 ชมพู)
// ชื่อแบรนด์ในหัวข้อใช้ชมพูอ่อน #ff6cbb ซึ่ง §2 ให้ถือตัวอักษรได้จริง (5.7:1 บนผิวยก)
// ขณะที่ #b3006a ใช้ไม่ได้เลย
// ป้ายอวาตาร์เป็นแผ่นทองทึบ ไล่ทองสว่าง #ffe49a → ทองแบรนด์ #f5c53d → ทองกลางเข้ม
// #d19a12 บนหมึก #2b0019 (7.5:1 ที่ปลายเข้มสุด — ห้ามใช้ #9c6f08 เป็นปลายเข้มของแผ่น
// ที่มีหมึก และห้ามพลิกแผ่นทองไปใช้ตัวอักษรสว่าง)
// คะแนนเฉลี่ยไล่ชมพูซีด #ffd1ea → ชมพูแบรนด์ #ff3fa4 ดาวที่ติดเป็นทองแบรนด์ ดาวที่ยัง
// ไม่ติดเป็นชมพูเข้ม #7a0046 จุดกะพริบบนป้ายใช้ชมพูแบรนด์ ออรามุมขวาบนเป็นทองโปร่ง
// (เป็นจุดเดียวในหน้าที่ออรารีวิวเป็นทอง ไม่ใช่ชมพู) กรอบการ์ดเป็นชมพูแบรนด์โปร่ง
// ชิปตกลงไปที่ผิวลึกสุด #210220 เนื้อความและชื่อสมาชิก #fde8f3 (= BRAND_TEXT) ตัวรอง
// ใช้ชมพูหม่น #e8b9d4 ซึ่ง §2 พินไว้ให้คำบรรยายโดยเฉพาะ (8.6:1) glow เป็น
// rgba(255,63,164,…)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 ที่เคย
// ค้างในไฟล์นี้ (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #3f4859
// #fdf3df #d9c9a6 #4e3406 #241700 #231500 rgba(251,193,52,α)) ชุดทองเป็ด-ส้มอำพันของ
// DUCK1688 (#f3bb34 #fde464 #c8901a #f58b2a #f6ecd9) ชุดทอง-แดงของ GOT777 (#f5c518
// #ffe9a8 #96690f #d21622) และชุดชมพู-ม่วงของ BPLAY639 (#f472b6 #fbcfe8 #e9d5f5
// #7e22ce #c4b5fd) ออกครบทุกจุดแล้ว — ⚠️ BPLAY639 ก็เป็นแบรนด์ชมพู "มีชมพูอยู่แล้ว"
// จึงไม่พิสูจน์อะไร #f472b6 ไม่ใช่ #ff3fa4 และ #f5c518 ของ GOT777 ต่างจาก #f5c53d
// ของรอบนี้แค่สองตัวอักษร
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกค่าย ค้นหาเกม และตรวจสอบข้อมูลบัญชีจากบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ฟีเจอร์พิเศษ",
    content:
      "ที่ใช้ต่อเพราะเป็นฟาสล็อตเว็บตรงที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ผ่านระบบ Login ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์ แล้วรวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว ไม่ว่าจะเป็นสล็อตคลาสสิก เกมโบนัส หรือฟรีสปิน ทางเข้าหลักเน้นการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก มีทั้งสล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ และเกมโบนัสให้เลือกตามความสนใจ ตัวที่ชอบที่สุดคือระบบ Login เพราะเข้าถึงข้อมูลเครดิต ประวัติรายการ และหมวดเกมได้จากบัญชีเดียว โดยไม่ต้องสลับหลายเว็บไซต์ ก่อนเริ่มเล่นก็ตรวจสอบตารางจ่าย อัตราการคืนเงินผู้เล่น และช่วงเดิมพันของแต่ละเกมได้โดยตรง ส่วนเรื่องที่อยากให้อ่านกันก่อนคือคำว่าสล็อตแตกง่ายทุกเกม ควรพิจารณาจากรายละเอียดของเกมแต่ละรายการ เพราะผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง และการยืนยันว่าเป็นสล็อตระบบแท้หรือเว็บตรง ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณ",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เข้ายูส",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบโปรโมชั่นตามกิจกรรมที่เปิดให้บริการได้เอง ทั้งรายการที่มีสิทธิ์รับ ยอดคำนวณ และสถานะโบนัสจากบัญชีตามระบบที่กำหนด ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามข้อกำหนดจะถูกนำมาคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงจำนวนโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด ถ้ารองรับการโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดและประวัติการรับสิทธิ์ได้จากบัญชี ส่วนแนะนำเพื่อนคือใช้ลิงก์แนะนำเชิญเพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ แล้วดูจำนวนเพื่อนและสถานะโบนัสผ่านบัญชีได้ ข้อควรรู้คือแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม รอบรับสิทธิ์ และการใช้โบนัสแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง และคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส เพื่อให้สมาชิกเข้าใจข้อกำหนดตรงกัน อย่าลืมตรวจรอบตัดยอดและค่ายเกมที่ร่วมรายการให้ครบถ้วนก่อนรับทุกครั้ง",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจโดเมนหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง",
    content:
      "การสมัครแบ่งเป็น 3 ขั้นตอนตามที่เว็บไซต์ระบุไว้ เริ่มจากเข้าหน้าสมัครสมาชิกโดยเลือกเมนูสมัครจากทางเข้าหลัก แล้วตรวจสอบชื่อเว็บไซต์และช่องทางที่ใช้งานให้ถูกต้องก่อนดำเนินการต่อ ขั้นที่สองคือกรอกข้อมูลตามแบบฟอร์มที่ระบบกำหนดพร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น ขั้นสุดท้ายคือตรวจสอบรายละเอียดที่กรอก อ่านเงื่อนไขให้ครบถ้วน และยืนยันการสมัครก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและข้อมูลบัญชีสมาชิก ข้อที่อยากกำกับไว้คือผู้สมัครควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการก่อนส่งข้อมูลส่วนตัว พร้อมอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมายอนุญาตในพื้นที่ของตน เรื่องติดต่อก็แจ้งแอดมินผ่านช่องทางติดต่อหลักได้ตลอด 24 ชั่วโมง ถ้าเข้าสู่ระบบไม่ได้ให้แจ้งข้อความแจ้งเตือนและเวลาที่เกิดเหตุ ปัญหาเกมสล็อตให้ระบุชื่อเกมและค่ายที่ใช้งาน ส่วนเรื่องโปรโมชั่นให้แจ้งชื่อกิจกรรมและรอบรับสิทธิ์ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe49a] via-[#ff6cbb] to-[#ff3fa4] shadow-[0_0_12px_rgba(255,63,164,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fde8f3] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ff6cbb]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e8b9d4]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการค้นหาเกมและเลือกหมวดเกมทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปินผ่านระบบ Login จากบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์
        และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#ff3fa4]/30 border-l-[#ff3fa4] bg-[#4a0b42] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffd1ea] to-[#ff3fa4] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e8b9d4]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7a0046] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c53d]" : "text-[#7a0046]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#fde8f3]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#d19a12]/45 bg-[#210220] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c53d] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#ff3fa4]/25 bg-[#4a0b42] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#ff3fa4]/70 hover:shadow-[0_15px_40px_rgba(255,63,164,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f5c53d]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#f5c53d]/34"
          />

          <div class="flex items-center gap-4 border-b border-[#7a0046] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#d19a12] bg-gradient-to-br from-[#ffe49a] via-[#f5c53d] to-[#d19a12] text-2xl text-[#2b0019] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fde8f3] transition-colors group-hover:text-[#ff6cbb]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e8b9d4]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f5c53d]" : "text-[#7a0046]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#d19a12]/45 bg-[#210220] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c53d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff3fa4]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#fde8f3]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
