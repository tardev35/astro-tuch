---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บเกมปั่นสล็อตที่รวมเกมจากหลายค่ายไว้ในระบบเดียว ทุกแถวจึงอยู่ในกรอบที่บรีฟ
// ระบุไว้เอง: รูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ตามที่เว็บไซต์ระบุ, สล็อตยอดนิยม เกมโบนัส
// และเกมใหม่ที่อัปเดตตามช่วงเวลา, เมนูแบ่งหมวดหมู่ชัดเจนและเข้าถึงแต่ละค่ายได้จากบัญชีเดียว,
// การตรวจสอบชื่อค่าย รายละเอียดเกม และข้อมูลที่เกี่ยวข้องก่อนเริ่มเล่น, ระบบบัญชีที่ช่วยให้จัดการ
// รายการได้เป็นขั้นตอน, โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบรับ
// สิทธิ์และรอบคำนวณ, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน และเจ้าหน้าที่ตลอด 24 ชั่วโมง ไม่มี
// ข้อความไหนอ้างชื่อค่ายเจาะจง ชื่อเกม ค่า RTP ชื่อธนาคาร ช่องทางฝากถอน ขั้นต่ำการเดิมพัน
// หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): โลโก้เป็นเวิร์ดมาร์กสองวัสดุ P กับ G44
// เป็นทองเมทัลลิก K เป็นโครเมียมขัดเงา การ์ดรีวิวจึงใช้ทองกับโครเมียมแยกหน้าที่กัน — สันนำหน้า
// หัวข้อ ป้ายระบุตัวสมาชิก และดาว เป็นทอง (ทองสว่าง #ffe27a → ทองแบรนด์ #fdd32a → ทองลึก
// #c8920a) ส่วนชื่อบล็อก คะแนนเฉลี่ย และป้ายแท็กรับโครเมียม (#f2f4f7 #c2c8d0 #8a9099) ตาม
// ตัว K กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #2a2110 บนผิวการ์ด #12100a เหนือพื้นเพจ #080602
// เนื้อความเป็น BRAND_TEXT #efe6d2 และตัวเน้นเป็น #fff8e1 — ชุดเขียวมรกตของ BRAZIL999
// (#22c55e #7cf25c #0a6b18 #123a18 #0a1a0c #040a05 #aab4bf #f1f5f9 #6b7580 #dfeadd
// #f4fbf2) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมสล็อตหลายค่ายจากบัญชีเดียว",
    stars: 5,
    tag: "API แท้ · บัญชีเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียวจริง ตามข้อมูลที่เว็บไซต์ระบุทั้งรูปแบบการเชื่อมต่อ API และข้อมูลลิขสิทธิ์ เลือกได้ทั้งสล็อตยอดนิยม เกมโบนัส และเกมใหม่ที่อัปเดตตามช่วงเวลา เมนูแบ่งหมวดหมู่ชัดเจน ใช้งานผ่านมือถือและคอมพิวเตอร์ด้วยบัญชีเดียวกัน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลาได้จากหน้าเดียว มีทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งแต่ละรายการแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และรอบคำนวณไว้ให้ตรวจก่อนกดรับ ทำให้เลือกใช้สิทธิ์ได้ตรงกับเงื่อนไขของแต่ละรายการ",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามเจ้าหน้าที่",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · เจ้าหน้าที่ 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้แค่ 3 ขั้นตอนตามที่เว็บไซต์บอกไว้ พอยืนยันบัญชีเสร็จก็เข้าสู่ระบบเพื่อเลือกค่ายสล็อต เกมที่สนใจ และโปรโมชั่นที่เปิดให้รับได้ทันที ติดตรงไหนเกี่ยวกับการสมัคร ทางเข้า โปรโมชั่น เกม หรือการใช้งานบัญชี ก็ถามเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง ควรยึดช่องทางอย่างเป็นทางการก่อนทำรายการ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe27a] via-[#fdd32a] to-[#c8920a] shadow-[0_0_12px_rgba(253,211,42,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff8e1] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fdd32a]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#efe6d2]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมเกมปั่นสล็อตจากหลายค่ายไว้ในระบบเดียว การตรวจสอบชื่อค่ายและรายละเอียดเกมก่อนเริ่มเล่น และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#2a2110] border-l-[#fdd32a] bg-[#12100a]/94 px-6 py-4 shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f2f4f7] to-[#8a9099] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#efe6d2]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#2a2110] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fdd32a]" : "text-[#2a2110]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#efe6d2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#2a2110] bg-[#080602] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c2c8d0] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#2a2110] bg-[#12100a]/94 p-5 shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fdd32a]/70 hover:shadow-[0_15px_40px_rgba(253,211,42,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fdd32a]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#c2c8d0]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#2a2110] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fdd32a]/65 bg-gradient-to-br from-[#ffe27a] via-[#fdd32a] to-[#c8920a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff8e1] transition-colors group-hover:text-[#c2c8d0]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#efe6d2]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fdd32a]" : "text-[#2a2110]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c2c8d0]/45 bg-[#080602] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c2c8d0] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fdd32a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#efe6d2]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
