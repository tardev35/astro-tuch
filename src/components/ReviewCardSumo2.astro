---
import { BRAND_NAME } from "../lib/brandProfile";

// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): บรีฟรอบนี้เป็นเว็บแทงหวยออนไลน์ล้วน ทุกแถวจึงถูก
// เขียนใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิมของรอบสล็อต
// กรอบที่บรีฟระบุไว้เองคือ: รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ
// ไว้ในหน้าเดียว · ประเภทหวยสี่กลุ่มคือ รัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ ·
// เลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้จากบัญชีเดียว · อัตรา 2 ตัว จ่าย 100 บาท
// และ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข · สมัครผ่านมือถือ 3 ขั้นตอน ·
// ติดต่อแอดมินได้ตลอด 24 ชั่วโมง · และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// มุมของรอบก่อนๆ ที่บรีฟนี้ไม่ได้เขียนไว้ (สล็อต/พีจี/ค่ายเกม, ฟรีสปิน/ตัวคูณ/วงล้อ,
// โบนัสไทม์, คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%, ชื่อเกม, บอล/คาสิโนสด) ถูกถอดออกทั้งหมด
//
// ห้ามพูดถึงสินค้าหมวดอื่นนอกจากหวย ห้ามใส่เวลาเปิด/ปิดรับเป็นตัวเลข ชื่อตลาดหุ้นรายตลาด
// ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีที่ก่อตั้ง —
// บรีฟ หวย365 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัวเท่าที่บรีฟระบุ คือ 2 ตัว
// จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · 24 ชั่วโมง และบรีฟเป็นโทน
// hedged ทุกย่อหน้า จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้: แบรนด์มีสองสีจริง (logo.webp เป็นคำว่า หวย สีแดงสด vivid #dc0203 #e00104
// #e2020a คู่กับเลข 365 บนพื้นดำ #020202 ส่วนทองมาจากตัวอักษรสามมิติบนแบนเนอร์และเหรียญ
// ทองในงานอาร์ต) แดงแบรนด์ #dc0203 จึงเป็นตัวระบุตัวตนของบล็อกนี้ — สันนำหน้าหัวข้อ ป้าย
// แท็ก และออร่ามุมขวาบนเป็นแดง ไล่แดงสว่าง #f5282a → แดงแบรนด์ #dc0203 → แดงลึก #8c0402
// ส่วนทองเป็นสีเน้นที่อ่านเป็นตัวอักษร คือชื่อแบรนด์ ดาวที่ติด และคะแนนเฉลี่ย (ทองบนผิว
// การ์ด #240406 ได้ 8.3:1 ส่วนแดงแบรนด์ได้ 3.7:1 จึงใช้เป็นเส้นกับพื้นเท่านั้น ไม่ใช่
// ตัวอักษรเล็ก) ดาวที่ยังไม่ติดใช้พื้นยกระดับ #3a0a0c กรอบเป็นทองลึก #c08a07 ชิปตกลงไปที่
// พื้นลึกสุด #140203 เนื้อความและชื่อสมาชิก #f6e7e0 (BRAND_TEXT) ตัวรองใช้ #f6e7e0
// แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #140c02
// #0a0501 #f3e8cf) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ติดตามหวยหลายประเภทจากบัญชีเดียว",
    stars: 5,
    tag: "รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หวยหุ้นต่างประเทศ",
    content:
      "ที่ใช้ต่อเพราะรายการหวยหลายประเภทรวมอยู่ในบัญชีเดียว ทั้งหวยรัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยหลายรอบ หวยลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ เลยติดตามหลายรอบได้โดยไม่ต้องสลับหลายที่ ก่อนเลือกแทงจะเปิดดูเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการก่อนทุกครั้ง เพราะรายการที่เปิดรับจริงขึ้นอยู่กับรอบที่ระบบกำหนดในแต่ละวัน",
    avatar: "🎟️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูแนวทางหวย กลุ่มหวย และสถิติย้อนหลังก่อนเลือกเลข",
    stars: 5,
    tag: "แนวทางหวย · กลุ่มหวย · สถิติหวยย้อนหลัง · ผลหวย",
    content:
      "ที่ชอบคือแนวทางหวย กลุ่มพูดคุย และสถิติย้อนหลังถูกจัดหมวดแยกตามประเภท เลยค้นหาข้อมูลได้ง่ายขึ้นกว่าการไล่หาทีละที่ สถิติย้อนหลังช่วยให้ย้อนดูผลและรูปแบบตัวเลขที่เคยออกในรอบที่ผ่านมา ส่วนแนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ทั้งสองอย่างไม่ได้เพิ่มความแน่นอนในการทายผลรอบถัดไป และไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้ เลยใช้เป็นข้อมูลประกอบเท่านั้น",
    avatar: "📊",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชี จากนั้นเลือกประเภทหวย รอบ และตัวเลขที่ต้องการได้เลย ตอนส่งโพยจะตรวจอัตราที่แสดงในระบบ เลขที่เลือก ยอดเดิมพัน และรอบหวยให้ถูกต้องก่อนยืนยัน อัตรา 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข บางรายการอาจกำหนดอัตราหรือวงเงินต่างกัน ถ้าระบบแสดงต่างจากข้อมูลประชาสัมพันธ์ก็ยึดหน้าส่งโพยเป็นหลัก ตอนที่รายการไม่แสดงและผลหวยยังไม่อัปเดต ติดต่อแอดมินได้ตลอด 24 ชั่วโมง โดยแจ้งชื่อหวย รอบเวลา และเลขที่เลือกไป ส่วนปัญหาด้านธุรกรรมก็เตรียมเวลา จำนวนเงิน และหลักฐานไว้ให้ตรวจสอบ และไม่ส่งรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5282a] via-[#dc0203] to-[#8c0402] shadow-[0_0_12px_rgba(220,2,3,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f6e7e0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ffc93c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f6e7e0]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามรายการหวยทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ การใช้แนวทางหวย กลุ่มหวย และสถิติย้อนหลังเป็นข้อมูลประกอบ และการสมัครผ่านมือถือ
        3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#c08a07] border-l-[#dc0203] bg-[#240406]/94 px-6 py-4 shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffeab0] to-[#c08a07] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f6e7e0]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#c08a07] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffc93c]" : "text-[#3a0a0c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e7e0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#dc0203]/60 bg-[#140203] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc93c] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#c08a07] bg-[#240406]/94 p-5 shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/24 blur-[60px] transition-all duration-300 group-hover:bg-[#f5282a]/32"
          />

          <div class="flex items-center gap-4 border-b border-[#c08a07] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ffc93c]/65 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f6e7e0] transition-colors group-hover:text-[#ffeab0]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f6e7e0]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ffc93c]" : "text-[#3a0a0c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#dc0203]/55 bg-[#140203] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc93c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5282a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e7e0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
