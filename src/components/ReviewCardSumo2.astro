// fb1b32 ff8f9c (มีเฮ168) fa0513 ff5a5f ffadaf (สมหวัง168) b3121b f2bba5
// (ขวัญใจ168) e4021b (รวยเทพ168) dc0203 f5282a (หวย365) ff3b14 6d0804 (FLASH877)
// **ทองก็ห้ามทั้งหมด**: ffd94a e3a712 9d6f06 (รวย168) eeae12 fded41 (พักยก168)
// f5ba14 fcee52 b37c0b (เงินทอง168) fee45d e6a416 b8780d (ยูฟ้า168) fbc134 ffe87a
// (NAZA168 ตัวละติน) d4922c fdfc71 (ufalion168) fdcb0c fefb6b (สบาย168) fcd434
// (มีโชค168) ffc82e (สบายเบท168)
// ⚠️ **วัสดุที่สองรอบนี้คือชมพูพาสเทล/ขาวอมชมพู R≥B>G (#ffffff / #fff4fb /
// #ffe3f5 / #ffc2e2) ไม่ใช่ครีมและไม่ใช่เทาเงินเย็น** — d9dfe9 b3bdd6 (มาดาม168)
// f4e4d3 e4cbb3 (ร่ำรวย168) ecd5c4 d2b9a4 (เงินทอง168) eadfce (ขวัญใจ168) f4ead6
// d6c6a8 e0e0df c0c0bf a1a09e (พักยก168) e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168)
// f0e6e4 c9b9b7 e3d6d4 (สล็อต168) **ห้ามกลับเข้ามา**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีเขียว ไม่มี
// บรอนซ์ ไม่มีม่วง/ไวโอเลต ไม่มีส้ม ไม่มีโรสโกลด์ ไม่มีครีม/เบจ/พีช และไม่มี
// แรมป์เทาเงินเย็น** (เหรียญทอง หมูชมพู ฉากสตูดิโอขาว กล่องของขวัญ และสีผิวนักแสดง
// เป็น **วัตถุในภาพ** ไม่ใช่สีแบรนด์)
const reviews = [
  {
    name: "คุณชัชวาล พ.",
    role: "ไล่อ่านกติกาเกมและเงื่อนไขโบนัสให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "เว็บสล็อตเงินดี · ทางเข้าเล่นง่าย · สมัครสมาชิก 3 ขั้นตอน",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมระบบสมาชิกที่รวบรวมข้อมูลเกม โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว ทำให้ศึกษากติกาเกม ตรวจสอบเงื่อนไขโบนัส และเลือกดูรายละเอียดค่ายเกมที่สนใจได้จากที่เดียว ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปดูรายละเอียดโปรโมชั่น ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการใช้บริการ และตรวจข้อกำหนดด้านอายุกับกฎหมายที่เกี่ยวข้อง ตั้งรหัสผ่านที่ปลอดภัย ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัส OTP ให้ใครทราบ ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างว่ายูสใหม่แตกไวไม่สามารถใช้รับประกันผลรางวัลได้ เพราะเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอนในแต่ละรอบ",
    avatar: "🎀",
    accent: "bloom" as const,
  },
  {
    name: "คุณนฤมล จ.",
    role: "อ่านประกาศโปรโมชั่นล่าสุดให้ครบ แล้วค่อยตรวจรอบรับเครดิตอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "เปิดรับสมาชิกใหม่ทุกวัน · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด ต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัส เพราะแต่ละรายการอาจมีเงื่อนไขเรื่องประเภทเกม ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนครั้งที่เข้าร่วมแตกต่างกัน แม้จะมีข้อความว่าแจกโบนัสทั้งวันไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และข้อกำหนดการถอนเงินจากประกาศล่าสุดก่อนตัดสินใจ ที่ต้องเข้าใจตรงกันคือการคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป",
    avatar: "🍬",
    accent: "blush" as const,
  },
  {
    name: "คุณเกรียงไกร ส.",
    role: "ตรวจชื่อบัญชีปลายทางและช่องทางติดต่อจากเว็บไซต์ทางการก่อนทำรายการทุกครั้ง",
    stars: 4,
    tag: "ฝากถอนไม่มีขั้นต่ำ · ทุกธนาคารและทรูวอลเลท · แอดมินตลอด 24ชม.",
    content:
      "เว็บไซต์ระบุช่องทางฝากถอนผ่านธนาคารและทรูวอลเลท ก่อนฝากเงินจึงตรวจรายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ และชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้ทุกครั้ง รวมถึงศึกษาระยะเวลาดำเนินการและข้อกำหนดการถอนเงินให้ครบถ้วน แม้จะมีข้อความว่าฝากถอนไม่มีขั้นต่ำ แต่ยังควรตรวจสอบวงเงินต่อรายการและข้อจำกัดที่อาจมีอยู่ หากพบข้อมูลบัญชีผิดปกติจะหยุดทำธุรกรรมแล้วติดต่อผู้ให้บริการชำระเงินเพื่อตรวจสอบก่อน เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โปรโมชั่นสมาชิกใหม่ และรายการฝากถอน ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมอธิบายปัญหาให้ชัดเจน โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🏦",
    accent: "bloom" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb439b] via-[#fc74b5] to-[#ffc2e2] shadow-[0_0_12px_rgba(251,67,155,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#6a0f3c] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#9c0f55]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#6a0f3c]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตออนไลน์และขั้นตอนสมัครสมาชิก โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ช่องทางฝากถอนผ่านทุกธนาคารและทรูวอลเลท พร้อมช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#f9b2d9] border-l-[#fb439b] bg-[#fff4fb] px-6 py-4 shadow-[0_10px_30px_rgba(156,15,85,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#9c0f55]">{average}</span>
      <span class="text-sm font-black text-[#95486b]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#f9b2d9] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#9c0f55]" : "text-[#9c0f55]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#6a0f3c]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#f9b2d9] bg-white px-3 py-1 text-[10px] font-bold tracking-wide text-[#95486b] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#f9b2d9] bg-white p-5 shadow-[0_10px_30px_rgba(156,15,85,0.1)] transition-all duration-300 hover:border-[#fb439b] hover:shadow-[0_15px_40px_rgba(251,67,155,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fb439b]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#fb439b]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#f9b2d9] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "bloom"
                  ? "border border-[#85094a] bg-gradient-to-br from-[#d91a73] to-[#b01160] text-white"
                  : "border border-[#f9b2d9] bg-gradient-to-br from-white to-[#ffe3f5] text-[#6a0f3c]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#6a0f3c] transition-colors group-hover:text-[#9c0f55]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#95486b]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#9c0f55]" : "text-[#9c0f55]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f9b2d9] bg-[#fff4fb] px-3 py-1 text-[10px] font-bold tracking-wide text-[#95486b] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fb439b]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#6a0f3c]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
