---
const reviews = [
  {
    name: "สมาชิกที่เข้าเล่นสล็อตผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้วเข้าสู่ระบบได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ระบบจัดหมวดหมู่เกมสล็อตไว้ให้ค้นหาง่าย เลือกเกมที่สนใจและสลับค่ายเกมได้จากบัญชีเดียว โดยไม่ต้องสลับใช้งานหลายระบบ",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามโปรโมชั่นเป็นประจำ",
    role: "ตรวจสอบเงื่อนไขก่อนกดรับโบนัสทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% • แนะนำเพื่อน 0.8%",
    content:
      "หน้าโปรโมชั่นแสดงเปอร์เซ็นต์โบนัส ยอดที่นำมาคำนวณ รอบการรับ และเงื่อนไขการถอนไว้ครบ ทำให้ดูได้ว่าลิงก์แนะนำเพื่อนของตนเองมีสิทธิ์เท่าไร และยอดเสียส่วนไหนเข้าเงื่อนไขคืนยอด จึงตรวจสอบสิทธิ์ให้ครบก่อนเข้าร่วมได้ทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ฝากถอนอัตโนมัติ",
    content:
      "ส่งคำขอถอนผ่านระบบอัตโนมัติแล้วรายการยังค้าง จึงแจ้งเวลาที่ทำรายการกับรายละเอียดไป แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาทำรายการรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JAIDEE928" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4c1095] via-[#a855f7] to-[#e6e8ec] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#d8a7ff]">JAIDEE928</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a855f7] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#a855f7]/35 bg-[#0d0616]/92 px-6 py-4 shadow-[0_10px_30px_rgba(168,85,247,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#e6e8ec] to-[#4c1095] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a897c4] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4c1095]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d8a7ff]" : "text-[#2c046a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e4d9f5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#4c1095]/50 bg-[#0d0616]/92 p-6 text-left shadow-[0_10px_30px_rgba(168,85,247,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#a855f7]/60 hover:shadow-[0_15px_40px_rgba(168,85,247,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#4c1095] to-[#d8a7ff] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2c046a]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#e53cfe]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#4c1095]/50 bg-[#060210] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d8a7ff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a855f7]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#d8a7ff]" : "text-[#2c046a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e4d9f5]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4c1095] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a855f7]/40 bg-gradient-to-br from-[#d8a7ff] via-[#a855f7] to-[#2c046a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e6e8ec] transition-colors group-hover:text-[#d8a7ff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a897c4] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
