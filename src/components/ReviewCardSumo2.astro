---
// OSAKA198 is a สล็อต brand — every row stays inside what the brief states:
// เกมสล็อตจากหลายค่ายในบัญชีเดียวโดยไม่ต้องสมัครแยกหลายบัญชี, เกมยอดนิยม เกมใหม่
// เกมโบนัส ฟรีสปิน และสล็อตหลายรูปแบบ, การรองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์,
// การตรวจช่วงเดิมพันของแต่ละเกมก่อนเริ่มเล่นเพราะขั้นต่ำจริงขึ้นอยู่กับผู้ให้บริการ,
// การยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการ, การ Login ดูโปรโมชั่นที่เปิดให้รับพร้อมยอด
// ที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอน, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%,
// การสมัคร 3 ขั้นตอน, การตรวจเครดิต โปรโมชั่น ประวัติรายการ และสถานะฝากถอนจากบัญชี
// สมาชิก, และแอดมินที่รับเรื่องตลอด 24 ชั่วโมงพร้อมแจ้งเวลาและรายละเอียดของรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "เล่นสล็อตหลายค่ายจากบัญชีเดียวทั้งบนมือถือและคอม",
    stars: 5,
    tag: "เกมยอดนิยม · เกมใหม่ · เกมโบนัส · ฟรีสปิน",
    content:
      "สลับเล่นสล็อตแต่ละค่ายได้สะดวก ทั้งเกมยอดนิยม เกมใหม่ เกมโบนัส ฟรีสปิน และสล็อตรูปแบบอื่น ๆ ตามค่ายที่เปิดให้บริการในช่วงนั้น ใช้ผ่านสมาร์ตโฟน แท็บเล็ต หรือคอมพิวเตอร์ก็เข้าเล่นได้เหมือนกันโดยไม่ต้องสมัครแยกหลายบัญชี ใช้บัญชีเดียวเลือกเกม ฝากถอน และดูโปรโมชั่นได้จากหน้าเว็บไซต์",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ตรวจช่วงเดิมพันของเกมก่อนเริ่มเล่นทุกครั้ง",
    stars: 5,
    tag: "ช่วงเดิมพัน · วงเงินที่ระบบแสดง · โปรโมชั่น",
    content:
      "ชอบที่ตรวจช่วงเดิมพันของแต่ละเกมได้ก่อนเริ่มหมุน เพราะขั้นต่ำจริงต่างกันตามผู้ให้บริการและตามเกม ส่วนเงื่อนไขไม่จำกัดยอดก็ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ฝั่งโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่เปิดให้รับผ่านบัญชีตัวเอง แล้วอ่านยอดที่ใช้คำนวณ รอบรับ และเงื่อนไขการถอนให้ครบก่อนกดรับ",
    avatar: "✨",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "สมัคร 3 ขั้นตอน แล้วเช็กสถานะรายการจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านมือถือหรือคอมพิวเตอร์ด้วยขั้นตอนที่ไม่ซับซ้อน กรอกข้อมูลตามที่ระบบกำหนด เข้าสู่ระบบ ฝากเครดิต แล้วเลือกค่ายกับเกมสล็อตที่ต้องการได้เลย โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ก็ดูจำนวนที่เข้าเกณฑ์และรอบที่รับได้จากบัญชีสมาชิก รอบที่เข้าเกมไม่ได้หรือเครดิตยังไม่เข้าก็ติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ ทำให้ตรวจสอบได้ตรงจุด และไม่ควรแจ้งรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก OSAKA198" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7f1e4] via-[#c7b895] to-[#e4cc95] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#d8d8d8]">OSAKA198</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d1ae72] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#a37c4b]/40 bg-[#1c1509]/92 px-6 py-4 shadow-[0_10px_30px_rgba(209,174,114,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7f1e4] to-[#e4cc95] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c7b895] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#a37c4b]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e4cc95]" : "text-[#9a8a68]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8ddc8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#a37c4b]/40 bg-[#1c1509]/92 p-6 text-left shadow-[0_10px_30px_rgba(11,9,6,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e4cc95]/70 hover:shadow-[0_15px_40px_rgba(209,174,114,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7f1e4] to-[#a37c4b] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a37c4b]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#d1ae72]/35"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#a37c4b]/45 bg-[#141210] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e4cc95] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d1ae72]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e4cc95]" : "text-[#9a8a68]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8ddc8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a37c4b]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d1ae72]/55 bg-gradient-to-br from-[#f7f1e4] via-[#d1ae72] to-[#7d5c31] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e4cc95] transition-colors group-hover:text-[#f7f1e4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c7b895] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
