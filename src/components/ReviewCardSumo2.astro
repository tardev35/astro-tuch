---
import { BRAND_NAME } from "../lib/brandProfile";

// แตกดี168 (2026-10-08): บรีฟรอบนี้เป็น **เว็บสล็อตออนไลน์ล้วน** ไม่ใช่คาสิโนฐาน
// เข้าหลักที่รวมบาคาร่า รูเล็ต บอล หวย แบบรอบ 789BETTING ก่อนหน้า ทุกแถวจึงถูกเขียน
// ใหม่ทั้งหมดจากคำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิม
// ที่พูดถึงโต๊ะสด ตลาดเดิมพัน หรือรอบหวย — คำชุดนั้นเป็นของบรีฟรอบก่อน ไม่ใช่ของ
// บรีฟนี้ และ brand-spec §6 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: รวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้ง
// สล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ · รองรับการเข้าเล่นผ่านมือถือ ·
// เลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียว · Login ตรวจ
// โปรโมชั่นที่เปิดให้รับในแต่ละวัน เงื่อนไข ยอดที่เข้าเกณฑ์ และรอบการรับสิทธิ์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัครง่าย ไม่ยุ่งยาก · แอดมิน 24 ชั่วโมง ·
// ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสามตัว:
// 0.3% · 0.8% · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคงประโยคกำกับของบรีฟ
// เองไว้คู่กับข้อดีในทุกแถว ("ไม่มีขั้นต่ำ" ควรตรวจวงเงินจริงของแต่ละเกม · "ถูกลิขสิทธิ์"
// ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับ · โบนัสที่ได้รับจริงควรยึดรายละเอียด
// ล่าสุดจากระบบเป็นหลัก · ผลลัพธ์ของสมาชิกคนหนึ่งไม่ใช่การรับประกันผลลัพธ์ของทุกคน)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ): สีหลักคือ **ฟ้าแบรนด์**
// #0193fb สีรองคือ **เหลืองมะนาว** #fce604 บนผิวการ์ดกลาง #07111d ไม่ใช่ผิวดำอมทอง
// แบบรอบ 789BETTING — สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่ฟ้าซีด #d4ecfd → ฟ้าอ่อน
// #7bcffb → ฟ้าแบรนด์ #0193fb บนหมึกเข้ม #031018 (11.2:1 บน #7bcffb และ 6.0:1 บน
// #0193fb ซึ่งเป็นเพดานตาม §2 — ห้ามพลิกไปใช้ตัวอักษรขาวบนแผ่นสีสด) ชื่อแบรนด์ใน
// หัวข้อใช้ฟ้าอ่อนบนพื้นมืด คะแนนเฉลี่ยไล่ฟ้าซีด #d4ecfd → ฟ้าแบรนด์ #0193fb ส่วน
// เหลืองมะนาว #fce604 ถูกใช้เฉพาะจุดที่ควรเป็นเหลืองจริงๆ คือดาวที่ติดและป้ายหัวข้อแถว
// (เหรียญทองกับคำว่า แตกดี ในงานอาร์ตของแบรนด์) ดาวที่ยังไม่ติดใช้ฟ้าเข้ม #064a86
// จุดกะพริบบนป้ายใช้ฟ้าอ่อน ออรามุมขวาบนเป็นฟ้าแบรนด์โปร่ง กรอบการ์ดเป็นฟ้าแบรนด์โปร่ง
// ชิปตกลงไปที่ผิวลึกสุด #020609 เนื้อความและชื่อสมาชิก #dbeafe (= BRAND_TEXT)
// ตัวรองใช้ฟ้าหม่น #93b4d4 glow เป็น rgba(1,147,251,…)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f
// #7a0505 #0b7a33 #2bbf63 #063f1c #d9a521 #ffdf91 #140705 #090302 #f6e3cf #ffffff
// rgba(196,17,21,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมสล็อตและตรวจเครดิตจากบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ตัวคูณ · เกมเปิดใหม่",
    content:
      "ที่ใช้ต่อเพราะรวบรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่ตามรายการที่ให้บริการ รองรับการเข้าเล่นผ่านมือถือ เลยเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากบัญชีเดียวโดยไม่ต้องสลับไปมา เกมที่รองรับการเดิมพันยอดต่ำก็เลือกเล่นตามงบที่ตั้งไว้ได้ ข้อที่อยากให้อ่านกันก่อนคือคำว่าไม่มีขั้นต่ำ ควรตรวจสอบวงเงินจริงของแต่ละเกมก่อนเริ่มเล่น เพราะแต่ละเกมและแต่ละค่ายกำหนดช่วงเดิมพันไว้ไม่เท่ากัน และการระบุว่าเกมสล็อตถูกลิขสิทธิ์ ควรมีข้อมูลค่ายหรือผู้ให้บริการที่ตรวจสอบได้รองรับด้วย",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "Login ตรวจโปรโมชั่นและยอดที่เข้าเกณฑ์จากบัญชี",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์",
    content:
      "ชอบที่ Login เข้าบัญชีแล้วตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้เอง ทั้งเงื่อนไข ยอดที่เข้าเกณฑ์ และรอบการรับสิทธิ์ ทำให้เลือกใช้โปรโมชั่นได้ตรงกับรูปแบบการเล่นมากขึ้น ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามเงื่อนไขจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัส 0.3% ที่รับได้ตามรอบที่กำหนด ส่วนแนะนำเพื่อนก็แชร์ลิงก์ให้เพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัส 0.8% จากยอดที่เข้าเกณฑ์ แล้วติดตามจำนวนเพื่อน ยอดคำนวณ และสถานะโบนัสผ่านบัญชีสมาชิกได้ตามรอบของโปรโมชั่น ข้อควรรู้คือแต่ละรายการมีรอบตัดยอด ค่ายเกม และข้อกำหนดการใช้โบนัสไม่เหมือนกัน โบนัสที่ได้รับจริงจึงควรยึดรายละเอียดล่าสุดจากระบบเป็นหลักก่อนกดรับสิทธิ์ทุกครั้ง",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือแล้วใช้บัญชีเดียวดูทุกอย่าง",
    stars: 4,
    tag: "สมัครสมาชิก · บัญชีเดียว · ฝากถอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านมือถือทำได้ไม่ยุ่งยาก เปิดหน้าสมัคร กรอกข้อมูลตามที่ระบบกำหนด แล้วตรวจสอบรายละเอียดก่อนยืนยันบัญชี เสร็จแล้ว Login เพื่อเลือกเกมสล็อต ตรวจสอบโปรโมชั่น เครดิต และรายการต่างๆ ผ่านบัญชีเดียวได้เลย ช่วยลดขั้นตอนในการค้นหาเกมหรือสลับค่ายที่ระบบรองรับ ก่อนสมัครควรตรวจสอบว่าเข้าสู่ช่องทางหลักและกรอกข้อมูลให้ถูกต้องเพื่อป้องกันปัญหาการเข้าใช้งานภายหลัง ควรตั้งรหัสผ่านที่คาดเดายากและไม่ใช้รหัสเดียวกับบริการสำคัญอื่น ตอนที่ Login เข้าเกมสล็อตไม่ได้ โบนัสไม่แสดง หรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ก็ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องเกมเตรียมชื่อเกม ค่าย และเวลาที่เกิดเหตุไว้ เรื่องโปรโมชั่นระบุชื่อกิจกรรมและรอบรับสิทธิ์ ส่วนฝากถอนเตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรม โดยหลีกเลี่ยงการเปิดเผยข้อมูลสำคัญของบัญชี และไม่ส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7bcffb] via-[#0193fb] to-[#064a86] shadow-[0_0_12px_rgba(1,147,251,0.65)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#dbeafe] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#7bcffb]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#93b4d4]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมเปิดใหม่จากบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
        จากยอดที่เข้าเกณฑ์ และการสมัครสมาชิกพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0193fb]/30 border-l-[#0193fb] bg-[#07111d] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#d4ecfd] to-[#0193fb] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#93b4d4]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#064a86] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fce604]" : "text-[#064a86]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbeafe]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#c9a703]/45 bg-[#020609] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fce604] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0193fb]/25 bg-[#07111d] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#0193fb]/70 hover:shadow-[0_15px_40px_rgba(1,147,251,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#0193fb]/26 blur-[60px] transition-all duration-300 group-hover:bg-[#0193fb]/40"
          />

          <div class="flex items-center gap-4 border-b border-[#064a86] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#0b6fc4] bg-gradient-to-br from-[#d4ecfd] via-[#7bcffb] to-[#0193fb] text-2xl text-[#031018] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#dbeafe] transition-colors group-hover:text-[#fce604]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#93b4d4]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fce604]" : "text-[#064a86]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c9a703]/45 bg-[#020609] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fce604] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#7bcffb]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dbeafe]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
