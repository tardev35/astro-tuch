---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บเกมสล็อตออนไลน์ ไม่ใช่เว็บหวยและไม่ใช่เว็บคาสิโนสด ทุกแถวจึงอยู่ในกรอบที่
// บรีฟระบุไว้เอง: รวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมวงล้อ
// แบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย เกมโบนัส ฟรีสปิน ตัวคูณ และสล็อตแจ็กพอตตามค่ายที่
// ระบบเปิดให้บริการ, เข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์, เลือกเกม ตรวจสอบเครดิต
// โปรโมชั่น และประวัติรายการจากระบบเดียว, การสมัครออนไลน์บนมือถือแล้ว Login เข้าเลือกเกม,
// โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่ต้องตรวจรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับ
// และการติดต่อแอดมินได้ตลอด 24 ชั่วโมง
//
// ห้ามพูดถึงหวย โพย งวด อัตราจ่าย 2 ตัว/3 ตัว บาคาร่า เกมไพ่ รูเล็ต ชื่อค่ายเกม RTP ชื่อธนาคาร
// เลขใบอนุญาต หรือยอดเดิมพันขั้นต่ำ — บรีฟ GOT777 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่
// ตัวเท่าที่บรีฟระบุ คือ คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง · เลข 777 ในชื่อแบรนด์
// และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): โลโก้เป็นเวิร์ดมาร์กสองสี GOT เป็นทองเมทัลลิก
// #f5c518 มีอัญมณีแดงฝังกลางตัว O แล้วปิดด้วยเลข 777 สีแดงเลือดหมู #d21622 ขอบทอง งานอาร์ต
// เป็นพื้นดำประดับเหรียญทอง ชิปคาสิโนดำแดง และวงล้อรูเล็ต การ์ดรีวิวจึงใช้ทองกับแดงแยกหน้าที่
// กัน — สันนำหน้าหัวข้อ ป้ายระบุตัวสมาชิก และดาว เป็นทอง (ทองอ่อน #ffe9a8 → ทองแบรนด์
// #f5c518 → ทองลึก #96690f) ส่วนชื่อสมาชิกกับบรรทัดคะแนนรับขาวไฮไลต์ #fff6dd และจุด
// สถานะบนป้ายหัวเรื่องเป็นแดงแบรนด์ตามเลข 777 กรอบการ์ดกับเส้นคั่นเป็นแดงเข้มสุด #4c0301
// บนผิวการ์ด #160b06 เหนือพื้นเพจ #0a0503 เนื้อความเป็น BRAND_TEXT #ece0cb ตัวรอง #bdae92
// — ชุดทอง-ขาวของ WIN999 (#fcc403 #fdda04 #8a6502 #4a3402 #fffbea #101010 #050505
// #e9e4d6) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมสล็อตจากบัญชีเดียวผ่านมือถือ",
    stars: 5,
    tag: "สล็อตคลาสสิก · ธีมเอเชีย · เกมผจญภัย",
    content:
      "ที่ใช้ต่อเพราะรวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่ไว้ในบัญชีเดียวจริง มีทั้งเกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย และเกมโบนัสตามค่ายที่ระบบเปิดให้บริการ สลับเกมจากหน้าเดียวได้เลยไม่ต้องสมัครหลายบัญชี เข้าเล่นจากมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็ได้ แล้วยังเลือกเกม ตรวจเครดิต และดูประวัติรายการจากระบบเดียวได้เอง ส่วนผลของเกมยังเป็นแบบสุ่มเหมือนเดิม จึงไม่ได้คาดหวังว่าจะทำกำไรได้ตลอดเกม",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ไล่อ่านฟรีสปิน ตัวคูณ และเงื่อนไขแจ็กพอตก่อนเดิมพัน",
    stars: 5,
    tag: "ฟรีสปิน · ตัวคูณ · สล็อตแจ็กพอต",
    content:
      "ชอบที่หน้าเกมสล็อตค้นหาเกมใหม่กับเกมยอดนิยมได้ง่าย มีทั้งเกมที่มีฟรีสปิน ตัวคูณ และสล็อตแจ็กพอตให้ลุ้น แต่จำนวนเกมและแจ็กพอตที่เปิดให้เล่นจริงขึ้นอยู่กับแต่ละค่าย เลยกลายเป็นนิสัยว่าก่อนเดิมพันจะเปิดอ่านกติกา ช่วงเดิมพัน ฟีเจอร์โบนัส และเงื่อนไขของแจ็กพอตในเกมนั้นก่อนทุกครั้ง เพราะไม่ใช่ทุกเกมหรือทุกค่ายที่จะมีระบบแจ็กพอตเหมือนกัน",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านมือถือ แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "สมัครเองผ่านระบบออนไลน์บนมือถือได้ กรอกข้อมูลที่จำเป็น ยืนยันตามขั้นตอน แล้ว Login เข้าไปเลือกเกมสล็อต ตรวจโปรโมชั่น และดูช่องทางจัดการเครดิตได้จากหน้าเดียว ฝั่งโปรโมชั่นมีคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการกำหนดประเภทเกม รอบคำนวณ และยอดที่เข้าเกณฑ์ไม่เหมือนกัน จึงควรอ่านรายละเอียดล่าสุดจากหน้าเว็บไซต์ก่อนกดรับ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง โดยไม่บอกรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c518] to-[#96690f] shadow-[0_0_12px_rgba(245,197,24,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff6dd] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f5c518]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#bdae92]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตจากบัญชีเดียวผ่านมือถือ การอ่านกติกาและช่วงเดิมพันก่อนหมุนวงล้อ และการตรวจรอบคำนวณกับเงื่อนไขโปรโมชั่นก่อนกดรับ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#4c0301] border-l-[#f5c518] bg-[#160b06]/94 px-6 py-4 shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#96690f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#bdae92]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#4c0301] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c518]" : "text-[#4c0301]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece0cb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#f5c518]/50 bg-[#0a0503] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c518] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#4c0301] bg-[#160b06]/94 p-5 shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#f5c518]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f5c518]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#d21622]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#4c0301] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f5c518]/65 bg-gradient-to-br from-[#ffe9a8] via-[#f5c518] to-[#96690f] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff6dd] transition-colors group-hover:text-[#f5c518]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#bdae92]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f5c518]" : "text-[#4c0301]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f5c518]/45 bg-[#0a0503] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c518] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d21622]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ece0cb]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
