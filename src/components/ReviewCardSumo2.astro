---
// Full-service casino brand — every row stays inside what the brief names: การ
// รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล, การจัด
// หมวดหมู่เกมให้ค้นหาง่าย, การตรวจอัตราจ่าย กติกา และขั้นต่ำก่อนยืนยันรายการ,
// ขั้นต่ำที่บางเกมเริ่มประมาณ 1 บาทตามข้อกำหนดของผู้ให้บริการแต่ละราย, โบนัส
// แนะนำเพื่อน 0.8% ที่ผู้ถูกแนะนำต้องมียอดตามเกณฑ์, คืนยอดเสีย 0.3% ตามรอบ และ
// การติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่ตรวจอัตราจ่ายก่อนยืนยันรายการ",
    role: "เปิดกติกาและขั้นต่ำของทุกโต๊ะก่อนลงเดิมพัน",
    stars: 5,
    tag: "บาคาร่า · สล็อต · หวย · บอล",
    content:
      "ในระบบแยกหมวดบาคาร่าและคาสิโนสด สล็อตออนไลน์ หวยออนไลน์ และฟุตบอลไว้ให้ค้นหาง่าย เลยไล่ดูอัตราจ่าย กติกา และขั้นต่ำของแต่ละรายการก่อนยืนยันทุกครั้ง บางเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท แต่ตัวเลขจริงขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย จึงต้องตรวจที่หน้าเกมเองก่อน",
    avatar: "📖",
  },
  {
    name: "สมาชิกที่เช็กเงื่อนไขก่อนกดรับโบนัส",
    role: "อ่านยอดที่นำมาคำนวณและรอบการรับก่อนทุกครั้ง",
    stars: 5,
    tag: "โบนัส 0.8% · คืนยอดเสีย 0.3%",
    content:
      "แชร์ลิงก์แนะนำให้เพื่อนแล้วเข้าใจว่าการแชร์อย่างเดียวอาจยังไม่ได้โบนัส เพราะโปรกำหนดให้ผู้ถูกแนะนำต้องสมัครและมียอดการใช้งานตรงตามเงื่อนไขก่อน ส่วนโบนัสคืนยอดเสีย 0.3% ก็ตรวจประเภทเกม รอบคำนวณ และข้อกำหนดการถอนโบนัสจากบัญชีสมาชิกก่อนกดรับสิทธิ์",
    avatar: "🤝",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนรายการมีปัญหา",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ",
    stars: 4,
    tag: "แอดมิน CASINO888 หลังบ้าน",
    content:
      "ฝากแล้วเครดิตยังไม่เข้า เลยตรวจสถานะธุรกรรมในบัญชีก่อน จากนั้นทักแอดมิน CASINO888 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ ทำให้ทีมงานตรวจสอบระบบหลังบ้านได้ตรงจุดตลอด 24 ชั่วโมง ทีมงานยังย้ำให้ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP หรือรหัสผ่านให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก CASINO888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#c9c9c9]">CASINO888</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e4c25a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#6b5216]/70 bg-[#0d0a06]/92 px-6 py-4 shadow-[0_10px_30px_rgba(228,194,90,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fdf49c] to-[#b28a2a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8a8a8a] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#6b5216]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e4c25a]" : "text-[#3a2f14]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e9ddc4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#6b5216]/70 bg-[#0d0a06]/92 p-6 text-left shadow-[0_10px_30px_rgba(5,4,3,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e4c25a]/70 hover:shadow-[0_15px_40px_rgba(228,194,90,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fdf49c] to-[#b28a2a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#e4c25a]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#c9c9c9]/22"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#6b5216]/80 bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fae582] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e4c25a]" : "text-[#3a2f14]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e9ddc4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6b5216] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4c25a]/55 bg-gradient-to-br from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fae582] transition-colors group-hover:text-[#fdf49c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8a8a8a] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
