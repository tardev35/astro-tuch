---
// MHEEPOOH168 เป็นเว็บรวมคาสิโนเกมที่รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว —
// ทุกแถวอยู่ในกรอบที่ brief ระบุไว้เอง: ความบันเทิงหลายรูปแบบในระบบเดียวที่เข้าถึง
// ได้ง่ายทั้งบนมือถือและคอมพิวเตอร์, ระบบจัดหมวดหมู่เกมชัดเจนและแต่ละประเภทแยกเป็น
// เมนู, การสลับรูปแบบการเล่นจากบัญชีเดียวโดยไม่ต้องเปลี่ยนหลายเว็บไซต์, ตัวเลือกจาก
// หลายค่ายและหลายตลาด, โบนัสคืนยอดเสีย 0.3% กับโบนัสแนะนำเพื่อน 0.8% ที่มีเงื่อนไข
// แยกไว้ชัดเจนและตรวจสอบสิทธิ์ได้ก่อนรับ, ช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายใน
// เว็บไซต์พร้อมการตรวจสอบสถานะรายการผ่านบัญชีของตัวเอง และแอดมินที่ให้บริการตลอด
// 24 ชั่วโมง.
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// MHEEPOOH168: แถบระบุตัวสมาชิกเป็นทองสว่าง #fced74 ไล่ลงทองกลาง #f5b70a ส่วน
// กรอบการ์ดกับเส้นคั่นเป็นแดงการ์ด #540202 บนพื้นแดงเข้ม #2b0101 ตามคู่สีทองบนแดง
// ของโลโก้
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "เลือกเล่นทั้งบาคาร่าและสล็อตจากบัญชีเดียว",
    stars: 5,
    tag: "สลับรูปแบบการเล่นจากบัญชีเดียว",
    content:
      "เมื่อก่อนต้องเปิดหลายเว็บไซต์เพราะแต่ละที่มีแค่บางหมวด พอมาใช้ที่นี่คือรวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว แต่ละประเภทแยกเป็นเมนูชัดเจน สลับรูปแบบการเล่นได้จากบัญชีเดียวโดยไม่ต้องเปลี่ยนเว็บไซต์ ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ตามที่เว็บระบุไว้",
    avatar: "🎴",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "ตรวจสอบสิทธิ์โปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%",
    content:
      "โปรโมชั่นที่กำหนดไว้มีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แต่ละรายการมีรายละเอียดและเงื่อนไขแยกไว้อย่างชัดเจน ที่ชอบคือตรวจสอบสิทธิ์ก่อนรับได้ รอบคำนวณกับขั้นตอนรับสิทธิ์ดูได้จากหน้าโปรโมชั่น ส่วนยอดสิทธิ์ของโบนัสแนะนำเพื่อนก็ดูได้จากบัญชีสมาชิก",
    avatar: "💰",
  },
  {
    name: "คุณอนุชา พ.",
    role: "จัดการเครดิตผ่านช่องทางที่เว็บกำหนดไว้",
    stars: 4,
    tag: "ธนาคาร วอลเลท และแอดมิน 24 ชั่วโมง",
    content:
      "ระบบรองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ เลือกวิธีจัดการเครดิตได้ตามความสะดวก ขั้นตอนถูกจัดวางให้เข้าใจง่าย เหมาะกับทั้งสมาชิกใหม่และคนที่ใช้งานเป็นประจำ ตรวจสอบสถานะรายการและยอดผ่านบัญชีของตัวเองได้ ถ้าติดตรงไหนก็ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร เกม โปรโมชั่น ระบบเครดิต หรือการเข้าใช้งาน ทีมงานช่วยตรวจสอบปัญหาเบื้องต้นให้ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🏦",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MHEEPOOH168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced74] via-[#f5b70a] to-[#c4161c] shadow-[0_0_12px_rgba(245,183,10,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f1dccd] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fced74]">MHEEPOOH</span><span class="text-[#c4161c]">168</span>
      </p>
      <span class="text-xs tracking-wide text-[#f1dccd]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการสลับเล่นบาคาร่า สล็อต หวย และบอลจากบัญชีเดียว การตรวจสอบสิทธิ์โปรโมชั่นก่อนรับ และการจัดการเครดิตผ่านช่องทางที่เว็บกำหนดไว้
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#540202] border-l-[#f5b70a] bg-[#2b0101]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fced74] to-[#f5b70a] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f1dccd]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#540202] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5b70a]" : "text-[#540202]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f1dccd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#540202] bg-[#120303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fced74] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#540202] bg-[#2b0101]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#f5b70a]/75 hover:shadow-[0_15px_40px_rgba(245,183,10,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c4161c]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#fced74]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#540202] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f5b70a]/60 bg-gradient-to-br from-[#fced74] via-[#f5b70a] to-[#8a5a06] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fced74] transition-colors group-hover:text-[#f5b70a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f1dccd]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f5b70a]" : "text-[#540202]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f5b70a]/65 bg-[#120303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fced74] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c4161c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f1dccd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
