---
// UVO88 is a multi-product casino — every row stays inside what the brief
// states: การรวมบาคาร่า เกมไพ่ สล็อตออนไลน์ หวยออนไลน์ และการเดิมพันฟุตบอลไว้ใน
// บัญชีเดียว, การสลับประเภทเกมโดยไม่ต้องสมัครหลายบัญชี, การใช้งานผ่านมือถือ
// แท็บเล็ต และคอมพิวเตอร์, การตรวจสอบเครดิต ฝากถอน โปรโมชั่น และประวัติรายการ
// จากหน้าเว็บไซต์, โบนัสแนะนำเพื่อน 0.8% พร้อมรอบคำนวณและข้อกำหนด, โบนัสคืนยอด
// เสีย 0.3% ตามรอบที่กำหนด, และแอดมินที่ให้บริการได้ตลอด 24 ชั่วโมง.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state — the brief says outright that ผลลัพธ์ของเกมไม่สามารถรับประกันกำไรหรือ
// ผลชนะได้ทุกครั้ง. Written testimonial text only — no Review/AggregateRating
// JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Brand emerald carries
// the score/quote furniture, coin gold carries the identity rail, so both halves
// of the UVO88 artwork — the green chip and the gold 88 — are doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "รวมทุกหมวดเดิมพันไว้ในบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า · เกมไพ่ · สล็อต · หวย · บอล",
    content:
      "เปิดบัญชีเดียวแล้วสลับหมวดเกมได้ตามที่สนใจ ทั้งบาคาร่าออนไลน์ เกมไพ่ในหมวดคาสิโน สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดรับ และการเดิมพันฟุตบอลตามรายการแข่งขัน ไม่ต้องสมัครหลายบัญชี ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน ตรวจสอบเครดิต และดูโปรโมชั่นอยู่ในหน้าเว็บไซต์เดียวกัน",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ดูกติกา อัตราจ่าย และวงเงินก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "กติกา · อัตราจ่าย · ช่วงเดิมพัน · วงเงิน",
    content:
      "ก่อนเริ่มเดิมพันจะเข้าไปดูกติกา อัตราจ่าย ช่วงเดิมพัน และวงเงินของเกมนั้นก่อนเสมอ เพราะรายละเอียดต่างกันตามผู้ให้บริการและประเภทการเดิมพัน ส่วนเรื่องไม่มีขั้นต่ำก็ยึดตัวเลขที่เกมหรือระบบแสดง ณ เวลาทำรายการเป็นหลัก ไม่ได้เอาจากข้อความโฆษณา เพราะบางเกมเริ่มด้วยยอดต่ำได้ แต่บางเกมกำหนดขั้นต่ำไว้ต่างกัน",
    avatar: "🎯",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ทำรายการเอง แล้วเช็กโปรโมชั่นจากบัญชีสมาชิก",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "เติมเครดิตผ่านช่องทางฝากที่ระบบเปิดรองรับ ส่งคำขอถอน และตามประวัติรายการผ่านบัญชีสมาชิกได้เองบนมือถือ ส่วนโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่มี ทั้งโบนัสแนะนำเพื่อน 0.8% ที่คำนวณจากยอดเข้าเงื่อนไข และโบนัสคืนยอดเสีย 0.3% ตามรอบที่กำหนด ก่อนกดรับควรดูวิธีคำนวณ รอบเวลา และเงื่อนไขการถอนให้ครบ รอบไหนติดปัญหาก็แจ้งแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก UVO88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#57dd8f] via-[#f2c230] to-[#116330] shadow-[0_0_12px_rgba(15,157,71,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f3fbf5] uppercase sm:text-3xl">
        เสียงจากสมาชิก UVO<span class="text-[#f2c230]">88</span>
      </p>
      <span class="text-xs tracking-wide text-[#93b8a0]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการสลับหมวดเกมจากบัญชีเดียว การตรวจกติกาและวงเงินก่อนเริ่มเดิมพัน และการตรวจสอบโปรโมชั่นผ่านบัญชีสมาชิกด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0a3b1c] border-l-[#0f9d47] bg-[#051a0e]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,13,7,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f3fbf5] to-[#0f9d47] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#93b8a0]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#0a3b1c] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2c230]" : "text-[#0a3b1c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c8e3d0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#f2c230]/45 bg-[#03110a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2c230] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0a3b1c] bg-[#051a0e]/92 p-5 shadow-[0_10px_30px_rgba(2,13,7,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#0f9d47]/70 hover:shadow-[0_15px_40px_rgba(15,157,71,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#0f9d47]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#0f9d47]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#0a3b1c] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f2c230]/50 bg-gradient-to-br from-[#f2c230] via-[#9c7d2b] to-[#116330] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f2c230] transition-colors group-hover:text-[#f3fbf5]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#93b8a0]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f2c230]" : "text-[#0a3b1c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#0a3b1c]/60 bg-[#03110a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#57dd8f] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#0f9d47]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#c8e3d0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
