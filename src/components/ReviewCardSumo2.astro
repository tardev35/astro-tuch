// เหลือง · ยอดปรางค์ทอง · ลูกบอลหวยเขียว-ขาว และผิวโครเมียมเงินของเวิร์ดมาร์กเป็น
// **วัตถุในภาพ** ส่วนห้องโทนขาวงาช้างคือฉาก ไม่ใช่สีของ UI คนละชุด) · LINE green
// 00B900 กับเขียว success ของฟีดอยู่ไฟล์อื่น **คงไว้ ห้ามกลืนเข้าเขียวมรกตของ
// รอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว
const reviews = [
  {
    name: "คุณกิตติพงศ์ ส.",
    role: "ไล่อ่านรอบปิดรับและแหล่งอ้างอิงผลรางวัลของแต่ละรายการให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้น",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์รวบรวมข้อมูลหวยหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย และหวยหุ้นที่อ้างอิงดัชนีตลาดหลักทรัพย์ จึงศึกษารูปแบบการเดิมพัน ตรวจสอบหมายเลข และติดตามข้อมูลผลรางวัลได้จากเว็บไซต์เดียว แต่ละรายการมีรอบปิดรับและเวลาออกผลไม่เหมือนกัน หวยรัฐบาลไทยผูกกับปฏิทินของงวดนั้น ส่วนหวยหุ้นผูกกับเวลาทำการของตลาดที่อ้างอิง จึงต้องดูตารางรอบของแต่ละรายการแยกกันจริง ๆ ไม่ใช่เทียบเอาจากรายการที่คุ้นเคยอยู่แล้ว ส่วนที่อยากกำกับไว้ให้ตรงกันคือเรื่องช่องทางเข้าใช้งาน ควรตรวจสอบความถูกต้องของที่อยู่เว็บไซต์ รวมถึงข้อมูลผู้ให้บริการที่อยู่เบื้องหลังก่อนทำรายการทุกครั้ง เพราะคำกล่าวอ้างว่าเป็นเว็บแม่จำเป็นต้องมีหลักฐานที่ตรวจสอบได้ ไม่ใช่สิ่งที่ยืนยันได้จากข้อความบนหน้าเว็บเพียงอย่างเดียว",
    avatar: "🍀",
    accent: "emerald" as const,
  },
  {
    name: "คุณศิรินทิพย์ พ.",
    role: "เปิดตารางอัตราจ่ายกับวงเงินจ่ายสูงสุดอ่านอีกรอบก่อนยืนยันบิลทุกครั้ง",
    stars: 5,
    tag: "อัตราจ่าย 2 ตัว 100 · 3 ตัว 1,000 · เลขอั้น · วงเงินเดิมพัน",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าอัตราจ่าย ซึ่งระบุไว้ว่า 2 ตัว 100 และ 3 ตัว 1,000 ซึ่งเป็นรายละเอียดที่ใช้เปรียบเทียบรูปแบบการเดิมพันได้จริง ก่อนยืนยันบิลจะไล่ดูก่อนว่าอัตราดังกล่าวคำนวณจากเงินเดิมพันจำนวนเท่าใด และใช้กับหวยประเภทใดบ้าง สำหรับหมายเลขสองหลักยังต้องดูว่าใช้กับเลขสองตัวบนหรือสองตัวล่าง ส่วนหมายเลขสามหลักก็ต้องดูว่าเป็นสามตัวตรง สามตัวโต๊ด หรือรูปแบบใด เพราะหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นอาจมีเงื่อนไขแตกต่างกัน รวมถึงข้อกำหนดเรื่องเลขอั้น วงเงินเดิมพัน และวงเงินจ่ายสูงสุดของแต่ละรายการ เว็บไซต์ระบุว่ามีอัตราจ่ายสูงและระบบโอนเงินรวดเร็ว แต่ควรตรวจสอบเงื่อนไขการถอนเงินให้ครบถ้วน เพราะความรวดเร็วในการโอนอาจขึ้นอยู่กับสถานะระบบและผู้ให้บริการชำระเงิน ที่ต้องเข้าใจตรงกันอีกข้อคือผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง",
    avatar: "🛕",
    accent: "surface" as const,
  },
  {
    name: "คุณวรเมธ อ.",
    role: "ตรวจช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง",
    stars: 4,
    tag: "สมัครสมาชิก 3 ขั้นตอน · แอดมิน 24ชม.",
    content:
      "ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปตรวจสอบประเภทหวย เปิดผ่านเบราว์เซอร์บนมือถือหรืออุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ตได้ตามที่เว็บไซต์ระบุ แต่ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชี ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ หลังลงทะเบียนแล้วก็ยังต้องศึกษารายการหวยที่เปิดให้บริการ อัตราจ่าย รอบปิดรับ และวิธีตรวจสอบบิลของแต่ละประเภท ส่วนการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ ประเภทหวย รอบปิดรับ และอัตราจ่าย ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบิลหวยหรือธุรกรรม จะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดปัญหาให้ชัดเจน ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🌼",
    accent: "emerald" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#03543c] via-[#046c4e] to-[#0c7c58] shadow-[0_0_12px_rgba(4,108,78,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#0d3326] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#046c4e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#0d3326]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมหวยสี่ประเภทที่เว็บไซต์ระบุไว้ อัตราจ่าย 2 ตัว 100 กับ 3 ตัว 1,000 ขั้นตอนสมัครสมาชิก 3 ขั้นตอน และช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#a3ddc3] border-l-[#046c4e] bg-white px-6 py-4 shadow-[0_10px_30px_rgba(13,51,38,0.10)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#046c4e]">{average}</span>
      <span class="text-sm font-black text-[#3f6f5c]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#a3ddc3] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#8a6508]" : "text-[#8a6508]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#0d3326]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#a3ddc3] bg-[#d2f3e4] px-3 py-1 text-[10px] font-bold tracking-wide text-[#0d3326] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#a3ddc3] bg-white p-5 shadow-[0_10px_30px_rgba(13,51,38,0.10)] transition-all duration-300 hover:border-[#19a97c] hover:shadow-[0_15px_40px_rgba(4,108,78,0.18)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e2b32a]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#2fd49b]/35"
          />

          <div class="flex items-center gap-4 border-b border-[#a3ddc3] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "emerald"
                  ? "border border-[#03543c] bg-gradient-to-br from-[#03543c] via-[#046c4e] to-[#0c7c58] text-white"
                  : "border border-[#a3ddc3] bg-gradient-to-br from-[#ffffff] to-[#d2f3e4] text-[#0d3326]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#0d3326] transition-colors group-hover:text-[#046c4e]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#3f6f5c]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#8a6508]" : "text-[#8a6508]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a3ddc3] bg-[#d2f3e4] px-3 py-1 text-[10px] font-bold tracking-wide text-[#0d3326] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#19a97c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#0d3326]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
