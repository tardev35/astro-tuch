---
const reviews = [
  {
    name: "สมาชิกที่ส่งโพยผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้วเข้าสู่ระบบได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด เลือกเลข กรอกยอดแทง และตรวจสอบโพยก่อนกดยืนยันได้จากเครื่องเดียว เหมาะกับคนที่สลับไปมาระหว่างมือถือกับคอมพิวเตอร์",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่แทงทั้งเลข 2 ตัวและ 3 ตัว",
    role: "ตรวจอัตราจ่ายและวงเงินก่อนยืนยันโพยทุกครั้ง",
    stars: 5,
    tag: "เรทจ่ายสูงสุด 1,000",
    content:
      "ทั้งเลข 2 ตัว เลข 3 ตัว เลขอั้น และวิ่งบนวิ่งล่าง อยู่ในบัญชีเดียวกัน อัตราจ่ายและวงเงินรับของเลขนั้นแสดงอยู่บนหน้าส่งโพย อ่านซ้ำได้ก่อนกดยืนยัน จึงรู้ตั้งแต่แรกว่ารายการนี้ใช้เรทเท่าไร",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "ตอนส่งคำขอถอนแล้วรายการยังค้าง แจ้งเวลาที่ทำรายการกับรายละเอียดไป แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาส่งโพยรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HSOD" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8121d] via-[#ff4d55] to-[#c2c9d4] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e8121d]">HSOD</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8121d] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#7c0207]/35 bg-[#170406]/92 px-6 py-4 shadow-[0_10px_30px_rgba(232,18,29,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ff4d55] to-[#7c0207] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#aeb6c2] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2a0508]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8121d]" : "text-[#2a0508]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#aeb6c2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7c0207]/35 bg-[#170406]/92 p-6 text-left shadow-[0_10px_30px_rgba(232,18,29,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8121d]/60 hover:shadow-[0_15px_40px_rgba(232,18,29,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#e8121d] to-[#c2c9d4] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#3d0104]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#e8121d]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7c0207]/35 bg-[#0b0203] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e8121d] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8121d]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e8121d]" : "text-[#2a0508]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dfe3ea]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2a0508] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7c0207]/40 bg-gradient-to-br from-[#ff4d55] via-[#e8121d] to-[#c2c9d4] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dfe3ea] transition-colors group-hover:text-[#e8121d]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#aeb6c2] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
