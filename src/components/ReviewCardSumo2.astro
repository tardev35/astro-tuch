---
import { BRAND_NAME } from "../lib/brandProfile";

// TND168 (2026-10-13): รอบนี้เป็น **รีเธมสีล้วน** ของไฟล์นี้ ไม่ได้เขียนเนื้อความใหม่
// ตัวบทรีวิว (ชื่อ · role · tag · content · ดาว) เป็นของบรีฟรอบ FAH999 และ operator
// สั่งให้คงไว้ทั้งหมด เพราะทุกแถวพูดถึง "สล็อตออนไลน์ · ระบบ Login · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง" ซึ่งไม่ขัดกับ TND168 ที่เป็น
// แบรนด์คาสิโนครบหมวด (บาคาร่า · สล็อต · รูเล็ต · ไฮโล · แทงบอล · คาสิโนสด) —
// สล็อตเป็นหมวดย่อยของสิ่งที่รอบนี้ให้บริการอยู่แล้ว ไม่มีแถวไหนพูดถึงหวย/ลอตเตอรี
// จึงไม่มีอะไรต้องรีไรต์เพราะเนื้อหาขัดกัน
//
// สิ่งเดียวในตัวบทที่แก้: คำว่า **"ฟาสล็อตเว็บตรง"** ในรีวิวแถวแรก — "ฟา" คือชื่อแบรนด์
// FAH999 ที่ผูกติดมากับคำ ไม่ใช่คำทั่วไป เปลี่ยนเป็น "คาสิโนเว็บตรง" ซึ่งตรงกับบรีฟรอบนี้
// ส่วนชื่อแบรนด์ที่แสดงผลยัง interpolate จาก BRAND_NAME เหมือนเดิม ไม่พิมพ์ชื่อตรงๆ
// ที่ไหนเลย (ทั้งในข้อความและใน aria-label)
//
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// หัวข้อบล็อกเป็น <p> และ <section> ถือ aria-label ไว้ — ตารางรีวิวคือ chrome
// จึงไม่ปล่อยแท็กหัวข้อออกมาเลยสักระดับ (h1 ถึง h6 = ศูนย์แท็ก) ชื่อสมาชิกทุกคนและ
// ป้ายทุกใบเป็น <span> ที่ถือคลาสหน้าตาเดิม
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// ── สีรอบนี้: ทองมังกรบนดำสนิท ฮิวเดียว ไม่มีสีที่สอง ──────────────────────
// ทองหลัก #dfa310 (ขอบ · ไอคอน · ดาวที่ติด · ตัวอักษรปกติ) · ทองสว่าง #ffe4a3
// (ปลายสว่างของไล่สี + สี hover) · ทองไฮไลต์ #ffc93d (stop กลาง + คำที่ไฮไลต์
// ในเนื้อความ = ชื่อแบรนด์ในหัวข้อ) · ผิวการ์ดยก #1b1307 · แผ่นจมสุด #070502
// (พื้นชิป) · เนื้อความและชื่อสมาชิก #f0e9dc (= BRAND_TEXT) · ตัวรอง #c9b88e
// glow ทั้งหมดเป็น rgba(223,163,16,α) หรือ rgba(0,0,0,α)
//
// #8a5c09 ใช้ได้แค่เป็นเส้น/ขอบ/ออรา — ในไฟล์นี้อยู่สองที่คือเส้นคั่น (bg) กับขอบ
// ป้ายอวาตาร์ (border) **ไม่มีจุดไหนให้มันถือตัวอักษร** และ #43240b ไม่ถูกใช้เลย
// ดาวที่ยังไม่ติดจึงเป็น #dfa310/25 (ทองหลักลดความทึบ) ไม่ใช่สีทองเข้มที่ห้ามถือ
// ตัวอักษร — ดาวเป็น glyph ไม่ใช่เส้น
// ป้ายอวาตาร์เป็นแผ่นทองทึบไล่ #ffe4a3 → #ffc93d → #dfa310 บนหมึก #140d02 ซึ่งเป็น
// หมึกตัวเดียวที่วางบนพื้นถมทองได้ (≈7.9:1 ที่ปลายเข้มสุดของแผ่น) — จงใจไม่ให้ไล่
// ลงไปถึง #8a5c09 เพราะหมึกบนปลายนั้นตกไปเหลือ ~2.5:1
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ทองมาแล้วเก้าในสิบเอ็ดรอบ ไฟล์นี้จึง
// "ดูทองถูกแล้ว" มาก่อนที่จะถูกแบรนด์ด้วย ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุด
// **ชมพูฮอต-ทอง บนพลัมดำของ FAH999**: #ff3fa4 #ff6cbb #ffd1ea #ffe49a #f5c53d
// #d19a12 #fde8f3 #e8b9d4 #7a0046 #4a0b42 #210220 #2b0019 และ rgba(255,63,164,α)
// ออกครบทุกจุด — ไม่เหลือชมพู/พลัมแม้แต่ค่าเดียว
// ก่อนหน้านั้นไฟล์นี้เคยค้างชุด NAZA168 (ทองอวกาศ-เงินโครเมียม) · DUCK1688
// (ทองเป็ด-ส้มอำพัน) · GOT777 (ทอง-แดง) · BPLAY639 (ชมพู-ม่วง) ซึ่ง FAH999 ถอด
// ออกไปแล้วรอบก่อน และรอบนี้ยืนยันว่าไม่มีค่าไหนกลับมา
// ⚠️ ที่ต้องระวังเป็นพิเศษ: #f5c53d (FAH999) ต่างจาก #ffc93d (รอบนี้) แค่สองตัวอักษร
// และ #e5a81b ของ UFA324 อยู่ห่างจาก #dfa310 แค่นิดเดียว — ห้ามกะด้วยตา
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกค่าย ค้นหาเกม และตรวจสอบข้อมูลบัญชีจากบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ฟีเจอร์พิเศษ",
    content:
      "ที่ใช้ต่อเพราะเป็นคาสิโนเว็บตรงที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ผ่านระบบ Login ใช้งานง่าย รองรับทั้งมือถือและคอมพิวเตอร์ แล้วรวมเกมสล็อตหลายแนวไว้ในแพลตฟอร์มเดียว ไม่ว่าจะเป็นสล็อตคลาสสิก เกมโบนัส หรือฟรีสปิน ทางเข้าหลักเน้นการจัดหมวดหมู่ให้ค้นหาเกมได้สะดวก มีทั้งสล็อตวงล้อทั่วไป เกมที่มีฟีเจอร์พิเศษ และเกมโบนัสให้เลือกตามความสนใจ ตัวที่ชอบที่สุดคือระบบ Login เพราะเข้าถึงข้อมูลเครดิต ประวัติรายการ และหมวดเกมได้จากบัญชีเดียว โดยไม่ต้องสลับหลายเว็บไซต์ ก่อนเริ่มเล่นก็ตรวจสอบตารางจ่าย อัตราการคืนเงินผู้เล่น และช่วงเดิมพันของแต่ละเกมได้โดยตรง ส่วนเรื่องที่อยากให้อ่านกันก่อนคือคำว่าสล็อตแตกง่ายทุกเกม ควรพิจารณาจากรายละเอียดของเกมแต่ละรายการ เพราะผลการหมุนเป็นแบบสุ่มและไม่มีเกมใดรับประกันว่าจะชนะทุกครั้ง และการยืนยันว่าเป็นสล็อตระบบแท้หรือเว็บตรง ควรตรวจสอบข้อมูลผู้ให้บริการและค่ายเกมที่เชื่อมต่อจริงก่อนใช้งาน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณ",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เข้ายูส",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบโปรโมชั่นตามกิจกรรมที่เปิดให้บริการได้เอง ทั้งรายการที่มีสิทธิ์รับ ยอดคำนวณ และสถานะโบนัสจากบัญชีตามระบบที่กำหนด ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามข้อกำหนดจะถูกนำมาคำนวณจากยอดที่เข้าเกณฑ์ก่อนแสดงจำนวนโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด ถ้ารองรับการโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดและประวัติการรับสิทธิ์ได้จากบัญชี ส่วนแนะนำเพื่อนคือใช้ลิงก์แนะนำเชิญเพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ แล้วดูจำนวนเพื่อนและสถานะโบนัสผ่านบัญชีได้ ข้อควรรู้คือแต่ละโปรโมชั่นอาจมีเงื่อนไขเกี่ยวกับประเภทเกม รอบรับสิทธิ์ และการใช้โบนัสแตกต่างกัน จึงควรอ่านรายละเอียดก่อนกดรับทุกครั้ง และคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส เพื่อให้สมาชิกเข้าใจข้อกำหนดตรงกัน อย่าลืมตรวจรอบตัดยอดและค่ายเกมที่ร่วมรายการให้ครบถ้วนก่อนรับทุกครั้ง",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจโดเมนหลักก่อนส่งข้อมูลส่วนตัวทุกครั้ง",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ยืนยันบัญชี · แอดมิน 24 ชั่วโมง",
    content:
      "การสมัครแบ่งเป็น 3 ขั้นตอนตามที่เว็บไซต์ระบุไว้ เริ่มจากเข้าหน้าสมัครสมาชิกโดยเลือกเมนูสมัครจากทางเข้าหลัก แล้วตรวจสอบชื่อเว็บไซต์และช่องทางที่ใช้งานให้ถูกต้องก่อนดำเนินการต่อ ขั้นที่สองคือกรอกข้อมูลตามแบบฟอร์มที่ระบบกำหนดพร้อมตั้งรหัสผ่านที่คาดเดายากและไม่ใช้ซ้ำกับบัญชีอื่น ขั้นสุดท้ายคือตรวจสอบรายละเอียดที่กรอก อ่านเงื่อนไขให้ครบถ้วน และยืนยันการสมัครก่อนเข้าสู่ระบบเพื่อดูหมวดเกมและข้อมูลบัญชีสมาชิก ข้อที่อยากกำกับไว้คือผู้สมัครควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการก่อนส่งข้อมูลส่วนตัว พร้อมอ่านข้อกำหนดการใช้งานและตรวจสอบอายุที่กฎหมายอนุญาตในพื้นที่ของตน เรื่องติดต่อก็แจ้งแอดมินผ่านช่องทางติดต่อหลักได้ตลอด 24 ชั่วโมง ถ้าเข้าสู่ระบบไม่ได้ให้แจ้งข้อความแจ้งเตือนและเวลาที่เกิดเหตุ ปัญหาเกมสล็อตให้ระบุชื่อเกมและค่ายที่ใช้งาน ส่วนเรื่องโปรโมชั่นให้แจ้งชื่อกิจกรรมและรอบรับสิทธิ์ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe4a3] via-[#ffc93d] to-[#dfa310] shadow-[0_0_12px_rgba(223,163,16,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f0e9dc] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ffc93d]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#c9b88e]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการค้นหาเกมและเลือกหมวดเกมทั้งสล็อตคลาสสิก เกมโบนัส และฟรีสปินผ่านระบบ Login จากบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์
        และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#dfa310]/30 border-l-[#dfa310] bg-[#1b1307] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe4a3] to-[#dfa310] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#c9b88e]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#8a5c09] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#dfa310]" : "text-[#dfa310]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f0e9dc]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#dfa310]/45 bg-[#070502] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfa310] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#dfa310]/25 bg-[#1b1307] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#dfa310]/70 hover:shadow-[0_15px_40px_rgba(223,163,16,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#dfa310]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#dfa310]/34"
          />

          <div class="flex items-center gap-4 border-b border-[#8a5c09] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#8a5c09] bg-gradient-to-br from-[#ffe4a3] via-[#ffc93d] to-[#dfa310] text-2xl text-[#140d02] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f0e9dc] transition-colors group-hover:text-[#ffe4a3]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#c9b88e]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#dfa310]" : "text-[#dfa310]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#dfa310]/45 bg-[#070502] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfa310] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dfa310]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f0e9dc]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
