---
const reviews = [
  {
    name: "สมาชิกที่เล่นสล็อตผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บน Android แล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ระบบแยกหมวดทั้งเกมยอดนิยม เกมใหม่ และเกมที่มีฟีเจอร์โบนัสไว้ให้ค้นหาง่าย ตรวจสอบกติกาและรายละเอียดของเกมก่อนเข้าเล่นได้จากบัญชีเดียว",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามสิทธิพิเศษรายวัน",
    role: "อ่านเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "โปรโมชั่นและสิทธิพิเศษ",
    content:
      "หน้าโปรโมชั่นแสดงยอดที่ใช้คำนวณ รอบการรับ และข้อกำหนดของแต่ละกิจกรรมไว้ครบ ทำให้ดูได้ว่ารายการไหนเข้าเงื่อนไขบ้างก่อนกดรับ ส่วนรายการที่ระบุว่าไม่จำกัดก็ยึดวงเงินและข้อกำหนดล่าสุดที่แสดงบนหน้าโปรโมชั่นเป็นหลัก",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนฝากถอน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอนทาง LINE Official",
    stars: 4,
    tag: "แอดมิน 24 ชั่วโมง",
    content:
      "ทำรายการฝากแล้วสถานะยังค้าง จึงแจ้งเวลาที่ทำรายการกับรายละเอียดไปทาง LINE Official แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ พร้อมอธิบายกติกาและฟีเจอร์ของเกมให้เข้าใจโดยไม่รับปากเรื่องผลกำไร",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก CAMPING289" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#69b522] via-[#eefae4] to-[#dbaa8a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#eefae4]">CAMPING289</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#69b522] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#69b522]/40 bg-[#072a13]/92 px-6 py-4 shadow-[0_10px_30px_rgba(105,181,34,0.16)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#eefae4] to-[#9ada4e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#dbaa8a]/80 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2f7a2a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#b6e87a]" : "text-[#2f7a2a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d6e6cc]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2f7a2a]/60 bg-[#072a13]/92 p-6 text-left shadow-[0_10px_30px_rgba(2,10,5,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#69b522]/70 hover:shadow-[0_15px_40px_rgba(105,181,34,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#dbaa8a] to-[#69b522] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0b5232]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#69b522]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2f7a2a]/70 bg-[#04120a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#eefae4] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#9ada4e]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#b6e87a]" : "text-[#2f7a2a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d6e6cc]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2f7a2a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#69b522]/45 bg-gradient-to-br from-[#9ada4e] via-[#69b522] to-[#0b5232] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#b6e87a] transition-colors group-hover:text-[#eefae4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#dbaa8a]/80 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
