---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บเดิมพันออนไลน์ "เจ้าของเดิม อัปเดตระบบใหม่ ความปลอดภัยสูงขึ้น"
// ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้เอง: ปรับระบบใหม่ทั้งหน้าเกม เมนูสมาชิก และ
// การเข้าถึงผ่านมือถือ, ยังคงรูปแบบบริการจากแบรนด์เดิม, จัดการสิทธิ์บัญชีและข้อมูล
// ภายในระบบอย่างเหมาะสม, รวมบาคาร่า สล็อต หวย ไฮโล บอล ไว้ในบัญชีเดียว, เลือกหมวด
// จากเมนูหลักและสลับเกมได้สะดวก, โบนัสแนะนำเพื่อน 0.8% กับโบนัสคืนยอดเสีย 0.3%
// ตามเงื่อนไขของแต่ละรายการ และสมัครเองได้ใน 3 ขั้นตอน ไม่มีข้อความไหนรับปากว่าจะ
// ชนะ บอกอัตราการจ่าย หรืออ้างใบอนุญาต
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// ABM96 (รอบชมพู-เหลือง 2026-09-22): แถบระบุตัวสมาชิกไล่จากชมพูอ่อน #ffc9dc ลงชมพู
// หลัก #fd6494 ไปหาชมพูเข้ม #b8325f ตามตัวอักษร ABM บนโลโก้ ส่วนดาวและป้ายแท็กรับ
// เหลืองโลโก้ #feda2a ตามเลข 96 กรอบการ์ดกับเส้นคั่นเป็นพื้นการ์ดสว่าง #3d0f26 บน
// พื้นการ์ด #1d0611 เหนือพื้นเพจชมพูเกือบดำ #12030a ชื่อหัวข้อเป็นชมพูอ่อนสุด
// #ffe0ec — มรกต-ทองของ HENG38 ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ใช้ทางเข้าใหม่ผ่านมือถือเป็นหลัก",
    stars: 5,
    tag: "เจ้าของเดิม ทางเข้าอัปเดตใหม่",
    content:
      "ที่ยังใช้ต่อเพราะเป็นเจ้าของเดิมแต่ปรับระบบใหม่ให้ใช้งานสะดวกขึ้น ทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ ทางเข้าถูกปรับให้ทันสมัย เปิดจากมือถือแล้วกดเข้าหมวดที่ต้องการได้เลย แต่รูปแบบบริการยังเป็นแบบเดิมที่คุ้นอยู่แล้ว เลยไม่ต้องเริ่มเรียนรู้ระบบใหม่ทั้งหมด",
    avatar: "📱",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เลือกหมวดเกมจากเมนูหลักในบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า สล็อต หวย ไฮโล บอล",
    content:
      "ชอบตรงที่รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย ไฮโล และบอล เลือกหมวดที่สนใจได้จากหน้าเมนูหลัก แล้วสลับระหว่างเกมแต่ละประเภทได้สะดวก ระบบจัดหมวดหมู่ชัดเจน ค้นหาเกมหรือรายการที่ต้องการได้ง่าย ไม่ต้องเปลี่ยนไปเปิดหลายเว็บไซต์เหมือนที่เคยทำ",
    avatar: "🎴",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "เช็กเงื่อนไขโปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "โปรโมชั่นที่ใช้อยู่มีให้เลือกตามเงื่อนไขของแต่ละรายการ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ที่ดีคือตรวจสอบรายละเอียดก่อนกดรับจากหน้าโปรโมชั่นได้โดยตรง เลยรู้รอบรับสิทธิ์ ยอดที่เข้าเกณฑ์ และข้อกำหนดก่อนนำโบนัสไปใช้งาน ส่วนการสมัครก็ทำเองผ่านหน้าเว็บไซต์ได้ใน 3 ขั้นตอน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9dc] via-[#fd6494] to-[#b8325f] shadow-[0_0_12px_rgba(253,100,148,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ffe0ec] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fd6494]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#fbe3ee]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมทางเข้าที่อัปเดตใหม่ การเลือกหมวดเกมจากเมนูหลักในบัญชีเดียว และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#3d0f26] border-l-[#fd6494] bg-[#1d0611]/94 px-6 py-4 shadow-[0_10px_30px_rgba(18,3,10,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe0ec] to-[#fd6494] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#fbe3ee]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#3d0f26] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#feda2a]" : "text-[#3d0f26]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#fbe3ee]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#3d0f26] bg-[#12030a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc9dc] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#3d0f26] bg-[#1d0611]/94 p-5 shadow-[0_10px_30px_rgba(18,3,10,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#fd6494]/75 hover:shadow-[0_15px_40px_rgba(253,100,148,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#d92e6e]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#feda2a]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#3d0f26] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fd6494]/60 bg-gradient-to-br from-[#ffc9dc] via-[#fd6494] to-[#b8325f] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ffc9dc] transition-colors group-hover:text-[#ffe0ec]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#fbe3ee]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#feda2a]" : "text-[#3d0f26]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fd6494]/65 bg-[#12030a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc9dc] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#feda2a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#fbe3ee]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
