---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บคาสิโนออนไลน์ ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง: รวมเกมคาสิโนออนไลน์
// หลายรูปแบบทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ, Login ผ่านเว็บเบราว์เซอร์
// แล้วเลือกหมวดเดิมพันจากบัญชีเดียว, ตรวจสอบเครดิต ประวัติรายการ และรายละเอียดเกมก่อนเริ่ม
// เดิมพัน, ฝากถอนผ่านช่องทางบัญชีบริษัทโดยตรวจชื่อบัญชีและข้อมูลปลายทางก่อนโอน, บันทึก
// ทางเข้าล่าสุดจากช่องทางหลักของเว็บไซต์, โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ที่ต้อง
// ตรวจรอบคำนวณและยอดที่เข้าเกณฑ์ก่อนกดรับ, การสมัคร 3 ขั้นตอนด้วยตัวเอง และการติดต่อ
// แอดมินที่ตอบแชทตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนพูดถึงหวย เลข 2 ตัว/3 ตัว อัตราจ่าย ชื่อค่ายเกม RTP ชื่อธนาคาร เลขใบอนุญาต
// หรือรับปากว่าจะไม่โดนอายัด/ไม่ปิดปรับปรุง เพราะบรีฟระบุข้อจำกัดทั้งสองข้อไว้ชัดเจน
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): โลโก้เป็นเวิร์ดมาร์กสองสี WIN เป็นทองสด #fcc403 แล้ว
// ปิดด้วย 999 สีขาว งานอาร์ตเป็นพื้นดำสนิทประดับทอง ชิปคาสิโนดำขอบทอง และมงกุฎทอง การ์ด
// รีวิวจึงใช้ทองกับขาวแยกหน้าที่กัน — สันนำหน้าหัวข้อ ป้ายระบุตัวสมาชิก และดาว เป็นทอง
// (ทองสว่าง #fdda04 → ทองแบรนด์ #fcc403 → ทองลึก #8a6502) ส่วนชื่อสมาชิกกับบรรทัด
// คะแนนรับขาวไฮไลต์ #fffbea ตามเลข 999 ในโลโก้ กรอบการ์ดกับเส้นคั่นเป็นทองลึกมาก
// #4a3402 บนผิวการ์ด #101010 เหนือพื้นเพจ #050505 เนื้อความเป็น BRAND_TEXT #e9e4d6 —
// ชุดแดง-ทองของ LOTTO24 (#dc2626 #fc2b2c #b40102 #7f1d1d #fbbf24 #fde68a #a16207
// #2a0405 #140202 #fff1f1 #f6e2e2) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกหมวดเดิมพันจากบัญชีเดียวผ่านมือถือ",
    stars: 5,
    tag: "บาคาร่า · สล็อต · เกมไพ่",
    content:
      "ที่ใช้ต่อเพราะรวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในที่เดียวจริง มีทั้งบาคาร่า สล็อต เกมไพ่ และเกมอื่นตามค่ายที่ระบบรองรับ Login ผ่านเว็บเบราว์เซอร์แล้วเลือกหมวดเดิมพันจากบัญชีเดียวได้เลย ไม่ต้องสลับเว็บไซต์ไปมา แล้วยังตรวจเครดิต ประวัติรายการ และรายละเอียดเกมก่อนเริ่มเดิมพันได้ด้วยตัวเอง",
    avatar: "🎲",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ฝากถอนผ่านช่องทางบัญชีบริษัท",
    stars: 5,
    tag: "บัญชีบริษัท · ตรวจก่อนโอน",
    content:
      "ระบบฝากถอนทำรายการและติดตามสถานะเครดิตผ่านบัญชีของตนเองได้ ก่อนฝากเงินก็ตรวจชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางให้ตรงกับรายละเอียดที่เว็บไซต์แสดงก่อนทุกครั้ง ส่วนรายการถอนตรวจสถานะผ่านระบบแล้วเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสมบูรณ์ ถ้าระบุว่าเป็นบัญชีบริษัทก็ควรมีชื่อนิติบุคคลที่ตรวจสอบได้จริง",
    avatar: "🏦",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "สมัครเองได้ใน 3 ขั้นตอน เข้าหน้าสมัครแล้วกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลหรือเบอร์โทรศัพท์ตามขั้นตอน แล้ว Login เข้าบัญชีเพื่อตรวจช่องทางฝากเงิน โปรโมชั่น และเกมที่เปิดให้บริการ ฝั่งโปรโมชั่นมีคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ซึ่งตรวจรอบคำนวณและยอดที่เข้าเกณฑ์ได้ก่อนกดรับ ติดตรงไหนก็ติดต่อแอดมินที่ตอบแชทตลอด 24 ชั่วโมง",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdda04] via-[#fcc403] to-[#8a6502] shadow-[0_0_12px_rgba(252,196,3,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fffbea] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fcc403]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e9e4d6]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกหมวดเดิมพันจากบัญชีเดียวผ่านมือถือ การฝากถอนผ่านช่องทางบัญชีบริษัท และการตรวจรอบคำนวณกับเงื่อนไขโปรโมชั่นก่อนกดรับ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#4a3402] border-l-[#fcc403] bg-[#101010]/94 px-6 py-4 shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdda04] to-[#8a6502] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e9e4d6]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#4a3402] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcc403]" : "text-[#4a3402]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e9e4d6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#fcc403]/50 bg-[#050505] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdda04] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#4a3402] bg-[#101010]/94 p-5 shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fcc403]/70 hover:shadow-[0_15px_40px_rgba(252,196,3,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fcc403]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#fdda04]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#4a3402] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fcc403]/65 bg-gradient-to-br from-[#fdda04] via-[#fcc403] to-[#8a6502] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fffbea] transition-colors group-hover:text-[#fdda04]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e9e4d6]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fcc403]" : "text-[#4a3402]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fcc403]/45 bg-[#050505] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdda04] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcc403]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e9e4d6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
