---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บหวยล้วน ไม่มีสล็อต ไม่มีคาสิโน ไม่มีกีฬา ทุกแถวจึงอยู่ในกรอบที่
// บรีฟระบุไว้เอง: รัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ ในระบบเดียว, ตรวจสอบรอบ
// เปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการจากหน้าเดียว, อัตราจ่ายเลข 2 ตัว
// ที่ 100 และเลข 3 ตัวที่ 1,000, การตรวจผลหวยจากหน้าตรวจผล, การสมัครผ่านมือถือ
// 3 ขั้นตอน และแอดมินตลอด 24 ชั่วโมง ไม่มีข้อความไหนรับปากว่าจะถูกรางวัล อ้าง
// ใบอนุญาต หรือระบุวันออกรางวัล
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): แถบระบุตัวสมาชิกไล่จากทองสว่าง
// #fff6ae ลงทองหลัก #fcdc2b ไปหาทองลึก #a87d0c ตามวงแหวนทองของโลโก้ ส่วนดาวรับทอง
// หลักและป้ายแท็กรับแดง #cf1111 ตามคำว่า PARUAY ที่เป็นสีแดง กรอบการ์ดกับเส้นคั่น
// เป็นพื้นยก #143a1c บนพื้นการ์ด #0d2312 เหนือพื้นเพจ #07130a เนื้อความเป็น
// BRAND_TEXT #e8e4c6 — ชุดแดง-ทอง-เงินโครเมียมของแบรนด์ก่อนหน้า (#fadc64 #fdf3b4
// #e0b03a #f3f6fa #e01f26 #2a0b0e #1a0709 #120406 #f0ddc4) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ตามรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศจากหน้าเดียว",
    stars: 5,
    tag: "รวมทุกตลาดไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมรายการหวยหลายประเภทไว้ให้เลือกจริง ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ ตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการได้จากหน้าเดียว ไม่ต้องสลับไปมาหลายเว็บไซต์ เปิดจากมือถือก็ใช้งานได้ตามปกติ",
    avatar: "🎫",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เช็กอัตราจ่ายและรายละเอียดบิลก่อนยืนยันทุกครั้ง",
    stars: 5,
    tag: "2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000",
    content:
      "ชอบตรงที่ดูอัตราจ่ายของเลขแต่ละประเภทได้ก่อนยืนยันรายการ เลข 2 ตัวระบุไว้ที่ 100 และเลข 3 ตัวระบุไว้ที่ 1,000 ตามเงื่อนไขที่กำหนด ก่อนกดส่งยังเช็กตัวเลข ประเภทหวย รอบเวลา และรายละเอียดของบิลได้อีกครั้ง เลือกประเภทการแทงได้ตรงกับรูปแบบที่ต้องการมากขึ้น",
    avatar: "💯",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือแล้วตามผลหวยจากหน้าตรวจผล",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านมือถือเองได้ กรอกข้อมูลที่ระบบกำหนด ตรวจความถูกต้องของบัญชี แล้วยืนยัน สามขั้นตอนจบ พอเข้าระบบก็เลือกรายการที่กำลังเปิดรับได้เลย เวลาจะตามผลก็เลือกประเภทหวยกับรอบที่ต้องการจากหน้าตรวจผล ติดตรงไหนถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] shadow-[0_0_12px_rgba(252,220,43,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fffdf0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fcdc2b]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e8e4c6]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ ไว้ในระบบเดียว การตรวจสอบอัตราจ่ายกับรายละเอียดบิลก่อนยืนยัน และการสมัครผ่านมือถือกับการตรวจผลหวยจากหน้าตรวจผล
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#143a1c] border-l-[#fcdc2b] bg-[#0d2312]/94 px-6 py-4 shadow-[0_10px_30px_rgba(7,19,10,0.78)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fff6ae] to-[#fcdc2b] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e8e4c6]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#143a1c] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcdc2b]" : "text-[#143a1c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8e4c6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#143a1c] bg-[#07130a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff6ae] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#143a1c] bg-[#0d2312]/94 p-5 shadow-[0_10px_30px_rgba(7,19,10,0.78)] backdrop-blur-xl transition-all duration-300 hover:border-[#fcdc2b]/75 hover:shadow-[0_15px_40px_rgba(252,220,43,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#1fae1c]/26 blur-[60px] transition-all duration-300 group-hover:bg-[#fcdc2b]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#143a1c] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fcdc2b]/60 bg-gradient-to-br from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fffdf0] transition-colors group-hover:text-[#fff6ae]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e8e4c6]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fcdc2b]" : "text-[#143a1c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#cf1111]/65 bg-[#07130a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff6ae] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#cf1111]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e8e4c6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
