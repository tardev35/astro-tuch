---
// Slot brand — every row stays inside what the brief names: จุดรวมเกมสล็อตออนไลน์ที่
// เล่นผ่านมือถือและคอมพิวเตอร์, สล็อตธีมเอเชียและเกมโบนัส, สามเกมของ PG SOFT
// (Mahjong Ways 2, Fortune Tiger, Lucky Neko) พร้อมฟีเจอร์ตามที่ระบุ, การอ่าน
// Paytable ก่อนเล่น, ระบบฝากถอนและการจัดการบัญชีออนไลน์, โบนัส 0.8% ตามเงื่อนไขของ
// กิจกรรม และแอดมินที่ดูแลตลอด 24 ชั่วโมง. Nothing here promises a payout, an RTP
// figure, or a provider the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกใหม่ที่เริ่มจากเกมกติกาเข้าใจง่าย",
    role: "อ่าน Paytable และรายละเอียดฟีเจอร์ก่อนเลือกเดิมพัน",
    stars: 5,
    tag: "เริ่มจาก Fortune Tiger",
    content:
      "ยังไม่รู้ว่าจะเริ่มจากเกมไหน เลยลองดูจากรายการที่แนะนำไว้ก่อน แล้วเลือก Fortune Tiger เพราะใช้วงล้อ 3 รีล 3 แถว หน้าจอไม่ซับซ้อน ทำความเข้าใจกติกาได้ไม่ยาก ก่อนกดเล่นก็อ่าน Paytable กับรายละเอียดฟีเจอร์ แล้วเลือกจำนวนเดิมพันให้เหมาะกับงบของตัวเอง",
    avatar: "🐯",
  },
  {
    name: "สมาชิกที่ชอบสล็อตธีมเอเชียและระบบโบนัส",
    role: "เลือกเกมจากรูปแบบที่ชอบ ไม่ใช่จากคำกล่าวอ้างว่าแตกง่าย",
    stars: 5,
    tag: "Mahjong Ways 2 และ Lucky Neko",
    content:
      "ชอบสล็อตธีมเอเชียที่มีรายละเอียดให้ติดตามระหว่างเล่น เลยเล่น Mahjong Ways 2 ที่ใช้รูปแบบ 5 รีล มีทั้ง Wild และ Free Spins ส่วน Lucky Neko ก็มีระบบฟรีสปินและตัวคูณในตัวเกม ก่อนเลือกเดิมพันได้ตรวจรายละเอียดของเกมและระดับ RTP ที่ระบุไว้ก่อนทุกครั้ง",
    avatar: "🀄",
  },
  {
    name: "สมาชิกที่ติดต่อแอดมินตอนเครดิตยังไม่เข้า",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดธุรกรรมให้ตรวจสอบ",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "ฝากแล้วเครดิตยังไม่แสดง เลยเข้าไปตรวจสถานะรายการในบัญชีก่อน จากนั้นติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดธุรกรรม เจ้าหน้าที่ค้นหารายการได้เร็วขึ้น และยังอธิบายเรื่องโบนัส 0.8% ว่าให้ดูรอบคำนวณกับข้อกำหนดการถอนก่อนกดรับทุกครั้ง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก FAH999" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdeaf8] via-[#fb44b3] to-[#c2249b] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fdeaf8]">FAH999</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb44b3] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#c2249b]/45 bg-[#180226]/92 px-6 py-4 shadow-[0_10px_30px_rgba(194,36,155,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#c98cff] to-[#c2249b] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b48fd0] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#6b1fa8]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#c98cff]" : "text-[#2a0640]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e6cfe9]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#6b1fa8]/70 bg-[#180226]/92 p-6 text-left shadow-[0_10px_30px_rgba(13,1,20,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fb44b3]/70 hover:shadow-[0_15px_40px_rgba(194,36,155,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fb44b3] to-[#c2249b] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2a0640]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#c2249b]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#6b1fa8]/80 bg-[#0d0114] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdeaf8] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fb44b3]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#c98cff]" : "text-[#2a0640]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e6cfe9]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6b1fa8] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c2249b]/50 bg-gradient-to-br from-[#ffb3e2] via-[#fb44b3] to-[#6b1fa8] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fb44b3] transition-colors group-hover:text-[#fdeaf8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b48fd0] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
