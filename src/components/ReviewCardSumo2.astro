---
import { BRAND_NAME } from "../lib/brandProfile";

// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): รอบนี้บรีฟเป็นเว็บเล่นหวยออนไลน์เท่านั้น ไม่ใช่
// เว็บบอลแบบรอบก่อนและไม่ใช่เว็บสล็อตแบบรอบก่อนหน้านั้น ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจาก
// คำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิม กรอบที่บรีฟระบุไว้เองคือ:
// หวยลาว หวยฮานอยหลายรอบ หวยรัฐบาลไทย และหวยหุ้น ในบัญชีเดียว · เลือกเลข ส่งโพย
// ตรวจสอบรายการ และเช็คผลหลังประกาศผลของแต่ละรอบ · เวลาเปิดรับ เวลาปิดรับ และอัตราจ่าย
// ของแต่ละรายการ · อัตรา 2 ตัว จ่าย 100 บาท กับ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่เข้า
// เงื่อนไข · สมัครผ่านมือถือ 3 ขั้นตอน · ฝากถอนผ่านวอลเลทและธนาคารที่ระบบรองรับ ·
// ติดต่อแอดมินได้ตลอด 24 ชั่วโมง · และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามพูดถึงสินค้าหมวดอื่นนอกจากหวย (สล็อต ฟรีสปิน บอล คาสิโน บาคาร่า ฯลฯ) ห้ามอ้างชื่อ
// ธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ จำนวนสมาชิก ปีที่ก่อตั้ง หรือรอบเวลา
// ออกรางวัลจริง — บรีฟ หวยเฮง24 ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัวเท่าที่บรีฟระบุ
// คือ 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · สมัคร 3 ขั้นตอน · 24 ชั่วโมง และบรีฟ
// เป็นโทน hedged ทุกย่อหน้า จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุด หวยเฮง24: ทองแบรนด์ #e0a52a เป็นตัวระบุตัวตน (สันนำหน้าหัวข้อ ป้ายสมาชิก ดาว)
// ไล่จากทองอ่อน #fdea83 → ทองแบรนด์ #e0a52a → ทองเข้ม #a46304 ตามคำว่า "เฮง24"
// ที่เป็นทองไล่เฉด ส่วนแดงแบรนด์ #8b0302 / แดงสว่าง #c01616 เป็นแอ็กเซนต์รอง ใช้กับจุด
// สถานะและแสงตอน hover ตามคำว่า "หวย" ที่เป็นแดงเลือดนก ผิวการ์ดเป็นแดงเข้ม #2e0707
// กรอบและเส้นคั่นแดงกลาง #720202 บนพื้นเพจแดงเกือบดำ #1a0505 เนื้อความและชื่อสมาชิก
// #f6e6cf (BRAND_TEXT) ตัวรองใช้สีเนื้อความลดความทึบแทนการตั้งเฉดใหม่ — ชุดน้ำเงินรอยัล-
// ทองของ BRAVO168 (#1558c4 #0e3f8f #2f86f0 #072247 #f4cb69 #ffe39a #c9922e #96690f
// #04142f #02081a #e8f1ff #a8bedd #dbe5f5) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกหวยลาว ฮานอย รัฐบาลไทย และหวยหุ้นจากบัญชีเดียว",
    stars: 5,
    tag: "หวยลาว · ฮานอย · รัฐบาลไทย · หวยหุ้น",
    content:
      "ที่ใช้ต่อเพราะรายการหวยที่สนใจรวมอยู่ในบัญชีเดียว ทั้งหวยลาว หวยฮานอยที่มีหลายรอบ หวยรัฐบาลไทยตามกำหนดออกรางวัล และหวยหุ้นตามตลาดที่ระบบรองรับ ไม่ต้องสลับหลายเว็บไซต์ เข้าใช้งานผ่านมือถือก็เห็นรายการชุดเดียวกัน ก่อนเลือกเลขจะเปิดดูเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการจากหน้าเดียวก่อนทุกครั้ง เพราะรอบที่เปิดรับจริงในแต่ละวันไม่ได้เหมือนกันทุกประเภท",
    avatar: "🎟️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจอัตราจ่ายก่อนส่งโพย แล้วกลับมาเช็คผลหลังประกาศผล",
    stars: 5,
    tag: "อัตราจ่าย · ส่งโพย · เช็คผล",
    content:
      "ขั้นตอนที่ทำทุกรอบคือเลือกเลข ส่งโพย แล้วตรวจสอบชื่อหวย รอบเวลา เลขที่เลือก และยอดเดิมพันอีกครั้งให้ถูกต้อง อัตรา 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ใช้กับรายการที่เข้าเงื่อนไข จึงไม่ถือว่าใช้เหมือนกันทุกหวย และดูตัวเลขที่แสดงในหน้าส่งโพยเป็นหลักก่อนยืนยัน พอประกาศผลแล้วก็กลับมาเช็คผลและสถานะโพยจากบัญชีสมาชิกได้ แต่ยังดูผลจากแหล่งประกาศอย่างเป็นทางการของหวยแต่ละประเภทประกอบด้วย",
    avatar: "🔢",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ฝากถอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชีสมาชิก จากนั้นเลือกหวย รอบ และเลขที่ต้องการได้เลย หลังจากนั้นใช้บัญชีเดียวตรวจโพย เช็คผล และจัดการธุรกรรมผ่านวอลเลทหรือธนาคารที่เว็บไซต์เปิดรองรับ ตอนที่ส่งโพยไม่สำเร็จและเครดิตไม่แสดง ติดต่อแอดมินได้ตลอด 24 ชั่วโมง โดยแจ้งชื่อหวย รอบเวลา และรายละเอียดรายการไป ส่วนเรื่องฝากถอนก็เก็บเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้จนตรวจสอบเสร็จ และไม่ส่งรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#a46304] shadow-[0_0_12px_rgba(224,165,42,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f6e6cf] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e0a52a]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f6e6cf]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกหวยลาว ฮานอย รัฐบาลไทย และหวยหุ้นจากบัญชีเดียว การตรวจเวลาปิดรับกับอัตราจ่ายก่อนส่งโพยแล้วกลับมาเช็คผล และการสมัครผ่านมือถือ 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#720202] border-l-[#e0a52a] bg-[#2e0707]/94 px-6 py-4 shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdea83] to-[#a46304] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f6e6cf]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#720202] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e0a52a]" : "text-[#720202]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e6cf]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#e0a52a]/50 bg-[#1a0505] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e0a52a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#720202] bg-[#2e0707]/94 p-5 shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#e0a52a]/70 hover:shadow-[0_15px_40px_rgba(224,165,42,0.30)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e0a52a]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#c01616]/30"
          />

          <div class="flex items-center gap-4 border-b border-[#720202] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e0a52a]/65 bg-gradient-to-br from-[#fdea83] via-[#e0a52a] to-[#a46304] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f6e6cf] transition-colors group-hover:text-[#fdea83]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f6e6cf]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e0a52a]" : "text-[#720202]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e0a52a]/45 bg-[#1a0505] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e0a52a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c01616]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e6cf]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
