---
// Slot brand — every row stays inside what the brief names: ทางเข้าเล่นสล็อตสำรอง
// เมื่อช่องทางหลักใช้งานไม่ได้, การตรวจลิงก์จากช่องทางที่ผู้ให้บริการประกาศ, การสมัคร
// ยูสเซอร์ใหม่หรือใช้บัญชีเดิมตามที่ระบบกำหนด, ฝากถอนอัตโนมัติ, คอมมิชชั่นแนะนำเพื่อน
// 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, และแอดมินที่ดูแลตลอด 24 ชั่วโมง. Nothing here
// promises a payout, an RTP figure, or a provider the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่ใช้ทางเข้าสำรองตอนช่องทางเดิมเข้าไม่ได้",
    role: "ตรวจลิงก์จากช่องทางของผู้ให้บริการก่อนกรอกข้อมูล",
    stars: 5,
    tag: "ทางเข้าสำรองใช้งานได้จริง",
    content:
      "ตอนช่องทางเดิมเข้าไม่ได้ ก็ตรวจทางเข้าสำรองจากช่องทางที่ผู้ให้บริการประกาศไว้ก่อน แล้วเปิดผ่านเบราว์เซอร์บนมือถือได้เลยโดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ก่อนกรอกข้อมูล Login ยังได้เช็กชื่อเว็บไซต์ให้ตรงอีกรอบ จึงเลี่ยงเว็บไซต์เลียนแบบได้",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่สมัครยูสเซอร์ใหม่ตามที่ระบบกำหนด",
    role: "ถามเจ้าหน้าที่ก่อนว่าบัญชีเดิมยังใช้งานต่อได้หรือไม่",
    stars: 5,
    tag: "สมัครยูสใหม่ ฝากถอนออโต้",
    content:
      "รอบนี้ระบบกำหนดให้เปิดบัญชีใหม่ จึงกรอกข้อมูลตามที่หน้าสมัครร้องขอ แล้ว Login เข้าไปตรวจช่องทางฝากเครดิตที่เปิดให้บริการก่อนทำรายการ ระหว่างนั้นได้สอบถามเจ้าหน้าที่ว่าบัญชีเดิมใช้ต่อได้ไหม จึงไม่ต้องสมัครบัญชีซ้ำโดยไม่จำเป็น",
    avatar: "📝",
  },
  {
    name: "สมาชิกที่ติดต่อแอดมินตอนเครดิตยังไม่เข้า",
    role: "แจ้งรายละเอียดและเวลาที่ทำรายการให้เจ้าหน้าที่ตรวจสอบ",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "สมัครแล้วเครดิตยังไม่ขึ้น จึงแจ้งรายละเอียดและเวลาที่ทำรายการให้แอดมินช่วยตรวจสอบ ทีมงานแนะนำขั้นตอนต่อจนจบและย้ำว่าคอมมิชชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% คำนวณตามรอบและเงื่อนไข พร้อมเตือนว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้ใคร",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ขวัญใจ168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eafcff] via-[#4bdbee] to-[#1687c9] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#eafcff]">ขวัญใจ168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#4bdbee] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#1687c9]/45 bg-[#02142b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(22,135,201,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd76a] to-[#1687c9] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8fb6cc] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0e4f7a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd76a]" : "text-[#041d38]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cfe7f2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#0e4f7a]/70 bg-[#02142b]/92 p-6 text-left shadow-[0_10px_30px_rgba(1,5,11,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#4bdbee]/70 hover:shadow-[0_15px_40px_rgba(22,135,201,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#4bdbee] to-[#1687c9] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#041d38]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#1687c9]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0e4f7a]/80 bg-[#01050b] px-3 py-1 text-[10px] font-bold tracking-widest text-[#eafcff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#4bdbee]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd76a]" : "text-[#041d38]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#cfe7f2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0e4f7a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#1687c9]/50 bg-gradient-to-br from-[#9df1ff] via-[#4bdbee] to-[#0e4f7a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#4bdbee] transition-colors group-hover:text-[#eafcff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8fb6cc] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
