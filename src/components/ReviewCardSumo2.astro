---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นแบรนด์รวมเกมเดิมพันหลายประเภท ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง:
// บาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยที่รวมไว้ในเว็บเดียว, เมนูที่แบ่งหมวดชัดเจน
// กับการเลือกดูเกมตามประเภท ตรวจสอบรายละเอียด และสลับหมวดได้จากบัญชีเดียว,
// โบนัสแนะนำเพื่อน 0.8% กับโบนัสคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบคำนวณ และ
// เงื่อนไขก่อนกดรับ, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน, การรองรับมือถือและ
// คอมพิวเตอร์ และเจ้าหน้าที่ผ่าน LINE OFFICIAL ตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้าง
// ชื่อค่ายเกม ชื่อเกม ค่า RTP ช่องทางฝากถอน ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): แถบระบุตัวสมาชิกไล่จากทองสว่าง #fbd564
// ลงทองแบรนด์ #e0b429 ไปหาทองลึก #7a5407 ตามตัว U กับเลข 33 บนโลโก้ที่เป็นทองนูน
// ส่วนดาวรับทองสว่างและป้ายแท็กรับเงินโครเมียม #dfe4ec ตามคำว่า WIN ที่เป็นเงิน
// กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #26200e บนผิวการ์ด #161106 เหนือพื้นเพจ
// #080602 เนื้อความเป็น BRAND_TEXT #ece6d8 และตัวเน้นเป็น #fff8e6 — ชุดแดง-ดำ-เงิน
// โครเมียมของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #e2e8ef #16090a #26100f
// #080506 #e8e3e1 #fff6f5) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยจากบัญชีเดียว",
    stars: 5,
    tag: "รวมครบไว้ให้ในเว็บเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมเดิมพันหลายประเภทไว้ในระบบเดียวจริง ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย เมนูแบ่งหมวดไว้ชัดเจนจนเลือกเกมที่สนใจได้เร็ว เปิดจากมือถือหรือคอมพิวเตอร์ก็เข้าใช้งานจากบัญชีเดียวได้เหมือนกัน ไม่ต้องสลับใช้งานหลายเว็บไซต์เหมือนเมื่อก่อน",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจรายละเอียดและสลับหมวดที่สนใจก่อนเข้าเล่น",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ชอบตรงที่เลือกดูเกมตามประเภท ตรวจสอบรายละเอียด แล้วสลับไปยังหมวดที่สนใจได้ง่ายจากหน้าเดียว ฝั่งโปรโมชั่นก็มีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งระบบแสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขไว้ให้ตรวจก่อนกดรับสิทธิ์ทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามผ่าน LINE OFFICIAL",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้แค่ 3 ขั้นตอนตามที่เว็บไซต์บอกไว้ พอยืนยันบัญชีเสร็จก็เข้าสู่ระบบเลือกเกมกับดูโปรโมชั่นที่เปิดให้รับได้ทันที ติดตรงไหนเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี ก็ถามเจ้าหน้าที่ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💬",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbd564] via-[#e0b429] to-[#7a5407] shadow-[0_0_12px_rgba(224,180,41,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff8e6] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e0b429]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ece6d8]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวยไว้ในเว็บเดียว การเลือกดูเกมตามประเภทกับสลับหมวดจากบัญชีเดียว และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#26200e] border-l-[#e0b429] bg-[#161106]/94 px-6 py-4 shadow-[0_10px_30px_rgba(8,6,2,0.82)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#dfe4ec] to-[#e0b429] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ece6d8]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#26200e] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbd564]" : "text-[#26200e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece6d8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#26200e] bg-[#080602] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfe4ec] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#26200e] bg-[#161106]/94 p-5 shadow-[0_10px_30px_rgba(8,6,2,0.82)] backdrop-blur-xl transition-all duration-300 hover:border-[#e0b429]/70 hover:shadow-[0_15px_40px_rgba(224,180,41,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e0b429]/24 blur-[60px] transition-all duration-300 group-hover:bg-[#dfe4ec]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#26200e] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e0b429]/65 bg-gradient-to-br from-[#fbd564] via-[#e0b429] to-[#7a5407] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff8e6] transition-colors group-hover:text-[#dfe4ec]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ece6d8]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fbd564]" : "text-[#26200e]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#dfe4ec]/40 bg-[#080602] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfe4ec] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e0b429]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ece6d8]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
