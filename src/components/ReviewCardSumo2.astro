---
// VAK88 is a slot brand — every row stays inside what the brief states:
// เกมสล็อตเว็บตรงเจ้าแรกที่ให้บริการผ่านช่องทางเข้าเล่นหลักอย่างเป็นทางการโดยไม่
// ต้องผ่านตัวแทนหรือเอเย่นต์, เกมจากค่ายยักษ์ใหญ่ระดับโลกที่ได้รับอนุญาตจากลิขสิทธิ์
// แท้ 100% (Certified API), กราฟิกคมชัดระดับ Cinematic Lighting, อัตราการชนะ (RTP)
// มาตรฐานสากลที่ไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ, การไม่ล็อคยูสเซอร์ทั้งลูกค้าเก่า
// และใหม่, โบนัสแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน, โบนัสคืนยอดเสีย 0.3%
// ในทุกรอบบิล, ระบบสมัครสมาชิกอัตโนมัติ 3 ขั้นตอน, ระบบฝาก-ถอนอัตโนมัติภายใน 3-5
// วินาทีที่ไม่มีขั้นต่ำ, และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// Nothing here promises a payout or a win rate. Written testimonial text only —
// no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Metallic gold carries
// the score/quote furniture, phoenix crimson carries the identity rail, so both
// halves of the VAK88 artwork — the gold wordmark and the crimson phoenix — are
// doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "เข้าเล่นผ่านช่องทางหลักโดยไม่ผ่านเอเย่นต์",
    stars: 5,
    tag: "เว็บตรงเจ้าแรก · Certified API",
    content:
      "สมัครแล้วเข้าเล่นผ่านช่องทางเข้าเล่นหลักของ VAK88 ได้โดยตรง ไม่ต้องผ่านตัวแทนหรือเอเย่นต์ให้เสียเวลา เกมสล็อตที่เปิดให้เล่นมาจากค่ายยักษ์ใหญ่ระดับโลกที่ได้รับอนุญาตจากลิขสิทธิ์แท้ 100% ภาพกราฟิกคมชัดและแสงเงาระดับ Cinematic Lighting เห็นความต่างชัดเจนตั้งแต่สปินแรก",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ยูสเซอร์เก่าที่ยังได้สิทธิ์เท่าผู้เล่นใหม่",
    stars: 5,
    tag: "ไม่ล็อคยูส · RTP มาตรฐานสากล",
    content:
      "อยู่กับเว็บมานานแต่ยังได้โปรโมชั่นเท่ากับผู้เล่นใหม่ เพราะ VAK88 ไม่มีการล็อคยูสเซอร์ทั้งลูกค้าเก่าและลูกค้าใหม่ อัตราการชนะ (RTP) ก็เป็นไปตามมาตรฐานสากลและไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ ทำให้ตัดสินใจลงเดิมพันได้โดยไม่ต้องกังวลเรื่องความโปร่งใส",
    avatar: "🔓",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ทำรายการเองและเช็กสิทธิ์โบนัสจากบัญชีสมาชิก",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "สมัครจบใน 3 ขั้นตอน ทั้งยืนยันเบอร์ด้วย OTP ผูกบัญชีธนาคาร แล้วตั้งรหัสผ่านเข้าหน้า Portal หลัก ฝาก-ถอนอัตโนมัติประมวลผลไวภายใน 3-5 วินาที รองรับทุกธนาคารชั้นนำและไม่มีขั้นต่ำ ส่วนโปรโมชั่นก็ล็อคอินเข้าไปดูสิทธิ์ได้เอง ทั้งค่าคอมมิชชั่นแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน และคืนยอดเสีย 0.3% ในทุกรอบบิล ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก VAK88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd873] via-[#e6b23c] to-[#cf2027] shadow-[0_0_12px_rgba(230,178,60,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff4dd] uppercase sm:text-3xl">
        เสียงจากสมาชิก VAK<span class="text-[#e6b23c]">88</span>
      </p>
      <span class="text-xs tracking-wide text-[#ded8ca]/60">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเข้าเล่นผ่านช่องทางหลักโดยไม่ผ่านเอเย่นต์ การรับสิทธิ์โปรโมชั่นแบบไม่ล็อคยูสเซอร์ และการทำรายการฝาก-ถอนอัตโนมัติด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#8a5f14] border-l-[#e6b23c] bg-[#0b1020]/92 px-6 py-4 shadow-[0_10px_30px_rgba(3,6,14,0.65)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fff4dd] to-[#e6b23c] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ded8ca]/60">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#8a5f14] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e6b23c]" : "text-[#8a5f14]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ded8ca]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#cf2027]/50 bg-[#060913] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ee3a34] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#8a5f14] bg-[#0b1020]/92 p-5 shadow-[0_10px_30px_rgba(3,6,14,0.65)] backdrop-blur-xl transition-all duration-300 hover:border-[#e6b23c]/70 hover:shadow-[0_15px_40px_rgba(230,178,60,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e6b23c]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#e6b23c]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#8a5f14] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#cf2027]/50 bg-gradient-to-br from-[#ee3a34] via-[#cf2027] to-[#6b0d11] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e6b23c] transition-colors group-hover:text-[#fff4dd]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ded8ca]/60">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e6b23c]" : "text-[#8a5f14]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#8a5f14]/60 bg-[#060913] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd873] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6b23c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ded8ca]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
