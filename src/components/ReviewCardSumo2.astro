---
import { BRAND_NAME } from "../lib/brandProfile";

// หวยดีใจ (2026-10-04): บรีฟรอบนี้เป็น **เว็บรับแทงหวยออนไลน์ล้วน** ทุกแถวจึงถูก
// เขียนใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคของ
// รอบ หวย24 ก่อนหน้า ซึ่งเปิดรายการหวยแคบกว่า (ลาว/ฮานอย/รัฐบาลไทย) และใช้คำ
// โฆษณาคนละชุด (รับไม่อั้น · จ่ายเต็มทุกโพย · เลขดัง · ประวัติโพย)
//
// กรอบที่บรีฟระบุไว้เองคือ: รวมรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส.
// ไว้ในบัญชีเดียว พร้อมเลือกเลข ตรวจสอบรอบ อัตราจ่าย และส่งโพยผ่านมือถือ · ดู
// แนวทางและสถิติประกอบการเลือกเลขในแต่ละรอบ · รายการที่เข้าเงื่อนไขมีเรท 2 ตัว
// จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท · สมัครผ่านมือถือ 3 ขั้นตอนแล้ว Login ·
// ติดตามผลรางวัลและประวัติรายการ · แอดมิน 24 ชั่วโมง · ไม่ส่งรหัสผ่าน PIN หรือ OTP
//
// คำของแบรนด์คาสิโนรอบก่อนๆ ถูกถอดออกทั้งชุด (สล็อต บาคาร่า บอล/เดิมพันฟุตบอล
// หมวดเกม ค่ายเกม คาสิโนสด RTP ความผันผวน คืนยอดเสีย แนะนำเพื่อน เว็บตรง) —
// ไม่เหลือแม้คำเดียว
//
// ห้ามใส่ชื่อตลาดหวยอื่นนอกจากห้ารายการของบรีฟ (ห้ามเติม ลาวพัฒนา หวยหุ้น ยี่กี)
// เวลาออกรางวัลของแต่ละรอบ ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้คือ 2 ตัว · 3 ตัว ·
// 100 · 1,000 · 3 ขั้นตอน · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคง
// ประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 แดงแบรนด์ + เงินโครเมียม บนดำอมแดง): สีหลักคือ **แดง**
// และสีคู่คือ **เงินโครเมียม** ไม่ใช่ทองแบบ หวย24 — แดงแบรนด์ #dc0409 เป็นตัวระบุ
// ตัวตนของบล็อกนี้ สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่แดงสว่าง #f5363d → แดงแบรนด์ →
// แดงลึก #8e0206 บนหมึกสว่าง #edeaf0 (พื้นแดงเข้มต้องใช้หมึกสว่างเสมอ ตามกฎ
// คอนทราสต์ §2) คะแนนเฉลี่ยไล่เงินสว่าง #eef0f4 → เงินกลาง #c3c7d1 ตามคำว่า "หวย"
// ที่เป็นโครเมียมในโลโก้ ส่วนทอง #f3c54e เป็นสีรองและถูกใช้เฉพาะจุดที่ควรเป็นทอง
// จริงๆ คือชื่อแบรนด์กับดาวที่ติด (มงกุฎทองเหนือโลโก้) ออรามุมขวาบนเป็นเงินโครเมียม
// ตัดกับตัวตนสีแดงของการ์ด ดาวที่ยังไม่ติดใช้แดงดำ #4b0205 กรอบการ์ดเป็นเส้นไรผม
// #4b0205 ชิปตกลงไปที่พื้นลึกสุด #0d0407 เนื้อความและชื่อสมาชิก #edeaf0
// (= BRAND_TEXT) ตัวรองใช้ #edeaf0 แบบลดความทึบ กับเงินหม่น #8d93a1 สำหรับ caption
// glow เป็น rgba(220,4,9,…) / rgba(195,199,209,…)
//
// ชุดแดง + ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#d20a0a #f5c33b #ffd45e #ff5c5c
// #7a0505 #3d0a0a #170707 #0a0303 #fff1e8 #f7e2d6 rgba(210,10,10,…)
// rgba(245,195,59,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ติดตามรัฐบาลไทย ลาว ฮานอย ออมสิน และ ธ.ก.ส. จากบัญชีเดียว",
    stars: 5,
    tag: "รัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน · หวย ธ.ก.ส.",
    content:
      "ที่ใช้ต่อเพราะรวมหวยหลายประเภทไว้ให้เลือกตามรอบในบัญชีเดียว ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย รวมถึงหวยออมสินและหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ เปิดมาก็ตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลขที่ต้องการ และยอดเดิมพันได้ก่อนส่งโพย ทำให้ติดตามหลายรายการได้โดยไม่ต้องเปลี่ยนบัญชีไปมา ส่วนแนวทางและสถิติย้อนหลังก็ดูประกอบการเลือกเลขได้ แต่ต้องเข้าใจตรงกันว่าเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้",
    avatar: "🗓️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูอัตราจ่ายและวงเงินที่ระบบเปิดรับก่อนยืนยันโพย",
    stars: 5,
    tag: "อัตราจ่าย · 2 ตัว จ่าย 100 · 3 ตัว จ่าย 1,000 · ไม่อั้นจ่าย",
    content:
      "ชอบที่ตรวจสอบเรทของหวยแต่ละรายการได้ก่อนส่งโพย รายการที่เข้าเงื่อนไขขึ้นชัดว่าเป็นเรท 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท พร้อมดูเลข ยอดเดิมพัน และสถานะรายการได้ครบถ้วน พอโพยได้รับการยืนยันแล้วก็มีประวัติรายการให้กลับมาตรวจสอบได้ ข้อที่อยากให้อ่านกันก่อนคือหวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยันรายการ และคำว่าไม่อั้นจ่ายก็ไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด ถ้าเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยันเสมอ",
    avatar: "🧾",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · Login · ประวัติรายการ · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด จากนั้นยืนยันข้อมูลและ Login เข้าบัญชีสมาชิก ก่อนเลือกประเภทหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายก่อนส่งโพย หลังเปิดบัญชีก็ใช้ระบบเดียวติดตามรัฐบาลไทย ลาว ฮานอย ออมสิน ธ.ก.ส. รวมถึงแนวทางและผลหวยตามรายการที่เปิดให้บริการได้ ตอนส่งโพยไม่สำเร็จหรือตรวจสอบผลไม่ได้ ก็ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องโพยเตรียมชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการไว้ ส่วนเรื่องธุรกรรมก็เก็บเวลา จำนวนเงิน และหลักฐานไว้จนกว่าจะตรวจสอบเรียบร้อย และไม่ควรส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5363d] via-[#dc0409] to-[#8e0206] shadow-[0_0_12px_rgba(220,4,9,0.6)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#edeaf0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f3c54e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#8d93a1]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. จากบัญชีเดียว การตรวจอัตราจ่ายกับวงเงินที่ระบบเปิดรับก่อนส่งโพย และการสมัคร 3
        ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#4b0205] border-l-[#dc0409] bg-[#17080c]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#eef0f4] to-[#c3c7d1] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#8d93a1]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#4b0205] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f3c54e]" : "text-[#4b0205]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#edeaf0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#c3c7d1]/40 bg-[#0d0407] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c3c7d1] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#4b0205] bg-[#17080c]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-300 hover:border-[#dc0409]/75 hover:shadow-[0_15px_40px_rgba(220,4,9,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c3c7d1]/16 blur-[60px] transition-all duration-300 group-hover:bg-[#eef0f4]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#4b0205] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f5363d]/65 bg-gradient-to-br from-[#f5363d] via-[#dc0409] to-[#8e0206] text-2xl text-[#edeaf0] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#edeaf0] transition-colors group-hover:text-[#f3c54e]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#8d93a1]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f3c54e]" : "text-[#4b0205]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c3c7d1]/40 bg-[#0d0407] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c3c7d1] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#dc0409]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#edeaf0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
