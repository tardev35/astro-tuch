---
// NEXT55 is a คาสิโนออนไลน์เว็บตรงครบวงจร — every row stays inside what the
// brief states: เว็บตรง 100% ไม่ผ่านเอเย่นต์, ไม่มีขั้นต่ำฝาก-ถอน เริ่มต้น 1 บาท,
// บาคาร่าและคาสิโนสดระดับ Full HD จากคาสิโนชั้นนำ, สล็อตลิขสิทธิ์แท้, เกมยิงปลา,
// หวยรัฐบาล ลาว ฮานอย ที่จ่ายเต็มไม่มีเลขอั้น, แทงบอลทุกลีกค่าน้ำดี, แนะนำเพื่อน
// 0.8%, คืนยอดเสีย 0.3%, ระบบฝาก-ถอนออโต้ภายใน 5 วินาที ที่รองรับทุกธนาคารและ
// TrueMoney Wallet, การเข้าใช้งานได้ทุกอุปกรณ์ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอป,
// และแอดมินผ่าน Line Official ตลอด 24 ชั่วโมง.
// Nothing here promises a payout or a win rate.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Crimson carries the
// score/quote furniture and brushed silver carries the identity rail, so the
// logo's graphite-and-red pairing is doing work on both halves.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ทุน 1 บาทที่ฝากเข้ามาลองโดยไม่มีขั้นต่ำ",
    stars: 5,
    tag: "ไม่มีขั้นต่ำฝาก-ถอน",
    content:
      "ที่ตัดสินใจสมัครเพราะไม่มีขั้นต่ำในการฝาก-ถอนจริงตามที่ประกาศไว้ ทุน 1 บาทก็ฝากเข้ามาเล่นได้ ไม่ต้องเติมก้อนใหญ่ก่อนถึงจะเริ่มได้ ฝากผ่านธนาคารก็ได้ ผ่าน TrueMoney Wallet ก็ได้ ระบบออโต้ทำรายการเสร็จภายใน 5 วินาที",
    avatar: "🪙",
  },
  {
    name: "คุณศิริพร ว.",
    role: "เล่นครบทั้งห้าหมวดเกมจากบัญชีเดียว",
    stars: 5,
    tag: "ครบวงจรในเว็บเดียว",
    content:
      "ชอบที่ NEXT55 รวมทุกอย่างไว้ที่เดียวแบบ One-Stop Service โต๊ะบาคาร่าและคาสิโนสดถ่ายทอดสดจากคาสิโนชั้นนำ ภาพคมชัดระดับ Full HD สล็อตเป็นลิขสิทธิ์แท้ ฟีเจอร์แน่น มีเกมยิงปลาที่เล่นง่ายตายไว หวยมีทั้งรัฐบาล ลาว และฮานอย จ่ายเต็มไม่มีเลขอั้น ส่วนคอกีฬาก็แทงบอลได้ทุกลีกดัง",
    avatar: "🃏",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ทำรายการเองและกดรับสิทธิ์โปรโมชั่นผ่านหน้าเว็บ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "เป็นเว็บตรง 100% ไม่ผ่านเอเย่นต์ ทำให้มั่นใจเรื่องความปลอดภัยของข้อมูล ฝาก-ถอนเป็นระบบออโต้ทั้งหมด รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet เสร็จภายใน 5 วินาที โปรโมชั่นกดรับได้ทุกวัน ทั้งคอมมิชชั่นแนะนำเพื่อน 0.8% จากทุกยอดการเล่นของเพื่อน และคืนยอดเสีย 0.3% ในทุกยอดการเล่น เข้าเล่นผ่านมือถือทั้ง iOS และ Android แท็บเล็ต หรือพีซี ผ่านเบราว์เซอร์ได้เลยโดยไม่ต้องโหลดแอปพลิเคชัน ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก NEXT55" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] shadow-[0_0_12px_rgba(205,20,55,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#e7eaef] uppercase sm:text-3xl">
        เสียงจากสมาชิก NEXT<span class="text-[#f0435f]">55</span>
      </p>
      <span class="text-xs tracking-wide text-[#c3c8d1]/60">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการฝากแบบไม่มีขั้นต่ำด้วยทุน 1 บาท การเล่นครบทั้งห้าหมวดเกมจากบัญชีเดียว และการทำรายการฝาก-ถอนออโต้ด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#3a3d45] border-l-[#cd1437] bg-[#17181c]/92 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffb3bf] to-[#f0435f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#c3c8d1]/60">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#3a3d45] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f0435f]" : "text-[#3a3d45]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c3c8d1]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#3a3d45] bg-[#0c0d10] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffb3bf] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#3a3d45] bg-[#17181c]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-300 hover:border-[#cd1437]/70 hover:shadow-[0_15px_40px_rgba(205,20,55,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#cd1437]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#f0435f]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#3a3d45] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#8d939e]/60 bg-gradient-to-br from-[#e7eaef] via-[#c3c8d1] to-[#8d939e] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ffb3bf] transition-colors group-hover:text-[#e7eaef]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#c3c8d1]/60">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f0435f]" : "text-[#3a3d45]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#cd1437]/60 bg-[#0c0d10] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffb3bf] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#cd1437]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#d5dae2]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
