---
import { BRAND_NAME } from "../lib/brandProfile";

// NAZA168 (2026-10-10): บรีฟรอบนี้เป็น **เว็บสล็อตนาซ่า ส่งตรงจากเมกา ฐานเกมหลัก
// 100%** ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจากคำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace
// ชื่อแบรนด์ทับประโยคเดิมของ SUPERSLOTCLUB ที่พูดถึง "คลับคนเล่นสล็อตซุปเปอร์ /
// กลุ่มลับคนดังวงการสล็อตออนไลน์ / ดับเบิ้ลโบนัส" หรือของ KINGKONG555 ก่อนหน้านั้นที่
// พูดถึง "ฐานเว็บสล็อตหลัก / เบทต่ำ 1 บาท / ช่วงเดิมพัน" — คำชุดนั้นเป็นของบรีฟรอบก่อน
// ไม่ใช่ของบรีฟนี้ และ brand-spec §6 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: เว็บสล็อตนาซ่าที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ภายใต้
// แนวคิดฐานเกมหลักจากเมกา · รวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งสล็อต
// คลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมยอดนิยมจากค่ายที่เปิดให้บริการ · รวมค่ายฮิต
// ระดับประเทศ ตั้งแต่เกมวงล้อทั่วไปไปจนถึงสล็อตที่มีฟีเจอร์โบนัส · ระบบจัดหมวดหมู่เกม
// ช่วยให้ค้นหาค่ายที่สนใจได้ง่าย · ตรวจสอบยอดเดิมพัน ตารางจ่าย และรายละเอียดของแต่ละ
// เกมก่อนเริ่มเล่น · ค้นหาเกม ตรวจสอบเครดิต ติดตามโปรโมชั่น · คืนยอดเสีย 0.3% ตามรอบ
// ประจำวัน เข้ายูสอัตโนมัติ · แนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ผ่านลิงก์แนะนำ ·
// ฝากถอนเข้าบัญชีบริษัทโดยตรง ไม่ผ่านม้า ตรวจชื่อบัญชีปลายทางก่อนยืนยันรายการ ·
// แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม ชื่อผู้พัฒนาเกม เลขใบอนุญาต ชื่อผู้ให้บริการ ชื่อนิติบุคคล ชื่อ
// ธนาคาร ค่า RTP เป็นตัวเลข ยอดฝากขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้
// ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัว: 0.3% · 0.8% · 24 ชั่วโมง · 100%
// (ไม่มี "2026" ซึ่งเป็นตัวเลขพาดหัวของ FLASH877 รอบก่อน) และบรีฟเป็นโทน hedged ทุก
// ย่อหน้า จึงคงประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว (การระบุว่าส่งตรงจากอเมริกา
// และเป็นฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ · โปรโมชั่นที่ระบุ
// ว่าครบทุกค่ายควรตรวจสอบรายชื่อเกมที่ร่วมรายการ · คำว่าไม่จำกัดควรระบุให้ชัด ·
// ชื่อบัญชีบริษัทอย่างเดียวไม่สามารถรับประกันว่าธุรกรรมจะไม่มีความเสี่ยง)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม): สีหลักคือ
// **ทองอวกาศ** #fbc134 สีรองคือ **เงินโครเมียม** #cfd6e3 บนผิวการ์ดยก #4e3406
// ไม่ใช่ผิวแดงแบบรอบ FLASH877 — สันนำหน้าหัวข้อไล่โครเมียมสว่าง #eef2f8 → ทองสว่าง
// #ffe87a → ทองแบรนด์ #fbc134 ซึ่งเป็นลำดับเดียวกับเหรียญตรา (หมวกเงิน → ขอบทอง)
// ชื่อแบรนด์ในหัวข้อใช้ทองแบรนด์ #fbc134 ซึ่ง §2 ให้ถือตัวอักษรได้จริง (7.0:1 บนผิวยก)
// ขณะที่ #96690a ใช้ไม่ได้เลย (3.7:1)
// ป้ายอวาตาร์เป็นแผ่นทองทึบ ไล่ทองสว่าง #ffe87a → ทองแบรนด์ #fbc134 → ทองกลางเข้ม
// #cf9a18 บนหมึก #231500 (7.0:1 ที่ปลายเข้มสุด — ห้ามใช้ #96690a เป็นปลายเข้มของแผ่น
// ที่มีหมึก และห้ามพลิกแผ่นทองไปใช้ตัวอักษรสว่าง)
// คะแนนเฉลี่ยไล่โครเมียมสว่าง → ทองแบรนด์ ดาวที่ติดเป็นทองแบรนด์ ดาวที่ยังไม่ติดเป็น
// เงินลึก #3f4859 จุดกะพริบบนป้ายใช้โครเมียม #cfd6e3 ออรามุมขวาบนเป็นโครเมียมโปร่ง
// (เป็นจุดเดียวในหน้าที่ออรารีวิวเป็นเงิน ไม่ใช่ทอง) กรอบการ์ดเป็นทองแบรนด์โปร่ง
// ชิปตกลงไปที่ผิวลึกสุด #241700 เนื้อความและชื่อสมาชิก #fdf3df (= BRAND_TEXT) ตัวรอง
// ใช้ครีมหม่น #d9c9a6 ซึ่ง §2 พินไว้ให้คำบรรยายโดยเฉพาะ (7.1:1) glow เป็น
// rgba(251,193,52,…)
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB ที่เคยค้างในไฟล์นี้ (#e8232a
// #ff5a46 #7d0f12 #f2b705 #ffd666 #c08a0b #a8730a #f5cbb0 #c9a898 #fbe8d5 #3d1709
// #180800 rgba(232,35,42,α)) ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 (#a435f0 #7a1fc4
// #5b1a75 #d2a6ff #efe6ff #fbe455 #ffd23d #c98a05 #17062e #ece2ff) และชุดฟ้าสด-
// เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd #0b6fc4 #064a86 #fce604 #c9a703
// #07111d #dbeafe #93b4d4) ออกครบทุกจุดแล้ว — ทองของรอบนี้ (#fbc134) เป็นคนละค่ากับ
// #f2b705 / #fbe455 / #fce604 / #ffd23d และ #cfd6e3 ก็ไม่ใช่เงินเทาของรอบไหนก่อนหน้า
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ค้นหาเกมและเลือกหมวดหมู่ผ่านแพลตฟอร์มเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมฟรีสปิน · โบนัสตัวคูณ · เกมยอดนิยมจากค่ายที่เปิดให้บริการ",
    content:
      "ที่ใช้ต่อเพราะเป็นเว็บสล็อตนาซ่าที่นำเสนอทางเข้าเล่นสล็อตออนไลน์ภายใต้แนวคิดฐานเกมหลักจากเมกา แล้วรวบรวมเกมสล็อตหลายประเภทไว้ในแพลตฟอร์มเดียว มีทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมยอดนิยมจากค่ายที่เปิดให้บริการ รวมค่ายฮิตระดับประเทศไว้ให้เลือกหลายแนว ตั้งแต่เกมวงล้อทั่วไปไปจนถึงสล็อตที่มีฟีเจอร์โบนัสและรูปแบบการเล่นแตกต่างกัน ตัวที่ชอบที่สุดคือระบบจัดหมวดหมู่เกม เพราะช่วยให้ค้นหาค่ายที่สนใจได้ง่ายและรองรับการเข้าใช้งานผ่านอุปกรณ์หลายประเภท ก่อนเริ่มเล่นก็ตรวจสอบยอดเดิมพัน ตารางจ่าย และรายละเอียดของแต่ละเกมได้โดยตรง ส่วนเรื่องที่อยากให้อ่านกันก่อนคือการระบุว่าส่งตรงจากอเมริกาและเป็นฐานเกมหลัก 100% ควรมีข้อมูลผู้ให้บริการที่สามารถตรวจสอบได้รองรับ ไม่ควรใช้ข้อความนั้นเป็นหลักฐานยืนยันเพียงอย่างเดียว และเรื่องระบบเดิมพันใหม่ล่าสุดกับมาตรฐานสากลก็ควรมีข้อมูลด้านเทคโนโลยี ผู้พัฒนาเกม หรือมาตรฐานที่ใช้งานจริงประกอบ",
    avatar: "🚀",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณ",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เข้ายูส",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบโปรโมชั่นตามกิจกรรมที่เปิดให้รับในแต่ละช่วงได้เอง ทั้งยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสผ่านบัญชีโดยตรง ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามข้อกำหนดจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด ถ้ามีการโอนโบนัสเข้ายูสอัตโนมัติก็ตรวจสอบยอดและประวัติการรับสิทธิ์ผ่านบัญชีได้ ส่วนแนะนำเพื่อนคือแชร์ลิงก์แนะนำให้เพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ แล้วดูจำนวนเพื่อนและสถานะโบนัสผ่านบัญชีสมาชิกได้ ข้อควรรู้คือการระบุว่าโปรโมชั่นครอบคลุมทุกค่ายควรตรวจสอบรายชื่อเกมที่ร่วมรายการ เพราะแต่ละกิจกรรมอาจกำหนดเงื่อนไขแตกต่างกัน และคำว่าไม่จำกัดควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส เพื่อให้เข้าใจรายละเอียดของโปรโมชั่นตรงกัน อย่าลืมอ่านรอบตัดยอดและเงื่อนไขการใช้โบนัสก่อนรับทุกครั้ง",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจชื่อบัญชีปลายทางก่อนยืนยันรายการทุกครั้ง",
    stars: 4,
    tag: "ฝากถอนเข้าบัญชีบริษัทโดยตรง · ไม่ผ่านม้า · แอดมิน 24 ชั่วโมง",
    content:
      "ก่อนยืนยันรายการจะตรวจชื่อบัญชี จำนวนเงิน และข้อมูลปลายทางผ่านระบบก่อนทุกครั้ง ถ้าเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ก็ควรมีชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้ เพื่อเอามาเปรียบเทียบกับชื่อบัญชีรับเงินก่อนทำธุรกรรม ข้อที่อยากกำกับไว้คือข้อความไม่ผ่านบัญชีม้า ควรมีข้อมูลผู้รับเงินและหลักฐานการดำเนินงานรองรับ เนื่องจากชื่อบัญชีบริษัทเพียงอย่างเดียวไม่สามารถรับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ถ้าพบว่าชื่อบัญชีปลายทางไม่ตรงกับข้อมูลจากช่องทางหลัก ควรสอบถามฝ่ายบริการก่อนทำรายการ พร้อมเก็บหลักฐานธุรกรรมไว้จนกว่ารายการจะเสร็จสมบูรณ์ เรื่องติดต่อก็แจ้งแอดมินผ่านช่องทางติดต่อหลักได้ตลอด 24 ชั่วโมง ปัญหาเกี่ยวกับเกมสล็อตให้แจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ปัญหาโปรโมชั่นให้ระบุชื่อกิจกรรมและรอบรับสิทธิ์ ส่วนเรื่องฝากถอนให้เตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรมไว้สำหรับตรวจสอบ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef2f8] via-[#ffe87a] to-[#fbc134] shadow-[0_0_12px_rgba(251,193,52,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fdf3df] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fbc134]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#d9c9a6]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการค้นหาเกมและเลือกหมวดหมู่ทั้งสล็อตคลาสสิก เกมฟรีสปิน และโบนัสตัวคูณผ่านแพลตฟอร์มเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์
        และการตรวจชื่อบัญชีปลายทางก่อนยืนยันรายการพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#fbc134]/30 border-l-[#fbc134] bg-[#4e3406] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#eef2f8] to-[#fbc134] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#d9c9a6]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#6b4a05] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbc134]" : "text-[#3f4859]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#fdf3df]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#cf9a18]/45 bg-[#241700] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fbc134] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#fbc134]/25 bg-[#4e3406] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#fbc134]/70 hover:shadow-[0_15px_40px_rgba(251,193,52,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#cfd6e3]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#cfd6e3]/38"
          />

          <div class="flex items-center gap-4 border-b border-[#6b4a05] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#cf9a18] bg-gradient-to-br from-[#ffe87a] via-[#fbc134] to-[#cf9a18] text-2xl text-[#231500] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fdf3df] transition-colors group-hover:text-[#fbc134]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#d9c9a6]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fbc134]" : "text-[#3f4859]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#cf9a18]/45 bg-[#241700] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fbc134] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#cfd6e3]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#fdf3df]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
