---
// HERO1688 is a สล็อตออโต้เว็บตรง brand — every row stays inside what the brief
// states: การรวบรวมเกมสล็อตจากหลายผู้ให้บริการไว้เป็นหมวดหมู่ในบัญชีเดียว ทั้ง
// สล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมรูปแบบใหม่ตามที่แต่ละค่ายเปิดให้บริการ,
// การเข้าเล่นผ่านเว็บเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์, ระบบออโต้ที่
// ให้ทำรายการฝาก ส่งคำขอถอน และตรวจสถานะผ่านบัญชีสมาชิกได้เอง, เงื่อนไข
// "ไม่มีขั้นต่ำ" และ "รองรับทุกธนาคาร" ที่ต้องยึดข้อมูลในหน้าฝากถอน ณ เวลา
// ทำรายการ, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% พร้อมรอบคำนวณและยอดที่
// เข้าเกณฑ์, และแอดมินที่ดูแลตลอด 24 ชั่วโมง.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state — the brief says outright that ผลลัพธ์ของเกมสล็อตเป็นไปตามระบบของแต่ละ
// เกม จึงรับประกันไม่ได้ว่าเกมใดจะแตกไว. Written testimonial text only — no
// Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Red carries the
// score/quote furniture, chrome silver carries the identity rail, so both
// halves of the HERO1688 wordmark are doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน",
    content:
      "เปิดบัญชีเดียวแล้วเลือกเกมสล็อตจากหลายค่ายได้ตามรูปแบบที่สนใจ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมรูปแบบใหม่ที่แต่ละค่ายเปิดให้บริการ ไม่ต้องสมัครใหม่ทุกครั้งที่ย้ายไปเล่นอีกค่ายหนึ่ง เข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตอยู่ในหน้าเว็บไซต์เดียวกัน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ดูเงื่อนไขในหน้าฝากถอนก่อนทำรายการทุกครั้ง",
    stars: 5,
    tag: "เงื่อนไขที่ระบบแสดง · ช่วงเดิมพันในเกม",
    content:
      "ก่อนทำรายการจะเข้าไปดูยอดขั้นต่ำ วงเงิน และสถานะของช่องทางในหน้าฝากถอนก่อนเสมอ เพราะช่องทางแต่ละประเภทกำหนดเงื่อนไขไม่เท่ากัน ส่วนคำว่าไม่มีขั้นต่ำและรองรับทุกธนาคารก็ยึดตามข้อมูลที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ไม่ได้เอาจากข้อความโฆษณา ตอนเข้าเกมก็ดูช่วงเดิมพันของเกมนั้นก่อนเริ่มหมุนด้วย",
    avatar: "🎮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ฝากถอนวอลเลทเอง แล้วเช็กโปรโมชั่นจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · แอดมิน 24 ชม.",
    content:
      "เลือกใช้วอลเลทหรือบัญชีธนาคารตามช่องทางที่เว็บไซต์เปิดรองรับ ทำรายการฝาก ส่งคำขอถอน และตามสถานะผ่านบัญชีสมาชิกได้เองบนมือถือ ส่วนโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่รับได้ผ่านบัญชีตัวเอง โบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเงื่อนไข ส่วนคืนยอดเสีย 0.3% เป็นไปตามรอบที่กำหนด ก่อนกดรับควรดูรอบคำนวณ ประเภทเกมที่ร่วมรายการ และเงื่อนไขให้ครบ รอบไหนติดปัญหาก็สอบถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรบอกรหัสผ่านหรือ OTP ให้ใคร",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HERO1688" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5a5d] via-[#e3e7ec] to-[#7d0507] shadow-[0_0_12px_rgba(225,16,21,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f4f7fb] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ff5a5d]">HERO</span><span class="text-[#c4c5ca]">1688</span>
      </p>
      <span class="text-xs tracking-wide text-[#a9b2c0]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตจากหลายค่าย การตรวจเงื่อนไขก่อนทำรายการ และการฝากถอนผ่านบัญชีของตนเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#7d0507] border-l-[#e11015] bg-[#080a12]/92 px-6 py-4 shadow-[0_10px_30px_rgba(1,2,7,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f4f7fb] to-[#e11015] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#a9b2c0]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7d0507] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff5a5d]" : "text-[#7d0507]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbe1ea]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#9aa3ad]/45 bg-[#010207] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e3e7ec] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#7d0507] bg-[#080a12]/92 p-5 shadow-[0_10px_30px_rgba(1,2,7,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#e11015]/70 hover:shadow-[0_15px_40px_rgba(225,16,21,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e11015]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#e11015]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#7d0507] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#9aa3ad]/50 bg-gradient-to-br from-[#e3e7ec] via-[#9aa3ad] to-[#7d0507] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e3e7ec] transition-colors group-hover:text-[#f4f7fb]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a9b2c0]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ff5a5d]" : "text-[#7d0507]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#7d0507]/60 bg-[#010207] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff5a5d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e11015]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dbe1ea]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
