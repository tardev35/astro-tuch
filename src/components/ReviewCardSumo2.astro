---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง" ทุกแถวจึงอยู่ในกรอบที่
// brief ระบุไว้เอง: รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว, เน้นทางเข้าเว็บตรงที่
// ใช้งานง่าย, จัดหมวดเกมไว้อย่างชัดเจนจนค้นหาเกมยอดนิยมจากหน้าเดียวได้, ระบบ
// ออโต้ที่จัดการบัญชีและเข้าเล่นได้สะดวกทั้งบนมือถือและคอมพิวเตอร์, เกมยอดนิยม
// หลายสไตล์ทั้งสล็อตโบนัส เกมฟีเจอร์ และเกมแจ็คพอต, การเปิดดูข้อมูลของแต่ละเกม
// กับรอบโบนัสและระดับเดิมพันก่อนเลือกเล่น, โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน
// 0.8% ที่ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น, ช่องทางธนาคารและ
// วอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งานพร้อมตรวจสอบสถานะฝากถอนและยอดเครดิต
// จากบัญชีได้โดยตรง และการติดต่อแอดมินเรื่องสมัคร ทางเข้าเว็บ โปรโมชั่น เกม
// หรือระบบฝากถอน
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// FAH999 (รอบม่วง-ทอง 2026-09-21): แถบระบุตัวสมาชิกไล่จากทองประกาย #fef354 ลง
// ทองหลัก #fbbf13 ไปหาม่วงกลาง #7c2fd4 ส่วนกรอบการ์ดกับเส้นคั่นเป็นม่วงเข้ม
// #4a1188 บนพื้นการ์ด #180430 ตามโลโก้มงกุฎทองบนพื้นม่วง — แยกชั้นด้วยสองสี
// ของแบรนด์ ไม่ใช่ความสว่างของทองสีเดียวอย่างรอบก่อน
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "เข้าเว็บตรงแล้วค้นหาเกมยอดนิยมจากหน้าเดียว",
    stars: 5,
    tag: "สล็อตออโต้ เว็บตรง",
    content:
      "เข้าผ่านทางเข้าเว็บตรงที่เว็บไซต์ประกาศไว้แล้วใช้งานง่ายตามที่ระบุ ในระบบรวมเกมสล็อตจากหลายค่ายไว้ที่เดียวและจัดหมวดเกมไว้ชัดเจน เลยค้นหาเกมยอดนิยมจากหน้าเดียวได้ ระบบออโต้ช่วยให้จัดการบัญชีและเข้าเล่นสะดวกขึ้น ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์",
    avatar: "🎰",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "ตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%",
    content:
      "โปรโมชั่นที่กำหนดไว้มีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขและวิธีรับสิทธิ์ของตัวเอง ที่ชอบคือตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น ทั้งยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และรอบคำนวณ ส่วนยอดสิทธิ์ของกิจกรรมแนะนำเพื่อนก็ดูได้จากบัญชีสมาชิก",
    avatar: "💰",
  },
  {
    name: "คุณอนุชา พ.",
    role: "จัดการบัญชีผ่านช่องทางที่เว็บเปิดให้ใช้งาน",
    stars: 4,
    tag: "ธนาคาร วอลเลท และการติดต่อแอดมิน",
    content:
      "ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน เลือกช่องทางที่เหมาะกับตัวเองได้ ขั้นตอนออกแบบให้ใช้งานง่ายและลดความซับซ้อนในการจัดการรายการแต่ละครั้ง ตรวจสอบสถานะฝากถอนและยอดเครดิตจากบัญชีได้โดยตรง ถ้าติดตรงไหนก็ติดต่อแอดมินได้ทั้งเรื่องการสมัคร ทางเข้าเว็บ โปรโมชั่น เกม หรือระบบฝากถอน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🏦",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fef354] via-[#fbbf13] to-[#7c2fd4] shadow-[0_0_12px_rgba(251,191,19,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ecdcff] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fbbf13]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ecdcff]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมทางเข้าเว็บตรงกับการค้นหาเกมยอดนิยมจากหน้าเดียว การตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับ และการจัดการบัญชีผ่านช่องทางที่เว็บไซต์เปิดให้ใช้งาน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#4a1188] border-l-[#fbbf13] bg-[#180430]/94 px-6 py-4 shadow-[0_10px_30px_rgba(13,1,25,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fef354] to-[#fbbf13] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ecdcff]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#4a1188] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbbf13]" : "text-[#4a1188]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ecdcff]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#4a1188] bg-[#0d0119] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffdf6b] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#4a1188] bg-[#180430]/94 p-5 shadow-[0_10px_30px_rgba(13,1,25,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#fbbf13]/75 hover:shadow-[0_15px_40px_rgba(251,191,19,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#7c2fd4]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#fbbf13]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#4a1188] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fbbf13]/60 bg-gradient-to-br from-[#fef354] via-[#fbbf13] to-[#7c2fd4] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ffdf6b] transition-colors group-hover:text-[#fef354]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ecdcff]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fbbf13]" : "text-[#4a1188]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fbbf13]/65 bg-[#0d0119] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffdf6b] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fbbf13]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ecdcff]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
