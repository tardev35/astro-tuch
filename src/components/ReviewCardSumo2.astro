---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บเกมเซ็กซี่บาคาร่า/คาสิโนไลฟ์สด ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง: เกมเซ็กซี่
// บาคาร่าออนไลน์ในรูปแบบไลฟ์สด, โต๊ะเกมและรูปแบบการเดิมพันตามรายการที่เปิดให้บริการ, รองรับ
// การเข้าใช้งานผ่านมือถือและคอมพิวเตอร์, เลือกโต๊ะและเข้าเล่นได้ตลอด 24 ชั่วโมงตามช่วงเวลาที่
// ระบบรองรับ, เชื่อมต่อเกมบาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศตามข้อมูลที่เว็บไซต์ระบุ, โต๊ะ
// บาคาร่าและเกมคาสิโนสดหลายรูปแบบ, เมนูที่จัดให้ค้นหาได้ง่าย, ข่าวสาร เกมใหม่ และโปรโมชั่นที่
// อัปเดตตามช่วงเวลา, โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบรับสิทธิ์
// รอบคำนวณ และเงื่อนไข, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน และการติดต่อเจ้าหน้าที่ได้ตลอด
// 24 ชั่วโมง ไม่มีข้อความไหนอ้างชื่อค่ายเจาะจง ชื่อโต๊ะ ค่า RTP ชื่อธนาคาร ช่องทางฝากถอน ขั้นต่ำ
// การเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): โลโก้เป็นเวิร์ดมาร์กสองโทน SEXY เป็นชมพู
// บานเย็น GAME ไล่ไปเป็นม่วง แล้วเลข 666 กลับมาเป็นชมพู การ์ดรีวิวจึงใช้ชมพูกับม่วงแยกหน้าที่กัน
// — สันนำหน้าหัวข้อ ป้ายระบุตัวสมาชิก และดาว เป็นชมพู (ชมพูอ่อน #ffb3e2 → ชมพูแบรนด์ #fa42b5
// → ชมพูลึก #7d1550) ส่วนคะแนนเฉลี่ยและป้ายแท็กรับม่วง (#c9a4ff #8b3df3 #4a17a0) ตามคำว่า
// GAME กรอบการ์ดกับเส้นคั่นเป็นม่วงลึก #3d1180 บนผิวการ์ด #0f0518 เหนือพื้นเพจ #070109
// เนื้อความเป็น BRAND_TEXT #f2dcee และตัวเน้นเป็น #fff2fb — ชุดทอง-เขียวของ PGW44 (#fde90e
// #fff89a #a86f02 #35d413 #5df53a #0c6d10 #1f5a16 #0b1408 #050803 #e9f0dd #fbffe8)
// ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกโต๊ะบาคาร่าและเกมคาสิโนสดจากหน้าเว็บไซต์",
    stars: 5,
    tag: "บาคาร่าไลฟ์สด · คาสิโนสดหลายรูปแบบ",
    content:
      "ที่ใช้ต่อเพราะรวมเกมเซ็กซี่บาคาร่าออนไลน์ในรูปแบบไลฟ์สดไว้จริง มีทั้งโต๊ะบาคาร่าและเกมคาสิโนสดหลายรูปแบบให้เลือกตามรายการที่เปิดให้บริการ ระบบจัดเมนูให้ค้นหาได้ง่าย มีรายละเอียดเกมและโต๊ะให้ตรวจสอบก่อนเข้าเล่นจริง แล้วใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตตามช่วงเวลาได้จากหน้าเว็บไซต์ มีทั้งโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของโปรโมชั่น และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด แต่ละรายการแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขไว้ให้ตรวจผ่านบัญชีสมาชิกก่อนกดรับ",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามเจ้าหน้าที่เมื่อติดขัด",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · เจ้าหน้าที่ 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเองเพียง 3 ขั้นตอน คือกรอกข้อมูล ตรวจสอบข้อมูลส่วนตัวและรายละเอียดบัญชีให้ถูกต้อง แล้วยืนยันและเข้าสู่ระบบ หลังจากนั้นเลือกโต๊ะบาคาร่าและเกมไลฟ์สดที่เปิดให้บริการได้ตลอด 24 ชั่วโมงตามช่วงเวลาที่ระบบรองรับ ทางเข้าเล่นเชื่อมต่อเกมบาคาร่าไลฟ์สดจากผู้ให้บริการต่างประเทศตามข้อมูลที่เว็บไซต์ระบุ ติดตรงไหนก็ติดต่อเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง ทีมงานช่วยให้ข้อมูลเกี่ยวกับระบบและตรวจสอบปัญหาตามรายละเอียดที่แจ้งเข้ามา",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3e2] via-[#fa42b5] to-[#7d1550] shadow-[0_0_12px_rgba(250,66,181,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff2fb] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fa42b5]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f2dcee]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกโต๊ะบาคาร่าและเกมคาสิโนสดจากรายการที่เปิดให้บริการ การตรวจรายละเอียดเกมและโต๊ะก่อนเข้าเล่นจริง และการตรวจเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#3d1180] border-l-[#fa42b5] bg-[#0f0518]/94 px-6 py-4 shadow-[0_10px_30px_rgba(4,1,8,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#c9a4ff] to-[#4a17a0] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f2dcee]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#3d1180] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fa42b5]" : "text-[#3d1180]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f2dcee]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#8b3df3]/50 bg-[#070109] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c9a4ff] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#3d1180] bg-[#0f0518]/94 p-5 shadow-[0_10px_30px_rgba(4,1,8,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fa42b5]/70 hover:shadow-[0_15px_40px_rgba(250,66,181,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fa42b5]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#8b3df3]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#3d1180] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fa42b5]/65 bg-gradient-to-br from-[#ffb3e2] via-[#fa42b5] to-[#7d1550] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff2fb] transition-colors group-hover:text-[#c9a4ff]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f2dcee]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fa42b5]" : "text-[#3d1180]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#8b3df3]/45 bg-[#070109] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c9a4ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fa42b5]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f2dcee]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
