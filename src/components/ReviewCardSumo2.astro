---
const reviews = [
  {
    name: "สมาชิกที่เข้าเล่นผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้วเข้าสู่ระบบได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ค้นหาเกมที่สนใจและสลับเข้าเล่นแต่ละหมวดหมู่ได้จากเครื่องเดียว เหมาะกับคนที่สลับไปมาระหว่างมือถือกับคอมพิวเตอร์",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่เล่นทั้งคาสิโนสดและสล็อต",
    role: "ตรวจสอบเงื่อนไขของแต่ละห้องก่อนวางเดิมพัน",
    stars: 5,
    tag: "รวมเกมหลายค่าย",
    content:
      "ทั้งคาสิโนสด บาคาร่า รูเล็ต เสือมังกร และสล็อตจากหลายค่าย อยู่ในบัญชีเดียวกัน เลือกห้องที่เปิดอยู่และดูวงเงินกับเงื่อนไขที่ระบบแสดงได้ก่อนวางเดิมพัน จึงรู้ตั้งแต่แรกว่ารายการนี้ใช้เงื่อนไขแบบไหน",
    avatar: "🃏",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "ตอนส่งคำขอถอนแล้วรายการยังค้าง แจ้งเวลาที่ทำรายการกับรายละเอียดไป แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาเข้าเล่นรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก SUPERWIN9" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#c81118] via-[#f5333c] to-[#fbe289] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ebbb4a]">SUPERWIN9</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebbb4a] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ebbb4a]/35 bg-[#170405]/92 px-6 py-4 shadow-[0_10px_30px_rgba(200,17,24,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbe289] to-[#9a7112] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9b489] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#33110d]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ebbb4a]" : "text-[#33110d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9b489]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7a0d10]/35 bg-[#170405]/92 p-6 text-left shadow-[0_10px_30px_rgba(200,17,24,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ebbb4a]/60 hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#c81118] to-[#ebbb4a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#3d0407]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#c81118]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7a0d10]/35 bg-[#0a0202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ebbb4a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c81118]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ebbb4a]" : "text-[#33110d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#efe3d2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#33110d] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ebbb4a]/40 bg-gradient-to-br from-[#f5333c] via-[#c81118] to-[#9a7112] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#efe3d2] transition-colors group-hover:text-[#ebbb4a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9b489] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
