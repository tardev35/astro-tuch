---
import { BRAND_NAME } from "../lib/brandProfile";

// WEPLAY168 (2026-10-09): บรีฟรอบนี้เป็น **เว็บเล่นสล็อตออโต้ล้วน** ทุกแถวจึงถูกเขียน
// ใหม่ทั้งหมดจากคำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิมของ
// แตกดี168 ที่พูดถึง "เกมเปิดใหม่ / ถูกลิขสิทธิ์ / รอบตัดยอด" หรือของ 789BETTING ก่อน
// หน้านั้นที่พูดถึงโต๊ะสด ตลาดเดิมพัน และรอบหวย — คำชุดนั้นเป็นของบรีฟรอบก่อน ไม่ใช่
// ของบรีฟนี้ และ brand-spec §6 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: เล่นสล็อตออโต้ที่รวบรวมเกมสล็อตจากค่ายหลักไว้ใน
// แพลตฟอร์มเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ ·
// ใช้งานผ่านมือถือโดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม · เลือกค่าย ค้นหาเกม ตรวจสอบ
// เครดิต และติดตามรายการจากบัญชีเดียว · บางเกมรองรับเบทเริ่มต้น 1 บาท ตามช่วงเดิมพัน
// ที่ค่ายกำหนด · ตรวจตารางจ่ายและอัตราการคืนเงินผู้เล่นก่อนเริ่มเล่น · คืนยอดเสีย 0.3%
// ตามรอบคำนวณ · แนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ · ฝากถอนเข้าบริษัทโดยตรง
// ตรวจชื่อบัญชีปลายทางก่อนยืนยันธุรกรรม · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN
// หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP เป็นตัวเลข ยอดฝาก
// ขั้นต่ำ จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มี
// สี่ตัว: 1 บาท · 0.3% · 0.8% · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคง
// ประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว (แตกง่าย/ไม่มีขั้นต่ำ ควรพิจารณาจาก
// ข้อมูลเกมจริง · ผลการหมุนสล็อตเป็นแบบสุ่ม ไม่มีเกมใดรับประกัน · ชื่อบัญชีบริษัท
// เพียงอย่างเดียวไม่ได้รับประกันความปลอดภัย · คำว่าไม่จำกัดควรตรวจสอบเงื่อนไข)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ม่วงนีออน-ทองอาร์เขตบนครามเกือบดำ): สีหลักคือ **ม่วง
// แบรนด์** #a435f0 สีรองคือ **ทอง** #fbe455 บนผิวการ์ดกลาง #17062e ไม่ใช่ผิวกรมท่า
// แบบรอบ แตกดี168 — สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่เงินอมม่วง #efe6ff → ม่วงอ่อน
// #d2a6ff → ม่วงแบรนด์ #a435f0 บนหมึกเข้ม #190633 (§2 ให้ 4.9:1 บน #a435f0 ซึ่งเป็น
// เพดาน — ห้ามพลิกไปใช้ตัวอักษรสว่างบนแผ่นม่วงสด) ชื่อแบรนด์ในหัวข้อใช้ม่วงอ่อนบน
// พื้นมืด คะแนนเฉลี่ยไล่เงินอมม่วง → ม่วงอ่อน ส่วนทองถูกใช้เฉพาะจุดที่ควรเป็นทองจริงๆ
// คือดาวที่ติดและป้ายหัวข้อแถว ซึ่งใช้ทองอุ่น #ffd23d (เหรียญทองกับเลข 168 ในงานอาร์ต
// ของแบรนด์) ดาวที่ยังไม่ติดใช้ม่วงลึก #5b1a75 จุดกะพริบบนป้ายใช้ม่วงอ่อน ออรามุมขวา
// บนเป็นม่วงแบรนด์โปร่ง กรอบการ์ดเป็นม่วงแบรนด์โปร่ง ชิปตกลงไปที่ผิวลึกสุด #0a0117
// เนื้อความและชื่อสมาชิก #ece2ff (= BRAND_TEXT) ตัวรองใช้เนื้อความแบบลดความทึบ
// (#ece2ff/70) เพราะพาเลตต์รอบนี้ไม่มีสีกลางหม่นของตัวเอง และการสร้างเทาขึ้นมาใหม่คือ
// การเพิ่มสีนอกพาเลตต์ glow เป็น rgba(164,53,240,…)
// ทองแบรนด์ #fbe455 ไม่ถือตัวอักษรทึบที่ไหนในไฟล์นี้ — §2 พินมันไว้ให้ <strong> ใน
// เนื้อความเท่านั้น
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0193fb #7bcffb #d4ecfd
// #0b6fc4 #064a86 #fce604 #c9a703 #07111d #020609 #031018 #dbeafe #93b4d4
// rgba(1,147,251,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกค่าย ค้นหาเกม และตรวจเครดิตจากบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · ตัวคูณ · เกมรูปแบบใหม่",
    content:
      "ที่ใช้ต่อเพราะรวบรวมเกมสล็อตจากค่ายหลักไว้ในแพลตฟอร์มเดียว มีทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่ให้เลือกตามความสนใจ ใช้งานผ่านมือถือได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม เลยเลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้จากบัญชีเดียวโดยไม่ต้องสลับไปมา ตัวที่ชอบที่สุดคือเกมเบทต่ำ บางเกมรองรับการเดิมพันเริ่มต้น 1 บาท ตามช่วงเดิมพันที่ค่ายกำหนด เลยวางแผนจำนวนเงินต่อรอบให้พอกับงบที่ตั้งไว้ได้ ข้อที่อยากให้อ่านกันก่อนคือคำว่าแตกง่ายและไม่มีขั้นต่ำ ควรพิจารณาจากข้อมูลเกมจริง เพราะแต่ละค่ายกำหนดยอดเดิมพันต่ำสุดไม่เท่ากัน และผลการหมุนสล็อตเป็นแบบสุ่ม ไม่มีเกมใดรับประกันว่าจะได้รับโบนัสหรือกำไรทุกครั้ง ส่วนจำนวนค่ายและเกมที่เปิดให้บริการจริงตรวจสอบได้จากหน้าเว็บไซต์",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เข้าสู่ระบบตรวจยอดที่เข้าเกณฑ์และรอบคำนวณ",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์",
    content:
      "ชอบที่เข้าสู่ระบบแล้วตรวจสอบโปรโมชั่นตามแคมเปญที่เปิดให้บริการในแต่ละช่วงได้เอง ทั้งยอดที่เข้าเกณฑ์ รอบคำนวณ และสถานะการรับโบนัสจากบัญชีโดยตรง ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามเงื่อนไขจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัสคืนยอดเสีย 0.3% ตามรอบประจำวันที่เว็บไซต์กำหนด ถ้าใช้รูปแบบโอนโบนัสเข้ายูสอัตโนมัติก็ติดตามยอดจากประวัติโปรโมชั่นได้ ส่วนแนะนำเพื่อนคือแชร์ลิงก์ให้เพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะคำนวณโบนัสแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ แล้วดูจำนวนเพื่อนและสถานะโบนัสผ่านบัญชีสมาชิกได้ ข้อควรรู้คือแต่ละรายการอาจกำหนดค่ายเกม ระยะเวลา และข้อกำหนดแตกต่างกัน จึงควรอ่านรายละเอียดก่อนรับสิทธิ์ทุกครั้ง และคำว่าไม่จำกัดควรตรวจสอบว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับโบนัส หรือวงเงินรวม",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจชื่อบัญชีปลายทางก่อนยืนยันธุรกรรมทุกครั้ง",
    stars: 4,
    tag: "ฝากถอนเข้าบริษัทโดยตรง · บัญชีปลายทาง · แอดมิน 24 ชั่วโมง",
    content:
      "ก่อนยืนยันธุรกรรมจะตรวจยอดเงิน ชื่อบัญชีปลายทาง และสถานะรายการผ่านระบบก่อนทุกครั้ง ถ้าเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ก็ควรแสดงชื่อบริษัทหรือนิติบุคคลที่สามารถตรวจสอบได้ เพื่อเอามาเทียบกับชื่อบัญชีรับเงินก่อนทำรายการ ข้อที่อยากกำกับไว้คือคำว่าปลอดภัยและไม่ผ่านบัญชีม้า ควรมีข้อมูลผู้รับเงินและหลักฐานการดำเนินงานรองรับ เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ถ้าพบชื่อบัญชีปลายทางผิดปกติหรือเปลี่ยนแปลงจากข้อมูลเดิม ควรสอบถามช่องทางบริการหลักก่อนโอนเงินและเก็บหลักฐานธุรกรรมไว้ทุกครั้ง เรื่องติดต่อก็แจ้งแอดมินได้ตลอด 24 ชั่วโมง ปัญหาเกมสล็อตให้แจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ปัญหาโปรโมชั่นให้ระบุชื่อกิจกรรมและรอบรับสิทธิ์ ส่วนธุรกรรมให้เตรียมเวลา จำนวนเงิน และหลักฐานรายการไว้ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#efe6ff] via-[#d2a6ff] to-[#a435f0] shadow-[0_0_12px_rgba(164,53,240,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ece2ff] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#d2a6ff]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ece2ff]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกค่ายและค้นหาเกมสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมรูปแบบใหม่จากบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน
        0.8% จากยอดที่เข้าเกณฑ์ และการตรวจชื่อบัญชีปลายทางก่อนยืนยันธุรกรรมพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#a435f0]/30 border-l-[#a435f0] bg-[#17062e] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#efe6ff] to-[#d2a6ff] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ece2ff]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5b1a75] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd23d]" : "text-[#5b1a75]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece2ff]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#c98a05]/45 bg-[#0a0117] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd23d] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#a435f0]/25 bg-[#17062e] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#a435f0]/70 hover:shadow-[0_15px_40px_rgba(164,53,240,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a435f0]/26 blur-[60px] transition-all duration-300 group-hover:bg-[#a435f0]/40"
          />

          <div class="flex items-center gap-4 border-b border-[#5b1a75] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#7a1fc4] bg-gradient-to-br from-[#efe6ff] via-[#d2a6ff] to-[#a435f0] text-2xl text-[#190633] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ece2ff] transition-colors group-hover:text-[#ffd23d]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ece2ff]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ffd23d]" : "text-[#5b1a75]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c98a05]/45 bg-[#0a0117] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd23d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d2a6ff]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ece2ff]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
