---
// MGM9 is a full-service casino brand — every row stays inside what the brief
// states: บาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอล และหวยออนไลน์ใน
// บัญชีเดียว, การตรวจกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกมก่อน
// ยืนยันรายการ, การยึดวงเงินและข้อกำหนดที่ระบบแสดง ณ เวลาทำรายการ, ระบบฝากถอนที่
// รองรับทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด, การติดตามสถานะธุรกรรมผ่านบัญชี
// สมาชิก, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, และการติดต่อแอดมิน
// ตลอด 24 ชั่วโมงพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ.
// The only figures quoted anywhere are the brief's own 0.8% และ 0.3%. Nothing
// here promises a payout, a win rate, or a product the brief does not state.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "เลือกบาคาร่า สล็อต บอล และหวยจากบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า · สล็อต · บอล · หวย",
    content:
      "สลับเล่นระหว่างเกมแต่ละประเภทบนมือถือได้สะดวก ทั้งบาคาร่าออนไลน์ เกมคาสิโนสด สล็อตออนไลน์ เดิมพันฟุตบอลตามรายการแข่งขัน และหวยออนไลน์ตามรอบที่เปิดให้บริการ ใช้บัญชีเดียวเลือกเกม ฝากถอน และตรวจสอบโปรโมชั่นได้จากหน้าเว็บไซต์ ส่วนเงื่อนไขไม่อั้นจ่ายกับไม่มีขั้นต่ำก็ยึดวงเงินที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ตรวจกติกาและอัตราจ่ายก่อนยืนยันรายการทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ชอบที่ตรวจสอบกติกา อัตราจ่าย ช่วงเดิมพัน และรายละเอียดของแต่ละเกมได้ก่อนกดยืนยัน ฝั่งโปรโมชั่นก็เข้าไปดูสิทธิ์ที่กดรับได้ในแต่ละรอบ ทั้งโบนัสแนะนำเพื่อน 0.8% ที่คำนวณจากยอดของเพื่อนที่เข้าเกณฑ์ และคืนยอดเสีย 0.3% ตามรอบที่กำหนด ก่อนกดรับก็ยังตรวจรอบคำนวณและข้อกำหนดล่าสุดอีกครั้งเสมอ",
    avatar: "🎁",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดรายการให้แอดมิน",
    stars: 4,
    tag: "ฝากถอนวอลเลท · แอดมิน 24 ชั่วโมง",
    content:
      "ฝากถอนเลือกได้ทั้งวอลเลทและบัญชีธนาคารตามช่องทางที่กำหนด ตรวจยอด ส่งคำขอถอน และติดตามสถานะธุรกรรมผ่านบัญชีสมาชิกได้เอง รอบที่เครดิตยังไม่เข้าก็ดูประวัติธุรกรรมก่อน แล้วติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ ทำให้ตรวจสอบได้ตรงจุด ทีมงานยังย้ำให้เก็บหลักฐานไว้จนกว่าการตรวจสอบจะเสร็จสิ้น และไม่ควรแจ้งรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MGM9" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#5ee7ff]">MGM9</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#4aa4f4] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#4aa4f4]/40 bg-[#062a72]/92 px-6 py-4 shadow-[0_10px_30px_rgba(74,164,244,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#9ad4ff] to-[#1f74d6] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a8c8ea] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#4aa4f4]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#4aa4f4]" : "text-[#2c4a86]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d3e6ff]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#4aa4f4]/40 bg-[#062a72]/92 p-6 text-left shadow-[0_10px_30px_rgba(1,12,38,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#9ad4ff]/70 hover:shadow-[0_15px_40px_rgba(74,164,244,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#9ad4ff] to-[#1f74d6] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#4aa4f4]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#5ee7ff]/35"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#4aa4f4]/45 bg-[#01102e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#4aa4f4] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5ee7ff]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#4aa4f4]" : "text-[#2c4a86]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d3e6ff]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4aa4f4]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#4aa4f4]/55 bg-gradient-to-br from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#4aa4f4] transition-colors group-hover:text-[#9ad4ff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a8c8ea] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
