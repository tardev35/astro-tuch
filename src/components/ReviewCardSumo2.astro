---
// LION991 is a live-casino brand — every row stays inside what the brief
// states: เกมเดิมพันหลายหมวดหมู่ในบัญชีเดียวพร้อมคาสิโนสดและโต๊ะ Live ตามที่ระบบเปิด
// ให้บริการ, บาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น ๆ, การรับชม
// ผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์แบบเรียลไทม์, การตรวจกติกา อัตราจ่าย วงเงินขั้นต่ำ
// และสูงสุดของแต่ละโต๊ะก่อนเดิมพัน, การ Login ดูโปรโมชั่นที่เปิดให้รับพร้อมเปอร์เซ็นต์
// วิธีคำนวณ รอบรับโบนัส และข้อกำหนดในการถอน, การสมัครออนไลน์เอง 3 ขั้นตอนโดยไม่ต้อง
// ผ่านแอดมิน, การตรวจเครดิต ประวัติรายการ และสถานะฝากถอนจากบัญชีสมาชิก, และแอดมิน
// ที่รับเรื่องตลอด 24 ชั่วโมงพร้อมแจ้งเวลาและรายละเอียดของรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "เข้าโต๊ะไลฟ์สดจากบัญชีเดียวทั้งบนมือถือและคอม",
    stars: 5,
    tag: "บาคาร่า · รูเล็ต · เสือมังกร · แบล็กแจ็ก",
    content:
      "สลับเข้าโต๊ะแต่ละแบบได้สะดวก ทั้งบาคาร่า รูเล็ต เสือมังกร แบล็กแจ็ก และเกมคาสิโนสดประเภทอื่น ๆ ตามโต๊ะและผู้ให้บริการที่เปิดให้บริการในช่วงนั้น รับชมผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ก็ติดตามการดำเนินเกมแบบเรียลไทม์ได้เหมือนกัน ใช้บัญชีเดียวเลือกเกม ฝากถอน และดูโปรโมชั่นได้จากหน้าเว็บไซต์",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ตรวจกติกาและวงเงินของโต๊ะก่อนเดิมพันทุกครั้ง",
    stars: 5,
    tag: "กติกา · อัตราจ่าย · วงเงินของโต๊ะ",
    content:
      "ชอบที่ตรวจกติกา อัตราจ่าย และวงเงินขั้นต่ำกับสูงสุดของแต่ละโต๊ะได้ก่อนกดเดิมพัน เพราะรายละเอียดเปลี่ยนไปตามเกมและผู้ให้บริการ ส่วนข้อมูลสตูดิโอหรือแหล่งถ่ายทอดสดก็ยึดที่แสดงในเกมโดยตรง ฝั่งโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่เปิดให้รับในช่วงนั้น แล้วอ่านเปอร์เซ็นต์ วิธีคำนวณ รอบรับโบนัส และเงื่อนไขก่อนถอนให้ครบก่อนกดรับ",
    avatar: "🎥",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "สมัครเอง 3 ขั้นตอน แล้วเช็กสถานะรายการจากบัญชี",
    stars: 4,
    tag: "สมัครออนไลน์ · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านระบบออนไลน์ได้ด้วยตัวเองโดยไม่ต้องส่งข้อมูลผ่านเจ้าหน้าที่ กรอกข้อมูล เข้าสู่ระบบ เลือกช่องทางฝากเครดิต แล้วเข้าโต๊ะได้เลย หลังจากนั้นตรวจเครดิต ประวัติรายการ โปรโมชั่น และสถานะฝากถอนจากบัญชีสมาชิกได้เอง รอบที่เข้าโต๊ะไม่ได้หรือเครดิตยังไม่เข้าก็ติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ ทำให้ตรวจสอบได้ตรงจุด และไม่ควรแจ้งรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LION991" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#8fc2ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#8fc2ff]">LION991</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3d82ff] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#1046e0]/40 bg-[#072459]/92 px-6 py-4 shadow-[0_10px_30px_rgba(61,130,255,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#e6ecf7] to-[#8fc2ff] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b7c6dd] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#1046e0]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#8fc2ff]" : "text-[#7d90ad]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d6e2f5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#1046e0]/40 bg-[#072459]/92 p-6 text-left shadow-[0_10px_30px_rgba(1,4,28,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#8fc2ff]/70 hover:shadow-[0_15px_40px_rgba(61,130,255,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#e6ecf7] to-[#1046e0] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1046e0]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#3d82ff]/35"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#1046e0]/45 bg-[#020a2b] px-3 py-1 text-[10px] font-bold tracking-widest text-[#8fc2ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#3d82ff]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#8fc2ff]" : "text-[#7d90ad]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d6e2f5]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#1046e0]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3d82ff]/55 bg-gradient-to-br from-[#e6ecf7] via-[#3d82ff] to-[#052ba9] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#8fc2ff] transition-colors group-hover:text-[#e6ecf7]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b7c6dd] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
