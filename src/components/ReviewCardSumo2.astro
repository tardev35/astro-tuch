---
const reviews = [
  {
    name: "สมาชิกที่เข้าเล่นผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้วเข้าสู่ระบบได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ระบบจัดหมวดหมู่เกมไว้ให้ค้นหาง่าย เลือกเกมที่สนใจและสลับเข้าเล่นแต่ละหมวดได้จากบัญชีเดียว โดยไม่ต้องสลับใช้งานหลายระบบ",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามโบนัสคืนยอดเสีย",
    role: "ตรวจสอบยอดที่เข้าเงื่อนไขก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3%",
    content:
      "ระบบแสดงยอดที่เข้าเงื่อนไขและรายละเอียดของรอบที่เปิดให้กดรับ ทำให้ดูได้ว่าประเภทเกมไหนร่วมรายการ รอบคำนวณเป็นอย่างไร และเงื่อนไขการถอนกำหนดไว้แบบไหน จึงตรวจสอบสิทธิ์ให้ครบก่อนรับโบนัสได้ทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อทีมงานตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ฝากถอนอัตโนมัติ",
    content:
      "ส่งคำขอถอนผ่านระบบอัตโนมัติแล้วรายการยังค้าง จึงแจ้งเวลาที่ทำรายการกับรายละเอียดไป ทีมงานช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาทำรายการรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JUMBOBET" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#0b7a06] via-[#25cb0e] to-[#f0f7ee] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#6ef25a]">JUMBOBET</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#25cb0e] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#25cb0e]/35 bg-[#031204]/92 px-6 py-4 shadow-[0_10px_30px_rgba(37,203,14,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f0f7ee] to-[#0b7a06] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8fa08c] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0b7a06]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#6ef25a]" : "text-[#063f04]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d5e8d0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#0b7a06]/50 bg-[#031204]/92 p-6 text-left shadow-[0_10px_30px_rgba(37,203,14,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#25cb0e]/60 hover:shadow-[0_15px_40px_rgba(37,203,14,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#0b7a06] to-[#6ef25a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#063f04]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#25cb0e]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0b7a06]/50 bg-[#010301] px-3 py-1 text-[10px] font-bold tracking-widest text-[#6ef25a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#25cb0e]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#6ef25a]" : "text-[#063f04]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d5e8d0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0b7a06] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#25cb0e]/40 bg-gradient-to-br from-[#6ef25a] via-[#25cb0e] to-[#063f04] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f0f7ee] transition-colors group-hover:text-[#6ef25a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8fa08c] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
