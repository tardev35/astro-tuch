---
import { BRAND_NAME } from "../lib/brandProfile";

// BOOM369 (2026-10-07): บรีฟรอบนี้เป็น **เว็บสล็อตเบทต่ำสำหรับคนทุนน้อย** ทุกแถวจึง
// ถูกเขียนใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคของ
// รอบ HI59 ก่อนหน้า ซึ่งขายตัวเองว่า "สล็อตไฮคลาสสไตล์ VIP เว็บตรง ลิขสิทธิ์แท้
// ส่งตรงจากเว็บแม่ ยอดเข้าบริษัทตรง ไม่ผ่านบัญชีม้า" — คำชุดนั้นเป็นของบรีฟรอบก่อน
// ไม่ใช่ของบรีฟนี้ และ brand-spec §4 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟระบุไว้เองคือ: รวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว เหมาะกับสายสล็อต
// ที่ต้องการเริ่มจากยอดเดิมพันไม่สูง · มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และ
// สล็อตเปิดใหม่จากค่ายที่ระบบรองรับ · เข้าเล่นผ่านมือถือได้สะดวก · เลือกเกมตามช่วง
// เดิมพันที่ต้องการ · ตรวจสอบตารางจ่ายและรายละเอียดของแต่ละเกมก่อนเริ่ม · Login
// ตรวจสอบโปรโมชั่น ยอดคำนวณ และสถานะการรับสิทธิ์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน
// 0.8% · สมัคร 3 ขั้นตอน · บัญชีเดียวดูเครดิต โปรโมชั่น และประวัติรายการ · ฝากถอน ·
// แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้คือ
// 0.3% · 0.8% · 100% · 24 ชั่วโมง · 3 ขั้นตอน และบรีฟเป็นโทน hedged ทุกย่อหน้า
// จึงคงประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 เขียวนีออน-เงิน บนดำสนิท): สีหลักคือ **เขียวนีออน**
// #42fb5a และสีคู่คือ **เงินโครเมียม** #dadcdc บนผิวการ์ดกลาง #07170f ไม่ใช่ผิวกระจก
// น้ำแข็งสว่างแบบรอบ HI59 — เขียวนีออนเป็นตัวระบุตัวตนของบล็อกนี้และใช้เป็นสีตัวอักษร
// ได้จริง (14.6:1 บนผิวการ์ด) สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่เขียวนีออน → เขียวแบรนด์
// #04ab3a → เขียวลึก #036b26 บนหมึกเขียวดำ #03150a (พื้น #42fb5a ใช้หมึกนี้ได้สีเดียว
// ตามกฎคอนทราสต์ §2) คะแนนเฉลี่ยไล่ขาว #ffffff → เขียวนีออน ส่วนทอง #f3c44a เป็นสีเน้น
// แบบใช้น้อยและถูกใช้เฉพาะจุดที่ควรเป็นทองจริงๆ คือดาวที่ติดกับป้ายหัวข้อแถว (เหรียญ
// และชิปทองในงานอาร์ตของแบรนด์) ดาวที่ยังไม่ติดใช้เขียวลึก #036b26 ชื่อแบรนด์ในหัวข้อ
// ใช้เขียวนีออน ออรามุมขวาบนเป็นเขียวนีออนโปร่ง กรอบการ์ดเป็นเขียวนีออนโปร่ง ชิปตกลงไป
// ที่ผิวลึกสุด #041109 เนื้อความและชื่อสมาชิก #cfe9d7 (= BRAND_TEXT) ตัวรองใช้เขียวหม่น
// #9fb8aa (7.4:1) glow เป็น rgba(66,251,90,…)
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 ที่เคยค้างในไฟล์นี้ (#f6fbff #e7f2fd #9ecbf2
// #0a84e0 #065a9c #044b80 #033f70 #06355f #35587d #fdbc04 #ffe27a #c88a02 #8a6102
// #eaf5ff #0d2744 rgba(6,53,95,…) rgba(10,132,224,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เริ่มจากยอดเดิมพันไม่สูง แบ่งงบเล่นเป็นรอบ",
    stars: 5,
    tag: "สล็อตเบทต่ำ · ทุนน้อย · เกมคลาสสิก · สล็อตเปิดใหม่",
    content:
      "ที่ใช้ต่อเพราะรวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว เหมาะกับสายสล็อตที่ต้องการเริ่มจากยอดเดิมพันไม่สูง มีทั้งเกมคลาสสิก ฟรีสปิน โบนัส ตัวคูณ และสล็อตเปิดใหม่จากค่ายที่ระบบรองรับ เข้าเล่นผ่านมือถือได้สะดวก เลือกเกมจากยอดเดิมพันขั้นต่ำที่ระบบกำหนดได้ แล้วตรวจสอบตารางจ่าย ฟีเจอร์โบนัส ฟรีสปิน และรายละเอียดของแต่ละเกมก่อนเริ่ม ทำให้ควบคุมจำนวนเงินต่อรอบได้ง่ายกว่าเลือกเกมโดยไม่ดูช่วงเดิมพัน ส่วนการระบุว่าเป็นเกมค่ายตรงและถูกลิขสิทธิ์ ควรมีรายชื่อผู้ให้บริการหรือข้อมูลสิทธิ์การให้บริการที่สามารถตรวจสอบได้ประกอบ ไม่ควรดูจากข้อความประชาสัมพันธ์อย่างเดียว",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "Login ตรวจโปรโมชั่นและยอดคำนวณจากบัญชี",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์",
    content:
      "ชอบที่ Login เข้าไปตรวจสอบโปรโมชั่น ยอดคำนวณ และสถานะการรับสิทธิ์จากบัญชีได้โดยตรง ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามเงื่อนไขจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัส 0.3% ที่รับได้ตามรอบที่กำหนด ส่วนแนะนำเพื่อนก็แชร์ลิงก์แนะนำให้เพื่อนสมัคร พอเพื่อนมียอดใช้งานตรงตามข้อกำหนด ระบบจะนำยอดที่เข้าเกณฑ์มาคำนวณโบนัส 0.8% แล้วดูจำนวนเพื่อน ยอดคำนวณ และสถานะโบนัสผ่านบัญชีสมาชิกได้ตามรอบที่โปรโมชั่นกำหนด ข้อที่อยากให้อ่านกันก่อนคือแต่ละรายการมีเกณฑ์คำนวณ รอบรับสิทธิ์ และเงื่อนไขแตกต่างกัน จึงควรตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขการรับโบนัสก่อนกดรับสิทธิ์ทุกครั้ง ส่วนคำว่า โบนัสสูง ให้เยอะกว่าใคร ก็ควรมีข้อมูลเปรียบเทียบรองรับ",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัคร 3 ขั้นตอน แล้วใช้บัญชีเดียวดูทุกอย่าง",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · บัญชีเดียว · ฝากถอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านมือถือทำได้ใน 3 ขั้นตอน เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ต่อด้วยตรวจสอบข้อมูลและยืนยันบัญชีสมาชิก จากนั้น Login เลือกค่ายและเกมสล็อตที่ต้องการเข้าเล่น แล้วตรวจสอบช่วงเดิมพันของเกมก่อนยืนยันยอดในแต่ละรอบได้ทันที หลังเปิดบัญชีเรียบร้อยก็ใช้บัญชีเดียวค้นหาเกมสล็อต ดูเครดิต โปรโมชั่น และประวัติรายการได้ ส่วนคำว่า เล่นสล็อตไม่จำกัดยอด ควรอ้างอิงวงเงินขั้นต่ำและสูงสุดของแต่ละเกม เพราะผู้ให้บริการกำหนดเพดานการเดิมพันต่อรอบแตกต่างกัน ตอนสมัคร Login เข้าเกมสล็อตไม่ได้ เครดิตไม่แสดง โปรโมชั่นไม่ถูกคำนวณ หรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ก็ติดต่อแอดมินผ่านช่องทางบริการหลักที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องเกมเตรียมชื่อเกม ค่าย และเวลาที่เกิดเหตุไว้ ส่วนธุรกรรมเตรียมเวลา จำนวนเงิน และหลักฐานรายการ และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่นไม่ว่ากรณีใด",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_12px_rgba(66,251,90,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ffffff] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#42fb5a]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#9fb8aa]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตเบทต่ำจากช่วงเดิมพันที่ระบบแสดง การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน
        24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#42fb5a]/30 border-l-[#42fb5a] bg-[#07170f] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffffff] to-[#42fb5a] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9fb8aa]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#036b26] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f3c44a]" : "text-[#036b26]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cfe9d7]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#f3c44a]/45 bg-[#041109] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f3c44a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#42fb5a]/25 bg-[#07170f] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#42fb5a]/70 hover:shadow-[0_15px_40px_rgba(66,251,90,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#42fb5a]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#42fb5a]/35"
          />

          <div class="flex items-center gap-4 border-b border-[#036b26] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#036b26] bg-gradient-to-br from-[#42fb5a] via-[#04ab3a] to-[#036b26] text-2xl text-[#03150a] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#cfe9d7] transition-colors group-hover:text-[#42fb5a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9fb8aa]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f3c44a]" : "text-[#036b26]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f3c44a]/45 bg-[#041109] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f3c44a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#42fb5a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#cfe9d7]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
