---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บที่อัปเดตค่ายสล็อตย่อยและรวมเกมหลายแนวไว้ให้เลือกจากระบบเดียว ทุกแถวจึงอยู่
// ในกรอบที่บรีฟระบุไว้เอง: ค่ายสล็อตย่อยและเกมหลายแนวในระบบเดียว, เกมคลาสสิก เกมโบนัส เกมธีมใหม่
// และสล็อตที่อัปเดตตามช่วงเวลา, เมนูจัดหมวดหมู่ชัดเจนและค้นหาได้โดยไม่ต้องเปลี่ยนหลายเว็บไซต์,
// รองรับมือถือและคอมพิวเตอร์, เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ,
// ระดับเดิมพันและรูปแบบการเล่นที่ต่างกันซึ่งตรวจได้จากหน้าเกมโดยตรง, ข่าวสาร เกมใหม่ และโปรโมชั่น
// ที่อัปเดตตามช่วงเวลา, โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบคำนวณ
// และขั้นตอนรับสิทธิ์, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน และการติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์
// ได้ตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้างชื่อค่ายเจาะจง ชื่อเกม ค่า RTP ชื่อธนาคาร ช่องทางฝากถอน
// ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): โลโก้เป็นเวิร์ดมาร์กสองสี P กับ G เป็นทอง W เป็นเขียวสด
// แล้วเลข 44 ไล่จากทองไปเขียว การ์ดรีวิวจึงใช้ทองกับเขียวแยกหน้าที่กัน — สันนำหน้าหัวข้อ ป้าย
// ระบุตัวสมาชิก และดาว เป็นทอง (ทองอ่อน #fff89a → ทองแบรนด์ #fde90e → ทองลึก #a86f02) ส่วน
// คะแนนเฉลี่ยและป้ายแท็กรับเขียว (#5df53a #35d413 #0c6d10) ตามตัว W กรอบการ์ดกับเส้นคั่นเป็น
// เขียวลึก #1f5a16 บนผิวการ์ด #0b1408 เหนือพื้นเพจ #050803 เนื้อความเป็น BRAND_TEXT #e9f0dd
// และตัวเน้นเป็น #fbffe8 — ชุดทอง-โครเมียมของแบรนด์รอบก่อน (#fdd32a #ffe27a #c8920a #c2c8d0
// #f2f4f7 #8a9099 #2a2110 #12100a #fff8e1 #efe6d2 #080602) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกค่ายสล็อตย่อยและเกมหลายแนวจากระบบเดียว",
    stars: 5,
    tag: "ค่ายสล็อตย่อย · ระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวบรวมค่ายสล็อตย่อยและเกมหลายแนวไว้ให้เลือกจากระบบเดียวจริง มีทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา เมนูจัดหมวดหมู่ชัดเจน ค้นหาเกมที่สนใจได้สะดวกโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ แล้วใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ติดตามข่าวสาร เกมใหม่ และโปรโมชั่นที่อัปเดตตามช่วงเวลาได้จากหน้าเว็บไซต์ มีทั้งโบนัสแนะนำเพื่อน 0.8% ตามเงื่อนไขของโปรโมชั่น และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด แต่ละรายการแสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และขั้นตอนรับสิทธิ์ไว้ให้ตรวจผ่านบัญชีสมาชิกก่อนกดรับ",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามเจ้าหน้าที่ทางไลน์",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ไลน์ 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเองเพียง 3 ขั้นตอน คือกรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยันและเข้าสู่ระบบ หลังจากนั้นเข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นไม่เหมือนกัน เลยตรวจรายละเอียดจากหน้าเกมโดยตรงก่อนเริ่มทุกครั้ง ติดตรงไหนก็ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง ทีมงานช่วยให้ข้อมูลเรื่องค่ายสล็อตและระบบสมาชิก และช่วยตรวจสอบปัญหาตามที่แจ้งเข้ามา",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff89a] via-[#fde90e] to-[#a86f02] shadow-[0_0_12px_rgba(253,233,14,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fbffe8] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fde90e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e9f0dd]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกค่ายสล็อตย่อยและเกมหลายแนวจากระบบเดียว การตรวจระดับเดิมพันของแต่ละเกมจากหน้าเกมโดยตรง และการตรวจเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#1f5a16] border-l-[#fde90e] bg-[#0b1408]/94 px-6 py-4 shadow-[0_10px_30px_rgba(3,6,2,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#5df53a] to-[#0c6d10] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e9f0dd]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#1f5a16] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fde90e]" : "text-[#1f5a16]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e9f0dd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#35d413]/50 bg-[#050803] px-3 py-1 text-[10px] font-bold tracking-widest text-[#5df53a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#1f5a16] bg-[#0b1408]/94 p-5 shadow-[0_10px_30px_rgba(3,6,2,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fde90e]/70 hover:shadow-[0_15px_40px_rgba(253,233,14,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fde90e]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#35d413]/20"
          />

          <div class="flex items-center gap-4 border-b border-[#1f5a16] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fde90e]/65 bg-gradient-to-br from-[#fff89a] via-[#fde90e] to-[#a86f02] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fbffe8] transition-colors group-hover:text-[#5df53a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e9f0dd]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fde90e]" : "text-[#1f5a16]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#35d413]/45 bg-[#050803] px-3 py-1 text-[10px] font-bold tracking-widest text-[#5df53a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fde90e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e9f0dd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
