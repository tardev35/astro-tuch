---
// Slot brand — every row stays inside what the brief names: การอ่าน Paytable,
// RTP, จำนวนเพย์ไลน์, Wild, Scatter, Free Spins และเงื่อนไขฟีเจอร์โบนัสก่อนเลือกเกม,
// การแบ่งทุน 100 ส่วนเพื่อคุมขนาดเดิมพัน, การตั้ง Stop Loss และ Stop Win ก่อนกด Spin,
// การสมัครและ Login ด้วยตัวเองผ่านมือถือ และการติดต่อแอดมินพร้อมแจ้งเวลาที่เกิดรายการ.
// The brief is explicit that no formula can force a slot result, so nothing here
// promises a payout, a win rate, or a product the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่อ่านข้อมูลเกมก่อนกด Spin",
    role: "เปิด Paytable และ RTP ทุกครั้งก่อนเลือกเกม",
    stars: 5,
    tag: "Paytable · RTP · ความผันผวน",
    content:
      "ก่อนเลือกเกมสล็อต PG จะไล่อ่านรายละเอียดให้ครบก่อน ทั้ง Paytable, RTP, จำนวนเพย์ไลน์หรือรูปแบบการจ่าย, Wild, Scatter, Free Spins และเงื่อนไขของฟีเจอร์โบนัส เพราะแต่ละเกมไม่ได้ใช้ระบบเหมือนกัน พอรู้ว่าเกมจ่ายรางวัลอย่างไรก็เลือกขนาดเดิมพันกับเงินทุนได้เหมาะกว่าการดูแค่คำว่าแตกง่าย",
    avatar: "📖",
  },
  {
    name: "สมาชิกที่แบ่งทุนก่อนเริ่มเล่นทุกรอบ",
    role: "ตั้ง Stop Loss และ Stop Win ไว้ล่วงหน้า",
    stars: 5,
    tag: "แบ่งทุน 100 ส่วน · Stop Loss · Stop Win",
    content:
      "ใช้วิธีตั้งงบเป็น 100 หน่วยตามคู่มือของ UFAFOX แล้วกำหนดขนาดเดิมพันให้อยู่ในระดับที่รับความผันผวนได้ พร้อมตั้งไว้ตั้งแต่ต้นว่าจะหยุดตรงไหนทั้งตอนเสียและตอนได้ วิธีนี้ไม่ได้ทำให้เกมจ่ายรางวัลมากขึ้น แต่ช่วยไม่ให้เพิ่มเดิมพันเพื่อไล่เอาเงินคืน",
    avatar: "🧮",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนรายการมีปัญหา",
    role: "แจ้งรายละเอียดและเวลาที่เกิดรายการ",
    stars: 4,
    tag: "แอดมิน UFAFOX หลังบ้าน",
    content:
      "ฝากแล้วเครดิตยังไม่เข้า เลยเช็กสถานะรายการในบัญชีก่อน จากนั้นทักแอดมิน UFAFOX พร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ ทำให้ตรวจสอบได้ตรงจุด ทีมงานยังย้ำว่าอย่าเปิดเผยรหัสผ่านหรือ OTP และให้ระวังคนที่อ้างว่ามีสูตรล็อกผลหรือรู้รอบแตกล่วงหน้า",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก UFAFOX" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e3e7ec] via-[#ffb266] to-[#f26a02] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffc48a]">UFAFOX</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f26a02] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#4a2409]/70 bg-[#140a05]/92 px-6 py-4 shadow-[0_10px_30px_rgba(242,106,2,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffb266] to-[#8c3a01] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9ba3ad] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a2409]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff9130]" : "text-[#4a2409]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ded4cb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#4a2409]/70 bg-[#140a05]/92 p-6 text-left shadow-[0_10px_30px_rgba(7,4,3,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f26a02]/70 hover:shadow-[0_15px_40px_rgba(242,106,2,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffb266] to-[#8c3a01] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8c3a01]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#f26a02]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#4a2409]/80 bg-[#070403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffc48a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff9130]" : "text-[#4a2409]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ded4cb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a2409] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f26a02]/55 bg-gradient-to-br from-[#ffb266] via-[#f26a02] to-[#8c3a01] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ffc48a] transition-colors group-hover:text-[#ff9130]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9ba3ad] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
