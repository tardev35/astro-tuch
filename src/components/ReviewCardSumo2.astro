// หินอ่อนสีงาช้างคือฉาก ไม่ใช่สีของ UI คนละชุด) · LINE green 00B900 กับเขียว
// success ของฟีดอยู่ไฟล์อื่น **คงไว้**
const reviews = [
  {
    name: "คุณธีรภัทร ว.",
    role: "ไล่อ่านกติกาเกม โปรโมชั่น และรายละเอียดบริการให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "บาคาร่า · สล็อตออนไลน์ · ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล · หวยออนไลน์",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอข้อมูลเกมคาสิโนออนไลน์หลากหลายประเภทไว้ในที่เดียว ทั้งบาคาร่า สล็อตออนไลน์ ไฮโล รูเล็ต ยิงปลา เดิมพันฟุตบอล และหวยออนไลน์ พร้อมระบบสมาชิกที่รองรับการใช้งานผ่านมือถือ จึงศึกษากติกาเกม โปรโมชั่น และรายละเอียดบริการได้จากเว็บไซต์เดียว แต่ละหมวดมีรูปแบบการเล่นและอัตราจ่ายไม่เหมือนกัน บาคาร่ากับรูเล็ตมีกติกาเฉพาะตัว ส่วนสล็อตออนไลน์แต่ละเกมก็มีฟีเจอร์แตกต่างกัน จึงต้องอ่านทีละหมวดจริง ๆ ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างเกี่ยวกับการเป็นเจ้าของระบบเกม เว็บตรง และลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน รวมถึงตรวจรายชื่อผู้พัฒนาเกม ความน่าเชื่อถือของระบบเซิร์ฟเวอร์ และนโยบายคุ้มครองข้อมูลส่วนบุคคลให้ชัดเจน เพราะคำกล่าวอ้างว่าใช้เซิร์ฟเวอร์แท้หรือปลอดภัยในไทย ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว",
    avatar: "👑",
    accent: "crimson" as const,
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "อ่านประกาศโปรโมชั่นประจำสัปดาห์ให้ครบ แล้วค่อยตรวจรอบคำนวณยอดอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ และมีประกาศอัปเดตในแต่ละสัปดาห์ให้ติดตามรายละเอียดการรับเครดิตและเงื่อนไขการเข้าร่วม ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าบาคาร่าสล็อต ไฮโล รูเล็ต ยิงปลา บอล หรือหวยประเภทใดเข้าร่วมรายการ รอบเวลาคำนวณยอดเป็นอย่างไร และต้องรับเครดิตด้วยวิธีใด เพราะการเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ส่วนโบนัสแนะนำเพื่อนก็ยังตรวจวิธีเชื่อมโยงบัญชี ฐานยอดที่ใช้คำนวณโบนัส และรอบจ่ายเครดิตให้ชัดเจน แม้จะระบุว่าไม่จำกัด แต่ควรตรวจสอบข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส และเงื่อนไขการถอนเงิน ที่ต้องเข้าใจตรงกันคือโปรโมชั่นคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป",
    avatar: "🏛️",
    accent: "surface" as const,
  },
  {
    name: "คุณอนุชา ก.",
    role: "ตรวจช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง",
    stars: 4,
    tag: "สมัครไม่มีขั้นต่ำ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.",
    content:
      "ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปตรวจสอบรายละเอียดเกม เปิดผ่านเบราว์เซอร์บนมือถือหรืออุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ตได้ตามที่เว็บไซต์ระบุ แต่ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชี ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ อีกจุดที่ตรวจไว้คือข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครหรือรวมถึงการฝากเงินและการเดิมพันด้วย ส่วนการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมเดิมพัน โปรโมชั่น และปัญหาการใช้งานบัญชี ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม จะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🃏",
    accent: "crimson" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8a1420] via-[#a30d1a] to-[#c21325] shadow-[0_0_12px_rgba(163,13,26,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#36080f] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#a30d1a]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#36080f]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมเจ็ดหมวดเกมที่เว็บไซต์ระบุไว้ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครไม่มีขั้นต่ำ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#eec3cc] border-l-[#a30d1a] bg-[#fdf5f6] px-6 py-4 shadow-[0_10px_30px_rgba(163,13,26,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#a30d1a]">{average}</span>
      <span class="text-sm font-black text-[#6b2b33]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#eec3cc] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#7a4a0c]" : "text-[#7a4a0c]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#36080f]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#eec3cc] bg-[#f7dfe4] px-3 py-1 text-[10px] font-bold tracking-wide text-[#6b2b33] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#eec3cc] bg-[#fdf5f6] p-5 shadow-[0_10px_30px_rgba(54,8,15,0.1)] transition-all duration-300 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(163,13,26,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#dca53a]/25 blur-[60px] transition-all duration-300 group-hover:bg-[#a30d1a]/20"
          />

          <div class="flex items-center gap-4 border-b border-[#eec3cc] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "crimson"
                  ? "border border-[#8a1420] bg-gradient-to-br from-[#8a1420] via-[#a30d1a] to-[#c21325] text-white"
                  : "border border-[#eec3cc] bg-gradient-to-br from-[#fdf5f6] to-[#f7dfe4] text-[#36080f]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#36080f] transition-colors group-hover:text-[#a30d1a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#6b2b33]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#7a4a0c]" : "text-[#7a4a0c]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#eec3cc] bg-[#f7dfe4] px-3 py-1 text-[10px] font-bold tracking-wide text-[#6b2b33] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c21325]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#36080f]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
