---
const reviews = [
  {
    name: "สมาชิกที่เล่นคาสิโนผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย หน้าจอปรับให้พอดีทุกขนาด ระบบรวมบาคาร่า คาสิโนสด รูเล็ต เสือมังกร แบล็กแจ็ก และสล็อตไว้ในบัญชีเดียว ตรวจสอบกติกา ฟีเจอร์ และอัตราเดิมพันของแต่ละเกมก่อนเริ่มเล่นได้จากที่เดียว",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามโบนัสและคืนยอดเสีย",
    role: "อ่านเงื่อนไขให้ครบก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "โบนัสและโปรโมชั่น",
    content:
      "หน้าโปรโมชั่นแสดงเปอร์เซ็นต์ วิธีคำนวณ รอบการรับ และข้อกำหนดของแต่ละรายการไว้ครบ ทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียสูงถึง 0.3% ทำให้ดูได้ว่ารายการไหนเข้าเงื่อนไขก่อนกดรับสิทธิ์",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนฝากถอน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอนจากทีมงาน",
    stars: 4,
    tag: "แอดมินช่วยตรวจสอบ",
    content:
      "ทำรายการฝากแล้วเครดิตยังไม่เข้า จึงแจ้งรายละเอียดและเวลาที่ทำรายการให้แอดมิน ทีมงานช่วยตรวจสอบสถานะและบอกขั้นตอนที่ต้องทำต่อจนจบ พร้อมอธิบายกติกาของเกมให้เข้าใจโดยไม่รับปากเรื่องผลกำไร",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BPLAY639" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f472b6] via-[#fdf2f8] to-[#fcd34d] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fdf2f8]">BPLAY639</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f472b6] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f472b6]/40 bg-[#2c0f45]/92 px-6 py-4 shadow-[0_10px_30px_rgba(244,114,182,0.16)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fdf2f8] to-[#ec4899] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#fcd34d]/80 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7e22ce]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f9a8d4]" : "text-[#7e22ce]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f2e3f7]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7e22ce]/60 bg-[#2c0f45]/92 p-6 text-left shadow-[0_10px_30px_rgba(10,3,19,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f472b6]/70 hover:shadow-[0_15px_40px_rgba(244,114,182,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fcd34d] to-[#f472b6] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#4c1d6b]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#f472b6]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7e22ce]/70 bg-[#150724] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf2f8] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ec4899]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f9a8d4]" : "text-[#7e22ce]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e3f7]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7e22ce] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f472b6]/45 bg-gradient-to-br from-[#ec4899] via-[#f472b6] to-[#4c1d6b] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f9a8d4] transition-colors group-hover:text-[#fdf2f8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#fcd34d]/80 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
