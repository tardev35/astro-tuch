---
// Lottery brand — every row stays inside what the brief names: หวยรัฐบาลไทย /
// ลาว / ฮานอย / ยี่กี่ / หุ้น ตามรอบที่เปิดรับ, การเลือกเลข กรอกยอดเดิมพัน ตรวจเรท
// แล้วยืนยันโพย, เรท 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ที่ต้องยึดตัวเลขในระบบ ณ
// เวลาส่งโพย, การสมัครและ Login ด้วยตัวเอง, ประวัติโพยในบัญชีสมาชิก และแอดมินที่
// ออนไลน์ตลอด 24 ชั่วโมง. Nothing here promises a payout, a rate, or a product
// the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่แทงหลายประเภทในระบบเดียว",
    role: "ดูรอบที่เปิดรับก่อนเลือกเลขทุกครั้ง",
    stars: 5,
    tag: "รัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น",
    content:
      "เข้ามาดูก่อนว่ารอบไหนเปิดรับอยู่ แล้วค่อยเลือกว่าจะแทงหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ หรือหวยหุ้น จากนั้นกรอกเลขกับยอดเดิมพันในระบบได้เลย ก่อนส่งโพยก็ไล่ดูเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินที่หน้าแทงแสดงอีกรอบ เพราะรายละเอียดของแต่ละประเภทและแต่ละรอบไม่เหมือนกัน",
    avatar: "🎱",
  },
  {
    name: "สมาชิกที่เช็กเรทก่อนกดยืนยันโพย",
    role: "ยึดอัตราจ่ายที่ระบบแสดง ณ เวลาส่งโพย",
    stars: 5,
    tag: "2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000",
    content:
      "ชอบตรงที่เรทเลข 2 ตัวและ 3 ตัวขึ้นให้อ่านชัดตั้งแต่ก่อนส่งโพย ทำให้คำนวณยอดล่วงหน้าได้ว่าถ้าแทง 10 บาทตามเรท 100 จะเป็นเท่าไหร่ แต่ก็ยังยึดตัวเลขที่ระบบแสดงตอนยืนยันเป็นหลัก เพราะเลขบางรายการหรือหวยบางประเภทอาจมีเงื่อนไขต่างออกไป",
    avatar: "🧮",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนรายการค้าง",
    role: "แจ้งประเภทหวย เวลา และจำนวนเงิน",
    stars: 4,
    tag: "แอดมินออนไลน์ 24 ชั่วโมง",
    content:
      "ฝากเครดิตแล้วยอดยังไม่ขึ้น เลยเข้าไปเช็กสถานะรายการในบัญชีสมาชิกก่อน จากนั้นทักแอดมินพร้อมแจ้งประเภทหวย เวลา จำนวนเงิน และรายละเอียดรายการ ทีมงานตรวจให้ได้ตลอด 24 ชั่วโมง แล้วยังย้ำว่าอย่าบอกรหัสผ่านหรือ OTP กับใคร",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HUAY928" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf1cd] via-[#dfb455] to-[#a87a1e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fdf1cd]">HUAY928</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dfb455] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#dfb455]/45 bg-[#04122b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(223,180,85,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7d979] to-[#a87a1e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8fa5c4] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2c4d84]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f7d979]" : "text-[#1d3a68]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d5e3f7]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2c4d84]/70 bg-[#04122b]/92 p-6 text-left shadow-[0_10px_30px_rgba(1,9,27,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#dfb455]/70 hover:shadow-[0_15px_40px_rgba(223,180,85,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7d979] to-[#12508f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#12508f]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#a87a1e]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2c4d84]/80 bg-[#01091b] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf1cd] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f7d979]" : "text-[#1d3a68]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d5e3f7]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2c4d84] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dfb455]/50 bg-gradient-to-br from-[#f7d979] via-[#dfb455] to-[#a87a1e] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dfb455] transition-colors group-hover:text-[#fdf1cd]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8fa5c4] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
