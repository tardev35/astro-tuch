// (d4922c / fdfc71 / f6e3b4 / a25b24 / 5a3310 / 33200a / 1f1304 / 0a0601 / 1a1000)
// ชุด **ทอง-เทา** ของ UFA324 (e5a81b / ffe08a / bb8410 / 7d5a07 / 8792a0 / f0e8d4 /
// b9c2cc / 464f5a) ชุด **แดงชาด-ทองเนย** ของมีเฮ168 (fb1b32 / ff8f9c / 5c0410 /
// fcd45c / 6b4a08 / 2b0711 / 1a040a / 0c0205) ชุด **ฟ้าไซยาน-เหลืองมะนาว** ของ
// นินจา168 (32bcfb / a9e9ff / fef54b / 07335f / 6b5c10 / 0c2a3d / 071a28 / 030e16 /
// 041019 / dceefc) ชุด **ชมพูบับเบิลกัม-ทองเนย** ของถอนชัวร์168 (fa63b9 / ffb3de /
// ffd84d / 2b0f20 / 1a0914 / 0d040a / 6d0b3f / 6b4708 / 2a0617 / fdeaf5) ชุด
// **ทองไทย-โรสโกลด์-แดงชาด** ของขวัญใจ168 (f7c92b / ffe6a3 / f2bba5 / c98a74 /
// b3121b / 5a0a0e / eadfce) ชุด **แดงมังกร-ทองไทย** ของสมหวัง168 (fa0513 / ffadaf /
// ff5a5f / e3b23c / ffe5a8 / 8a6210 / b90203 / 8c0204 / 5b0203 / 3c0303) ชุด
// **น้ำเงินไฟฟ้า-เงินโครเมียม** ของ TSDET911 (0360f3 / 0292fb / 6ec8ff / 4fb4ff /
// cfdcec / 9db4d4 / dde8f7 / 102a5e) ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 (039cfa /
// c3ebfc / 04366b / f9a826 / 704504 / e3f2fc / 0b2d52 / 071e38 / 030f1d) ชุดทอง
// น้ำผึ้ง-แดงชาดของ ดวงเศรษฐี168 (d9212a / 8e1a16 / f0c878 / fff8d8 / 2a0608 /
// 4e2120 / 300605 / 150303) ชุดทองอิมพีเรียลของรวยเทพ168 (f0bb4e / ffeccb / e4021b /
// d9701a / 3b1b0e / 260d04 / 0d0501 / 5c2a06) ชุดทองของหวยคิง (cd9a2c / fdeb7c /
// ab7314 / f5e7c8 / fcd4c3 / 0c0b0a / 120a02 / 1c140b) และ CEO66 (020617 / 7e22ce /
// d946ef / f5d0fe / a855f7) — ออกครบทุกค่า
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/
// ไซยาน ไม่มีม่วง/ไวโอเลต ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีทองแดงไหม้** —
// **เงิน/โครเมียมรอบนี้มี** แต่เป็นชุด #e0e0df / #c0c0bf / #a1a09e เท่านั้น
const reviews = [
  {
    name: "คุณธนากร ว.",
    role: "ไล่ดูรูปแบบเกมสล็อตและโหมดทดลองเล่นฟรีให้จบก่อน แล้วค่อยตัดสินใจเดิมพันจริง",
    stars: 5,
    tag: "สล็อตออนไลน์ · ค่ายต่าง ๆ · ทดลองเล่นฟรี",
    content:
      "ที่ใช้งานต่อเพราะเว็บไซต์รวบรวมข้อมูลเกมสล็อตจากค่ายต่าง ๆ ไว้ในช่องทางเดียว ทั้งเกมแนวคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมสล็อตที่ใช้สัญลักษณ์พิเศษในการกำหนดผลรางวัล ทำให้เทียบกติกาเกมของแต่ละแบบได้ก่อนใช้งานโดยไม่ต้องไล่เปิดทีละหน้า ก่อนเริ่มเดิมพันจริงจะตรวจก่อนว่าเกมใดมีโหมดทดลองเล่นฟรีให้ใช้งาน เพราะโหมดดังกล่าวช่วยให้เข้าใจกติกาและการทำงานของฟีเจอร์ต่าง ๆ โดยไม่ต้องใช้เงินจริง ส่วนที่อยากกำกับไว้ให้ตรงกันคือผลจากการทดลองเล่นไม่ได้บ่งบอกถึงผลลัพธ์เมื่อเดิมพันจริง และควรตรวจสอบสถานะลิขสิทธิ์เกมจากข้อมูลทางการของค่ายผู้พัฒนา ไม่ใช่จากข้อความโฆษณาเพียงอย่างเดียว",
    avatar: "🎮",
    accent: "gold" as const,
  },
  {
    name: "คุณพิมพ์ชนก ส.",
    role: "อ่านประกาศล่าสุดของโปรโมชั่นให้ครบ แล้วค่อยตรวจรอบเวลารับเครดิตอีกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เงื่อนไขการใช้โบนัส",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือข้อมูลโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขในแต่ละวัน และโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ แต่ละรายการมีข้อกำหนดเกี่ยวกับยอดที่นำมาคำนวณ ประเภทเกมที่เข้าร่วม และรอบเวลารับเครดิตแตกต่างกัน จึงต้องดูรอบสรุปยอด วิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และรอบจ่ายเครดิตจากประกาศล่าสุดทุกครั้ง แม้โปรโมชั่นจะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง รวมถึงเงื่อนไขการใช้โบนัสและการถอนเงินก่อนเข้าร่วม ที่ต้องเข้าใจตรงกันคือเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือรับประกันผลกำไรในอนาคต",
    avatar: "🎁",
    accent: "chrome" as const,
  },
  {
    name: "คุณอรรถพล ม.",
    role: "ตรวจข้อมูลบัญชีรับเงินกับหลักฐานของผู้ให้บริการก่อนทำรายการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใคร",
    stars: 4,
    tag: "สมัครสมาชิก · ฝากถอน · ติดต่อแอดมิน 24ชม.",
    content:
      "ตอนเริ่มใช้งานได้อ่านคุณสมบัติผู้สมัคร อายุที่กฎหมายอนุญาต และเงื่อนไขการใช้บริการจากเว็บไซต์ทางการก่อนสมัครสมาชิก รวมถึงนโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บและใช้ข้อมูลส่วนบุคคล จากนั้นจึงตั้งรหัสผ่านที่คาดเดาได้ยาก ยืนยันบัญชี แล้วเข้าสู่ระบบเพื่อศึกษารายชื่อเกมสล็อต กติกาการเล่น โหมดทดลองเล่น และรายละเอียดโปรโมชั่นที่เปิดให้บริการ ส่วนคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกม ความน่าเชื่อถือ และการไม่ใช้บัญชีม้า จะตรวจจากหลักฐานของผู้ให้บริการและข้อมูลบัญชีรับเงินที่ยืนยันได้เสมอ เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ โหมดทดลองเล่น รายการฝากถอน และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเตรียมหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "💬",
    accent: "gold" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e0e0df] via-[#fded41] to-[#9f600d] shadow-[0_0_12px_rgba(253,237,65,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f4ead6] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#fded41]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#d6c6a8]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตจากค่ายต่าง ๆ ทั้งเกมแนวคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมที่ใช้สัญลักษณ์พิเศษ โหมดทดลองเล่นฟรี โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครสมาชิกและรายการฝากถอน พร้อมช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#eeae12]/35 border-l-[#eeae12] bg-[#32200f] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.5)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fded41] to-[#eeae12] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#eeae12]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#9f600d] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fded41]" : "text-[#fded41]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f4ead6]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#eeae12]/50 bg-[#1f1308] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fded41] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#eeae12]/30 bg-[#3a2713] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-[#fded41]/75 hover:shadow-[0_15px_40px_rgba(253,237,65,0.2)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e0e0df]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#fded41]/22"
          />

          <div class="flex items-center gap-4 border-b border-[#9f600d]/70 pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "gold" ? "border border-[#9f600d] bg-gradient-to-br from-[#fded41] to-[#eeae12] text-[#1f0f04]" : "border border-[#a1a09e] bg-gradient-to-br from-[#e0e0df] to-[#a1a09e] text-[#1f0f04]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f4ead6] transition-colors group-hover:text-[#fded41]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#c0c0bf]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fded41]" : "text-[#fded41]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#eeae12]/45 bg-[#1f1308] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fded41] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fded41]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f4ead6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
