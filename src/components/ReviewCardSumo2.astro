---
// Slot only — the brief names สล็อตหลายค่ายและหลายระดับการเดิมพัน, เกมเบทต่ำ,
// เกมโบนัส, สล็อตแจ็คพอต, เกมใหม่, การตรวจกติกา เพย์ไลน์ ฟีเจอร์ และช่วงเดิมพัน,
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ตามเงื่อนไข, การสมัคร ฝากแรก และแอดมิน
// 24 ชั่วโมง. Nothing here promises a payout, an RTP figure, or a game the brief
// does not state.
const reviews = [
  {
    name: "สมาชิกที่ปั่นสล็อตเบทต่ำผ่านมือถือเป็นหลัก",
    role: "เลือกช่วงเดิมพันให้พอดีกับเงินทุนของตัวเอง",
    stars: 5,
    tag: "สล็อตเบทต่ำ",
    content:
      "เปิดผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม ในระบบมีเกมหลายระดับการเดิมพัน รวมถึงเกมที่เริ่มต้นเดิมพันในจำนวนต่ำ โดยขั้นต่ำต่างกันตามเกมและผู้ให้บริการ จึงดูช่วงเดิมพันที่แสดงในเกมก่อนเริ่มเล่นทุกครั้ง",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่อ่านเงื่อนไขโบนัสก่อนกดรับ",
    role: "ตรวจยอดที่เข้าร่วมและรอบรับก่อนกดรับสิทธิ์",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "โบนัส 0.8% เป็นโปรแนะนำเพื่อนสำหรับรายการที่เข้าเงื่อนไข ส่วน 0.3% เป็นโปรคืนยอดเสียตามรอบที่กำหนด ในบัญชีสมาชิกแสดงยอดที่ใช้คำนวณและโบนัสที่มีสิทธิ์รับให้ตรวจก่อน จึงเห็นวิธีคำนวณและรอบรับของแต่ละรายการชัดเจนก่อนตัดสินใจ",
    avatar: "🤝",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนฝากถอน",
    role: "แจ้งเวลาและรายละเอียดรายการแล้วได้รับการตรวจสอบ",
    stars: 4,
    tag: "แอดมินดูแล 24 ชั่วโมง",
    content:
      "ฝากเงินแล้วเครดิตยังไม่เข้า จึงตรวจสถานะธุรกรรมในบัญชีก่อนแล้วแจ้งเวลาและรายละเอียดให้แอดมิน ทีมงานช่วยตรวจสอบรายการและแนะนำขั้นตอนแก้ไขจนจบ พร้อมย้ำว่าผลของเกมสล็อตไม่แน่นอนและไม่มีการรับประกันกำไร ควรกำหนดงบประมาณก่อนเล่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PLUSPSG" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff6e0] via-[#fbbf14] to-[#e2060a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fff6e0]">PLUSPSG</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2060a] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e2060a]/40 bg-[#140502]/92 px-6 py-4 shadow-[0_10px_30px_rgba(226,6,10,0.16)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff6e0] to-[#e2060a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c2a878] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a0304]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbbf14]" : "text-[#240803]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e9d6ac]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7a0304]/65 bg-[#140502]/92 p-6 text-left shadow-[0_10px_30px_rgba(11,4,2,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e2060a]/70 hover:shadow-[0_15px_40px_rgba(226,6,10,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbbf14] to-[#e2060a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#240803]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#e2060a]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7a0304]/70 bg-[#0b0402] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff6e0] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e2060a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fbbf14]" : "text-[#240803]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e9d6ac]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a0304] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e2060a]/45 bg-gradient-to-br from-[#ff4b18] via-[#e2060a] to-[#7a0304] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fbbf14] transition-colors group-hover:text-[#fff6e0]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c2a878] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
