---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นแบรนด์รวมเกมคาสิโนหลายหมวด ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง:
// บาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดจากผู้ให้บริการต่างประเทศที่รวมไว้ในระบบ
// เดียว, ระบบจัดหมวดหมู่ให้ค้นหาได้ง่ายพร้อมตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และ
// รูปแบบเดิมพันก่อนเข้าเล่นได้จากหน้าเดียว, เครดิตฟรีและโปรโมชั่นตามเงื่อนไขที่กำหนด
// โดยมีโบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และ
// ข้อกำหนดก่อนกดรับ, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน, การรองรับมือถือและคอมพิวเตอร์
// และเจ้าหน้าที่ผ่าน LINE OFFICIAL ตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้างชื่อค่ายเกม
// ชื่อเกม ค่า RTP ช่องทางฝากถอน ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// KINGDOM66 (รอบทอง-ดำ 2026-09-25): แถบระบุตัวสมาชิกไล่จากทองสว่าง #f2d683 ลงทอง
// แบรนด์ #e6bf4e ไปหาทองลึก #5c4113 ตามเลข 66 บนโลโก้ที่เป็นทองเต็มดวง ส่วนดาวรับทอง
// สว่างและป้ายแท็กรับครีมแพลตินัมอุ่น #efe6cf ตามคำว่า KINGDOM ที่เป็นทองแกะสลักด้าน
// กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #241c13 บนผิวการ์ด #151109 เหนือพื้นเพจ #050403
// เนื้อความเป็น BRAND_TEXT #ebe3d3 และตัวเน้นเป็น #fdf6e0 — ชุดทอง-เงินโครเมียมเย็น
// ของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec #161106 #26200e #080602 #ece6d8
// #fff8e6) ออกทั้งหมด แบรนด์นี้ไม่มีสีเงินเย็นอยู่เลย
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดจากบัญชีเดียว",
    stars: 5,
    tag: "รวมทุกหมวดไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมคาสิโนหลายรูปแบบไว้ในระบบเดียวจริง ทั้งบาคาร่า ไพ่ สล็อต หวย บอล และเกมไลฟ์สดจากผู้ให้บริการต่างประเทศตามรายการที่เปิดให้บริการ ระบบจัดหมวดหมู่ไว้จนค้นหาหมวดที่สนใจได้เร็ว เปิดจากมือถือหรือคอมพิวเตอร์ก็เลือกหมวดเกมได้จากบัญชีเดียวเหมือนกัน",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันก่อนเข้าเล่น",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ชอบตรงที่ตรวจสอบรายละเอียดเกม ค่ายที่ให้บริการ และรูปแบบเดิมพันได้จากหน้าเดียวก่อนกดเข้าเล่น ฝั่งโปรโมชั่นก็มีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งหน้าโปรโมชั่นแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และข้อกำหนดไว้ให้ตรวจก่อนกดรับทุกครั้ง ส่วนเครดิตฟรีก็เป็นไปตามเงื่อนไขที่กำหนด",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามผ่าน LINE OFFICIAL",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้แค่ 3 ขั้นตอนตามที่เว็บไซต์บอกไว้ พอยืนยันบัญชีเสร็จก็เข้าสู่ระบบเลือกเกมกับตรวจสอบโปรโมชั่นที่เปิดให้รับในแต่ละวันได้ทันที ติดตรงไหนเกี่ยวกับการสมัคร เครดิตฟรี โปรโมชั่น เกมไลฟ์สด หรือการใช้งานบัญชี ก็ถามเจ้าหน้าที่ผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💬",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2d683] via-[#e6bf4e] to-[#5c4113] shadow-[0_0_12px_rgba(230,191,78,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fdf6e0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e6bf4e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ebe3d3]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมบาคาร่า ไพ่ สล็อต หวย บอล และคาสิโนไลฟ์สดไว้ในบัญชีเดียว การค้นหาหมวดเกมจากระบบที่จัดหมวดหมู่ไว้ และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#241c13] border-l-[#e6bf4e] bg-[#151109]/94 px-6 py-4 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#efe6cf] to-[#e6bf4e] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ebe3d3]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#241c13] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2d683]" : "text-[#241c13]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ebe3d3]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#241c13] bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#efe6cf] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#241c13] bg-[#151109]/94 p-5 shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#e6bf4e]/70 hover:shadow-[0_15px_40px_rgba(230,191,78,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e6bf4e]/24 blur-[60px] transition-all duration-300 group-hover:bg-[#efe6cf]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#241c13] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e6bf4e]/65 bg-gradient-to-br from-[#f2d683] via-[#e6bf4e] to-[#5c4113] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fdf6e0] transition-colors group-hover:text-[#efe6cf]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ebe3d3]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f2d683]" : "text-[#241c13]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#efe6cf]/40 bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#efe6cf] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6bf4e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ebe3d3]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
