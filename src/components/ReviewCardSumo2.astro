---
const reviews = [
  {
    name: "สมาชิกที่เล่นผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม ระบบรวมเกมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร และแบล็กแจ็กจากหลายค่ายไว้ในบัญชีเดียว ตรวจสอบกติกา ฟีเจอร์ และอัตราเดิมพันของแต่ละเกมก่อนเริ่มเล่นได้จากที่เดียว",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ตรวจสอบโปรโมชั่นก่อนกดรับ",
    role: "อ่านยอดฝาก ยอดเทิร์น และเงื่อนไขการถอนให้ครบทุกครั้ง",
    stars: 5,
    tag: "โปรโมชั่นสมาชิกใหม่",
    content:
      "หลังสมัครระบบจะแสดงโปรโมชั่นที่บัญชีมีสิทธิ์รับ พร้อมรายละเอียดยอดฝาก ระยะเวลารับสิทธิ์ ยอดเทิร์น และเงื่อนไขการถอนของแต่ละรายการ ทำให้ดูได้ก่อนว่ารายการไหนเข้าเกณฑ์แล้วค่อยตัดสินใจกดรับ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนฝากถอน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอนผ่าน LINE Official",
    stars: 4,
    tag: "แอดมินช่วยตรวจสอบ",
    content:
      "ทำรายการฝากแล้วเครดิตยังไม่เข้า จึงแจ้งรายละเอียดและเวลาที่ทำรายการให้แอดมินผ่าน LINE Official ทีมงานช่วยตรวจสอบสถานะและบอกขั้นตอนที่ต้องทำต่อจนจบ พร้อมอธิบายกติกาของเกมให้เข้าใจโดยไม่รับปากเรื่องผลกำไร",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JADTEM88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#3b82f6] via-[#f1f5f9] to-[#cbd5e1] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f1f5f9]">JADTEM88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3b82f6] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#3b82f6]/40 bg-[#0f1e3d]/92 px-6 py-4 shadow-[0_10px_30px_rgba(59,130,246,0.16)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f1f5f9] to-[#2563eb] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#cbd5e1]/80 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#1d4ed8]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#60a5fa]" : "text-[#1e3a6b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cbd5e1]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#1d4ed8]/60 bg-[#0f1e3d]/92 p-6 text-left shadow-[0_10px_30px_rgba(3,6,15,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#3b82f6]/70 hover:shadow-[0_15px_40px_rgba(59,130,246,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#cbd5e1] to-[#3b82f6] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#132447]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#3b82f6]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#1d4ed8]/70 bg-[#0a142c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f1f5f9] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2563eb]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#60a5fa]" : "text-[#1e3a6b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#cbd5e1]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#1d4ed8] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3b82f6]/45 bg-gradient-to-br from-[#2563eb] via-[#3b82f6] to-[#1d4ed8] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#60a5fa] transition-colors group-hover:text-[#f1f5f9]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#cbd5e1]/80 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
