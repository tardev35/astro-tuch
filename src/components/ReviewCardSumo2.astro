  {
    name: "คุณอรรถพล ม.",
    role: "เก็บหลักฐานการทำรายการ และติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเท่านั้น",
    stars: 4,
    tag: "ฝากถอน · ธนาคารและวอลเลท · LINE Official",
    content:
      "เว็บไซต์นำเสนอข้อมูลช่องทางทำรายการฝากถอนผ่านธนาคารและวอลเลท ทำให้ตรวจสอบรูปแบบการชำระเงินที่รองรับได้ก่อนดำเนินการ สิ่งที่ควรศึกษาคือรายชื่อธนาคารและบริการวอลเลทที่เปิดใช้งานจริง รวมถึงยอดขั้นต่ำ ระยะเวลาดำเนินการ และเงื่อนไขการถอนเงินให้ครบถ้วน หากพบรายการล่าช้าหรือสถานะไม่ถูกต้อง ควรเก็บหลักฐานการทำรายการและติดต่อเจ้าหน้าที่ผ่านช่องทางทางการ โดยไม่ส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ฝั่งการติดต่อ เว็บไซต์ระบุช่องทาง LINE Official สำหรับสอบถามรายละเอียดโปรโมชั่นแนะนำเพื่อน 0.8% โปรโมชั่นคืนยอดเสีย 0.3% รวมถึงปัญหาการสมัครสมาชิกและรายการฝากถอน ควรตรวจสอบลิงก์หรือ QR Code จากเว็บไซต์ทางการก่อนเพิ่มเพื่อน เพื่อหลีกเลี่ยงบัญชีที่แอบอ้างชื่อบริการ และควรยืนยันเวลาให้บริการกับระยะเวลาตอบกลับล่าสุดจากช่องทางทางการอีกครั้ง",
    avatar: "🏦",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้เล่น ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a9e9ff] via-[#32bcfb] to-[#07335f] shadow-[0_0_12px_rgba(50,188,251,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#dceefc] uppercase sm:text-3xl">
        เสียงจากผู้เล่น <span class="text-[#32bcfb]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#a9e9ff]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมโปรโมชั่นแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ลิงก์แนะนำกับรอบจ่ายโบนัส การฝากถอนผ่านธนาคารและวอลเลท พร้อมช่องทาง LINE Official ที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#32bcfb]/30 border-l-[#07335f] bg-[#071a28] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fef54b] to-[#32bcfb] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#a9e9ff]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#6b5c10] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fef54b]" : "text-[#fef54b]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dceefc]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#6b5c10] bg-[#030e16] px-3 py-1 text-[10px] font-bold tracking-widest text-[#a9e9ff] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#32bcfb]/25 bg-[#0c2a3d] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#32bcfb]/70 hover:shadow-[0_15px_40px_rgba(50,188,251,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#07335f]/40 blur-[60px] transition-all duration-300 group-hover:bg-[#07335f]/60"
          />

          <div class="flex items-center gap-4 border-b border-[#6b5c10] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#6b5c10] bg-gradient-to-br from-[#a9e9ff] via-[#32bcfb] to-[#fef54b] text-2xl text-[#041019] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#dceefc] transition-colors group-hover:text-[#32bcfb]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a9e9ff]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fef54b]" : "text-[#fef54b]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#32bcfb]/45 bg-[#030e16] px-3 py-1 text-[10px] font-bold tracking-widest text-[#a9e9ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fef54b]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dceefc]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
