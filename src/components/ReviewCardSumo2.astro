---
// Slot brand — every row stays inside what the brief names: การเล่นสล็อต
// ออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์, เกมสล็อตหลายรูปแบบให้เลือก,
// การ Login เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต และดูประวัติรายการ, ผลลัพธ์ของเกม
// สล็อตที่ไม่แน่นอนและการกำหนดงบประมาณของตัวเอง, โบนัสแนะนำเพื่อน 0.8% ที่ผู้ถูก
// แนะนำต้องมีรายการตามข้อกำหนด, คืนยอดเสีย 0.3% ตามรอบ, ระบบฝากถอนออโต้ และการ
// ติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่อ่านกติกาและช่วงเดิมพันก่อนหมุน",
    role: "ตั้งงบประมาณของตัวเองไว้ก่อนเริ่มเล่นทุกครั้ง",
    stars: 5,
    tag: "สล็อตออนไลน์ · ค้นหาเกม",
    content:
      "ในระบบมีเกมสล็อตหลายรูปแบบให้เลือก และค้นหาเกมกับเลือกค่ายได้สะดวกขึ้นหลังอัปเดต เลยไล่ดูกติกา ช่วงเดิมพัน และรายละเอียดของแต่ละเกมก่อนเริ่มหมุน เข้าใจตรงกันว่าเกมสล็อตมีผลลัพธ์ที่ไม่แน่นอน คำว่าแตกไวหรือกำไรดีจึงไม่ได้รับประกันผลการเล่น ต้องกำหนดงบประมาณเองให้ชัดเจน",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เช็กเงื่อนไขก่อนกดรับโบนัส",
    role: "อ่านยอดที่นำมาคำนวณและรอบการรับก่อนทุกครั้ง",
    stars: 5,
    tag: "โบนัส 0.8% · คืนยอดเสีย 0.3%",
    content:
      "แชร์ลิงก์แนะนำให้เพื่อนแล้วเข้าใจว่าการแชร์อย่างเดียวอาจยังไม่ได้โบนัส เพราะโปรกำหนดให้ผู้ถูกแนะนำต้องสมัครและมีรายการตรงตามข้อกำหนดก่อน ส่วนโบนัสคืนยอดเสีย 0.3% ก็ตรวจประเภทเกม รอบเวลา และเงื่อนไขการถอนโบนัสจากหน้าโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
    avatar: "🤝",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนรายการมีปัญหา",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดของรายการ",
    stars: 4,
    tag: "แอดมิน HIX168 หลังบ้าน",
    content:
      "ฝากแล้วเครดิตยังไม่เข้า เลยตรวจสถานะธุรกรรมในบัญชีก่อน จากนั้นทักแอดมิน HIX168 พร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดรายการ ทำให้ทีมงานหลังบ้านค้นหารายการและตรวจสอบปัญหาได้ตรงจุดตลอด 24 ชั่วโมง ทีมงานยังย้ำว่าไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HIX168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#cfd8e6]">HIX168</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#1e7bf5] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#1e7bf5]/40 bg-[#060c1c]/92 px-6 py-4 shadow-[0_10px_30px_rgba(30,123,245,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#8ec5ff] to-[#0a3fa8] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#7f8ea3] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#1e7bf5]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#1e7bf5]" : "text-[#16305e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d6e2f5]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#1e7bf5]/40 bg-[#060c1c]/92 p-6 text-left shadow-[0_10px_30px_rgba(1,3,13,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#6fb4ff]/70 hover:shadow-[0_15px_40px_rgba(30,123,245,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#8ec5ff] to-[#0a3fa8] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1e7bf5]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#cfd8e6]/22"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#1e7bf5]/45 bg-[#01030d] px-3 py-1 text-[10px] font-bold tracking-widest text-[#6fb4ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#1e7bf5]" : "text-[#16305e]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d6e2f5]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#1e7bf5]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#1e7bf5]/55 bg-gradient-to-br from-[#8ec5ff] via-[#1e7bf5] to-[#0a3fa8] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#6fb4ff] transition-colors group-hover:text-[#8ec5ff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#7f8ea3] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
