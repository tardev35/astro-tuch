---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บพนันรวมเกม ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง: บาคาร่า สล็อต
// หวย บอล รูเล็ต และหมวดเกมไลฟ์สดที่เชื่อมต่อจากผู้ให้บริการตามข้อมูลของเว็บไซต์,
// การตรวจสอบค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันก่อนเข้าเล่น, โบนัสแนะนำเพื่อน
// 0.8% กับโบนัสคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขก่อน
// กดรับ, การฝากถอนผ่านวอลเลทและธนาคารตามรายการที่เว็บไซต์เปิดให้ใช้งาน, การรองรับ
// มือถือและคอมพิวเตอร์จากบัญชีเดียว และแอดมินตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้าง
// ชื่อค่ายเกม ชื่อเกม ค่า RTP ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): แถบระบุตัวสมาชิกไล่จากแดงสว่าง
// #ff4d52 ลงแดงแบรนด์ #de161d ไปหาแดงลึก #7a0a0e ตามคำว่า GAME บนโลโก้ที่เป็นแดงสด
// ส่วนดาวรับแดงสว่างและป้ายแท็กรับเงินโครเมียม #e2e8ef ตามคำว่า MAHA กับเลข 66 ที่
// เป็นเงิน-ดำ กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #26100f บนผิวการ์ด #16090a เหนือ
// พื้นเพจ #080506 เนื้อความเป็น BRAND_TEXT #e8e3e1 และตัวเน้นเป็น #fff6f5 — ชุด
// ทอง-เขียว-แดงของ 888PARUAY (#fff6ae #fcdc2b #a87d0c #1fae1c #cf1111 #143a1c
// #0d2312 #07130a #e8e4c6 #fffdf0) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เล่นบาคาร่า สล็อต หวย บอล และรูเล็ตจากบัญชีเดียว",
    stars: 5,
    tag: "รวมทุกหมวดเกมไว้ในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมยอดนิยมไว้ครบจริง ทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต พร้อมหมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ เมนูจัดหมวดหมู่ชัดเจนจนเลือกเกมที่ต้องการได้เร็ว เปิดจากมือถือหรือคอมพิวเตอร์ก็เข้าใช้งานจากบัญชีเดียวได้เหมือนกัน",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันก่อนเข้าเล่น",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ชอบตรงที่ดูค่ายเกม รายละเอียดโต๊ะ และรูปแบบเดิมพันได้ก่อนกดเข้าเล่น เลยเลือกเกมที่ตรงกับความสนใจได้สะดวกขึ้น ฝั่งโปรโมชั่นก็มีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งระบบแสดงยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไขไว้ให้ตรวจก่อนกดรับทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ฝากถอนผ่านวอลเลทและธนาคาร แล้วเช็กสถานะจากบัญชี",
    stars: 4,
    tag: "วอลเลท-ธนาคาร · แอดมิน 24 ชั่วโมง",
    content:
      "เลือกช่องทางฝากถอนได้ตามรายการที่เว็บไซต์เปิดให้ใช้งาน ทั้งวอลเลทและธนาคาร ขั้นตอนถูกจัดให้เข้าใจง่ายและตรวจยอดกับสถานะรายการผ่านบัญชีได้โดยตรงจากหน้าเดียว ติดตรงไหนเกี่ยวกับการสมัคร ทางเข้าเกม โปรโมชั่น หรือระบบฝากถอน ก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4d52] via-[#de161d] to-[#7a0a0e] shadow-[0_0_12px_rgba(222,22,29,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff6f5] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#de161d]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#e8e3e1]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมบาคาร่า สล็อต หวย บอล รูเล็ต และหมวดเกมไลฟ์สดไว้ในระบบเดียว การตรวจสอบค่ายเกมกับรูปแบบเดิมพันก่อนเข้าเล่น และการฝากถอนผ่านวอลเลทกับธนาคารตามรายการที่เว็บไซต์เปิดให้ใช้งาน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#26100f] border-l-[#de161d] bg-[#16090a]/94 px-6 py-4 shadow-[0_10px_30px_rgba(8,5,6,0.82)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#e2e8ef] to-[#ff4d52] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e8e3e1]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#26100f] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff4d52]" : "text-[#26100f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8e3e1]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#26100f] bg-[#080506] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e2e8ef] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#26100f] bg-[#16090a]/94 p-5 shadow-[0_10px_30px_rgba(8,5,6,0.82)] backdrop-blur-xl transition-all duration-300 hover:border-[#de161d]/70 hover:shadow-[0_15px_40px_rgba(222,22,29,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#de161d]/24 blur-[60px] transition-all duration-300 group-hover:bg-[#e2e8ef]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#26100f] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#de161d]/65 bg-gradient-to-br from-[#ff4d52] via-[#de161d] to-[#7a0a0e] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff6f5] transition-colors group-hover:text-[#e2e8ef]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e8e3e1]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ff4d52]" : "text-[#26100f]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e2e8ef]/40 bg-[#080506] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e2e8ef] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#de161d]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e8e3e1]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
