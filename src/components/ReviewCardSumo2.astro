---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรง ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง:
// รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว, ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการ
// ใช้งานก่อนเริ่มเล่น, เข้าถึงแต่ละเมนูได้ง่ายทั้งบนมือถือและคอมพิวเตอร์, ระบบบัญชีและการ
// จัดการรายการผ่านบัญชีส่วนตัว, การตรวจสอบข้อมูล เงื่อนไข และช่องทางอย่างเป็นทางการก่อนทำ
// รายการ, โปรโมชั่นที่อัปเดตตามช่วงเวลาโดยมีโบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อม
// ยอดที่เข้าเกณฑ์และวิธีรับสิทธิ์, การสมัครด้วยตัวเองเพียง 3 ขั้นตอน และเจ้าหน้าที่ผ่านช่องทาง
// ไลน์ตลอด 24 ชั่วโมง ไม่มีข้อความไหนอ้างชื่อค่ายเกม ชื่อเกม ประเภทเกม ค่า RTP ชื่อธนาคาร
// ช่องทางฝากถอน ขั้นต่ำการเดิมพัน หรือรับปากว่าจะชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// BRAZIL999 (รอบเขียว-โครเมียม-ดำ 2026-09-25): โลโก้เป็นเวิร์ดมาร์กสองวัสดุ BRAZIL
// โครเมียม 999 เขียวสด การ์ดรีวิวจึงใช้เขียวกับโครเมียมแยกหน้าที่กัน — สันนำหน้าหัวข้อ ป้าย
// ระบุตัวสมาชิก และดาว เป็นเขียว (เขียวสว่าง #7cf25c → เขียวแบรนด์ #22c55e → เขียวลึก
// #0a6b18) ส่วนชื่อบล็อก คะแนนเฉลี่ย และป้ายแท็กรับโครเมียม (#f1f5f9 #aab4bf #6b7580)
// ตามคำว่า BRAZIL กรอบการ์ดกับเส้นคั่นเป็นผิวการ์ดยก #123a18 บนผิวการ์ด #0a1a0c เหนือ
// พื้นเพจ #040a05 เนื้อความเป็น BRAND_TEXT #dfeadd และตัวเน้นเป็น #f4fbf2 — ชุด
// ทอง-โครเมียมของ MIRACLE55 (#fee47b #fcda65 #8c5f14 #fcfcfc #d2d3d4 #a8acb1
// #2c241c #14100a #050403 #e8e6e1) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เข้าใช้งานผ่านระบบที่เชื่อมต่อจากบริษัทโดยตรง",
    stars: 5,
    tag: "บริษัทโดยตรง · บัญชีเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียวจริง ตามข้อมูลที่เว็บไซต์ระบุว่าเป็นระบบคาสิโนออนไลน์ที่เชื่อมต่อจากบริษัทโดยตรง เปิดดูรายละเอียดเกมและข้อมูลการใช้งานได้ก่อนเริ่มเล่น เข้าถึงแต่ละเมนูได้ง่ายทั้งจากมือถือและคอมพิวเตอร์โดยใช้บัญชีเดียวกัน",
    avatar: "🏢",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "ติดตามข่าวสารและโปรโมชั่นที่เว็บไซต์อัปเดตตามช่วงเวลาได้จากหน้าโปรโมชั่น มีทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งแต่ละรายการแสดงยอดที่เข้าเกณฑ์ รอบคำนวณ และวิธีรับสิทธิ์ไว้ให้ตรวจก่อนกดรับ ทำให้เลือกใช้สิทธิ์ได้ตรงกับเงื่อนไขของแต่ละรายการ",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามผ่านช่องทางไลน์",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · ไลน์ 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อนและใช้แค่ 3 ขั้นตอนตามที่เว็บไซต์บอกไว้ พอยืนยันบัญชีเสร็จก็เข้าสู่ระบบเพื่อตรวจสอบเกมและโปรโมชั่นที่เปิดให้รับได้ทันที ติดตรงไหนเกี่ยวกับการสมัคร โปรโมชั่น ทางเข้าเกม หรือการใช้งานบัญชี ก็ถามเจ้าหน้าที่ผ่านช่องทางไลน์ที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง ควรยึดช่องทางอย่างเป็นทางการก่อนทำรายการ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💬",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7cf25c] via-[#22c55e] to-[#0a6b18] shadow-[0_0_12px_rgba(34,197,94,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f4fbf2] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#22c55e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#dfeadd]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว การตรวจสอบรายละเอียดเกมและข้อมูลการใช้งานก่อนเริ่มเล่น และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับสิทธิ์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#123a18] border-l-[#22c55e] bg-[#0a1a0c]/94 px-6 py-4 shadow-[0_10px_30px_rgba(4,10,5,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f1f5f9] to-[#6b7580] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#dfeadd]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#123a18] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#22c55e]" : "text-[#123a18]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dfeadd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#123a18] bg-[#040a05] px-3 py-1 text-[10px] font-bold tracking-widest text-[#aab4bf] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#123a18] bg-[#0a1a0c]/94 p-5 shadow-[0_10px_30px_rgba(4,10,5,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#22c55e]/70 hover:shadow-[0_15px_40px_rgba(34,197,94,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#22c55e]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#aab4bf]/16"
          />

          <div class="flex items-center gap-4 border-b border-[#123a18] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#22c55e]/65 bg-gradient-to-br from-[#7cf25c] via-[#22c55e] to-[#0a6b18] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f4fbf2] transition-colors group-hover:text-[#aab4bf]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#dfeadd]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#22c55e]" : "text-[#123a18]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#aab4bf]/45 bg-[#040a05] px-3 py-1 text-[10px] font-bold tracking-widest text-[#aab4bf] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22c55e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dfeadd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
