// (รวยเทพ168) ไม่ใช่ dc0203 f5282a (หวย365) ไม่ใช่ ff3b14 6d0804 (FLASH877)
// ⚠️⚠️ **ชมพูบับเบิลกัมคือฮิวนำของ okkub88 ซึ่งเป็นแบรนด์ขาออกพอดี — เสี่ยงหลงเหลือ
// สูงสุด** ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55
// fb439b fc74b5 ffc2e2 d91a73 b01160 85094a + rgba 251/67/155, rgba 255/194/226,
// rgba 156/15/85, rgba 106/15/60, rgba 249/178/217 **ห้ามเหลือเด็ดขาด**
// **ฟ้าของ โบ๊ะบ๊ะ168 (N-2) ก็ห้ามทั้งหมด**: 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea
// 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 · และชมพูของ
// หมูบิน168: fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8
// ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463
// **ทองของแบรนด์เก่าก็ห้ามทั้งหมด** (ทองรอบนี้คือ **#f2a033 ค่าเดียว**): ffd94a
// e3a712 9d6f06 eeae12 fded41 f5ba14 fcee52 b37c0b fee45d e6a416 b8780d fbc134
// ffe87a d4922c fdfc71 fdcb0c fefb6b fcd434 ffc82e e5a81b ffe08a f9a826 f7c92b
// ⚠️ **วัสดุที่สองรอบนี้คือพีช/ฟางอุ่น R>G>B (#fed7b5 / #fec28d / #fde4d3)
// ไม่ใช่ครีมเย็นและไม่ใช่เทาเงิน** — d9dfe9 b3bdd6 (มาดาม168) f4e4d3 e4cbb3
// (ร่ำรวย168) ecd5c4 d2b9a4 (เงินทอง168) eadfce (ขวัญใจ168) f4ead6 d6c6a8 e0e0df
// c0c0bf a1a09e (พักยก168) e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) **ห้ามกลับเข้ามา**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/แมเจนต้า ไม่มีม่วง/ไวโอเลต ไม่มี
// โรสโกลด์ และไม่มีแรมป์เทาเงิน** (เหรียญทอง ซอมเบรโรฟาง ปอนโช กระบองเพชร ฉาก
// อะโดบีครีม และสีผิวนักแสดงเป็น **วัตถุในภาพ** ไม่ใช่สีแบรนด์ และ **"SLOT"
// สีน้ำเงินในเวิร์ดมาร์กก็เป็นอาร์ตเวิร์ก ไม่ใช่สี UI**)
const reviews = [
  {
    name: "คุณชัชวาล พ.",
    role: "ไล่อ่านกติกาเกมและอัตราการจ่ายรางวัลให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "สล็อตเมกซิกัน · สล็อตคลาสสิก · เกมโบนัส · เกมที่มีฟีเจอร์พิเศษ",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอเกมสล็อตออนไลน์ภายใต้คอนเซปต์สล็อตเมกซิกัน ที่เน้นบรรยากาศสนุกสนานและรูปแบบเกมหลากหลาย ทั้งสล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ทำให้ศึกษารายละเอียดเกม กติกา และโปรโมชั่นได้ในช่องทางเดียว ก่อนสมัครสมาชิกจึงไล่ดูชื่อบริษัท รายละเอียดผู้ให้บริการเกม และหลักฐานความเกี่ยวข้องกับค่ายเกม รวมถึงกติกาเกม อัตราการจ่ายรางวัล และข้อกำหนดการใช้งาน เพื่อประกอบการพิจารณาความน่าเชื่อถือของเว็บไซต์ ส่วนที่อยากกำกับไว้ให้ตรงกันคือข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการก่อนใช้งาน เช่นเดียวกับคำกล่าวอ้างว่าไม่ผ่านเอเย่นต์หรือยอดเงินเข้าบริษัทโดยตรง ซึ่งจำเป็นต้องมีข้อมูลที่ตรวจสอบได้ประกอบ",
    avatar: "🎸",
    accent: "fiesta" as const,
  },
  {
    name: "คุณนฤมล จ.",
    role: "อ่านประกาศโปรโมชั่นล่าสุดให้ครบ แล้วค่อยตรวจรอบจ่ายเครดิตอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด ต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัส เพราะแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และเงื่อนไขการถอนเงินแตกต่างกัน แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดก่อนตัดสินใจ ที่ต้องเข้าใจตรงกันคือเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป",
    avatar: "🌶️",
    accent: "adobe" as const,
  },
  {
    name: "คุณเกรียงไกร ส.",
    role: "ตรวจช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง",
    stars: 4,
    tag: "สมัครด้วยตัวเอง 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.",
    content:
      "ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปตรวจสอบรายละเอียดเกม ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชี คุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมสล็อต และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมหรือบัญชีสมาชิก จะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "🌺",
    accent: "fiesta" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#de2b1e] via-[#f2a033] to-[#fed7b5] shadow-[0_0_12px_rgba(222,43,30,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#3f130d] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#a81410]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#3f130d]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตออนไลน์ภายใต้คอนเซปต์สล็อตเมกซิกัน โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครด้วยตัวเอง 3 ขั้นตอน และช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#f6c4a4] border-l-[#de2b1e] bg-[#fff3ea] px-6 py-4 shadow-[0_10px_30px_rgba(168,20,16,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#a81410]">{average}</span>
      <span class="text-sm font-black text-[#80453a]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#f6c4a4] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#a81410]" : "text-[#a81410]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#3f130d]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#f6c4a4] bg-white px-3 py-1 text-[10px] font-bold tracking-wide text-[#80453a] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#f6c4a4] bg-white p-5 shadow-[0_10px_30px_rgba(63,19,13,0.1)] transition-all duration-300 hover:border-[#de2b1e] hover:shadow-[0_15px_40px_rgba(222,43,30,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#de2b1e]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#de2b1e]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#f6c4a4] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "fiesta"
                  ? "border border-[#6f0e08] bg-gradient-to-br from-[#c81e12] to-[#9d140c] text-white"
                  : "border border-[#f6c4a4] bg-gradient-to-br from-white to-[#fde4d3] text-[#3f130d]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#3f130d] transition-colors group-hover:text-[#a81410]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#80453a]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#a81410]" : "text-[#a81410]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f6c4a4] bg-[#fff3ea] px-3 py-1 text-[10px] font-bold tracking-wide text-[#80453a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#de2b1e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#3f130d]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
