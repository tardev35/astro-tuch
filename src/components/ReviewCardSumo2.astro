---
import { BRAND_NAME } from "../lib/brandProfile";

// HI59 (2026-10-07): บรีฟรอบนี้เป็น **เว็บสล็อตไฮคลาส** ทุกแถวจึงถูกเขียนใหม่ทั้งหมด
// จากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคของรอบ หวยดีใจ ก่อนหน้า
// ซึ่งเป็นเว็บรับแทงหวยล้วน (รัฐบาลไทย ลาว ฮานอย ออมสิน ธ.ก.ส. ส่งโพย อัตราจ่าย
// 2 ตัว 3 ตัว แนวทาง สถิติย้อนหลัง)
//
// กรอบที่บรีฟระบุไว้เองคือ: รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว มีทั้งสล็อตยอดนิยม
// เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ · รองรับมือถือและ
// คอมพิวเตอร์ · เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการ ·
// สลับเกมและค่ายผ่านบัญชีเดียวโดยไม่ต้องสมัครใหม่ · คืนยอดเสีย 0.3% · แนะนำเพื่อน
// 0.8% · ฝากถอนตามช่องทางที่ระบบเปิดให้บริการ · แอดมิน 24 ชั่วโมง · ไม่เปิดเผย PIN
// รหัสผ่าน หรือ OTP
//
// คำหวยของรอบก่อนถูกถอดออกทั้งชุดตาม brand-spec §7 — ไม่เหลือแม้คำเดียว และห้ามใส่
// ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ จำนวน
// สมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้คือ 0.3% ·
// 0.8% · 100% · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคงประโยคกำกับของบรีฟ
// เองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 ฟ้า-ทอง บนการ์ดสว่าง): สีหลักคือ **ฟ้า** และสีคู่คือ
// **ทอง** บนผิวกระจกน้ำแข็ง #f6fbff ไม่ใช่ผิวเกือบดำแบบทุกแบรนด์ก่อนหน้า — ฟ้าแบรนด์
// #0a84e0 เป็นตัวระบุตัวตนของบล็อกนี้ แต่ถูกใช้เป็นสีถม/ขอบ/เรืองเท่านั้น ไม่เคยเป็น
// สีตัวอักษรเล็ก (4.0:1 บนพื้นสว่าง) สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่ฟ้าลึก #065a9c →
// #044b80 → #033f70 บนหมึกสว่าง #eaf5ff (พื้นฟ้าเข้มต้องใช้หมึกสว่างเสมอ ตามกฎ
// คอนทราสต์ §2) คะแนนเฉลี่ยไล่กรมท่าหัวข้อ #06355f → ฟ้าลึก #065a9c ส่วนทองเป็นสีคู่
// และถูกใช้เฉพาะจุดที่ควรเป็นทองจริงๆ คือชื่อแบรนด์กับดาวที่ติด (ตัวเลข 59 ทองใน
// โลโก้) โดยใช้ทองหมึก #8a6102 ไม่ใช่ทองแบรนด์ #fdbc04 ซึ่งบนพื้นสว่างอ่านไม่ออก
// ออรามุมขวาบนเป็นทองโปร่งตัดกับตัวตนสีฟ้าของการ์ด ดาวที่ยังไม่ติดใช้ฟ้าขอบการ์ด
// #9ecbf2 กรอบการ์ดเป็นเส้นไรผม #9ecbf2 ชิปตกลงไปที่ผิวรอง #e7f2fd เนื้อความและ
// ชื่อสมาชิก #0d2744 (= BRAND_TEXT) ตัวรองใช้สีหม่นบนพื้นสว่าง #35587d
// glow เป็น rgba(10,132,224,…) / rgba(200,138,2,…)
//
// ชุดแดงแบรนด์ + เงินโครเมียมของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#dc0409 #f5363d
// #8e0206 #4b0205 #17080c #0d0407 #eef0f4 #c3c7d1 #8d93a1 #f3c54e #edeaf0
// rgba(220,4,9,…) rgba(195,199,209,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "สลับเกมและค่ายผ่านบัญชีเดียว ทั้งมือถือและคอมพิวเตอร์",
    stars: 5,
    tag: "ค่ายเกมพรีเมียม · สล็อตยอดนิยม · เกมเปิดใหม่ · บัญชีเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ รองรับการเข้าเล่นผ่านมือถือและคอมพิวเตอร์ เลยสลับเกมและค่ายได้โดยไม่ต้องสมัครใหม่หลายครั้ง เปิดมาก็เลือกค่าย ค้นหาเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้สะดวก แต่ละเกมมีรูปแบบวงล้อ ฟีเจอร์โบนัส ฟรีสปิน และช่วงเดิมพันต่างกัน จึงตรวจสอบรายละเอียดเกมก่อนเริ่มเล่นได้ ส่วนการระบุว่าเป็นเว็บตรงหรือลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับอย่างชัดเจน ไม่ควรดูจากข้อความประชาสัมพันธ์อย่างเดียว",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจรอบตัดยอดและค่ายที่ร่วมรายการก่อนกดรับสิทธิ์",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์",
    content:
      "ชอบที่ Login เข้าไปตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และรอบรับสิทธิ์ผ่านบัญชีได้เอง ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามข้อกำหนดจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัส 0.3% ที่รับได้ ส่วนแนะนำเพื่อนก็แชร์ลิงก์ให้เพื่อน พอเพื่อนสมัครและมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส 0.8% จากยอดที่เข้าเกณฑ์ และดูจำนวนเพื่อน ยอดคำนวณ กับสถานะโบนัสจากบัญชีสมาชิกได้ตามรอบ ข้อที่อยากให้อ่านกันก่อนคือทั้งสองโปรโมชั่นอาจมีรอบคำนวณและค่ายเกมที่ร่วมรายการแตกต่างกัน จึงควรตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขล่าสุดก่อนกดรับสิทธิ์ทุกครั้ง ส่วนคำว่าโบนัสสูง ให้เยอะกว่าใคร ก็ควรมีข้อมูลเปรียบเทียบรองรับ",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "ตรวจชื่อบัญชีปลายทางก่อนยืนยัน แล้วแจ้งแอดมิน",
    stars: 4,
    tag: "ฝากถอน · ยอดเข้าบริษัทตรง · ประวัติรายการ · แอดมิน 24 ชั่วโมง",
    content:
      "ฝากถอนทำตามช่องทางที่ระบบเปิดให้บริการ ทุกครั้งจะตรวจสอบตัวเลือกการทำรายการ ชื่อบัญชี จำนวนเงิน และรายละเอียดปลายทางก่อนยืนยัน ถ้าเว็บไซต์ระบุว่าเงินเข้าบัญชีบริษัทโดยตรง ก็ควรมีชื่อนิติบุคคลและข้อมูลบริษัทที่นำไปตรวจสอบเทียบกับชื่อบัญชีปลายทางได้ และคำว่าฝากถอนได้ทุกช่องทางควรหมายถึงเฉพาะช่องทางที่ระบบรองรับจริง ตอนสมัคร Login ไม่ผ่าน เข้าเกมสล็อตไม่ได้ เครดิตไม่แสดง โปรโมชั่นไม่ถูกคำนวณ หรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ก็ติดต่อแอดมินผ่านช่องทางบริการหลักที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องเกมเตรียมชื่อเกม ค่าย และเวลาที่เกิดเหตุไว้ ส่วนรายการฝากถอนเตรียมเวลา จำนวนเงิน และหลักฐานธุรกรรม และไม่ควรเปิดเผย PIN รหัสผ่าน หรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#065a9c] via-[#044b80] to-[#033f70] shadow-[0_0_12px_rgba(10,132,224,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#06355f] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#8a6102]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#35587d]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ และการฝากถอนพร้อมติดต่อ
        แอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#9ecbf2] border-l-[#0a84e0] bg-[#f6fbff] px-6 py-4 shadow-[0_10px_30px_rgba(6,53,95,0.16)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#06355f] to-[#065a9c] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#35587d]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#9ecbf2] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#c88a02]" : "text-[#9ecbf2]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#0d2744]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#c88a02]/55 bg-[#e7f2fd] px-3 py-1 text-[10px] font-bold tracking-widest text-[#8a6102] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#9ecbf2] bg-[#f6fbff] p-5 shadow-[0_10px_30px_rgba(6,53,95,0.16)] backdrop-blur-xl transition-all duration-300 hover:border-[#0a84e0]/80 hover:shadow-[0_15px_40px_rgba(10,132,224,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fdbc04]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#ffe27a]/45"
          />

          <div class="flex items-center gap-4 border-b border-[#9ecbf2] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#065a9c]/70 bg-gradient-to-br from-[#065a9c] via-[#044b80] to-[#033f70] text-2xl text-[#eaf5ff] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#0d2744] transition-colors group-hover:text-[#8a6102]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#35587d]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#c88a02]" : "text-[#9ecbf2]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c88a02]/55 bg-[#e7f2fd] px-3 py-1 text-[10px] font-bold tracking-widest text-[#8a6102] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#0a84e0]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#0d2744]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
