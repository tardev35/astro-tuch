---
// PREMSUK365 is a เว็บแทงหวยออนไลน์ brand — every row stays inside what the brief
// states: การรับเลขดังและเลขอั้นตามวงเงินที่ระบบเปิดรับ, การแสดงอัตราจ่ายให้ตรวจสอบ
// ก่อนส่งโพย, การเลือกเลขและกำหนดยอดเอง, การเช็กบิลย้อนหลังได้ด้วยตัวเอง, ระบบฝากถอน
// ออโต้ผ่านวอลเลทและธนาคารที่รองรับ, การติดตามสถานะและประวัติธุรกรรม และการแจ้ง
// แอดมินพร้อมประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม.
// The only rates quoted anywhere are the brief's own 2 ตัวบาทละ 100 และ 3 ตัวบาทละ
// 1,000. Nothing here promises a payout, a win rate, or a product the brief does
// not state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ตรวจวงเงินที่ระบบรับได้ก่อนยืนยันโพยทุกครั้ง",
    stars: 5,
    tag: "เลขดัง · เลขอั้น",
    content:
      "มีเลขในใจอยู่แล้วเลยลองเข้ามาตรวจสอบการรับแทงก่อนส่งโพย ทั้งเลขดัง เลขกระแส และเลขที่รอบนั้นมีคนเลือกเยอะ ระบบแสดงวงเงินที่รับได้ให้เห็นก่อนกดยืนยัน ทำให้เห็นรายละเอียดของเลขและยอดเดิมพันชัดเจน ส่วนวงเงินรับจริงก็ยึดข้อมูลที่ระบบแสดงในรอบนั้นเป็นหลัก",
    avatar: "🔥",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ดูอัตราจ่ายบนหน้าส่งโพยก่อนกดยืนยันเสมอ",
    stars: 5,
    tag: "2 ตัวบาทละ 100 · 3 ตัวบาทละ 1,000",
    content:
      "ชอบที่มีอัตราจ่ายให้ตรวจสอบก่อนตัดสินใจ เรทที่ระบุไว้คือเลข 2 ตัวบาทละ 100 และเลข 3 ตัวบาทละ 1,000 คำนวณยอดเบื้องต้นได้ง่าย แต่ก่อนแทงก็ยังตรวจประเภทหวย เลขที่เลือก และอัตราจ่ายจริงในระบบอีกรอบ เพราะบางรอบหรือบางประเภทอาจมีเงื่อนไขเฉพาะของมันเอง",
    avatar: "🧮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "แจ้งประเภทหวย รอบเดิมพัน เวลา และรายละเอียดให้แอดมิน",
    stars: 4,
    tag: "ฝากถอนออโต้ · แจ้งแอดมิน",
    content:
      "ฝากผ่านวอลเลทแล้วเครดิตยังไม่เข้า เลยเช็กสถานะรายการและประวัติธุรกรรมในบัญชีสมาชิกก่อน จากนั้นทักแอดมินพร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา และรายละเอียดธุรกรรม ทำให้ตรวจสอบได้ตรงจุด ทีมงานยังย้ำให้เก็บข้อมูลบิลไว้จนกว่าจะตรวจเสร็จ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PREMSUK365" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#2a9d5c]">PREMSUK365</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3c56a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e3c56a]/40 bg-[#082013]/92 px-6 py-4 shadow-[0_10px_30px_rgba(227,197,106,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7e8b4] to-[#8a6a26] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a9bda9] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#e3c56a]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e3c56a]" : "text-[#5c4415]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e4e7d8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e3c56a]/40 bg-[#082013]/92 p-6 text-left shadow-[0_10px_30px_rgba(2,12,6,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f7e8b4]/70 hover:shadow-[0_15px_40px_rgba(227,197,106,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7e8b4] to-[#8a6a26] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#e3c56a]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#2a9d5c]/25"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e3c56a]/45 bg-[#020c06] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e3c56a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2a9d5c]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e3c56a]" : "text-[#5c4415]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e4e7d8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#e3c56a]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e3c56a]/55 bg-gradient-to-br from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e3c56a] transition-colors group-hover:text-[#f7e8b4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a9bda9] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
