---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟคือ "365LOTTO รวมทั้งหวยและคาสิโนไว้ในระบบเดียว" ทุกแถวจึงอยู่ในกรอบ
// ที่บรีฟระบุไว้เอง: หวยรัฐบาลไทย ฮานอย ลาวพัฒนา พร้อมแยกรอบเปิดรับของแต่ละประเภท,
// ตรวจสอบเลข รอบเวลา และรายละเอียดของรายการก่อนยืนยัน, อัตราจ่ายเลข 2 ตัวที่ 100
// และเลข 3 ตัวที่ 1,000, โปรโมชั่นสล็อตที่มีทั้งแนะนำเพื่อน 0.8% และคืนยอดเสีย
// 0.3%, สมัครผ่านมือถือ 3 ขั้นตอน, บาคาร่า ไพ่ สล็อต ในบัญชีเดียว และแอดมินตลอด
// 24 ชั่วโมง ไม่มีข้อความไหนรับปากว่าจะถูกรางวัล อ้างใบอนุญาต หรือระบุวันออกรางวัล
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// 365LOTTO (รอบแดง-ทอง-เงินโครเมียม 2026-09-24): แถบระบุตัวสมาชิกไล่จากทองสว่าง
// #fdf3b4 ลงทองหลัก #fadc64 ไปหาทองลึก #e0b03a ตามเลข 365 บนโลโก้ที่เป็นทอง ส่วน
// ดาวและป้ายแท็กรับเงินโครเมียม #f3f6fa กับแดงสด #e01f26 ตามคำว่า LOTTO ที่เป็น
// เงินโครเมียมและมีวง O สีแดง กรอบการ์ดกับเส้นคั่นเป็นพื้นยก #2a0b0e บนพื้นการ์ด
// #1a0709 เหนือพื้นเพจ #120406 เนื้อความเป็น BRAND_TEXT #f0ddc4 — ทอง-เงินโครเมียม
// ของ SAGAME66 (#e8b93f #ffe9a3 #96671a #2a1d0b #171006 #0d0903 #e3d8c0 #eef3f8)
// ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ตามหวยรัฐบาลไทย ฮานอย และลาวพัฒนาจากหน้าเดียว",
    stars: 5,
    tag: "หวยและคาสิโนในระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมหวยกับคาสิโนไว้ในระบบเดียวจริง มีทั้งรัฐบาลไทย ฮานอย และลาวพัฒนา แถมแยกรอบเปิดรับของแต่ละประเภทไว้ชัดเจน ติดตามหลายรายการได้จากหน้าเดียวโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ เปิดจากมือถือก็ได้ สลับมาใช้คอมพิวเตอร์ก็เหมือนกัน",
    avatar: "🎫",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เช็กอัตราจ่ายและรายละเอียดบิลก่อนยืนยันทุกครั้ง",
    stars: 5,
    tag: "2 ตัวจ่าย 100 · 3 ตัวจ่าย 1,000",
    content:
      "ชอบตรงที่ดูอัตราจ่ายของแต่ละประเภทได้ก่อนทำรายการ เลข 2 ตัวระบุไว้ที่ 100 และเลข 3 ตัวระบุไว้ที่ 1,000 ตามเงื่อนไขของรายการ ก่อนยืนยันยังตรวจสอบตัวเลข รอบที่กำลังเปิดรับ และข้อมูลบิลได้อีกครั้ง เลือกประเภทการซื้อได้ตรงกับรูปแบบที่ต้องการมากขึ้น",
    avatar: "💯",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือแล้วเช็กเงื่อนไขโปรโมชั่นก่อนกดรับ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "สมัครผ่านมือถือเองได้ กรอกข้อมูล ตรวจความถูกต้อง แล้วยืนยันบัญชี สามขั้นตอนจบ พอเข้าระบบก็เลือกหวยหรือจะไปบาคาร่า ไพ่ สล็อต ก็ใช้บัญชีเดียวกัน โปรโมชั่นสล็อตมีทั้งโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งดูรอบคำนวณกับยอดที่เข้าเกณฑ์ก่อนกดรับได้ ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] shadow-[0_0_12px_rgba(250,220,100,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f3f6fa] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fadc64]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f0ddc4]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการรวมหวยรัฐบาลไทย ฮานอย ลาวพัฒนา เข้ากับบาคาร่า ไพ่ สล็อต ไว้ในระบบเดียว การตรวจสอบอัตราจ่ายกับรายละเอียดบิลก่อนยืนยัน และการสมัครผ่านมือถือกับการเช็กเงื่อนไขโปรโมชั่น
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#2a0b0e] border-l-[#fadc64] bg-[#1a0709]/94 px-6 py-4 shadow-[0_10px_30px_rgba(18,4,6,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdf3b4] to-[#fadc64] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f0ddc4]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#2a0b0e] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f3f6fa]" : "text-[#2a0b0e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f0ddc4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#2a0b0e] bg-[#120406] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf3b4] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#2a0b0e] bg-[#1a0709]/94 p-5 shadow-[0_10px_30px_rgba(18,4,6,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#fadc64]/75 hover:shadow-[0_15px_40px_rgba(250,220,100,0.35)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e01f26]/28 blur-[60px] transition-all duration-300 group-hover:bg-[#fadc64]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#2a0b0e] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fadc64]/60 bg-gradient-to-br from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f3f6fa] transition-colors group-hover:text-[#fdf3b4]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f0ddc4]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f3f6fa]" : "text-[#2a0b0e]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e01f26]/65 bg-[#120406] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf3b4] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01f26]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f0ddc4]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
