---
// LOTTOKA เป็นเว็บแทงหวยออนไลน์แพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์ — ทุกแถวอยู่
// ในกรอบที่ brief ระบุไว้เอง: ยอดฝาก-ถอนโอนเข้าบัญชีของบริษัทโดยตรง ไม่ใช้บัญชีม้า
// หรือผ่านบุคคลที่สาม, รับเงินเข้าเต็ม 100% ไม่หักค่าธรรมเนียม, หวยรัฐบาลไทย ลาว
// ออมสิน ฮานอย และหวยหุ้นไทย/ต่างประเทศ, ไม่มีขั้นต่ำในการฝาก, ทุกธนาคารและ
// TrueMoney Wallet ด้วยระบบออโต้, นโยบายรับแทงทุกเลข ไม่มีปิดกั้น และแอดมินผ่าน
// Line Official ตลอด 24 ชั่วโมง.
// ไม่มีข้อความไหนรับปากผลรางวัลหรืออัตราการถูก และไม่มีการพูดถึงเรทบาทละ ซึ่ง
// อยู่ในหัวข้อ #4/#5 ของบทความเท่านั้น.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Logo red carries the
// score/quote furniture and the cream of the outlined KA carries the identity
// rail, so the two halves of the wordmark are both doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "ฝากเข้าระบบเองโดยไม่มีขั้นต่ำ",
    stars: 5,
    tag: "เข้าบัญชีบริษัทโดยตรง",
    content:
      "ที่ตัดสินใจสมัครเพราะยอดฝาก-ถอนโอนเข้าบัญชีของบริษัทโดยตรง ไม่ผ่านบัญชีม้าหรือบุคคลที่สาม เงินเข้าเต็มไม่มีหักค่าธรรมเนียม ฝากผ่านธนาคารก็ได้ ผ่าน TrueMoney Wallet ก็ได้ ระบบออโต้ทำรายการให้เอง และไม่มีขั้นต่ำในการฝากด้วย",
    avatar: "🏦",
  },
  {
    name: "คุณศิริพร ว.",
    role: "แทงครบทั้งห้าแนวหวยจากบัญชีเดียว",
    stars: 5,
    tag: "ครบทุกแนวหวย",
    content:
      "ชอบที่ LOTTOKA รวมหวยไว้ครบในเว็บเดียว หวยรัฐบาลไทยออกวันที่ 1 และ 16 เปิดรับแทงล่วงหน้าปิดรับช้า หวยลาวพัฒนาออกจันทร์ พุธ ศุกร์ หวยออมสินอ้างอิงผลสลากออมสิน หวยฮานอยมีทั้งปกติ พิเศษ และ VIP ลุ้นได้ทุกวัน ส่วนสายวิเคราะห์ก็มีหวยหุ้นไทยและต่างประเทศอย่างนิเคอิ ดาวโจนส์ ฮั่งเส็ง",
    avatar: "🎫",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "สมัครเองสามขั้นตอนและทำรายการผ่านหน้าเว็บ",
    stars: 4,
    tag: "รับแทงทุกเลข ไม่มีปิดกั้น",
    content:
      "สมัครเองด้วยระบบออโต้สามขั้นตอน กรอกเบอร์รับ OTP ผูกบัญชีธนาคารหรือวอลเลทโดยชื่อต้องตรงกับที่สมัคร แล้วตั้งรหัสผ่าน เท่านั้นก็เริ่มแทงได้ เว็บมีนโยบายรับแทงทุกเลข ไม่มีปิดกั้น ถ้าส่งโพยทันก่อนระบบปิดรับและถูกรางวัล ก็จ่ายเต็มตามเรทราคาที่ระบุไว้ในบิล ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LOTTOKA" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff9a9d] via-[#e2353a] to-[#7d1114] shadow-[0_0_12px_rgba(194,30,34,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f2eded] uppercase sm:text-3xl">
        เสียงจากสมาชิก LOTTO<span class="text-[#e2353a]">KA</span>
      </p>
      <span class="text-xs tracking-wide text-[#bdb4b6]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการฝากแบบไม่มีขั้นต่ำเข้าบัญชีบริษัทโดยตรง การแทงครบทั้งห้าแนวหวยจากบัญชีเดียว และการสมัครเองสามขั้นตอนด้วยระบบออโต้
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#7d1114]/60 border-l-[#c21e22] bg-[#140a0c]/92 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ff9a9d] to-[#e2353a] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#bdb4b6]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7d1114]/70 sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e2353a]" : "text-[#7d1114]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#bdb4b6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#7d1114]/70 bg-[#0a0608] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff9a9d] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#7d1114]/60 bg-[#140a0c]/92 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-300 hover:border-[#c21e22]/70 hover:shadow-[0_15px_40px_rgba(194,30,34,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c21e22]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#e2353a]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#7d1114]/60 pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ffe9ea]/50 bg-gradient-to-br from-[#ffe9ea] via-[#ff9a9d] to-[#c21e22] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ff9a9d] transition-colors group-hover:text-[#ffe9ea]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#bdb4b6]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e2353a]" : "text-[#7d1114]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c21e22]/60 bg-[#0a0608] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff9a9d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c21e22]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ded9da]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
