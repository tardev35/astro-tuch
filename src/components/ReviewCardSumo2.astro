---
// WIN8S is a สล็อตออนไลน์ เว็บตรง brand — every row stays inside what the brief
// states: การรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว, การรองรับมือถือ แท็บเล็ต และ
// คอมพิวเตอร์โดยไม่ต้องติดตั้งหลายระบบ, หมวดสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส
// ฟรีสปิน และเกมธีมต่าง ๆ, การปรับระดับเดิมพันตามช่วงที่แต่ละเกมกำหนดและการตรวจ
// ช่วงเดิมพันก่อนเล่นเพราะขั้นต่ำจริงต่างกันตามค่ายและเกม, การ Login เพื่อตรวจสอบ
// โปรโมชั่นที่มีสิทธิ์รับพร้อมรอบคำนวณ ยอดขั้นต่ำ เกมที่เข้าร่วม และเงื่อนไขการถอน,
// โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%, ระบบวอลเลทและธนาคารตามช่องทางที่เปิด
// รองรับ, และทีมงานที่ช่วยเหลือด้านการใช้งานตลอด 24 ชั่วโมง.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Orange carries the
// score/quote furniture, chrome silver carries the identity rail, so both
// halves of the WIN8S wordmark are doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · สล็อตวิดีโอ · เกมธีมต่าง ๆ",
    content:
      "เปิดบัญชีเดียวแล้วเลือกเกมสล็อตจากหลายค่ายได้ตามรูปแบบที่สนใจ ทั้งสล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ ไม่ต้องสมัครหลายครั้งเพื่อเข้าอีกค่ายหนึ่ง ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ได้โดยไม่ต้องติดตั้งหลายระบบ เลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตอยู่ในหน้าเว็บไซต์เดียวกัน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ตรวจช่วงเดิมพันในเกมก่อนเริ่มเล่นทุกครั้ง",
    stars: 5,
    tag: "ช่วงเดิมพัน · เงื่อนไขที่ระบบแสดง",
    content:
      "ชอบที่ปรับระดับเดิมพันได้ตามช่วงที่แต่ละเกมกำหนด เลยเข้าไปดูตัวเลขเดิมพันในเกมก่อนเริ่มเล่นทุกครั้ง เพราะขั้นต่ำจริงแตกต่างกันตามค่ายและเกมสล็อต บางเกมเริ่มที่ 1 บาท บางเกมก็ไม่ใช่ ส่วนคำว่าไม่มีขั้นต่ำก็ยึดตามเงื่อนไขที่ระบบแสดง ณ เวลาทำรายการเป็นหลัก ไม่ได้เอาจากข้อความโฆษณา",
    avatar: "🎮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ฝากถอนวอลเลทเอง แล้วเช็กโปรโมชั่นจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · ทีมงาน 24 ชม.",
    content:
      "เลือกใช้วอลเลทหรือบัญชีธนาคารตามช่องทางที่เว็บไซต์เปิดรองรับ ก่อนทำรายการก็เข้าไปดูยอดขั้นต่ำ วงเงิน และสถานะของช่องทางจากหน้าฝากถอนโดยตรง ส่วนโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่รับได้ผ่านบัญชีตัวเอง โบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ ส่วนคืนยอดเสีย 0.3% เป็นไปตามรอบที่กำหนด ก่อนกดรับควรดูประเภทเกม รอบคำนวณ และเงื่อนไขให้ครบ รอบไหนติดปัญหาก็สอบถามทีมงานได้ตลอด 24 ชั่วโมง และไม่ควรบอกรหัสผ่านหรือ OTP ให้ใคร",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก WIN8S" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fd9a1e] via-[#e3e7ec] to-[#8a3103] shadow-[0_0_12px_rgba(243,100,3,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f6e4d6] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f36403]">WIN</span><span class="text-[#e3e7ec]">8S</span>
      </p>
      <span class="text-xs tracking-wide text-[#9aa3ad]">บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อต การตรวจช่วงเดิมพันก่อนเริ่มเล่น และการฝากถอนผ่านบัญชีของตนเอง</span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#8a3103] border-l-[#f36403] bg-[#1c0a02]/92 px-6 py-4 shadow-[0_10px_30px_rgba(5,2,1,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fff2e6] to-[#f36403] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9aa3ad]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#8a3103] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fd9a1e]" : "text-[#8a3103]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e4d6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#9aa3ad]/45 bg-[#140300] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e3e7ec] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#8a3103] bg-[#1c0a02]/92 p-5 shadow-[0_10px_30px_rgba(5,2,1,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#f36403]/70 hover:shadow-[0_15px_40px_rgba(243,100,3,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f36403]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#f36403]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#8a3103] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#9aa3ad]/50 bg-gradient-to-br from-[#e3e7ec] via-[#9aa3ad] to-[#8a3103] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e3e7ec] transition-colors group-hover:text-[#fff2e6]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9aa3ad]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fd9a1e]" : "text-[#8a3103]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#8a3103]/60 bg-[#140300] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fd9a1e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f36403]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e4d6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
