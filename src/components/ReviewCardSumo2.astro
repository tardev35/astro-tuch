---
// YADOM168 is a slot brand — every row stays inside what the brief states:
// การรวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน
// แจ็กพอต และเกมธีมใหม่ ๆ, การเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์โดยไม่ต้อง
// สลับสมัครหลายเว็บไซต์, ระบบออโต้สำหรับจัดการเครดิต ฝากถอน และตรวจสอบรายการ,
// เกมที่รองรับเบทต่ำ 1 บาทซึ่งต้องตรวจขั้นต่ำภายในเกมก่อนกด Spin, การ Login เพื่อ
// ตรวจสอบโบนัสที่มีสิทธิ์รับในแต่ละวัน, โบนัสแนะนำเพื่อน 0.8% พร้อมรอบคำนวณและ
// ข้อกำหนด, และแอดมินที่ช่วยเหลือได้ตลอด 24 ชั่วโมง.
// Nothing here promises a payout, a win rate, a cashback promotion, or a product
// the brief does not state — the brief says outright that ผลลัพธ์ของเกมสล็อตไม่
// สามารถรับประกันว่าเกมใดจะแตกง่ายหรือทำกำไรได้ทุกครั้ง. Written testimonial text
// only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Brand green carries the
// score/quote furniture, coin gold carries the identity rail, so both halves of
// the YADOM168 artwork — the green neon and the gold coins — are doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · แจ็กพอต",
    content:
      "เปิดบัญชีเดียวแล้วเลือกเกมสล็อตจากหลายค่ายได้ตามสไตล์ที่สนใจ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ ๆ ที่แต่ละค่ายเปิดให้บริการ ไม่ต้องสลับสมัครหลายเว็บไซต์ ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน ตรวจสอบโบนัส และจัดการเครดิตอยู่ในหน้าเว็บไซต์เดียวกัน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ดูช่วงเดิมพันในเกมและวงเงินของช่องทางก่อนทุกครั้ง",
    stars: 5,
    tag: "ช่วงเดิมพันในเกม · เงื่อนไขที่ระบบแสดง",
    content:
      "ก่อนทำรายการจะเข้าไปดูวงเงินขั้นต่ำและสูงสุดของช่องทางที่เลือกก่อนยืนยันเสมอ เพราะข้อกำหนดต่างกันตามธนาคารหรือช่องทางชำระเงิน ส่วนเกมที่รองรับเบทต่ำ 1 บาทก็ยึดช่วงเดิมพันที่แสดงอยู่ในเกมนั้นเป็นหลัก ไม่ได้เอาจากข้อความโฆษณา เพราะแต่ละค่ายกำหนดช่วงเดิมพันไม่เท่ากัน",
    avatar: "🎮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ใช้ระบบออโต้ทำรายการเอง แล้วเช็กโบนัสจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · แอดมิน 24 ชม.",
    content:
      "เติมเครดิตผ่านช่องทางฝากเงินที่ระบบเปิดรองรับ ส่งคำขอถอน และตามสถานะรายการผ่านบัญชีสมาชิกได้เองบนมือถือ ส่วนโปรโมชั่นก็ Login เข้าไปดูโบนัสที่มีสิทธิ์รับในแต่ละวัน โบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเงื่อนไข ก่อนใช้สิทธิ์ควรดูรอบคำนวณ วิธีรับโบนัส และข้อกำหนดล่าสุดให้ครบ รอบไหนติดปัญหาก็แจ้งแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก YADOM168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8fe06f] via-[#e6bd5c] to-[#1d6b18] shadow-[0_0_12px_rgba(92,194,63,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f2fbef] uppercase sm:text-3xl">
        เสียงจากสมาชิก YADOM<span class="text-[#5cc23f]">168</span>
      </p>
      <span class="text-xs tracking-wide text-[#9bb38d]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตจากหลายค่าย การตรวจช่วงเดิมพันก่อนกด Spin และการทำรายการผ่านระบบออโต้ด้วยตัวเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0f3d0d] border-l-[#5cc23f] bg-[#071508]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,8,3,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f2fbef] to-[#5cc23f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9bb38d]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#0f3d0d] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e6bd5c]" : "text-[#0f3d0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d4e8cb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#e6bd5c]/45 bg-[#040d04] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e6bd5c] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0f3d0d] bg-[#071508]/92 p-5 shadow-[0_10px_30px_rgba(2,8,3,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#5cc23f]/70 hover:shadow-[0_15px_40px_rgba(92,194,63,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#5cc23f]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#5cc23f]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#0f3d0d] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e6bd5c]/50 bg-gradient-to-br from-[#e6bd5c] via-[#9c8340] to-[#1d6b18] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e6bd5c] transition-colors group-hover:text-[#f2fbef]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9bb38d]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e6bd5c]" : "text-[#0f3d0d]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#0f3d0d]/60 bg-[#040d04] px-3 py-1 text-[10px] font-bold tracking-widest text-[#8fe06f] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5cc23f]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#d4e8cb]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
