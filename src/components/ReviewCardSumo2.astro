---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บหวย "แทงหวย อันดับ1 รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น
// ต่างประเทศ จ่ายเต็ม ไม่อั้นเลข" ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้เอง:
// รวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว, เลือกดูรอบที่เปิดรับและตรวจสอบเลขที่
// ต้องการจากหน้าเดียว, เปิดรับเลขเด็ดเลขดังตามรอบที่ระบบกำหนด, แสดงอัตราจ่ายของ
// แต่ละประเภทเลขไว้ชัดเจนก่อนยืนยันรายการ, เลข 2 ตัวจ่าย 100 กับเลข 3 ตัวจ่าย
// 1,000 ตามเงื่อนไขของแต่ละรายการ, สมัครเองได้ใน 3 ขั้นตอน และแอดมินออนไลน์
// 24 ชั่วโมง ไม่มีข้อความไหนรับปากว่าจะถูกรางวัลหรือบอกอัตราการชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// หวยพยัคฆ์ (รอบกรมท่า-ทอง 2026-09-22): แถบระบุตัวสมาชิกไล่จากทองสว่าง #fdf5a4
// ลงทองหลัก #fadb6c ไปหาทองบรอนซ์ #ab6d13 ตามคำว่า พยัคฆ์ บนโลโก้ ส่วนกรอบการ์ด
// กับเส้นคั่นเป็นน้ำเงินคั่น #1c3566 บนพื้นการ์ด #08152f เหนือพื้นเพจกรมท่าเข้ม
// #030b1c ชื่อหัวข้อเป็นเงิน #e8eef8 ตามคำว่า หวย — ดำ-ทองของ HENG35 ออกทั้งหมด
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "ติดตามหวยหลายประเภทจากระบบเดียว",
    stars: 5,
    tag: "รัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้น",
    content:
      "ที่เลือกใช้เพราะรวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ เลือกดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ แล้วจัดการรายการได้จากหน้าเดียว ไม่ต้องสลับหลายเว็บไซต์เหมือนเดิม รายการที่เปิดรับต่างกันตามวันและช่วงเวลา เลยดูรอบล่าสุดจากหน้ารวมหวยก่อนทำรายการทุกครั้ง",
    avatar: "🎫",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "ดูอัตราจ่ายให้ครบก่อนยืนยันบิลทุกครั้ง",
    stars: 5,
    tag: "2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000",
    content:
      "อัตราจ่ายของแต่ละประเภทเลขแสดงไว้ชัดเจนก่อนยืนยันรายการ เลข 2 ตัวระบุไว้ที่ 100 และเลข 3 ตัวระบุไว้ที่ 1,000 ตามเงื่อนไขของแต่ละรายการ ที่ชอบคือตรวจสอบอัตรา รอบหวย และประเภทบิลได้จากหน้าเดียว เลยเปรียบเทียบรายละเอียดแล้วเลือกวิธีแทงที่เหมาะกับเลขที่ถืออยู่ได้ง่ายขึ้น และควรเช็กเงื่อนไขของแต่ละรอบก่อนยืนยันเสมอ",
    avatar: "💰",
  },
  {
    name: "คุณอนุชา พ.",
    role: "สมัครเองผ่านหน้าเว็บแล้วเริ่มเลือกเลขได้เลย",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อน กรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจสอบข้อมูลส่วนตัวกับรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน แล้วเข้าสู่ระบบเลือกรัฐบาลไทย ฮานอย ลาวพัฒนา หรือรายการอื่นได้ทันที ถ้าติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องรอบหวย อัตราจ่าย หรือวิธีเลือกเลข และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] shadow-[0_0_12px_rgba(250,219,108,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#e8eef8] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fadb6c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#9fb0d0]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามหวยหลายประเภทจากระบบเดียว การตรวจสอบอัตราจ่ายกับรอบหวยก่อนยืนยันบิล และการสมัครเองผ่านหน้าเว็บไซต์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#1c3566] border-l-[#fadb6c] bg-[#08152f]/94 px-6 py-4 shadow-[0_10px_30px_rgba(3,11,28,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdf5a4] to-[#fadb6c] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9fb0d0]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#1c3566] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fadb6c]" : "text-[#1c3566]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbe4f7]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#1c3566] bg-[#030b1c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf5a4] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#1c3566] bg-[#08152f]/94 p-5 shadow-[0_10px_30px_rgba(3,11,28,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#fadb6c]/75 hover:shadow-[0_15px_40px_rgba(250,219,108,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#ab6d13]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#fadb6c]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#1c3566] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fadb6c]/60 bg-gradient-to-br from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fdf5a4] transition-colors group-hover:text-[#e8eef8]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9fb0d0]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fadb6c]" : "text-[#1c3566]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fadb6c]/65 bg-[#030b1c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdf5a4] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fadb6c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#dbe4f7]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
