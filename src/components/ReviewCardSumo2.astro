//     #5411c4 — เจอแล้วให้สงสัยว่าพิมพ์ผิดก่อนเสมอ**
//   **KMD88** 7505cc b453ff c07cff d9b8ff 3a0565
//     ⚠️⚠️ **b453ff ↔ #bb6dff · 7505cc ↔ #7a1bd6 — คู่ที่ใกล้ที่สุดในลิสต์ทั้งหมด**
//   **CEO66** 7e22ce d946ef a855f7 · **โบ๊ะบ๊ะ168** 00bfff 12b4ef b6e3f0 7fcbe8
//     4fb8ea 06283f 0f5684 1a6ea8 eaf7ff f0faff e4f6fb · **หมูบิน168** fa539c
//     c2185b 8e0f41 fb8cc0 f7bcd9 ffe5ff fff0f8 3b0b26 54123a 7a2350
//     ⚠️ **c2185b ↔ #c2178b ต่างสองไบต์ท้าย — จุดที่พิมพ์ผิดง่ายที่สุดในไฟล์นี้**
//   **cyber-neon/dark defaults** 00f3ff e0ffff 60a5fa 4b5563 030712 1f2937
//     (⚠️ **60a5fa ↔ #7aa7ff**)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงทุกเฉด ไม่มีทอง/เหลือง/ส้ม ไม่มีเขียว ไม่มีไซยาน ไม่มีครีม/เบจ/
// พีช ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน** (เชอร์รี่ชมพู เพชรม่วง ชิปแมเจนต้า และ
// ลำแสงนีออนบนอาร์ตเวิร์กเป็น **วัตถุในภาพ** ส่วนฉากสตูดิโอขาว-ไลแลคคือที่มาของ
// ผิวสว่าง ไม่ใช่สีของ UI คนละชุด)
const reviews = [
  {
    name: "คุณธีรภัทร ว.",
    role: "ไล่อ่านตารางจ่ายรางวัลและกติกาของแต่ละเกมให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "ค่ายเกมหลากหลายแบรนด์ · สล็อตคลาสสิก · ฟีเจอร์ฟรีสปิน · เกมโบนัส",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอเกมสล็อตออนไลน์จากค่ายเกมหลากหลายแบรนด์ ทั้งสล็อตคลาสสิก เกมที่มีฟีเจอร์ฟรีสปิน และเกมโบนัสที่มีกติกาแตกต่างกัน พร้อมรวบรวมข้อมูลเกม โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ไว้ในที่เดียว จึงศึกษารายละเอียดและเงื่อนไขต่าง ๆ ได้ก่อนใช้งาน มีข้อมูลการเดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุ แต่ก่อนเริ่มยังไล่ดูยอดเดิมพันขั้นต่ำ ตารางจ่ายรางวัล และกติกาของแต่ละเกมอีกรอบ เพราะเกมสล็อตแต่ละประเภทอาจกำหนดวงเงินเดิมพันไม่เท่ากัน ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างเกี่ยวกับลิขสิทธิ์เกมและการเป็นเว็บตรงไม่ผ่านเอเย่นต์ ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ และควรศึกษาค่า RTP และความผันผวนของเกม เพื่อทำความเข้าใจความเสี่ยงโดยไม่คาดหวังผลรางวัลที่แน่นอน",
    avatar: "✨",
    accent: "neon" as const,
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "อ่านประกาศโปรโมชั่นล่าสุดให้ครบ แล้วค่อยตรวจรอบสรุปยอดอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "โปรโมชั่นอัปเดตใหม่ทุกสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ และมีรายละเอียดประจำสัปดาห์ให้ติดตามรอบรับเครดิตกับเงื่อนไขการเข้าร่วม ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าเกมสล็อตประเภทใดเข้าร่วมรายการ มีรอบสรุปยอดเวลาใด ต้องกดรับเครดิตด้วยตนเองหรือระบบดำเนินการให้อัตโนมัติ รวมถึงวิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และฐานยอดที่ใช้คำนวณโบนัส เพราะแต่ละรายการอาจกำหนดประเภทเกม ยอดที่นำมาคำนวณ และข้อจำกัดการถอนเงินแตกต่างกัน แม้จะมีข้อความว่าไม่จำกัด แต่ควรยืนยันจำนวนบัญชีที่เข้าร่วมได้ รอบจ่ายเครดิต และเงื่อนไขการใช้โบนัสจากประกาศล่าสุดก่อนตัดสินใจ ที่ต้องเข้าใจตรงกันคือเครดิตคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งต่อไป",
    avatar: "🍒",
    accent: "chrome" as const,
  },
  {
    name: "คุณอนุชา ก.",
    role: "ตรวจช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง",
    stars: 4,
    tag: "สมัครด้วยมือถือ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.",
    content:
      "ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปตรวจสอบรายละเอียดเกม เปิดผ่านเบราว์เซอร์บนมือถือได้ตามที่เว็บไซต์ระบุ แต่ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชี คุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกมสล็อต และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม จะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "💎",
    accent: "neon" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2b3fd9] via-[#7a1bd6] to-[#f23bb4] shadow-[0_0_12px_rgba(122,27,214,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#241046] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#5411c4]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#241046]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมเกมสล็อตจากค่ายเกมหลากหลายแบรนด์ ยอดเดิมพันเริ่มต้น 1 บาทสำหรับบางรายการตามที่ระบุ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครด้วยมือถือ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#dcc6f4] border-l-[#7a1bd6] bg-[#f6edfe] px-6 py-4 shadow-[0_10px_30px_rgba(84,17,196,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#5411c4]">{average}</span>
      <span class="text-sm font-black text-[#6b4a86]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#dcc6f4] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#c2178b]" : "text-[#c2178b]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#241046]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#dcc6f4] bg-white px-3 py-1 text-[10px] font-bold tracking-wide text-[#6b4a86] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#dcc6f4] bg-white p-5 shadow-[0_10px_30px_rgba(36,16,70,0.1)] transition-all duration-300 hover:border-[#7a1bd6] hover:shadow-[0_15px_40px_rgba(122,27,214,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#bb6dff]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#bb6dff]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#dcc6f4] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "neon"
                  ? "border border-[#5411c4] bg-gradient-to-br from-[#5411c4] to-[#8e14b8] text-white"
                  : "border border-[#dcc6f4] bg-gradient-to-br from-white to-[#ece0fb] text-[#241046]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#241046] transition-colors group-hover:text-[#5411c4]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#6b4a86]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#c2178b]" : "text-[#c2178b]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#dcc6f4] bg-[#f6edfe] px-3 py-1 text-[10px] font-bold tracking-wide text-[#6b4a86] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f23bb4]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#241046]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
