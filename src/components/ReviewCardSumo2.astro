---
// ENTER55 เป็นเว็บเล่นสล็อตและหวยออนไลน์ที่รวมไว้ในทางเข้าเดียว — ทุกแถวอยู่ในกรอบ
// ที่ brief ระบุไว้เอง: เว็บตรงไม่ผ่านเอเย่นต์ที่มั่นคงทางการเงินระดับประเทศ, ระบบ
// กระเป๋าเดียว (Single Wallet) ที่ฝากครั้งเดียวเล่นได้ทั้งสล็อตและหวยโดยไม่ต้องโยก
// เครดิต, เปิดรับหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น, จ่ายเต็มทุกบิลไม่หัก
// เปอร์เซ็นต์แม้เป็นเลขเด็ด เลขดัง เลขอั้น, อัตราจ่าย 2 ตัวบน-ล่างบาทละ 100 และ
// 3 ตัวตรงบาทละ 1,000, โปรโมชั่นแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ทุกรอบบิล,
// สมัครออโต้สามขั้นตอนด้วย OTP ผูกบัญชีธนาคารชื่อตรงกันแล้วตั้ง Username/Password,
// ฝาก-ถอนไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากได้ ทำรายการได้ 24 ชั่วโมงภายใน 3-5 วินาที,
// รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet และถอนได้ 100% เต็มจำนวนไม่มีอั้น
// ยอดถอนต่อวัน.
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// ENTER55: แถบระบุตัวสมาชิกเป็นทองประกาย #ebd484 ไล่ลงทองหลัก #c4a255 ส่วนกรอบ
// การ์ดกับเส้นคั่นเป็นทองเข้ม #8a6d2c บนพื้นดำ #0b0b0a ตามลายวงจรเส้นทองของแบรนด์
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "เล่นสล็อตและแทงหวยด้วยเครดิตกระเป๋าเดียว",
    stars: 5,
    tag: "กระเป๋าเดียว Single Wallet",
    content:
      "เมื่อก่อนต้องสมัครหลายเว็บและจำหลายรหัสผ่าน พอย้ายมาที่นี่คือฝากเงินครั้งเดียวจบ เครดิตรวมอยู่ในกระเป๋าเดียว สลับหน้าจากเกมสล็อตไปแทงหวยออนไลน์ได้ทันทีโดยไม่ต้องกดโยกเงินระหว่างค่ายเกม ครบจบในทางเข้าเดียวจริงตามที่เว็บบอกไว้",
    avatar: "👛",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "คอหวยที่แทงครบทั้งไทย ลาว ฮานอย และหุ้น",
    stars: 5,
    tag: "จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์",
    content:
      "เปิดรับหวยครบทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น ที่ชอบที่สุดคือนโยบายจ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ แม้จะเป็นเลขเด็ด เลขดัง หรือเลขอั้นก็ยังได้เรทเดิม 2 ตัวบน-ล่างบาทละ 100 และ 3 ตัวตรงบาทละ 1,000 แทงถูกแล้วระบบปรับยอดเครดิตให้เลย",
    avatar: "🎟️",
  },
  {
    name: "คุณอนุชา พ.",
    role: "สมัครออโต้เองและกดรับโปรโมชั่นผ่านหน้าเว็บ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "สมัครเองด้วยระบบออโต้สามขั้นตอน กรอกเบอร์รับ OTP ผูกบัญชีธนาคารที่ชื่อ-นามสกุลตรงกัน แล้วตั้ง Username กับ Password เสร็จเร็วมาก ฝาก-ถอนไม่มีขั้นต่ำ ทุน 1 บาทก็ฝากได้ ทำรายการได้ตลอด 24 ชั่วโมง ใช้เวลาแค่ 3-5 วินาที รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet ส่วนโปรก็กดรับผ่านหน้าเว็บได้ ทั้งแนะนำเพื่อนรับค่าคอมมิชชั่น 0.8% จากทุกยอดการเล่นของเพื่อน และคืนยอดเสีย 0.3% ทุกรอบบิล ตอนถอนก็ได้เต็มจำนวนไม่มีอั้นยอดต่อวัน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🤝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ENTER55" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ebd484] via-[#c4a255] to-[#8a6d2c] shadow-[0_0_12px_rgba(196,162,85,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ded8cb] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ebd484]">ENTER</span><span class="text-[#c4a255]">55</span>
      </p>
      <span class="text-xs tracking-wide text-[#a1937a]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการใช้เครดิตกระเป๋าเดียวเล่นได้ทั้งสล็อตและหวย อัตราจ่ายหวยที่ไม่หักเปอร์เซ็นต์ และการสมัครออโต้พร้อมกดรับโปรโมชั่นผ่านหน้าเว็บ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#26200f] border-l-[#c4a255] bg-[#0b0b0a]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ebd484] to-[#c4a255] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#a1937a]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#26200f] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d2b262]" : "text-[#5a4e34]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ded8cb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#26200f] bg-[#000000] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ebd484] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#26200f] bg-[#0b0b0a]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#c4a255]/75 hover:shadow-[0_15px_40px_rgba(196,162,85,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c4a255]/16 blur-[60px] transition-all duration-300 group-hover:bg-[#ebd484]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#26200f] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#c4a255]/60 bg-gradient-to-br from-[#ebd484] via-[#d2b262] to-[#c4a255] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ebd484] transition-colors group-hover:text-[#d2b262]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a1937a]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#d2b262]" : "text-[#5a4e34]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#c4a255]/65 bg-[#000000] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ebd484] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c4a255]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ded8cb]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
