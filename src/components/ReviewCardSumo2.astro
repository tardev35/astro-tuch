---
const reviews = [
  {
    name: "สมาชิกที่เล่นคาสิโนสดผ่านมือถือเป็นหลัก",
    role: "ใช้ระบบเดียวได้ทั้งมือถือและคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เข้าสู่ระบบผ่านสมาร์ตโฟนได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด เลือกโต๊ะบาคาร่า รูเล็ต หรือสล็อตได้จากอุปกรณ์เครื่องเดียว เหมาะกับคนที่เดินทางบ่อยแล้วกลับมาเล่นต่อที่บ้าน",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ใช้ระบบฝากถอนอัตโนมัติ",
    role: "ทำรายการเองได้ตลอด 24 ชั่วโมง",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ฝากเครดิต ถอนเงิน และตรวจสอบสถานะรายการทำได้ด้วยตัวเองผ่านระบบ ไม่ต้องรอเจ้าหน้าที่ตอบทีละเคส รองรับทั้งบัญชีธนาคารและวอลเลท ช่วยลดเวลารอระหว่างเล่นแต่ละเกม",
    avatar: "🏧",
  },
  {
    name: "สมาชิกที่เคยติดต่อทีมงานตอนสมัคร",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ทีมงานดูแล 24 ชม.",
    content:
      "ตอนสมัครสมาชิกครั้งแรกมีจุดที่ไม่แน่ใจอยู่บ้าง ทีมงานตอบกลับไวและอธิบายขั้นตอนฝากเครดิตและการเลือกเกมให้เข้าใจก่อนเริ่มเดิมพันจริง ช่วยให้มั่นใจว่าใช้งานระบบได้ถูกต้องตั้งแต่ครั้งแรก",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก WE168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4ade80] via-[#e9f7e6] to-[#ec4899] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ec4899]">WE168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#22c55e]/25 bg-[#0a1207]/92 px-6 py-4 shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f9a8d4] to-[#db2777] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#bbf7d0]/90 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#04120a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ec4899]" : "text-[#04120a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#bbf7d0]/90">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#22c55e]/25 bg-[#0a1207]/92 p-6 text-left shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#22c55e]/50 hover:shadow-[0_15px_40px_rgba(34,197,94,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#4ade80] to-[#ec4899] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#ec4899]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#22c55e]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#22c55e]/25 bg-[#04120a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#4ade80] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#4ade80]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ec4899]" : "text-[#04120a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e9f7e6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#04120a] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22c55e]/30 bg-gradient-to-br from-[#4ade80] via-[#e9f7e6] to-[#ec4899] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e9f7e6] transition-colors group-hover:text-[#4ade80]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#bbf7d0]/90 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
