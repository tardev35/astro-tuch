<section aria-label={`เสียงจากผู้เล่น ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe5a8] via-[#ff5a5f] to-[#fa0513] shadow-[0_0_12px_rgba(250,5,19,0.7)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f4ecea] uppercase sm:text-3xl">
        เสียงจากผู้เล่น <span class="text-[#e3b23c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ccb9b6]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมช่องทางติดต่อผู้ให้บริการ การขอความช่วยเหลือเรื่องการเข้าสู่ระบบ การตรวจสอบบัญชี และการใช้งานเกมสล็อต โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
        พร้อมขั้นตอนสมัครสมาชิกและช่องทาง LINE Official ที่ระบุว่าเปิดตลอด 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#fa0513]/30 border-l-[#fa0513] bg-[#1f0d0c] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffe5a8] to-[#ff5a5f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ccb9b6]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5b0203] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e3b23c]" : "text-[#e3b23c]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f4ecea]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#8a6210] bg-[#140706] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e3b23c] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#e3b23c]/25 bg-[#140706] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-300 hover:border-[#e3b23c]/70 hover:shadow-[0_15px_40px_rgba(250,5,19,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#fa0513]/20 blur-[60px] transition-all duration-300 group-hover:bg-[#fa0513]/34"
          />

          <div class="flex items-center gap-4 border-b border-[#5b0203] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#b90203] bg-gradient-to-br from-[#ffe5a8] via-[#e3b23c] to-[#fa0513] text-2xl text-[#170504] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f4ecea] transition-colors group-hover:text-[#ff5a5f]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ccb9b6]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e3b23c]" : "text-[#e3b23c]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e3b23c]/45 bg-[#1f0d0c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e3b23c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fa0513]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f4ecea]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
