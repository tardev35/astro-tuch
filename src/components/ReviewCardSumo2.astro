---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "เว็บเล่นพนันอันดับ1ในไทย เข้าเล่นเกมสดแบบ VIP ได้ทันที"
// ทุกแถวจึงอยู่ในกรอบที่ brief ระบุไว้เอง: ทางเข้าเล่นรูปแบบ VIP สำหรับยูสไทย,
// ปรับหน้าหลัก เมนูเกม และระบบสมาชิกให้ทันสมัยขึ้น, ค้นหาเกมและสลับหมวดได้ง่าย
// กว่าเดิม, รองรับทั้งมือถือและคอมพิวเตอร์, เลือกเกมสดและหมวดเกมจากบัญชีเดียว,
// สิทธิ์บางประเภทกดรับหลังสมัครได้ตามที่ระบบกำหนด, โบนัสแนะนำเพื่อน 0.8% กับ
// คืนยอดเสีย 0.3%, สมัครเองได้ใน 3 ขั้นตอน และสอบถามแอดมินได้ตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนรับปากว่าจะชนะ บอกอัตราการจ่าย หรืออ้างใบอนุญาต
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): แถบระบุตัวสมาชิกไล่จากชมพูกุหลาบ #f9a8cd
// ลงมาเจนตาหลัก #ec2b84 ไปหามาเจนตาเข้ม #a3145a ตามตัวอักษร WY บนโลโก้ ส่วนดาว
// และป้ายแท็กรับทองหลัก #e8b33a ตามเลข 88 กรอบการ์ดกับเส้นคั่นเป็นมาเจนตาเข้มบน
// พื้นการ์ดพลัม #24081a เหนือพื้นเพจ #170411 ชื่อหัวข้อเป็นชมพูกุหลาบ —
// ชมพู-เหลืองของ ABM96 ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เข้าเล่นเกมสดผ่านมือถือเป็นหลัก",
    stars: 5,
    tag: "ทางเข้าเล่นรูปแบบ VIP",
    content:
      "ที่ใช้ต่อเพราะทางเข้าเล่นเวอร์ชันใหม่ถูกปรับรูปแบบให้ทันสมัยขึ้น ทั้งหน้าหลัก เมนูเกม และระบบสมาชิก รูปแบบ VIP จัดองค์ประกอบการใช้งานไว้เป็นระเบียบ เปิดจากมือถือแล้วกดเข้าเกมสดที่ต้องการได้เลย ใช้งานบนคอมพิวเตอร์ก็ได้เหมือนกัน เลยไม่ต้องสลับอุปกรณ์ให้ยุ่งยาก",
    avatar: "👑",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เลือกเกมสดและหมวดเกมจากบัญชีเดียว",
    stars: 5,
    tag: "เกมสดและหมวดเกมในบัญชีเดียว",
    content:
      "ชอบตรงที่เลือกเกมสดและหมวดเกมที่สนใจได้จากบัญชีเดียว หลังปรับเมนูใหม่แล้วค้นหาเกมและสลับหมวดได้ง่ายกว่าเดิมจริง พอยืนยันบัญชีเรียบร้อยก็เข้าสู่ระบบแล้วเลือกสล็อตหรือเกมสดที่ต้องการได้ทันที ไม่ต้องไล่หาหลายหน้าเหมือนระบบเดิม",
    avatar: "🎥",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "เช็กเงื่อนไขโปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "โปรโมชั่นมีให้เลือกตามเงื่อนไขของแต่ละรายการ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ที่ดีคือสิทธิ์บางประเภทตรวจสอบและกดรับหลังสมัครได้ตามที่ระบบกำหนด เลยดูรอบคำนวณกับยอดที่เข้าเกณฑ์ก่อนได้ ส่วนการสมัครทำเองผ่านหน้าเว็บไซต์ได้ใน 3 ขั้นตอน ติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] shadow-[0_0_12px_rgba(236,43,132,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f9a8cd] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e8b33a]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#fce9f3]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมทางเข้าเล่นรูปแบบ VIP การเลือกเกมสดและหมวดเกมจากบัญชีเดียว และการตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#a3145a] border-l-[#ec2b84] bg-[#24081a]/94 px-6 py-4 shadow-[0_10px_30px_rgba(23,4,17,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f9a8cd] to-[#ec2b84] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#fce9f3]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#a3145a] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8b33a]" : "text-[#a3145a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#fce9f3]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#a3145a] bg-[#170411] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f9a8cd] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#a3145a] bg-[#24081a]/94 p-5 shadow-[0_10px_30px_rgba(23,4,17,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#ec2b84]/75 hover:shadow-[0_15px_40px_rgba(236,43,132,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#ec2b84]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#e8b33a]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#a3145a] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ec2b84]/60 bg-gradient-to-br from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f9a8cd] transition-colors group-hover:text-[#fced94]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#fce9f3]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e8b33a]" : "text-[#a3145a]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#ec2b84]/65 bg-[#170411] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f9a8cd] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8b33a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#fce9f3]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
