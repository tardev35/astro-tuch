// ff8f9c / 5c0410 / fcd45c / 6b4a08 / 2b0711) ชุด **ฟ้าไซยาน-เหลืองมะนาว** ของ
// นินจา168 (32bcfb / a9e9ff / fef54b / 07335f / 6b5c10 / 0c2a3d / 071a28 / 030e16)
// ชุด **น้ำเงินไฟฟ้า-เงินโครเมียม** ของ TSDET911 (0360f3 / 0292fb / 6ec8ff /
// 4fb4ff / cfdcec / 9db4d4 / dde8f7 / 102a5e) ชุด **ฟ้าอะซัวร์-ทองอำพัน** ของ
// รวยแทร่168 (039cfa / 0494f5 / c3ebfc / 04366b / f9a826 / 704504 / e3f2fc /
// 0b2d52) ชุด **ฟ้าบับเบิล-ทอง** ของ สบายเบท168 (2f9ff5 / a8dcff / d6ecff /
// 0b3f78 / e8f4ff / ffc82e / 5c4a16) ชุดทองน้ำผึ้ง-แดงชาดของ ดวงเศรษฐี168 (d9212a /
// 8e1a16 / f0c878 / fff8d8 / 2a0608 / 4e2120) ชุดทองอิมพีเรียลของ รวยเทพ168
// (f0bb4e / ffeccb / e4021b / d9701a / 3b1b0e / 260d04) และ CEO66 (020617 / 7e22ce /
// d946ef / f5d0fe / a855f7) — ออกครบทุกค่า
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีบรอนซ์ ไม่มีม่วง/ไวโอเลต ไม่มีส้ม ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้
// และไม่มีแรมป์เทาเงิน/โครเมียม** (เลข "168" ในโลโก้เป็นโครเมียมจริง แต่ §2 ระบุว่า
// แรมป์เทาเงินเป็นของ พักยก168 กับ ยูฟ้า168 ไปแล้ว ห้ามเอากลับเข้ามาเป็นสี UI)
const reviews = [
  {
    name: "คุณธนากร ว.",
    role: "ไล่ดูระดับการเดิมพันของแต่ละเกมและค่า RTP ที่ผู้พัฒนาเปิดเผยให้จบก่อน แล้วค่อยเลือกเกม",
    stars: 5,
    tag: "เกมสล็อตออนไลน์ · ระดับการเดิมพัน · ตารางจ่ายรางวัล",
    content:
      "ที่ใช้งานต่อเพราะเว็บไซต์รวบรวมข้อมูลเกมสล็อตออนไลน์ที่มีระดับการเดิมพันแตกต่างกันไว้ในช่องทางเดียว รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ ทำให้เทียบกติกาและตารางจ่ายรางวัลของแต่ละเกมได้ก่อนเลือกใช้งานโดยไม่ต้องไล่เปิดทีละหน้า ก่อนเริ่มเดิมพันจะดูค่า RTP ที่ผู้พัฒนาเปิดเผยประกอบทุกครั้ง ส่วนที่อยากกำกับไว้ให้ตรงกันคือค่า RTP เป็นสถิติระยะยาว ไม่ใช่การรับประกันว่าจะชนะในแต่ละครั้ง และคำกล่าวอ้างเรื่องการปรับเรทแตกหนักที่สุดควรพิจารณาจากข้อมูลที่ตรวจสอบได้ เนื่องจากผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน",
    avatar: "🎮",
    accent: "cyan" as const,
  },
  {
    name: "คุณพิมพ์ชนก ส.",
    role: "อ่านประกาศล่าสุดของโปรโมชั่นให้ครบ แล้วค่อยตรวจรอบเวลารับเครดิตอีกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · เงื่อนไขการใช้โบนัส",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือข้อมูลโปรโมชั่นสำหรับสมาชิก ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน และโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ แต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน จึงต้องดูรอบสรุปยอด วิธีรับลิงก์แนะนำ ขั้นตอนเชื่อมโยงบัญชี และรอบจ่ายเครดิตจากประกาศล่าสุดทุกครั้ง แม้จะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริง รวมถึงเงื่อนไขการใช้โบนัสและการถอนเงินก่อนตัดสินใจเข้าร่วม ที่ต้องเข้าใจตรงกันคือการคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะมากขึ้น",
    avatar: "🎁",
    accent: "cream" as const,
  },
  {
    name: "คุณอรรถพล ม.",
    role: "ตรวจที่อยู่เว็บไซต์และช่องทางติดต่อจากเว็บไซต์ทางการก่อนทำรายการ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใคร",
    stars: 4,
    tag: "สมัครสมาชิก · ฝากถอน · ติดต่อแอดมิน 24ชม.",
    content:
      "ตอนเริ่มใช้งานได้ตรวจที่อยู่เว็บไซต์ให้ถูกต้อง อ่านเงื่อนไขการเปิดบัญชี คุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และนโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคลก่อนกรอกข้อมูล จากนั้นจึงตั้งรหัสผ่านที่คาดเดาได้ยาก ยืนยันบัญชี แล้วเข้าสู่ระบบเพื่อศึกษารายชื่อเกมสล็อต กติกาการเล่น ยอดเดิมพันขั้นต่ำ และรายละเอียดโปรโมชั่นที่เปิดให้บริการ ก่อนทำรายการฝากถอนยังตรวจยอดฝากขั้นต่ำกับวงเงินถอนตามเงื่อนไขจริงเสมอ เพราะข้อความที่ระบุว่าไม่อั้นจ่ายหรือไม่อั้นถอนไม่ได้แปลว่าไม่มีเพดานธุรกรรม เรื่องการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายการฝากถอน และรายละเอียดโปรโมชั่น ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับธุรกรรมจะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "💬",
    accent: "cyan" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#18a5e2] via-[#0d6b9b] to-[#31408a] shadow-[0_0_12px_rgba(24,165,226,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#16294a] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#0d6b9b]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#16294a]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมสล็อตออนไลน์ที่มีระดับการเดิมพันแตกต่างกัน กติกา ตารางจ่ายรางวัลและค่า RTP ที่ผู้พัฒนาเปิดเผย โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครสมาชิกและรายการฝากถอน พร้อมช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#31408a] border-l-[#18a5e2] bg-[#111a3f] px-6 py-4 shadow-[0_10px_30px_rgba(17,26,63,0.4)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#a9d7f2] to-[#18a5e2] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#18a5e2]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#31408a] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#18a5e2]" : "text-[#18a5e2]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e9f1ff]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#31408a] bg-[#202a66] px-3 py-1 text-[10px] font-bold tracking-wide text-[#adc0e4] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#31408a] bg-[#202a66] p-5 shadow-[0_10px_30px_rgba(17,26,63,0.35)] transition-all duration-300 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(24,165,226,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#18a5e2]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#18a5e2]/25"
          />

          <div class="flex items-center gap-4 border-b border-[#31408a] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "cyan" ? "border border-[#18a5e2] bg-gradient-to-br from-[#a9d7f2] to-[#18a5e2] text-[#111a3f]" : "border border-[#e4cbb3] bg-gradient-to-br from-[#f4e4d3] to-[#e4cbb3] text-[#16294a]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e9f1ff] transition-colors group-hover:text-[#18a5e2]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#adc0e4]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#18a5e2]" : "text-[#18a5e2]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#31408a] bg-[#111a3f] px-3 py-1 text-[10px] font-bold tracking-wide text-[#adc0e4] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#18a5e2]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e9f1ff]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
