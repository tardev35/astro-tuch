---
// หวยกินดี365 is a เว็บแทงหวยออนไลน์ brand — every row stays inside what the brief
// states: หวยรัฐบาลไทย ลาวพัฒนา ฮานอย 3 รูปแบบ และหุ้นต่างประเทศ, การเลือกตลาดหวย
// รอบเดิมพัน เลขที่ต้องการ และจำนวนเงินผ่านมือถือ, การตรวจเวลาเปิด-ปิด เลขที่เลือก
// อัตราจ่าย และยอดรวมก่อนยืนยันโพย, การยึดวงเงินที่ระบบแสดง ณ เวลาส่งโพย, ระบบฝาก
// เครดิตออโต้ผ่านธนาคารและวอลเลท, การติดตามเครดิตและประวัติธุรกรรมผ่านบัญชีสมาชิก
// และการแจ้งเจ้าหน้าที่พร้อมประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดรายการ.
// The only rates quoted anywhere are the brief's own 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ
// 100. Nothing here promises a payout, a win rate, or a product the brief does
// not state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "เลือกตลาดหวยและรอบเดิมพันจากมือถือได้เอง",
    stars: 5,
    tag: "รัฐบาลไทย · ลาวพัฒนา · ฮานอย · หุ้นต่างประเทศ",
    content:
      "เลือกเล่นได้หลายตลาดโดยไม่ต้องสลับเว็บไซต์ ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย 3 รูปแบบ และหวยหุ้นต่างประเทศ เลือกตลาดหวย รอบเดิมพัน เลขที่ต้องการ และจำนวนเงินผ่านมือถือได้ด้วยตัวเอง ส่วนคำว่ารับแทงไม่อั้นก็ยึดวงเงินที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก เพราะบางรอบหรือบางหมายเลขอาจรับต่างกัน",
    avatar: "🎯",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ตรวจอัตราจ่ายบนหน้าแทงหวยก่อนกดยืนยันเสมอ",
    stars: 5,
    tag: "3 ตัวบาทละ 1,000 · 2 ตัวบาทละ 100",
    content:
      "ชอบที่มีอัตราจ่ายให้ตรวจสอบก่อนตัดสินใจ เรทที่กำหนดสำหรับหน้านี้คือเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 คำนวณยอดตามเรทเบื้องต้นได้ก่อนส่งโพย แต่ก่อนยืนยันก็ยังตรวจเวลาเปิด-ปิด เลขที่เลือก อัตราจ่ายจริง และยอดรวมอีกครั้ง เพราะรายละเอียดของหวยแต่ละประเภทอาจไม่เหมือนกัน",
    avatar: "🧮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "แจ้งประเภทหวย รอบเดิมพัน เวลา และจำนวนเงินให้เจ้าหน้าที่",
    stars: 4,
    tag: "ฝากออโต้ · เจ้าหน้าที่ 24 ชั่วโมง",
    content:
      "ฝากเครดิตผ่านระบบออโต้โดยเลือกช่องทางวอลเลทที่เว็บไซต์เปิดรองรับ แล้วตรวจจำนวนเงินและรายละเอียดบัญชีก่อนยืนยัน รอบที่เครดิตยังไม่ขึ้นก็เช็กประวัติธุรกรรมในบัญชีสมาชิกก่อน จากนั้นติดต่อเจ้าหน้าที่พร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดรายการ ทำให้ค้นหาข้อมูลได้ตรงจุด ทีมงานยังย้ำให้เก็บหลักฐานไว้จนกว่าการตรวจสอบจะเรียบร้อย และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่น",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก หวยกินดี365" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbe473] via-[#f6db6b] to-[#c9a23a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#5ec2f5]">หวยกินดี365</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f6db6b] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f6db6b]/40 bg-[#062a6b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(246,219,107,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbe473] to-[#c9a23a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#93a8ce] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#f6db6b]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f6db6b]" : "text-[#2c4a86]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dce7fb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f6db6b]/40 bg-[#062a6b]/92 p-6 text-left shadow-[0_10px_30px_rgba(2,10,30,0.7)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fbe473]/70 hover:shadow-[0_15px_40px_rgba(246,219,107,0.30)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbe473] to-[#c9a23a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#f6db6b]/20 blur-[50px] transition-all duration-300 group-hover:bg-[#0a6dfb]/35"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f6db6b]/45 bg-[#03153b] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f6db6b] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5ec2f5]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f6db6b]" : "text-[#2c4a86]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dce7fb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f6db6b]/40 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f6db6b]/55 bg-gradient-to-br from-[#fbe473] via-[#f6db6b] to-[#c9a23a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f6db6b] transition-colors group-hover:text-[#fbe473]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#93a8ce] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
