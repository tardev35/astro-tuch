---
// MEPAY77 is a คาสิโนออนไลน์ brand (บาคาร่า / สล็อต / หวย / บอล) — every row stays
// inside what the brief states: เกมเดิมพันหลักทั้งบาคาร่าออนไลน์และคาสิโนสด สล็อต
// ออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ และการเดิมพันฟุตบอลตามรายการ
// แข่งขัน, การสลับหมวดเกมผ่านบัญชีเดียวโดยไม่ต้องสมัครหลายครั้ง, การตรวจสอบกติกา
// อัตราจ่าย และวงเงินก่อนยืนยันเดิมพัน, ผลของเกมที่ไม่แน่นอนและไม่มีเกมใดรับประกันว่า
// แตกง่ายหรือสร้างกำไรได้ทุกครั้ง, การ Login ดูโปรโมชั่นที่เปิดให้รับพร้อมยอดที่ใช้
// คำนวณ รอบรับโบนัส ประเภทเกม และเงื่อนไข, โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%,
// ระบบฝากถอนวอลเลทหรือธนาคารตามช่องทางที่เปิดรองรับพร้อมการตรวจสถานะรายการจากมือถือ,
// และแอดมินที่รับเรื่องตลอด 24 ชั่วโมงโดยแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state. Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
//
// Layout redesign for MEPAY77: the previous brand ran a centred header, a
// centred rating pill and a 3-up grid of vertical cards. This is a full-width
// LEDGER instead — a left-anchored header rail, one horizontal score bar, and
// one full-width row per review with the member's identity pinned in a left rail
// and the quote filling the rest. Gold carries the score/quote furniture,
// brushed silver carries the identity rail, so the two halves of the wordmark
// are both doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "สลับหมวดบาคาร่า สล็อต หวย และบอลจากบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า · คาสิโนสด · สล็อต · หวย · บอล",
    content:
      "เปิดบัญชีเดียวแล้วสลับหมวดเกมได้ตามความสนใจ ทั้งบาคาร่าออนไลน์กับคาสิโนสด สล็อตออนไลน์จากหลายค่าย หวยออนไลน์ตามรอบที่เปิดให้บริการ และเดิมพันฟุตบอลตามรายการแข่งขัน ไม่ต้องสมัครหลายครั้งเพื่อเข้าอีกหมวดหนึ่ง ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ เลือกเกม ดูโปรโมชั่น ฝากถอน และจัดการเครดิตอยู่ในระบบเดียวกัน",
    avatar: "🃏",
  },
  {
    name: "คุณศิริพร ว.",
    role: "อ่านกติกาและอัตราจ่ายให้ครบก่อนยืนยันเดิมพัน",
    stars: 5,
    tag: "กติกา · อัตราจ่าย · วงเงินของแต่ละเกม",
    content:
      "ชอบที่ตรวจกติกา อัตราจ่าย และวงเงินของแต่ละเกมได้ก่อนกดยืนยัน เพราะเกมสล็อตและเกมคาสิโนมีผลลัพธ์ไม่แน่นอน ไม่มีเกมไหนรับประกันว่าแตกง่ายหรือทำกำไรได้ทุกครั้ง เลยเลือกเกมจากกติกา รูปแบบการเดิมพัน และงบประมาณที่เหมาะกับตัวเองมากกว่า ส่วนฝั่งโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่เปิดให้รับในช่วงนั้นผ่านบัญชีตัวเองได้เลย",
    avatar: "🎯",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ฝากถอนวอลเลทเอง แล้วเช็กสถานะรายการจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3% · แอดมิน 24 ชม.",
    content:
      "เลือกใช้วอลเลทหรือธนาคารจากช่องทางที่เว็บไซต์เปิดรองรับ ฝากเครดิต ส่งคำขอถอน แล้วดูสถานะรายการจากมือถือได้เอง ไม่ต้องแจ้งเจ้าหน้าที่ทุกครั้ง แต่ละช่องทางมีขั้นต่ำกับวงเงินสูงสุดไม่เท่ากัน ก็เข้าไปดูข้อมูลล่าสุดในหน้าฝากถอนก่อนทำรายการ โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ดูยอดที่เข้าเกณฑ์และรอบรับได้จากบัญชีสมาชิก รอบไหนติดปัญหาก็ติดต่อแอดมินได้ตลอด 24 ชั่วโมง โดยแจ้งเวลา จำนวนเงิน และรายละเอียดรายการไปด้วย และไม่ควรบอกรหัสผ่านหรือ OTP ให้ใคร",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MEPAY77" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdcc5c] via-[#dfe3e8] to-[#a3701c] shadow-[0_0_12px_rgba(253,204,92,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f1e5cd] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fdcc5c]">ME</span><span class="text-[#dfe3e8]">PAY</span><span class="text-[#fdcc5c]">77</span>
      </p>
      <span class="text-xs tracking-wide text-[#cdb98a]">บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกหมวดเกม การตรวจเงื่อนไขก่อนเดิมพัน และการฝากถอนผ่านบัญชีของตนเอง</span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-[#5c3a08] border-l-4 border-l-[#fdcc5c] bg-[#1b1206]/92 px-6 py-4 shadow-[0_10px_30px_rgba(10,6,1,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fff6e0] to-[#f2ae35] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#a08a5c]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5c3a08] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fdcc5c]" : "text-[#5c3a08]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f1e5cd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#aab0b8]/45 bg-[#130c01] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dfe3e8] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#5c3a08] bg-[#1b1206]/92 p-5 shadow-[0_10px_30px_rgba(10,6,1,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#f2ae35]/60 hover:shadow-[0_15px_40px_rgba(242,174,53,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f2ae35]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#f2ae35]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#5c3a08] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#aab0b8]/50 bg-gradient-to-br from-[#dfe3e8] via-[#aab0b8] to-[#5c3a08] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#dfe3e8] transition-colors group-hover:text-[#fff6e0]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#a08a5c]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fdcc5c]" : "text-[#5c3a08]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a3701c]/50 bg-[#130c01] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdcc5c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f2ae35]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f1e5cd]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
