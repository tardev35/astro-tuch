// สลับขาวพิมพ์เลข 69 และ 6 · มงกุฎทองดวงเล็ก · ต้นไม้ใบเขียวในกระถาง · สูทขาว ·
// โน้ตบุ๊กบนโต๊ะ และผิวโครเมียมเงินของเวิร์ดมาร์กบนอาร์ตเวิร์กเป็น **วัตถุในภาพ**
// ส่วนฉากห้องสีขาวครีมคือที่มาของผิวสว่าง ไม่ใช่สีของ UI คนละชุด)
const reviews = [
  {
    name: "คุณธีรภัทร ว.",
    role: "ไล่อ่านกติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการให้จบก่อน แล้วค่อยตัดสินใจใช้งาน",
    stars: 5,
    tag: "เกมเดิมพันออนไลน์หลากหลายประเภท · ค่ายแท้ ถูกลิขสิทธิ์ · เซิร์ฟนอก",
    content:
      "ที่เปิดดูต่อเพราะเว็บไซต์นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่รวมไว้ในที่เดียว ภายในเว็บไซต์มีข้อมูลเกมจากค่ายต่าง ๆ ให้ศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการได้ก่อนเริ่ม รวมถึงระบุการใช้งานระบบเซิร์ฟเวอร์ต่างประเทศและการเชื่อมต่อเกมผ่านแพลตฟอร์มออนไลน์ไว้ด้วย ส่วนที่อยากกำกับไว้ให้ตรงกันคือคำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทยไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว จึงยังไล่ดูรายชื่อค่ายเกม ข้อมูลบริษัทผู้ให้บริการ และหลักฐานการได้รับอนุญาตอย่างชัดเจน พร้อมตรวจนโยบายคุ้มครองข้อมูลส่วนบุคคลและข้อกำหนดทางกฎหมายที่เกี่ยวข้องก่อนใช้งานทุกครั้ง",
    avatar: "👑",
    accent: "forest" as const,
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "อ่านประกาศโปรโมชั่นล่าสุดให้ครบ แล้วค่อยตรวจรอบคำนวณยอดอีกครั้งก่อนเข้าร่วม",
    stars: 5,
    tag: "โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ส่วนที่เปิดดูบ่อยที่สุดคือหน้าโปรโมชั่น ซึ่งระบุรายการคืนยอดเสีย 0.3% ที่คืนเครดิตจากยอดเสียตามเงื่อนไขรายวัน กับโบนัสแนะนำเพื่อน 0.8% สำหรับสมาชิกที่แนะนำผู้ใช้งานรายใหม่ และมีรายละเอียดที่อัปเดตในแต่ละสัปดาห์ให้ติดตามช่วงเวลารับสิทธิ์กับเงื่อนไขการใช้เครดิต ก่อนกดรับสิทธิ์จะไล่ดูก่อนว่าประเภทเกมใดเข้าร่วมรายการ รอบเวลาคำนวณยอดเป็นอย่างไร และต้องรับเครดิตด้วยวิธีใด เพราะยอดเดิมพันบางรายการอาจไม่เข้าเกณฑ์รับสิทธิ์ ส่วนโบนัสแนะนำเพื่อนก็ยังตรวจวิธีเชื่อมโยงบัญชี ฐานยอดที่ใช้คำนวณโบนัส และรอบจ่ายเครดิตให้ชัดเจน แม้จะระบุว่าไม่จำกัด แต่ควรตรวจสอบว่ามีข้อกำหนดเกี่ยวกับจำนวนบัญชี วงเงินโบนัส หรือเงื่อนไขการถอนเงินหรือไม่ ที่ต้องเข้าใจตรงกันคือโปรโมชั่นคืนยอดเสียไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือเพิ่มโอกาสชนะในครั้งถัดไป",
    avatar: "🪴",
    accent: "surface" as const,
  },
  {
    name: "คุณอนุชา ก.",
    role: "ตรวจช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความทุกครั้ง",
    stars: 4,
    tag: "สมัครเล่นไม่มีขั้นต่ำ 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.",
    content:
      "ขั้นตอนสมัครสมาชิกศึกษาได้จากเมนูลงทะเบียนของเว็บไซต์ ซึ่งแบ่งไว้เป็น 3 ขั้นตอน คือเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลและยืนยันบัญชี แล้วจึงเข้าสู่ระบบไปตรวจสอบรายละเอียดบริการ เปิดผ่านเบราว์เซอร์บนมือถือหรืออุปกรณ์ที่เชื่อมต่ออินเทอร์เน็ตได้ตามที่เว็บไซต์ระบุ แต่ก่อนดำเนินการยังควรตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้อง อ่านข้อกำหนดการเปิดบัญชี ข้อกำหนดด้านอายุ กฎหมายที่เกี่ยวข้อง และนโยบายความเป็นส่วนตัวให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก ไม่ใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ อีกจุดที่ตรวจไว้คือข้อความไม่มีขั้นต่ำครอบคลุมเฉพาะการสมัครสมาชิกหรือรวมถึงการฝากเงินและการเดิมพันด้วย ส่วนการติดต่อ เว็บไซต์ระบุช่องทางสอบถามเจ้าหน้าที่เกี่ยวกับการสมัครสมาชิก การเข้าสู่ระบบ รายชื่อเกม โปรโมชั่น และปัญหาการใช้งานบัญชี ซึ่งควรตรวจสอบช่องทางจากเว็บไซต์ทางการก่อนส่งข้อความ เพื่อหลีกเลี่ยงบัญชีแอบอ้าง หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม จะเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ พร้อมแจ้งรายละเอียดให้ชัดเจน ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง",
    avatar: "💻",
    accent: "forest" as const,
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากผู้ใช้งาน ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0b4a12] via-[#1a7d24] to-[#28c437] shadow-[0_0_12px_rgba(26,125,36,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-wide text-[#10280f] uppercase sm:text-3xl">
        เสียงจากผู้ใช้งาน <span class="text-[#116018]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#10280f]">
        ความคิดเห็นตัวอย่าง {reviews.length} รายการ ครอบคลุมข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภทจากค่ายต่าง ๆ โปรโมชั่นคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% ขั้นตอนสมัครเล่นไม่มีขั้นต่ำ 3 ขั้นตอน และช่องทางติดต่อแอดมินที่เว็บไซต์ระบุว่าเปิดตลอด
        24ชม.
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#b2dba3] border-l-[#1a7d24] bg-white px-6 py-4 shadow-[0_10px_30px_rgba(17,96,24,0.12)] sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl leading-none font-black text-[#116018]">{average}</span>
      <span class="text-sm font-black text-[#3c5b36]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#b2dba3] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#8a6a0e]" : "text-[#8a6a0e]/25"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#10280f]">คะแนนเฉลี่ย {average} จาก 5 ดาว คำนวณจากความคิดเห็นตัวอย่าง {reviews.length} รายการในหน้านี้</span>
    </div>
    <span class="rounded-full border border-[#b2dba3] bg-[#e6f7df] px-3 py-1 text-[10px] font-bold tracking-wide text-[#3c5b36] uppercase sm:ml-auto">ข้อความตัวอย่าง</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#b2dba3] bg-white p-5 shadow-[0_10px_30px_rgba(16,40,15,0.1)] transition-all duration-300 hover:border-[#3f7a2e] hover:shadow-[0_15px_40px_rgba(26,125,36,0.22)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#28c437]/14 blur-[60px] transition-all duration-300 group-hover:bg-[#28c437]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#b2dba3] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105 ${
                review.accent === "forest"
                  ? "border border-[#0b4a12] bg-gradient-to-br from-[#0b4a12] via-[#116018] to-[#1a7d24] text-white"
                  : "border border-[#b2dba3] bg-gradient-to-br from-white to-[#e6f7df] text-[#10280f]"
              }`}>
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#10280f] transition-colors group-hover:text-[#116018]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#3c5b36]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#8a6a0e]" : "text-[#8a6a0e]/25"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#b2dba3] bg-[#e6f7df] px-3 py-1 text-[10px] font-bold tracking-wide text-[#3c5b36] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#28c437]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#10280f]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
