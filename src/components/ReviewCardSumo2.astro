---
// TTN69 is a สล็อตออโต้เกม brand — every row stays inside what the brief states:
// การรวมเกมจากหลายแบรนด์ไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต
// และเกมธีมใหม่จากผู้ให้บริการต่าง ๆ, การใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์,
// ระบบออโต้ที่ให้ฝากเครดิต ส่งคำขอถอน และตรวจสถานะผ่านบัญชีสมาชิกได้เอง, เงื่อนไข
// "ขั้นต่ำ 1 บาททุกค่าย" และ "รองรับทุกธนาคาร" ที่ต้องยึดช่วงเดิมพันในเกมและช่อง
// ทางที่เปิดใช้งานจริง ณ เวลานั้น, โบนัสแนะนำเพื่อน 0.8% พร้อมรอบคำนวณและยอดที่
// เข้าเกณฑ์, และ LINE OFFICIAL ที่ติดต่อแอดมินได้ตลอด 24 ชั่วโมง.
// Nothing here promises a payout, a win rate, or a product the brief does not
// state — the brief says outright that คำว่าแตกง่ายหรือแตกหนักรับประกันผลลัพธ์
// ไม่ได้ เพราะแต่ละเกมมีระบบและความผันผวนต่างกัน. Written testimonial text only —
// no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. Emerald carries the
// score/quote furniture, chrome-white carries the identity rail, so both halves
// of the TTN69 logo — the snow cap and the emerald ridge — are doing work.
const reviews = [
  {
    name: "คุณธนพล ศ.",
    role: "รวมเกมสล็อตจากหลายแบรนด์ไว้ในบัญชีเดียว",
    stars: 5,
    tag: "สล็อตคลาสสิก · เกมโบนัส · ฟรีสปิน · แจ็กพอต",
    content:
      "เปิดบัญชีเดียวแล้วเลือกเกมสล็อตจากหลายแบรนด์ได้ตามสไตล์ที่สนใจ ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน แจ็กพอต และเกมธีมใหม่ที่แต่ละค่ายเปิดให้บริการ สลับค่ายได้โดยไม่ต้องสมัครใหม่ทุกครั้ง ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เลือกเกม ฝากถอน ตรวจสอบโปรโมชั่น และจัดการเครดิตอยู่ในหน้าเว็บไซต์เดียวกัน",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ว.",
    role: "ดูช่วงเดิมพันในเกมและเงื่อนไขในหน้าฝากถอนก่อนทุกครั้ง",
    stars: 5,
    tag: "ช่วงเดิมพันในเกม · เงื่อนไขที่ระบบแสดง",
    content:
      "ก่อนทำรายการจะเข้าไปดูรายชื่อธนาคาร ยอดขั้นต่ำ วงเงิน และสถานะของช่องทางก่อนเสมอ เพราะแต่ละช่องทางกำหนดเงื่อนไขไม่เท่ากัน ส่วนคำว่าขั้นต่ำ 1 บาททุกค่ายก็ยึดช่วงเดิมพันที่แสดงอยู่ในเกมนั้นเป็นหลัก ไม่ได้เอาจากข้อความโฆษณา เพราะขั้นต่ำจริงต่างกันตามผู้ให้บริการแต่ละราย",
    avatar: "🎮",
  },
  {
    name: "คุณอนุชิต ก.",
    role: "ฝากถอนวอลเลทเอง แล้วเช็กโปรโมชั่นจากบัญชี",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · LINE OFFICIAL 24 ชม.",
    content:
      "เลือกใช้บัญชีธนาคารหรือวอลเลทตามช่องทางที่เว็บไซต์เปิดรองรับ ฝากเครดิต ส่งคำขอถอน และตามสถานะผ่านบัญชีสมาชิกได้เองบนมือถือ ส่วนโปรโมชั่นก็ Login เข้าไปดูสิทธิ์ที่รับได้ผ่านบัญชีตัวเอง โบนัสแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ ก่อนกดรับควรดูรอบคำนวณ ประเภทเกมที่เข้าร่วม และเงื่อนไขล่าสุดให้ครบ รอบไหนติดปัญหาก็ทักแอดมินผ่าน LINE OFFICIAL ได้ตลอด 24 ชั่วโมง และไม่ควรบอกรหัสผ่านหรือ OTP ให้ใคร",
    avatar: "💳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TTN69" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ce68f] via-[#e4ece7] to-[#046b3a] shadow-[0_0_12px_rgba(2,185,97,0.45)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f1faf4] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e4ece7]">TTN</span><span class="text-[#02b961]">69</span>
      </p>
      <span class="text-xs tracking-wide text-[#9db0a4]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมสล็อตจากหลายแบรนด์ การตรวจช่วงเดิมพันก่อนเริ่มเล่น และการฝากถอนผ่านบัญชีของตนเอง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#046b3a] border-l-[#02b961] bg-[#061309]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,8,5,0.6)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f1faf4] to-[#02b961] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#9db0a4]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#046b3a] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#4ce68f]" : "text-[#046b3a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d5e6da]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#e4ece7]/45 bg-[#020805] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e4ece7] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#046b3a] bg-[#061309]/92 p-5 shadow-[0_10px_30px_rgba(2,8,5,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-[#02b961]/70 hover:shadow-[0_15px_40px_rgba(2,185,97,0.24)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#02b961]/12 blur-[60px] transition-all duration-300 group-hover:bg-[#02b961]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#046b3a] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e4ece7]/50 bg-gradient-to-br from-[#e4ece7] via-[#9db0a4] to-[#046b3a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#e4ece7] transition-colors group-hover:text-[#f1faf4]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#9db0a4]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#4ce68f]" : "text-[#046b3a]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#046b3a]/60 bg-[#020805] px-3 py-1 text-[10px] font-bold tracking-widest text-[#4ce68f] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#02b961]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#d5e6da]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
