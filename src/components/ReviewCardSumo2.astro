---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้บรีฟเป็นเว็บแทงหวยออนไลน์ ทุกแถวจึงอยู่ในกรอบที่บรีฟระบุไว้เอง: รวมบริการแทงหวยออนไลน์
// หลายประเภทไว้ในระบบเดียว, อัตราจ่ายที่ระบุชัดเจนทั้งเลข 2 ตัวและ 3 ตัว (3 ตัวสูงสุด 1,000
// และ 2 ตัว 100), รูปแบบไม่ลดเรทตามเงื่อนไขที่กำหนด, รองรับการทำรายการผ่านวอลเลทและช่องทาง
// บัญชีบริษัทโดยตรงโดยไม่ผ่านช่องทางบุคคลอื่น, ระบบสมาชิกที่ช่วยติดตามยอด รายการย้อนหลัง และ
// ข้อมูลการแทงหวยจากหน้าเดียว, การตรวจสอบอัตราจ่าย รอบหวย และรายละเอียดบิลก่อนยืนยัน,
// โบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% พร้อมยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไข,
// การสมัครด้วยตัวเองผ่านหน้าเว็บไซต์ และการติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนพูดถึงสล็อต ค่ายเกม RTP บาคาร่า ไลฟ์สด ชื่อธนาคาร วัน-เวลาออกรางวัล หรือ
// รับปากว่าจะถูกรางวัล
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): โลโก้เป็นเวิร์ดมาร์กสองส่วน LOTTO เป็นโครเมียมขาว
// แล้วปิดด้วย 24 สีแดง งานอาร์ตล้อมด้วยลูกหวยแดง-ขาวและกองเหรียญทอง การ์ดรีวิวจึงใช้แดงกับ
// ทองแยกหน้าที่กัน — สันนำหน้าหัวข้อ ป้ายระบุตัวสมาชิก และดาว เป็นแดง (แดงสว่าง #fc2b2c →
// แดงแบรนด์ #dc2626 → แดงลึก #b40102) ส่วนคะแนนเฉลี่ยและป้ายแท็กรับทอง (#fde68a #fbbf24
// #a16207) ตามกองเหรียญ กรอบการ์ดกับเส้นคั่นเป็นแดงเข้ม #7f1d1d บนผิวการ์ด #2a0405 เหนือ
// พื้นลึก #140202 เนื้อความเป็น BRAND_TEXT #f6e2e2 และตัวเน้นเป็น #fff1f1 — ชุดชมพูนีออน-
// ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #7d1550 #8b3df3 #c9a4ff #4a17a0 #3d1180 #0f0518
// #070109 #f2dcee #fff2fb) ออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกรอบหวยและเลขที่ต้องการจากหน้าเว็บไซต์",
    stars: 5,
    tag: "แทงหวยหลายประเภท · ระบบเดียว",
    content:
      "ที่ใช้ต่อเพราะรวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียวจริง อัตราจ่ายระบุชัดเจนทั้งเลข 2 ตัวและ 3 ตัว คือ 3 ตัวสูงสุด 1,000 และ 2 ตัว 100 ตามเงื่อนไขของแต่ละรายการ เข้าสู่ระบบแล้วเลือกรอบหวยกับเลขที่ต้องการได้เลย แล้วตรวจอัตราจ่ายและรายละเอียดบิลก่อนยืนยันได้ทุกครั้ง",
    avatar: "🎫",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ทำรายการผ่านวอลเลทและช่องทางบัญชีบริษัท",
    stars: 5,
    tag: "ยอดเข้า บช.บริษัท · ไม่ผ่านม้า",
    content:
      "รองรับการทำรายการผ่านช่องทางบัญชีบริษัทตามข้อมูลที่เว็บไซต์กำหนด และผ่านวอลเลทตามรายการที่ระบบเปิดให้ใช้งาน ทำให้ตรวจสอบรายละเอียดบัญชีและสถานะรายการได้ชัดเจนก่อนดำเนินการ โดยไม่ต้องผ่านช่องทางบุคคลอื่น ระบบสมาชิกยังช่วยติดตามยอด รายการย้อนหลัง และข้อมูลการแทงหวยได้จากหน้าเดียว",
    avatar: "🏢",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บไซต์ แล้วสอบถามเจ้าหน้าที่ทางไลน์",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% · คืนยอดเสีย 0.3%",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนเข้าใจง่าย กรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจข้อมูลส่วนตัวกับรายละเอียดบัญชีให้ถูกต้อง แล้วเข้าสู่ระบบเพื่อเลือกรอบหวยและเลขที่ต้องการ ฝั่งโปรโมชั่นมีโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% ซึ่งตรวจยอดที่เข้าเกณฑ์ รอบคำนวณ และเงื่อนไขได้ก่อนกดรับ ติดตรงไหนก็ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ได้ตลอด 24 ชั่วโมง",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fc2b2c] via-[#dc2626] to-[#b40102] shadow-[0_0_12px_rgba(220,38,38,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#fff1f1] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#fc2b2c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f6e2e2]/75">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกรอบหวยและเลขที่ต้องการจากระบบเดียว การทำรายการผ่านวอลเลทและช่องทางบัญชีบริษัทโดยตรง และการตรวจอัตราจ่ายกับเงื่อนไขโปรโมชั่นก่อนยืนยัน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#7f1d1d] border-l-[#dc2626] bg-[#2a0405]/94 px-6 py-4 shadow-[0_10px_30px_rgba(6,1,1,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fde68a] to-[#a16207] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f6e2e2]/75">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7f1d1d] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fc2b2c]" : "text-[#7f1d1d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e2e2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#fbbf24]/50 bg-[#140202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fde68a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#7f1d1d] bg-[#2a0405]/94 p-5 shadow-[0_10px_30px_rgba(6,1,1,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#fc2b2c]/70 hover:shadow-[0_15px_40px_rgba(220,38,38,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#dc2626]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#fbbf24]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#7f1d1d] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#fc2b2c]/65 bg-gradient-to-br from-[#fc2b2c] via-[#dc2626] to-[#b40102] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fff1f1] transition-colors group-hover:text-[#fde68a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f6e2e2]/75">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#fc2b2c]" : "text-[#7f1d1d]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#fbbf24]/45 bg-[#140202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fde68a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fc2b2c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e2e2]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
