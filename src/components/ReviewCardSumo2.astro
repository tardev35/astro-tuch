---
// FAH999 เป็นเว็บสล็อตที่รับสมัครยูสใหม่แบบไม่ล็อคยูส — ทุกแถวอยู่ในกรอบที่ brief
// ระบุไว้เอง: ระบบที่ใช้งานง่ายและไม่ล็อคยูส, สิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด,
// เกมจากหลายค่ายที่ตรวจสอบเงื่อนไขก่อนเข้าเล่นได้จากหน้าเดียว, ระบบจัดหมวดเกม
// ชัดเจนและตัวเลือกการเดิมพันที่หลากหลายตามแต่ละเกม, โบนัสคืนยอดเสีย 0.3% กับ
// โบนัสแนะนำเพื่อน 0.8% ที่ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น, ช่องทาง
// ธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งานพร้อมตรวจสอบยอดและสถานะฝากถอน
// จากบัญชีได้โดยตรง และแอดมินที่ให้บริการตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// FAH999: แถบระบุตัวสมาชิกไล่จากทองประกาย #f7e7a8 ลงทองหลัก #e8c25a ไปหาบรอนซ์
// #a3732c ส่วนกรอบการ์ดกับเส้นคั่นเป็นบรอนซ์เข้ม #6b4a18 บนพื้นการ์ด #12100b
// ตามโลโก้ที่เป็นทองบนดำสีเดียว แยกชั้นด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "สมัครยูสใหม่และเริ่มเล่นสล็อตจากหน้าเดียว",
    stars: 5,
    tag: "ยูสใหม่ ไม่ล็อคยูส",
    content:
      "สมัครเป็นยูสใหม่แล้วเริ่มเล่นได้เลย ระบบใช้งานง่ายและเน้นแบบไม่ล็อคยูสตามที่เว็บระบุไว้ เลือกเกมจากหลายค่ายได้และตรวจสอบเงื่อนไขของแต่ละเกมก่อนเข้าเล่นได้จากหน้าเดียว ระบบจัดหมวดเกมชัดเจนเลยหาเกมที่ต้องการได้ง่าย ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์",
    avatar: "🎰",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "ตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%",
    content:
      "โปรโมชั่นที่กำหนดไว้มีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขของตัวเอง ที่ชอบคือตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น ทั้งยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และเงื่อนไข ส่วนสิทธิ์โบนัสฝากแรกของยูสใหม่ก็ดูรายละเอียดได้จากหน้าเดียวกัน",
    avatar: "💰",
  },
  {
    name: "คุณอนุชา พ.",
    role: "จัดการบัญชีผ่านช่องทางที่เว็บเปิดให้ใช้งาน",
    stars: 4,
    tag: "ธนาคาร วอลเลท และแอดมิน 24 ชั่วโมง",
    content:
      "ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน เลือกช่องทางที่เหมาะกับตัวเองได้ ขั้นตอนจัดให้เข้าใจง่ายและทำรายการตามวงเงินกับเงื่อนไขที่ระบบกำหนด ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง ถ้าติดตรงไหนก็ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🏦",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก FAH999" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] shadow-[0_0_12px_rgba(232,194,90,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#e7dcc4] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f7e7a8]">FAH</span><span class="text-[#c49a41]">999</span>
      </p>
      <span class="text-xs tracking-wide text-[#e7dcc4]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการสมัครยูสใหม่แบบไม่ล็อคยูส การตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับ และการจัดการบัญชีผ่านช่องทางที่เว็บไซต์เปิดให้ใช้งาน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#6b4a18] border-l-[#e8c25a] bg-[#12100b]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f7e7a8] to-[#c49a41] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#e7dcc4]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#6b4a18] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8c25a]" : "text-[#6b4a18]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e7dcc4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#6b4a18] bg-[#0a0907] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f7e7a8] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#6b4a18] bg-[#12100b]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#e8c25a]/75 hover:shadow-[0_15px_40px_rgba(232,194,90,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a3732c]/25 blur-[60px] transition-all duration-300 group-hover:bg-[#f7e7a8]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#6b4a18] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e8c25a]/60 bg-gradient-to-br from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f7e7a8] transition-colors group-hover:text-[#e8c25a]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#e7dcc4]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e8c25a]" : "text-[#6b4a18]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e8c25a]/65 bg-[#0a0907] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f7e7a8] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8c25a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e7dcc4]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
