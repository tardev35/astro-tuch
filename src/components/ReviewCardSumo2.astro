---
import { BRAND_NAME } from "../lib/brandProfile";

// GUCCI168 (2026-10-08): บรีฟรอบนี้เป็น **เว็บคาสิโนไลฟ์ 24 ชม. + สล็อต + แทงบอล**
// ไม่ใช่เว็บสล็อตเบทต่ำแบบรอบ BOOM369/UOK365 ก่อนหน้า ทุกแถวจึงถูกเขียนใหม่ทั้งหมดจาก
// คำของบรีฟรอบนี้เอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิมที่ขายตัวเองว่า
// "สล็อตเบทต่ำ ทุนน้อย ค่ายตรง ถูกลิขสิทธิ์ ตารางจ่าย สล็อตเปิดใหม่" — คำชุดนั้นเป็นของ
// บรีฟรอบก่อน ไม่ใช่ของบรีฟนี้ และ brand-spec §2 สั่งห้ามไว้ตรงๆ
//
// กรอบที่บรีฟรอบนี้ระบุไว้เองคือ: รวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งบาคาร่า
// รูเล็ต ไฮโล สล็อต และบอล · เลือกโต๊ะสดหรือหมวดเกมจากบัญชีเดียว · ระบบจัดหมวดหมู่ชัดเจน
// สลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก · ไฮโลเน้นรูปแบบการเดิมพันที่เข้าใจง่าย ·
// สล็อตมีเกมโบนัส ฟรีสปิน และตัวคูณ · แทงบอลเลือกคู่แข่งขันและตลาดเดิมพันตามช่วงเวลา
// ที่ระบบเปิดรับ · โปรโมชั่นตามแคมเปญที่เปิดในแต่ละช่วง · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · บัญชีเดียวดูเครดิต โปรโมชั่น และประวัติรายการ ·
// ฝากถอน · แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// ห้ามใส่ชื่อค่ายเกม เลขใบอนุญาต ชื่อผู้ดำเนินงาน ชื่อธนาคาร ค่า RTP ยอดฝากขั้นต่ำ
// จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้มีสี่ตัว:
// 0.3% · 0.8% · 24 ชั่วโมง · 3 ขั้นตอน และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคงประโยค
// กำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว ("ไม่มีขั้นต่ำทุกรูปแบบเกม" ควรอ้างอิงวงเงินจริง
// ภายในระบบ · "คาสิโนไม่จำกัดยอด" ควรพิจารณาจากวงเงินของโต๊ะและเกมจริง ตรวจ Limit
// ก่อนเดิมพัน · โต๊ะคาสิโนไลฟ์และการแข่งขันกีฬาบางรายการมีช่วงเวลาให้บริการต่างกัน)
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §3 แดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง): สีหลักคือ **แดง
// แบรนด์** #c41115 สีรองคือ **เขียวมรกต** #0b7a33 และทองเป็นโลหะคั่น บนผิวการ์ดกลาง
// #140705 ไม่ใช่ผิวการ์ดมืดเขียวแบบรอบ BOOM369 — สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่แดง
// สว่าง #e0201f → แดงแบรนด์ #c41115 → แดงลึก #7a0505 บนตัวอักษรขาว (6.1:1 บน #c41115
// และ 4.8:1 บน #e0201f ซึ่งเป็นเพดานตาม §3) ชื่อแบรนด์ในหัวข้อใช้แดงสว่างบนพื้นมืด
// คะแนนเฉลี่ยไล่ขาว #ffffff → แดงสว่าง #e0201f ส่วนทอง #d9a521 ถูกใช้เฉพาะจุดที่ควร
// เป็นทองจริงๆ คือดาวที่ติดและป้ายหัวข้อแถว (เหรียญทองจีนในงานอาร์ตของแบรนด์) ดาวที่ยัง
// ไม่ติดใช้เขียวลึก #063f1c จุดกะพริบบนป้ายใช้เขียวสว่าง #2bbf63 ออรามุมขวาบนเป็นแดง
// แบรนด์โปร่ง กรอบการ์ดเป็นแดงแบรนด์โปร่ง ชิปตกลงไปที่ผิวลึกสุด #090302 เนื้อความและ
// ชื่อสมาชิก #f6e3cf (= BRAND_TEXT) ตัวรองใช้ #f6e3cf แบบลดความทึบเพื่อไม่สร้างสี
// นอกพาเลตต์ glow เป็น rgba(196,17,21,…)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #04ab3a #036b26 #03150a
// #07170f #041109 #dadcdc #f3c44a #9fb8aa #ffffff #cfe9d7 rgba(66,251,90,…))
// ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "สลับระหว่างคาสิโน สล็อต และกีฬาจากบัญชีเดียว",
    stars: 5,
    tag: "บาคาร่า · รูเล็ต · ไฮโล · สล็อต · บอล",
    content:
      "ที่ใช้ต่อเพราะรวมเกมเดิมพันหลายรูปแบบไว้ในระบบเดียว มีทั้งบาคาร่า รูเล็ต ไฮโล สล็อต และบอล เข้าเล่นผ่านมือถือและคอมพิวเตอร์ได้ แล้วเลือกโต๊ะสดหรือหมวดเกมที่สนใจจากบัญชีเดียว บาคาร่าและรูเล็ตมีโต๊ะให้เลือกตามรายการที่เปิดบริการ ไฮโลเน้นรูปแบบการเดิมพันที่เข้าใจง่าย ส่วนสล็อตมีทั้งเกมโบนัส ฟรีสปิน และตัวคูณ ขณะที่แทงบอลเลือกคู่แข่งขันและตลาดเดิมพันตามช่วงเวลาที่ระบบเปิดรับได้ ระบบจัดหมวดหมู่ชัดเจนจนสลับระหว่างคาสิโน สล็อต และกีฬาได้สะดวก ข้อที่อยากให้อ่านกันก่อนคือเกมไลฟ์และการแข่งขันบางรายการมีเวลาเปิดให้เดิมพันแตกต่างกัน จึงควรตรวจสอบสถานะจากระบบก่อนเริ่มทุกครั้ง",
    avatar: "🎴",
  },
  {
    name: "คุณศิริพร ก.",
    role: "Login ตรวจโปรโมชั่นและยอดที่เข้าเกณฑ์จากบัญชี",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ยอดที่เข้าเกณฑ์",
    content:
      "ชอบที่ Login เข้าไปตรวจสอบโบนัส ยอดที่เข้าเกณฑ์ และสถานะการรับสิทธิ์ผ่านบัญชีสมาชิกได้โดยตรง โปรโมชั่นมีสิทธิ์ให้สมาชิกตามแคมเปญที่เปิดในแต่ละช่วงและครอบคลุมเกมตามเงื่อนไขของรายการ ฝั่งคืนยอดเสียคือยอดเสียที่ตรงตามข้อกำหนดจะถูกนำมาคำนวณก่อนแสดงจำนวนโบนัส 0.3% ที่รับได้ตามรอบที่กำหนด ส่วนแนะนำเพื่อนก็ใช้ลิงก์แนะนำชวนเพื่อนเข้ามาสมัคร พอเพื่อนมียอดใช้งานตรงตามเงื่อนไข ระบบจะคำนวณโบนัส 0.8% จากยอดที่เข้าเกณฑ์ แล้วติดตามจำนวนเพื่อน ยอดคำนวณ และสถานะโบนัสผ่านบัญชีได้ตามรอบของโปรโมชั่น ข้อควรรู้คือโบนัสของแต่ละเกมอาจกำหนดวิธีคำนวณและเงื่อนไขไม่เหมือนกัน จึงควรอ่านรายละเอียด ตรวจประเภทเกม รอบตัดยอด และเงื่อนไขการใช้โบนัสก่อนกดรับทุกครั้ง",
    avatar: "💸",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัคร 3 ขั้นตอน แล้วใช้บัญชีเดียวดูทุกอย่าง",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · บัญชีเดียว · ฝากถอน · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านมือถือทำได้ใน 3 ขั้นตอน เริ่มจากเปิดหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด ต่อด้วยตรวจสอบและยืนยันข้อมูลบัญชีสมาชิก จากนั้น Login แล้วเลือกบาคาร่า รูเล็ต ไฮโล สล็อต หรือบอลที่ต้องการ หลังเปิดบัญชีก็เลือกหมวดเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการผ่านบัญชีเดียวได้ ส่วนคำว่า คาสิโนไม่จำกัดยอด ควรพิจารณาจากวงเงินของโต๊ะและเกมจริง เพราะเกมคาสิโนแต่ละรายการกำหนดยอดขั้นต่ำและสูงสุดแตกต่างกัน จึงควรตรวจสอบ Limit ของโต๊ะหรือเกมก่อนเดิมพันและกำหนดงบไว้ล่วงหน้า ตอนสมัคร Login เข้าโต๊ะคาสิโนไม่ได้ เกมไม่แสดง โปรโมชั่นมีปัญหา หรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ก็ติดต่อแอดมินผ่านช่องทางบริการหลักของเว็บไซต์ได้ตลอด 24 ชั่วโมง เรื่องคาสิโนไลฟ์เตรียมชื่อเกม โต๊ะ และเวลาที่เกิดเหตุไว้ แทงบอลระบุคู่แข่งขันและรายการที่เกี่ยวข้อง ส่วนธุรกรรมเตรียมเวลา จำนวนเงิน และหลักฐาน และไม่เปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] shadow-[0_0_12px_rgba(196,17,21,0.65)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f6e3cf] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e0201f]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f6e3cf]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกโต๊ะสดและหมวดเกมบาคาร่า รูเล็ต ไฮโล สล็อต และบอลจากบัญชีเดียว การตรวจสอบโบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% จากยอดที่เข้าเกณฑ์ และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน
        24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#c41115]/30 border-l-[#c41115] bg-[#140705] px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffffff] to-[#e0201f] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f6e3cf]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#7a0505] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d9a521]" : "text-[#063f1c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e3cf]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#d9a521]/45 bg-[#090302] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d9a521] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#c41115]/25 bg-[#140705] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#c41115]/70 hover:shadow-[0_15px_40px_rgba(196,17,21,0.28)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#c41115]/26 blur-[60px] transition-all duration-300 group-hover:bg-[#c41115]/40"
          />

          <div class="flex items-center gap-4 border-b border-[#7a0505] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#7a0505] bg-gradient-to-br from-[#e0201f] via-[#c41115] to-[#7a0505] text-2xl text-white shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f6e3cf] transition-colors group-hover:text-[#ffdf91]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f6e3cf]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#d9a521]" : "text-[#063f1c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#d9a521]/45 bg-[#090302] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d9a521] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2bbf63]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f6e3cf]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
