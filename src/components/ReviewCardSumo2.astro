---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือเว็บสล็อต "เว็บรวมสล็อตใหญ่ เกมแท้ค่ายดัง ครบทุกเกมฮิต" ทุกแถว
// จึงอยู่ในกรอบที่ brief ระบุไว้เอง: รวบรวมเกมแท้จากค่ายดังไว้ในระบบเดียว, เมนู
// จัดหมวดหมู่ชัดเจนใช้ได้ทั้งมือถือและคอมพิวเตอร์, เลือกเกมฮิตจากหลายค่ายผ่านบัญชี
// เดียวโดยไม่ต้องสลับหลายเว็บไซต์, ระบบ API เชื่อมต่อเกมจากค่ายตามที่เว็บไซต์ระบุ,
// โบนัสแนะนำเพื่อน 0.8% กับโบนัสคืนยอดเสีย 0.3% ตามเงื่อนไขของโปรโมชั่น, สมัครเอง
// ได้ใน 3 ขั้นตอน และแอดมินออนไลน์ 24 ชั่วโมง ไม่มีข้อความไหนรับปากว่าจะชนะหรือ
// บอกอัตราการจ่าย
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// HENG38 (รอบมรกต-ทอง 2026-09-22): แถบระบุตัวสมาชิกไล่จากทองอ่อน #fbeeb0 ลงทอง
// หลัก #f3cf63 ไปหาทองบรอนซ์ #a5761a ตามมงกุฎและลายกนกบนโลโก้ ส่วนกรอบการ์ดกับ
// เส้นคั่นเป็นมรกตกลาง #0f4423 บนพื้นการ์ด #061f0f เหนือพื้นเพจเขียวเกือบดำ
// #03140a ชื่อหัวข้อเป็นขาวงาช้าง #f1eee2 — กรมท่า-ทองของรอบก่อนออกทั้งหมด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมฮิตจากหลายค่ายผ่านบัญชีเดียว",
    stars: 5,
    tag: "เกมแท้ค่ายดัง รวมไว้ในระบบเดียว",
    content:
      "ที่เลือกใช้เพราะรวบรวมเกมแท้จากค่ายดังไว้ในระบบเดียว มีทั้งเกมยอดนิยม เกมใหม่ และสล็อตหลายรูปแบบให้เลือกตามสไตล์ที่ต้องการ เมนูจัดหมวดหมู่ชัดเจน ใช้งานได้ทั้งมือถือและคอมพิวเตอร์ เลยเลือกเกมฮิตจากหลายค่ายผ่านบัญชีเดียวได้โดยไม่ต้องสลับหลายเว็บไซต์เหมือนเดิม ก่อนเข้าเล่นก็ดูชื่อค่ายกับรายละเอียดเกมจากหน้าระบบก่อนทุกครั้ง",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "เช็กเงื่อนไขโปรโมชั่นให้ครบก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "โปรโมชั่นที่ใช้อยู่เน้นรายการที่ตรวจสอบเงื่อนไขและกดรับผ่านระบบได้ ทั้งโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ตามยอดและเงื่อนไขที่ระบบกำหนด ที่ชอบคือเปิดดูรายละเอียดของแต่ละโปรโมชั่นก่อนรับได้ เลยเช็กยอดที่เข้าเกณฑ์ รอบคำนวณ และข้อกำหนดที่เกี่ยวข้องได้ชัดเจน แล้วติดตามสิทธิ์ของตัวเองผ่านบัญชีสมาชิกได้โดยตรง",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครเองผ่านหน้าเว็บแล้วเข้าเล่นได้ทันที",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน และแอดมิน 24 ชั่วโมง",
    content:
      "สมัครผ่านหน้าเว็บไซต์ได้ด้วยตัวเอง ขั้นตอนไม่ซับซ้อน เปิดหน้าสมัครแล้วกรอกข้อมูลที่ระบบกำหนดให้ครบ ตรวจสอบข้อมูลส่วนตัวกับรายละเอียดบัญชีให้ถูกต้องก่อนกดยืนยัน จากนั้นเข้าสู่ระบบเลือกค่ายและเกมสล็อตที่ต้องการได้ทันที ถ้าติดตรงไหนก็ถามแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร การเข้าเกม โปรโมชั่น หรือระบบเครดิต และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "📝",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] shadow-[0_0_12px_rgba(243,207,99,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f1eee2] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f3cf63]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#b6c4ac]">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมฮิตจากหลายค่ายผ่านบัญชีเดียว การตรวจสอบเงื่อนไขโปรโมชั่นก่อนกดรับ และการสมัครเองผ่านหน้าเว็บไซต์
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#0f4423] border-l-[#f3cf63] bg-[#061f0f]/94 px-6 py-4 shadow-[0_10px_30px_rgba(3,20,10,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fbeeb0] to-[#f3cf63] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#b6c4ac]">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#0f4423] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f3cf63]" : "text-[#0f4423]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e6e2d2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#0f4423] bg-[#03140a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fbeeb0] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#0f4423] bg-[#061f0f]/94 p-5 shadow-[0_10px_30px_rgba(3,20,10,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#f3cf63]/75 hover:shadow-[0_15px_40px_rgba(243,207,99,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#15833c]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#f3cf63]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#0f4423] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#f3cf63]/60 bg-gradient-to-br from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#fbeeb0] transition-colors group-hover:text-[#f1eee2]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#b6c4ac]">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f3cf63]" : "text-[#0f4423]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f3cf63]/65 bg-[#03140a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fbeeb0] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f3cf63]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#e6e2d2]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
