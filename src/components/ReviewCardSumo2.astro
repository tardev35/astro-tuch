---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ brief คือ "สมัครสล็อตยูสใหม่ ไม่ล็อค โบนัสฝากแรก ไม่อั้น" ทุกแถวจึงอยู่ใน
// กรอบที่ brief ระบุไว้เอง: เปิดรับสมาชิกใหม่ผ่านระบบที่ใช้งานง่ายและไม่ล็อคยูส,
// สิทธิ์โบนัสฝากแรกตามเงื่อนไขที่กำหนด, สิทธิพิเศษเฉพาะสมาชิกทั้งยูสใหม่และยูสเดิม,
// เกมจากหลายค่ายกับระบบจัดหมวดเกมที่ชัดเจนจนค้นหาจากหน้าเดียวได้, ตัวเลือกการ
// เดิมพันหลากหลายตามแต่ละเกม, รองรับทั้งมือถือและคอมพิวเตอร์, โบนัสคืนยอดเสีย
// 0.3% กับแนะนำเพื่อน 0.8% ที่ตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น,
// ช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งานพร้อมตรวจสอบยอดและ
// สถานะฝากถอนจากบัญชีได้โดยตรง และแอดมินที่ให้บริการตลอด 24 ชั่วโมง
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// HENG35 (รอบดำ-ทอง 2026-09-21): แถบระบุตัวสมาชิกไล่จากทองสว่าง #fefac4 ลง
// ทองหลัก #ecc55c ไปหาบรอนซ์ #a3732c ส่วนกรอบการ์ดกับเส้นคั่นเป็นบรอนซ์เข้ม
// #5e4418 บนพื้นการ์ด #12100b เหนือพื้นเพจดำ #070605 ตามโลโก้มงกุฎทองบนพื้นดำ —
// แบรนด์นี้มีทองสีเดียว จึงแยกชั้นด้วยความสว่าง ไม่ใช่ด้วยสีที่สองอย่างรอบก่อน
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "สมัครยูสใหม่แล้วเริ่มเล่นแบบไม่ล็อคยูส",
    stars: 5,
    tag: "ยูสใหม่ ไม่ล็อคยูส",
    content:
      "สมัครเป็นสมาชิกใหม่แล้วเริ่มเล่นผ่านระบบที่ใช้งานง่ายตามที่เว็บระบุไว้ จุดเด่นคือไม่ล็อคยูส เลือกเกมและค่ายที่ต้องการได้ตามรายการที่รองรับ ระบบจัดหมวดเกมไว้ชัดเจนเลยค้นหาเกมที่อยากเล่นได้จากหน้าเดียว ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ ส่วนสิทธิ์โบนัสฝากแรกก็ตรวจสอบเงื่อนไขได้ก่อนรับ",
    avatar: "🔓",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "ตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับทุกครั้ง",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%",
    content:
      "โปรโมชั่นที่กำหนดไว้มีโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% แต่ละรายการมีเงื่อนไขและวิธีรับสิทธิ์ของตัวเอง ที่ชอบคือตรวจสอบรายละเอียดก่อนกดรับได้จากหน้าโปรโมชั่น ทั้งยอดที่เข้าเกณฑ์ รอบรับสิทธิ์ และรอบคำนวณ ส่วนยอดสิทธิ์ของกิจกรรมแนะนำเพื่อนก็ดูได้จากบัญชีสมาชิก",
    avatar: "💰",
  },
  {
    name: "คุณอนุชา พ.",
    role: "จัดการบัญชีผ่านช่องทางที่เว็บเปิดให้ใช้งาน",
    stars: 4,
    tag: "ธนาคาร วอลเลท และแอดมิน 24 ชั่วโมง",
    content:
      "ระบบรองรับช่องทางธนาคารและวอลเลทตามรายการที่เว็บไซต์เปิดให้ใช้งาน เลือกช่องทางที่เหมาะกับตัวเองได้ ขั้นตอนจัดไว้ให้เข้าใจง่าย ตรวจสอบยอดและสถานะฝากถอนจากบัญชีได้โดยตรง ถ้าติดตรงไหนก็ติดต่อแอดมินได้ตลอด 24 ชั่วโมง ทั้งเรื่องการสมัคร โบนัสฝากแรก โปรโมชั่น การเข้าเกม หรือระบบฝากถอน และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🏦",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fefac4] via-[#ecc55c] to-[#a3732c] shadow-[0_0_12px_rgba(236,197,92,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ece1cb] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ecc55c]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#ece1cb]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการสมัครยูสใหม่แบบไม่ล็อคยูสกับการค้นหาเกมจากหน้าเดียว การตรวจสอบรายละเอียดโปรโมชั่นก่อนกดรับ และการจัดการบัญชีผ่านช่องทางที่เว็บไซต์เปิดให้ใช้งาน
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#5e4418] border-l-[#ecc55c] bg-[#12100b]/94 px-6 py-4 shadow-[0_10px_30px_rgba(7,6,5,0.75)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fefac4] to-[#ecc55c] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ece1cb]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#5e4418] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ecc55c]" : "text-[#5e4418]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece1cb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#5e4418] bg-[#070605] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffdf8a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#5e4418] bg-[#12100b]/94 p-5 shadow-[0_10px_30px_rgba(7,6,5,0.75)] backdrop-blur-xl transition-all duration-300 hover:border-[#ecc55c]/75 hover:shadow-[0_15px_40px_rgba(236,197,92,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a3732c]/30 blur-[60px] transition-all duration-300 group-hover:bg-[#ecc55c]/24"
          />

          <div class="flex items-center gap-4 border-b border-[#5e4418] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ecc55c]/60 bg-gradient-to-br from-[#fefac4] via-[#ecc55c] to-[#a3732c] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#ffdf8a] transition-colors group-hover:text-[#fefac4]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ece1cb]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ecc55c]" : "text-[#5e4418]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#ecc55c]/65 bg-[#070605] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffdf8a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ecc55c]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ece1cb]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
