---
import { BRAND_NAME } from "../lib/brandProfile";

// NAZA99 (รอบทอง-ดำ 2026-10-02): บรีฟรอบนี้เป็นเว็บสล็อตออนไลน์ล้วน ทุกแถวจึงถูกเขียนใหม่
// ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคเดิม กรอบที่บรีฟระบุไว้
// เองคือ: รวมเกมสล็อตหลายสไตล์จากค่ายยอดนิยมไว้ในระบบเดียว ทั้งเกมโบนัส ฟรีสปิน ตัวคูณ ·
// สามเกมที่บรีฟระบุชื่อคือ Mahjong Ways 2, Fortune Tiger และ Sweet Bonanza · รองรับการ
// ใช้งานผ่านมือถือและคอมพิวเตอร์ · เลือกเกม ตรวจสอบโปรโมชั่น และติดตามรายการผ่านบัญชีเดียว ·
// โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามรอบที่กำหนด · สมัครผ่านมือถือ 3 ขั้นตอน ·
// ติดต่อแอดมินได้ตลอด 24 ชั่วโมง · และการไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// มุมของรอบก่อนๆ ที่บรีฟนี้ไม่ได้เขียนไว้ (แนวทางหวย/สถิติย้อนหลัง, เลขเด็ด/เลขดัง,
// ฝากถอนวอลเลทและธนาคาร, บอลเดี่ยว/บอลสเต็ป) ถูกถอดออกทั้งหมด
//
// ห้ามพูดถึงสินค้าหมวดอื่นนอกจากสล็อต (หวย โพย บอล คาสิโนสด บาคาร่า ยิงปลา ฯลฯ) ห้ามอ้าง
// ชื่อค่ายเกมอื่นนอกจากสามเกมข้างต้น ชื่อธนาคาร เลขใบอนุญาต ชื่อผู้ให้บริการ ยอดฝากขั้นต่ำ
// จำนวนสมาชิก ปีที่ก่อตั้ง หรือตัวเลข RTP ของค่าย — บรีฟ NAZA99 ไม่ได้ให้ไว้เลยสักอย่าง
// ตัวเลขที่ใช้ได้มีห้าตัวเท่าที่บรีฟระบุ คือ 0.3% · 0.8% · 3 เกม · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงต้องคงคำเตือนคู่กับข้อดีไว้ทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้: แบรนด์เป็นทองล้วนไม่มีสีคู่ตรงข้าม (โลโก้เป็นตัวอักษรทองเมทัลลิกบนพื้นโปร่ง
// งานอาร์ตเป็นฉากทองบนพื้นดำอมน้ำตาล) ทองแบรนด์ #e4b34d จึงเป็นตัวระบุตัวตน (สันนำหน้า
// หัวข้อ ป้ายสมาชิก ดาว) ไล่จากแชมเปญ #fdf2ac → ทองแบรนด์ #e4b34d → ทองเข้ม #c08f2b
// ส่วนทองลึก #8a5f12 เป็นเส้นฐานของกรอบและดาวที่ยังไม่ติด ผิวการ์ด #140c02 ชิปตกลงไปที่
// พื้นดำสนิท #0a0501 เนื้อความและชื่อสมาชิก #f3e8cf (BRAND_TEXT) ตัวรองใช้ #f3e8cf
// แบบลดความทึบ ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง — ชุดแดงสด-ทองของ หวย365/หวยเฮง789 (#dc0203
// #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303 #f6e7e0 #d9b9b1 #dc2224
// #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "เลือกเกมจากสามเกมแนะนำผ่านบัญชีเดียว",
    stars: 5,
    tag: "Mahjong Ways 2 · Fortune Tiger · Sweet Bonanza",
    content:
      "ที่ใช้ต่อเพราะเกมสล็อตหลายสไตล์รวมอยู่ในระบบเดียว หมวดแนะนำมีสามเกมที่ฟีเจอร์ต่างกันชัดเจน Mahjong Ways 2 เป็นธีมไพ่นกกระจอกที่เด่นเรื่องตัวคูณกับฟรีสปิน Fortune Tiger เป็นธีมเสือนำโชคที่วงล้อเข้าใจง่าย ส่วน Sweet Bonanza เป็นธีมขนมและผลไม้ที่จ่ายแบบกลุ่มสัญลักษณ์ เลยเลือกได้ตามสไตล์ที่สนใจในวันนั้น เข้าใช้งานผ่านมือถือหรือคอมพิวเตอร์ก็เห็นรายการชุดเดียวกัน ก่อนเริ่มเล่นจะเปิดดูกติกา ช่วงเดิมพัน และรายละเอียดฟีเจอร์ของเกมนั้นก่อนทุกครั้ง",
    avatar: "🎰",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ตรวจสิทธิ์โบนัสคืนยอดเสียและแนะนำเพื่อนจากบัญชีสมาชิก",
    stars: 5,
    tag: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
    content:
      "ที่ชอบคือโปรโมชั่นแต่ละเดือนดูได้จากบัญชีสมาชิกโดยตรง ทั้งยอดที่เข้าเกณฑ์ รอบคำนวณ และจำนวนโบนัสที่รับได้ โบนัสคืนยอดเสีย 0.3% จะคำนวณจากยอดที่เข้าเงื่อนไขตามรอบที่กำหนด ส่วนแนะนำเพื่อน 0.8% คำนวณจากยอดใช้งานของเพื่อนที่สมัครผ่านลิงก์แนะนำ ติดตามจำนวนเพื่อนและยอดคำนวณได้จากหน้าเดียวกัน แต่ละรายการอาจกำหนดค่ายเกมและเงื่อนไขแตกต่างกัน เลยอ่านรายละเอียดกับรอบตัดยอดให้ครบก่อนกดรับทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · อัปเดตเกมใหม่ · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เข้าหน้าสมัครและกรอกข้อมูลที่ระบบกำหนด ยืนยันข้อมูลแล้ว Login เข้าบัญชีสมาชิก จากนั้นเลือกค่ายและเกมสล็อตที่ต้องการได้เลย หลังเปิดบัญชีก็ค้นหาเกมใหม่ ตรวจเครดิต โปรโมชั่น และประวัติรายการจากบัญชีเดียวได้ ส่วนคำว่าแตกหนักหรือปั่นแตกง่ายที่สุดไม่ได้ถือเป็นการรับประกันผลลัพธ์ เพราะเกมสล็อตให้ผลลัพธ์แบบสุ่ม ตอนที่เกมใหม่ยังไม่แสดงและเครดิตมีปัญหา ติดต่อแอดมินได้ตลอด 24 ชั่วโมง โดยแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุไป ส่วนปัญหาด้านธุรกรรมก็เตรียมเวลา จำนวนเงิน และหลักฐานไว้ให้ตรวจสอบ และไม่ส่งรหัสผ่าน PIN หรือ OTP ให้ใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] shadow-[0_0_12px_rgba(228,179,77,0.5)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f3e8cf] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#e4b34d]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f3e8cf]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเลือกเกมจากหมวดแนะนำทั้ง Mahjong Ways 2 Fortune Tiger และ Sweet Bonanza การตรวจสิทธิ์โบนัสคืนยอดเสีย 0.3% กับแนะนำเพื่อน 0.8% จากบัญชีสมาชิก
        และการสมัครผ่านมือถือ 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#8a5f12] border-l-[#e4b34d] bg-[#140c02]/94 px-6 py-4 shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#fdf2ac] to-[#c08f2b] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f3e8cf]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#8a5f12] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e4b34d]" : "text-[#8a5f12]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f3e8cf]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#e4b34d]/50 bg-[#0a0501] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e4b34d] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#8a5f12] bg-[#140c02]/94 p-5 shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-300 hover:border-[#e4b34d]/70 hover:shadow-[0_15px_40px_rgba(228,179,77,0.30)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#e4b34d]/22 blur-[60px] transition-all duration-300 group-hover:bg-[#fdf2ac]/30"
          />

          <div class="flex items-center gap-4 border-b border-[#8a5f12] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#e4b34d]/65 bg-gradient-to-br from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f3e8cf] transition-colors group-hover:text-[#fdf2ac]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f3e8cf]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#e4b34d]" : "text-[#8a5f12]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#e4b34d]/45 bg-[#0a0501] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e4b34d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fdf2ac]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f3e8cf]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
