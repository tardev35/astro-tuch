---
// Lottery brand — every row stays inside what the brief names: หวยรัฐบาลไทย /
// หวยลาว / หวยฮานอย / หวยหุ้น ตามรอบที่เปิดให้บริการ, การเลือกเลข กรอกจำนวนเงิน
// และตรวจโพยก่อนยืนยัน, วงเงิน เลขอั้น เวลาเปิด-ปิด และอัตราจ่ายที่ต่างกันในแต่ละ
// ประเภท, ระบบฝากถอนที่รองรับบัญชีธนาคารและวอลเลท, โปรโมชั่นรอบวันที่ 1 และ 16
// และแอดมินที่ออนไลน์ตลอด 24 ชั่วโมง. Nothing here promises a payout, a rate, or
// a product the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่ซื้อหวยหลายประเภทในบัญชีเดียว",
    role: "ตรวจรายละเอียดโพยทุกครั้งก่อนกดยืนยัน",
    stars: 5,
    tag: "รัฐบาลไทย ลาว ฮานอย หุ้น",
    content:
      "เข้ามาดูรอบที่เปิดให้บริการก่อน แล้วค่อยเลือกว่าจะซื้อหวยรัฐบาลไทย หวยลาว หวยฮานอย หรือหวยหุ้น ระบบแยกหมวดหมู่กับรอบเดิมพันไว้ให้ตรวจได้ง่าย เลือกเลข กรอกจำนวนเงิน แล้วอ่านรายละเอียดโพยอีกรอบก่อนยืนยันผ่านมือถือ",
    avatar: "🎱",
  },
  {
    name: "สมาชิกที่เช็กเงื่อนไขก่อนกดรับโบนัส",
    role: "ดูยอดที่ใช้คำนวณและช่วงเวลารับสิทธิ์ให้ครบ",
    stars: 5,
    tag: "โบนัสวันที่ 1 และ 16",
    content:
      "พอถึงรอบวันที่ 1 กับวันที่ 16 ก็ Login เข้าไปตรวจสิทธิ์และรายละเอียดโบนัสในบัญชีตัวเองก่อน อ่านเรื่องยอดที่ใช้คำนวณ ช่วงเวลารับสิทธิ์ และเงื่อนไขที่เกี่ยวข้องให้ครบ ถ้าไม่แน่ใจว่าบัญชีเข้าเงื่อนไขไหมก็ถามแอดมินให้ช่วยตรวจก่อนทำรายการ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนเครดิตยังไม่เข้า",
    role: "แจ้งจำนวนเงิน เวลา และรายละเอียดธุรกรรม",
    stars: 4,
    tag: "ฝากถอนทุกธนาคารและวอลเลท",
    content:
      "ฝากผ่านช่องทางที่เปิดให้บริการแล้วเครดิตยังไม่แสดง เลยเข้าไปเช็กสถานะรายการในบัญชีสมาชิกก่อน จากนั้นติดต่อแอดมินพร้อมแจ้งจำนวนเงิน เวลา และรายละเอียดธุรกรรม ทีมงานก็ช่วยตรวจสอบให้ได้ตลอด 24 ชั่วโมง แล้วยังย้ำให้เช็กชื่อบัญชีกับช่องทางถอนให้ถูกก่อนยืนยันทุกครั้ง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LEKDED" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff4cd] via-[#e2c466] to-[#b5811e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fff4cd]">LEKDED</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2c466] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e2c466]/45 bg-[#0b1405]/92 px-6 py-4 shadow-[0_10px_30px_rgba(226,196,102,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbe479] to-[#b5811e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a89a6b] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a5d2c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbe479]" : "text-[#123209]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ecdfb4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7a5d2c]/70 bg-[#0b1405]/92 p-6 text-left shadow-[0_10px_30px_rgba(3,8,3,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e2c466]/70 hover:shadow-[0_15px_40px_rgba(226,196,102,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbe479] to-[#0b530d] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#123209]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#b5811e]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7a5d2c]/80 bg-[#030803] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff4cd] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#1c9b22]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fbe479]" : "text-[#123209]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ecdfb4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a5d2c] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e2c466]/50 bg-gradient-to-br from-[#fbe479] via-[#e2c466] to-[#7a5d2c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e2c466] transition-colors group-hover:text-[#fff4cd]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a89a6b] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
