---
const reviews = [
  {
    name: "สมาชิกที่เข้าเล่นผ่านมือถือเป็นหลัก",
    role: "ใช้ระบบเดียวได้ทั้งมือถือและคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เข้าสู่ระบบผ่านสมาร์ตโฟนได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด สลับไปเล่นบนคอมพิวเตอร์ก็ใช้บัญชีเดียวกันได้ทันที เหมาะกับคนที่เล่นระหว่างเดินทางแล้วกลับมาเล่นต่อที่บ้าน",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ใช้ระบบฝากถอนอัตโนมัติ",
    role: "ทำรายการเองได้ตลอด 24 ชั่วโมง",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ฝากเครดิต ถอนเงิน และตรวจสอบสถานะรายการทำได้ด้วยตัวเองผ่านระบบ ไม่ต้องรอเจ้าหน้าที่ตอบทีละเคส รองรับทั้งบัญชีธนาคารและวอลเลท ช่วยลดเวลาที่ต้องรอระหว่างรอบเล่น",
    avatar: "🏧",
  },
  {
    name: "สมาชิกที่เคยติดต่อทีมงานตอนสมัคร",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ทีมงานดูแล 24 ชม.",
    content:
      "ตอนสมัครสมาชิกครั้งแรกมีจุดที่ไม่แน่ใจอยู่บ้าง ทีมงานตอบกลับไวและอธิบายขั้นตอนฝากเครดิตให้เข้าใจก่อนเริ่มเล่นจริง ช่วยให้มั่นใจว่าเลือกเกมและใช้งานระบบได้ถูกต้องตั้งแต่ครั้งแรก",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก RUAYHENG289" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a4e254] via-[#dfeacf] to-[#3fa316] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#a4e254]">RUAYHENG289</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3fa316] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#3fa316]/25 bg-[#0a1207]/92 px-6 py-4 shadow-[0_10px_30px_rgba(63,163,22,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#a4e254] to-[#2f6b0f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#55aa25]/90 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#122008]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#a4e254]" : "text-[#122008]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#55aa25]/90">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#3fa316]/25 bg-[#0a1207]/92 p-6 text-left shadow-[0_10px_30px_rgba(63,163,22,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#3fa316]/50 hover:shadow-[0_15px_40px_rgba(63,163,22,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#a4e254] to-[#2f6b0f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2f6b0f]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#3fa316]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#3fa316]/25 bg-[#07100a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#a4e254] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a4e254]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#a4e254]" : "text-[#122008]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dfeacf]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#122008] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3fa316]/30 bg-gradient-to-br from-[#a4e254] via-[#dfeacf] to-[#3fa316] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dfeacf] transition-colors group-hover:text-[#a4e254]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#55aa25]/90 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
