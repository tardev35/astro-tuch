---
const reviews = [
  {
    name: "สมาชิกที่ปั่นสล็อตผ่านมือถือเป็นหลัก",
    role: "ใช้บัญชีเดียวได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
    stars: 5,
    tag: "รองรับทุกอุปกรณ์",
    content:
      "เปิดเว็บผ่านเบราว์เซอร์บนมือถือแล้ว Login ได้เลย ไม่ต้องติดตั้งโปรแกรมเพิ่ม หน้าจอปรับให้พอดีทุกขนาด ระบบแยกหมวดทั้งเกมยอดนิยม เกมใหม่ สล็อตโบนัส และเกมแจ็คพอตไว้ให้ค้นหาง่าย เลือกค่ายและสลับเกมได้จากบัญชีเดียว",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ติดตามโปรโมชั่นเป็นประจำ",
    role: "ตรวจสอบเงื่อนไขก่อนกดรับโบนัสทุกครั้ง",
    stars: 5,
    tag: "โบนัสแนะนำเพื่อนและคืนยอดเสีย",
    content:
      "หน้าโปรโมชั่นแสดงรายละเอียดของโบนัส ยอดที่นำมาคำนวณ รอบการรับ และข้อกำหนดการถอนไว้ครบ ทำให้ดูได้ว่าโบนัสแนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3% เข้าเงื่อนไขส่วนไหนบ้าง จึงตรวจสอบให้ครบก่อนกดรับสิทธิ์ได้ทุกครั้ง",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เคยติดต่อแอดมินตอนถอนเงิน",
    role: "ได้รับคำแนะนำครบทุกขั้นตอน",
    stars: 4,
    tag: "ฝากถอนอัตโนมัติ",
    content:
      "ส่งคำขอถอนผ่านระบบอัตโนมัติแล้วรายการยังค้าง จึงแจ้งเวลาที่ทำรายการกับรายละเอียดไป แอดมินช่วยตรวจสอบสถานะให้และบอกขั้นตอนที่ต้องทำต่อจนจบ ทำให้กลับมาปั่นเกมรอบถัดไปได้โดยไม่ต้องเดาเอง",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DARK168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#8a6320] via-[#e6b74e] to-[#c8cfd8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f6dfa4]">DARK168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e6b74e] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e6b74e]/35 bg-[#131009]/92 px-6 py-4 shadow-[0_10px_30px_rgba(230,183,78,0.14)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#c8cfd8] to-[#8a6320] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a89b80] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#8a6320]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e6b74e]" : "text-[#5c4212]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece3d1]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#8a6320]/50 bg-[#131009]/92 p-6 text-left shadow-[0_10px_30px_rgba(230,183,78,0.14)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e6b74e]/60 hover:shadow-[0_15px_40px_rgba(230,183,78,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#8a6320] to-[#f6dfa4] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#5c4212]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#e6b74e]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#8a6320]/50 bg-[#050505] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f6dfa4] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e6b74e]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e6b74e]" : "text-[#5c4212]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece3d1]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#8a6320] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e6b74e]/40 bg-gradient-to-br from-[#f6dfa4] via-[#e6b74e] to-[#5c4212] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#c8cfd8] transition-colors group-hover:text-[#f6dfa4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a89b80] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
