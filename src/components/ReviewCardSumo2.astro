---
// JOKERSLOTZ เป็นเว็บโจ๊กเกอร์สล็อตที่เพิ่งอัปเดตทางเข้าสำรองใหม่ — ทุกแถวอยู่ในกรอบ
// ที่ brief ระบุไว้เอง: ทางเข้าสำรองล่าสุดแก้ปัญหาลิ้งก์เข้าใช้งานไม่ได้หรือเว็บโดนบล็อก,
// เกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming, ระบบเซิร์ฟเวอร์ใหม่ที่เข้ารหัสความปลอดภัย
// แน่นหนาขึ้น 100% เมื่อสมัครใช้ยูสใหม่, โปรโมชั่นแนะนำเพื่อนรับค่าคอมมิชชั่นสูงถึง 0.8%
// จากทุกยอดการเดิมพันของเพื่อน, โปรโมชั่นคืนยอดเสีย 0.3% ในทุกรอบบิล, สมัครอัตโนมัติ
// เสร็จภายใน 1 นาที รองรับทุกธนาคารและ TrueMoney Wallet, เล่นผ่านมือถือ iOS และ
// Android ผ่านเว็บบราว์เซอร์โดยไม่ต้องติดตั้งแอป และแอดมินผ่าน Line Official ตลอด
// 24 ชั่วโมง.
// ไม่มีข้อความไหนรับปากผลการเล่นหรืออัตราการชนะ.
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest. The logo's crimson
// carries the score/quote furniture and the jester hat's antique gold carries
// the identity rail, so both halves of the wordmark are doing work.
const reviews = [
  {
    name: "คุณกิตติศักดิ์ ธ.",
    role: "เข้าเล่นผ่านลิ้งก์ทางเข้าสำรองล่าสุด",
    stars: 5,
    tag: "ทางเข้าสำรอง ล่าสุด",
    content:
      "ก่อนหน้านี้เจอปัญหาลิ้งก์เข้าใช้งานไม่ได้อยู่บ่อยๆ พอเว็บอัปเดตทางเข้าสำรองล่าสุดก็เข้าถึงหน้าเกมได้ตามปกติ ไม่ต้องกลัวเว็บโดนบล็อกอีก เข้าไปเล่นเกมสล็อตลิขสิทธิ์แท้จากค่าย Joker Gaming ได้เร็วและเสถียร เล่นยาวๆ ก็ไม่สะดุด",
    avatar: "🔗",
  },
  {
    name: "คุณพิมพ์ชนก ร.",
    role: "สมัครยูสใหม่บนระบบเซิร์ฟเวอร์ใหม่",
    stars: 5,
    tag: "ใช้ยูสใหม่ ปลอดภัยขึ้น 100%",
    content:
      "ทำตามที่เว็บแนะนำคือสมัครสมาชิกเพื่อใช้ยูสใหม่บนทางเข้าล่าสุด ข้อมูลส่วนตัวและข้อมูลทางการเงินได้รับการเข้ารหัสความปลอดภัยที่แน่นหนาขึ้น 100% ตั้งแต่ย้ายมาก็ไม่เจอยูสเซอร์ค้างหรือเครดิตหายอีกเลย หมุนสปินและทำธุรกรรมบนระบบใหม่ลื่นไหลกว่าเดิมจริง",
    avatar: "🛡️",
  },
  {
    name: "คุณอนุชา พ.",
    role: "กดรับโปรโมชั่นและเล่นผ่านมือถือ",
    stars: 4,
    tag: "แนะนำเพื่อน 0.8% และคืนยอดเสีย 0.3%",
    content:
      "สมัครเองด้วยระบบอัตโนมัติสามขั้นตอน กรอกเบอร์รับ OTP ผูกบัญชีธนาคารโดยชื่อต้องตรงกัน แล้วตั้งรหัสผ่าน เสร็จภายในนาทีเดียว รองรับทุกธนาคารและ TrueMoney Wallet ส่วนโปรก็กดรับได้ทุกวัน ทั้งแนะนำเพื่อนที่ได้ค่าคอมมิชชั่นสูงถึง 0.8% จากยอดเดิมพันของเพื่อน และคืนยอดเสีย 0.3% ในทุกรอบบิล เล่นผ่านมือถือทั้ง iOS และ Android ได้จากเว็บบราว์เซอร์โดยไม่ต้องติดตั้งแอป ติดปัญหาก็ทักแอดมินผ่าน Line Official ได้ตลอด 24 ชั่วโมง และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น",
    avatar: "🎰",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JOKERSLOTZ" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#c81e1e] to-[#6d0d0d] shadow-[0_0_12px_rgba(165,21,21,0.55)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#ecdfd0] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#f2dc9a]">JOKER</span><span class="text-[#d9b45e]">SLOTZ</span>
      </p>
      <span class="text-xs tracking-wide text-[#ecdfd0]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการเข้าเล่นผ่านลิ้งก์ทางเข้าสำรองล่าสุด การสมัครยูสใหม่บนระบบเซิร์ฟเวอร์ที่ปลอดภัยขึ้น และการกดรับโปรโมชั่นพร้อมเล่นผ่านมือถือ
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#6d0d0d]/70 border-l-[#a51515] bg-[#2b0204]/92 px-6 py-4 shadow-[0_10px_30px_rgba(13,1,1,0.72)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#f2dc9a] to-[#bc9b5b] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#ecdfd0]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#6d0d0d] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#d9b45e]" : "text-[#6d0d0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ecdfd0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#6d0d0d] bg-[#1c0202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2dc9a] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#6d0d0d]/70 bg-[#2b0204]/92 p-5 shadow-[0_10px_30px_rgba(13,1,1,0.72)] backdrop-blur-xl transition-all duration-300 hover:border-[#a51515]/75 hover:shadow-[0_15px_40px_rgba(165,21,21,0.26)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#a51515]/16 blur-[60px] transition-all duration-300 group-hover:bg-[#c81e1e]/26"
          />

          <div class="flex items-center gap-4 border-b border-[#6d0d0d]/70 pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#bc9b5b]/60 bg-gradient-to-br from-[#f2dc9a] via-[#d9b45e] to-[#bc9b5b] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f2dc9a] transition-colors group-hover:text-[#d9b45e]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#ecdfd0]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#d9b45e]" : "text-[#6d0d0d]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#a51515]/65 bg-[#1c0202] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f2dc9a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c81e1e]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#ecdfd0]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
