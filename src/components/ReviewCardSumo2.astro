---
// Slot-only brand — every row stays inside what the brief names: รวมเกมสล็อต
// หลายรูปแบบไว้ในบัญชีเดียว, ค่าย PG SOFT / Pragmatic Play / JILI / JDB / Habanero,
// เกมที่ระบุชื่อไว้ (Mahjong Ways, Fortune Tiger, Lucky Neko), การอ่าน Paytable และ
// RTP ก่อนเดิมพัน, ระบบฝากถอนออโต้ที่ทำรายการได้ตลอดทั้งวัน, โปรแนะนำเพื่อน 0.8% และ
// คืนยอดเสีย 0.3% ตามเงื่อนไข และแอดมินที่ตรวจสอบรายการให้ไม่ข้ามวัน. Nothing here
// promises a payout, an RTP figure, or a provider the brief does not state.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// carousel is chrome, so it never emits a heading tag.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากค่ายที่เปิดให้บริการจริง",
    role: "อ่าน Paytable และรายละเอียดโบนัสก่อนเริ่มเดิมพัน",
    stars: 5,
    tag: "PG SOFT บนมือถือ",
    content:
      "เข้ามาดูรายชื่อค่ายที่เปิดให้บริการก่อน แล้วเลือกเล่นฝั่ง PG SOFT เพราะออกแบบมาให้เล่นผ่านมือถือได้สะดวก มีหลายธีมให้เลือก ทั้ง Mahjong Ways, Fortune Tiger และ Lucky Neko ก่อนกดเดิมพันก็อ่าน Paytable กับรายละเอียดโบนัสของเกมนั้นให้ครบก่อนทุกครั้ง",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ชอบเปลี่ยนแนวเกมไปมา",
    role: "ยึดรายชื่อค่ายและเกมที่แสดงอยู่ในระบบเป็นหลัก",
    stars: 5,
    tag: "Pragmatic Play, JILI, JDB, Habanero",
    content:
      "ชอบสลับแนวเกมไปเรื่อย ๆ เลยไล่ดูของ Pragmatic Play ที่มีทั้งสล็อตคลาสสิกและเกมที่มี Free Spins แล้วค่อยข้ามไป JILI, JDB และ Habanero ที่ธีมกับระบบโบนัสต่างกัน ส่วนรายชื่อเกมที่พร้อมใช้งานจริงก็ยึดข้อมูลล่าสุดที่แสดงอยู่ในระบบเป็นหลัก",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่แจ้งแอดมินตอนเครดิตยังไม่เข้า",
    role: "แจ้งเวลา จำนวนเงิน และรายละเอียดรายการให้ตรวจสอบ",
    stars: 4,
    tag: "ฝากถอนออโต้ตลอดทั้งวัน",
    content:
      "ฝากผ่านระบบออโต้แล้วเครดิตยังไม่แสดง เลยเข้าไปเช็กสถานะธุรกรรมในบัญชีก่อน จากนั้นติดต่อแอดมินพร้อมแจ้งเวลา จำนวนเงิน และรายละเอียดรายการ ทีมงานก็ค้นหารายการได้ตรงจุด แล้วยังอธิบายเรื่องโบนัสแนะนำเพื่อน 0.8% กับคืนยอดเสีย 0.3% ว่าให้ดูรอบคำนวณและเงื่อนไขการถอนก่อนกดรับ",
    avatar: "🎧",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JUDTEM168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fff6d4]">JUDTEM168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fae27c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#cc9c2d]/45 bg-[#120c04]/92 px-6 py-4 shadow-[0_10px_30px_rgba(204,156,45,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fae27c] to-[#cc9c2d] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b9a67d] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#6a5115]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fae27c]" : "text-[#1d1407]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f0e2bd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#6a5115]/70 bg-[#120c04]/92 p-6 text-left shadow-[0_10px_30px_rgba(5,3,1,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8bf4e]/70 hover:shadow-[0_15px_40px_rgba(204,156,45,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fae27c] to-[#cc9c2d] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1d1407]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#cc9c2d]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#6a5115]/80 bg-[#050301] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff6d4] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8bf4e]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fae27c]" : "text-[#1d1407]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f0e2bd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6a5115] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#cc9c2d]/50 bg-gradient-to-br from-[#fae27c] via-[#e8bf4e] to-[#6a5115] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fae27c] transition-colors group-hover:text-[#fff6d4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b9a67d] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
