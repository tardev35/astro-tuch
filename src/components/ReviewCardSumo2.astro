---
import { BRAND_NAME } from "../lib/brandProfile";

// หวย24 (2026-10-04): บรีฟรอบนี้เป็น **เว็บแทงหวยออนไลน์ล้วน** ทุกแถวจึงถูกเขียน
// ใหม่ทั้งหมดจากคำของบรีฟเอง ไม่ได้ find-and-replace ชื่อแบรนด์ทับประโยคของรอบ
// หวยคิง ก่อนหน้า ซึ่งขายคนละมุมกันทั้งชุด (บาทละ 1,000 เป็นคำโฆษณาหลัก · เว็บแม่ ·
// จ่ายไม่อั้น · ยอดเข้าบริษัทโดยตรง · ชื่อนิติบุคคล/บัญชีบริษัท · เครดิต/วอลเลท/
// ธนาคาร) — บรีฟรอบนี้ไม่ได้พูดสักคำ
//
// กรอบที่บรีฟระบุไว้เองคือ: รวมหวยลาว หวยฮานอย และรัฐบาลไทยไว้ในบัญชีเดียว พร้อม
// รอบเปิดรับ อัตราจ่าย และผลรางวัล · เลือกเลขเด็ด เลขดัง หรือเลขของตัวเองแล้ว
// ตรวจสอบก่อนส่งโพย · รายการที่เข้าเงื่อนไขมีเรท 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย
// 1,000 บาท · สมัครผ่านมือถือ 3 ขั้นตอน · ติดตามแนวทางหวย ผลรางวัล และประวัติโพย ·
// แอดมิน 24 ชั่วโมง · ไม่เปิดเผยรหัสผ่าน PIN หรือ OTP
//
// คำของแบรนด์คาสิโนรอบก่อนๆ ถูกถอดออกทั้งชุด (สล็อต บาคาร่า บอล/เดิมพันฟุตบอล
// หมวดเกม ค่ายเกม คาสิโนสด RTP ความผันผวน คืนยอดเสีย แนะนำเพื่อน เว็บตรง) —
// ไม่เหลือแม้คำเดียว
//
// ห้ามใส่ชื่อตลาดหวยอื่นนอกจาก ลาว/ฮานอย/รัฐบาลไทย (ห้ามเติม ลาวพัฒนา หวยหุ้น
// ยี่กี) เวลาเปิด-ปิดของแต่ละรอบ ชื่อธนาคาร เลขใบอนุญาต ยอดฝากขั้นต่ำ จำนวนสมาชิก
// หรือปีก่อตั้ง — บรีฟรอบนี้ไม่ได้ให้ไว้เลยสักอย่าง ตัวเลขที่ใช้ได้คือ 2 ตัว · 3 ตัว ·
// 100 · 1,000 · 3 ขั้นตอน · 24 ชั่วโมง และบรีฟเป็นโทน hedged ทุกย่อหน้า จึงคง
// ประโยคกำกับของบรีฟเองไว้คู่กับข้อดีในทุกแถว
// Written testimonial text only — no Review/AggregateRating JSON-LD.
//
// The block title is a <p> and the <section> carries an aria-label — a review
// ledger is chrome, so it never emits a heading tag at any level.
//
// Layout: a full-width LEDGER — a left-anchored header rail, one horizontal
// score bar, and one full-width row per review with the member's identity
// pinned in a left rail and the quote filling the rest.
//
// สีชุดรอบนี้ (brand-spec §2 แดงแบรนด์ + ทอง บนดำอมแดง): รอบนี้สีหลักคือ **แดง**
// ไม่ใช่ทองแบบ หวยคิง จึงกลับบทบาทกัน — แดงแบรนด์ #d20a0a เป็นตัวระบุตัวตนของบล็อก
// นี้ สันนำหน้าหัวข้อและป้ายอวาตาร์ไล่แดงสว่าง #ff5c5c → แดงแบรนด์ → แดงลึก #7a0505
// บนหมึกครีม #fff1e8 (พื้นแดงเข้มต้องใช้หมึกสว่างเสมอ ตามกฎคอนทราสต์ §2) ส่วนทอง
// เป็นสีรองและถูกใช้เป็น "สีที่อ่านเป็นตัวอักษร" คือชื่อแบรนด์ ดาวที่ติด คะแนนเฉลี่ย
// และขอบป้ายแท็ก เพราะทองสว่าง #ffd45e บนผิวการ์ด #170707 ได้คอนทราสต์สูงกว่าแดง
// มาก ออรามุมขวาบนเป็นทองแบรนด์ #f5c33b ตัดกับตัวตนสีแดงของการ์ด ดาวที่ยังไม่ติด
// ใช้แดงลึก #7a0505 กรอบการ์ดเป็นเส้นไรผม #3d0a0a ชิปตกลงไปที่พื้นลึกสุด #0a0303
// เนื้อความและชื่อสมาชิก #f7e2d6 (= BRAND_TEXT) ตัวรองใช้ #f7e2d6 แบบลดความทึบ
// ไม่ใช่เฉดใหม่ที่คิดขึ้นเอง glow เป็น rgba(210,10,10,…) / rgba(245,195,59,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…)
// rgba(252,212,195,…)) ออกครบทุกจุดแล้ว
const reviews = [
  {
    name: "คุณธนกฤต ว.",
    role: "ติดตามหวยลาว ฮานอย และรัฐบาลไทยจากบัญชีเดียว",
    stars: 5,
    tag: "หวยลาว · หวยฮานอย · รัฐบาลไทย · รอบเปิดรับ",
    content:
      "ที่ใช้ต่อเพราะรวมหวยยอดนิยมหลายรายการไว้ในบัญชีเดียว ทั้งหวยลาวตามรอบที่เปิดรับ หวยฮานอยหลายช่วงเวลา และรัฐบาลไทยตามกำหนดออกรางวัล เปิดมาก็เห็นรอบเปิดรับ อัตราจ่าย และผลรางวัลอยู่ในหน้าเดียว เลือกเลขที่สนใจแล้วตรวจสอบรายละเอียดก่อนส่งโพยได้เลย ข้อที่อยากให้เข้าใจตรงกันคือระบบเว็บไซต์เข้าใช้งานได้ 24 ชั่วโมงก็จริง แต่เวลารับแทงจริงยังขึ้นอยู่กับกำหนดเปิดและปิดของหวยแต่ละรอบ ควรดูเวลาที่ระบบแสดงก่อนส่งโพยทุกครั้ง",
    avatar: "🗓️",
  },
  {
    name: "คุณศิริพร ก.",
    role: "ดูอัตราจ่ายและวงเงินรับแทงก่อนยืนยันโพย",
    stars: 5,
    tag: "อัตราจ่าย · 2 ตัว จ่าย 100 · 3 ตัว จ่าย 1,000 · วงเงินรับแทง",
    content:
      "ชอบที่ตรวจสอบอัตราการจ่ายได้ก่อนส่งโพย รายการที่เข้าเงื่อนไขขึ้นชัดว่าเป็นเรท 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ทำให้ทราบอัตราที่ใช้คำนวณก่อนยืนยันการเดิมพัน เลือกได้ทั้งเลขที่คิดเองและเลขเด็ด เลขดังที่กำลังได้รับความสนใจ แต่อัตราจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เลือก จึงควรยึดข้อมูลล่าสุดบนหน้าส่งโพยเป็นหลัก ส่วนคำว่ารับไม่อั้นและจ่ายเต็มทุกโพย ก็ควรยึดตามวงเงินและเงื่อนไขจริงที่ระบบแสดง เพราะเลขที่มียอดเดิมพันสูงอาจมีวงเงินรับแตกต่างจากเลขทั่วไป และถ้าจะใช้ข้อความว่าเรทจ่ายสูงที่สุด ส่วนตัวมองว่าควรมีข้อมูลเปรียบเทียบกับผู้ให้บริการรายอื่นที่ตรวจสอบได้ ถ้าไม่มี การใช้คำว่าเรทจ่ายสูงจะเหมาะสมกว่า",
    avatar: "🧾",
  },
  {
    name: "คุณวรเทพ ส.",
    role: "สมัครผ่านมือถือ 3 ขั้นตอน แล้วสอบถามแอดมิน",
    stars: 4,
    tag: "สมัคร 3 ขั้นตอน · แนวทางหวย · ประวัติโพย · แอดมิน 24 ชั่วโมง",
    content:
      "สมัครเองผ่านมือถือได้ใน 3 ขั้นตอน เริ่มจากเข้าหน้าสมัครและกรอกข้อมูลตามที่ระบบกำหนด จากนั้นยืนยันข้อมูลเพื่อสร้างบัญชีและ Login เข้าสู่ระบบ ก่อนเลือกหวย รอบ และเลขที่ต้องการ พร้อมตรวจสอบอัตราจ่ายและยอดเดิมพันก่อนส่งโพย พอเปิดบัญชีแล้วก็ใช้บัญชีเดียวติดตามหวยลาว หวยฮานอย รัฐบาลไทย แนวทางหวย ผลรางวัล และประวัติโพยได้ ตรงนี้ต้องบอกว่าแนวทางหวยหรือเลขดังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลรางวัลของรอบถัดไปได้ ตอนส่งโพยไม่สำเร็จหรือตรวจผลไม่ได้ ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง เรื่องโพยก็เตรียมชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการไว้ ส่วนเรื่องธุรกรรมก็เก็บหลักฐาน เวลา และจำนวนเงินไว้สำหรับตรวจสอบ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={`เสียงจากสมาชิก ${BRAND_NAME}`} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex items-center gap-4">
    <span aria-hidden="true" class="h-12 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5c5c] via-[#d20a0a] to-[#7a0505] shadow-[0_0_12px_rgba(210,10,10,0.6)]"></span>
    <div class="flex flex-col gap-1">
      <p class="text-2xl font-black tracking-widest text-[#f7e2d6] uppercase sm:text-3xl">
        เสียงจากสมาชิก <span class="text-[#ffd45e]">{BRAND_NAME}</span>
      </p>
      <span class="text-xs tracking-wide text-[#f7e2d6]/70">
        บันทึกการใช้งานจริงจากสมาชิก {reviews.length} ราย ครอบคลุมการติดตามหวยลาว หวยฮานอย และรัฐบาลไทยจากบัญชีเดียว การตรวจอัตราจ่ายกับวงเงินรับแทงก่อนส่งโพย และการสมัคร 3 ขั้นตอนพร้อมติดต่อแอดมิน 24 ชั่วโมง
      </span>
    </div>
  </div>

  <div
    class="mb-6 flex flex-col items-start gap-4 rounded-2xl border border-l-4 border-[#3d0a0a] border-l-[#d20a0a] bg-[#170707]/94 px-6 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl sm:flex-row sm:items-center sm:gap-8">
    <div class="flex items-baseline gap-2">
      <span class="bg-gradient-to-b from-[#ffd45e] to-[#f5c33b] bg-clip-text text-5xl leading-none font-black text-transparent">{average}</span>
      <span class="text-sm font-black text-[#f7e2d6]/70">/ 5.0</span>
    </div>
    <span aria-hidden="true" class="hidden h-10 w-px bg-[#3d0a0a] sm:block"></span>
    <div class="flex flex-col gap-1">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd45e]" : "text-[#7a0505]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f7e2d6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
    <span class="rounded-full border border-[#f5c33b]/45 bg-[#0a0303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd45e] uppercase sm:ml-auto">ข้อความจากสมาชิก</span>
  </div>

  <div class="flex flex-col gap-5">
    {
      reviews.map((review) => (
        <article class="group relative isolate grid grid-cols-1 gap-5 overflow-hidden rounded-2xl border border-[#3d0a0a] bg-[#170707]/94 p-5 shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-300 hover:border-[#d20a0a]/75 hover:shadow-[0_15px_40px_rgba(210,10,10,0.3)] md:grid-cols-[16rem_1fr] md:p-6">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#f5c33b]/18 blur-[60px] transition-all duration-300 group-hover:bg-[#ffd45e]/28"
          />

          <div class="flex items-center gap-4 border-b border-[#3d0a0a] pb-4 md:flex-col md:items-start md:gap-3 md:border-r md:border-b-0 md:pr-6 md:pb-0">
            <span
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#ff5c5c]/65 bg-gradient-to-br from-[#ff5c5c] via-[#d20a0a] to-[#7a0505] text-2xl text-[#fff1e8] shadow-inner transition-transform duration-300 group-hover:scale-105">
              {review.avatar}
            </span>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="text-base font-black text-[#f7e2d6] transition-colors group-hover:text-[#ffd45e]">{review.name}</span>
              <span class="text-[11px] leading-snug font-bold text-[#f7e2d6]/70">{review.role}</span>
              <span class="mt-1 flex gap-0.5 text-sm">
                <span aria-hidden="true" class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ffd45e]" : "text-[#7a0505]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#f5c33b]/45 bg-[#0a0303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd45e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d20a0a]" />
              {review.tag}
            </span>
            <p class="text-left text-base leading-relaxed text-[#f7e2d6]">{review.content}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
