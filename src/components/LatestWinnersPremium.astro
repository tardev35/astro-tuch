---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// สีใน bg-[#...] ชุดนี้คือสีประจำแบรนด์ของธนาคารเอง ไม่ใช่ส่วนหนึ่งของพาเลตต์แบรนด์
// brand-spec §2 ระบุว่าสีเชิงความหมายห้ามแตะ จึงไม่ถูกสวีปทุกรอบรีแบรนด์
// ชื่อธนาคารเดินทางเป็น JSON เฉยๆ เพื่อใช้เลือกสีป้ายกับโลโก้ — ไม่มีชื่อธนาคารโผล่ใน
// ข้อความที่มองเห็นสักจุด เพราะบรีฟรอบนี้ไม่ได้ระบุชื่อธนาคารไว้เลย
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// ไฟล์นี้ต้องไม่กลับไปใช้ `<script define:vars={{ bankPool }}>` เด็ดขาด:
// define:vars บังคับ is:inline ซึ่งตัด type/async/defer ออก เหลือ script ที่บล็อก
// parser กลางเอกสาร — tools/verify-build.mjs ทำให้ build แดงทันทีบนหน้าที่ index ได้
// แถวทั้งห้าแถวจึง server-render จากตรงนี้ รายชื่อธนาคารเดินทางเป็น JSON ที่ parser
// ข้ามไป และ src/lib/winnersFeed.ts (ใช้ร่วมกับทุก LatestWinners* และขับด้วย selector
// จึงไม่ต้องแก้) เข้ามารับช่วงแค่การหมุนแถว พร้อมการ์ด on-screen / hidden-tab /
// prefers-reduced-motion ทุก data-* ด้านล่างคือส่วนหนึ่งของสัญญานั้น
//
// ค่าทั้งหมดมาจากแฮชโดเมนของแบรนด์ **ไม่ใช่ Math.random()**: frontmatter รันตอน build
// ถ้าสุ่มที่นี่ ทุก deploy จะเขียน markup ของเว็บจริงใหม่โดยไม่มีเหตุผล
// brandPick()/brandFlag() ทำให้สองบิลด์ของโดเมนเดียวกันออกมาไบต์ต่อไบต์เท่ากัน
//
// สองสถานะของแถวถูกตั้งค่าจาก markup ทั้งคู่ เพื่อให้โมดูลที่แชร์กันไม่ต้องรู้พาเลตต์
// หรือคำพูดของแบรนด์นี้เลย:
//   • data-winner-status — รอตรวจสอบ vs ตรวจสอบแล้ว โมดูลเลือกต่อแถวจาก
//     data-pending-chance ส่วนคำอยู่ใน data-pending-text/data-done-text และคลาสอยู่ใน
//     คู่ -class ที่ตรงกัน
//   • data-winner-big — เหนือ BIG_WIN แถวจะยกขึ้น ⚠️ รอบก่อนๆ "ก้อนใหญ่" อ่านเป็น
//     **การเดินข้ามฮิว** (ทองไปมะนาว ทองไปชมพู) ซึ่งรอบนี้ทำไม่ได้ เพราะ §2 ห้ามทอง
//     ม่วง ชมพู น้ำเงิน ฟ้า เขียว ส้ม ทั้งหมด TKB55 มีสองฮิวจริงอยู่แล้ว (แดงนำ
//     เงินโครเมียมรอง) จึงเดินในสองสีนั้น: แถวปกติอยู่บน **เงินโครเมียม** เงียบๆ
//     (หม่น #aeb9c6 → สว่าง #e9eef4) ส่วนแถวยอดก้อนใหญ่สว่างขึ้นเป็น **แดงแบรนด์**
//     (#e9eef4 → #ff4d55 พร้อมออราแดง) ซึ่งเป็นความต่างสองขั้นที่เห็นจริง ไม่ใช่การ
//     ขยับความสว่าง และไม่ต้องยืมฮิวที่สามเข้ามา
//
// ตัวเลข HUD ก็ server-render และโมดูลนับต่อจากค่านั้นผ่าน data-seed — ไม่งั้นเลขจะ
// รีเซ็ตเป็นศูนย์ให้เห็นตอน JS เริ่มทำงาน แล้วค่อยไต่ขึ้นใหม่
//
// ป้ายกำกับทุกตัวเป็น <p>/<span> ฟีดรายการเป็น chrome ไม่ใช่เนื้อหาบทความ จึง
// **ไม่ปล่อย heading tag ระดับไหนเลย** และ <section> รับชื่อที่เข้าถึงได้จาก aria-label
// ไม่มีไทล์ไหนอ้างยอดฝากถอนขั้นต่ำ ค่า RTP เลขใบอนุญาต หรือชื่อธนาคาร เพราะบรีฟ
// (src/assets/content.txt) ไม่ได้ระบุสิ่งเหล่านั้นเป็นข้อเท็จจริงของฟีดนี้
// บรรทัดรองพูดตรงๆ ว่าแถวข้างล่างคือตัวอย่าง "รูปแบบการแสดงรายการ" ไม่ใช่ยอดจริง
// จึงไม่มีการอ้างตัวเลขของสมาชิกจริงที่ไหน
//
// ไทล์ที่สามถือโปรโมชั่นสองรายการที่บรีฟระบุเอง ด้วยตัวเลขของบรีฟเอง:
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% — **ไม่ใช่ไทล์หวย** และต้องไม่กลับไปเป็นอีก
// brand-spec §7 ห้ามคำเกี่ยวกับหวยทุกคำบนแบรนด์นี้ (TKB55 เป็นเว็บคาสิโน+กีฬา:
// บาคาร่า ไฮโล บอล สล็อต — ส่วน /ตรวจหวย กับ /แนวทาง จอดอยู่ใน src/pages-disabled/)
// คำที่ใช้มาจากคลังคำของบรีฟล้วน: ฝากถอน · ตรวจสอบ · บัญชีเดียว · ยอดที่เข้าเกณฑ์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน · โบนัส 0.8% ชื่อแบรนด์ interpolate จาก BRAND_NAME
// ไม่พิมพ์ตรงๆ และไม่มีโดเมนอยู่ในไฟล์นี้
//
// TKB55 (รอบแดงเลือดนก-เงินโครเมียมบนดำสนิท 2026-10-13, brand-spec §2):
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน TSDET911 ใช้ LatestWinners3 จึงหมุนมาที่ไฟล์นี้
// โลโก้อ่านตรงๆ ว่า: คำว่า TKB เป็นตัวอักษรสามมิติ **แดงสด** ต่อด้วยเลข 55
// **เงินโครเมียมขัดเงา** และเหนือคำเป็นมาสคอตโจรการ์ตูนใส่หน้ากากดำแบกถุงเงิน $
// ไอคอนหัวแผงจึงเป็นถุงเงิน ไม่ใช่มงกุฎของ TIGERWIN369 รอบก่อน (ดรอปนี้ไม่มีมงกุฎ
// ไม่มีหัวเสือ ไม่มีวงแหวนทอง ไม่มีปีกเหยี่ยวน้ำเงิน และไม่มีโปสเตอร์หวย)
// ⚠️ พื้นเพจรอบนี้ดำสนิท #000000 (bg.json) ทุกผิวในไฟล์นี้จึงสว่างกว่าพื้น ไม่มีชั้น
// ไหนจมต่ำกว่าพื้นได้ ลำดับความลึก: #2a0d0f ยก / #1a0708 กลาง / #0d0304 จม
// แผงนั่งบนผิวจม #0d0304 ในกรอบแดงแบรนด์ #fb131b โปร่ง แถวอยู่บนผิวกลาง #1a0708
// และกดลงเป็นผิวจมตอนชี้ เส้นคั่นกับขอบแถวปกติเป็นแดงเลือดหมูเข้มสุด #53050a
// หัวแผงเป็นเงินโครเมียมสว่าง #e9eef4 ส่วนชื่อแบรนด์เป็นแดงสว่าง #ff4d55 — สองสีนี้
// คือสองสีของโลโก้ตรงตัว ชื่อยูสเซอร์เป็นสีเนื้อความ #f2e4e5 (= BRAND_TEXT)
// ข้อความรองทั้งหมดเป็นเงินโครเมียมหม่น #aeb9c6 (8.9:1)
// §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสี่ค่า
// (ที่ใช้สองค่า) อยู่ที่กรอบ เส้นคั่น จุด และออราเท่านั้น ไม่มีตัวอักษรไหนนั่งบนมัน
// และ #ff8a8f ถูกสงวนให้ <strong> ในย่อหน้าของหน้าแรก จึงไม่โผล่ในไฟล์นี้เลย
// ไล่เฉดที่ถูก bg-clip-text ทุกตัวใช้แต่ค่าที่ถือตัวอักษรได้ (#aeb9c6 #e9eef4 #ff4d55)
// เพราะพิกเซลของไล่เฉดนั้น **คือตัวอักษร** ไม่ใช่พื้นหลัง
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของรอบนี้คือแดง** โค้ดเบสนี้มีแบรนด์
// แดงมาแล้วหลายเจ้า การเจอแดงในไฟล์จึงไม่พิสูจน์อะไร ไฟล์นี้เพิ่งถือชุดทองอำพันเสือ
// ของ TIGERWIN369 มาทั้งไฟล์ (d98324 / f7b733 / ffd98a / f7e4c0 / e3cfae / 8a5214 /
// 4a2a08 / 2d1c0a / 1c1206 / 0f0903) และก่อนนั้นเป็นชุดเขียวป่า-ทองมงกุฎของ
// KINGKONG555 (8ce023 / f2c230 / ffe066 / 1a5c04) ชุดทองแชมเปี้ยน-เงินของ UFA324
// (e5a81b / b9c2cc / 231c0e / f0e8d4) ชุดม่วงนีออน-ทองของ WEPLAY168 (a435f0 / fbe455 /
// 1e0a3c) และชุดแดงแบรนด์-ทองของ หวย24 (d20a0a / ff5c5c / 7a0505 / f5c33b) — ออกครบ
// ทุกค่าแล้ว พร้อมคำหมวดหวยทั้งหมด
// ⚠️ แดงรอบนี้คือ #fb131b (R=251 G=19 B=27) **คนละค่า** กับแดงของ SUPERSLOTCLUB
// (e8232a) PIGPG (d4200d) FLASH877 (ff3b14) และ หวย24 (d20a0a) ที่ยังค้างในไฟล์อื่น
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
//
// ⚠️ สีเชิงความหมายคงไว้ตาม §2: จุด live กับสถานะ "ตรวจสอบแล้ว" ยังเป็นเขียว success
// ของทุกแบรนด์ (emerald) ห้ามเปลี่ยนให้เป็นสีแบรนด์ เพราะนั่นคือการลบความหมาย
// "สำเร็จ / อยู่ระหว่างตรวจสอบ" ออกจากแถว ส่วนสถานะรอใช้เงินโครเมียมหม่น #aeb9c6
// (เงียบ ไม่ใช่สีนำ) — สถานะที่รออยู่ที่ทาด้วยแดงนำของแบรนด์จะเลิกอ่านเป็นการรอ
// สีประจำธนาคารใน bankPool ด้านบนอยู่ใต้กฎเดียวกันและไม่ถูกแตะ
const BIG_WIN = 40000;
const AMOUNT_MIN = 100;
const AMOUNT_MAX = 49000;

const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`winner-bank-${i}`, bankPool.length)],
    user: `0${pick(`winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`winner-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
    pending: brandFlag(Astro.site, `winner-pending-${i}`),
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

const ROW_NORMAL = "border-[#53050a]";
const ROW_BIG = "border-[#fb131b]/75 shadow-[0_0_15px_rgba(251,19,27,0.35)]";
const AMOUNT_NORMAL = "from-[#aeb9c6] to-[#e9eef4]";
const AMOUNT_BIG = "from-[#e9eef4] to-[#ff4d55] drop-shadow-[0_0_10px_rgba(251,19,27,0.5)]";
const STATUS_DONE = "text-emerald-400 font-bold";
const STATUS_PENDING = "text-[#aeb9c6] font-bold";
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ตรวจสอบแล้ว";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการฝากถอนในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-3xl border border-[#fb131b]/50 bg-[#0d0304]/92 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#53050a] px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#fb131b]/50 bg-[#1a0708] text-2xl">💰</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#e9eef4] drop-shadow-sm">
            รายการฝากถอนในระบบสมาชิก <span class="text-[#ff4d55]">{BRAND_NAME}</span>
          </p>
          <span class="mt-1 text-[11px] font-medium tracking-wide text-[#aeb9c6]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการในระบบสมาชิกเท่านั้น ไม่ใช่ยอดจริงของสมาชิก</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-emerald-500/40 bg-emerald-900/20 px-3 py-1.5 sm:self-auto">
        <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-emerald-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#53050a] bg-[#1a0708]/60 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#0d0304] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#aeb9c6]">ยอดรวมในรายการตัวอย่าง</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#e9eef4] to-[#ff4d55] bg-clip-text text-lg font-black text-transparent tabular-nums sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#0d0304] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#aeb9c6]">จำนวนรายการตัวอย่าง</span>
        <span data-winners-count data-seed={initialRows.length} class="text-lg font-black text-[#f2e4e5] tabular-nums sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#0d0304] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#aeb9c6]">โปรโมชั่นที่ตรวจสอบได้จากบัญชีเดียว</span>
        <span class="text-base font-black text-[#ff4d55] sm:text-lg">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#aeb9c6] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.25"
      data-user-style="phone"
      data-user-digits="4"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#1a0708]/90 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#fb131b]/70 hover:bg-[#0d0304]/80 sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain" />
                </div>
                <span data-winner-user class="text-sm font-bold text-[#f2e4e5] tabular-nums">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#fb131b]" />
                <span
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={STATUS_PENDING}
                  data-done-class={STATUS_DONE}
                  class={row.pending ? STATUS_PENDING : STATUS_DONE}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </span>
              </div>
              <div
                data-winner-big
                data-normal-class={AMOUNT_NORMAL}
                data-big-class={AMOUNT_BIG}
                class={`bg-gradient-to-r bg-clip-text text-right text-base font-black text-transparent tabular-nums sm:text-lg ${row.big ? AMOUNT_BIG : AMOUNT_NORMAL}`}>
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#aeb9c6] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

