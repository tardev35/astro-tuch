---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// สีใน bg-[#...] ชุดนี้คือสีประจำแบรนด์ของธนาคารเอง ไม่ใช่ส่วนหนึ่งของพาเลตต์แบรนด์
// brand-spec §2 ระบุว่าสีเชิงความหมายห้ามแตะ จึงไม่ถูกสวีปทุกรอบรีแบรนด์
// ⚠️ #1155cc #4e1c80 #fcd34d #0ea5e9 สี่ค่านี้ **ห้ามสวีป** แม้ว่ารอบนี้จะห้าม
// น้ำเงิน ม่วง และทองนอกพาเลตต์ — มันคือสีของธนาคาร ไม่ใช่สีของแบรนด์นี้ และ
// #fcd34d ก็ไม่ใช่ "ทองของแบรนด์เก่าที่ค้าง" แต่เป็นเหลืองประจำธนาคารของมันเอง
// ชื่อธนาคารเดินทางเป็น JSON เฉยๆ เพื่อใช้เลือกสีป้ายกับโลโก้ — ไม่มีชื่อธนาคารโผล่ใน
// ข้อความที่มองเห็นสักจุด เพราะบรีฟรอบนี้ไม่ได้ระบุชื่อธนาคารไว้เลย (§6 แบนชื่อธนาคาร)
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// ไฟล์นี้ต้องไม่กลับไปใช้ `<script define:vars={{ bankPool }}>` เด็ดขาด:
// define:vars บังคับ is:inline ซึ่งตัด type/async/defer ออก เหลือ script ที่บล็อก
// parser กลางเอกสาร — tools/verify-build.mjs ทำให้ build แดงทันทีบนหน้าที่ index ได้
// แถวทั้งห้าแถวจึง server-render จากตรงนี้ รายชื่อธนาคารเดินทางเป็น JSON ที่ parser
// ข้ามไป และ src/lib/winnersFeed.ts (ใช้ร่วมกับทุก LatestWinners* และขับด้วย selector
// จึงไม่ต้องแก้) เข้ามารับช่วงแค่การหมุนแถว พร้อมการ์ด on-screen / hidden-tab /
// prefers-reduced-motion ทุก data-* ด้านล่างคือส่วนหนึ่งของสัญญานั้น
//
// ค่าทั้งหมดมาจากแฮชโดเมนของแบรนด์ **ไม่ใช่ Math.random()**: frontmatter รันตอน build
// ถ้าสุ่มที่นี่ ทุก deploy จะเขียน markup ของเว็บจริงใหม่โดยไม่มีเหตุผล
// brandPick()/brandFlag() ทำให้สองบิลด์ของโดเมนเดียวกันออกมาไบต์ต่อไบต์เท่ากัน
//
// สองสถานะของแถวถูกตั้งค่าจาก markup ทั้งคู่ เพื่อให้โมดูลที่แชร์กันไม่ต้องรู้พาเลตต์
// หรือคำพูดของแบรนด์นี้เลย:
//   • data-winner-status — รอตรวจสอบ vs ตรวจสอบแล้ว โมดูลเลือกต่อแถวจาก
//     data-pending-chance ส่วนคำอยู่ใน data-pending-text/data-done-text และคลาสอยู่ใน
//     คู่ -class ที่ตรงกัน
//   • data-winner-big — เหนือ BIG_WIN แถวจะยกขึ้น ⚠️ "ก้อนใหญ่" ต้องอ่านเป็น
//     **การเดินข้ามเฉด** ไม่ใช่การขยับความสว่างของสีเดียว รอบนี้พาเลตต์เป็นวงศ์ทอง
//     เดียวกันทั้งชุด (§2 ไม่มีสีที่สองที่เป็นคนละวงศ์) แต่มีสองเฉดทองที่ห่างกันจริง
//     ให้เดิน: แถวปกติอยู่บน **ครีมทอง → ทองนำ** (#f6e3b4 → #d4922c) ส่วนแถวยอด
//     ก้อนใหญ่ไต่ขึ้นเป็น **ทองนำ → ทองสว่าง** (#d4922c → #fdfc71 พร้อมออราเลมอน)
//     ซึ่งเป็นความต่างสองขั้นที่เห็นจริง และไม่ต้องยืมบรอนซ์ที่ถือตัวอักษรไม่ได้เข้ามา
//     นี่คือจุดที่ทองสว่าง "เห็นได้จริง" ที่สุดในไฟล์นี้
//
// ตัวเลข HUD ก็ server-render และโมดูลนับต่อจากค่านั้นผ่าน data-seed — ไม่งั้นเลขจะ
// รีเซ็ตเป็นศูนย์ให้เห็นตอน JS เริ่มทำงาน แล้วค่อยไต่ขึ้นใหม่
//
// ป้ายกำกับทุกตัวเป็น <p>/<span> ฟีดรายการเป็น chrome ไม่ใช่เนื้อหาบทความ จึง
// **ไม่ปล่อย heading tag ระดับไหนเลย** และ <section> รับชื่อที่เข้าถึงได้จาก aria-label
// (§8 ห้ามเลื่อน <p> ขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด")
// ไม่มีไทล์ไหนอ้างยอดฝากถอนขั้นต่ำ ค่า RTP เลขใบอนุญาต หรือชื่อธนาคาร เพราะบรีฟ
// (src/assets/content.txt) ไม่ได้ระบุสิ่งเหล่านั้นเป็นข้อเท็จจริงของฟีดนี้
// บรรทัดรองพูดตรงๆ ว่าแถวข้างล่างคือตัวอย่าง "รูปแบบการแสดงรายการ" ไม่ใช่ยอดจริง
// จึงไม่มีการอ้างตัวเลขของสมาชิกจริงที่ไหน
//
// ไทล์ที่สามถือโปรโมชั่นสองรายการที่บรีฟระบุเอง ด้วยตัวเลขของบรีฟเอง:
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% (content.txt บรรทัด 8) — **ไม่ใช่ไทล์หวย และ
// ไม่ใช่ไทล์สล็อต** และต้องไม่กลับไปเป็นทั้งสองอย่าง §6 วางแบรนด์นี้บนแกน
// **ฟุตบอล/ยูฟ่า** คำสล็อตทั้งหมดเป็นของค้างจากรอบขาออก (รวยเทพ168) และคำหวย
// ทั้งหมดถูกห้ามตั้งแต่สองรอบก่อน (/ตรวจหวย กับ /แนวทาง จอดอยู่ใน src/pages-disabled/
// รอบนี้ และห้ามมีลิงก์ไปสองหน้านั้น)
// คำที่ใช้มาจากคลังคำของบรีฟล้วน (§6): รายการฝากถอน · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ผู้ใช้งาน · เว็บไซต์ — **ไม่มี "ฐานหลัก" และไม่มี "ช่องทาง
// รับบริการ"** ซึ่งเป็นวลีของรับตัง168 ชื่อแบรนด์ interpolate จาก BRAND_NAME
// ไม่พิมพ์ตรงๆ และไม่มีโดเมนอยู่ในไฟล์นี้
//
// ufalion168 (รอบ **ทองสองเฉด + บรอนซ์ บนดำสนิท — ไม่มีสีที่สองที่เป็นคนละวงศ์**
// 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ufalion168.md §2
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (รวยเทพ168) ใช้ LatestWinners4 จึงหมุนมาที่ไฟล์นี้
// และไฟล์นี้ยังถือพาเลตต์ของขวัญใจ168 อยู่ทั้งไฟล์ ต้องรีเธมทั้งใบก่อนใช้
// โลโก้อ่านตรงๆ ว่า: **หัวสิงโตทองคำขนแผงฟูสวมมงกุฎทองแหลม** ล้อมด้วย
// **ริ้วทองเหลวโค้งสาดกระเซ็น** และ **ประกายดาวทอง** ด้านล่างเป็นคำว่า **ufalion168**
// ตัวอักษรหนาสามมิติผิวทองมันวาว โดย `ufa` และ `168` เป็นทองเข้ม `lion` เป็นทอง
// อ่อนกว่า และตัว `o` ในคำว่า `lion` มีมงกุฎทองเล็กวางอยู่ข้างใน ส่วนแบนเนอร์เป็น
// ฉาก **สนามบอลกลางคืนพื้นดำ** ที่มีชุดบอลดำ-ทอง ถ้วยแชมเปี้ยนส์ลีกสีเงิน
// **ลูกฟุตบอลดำ-ทอง** ธงดำลายดาวฟุตบอลสีทอง และไอคอนกราฟแท่งทองพร้อมลูกศรขึ้น
// ไอคอนหัวแผงจึงเป็น **ลูกฟุตบอล** ⚽ ตรงกับงานอาร์ตและกับแกนแบรนด์ **ไม่ใช่เหรียญ
// ของขวัญใจ168 ไม่ใช่ถุงเงินของ TKB55 และไม่ใช่ตู้สล็อตของรอบขาออก** (ดรอปนี้
// ไม่มีสามอย่างนั้นเลย)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** (bg.json) ทุกผิวในไฟล์นี้จึงสว่างกว่าพื้น
// ไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ลำดับความลึก: #33200a ยก / #1f1304 กลาง / #0a0601 จม
// แผงนั่งบนผิวจม #0a0601 ในกรอบทองนำ #d4922c โปร่ง แถวอยู่บนผิวกลาง #1f1304
// และกดลงเป็นผิวจมตอนชี้ เส้นคั่นกับขอบแถวปกติเป็นบรอนซ์ไหม้ #5a3310
// หัวแผงเป็นทองนำ #d4922c ส่วนชื่อแบรนด์เป็น **ครีมทอง #f6e3b4** — สองเฉดทองของ
// รอบนี้ติดกันในบรรทัดเดียว ชื่อยูสเซอร์เป็นสีเนื้อความ #fbf6e3 (= BRAND_TEXT)
// ข้อความรองทั้งหมดเป็นครีมทอง #f6e3b4 (16.6:1 บนดำ · 12.3:1 บนผิวยก) ซึ่ง §2
// กำหนดให้เป็นสีตัวอักษรรอง/ป้ายกำกับ
// แถบคาดบนสุดของแผงเป็นแผ่นไล่ บรอนซ์ #a25b24 → ทองนำ #d4922c → ทองสว่าง #fdfc71
// ซึ่งเป็น "ฮิวที่สาม → ฮิวนำ → เฉดสว่าง" อ่านจากซ้ายไปขวา
