---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick } from "../lib/brandProfile";

// Real bank brand colours — never rethemed with the palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Rows are server-rendered and src/lib/winnersFeed.ts only takes over the
// rotation — never `<script define:vars>`, which forces is:inline and leaves the
// feed container empty in the HTML. Verified on this rebrand: the module import
// below is the only script, the five initial rows are in the markup, and nothing
// in this frontmatter calls Math.random().
//
// Two independent row states live here, and both are configured from the markup
// so the shared module never learns this brand's palette or wording:
//   • data-winner-status — pending vs settled, chosen per row by the module from
//     data-pending-chance, with its wording in data-pending-text/data-done-text
//     and its classes in the matching -class pair.
//   • data-winner-big — over BIG_WIN the row swaps from the plain gold treatment
//     to the bright champagne one, which is what reads as "big" on a brand whose
//     only hue is gold: the difference is BRIGHTNESS, not a second colour.
//
// The HUD totals are server-rendered and the module continues from them via
// data-seed — otherwise the figures would visibly reset to zero the moment JS
// ran, then climb again.
//
// Values come from the domain hash, never Math.random(): frontmatter runs at
// build time, and the gate fails the build on a random call there.
//
// Every label here is a <p>/<span>. A withdrawal ticker is chrome, so the
// section takes its accessible name from aria-label and emits no heading tag.
// No tile states a deposit/withdrawal limit, a payout figure, a price, a licence
// or a banking partner — this brief names none of those as facts about the feed.
//
// THE THIRD TILE WAS A LOTTERY TILE AND IS NOT ANY MORE. The previous holder of
// this file listed หวยลาว · หวยฮานอย · รัฐบาลไทย under "รายการหวยที่ติดตามได้จาก
// บัญชีเดียว" — brand-spec §4 bans every lottery word on this brand (UOK365 is
// สล็อต/คาสิโนออนไลน์ เบทต่ำ, and the lottery pages are parked). It now carries
// the only two promotions the brief itself names, with the brief's own figures:
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%.
const BIG_WIN = 40000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = 100 + pick(`winner-amount-${i}`, 48901);
  return {
    bank: bankPool[pick(`winner-bank-${i}`, bankPool.length)],
    user: `0${pick(`winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`winner-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// โลโก้เป็นสองโลหะจริง — ตัวอักษร UOK เป็นทองเมทัลลิก (vivid อันดับ 1 #a46b25 ใช้เป็น
// ทองแบรนด์ #c8912f) ส่วนตัวเลข 365 เป็นเงินโครเมียม #d8dbe0 ในวงแหวนทอง แผงนี้จึง
// แบ่งงานด้วย "ทองเป็นปกติ เงินเป็นก้อนใหญ่": ขอบแถวปกติเป็นทองลึก #6d4412 และยอดเงิน
// ไล่ทองกลาง #a46b25 → ทองอ่อน #f5d98a ส่วนแถวยอดถอนก้อนใหญ่ยกขึ้นเป็นทองอ่อนคู่เงิน
// โครเมียมทั้งขอบและยอด ซึ่งเป็นจุดเดียวในไฟล์นี้ที่เงินถูกใช้ ตามกฎ §2 ที่ให้ใช้เงิน
// อย่างประหยัด ชื่อแบรนด์บนหัวแผงเป็นเงินโครเมียม ตัวนับรายการเป็นสีเนื้อความ #ece1cc
// แผงนั่งบนผิวแถบ #0a0806 แถวอยู่บนผิวยก #191108 และยกเป็นผิวกลาง #120c07 ตอนชี้
// ข้อความรองเป็นงาช้างหม่น #b7a58a
// ส่วนจุด "live" กับสีสถานะที่โอนสำเร็จยังเป็นเขียวของ Tailwind ตามเดิม: นั่นคือสีเชิง
// ความหมาย ไม่ใช่สีแบรนด์ เช่นเดียวกับสีประจำธนาคารในรายชื่อด้านบน
//
// ชุดแดงแบรนด์-ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#d20a0a #ff5c5c #7a0505 #f5c33b
// #ffd45e #a9761a #060202 #170707 #230d0d #f7e2d6 #d6b3a6 rgba(255,212,94,…)
// rgba(245,195,59,…) rgba(5,2,2,…)) ออกครบทุกจุดแล้ว พร้อมกับคำหมวดหวยทั้งหมด
const ROW_NORMAL = "border-[#6d4412]";
const ROW_BIG = "border-[#f5d98a]/75 shadow-[0_0_15px_rgba(245,217,138,0.35)]";
const AMOUNT_NORMAL = "from-[#a46b25] to-[#f5d98a]";
const AMOUNT_BIG = "from-[#f5d98a] to-[#d8dbe0] drop-shadow-[0_0_10px_rgba(245,217,138,0.45)]";
const STATUS_DONE = "text-green-400 font-bold";
const STATUS_PENDING = "text-[#ece1cc] font-bold";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-3xl border border-[#c8912f]/45 bg-[#0a0806]/92 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#6d4412] px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#c8912f]/45 bg-[#191108] text-2xl text-[#f5d98a]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#f5d98a] drop-shadow-sm">
            รายการถอนเงินล่าสุด <span class="text-[#d8dbe0]">{BRAND_NAME}</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#b7a58a]">อัปเดตอัตโนมัติจากรายการถอนของสมาชิก ตามช่องทางที่เว็บไซต์เปิดให้ใช้งานในแต่ละช่วงเวลา</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#6d4412] bg-[#191108]/60 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#0a0806] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b7a58a]">ยอดถอนรวมวันนี้</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#f5d98a] to-[#a46b25] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#0a0806] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b7a58a]">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#ece1cc] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#0a0806] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#b7a58a]">โปรโมชั่นที่ติดตามได้จากบัญชีเดียว</span>
        <span class="font-mono text-base font-black text-[#d8dbe0] sm:text-lg">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#b7a58a] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min="100"
      data-amount-max="49000"
      data-pending-chance="0.25"
      data-user-style="phone"
      data-user-digits="4"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#191108]/90 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#c8912f]/70 hover:bg-[#120c07]/80 sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#ece1cc]">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#c8912f]" />
                <span data-winner-status data-pending-text="กำลังตรวจสอบรายการถอน" data-done-text="ถอนสำเร็จแล้ว" data-pending-class={STATUS_PENDING} data-done-class={STATUS_DONE} class={STATUS_DONE}>
                  ถอนสำเร็จแล้ว
                </span>
              </div>
              <div
                data-winner-big
                data-normal-class={AMOUNT_NORMAL}
                data-big-class={AMOUNT_BIG}
                class={`bg-gradient-to-r bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg ${row.big ? AMOUNT_BIG : AMOUNT_NORMAL}`}>
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#b7a58a] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
