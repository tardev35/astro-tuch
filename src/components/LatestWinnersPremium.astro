---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick } from "../lib/brandProfile";

// Real bank brand colours — never rethemed with the palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Rows are server-rendered and src/lib/winnersFeed.ts only takes over the
// rotation — never `<script define:vars>`, which forces is:inline and leaves the
// feed container empty in the HTML. Verified on this rebrand: the module import
// below is the only script, the five initial rows are in the markup, and nothing
// in this frontmatter calls Math.random().
//
// Two independent row states live here, and both are configured from the markup
// so the shared module never learns this brand's palette or wording:
//   • data-winner-status — pending vs settled, chosen per row by the module from
//     data-pending-chance, with its wording in data-pending-text/data-done-text
//     and its classes in the matching -class pair.
//   • data-winner-big — over BIG_WIN the row swaps from the crown-gold treatment
//     to a gold-into-lime one, which is what reads as "big" on a brand whose two
//     hues are gold and lime: the difference is HUE TRAVEL, not just brightness.
//
// The HUD totals are server-rendered and the module continues from them via
// data-seed — otherwise the figures would visibly reset to zero the moment JS
// ran, then climb again.
//
// Values come from the domain hash, never Math.random(): frontmatter runs at
// build time, and the gate fails the build on a random call there.
//
// Every label here is a <p>/<span>. A withdrawal ticker is chrome, so the
// section takes its accessible name from aria-label and emits no heading tag.
// No tile states a deposit/withdrawal limit, a payout figure, a price, a licence
// or a banking partner — this brief names none of those as facts about the feed.
//
// The third tile carries the only two promotions the brief itself names, with
// the brief's own figures: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%. It is NOT a
// lottery tile and must never become one again — brand-spec §6 bans every
// lottery word on this brand (KINGKONG555 is a ฐานเว็บสล็อตหลัก, and /ตรวจหวย
// and /แนวทาง stay parked in src/pages-disabled/).
const BIG_WIN = 40000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = 100 + pick(`winner-amount-${i}`, 48901);
  return {
    bank: bankPool[pick(`winner-bank-${i}`, bankPool.length)],
    user: `0${pick(`winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`winner-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// โลโก้เป็นกอริลลาเขียวสวมมงกุฎทองฝังพลอยเขียว ตัวอักษร KINGKONG เป็นเขียวมะนาว
// #8ce023 (vivid อันดับ 1 ของดรอปนี้) และมงกุฎเป็นทองมงกุฎ #f2c230 แผงนี้จึงแบ่งงาน
// ด้วย "ทองเป็นปกติ เขียวมะนาวเป็นก้อนใหญ่": ขอบแถวปกติเป็นเขียวลึก #1a5c04 และยอดเงิน
// ไล่ทองมงกุฎ #f2c230 → ทองสว่าง #ffe066 ส่วนแถวยอดถอนก้อนใหญ่ยกขึ้นเป็นทองสว่างไล่
// เข้าเขียวมะนาวทั้งขอบและยอด ซึ่งเป็นจุดเดียวในไฟล์นี้ที่เขียวมะนาวถือยอดเงิน
// ชื่อแบรนด์บนหัวแผงเป็นเขียวมะนาว ตัวนับรายการเป็นสีเนื้อความ #e9f7d6
// แผงนั่งบนผิวเพจ #0a2400 แถวอยู่บนผิวยก #14380a และยกเป็นผิวกลาง #0f2e05 ตอนชี้
// ข้อความรองเป็นเขียวอ่อน #bde397
//
// ⚠️ กรณีพิเศษของรอบนี้: ฮิวของแบรนด์ "เป็นเขียว" เอง จุด live กับสีสถานะที่โอนสำเร็จ
// จึงถูกย้ายจาก green-400 ของ Tailwind ไปเป็น emerald-400 (#34d399) ซึ่งเป็นเขียวอม
// ฟ้า แยกฮิวออกจากเขียวมะนาว #8ce023 ของแบรนด์ได้ชัดด้วยตา ตาม §2 ที่ให้คงสีเชิง
// ความหมายไว้ แต่ต้องทำให้ต่างจากไลม์ของแบรนด์จริง — ห้ามเปลี่ยนให้เป็นสีแบรนด์ เพราะ
// นั่นคือการลบความหมาย "สำเร็จ/กำลังตรวจสอบ" ออกจากแถว สีประจำธนาคารในรายชื่อด้านบน
// ก็อยู่ใต้กฎเดียวกันและไม่ถูกแตะ
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #a46b25
// #6d4412 #d8dbe0 #0a0806 #191108 #120c07 #ece1cc #b7a58a rgba(245,217,138,α))
// ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #ffd23d #c98a05 #1e0a3c #0a0117
// #ece2ff) และชุดแดงแบรนด์-ทองของ หวย24 (#d20a0a #ff5c5c #7a0505 #f5c33b #ffd45e
// #a9761a #f7e2d6) ออกครบทุกจุดแล้ว พร้อมกับคำหมวดหวยทั้งหมด
const ROW_NORMAL = "border-[#1a5c04]";
const ROW_BIG = "border-[#ffe066]/75 shadow-[0_0_15px_rgba(140,224,35,0.35)]";
const AMOUNT_NORMAL = "from-[#f2c230] to-[#ffe066]";
const AMOUNT_BIG = "from-[#ffe066] to-[#8ce023] drop-shadow-[0_0_10px_rgba(140,224,35,0.45)]";
const STATUS_DONE = "text-emerald-400 font-bold";
const STATUS_PENDING = "text-[#e9f7d6] font-bold";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-3xl border border-[#f2c230]/45 bg-[#0a2400]/92 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#1a5c04] px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#f2c230]/45 bg-[#14380a] text-2xl text-[#ffe066]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#ffe066] drop-shadow-sm">
            รายการถอนเงินล่าสุด <span class="text-[#8ce023]">{BRAND_NAME}</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#bde397]">อัปเดตอัตโนมัติจากรายการถอนของสมาชิก ตามช่องทางที่เว็บไซต์เปิดให้ใช้งานในแต่ละช่วงเวลา</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-emerald-500/40 bg-emerald-900/20 px-3 py-1.5 sm:self-auto">
        <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-emerald-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#1a5c04] bg-[#14380a]/60 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#0a2400] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#bde397]">ยอดถอนรวมวันนี้</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#ffe066] to-[#f2c230] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#0a2400] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#bde397]">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#e9f7d6] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#0a2400] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#bde397]">โปรโมชั่นที่ติดตามได้จากบัญชีเดียว</span>
        <span class="font-mono text-base font-black text-[#8ce023] sm:text-lg">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#bde397] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min="100"
      data-amount-max="49000"
      data-pending-chance="0.25"
      data-user-style="phone"
      data-user-digits="4"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#14380a]/90 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#f2c230]/70 hover:bg-[#0f2e05]/80 sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#e9f7d6]">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f2c230]" />
                <span data-winner-status data-pending-text="กำลังตรวจสอบรายการถอน" data-done-text="ถอนสำเร็จแล้ว" data-pending-class={STATUS_PENDING} data-done-class={STATUS_DONE} class={STATUS_DONE}>
                  ถอนสำเร็จแล้ว
                </span>
              </div>
              <div
                data-winner-big
                data-normal-class={AMOUNT_NORMAL}
                data-big-class={AMOUNT_BIG}
                class={`bg-gradient-to-r bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg ${row.big ? AMOUNT_BIG : AMOUNT_NORMAL}`}>
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#bde397] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
