---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick } from "../lib/brandProfile";

// Real bank brand colours — never rethemed with the palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Rows are server-rendered and src/lib/winnersFeed.ts only takes over the
// rotation — never `<script define:vars>`, which forces is:inline and leaves the
// feed container empty in the HTML. Verified on this rebrand: the module import
// below is the only script, the five initial rows are in the markup, and nothing
// in this frontmatter calls Math.random().
//
// Two independent row states live here, and both are configured from the markup
// so the shared module never learns this brand's palette or wording:
//   • data-winner-status — pending vs settled, chosen per row by the module from
//     data-pending-chance, with its wording in data-pending-text/data-done-text
//     and its classes in the matching -class pair.
//   • data-winner-big — over BIG_WIN the row gets the bright-gold treatment,
//     which is what reads as "big" on BRAVO168's stadium-night navy surface.
//
// The HUD totals are server-rendered and the module continues from them via
// data-seed — otherwise the figures would visibly reset to zero the moment JS
// ran, then climb again.
//
// Values come from the domain hash, never Math.random(): frontmatter runs at
// build time, and the gate fails the build on a random call there.
//
// Every label here is a <p>/<span>. A withdrawal ticker is chrome, so the
// section takes its accessible name from aria-label and emits no heading tag.
// No tile states a deposit/withdrawal limit, a payout figure, a price, an odds
// number or a banking partner — the BRAVO168 brief names none. The market tile
// lists only the three the brief itself names: บอลเดี่ยว บอลสเต็ป และบอลสด
// (คำของแบรนด์สล็อต/หวยรอบก่อนไม่มีอยู่ในบรีฟรอบนี้).
const BIG_WIN = 40000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = 100 + pick(`winner-amount-${i}`, 48901);
  return {
    bank: bankPool[pick(`winner-bank-${i}`, bankPool.length)],
    user: `0${pick(`winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`winner-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): โลโก้เป็นเวิร์ดมาร์กสองสี BRAVO เป็นโครเมียม
// ไล่น้ำเงินรอยัล #1558c4 แล้ว 168 เป็นทองตัน #f4cb69 แผงนี้จึงแบ่งงานให้สองสีนั้นจริง —
// กรอบแผง เส้นคั่น และยอดเงินเป็นทอง (ทองแบรนด์ #f4cb69 ตอนปกติ ทองลึก #c9922e เป็น
// เส้นฐาน ทองอ่อน #ffe39a เมื่อเป็นยอดถอนก้อนใหญ่) ส่วนตัวเลขนับรายการ ชื่อแบรนด์บนหัวแผง
// และสถานะที่ยังตรวจสอบอยู่เป็นขาวนวล #dbe5f5 แผงนั่งบนพื้นเพจกรมท่าเกือบดำ #02081a แถว
// อยู่บนผิวการ์ด #04142f และยกเป็นผิวแผงยก #072247 ตอนชี้ ส่วนจุด "live" กับสีสถานะที่โอน
// สำเร็จยังเป็นเขียวของ Tailwind ตามเดิม: นั่นคือสีเชิงความหมาย ไม่ใช่สีแบรนด์ — ชุดทอง-ขาว
// ของ WIN999 (#fcc403 #fdda04 #e0a800 #8a6502 #4a3402 #fffbea #191712 #101010
// #050505 #e9e4d6) ออกทั้งหมด
const ROW_NORMAL = "border-[#0e3f8f]";
const ROW_BIG = "border-[#f4cb69]/75 shadow-[0_0_15px_rgba(244,203,105,0.4)]";
const AMOUNT_NORMAL = "from-[#c9922e] to-[#f4cb69]";
const AMOUNT_BIG = "from-[#ffe39a] to-[#f4cb69] drop-shadow-[0_0_10px_rgba(244,203,105,0.45)]";
const STATUS_DONE = "text-green-400 font-bold";
const STATUS_PENDING = "text-[#dbe5f5] font-bold";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-3xl border border-[#f4cb69]/45 bg-[#02081a]/92 shadow-[0_10px_40px_rgba(1,3,10,0.85)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#0e3f8f] px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#f4cb69]/40 bg-[#04142f] text-2xl text-[#f4cb69]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#f4cb69] drop-shadow-sm">
            รายการถอนเงินล่าสุด <span class="text-[#dbe5f5]">{BRAND_NAME}</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#dbe5f5]/65">อัปเดตอัตโนมัติจากรายการถอนของสมาชิก ตามช่องทางที่เว็บไซต์เปิดให้ใช้งานในแต่ละช่วงเวลา</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#0e3f8f] bg-[#04142f]/60 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#02081a] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe5f5]/65">ยอดถอนรวมวันนี้</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#f4cb69] to-[#c9922e] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#02081a] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe5f5]/65">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#dbe5f5] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#02081a] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe5f5]/65">รูปแบบเดิมพันในบัญชีเดียว</span>
        <span class="font-mono text-lg font-black text-[#dbe5f5] sm:text-xl">บอลเดี่ยว · บอลสเต็ป · บอลสด</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#dbe5f5]/65 uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min="100"
      data-amount-max="49000"
      data-pending-chance="0.25"
      data-user-style="phone"
      data-user-digits="4"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#04142f]/90 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#f4cb69]/70 hover:bg-[#072247]/80 sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#dbe5f5]">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9922e]" />
                <span data-winner-status data-pending-text="กำลังตรวจสอบรายการถอน" data-done-text="ถอนสำเร็จแล้ว" data-pending-class={STATUS_PENDING} data-done-class={STATUS_DONE} class={STATUS_DONE}>
                  ถอนสำเร็จแล้ว
                </span>
              </div>
              <div
                data-winner-big
                data-normal-class={AMOUNT_NORMAL}
                data-big-class={AMOUNT_BIG}
                class={`bg-gradient-to-r bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg ${row.big ? AMOUNT_BIG : AMOUNT_NORMAL}`}>
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#dbe5f5]/65 sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
