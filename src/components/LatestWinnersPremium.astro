---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// สีใน bg-[#...] ชุดนี้คือสีประจำแบรนด์ของธนาคารเอง ไม่ใช่ส่วนหนึ่งของพาเลตต์แบรนด์
// brand-spec §2 ระบุว่าสีเชิงความหมายห้ามแตะ จึงไม่ถูกสวีปทุกรอบรีแบรนด์
// ⚠️ #1155cc #4e1c80 #fcd34d #0ea5e9 สี่ค่านี้ **ห้ามสวีป** แม้ว่ารอบนี้จะห้ามทอง
// ม่วง และฟ้านอกพาเลตต์ — มันคือสีของธนาคาร ไม่ใช่สีของแบรนด์นี้
// ชื่อธนาคารเดินทางเป็น JSON เฉย ๆ เพื่อใช้เลือกสีป้ายกับไอคอนของแถว —
// **ไม่มีชื่อธนาคารโผล่ในข้อความที่มองเห็นสักจุด และไอคอนทุกใบเป็น alt=""**
// 🚨🚨 **บรีฟรอบนี้ (src/assets/content.txt) ไม่มีหมวดฝากถอน ธนาคาร หรือวอลเลท
// เลยแม้แต่คำเดียว** → ข้อความที่มองเห็นในไฟล์นี้จึง **ไม่มีคำว่า ฝากถอน / ฝาก /
// ถอน / ธนาคาร / วอลเลท / ออโต้ สักคำ** แผงนี้พูดถึง **รายการธุรกรรมในระบบสมาชิก**
// ซึ่งเป็นคำของบรีฟเอง (บรรทัด 22: "หากพบปัญหาเกี่ยวกับบัญชีสมาชิกหรือธุรกรรม
// ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ")
// ⚠️ bankPool **ต้องไม่ว่าง**: src/lib/winnersFeed.ts คืนค่าทันทีถ้า banks.length
// เป็น 0 ซึ่งจะทำให้ฟีดหยุดหมุน — จึงคงสี่รายการไว้ในฐานะข้อมูลของแถว ไม่ใช่
// คำกล่าวอ้างของเว็บไซต์
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// ไฟล์นี้ต้องไม่กลับไปใช้ `<script define:vars={{ bankPool }}>` เด็ดขาด:
// define:vars บังคับ is:inline ซึ่งตัด type/async/defer ออก เหลือ script ที่บล็อก
// parser กลางเอกสาร — tools/verify-build.mjs ทำให้ build แดงทันทีบนหน้าที่ index ได้
// แถวทั้งห้าแถวจึง server-render จากตรงนี้ รายชื่อธนาคารเดินทางเป็น JSON ที่ parser
// ข้ามไป และ src/lib/winnersFeed.ts (ใช้ร่วมกับทุก LatestWinners* และขับด้วย selector
// จึงไม่ต้องแก้) เข้ามารับช่วงแค่การหมุนแถว พร้อมการ์ด on-screen / hidden-tab /
// prefers-reduced-motion ทุก data-* ด้านล่างคือส่วนหนึ่งของสัญญานั้น
//
// ค่าทั้งหมดมาจากแฮชโดเมนของแบรนด์ **ไม่ใช่ Math.random()**: frontmatter รันตอน build
// ถ้าสุ่มที่นี่ ทุก deploy จะเขียน markup ของเว็บจริงใหม่โดยไม่มีเหตุผล
// brandPick()/brandFlag() ทำให้สองบิลด์ของโดเมนเดียวกันออกมาไบต์ต่อไบต์เท่ากัน
//
// สองสถานะของแถวถูกตั้งค่าจาก markup ทั้งคู่ เพื่อให้โมดูลที่แชร์กันไม่ต้องรู้พาเลตต์
// หรือคำพูดของแบรนด์นี้เลย:
//   • data-winner-status — รอตรวจสอบ vs ตรวจสอบแล้ว โมดูลเลือกต่อแถวจาก
//     data-pending-chance ส่วนคำอยู่ใน data-pending-text/data-done-text และคลาสอยู่ใน
//     คู่ -class ที่ตรงกัน
//   • data-winner-big — เหนือ BIG_WIN แถวจะยกขึ้น ⚠️ "ก้อนใหญ่" ต้องอ่านเป็น
//     **การเดินข้ามเฉด** ไม่ใช่การขยับความสว่างของสีเดียว รอบนี้จึงเดินข้ามฮิวจริง:
//     แถวปกติอยู่บน **แรมป์เขียวเสจเงียบ ๆ** (#b4d6ad → #e8fbe4) ส่วนแถวยอดก้อนใหญ่
//     กระโดดไป **ทองอำพัน → หมึกหลัก** (#e3bb45 → #e8fbe4 พร้อมออราทอง) ซึ่งเป็น
//     ความต่างที่เห็นจริงในเสี้ยววินาที และทุกสต็อปยังถือตัวอักษรได้บนผิวแถว #0b2a12
//     (#b4d6ad 9.7:1 · #e8fbe4 14.3:1 · #e3bb45 8.5:1 ตาม brand-spec §2)
//
// ตัวเลข HUD ก็ server-render และโมดูลนับต่อจากค่านั้นผ่าน data-seed — ไม่งั้นเลขจะ
// รีเซ็ตเป็นศูนย์ให้เห็นตอน JS เริ่มทำงาน แล้วค่อยไต่ขึ้นใหม่
//
// ป้ายกำกับทุกตัวเป็น <p>/<span> ฟีดรายการเป็น chrome ไม่ใช่เนื้อหาบทความ จึง
// **ไม่ปล่อย heading tag ระดับไหนเลย** และ <section> รับชื่อที่เข้าถึงได้จาก aria-label
// (**ห้ามเลื่อน <p> ขึ้นเป็น h2 เพื่อ "แก้ชื่อที่ขาด"** — inventory ของหน้าแรกรอบนี้
// ถูกตรึงไว้ที่ h1×1 / h2×5 / h3×2 ตาม brand-spec §4)
// ไม่มีไทล์ไหนอ้างยอดขั้นต่ำเป็นตัวเลข เลขใบอนุญาต จำนวนสมาชิก หรือชื่อธนาคาร เพราะ
// บรีฟไม่ได้ระบุสิ่งเหล่านั้นไว้ บรรทัดรองพูดตรง ๆ ว่าแถวข้างล่างคือตัวอย่าง
// "รูปแบบการแสดงรายการ" ไม่ใช่ยอดจริง จึงไม่มีการอ้างตัวเลขของสมาชิกจริงที่ไหน
//
// ⚠️⚠️ ไทล์ที่สามถือโปรโมชั่นสองรายการที่บรีฟระบุเอง ด้วยตัวเลขของบรีฟเอง:
// **คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%** (content.txt บรรทัด 8) — **รอบนี้สองค่านี้
// เป็นเนื้อหาของบรีฟจริง เขียนได้ตามปกติ** (กลับทิศจากรอบก่อนที่ห้าม)
// 🚨 **แบรนด์รอบนี้เป็นเว็บเกมพนัน/สล็อต ไม่ใช่เว็บหวย** คำว่า หวย · สลาก · ตรวจหวย ·
// แนวทาง · เลขเด็ด · งวด · แทงหวย · โพยหวย · รอบปิดรับ · อัตราจ่าย 2 ตัว 100 ·
// 3 ตัว 1,000 **ไม่มีอยู่ในบรีฟรอบนี้แม้แต่คำเดียวและห้ามเติมกลับ** ไอคอนหัวแผงจึง
// เป็น **🧾 หมายเลขรายการ/หลักฐานธุรกรรม** ซึ่งตรงกับหัวข้อของแผงนี้เอง และไม่อ้าง
// วัตถุที่ไม่มีอยู่ในอาร์ตเวิร์กของดรอปนี้
// คำที่ใช้มาจากคลังคำของบรีฟล้วน (brand-spec §5): ระบบสมาชิก · ธุรกรรม · หมายเลข
// รายการ · สมาชิก · ผู้ใช้งาน · เว็บไซต์ · โปรโมชั่น · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% ชื่อแบรนด์ interpolate จาก BRAND_NAME ไม่พิมพ์ตรง ๆ และไม่มี
// โดเมนในไฟล์นี้
//
