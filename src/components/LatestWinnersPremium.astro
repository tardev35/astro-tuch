// จะเป็นเขียวก็ตาม** เพราะนั่นคือการลบความหมาย "สำเร็จ / อยู่ระหว่างตรวจสอบ" ออกจาก
// แถว และจะกลืนหายไปกับเขียวแบรนด์รอบนี้ทันที ส่วนสถานะรอใช้เงินโครเมียม #c6cfd2
// (เงียบ ไม่ใช่สีนำ และต่างฮิวจาก emerald ชัดเจน) สีประจำธนาคารใน bankPool ด้านบน
// อยู่ใต้กฎเดียวกันและไม่ถูกแตะ
const BIG_WIN = 40000;
const AMOUNT_MIN = 100;
const AMOUNT_MAX = 49000;

const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`winner-bank-${i}`, bankPool.length)],
    user: `0${pick(`winner-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`winner-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
    pending: brandFlag(Astro.site, `winner-pending-${i}`),
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

const ROW_NORMAL = "border-[#2d6b2f]";
const ROW_BIG = "border-[#e3bb45]/75 shadow-[0_0_15px_rgba(227,187,69,0.32)]";
const AMOUNT_NORMAL = "from-[#b4d6ad] to-[#e8fbe4]";
const AMOUNT_BIG = "from-[#e3bb45] to-[#e8fbe4] drop-shadow-[0_0_10px_rgba(227,187,69,0.5)]";
const STATUS_DONE = "text-emerald-400 font-bold";
const STATUS_PENDING = "text-[#c6cfd2] font-bold";
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ตรวจสอบแล้ว";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบการแสดงรายการธุรกรรมในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-3xl border border-[#2d6b2f] bg-[#051409] shadow-[0_10px_40px_rgba(0,0,0,0.55)]">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[#0b4a12] via-[#1a7d24] to-[#28c437]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-56 w-56 rounded-full bg-[#28c437]/18 blur-[70px]"></div>

    <div class="relative z-10 flex flex-col gap-4 border-b border-[#2d6b2f] px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#2d6b2f] bg-[#0b2a12] text-2xl">🧾</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#c6cfd2] drop-shadow-sm">
            รายการธุรกรรมในระบบสมาชิก <span class="text-[#28c437]">{BRAND_NAME}</span>
          </p>
          <span class="mt-1 text-[11px] font-medium tracking-wide text-[#b4d6ad]"
            >แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการในระบบสมาชิกเท่านั้น ไม่ใช่ยอดจริงของสมาชิก</span
          >
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-emerald-500/40 bg-emerald-900/20 px-3 py-1.5 sm:self-auto">
        <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-emerald-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#2d6b2f] bg-[#15401d]/70 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#051409] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b4d6ad]">ยอดรวมในรายการตัวอย่าง</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#e3bb45] to-[#e8fbe4] bg-clip-text text-lg font-black text-transparent tabular-nums sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#051409] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#b4d6ad]">จำนวนรายการตัวอย่าง</span>
        <span data-winners-count data-seed={initialRows.length} class="text-lg font-black text-[#e8fbe4] tabular-nums sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#051409] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#b4d6ad]">โปรโมชั่นที่ระบุไว้บนเว็บไซต์</span>
        <span class="text-base font-black text-[#28c437] sm:text-lg">คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#b4d6ad] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.25"
      data-user-style="phone"
      data-user-digits="4"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#0b2a12] p-3.5 shadow-sm transition-colors duration-300 hover:border-[#28c437]/70 hover:bg-[#051409] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#2d6b2f] shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain" />
                </div>
                <span data-winner-user class="text-sm font-bold text-[#e8fbe4] tabular-nums">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#1a7d24]" />
                <span
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={STATUS_PENDING}
                  data-done-class={STATUS_DONE}
                  class={row.pending ? STATUS_PENDING : STATUS_DONE}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </span>
              </div>
              <div
                data-winner-big
                data-normal-class={AMOUNT_NORMAL}
                data-big-class={AMOUNT_BIG}
                class={`bg-gradient-to-r bg-clip-text text-right text-base font-black text-transparent tabular-nums sm:text-lg ${row.big ? AMOUNT_BIG : AMOUNT_NORMAL}`}>
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#b4d6ad] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // ไม่ใช่ `define:vars` — ตัวนั้นบังคับ is:inline ซึ่งตัด type/async/defer ออก และ
  // เหลือ script ที่บล็อก parser กลางเอกสาร รายชื่อธนาคารมาเป็น JSON ที่ parser ข้าม
  // ด้านบนแทน และโมดูลนี้ถูก bundle + defer เหมือน script ปกติทุกตัว
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
