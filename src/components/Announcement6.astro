---
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out as "crown" ahead of the sentence, three
  // times over, once per marquee copy.
  message = "JOJO789 สล็อตออโต้เว็บตรง รวมค่ายลิขสิทธิ์แท้จาก PG SOFT • ฝากถอนอัตโนมัติไม่มีขั้นต่ำ • เล่นได้ทั้ง Android และ iOS • ทีมงานดูแลและให้คำแนะนำตลอด 24 ชั่วโมง • ตรวจสอบสถานะฝากถอนได้ด้วยตนเอง",
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#b38f00]/40 bg-gradient-to-b from-[#171200] via-[#0c0900] to-[#171200] p-1 shadow-[0_5px_20px_rgba(252,237,11,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#b38f00]/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#fff6b0]/15 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#fff6b0]/40 bg-gradient-to-b from-[#fff6b0] via-[#fced0b] to-[#b38f00] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#201800] shadow-[0_0_6px_rgba(32,24,0,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#201800] uppercase md:text-sm"><span aria-hidden="true">👑</span> JOJO789</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#fff6b0]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#f4ecc9]/80">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f4ecc9]/80">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#b38f00]/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
