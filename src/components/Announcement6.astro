---
import { BRAND_NAME } from "../lib/brandProfile";

// สบาย168 (รอบฟ้าสกายนำ-ทองคานารีรอง บนธีมสว่าง 2026-10-22): ticker ที่ใช้งานจริง
// รอบนี้ หมุนมาจาก Announcement3 ของ ยูฟ้า168 ของเดิมที่ค้างอยู่ในไฟล์นี้เป็นพาเลตต์
// ชมพูบับเบิลกัม-ทองเนยของ ถอนชัวร์168 ซึ่งถูกเปลี่ยนออกครบแล้ว — fa63b9 ffb3de
// ffd9ef ffd84d 6d0b3f 2a0617 1a0914 ไม่เหลือในไฟล์นี้ และชุดทองเป็ด-ส้มปากเป็ด
// ของ DUCK1688 ก่อนหน้านั้น (1f1709 8a5f08 f3bb34 fde464 c8901a a3510c f58b2a
// 1a1203) ก็ไม่เหลือเช่นกัน
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์)
//
// ⚠️ ไฟล์นี้เคยเป็นทอง-ส้ม และรอบนี้ก็ยังมีทองอยู่ในพาเลตต์ — การเจอ "ทอง" จึงไม่
// พิสูจน์อะไร ทองรอบนี้คือ **#fdcb0c / #fefb6b** เท่านั้น ไม่ใช่ ffd84d (ถอนชัวร์168)
// f3bb34 fde464 (DUCK1688) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) fad354 (789BETTING)
// ffc82e (สบายเบท168) หรือ fef54b (นินจา168 ซึ่งใกล้ #fefb6b ที่สุด)
// และฟ้ารอบนี้คือ **#2cc3fc / #6bdcfb** ไม่ใช่ 2f9ff5 (สบายเบท168) 32bcfb (นินจา168)
// หรือ 039cfa (รวยแทร่168) รายการเต็มอยู่ใน .claude/brand-spec-sabai168.md §2
//
// ⚠️⚠️ **พื้นเพจรอบนี้สว่าง (#ccf7ff จาก bg.json) แต่ ticker ตัวนี้เป็นโครม จึงเป็น
// น้ำเงินมหาสมุทรลึก** — หัว-ท้าย-ticker เป็นสมอหนักคร่อมตัวหน้าที่สว่าง
// **ห้าม "แก้" ให้สว่างตามพื้นเพจ** และห้ามทำกลับกันคือทำให้เนื้อหามืดตาม ticker
//
// ทุกหน้าเรียก <Announcement /> แบบ bare ทั้งหมด ข้อความด้านล่างจึงเป็นข้อความ
// จริงที่ขึ้นทั้งเว็บ ไม่ใช่ filler — ห้ามส่ง prop message ทับจากหน้าไหน ไม่งั้น
// ticker จะพูดคนละเรื่องกันระหว่างหน้า
//
// ข้อความทุกคำมาจาก src/assets/content.txt รอบนี้: สล็อตเบทต่ำสบายเป๋า ทุนน้อย
// เล่นง่าย · ข้อมูลเกี่ยวกับการสมัครสมาชิก โปรโมชั่น และช่องทางฝากถอน ·
// คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน · แนะนำเพื่อนโบนัส 0.8% · สมัครง่ายๆ 3 ขั้นตอน ·
// ช่องทางติดต่อแอดมิน 24ชม. — บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว**
// จึงไม่มีชื่อค่ายในข้อความนี้ และคำของแบรนด์ก่อน (เว็บตรง100% ไม่ผ่านม้า ฐานหลัก
// แทงบอล บาคาร่า) ไม่เหลือแล้ว
//
// ชื่อแบรนด์บนป้ายซ้ายมาจาก BRAND_NAME ไม่ใช่สตริงที่พิมพ์ไว้
//
// เป็น chrome ล้วน จึงไม่มี heading tag — ป้ายซ้ายเป็น <span>
//
// หมึก #2a1f02 บนป้ายไล่เฉดทอง #fefb6b → #fdcb0c ได้ 14.8 / 10.6:1 ผ่าน AA ทั้งเส้น
// ส่วนข้อความวิ่ง #a9e3f9 บนพื้นน้ำเงินหมึก #063a57 ≈ 8.6:1
// ⚠️ #2cc3fc #6bdcfb #fdcb0c #fefb6b ถือตัวอักษรได้ **เฉพาะบนผิวโครมเข้มในไฟล์นี้**
// บนพื้นสว่างของเนื้อหาถือไม่ได้
// ไอคอนในป้ายเป็น 🌾 ตามอาร์ตเวิร์กฟาร์ม/โรงเรือนของดรอปนี้ ไม่ใช่ ⚽ ของรอบก่อน
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out ahead of the sentence, three times over,
  // once per marquee copy.
  message = `${BRAND_NAME} สล็อตเบทต่ำสบายเป๋า ทุนน้อย เล่นง่าย รวมข้อมูลการสมัครสมาชิก โปรโมชั่น และช่องทางฝากถอนไว้ในเว็บไซต์เดียว • คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของแต่ละรายการ • สมัครเล่นง่ายๆ 3 ขั้นตอน • ติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24ชม.`,
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#2cc3fc]/55 bg-gradient-to-b from-[#0a4f74] via-[#063a57] to-[#04293d] p-1 shadow-[0_5px_20px_rgba(6,58,87,0.25),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#2cc3fc]/30 blur-[30px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#fdcb0c]/25 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#fefb6b]/50 bg-gradient-to-b from-[#fefb6b] to-[#fdcb0c] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#063a57] shadow-[0_0_6px_rgba(6,58,87,0.9)]"></span>
      <span class="text-xs font-black tracking-wider text-[#2a1f02] uppercase md:text-sm"><span aria-hidden="true">🌾</span> {BRAND_NAME}</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#a9e3f9]">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#fdcb0c]">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#fdcb0c]">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#fdcb0c]/80 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
