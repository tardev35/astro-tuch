---
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out as "red envelope" ahead of the sentence,
  // three times over, once per marquee copy.
  message = "HENGDEE89 เว็บพนันออนไลน์ที่1 ในไทย รวมเกมครบทั้งสล็อต บาคาร่า คาสิโนสด หวย และกีฬาไว้ในบัญชีเดียว • คืนยอดเสียทุกวัน 0.3% และแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของแต่ละโปรโมชั่น • ระบบฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน HENGDEE89 พร้อมช่วยตรวจสอบรายการทุกวัน",
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#a97a08]/45 bg-gradient-to-b from-[#2a0b0b] via-[#0d0303] to-[#2a0b0b] p-1 shadow-[0_5px_20px_rgba(253,211,45,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#d31411]/25 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#ffe98a]/15 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#ffe98a]/40 bg-gradient-to-b from-[#ffe98a] via-[#fdd32d] to-[#a97a08] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#8e0c0a] shadow-[0_0_6px_rgba(142,12,10,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#1c0707] uppercase md:text-sm"><span aria-hidden="true">🧧</span> HENGDEE89</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#ffe98a]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#f5322e]">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f5322e]">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#d31411]/80 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
