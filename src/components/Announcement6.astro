---
import { BRAND_NAME } from "../lib/brandProfile";

// ถอนชัวร์168 (รอบชมพูบับเบิลกัมนำ-ทองเนยรอง บนดำสนิท 2026-10-18): ticker ที่
// ใช้งานจริงรอบนี้ หมุนมาจาก Announcement3 ของ มีโชค168 ของเดิมที่ค้างอยู่ในไฟล์นี้
// เป็นพาเลตต์ทองเป็ด-ส้มปากเป็ดของ DUCK1688 ซึ่งถูกเปลี่ยนออกครบแล้ว — 1f1709
// 8a5f08 f3bb34 fde464 c8901a a3510c f58b2a 1a1203 ไม่เหลือในไฟล์นี้
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์)
//
// ⚠️ ไฟล์นี้เคยเป็นทอง-ส้ม และรอบนี้ก็ยังมีทองอยู่ในพาเลตต์ — การเจอ "ทอง" จึงไม่
// พิสูจน์อะไร ทองรอบนี้คือ **#ffd84d** เท่านั้น ไม่ใช่ f3bb34 (DUCK1688) fde464
// (DUCK1688) fcd434 (มีโชค168 รอบที่แล้ว) f7c92b (ขวัญใจ168) หรือ fad354
// (789BETTING) และชมพูรอบนี้คือ **#fa63b9** ไม่ใช่ f5469f (มีโชค168) หรือ f41571
// (PUNPRO168) รายการเต็มอยู่ใน .claude/brand-spec-tonchua168.md §2
//
// ทุกหน้าเรียก <Announcement /> แบบ bare ทั้งหมด ข้อความด้านล่างจึงเป็นข้อความ
// จริงที่ขึ้นทั้งเว็บ ไม่ใช่ filler — ห้ามส่ง prop message ทับจากหน้าไหน ไม่งั้น
// ticker จะพูดคนละเรื่องกันระหว่างหน้า
//
// ข้อความทุกคำมาจาก src/assets/content.txt รอบนี้: เว็บสล็อตฐานหลักถอนง่าย ·
// รวมเมนูสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว · คืนยอดเสีย
// 0.3% เข้ายูสทุกวัน · แนะนำเพื่อนโบนัส 0.8% · สมัครง่ายๆ 3 ขั้นตอน ·
// LINE Official 24 ชม. — บรีฟรอบนี้ **ไม่ได้ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว**
// จึงไม่มีชื่อค่ายในข้อความนี้ และคำว่า "สล็อตพีจีเว็บเป็ด" ของ DUCK1688 หายไปแล้ว
//
// ชื่อแบรนด์บนป้ายซ้ายมาจาก BRAND_NAME ไม่ใช่สตริงที่พิมพ์ไว้ — ของเดิมเคยพิมพ์
// "HENGDEE89" ไว้ตรงๆ ซึ่งเป็นแบบที่ค้างข้ามแบรนด์ได้แบบเงียบๆ
//
// เป็น chrome ล้วน จึงไม่มี heading tag — ป้ายซ้ายเป็น <span>
//
// หมึก #2a0617 บนป้ายไล่เฉดชมพู #ffd9ef → #ffb3de → #fa63b9 ได้ 15.0 / 12.6 /
// 7.0:1 ผ่าน AA ทั้งเส้น ส่วนข้อความวิ่ง #ffb3de/90 บนพื้นดำ #000000 ≈ 10.9:1
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out ahead of the sentence, three times over,
  // once per marquee copy.
  message = `${BRAND_NAME} เว็บสล็อตฐานหลักถอนง่าย รวมเมนูสมัครสมาชิก ฝากถอน และตรวจสอบโปรโมชั่นไว้ในเว็บไซต์เดียว • คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไขของแต่ละรายการ • สมัครสมาชิกง่ายๆ 3 ขั้นตอน • ติดต่อเจ้าหน้าที่ ${BRAND_NAME} ทาง LINE Official ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#fa63b9]/45 bg-gradient-to-b from-[#1a0914] via-[#000000] to-[#1a0914] p-1 shadow-[0_5px_20px_rgba(250,99,185,0.2),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#fa63b9]/25 blur-[30px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#ffd84d]/20 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#ffd9ef]/40 bg-gradient-to-b from-[#ffd9ef] via-[#ffb3de] to-[#fa63b9] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#6d0b3f] shadow-[0_0_6px_rgba(109,11,63,0.9)]"></span>
      <span class="text-xs font-black tracking-wider text-[#2a0617] uppercase md:text-sm"><span aria-hidden="true">💸</span> {BRAND_NAME}</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#ffb3de]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#ffd84d]">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#ffd84d]">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#ffd84d]/80 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
