---
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out as "crown" ahead of the sentence, three
  // times over, once per marquee copy.
  message = "UFA24K คาสิโนมือถือ ฝากถอนออโต้ปลอดภัย • รองรับคาสิโนสด บาคาร่า และสล็อตในบัญชีเดียว • เข้าใช้งานได้ทั้ง Android และ iOS • ทีมงานดูแลและให้คำแนะนำตลอด 24 ชั่วโมง • ตรวจสอบสถานะฝากถอนได้ด้วยตนเอง",
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#9a6d25]/40 bg-gradient-to-b from-[#1c140a] via-[#0a0603] to-[#1c140a] p-1 shadow-[0_5px_20px_rgba(235,188,76,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#9a6d25]/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#fcf3ab]/15 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#fcf3ab]/40 bg-gradient-to-b from-[#fcf3ab] via-[#ebbc4c] to-[#9a6d25] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#241705] shadow-[0_0_6px_rgba(36,23,5,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#241705] uppercase md:text-sm"><span aria-hidden="true">👑</span> UFA24K</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#fcf3ab]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#f0e6c8]/80">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f0e6c8]/80">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#9a6d25]/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
