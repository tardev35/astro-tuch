---
import { BRAND_NAME } from "../lib/brandProfile";

// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10): ticker ที่ใช้งานจริงรอบนี้
// (รอบก่อน NAZA168 ใช้ AnnouncementPremium) ของเดิมที่ค้างอยู่เป็นพาเลตต์
// ทอง-แดงซองอั่งเปาของ HENGDEE89 ซึ่งถูกเปลี่ยนออกครบแล้ว — #2a0b0b #0d0303
// #d31411 #f5322e #8e0c0a #1c0707 #a97a08 #fdd32d #ffe98a ไม่เหลือในไฟล์นี้
//
// ทุกหน้าเรียก <Announcement /> แบบ bare ทั้งหมด ข้อความด้านล่างจึงเป็นข้อความ
// จริงที่ขึ้นทั้งเว็บ ไม่ใช่ filler — ห้ามส่ง prop message ทับจากหน้าไหน ไม่งั้น
// ticker จะพูดคนละเรื่องกันระหว่างหน้า
//
// ชื่อแบรนด์บนป้ายซ้ายมาจาก BRAND_NAME ไม่ใช่สตริงที่พิมพ์ไว้ — ของเดิมพิมพ์
// "HENGDEE89" ไว้ตรงๆ ซึ่งเป็นแบบที่ค้างข้ามแบรนด์ได้แบบเงียบๆ
//
// เป็น chrome ล้วน จึงไม่มี heading tag — ป้ายซ้ายเป็น <span>
//
// หมึก #1a1203 บนป้ายไล่เฉดทอง #fde464 → #f3bb34 → #c8901a ได้ 14.4 / 10.4 /
// 6.4:1 ผ่าน AA ทั้งเส้น ส่วนข้อความวิ่ง #fde464/90 บนพื้นดำ #000000 ≈ 15:1
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out as "duck" ahead of the sentence, three
  // times over, once per marquee copy.
  message = `${BRAND_NAME} สล็อตพีจีเว็บเป็ด รวมเกมเดิมพันจากค่ายหลักไว้ในแพลตฟอร์มเดียว เล่นง่ายผ่านมือถือ • คืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนรับโบนัสแชร์ลิงก์ 0.8% ตามเงื่อนไขของแต่ละโปรโมชั่น • สมัครสมาชิกง่ายๆ 3 ขั้นตอน • แอดมิน ${BRAND_NAME} เปิดให้บริการตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="mx-auto -mb-6 max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#8a5f08]/55 bg-gradient-to-b from-[#1f1709] via-[#000000] to-[#1f1709] p-1 shadow-[0_5px_20px_rgba(243,187,52,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#f3bb34]/25 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#f58b2a]/20 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#fde464]/40 bg-gradient-to-b from-[#fde464] via-[#f3bb34] to-[#c8901a] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a3510c] shadow-[0_0_6px_rgba(163,81,12,0.9)]"></span>
      <span class="text-xs font-black tracking-wider text-[#1a1203] uppercase md:text-sm"><span aria-hidden="true">🦆</span> {BRAND_NAME}</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#fde464]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#f58b2a]">✨</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f58b2a]">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#f58b2a]/80 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
