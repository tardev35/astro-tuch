---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก — แก้
// ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย (section max-w-7xl/1280 + px-4(32) · card
// border 1×2=2 · p-8(64) · grid gap-8(32) · คอลัมน์รูปมี md:border-l(1) +
// md:pl-8(32) = 33 อยู่ในกล่องของมันเอง):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 345 − 33 = 312px
//   md..1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   698..767  : คอลัมน์เดียวที่ p-8 กว้างเกิน 600 จึงติดเพดาน max-w-[600px] = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (p-8 / gap-8 / md:pl-8) ไม่ใช่ของ
// ContentBoxSevenThreeNeumorphism ที่เป็น md:p-10 / gap-10 / md:pl-10 แล้วออกมา
// 297px / calc(30vw − 87px) — ห้ามลอกตัวเลขข้ามไฟล์
//
// นินจา168 (รอบ **ฟ้าไซยานนำ · เหลืองมะนาวเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม brand-spec §2–§5
// กล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ
// **slide2.png** ซึ่งพิมพ์คำว่า คืนยอดเสีย กับเลข 0.3% ไว้บนแผ่นป้ายในตัวภาพเอง
// ⚠️ **ตัวเลขบนงานอาร์ตเป็นตัวตัดสินการจับคู่**: slide2 = คืนยอดเสีย 0.3% (ใบนี้) ·
// slide1 = แนะนำเพื่อน 0.8% (§5) ส่วน banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์ก
// ของแบรนด์ก่อน — ห้าม import ที่ไหนเลย (eager import = emit แม้ไม่ render)
// นี่คือหนึ่งในสองบล็อก SevenThree ของรอบนี้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0c2a3d ยก / #071a28 กลาง /
// #030e16 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัดใบที่สองของหน้า** (clip-path 30px ที่มุม
// ขวาบนกับซ้ายล่าง ต่างจาก §1 ที่ตัด 40px ที่มุมซ้ายบนกับขวาล่าง) นั่งอยู่ที่
// **ผิวกลาง #071a28** ซึ่งตื้นกว่าผิวจมของ SevenThreeNeumorphism (§5) ที่ตามมาทันที
// §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่างพร้อมกัน: **รูปทรง**
// (มุมตัดเฉียง vs มุมกลมนูน) **ความลึกของผิว** (กลาง vs จม) **การตกแต่งขอบ**
// (เส้นรูดสี่มุม vs เงานูนคู่) และ **การจัดหัวข้อ** (ฟ้าไซยานทึบสีเดียว vs ไล่เฉด
// สามสีพร้อมแถบตั้ง)
// หัวข้อเป็น **ฟ้าแบรนด์ #32bcfb ทึบสีเดียว** (7.1:1 บนผิวกลาง และเป็น text-xl
// font-black จึงเป็น large text) — ใบนี้คือใบเดียวของหน้าที่ยกฮิวนำขึ้นมาเป็นสี
// หัวข้อเต็มๆ ตรงกับ §2 ที่ย้ำว่าฟ้าต้องนำจริง ไม่ใช่แค่อยู่ในสเปก
// เส้นรูดสี่มุมจับคู่ไขว้กัน: ฟ้าแบรนด์ #32bcfb คู่เหลืองมะนาว #fef54b บนแนวนอน และ
// ฟ้าน้ำแข็ง #a9e9ff คู่น้ำเงินลึก #07335f บนแนวตั้ง — วางอยู่ที่สองมุมที่ถูกตัดจริง
// เครื่องหมาย ✦ เป็นเหลืองมะนาว อ้างถึงประกายดาวทองที่กระจายอยู่รอบนินจาในงานศิลป์
// (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นเป็นทองลึก #6b5c10 ขอบการ์ดเป็นน้ำเงินลึก (อิ่มเป็นฟ้าตอน hover)
// เนื้อความ #dceefc (= BRAND_TEXT, 13:1 บนผิวกลาง)
// §2 ห้าม #07335f (1.4:1) และ #6b5c10 (1.9:1) ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// เส้นรูดมุม ขอบ และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้นคือฟ้าและทอง**
// ฟ้ารอบนี้ **#32bcfb** (R=50 G=188 B=251) ไซยานสว่างกว่า 2f9ff5 ของสบายเบท168
// ไม่ใช่ 0a84e0 (HI59) 0360f3 / 0292fb / 6ec8ff (TSDET911) 0193fb / 7bcffb
// (แตกดี168) 04225b หรือ 2563eb · ฮิวที่สองรอบนี้ **#fef54b เหลืองมะนาว** ไม่ใช่
// ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 e5a81b e2b33f f2c230 fad354 f5c518
// fce343 f3bb34 หรือ fbe455
// ชุดเต็มของสบายเบท168 (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726
// 040d16 04121f) และชุดของถอนชัวร์168 ที่เพิ่งอยู่ในไฟล์นี้ (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ออกครบทุกจุดแล้ว เช่นเดียวกับ
// ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c
// 160a12 0b0509) ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce
// 140c06 241509 160d06 0b0603) และรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203
// 4a0202 9a6c0c cfd9e6 f5ece0)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ม่วง/ไวโอเลต เขียว ส้ม แดง โรสโกลด์ และเงิน/โครเมียม**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#07335f] bg-[#071a28]/96 p-8 text-[#dceefc] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md transition-all duration-300 hover:border-[#32bcfb]/75 hover:shadow-[0_15px_40px_rgba(50,188,251,0.28)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#32bcfb] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fef54b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#a9e9ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#07335f] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dceefc]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6b5c10] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#fef54b]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#32bcfb] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dceefc] md:border-l md:border-[#6b5c10] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#6b5c10] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#fef54b]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#32bcfb] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
