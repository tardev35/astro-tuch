---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeNeumorphism, which runs text-then-image.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): กรอบมุมตัดกับเส้นไรผมเป็น
// #2e1d08 บนผิวการ์ดดำอมน้ำตาล #130b03 หัวข้อเป็นทองแบรนด์ทึบ #ebbb54 ต่างจากหัวข้อ
// เงินโครเมียมของ SevenThreeNeumorphism ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน ทั้งสองบล็อก
// จึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองโลหะของโลโก้
// ไขว้กัน — ทองแบรนด์คู่ทองสว่าง #fce675 บนแนวหนึ่ง เงินโครเมียม #d5d4d3 คู่ทองลึก
// #ab6d24 บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นเงิน เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#2a2115 #121010 #edbb23 #ffeeb4
// #c8cbce #a87708 #f0e6d2) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2e1d08] bg-[#130b03]/92 p-8 text-[#f8eed9] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#ebbb54]/70 hover:shadow-[0_15px_40px_rgba(235,187,84,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ebbb54] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fce675] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d5d4d3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ab6d24] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#2e1d08] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#d5d4d3]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ebbb54] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9] md:border-l md:border-[#2e1d08] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#2e1d08] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#d5d4d3]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ebbb54] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
