---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก — แก้
// ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย (section max-w-7xl/1280 + px-4(32) · card
// border 1×2=2 · p-8(64) · grid gap-8(32) · คอลัมน์รูปมี md:border-l(1) +
// md:pl-8(32) = 33 อยู่ในกล่องของมันเอง):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 345 − 33 = 312px
//   md..1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   698..767  : คอลัมน์เดียวที่ p-8 กว้างเกิน 600 จึงติดเพดาน max-w-[600px] = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (p-8 / gap-8 / md:pl-8) ไม่ใช่ของ
// ContentBoxSevenThreeNeumorphism ที่เป็น md:p-10 / gap-10 / md:pl-10 แล้วออกมา
// 297px / calc(30vw − 87px) — **ห้ามลอกตัวเลขข้ามไฟล์** และสองใบนั้นคือคู่บล็อกรูป
// ของรอบนี้ (brand-spec §3) จึงอยู่บนหน้าเดียวกันห่างกันบล็อกเดียว
// ⚠️ สไลด์ดรอปนี้เป็น **จัตุรัส 600x600** (รอบก่อนเป็นแถบนอน 600x200) เพดาน 600
// จึงยังเป็น candidate สูงสุด แต่ 1x ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป
// จึงตกลงมาที่ 600 — ไม่มี candidate ไหนสูงกว่า 600 ได้
//
// ufalion168 (รอบ **ทองสองเฉด + บรอนซ์ บนดำสนิท — ไม่มีสีที่สองที่เป็นคนละวงศ์**
// 2026-10-20) — พาเลตต์ตาม brand-spec §2–§5
// กล่องนี้ถือ **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ
// **slide1.png** ซึ่งพิมพ์คำว่า แนะนำเพื่อน กับเลข 0.8% ไว้บนแผ่นป้ายในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่**: slide1 = แนะนำเพื่อน 0.8%
// (ใบนี้) · slide2 = คืนยอดเสีย 0.3% (§4) ส่วน banner2/banner3/slide3/slide4 เป็น
// อาร์ตเวิร์กของแบรนด์ก่อน — ห้าม import ที่ไหนเลย (eager import = emit แม้ไม่ render)
// นี่คือบล็อก SevenThree ใบที่สองและใบสุดท้ายของรอบนี้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #33200a ยก / #1f1304 กลาง /
// #0a0601 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัดใบที่สองของหน้า** (clip-path 30px ที่มุม
// ขวาบนกับซ้ายล่าง ต่างจาก §2 ที่ตัด 40px ที่มุมซ้ายบนกับขวาล่าง) นั่งอยู่ที่
// **ผิวกลาง #1f1304** ซึ่งตื้นกว่าผิวจมของ SevenThreeNeumorphism (§4) ที่อยู่เหนือมัน
// ทันที §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่างพร้อมกัน:
// **รูปทรง** (มุมกลมนูน vs มุมตัดเฉียง) **ความลึกของผิว** (จม vs กลาง)
// **การตกแต่งขอบ** (เงานูนคู่ vs เส้นรูดสี่มุม) และ **การจัดหัวข้อ** (ไล่เฉดสามสี
// พร้อมแถบตั้ง vs ทองนำทึบสีเดียว)
// หัวข้อเป็น **ทองนำ #d4922c ทึบสีเดียว** (6.89:1 บนผิวกลาง และเป็น text-xl
// font-black จึงเป็น large text) — ใบนี้คือใบเดียวของหน้าที่ยกฮิวนำขึ้นมาเป็นสี
// หัวข้อเต็มๆ ตรงกับ §2 ที่ย้ำว่าทองนำต้องนำจริง ไม่ใช่แค่อยู่ในสเปก
// เส้นรูดสี่มุมจับคู่ไขว้กัน: ทองนำ #d4922c คู่ทองสว่าง #fdfc71 บนแนวนอน และ
// ครีมทอง #f6e3b4 คู่บรอนซ์ไหม้ #5a3310 บนแนวตั้ง — วางอยู่ที่สองมุมที่ถูกตัดจริง
// เครื่องหมาย ✦ เป็นทองสว่าง อ้างถึงประกายดาวทองที่กระจายอยู่รอบโลโก้ในงานศิลป์
// (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นเป็นบรอนซ์ไหม้ #5a3310 ขอบการ์ดเป็นบรอนซ์ไหม้ (อิ่มเป็นทองนำตอน hover)
// เนื้อความ #fbf6e3 (= BRAND_TEXT, 17.5:1 บนผิวกลาง)
// §2 ห้าม #a25b24 (3.0:1 บนผิวการ์ด) และ #5a3310 ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// เส้นรูดมุม ขอบ และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง เพราะทองเคยนำมาแล้ว
// เกือบทุกแบรนด์** ทองนำรอบนี้ **#d4922c** (R=212 G=146 B=44) **ห่างจาก dfa310 ของ
// TND168 (R=223 G=163 B=16) แค่สองช่อง** ไม่ใช่ f0bb4e (รวยเทพ168 รอบขาออก) fcd45c
// (มีเฮ168) f9a826 (รวยแทร่168) ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434
// (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) e5a81b
// (UFA324) e2b33f f2c230 fad354 f5c518 fce343 f3bb34 fbe455 หรือ f2b705
// · ทองสว่างรอบนี้ **#fdfc71** ⚠️ ใกล้ fef54b ของนินจา168 (B113 vs B75 · G252 vs
// G245) · บรอนซ์รอบนี้ **#a25b24** ไม่มีแบรนด์ไหนในรีโปนี้เคยใช้ และไม่ใช่ทองแดง
// d9701a ของรอบขาออก
// ชุดเต็มของรวยเทพ168 ที่เพิ่งอยู่ในไฟล์นี้ (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดของมีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c
// 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308) ชุดของรวยแทร่168 (039cfa 0494f5 c3ebfc
// 04366b 704504 e3f2fc 0b2d52 071e38 030f1d 031320) ชุดของนินจา168 (32bcfb a9e9ff
// 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดของสบายเบท168 (2f9ff5 a8dcff
// d6ecff 0b3f78 5c4a16 e8f4ff 0e2238 081726 040d16 04121f) ชุดของถอนชัวร์168 (fa63b9
// ffb3de 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (f5469f
// ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f2bba5
// c98a74 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) และชุดของรับตัง168 (ffdc8c
// ff6b6e 4a0202 9a6c0c cfd9e6 f5ece0) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงเลย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มีส้มสด**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5a3310] bg-[#1f1304]/96 p-8 text-[#fbf6e3] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md transition-all duration-300 hover:border-[#d4922c]/75 hover:shadow-[0_15px_40px_rgba(212,146,44,0.28)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#d4922c] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fdfc71] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f6e3b4] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#5a3310] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbf6e3]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#5a3310] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#fdfc71]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#d4922c] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbf6e3] md:border-l md:border-[#5a3310] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#5a3310] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#fdfc71]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#d4922c] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
