---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// PAOTUNG palette: navy card surface (#04203c) inside a clipped primary-blue
// frame, with the corner rules split gold metallic (#f5e3b3 / #a5813a) on one
// diagonal and brand blue (#3b9ddd / #054e83) on the other — the navy + gold
// pairing the brief names. The heading and the `>_` marker take gold. The
// previous brand's crimson diagonal is gone; this brand has no red.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#226ca9]/80 bg-[#04203c]/92 p-8 text-[#cfdeed] shadow-[0_10px_30px_rgba(34,108,169,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#3b9ddd]/70 hover:shadow-[0_15px_40px_rgba(59,157,221,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f5e3b3] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a5813a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#3b9ddd] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#054e83] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#226ca9]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e0bd72]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f5e3b3] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed] md:border-l md:border-[#226ca9]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#226ca9]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e0bd72]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f5e3b3] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
