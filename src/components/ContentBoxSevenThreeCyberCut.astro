---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#4a2409]/80 bg-[#0b0503]/92 p-8 text-[#ded4cb] shadow-[0_10px_30px_rgba(242,106,2,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#f26a02]/60 hover:shadow-[0_15px_40px_rgba(242,106,2,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ffb266] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f26a02] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e3e7ec] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8c3a01] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#4a2409]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f26a02]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#ffc48a] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb] md:border-l md:border-[#4a2409]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#4a2409]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f26a02]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#ffc48a] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
