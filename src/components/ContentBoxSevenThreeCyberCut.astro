---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-28** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64
// **ไม่มี md:p-10** · grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32)
// = 33 อยู่ในกล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   >=1280px  : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768..1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                           = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** ไม่ใช่ของ **ContentBoxSevenThree ตัวฐาน** ที่ถือ
// §4 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8/**md:p-10** · gap-10 · md:pl-6 แล้วออกมา
// **314px / calc(30vw - 70px)** — ต่างกันทั้งที่ 1x และใน calc()
// **ห้ามลอกตัวเลขข้ามไฟล์** และห้ามลอกจากรอบก่อน สองใบนี้คือคู่บล็อกรูปของรอบนี้
// (brand-spec §4 ข้อ 4–5) และอยู่ติดกันบนหน้าแรก
// ⚠️⚠️ **สไลด์ดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดคือ **375** และ 1x
// ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 375 — **ห้ามมี candidate
// สูงกว่านั้น** และ **alt ห้ามระบุทิศทางของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
// เพราะดรอปถัดไปอาจเปลี่ยนอัตราส่วนอีก
//
// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28, .claude/brand-spec-123bet.md §1–§6):
// กล่องนี้ถือ **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด" —
// content.txt บรรทัด 11, ย่อหน้าเต็มอยู่บรรทัด 12) คู่กับ **slide1.png** ซึ่ง
// พิมพ์แคปซูลพื้นดำขอบทองคำว่า **แนะนำเพื่อน** กับเลข **0.8%** ไว้บนตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide2 = คืนยอดเสีย 0.3% (§4 · หญิงสาวนั่ง มีกองชิปแดง-ขาวที่มุมล่างขวา) ·
// slide1 = แนะนำเพื่อน 0.8% (ใบนี้ · หญิงสาวยืนกับผ้าคลุมกำมะหยี่แดงพาดยาวลงพื้น
// ซึ่ง slide2 ไม่มี) uploader เขียนทับสองไฟล์นี้ทุกดรอป — เลขในชื่อไฟล์จึงไม่มี
// ความหมายข้ามแบรนด์ **ต้องเปิดรูปอ่านใหม่ทุกครั้ง** (รอบนี้การจับคู่สลับทิศจากรอบก่อน)
// ⛔ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import
// ที่ไหนเลย** เพราะ eager import = emit ขึ้น dist แม้ไม่มีหน้าไหน render
// นี่คือบล็อก SevenThree ใบที่สองของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **มุมตัดคงไว้ แต่ภาษาไซเบอร์ถอดออกหมด** — มุมเฉียงอ่านเป็น **ตั๋ว/ดวงตรา
// ประทับ** ซึ่งเข้ากับหัวข้อโปรโมชั่น ส่วนมอนอสเปซ `SYSTEM_` สแลชสามตัว และเส้น
// สแกนนีออน **ไม่มีในไฟล์นี้แล้วสักจุด** กลีฟที่นำหน้าหัวข้อรอบนี้คือ **มงกุฎ 👑**
// ซึ่งเป็นหนึ่งในภาษาภาพของดรอปนี้จริง (มงกุฎทองประดับอัญมณีแดงที่นางแบบสวม
// มงกุฎเงินบนโลโก้ และมงกุฎทองดวงเล็กเหนือคำว่า โปรโมชั่น บนสไลด์ทั้งสองใบ)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเม็กซิกัน-พีช/ฟางอุ่นของ MEXICANOSLOT** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมสว่าง แต่คนละค่าทุกตัว** — bg.json =
// {"mode":"color","color":"#f7e4e9"} = ชมพูบลัชจาง
// 🚨🚨 **ไฟล์นี้คือจุดที่พลาดง่ายที่สุดของรอบ เพราะชุดเก่าที่ค้างอยู่ก็เป็นแดง/ทอง
// เหมือนรอบนี้** — ต้องเทียบ **ตรงหกหลัก** ทุกค่า ห้ามตัดสินด้วยตระกูลสี
// ลำดับผิว: #fdf5f6 การ์ด / **#f7dfe4 ยก (ใบนี้)** / #eec3cc เส้นบาง / #f7e4e9 พื้นเพจ ·
// หมึก **#36080f** (= BRAND_TEXT, ~15.5:1 บนผิวยก)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวยก #f7dfe4 ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่าง
// พร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม 28px) · **ความลึกของผิว**
// (ผิวยกทึบ vs ผิวการ์ดทึบ) · **การตกแต่งขอบ** (เส้นรูดสี่มุม vs เส้นไรผมขอบล่าง +
// ออราเบลอมุมเดียว) · **การจัดหัวข้อ** (ชิปถมแดงคู่กลีฟมงกุฎในสายปกติ vs หัวข้อทึบ
// + เส้นคาดเต็มคอลัมน์)
// ⚠️ และใบนี้แยกจาก **§1 ContentBoxCyberCut** (มุมตัด 40px บนไล่การ์ด→ยก เส้นรูด
// ไขว้ แนวนอนแดง-แนวตั้งทอง/แดงสด พร้อมสันซ้ายสี่พิกเซล) — ที่นี่เส้นรูดสี่มุมเป็น
// **แดงชาด/ทองอำพัน/ขอบชมพู** #a30d1a / #dca53a / #d98fa0 / #c21325
// หัวข้อเป็น **แดงชาด #a30d1a ทึบสีเดียว** (~7.0:1 บนผิวยก) ไม่ใช่ bg-clip-text
// ⚠️ กลีฟ 👑 จึง **ไม่ได้ถูกทาเป็นสีลอย ๆ** แต่ถูกวางบน **ชิปถมแดงเลือดหมู
// #8a1420 พร้อมหมึกขาว** (9.5:1) ตาม §2 ซึ่งเป็นสต็อปเข้มสุดของสูตรปุ่มหลัก
// — และตรงกับแคปซูลพื้นเข้มบนอาร์ตเวิร์กอยู่แล้ว กลีฟนับเป็น **ตัวอักษร**
// ไม่ใช่เส้น จึงต้องมีพื้นถมรองรับเสมอ (เป็น span aria-hidden และเป็น **พี่น้อง**
// ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// 🚨 **ห้ามใช้พื้นชิปสว่างกว่า #c21325** — ขาวบนนั้นเหลือ 6.2:1 และสว่างกว่านั้น
// ตกต่ำกว่า 4.5:1 ทันที
// เส้นคั่นและขอบการ์ดเป็น #eec3cc อิ่มเป็นแดงชาดตอน hover
// ⚠️ **#eec3cc / #d98fa0 / #dca53a / #ef4a5e ห้ามถือตัวอักษรบนผิวสว่าง** —
// ในไฟล์นี้อยู่ที่ขอบ เส้นรูด และพื้นถมล้วน · **#a30d1a ใช้ทั้งหัวข้อที่นี่และ
// <strong> ในย่อหน้า** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์แดงจริง และรีโปนี้
// มีแดงของแบรนด์อื่นอยู่สิบชุดขึ้นไป** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้คือ **#a30d1a (R163 G13 B26) / #8a1420 / #c21325 / #36080f / #330710 /
// #1c050b / #6b2b33** เท่านั้น และทองคือ **#dca53a / #7a4a0c** ค่าที่ต้องไม่เหลือ
// ในไฟล์นี้:
//   de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a 2b100a 431a10 1d0a06
//   8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3 fff3ea fef6fb 117a41
//   2bb061 f2543f (**MEXICANOSLOT — ชุดที่เพิ่งอยู่ทั้งใบนี้** ⚠️⚠️ **a81410 ↔
//   #a30d1a ต่างแค่ไม่กี่หลัก · c81e12 ↔ #c21325 · 80453a ↔ #6b2b33 · fef6fb ↔
//   #fdf5f6 — เจอค่าซ้ายให้ถือว่าพิมพ์ผิดก่อนเสมอ**) ·
//   002908 010d04 031b09 073c1a 0e5424 1e7033 35a043 3ddc4a dfe6e3 e8c86a eef7f0
//   9dc2a5 (**ZORO365 — แบรนด์ขาออกทันที**) ·
//   fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310
//   d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//   (**LOTTO189 — ตระกูลสีเดียวกับรอบนี้เป๊ะ เสี่ยงที่สุด** ⚠️⚠️ **c1071b / b00718
//   ↔ #a30d1a · 7e1221 / 8a0412 ↔ #8a1420 · 3d0d16 / 24060c ↔ #36080f · 6e3b44 ↔
//   #6b2b33 · e9b53c ↔ #dca53a · ffe4e6 / ffd4d7 ↔ #f7e4e9 / #f7dfe4**) ·
//   f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24
//   8a6a0e 28c437 e3bb45 c6cfd2 (TEVA69) ·
//   fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607 2a0c0d 551c1e f0e6e4 c9b9b7 e3d6d4
//   (สล็อต168) · ff2e52 e01238 c9102f (มาดาม168) · c30303 8f0505 e81313 dcb95f
//   (รวยแท้168) · d9212a 8e1a16 f0c878 (ดวงเศรษฐี168) · fb141b ff5f63 (GT66B) ·
//   eb0305 e40303 c20305 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 (หมูบิน168) · ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 f4a7cf
//   6a0f3c 95486b 9c0f55 fb439b d91a73 b01160 85094a (okkub88) ·
//   00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb
//   355f7d 0f5684 1a6ea8 (โบ๊ะบ๊ะ168) · 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0
//   (นาซ่า168) · 18a5e2 0d6b9b a9d7f2 (ร่ำรวย168) · 7a1bd6 2b3fd9 c2178b f23bb4
//   bb6dff 5411c4 241046 f8e6f9 f6edfe ece0fb dcc6f4 (ZANE96)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (ทองรอบนี้คือ **#dca53a** กับทองเข้ม **#7a4a0c**):
//   ffd84d f5ba14 fcee52 b37c0b ffd94a e3a712 9d6f06 eeae12 fded41 9f600d fcd434
//   fdcb0c fefb6b fee45d e6a416 fef54b f7c92b d4922c fdfc71 e5a81b ffe08a f9a826
//   ffdc8c f0b429 ffc82e e0bd72 f6e4b4 d4af5a e0b03a b07d08 f2c230 ffe066 a87a08
//   2a1206 7a3a0c fff3e0 e0b784 c98a24 c23400 d13800 fa4903 e8a000 ff8a2b 6a4a30
//   ⚠️⚠️ **e0b03a / e3bb45 / e9b53c / e3a712 / d4922c ↔ #dca53a · 7a3a0c / 9f600d /
//   6a4a30 / b07d08 ↔ #7a4a0c**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/แมเจนต้า ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม และไม่มีแรมป์เทาเงิน** — วัสดุที่สองรอบนี้คือ **เงินโครเมียม #d2d7dd
// (โครมเข้มเท่านั้น ไม่อยู่ในไฟล์นี้) กับทองอำพัน #dca53a** และมงกุฎทอง
// ชิปคาสิโนแดง-ขาว กับไพ่เอซโพดำบนสไลด์เป็น **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#eec3cc] bg-[#f7dfe4] p-8 text-[#36080f] shadow-[0_10px_30px_rgba(163,13,26,0.12)] transition-all duration-300 hover:border-[#a30d1a] hover:shadow-[0_15px_40px_rgba(163,13,26,0.22)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#a30d1a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#d98fa0] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#dca53a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c21325] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#36080f]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#eec3cc] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#8a1420] text-xs leading-none text-white">
                👑
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#a30d1a]">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#36080f] md:border-l md:border-[#eec3cc] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#eec3cc] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#8a1420] text-xs leading-none text-white">
                👑
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#a30d1a]">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
