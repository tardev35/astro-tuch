---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeNeumorphism, which runs text-then-image.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card p-8, grid gap-8, and NO inner padding
// on the image column — the border/padding pair is on the text column):
//   >= 1280px : (1280 - 32 - 64 - 32) x 0.3 = 345.6 -> 346px
//   md..1279  : (100vw - 128) x 0.3          = calc(30vw - 38px)
//   < md      : one column at p-8            = calc(100vw - 96px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): การ์ดมุมตัดใบที่ลึกที่สุดในสาม
// ใบของหน้านี้ — ผิวพื้นดำอมแดง #0a0303 ในเส้นไรผมแดงลึก #7a0505 เทียบกับ
// ContentBoxCyberCut ที่เป็น #170707 และ ContentBoxTwoCyberCut ที่เป็น #230d0d
// สามใบจึงไล่ระดับความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ หัวข้อเป็นทองแบรนด์ทึบ
// #f5c33b ต่างจากหัวข้อแดงสว่างทึบของ SevenThreeNeumorphism ที่อยู่เหนือขึ้นไปบน
// หน้าเดียวกัน ทั้งสองบล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่แดง-ทองไขว้กัน — แดงแบรนด์ #d20a0a คู่แดงสว่าง #ff3b3b บนแนว
// หนึ่ง ทองสว่าง #ffd45e คู่ทองลึก #a9761a บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นแดงสว่าง
// เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#2e1d08 #130b03 #ebbb54
// #fce675 #ab6d24 #d5d4d3 #f8eed9) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#7a0505] bg-[#0a0303]/92 p-8 text-[#f7e2d6] shadow-[0_10px_30px_rgba(5,1,1,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#f5c33b]/70 hover:shadow-[0_15px_40px_rgba(210,10,10,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d20a0a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff3b3b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffd45e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a9761a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#7a0505] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ff3b3b]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5c33b] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:border-l md:border-[#7a0505] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#7a0505] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ff3b3b]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5c33b] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
