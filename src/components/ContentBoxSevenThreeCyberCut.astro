---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-23** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64
// **ไม่มี md:p-10** · grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32)
// = 33 อยู่ในกล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   >=1280px  : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768..1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                           = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** ไม่ใช่ของ **ContentBoxSevenThreePremium** ที่ถือ
// §4 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8/**md:p-10** · gap-10 · md:pl-10 แล้วออกมา
// **297px / calc(30vw - 87px)** — ต่างกัน 15px ทั้งที่ 1x และใน calc()
// **ห้ามลอกตัวเลขข้ามไฟล์** และห้ามลอกจากรอบก่อน สองใบนี้คือคู่บล็อกรูปของรอบนี้
// (brand-spec §3–§4) และอยู่ติดกันบนหน้าแรก
// ⚠️⚠️ **สไลด์ดรอปนี้วัดจาก IHDR ของ PNG จริงได้ 375x600 ทั้งสองใบ** เพดานกว้างสุด
// คือ **375** และ 1x ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 375 —
// **ห้ามมี candidate สูงกว่านั้น** และ **alt ห้ามระบุทิศทางของภาพ** ให้บรรยาย
// สิ่งที่วาดอยู่แทน เพราะดรอปถัดไปอาจเปลี่ยนอัตราส่วนอีก
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23, .claude/brand-spec-slot168.md §1–§5): กล่องนี้ถือ
// **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด" — content.txt
// บรรทัด 11, ย่อหน้าเต็มอยู่บรรทัด 12) คู่กับ **slide2.png** ซึ่งพิมพ์คำว่า
// **แนะนำเพื่อน** กับเลข **0.8%** ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = คืนยอดเสีย 0.3% (§4 · โลโก้มุมบนซ้าย ถือโทรศัพท์โชว์ตารางเกมสล็อต) ·
// slide2 = แนะนำเพื่อน 0.8% (ใบนี้ · โลโก้มุมบนขวา ยกโทรศัพท์โชว์โลโก้บนจอ)
// **รอบก่อนจับคู่กลับทางกับรอบนี้** เพราะ uploader เขียนทับสองไฟล์นี้ทุกดรอป —
// เลขในชื่อไฟล์จึงไม่มีความหมายข้ามแบรนด์
// ⛔ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน **ห้าม import
// ที่ไหนเลย** เพราะ eager import = emit ขึ้น dist แม้ไม่มีหน้าไหน render
// นี่คือบล็อก SevenThree ใบที่สองของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวสิ้นเชิง** — bg.json = {"mode":"color",
// "color":"#140000"} ดำอมแดงเข้มมาก ⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-
// อะซัวร์บนน้ำเงินเที่ยงคืนของ มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์
// **ห้ามเหลือฟ้า/อะซัวร์/น้ำเงินไว้เลยสักค่า และห้ามแก้กลับไปเป็นการ์ดสว่าง**
// ลำดับผิว: #2a0c0d ยก / #1c0607 การ์ด / **#0b0000 จม (ใบนี้)** / #140000 พื้นเพจ ·
// หมึก **#f0e6e4** (= BRAND_TEXT, 16.9:1 บนผิวจม)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวจม #0b0000 ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่าง
// พร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม rounded-3xl) · **ความลึกของผิว**
// (จมทึบ vs ไล่การ์ด→จม) · **การตกแต่งขอบ** (เส้นรูดสี่มุม vs ออราเบลอสองมุม) ·
// **การจัดหัวข้อ** (ชิปถมแดงคู่กลีฟในสายปกติ vs หัวข้อทึบ + ขีดสั้นใต้หัวข้อ)
// ⚠️ และใบนี้แยกจาก **§3 ContentBox3ThreeCyberCut** (มุมตัด 30px ขวาบน-ซ้ายล่าง
// เส้นรูดไขว้แดง/มุก) และ **§7 ContentBoxCyberCut** (มุมตัด 40px เส้นรูดไขว้
// แนวนอนแดง-แนวตั้งมุก) — ที่นี่เส้นรูดสี่มุมเป็น **แดงล้วนสามเฉด**
// #fb2e33 / #cb0b0d / #8a0608
// หัวข้อเป็น **แดงเจล #fb2e33 ทึบสีเดียว** (5.5:1 บนผิวจม) ไม่ใช่ bg-clip-text
// ⚠️ กลีฟ ◆ จึง **ไม่ได้ถูกทาเป็นสีลอย ๆ** แต่ถูกวางบน **ชิปถมแดงเจล #fb2e33
// พร้อมหมึกดำ #0a0a0a** (5.2:1) ตาม §2 ซึ่งระบุตรง ๆ ว่า **พื้นแดงสว่างต้องใช้
// หมึกดำ ห้ามขาว (3.8:1)** — และตรงกับแคปซูลขาว-ดำในอาร์ตเวิร์กอยู่แล้ว
// กลีฟนับเป็น **ตัวอักษร** ไม่ใช่เส้น จึงต้องมีพื้นถมรองรับเสมอ (เป็น span
// aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ) กลีฟสี่เหลี่ยม
// ข้าวหลามตัดอ้างถึงช่องตารางเกมสล็อตบนจอโทรศัพท์ในอาร์ตเวิร์กของดรอปนี้
// เส้นคั่นและขอบการ์ดเป็น #551c1e อิ่มเป็นแดงเจลตอน hover
// ⚠️ **#551c1e / #cb0b0d / #8a0608 / #7d6f6e ห้ามถือตัวอักษร** — ในไฟล์นี้อยู่ที่
// ขอบ เส้นรูด และพื้นถมล้วน · **#fb2e33 สงวนไว้ให้ <strong> ในย่อหน้าด้วย**
// ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์แดงจริง และรีโปนี้
// มีแดงของแบรนด์อื่นอยู่สิบกว่าชุด** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย แดงรอบนี้
// คือ **#fb2e33 (R251 G46 B51) / #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (**มาดาม168 — ชุดที่เพิ่งอยู่ทั้งใบนี้** ⚠️ ff2e52 เป็น
//   แดงเหมือนกันแต่ B82 เทียบกับ B51 ของรอบนี้ **ต้อง grep เป็นค่า**) ·
//   ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16 3d3425
//   f3ece0 bfb8aa (**รวย168 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด** ⚠️ 1c1a16 ห่างจาก
//   1c0607 ของรอบนี้แค่ G/B) ·
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722 33455f 0d1017
//   (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff f4e4d3 e4cbb3 (ร่ำรวย168) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B — ⚠️ สองค่านี้ห่างจากค่าของรอบนี้
//   หนึ่งก้าว **เจอแล้วแปลว่าพิมพ์ผิด**) · b3121b 5a0a0e f2bba5 c98a74 (ขวัญใจ168) ·
//   c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef ffeee8 (รวยแท้168) · eb0305 e40303
//   c20305 9b0a0c ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a
//   8e1a16 (ดวงเศรษฐี168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) ·
//   d30304 a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) · ff3b14 6d0804 2b0000
//   (FLASH877) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น** —
// วัสดุที่สองรอบนี้คือ **มุกอุ่น (R>G>B)** และมงกุฎทองเล็กในโลโก้เป็นรายละเอียด
// ~2% ของอาร์ตเวิร์ก **ไม่ใช่สี UI** (ทองคือฮิวนำของแบรนด์ขาออกพอดี)
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#551c1e] bg-[#0b0000] p-8 text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(251,46,51,0.22)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fb2e33] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8a0608] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#cb0b0d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#fb2e33] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#551c1e] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#fb2e33] text-xs leading-none text-[#0a0a0a]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fb2e33]">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4] md:border-l md:border-[#551c1e] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#551c1e] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#fb2e33] text-xs leading-none text-[#0a0a0a]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fb2e33]">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
