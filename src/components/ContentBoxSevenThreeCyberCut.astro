---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-21/22** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64 ·
//  grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32) = 33 อยู่ใน
//  กล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 1150 × 0.3 − 33 = 312px
//   768–1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   638–767   : ยุบเหลือคอลัมน์เดียวที่ p-8 → 100vw − 98 ซึ่งเกิน 540 จึงติดเพดาน
//               max-w-[540px] ของบิตแมป                        = 540px
//   <638      : คอลัมน์เดียวที่ p-8                             = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (max-w-7xl / p-8 / gap-8 / md:pl-8 + md:border-l)
// ไม่ใช่ของ **ContentBoxSevenThree** ตัวฐาน ซึ่งเป็น max-w-[1400px] / md:p-10 /
// gap-8 / md:pl-6 (ไม่มี border-l) แล้วออกมา 352px / calc(30vw − 68px) —
// **ห้ามลอกตัวเลขข้ามไฟล์** สองใบนี้คือคู่บล็อกรูปของรอบนี้ (brand-spec §3–§4) และ
// อยู่ติดกันบนหน้าแรก ค่า 1x ต่างกัน 40px
// ⚠️ สไลด์ดรอปนี้วัดจากบิตแมปจริงได้ **540x600 แนวตั้ง** เพดานกว้างสุดคือ **540**
// และ 1x ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 540 — ห้ามมี
// candidate สูงกว่านั้น
//
// โปรดี168 (รอบ **แดงเชอร์รี่นำ · ทองแดงไหม้รอง · ธีมสว่าง** 2026-10-22,
// .claude/brand-spec-prodeee168.md §2–§4): กล่องนี้ถือ **docx H3 §4**
// ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ **slide1.png** ซึ่งพิมพ์คำว่า
// **คืนยอดเสีย** กับเลข **0.3%** ไว้บนป้ายไม้ในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = คืนยอดเสีย 0.3% (ใบนี้) · slide2 = แนะนำเพื่อน 0.8% (§5) ส่วน
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน (mtime ก่อนดรอป
// 2026-10-21) **ห้าม import ที่ไหนเลย** เพราะ eager import = emit แม้ไม่ render
// ⚠️ รอบก่อนจับคู่กลับด้านกัน (slide2 = 0.3%) เพราะโปสเตอร์ของแบรนด์นั้นสลับกัน —
// ผู้อัปโหลดเขียนทับสองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์
// นี่คือบล็อก SevenThree ใบแรกของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️ **ธีมสว่าง** — bg.json = {"mode":"color","color":"#ffd1d1"} ชมพูพาสเทลสว่าง
// ลำดับความลึก: **#ffffff ผิวยก (ใบนี้)** / #fff4ea อินเซ็ต / #ffd1d1 พื้นเพจ
// หมึก **น้ำตาลแดง #401107** (= BRAND_TEXT, 16.1:1 บนผิวยก)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวยก #ffffff** ซึ่งเป็นภาพกระจกของ ContentBox3ThreeCyberCut (§2) ที่ตัด
// ขวาบน-ซ้ายล่าง 30px บนผิวอินเซ็ต · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูก
// แยกสี่อย่างพร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม rounded-3xl)
// **ความลึกของผิว** (ยก vs อินเซ็ต) **การตกแต่งขอบ** (เส้นรูดสี่มุม vs เส้นคาดบน
// + ออราเบลอมุมเดียว) และ **การจัดหัวข้อ** (ทองแดงไหม้ทึบคู่เครื่องหมาย ✦ vs
// ทองแดงเข้มทึบคู่แถบตั้งไล่เฉด)
// หัวข้อเป็น **ทองแดงไหม้ #b44c06 ทึบสีเดียว** (5.3:1 บนผิวยก และเป็น text-xl
// font-black จึงเป็น large text ด้วย) — §2 ระบุว่า #b44c06 คือสีที่สองที่
// **ถือตัวอักษรบนการ์ดสว่างได้จริง** ต่างจากทองโบราณของรอบก่อนที่ทำไม่ได้
// เส้นรูดสี่มุมจับคู่ไขว้กันและวางอยู่ที่ **สองมุมที่ถูกตัดจริง**: แดงเชอร์รี่
// #eb0305 คู่ทองแดงไหม้ #b44c06 บนแนวนอน และ **แดงสด #ff4446** คู่ทองแดงเข้ม
// #7a2f03 บนแนวตั้ง ⚠️ #ff4446 อยู่ได้ตรงนี้เพราะเป็น **พื้นถม** ล้วน §2 ห้ามมัน
// ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษรทุกกรณี
// เครื่องหมาย ✦ เป็น **ทองแดงเข้ม #7a2f03** (9.4:1 บนผิวยก) เพราะกลีฟนับเป็น
// **ตัวอักษร** ไม่ใช่เส้น จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร — อ้างถึงดอก
// เดซี่ขาวและประกายเหรียญทองที่กระจายรอบป้ายไม้ในงานศิลป์ (เป็น span aria-hidden
// และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นและขอบการ์ดเป็นแดงเชอร์รี่โปร่ง อิ่มเป็นทองแดงไหม้ตอน hover
// ⚠️ **ทองสาลี่ #f0b46a ไม่มีในไฟล์นี้เลย** — §2 กันไว้ให้โครมเท่านั้น (1.8:1 บน
// ผิวสว่าง) ทองที่เห็นคือพิกเซลในบิตแมปของสไลด์ · **#9b0a0c สงวนไว้ให้ <strong>
// ในย่อหน้า** จึงไม่โผล่ที่นี่
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดงกับทองเป็นฮิวที่แน่นที่สุดในรีโปนี้
// และรอบก่อน (รวยแท้168) ก็เป็นแดง+ทอง+ธีมสว่างชมพูเหมือนกัน** การเจอแดงหรือทอง
// ในไฟล์จึงไม่พิสูจน์อะไร ต้องเทียบทีละหลัก: #eb0305 (R235 G3 B5) วัดจาก logo.webp
// · #b44c06 (R180 G76 B6) วัดจาก banner1.png · ตัวที่ใกล้แดงรอบนี้ที่สุดในรีโปคือ
// dc0203 ของหวย365 (ห่าง 18) รับไว้โดยตั้งใจ
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40 α)
// rgba 12/58/22 α)) ชุดบรอนซ์-ทองอำพันของ **ufalion168** (d4922c fdfc71 a25b24
// 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000 fbf6e3) ชุดชมพูบานเย็น
// ของ **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) และชุดแดง
// คริมสัน-ทองโบราณของรอบขาออก **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b
// 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง/ไวโอเลต
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีทองโบราณอมเขียว**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#eb0305]/45 bg-[#ffffff] p-8 text-[#401107] shadow-[0_10px_30px_rgba(64,17,7,0.16)] transition-all duration-300 hover:border-[#b44c06]/75 hover:shadow-[0_15px_40px_rgba(235,3,5,0.22)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#eb0305] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b44c06] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff4446] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#7a2f03] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#401107]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#eb0305]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#7a2f03]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#b44c06] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#401107] md:border-l md:border-[#eb0305]/40 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#eb0305]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#7a2f03]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#b44c06] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
