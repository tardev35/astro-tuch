---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeNeumorphism, which runs text-then-image.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): กรอบมุมตัดกับเส้นไรผมเป็น #2a2115 บน
// ผิวการ์ดดำอมทอง #121010 หัวข้อเป็นทองแบรนด์ทึบ #edbb23 (9.9:1 บนผิวนี้) ต่างจาก
// หัวข้อเงินโครเมียมของ SevenThreeNeumorphism ที่อยู่เหนือขึ้นไปบนหน้าเดียวกัน ทั้งสอง
// บล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองโลหะของโลโก้
// ไขว้กัน — ทองแบรนด์คู่ทองอ่อน #ffeeb4 บนแนวหนึ่ง เงิน #c8cbce คู่ทองลึก #a87708 บน
// อีกแนวหนึ่ง พรอมป์ &gt;_ เป็นเงิน เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#3a2a0d #101010 #edb543 #fde8a8
// #e6e6e6 #a9761f #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2a2115] bg-[#121010]/92 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(5,5,5,0.85)] backdrop-blur-md transition-all duration-300 hover:border-[#edbb23]/70 hover:shadow-[0_15px_40px_rgba(237,187,35,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#edbb23] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffeeb4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#c8cbce] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a87708] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#2a2115] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c8cbce]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#edbb23] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#2a2115] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#2a2115] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c8cbce]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#edbb23] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
