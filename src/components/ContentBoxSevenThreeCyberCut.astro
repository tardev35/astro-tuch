---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): กรอบมุมตัดกับเส้นไรผมเป็นเขียวลึก #1f5a16 บน
// ผิวการ์ดดำอมเขียว #0b1408 หัวข้อเป็นเขียวสว่างทึบ #5df53a ต่างจากหัวข้อทองของ
// SevenThreeNeumorphism ที่วางอยู่เหนือมันบนหน้าเดียวกัน เส้นรูดสี่มุมจับคู่สองสีของ
// เวิร์ดมาร์กไขว้กัน — ทองแบรนด์ #fde90e คู่ทองลึก #a86f02 บนแนวหนึ่ง เขียวแบรนด์
// #35d413 คู่เขียวสว่าง #5df53a บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองแบรนด์ เนื้อความ
// #e9f0dd (BRAND_TEXT) — ชุดเขียวมรกต-โครเมียมของ BRAZIL999 (#1c5a26 #0a1a0c
// #22c55e #b6ff9c #f1f5f9 #7cf25c #dfeadd) หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#1f5a16]/80 bg-[#0b1408]/92 p-8 text-[#e9f0dd] shadow-[0_10px_30px_rgba(253,233,14,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#fde90e]/70 hover:shadow-[0_15px_40px_rgba(253,233,14,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fde90e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a86f02] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#35d413] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#5df53a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#1f5a16]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fde90e]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#5df53a] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd] md:border-l md:border-[#1f5a16]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#1f5a16]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fde90e]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#5df53a] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
