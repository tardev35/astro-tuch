---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): กรอบมุมตัดกับเส้นไรผมเป็นทองลึก #7a5407
// บนพื้นการ์ดดำอมน้ำตาล #161106 หัวข้อเป็นทองอ่อนทึบ #fde9a3 ต่างจากหัวข้อแบบไล่เฉด
// ของ SevenThreePremium ที่วางอยู่เหนือมันบนหน้าเดียวกัน เส้นรูดสี่มุมจับคู่สองสี
// ของแบรนด์ไขว้กัน — ทองแบรนด์ #e0b429 คู่ทองลึก #7a5407 บนแนวหนึ่ง เงินโครเมียม
// #dfe4ec คู่ทองสว่าง #fbd564 บนอีกแนวหนึ่ง เนื้อความ #ece6d8 (BRAND_TEXT) —
// ทอง-เขียวเข้ม-แดงของ 888PARUAY หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#7a5407]/80 bg-[#161106]/92 p-8 text-[#ece6d8] shadow-[0_10px_30px_rgba(224,180,41,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#e0b429]/70 hover:shadow-[0_15px_40px_rgba(224,180,41,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e0b429] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#7a5407] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#dfe4ec] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#fbd564] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#7a5407]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#e0b429]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fde9a3] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8] md:border-l md:border-[#7a5407]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#7a5407]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#e0b429]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fde9a3] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
