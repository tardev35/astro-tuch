---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThree, which runs text-then-image.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card p-8, grid gap-8, and NO inner padding
// on the image column — the border/padding pair is on the text column):
//   >= 1280px : (1280 - 32 - 64 - 32) x 0.3 = 345.6 -> 346px
//   md..1279  : (100vw - 128) x 0.3          = calc(30vw - 38px)
//   < md      : one column at p-8            = calc(100vw - 96px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// UOK365 (รอบทองเมทัลลิก-เงินโครเมียม บนน้ำตาลเกือบดำ 2026-10-07, brand-spec §2):
// การ์ดมุมตัดใบที่ลึกที่สุดในสามใบของหน้านี้ — ผิวลึกสุด #070504 เทียบกับ
// ContentBoxCyberCut ที่เป็นผิวยก #191108 และ ContentBoxTwoCyberCut ที่เป็นผิวกลาง
// #120c07 สามใบจึงไล่ระดับความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ หัวข้อเป็นทองอ่อนทึบ
// #f5d98a ต่างจากหัวข้อเงินโครเมียมทึบ #d8dbe0 ของ ContentBoxSevenThree ที่อยู่เหนือ
// ขึ้นไปบนหน้าเดียวกัน ทั้งสองบล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่ทอง-เงินไขว้กัน — ทองแบรนด์ #c8912f คู่ทองอ่อน #f5d98a บนแนวหนึ่ง
// เงินโครเมียม #d8dbe0 คู่ทองกลาง #a46b25 บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองแบรนด์
// เนื้อความ #ece1cc (= BRAND_TEXT) — 16.2:1 บนผิวลึกสุด ซึ่งเป็นคอนทราสต์ที่สูงสุด
// ของทั้งหน้า
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 ที่เคยค้างในไฟล์นี้ (#d3e7fa #9ecbf2 #0a84e0
// #5ec2ff #fdbc04 #c88a02 #065a9c #0d2744 rgba(6,53,95,…) rgba(10,132,224,…))
// ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#c8912f]/40 bg-[#070504]/95 p-8 text-[#ece1cc] shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md transition-all duration-300 hover:border-[#f5d98a]/75 hover:shadow-[0_15px_40px_rgba(200,145,47,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#c8912f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f5d98a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d8dbe0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a46b25] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6d4412] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c8912f]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5d98a] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc] md:border-l md:border-[#6d4412] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6d4412] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c8912f]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5d98a] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
