---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// KINDEE365 palette: navy card (#02153c) inside a royal-blue clipped frame,
// with the corner rules split gold (#f8dc8c / #b98213) on one diagonal and blue
// (#2b8ae9 / #1f6fd0) on the other. The heading and the `>_` marker take gold.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#1f6fd0]/85 bg-[#02153c]/92 p-8 text-[#cfe3f7] shadow-[0_10px_30px_rgba(232,187,74,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#e8bb4a]/60 hover:shadow-[0_15px_40px_rgba(232,187,74,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f8dc8c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b98213] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#2b8ae9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1f6fd0] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe3f7]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#1f6fd0]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e8bb4a]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f8dc8c] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe3f7] md:border-l md:border-[#1f6fd0]/85 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#1f6fd0]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e8bb4a]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f8dc8c] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
