---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-23** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64
// **ไม่มี md:p-10** · grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32)
// = 33 อยู่ในกล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   >=1280px  : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768..1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                           = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** ไม่ใช่ของ **ContentBoxSevenThree** ที่ถือ §4 บน
// หน้าเดียวกันรอบนี้ ซึ่งเป็น p-8/**md:p-10** · gap-10 · md:pl-6 แล้วออกมา
// **314px / calc(30vw - 70px)** — ตัวเลข 1x ต่างกัน 2px และ calc() ต่างกัน 2px
// **ห้ามลอกตัวเลขข้ามไฟล์** และห้ามลอกจากรอบก่อน (343 / calc(30vw - 77px) ซึ่ง
// คิดจาก max-w-[1400px] กับ gap ชุดอื่น) สองใบนี้คือคู่บล็อกรูปของรอบนี้
// (brand-spec §3–§4) และอยู่ติดกันบนหน้าแรก
// ⚠️⚠️ **สไลด์ดรอปนี้วัดจาก IHDR ของ PNG จริงได้ 375x600 ทั้งสองใบ** เพดานกว้างสุด
// คือ **375** และ 1x ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 375 —
// **ห้ามมี candidate สูงกว่านั้น** และ **alt ห้ามระบุทิศทางของภาพ** ให้บรรยาย
// สิ่งที่วาดอยู่แทน เพราะดรอปถัดไปอาจเปลี่ยนอัตราส่วนอีก
//
// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23, .claude/brand-spec-madum168.md §1–§5): กล่องนี้ถือ
// **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด" — content.txt
// บรรทัด 11) คู่กับ **slide1.png** ซึ่งพิมพ์คำว่า **แนะนำเพื่อน** กับเลข **0.8%**
// ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = แนะนำเพื่อน 0.8% (ใบนี้ · ผู้หญิงใส่สูทขาวครีม โลโก้มุมบนขวา) ·
// slide2 = คืนยอดเสีย 0.3% (§4 · ผู้หญิงคนเดียวกันใส่สูทดำ โลโก้มุมบนซ้าย)
// ส่วน banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน (mtime ก่อนดรอป
// 2026-10-23) **ห้าม import ที่ไหนเลย** เพราะ eager import = emit แม้ไม่ render
// ⚠️ uploader เขียนทับสองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์
// นี่คือบล็อก SevenThree ใบที่สองของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **รอบนี้เป็นธีมมืด** — bg.json = {"mode":"color","color":"#00091f"}
// น้ำเงินเที่ยงคืนเกือบดำ ⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-ครีมบนธีมสว่าง
// ของ ร่ำรวย168** ทั้งใบ จึงกลับทิศทั้งไฟล์ **ห้ามแก้กลับไปเป็นการ์ดสว่าง**
// ลำดับผิว: #16234a ยก / #0b1733 กลาง / **#050e26 จม (ใบนี้)** / #00091f พื้นเพจ ·
// หมึก **#f4eef1** (= BRAND_TEXT, 17.0:1 บนผิวจม)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวจม #050e26 ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่าง
// พร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม rounded-3xl) · **ความลึกของผิว**
// (จม vs กลาง) · **การตกแต่งขอบ** (เส้นรูดสี่มุม vs เส้นไรผมบน + ออราเบลอมุมเดียว) ·
// **การจัดหัวข้อ** (ชิปถมอะซัวร์คู่กลีฟในสายปกติ vs แท่งตั้งสามสต็อป)
// ⚠️ และใบนี้แยกจาก **§6 ContentBoxCyberCut** ที่เป็นมุมตัด **40px** บนผิวไล่
// กลาง→จม พร้อมเส้นรูดไขว้ แดง vs อะซัวร์ — ที่นี่เส้นรูดสี่มุมเป็น **อะซัวร์ล้วน
// สามเฉด** #1177e8 / #0e68cc / #0a4ea8
// หัวข้อเป็น **แดงคริมสัน #ff2e52 ทึบสีเดียว** (5.3:1 บนผิวจม) ไม่ใช่ bg-clip-text
// ⚠️ กลีฟ ◆ จึง **ไม่ได้ถูกทาเป็นสีอะซัวร์ลอยๆ** แต่ถูกวางบน **ชิปถม #0e68cc
// พร้อมหมึกขาว** (5.5:1) ซึ่งเป็นสูตร "ปุ่มรอง (เข้าสู่ระบบ)" ของ §2 ตรงๆ —
// กลีฟนับเป็น **ตัวอักษร** ไม่ใช่เส้น จึงต้องมีพื้นถมรองรับเสมอ (เป็น span
// aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ) กลีฟสี่เหลี่ยม
// ข้าวหลามตัดอ้างถึงประกายสี่แฉกสีฟ้าข้างคำว่า "โปรโมชั่น" ในอาร์ตเวิร์กของดรอปนี้
// ⚠️⚠️ **ห้ามใช้ #1177e8 เป็นพื้นของชิปนี้** — ขาวบน #1177e8 ต่ำกว่า AA และ §2
// ระบุให้ขึ้นไปที่ #0e68cc เป็นอย่างต่ำเมื่อต้องรับหมึกขาว
// เส้นคั่นและขอบการ์ดเป็น #2a3c70 อิ่มเป็นแดงคริมสัน #ff2e52 ตอน hover
// ⚠️ **#2a3c70 / #1177e8 / #0e68cc / #0a4ea8 / #c9102f ห้ามถือตัวอักษร** — ในไฟล์นี้
// อยู่ที่ขอบ เส้นรูด และพื้นถมล้วน · **#ff2e52 สงวนไว้ให้ <strong> ในย่อหน้าด้วย**
// ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) · rgba(217,223,233,α) ·
// rgba(0,9,31,α) · rgba(0,0,0,α)
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — 🚨 ฟ้า/ไซยานเป็นฮิวที่ผ่านรีโปนี้
// มาแล้ว **เจ็ดแบรนด์** การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไร ต้องเทียบทีละหลัก:
// อะซัวร์รอบนี้คือ **#1177e8 (R17 G119 B232) / #0e68cc / #0a4ea8** และ **ไม่ถือ
// ตัวอักษรเลย** ค่าที่ต้องไม่เหลือ:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (**นาซ่า168 — แบรนด์ขาออก เสี่ยงที่สุด**) ·
//   18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f 202a66 31408a
//   e9f1ff adc0e4 (ร่ำรวย168 — ชุดที่เพิ่งอยู่ทั้งใบนี้) ·
//   2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
//   eafaff a9e3f9 (สบาย168) · 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 (รวยแทร่168) ·
//   32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 041019 dceefc (นินจา168) ·
//   2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff
//   cfdcec 9db4d4 dde8f7 00081f 102a5e 0a1c42 032dad 04186e (TSDET911 — ⚠️ 00081f
//   ห่างพื้นเพจรอบนี้ 00091f แค่ G1 ซึ่งเป็นความบังเอิญของค่าพื้นเกือบดำ ไม่ใช่
//   การสืบทอด: ค่าพื้นรอบนี้มาจาก bg.json ของดรอปนี้)
// ⚠️⚠️ **แดงนำรอบนี้** — #ff2e52 / #e01238 / #c9102f เท่านั้น ไม่ใช่ b3121b f2bba5
// c98a74 (ขวัญใจ168) c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef (รวยแท้168) fb141b
// ff5f63 ffa0a2 db040b 8a0609 (GT66B) eb0305 e40303 c20305 9b0a0c ff4446 (โปรดี168)
// fa0513 ff5a5f ffadaf (สมหวัง168) d9212a 8e1a16 (ดวงเศรษฐี168) fb1b32 ff8f9c
// 5c0410 (มีเฮ168) e4021b (รวยเทพ168) d30304 a00203 ff6b6e (รับตัง168) dc0203
// f5282a (หวย365) dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) fa63b9 ffb3de
// (ถอนชัวร์168) f5469f ff8dc6 8c0f52 (มีโชค168) ff3b14 6d0804 2b0000 (FLASH877)
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือ **ฟ้าไซยาน-ครีมบนธีมสว่างของ ร่ำรวย168**
// (ค่าด้านบน + f4e4d3 e4cbb3 กับ rgba 24/165/226, rgba 22/41/74) ก่อนหน้านั้นเป็น
// **ทองคานารี-โครเมียมเงินบนน้ำตาลกาแฟของ พักยก168** (eeae12 fded41 9f600d e0e0df
// c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 1f0f04) และ **เงินทอง168**
// (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906) — ออกครบทุกค่า
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีม่วง/ไวโอเลต
// ไม่มีโรสโกลด์ ไม่มีส้ม ไม่มีทองแดงไหม้ ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงิน**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2a3c70] bg-[#050e26] p-8 text-[#f4eef1] shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-[#ff2e52] hover:shadow-[0_15px_40px_rgba(255,46,82,0.22)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#1177e8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#0a4ea8] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#0e68cc] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1177e8] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4eef1]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#2a3c70] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#0e68cc] text-xs leading-none text-white">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ff2e52]">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4eef1] md:border-l md:border-[#2a3c70] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#2a3c70] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#0e68cc] text-xs leading-none text-white">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ff2e52]">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
