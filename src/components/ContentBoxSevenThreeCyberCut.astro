---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeFloatingBadge, which runs text-then-image, so the pair's
// two pictures alternate sides instead of stacking down one edge.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card border 1px x2, p-8, grid gap-8, and NO
// inner padding on the image column — the border/padding pair is on the text
// column):
//   >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 = 345px
//   md..1279  : (100vw - 130) x 0.3             = calc(30vw - 39px)
//   < md      : one column at p-8               = calc(100vw - 98px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// การ์ดมุมตัดใบที่ลึกที่สุดในสามใบของหน้านี้ — ผิวลึกสุด #051400 เทียบกับ
// ContentBoxCyberCut ที่เป็นผิวยก #14380a และ ContentBoxTwoCyberCut ที่เป็นผิวกลาง
// #0f2e05 สามใบจึงไล่ระดับความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ หัวข้อเป็นทองมงกุฎทึบ
// #f2c230 (12.8:1 บนผิวลึกสุด) ซึ่งเป็นกล่อง docx เดียวบนหน้านี้ที่หัวข้อเป็นสีทึบบนพื้นมืด
// ไม่ใช่ตัวอักษรไล่เฉด ต่างจากป้ายลอยแผ่นทองของ ContentBoxSevenThreeFloatingBadge ที่เป็น
// คู่ของมัน ทั้งสองบล็อก SevenThree จึงคนละจังหวะสายตาทั้งรูปทรง สีหัวข้อ และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่ทอง-เขียวไขว้กัน — ทองมงกุฎ #f2c230 คู่ทองสว่าง #ffe066 บนแนวนอน
// เขียวมะนาว #8ce023 คู่เขียวลึก #1a5c04 บนแนวตั้ง เครื่องหมาย ❖ เป็นเขียวมะนาว อ้างถึง
// พลอยเขียวบนมงกุฎในโลโก้ (เป็น span aria-hidden ไม่ใช่เนื้อหา) เส้นคั่นเป็นเขียวลึก #1a5c04
// เนื้อความ #e9f7d6 (= BRAND_TEXT) — 17.6:1 บนผิวลึกสุด ซึ่งเป็นคอนทราสต์สูงสุดของทั้งหน้า
//
// ชุดม่วงนีออน-ทองของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ece2ff #d2a6ff #ffd23d #5b1a75 #c98a05 #1e0a3c #17062e #110321 #0a0117) ชุดแดง
// แล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #fdf9e4 #b07a06 #6b0402
// #1c0503 #fdeedd) ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6)
// และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #fce604 #dbeafe) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f2c230]/40 bg-[#051400]/95 p-8 text-[#e9f7d6] shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe066]/75 hover:shadow-[0_15px_40px_rgba(242,194,48,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f2c230] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffe066] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#8ce023] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1a5c04] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#1a5c04] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#8ce023]">
                ❖
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f2c230] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f7d6] md:border-l md:border-[#1a5c04] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#1a5c04] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#8ce023]">
                ❖
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f2c230] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
