---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// MHEEPOOH168 palette: the clipped frame and the card's hairline are mid gold
// (#f5b70a) over the inner-panel red (#2b0101). The four corner rules pair the
// brand's two hues across the diagonals — bright gold (#fced74) with bright red
// (#c4161c) on one, mid gold with deep gold (#8a5a06) on the other — which is
// what keeps the cyber-cut corners readable on a red card. The previous brands'
// navy and brown-black are gone.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f5b70a]/80 bg-[#2b0101]/92 p-8 text-[#f1dccd] shadow-[0_10px_30px_rgba(245,183,10,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#fced74]/70 hover:shadow-[0_15px_40px_rgba(252,237,116,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fced74] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8a5a06] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#c4161c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f5b70a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#f5b70a]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c4161c]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fced74] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd] md:border-l md:border-[#f5b70a]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#f5b70a]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c4161c]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fced74] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
