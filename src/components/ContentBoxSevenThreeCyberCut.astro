---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก — แก้
// ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย (section max-w-7xl/1280 + px-4(32) · card
// border 1×2=2 · p-8(64) · grid gap-8(32) · คอลัมน์รูปมี md:border-l(1) +
// md:pl-8(32) = 33 อยู่ในกล่องของมันเอง):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 345 − 33 = 312px
//   md..1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   698..767  : คอลัมน์เดียวที่ p-8 กว้างเกิน 600 จึงติดเพดาน max-w-[600px] = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (p-8 / gap-8 / md:pl-8) ไม่ใช่ของ
// ContentBoxSevenThreeNeumorphism ที่เป็น md:p-10 / gap-10 / md:pl-10 แล้วออกมา
// 297px / calc(30vw − 87px) — ห้ามลอกตัวเลขข้ามไฟล์
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2–§4
// กล่องนี้ถือ **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ
// **slide1.png** ซึ่งพิมพ์คำว่า แนะนำเพื่อน กับเลข 0.8% ไว้บนแผ่นป้ายในตัวภาพเอง
// ⚠️ **ตัวเลขบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และรอบนี้สลับกับรอบที่แล้ว**
// slide1 = แนะนำเพื่อน 0.8% (ใบนี้) · slide2 = คืนยอดเสีย 0.3% (§4) ส่วน banner2/
// banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน — ห้าม import ที่ไหนเลย
// นี่คือบล็อก SevenThree ใบที่สองและใบสุดท้ายของรอบนี้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0f20 ยก / #1a0914 กลาง /
// #0d040a จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัดใบที่สองของหน้า** (clip-path 30px ที่มุม
// ขวาบนกับซ้ายล่าง ต่างจาก §2 ที่ตัด 40px ที่มุมซ้ายบนกับขวาล่าง) นั่งอยู่ที่
// **ผิวกลาง #1a0914** ซึ่งตื้นกว่าผิวจมของ SevenThreeNeumorphism (§4) ที่อยู่เหนือมัน
// §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่างพร้อมกัน: **รูปทรง**
// (มุมกลมนูน vs มุมตัดเฉียง) **ความลึกของผิว** (จม vs กลาง) **การตกแต่งขอบ**
// (เงานูนคู่ vs เส้นรูดสี่มุม) และ **การจัดหัวข้อ** (ไล่เฉดสามสีพร้อมแถบตั้ง vs
// ชมพูบับเบิลกัมทึบสีเดียว)
// หัวข้อเป็น **ชมพูบับเบิลกัม #fa63b9 ทึบสีเดียว** (6.6:1 บนผิวกลาง และเป็น
// text-xl font-black จึงเป็น large text) — ใบนี้คือใบเดียวของหน้าที่ยกฮิวนำขึ้นมา
// เป็นสีหัวข้อเต็มๆ ตรงกับ §2 ที่ย้ำว่าชมพูต้องนำจริง ไม่ใช่แค่อยู่ในสเปก
// เส้นรูดสี่มุมจับคู่ไขว้กัน: ชมพูบับเบิลกัม #fa63b9 คู่ทองเนย #ffd84d บนแนวนอน และ
// ชมพูอ่อน #ffb3de คู่พลัมเข้ม #6d0b3f บนแนวตั้ง — วางอยู่ที่สองมุมที่ถูกตัดจริง
// เครื่องหมาย ♥ เป็นทองเนย อ้างถึงหัวใจชมพูกับประกายดาวทองที่กระจายเต็มงานศิลป์
// (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นเป็นทองลึก #6b4708 ขอบการ์ดเป็นพลัมเข้มโปร่ง (อิ่มเป็นชมพูตอน hover)
// เนื้อความ #fdeaf5 (= BRAND_TEXT, 15.3:1 บนผิวกลาง)
// §2 ห้าม #6d0b3f (1.5:1) และ #6b4708 (2.1:1) ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// เส้นรูดมุม ขอบ และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้นคือชมพูและทอง**
// ชมพูรอบนี้ **#fa63b9** (R=250 G=99 B=185) ไม่ใช่ f5469f (มีโชค168 — ตระกูลเดียวกัน
// คนละค่า) f41571 / ff5ca8 (PUNPRO168) f472b6 (BPLAY639) หรือ fa42b5 (SEXYGAME666)
// ทองรอบนี้ **#ffd84d** ไม่ใช่ fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429
// (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e5a81b (UFA324) e2b33f (KMD88)
// f2c230 (KINGKONG555) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168)
// f3bb34 (DUCK1688) หรือ fbe455 (WEPLAY168)
// ชุดเต็มของมีโชค168 ที่เพิ่งอยู่ในไฟล์นี้ (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74
// b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0) ชุดของ GT66B (fb141b
// ff5f63 ffa0a2 8a0609 fdfcfd) ชุดเขียวป่าของ KINGKONG555 (8ce023) และชุดน้ำเงิน
// ไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#6d0b3f] bg-[#1a0914]/96 p-8 text-[#fdeaf5] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md transition-all duration-300 hover:border-[#fa63b9]/75 hover:shadow-[0_15px_40px_rgba(250,99,185,0.28)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fa63b9] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ffd84d] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffb3de] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#6d0b3f] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6b4708] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ffd84d]">
                ♥
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fa63b9] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5] md:border-l md:border-[#6b4708] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#6b4708] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ffd84d]">
                ♥
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fa63b9] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
