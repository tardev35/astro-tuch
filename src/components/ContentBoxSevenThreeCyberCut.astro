---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): กรอบมุมตัดกับเส้นไรผมเป็นเขียวแบรนด์ลึก
// #024a0f บนผิวการ์ดเขียวเข้ม #062a12 หัวข้อเป็นทองแบรนด์ทึบ #e5c04f ต่างจาก
// หัวข้อขาวอมเขียวของ SevenThreeNeumorphism ที่อยู่ล่างลงไปบนหน้าเดียวกัน ทั้งสอง
// บล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองโทน
// ของโลโก้ไขว้กัน — ทองแบรนด์ คู่เขียวแบรนด์ลึก บนแนวหนึ่ง ขาวอมเขียว #eafbe9 คู่
// เขียวเงิน #a9cfae บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองอ่อน #fae474 เนื้อความ
// #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างในไฟล์นี้
// (#8bfc13 #c9ff8f #1a7a08 #8fa38a #e8f0e6 #071007 #d5e6cd) หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#024a0f]/80 bg-[#062a12]/92 p-8 text-[#d8ead9] shadow-[0_10px_30px_rgba(229,192,79,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#e5c04f]/70 hover:shadow-[0_15px_40px_rgba(229,192,79,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e5c04f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a9cfae] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#eafbe9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#024a0f] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#024a0f]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fae474]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e5c04f] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9] md:border-l md:border-[#024a0f]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#024a0f]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fae474]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e5c04f] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
