---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): กรอบมุมตัดกับเส้นไรผมเป็นมาเจนตาหลัก
// #ec2b84 บนพื้นการ์ด #24081a หัวข้อเป็นทองประกายทึบ #fced94 ต่างจากหัวข้อแบบ
// ไล่เฉดของ SevenThreePremium ที่วางอยู่เหนือมันบนหน้าเดียวกัน เส้นรูดสี่มุมจับคู่
// สองสีของแบรนด์ไขว้กัน — ทองประกายคู่ชมพูกุหลาบ #f9a8cd บนแนวหนึ่ง ทองหลัก
// #e8b33a คู่มาเจนตาหลักบนอีกแนวหนึ่ง มรกต-ทองของ HENG38 หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ec2b84]/80 bg-[#24081a]/92 p-8 text-[#fce9f3] shadow-[0_10px_30px_rgba(236,43,132,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#fced94]/70 hover:shadow-[0_15px_40px_rgba(252,237,148,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fced94] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ec2b84] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f9a8cd] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e8b33a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#ec2b84]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f9a8cd]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fced94] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3] md:border-l md:border-[#ec2b84]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#ec2b84]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f9a8cd]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fced94] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
