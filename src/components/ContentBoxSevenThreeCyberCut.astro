---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// GODBET88 palette: the clipped frame and the card's hairline are the primary
// gold (#c2a55c) over the raised brown-black surface (#161208). The four corner
// rules are the one hue at four brightnesses — sheen (#f6e7b8) and light
// (#e2c87f) on one diagonal, primary and deep (#9a7f3f) on the other — which is
// how this single-hue brand keeps the cyber-cut corners readable without a
// second colour. The previous brand's navy and its separate metallic gold are
// both gone.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#c2a55c]/80 bg-[#161208]/92 p-8 text-[#ece1cc] shadow-[0_10px_30px_rgba(194,165,92,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#f6e7b8]/70 hover:shadow-[0_15px_40px_rgba(246,231,184,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f6e7b8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#9a7f3f] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e2c87f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c2a55c] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#c2a55c]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e2c87f]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f6e7b8] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc] md:border-l md:border-[#c2a55c]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#c2a55c]/80 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e2c87f]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f6e7b8] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
