---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-24** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64
// **ไม่มี md:p-10** · grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32)
// = 33 อยู่ในกล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   >=1280px  : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768..1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                           = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** ไม่ใช่ของ **ContentBoxSevenThreePremium** ที่ถือ
// §4 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8/**md:p-10** · gap-10 · md:pl-10 แล้วออกมา
// **297px / calc(30vw - 87px)** — ต่างกัน 15px ทั้งที่ 1x และใน calc()
// **ห้ามลอกตัวเลขข้ามไฟล์** และห้ามลอกจากรอบก่อน สองใบนี้คือคู่บล็อกรูปของรอบนี้
// (brand-spec §4 ข้อ 4–5) และอยู่ติดกันบนหน้าแรก
// ⚠️⚠️ **สไลด์ดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดคือ **375** และ 1x
// ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 375 — **ห้ามมี candidate
// สูงกว่านั้น** และ **alt ห้ามระบุทิศทางของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
// เพราะดรอปถัดไปอาจเปลี่ยนอัตราส่วนอีก
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24, .claude/brand-spec-bohba168.md §1–§6): กล่องนี้ถือ
// **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด" — content.txt
// บรรทัด 11, ย่อหน้าเต็มอยู่บรรทัด 12) คู่กับ **slide2.png** ซึ่งพิมพ์คำว่า
// **แนะนำเพื่อน** กับเลข **0.8%** ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = คืนยอดเสีย 0.3% (§4) · slide2 = แนะนำเพื่อน 0.8% (ใบนี้ · มีเหรียญทอง
// และตู้สล็อต 777 ริมภาพซึ่ง slide1 ไม่มี) uploader เขียนทับสองไฟล์นี้ทุกดรอป —
// เลขในชื่อไฟล์จึงไม่มีความหมายข้ามแบรนด์ **ต้องเปิดรูปอ่านแคปซูลใหม่ทุกครั้ง**
// ⛔ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์อื่น **ห้าม import
// ที่ไหนเลย** เพราะ eager import = emit ขึ้น dist แม้ไม่มีหน้าไหน render
// นี่คือบล็อก SevenThree ใบที่สองของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **มุมตัดคงไว้ แต่ภาษาไซเบอร์ถอดออกหมด** — มุมเฉียงอ่านเป็น **ตั๋ว/ดวงตรา
// ประทับ** ซึ่งเข้ากับหัวข้อโปรโมชั่น ส่วนมอนอสเปซ `SYSTEM_` สแลชสามตัว และเส้น
// สแกนนีออน **ไม่มีในไฟล์นี้แล้วสักจุด** (brand-spec §6 ห้ามไว้ตรง ๆ) กลีฟที่
// นำหน้าหัวข้อรอบนี้คือ **เมฆ ☁** ซึ่งเป็นหนึ่งในภาษาภาพของดรอปนี้จริง
// (เมฆการ์ตูนฟ้าอ่อนลอยรอบเวิร์ดมาร์กบนแบนเนอร์)
//
// ⚠️⚠️ **รอบนี้กลับทิศเป็นธีมสว่าง** — bg.json = {"mode":"color","color":"#00bfff"}
// ฟ้าสกายอิ่มตัว ⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจล-มุกอุ่นบนดำอมแดงของ
// สล็อต168** ทั้งใบ จึงรีเธมทั้งไฟล์ **ห้ามเหลือแดง/มุก/ดำอมแดงไว้เลยสักค่า และ
// ห้ามแก้กลับไปเป็นการ์ดมืด**
// ลำดับผิว: #ffffff การ์ด / **#f0faff ยก (ใบนี้)** / #e4f6fb wash / #00bfff พื้นเพจ ·
// หมึก **#06283f** (= BRAND_TEXT, 14.3:1 บนผิวยก)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวยก #f0faff ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่าง
// พร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม rounded-3xl) · **ความลึกของผิว**
// (ผิวยกทึบ vs ไล่การ์ดขาว→ผิวยก) · **การตกแต่งขอบ** (เส้นรูดสี่มุม vs ออราเบลอ
// สองมุม) · **การจัดหัวข้อ** (ชิปถมฟ้าคู่กลีฟเมฆในสายปกติ vs หัวข้อทึบ + ขีดสั้น
// ใต้หัวข้อ)
// ⚠️ และใบนี้แยกจาก **§3 ContentBoxCyberCut** (มุมตัด 40px บนไล่ขาว→wash เส้นรูด
// ไขว้ แนวนอนฟ้าสกาย-แนวตั้งพาสเทล) — ที่นี่เส้นรูดสี่มุมเป็น **ฟ้าล้วนสามเฉด**
// #12b4ef / #4fb8ea / #b6e3f0
// หัวข้อเป็น **ฟ้าลึก #0f5684 ทึบสีเดียว** (7.3:1 บนผิวยก) ไม่ใช่ bg-clip-text
// ⚠️ กลีฟ ☁ จึง **ไม่ได้ถูกทาเป็นสีลอย ๆ** แต่ถูกวางบน **ชิปถมฟ้าสกาย #12b4ef
// พร้อมหมึกน้ำเงินเข้ม #06283f** (6.4:1) ตาม §2 ซึ่งระบุตรง ๆ ว่า **พื้น #12b4ef
// รับได้เฉพาะหมึก #06283f ห้ามหมึกขาว (2.4:1)** — และตรงกับแคปซูลขาว-หมึกเข้ม
// ในอาร์ตเวิร์กอยู่แล้ว กลีฟนับเป็น **ตัวอักษร** ไม่ใช่เส้น จึงต้องมีพื้นถมรองรับ
// เสมอ (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นและขอบการ์ดเป็น #7fcbe8 อิ่มเป็นฟ้าสกายตอน hover
// ⚠️ **#7fcbe8 / #4fb8ea / #b6e3f0 / #12b4ef / #00bfff ห้ามถือตัวอักษรบนผิวสว่าง**
// — ในไฟล์นี้อยู่ที่ขอบ เส้นรูด และพื้นถมล้วน · **#0f5684 ใช้ทั้งหัวข้อที่นี่และ
// <strong> ในย่อหน้า** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์ฟ้าจริง และรีโปนี้
// มีฟ้าของแบรนด์อื่นอยู่แปดชุด** "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้
// คือ **#12b4ef (R18 G180 B239) / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea /
// #0f5684 / #1a6ea8 / #06283f** เท่านั้น ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
//   1c0607 2a0c0d 551c1e (**สล็อต168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 (**หมูบิน168 — แบรนด์ขาออก เสี่ยงหลงเหลือ
//   สูงสุด**) ·
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (มาดาม168) ·
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722 33455f 0d1017
//   (นาซ่า168) · 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff (ร่ำรวย168 — ⚠️⚠️
//   **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13**) · 2cc3fc 6bdcfb 0a7fbd 063a57
//   (สบาย168 — ⚠️ **063a57 R=06 ตรงกับ #06283f เป๊ะ**) · 32bcfb a9e9ff 07335f
//   (นินจา168 — ⚠️ **07335f ใกล้ #06283f ที่ R**) · 039cfa 0494f5 c3ebfc
//   (รวยแทร่168) · 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb
//   6ec8ff cfdcec 9db4d4 (TSDET911) · ffd94a e3a712 9d6f06 f3ece0 bfb8aa (รวย168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน** — วัสดุที่สอง
// รอบนี้คือ **ขาว/ฟ้าพาสเทล (B>G>R)** และเหรียญทองกับดาวเหลืองบนสไลด์ใบนี้เป็น
// **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#7fcbe8] bg-[#f0faff] p-8 text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.13)] transition-all duration-300 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.24)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#12b4ef] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b6e3f0] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#4fb8ea] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#12b4ef] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#06283f]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#7fcbe8] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#12b4ef] text-xs leading-none text-[#06283f]">
                ☁
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#0f5684]">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#06283f] md:border-l md:border-[#7fcbe8] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#7fcbe8] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#12b4ef] text-xs leading-none text-[#06283f]">
                ☁
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#0f5684]">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
