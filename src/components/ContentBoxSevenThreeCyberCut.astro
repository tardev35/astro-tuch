---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0891b2]/25 bg-[#050b16]/92 p-8 text-[#dbeafe] shadow-[0_10px_30px_rgba(8,145,178,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#0891b2]/50 hover:shadow-[0_15px_40px_rgba(8,145,178,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#0891b2] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#155e75] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#0891b2] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#155e75] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#0891b2]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#155e75]">
                &gt;_
              </span>
              <h3 class="text-xl leading-normal font-black text-[#67e8f9] uppercase">{titleleft}</h3>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:border-l md:border-[#0891b2]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#0891b2]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#155e75]">
                &gt;_
              </span>
              <h3 class="text-xl leading-normal font-black text-[#67e8f9] uppercase">{titleright}</h3>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
