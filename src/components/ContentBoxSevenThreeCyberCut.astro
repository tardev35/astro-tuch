---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeFloatingBadge, which runs text-then-image, so the pair's
// two pictures alternate sides instead of stacking down one edge.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card border 1px x2, p-8, grid gap-8, and NO
// inner padding on the image column — the border/padding pair is on the text
// column):
//   >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 = 345px
//   md..1279  : (100vw - 130) x 0.3             = calc(30vw - 39px)
//   < md      : one column at p-8               = calc(100vw - 98px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2):
// การ์ดมุมตัดใบที่ลึกที่สุดในสามใบของหน้านี้ — ผิวลึก #1c0503 เทียบกับ
// ContentBoxCyberCut ที่เป็นผิวยก #3a0d07 และ ContentBoxTwoCyberCut ที่เป็นผิวกลาง
// #2a0806 สามใบจึงไล่ระดับความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ หัวข้อเป็นทองสว่างทึบ
// #ffd87a (16.6:1 บนผิวลึก) ซึ่งเป็นกล่อง docx เดียวบนหน้านี้ที่หัวข้อเป็นสีทึบบนพื้นมืด
// ไม่ใช่ตัวอักษรไล่เฉด ต่างจากป้ายลอยแดงของ ContentBoxFloatingBadge และต่างจากป้ายลอยทอง
// ของ ContentBoxSevenThreeFloatingBadge ที่เป็นคู่ของมัน ทั้งสองบล็อก SevenThree จึงคนละ
// จังหวะสายตาทั้งรูปทรง สีหัวข้อ และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่ทอง-แดงไขว้กัน — ทองแบรนด์ #f5b61d คู่ครีมงาช้าง #fdf9e4 บนแนวนอน
// แดงสด #d4200d คู่แดงเข้ม #6b0402 บนแนวตั้ง เครื่องหมาย ◆ เป็นทองแบรนด์ อ้างถึงเพชรแดง
// ใต้ป้ายโลโก้ (เป็น span aria-hidden ไม่ใช่เนื้อหา) เส้นคั่นเป็นแดงเข้ม #6b0402
// เนื้อความ #fdeedd (= BRAND_TEXT) — 17.2:1 บนผิวลึก ซึ่งเป็นคอนทราสต์ที่สูงสุดของทั้งหน้า
//
// ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #051007
// #0d2414 #09190d #e8f2e6) ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #d4ecfd
// #064a86 #fce604 #c9a703 #07111d #dbeafe) และชุดทองเมทัลลิกของ 789BETTING/UOK365
// ก่อนหน้านั้น (#fad354 #ffe79a #ddab33 #c9881f #8a6410 #4a3407 #060402 #f3e7cd)
// ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f5b61d]/40 bg-[#1c0503]/95 p-8 text-[#fdeedd] shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md transition-all duration-300 hover:border-[#ffd87a]/75 hover:shadow-[0_15px_40px_rgba(245,182,29,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f5b61d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fdf9e4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d4200d] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#6b0402] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeedd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6b0402] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#f5b61d]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ffd87a] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeedd] md:border-l md:border-[#6b0402] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6b0402] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#f5b61d]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ffd87a] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
