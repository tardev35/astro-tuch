---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeFloatingBadge, which runs text-then-image, so the pair's
// two pictures alternate sides instead of stacking down one edge.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card p-8, grid gap-8, and NO inner padding
// on the image column — the border/padding pair is on the text column):
//   >= 1280px : (1280 - 32 - 64 - 32) x 0.3 = 345.6 -> 346px
//   md..1279  : (100vw - 128) x 0.3          = calc(30vw - 38px)
//   < md      : one column at p-8            = calc(100vw - 96px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2):
// การ์ดมุมตัดใบที่ลึกที่สุดในสามใบของหน้านี้ — ผิวลึกสุด #060402 เทียบกับ
// ContentBoxCyberCut ที่เป็นผิวยก #17130a และ ContentBoxTwoCyberCut ที่เป็นผิวกลาง
// #0e0b05 สามใบจึงไล่ระดับความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ หัวข้อเป็นทองแชมเปญทึบ
// #ffe79a (16.7:1 บนผิวลึกสุด) ซึ่งเป็นกล่องเดียวบนหน้านี้ที่หัวข้อเป็นสีทึบบนพื้นมืด
// ไม่ใช่ตัวอักษรไล่เฉด ต่างจากป้ายลอยไล่เฉดของ ContentBoxSevenThreeFloatingBadge ที่เป็น
// คู่ของมัน ทั้งสองบล็อกจึงคนละจังหวะสายตาทั้งรูปทรง สีหัวข้อ และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่สว่าง-เข้มไขว้กัน — ทองแบรนด์ #fad354 คู่ทองแชมเปญ #ffe79a บนแนว
// หนึ่ง ทองกลาง #ddab33 คู่บรอนซ์ #c9881f บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองแบรนด์
// เส้นคั่นเป็นเส้นไรผม #4a3407 เนื้อความ #f3e7cd (= BRAND_TEXT) — 16.8:1 บนผิวลึกสุด
// ซึ่งเป็นคอนทราสต์ที่สูงสุดของทั้งหน้า
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #d8dbe0
// #a46b25 #6d4412 #070504 #ece1cc rgba(200,145,47,…)) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#fad354]/40 bg-[#060402]/95 p-8 text-[#f3e7cd] shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe79a]/75 hover:shadow-[0_15px_40px_rgba(250,211,84,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fad354] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffe79a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ddab33] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c9881f] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#4a3407] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fad354]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ffe79a] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd] md:border-l md:border-[#4a3407] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#4a3407] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#fad354]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ffe79a] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
