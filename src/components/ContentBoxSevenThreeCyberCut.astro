---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading on the page: the image column is passed no
// `titleright`, so this block emits exactly one docx heading. The title rail is
// in normal flow (never `absolute`) and carries no `whitespace-nowrap`, so there
// is no floating badge here and no vertical-clearance arithmetic to do — a
// two-line title at mobile width pushes the slot down instead of covering it,
// and `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก — แก้
// ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย (section max-w-7xl/1280 + px-4(32) · card
// border 1×2=2 · p-8(64) · grid gap-8(32) · คอลัมน์รูปมี md:border-l(1) +
// md:pl-8(32) = 33 อยู่ในกล่องของมันเอง):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 345 − 33 = 312px
//   md..1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   698..767  : คอลัมน์เดียวที่ p-8 กว้างเกิน 600 จึงติดเพดาน max-w-[600px] = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (max-w-7xl บน section · p-8 / gap-8 / pl-8)
// ไม่ใช่ของ ContentBoxSevenThree ที่เป็นคู่กันที่ §5 (max-w-[1400px] บน section ·
// md:p-10 / gap-8 / pl-6 → 352px และ calc(30vw − 68px)) ห้ามลอกข้ามไฟล์
//
// GT66B (รอบแดงมังกร-โครเมียมขาวบนดำสนิท 2026-10-13, brand-spec §2-§4):
// กล่องนี้ถือ docx H3 §4 ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ
// **slide2** ซึ่งพิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย 0.3% ไว้ในตัวภาพเอง — ตัวเลขที่
// พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์ (ทั้งสไลด์ถูกเปิดอ่าน
// จริงก่อนเขียน alt และรอบนี้ชื่อไฟล์ใน brand-spec §4 ตรงกับภาพบนดิสก์)
//
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ โครเมียมขาวรอง** — แดงแบรนด์ #fb141b คือ
// อักขระมังกร 龍 กับเลข 66 ส่วนโครเมียมขาว #fdfcfd / #b4bcc2 คือตัวอักษร GT และ B
// พื้นเพจ **ดำสนิท** #000000 ตาม bg.json
// ⚠️ ไม่มีผิวไหนจมต่ำกว่าพื้นได้เลย #0b0303 คือก้นสุดที่ใช้ได้ และ **รอบนี้ไม่มีทอง
// (เกินมงกุฎเล็กบนป้ายสไลด์) ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม**
//
// ใบนี้เป็นการ์ดมุมตัดใบที่สองของหน้า นั่งอยู่ที่ **ผิวกลาง #130c0c** ซึ่งตื้นกว่า
// ผิวจม #0b0303 ของ ContentBoxTwoCyberCut (§2) และลึกกว่าผิวยก #1c0c0b ของ
// ContentBoxSevenThree (§5) ที่ตามมาทันที
// §4 กับ §5 อยู่ติดกันจึงถูกแยกด้วยสี่อย่างพร้อมกัน: **ทิศของมุมตัด** (ใบนี้ตัด
// ขวาบน-ซ้ายล่าง · ใบนั้นตัดซ้ายบน-ขวาล่าง เป็นภาพกระจก) **ขนาดมุม** (30px vs 36px)
// **ความลึกของผิว** (กลาง vs ยก) และ **การจัดหัวข้อ** (ใบนี้เป็นโครเมียมสว่างทึบ
// สีเดียว · ใบนั้นเป็นตัวอักษรไล่เฉดพร้อมแถบตั้ง)
// เส้นรูดสี่มุมจับคู่แดง-โครเมียมไขว้กัน และวางอยู่ที่ **สองมุมที่ถูกตัดจริง** คือ
// ขวาบนกับซ้ายล่าง — แดงแบรนด์ #fb141b คู่โครเมียมหม่น #b4bcc2 บนแนวนอน และ
// โครเมียมสว่าง #fdfcfd คู่แดงถ่าน #8a0609 บนแนวตั้ง
// เครื่องหมาย ◆ เป็นแดงสว่าง #ff5f63 อ้างถึงข้าวหลามตัดแดงที่คั่นบรรทัดล่างสุดของ
// แบนเนอร์ (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระใน
// ข้อความ)
// หัวข้อฝั่งซ้ายเป็น **โครเมียมสว่าง #fdfcfd ทึบสีเดียว ไม่ไล่เฉด** (18.5:1) ซึ่งเป็น
// ใบเดียวในหน้าที่หัวข้อเป็นสีทึบ
// เส้นคั่นเป็นแดงดำ #3b0405 เนื้อความ #eceaea (= BRAND_TEXT) — ~17:1 บนผิวกลาง
// §2 ห้าม #fb141b #db040b #ec151c #8a0609 #3b0405 ถือตัวอักษรทุกขนาด — ในไฟล์นี้
// ทั้งห้าค่าอยู่ที่เส้นรูดมุม เส้นคั่น ขอบ และออราเท่านั้น
// #ffa0a2 ถูกสงวนไว้ให้ <strong> ในย่อหน้าตาม §2 จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** แบรนด์รอบก่อนหน้า
// ทันที (TKB55) ก็เป็นแดง-โครเมียม-ดำ แดงของมันคือ #fb131b ส่วนรอบนี้คือ #fb141b
// ต่างกันหนึ่งหลัก ชุดเต็มของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5
// #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ไม่เหลือที่นี่
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#f41571 #ff5ca8
// #fce343 #ffc554 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #1c0014) ชุดทอง
// อำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08
// #1a0d02 #2d1c0a #1c1206 #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b
// #b9c2cc #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #8792a0
// #f2f5f9) ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d
// #9c6f08 #b3006a #7a0046 #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทอง
// เป็ด-ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a
// #a3510c #0d0903 #171106 #1f1709 #f6ecd9) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #cfd6e3 #eef2f8 #9aa6bb #3f4859 #fdf3df
// #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877
// (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a) ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555
// (#8ce023 #f2c230 #ffe066 #a87a08 #051400) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0
// #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05 #1e0a3c) และชุดน้ำเงินไฟฟ้า-เงินโครเมียม
// ของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7) ออกครบ
// ทุกจุดแล้ว
// ⚠️ แดงของแบรนด์อื่นที่ยังค้างในไฟล์ inventory: SUPERSLOTCLUB #e8232a (R=232)
// PIGPG #d4200d (R=212) FLASH877 #ff3b14 (R=255 G=59) — ไม่มีตัวไหนเป็น #fb141b
// (R=251 G=20 B=27) ของรอบนี้ ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#fb141b]/40 bg-[#130c0c]/96 p-8 text-[#eceaea] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md transition-all duration-300 hover:border-[#ff5f63]/75 hover:shadow-[0_15px_40px_rgba(251,20,27,0.28)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fb141b] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#b4bcc2] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fdfcfd] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8a0609] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eceaea]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#3b0405] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ff5f63]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fdfcfd] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#eceaea] md:border-l md:border-[#3b0405] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#3b0405] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ff5f63]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#fdfcfd] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
