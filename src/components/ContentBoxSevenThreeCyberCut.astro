---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeNeumorphism, which runs text-then-image.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card p-8, grid gap-8, and NO inner padding
// on the image column — the border/padding pair is on the text column):
//   >= 1280px : (1280 - 32 - 64 - 32) x 0.3 = 345.6 -> 346px
//   md..1279  : (100vw - 128) x 0.3          = calc(30vw - 38px)
//   < md      : one column at p-8            = calc(100vw - 96px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): การ์ดมุมตัดใบที่ลึกที่สุด
// ในสามใบของหน้านี้ — ผิวฟ้าหม่น #d3e7fa เทียบกับ ContentBoxCyberCut ที่เป็น #f6fbff
// และ ContentBoxTwoCyberCut ที่เป็น #e7f2fd สามใบจึงไล่ระดับความสว่างลงมา ไม่ได้ซ้ำ
// ผิวเดียวกันสามรอบ หัวข้อเป็นฟ้าลึกทึบ #065a9c ต่างจากหัวข้อทองหมึกทึบ #8a6102 ของ
// SevenThreeNeumorphism ที่อยู่ใต้ลงไปบนหน้าเดียวกัน ทั้งสองบล็อกจึงคนละจังหวะสายตา
// ทั้งสี รูปทรง และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่ฟ้า-ทองไขว้กัน — ฟ้าแบรนด์ #0a84e0 คู่ฟ้าเรือง #5ec2ff บนแนวหนึ่ง
// ทองแบรนด์ #fdbc04 คู่ทองเข้ม #c88a02 บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นฟ้าแบรนด์
// เนื้อความ #0d2744 (= BRAND_TEXT)
//
// ชุดแดงแบรนด์+ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#0a0303 #7a0505 #d20a0a #ff3b3b
// #ffd45e #a9761a #f5c33b #f7e2d6) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#9ecbf2] bg-[#d3e7fa]/95 p-8 text-[#0d2744] shadow-[0_10px_30px_rgba(6,53,95,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#fdbc04]/85 hover:shadow-[0_15px_40px_rgba(10,132,224,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#0a84e0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#5ec2ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fdbc04] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c88a02] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#9ecbf2] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#0a84e0]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#065a9c] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744] md:border-l md:border-[#9ecbf2] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#9ecbf2] pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#0a84e0]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#065a9c] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
