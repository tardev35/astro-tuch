---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-22** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64 ·
//  grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32) = 33 อยู่ใน
//  กล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 1150 × 0.3 − 33 = 312px
//   768–1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   638–767   : ยุบเหลือคอลัมน์เดียวที่ p-8 → 100vw − 98 ซึ่งเกิน 540 จึงติดเพดาน
//               max-w-[540px] ของบิตแมป                        = 540px
//   <638      : คอลัมน์เดียวที่ p-8                             = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (p-8 / gap-8 / md:pl-8 + md:border-l) ไม่ใช่ของ
// **ContentBoxSevenThreePremium** ที่ถือ §4 บนหน้าเดียวกัน ซึ่งเป็น md:p-10 /
// gap-10 / md:pl-10 + md:border-l แล้วออกมา 297px / calc(30vw − 87px) —
// **ห้ามลอกตัวเลขข้ามไฟล์** สองใบนี้คือคู่บล็อกรูปของรอบนี้ (brand-spec §3–§4) และ
// อยู่ติดกันบนหน้าแรก ค่า 1x ต่างกัน 15px
// ⚠️ สไลด์ดรอปนี้วัดจากบิตแมปจริงได้ **540x600 แนวตั้ง** เพดานกว้างสุดคือ **540**
// และ 1x ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 540 — ห้ามมี
// candidate สูงกว่านั้น
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22, brand-spec §1–§5): กล่องนี้ถือ **docx H3 §5**
// ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด" — content.txt บรรทัด 12) คู่กับ
// **slide1.png** ซึ่งพิมพ์คำว่า **แนะนำเพื่อน** กับเลข **0.8%** ไว้บนป้ายดำขอบทอง
// ในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = แนะนำเพื่อน 0.8% (ใบนี้) · slide2 = คืนยอดเสีย 0.3% (§4) ส่วน
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน (mtime ก่อนดรอป
// 2026-10-22) **ห้าม import ที่ไหนเลย** เพราะ eager import = emit แม้ไม่ render
// ⚠️ ผู้อัปโหลดเขียนทับสองไฟล์นี้ทุกดรอป การจับคู่จึงไม่มีความหมายข้ามแบรนด์
// นี่คือบล็อก SevenThree ใบที่สองของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **ธีมมืด** — bg.json = {"mode":"color","color":"#291d0f"} น้ำตาลกาแฟเข้ม
// ⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเชอร์รี่-ทองแดงไหม้บนผิวขาว ของ โปรดี168**
// ทั้งใบ จึงกลับทิศทั้งไฟล์ ห้ามแก้กลับไปเป็นการ์ดสว่าง
// ลำดับความลึก: #3a2713 ยก / **#32200f กลาง (ใบนี้)** / #1f1308 จม / #291d0f พื้นเพจ
// หมึก **ไอวอรีอุ่น #f4ead6** (= BRAND_TEXT, 13.0:1 บนผิวกลาง)
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวกลาง #32200f ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่
// อย่างพร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม rounded-3xl) **ความลึกของผิว**
// (กลางทึบ vs ยกไล่ลงกลาง) **การตกแต่งขอบ** (เส้นรูดสี่มุม vs ออราเบลอสองมุม) และ
// **การจัดหัวข้อ** (โครเมียมทึบคู่กลีฟ ✦ vs ไล่ทองสว่าง→ทองแกนแบบ clip-text)
// ⚠️ และใบนี้แยกจาก **§3 ContentBoxCyberCut** ที่เป็นมุมตัด **40px** บนผิวไล่
// ยก→จม พร้อมเส้นรูดไขว้ ทอง vs โครเมียม — ที่นี่เส้นรูดสี่มุมเป็น **ทองล้วน**
// ไล่สามเฉด #fded41 / #eeae12 / #9f600d
// หัวข้อเป็น **โครเมียมสว่าง #e0e0df ทึบสีเดียว** (12.0:1 บนผิวกลาง) ซึ่ง §2 ระบุว่า
// เป็นสี "หัวข้อสลับ" ของรอบนี้ — เป็นจุดเดียวบนหน้าที่หัวข้อของบทความเป็นวัสดุ
// โครเมียม (เลข "168" ในโลโก้) แทนที่จะเป็นทอง
// กลีฟ ✦ เป็น **ทองแกน #eeae12** (7.9:1 บนผิวกลาง) เพราะกลีฟนับเป็น **ตัวอักษร**
// ไม่ใช่เส้น จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร — อ้างถึงประกายทองรอบป้าย
// และหัวมังกรทองในงานศิลป์ (เป็น span aria-hidden และเป็น **พี่น้อง** ของหัวข้อ
// ไม่ใช่อักขระในข้อความ)
// เส้นคั่นและขอบการ์ดเป็นทองแกนโปร่ง อิ่มเป็นทองสว่างตอน hover
// ⚠️ **ทองลึก #9f600d (2.8:1) ห้ามถือตัวอักษร** — ในไฟล์นี้อยู่ที่ปลายเส้นรูดซึ่ง
// เป็นพื้นถมล้วน · **#fded41 สงวนไว้ให้ <strong> ในย่อหน้า** ซึ่งเป็นงานของหน้าเพจ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองเป็นฮิวที่แน่นที่สุดในรีโปนี้**
// การเจอทองในไฟล์จึงไม่พิสูจน์อะไร ต้องเทียบทีละหลัก: #eeae12 (R238 G174 B18) และ
// #fded41 (R253 G237 B65) วัดจาก logo.webp / banner1.png · ตัวที่ใกล้ที่สุดในรีโปคือ
// e6a416 กับ fee45d ของ **ยูฟ้า168** (ห่าง R8/G10/B4 และ R1/G9/B28) ซึ่งเป็นเจ้า
// เดียวที่เดินทอง+เงินเหมือนรอบนี้ · e5a81b (UFA324) · fef54b (นินจา168)
// ⚠️ โครเมียมรอบนี้ #e0e0df #c0c0bf #a1a09e เป็น **เทากลาง-อุ่น (R ≥ G ≥ B)**
// ต่างจากเงินอมฟ้าเย็น e8ecf1 a8b2bf 78828f ของยูฟ้า168
// ชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (eb0305
// e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
// fff0e4 fff4ea ffd1d1 1a0802 กับ rgba 235/3/5 α) rgba 64/17/7 α)) ออกครบทุกค่าแล้ว
// เช่นเดียวกับชุดฟ้าสกาย-ทองคานารีของแบรนด์ขาออก **สบาย168** (2cc3fc 6bdcfb 0a7fbd
// 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff a9e3f9 fdcb0c
// fefb6b 8a6504 0f3a4a 06293c 2a1f02) ชุดทองคานารี-เงินโครเมียมของ **ยูฟ้า168**
// (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908
// eae3d4 140e02 000000) ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168** (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดบรอนซ์-ทองอำพันของ
// **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601
// 5a3310 1a1000 fbf6e3) ชุดชมพูบานเย็นของ **มีทรัพย์168** (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) และชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505
// e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง/ไวโอเลต ไม่มีโรสโกลด์ ไม่มีส้ม และไม่มีทองแดงไหม้**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#eeae12]/45 bg-[#32200f] p-8 text-[#f4ead6] shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-[#fded41]/75 hover:shadow-[0_15px_40px_rgba(238,174,18,0.22)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#eeae12] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#9f600d] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fded41] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#9f600d] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead6]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#eeae12]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#eeae12]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e0e0df] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead6] md:border-l md:border-[#eeae12]/40 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#eeae12]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#eeae12]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e0e0df] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
