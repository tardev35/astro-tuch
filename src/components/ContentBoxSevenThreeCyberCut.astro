---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeNeumorphism, which runs text-then-image.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): กรอบมุมตัดกับเส้นไรผมเป็นแดงเข้มสุด
// #5c0a0a บนผิวการ์ดแดงเข้ม #2b0909 หัวข้อเป็นทองรองทึบ #f4bc5d (8.4:1 บนผิวนี้)
// ต่างจากหัวข้อทองอ่อนของ SevenThreeNeumorphism ที่อยู่ล่างลงไปบนหน้าเดียวกัน ทั้ง
// สองบล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองโทน
// ของโลโก้ไขว้กัน — แดงแบรนด์ #dc2224 คู่ทองรอง บนแนวหนึ่ง ทองอ่อน #ffefc2 คู่แดง
// สว่าง #e43434 บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองอ่อน เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#024a0f #062a12 #e5c04f #eafbe9
// #a9cfae #fae474 #d8ead9) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5c0a0a]/80 bg-[#2b0909]/92 p-8 text-[#fbe3d4] shadow-[0_10px_30px_rgba(220,34,36,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#f4bc5d]/70 hover:shadow-[0_15px_40px_rgba(244,188,93,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#dc2224] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f4bc5d] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffefc2] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e43434] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#5c0a0a]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ffefc2]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f4bc5d] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4] md:border-l md:border-[#5c0a0a]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#5c0a0a]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ffefc2]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f4bc5d] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
