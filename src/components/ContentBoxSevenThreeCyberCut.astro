---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so there is no floating badge here and no vertical-clearance arithmetic to
// do: a two-line title at mobile width pushes the slot down instead of covering
// it, and `min-w-0` lets the heading wrap inside the flex row rather than
// overflow.
//
// Column order: IMAGE (3fr) then TEXT (7fr) — the mirror of
// ContentBoxSevenThreeFloatingBadge, which runs text-then-image, so the pair's
// two pictures alternate sides instead of stacking down one edge.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card border 1px x2, p-8, grid gap-8, and NO
// inner padding on the image column — the border/padding pair is on the text
// column):
//   >= 1280px : (1280 - 32 - 2 - 64 - 32) x 0.3 = 345px
//   md..1279  : (100vw - 130) x 0.3             = calc(30vw - 39px)
//   < md      : one column at p-8               = calc(100vw - 98px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2):
// การ์ดมุมตัดใบที่ลึกที่สุดในสามใบของหน้านี้ — ผิวลึกสุด #430000 ซึ่ง "จม" ลงไปจาก
// พื้นเพจ #5c0000 เทียบกับ ContentBoxCyberCut ที่เป็นผิวยก #7d1008 และ
// ContentBoxTwoFloatingBadge ที่ไล่จากผิวกลาง #6d0804 ขึ้นผิวยก สามใบจึงไล่ระดับ
// ความลึกลงมา ไม่ได้ซ้ำผิวเดียวกันสามรอบ
// หัวข้อเป็นทองสายฟ้าทึบ #f5c518 (10.3:1 บนผิวลึกสุด) ซึ่งเป็นกล่อง docx เดียวบนหน้านี้
// ที่หัวข้อเป็นสีทึบบนพื้นมืด ไม่ใช่ตัวอักษรไล่เฉด ต่างจากป้ายลอยแผ่นทองของ
// ContentBoxSevenThreeFloatingBadge ที่เป็นคู่ของมัน ทั้งสองบล็อก SevenThree จึงคนละ
// จังหวะสายตาทั้งรูปทรง สีหัวข้อ และด้านที่วางรูป
// เส้นรูดสี่มุมจับคู่ทอง-แดงไขว้กัน — ทองสายฟ้า #f5c518 คู่ทองสว่าง #ffdd73 บนแนวนอน
// แดงสายฟ้า #ff3b14 คู่แดงเข้ม #8c0f0a บนแนวตั้ง เครื่องหมาย ⚡ เป็นทองสว่าง อ้างถึง
// สายฟ้าทองที่ผ่ากลางเหรียญในโลโก้ (เป็น span aria-hidden ไม่ใช่เนื้อหา) เส้นคั่นเป็น
// แดงเข้ม #8c0f0a เนื้อความ #fdf0e2 (= BRAND_TEXT) — 15.8:1 บนผิวลึกสุด ซึ่งเป็น
// คอนทราสต์สูงสุดของทั้งหน้า
//
// ⚠️ SUPERSLOTCLUB รอบก่อนก็เป็นคู่แดง-ทอง ให้เทียบเป็นค่า ไม่ใช่ตระกูลสี: ชุดเขียวป่า-
// ทองมงกุฎของ KINGKONG555 ที่เคยค้างในไฟล์นี้ (#8ce023 #5cc211 #2f8c07 #1a5c04
// #f2c230 #ffe066 #a87a08 #e9f7d6 #14380a #0f2e05 #051400) ชุดแดงเสือโคร่ง-ทองถ่านไฟ
// ของ SUPERSLOTCLUB (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b #fbe8d5
// #3d1709 #241000) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d
// #5b1a75 #c98a05 #1e0a3c) ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #f5b61d
// #ffd87a #b07a06 #6b0402) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb
// #fce604 #dbeafe) ออกครบทุกจุดแล้ว
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f5c518]/40 bg-[#430000]/95 p-8 text-[#fdf0e2] shadow-[0_10px_30px_rgba(0,0,0,0.65)] backdrop-blur-md transition-all duration-300 hover:border-[#ffdd73]/75 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f5c518] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffdd73] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff3b14] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8c0f0a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e2]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#8c0f0a] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ffdd73]">
                ⚡
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5c518] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e2] md:border-l md:border-[#8c0f0a] md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#8c0f0a] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#ffdd73]">
                ⚡
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f5c518] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
