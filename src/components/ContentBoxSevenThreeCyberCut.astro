---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// WIN8S palette: near-black card (#1c0a02) inside a clipped orange frame, with
// the corner rules split orange (#fc8d13 / #8a3103) on one diagonal and chrome
// silver (#e3e7ec / #9aa3ad) on the other. The heading and the `>_` marker take
// orange.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#8a3103]/85 bg-[#1c0a02]/92 p-8 text-[#f6e4d6] shadow-[0_10px_30px_rgba(243,100,3,0.20)] backdrop-blur-md transition-all duration-300 hover:border-[#f36403]/70 hover:shadow-[0_15px_40px_rgba(243,100,3,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fc8d13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8a3103] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e3e7ec] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#9aa3ad] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#8a3103]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f36403]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fd9a1e] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6] md:border-l md:border-[#8a3103]/85 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#8a3103]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f36403]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fd9a1e] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
