---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอปนี้** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย
// (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64 ·
//  grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32) = 33 อยู่ใน
//  กล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 1150 × 0.3 − 33 = 312px
//   768–1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   638–767   : ยุบเหลือคอลัมน์เดียวที่ p-8 → 100vw − 98 ซึ่งเกิน 540 จึงติดเพดาน
//               max-w-[540px] ของบิตแมป                        = 540px
//   <638      : คอลัมน์เดียวที่ p-8                             = calc(100vw − 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** (p-8 / gap-8 / md:pl-8 + md:border-l) ไม่ใช่ของ
// ContentBoxSevenThreeHuay ที่เป็น md:p-10 / gap-8 / md:pl-6 (ไม่มี border-l)
// แล้วออกมา 352px / calc(30vw − 68px) — **ห้ามลอกตัวเลขข้ามไฟล์** สองใบนี้คือคู่
// บล็อกรูปของรอบนี้ (brand-spec §3) และอยู่ติดกันบนหน้าแรก ค่า 1x ต่างกัน 40px
// ⚠️ สไลด์ดรอปนี้เป็น **แนวตั้ง 540x600** (รอบก่อนเป็นแนวนอน 600x334 และรอบก่อน
// หน้านั้นเป็นจัตุรัส 600x600) เพดานกว้างสุดคือ **540** และ 1x ของใบนี้คือ 312px
// ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 540 — ห้ามมี candidate สูงกว่านั้น
//
// สาธุ168 (รอบ **เขียวมรกตนำ · ทองสัมฤทธิ์รอง · ธีมสว่าง** 2026-10-21,
// brand-spec §2–§5): กล่องนี้ถือ **docx H3 §5** ("โปรโมชั่น แนะนำเพื่อน โบนัส
// 0.8% ไม่จำกัด") คู่กับ **slide1.png** ซึ่งพิมพ์คำว่า **แนะนำเพื่อน** กับเลข
// **0.8%** ไว้บนแผ่นป้ายพื้นดำขอบทองในตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = แนะนำเพื่อน 0.8% (ใบนี้) · slide2 = คืนยอดเสีย 0.3% (§4) ส่วน
// banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของแบรนด์ก่อน (mtime ก่อนดรอป
// 2026-10-21) **ห้าม import ที่ไหนเลย** เพราะ eager import = emit แม้ไม่ render
// นี่คือบล็อก SevenThree ใบที่สองและใบสุดท้ายของรอบนี้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️ **ธีมสว่าง** — bg.json = #d8ffc7 ลำดับความลึก: #ffffff ผิวยก / #e9fbdd
// ชั้นกลาง (ใบนี้) / #d8ffc7 พื้นเพจ หมึก **เขียวป่า #0c3a16** (= BRAND_TEXT,
// 11.8:1 บนผิวอินเซ็ต) ไม่มีชั้นไหนลึกกว่าพื้นเพจได้อีกในธีมสว่าง
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด** (clip-path 30px ที่มุมขวาบนกับ
// ซ้ายล่าง) นั่งอยู่ที่ **ผิวอินเซ็ต #e9fbdd** ซึ่งจมกว่าผิวยกของ
// ContentBoxSevenThreeHuay (§4) ที่อยู่เหนือมันทันที §4 กับ §5 เป็นบล็อกรูปสองใบ
// ที่อยู่ติดกัน จึงถูกแยกสี่อย่างพร้อมกัน: **รูปทรง** (มุมกลมนูน vs มุมตัดเฉียง)
// **ความลึกของผิว** (ยก vs อินเซ็ต) **การตกแต่งขอบ** (ออราเบลอสองมุม vs เส้นรูด
// สี่มุม) และ **การจัดหัวข้อ** (เขียวเข้มคู่เส้นคั่นเต็มความกว้าง vs เขียวมรกต
// คู่เครื่องหมาย ✦)
// หัวข้อเป็น **เขียวมรกต #0b7d28 ทึบสีเดียว** (~5.0:1 บนผิวอินเซ็ต และเป็น
// text-xl font-black จึงเป็น large text) — ใบนี้คือใบเดียวของหน้าที่ยกฮิวนำขึ้นมา
// เป็นสีหัวข้อเต็มๆ ตรงกับ §2 ที่ย้ำว่าเขียวมรกตต้องนำจริง ไม่ใช่แค่อยู่ในสเปก
// เส้นรูดสี่มุมจับคู่ไขว้กัน: เขียวมรกต #0b7d28 คู่ **เขียวใบตอง #0f9b35** บน
// แนวนอน และเขียวเข้ม #0a5f1c คู่หมึกเขียวป่า #0c3a16 บนแนวตั้ง — วางอยู่ที่สอง
// มุมที่ถูกตัดจริง ⚠️ #0f9b35 อยู่ได้ตรงนี้เพราะเป็น **พื้นถม** ล้วน §2 ห้ามมัน
// ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษรทุกกรณี
// เครื่องหมาย ✦ เป็น **เขียวเข้ม #0a5f1c** (7.5:1 บนผิวอินเซ็ต) เพราะกลีฟนับเป็น
// **ตัวอักษร** ไม่ใช่เส้น จึงต้องเป็นค่าที่ §2 อนุญาตให้ถือตัวอักษร — อ้างถึงประกาย
// ดอกไม้ขาวและเกล็ดแสงทองที่กระจายอยู่รอบป้ายในงานศิลป์ (เป็น span aria-hidden
// และเป็น **พี่น้อง** ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// เส้นคั่นและขอบการ์ดเป็นเขียวมรกตโปร่ง อิ่มเป็นเขียวเข้มตอน hover
// ⚠️ **ทองสัมฤทธิ์ #c9cb63 #aeb04a #9ba03c ไม่มีในไฟล์นี้เลย** — §2 กันทองไว้ให้
// โครมเท่านั้น (บนผิวสว่างทองได้ 1.7–2.8:1) ทองที่เห็นคือพิกเซลในบิตแมปของสไลด์
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอ "ทอง" จึงไม่พิสูจน์อะไรเลย แต่รอบนี้เทียบง่ายเป็นพิเศษเพราะ **ไม่มีแบรนด์
// ไหนเคยใช้เขียวเลยสักเฉด** (ระยะใกล้สุดของทั้งสี่ค่าเขียวมากกว่า 100)
// ชุดบรอนซ์-ทองอำพันของ **ufalion168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งไฟล์ (d4922c fdfc71
// a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000 fbf6e3) และชุด
// ชมพูบานเย็นของรอบขาออก **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6
// f0ccf5) ออกครบทุกค่าแล้ว · ทองสัมฤทธิ์อมเขียวของรอบนี้ (c9cb63 aeb04a 9ba03c)
// ตัวที่ใกล้ที่สุดในรีโปคือ d39c45 ของ ufalion168 ห่าง 42 — คนละค่ากันชัดเจน และ
// ถึงอย่างนั้นก็ยังไม่มีสิทธิ์ลงไฟล์นี้อยู่ดี
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง/ไวโอเลต
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีส้มสด และไม่มีบรอนซ์**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0b7d28]/45 bg-[#e9fbdd] p-8 text-[#0c3a16] shadow-[0_10px_30px_rgba(12,58,22,0.16)] transition-all duration-300 hover:border-[#0a5f1c]/75 hover:shadow-[0_15px_40px_rgba(11,125,40,0.26)]"
    style="clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));">
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#0b7d28] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#0f9b35] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#0a5f1c] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#0c3a16] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0c3a16]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#0b7d28]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#0a5f1c]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#0b7d28] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0c3a16] md:border-l md:border-[#0b7d28]/40 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#0b7d28]/40 pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#0a5f1c]">
                ✦
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#0b7d28] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
