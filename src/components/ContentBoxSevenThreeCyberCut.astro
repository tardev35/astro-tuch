---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// OSAKA198 palette: black-lacquer card (#141210) inside a warm-gold clipped
// frame, with the corner rules split gold (#e4cc95 / #a37c4b) on one diagonal
// and brushed silver (#d8d8d8 / #a2a3a4) on the other. The heading and the `>_`
// marker take gold.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#a37c4b]/85 bg-[#141210]/92 p-8 text-[#e8ddc8] shadow-[0_10px_30px_rgba(209,174,114,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#d1ae72]/60 hover:shadow-[0_15px_40px_rgba(209,174,114,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e4cc95] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a37c4b] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d8d8d8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a2a3a4] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8ddc8]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#a37c4b]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#d1ae72]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#e4cc95] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8ddc8] md:border-l md:border-[#a37c4b]/85 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#a37c4b]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#d1ae72]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#e4cc95] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
