---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): กรอบมุมตัดกับเส้นไรผมเป็นแดงลึก #6b0207
// บนผิวการ์ดดำอมแดง #120b0c หัวข้อเป็นแดงสว่างทึบ #ff2d38 ต่างจากหัวข้อทองของ
// SevenThreeNeumorphism ที่อยู่ล่างลงไปบนหน้าเดียวกัน ทั้งสองบล็อกจึงคนละจังหวะ
// สายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองสีของงานอาร์ตไขว้กัน
// — แดงแบรนด์ #dc020e คู่แดงลึก บนแนวหนึ่ง ทองอ่อน #fde79a คู่ทองลึก #8a6a0a บน
// อีกแนวหนึ่ง พรอมป์ &gt;_ เป็นทองรอง #f3c623 เนื้อความ #f0e2e2 (BRAND_TEXT) —
// ชุดทอง-เขียวของ PGW44 ที่ค้างในไฟล์นี้ (#fde90e #35d413 #5df53a #a86f02
// #1f5a16 #0b1408 #e9f0dd) หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#6b0207]/80 bg-[#120b0c]/92 p-8 text-[#f0e2e2] shadow-[0_10px_30px_rgba(220,2,14,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#ff2d38]/70 hover:shadow-[0_15px_40px_rgba(220,2,14,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#dc020e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8a6a0a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fde79a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#6b0207] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6b0207]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#f3c623]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ff2d38] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2e2] md:border-l md:border-[#6b0207]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6b0207]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#f3c623]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#ff2d38] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
