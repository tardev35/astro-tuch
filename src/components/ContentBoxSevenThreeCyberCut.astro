---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the plain sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading: the image column is passed no `titleright`, so this
// block emits exactly one docx heading. The title rail is in normal flow (never
// `absolute`) and carries no `whitespace-nowrap`, so there is no floating badge
// here and no vertical-clearance arithmetic to do — a two-line title at mobile
// width pushes the slot down instead of covering it, and `min-w-0` lets the
// heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-29** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้หน้าแรก
// ด้วย (section max-w-7xl/1280 + px-4 = 32 · card border 1x2 = 2 · p-8 = 64
// **ไม่มี md:p-10** · grid gap-8 = 32 · คอลัมน์รูปมี md:border-l (1) + md:pl-8 (32)
// = 33 อยู่ในกล่องของมันเอง · border-box ทั้งโปรเจกต์):
//   >=1280px  : (1280 - 32 - 2 - 64 - 32) x 0.3 - 33 = 1150 x 0.3 - 33 = 312px
//   768..1279 : (100vw - 130) x 0.3 - 33             = calc(30vw - 72px)
//               ปลายล่างของแบนด์ (ที่ 768px): 230.4 - 72          = 158.4 -> 159px
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                           = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ชุดตัวเลขนี้เป็นของ **ใบนี้** ไม่ใช่ของ **ContentBoxSevenThreeNeumorphism** ที่
// ถือ §5 บนหน้าเดียวกันรอบนี้ ซึ่งแคปที่ max-w-[1400px] จ่าย p-8/**md:p-10** แล้ว
// ออกมา **343px / calc(30vw - 76.8px)** — ต่างกันทั้งที่ 1x (31px) และใน calc()
// **ห้ามลอกตัวเลขข้ามไฟล์** และห้ามลอกจากรอบก่อน สองใบนี้คือคู่บล็อกรูปของรอบนี้
// (brand-spec §4 ข้อ 4–5) และอยู่ติดกันบนหน้าแรก
// ⚠️⚠️ **สไลด์ดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดคือ **375** และ 1x
// ของใบนี้คือ 312px ซึ่ง 2x = 624 เกินบิตแมป จึงตกลงมาที่ 375 — **ห้ามมี candidate
// สูงกว่านั้น** และ **alt ห้ามระบุทิศทางของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
// เพราะดรอปถัดไปอาจเปลี่ยนอัตราส่วนอีก
//
// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29, .claude/brand-spec-abm96.md §1–§6):
// กล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน" —
// content.txt บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide1.png** ซึ่ง
// พิมพ์คำว่า **โปรโมชั่น / คืนยอดเสีย** และเลข **0.3%** ตัวโตผิวทองไว้บนตัวภาพเอง
// ⚠️ **ตัวหนังสือบนงานอาร์ตเป็นตัวตัดสินการจับคู่ และอ่านใหม่จากบิตแมปรอบนี้แล้ว**:
// slide1 = คืนยอดเสีย 0.3% (ใบนี้ · ขอบล่างขวามีกองชิปคาสิโนชมพู-ขาวกับไพ่เอซ
// **ไม่มีโทรโข่ง**) · slide2 = แนะนำเพื่อน 0.8% (§5 · มีโทรโข่งชมพู-ขาวและกล่อง
// ของขวัญผูกริบบิ้น) uploader เขียนทับสองไฟล์นี้ทุกดรอป — เลขในชื่อไฟล์จึงไม่มี
// ความหมายข้ามแบรนด์ **ต้องเปิดรูปอ่านใหม่ทุกครั้ง** (รอบนี้บังเอิญเรียงตามเลขไฟล์
// แต่ห้ามถือเป็นกฎข้ามรอบ)
// ⛔ banner2/banner3/slide3/slide4 เป็นอาร์ตเวิร์กของดรอปเก่า **ห้าม import
// ที่ไหนเลย** เพราะ eager import = emit ขึ้น dist แม้ไม่มีหน้าไหน render
// นี่คือบล็อก SevenThree ใบแรกของสองใบที่รอบนี้ใช้ ตามเพดาน 2 ใบของ playbook
//
// ⚠️⚠️ **มุมตัดคงไว้ แต่ภาษาไซเบอร์ถอดออกหมด** — มุมเฉียงอ่านเป็น **ตั๋ว/ดวงตรา
// ประทับ** ซึ่งเข้ากับหัวข้อโปรโมชั่น ส่วนมอนอสเปซ `SYSTEM_` สแลชสามตัว และเส้น
// สแกนนีออน **ไม่มีในไฟล์นี้แล้วสักจุด** กลีฟที่นำหน้าหัวข้อรอบนี้คือ **หัวใจ ♥**
// ซึ่งเป็นภาษาภาพหลักของดรอปนี้จริง (หัวใจชมพูสามมิติผิวมันเงาลอยกระจายรอบโลโก้
// หัวใจเล็กในช่องกลางตัว A ของเวิร์ดมาร์ก และต่างหูรูปหัวใจของนางแบบ)
// 🚨 **ไม่ใช่มงกุฎ 👑 ของ 123BET ที่เพิ่งอยู่ในไฟล์นี้** — ดรอปนี้ไม่มีมงกุฎเลย
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงชาด/ชมพูบลัชของ 123BET** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ **รอบนี้ยังเป็นธีมสว่าง แต่คนละค่าทุกตัว** — bg.json =
// {"mode":"color","color":"#f8b9f0"} = ชมพูพาสเทลอิ่มตัว
// 🚨🚨 **ไฟล์นี้คือจุดที่พลาดง่ายที่สุดของรอบ เพราะชุดเก่าที่ค้างอยู่ก็เป็น
// "แดง-ชมพูบนผิวสว่าง" เหมือนรอบนี้** — ต้องเทียบ **ตรงหกหลัก** ทุกค่า
// ⚠️⚠️ **a30d1a (123BET, แดง) ↔ #a30d63 (รอบนี้, ชมพู) ต่างกันสองหลักท้ายเท่านั้น**
// และ **d91a73 (okkub88) ↔ #d11a7e · f7dfe4 fdf5f6 ↔ #fcd9ee #fff5fb**
// ลำดับผิว: #ffffff การ์ดขาว / #fff5fb การ์ดสำรอง / **#fcd9ee ผิวยก (ใบนี้)** /
// #f3a7d3 เส้นบาง / #f8b9f0 พื้นเพจ · หมึก **#3d0a2c** (= BRAND_TEXT)
// ✅ คอนทราสต์ที่ตรวจเองรอบนี้บนผิวยก #fcd9ee: **#3d0a2c = 12.7:1** ·
// **#a30d63 = 5.8:1** · **#7a4263 = 5.9:1** — ผ่าน AA ทั้งสามค่าในฐานะ normal text
//
// จังหวะรูปทรงของใบนี้: เป็น **การ์ดมุมตัด 36px ที่มุมซ้ายบน-ขวาล่าง** นั่งอยู่ที่
// **ผิวยก #fcd9ee ทึบ** · §4 กับ §5 เป็นบล็อกรูปสองใบที่อยู่ติดกัน จึงถูกแยกสี่อย่าง
// พร้อมกัน: **รูปทรง** (มุมตัดเฉียง vs มุมกลม 22px) · **ความลึกของผิว**
// (ผิวยก #fcd9ee vs การ์ดสำรอง #fff5fb แบบนูน neumorphic) · **การตกแต่งขอบ**
// (เส้นรูดสี่มุม vs เงานูนคู่) · **การจัดหัวข้อ** (ชิปถมชมพูเข้มคู่กลีฟหัวใจใน
// สายปกติ vs หัวข้อทึบ + แถบตั้ง)
// ⚠️ และใบนี้แยกจาก **§2 ContentBoxTwoCyberCut** (มุมตัด 30px บนผิว #fff5fb หัวข้อ
// จัดกึ่งกลางใต้แถบสั้น) — ที่นี่เส้นรูดสี่มุมเป็น **#d11a7e / #ff7ac2 / #e0509f /
// #f3a7d3** และหัวข้อเป็น **#a30d63 ทึบสีเดียวชิดซ้าย** ไม่ใช่ bg-clip-text
// ⚠️ กลีฟ ♥ จึง **ไม่ได้ถูกทาเป็นสีลอย ๆ** แต่ถูกวางบน **ชิปถมชมพูเข้ม #7a0449
// พร้อมหมึกขาว** (10.8:1) ตาม §2 ซึ่งเป็นสต็อปเข้มสุดของสูตรปุ่มหลัก
// — และตรงกับแคปซูลพื้นชมพูเข้มบนอาร์ตเวิร์กอยู่แล้ว กลีฟนับเป็น **ตัวอักษร**
// ไม่ใช่เส้น จึงต้องมีพื้นถมรองรับเสมอ (เป็น span aria-hidden และเป็น **พี่น้อง**
// ของหัวข้อ ไม่ใช่อักขระในข้อความ)
// 🚨 **ห้ามใช้พื้นชิปอ่อนกว่า #d11a7e** — ขาวบนนั้นเหลือ 5.0:1 และอ่อนกว่านั้น
// (#e0509f = 3.6:1) ตกต่ำกว่า 4.5:1 ทันที
// เส้นคั่นและขอบการ์ดเป็น #f3a7d3 อิ่มเป็น #e0509f ตอน hover
// ⚠️ **#f3a7d3 / #fcd9ee / #e0509f / #ff7ac2 ห้ามถือตัวอักษรบนผิวสว่าง** —
// ในไฟล์นี้อยู่ที่ขอบ เส้นรูด และพื้นถมล้วน · **#a30d63 ใช้ทั้งหัวข้อที่นี่และ
// <strong> ในย่อหน้า** ซึ่งเป็นงานของหน้าเพจ
// ⚠️ **#f2c14e ถือตัวอักษรได้เฉพาะบนโครมเข้ม จึงไม่อยู่ในไฟล์นี้เลยสักจุด**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(43,6,32,α)
// **เงาบนการ์ดสว่างต้องเบา**: ปกติ rgba(61,10,44,0.10) · hover rgba(163,13,99,0.18)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์ชมพูจริง และรีโปนี้
// มีชมพู/แดงของแบรนด์อื่นอยู่สิบชุดขึ้นไป** "มีชมพูอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// ชมพูรอบนี้คือ **#a30d63 (R163 G13 B99) / #d11a7e / #7a0449 / #e0509f / #ff7ac2 /
// #f3a7d3 / #fcd9ee / #fff5fb / #f8b9f0** หมึกคือ **#3d0a2c / #7a4263** ทองคือ
// **#6e4705 (ผิวสว่าง) / #f2c14e (โครมเท่านั้น)** และโครมคือ **#440d31 / #2b0620 /
// #5e1746 / #ffeef8 / #e8c3da**
// ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (**123BET**): a30d1a c21325 8a1420
// 36080f 6b2b33 f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 dca53a ef4a5e
// + rgba(163,13,26) rgba(220,165,58) rgba(217,143,160) rgba(54,8,15)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-abm96.md §2b — ไม่ซ้ำ
// ลงที่นี่โดยตั้งใจ** ตัวที่เสี่ยงสูงสุดรอบนี้คือ **LOTTOPLUS (ขาออกทันที) ·
// okkub88 + ถอนชัวร์168 (ชมพูเหมือนกัน) · 123BET + ZANE96 (เจ้าของไฟล์ที่หมุนเข้ามา)**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีแดงชาด
// และไม่มีแรมป์เทาเงิน** — ชิปคาสิโนชมพู-ขาว ไพ่เอซ ลูกเต๋าชมพู วงล้อรูเล็ตขอบทอง
// และหัวใจสามมิติบนสไลด์เป็น **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f3a7d3] bg-[#fcd9ee] p-8 text-[#3d0a2c] shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-300 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)]"
    style="clip-path: polygon(36px 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%, 0 36px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d11a7e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff7ac2] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e0509f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f3a7d3] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#f3a7d3] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#7a0449] text-xs leading-none text-[#ffffff]">
                ♥
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#a30d63]">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3d0a2c] md:border-l md:border-[#f3a7d3] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#f3a7d3] pb-2">
              <span aria-hidden="true" class="flex h-6 w-6 shrink-0 translate-y-1 items-center justify-center rounded-md bg-[#7a0449] text-xs leading-none text-[#ffffff]">
                ♥
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#a30d63]">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
