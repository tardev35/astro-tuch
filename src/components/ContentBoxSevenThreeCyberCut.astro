---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): กรอบมุมตัดกับเส้นไรผมเป็นเขียวลึก
// #1a7a08 บนผิวการ์ดดำอมเขียว #071007 หัวข้อเป็นเขียวนีออนทึบ #8bfc13 ต่างจาก
// หัวข้อโครเมียมของ SevenThreeNeumorphism ที่อยู่ล่างลงไปบนหน้าเดียวกัน ทั้งสอง
// บล็อกจึงคนละจังหวะสายตาทั้งสี รูปทรง และด้านที่วางรูป เส้นรูดสี่มุมจับคู่สองโทน
// ของโลโก้ไขว้กัน — เขียวนีออน คู่เขียวลึก บนแนวหนึ่ง โครเมียมขาว #e8f0e6 คู่
// โครเมียมหม่น #8fa38a บนอีกแนวหนึ่ง พรอมป์ &gt;_ เป็นเขียวอ่อน #c9ff8f เนื้อความ
// #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่ค้างในไฟล์นี้ (#dc020e
// #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #120b0c #f0e2e2) หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#1a7a08]/80 bg-[#071007]/92 p-8 text-[#d5e6cd] shadow-[0_10px_30px_rgba(139,252,19,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#8bfc13]/70 hover:shadow-[0_15px_40px_rgba(139,252,19,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#8bfc13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8fa38a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e8f0e6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1a7a08] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#1a7a08]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c9ff8f]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#8bfc13] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd] md:border-l md:border-[#1a7a08]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#1a7a08]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#c9ff8f]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#8bfc13] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
