---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// COLUMN ORDER: TEXT (7fr) then IMAGE (3fr) — `title` is the shorthand for the
// LEFT column's heading and the picture goes in slot="right". Only one column
// ever carries a heading on the page: the image column is passed no
// `titleright`, so this block emits exactly one docx heading. The title rail is
// in normal flow (never `absolute`) and carries no `whitespace-nowrap`, so there
// is no floating badge here and no vertical-clearance arithmetic to do — a
// two-line title at mobile width pushes the slot down instead of covering it,
// and `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก — แก้
// ค่าใดต่อไปนี้ต้องไปแก้หน้าแรกด้วย (section max-w-7xl/1280 + px-4(32) · card
// border 1×2=2 · p-8(64) · grid gap-8(32) · คอลัมน์รูปมี md:border-l(1) +
// md:pl-8(32) = 33 อยู่ในกล่องของมันเอง):
//   ≥1280px   : (1280 − 32 − 2 − 64 − 32) × 0.3 − 33 = 345 − 33 = 312px
//   md..1279  : (100vw − 130) × 0.3 − 33             = calc(30vw − 72px)
//   698..767  : คอลัมน์เดียวที่ p-8 กว้างเกิน 600 จึงติดเพดาน max-w-[600px] = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
//
// รอบนี้ (2026-10-11, brand-spec §2-§4): กล่องนี้ถือ docx H3 #5 ("โปรโมชั่น
// แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ **slide1** ซึ่งพิมพ์คำว่า โปรโมชั่น /
// แนะนำเพื่อน / โบนัส 0.8% ไว้ในภาพ — ตัวเลขบนภาพเป็นตัวตัดสินการจับคู่
//
// การ์ดมุมตัดใบที่ "ลึก" ที่สุดของหน้านี้ — ผิวจม #0d0b06 เทียบกับ
// ContentBoxCyberCut ที่เป็นผิวยก #231c0e สองใบมุมตัดจึงอยู่คนละปลายของลำดับความลึก
// ⚠️ พื้นเพจรอบนี้ดำสนิท #000000 จึงไม่มีผิวไหน "จม" ต่ำกว่าพื้นได้ #0d0b06 ยังสว่าง
// กว่าพื้นอยู่ การ์ดยังลอย เพียงลอยน้อยที่สุดในหน้า
// หัวข้อเป็นทองแบรนด์ทึบ #e5a81b (13.6:1 บนผิวจม) ซึ่งเป็นกล่อง docx เดียวบนหน้านี้ที่
// หัวข้อเป็นสีทึบ ไม่ใช่ตัวอักษรไล่เฉด ต่างจาก ContentBoxSevenThreePremium ที่เป็นคู่
// ของมันและไล่เฉดทอง→เงิน ทั้งสองบล็อก SevenThree จึงคนละจังหวะสายตาทั้งรูปทรง
// (มุมตัด vs มุมโค้ง) ผิว (จม vs ไล่เฉด) และสีหัวข้อ (ทึบ vs ไล่เฉด)
// เส้นรูดสี่มุมจับคู่ทอง-เงินไขว้กัน — ทองแบรนด์ #e5a81b คู่ทองสว่าง #ffe08a บนแนวนอน
// เงินแบรนด์ #b9c2cc คู่เงินหม่น #8792a0 บนแนวตั้ง เครื่องหมาย ◆ เป็นเงินแบรนด์
// อ้างถึงเลข 324 เงินโครเมียมในโลโก้ (เป็น span aria-hidden ไม่ใช่เนื้อหา)
// เส้นคั่นเป็นทองดำ #43300a
// เนื้อความ #f0e8d4 (= BRAND_TEXT) — 17.0:1 บนผิวจม ซึ่งเป็นคอนทราสต์สูงสุดของหน้า
//
// ⚠️ เทียบสีเป็นค่า ไม่ใช่ตระกูลสี: ชุดชมพูฮอต-ทองบนพลัมดำของแบรนด์รอบก่อนหน้าทันที
// (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a #7a0046 #4d002b
// #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มอำพันที่เคยค้างในไฟล์นี้
// (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #0d0903 #171106
// #1f1709 #f6ecd9) ชุดทองอวกาศ-เงินโครเมียม (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #cfd6e3 #eef2f8 #9aa6bb #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400
// #241700) ชุดทองสายฟ้า-แดงเลือดนก (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a) ชุด
// เขียวป่า-ทองมงกุฎ (#8ce023 #f2c230 #ffe066 #a87a08 #051400) และชุดม่วงนีออน-ทอง
// (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05 #1e0a3c) ออกครบทุกจุดแล้ว —
// รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีเขียว ไม่มีม่วง และไม่มีส้ม
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e5a81b]/40 bg-[#0d0b06]/96 p-8 text-[#f0e8d4] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe08a]/75 hover:shadow-[0_15px_40px_rgba(229,168,27,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e5a81b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffe08a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#b9c2cc] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8792a0] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e8d4]">
        {
          leftHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#43300a] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#b9c2cc]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e5a81b] uppercase">{leftHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e8d4] md:border-l md:border-[#43300a] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#43300a] pb-2">
              <span aria-hidden="true" class="shrink-0 text-[#b9c2cc]">
                ◆
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#e5a81b] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
