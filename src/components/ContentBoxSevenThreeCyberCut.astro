---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#6d1750]/55 bg-[#08030f]/92 p-8 text-[#dfd0ee] shadow-[0_10px_30px_rgba(229,57,159,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#e5399f]/60 hover:shadow-[0_15px_40px_rgba(229,57,159,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f4ebff] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e5399f] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#dfd0ee] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#22c6f0] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6d1750]/55 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ff6fd0]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f4ebff] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfd0ee] md:border-l md:border-[#6d1750]/55 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#6d1750]/55 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ff6fd0]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f4ebff] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
