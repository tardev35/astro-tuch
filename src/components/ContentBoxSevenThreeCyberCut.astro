---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Neumorphism sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// BRAZIL999 (รอบเขียว-โครเมียม-ดำ 2026-09-25): กรอบมุมตัดกับเส้นไรผมเป็นเขียวลึก
// #1c5a26 บนพื้นการ์ดเขียวเข้ม #0a1a0c หัวข้อเป็นเขียวสว่างทึบ #b6ff9c ต่างจาก
// หัวข้อสีเดียวของ SevenThreeNeumorphism ที่วางอยู่เหนือมันบนหน้าเดียวกัน เส้นรูด
// สี่มุมจับคู่สองวัสดุของแบรนด์ไขว้กัน — เขียวแบรนด์ #22c55e คู่เขียวลึก #1c5a26 บน
// แนวหนึ่ง โครเมียมสว่าง #f1f5f9 คู่เขียวสว่าง #7cf25c บนอีกแนวหนึ่ง เนื้อความ
// #dfeadd (BRAND_TEXT) — ทอง-โครเมียม-ดำของ UWIN33 (#7a5407 #161106 #fde9a3
// #e0b429 #dfe4ec #fbd564 #ece6d8) หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#1c5a26]/80 bg-[#0a1a0c]/92 p-8 text-[#dfeadd] shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#22c55e]/70 hover:shadow-[0_15px_40px_rgba(34,197,94,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#22c55e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#1c5a26] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f1f5f9] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#7cf25c] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#1c5a26]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#22c55e]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#b6ff9c] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd] md:border-l md:border-[#1c5a26]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#1c5a26]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#22c55e]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#b6ff9c] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
