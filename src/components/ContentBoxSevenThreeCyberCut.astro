---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// YADOM168 palette: near-black green card surface (#071508) inside a clipped
// deep-green frame, with the corner rules split brand green (#8fe06f / #1d6b18)
// on one diagonal and coin gold (#e6bd5c / #9c8340) on the other — the artwork's
// neon-green lightning against its gold coins. The heading and the `>_` marker
// take green.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0f3d0d]/85 bg-[#071508]/92 p-8 text-[#d4e8cb] shadow-[0_10px_30px_rgba(92,194,63,0.20)] backdrop-blur-md transition-all duration-300 hover:border-[#5cc23f]/70 hover:shadow-[0_15px_40px_rgba(92,194,63,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#8fe06f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#1d6b18] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e6bd5c] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#9c8340] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#0f3d0d]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#5cc23f]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#8fe06f] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb] md:border-l md:border-[#0f3d0d]/85 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#0f3d0d]/85 pb-2">
              <span aria-hidden="true" class="font-mono text-[#5cc23f]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#8fe06f] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
