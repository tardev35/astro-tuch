---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it — same prop shape as the Premium sibling. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline. The
   *  `as` prop is what decides the tag — no level is hardcoded in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened: `isolate` on the card, `-z-10` on the four corner rules, each
// column's text classes on its own <article> with the slot as a direct child.
// The headings carry `leading-normal` so the hoisted `leading-relaxed` cannot
// leak into them. Do not re-add a wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading. The title
// rail is in normal flow (never `absolute`) and carries no `whitespace-nowrap`,
// so a two-line title at mobile width pushes the slot down instead of covering
// it; `min-w-0` lets the heading wrap inside the flex row rather than overflow.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): กรอบมุมตัดกับเส้นไรผมเป็นแดงแบรนด์
// #c50d12 บนพื้นการ์ดยกระดับ #241a1a หัวข้อเป็นขาวเงินทึบ #f4f7fa ต่างจากหัวข้อ
// แบบไล่เฉดของ SevenThreePremium ที่วางอยู่เหนือมันบนหน้าเดียวกัน เส้นรูดสี่มุม
// จับคู่สองสีของแบรนด์ไขว้กัน — ขาวเงินคู่แดงสด #ef1f25 บนแนวหนึ่ง เงินหลัก
// #b8c3cf คู่แดงแบรนด์บนอีกแนวหนึ่ง ชมพูมาเจนตา-ทองของ WY88 หายไปทั้งหมด
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#c50d12]/80 bg-[#241a1a]/92 p-8 text-[#cdd5dd] shadow-[0_10px_30px_rgba(197,13,18,0.24)] backdrop-blur-md transition-all duration-300 hover:border-[#b8c3cf]/70 hover:shadow-[0_15px_40px_rgba(184,195,207,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f4f7fa] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#c50d12] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ef1f25] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#b8c3cf] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#c50d12]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ef1f25]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f4f7fa] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd] md:border-l md:border-[#c50d12]/80 md:pl-8">
        {
          rightHeading && (
            <div class="flex items-baseline gap-2 border-b border-[#c50d12]/80 pb-2">
              <span aria-hidden="true" class="shrink-0 font-mono text-[#ef1f25]">
                &gt;_
              </span>
              <HeadingTag class="min-w-0 text-xl leading-normal font-black text-[#f4f7fa] uppercase">{rightHeading}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
