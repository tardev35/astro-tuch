---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// PAOTUNG is a multi-game portal, so the board lists the หมวดเกม the brief's own
// four game types describe — สล็อตออนไลน์ที่จัดเต็มด้วยแสงเงาแบบ Cinematic
// Lighting, บาคาร่าและคาสิโนสดจากโต๊ะวีไอพีที่ส่งสัญญาณภาพสดจากคาสิโนชั้นนำ,
// หวยรัฐบาล หวยลาว หวยฮานอย ที่จ่ายเต็มไม่มีอั้น, และเดิมพันกีฬา มวย กับฟุตบอล
// ครบทุกลีกดัง — บวกกับ Portal ที่ผูกกับระบบฝาก-ถอนอัตโนมัติ และการเข้าใช้งานได้
// ทุกอุปกรณ์โดยไม่ต้องโหลดแอปพลิเคชัน. No payout promise and no win-rate figure:
// the brief states only ว่าทุกเกมเป็นลิขสิทธิ์แท้และเดิมพันเริ่มต้นเพียง 1 บาท.
//
// The board title is a <p> — this is chrome, not a docx heading — so the
// <section> takes its accessible name from aria-label instead. The 🥇🥈🥉 replace
// the rank NUMBER for the top three, so each keeps its aria-hidden + sr-only pair.
const games = [
  { rank: 1, name: "สล็อตออนไลน์ลิขสิทธิ์แท้ทุกค่าย", type: "สล็อต • แสงเงาสมจริงระดับ Cinematic Lighting", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "บาคาร่าและคาสิโนสดโต๊ะวีไอพี", type: "คาสิโนสด • สัญญาณภาพสดจากคาสิโนชั้นนำ", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "หวยรัฐบาล หวยลาว หวยฮานอย", type: "หวยออนไลน์ • อัตราจ่ายสูง จ่ายเต็มไม่มีอั้น", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "มวยและฟุตบอลครบทุกลีกดัง", type: "กีฬา • อัปเดตราคาค่าน้ำดีที่สุด ครบทุกแมตช์", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "เล่นได้ทุกอุปกรณ์ ไม่ต้องโหลดแอป", type: "อุปกรณ์ • iOS Android แท็บเล็ต และคอมพิวเตอร์พีซี", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "Portal ฝาก-ถอนอัตโนมัติ", type: "ระบบ • ทุกธนาคารชั้นนำ เสร็จภายใน 3-5 วินาที", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมยอดนิยมของ PAOTUNG" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#eef6fd] uppercase">
      หมวดเกมยอดนิยมของ PAO<span class="text-[#e0bd72]">TUNG</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#cfdeed]/70">
      ทุกหมวดด้านล่างเล่นผ่าน Portal ของ PAOTUNG โดยตรง ทุกค่ายเป็นเกมลิขสิทธิ์แท้ที่เริ่มเดิมพันได้ตั้งแต่ 1 บาท ครอบคลุมทั้งสล็อต บาคาร่าและคาสิโนสด หวย และกีฬา
      รายการเกมที่เปิดให้เล่นในแต่ละหมวดเปลี่ยนแปลงได้ตามที่ระบบเปิดให้บริการ จึงควรยึดหน้าเลือกเกมใน Portal เป็นข้อมูลล่าสุดเสมอ
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e0bd72] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e0bd72]/60 bg-gradient-to-r from-[#0a325a]/95 via-[#04203c]/92 to-[#04203c]/92 shadow-[0_15px_40px_rgba(224,189,114,0.26)]"
                : "border-[#226ca9]/55 bg-[#04203c]/92 shadow-[0_10px_30px_rgba(2,15,30,0.6)] hover:border-[#3b9ddd]/70 hover:shadow-[0_15px_40px_rgba(34,108,169,0.24)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#226ca9]/24 blur-[40px] transition-all duration-500 group-hover:bg-[#3b9ddd]/32"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#cfdeed]/60 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e0bd72]/60" : "border-[#226ca9]/55"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดเกมยอดนิยมของ PAOTUNG`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#eef6fd] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e0bd72]/70 bg-[#020f1e] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f5e3b3] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#7fc4f0] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#226ca9]/65 bg-[#020f1e] px-2.5 py-0.5 text-[10px] font-bold text-[#cfdeed]/70">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#cfdeed]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] text-[#020f1e] shadow-[0_10px_30px_rgba(224,189,114,0.30)]"
                    : "border border-[#226ca9]/65 bg-[#020f1e] text-[#7fc4f0] hover:border-[#3b9ddd] hover:bg-[#0a325a]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
