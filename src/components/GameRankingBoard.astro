---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// NEXT55 is a คาสิโนออนไลน์เว็บตรงครบวงจร, so the board lists the หมวดเกม the
// brief's own five game types describe — บาคาร่าและคาสิโนสดระดับ Full HD จาก
// คาสิโนชั้นนำ, สล็อตออนไลน์ลิขสิทธิ์แท้, เกมยิงปลา, หวยรัฐบาล ลาว ฮานอย ที่
// จ่ายเต็มไม่มีเลขอั้น, และแทงบอลกับกีฬาทุกลีกดัง — บวกกับระบบฝาก-ถอนออโต้ที่ไม่มี
// ขั้นต่ำ. No payout promise and no win-rate figure: the brief states only that
// every game is ลิขสิทธิ์แท้ and that เดิมพันเริ่มต้นเพียง 1 บาท.
//
// The board title is a <p> — this is chrome, not a docx heading — so the
// <section> takes its accessible name from aria-label instead. The 🥇🥈🥉 replace
// the rank NUMBER for the top three, so each keeps its aria-hidden + sr-only pair.
const games = [
  { rank: 1, name: "บาคาร่าและคาสิโนสดโต๊ะวีไอพี", type: "คาสิโนสด • ถ่ายทอดสดคมชัดระดับ Full HD จากคาสิโนชั้นนำ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img3 },
  { rank: 2, name: "สล็อตออนไลน์ลิขสิทธิ์แท้ทุกค่าย", type: "สล็อต • แจ็คพอตแตกง่าย ฟีเจอร์แน่น ภาพสวยตระการตา", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img6 },
  { rank: 3, name: "เกมยิงปลา กราฟิกสวยงาม", type: "ยิงปลา • เล่นง่าย ตายไว ทำกำไรได้รวดเร็ว", menus: ["ยอดนิยม", "เกมใหม่"], players: 3517, img: img1 },
  { rank: 4, name: "หวยรัฐบาล หวยลาว หวยฮานอย", type: "หวยออนไลน์ • จ่ายหนัก จ่ายเต็ม ไม่มีเลขอั้น", menus: ["ยอดนิยม", "รายการโปรด"], players: 2905, img: img2 },
  { rank: 5, name: "แทงบอลและกีฬาทุกลีกดัง", type: "กีฬา • ค่าน้ำดีที่สุด รูปแบบการแทงหลากหลาย", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2431, img: img4 },
  { rank: 6, name: "ฝาก-ถอนออโต้ ไม่มีขั้นต่ำ", type: "ระบบ • ทุกธนาคารและ TrueMoney Wallet ภายใน 5 วินาที", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมยอดนิยมของ NEXT55" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#e7eaef] uppercase">
      หมวดเกมยอดนิยมของ NEXT<span class="text-[#f0435f]">55</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c3c8d1]/70">
      ทุกหมวดด้านล่างเล่นผ่านเว็บตรงของ NEXT55 โดยตรง ไม่ผ่านเอเย่นต์ ทุกค่ายเป็นเกมลิขสิทธิ์แท้ที่เริ่มเดิมพันได้ตั้งแต่ 1 บาท ครอบคลุมทั้งบาคาร่าและคาสิโนสด สล็อต ยิงปลา หวย และกีฬา
      รายการเกมที่เปิดให้เล่นในแต่ละหมวดเปลี่ยนแปลงได้ตามที่ระบบเปิดให้บริการ จึงควรยึดหน้าเลือกเกมในเว็บไซต์เป็นข้อมูลล่าสุดเสมอ
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#cd1437] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#cd1437]/70 bg-gradient-to-r from-[#22242a]/95 via-[#17181c]/92 to-[#17181c]/92 shadow-[0_15px_40px_rgba(205,20,55,0.26)]"
                : "border-[#3a3d45] bg-[#17181c]/92 shadow-[0_10px_30px_rgba(0,0,0,0.6)] hover:border-[#cd1437]/60 hover:shadow-[0_15px_40px_rgba(205,20,55,0.20)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#cd1437]/20 blur-[40px] transition-all duration-500 group-hover:bg-[#f0435f]/30"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#c3c8d1]/60 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#cd1437]/70" : "border-[#3a3d45]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดเกมยอดนิยมของ NEXT55`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e7eaef] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#cd1437]/70 bg-[#0c0d10] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#ffb3bf] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#ffb3bf] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#3a3d45] bg-[#0c0d10] px-2.5 py-0.5 text-[10px] font-bold text-[#c3c8d1]/70">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c3c8d1]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#cd1437] text-[#0c0d10] shadow-[0_10px_30px_rgba(205,20,55,0.30)]"
                    : "border border-[#3a3d45] bg-[#0c0d10] text-[#ffb3bf] hover:border-[#cd1437] hover:bg-[#22242a]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
