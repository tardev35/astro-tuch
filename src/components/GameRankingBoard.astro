---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// VAK88 is a slot brand, so the board lists the หมวดสล็อต the brief's own claims
// describe — ค่ายยักษ์ใหญ่ระดับโลกที่นำเข้าด้วย Certified API, กราฟิกคมชัดระดับ
// Cinematic Lighting, อัตราการชนะ (RTP) มาตรฐานสากล, การเข้าเล่นผ่านเว็บเบราว์เซอร์
// บนทุกอุปกรณ์, และ Portal หลักที่ผูกกับระบบฝาก-ถอนอัตโนมัติ. No payout promise and
// no win-rate figure: the brief states only that RTP เป็นมาตรฐานสากล และไม่มีการ
// ดัดแปลงเปอร์เซ็นต์การชนะ.
//
// The board title is a <p> — this is chrome, not a docx heading — so the
// <section> takes its accessible name from aria-label instead. The 🥇🥈🥉 replace
// the rank NUMBER for the top three, so each keeps its aria-hidden + sr-only pair.
const games = [
  { rank: 1, name: "สล็อตค่ายยักษ์ใหญ่ระดับโลก", type: "สล็อต • นำเข้าด้วย Certified API ลิขสิทธิ์แท้ 100%", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตกราฟิก Cinematic Lighting", type: "สล็อต • ภาพคมชัดและแสงเงาสมจริงในทุกการสปิน", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "สล็อต RTP มาตรฐานสากล", type: "สล็อต • ไม่มีการดัดแปลงเปอร์เซ็นต์การชนะ", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "สล็อตบนสมาร์ทโฟน iOS และ Android", type: "อุปกรณ์ • เข้าเล่นผ่านเบราว์เซอร์ ไม่ต้องดาวน์โหลดแอป", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตบนคอมพิวเตอร์และแท็บเล็ต", type: "อุปกรณ์ • รองรับทุกอุปกรณ์อย่างสมบูรณ์แบบ", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "Portal หลัก ฝาก-ถอนอัตโนมัติ", type: "ระบบ • ประมวลผลภายใน 3-5 วินาที ไม่มีขั้นต่ำ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดสล็อตยอดนิยมของ VAK88" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#fff4dd] uppercase">
      หมวดสล็อตยอดนิยมของ VAK<span class="text-[#e6b23c]">88</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#ded8ca]/70">
      ทุกหมวดด้านล่างเล่นผ่านช่องทางเข้าเล่นหลักของ VAK88 โดยตรง เกมทุกค่ายได้รับการตรวจสอบและอนุญาตจากลิขสิทธิ์แท้ 100% พร้อมอัตราการชนะ (RTP) ที่เป็นมาตรฐานสากล
      รายการเกมที่เปิดให้เล่นในแต่ละหมวดเปลี่ยนแปลงได้ตามที่ระบบเปิดให้บริการ จึงควรยึดหน้าเลือกเกมใน Portal หลักเป็นข้อมูลล่าสุดเสมอ
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e6b23c] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e6b23c]/60 bg-gradient-to-r from-[#121a2e]/95 via-[#0b1020]/92 to-[#0b1020]/92 shadow-[0_15px_40px_rgba(230,178,60,0.28)]"
                : "border-[#8a5f14]/60 bg-[#0b1020]/92 shadow-[0_10px_30px_rgba(3,6,14,0.6)] hover:border-[#e6b23c]/70 hover:shadow-[0_15px_40px_rgba(230,178,60,0.25)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#e6b23c]/22 blur-[40px] transition-all duration-500 group-hover:bg-[#e6b23c]/32"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ded8ca]/60 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e6b23c]/60" : "border-[#8a5f14]/60"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดสล็อตยอดนิยมของ VAK88`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#fff4dd] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e6b23c]/70 bg-[#060913] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#e6b23c] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#ffd873] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#8a5f14]/70 bg-[#060913] px-2.5 py-0.5 text-[10px] font-bold text-[#ded8ca]/70">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#ded8ca]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd873] via-[#e6b23c] to-[#8a5f14] text-[#060913] shadow-[0_10px_30px_rgba(230,178,60,0.30)]"
                    : "border border-[#8a5f14]/70 bg-[#060913] text-[#e6b23c] hover:border-[#e6b23c] hover:bg-[#121a2e]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
