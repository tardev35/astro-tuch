---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// SUPERMAX168 is a คาสิโนเว็บตรง brand, so the board lists the หมวดเกม the brief
// names — บาคาร่า สล็อต บอล หวย และไฮโล — plus the คาสิโนสด grouping ไฮโล sits in.
// No payout promise and no "แตกง่าย" claim: the brief says กติกา อัตราจ่าย และ
// วงเงินเดิมพัน that the system shows are what a member checks before betting.
const games = [
  { rank: 1, name: "บาคาร่าออนไลน์", type: "คาสิโน • เกมไพ่ที่เล่นบ่อยที่สุดในระบบ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตออนไลน์หลายค่าย", type: "สล็อต • เลือกค่ายและเกมจากบัญชีเดียว", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "เดิมพันฟุตบอล", type: "กีฬา • เปิดรับตามรายการแข่งขัน", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "ไฮโลออนไลน์", type: "คาสิโน • โต๊ะไฮโลในหมวดคาสิโนสด", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "หวยออนไลน์", type: "หวย • เปิดรับตามรอบที่ระบบกำหนด", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "เกมไพ่และโต๊ะคาสิโนอื่น", type: "คาสิโน • ตรวจกติกาและอัตราจ่ายของโต๊ะก่อนเริ่ม", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมคาสิโนยอดนิยมของ SUPERMAX168" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#f3e6c8] uppercase">
      หมวดเกมคาสิโนยอดนิยมของ <span class="text-[#f9e38b]">SUPER</span><span class="text-[#e3e3e4]">MAX</span><span class="text-[#f9e38b]">168</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f3e6c8]/70">
      แต่ละหมวดให้ดูกติกา อัตราจ่าย และวงเงินเดิมพันของเกมนั้นก่อนทำรายการ รายการที่เปิดรับในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา และเงื่อนไขของแต่ละโต๊ะหรือแต่ละรอบอาจแตกต่างกัน
      จึงควรตรวจสอบรายละเอียดที่ระบบแสดงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3e3e4] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ecc964]/60 bg-gradient-to-r from-[#1b140b]/95 via-[#0d0904]/92 to-[#0d0904]/92 shadow-[0_15px_40px_rgba(236,201,100,0.30)]"
                : "border-[#ba8219]/60 bg-[#0d0904]/92 shadow-[0_10px_30px_rgba(3,2,1,0.55)] hover:border-[#ecc964]/70 hover:shadow-[0_15px_40px_rgba(236,201,100,0.25)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ecc964]/22 blur-[40px] transition-all duration-500 group-hover:bg-[#ecc964]/32"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#f3e6c8]/60 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ecc964]/60" : "border-[#ba8219]/60"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดเกมคาสิโนยอดนิยมของ SUPERMAX168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#fff8e2] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e3e3e4]/70 bg-[#030201] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#e3e3e4] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#f9e38b] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#ba8219]/70 bg-[#030201] px-2.5 py-0.5 text-[10px] font-bold text-[#f3e6c8]/70">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#f3e6c8]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f9e38b] via-[#e3e3e4] to-[#ecc964] text-[#030201] shadow-[0_10px_30px_rgba(236,201,100,0.30)]"
                    : "border border-[#ba8219]/70 bg-[#030201] text-[#e3e3e4] hover:border-[#e3e3e4] hover:bg-[#1b140b]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
