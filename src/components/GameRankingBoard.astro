---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// HERO1688 is a สล็อตออโต้เว็บตรง brand, so the board lists only the หมวดสล็อต
// the brief names — สล็อตคลาสสิก เกมโบนัส ฟรีสปิน และเกมรูปแบบใหม่ตามที่แต่ละค่าย
// เปิดให้บริการ — plus the บัญชีเดียว/หลายอุปกรณ์ grouping the brief describes.
// No payout promise and no "แตกไว" claim: the brief states outright that ผลลัพธ์
// ของเกมสล็อตเป็นไปตามระบบของแต่ละเกม จึงรับประกันไม่ได้.
//
// The board title is a <p> — this is chrome, not a docx heading — so the
// <section> takes its accessible name from aria-label instead.
const games = [
  { rank: 1, name: "สล็อตคลาสสิก", type: "สล็อต • หมวดที่สมาชิกเปิดเล่นบ่อยที่สุด", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "เกมโบนัสในเกมสล็อต", type: "สล็อต • ฟีเจอร์โบนัสตามกติกาของแต่ละเกม", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "ฟรีสปิน", type: "สล็อต • จำนวนรอบและเงื่อนไขต่างกันตามเกม", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "เกมสล็อตรูปแบบใหม่", type: "สล็อต • เปิดเพิ่มตามที่แต่ละค่ายปล่อยเข้าระบบ", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตหลายค่ายในบัญชีเดียว", type: "ระบบ • ค้นหาเกมและสลับค่ายจากบัญชีเดียว", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "สล็อตบนมือถือและแท็บเล็ต", type: "อุปกรณ์ • เข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทุกเครื่อง", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมสล็อตยอดนิยมของ HERO1688" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#f4f7fb] uppercase">
      หมวดเกมสล็อตยอดนิยมของ <span class="text-[#ff5a5d]">HERO</span><span class="text-[#c4c5ca]">1688</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#dbe1ea]/70">
      แต่ละหมวดให้ดูกติกา ช่วงเดิมพัน และรูปแบบการจ่ายของเกมนั้นก่อนเริ่มหมุนทุกครั้ง เกมที่เปิดให้เล่นในแต่ละหมวดเปลี่ยนแปลงได้ตามที่แต่ละค่ายปล่อยเข้าระบบ และเงื่อนไขของฟีเจอร์ในเกมอาจแตกต่างกัน
      จึงควรตรวจสอบรายละเอียดที่ระบบแสดงอีกครั้งก่อนเริ่มเล่น
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c4c5ca] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e11015]/60 bg-gradient-to-r from-[#1a0509]/95 via-[#080a12]/92 to-[#080a12]/92 shadow-[0_15px_40px_rgba(225,16,21,0.30)]"
                : "border-[#7d0507]/60 bg-[#080a12]/92 shadow-[0_10px_30px_rgba(1,2,7,0.55)] hover:border-[#e11015]/70 hover:shadow-[0_15px_40px_rgba(225,16,21,0.25)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#e11015]/22 blur-[40px] transition-all duration-500 group-hover:bg-[#e11015]/32"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#dbe1ea]/60 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e11015]/60" : "border-[#7d0507]/60"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดเกมสล็อตยอดนิยมของ HERO1688`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f4f7fb] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#c4c5ca]/70 bg-[#010207] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#e3e7ec] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#ff5a5d] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#7d0507]/70 bg-[#010207] px-2.5 py-0.5 text-[10px] font-bold text-[#dbe1ea]/70">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#dbe1ea]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff5a5d] via-[#e3e7ec] to-[#e11015] text-[#010207] shadow-[0_10px_30px_rgba(225,16,21,0.30)]"
                    : "border border-[#7d0507]/70 bg-[#010207] text-[#e3e7ec] hover:border-[#e3e7ec] hover:bg-[#1a0509]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
