---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// WIN8S is a สล็อตออนไลน์ เว็บตรง brand, so the board lists the slot หมวด the
// brief names — สล็อตคลาสสิก สล็อตวิดีโอ เกมโบนัส ฟรีสปิน และเกมธีมต่าง ๆ.
// No payout promise and no "แตกง่าย" claim: the brief says the bet range shown
// in each game is what decides the real minimum, not a headline number.
const games = [
  { rank: 1, name: "สล็อตวิดีโอ", type: "สล็อต • เล่นบ่อยที่สุดในระบบ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตคลาสสิก", type: "สล็อต • รูปแบบวงล้อคลาสสิก", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "เกมโบนัสและฟรีสปิน", type: "สล็อต • ฟีเจอร์ตามเงื่อนไขของแต่ละเกม", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "สล็อตธีมแฟนตาซี", type: "สล็อต • เลือกตามธีมที่สนใจ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตธีมสัตว์และธรรมชาติ", type: "สล็อต • เกมใหม่ที่เพิ่งเปิดในระบบ", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "สล็อตช่วงเดิมพันต่ำ", type: "สล็อต • ตรวจช่วงเดิมพันในเกมก่อนเริ่มเล่น", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมสล็อตยอดนิยมของ WIN8S" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="text-2xl font-black tracking-widest text-[#f6e4d6] uppercase">
      หมวดเกมสล็อตยอดนิยมของ <span class="text-[#f36403]">WIN</span><span class="text-[#e3e7ec]">8S</span>
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#9aa3ad]">
      แต่ละหมวดให้ดูช่วงเดิมพัน รูปแบบการจ่าย และเงื่อนไขของฟีเจอร์ในเกมนั้นก่อนเริ่มเล่น รายชื่อเกมในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา และขั้นต่ำจริงอาจแตกต่างกันตามค่ายและเกม
      จึงควรตรวจสอบตัวเลขเดิมพันที่แสดงในเกมอีกครั้งก่อนกดหมุน
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3e7ec] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f36403]/60 bg-gradient-to-r from-[#2a0f03]/95 via-[#1c0a02]/92 to-[#1c0a02]/92 shadow-[0_15px_40px_rgba(243,100,3,0.30)]"
                : "border-[#8a3103]/60 bg-[#1c0a02]/92 shadow-[0_10px_30px_rgba(5,2,1,0.55)] hover:border-[#f36403]/70 hover:shadow-[0_15px_40px_rgba(243,100,3,0.25)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#f36403]/22 blur-[40px] transition-all duration-500 group-hover:bg-[#f36403]/32"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#9aa3ad] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#f36403]/60" : "border-[#8a3103]/60"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกหมวด ${g.name} ในกระดานหมวดเกมสล็อตยอดนิยมของ WIN8S`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#fff2e6] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e3e7ec]/70 bg-[#140300] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#e3e7ec] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#fd9a1e] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#8a3103] bg-[#140300] px-2.5 py-0.5 text-[10px] font-bold text-[#9aa3ad]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#9aa3ad]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fd9a1e] via-[#e3e7ec] to-[#f36403] text-[#140300] shadow-[0_10px_30px_rgba(243,100,3,0.30)]"
                    : "border border-[#8a3103]/70 bg-[#140300] text-[#e3e7ec] hover:border-[#e3e7ec] hover:bg-[#2a0f03]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
