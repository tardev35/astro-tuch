---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-ruaythear168.md §2
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (นินจา168) ใช้ Faq4 จึงหมุนมาที่นี่
// และไฟล์นี้ยังถือพาเลตต์ของสบายเบท168 อยู่ทั้งไฟล์ ต้องรีเธมทั้งใบก่อนใช้
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียงบนผิวจม ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่นของตัวเอง
// ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ ContentBoxTwoPremium กับ
// ContentBoxTwoNeumorphism ถือรูปทรงนั้นอยู่แล้วบนหน้าเดียวกัน
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #030f1d**
// ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#0b2d52 ยก / #071e38 กลาง / #030f1d จม /
// #000000 พื้น)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** ตาม bg.json จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// กรอบมุมตัดเฉียงเป็นน้ำเงินลึก #04366b ล้อมแผ่นผิวจม แถบไล่เฉดบนกรอบวิ่ง
// **ฟ้าอะซัวร์ #039cfa → ทองอำพัน #f9a826** = สองฮิวของรอบนี้อยู่บนขอบเดียวกัน
// (ตามโลโก้ที่คำว่า "รวย" เป็นทองและ "แทร่168" เป็นฟ้าอะซัวร์ ติดกันบนบรรทัดเดียว)
// ป้ายเครื่องหมายคำถามเป็น **แผ่นฟ้าทึบ** ไล่ฟ้าน้ำแข็ง #c3ebfc → ฟ้าอะซัวร์ #039cfa
// บนหมึก #031320 (§2 ระบุว่า #031320 เป็นหมึกตัวเดียวที่วางบนพื้นถมฟ้า/ทองได้ —
// 12.9:1 บน #c3ebfc และ 6.2:1 บน #039cfa ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง และห้าม
// ลากปลายเข้มของไล่เฉดลงไปถึง #04366b เพราะจะเหลือ ~1.15:1) กลีฟ ? เป็น aria-hidden
// จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **ฟ้าน้ำแข็ง #c3ebfc** (10.8:1 บนผิวยก สูงกว่านั้นบนผิวจม) ส่วนคำตอบเป็น
// สีเนื้อความ #e3f2fc (= BRAND_TEXT, 16.3:1 บนผิวจม) เส้นคั่นคำตอบเป็นบรอนซ์ลึก
// #704504 แบบโปร่ง และลูกศรเป็นทองอำพัน #f9a826
// หัวข้อเป็นไล่เฉด **สองสต็อป ฟ้าอะซัวร์ #039cfa → ทองอำพัน #f9a826** ซึ่งเป็นกล่อง
// เดียวของหน้าที่หัวข้อมีแค่สองสต็อป ทุกใบอื่นเป็นสามสต็อปหรือสีทึบ จึงไม่ซ้ำกับใบใด
// (§1 แผ่นถมไล่ ฟ้า→ฟ้าน้ำแข็ง→ทอง · §2 ฟ้าทึบกึ่งกลาง · §3 ฟ้าน้ำแข็ง→ทอง→ฟ้า ·
// §4 ทอง→ฟ้าน้ำแข็ง→ฟ้า · §5 ฟ้า→ทอง→ฟ้าน้ำแข็ง · §6 ฟ้าน้ำแข็ง→ฟ้า→ทอง ·
// §7 ทอง→ฟ้า→ฟ้าน้ำแข็ง) และขีดใต้หัวข้อเป็น **ทอง** ไม่ใช่ฟ้า
// §2 ห้าม #04366b #704504 ถือตัวอักษรทุกขนาด — ที่นี่ #04366b อยู่ที่กรอบ 1px และ
// #704504 อยู่ที่เส้นคั่นคำตอบเท่านั้น ไม่มีตัวอักษรไหนนั่งบนทั้งคู่
// glow ที่ใช้มีชุดเดียว rgba(249,168,38,α) ตาม §2
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองของตัวเอง การเจอทองอยู่แล้วจึงไม่พิสูจน์อะไร และ
// ฟ้าก็ไม่ปลอดภัยเพราะสองรอบก่อนหน้าเป็นฟ้าทั้งคู่ และ TSDET911 เคยเป็นน้ำเงินไฟฟ้า
// ทั้งชุดในไฟล์นี้
// ทองที่เคยผ่านไฟล์นี้: ffc82e ffefbb 5c4a16 (สบายเบท168 — ชุดที่เพิ่งถอดออกรอบนี้)
// fef54b 6b5c10 (นินจา168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e2b33f (KMD88) e5a81b
// (UFA324) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f2b705
// (SUPERSLOTCLUB) f7d14e (KOON234) ffd666 f2c230 ffe066 ffe49a 8a6210 —
// **ทองรอบนี้คือ #f9a826 (R=249 G=168 B=38) เท่านั้น** อำพันออกส้ม ไม่ใช่เหลือง
// ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้: 2f9ff5 a8dcff 0b3f78 (สบายเบท168) 32bcfb a9e9ff
// 07335f (นินจา168) 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42
// 040e26 00081f (TSDET911) — **ฟ้ารอบนี้คือ #039cfa / #c3ebfc / #04366b เท่านั้น**
// และ cfd9e6 (เงินอมฟ้าของรับตัง168) หน้าตาใกล้ฟ้าอ่อนมาก
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุดของ **สบายเบท168** (2f9ff5 a8dcff ffefbb 0b3f78
// ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f กับ rgba 255/200/46) ก่อนนั้นคือ
// ชุด **ทองไทย-โรสโกลด์-แดงชาด** ของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b
// 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุด **แดงเลือดนก-เงินโครเมียม**
// ของ TKB55 (fb131b ff4d55 e9eef4 aeb9c6 f2e4e5 0d0304 1a0304) ชุดชมพูฮอตพิงก์-ทอง
// ของ PUNPRO168 (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a0426 2a0012
// 3a0a2a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff e2b33f ffdf8c ece2f8 1d0832
// 140522 0a0213) ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d 7a0046
// 4d002b 2b0019) ชุดส้มอำพันเสือของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 1a0d02
// 2d1c0a 0f0903) และชุดมรกต-ทองของ KOON234 (0a6b32 2fbf6a cc920a f7d14e e8f2e6) —
// ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีโรสโกลด์
// ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** (cfd9e6 เป็นของรับตัง168 · e9eef4 aeb9c6
// เป็นของ TKB55 · fef54b เป็นของนินจา168 ห้ามเหลือไว้)
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#039cfa] to-[#f9a826] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f9a826] to-transparent shadow-[0_0_10px_rgba(249,168,38,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#04366b] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#039cfa] via-[#f9a826] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#030f1d] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#c3ebfc] to-[#039cfa] font-black text-[#031320] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#c3ebfc]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f9a826] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#704504]/70 pl-4 text-left text-base leading-relaxed text-[#e3f2fc]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
