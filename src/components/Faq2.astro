---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
// **Do not rewrite this back into a button + max-height accordion.**
//
// ───────────────────────────────────────────────────────────────────────────
// LOTTO189 (ดรอป 2026-10-27) — พาเลตตาม .claude/brand-spec-lotto189.md §2
// **แดงเลือดนกนำ · หมึกแดงจมเกือบดำ · บนธีมเนื้อหาสว่าง**
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (ZNOVA168) ใช้ Faq4 จึงหมุนมา
// ที่นี่ และไฟล์นี้ยังถือพาเลต **ชมพูบับเบิลกัมของ okkub88** อยู่ทั้งไฟล์ จึงรีเธม
// ทั้งใบก่อนใช้ หน้าแรกส่ง **docx H2 §8** มาให้ ("คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>"
// — content.txt บรรทัด 23) พร้อม prop `faqs` สามคู่จากบรรทัด 24–29 **แบบส่งชัดเจน
// ไม่พึ่ง default** (ไฟล์นี้ตั้งใจ ship ลิสต์ว่าง คำถามที่หายไปจึงเป็นหีบเปล่า
// ไม่ใช่คำถามของแบรนด์ก่อน)
//
// ⚠️ **ทิศของธีมเหมือนรอบที่ค้างอยู่ (สว่างทั้งคู่) แต่ฮิวคนละตระกูลสิ้นเชิง**
// bg.json = {"mode":"color","color":"#fff0f0"} = **ขาวอมชมพูจาง** (ชุดที่ค้างอยู่
// คือ ffd6fa ชมพูบับเบิลกัมพาสเทล — R≥B>G เหมือนกันแต่คนละค่าทุกไบต์)
// **ห้าม "แก้" แถวคำถามไปเป็นผิวมืด** — หมึก #25090f บนแถวมืดคือตัวอักษรหายไปเลย
// ⚠️ โครมเข้ม (navbar/footer/ticker) เป็นอีกโซนหนึ่ง **ไม่ใช่ไฟล์นี้**
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียง 20px บนผิวการ์ดขาว ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็น
// แผ่นของตัวเอง ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะกล่อง docx ใบอื่น
// บนหน้าเดียวกันถือรูปทรงนั้นอยู่แล้ว (§1/§4/§5 ใบสลากมุม 2rem · §3 การ์ดมุม 28px ·
// §6 การ์ดมุม rounded-3xl)
// แผงนี้ปิดท้ายสายบทความ จึงนั่งบน **พื้นเพจ #fff0f0 ตรง ๆ** โดยไม่มีการ์ดครอบ
// แถวคำถามอยู่บน **ผิวการ์ดขาว #ffffff** จึงลอยขึ้นจากพื้นเพจได้จริงโดยไม่ต้อง
// เพิ่มเงา (ลำดับผิวรอบนี้: #ffffff การ์ด / #ffe4e6 ยก / #ffd4d7 wash /
// #fff0f0 พื้นเพจ)
// กรอบมุมตัดเฉียงเป็นเส้น #f5b9bd ล้อมแผ่นขาว แถบไล่เฉดบนกรอบวิ่ง **แดงสด #ff2436
// → แดงแบรนด์ #c1071b → โปร่ง** ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ 1px** ไม่ใช่
// ตัวอักษร #ff2436 และ #f5b9bd จึงอยู่ตรงนั้นได้ทั้งที่ §2 ห้ามถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นถมแดงทึบ** ไล่ #b00718 → #8a0412 บนหมึก **ขาว**
// (7.3:1 และ 10.4:1 — ครึ่งเข้มของสูตร "CTA หลัก" ของ §2) ⚠️⚠️ **ห้ามลากไล่เฉด
// ขึ้นไปถึง #ff2436 แล้ววางหมึกขาว** เพราะขาวบน #ff2436 ได้แค่ 3.9:1 และ §2 ห้ามไว้
// ตรง ๆ กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **แดงเลือดนก #b00718** (7.3:1 บนผิวการ์ดขาว) ส่วนคำตอบเป็นสีเนื้อความ
// **#25090f** (= BRAND_TEXT, 18.7:1 บนผิวการ์ดขาว) เส้นคั่นคำตอบเป็นแดงสดแบบโปร่ง
// (พื้นถม) และลูกศรเป็นแดงเลือดนก
// หัวข้อเป็นไล่เฉด **สองสต็อป แดงเลือดนก #b00718 → แดงลึก #8a0412**
// ⚠️ ไล่เฉดหัวข้อถูก bg-clip-text จึงเป็น **พิกเซลของตัวอักษร** ทั้งสองสต็อปจึง
// ต้องถือตัวอักษรได้ตาม §2 และทั้งคู่ผ่าน (บนพื้นเพจ #fff0f0: #b00718 7.0:1 และ
// #8a0412 10.0:1 — หัวข้อเป็น text-2xl/3xl font-black = large text)
// 🚨 **ห้ามเอา #ff2436 (3.7:1 บนพื้นเพจ) #e9b53c #f5b9bd #ffd4d7 #ffe4e6 #c3ccd6
// มาเป็นสต็อปของไล่เฉดที่เป็นตัวอักษร** — §2 ให้ทั้งหมดเป็นพื้นถม/เส้น/ออราเท่านั้น
// glow ที่ใช้มีสองชุดตาม §2: rgba(255,36,54,α) และ rgba(176,7,24,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แดง/ชมพูผ่านไฟล์นี้มาหลายเจ้า
// และรอบนี้ก็เป็นแดง** การเจอแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย แดงรอบนี้คือ
// **#b00718 (R176 G7 B24) · #c1071b · #8a0412 · #d61023 · #ff2436** และผิวสว่างคือ
// **#ffffff · #ffe4e6 · #ffd4d7 · #fff0f0 · #f5b9bd · #a8333f**
// ⚠️⚠️ **okkub88 คือชุดที่เพิ่งอยู่ทั้งไฟล์นี้ ต้องกวาดก่อนใคร**: ffd6fa fff4fb
// ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
// d91a73 b01160 85094a + rgba(251,67,155,α) rgba(156,15,85,α)
// — ⚠️ **b01160 ↔ #b00718 สองไบต์แรกตรงกัน · 85094a ↔ #8a0412 คนละ G/B**
// ⚠️⚠️ **ZNOVA168 แบรนด์ขาออกทันที (ส้ม/ทอง/ครีม = ตระกูลเดียวกับรอบนี้)**:
// 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784 fffbf0 fff4e0 ffe9c7 f3d9a8
// c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 fde90b e8a000 ff8a2b d8dde6
// 8f9aa8 6a4a30 — 🚨 **b8300a ↔ #b00718 · c23400 ↔ #c1071b · 9a2a00 ↔ #8a0412 ·
// d13800 ↔ #d61023 · fa4903 ↔ #ff2436 · 2a1206 ↔ #25090f**
// ⚠️ แดง/ชมพูของแบรนด์อื่นที่เคยผ่านไฟล์นี้: ff2e52 e01238 c9102f (มาดาม168) ·
// fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 3b0b26 (หมูบิน168) ·
// fb2e33 cb0b0d d81115 b00d11 8a0608 (สล็อต168 — **b00d11 และ 8a0608 ใกล้ที่สุด
// ในลิสต์ทั้งหมด**) · a81410 c81e12 9d140c de2b1e 3f130d (MEXICANOSLOT) ·
// e4021b (รวยเทพ168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · b3121b 5a0a0e (ขวัญใจ168) ·
// eb0305 e40303 c20305 9b0a0c (โปรดี168) · c30303 8f0505 e81313 (รวยแท้168) ·
// fb141b ff5f63 ffa0a2 (GT66B) · fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16
// (ดวงเศรษฐี168) · d30304 a00203 (รับตัง168) · dc0203 f5282a (หวย365) ·
// cf1111 e01f26 (แบรนด์หวยเก่า) · f41571 ff5ca8 (PUNPRO168) · f5469f ff8dc6 8c0f52
// (มีโชค168) · fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 (มีทรัพย์168) ·
// ff3b14 6d0804 (FLASH877) · ff3fa4 ffd1ea (FAH999)
// ⚠️ ทองที่เคยผ่านไฟล์นี้ — **รอบนี้ทอง #e9b53c เป็นไฮไลต์ของโครมเข้มเท่านั้น
// และไม่มีในไฟล์นี้สักจุด**: f5ba14 fcee52 b37c0b fee45d e6a416 b8780d eeae12
// fded41 9f600d fdcb0c fefb6b f0bb4e f9a826 fcd45c ffc82e fef54b ffd84d fcd434
// f7c92b f0b429 e3b23c e5a81b dcb95f f0b46a fbc134 ffe87a cf9a18 ffd94a e3a712
// 9d6f06 fcdc2b fff6ae a87d0c
// ⚠️ ฟ้า/ม่วงที่เคยผ่านไฟล์นี้ — **รอบนี้ไม่มีเลยสักเฉด**: 00bfff 12b4ef b6e3f0
// 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
// (โบ๊ะบ๊ะ168) · 1fd8f0 0bb6d4 1d4fd8 143aa0 (นาซ่า168) · 18a5e2 0d6b9b 0a5176
// (ร่ำรวย168) · 2cc3fc 6bdcfb (สบาย168) · 7a1bd6 5411c4 241046 c2178b f23bb4
// bb6dff f8e6f9 f6edfe ece0fb dcc6f4 (ZANE96)
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งต่างจากครีม/งาช้าง (R>G>B)
// และจากขาวอมฟ้า (B>G>R) — ตรวจทีละค่า อย่าตัดสินด้วยสายตา · ค่าที่ห้ามเหลือ:
// f4e4d3 e4cbb3 ecd5c4 d2b9a4 f3ece0 bfb8aa e8eaee b4b9c2 6b7079 e0e0df c0c0bf
// a1a09e e8ecf1 a8b2bf 78828f d9c9a6 cfd6e3 f3f6fa
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองในไฟล์นี้ ไม่มีม่วง ไม่มีเขียว (LINE green กับเขียว
// success ของฟีดถอนเงินอยู่ไฟล์อื่น) ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีโรสโกลด์
// ไม่มีส้ม/ทองแดง ไม่มีครีม/เบจ และ ⚠️⚠️ ไม่มีแรมป์เทาเงิน**
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#b00718] to-[#8a0412] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2436] to-transparent shadow-[0_0_10px_rgba(255,36,54,0.5)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#f5b9bd] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#ff2436] via-[#c1071b] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-white p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#b00718] to-[#8a0412] font-black text-white italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#b00718]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#b00718] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#ff2436]/70 pl-4 text-left text-base leading-relaxed text-[#25090f]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
