---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file. The shared
// `name` makes the group exclusive — opening one answer closes the others, again
// with no script. The badge and the arrow are aria-hidden, so a question's
// accessible name is the question text itself.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): กรอบเขียวลึก #1f5a16 บางๆ มุมตัดเฉียงแบบลาย
// วงจรรอบแผงดำอมเขียว #0b1408 แถบไล่เฉดบนกรอบวิ่งทองอ่อน #fff89a → ทองแบรนด์
// #fde90e ตามตัว G ทองบนโลโก้ ป้ายเครื่องหมายคำถามไล่ทองแบรนด์ลงเขียวแบรนด์ #35d413
// บนหมึกเข้ม #10160a ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่างต้องเกือบดำ คำถามเป็น
// ทองแบรนด์ คำตอบเป็นสีเนื้อความ #e9f0dd เส้นคั่นคำตอบเป็นเขียวลึกและลูกศรเป็น
// เขียวแบรนด์ — ชุดเขียวมรกต-โครเมียมของ BRAZIL999 (#1c5a26 #0a1a0c #7cf25c
// #22c55e #f1f5f9 #b6ff9c #040a05 #dfeadd) หายไปทั้งหมด
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#fff89a] via-[#f5c518] to-[#35d413] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fde90e] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#1f5a16] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fff89a] via-[#fde90e] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details name="faq-pgw44" class="faq-item relative bg-[#0b1408] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fde90e] to-[#35d413] font-black text-[#10160a] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#fde90e]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#35d413] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#1f5a16] pl-4 text-left text-base leading-relaxed text-[#e9f0dd]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
