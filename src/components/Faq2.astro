---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2):
// รอบนี้พลิกจากแผงมรกต-ทองของ KOON234 มาเป็นคู่ "แดง-ทอง" ของแบรนด์นี้ กรอบมุมตัดเฉียง
// เป็นแดงสด #d4200d ล้อมแผงผิวกลาง #2a0806 แถบไล่เฉดบนกรอบวิ่งทองแบรนด์ #f5b61d →
// ทองสว่าง #ffd87a ตามขอบทองหนาของป้ายแล็กเกอร์ในโลโก้ PIGPG
// ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ ไล่ครีมงาช้าง #fdf9e4 → ทองแบรนด์ #f5b61d บนหมึก
// ผิวลึกสุด #120302 (10:1 ขึ้นไป — พื้นทองต้องใช้หมึกเข้มเสมอตาม §2) ซึ่งเป็นจุดที่ทองของ
// แบรนด์ (เหรียญทองและก้อนทองในงานอาร์ต) โผล่ในแผงนี้
// คำถามเป็นทองสว่าง #ffd87a บนผิวแผงมืด (14.5:1) ส่วนคำตอบเป็นสีเนื้อความ #fdeedd
// (= BRAND_TEXT, 16.2:1 บนผิว #2a0806) เส้นคั่นคำตอบเป็นแดงสดแบบโปร่ง และลูกศรเป็น
// ทองแบรนด์ หัวข้อไล่ทองแบรนด์ #f5b61d → ครีมงาช้าง #fdf9e4 → ทองสว่าง #ffd87a คือ
// ทอง-ครีม-ทอง ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่อง docx ใบใดในหน้าเดียวกัน
//
// ชุดมรกต-ทองของ KOON234 ที่เคยค้างในไฟล์นี้ (#0a6b32 #2fbf6a #cc920a #f7d14e #fde9a6
// #09190d #e8f2e6 #07170c) ชุดแดง-เขียวมรกต-ทองของ GUCCI168 ก่อนหน้านั้น (#c41115
// #e0201f #7a0505 #0b7a33 #2bbf63 #d9a521 #ffdf91 #1a0604 #140705 #f6e3cf) และชุดฟ้า-
// ทองบนการ์ดสว่างของ HI59 ก่อนนั้น (#f6fbff #9ecbf2 #0a84e0 #5ec2ff #065a9c #06355f
// #fdbc04 #ffe27a #c88a02 #04203f #0d2744) ออกครบทุกจุดแล้ว — แดงของ GUCCI168
// (#c41115 / #e0201f) ใกล้เคียงแดงของรอบนี้มาก แต่เป็นคนละค่า จึงถูกเปลี่ยนทุกจุด
// ไม่ปล่อยไว้เพราะ "แดงอยู่แล้ว"
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#f5b61d] via-[#fdf9e4] to-[#ffd87a] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d4200d] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#d4200d] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#f5b61d] via-[#ffd87a] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#2a0806] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fdf9e4] to-[#f5b61d] font-black text-[#120302] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#ffd87a]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f5b61d] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#d4200d]/70 pl-4 text-left text-base leading-relaxed text-[#fdeedd]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
