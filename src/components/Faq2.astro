---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 (รอบ **ทองคานารีนำ · โครเมียมเงินเป็นสีที่สอง · บนดำสนิท** 2026-10-22)
// — พาเลตต์ตาม .claude/brand-spec-ufabet168.md §2
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (โปรดี168) ใช้ Faq4 จึงหมุนมาที่นี่
// และไฟล์นี้ยังถือพาเลตต์ **ทองจักรพรรดิ-แดงชาดของ รวยเทพ168** อยู่ทั้งไฟล์
// จึงรีเธมทั้งใบก่อนใช้
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียง 20px บนผิวจม ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่นของ
// ตัวเอง ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ §1/§2/§4/§5 ถือรูปทรง
// นั้นอยู่แล้วบนหน้าเดียวกัน และมุมตัด 40px/30px เป็นของ §3/§7 ไปแล้ว
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #0a0908**
// ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#15130f ยก / #1e1a13 อุ่น / #0a0908 จม /
// #000000 พื้นเพจ)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** ตาม bg.json จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// กรอบมุมตัดเฉียงเป็นทองมืด #7a4e05 ล้อมแผ่นผิวจม แถบไล่เฉดบนกรอบวิ่ง
// **ทองคานารี #fee45d → ทองกลาง #e6a416 → โปร่ง** ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ
// 1px** ไม่ใช่ตัวอักษร #7a4e05 (2.4:1) จึงอยู่ตรงนั้นได้ทั้งที่ §2 ห้ามถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นทองทึบ** ไล่ทองคานารี #fee45d → ทองกลาง #e6a416
// บนหมึก #140e02 (§2 ระบุว่า #140e02 เป็นหมึกของพื้นถมทอง — 15.1:1 บน #fee45d และ
// 8.7:1 บน #e6a416 **ห้ามพลิกแผ่นทองไปใช้หมึกขาว** และห้ามลากปลายเข้มลงไปถึง #7a4e05)
// กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **โครเมียมสว่าง #e8ecf1** (17.5:1 บนผิวจม) ซึ่งเป็นที่ที่สีที่สองของ
// รอบนี้ถือตัวอักษรจริง ส่วนคำตอบเป็นสีเนื้อความ #eae3d4 (= BRAND_TEXT, 16.0:1
// บนผิวจม) เส้นคั่นคำตอบเป็นทองกลาง #e6a416 แบบโปร่ง และลูกศรเป็นทองกลาง
// หัวข้อเป็นไล่เฉด **สองสต็อป ทองคานารี #fee45d → ทองลึก #b8780d** ซึ่งเป็นคู่สต็อป
// ที่ไม่ซ้ำกับกล่องใดบนหน้า (§4 เป็น ทอง→ทองกลาง · §5 เป็น โครเมียม→ทอง ·
// §7 เป็นสามสต็อป โครเมียม→ทอง→ทองกลาง) และขีดใต้หัวข้อเป็น **ทองคานารี**
// ⚠️ ไล่เฉดหัวข้อถูก bg-clip-text จึงเป็นพิกเซลของตัวอักษร ทั้งสองสต็อปถือตัวอักษร
// ได้ตาม §2 (14.8:1 และ 5.2:1 บนผิวการ์ด — หัวข้อเป็น text-2xl/3xl font-black
// = large text) **ห้ามเอา #7a4e05 หรือ #5a6472 มาเป็นสต็อป**
// glow ที่ใช้มีชุดเดียว rgba(254,228,93,α) ตาม §2
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองของ
// ตัวเอง** การเจอทองอยู่แล้วจึงไม่พิสูจน์อะไร
// ทองที่เคยผ่านไฟล์นี้: f0bb4e ffeccb d9701a (รวยเทพ168 — ชุดที่เพิ่งถอดออกรอบนี้)
// f9a826 704504 (รวยแทร่168) fcd45c 6b4a08 (มีเฮ168) ffc82e ffefbb 5c4a16
// (สบายเบท168) fef54b 6b5c10 (นินจา168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e2b33f
// (KMD88) e5a81b (UFA324 ⚠️ ชื่อใกล้ที่สุด) dcb95f c99a3f (รวยแท้168) f0b46a
// (โปรดี168 — แบรนด์ขาออก) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168)
// f2b705 (SUPERSLOTCLUB) f7d14e (KOON234) ffd666 f2c230 ffe066 ffe49a 8a6210 —
// **ทองรอบนี้คือ #fee45d (R254 G228 B93) เท่านั้น** ⚠️ **ตัวที่ใกล้ที่สุดคือ fef54b
// ของนินจา168 ตัวตัดสินคือ G228 vs G245 และ B93 vs B75** รับไว้เพราะวัดจาก
// logo.webp เอง
// ⚠️ **ufalion168 เป็นแบรนด์บอลเหมือนกัน** (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) ห้ามเทียบด้วยแนวเรื่อง ต้องเทียบทีละค่า
// แดงที่เคยผ่านไฟล์นี้: e4021b (รวยเทพ168) fb1b32 ff8f9c 5c0410 (มีเฮ168) b3121b
// 5a0a0e (ขวัญใจ168) fb131b ff4d55 (TKB55) eb0305 e40303 ff4446 (โปรดี168) c30303
// e81313 (รวยแท้168) — **รอบนี้ไม่มีแดงเลยสักค่า**
// ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้: 039cfa c3ebfc 04366b 031320 (รวยแทร่168) 2f9ff5
// a8dcff 0b3f78 (สบายเบท168) 32bcfb a9e9ff 07335f (นินจา168) 0360f3 0292fb 6ec8ff
// 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f (TSDET911) —
// **รอบนี้ไม่มีฟ้า/น้ำเงินเลยสักค่า**
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุดของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a
// 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400 กับ rgba 240/187/78) ก่อนนั้นคือชุดของ
// รวยแทร่168 (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320)
// สบายเบท168 (2f9ff5 a8dcff ffefbb 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16
// 04121f) ชุด **ทองไทย-โรสโกลด์-แดงชาด** ของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74
// b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุด **แดงเลือดนก-เงิน
// โครเมียม** ของ TKB55 (fb131b ff4d55 e9eef4 aeb9c6 f2e4e5 0d0304 1a0304) ชุดชมพู
// ฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a0426
// 2a0012 3a0a2a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff e2b33f ffdf8c ece2f8
// 1d0832 140522 0a0213) ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d
// 7a0046 4d002b 2b0019) ชุดส้มอำพันเสือของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0
// 1a0d02 2d1c0a 0f0903) และชุดมรกต-ทองของ KOON234 (0a6b32 2fbf6a cc920a f7d14e
// e8f2e6) — ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีโรสโกลด์
// ไม่มีแดง ไม่มีส้ม/ทองแดง และไม่มีเหลืองมะนาว** — **เงิน/โครเมียมรอบนี้มี** แต่เป็น
// ชุด #e8ecf1 / #a8b2bf / #78828f / #5a6472 เท่านั้น (e9eef4 aeb9c6 f2e4e5 เป็นของ
// TKB55 · cfd9e6 เป็นของรับตัง168 · 8792a0 b9c2cc 464f5a เป็นของ UFA324 · dceefc
// เป็นของนินจา168 — ห้ามเหลือไว้สักค่า)
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#fee45d] to-[#b8780d] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fee45d] to-transparent shadow-[0_0_10px_rgba(254,228,93,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#7a4e05] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fee45d] via-[#e6a416] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#0a0908] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fee45d] to-[#e6a416] font-black text-[#140e02] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#e8ecf1]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#e6a416] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#e6a416]/70 pl-4 text-left text-base leading-relaxed text-[#eae3d4]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
