---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses.  The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// กรอบมุมตัดเฉียงเป็นแดงเสือโคร่ง #e8232a ล้อมแผงผิวกลาง #301105 แถบไล่เฉดบนกรอบวิ่ง
// ทองแบรนด์ #f2b705 → ทองสว่าง #ffd666 ตามขอบทองของเหรียญรอยเท้าเสือในงานอาร์ต
// ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ ไล่ครีมอุ่น #f5cbb0 → ทองแบรนด์ #f2b705 บนหมึก
// น้ำตาลเกือบดำ #2b0a00 (8.7:1 ขึ้นไป — พื้นทองต้องใช้หมึกเข้มเสมอตาม §2 และห้ามพลิก
// ไปใช้หมึกสว่าง) ซึ่งเป็นจุดที่ทองของแบรนด์โผล่ในแผงนี้
// คำถามเป็นทองสว่าง #ffd666 บนผิวแผงมืด ส่วนคำตอบเป็นสีเนื้อความ #fbe8d5
// (= BRAND_TEXT, 14.6:1 บนผิว #301105) เส้นคั่นคำตอบเป็นแดงแบรนด์แบบโปร่ง และลูกศร
// เป็นทองแบรนด์ หัวข้อไล่ทองแบรนด์ #f2b705 → ครีมอุ่น #f5cbb0 → ทองสว่าง #ffd666 คือ
// ทอง-ครีม-ทอง ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่อง docx ใบใดในหน้าเดียวกัน
// §2 ห้าม #e8232a ถือตัวอักษร (3.5:1) — ที่นี่เป็นกรอบ เส้นคั่น และเส้นใต้หัวข้อเท่านั้น
//
// ⚠️ รอบนี้ฮิวแบรนด์เองเป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดง เจอแดงที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดแดงแล็กเกอร์-ทองแบบตรุษจีนของ PIGPG
// ที่เคยค้างในไฟล์นี้ (#d4200d #f5b61d #ffd87a #fdf9e4 #2a0806 #120302 #fdeedd)
// ชุดมรกต-ทองของ KOON234 ก่อนนั้น (#0a6b32 #2fbf6a #cc920a #f7d14e #fde9a6 #09190d
// #e8f2e6 #07170c) ชุดแดง-เขียวมรกต-ทองของ GUCCI168 (#c41115 #e0201f #7a0505
// #0b7a33 #2bbf63 #d9a521 #ffdf91 #1a0604 #140705 #f6e3cf) และชุดฟ้า-ทองบนการ์ดสว่าง
// ของ HI59 (#f6fbff #9ecbf2 #0a84e0 #5ec2ff #065a9c #06355f #fdbc04 #ffe27a #c88a02
// #04203f #0d2744) ออกครบทุกจุดแล้ว — แดงของ PIGPG (#d4200d) และของ GUCCI168
// (#c41115 / #e0201f) ใกล้แดงของรอบนี้มาก แต่เป็นคนละค่า จึงถูกเปลี่ยนทุกจุด
// ไม่ปล่อยไว้เพราะ "แดงอยู่แล้ว"
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#f2b705] via-[#f5cbb0] to-[#ffd666] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8232a] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#e8232a] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#f2b705] via-[#ffd666] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#301105] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#f5cbb0] to-[#f2b705] font-black text-[#2b0a00] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#ffd666]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f2b705] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#e8232a]/70 pl-4 text-left text-base leading-relaxed text-[#fbe8d5]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
