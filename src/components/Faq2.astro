---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
// **Do not rewrite this back into a button + max-height accordion.**
//
// ───────────────────────────────────────────────────────────────────────────
// เงินทอง168 (ดรอป 2026-10-22, .claude/brand-spec-ngernthong168.md §2) —
// **ทองนำ · ครีมอุ่นเป็นวัสดุที่สอง · บนน้ำตาลโอลีฟเข้ม**
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (พักยก168) ใช้ Faq4 จึงหมุนมาที่นี่
// และไฟล์นี้ยังถือพาเลตต์ **ทองคานารี-โครเมียมเงินของ ยูฟ้า168** อยู่ทั้งไฟล์
// จึงรีเธมทั้งใบก่อนใช้
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียง 20px บนผิวอินเซ็ต ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่น
// ของตัวเอง ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ §1/§3/§4/§5/§6 ถือ
// รูปทรงนั้นอยู่แล้วบนหน้าเดียวกัน และมุมตัด 30px เป็นของ §2/§7 ไปแล้ว
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวอินเซ็ต
// #201906** ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#3d3016 ยก / #332810 กลาง /
// #201906 อินเซ็ต / #29210f พื้นเพจ)
// ⚠️ พื้นเพจรอบนี้เป็น **น้ำตาลโอลีฟเข้ม #29210f** ตาม bg.json ซึ่ง *สว่างกว่า*
// ผิวอินเซ็ต เล็กน้อย แถวคำถามจึงอ่านเป็นร่องจมได้จริงโดยไม่ต้องเพิ่มเงา
// กรอบมุมตัดเฉียงเป็นทองลึก #b37c0b ล้อมแผ่นผิวอินเซ็ต แถบไล่เฉดบนกรอบวิ่ง
// **ทองสว่าง #fcee52 → ทองแกน #f5ba14 → โปร่ง** ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ
// 1px** ไม่ใช่ตัวอักษร #b37c0b (2.0:1 บนการ์ด) จึงอยู่ตรงนั้นได้ทั้งที่ §2 ห้าม
// ถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นทองทึบ** ไล่ทองสว่าง #fcee52 → ทองแกน #f5ba14
// บนหมึก #201906 (§2 ระบุว่า #201906 เป็นหมึกของพื้นถมทอง — 14.5:1 บน #fcee52 และ
// 9.9:1 บน #f5ba14 **ห้ามพลิกแผ่นทองไปใช้หมึกขาว** และห้ามลากปลายเข้มลงไปถึง
// #b37c0b) กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **ทองแกน #f5ba14** (9.8:1 บนผิวอินเซ็ต) ซึ่งเป็นค่าที่ §2 อนุญาตให้ถือ
// ตัวอักษรในบทบาท accent/active ส่วนคำตอบเป็นสีเนื้อความ **ครีมอุ่น #ecd5c4**
// (= BRAND_TEXT, 12.5:1 บนผิวอินเซ็ต) เส้นคั่นคำตอบเป็นทองแกนแบบโปร่ง และลูกศร
// เป็นทองแกน
// หัวข้อเป็นไล่เฉด **สองสต็อป ทองสว่าง #fcee52 → ทองแกน #f5ba14** ซึ่งเป็นคู่สต็อป
// ที่ไม่ซ้ำกับกล่องใดบนหน้า (§2 เป็นสามสต็อป ทองสว่าง→ทองแกน→ครีม · §4 เป็นสองสต็อป
// ครีม→ทองสว่าง · §7 เป็นสามสต็อป ครีม→ทองสว่าง→ทองแกน) และขีดใต้หัวข้อเป็น
// **ทองสว่าง**
// ⚠️ ไล่เฉดหัวข้อถูก bg-clip-text จึงเป็นพิกเซลของตัวอักษร ทั้งสองสต็อปถือตัวอักษร
// ได้ตาม §2 (บนพื้นเพจ #29210f: #fcee52 12.9:1 และ #f5ba14 8.7:1 — หัวข้อเป็น
// text-2xl/3xl font-black = large text) **ห้ามเอา #b37c0b มาเป็นสต็อป**
// glow ที่ใช้มีสองชุดตาม §2: rgba(252,238,82,α) และ rgba(245,186,20,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองของ
// ตัวเอง และรอบนี้เป็นทองนำสองรอบติดกัน** การเจอทองอยู่แล้วจึงไม่พิสูจน์อะไร
// ทองที่เคยผ่านไฟล์นี้: fee45d e6a416 b8780d 7a4e05 (ยูฟ้า168 — ชุดที่เพิ่งถอดออก
// รอบนี้) eeae12 fded41 9f600d e29f0f fdf051 (พักยก168 — **แบรนด์ขาออก ⚠️ eeae12
// ห่าง #f5ba14 แค่ R7/G12/B2 และ fded41 ห่าง #fcee52 แค่ R1/G17/B17**) fdcb0c fefb6b
// 8a6504 (สบาย168) f0bb4e ffeccb d9701a (รวยเทพ168) f9a826 704504 (รวยแทร่168)
// fcd45c 6b4a08 (มีเฮ168) ffc82e ffefbb 5c4a16 (สบายเบท168) fef54b 6b5c10
// (นินจา168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168 ⚠️ ห่าง
// #f5ba14 แค่ R2/G15/B23) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168)
// e2b33f (KMD88) e5a81b (UFA324 ⚠️ ชื่อใกล้ที่สุด) dcb95f c99a3f (รวยแท้168) f0b46a
// (โปรดี168) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f2b705
// (SUPERSLOTCLUB) f7d14e (KOON234) ffd666 f2c230 ffe066 ffe49a 8a6210 —
// **ทองรอบนี้คือ #f5ba14 (R245 G186 B20) กับ #fcee52 (R252 G238 B82) เท่านั้น**
// ⚠️⚠️ **วัสดุที่สองรอบนี้คือครีมอุ่น #ecd5c4 / #d2b9a4 ไม่ใช่เทาเงิน** —
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 เป็นของ **พักยก168 ซึ่งเป็นแบรนด์ขาออกพอดี**
// e8ecf1 a8b2bf 78828f 5a6472 เป็นของยูฟ้า168 · e9eef4 aeb9c6 f2e4e5 เป็นของ TKB55
// · cfd9e6 เป็นของรับตัง168 · 8792a0 b9c2cc 464f5a เป็นของ UFA324 · dceefc เป็นของ
// นินจา168 — **ห้ามเหลือไว้สักค่า และห้ามเอาแรมป์เทาเงินกลับเข้ามา**
// แดงที่เคยผ่านไฟล์นี้: e4021b (รวยเทพ168) fb1b32 ff8f9c 5c0410 (มีเฮ168) b3121b
// 5a0a0e (ขวัญใจ168) fb131b ff4d55 (TKB55) eb0305 e40303 ff4446 (โปรดี168) c30303
// e81313 (รวยแท้168) — **รอบนี้ไม่มีแดงเลยสักค่า**
// ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้: 2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a (สบาย168)
// 039cfa c3ebfc 04366b 031320 (รวยแทร่168) 2f9ff5 a8dcff 0b3f78 (สบายเบท168) 32bcfb
// a9e9ff 07335f (นินจา168) 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e
// 0a1c42 040e26 00081f (TSDET911) — **รอบนี้ไม่มีฟ้า/น้ำเงินเลยสักค่า**
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a d8ffc7 e9fbdd) ชุดชมพูฮอตพิงก์-ทองของ **PUNPRO168** (f41571
// ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a0426 2a0012 3a0a2a) ชุดม่วงราชา-ทอง
// ของ **KMD88** (7505cc b453ff c07cff e2b33f ffdf8c ece2f8 1d0832 140522 0a0213)
// ชุดชมพูฮอต-ทองของ **FAH999** (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d 7a0046 4d002b
// 2b0019) ชุดส้มอำพันเสือของ **TIGERWIN369** (d98324 f7b733 ffd98a f7e4c0 1a0d02
// 2d1c0a 0f0903) และชุดมรกต-ทองของ **KOON234** (0a6b32 2fbf6a cc920a f7d14e e8f2e6)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีโรสโกลด์
// ไม่มีแดง ไม่มีส้ม/ทองแดง ไม่มีเหลืองมะนาว และ ⚠️⚠️ ไม่มีแรมป์เทาเงิน**
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#fcee52] to-[#f5ba14] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fcee52] to-transparent shadow-[0_0_10px_rgba(252,238,82,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#b37c0b] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fcee52] via-[#f5ba14] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#201906] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fcee52] to-[#f5ba14] font-black text-[#201906] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f5ba14]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f5ba14] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#f5ba14]/70 pl-4 text-left text-base leading-relaxed text-[#ecd5c4]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
