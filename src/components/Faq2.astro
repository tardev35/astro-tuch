---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-sabuybet168.md §2
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (ถอนชัวร์168) ใช้ Faq ตัวฐาน
// จึงหมุนมาที่นี่ และไฟล์นี้ยังถือพาเลตต์ของขวัญใจ168 อยู่ทั้งไฟล์ ต้องรีเธมทั้งใบ
// ก่อนใช้
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียงบนผิวจม ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่นของตัวเอง
// ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ ContentBox3Three กับ
// ContentBoxTwoNeumorphism ถือรูปทรงนั้นอยู่แล้วบนหน้าเดียวกัน
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #040d16**
// ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#0e2238 ยก / #081726 กลาง / #040d16 จม /
// #000000 พื้น)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** ตาม bg.json จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// กรอบมุมตัดเฉียงเป็นน้ำเงินลึก #0b3f78 ล้อมแผ่นผิวจม แถบไล่เฉดบนกรอบวิ่ง
// **ฟ้าแบรนด์ #2f9ff5 → ทอง #ffc82e** = สองฮิวของรอบนี้อยู่บนขอบเดียวกัน (ตามโลโก้
// ที่คำว่า "สบาย" เป็นทองและ "เบท168" เป็นฟ้าบับเบิล ติดกันบนบรรทัดเดียว)
// ป้ายเครื่องหมายคำถามเป็น **แผ่นฟ้าทึบ** ไล่ฟ้าอ่อน #a8dcff → ฟ้าแบรนด์ #2f9ff5
// บนหมึก #04121f (§2 ระบุว่า #04121f เป็นหมึกตัวเดียวที่วางบนพื้นถมฟ้า/ทองได้ —
// 11.6:1 บน #a8dcff และ 6.9:1 บน #2f9ff5 ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง และห้าม
// ลากปลายเข้มของไล่เฉดลงไปถึง #0b3f78 เพราะจะเหลือ 1.4:1) กลีฟ ? เป็น aria-hidden
// จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **ฟ้าอ่อน #a8dcff** (11.6:1 บนผิวยก สูงกว่านั้นบนผิวจม) ส่วนคำตอบเป็น
// สีเนื้อความ #e8f4ff (= BRAND_TEXT, 16.8:1 บนผิวจม) เส้นคั่นคำตอบเป็นทองลึก
// #5c4a16 แบบโปร่ง และลูกศรเป็นทอง #ffc82e
// หัวข้อไล่ ฟ้าแบรนด์ #2f9ff5 → ทองอ่อน #ffefbb → ฟ้าอ่อน #a8dcff คือ ฟ้า-ทอง-ฟ้า
// ซึ่งเป็นลำดับเดียวที่ยังไม่ถูกกล่อง docx ใบใดบนหน้าเดียวกันใช้
// (§1 แผ่นถมไล่ ฟ้า→ฟ้าอ่อน→ทองอ่อน · §2 ฟ้าทึบกึ่งกลาง · §3 ทอง→ทองอ่อน→ฟ้า ·
// §4 ฟ้า→ฟ้าอ่อน→ทอง · §5 ฟ้าอ่อน→ทอง→ฟ้า · §6 ทองอ่อน→ฟ้า→ทอง ·
// §7 ฟ้าอ่อน→ฟ้า→ทอง) และขีดใต้หัวข้อเป็น **ทอง** ไม่ใช่ฟ้า ต่างจากขีดของ
// ContentBox3Three ที่ไล่ ฟ้า→ทอง→น้ำเงินลึก
// §2 ห้าม #0b3f78 #5c4a16 ถือตัวอักษรทุกขนาด — ที่นี่ #0b3f78 อยู่ที่กรอบ 1px และ
// #5c4a16 อยู่ที่เส้นคั่นคำตอบเท่านั้น ไม่มีตัวอักษรไหนนั่งบนทั้งคู่
// glow ที่ใช้มีชุดเดียว rgba(255,200,46,α) ตาม §2
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทอง และ ฟ้า**
// แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองของตัวเอง การเจอทองอยู่แล้วจึงไม่พิสูจน์อะไร และ
// ฟ้าก็เป็นกับดักเพราะ TSDET911 เคยเป็นน้ำเงินไฟฟ้าทั้งชุดในไฟล์นี้
// ทองที่เคยผ่านไฟล์นี้: ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e2b33f (KMD88) e5a81b
// (UFA324) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f2b705
// (SUPERSLOTCLUB) f7d14e (KOON234) ffd666 f2c230 ffe066 ffe49a 8a6210 —
// **ทองรอบนี้คือ #ffc82e (R=255 G=200 B=46) เท่านั้น**
// ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้: 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7
// 102a5e 0a1c42 040e26 00081f (TSDET911) — **ฟ้ารอบนี้คือ #2f9ff5 / #a8dcff /
// #0b3f78 เท่านั้น** และ cfd9e6 (เงินอมฟ้าของรับตัง168) หน้าตาใกล้ฟ้าอ่อนมาก
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุด **ทองไทย-โรสโกลด์-แดงชาด** ของขวัญใจ168
// (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06
// 0b0603) ก่อนนั้นคือชุด **แดงเลือดนก-เงินโครเมียม** ของ TKB55 (fb131b ff4d55
// e9eef4 aeb9c6 f2e4e5 0d0304 1a0304) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571
// ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a0426 2a0012 3a0a2a) ชุดม่วงราชา-ทอง
// ของ KMD88 (7505cc b453ff c07cff e2b33f ffdf8c ece2f8 1d0832 140522 0a0213)
// ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d ffe49a 7a0046
// 4d002b 2b0019) ชุดส้มอำพันเสือของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0
// 1a0d02 2d1c0a 0f0903) และชุดมรกต-ทองของ KOON234 (0a6b32 2fbf6a cc920a f7d14e
// e8f2e6) — ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีโรสโกลด์ และ
// ไม่มีเงิน/โครเมียม** (cfd9e6 เป็นของรับตัง168 · e9eef4 aeb9c6 เป็นของ TKB55
// ห้ามเหลือไว้)
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#2f9ff5] via-[#ffefbb] to-[#a8dcff] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffc82e] to-transparent shadow-[0_0_10px_rgba(255,200,46,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#0b3f78] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#2f9ff5] via-[#ffc82e] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#040d16] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#a8dcff] to-[#2f9ff5] font-black text-[#04121f] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#a8dcff]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#ffc82e] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#5c4a16]/70 pl-4 text-left text-base leading-relaxed text-[#e8f4ff]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
