---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// FAH999 (รอบชมพูฮอต-ทอง บนพลัมดำ 2026-10-11, brand-spec §2):
// กรอบมุมตัดเฉียงเป็นชมพูฮอต #ff3fa4 ล้อมแผงผิวกลาง #3a0534 แถบไล่เฉดบนกรอบวิ่ง
// ทอง #f5c53d → ทองสว่าง #ffe49a ตามขอบทองของมงกุฎและเหรียญในงานอาร์ต
// ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ ไล่ทองสว่าง #ffe49a → ทองแบรนด์ #f5c53d บนหมึก
// พลัมเกือบดำ #2b0019 (11.5:1 — พื้นทองต้องใช้หมึกเข้มเสมอตาม §2 และห้ามพลิกไปใช้
// หมึกสว่าง) ซึ่งเป็นจุดที่ทองของแบรนด์โผล่ในแผงนี้
// คำถามเป็นชมพูซีด #ffd1ea บนผิวแผงมืด ส่วนคำตอบเป็นสีเนื้อความ #fde8f3
// (= BRAND_TEXT, 14.4:1 บนผิว #3a0534) เส้นคั่นคำตอบเป็นชมพูแบรนด์แบบโปร่ง และลูกศร
// เป็นทองแบรนด์ หัวข้อไล่ชมพูแบรนด์ #ff3fa4 → ทองสว่าง #ffe49a → ชมพูซีด #ffd1ea คือ
// ชมพู-ทอง-ชมพู ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่อง docx ใบใดในหน้าเดียวกัน
// §2 ห้าม #b3006a #7a0046 #4d002b #9c6f08 ถือตัวอักษร — ที่นี่ไม่มีตัวไหนถือตัวอักษรเลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// ที่เคยค้างในไฟล์นี้ (#e8232a #f2b705 #ffd666 #f5cbb0 #2b0a00 #301105 #fbe8d5)
// ชุดแดงแล็กเกอร์-ทองของ PIGPG ก่อนนั้น (#d4200d #f5b61d #ffd87a #fdf9e4 #2a0806
// #fdeedd) ชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6) และชุด
// ชมพู-ม่วงของ BPLAY639 (#f472b6 #fbcfe8 #e9d5f5 #7e22ce #fdf2f8) ออกครบทุกจุดแล้ว
// ⚠️ BPLAY639 ก็เป็นแบรนด์ชมพู — "มีชมพูอยู่แล้ว" ไม่พิสูจน์อะไร #f472b6 ไม่ใช่
// #ff3fa4 และ #f5c518 ของ GOT777 ต่างจาก #f5c53d ของรอบนี้แค่สองตัวอักษร
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#ff3fa4] via-[#ffe49a] to-[#ffd1ea] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff3fa4] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#ff3fa4] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#f5c53d] via-[#ffe49a] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#3a0534] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffe49a] to-[#f5c53d] font-black text-[#2b0019] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#ffd1ea]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f5c53d] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#ff3fa4]/70 pl-4 text-left text-base leading-relaxed text-[#fde8f3]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
