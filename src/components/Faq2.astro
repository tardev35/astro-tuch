---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// PUNPRO168 (รอบชมพูฮอตพิงก์-ทอง บนพลัมเข้มอมม่วง 2026-10-12, brand-spec §2):
// กรอบมุมตัดเฉียงเป็นชมพูบานเย็น #f41571 ล้อมแผงผิวกลาง #3a0a2a แถบไล่เฉดบนกรอบวิ่ง
// ทองสว่าง #fce343 → ทองอำพัน #ffc554 ตามขอบทองของตัวอักษร PUNPRO และเหรียญทองใน
// งานอาร์ต
// ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ ไล่ทองสว่าง #fce343 → ทองอำพัน #ffc554 บนหมึก
// พลัมเกือบดำ #2a0012 (12.3:1 — พื้นทองต้องใช้หมึกเข้มเสมอตาม §2 ห้ามไล่เข้มกว่า
// #ffc554 ใต้ตัวอักษร และห้ามพลิกไปใช้หมึกสว่าง) ซึ่งเป็นจุดที่ทองของแบรนด์โผล่ในแผงนี้
// คำถามเป็นครีมหม่นอมชมพู #f0c3dc (9.6:1 บนผิวยก สูงกว่านั้นบนผิวกลาง) ส่วนคำตอบเป็น
// สีเนื้อความ #fde7f2 (= BRAND_TEXT, 14.2:1 บนผิว #3a0a2a) เส้นคั่นคำตอบเป็นชมพู
// แบรนด์แบบโปร่ง และลูกศรเป็นทองสว่าง
// หัวข้อไล่ชมพูบานเย็น #f41571 → ชมพูสว่าง #ff5ca8 → ทองสว่าง #fce343 คือ
// ชมพู-ชมพู-ทอง ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่อง docx ใบใดในหน้าเดียวกัน
// §2 ห้าม #8a0a45 #4a0426 ถือตัวอักษร — ที่นี่ไม่มีตัวไหนถือตัวอักษรเลย และ #ffd94a
// ถูกสงวนไว้ให้ <strong> ในย่อหน้า จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดชมพูฮอต-ทองของ FAH999 ที่เคยค้างใน
// ไฟล์นี้ (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #ffe49a #7a0046 #4d002b #2b0019
// #3a0534 #2e002c) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0
// #1a0d02 #2d1c0a #0f0903) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a
// #f2b705 #ffd666 #f5cbb0 #2b0a00 #301105 #fbe8d5) ชุดแดงแล็กเกอร์-ทองของ PIGPG
// (#d4200d #f5b61d #ffd87a #fdf9e4 #2a0806 #fdeedd) และชุดมรกต-ทองของ KOON234
// (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6) ออกครบทุกจุดแล้ว
// ⚠️ FAH999 ก็เป็นแบรนด์ชมพู — "มีชมพูอยู่แล้ว" ไม่พิสูจน์อะไร #ff3fa4 (R=255 G=63)
// ไม่ใช่ #f41571 (R=244 G=21) และ #f5c53d ของ FAH999 ต่างจาก #fce343 ของรอบนี้
// แค่สองตัวอักษร ห้ามกะด้วยตา
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#f41571] via-[#ff5ca8] to-[#fce343] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f41571] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#f41571] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fce343] via-[#ffc554] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#3a0a2a] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fce343] to-[#ffc554] font-black text-[#2a0012] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f0c3dc]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#fce343] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#f41571]/70 pl-4 text-left text-base leading-relaxed text-[#fde7f2]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
