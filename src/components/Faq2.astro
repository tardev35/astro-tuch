---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
// **Do not rewrite this back into a button + max-height accordion.**
//
// ───────────────────────────────────────────────────────────────────────────
// okkub88 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-okkub88.md §2
// **ชมพูบับเบิลกัมนำ · เบอร์รีเข้มเป็นหมึก · บนธีมสว่าง**
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (โบ๊ะบ๊ะ168) ใช้ Faq4 จึงหมุนมา
// ที่นี่ และไฟล์นี้ยังถือพาเลต **แดงคริมสัน-อะซัวร์บนน้ำเงินเที่ยงคืนของ มาดาม168**
// อยู่ทั้งไฟล์ จึงรีเธมทั้งใบก่อนใช้ หน้าแรกส่ง **docx H2 §9** มาให้ ("คำถามที่พบ
// บ่อยเกี่ยวกับ <แบรนด์>" — content.txt บรรทัด 25) พร้อม prop `faqs` สามคู่จาก
// บรรทัด 26–31 **แบบส่งชัดเจน ไม่พึ่ง default** (ไฟล์นี้ตั้งใจ ship ลิสต์ว่าง
// คำถามที่หายไปจึงเป็นหีบเปล่า ไม่ใช่คำถามของแบรนด์ก่อน)
//
// 🚨🚨 **รอบนี้กลับทิศจากพาเลตที่ค้างในไฟล์นี้ 180 องศา: จากธีมมืด เป็นธีมสว่าง**
// bg.json = {"mode":"color","color":"#ffd6fa"} = ชมพูบับเบิลกัมพาสเทล (ชุดที่ค้าง
// อยู่คือ 00091f น้ำเงินเที่ยงคืน) **ห้าม "แก้" แถวคำถามกลับไปเป็นผิวมืด** —
// หมึก #6a0f3c บนแถวมืดคือตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียง 20px บนผิวการ์ดขาว ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็น
// แผ่นของตัวเอง ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะกล่อง docx ใบอื่น
// บนหน้าเดียวกันถือรูปทรงนั้นอยู่แล้ว
// แผงนี้ปิดท้ายสายบทความ จึงนั่งบน **พื้นเพจ #ffd6fa ตรง ๆ** โดยไม่มีการ์ดครอบ
// แถวคำถามอยู่บน **ผิวการ์ดขาว #ffffff** จึงลอยขึ้นจากพื้นเพจได้จริงโดยไม่ต้อง
// เพิ่มเงา (ลำดับผิวรอบนี้: #ffffff การ์ด / #fff4fb ยก / #ffe3f5 wash /
// #ffd6fa พื้นเพจ)
// กรอบมุมตัดเฉียงเป็นเส้น #f9b2d9 ล้อมแผ่นขาว แถบไล่เฉดบนกรอบวิ่ง **ชมพูบับเบิลกัม
// #fb439b → ชมพูเข้ม #d91a73 → โปร่ง** ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ 1px** ไม่ใช่
// ตัวอักษร #fb439b และ #f9b2d9 จึงอยู่ตรงนั้นได้ทั้งที่ §2 ห้ามถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นถมชมพูเข้มทึบ** ไล่ #d91a73 → #b01160 บนหมึก
// **ขาว** (4.8:1 และ 6.8:1 — สูตร "CTA หลัก" ของ §2) ⚠️⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง
// #fb439b แล้ววางหมึกขาว** เพราะขาวบน #fb439b ได้แค่ 3.3:1 และ §2 ห้ามไว้ตรง ๆ
// กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **ชมพูลึก #9c0f55** (8.1:1 บนผิวการ์ดขาว) ส่วนคำตอบเป็นสีเนื้อความ
// **#6a0f3c** (= BRAND_TEXT, 12.1:1 บนผิวการ์ดขาว) เส้นคั่นคำตอบเป็นชมพูบับเบิลกัม
// แบบโปร่ง (พื้นถม) และลูกศรเป็นชมพูลึก
// หัวข้อเป็นไล่เฉด **สองสต็อป ชมพูลึก #9c0f55 → เบอร์รีเข้มสุด #85094a**
// ⚠️ ไล่เฉดหัวข้อถูก bg-clip-text จึงเป็น **พิกเซลของตัวอักษร** ทั้งสองสต็อปจึง
// ต้องถือตัวอักษรได้ตาม §2 และทั้งคู่ผ่าน (บนพื้นเพจ #ffd6fa: #9c0f55 6.2:1 และ
// #85094a 7.6:1 — หัวข้อเป็น text-2xl/3xl font-black = large text)
// 🚨 **ห้ามเอา #fb439b (1.9:1 บนพื้นเพจ) #fc74b5 #ffc2e2 #f9b2d9 #f479b9 มาเป็น
// สต็อปของไล่เฉดที่เป็นตัวอักษร** — §2 ให้ทั้งหมดเป็นพื้นถม/เส้น/ออราเท่านั้น
// glow ที่ใช้มีสองชุดตาม §2: rgba(251,67,155,α) และ rgba(156,15,85,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แดง/ชมพูผ่านไฟล์นี้มาหลายเจ้า
// และรอบนี้ก็เป็นชมพู** การเจอชมพูในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ชมพูรอบนี้คือ
// **#fb439b (R251 G67 B155) · #fc74b5 · #ffc2e2 · #ffd6fa · #f9b2d9 · #f479b9**
// และหมึกคือ **#6a0f3c · #95486b · #9c0f55 · #d91a73 · #b01160 · #85094a**
// ⚠️⚠️ **หมูบิน168 (สองรอบก่อน) เป็นชมพูเหมือนกัน = กับดักหลักของรอบนี้**: fa539c
// c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26
// 54123a 7a2350 ffe9f5 7a4463 — **fb8cc0 ↔ #fb439b R ตรงกันเป๊ะ · f7bcd9 ↔ #f9b2d9
// B ตรงกันเป๊ะ · ffe9f5 ↔ #ffe9f7 ต่างแค่ไบต์สุดท้าย · c2185b ↔ #9c0f55 คนละ R**
// ⚠️⚠️ **ชุดที่เพิ่งถอดออกจากไฟล์นี้คือ มาดาม168** (ff2e52 e01238 c9102f 1177e8
// 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6 + rgba
// 255/46/82 และ rgba 201/16/47) **ออกครบทุกค่าแล้ว**
// ⚠️⚠️ **โบ๊ะบ๊ะ168 แบรนด์ขาออก (ฟ้าสกายบนธีมสว่าง)**: 00bfff 12b4ef b6e3f0 7fcbe8
// 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
// ⚠️ แดง/ชมพูของแบรนด์อื่นที่เคยผ่านไฟล์นี้: f41571 ff5ca8 fce343 (PUNPRO168 —
// **f41571 ใกล้ #fb439b ที่สุดในลิสต์**) · f5469f ff8dc6 8c0f52 (มีโชค168) ·
// fa63b9 ffb3de (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) ·
// fb2e33 cb0b0d d81115 b00d11 8a0608 (สล็อต168 — **b00d11 ↔ #b01160 b01 ตรงกัน**) ·
// e4021b (รวยเทพ168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · b3121b 5a0a0e f2bba5
// (ขวัญใจ168) · eb0305 e40303 c20305 9b0a0c (โปรดี168) · c30303 8f0505 e81313
// (รวยแท้168) · fb141b ff5f63 ffa0a2 (GT66B) · fa0513 ff5a5f ffadaf (สมหวัง168) ·
// d9212a 8e1a16 (ดวงเศรษฐี168) · d30304 a00203 (รับตัง168) · dc0203 f5282a (หวย365) ·
// ff3b14 6d0804 (FLASH877) · ff3fa4 ffd1ea (FAH999)
// ⚠️ ทองที่เคยผ่านไฟล์นี้ — **รอบนี้ไม่มีทองเลยสักค่า**: f5ba14 fcee52 b37c0b
// fee45d e6a416 b8780d eeae12 fded41 9f600d fdcb0c fefb6b f0bb4e f9a826 fcd45c
// ffc82e fef54b ffd84d fcd434 f7c92b f0b429 e3b23c dfa310 e2b33f e5a81b dcb95f
// c99a3f f0b46a fad354 f5c518 fce343 f2b705 f7d14e fbc134 ffe87a cf9a18 96690a
// ⚠️ ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้ — **รอบนี้ไม่มีฟ้าเลยสักเฉด**: 1fd8f0 0bb6d4
// 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722 33455f 0d1017 (นาซ่า168) ·
// 18a5e2 0d6b9b 0a5176 a9d7f2 16294a (ร่ำรวย168) · 2cc3fc 6bdcfb 9ae0fa 0a7fbd
// 063a57 (สบาย168) · 039cfa c3ebfc 04366b (รวยแทร่168) · 2f9ff5 a8dcff 0b3f78
// (สบายเบท168) · 32bcfb a9e9ff 07335f (นินจา168) · 0360f3 0292fb 6ec8ff 4fb4ff
// cfdcec 9db4d4 (TSDET911)
// ⚠️⚠️ **วัสดุที่สองรอบนี้คือชมพูพาสเทล/ขาวอมชมพู (R≥B>G) ไม่ใช่ครีมและไม่ใช่
// เทาเงิน** — d9dfe9 b3bdd6 f4eef1 (มาดาม168) ecd5c4 d2b9a4 (เงินทอง168) f4e4d3
// e4cbb3 (ร่ำรวย168) e0e0df c0c0bf a1a09e f4ead6 d6c6a8 (พักยก168) e8ecf1 a8b2bf
// 78828f 5a6472 (ยูฟ้า168) e9eef4 aeb9c6 (TKB55) cfd9e6 (รับตัง168) 8792a0 b9c2cc
// (UFA324) dceefc (นินจา168) **ห้ามเหลือไว้สักค่า**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว (ยกเว้น LINE green และเขียว
// success ของฟีดถอนเงินซึ่งอยู่ไฟล์อื่น) ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีโรสโกลด์
// ไม่มีส้ม/ทองแดง ไม่มีครีม/เบจ และ ⚠️⚠️ ไม่มีแรมป์เทาเงิน**
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#9c0f55] to-[#85094a] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb439b] to-transparent shadow-[0_0_10px_rgba(251,67,155,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#f9b2d9] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fb439b] via-[#d91a73] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-white p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#d91a73] to-[#b01160] font-black text-white italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#9c0f55]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#9c0f55] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#fb439b]/70 pl-4 text-left text-base leading-relaxed text-[#6a0f3c]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
