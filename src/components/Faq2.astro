---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file. The shared
// `name` makes the group exclusive — opening one answer closes the others, again
// with no script. It is deliberately brand-neutral ("site-faq"): a group name
// carrying a previous brand's slug is the kind of string a rebrand misses. The
// badge and the arrow are aria-hidden, so a question's accessible name is the
// question text itself.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): กรอบฟ้าขอบการ์ด #9ecbf2
// บางๆ มุมตัดเฉียงรอบแผงกระจกน้ำแข็ง #f6fbff แถบไล่เฉดบนกรอบวิ่งฟ้าแบรนด์ #0a84e0 →
// ฟ้าเรือง #5ec2ff ตามตัวอักษร HI ฟ้าของโลโก้
// ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ ไล่ทองอ่อน #ffe27a → ทองแบรนด์ #fdbc04 บนหมึก
// กรมท่า #04203f (คอนทราสต์ 10.9:1) ซึ่งเป็นจุดที่ทองของแบรนด์ (ตัวเลข 59) โผล่ในแผงนี้
// คำถามเป็นฟ้าลึก #065a9c (7.2:1 บนผิวแผง) ไม่ใช่ฟ้าแบรนด์ #0a84e0 ซึ่งได้แค่ 4.0:1
// ตามกฎ §2 ที่ว่าตัวอักษรลิงก์บนการ์ดสว่างต้องเป็น #065a9c
// คำตอบเป็นสีเนื้อความ #0d2744 (BRAND_TEXT) เส้นคั่นคำตอบเป็นทองแบรนด์แบบโปร่ง และ
// ลูกศรเป็นฟ้าแบรนด์ หัวข้อไล่กรมท่าหัวข้อ #06355f → ทองเข้ม #c88a02 → ฟ้าลึก #065a9c
// คือเข้ม-ทอง-ฟ้า ซึ่งสลับกับการ์ด docx ใบก่อนหน้าที่ไล่ "ทองไปเข้ม"
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#0a4a18 #030a05 #4ade6b
// #12c23a #ffe9a8 #f2b422 #06140a #fb252b #01a326 #e4f2e4) ออกครบทุกจุดแล้ว
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#06355f] via-[#c88a02] to-[#065a9c] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0a84e0] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#9ecbf2] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#0a84e0] via-[#5ec2ff] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#f6fbff] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffe27a] to-[#fdbc04] font-black text-[#04203f] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#065a9c]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#0a84e0] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#fdbc04]/70 pl-4 text-left text-base leading-relaxed text-[#0d2744]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
