---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ruaythep168.md §2
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (มีเฮ168) ใช้ Faq4 จึงหมุนมาที่นี่
// และไฟล์นี้ยังถือพาเลตต์ของรวยแทร่168 อยู่ทั้งไฟล์ จึงรีเธมทั้งใบก่อนใช้
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียงบนผิวจม ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่นของตัวเอง
// ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ ContentBoxTwoPremium กับ
// ContentBoxTwoNeumorphism ถือรูปทรงนั้นอยู่แล้วบนหน้าเดียวกัน
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #0d0501**
// ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#3b1b0e ยก / #260d04 กลาง / #0d0501 จม /
// #000000 พื้น)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** ตาม bg.json จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// กรอบมุมตัดเฉียงเป็นบรอนซ์ลึก #5c2a06 ล้อมแผ่นผิวจม แถบไล่เฉดบนกรอบวิ่ง
// **ทองแบรนด์ #f0bb4e → แดงชาด #e4021b** = สองฮิวของรอบนี้อยู่บนขอบเดียวกัน
// (ตามโลโก้ที่คำว่า "รวย" เป็นทองและเลข "168" เป็นแดงชาด ติดกันบนบรรทัดเดียว)
// ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ 1px** ไม่ใช่ตัวอักษร แดงชาดจึงอยู่ตรงนั้นได้ ทั้งที่
// §2 วัดไว้ 3.2–4.3:1 ทุกผิวและห้ามให้ถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นทองทึบ** ไล่ครีมทอง #ffeccb → ทองแบรนด์ #f0bb4e
// บนหมึก #2b1400 (§2 ระบุว่า #2b1400 เป็นหมึกตัวเดียวที่วางบนพื้นถมทอง/ครีมได้ —
// 9.9:1 บน #f0bb4e และสูงกว่านั้นบน #ffeccb ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง และห้าม
// ลากปลายเข้มของไล่เฉดลงไปถึง #5c2a06) กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่ง
// ล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **ครีมทอง #ffeccb** (17.4:1 บนผิวจม) ส่วนคำตอบเป็นสีเนื้อความ #fff8ec
// (= BRAND_TEXT, 19.1:1 บนผิวจม) เส้นคั่นคำตอบเป็นทองแดง #d9701a แบบโปร่ง และ
// ลูกศรเป็นทองแบรนด์ #f0bb4e
// หัวข้อเป็นไล่เฉด **สองสต็อป ทองแบรนด์ #f0bb4e → ทองแดง #d9701a** ซึ่งเป็นกล่อง
// เดียวของหน้าที่หัวข้อมีแค่สองสต็อป ทุกใบอื่นเป็นสามสต็อปหรือสีทึบ จึงไม่ซ้ำกับใบใด
// (§1 แผ่นถมไล่ ทอง→ครีม→ทองแดง · §2 ทองทึบกึ่งกลาง · §3 ครีม→ทองแดง→ทอง ·
// §4 ทอง→ทองแดง→ครีม · §5 ทองแดง→ครีม→ทอง · §6 ทองแดง→ทอง→ครีม ·
// §7 ครีม→ทอง→ทองแดง) และขีดใต้หัวข้อเป็น **ทองแบรนด์**
// §2 ห้าม #e4021b #5c2a06 ถือตัวอักษรทุกขนาด — ที่นี่ #5c2a06 อยู่ที่กรอบ 1px และ
// #e4021b อยู่ในแถบไล่เฉดของกรอบเท่านั้น ไม่มีตัวอักษรไหนนั่งบนทั้งคู่
// glow ที่ใช้มีชุดเดียว rgba(240,187,78,α) ตาม §2
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทองของ
// ตัวเอง** การเจอทองอยู่แล้วจึงไม่พิสูจน์อะไร และแดงก็เคยนำมาแล้วสี่แบรนด์
// ทองที่เคยผ่านไฟล์นี้: f9a826 704504 (รวยแทร่168 — ชุดที่เพิ่งถอดออกรอบนี้)
// fcd45c 6b4a08 (มีเฮ168) ffc82e ffefbb 5c4a16 (สบายเบท168) fef54b 6b5c10
// (นินจา168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429
// (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e2b33f (KMD88) e5a81b (UFA324)
// fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f2b705 (SUPERSLOTCLUB)
// f7d14e (KOON234) ffd666 f2c230 ffe066 ffe49a 8a6210 —
// **ทองรอบนี้คือ #f0bb4e (R240 G187 B78) เท่านั้น** ⚠️ **R ตรงกับ f0b429 ของ
// รับตัง168 เป๊ะ ตัวตัดสินคือ B78 vs B41**
// แดงที่เคยผ่านไฟล์นี้: fb1b32 ff8f9c 5c0410 (มีเฮ168) b3121b 5a0a0e (ขวัญใจ168)
// fb131b ff4d55 (TKB55) — **แดงรอบนี้คือ #e4021b (R228 G2 B27) เท่านั้น** ไม่ใช่
// fa0513 (สมหวัง168) หรือ d30304 (รับตัง168)
// ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้: 039cfa c3ebfc 04366b 031320 (รวยแทร่168) 2f9ff5
// a8dcff 0b3f78 (สบายเบท168) 32bcfb a9e9ff 07335f (นินจา168) 0360f3 0292fb 6ec8ff
// 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f (TSDET911) —
// **รอบนี้ไม่มีฟ้า/น้ำเงินเลยสักค่า**
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุดของ **รวยแทร่168** (039cfa c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 030f1d 031320 กับ rgba 249/168/38) ก่อนนั้นคือชุดของ
// สบายเบท168 (2f9ff5 a8dcff ffefbb 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726
// 040d16 04121f) ชุด **ทองไทย-โรสโกลด์-แดงชาด** ของขวัญใจ168 (f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุด **แดงเลือดนก-
// เงินโครเมียม** ของ TKB55 (fb131b ff4d55 e9eef4 aeb9c6 f2e4e5 0d0304 1a0304)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2
// 8a0a45 4a0426 2a0012 3a0a2a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff
// e2b33f ffdf8c ece2f8 1d0832 140522 0a0213) ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4
// ff6cbb ffd1ea fde8f3 f5c53d 7a0046 4d002b 2b0019) ชุดส้มอำพันเสือของ TIGERWIN369
// (d98324 f7b733 ffd98a f7e4c0 1a0d02 2d1c0a 0f0903) และชุดมรกต-ทองของ KOON234
// (0a6b32 2fbf6a cc920a f7d14e e8f2e6) — ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีโรสโกลด์
// ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** (cfd9e6 เป็นของรับตัง168 · e9eef4 aeb9c6
// เป็นของ TKB55 · fef54b เป็นของนินจา168 ห้ามเหลือไว้) ส้มตัวเดียวที่อนุญาตคือ
// ทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#f0bb4e] to-[#d9701a] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0bb4e] to-transparent shadow-[0_0_10px_rgba(240,187,78,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#5c2a06] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#f0bb4e] via-[#e4021b] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#0d0501] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffeccb] to-[#f0bb4e] font-black text-[#2b1400] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#ffeccb]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f0bb4e] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#d9701a]/70 pl-4 text-left text-base leading-relaxed text-[#fff8ec]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
