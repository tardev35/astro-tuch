---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file. The shared
// `name` makes the group exclusive — opening one answer closes the others, again
// with no script. It is deliberately brand-neutral ("site-faq"): a group name
// carrying a previous brand's slug is the kind of string a rebrand misses. The
// badge and the arrow are aria-hidden, so a question's accessible name is the
// question text itself.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): กรอบเขียวลึก #0a4a18 บางๆ
// มุมตัดเฉียงรอบแผงพื้นลึกสุด #030a05 แถบไล่เฉดบนกรอบวิ่งเขียวสว่าง #4ade6b →
// เขียวสว่างกลาง #12c23a ตามตัว D เขียวของโลโก้ ป้ายเครื่องหมายคำถามเป็นทองเต็มใบ
// ไล่ทองอ่อน #ffe9a8 → ทองแบรนด์ #f2b422 บนหมึก #06140a (คอนทราสต์ 10.2:1) ซึ่ง
// เป็นจุดที่ทองเสริมของแบรนด์โผล่ในแผงนี้ คำถามเป็นเขียวสว่าง #4ade6b (11.4:1 บน
// ผิวแผง) คำตอบเป็นสีเนื้อความ #e4f2e4 (BRAND_TEXT) เส้นคั่นคำตอบเป็นแดงแบรนด์
// #fb252b แบบโปร่ง ซึ่งเป็นจุดที่ฮิวที่สอง (ตัว M แดง) โผล่ในแผงนี้ และลูกศรเป็น
// เขียวสว่าง หัวข้อไล่ขาวนวล #e4f2e4 → เขียวสว่าง #4ade6b → แดงแบรนด์ #fb252b
// สลับกับการ์ด docx ใบก่อนหน้าที่ไล่ "ทองไปเขียว"
//
// ชุดทอง-เงิน-ดำของ NATO168 ที่เคยค้างในไฟล์นี้ (#3a2a0d #101010 #fde8a8 #edb543
// #a9761f #1a1203 #e6e6e6 #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#e4f2e4] via-[#4ade6b] to-[#fb252b] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#01a326] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#0a4a18] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#4ade6b] via-[#12c23a] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#030a05] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffe9a8] to-[#f2b422] font-black text-[#06140a] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#4ade6b]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#4ade6b] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#fb252b]/45 pl-4 text-left text-base leading-relaxed text-[#e4f2e4]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
