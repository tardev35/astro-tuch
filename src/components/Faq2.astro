---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
// **Do not rewrite this back into a button + max-height accordion.**
//
// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-madum168.md §2
// **แดงคริมสันนำ · อะซัวร์เป็นวัสดุที่สอง (ไม่ถือตัวอักษร) · บนน้ำเงินเที่ยงคืน**
// แผง Faq ที่ใช้งานจริงรอบนี้คือไฟล์นี้ — รอบก่อน (นาซ่า168) ใช้ Faq4 จึงหมุนมาที่นี่
// และไฟล์นี้ยังถือพาเลตต์ **ทองนำ-ครีมอุ่นของ เงินทอง168** อยู่ทั้งไฟล์ จึงรีเธม
// ทั้งใบก่อนใช้ หน้าแรกส่ง **docx H2 §8** มาให้ ("คำถามที่พบบ่อยเกี่ยวกับ <แบรนด์>"
// — content.txt บรรทัด 17) พร้อม prop `faqs` สามคู่จากบรรทัด 18–23 **แบบส่งชัดเจน
// ไม่พึ่ง default** (ไฟล์นี้ตั้งใจ ship ลิสต์ว่าง คำถามที่หายไปจึงเป็นหีบเปล่า
// ไม่ใช่คำถามของแบรนด์ก่อน)
//
// รูปทรงของใบนี้ (ล็อกไว้ให้ไม่ซ้ำกับกล่อง docx ใบอื่นบนหน้าเดียวกัน):
// **แถวมุมตัดเฉียง 20px บนผิวจม ไม่มีการ์ดครอบทั้งลิสต์** — แต่ละคำถามเป็นแผ่นของ
// ตัวเอง ห้ามเปลี่ยนไปเป็นการ์ดมุมกลมซ้อนในกล่องใหญ่ เพราะ §1/§3/§4/§7 ถือรูปทรงนั้น
// อยู่แล้วบนหน้าเดียวกัน และมุมตัด 36px/40px เป็นของ §5/§6 ไปแล้ว
// แผงนี้ปิดท้ายสายบทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #050e26**
// ซึ่งเป็นก้นสุดของลำดับความลึกรอบนี้ (#16234a ยก / #0b1733 กลาง / #050e26 จม /
// #00091f พื้นเพจ)
// ⚠️ พื้นเพจรอบนี้เป็น **น้ำเงินเที่ยงคืน #00091f** ตาม bg.json ซึ่ง *เข้มกว่า*
// ผิวจมเล็กน้อย แถวคำถามจึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้นเพจได้จริงโดยไม่ต้อง
// เพิ่มเงา
// กรอบมุมตัดเฉียงเป็นเส้น #2a3c70 ล้อมแผ่นผิวจม แถบไล่เฉดบนกรอบวิ่ง **แดงคริมสัน
// #ff2e52 → แดงลึก #c9102f → โปร่ง** ⚠️ แถบนั้นเป็น **พื้นถมของกรอบ 1px** ไม่ใช่
// ตัวอักษร #c9102f และ #2a3c70 จึงอยู่ตรงนั้นได้ทั้งที่ §2 ห้ามถือตัวอักษร
// ป้ายเครื่องหมายคำถามเป็น **แผ่นถมแดงทึบ** ไล่ #e01238 → #c9102f บนหมึก **ขาว**
// (4.9:1 และ 5.8:1 — สูตร "ปุ่มหลัก" ของ §2) ⚠️⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #ff2e52
// แล้ววางหมึกขาว** เพราะขาวบน #ff2e52 ได้แค่ 3.6:1 และ §2 ห้ามไว้ตรงๆ
// กลีฟ ? เป็น aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็น **แดงคริมสัน #ff2e52** (5.3:1 บนผิวจม) ส่วนคำตอบเป็นสีเนื้อความ
// **#f4eef1** (= BRAND_TEXT, 17.0:1 บนผิวจม) เส้นคั่นคำตอบเป็นแดงคริมสันแบบโปร่ง
// และลูกศรเป็นแดงคริมสัน
// หัวข้อเป็นไล่เฉด **สองสต็อป แดงคริมสัน #ff2e52 → แพลทินัม #d9dfe9** ซึ่งเป็นคู่
// สต็อปที่ไม่ซ้ำกับกล่องใดบนหน้า (§1 เป็นแผ่นถมแดงหมึกขาว · §3 ทึบ + เรืองแสง ·
// §4 ทึบ + แท่งตั้ง · §5 ทึบ + ชิปกลีฟ · §6 ทึบ + สันซ้าย · §7 ทึบคร่อมเส้นคู่)
// และขีดใต้หัวข้อเป็น **แดงคริมสัน**
// ⚠️ ไล่เฉดหัวข้อถูก bg-clip-text จึงเป็น **พิกเซลของตัวอักษร** ทั้งสองสต็อปจึง
// ต้องถือตัวอักษรได้ตาม §2 และทั้งคู่ผ่าน (บนพื้นเพจ #00091f: #ff2e52 5.4:1 และ
// #d9dfe9 14.6:1 — หัวข้อเป็น text-2xl/3xl font-black = large text)
// ⚠️⚠️ **ห้ามเอา #1177e8 / #0e68cc / #0a4ea8 / #c9102f / #2a3c70 มาเป็นสต็อปของ
// ไล่เฉดที่เป็นตัวอักษร** — ทั้งห้าค่าเป็นพื้นถม/เส้นเท่านั้นตาม §2
// glow ที่ใช้มีสองชุดตาม §2: rgba(255,46,82,α) และ rgba(201,16,47,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **แทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง
// ของตัวเอง และรอบนี้ไม่มีทองเลยสักค่า** ทองที่เคยผ่านไฟล์นี้: f5ba14 fcee52 b37c0b
// (เงินทอง168 — ชุดที่เพิ่งถอดออกรอบนี้) fee45d e6a416 b8780d 7a4e05 (ยูฟ้า168)
// eeae12 fded41 9f600d e29f0f fdf051 (พักยก168) fdcb0c fefb6b 8a6504 (สบาย168)
// f0bb4e ffeccb d9701a (รวยเทพ168) f9a826 704504 (รวยแทร่168) fcd45c 6b4a08 (มีเฮ168)
// ffc82e ffefbb 5c4a16 (สบายเบท168) fef54b 6b5c10 (นินจา168) ffd84d (ถอนชัวร์168)
// fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168)
// dfa310 (TND168) e2b33f (KMD88) e5a81b (UFA324) dcb95f c99a3f (รวยแท้168) f0b46a
// (โปรดี168) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f2b705
// (SUPERSLOTCLUB) f7d14e (KOON234) fbc134 ffe87a cf9a18 96690a (NAZA168 ตัวละติน)
// ffd666 f2c230 ffe066 ffe49a 8a6210
// ⚠️⚠️ **แดงเป็นฮิวนำรอบนี้ จึงเป็นกับดักใหม่ที่ต้องเทียบหนักที่สุด** — แดงรอบนี้
// คือ **#ff2e52 (R255 G46 B82) · #e01238 · #c9102f** เท่านั้น แดงที่เคยผ่านไฟล์นี้
// และของแบรนด์อื่น: e4021b (รวยเทพ168) fb1b32 ff8f9c 5c0410 (มีเฮ168) b3121b 5a0a0e
// f2bba5 c98a74 (ขวัญใจ168) fb131b ff4d55 (TKB55) eb0305 e40303 c20305 9b0a0c
// ff4446 (โปรดี168) c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef (รวยแท้168) fb141b
// ff5f63 ffa0a2 db040b 8a0609 (GT66B) fa0513 ff5a5f ffadaf (สมหวัง168) d9212a
// 8e1a16 (ดวงเศรษฐี168) d30304 a00203 ff6b6e (รับตัง168) dc0203 f5282a (หวย365)
// dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) fa63b9 ffb3de (ถอนชัวร์168) f5469f
// ff8dc6 8c0f52 (มีโชค168) ff3b14 6d0804 2b0000 (FLASH877)
// 🚨 ฟ้า/น้ำเงินที่เคยผ่านไฟล์นี้ — **เคยนำมาแล้วเจ็ดแบรนด์ "เจอฟ้า ≠ เป็นของ
// รอบนี้"**: 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722
// 33455f 0d1017 (**นาซ่า168 — แบรนด์ขาออก**) 18a5e2 0d6b9b 0a5176 a9d7f2 16294a
// 111a3f 202a66 31408a (ร่ำรวย168) 2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a
// (สบาย168) 039cfa c3ebfc 04366b 031320 (รวยแทร่168) 2f9ff5 a8dcff 0b3f78
// (สบายเบท168) 32bcfb a9e9ff 07335f (นินจา168) 0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f (TSDET911) — **อะซัวร์รอบนี้คือ
// #1177e8 / #0e68cc / #0a4ea8 เท่านั้น และทั้งสามค่าไม่ถือตัวอักษร**
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a d8ffc7 e9fbdd) ชุดชมพูฮอตพิงก์-ทองของ **PUNPRO168** (f41571
// ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a0426 2a0012 3a0a2a) ชุดม่วงราชา-ทอง
// ของ **KMD88** (7505cc b453ff c07cff ffdf8c ece2f8 1d0832 140522 0a0213) ชุดชมพู
// ฮอต-ทองของ **FAH999** (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d 7a0046 4d002b 2b0019)
// ชุดส้มอำพันเสือของ **TIGERWIN369** (d98324 f7b733 ffd98a f7e4c0 1a0d02 2d1c0a
// 0f0903) และชุดมรกต-ทองของ **KOON234** (0a6b32 2fbf6a cc920a e8f2e6)
// ⚠️⚠️ **วัสดุที่สองรอบนี้คืออะซัวร์ ไม่ใช่ครีมและไม่ใช่เทาเงิน** — ecd5c4 d2b9a4
// (เงินทอง168) f4e4d3 e4cbb3 (ร่ำรวย168) e0e0df c0c0bf a1a09e f4ead6 d6c6a8
// (พักยก168) e8ecf1 a8b2bf 78828f 5a6472 (ยูฟ้า168) e9eef4 aeb9c6 f2e4e5 (TKB55)
// cfd9e6 (รับตัง168) 8792a0 b9c2cc 464f5a (UFA324) dceefc (นินจา168) — **ห้ามเหลือ
// ไว้สักค่า** รอบนี้มี **#d9dfe9 ตัวเดียว** เป็นแพลทินัม ซึ่งเป็นค่าใหม่
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อให้สวีปที่ไล่หา "#" ไม่สะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีโรสโกลด์
// ไม่มีส้ม/ทองแดง ไม่มีครีม/เบจ และ ⚠️⚠️ ไม่มีแรมป์เทาเงิน**
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#ff2e52] to-[#d9dfe9] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2e52] to-transparent shadow-[0_0_10px_rgba(255,46,82,0.55)]" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#2a3c70] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#ff2e52] via-[#c9102f] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#050e26] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#e01238] to-[#c9102f] font-black text-white italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#ff2e52]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#ff2e52] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#ff2e52]/70 pl-4 text-left text-base leading-relaxed text-[#f4eef1]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
