---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file. The shared
// `name` makes the group exclusive — opening one answer closes the others, again
// with no script. The badge and the arrow are aria-hidden, so a question's
// accessible name is the question text itself.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): กรอบแดงลึก #6b0207 บางๆ มุมตัดเฉียงแบบลาย
// วงจรรอบแผงดำอมแดง #120b0c แถบไล่เฉดบนกรอบวิ่งทองอ่อน #fde79a → ทองรอง #f3c623
// ตามเหรียญทองในงานอาร์ต ป้ายเครื่องหมายคำถามเป็นทองเต็มใบบนหมึกเข้ม #1a0203
// (12.4:1) ไม่ไล่ไปจบที่แดง เพราะหมึกเข้มบนแดงได้แค่ 3.85:1 ซึ่งตกเกณฑ์ คำถามเป็น
// ทองรอง คำตอบเป็นสีเนื้อความ #f0e2e2 (BRAND_TEXT) เส้นคั่นคำตอบเป็นแดงลึกและ
// ลูกศรเป็นแดงสว่าง #ff2d38 — ชุดทอง-เขียวของ PGW44 ที่ค้างในไฟล์นี้ (#fde90e
// #fff89a #f5c518 #35d413 #1f5a16 #0b1408 #10160a #e9f0dd) หายไปทั้งหมด
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#dc020e] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#6b0207] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details name="faq-lottoplus" class="faq-item relative bg-[#120b0c] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#fde79a] to-[#f3c623] font-black text-[#1a0203] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f3c623]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#ff2d38] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#6b0207] pl-4 text-left text-base leading-relaxed text-[#f0e2e2]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
