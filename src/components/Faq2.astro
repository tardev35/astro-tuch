---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, faqs = [] } = Astro.props;
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#e8e6ee] via-[#c47bff] to-[#9d16f1] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#9d16f1] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#150726] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div class="absolute inset-0 bg-gradient-to-r from-[#9d16f1] via-[#4a0b8f] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details class="faq-item relative bg-[#06020e] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#c47bff] to-[#2c045c] font-black text-[#06020e] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f5ebff]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#c47bff] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#9d16f1]/70 pl-4 text-left text-base leading-relaxed text-[#ece0fb]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  /* <details> carries the open/close state, the keyboard handling and the
     expanded/collapsed announcement, so there is no JS here to get wrong.
     The badge and the arrow are aria-hidden, so the accessible name of a
     question is the question. The question is a <span>, not a heading — the
     docx has no h3 here and a chrome accordion is not article structure. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
