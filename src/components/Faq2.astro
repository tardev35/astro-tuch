---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  as?: "h2" | "h3";
  faqs?: FaqItem[];
}

// No default FAQ list on purpose — a default here is always some previous
// brand's copy, and it ships silently the moment a page forgets the prop.
const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The section title's level comes from the page, because the docx decides it,
// and its text arrives as a prop. The questions stay <span>: the docx marks no
// heading for them, and a chrome accordion is not article structure. So this
// file emits exactly one heading tag — the one the page asked for — and never a
// second at any level.
//
// <details> carries the open/close state, the keyboard handling and the
// expanded/collapsed announcement, so there is no JS in this file and no
// aria-expanded to keep in sync by hand. The shared `name` makes the group
// exclusive — opening one answer closes the others, again with no script. It is
// deliberately brand-neutral ("site-faq"): a group name carrying a previous
// brand's slug is the kind of string a rebrand misses. The badge and the arrow
// are aria-hidden, so a question's accessible name is the question text itself.
//
// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13, brand-spec §2): แผงนี้ปิดท้ายสาย
// บทความ จึงนั่งลึกที่สุดของหน้า — แถวคำถามอยู่บน **ผิวจม #0d0304** ซึ่งเป็นก้นสุด
// ของลำดับความลึกรอบนี้ (#2a0d0f ยก / #1a0708 กลาง / #0d0304 จม / #000000 พื้น)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท** ตาม bg.json จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// กรอบมุมตัดเฉียงเป็นแดงแบรนด์ #fb131b ล้อมแผงผิวจม แถบไล่เฉดบนกรอบวิ่งเงินโครเมียม
// สว่าง #e9eef4 → เงินโครเมียมหม่น #aeb9c6 ตามเลข 55 ขัดเงาในโลโก้และผมขาวเงินของ
// คู่นายแบบ-นางแบบในงานอาร์ต
// ป้ายเครื่องหมายคำถามเป็นแดงเต็มใบ ไล่แดงสว่าง #ff4d55 → แดงแบรนด์ #fb131b บนหมึก
// แดงเกือบดำ #1a0304 (§2 ระบุว่า #1a0304 เป็นหมึกตัวเดียวที่วางบนพื้นแดงตันได้ —
// 6.2:1 บน #ff4d55 และ 4.9:1 บน #fb131b และห้ามพลิกไปใช้หมึกสว่าง) กลีฟ ? เป็น
// aria-hidden จึงเป็นของตกแต่งล้วน ไม่ได้ถือข้อมูล
// คำถามเป็นเงินโครเมียมหม่น #aeb9c6 (8.9:1 บนผิวการ์ด สูงกว่านั้นบนผิวจม) ส่วนคำตอบ
// เป็นสีเนื้อความ #f2e4e5 (= BRAND_TEXT, 16.8:1 บนผิว #0d0304) เส้นคั่นคำตอบเป็นแดง
// แบรนด์แบบโปร่ง และลูกศรเป็นแดงสว่าง #ff4d55
// หัวข้อไล่ แดงแบรนด์ #fb131b → แดงสว่าง #ff4d55 → เงินโครเมียมสว่าง #e9eef4 คือ
// แดง-แดง-เงิน ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่อง docx ใบใดในหน้าเดียวกัน
// §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษร — ที่นี่อยู่ที่กรอบ พื้นป้าย
// และเส้นคั่น ไม่มีตัวไหนถือตัวอักษรเลย และ #ff8a8f ถูกสงวนไว้ให้ <strong> ในย่อหน้า
// จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** และโค้ดเบสนี้มีแบรนด์
// แดงมาแล้วสามเจ้า: SUPERSLOTCLUB (#e8232a #7d0f12 #4a0605 #180800 #f2b705 #ffd666)
// PIGPG (#d4200d #f5b61d #ffd87a #120302 #2a0806 #6b0402 #fdf9e4 #fdeedd) และ
// FLASH877 (#ff3b14 #8c0f0a #2b0000 #f5c518) — ไม่มีตัวไหนเป็น #fb131b (R=251 G=19
// B=27) ของรอบนี้ ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#f41571
// #ff5ca8 #fce343 #ffc554 #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #3a0a2a) ชุดม่วง
// ราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff #e2b33f #ffdf8c #ece2f8 #1d0832 #140522
// #0a0213) ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff
// #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f) ชุดชมพูฮอต-ทองของ FAH999
// (#ff3fa4 #ff6cbb #ffd1ea #fde8f3 #f5c53d #ffe49a #7a0046 #4d002b #2b0019) ชุดทอง
// อำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a #f7e4c0 #1a0d02 #2d1c0a #0f0903)
// และชุดมรกต-ทองของ KOON234 (#0a6b32 #2fbf6a #cc920a #f7d14e #e8f2e6) ออกครบทุกจุดแล้ว
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-6">
        <HeadingTag class="bg-gradient-to-r from-[#fb131b] via-[#ff4d55] to-[#e9eef4] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </HeadingTag>
        <div aria-hidden="true" class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb131b] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#fb131b] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[#e9eef4] via-[#aeb9c6] to-transparent opacity-45 transition-opacity group-hover:opacity-100" />

        <details name="site-faq" class="faq-item relative bg-[#0d0304] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ff4d55] to-[#fb131b] font-black text-[#1a0304] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#aeb9c6]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#ff4d55] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#fb131b]/70 pl-4 text-left text-base leading-relaxed text-[#f2e4e5]">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
