---
// FAH999 (รอบชมพูบานเย็น-ทอง 2026-10-11): ติ๊กเกอร์ประกาศที่ใช้งานรอบนี้
// หมุนมาจาก Announcement6 ของ DUCK1688 — ทรงแถบเตี้ย 40px ขอบล่างหนา พร้อมป้าย
// "LIVE UPDATE" ลอยคร่อมมุมซ้ายบน คนละทรงกับแถบเต็มความกว้างที่ไล่ข้อความสามชุด
// ของ Announcement6
//
// ⚠️ ค่า default ของ message ในตระกูลนี้คือ "สโลแกนของแบรนด์เก่า" ทุกไฟล์ —
// ไฟล์นี้ค้างของ FIN8888 ไว้ ทุกหน้าในเว็บเรียก <Announcement /> แบบเปล่า
// (ไม่ส่ง prop) โดยตั้งใจ เพื่อให้ติ๊กเกอร์พูดเหมือนกันทั้งเว็บ ค่า default
// ด้านล่างจึงต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ไม่ใช่ filler กลางๆ
//
// ข้อความมาจากบรีฟรอบนี้ (src/assets/content.txt) ล้วน: ฟาสล็อตเว็บตรง /
// เล่นสล็อตระบบแท้ / ทางเข้าหลัก / Login ใช้งานง่าย / คืนยอดเสีย 0.3% เข้ายูส /
// แนะนำเพื่อน 0.8% ไม่จำกัด / แอดมิน 24 ชั่วโมง — ไม่มีตัวเลขหรือคำกล่าวอ้างใด
// ที่บรีฟไม่ได้พูด
// ⚠️ ห้ามขึ้นต้นด้วยอีโมจิ: marquee เรนเดอร์ข้อความซ้ำสองชุด และอีโมจิที่ฝังใน
// text prop ทำ aria-hidden ไม่ได้ จึงถูกอ่านออกเสียงซ้ำ
//
// พาเลตต์ตาม brand-spec §2: ชมพูบานเย็น #ff3fa4 เป็นขอบล่างและต้นไล่เฉดของป้าย ·
// ชมพูอ่อน #ffd1ea เป็นปลายสว่างของป้าย · หมึกพลัมเกือบดำ #2b0019 อยู่บนป้าย
// ชมพู (5.8:1 ที่ปลายเข้มสุดของไล่เฉด ผ่าน AA) · พื้นแถบพลัมลึก #210220 ·
// เนื้อความ #fde8f3
// ชุดฟ้า-อำพันของ FIN8888 (#0891b2 #0a1628 #051022 #f59e0b #fcd34d #dbeafe)
// ถอดออกครบแล้ว และชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 ไม่เคยอยู่ในไฟล์นี้
//
// เป็น chrome ล้วน จึงไม่มี heading tag — ป้าย LIVE UPDATE เป็น <span>
const {
  message = "FAH999 ฟาสล็อตเว็บตรง เล่นสล็อตระบบแท้ • ทางเข้าหลัก Login ใช้งานง่าย • คืนยอดเสียทุกวัน 0.3% เข้ายูส • แนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด • แอดมินออนไลน์ 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-[#ff3fa4] bg-[#210220] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-gradient-to-r from-[#ff3fa4] to-[#ffd1ea] px-3 py-0.5 shadow-[0_4px_10px_rgba(255,63,164,0.5)]">
      <div aria-hidden="true" class="h-2 w-2 animate-pulse rounded-full bg-[#2b0019]"></div>
      <span class="text-[10px] font-black tracking-widest text-[#2b0019] md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_22s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-[#fde8f3]/90">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
