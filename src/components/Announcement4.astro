---
const {
  message = "COCOPLUS เว็บรวมเกมพนันออนไลน์ ทุกค่ายดังครบวงจร มาตรฐานสากลระดับเอเชีย พร้อมระบบฝากถอนอัตโนมัติและแอดมินดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-[#c8102e] bg-[#0c0505] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-gradient-to-r from-[#e8b74a] to-[#f6d78a] px-3 py-0.5 shadow-[0_4px_10px_rgba(200,16,46,0.5)]">
      <div class="h-2 w-2 animate-pulse rounded-full bg-[#2a0505]"></div>
      <span class="text-[10px] font-black tracking-widest text-[#2a0505] md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_22s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-[#f3e6d3]/90">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
