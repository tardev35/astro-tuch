---
import { BRAND_NAME } from "../lib/brandProfile";

// มีทรัพย์168 (รอบธีมสว่าง 2026-10-21): ติ๊กเกอร์ประกาศที่ใช้งานรอบนี้ หมุนมาจาก
// Announcement5 ของ ดวงเศรษฐี168 — ทรงแถบเตี้ย 40px ขอบล่างหนา พร้อมป้าย
// "LIVE UPDATE" ลอยคร่อมมุมซ้ายบน คนละทรงกับ Announcement5 ของรอบก่อน
//
// ⚠️ ค่า default ของ message ในตระกูลนี้คือ "สโลแกนของแบรนด์เก่า" ทุกไฟล์ —
// ไฟล์นี้ค้างของ FAH999 ไว้ ทุกหน้าในเว็บเรียก <Announcement /> แบบเปล่า
// (ไม่ส่ง prop) โดยตั้งใจ เพื่อให้ติ๊กเกอร์พูดเหมือนกันทั้งเว็บ ค่า default
// ด้านล่างจึงต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ไม่ใช่ filler กลางๆ
//
// ข้อความมาจากบรีฟรอบนี้ (src/assets/content.txt) ล้วน: ระบบดูแลการเงิน /
// ฝากถอนทุกช่องทาง / ปลอดภัยไม่ผ่านม้า / ธนาคารชั้นนำและวอลเลท / ตรวจสอบชื่อบัญชี
// ปลายทาง / คืนยอดเสีย 0.3% เข้ายูสทุกวัน / แนะนำเพื่อน 0.8% ไม่จำกัด / แอดมิน
// 24ชม. / ไม่เปิดเผยรหัสผ่านหรือรหัส OTP — ไม่มีตัวเลขหรือคำกล่าวอ้างใดที่บรีฟ
// ไม่ได้พูด และ **ไม่มีชื่อธนาคารหรือชื่อค่ายเกมเฉพาะเจาะจง** เพราะบรีฟไม่ระบุ
// ⚠️ คำของรอบก่อน (เว็บสอนเล่นเกมออนไลน์ / จากเศรษฐีพนันมือ1 / บาคาร่า / สูตร /
// เทคนิค / 3 ขั้นตอน) ถอดออกครบแล้ว — **บาคาร่าไม่อยู่ในบรีฟรอบนี้**
// (บรีฟระบุ สล็อต ไฮโล ยิงปลา หวย บอล = ห้าหมวด ไม่ใช่หก)
// ⚠️ ห้ามขึ้นต้นด้วยอีโมจิ: marquee เรนเดอร์ข้อความซ้ำสองชุด และอีโมจิที่ฝังใน
// text prop ทำ aria-hidden ไม่ได้ จึงถูกอ่านออกเสียงซ้ำ
//
// พาเลตตาม .claude/brand-spec-meesub168.md §2 — ⚠️ รอบนี้พื้นเพจเป็นชมพูอมม่วง
// สว่าง #f0ccf5 (จาก bg.json) ติ๊กเกอร์เป็น **โครม** จึงยังเป็นพลัมเข้มเพื่อ
// ให้อ่านชัดบนพื้นสว่าง และตรงกับแคปซูลดำขอบชมพูในอาร์ตเวิร์กเอง:
//   พื้นแถบพลัมจม #2d0720 · ขอบล่างชมพูบานเย็น #dd1b74 · เนื้อความ #f7dcf6
//   ป้าย LIVE UPDATE ถมไล่เฉด #dd1b74 → #a4186b แล้ววาง #ffffff ทับ
//   (4.67:1 ที่ปลายสว่างสุดของไล่เฉด ผ่าน AA — จุดที่เข้มกว่ายิ่งผ่านสบาย)
// ⚠️ **#dd1b74 ห้ามถือตัวอักษรบนพื้น #2d0720** (3.86:1 ตกเกณฑ์สำหรับ text ขนาดปกติ)
// จึงเป็นขอบและพื้นถมเท่านั้น
// ชุดชมพู-ทองของ FAH999 (ff3fa4 ffd1ea 2b0019 210220 fde8f3) ถอดออกครบแล้ว
// ชุดฟ้า-อำพันของ FIN8888 (0891b2 0a1628 051022 f59e0b fcd34d dbeafe) ไม่เคยอยู่ที่นี่
// ⚠️ ff3fa4 ของ FAH999 เป็น **ชมพูคนละค่า** กับ dd1b74 ของรอบนี้ (ห่าง 62 หน่วย)
// — การเจอ "ชมพูอยู่แล้ว" ในไฟล์ไม่เคยพิสูจน์ว่าเป็นของรอบปัจจุบัน
//
// เป็น chrome ล้วน จึงไม่มี heading tag — ป้าย LIVE UPDATE เป็น <span>
const {
  message = `${BRAND_NAME} ระบบดูแลการเงิน ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า • รองรับฝากถอนผ่านธนาคารชั้นนำและวอลเลทตามที่เปิดให้บริการ ควรตรวจสอบชื่อบัญชีปลายทางให้ตรงกับข้อมูลทางการก่อนโอนทุกครั้ง • คืนยอดเสีย 0.3% เข้ายูสทุกวันตามเงื่อนไขที่ระบุ • แนะนำเพื่อนรับโบนัส 0.8% ไม่จำกัด • ติดต่อเจ้าหน้าที่ได้ตลอด 24ชม. และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
} = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-[#dd1b74] bg-[#2d0720] shadow-[0_2px_10px_rgba(74,13,53,0.45)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-gradient-to-r from-[#a4186b] to-[#dd1b74] px-3 py-0.5 shadow-[0_4px_10px_rgba(221,27,116,0.5)]">
      <div aria-hidden="true" class="h-2 w-2 animate-pulse rounded-full bg-white"></div>
      <span class="text-[10px] font-black tracking-widest text-white md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_26s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-[#f7dcf6]/90">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_26s_linear_infinite\] {
      animation: none;
    }
  }
</style>
