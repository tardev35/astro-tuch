---
const {
  message = "FIN8888 แบรนด์เกมสล็อต รองรับทุกเครือข่าย • แนะนำเพื่อนรับโบนัส 0.8% • คืนยอดเสียทุกวัน 0.3% • ฝากครั้งแรกรับโบนัสสมาชิกใหม่",
} = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-[#0891b2] bg-[#0a1628] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-gradient-to-r from-[#f59e0b] to-[#fcd34d] px-3 py-0.5 shadow-[0_4px_10px_rgba(8,145,178,0.5)]">
      <div class="h-2 w-2 animate-pulse rounded-full bg-[#051022]"></div>
      <span class="text-[10px] font-black tracking-widest text-[#051022] md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_22s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-[#dbeafe]/90">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
