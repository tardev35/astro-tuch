---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น navbar ที่ใช้
// งานจริงรอบนี้ (รอบก่อน MAHAGAME66 ใช้ NavbarStyle8) ของเดิมที่ค้างอยู่เป็น
// พาเลตต์เขียวมรกต-ทองของ HENG38 ย้ายทั้งไฟล์มาเป็นทอง-เงินโครเมียมบนดำแล้ว
// ไม่เหลือเฉดเขียวเดิมสักจุด
//
// แกนสี: แถบนำทางดำอมน้ำตาล #0a0702 ยกระดับด้วย #26200e / #3a3116 · ทองแบรนด์
// #e0b429 กับทองสว่าง #fbd564 เป็นเส้นใต้เมนู ขอบปุ่ม และแสงเรือง · ทองอ่อน
// #fde9a3 สงวนไว้ให้ลิงก์ที่ active กับชื่อแบรนด์ · เงินโครเมียม #dfe4ec เป็น
// ปลายเกรเดียนต์ให้ตรงกับโลโก้ที่ U/33 เป็นทองแล้ว WIN เป็นเงิน · เนื้อความ
// #ece6d8 (BRAND_TEXT) ลดน้ำหนักด้วย opacity
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน 🎲 ให้เข้ากับแบรนด์ที่รวมบาคาร่า รูเล็ต ไฮโล สล็อต บอล หวย ไว้ด้วยกัน
// ไม่ใช่เว็บสล็อตล้วน — และไม่มี /ตรวจหวย หรือ /แนวทาง เพราะ UWIN33 ไม่ใช่เว็บหวย
// เฉพาะทาง ทั้งสองหน้าจึงถูกปิดไว้ใน src/pages-disabled/
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#e0b429]/45 bg-[#0a0702]/90 px-4 shadow-[0_10px_30px_rgba(224,180,41,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(251,213,100,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ UWIN33 ตัวอักษรตัวหนาสามมิติบนพื้นโปร่ง ตัว U และเลข 33 เป็นสีทองขัดเงาไล่แสงเป็นประกาย ส่วนคำว่า WIN ตรงกลางเป็นสีเงินโครเมียม ทุกตัวอักษรมีขอบไฮไลต์สว่างและเงาตกด้านล่าง"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="text-4xl font-black tracking-widest drop-shadow-md">
            <span class="bg-gradient-to-r from-[#fde9a3] to-[#b8860b] bg-clip-text text-transparent">U</span><span
              class="bg-gradient-to-r from-[#f4f7fa] to-[#a6adb9] bg-clip-text text-transparent">WIN</span><span
              class="bg-gradient-to-r from-[#fde9a3] to-[#b8860b] bg-clip-text text-transparent">33</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#fde9a3]" : "text-[#ece6d8]/70 hover:text-[#fde9a3]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] shadow-[0_-2px_10px_rgba(251,213,100,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#e0b429]/55 bg-[#26200e]/75 px-7 py-2.5 text-sm font-bold text-[#fde9a3] backdrop-blur-md transition-all duration-300 hover:bg-[#3a3116]/80 hover:text-[#fde9a3] hover:shadow-[0_0_15px_rgba(251,213,100,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#fde9a3] via-[#fbd564] to-[#e0b429] px-7 py-2.5 text-sm font-black text-[#161106] shadow-[0_4px_15px_rgba(251,213,100,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(251,213,100,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#e0b429]/40 bg-[#26200e]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#e0b429] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#e0b429] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#e0b429] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#e0b429]/45 bg-[#0a0702]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#e0b429]/25 text-[#fde9a3] shadow-inner" : "text-[#ece6d8]/70 hover:bg-[#e0b429]/12 hover:text-[#fde9a3]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#fde9a3] via-[#fbd564] to-[#e0b429] py-3.5 text-lg font-black text-[#161106] shadow-[0_5px_15px_rgba(251,213,100,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#e0b429]/55 bg-[#26200e]/75 py-3.5 text-lg font-bold text-[#fde9a3]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
