---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// รวยเทพ168 (รอบทองจักรพรรดิ-แดงชาดบนดำสนิท 2026-10-20): ไฟล์นี้ถูกเลื่อนขึ้นมา
// เป็น navbar ที่ใช้งานจริงรอบนี้ แทน NavbarStyle9 ของ มีเฮ168 — หนึ่งไฟล์ต่อ
// หนึ่งรอบเท่านั้น ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของที่ค้างอยู่ก่อนหน้าเป็นชุดทองอำพันเสือของ TIGERWIN369 (d98324 / ffd98a /
// f7b733 / 8a5214 / 1c1206 / 2d1c0a / 1a0d02 / f7e4c0) ก่อนนั้นเป็นชุดทอง
// เมทัลลิก-เงินโครเมียมของ UOK365 (0a0806 / 19100a / 2a1b0d / c8912f / f5d98a /
// a46b25 / 6d4412 / 191005 / ece1cc / d8dbe0) และก่อนนั้นเป็นชุดทอง-ดำของ NAZA99
// (140c02 / 241404 / 3a2409 / e4b34d / fdf2ac / c08f2b / 8a5f12 / 1a1000 /
// f3e8cf) — ย้ายทั้งไฟล์มาเป็นทองจักรพรรดิของ รวยเทพ168 แล้วทั้งสามชุด
// (เขียนไม่มี # เพื่อให้ sweep ที่ไล่หา "#hex ของแบรนด์เก่า" ไม่สะดุดที่คอมเมนต์
// ประวัติบรรทัดนี้)
//
// ทรงของ navbar ตัวนี้ต่างจาก NavbarStyle9 ของรอบก่อนคนละแกน: รอบก่อนเป็น "แถบนอน
// sticky + ปุ่มแฮมเบอร์เกอร์วงกลมมุมขวาบนที่กาง overlay เต็มจอด้วย clip-path:
// circle() ขยายจากจุดปุ่ม" ส่วนไฟล์นี้เป็น "แถบบนเต็มความกว้างแบบ sticky สูง 85px
// โค้งมุมล่าง" ที่ active เป็นขีดแนวนอนเรืองแสงที่ขอบล่างของเมนู และ drawer กางลง
// มาจากใต้แถบ
//
// แกนสี (brand-spec §2): แบรนด์นี้เป็น **ทองจักรพรรดินำ แดงชาดเป็นฮิวที่สอง** —
// โลโก้เป็นเทพเจ้าโชคลาภจีนบนริ้วทอง กับตัวอักษร รวย ทอง / เทพ ขาวมุก / 168 แดง
// ลำดับจึงเป็น: แถบนำทางดำสนิท #000000 (= พื้นเพจของ bg.json) ยกระดับด้วยน้ำตาล
// ไหม้ #3b1b0e และ #4a2412 ตอน hover · ทองน้ำผึ้ง #f0bb4e เป็นขอบ ออรา และกลาง
// เกรเดียนต์ · ครีมทอง #ffeccb สงวนไว้ให้ลิงก์ที่ active และปลายสว่างของเกรเดียนต์ ·
// ทองแดง #d9701a เป็นเฉดเงาของทอง · บรอนซ์ลึก #5c2a06 เป็นปลายเข้มสุด (เส้น/ออรา
// เท่านั้น ห้ามถือตัวอักษร) · หมึก #2b1400 บนปุ่มทอง · เนื้อความงาช้างอุ่น #fff8ec
// (= BRAND_TEXT) ลดน้ำหนักด้วย opacity
// ⚠️ **แดงชาด #e4021b ได้คอนทราสต์แค่ 3.2-4.3:1 = ตกเกณฑ์ AA** ในไฟล์นี้จึงใช้
// เป็น **ปลายเกรเดียนต์ของขีดใต้เมนู** และ **พื้นถมของจุดเน้น** เท่านั้น
// ห้ามเป็นสีตัวอักษรบนพื้นเข้ม — เกรเดียนต์ ครีม -> ทอง -> แดง คือลำดับสีของ
// ตัวโลโก้เองพอดี (รวย ทอง -> 168 แดง)
// ⚠️ **รอบนี้ไม่มีเงินโครเมียม ไม่มีฟ้า ไม่มีม่วง** และทองรอบนี้คือ #f0bb4e
// ซึ่ง **ไม่ใช่** d98324/ffd98a/f7b733 ของ TIGERWIN369 ที่เพิ่งถูกแทนที่ไป
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน 🎰 ตรงกับแบรนด์สล็อตรอบนี้ (บรีฟนำด้วย "เกมสล็อตรวยขั้นเทพ") และ 🧧
// (อั่งเปา) ตรงกับธีมเทพเจ้าโชคลาภจีนของอาร์ตเวิร์ก — ไม่ใช่ 🐯 ของแบรนด์เสือ
// รอบก่อน และไม่ใช่ 🃏 ของแบรนด์คาสิโนรวมเกม
// ⚠️ ไม่มี /ตรวจหวย หรือ /แนวทาง ถึงแม้บรีฟรอบนี้จะพูดถึง "หวยออนไลน์" เป็นหนึ่ง
// ในสี่หมวดเกมก็ตาม — รวยเทพ168 เป็นเว็บเกมสล็อต ไม่ใช่เว็บหวย ทั้งสองหน้าจอดอยู่
// ที่ src/pages-disabled/ ถ้าเหลือลิงก์ไว้ verify-build จะจับเป็น href ไปยังหน้าที่
// ไม่มีอยู่ (navbar นี้ขึ้นทุกหน้า จึงผิดทั้งเว็บพร้อมกัน)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🧧" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นเทพเจ้าแห่งโชคลาภของจีนกำลังหัวเราะ สวมหมวกปีกสีทองแต่งสีแดงและเสื้อคลุมสีแดงปักทอง มือถือก้อนทอง นั่งอยู่บนริ้วทองโค้งที่พาดยาวไปทางขวา ถัดมาเป็นคำว่า รวย ตัวอักษรไทยหนาสามมิติสีทองไล่เฉด ต่อด้วยคำว่า เทพ สีขาวมุกตัดขอบเทา และเลข 168 สีแดงชาดผิวมันวาว รอบตัวอักษรมีประกายดาวสีทองและเหรียญทองกระจายอยู่`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#f0bb4e]/45 bg-[#000000]/90 px-4 shadow-[0_10px_30px_rgba(240,187,78,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(255,236,203,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#ffeccb] via-[#f0bb4e] to-[#e4021b] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#ffeccb]" : "text-[#fff8ec]/70 hover:text-[#ffeccb]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#ffeccb] via-[#f0bb4e] to-[#e4021b] shadow-[0_-2px_10px_rgba(240,187,78,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#f0bb4e]/55 bg-[#3b1b0e]/75 px-7 py-2.5 text-sm font-bold text-[#ffeccb] backdrop-blur-md transition-all duration-300 hover:bg-[#4a2412]/85 hover:text-[#ffeccb] hover:shadow-[0_0_15px_rgba(255,236,203,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffeccb] via-[#f0bb4e] to-[#d9701a] px-7 py-2.5 text-sm font-black text-[#2b1400] shadow-[0_4px_15px_rgba(240,187,78,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(240,187,78,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f0bb4e]/40 bg-[#3b1b0e]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f0bb4e] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f0bb4e] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f0bb4e] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#f0bb4e]/45 bg-[#000000]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#f0bb4e]/25 text-[#ffeccb] shadow-inner" : "text-[#fff8ec]/70 hover:bg-[#f0bb4e]/12 hover:text-[#ffeccb]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffeccb] via-[#f0bb4e] to-[#d9701a] py-3.5 text-lg font-black text-[#2b1400] shadow-[0_5px_15px_rgba(240,187,78,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#f0bb4e]/55 bg-[#3b1b0e]/75 py-3.5 text-lg font-bold text-[#ffeccb]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
