---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// WIN999 (รอบทอง-ดำ 2026-09-29): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น navbar ที่ใช้งานจริง
// รอบนี้ (รอบก่อน LOTTO24 ใช้ NavbarHuay) ของเดิมที่ค้างอยู่เป็นพาเลตต์
// ทอง-โครเมียมของ PKG44 ย้ายทั้งไฟล์มาเป็นทองของ WIN999 แล้ว ไม่เหลือเฉดเดิมสักจุด
//
// แกนสี: แถบนำทางดำสนิท #060502 ยกระดับด้วย #251d06 / #40310a · ทองแบรนด์
// #fcc403 กับทองสว่าง #fdda04 เป็นเส้นใต้เมนู ขอบปุ่ม และแสงเรือง · ทองอ่อน
// #fff0a8 สงวนไว้ให้ลิงก์ที่ active · เงิน/ขาว #f2f4f7/#c2c8d0 เป็นปลายเกรเดียนต์
// ให้ตรงกับโลโก้ที่ WIN เป็นทองแล้ว 999 เป็นขาว · เนื้อความ #e9e4d6 (BRAND_TEXT)
// ลดน้ำหนักด้วย opacity
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน 🎲 ตรงกับแบรนด์ที่เป็นเว็บคาสิโน (บรีฟพูดถึงบาคาร่า สล็อต และเกมไพ่) —
// และไม่มี /ตรวจหวย หรือ /แนวทาง เพราะ WIN999 ไม่ใช่เว็บหวย ทั้งสองหน้าจึงถูก
// ปิดไว้ใน src/pages-disabled/ ต่อจากรอบที่แล้ว
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#fcc403]/45 bg-[#060502]/90 px-4 shadow-[0_10px_30px_rgba(252,196,3,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(253,218,4,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ WIN999 ตัวอักษรตัวหนาเอียงบนพื้นดำ คำว่า WIN เป็นสีทองขัดเงาไล่แสงเป็นประกาย ส่วนเลข 999 ต่อท้ายเป็นสีขาวนวล ทุกตัวอักษรมีขอบไฮไลต์สว่างและเงาตกด้านล่าง"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="text-4xl font-black tracking-widest drop-shadow-md">
            <span class="bg-gradient-to-r from-[#fff0a8] via-[#fdda04] to-[#a87d02] bg-clip-text text-transparent">WIN</span><span
              class="bg-gradient-to-r from-[#f2f4f7] to-[#c2c8d0] bg-clip-text text-transparent">999</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#fff0a8]" : "text-[#e9e4d6]/70 hover:text-[#fff0a8]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#f2f4f7] via-[#fdda04] to-[#fcc403] shadow-[0_-2px_10px_rgba(253,218,4,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#fcc403]/55 bg-[#251d06]/75 px-7 py-2.5 text-sm font-bold text-[#fff0a8] backdrop-blur-md transition-all duration-300 hover:bg-[#40310a]/80 hover:text-[#fff0a8] hover:shadow-[0_0_15px_rgba(253,218,4,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#fff0a8] via-[#fdda04] to-[#fcc403] px-7 py-2.5 text-sm font-black text-[#120d02] shadow-[0_4px_15px_rgba(252,196,3,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(252,196,3,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#fcc403]/40 bg-[#251d06]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#fcc403] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#fcc403] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#fcc403] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#fcc403]/45 bg-[#060502]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#fcc403]/25 text-[#fff0a8] shadow-inner" : "text-[#e9e4d6]/70 hover:bg-[#fcc403]/12 hover:text-[#fff0a8]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#fff0a8] via-[#fdda04] to-[#fcc403] py-3.5 text-lg font-black text-[#120d02] shadow-[0_5px_15px_rgba(252,196,3,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#fcc403]/55 bg-[#251d06]/75 py-3.5 text-lg font-bold text-[#fff0a8]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
