---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น navbar ที่ใช้
// งานจริงรอบนี้ (รอบก่อน CK268 ใช้ NavbarStyle6) ของเดิมที่ค้างอยู่เป็นพาเลตต์ทอง-ดำ
// ของ WIN999 ย้ายทั้งไฟล์มาเป็นน้ำเงินรอยัล-ทองของ BRAVO168 แล้ว ไม่เหลือเฉดเดิมสักจุด
//
// แกนสี: แถบนำทางกรมท่าเกือบดำ #02081a ยกระดับด้วย #072247 / #0e3f8f · ทองแบรนด์
// #f4cb69 กับทองอ่อน #ffe39a เป็นเส้นใต้เมนู ขอบปุ่ม และแสงเรือง · ทองอ่อน #ffe39a
// สงวนไว้ให้ลิงก์ที่ active · โครเมียมฟ้าขาว #e8f1ff/#a8bedd เป็นปลายเกรเดียนต์ให้ตรง
// กับโลโก้ที่ BRAVO เป็นโครเมียมไล่น้ำเงินรอยัลแล้ว 168 เป็นทองตัน · เนื้อความ #dbe5f5
// (BRAND_TEXT) ลดน้ำหนักด้วย opacity
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน ⚽ ตรงกับแบรนด์ที่เป็นเว็บแทงบอล (บรีฟพูดถึงบอลเดี่ยว บอลสเต็ป และบอลสด) —
// และไม่มี /ตรวจหวย หรือ /แนวทาง เพราะ BRAVO168 ไม่ใช่เว็บหวย ทั้งสองหน้าจึงถูก
// ปิดไว้ใน src/pages-disabled/ ต่อจากรอบที่แล้ว
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "⚽" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#f4cb69]/45 bg-[#02081a]/90 px-4 shadow-[0_10px_30px_rgba(244,203,105,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(255,227,154,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ BRAVO168 ตัวอักษร BRAVO ตัวหนาทรงเหลี่ยมไล่เฉดจากโครเมียมขาวเงินลงเป็นน้ำเงินรอยัลเข้ม มีเส้นขอบทองบางล้อมทุกตัว ต่อท้ายด้วยเลข 168 สีทองตันเงาวาว เรียงติดกันเป็นบรรทัดเดียว"
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="text-4xl font-black tracking-widest drop-shadow-md">
            <span class="bg-gradient-to-r from-[#e8f1ff] via-[#a8bedd] to-[#1558c4] bg-clip-text text-transparent">BRAVO</span><span
              class="bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text text-transparent">168</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#ffe39a]" : "text-[#dbe5f5]/70 hover:text-[#ffe39a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#e8f1ff] via-[#f4cb69] to-[#c9922e] shadow-[0_-2px_10px_rgba(244,203,105,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#f4cb69]/55 bg-[#072247]/75 px-7 py-2.5 text-sm font-bold text-[#ffe39a] backdrop-blur-md transition-all duration-300 hover:bg-[#0e3f8f]/80 hover:text-[#ffe39a] hover:shadow-[0_0_15px_rgba(255,227,154,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] px-7 py-2.5 text-sm font-black text-[#0a1020] shadow-[0_4px_15px_rgba(244,203,105,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(244,203,105,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f4cb69]/40 bg-[#072247]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f4cb69] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f4cb69] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f4cb69] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#f4cb69]/45 bg-[#02081a]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#f4cb69]/25 text-[#ffe39a] shadow-inner" : "text-[#dbe5f5]/70 hover:bg-[#f4cb69]/12 hover:text-[#ffe39a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] py-3.5 text-lg font-black text-[#0a1020] shadow-[0_5px_15px_rgba(244,203,105,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#f4cb69]/55 bg-[#072247]/75 py-3.5 text-lg font-bold text-[#ffe39a]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
