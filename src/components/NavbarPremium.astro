---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// TIGERWIN369 (รอบทองอำพันเสือบนดำสนิท 2026-10-11): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น
// navbar ที่ใช้งานจริงรอบนี้ แทน NavbarStyle6 ของ UFA324 — หนึ่งไฟล์ต่อหนึ่งรอบ
// เท่านั้น ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของที่ค้างอยู่ก่อนหน้าเป็นชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 (0a0806 / 19100a
// / 2a1b0d / c8912f / f5d98a / a46b25 / 6d4412 / 191005 / ece1cc / d8dbe0) และก่อน
// นั้นเป็นชุดทอง-ดำของ NAZA99 (140c02 / 241404 / 3a2409 / e4b34d / fdf2ac / c08f2b
// / 8a5f12 / 1a1000 / f3e8cf) — ย้ายทั้งไฟล์มาเป็นทองอำพันของ TIGERWIN369 แล้ว
// ทั้งสองชุด (เขียนไม่มี # เพื่อให้ sweep ที่ไล่หา "#hex ของแบรนด์เก่า" ไม่สะดุด
// ที่คอมเมนต์ประวัติบรรทัดนี้)
//
// ทรงของ navbar ตัวนี้ต่างจาก NavbarStyle6 ของรอบก่อนคนละแกน: รอบก่อนเป็น "ราง
// แนวตั้งลอยติดขอบซ้ายจอ" ที่ active เป็นแถบไฮไลต์แนวตั้ง 3px และ drawer ไถลเข้า
// มาจากขอบซ้าย ส่วนไฟล์นี้เป็น "แถบบนเต็มความกว้างแบบ sticky สูง 85px โค้งมุมล่าง"
// ที่ active เป็นขีดแนวนอนเรืองแสงที่ขอบล่างของเมนู และ drawer กางลงมาจากใต้แถบ
//
// แกนสี (brand-spec §2): แบรนด์นี้เป็น **ทองล้วนสองระดับ ไม่มีโลหะเย็นเลย** —
// โลโก้เป็นหัวเสือขนทองอำพันสวมมงกุฎทองกลางเหรียญตราดำ-ทอง ความต่างทั้งหมดจึง
// สร้างจากระดับความสว่างของทอง: แถบนำทางดำสนิท #000000 (= พื้นเพจของ bg.json)
// ยกระดับด้วยน้ำตาลอุ่น #1c1206 และ #2d1c0a ตอน hover · ทองอำพัน #d98324 เป็นขอบ
// และปลายเข้มของเส้นใต้เมนู · ทองซีด #ffd98a สงวนไว้ให้ลิงก์ที่ active และปลาย
// สว่างของเกรเดียนต์ · ทองสว่าง #f7b733 เป็นกลางเกรเดียนต์ · อำพันลึก #8a5214
// เป็นปลายเข้มสุด (เส้น/ออราเท่านั้น ห้ามถือตัวอักษร) · หมึก #1a0d02 บนปุ่มทอง ·
// เนื้อความครีมอมทอง #f7e4c0 (= BRAND_TEXT) ลดน้ำหนักด้วย opacity
// ⚠️ **รอบนี้ไม่มีเงินโครเมียมเลย** เงิน d8dbe0 ของ UOK365 ที่เคยอยู่กลางเกรเดียนต์
// ชื่อแบรนด์ (ตอนไม่มีไฟล์โลโก้) ถูกแทนด้วยทองสว่าง #f7b733 เพื่อให้อ่านเป็น
// "ทองซีด-ทองสว่าง-ทองอำพัน" ตามโลโก้จริงที่ไล่จากหน้าตัวอักษรลงเงา
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน 🐯 ตรงกับแบรนด์เสือรอบนี้ และ 🃏 ตรงกับ "เกมคาสิโนรวม" ของบรีฟ (บาคาร่า
// สล็อต บอลออนไลน์ ไฮโล ยิงปลา) ไม่ใช่ 🎰 ของแบรนด์สล็อตล้วนรอบก่อนๆ —
// และไม่มี /ตรวจหวย หรือ /แนวทาง เพราะ TIGERWIN369 ไม่ใช่เว็บหวย ทั้งสองหน้าจอด
// อยู่ที่ src/pages-disabled/ ถ้าเหลือลิงก์ไว้ verify-build จะจับเป็น href ไปยัง
// หน้าที่ไม่มีอยู่ (navbar นี้ขึ้นทุกหน้า จึงผิดทั้งเว็บพร้อมกัน)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🐯" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเหรียญตรากลมสีดำสลับทอง กลางเหรียญเป็นหัวเสือขนสีทองอำพันสวมมงกุฎทองใบเล็ก ล้อมด้วยวงแหวนสีดำที่ประดับสัญลักษณ์ไพ่โพดำ ดอกจิก ข้าวหลามตัด และโพแดงสีทอง ด้านซ้ายมีไพ่สีดำสองใบกางออกโชว์เอซสีทอง ด้านขวาเป็นกองชิปคาสิโนสีดำขอบทอง ใต้ลงมาเป็นคำว่า ${BRAND_NAME} ตัวหนาสามมิติสีทองวาว และมีมงกุฎทองใบเล็กอยู่ใต้สุด`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#d98324]/45 bg-[#000000]/90 px-4 shadow-[0_10px_30px_rgba(217,131,36,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(255,217,138,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#ffd98a] via-[#f7b733] to-[#d98324] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#ffd98a]" : "text-[#f7e4c0]/70 hover:text-[#ffd98a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#ffd98a] via-[#d98324] to-[#8a5214] shadow-[0_-2px_10px_rgba(217,131,36,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#d98324]/55 bg-[#1c1206]/75 px-7 py-2.5 text-sm font-bold text-[#ffd98a] backdrop-blur-md transition-all duration-300 hover:bg-[#2d1c0a]/85 hover:text-[#ffd98a] hover:shadow-[0_0_15px_rgba(255,217,138,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffd98a] via-[#f7b733] to-[#d98324] px-7 py-2.5 text-sm font-black text-[#1a0d02] shadow-[0_4px_15px_rgba(217,131,36,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(217,131,36,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#d98324]/40 bg-[#1c1206]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#d98324] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#d98324] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#d98324] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#d98324]/45 bg-[#000000]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#d98324]/25 text-[#ffd98a] shadow-inner" : "text-[#f7e4c0]/70 hover:bg-[#d98324]/12 hover:text-[#ffd98a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffd98a] via-[#f7b733] to-[#d98324] py-3.5 text-lg font-black text-[#1a0d02] shadow-[0_5px_15px_rgba(217,131,36,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#d98324]/55 bg-[#1c1206]/75 py-3.5 text-lg font-bold text-[#ffd98a]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
