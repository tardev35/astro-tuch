---
import { isActivePath } from "../lib/nav";
import { BRAND_NAME } from "../lib/brandProfile";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// 123BET (รอบแดงชาด-โครเมียมเงิน-ทองอำพัน บนธีมเนื้อหาสว่าง 2026-10-28): ไฟล์นี้
// ถูกเลื่อนขึ้นมาเป็น navbar ที่ใช้งานจริงรอบนี้ แทน NavbarCyber ของ ZORO365 —
// หนึ่งไฟล์ต่อหนึ่งรอบเท่านั้น ไฟล์เดิมยังอยู่ครบในฐานะ inventory **ห้ามลบ**
// ทรงของ navbar ตัวนี้ต่างจาก NavbarCyber ของรอบก่อนคนละแกน: รอบก่อนเป็น "แถบนอน
// sticky สูง 80px เต็มความกว้างที่ตัดมุมล่างซ้ายด้วย clip-path: polygon()"
// ส่วนไฟล์นี้เป็น "แถบบนเต็มความกว้างแบบ sticky สูง 85px **โค้งมุมล่าง**"
// ที่ active เป็นขีดแนวนอนเรืองแสงที่ขอบล่างของเมนู และ drawer กางลงมาจากใต้แถบ
//
// ของที่ค้างอยู่ก่อนหน้าในไฟล์นี้เป็นชุดทองจักรพรรดิ-แดงชาดบนดำสนิทของ รวยเทพ168
// (000000 / 3b1b0e / 4a2412 / f0bb4e / ffeccb / d9701a / 5c2a06 / 2b1400 /
// fff8ec / e4021b) ก่อนนั้นเป็นทองอำพันเสือของ TIGERWIN369 (d98324 / ffd98a /
// f7b733 / 8a5214 / 1c1206 / 2d1c0a / 1a0d02 / f7e4c0) ก่อนนั้นเป็นทองเมทัลลิก-
// เงินโครเมียมของ UOK365 (0a0806 / 19100a / 2a1b0d / c8912f / f5d98a / a46b25 /
// 6d4412 / 191005 / ece1cc / d8dbe0) และก่อนนั้นเป็นทอง-ดำของ NAZA99 (140c02 /
// 241404 / 3a2409 / e4b34d / fdf2ac / c08f2b / 8a5f12 / 1a1000 / f3e8cf)
// — **กวาดออกครบทั้งสี่ชุดแล้ว**
// (เขียนไม่มี # เพื่อให้ sweep ที่ไล่หา "#hex ของแบรนด์เก่า" ไม่สะดุดที่คอมเมนต์
// ประวัติบรรทัดนี้)
//
// แกนสี (.claude/brand-spec-123bet.md §2): แบรนด์นี้เป็น **แดงชาดนำ เงินโครเมียม
// เป็นคู่รอง ทองอำพันเป็นวัสดุที่สาม** — โลโก้เป็นเวิร์ดมาร์กสามมิติ ครึ่งแรกเป็น
// ตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา
// เหนือขึ้นไปเป็นมงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง วางบนโล่โครเมียมเงินที่มี
// เพชรแดงที่ปลายล่าง
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน: เนื้อหาสว่าง + โครมเข้ม** (รอบก่อนมืดทั้งเว็บ)
// พื้นเพจมาจาก bg.json = **f7e4e9 ชมพูบลัชจาง** ส่วนแถบนี้เป็น **ผิวเข้ม 330710**
// — **ความเข้มของแถบคือสิ่งที่แยกมันออกจากพื้นเพจสว่าง ห้ามทำให้สว่างตาม**
// ลำดับสีจึงเป็น: แถบนำทางแดงเลือดหมูเข้ม #330710 ยกระดับด้วย #4d0c18 ตอน hover ·
// ทองอำพัน #dca53a เป็นขอบ ออรา และปุ่มแฮมเบอร์เกอร์ · หมึกบลัชขาว #fdf5f6
// เป็นตัวอักษรหลัก · เงินโครเมียม #d2d7dd เป็นปลายสว่างของเกรเดียนต์โลโก้ ·
// แดงชาด #a30d1a เป็นพื้นปุ่มสมัครและปลายเข้มของขีดใต้เมนู
// ค่าคอนทราสต์บนแถบ #330710: fdf5f6 16.6:1 · d2d7dd 12.3:1 · dca53a 8.1:1
// ⚠️ **#a30d1a ได้แค่ 2.3:1 บนแถบนี้ = ห้ามเป็นสีตัวอักษรบนพื้นเข้ม** ใช้เป็น
// **พื้นปุ่ม** (ซึ่งรองหมึกขาวที่ 8.0:1) และ **ปลายเกรเดียนต์ของขีดใต้เมนู** เท่านั้น
// เกรเดียนต์ เงิน -> ทอง -> แดง คือลำดับวัสดุของตัวโลโก้เองพอดี
// ⚠️ **รอบนี้ไม่มีเขียวมรกต ไม่มีม่วง ไม่มีฟ้า** และทองรอบนี้คือ #dca53a ซึ่ง
// **ไม่ใช่** f0bb4e/ffeccb ของ รวยเทพ168 และ **ไม่ใช่** e8c86a ของ ZORO365
// ที่เพิ่งถูกแทนที่ไป
// 🚨 **LOTTO189 (แดง/ทอง/ขาวชมพู) เป็นตระกูลสีเดียวกับรอบนี้เป๊ะ** —
// ห้ามตัดสินด้วยสายตา ต้องเทียบหกหลักกับ brand-spec §2
//
// One array for both the desktop bar and the mobile drawer.
//
// Order: หน้าแรก first, then the two conversion actions immediately after
// โปรโมชั่น, then the informational pages. /ทางเข้า is deliberately absent —
// register.astro and login.astro are real pages on this brand, so a third link
// to the same two destinations adds nothing. The page itself stays routed.
// ไอคอน 🃏 ตรงกับบรีฟรอบนี้ที่นำด้วย "เจ้าของบาคาร่าสล็อต" และตรงกับไพ่เอซโพดำ
// ที่อยู่ในแบนเนอร์จริง ส่วน 👑 ตรงกับมงกุฎบนโลโก้และมงกุฎทองที่นางแบบสวมใน
// แบนเนอร์กับสไลด์ทั้งสองใบ — **ไม่ใช่ 🧧 (อั่งเปา) ของแบรนด์เทพเจ้าจีนรอบก่อน
// ของไฟล์นี้ และไม่ใช่ 🐯 ของแบรนด์เสือก่อนหน้านั้น**
// ⚠️ ไม่มี /ตรวจหวย หรือ /แนวทาง ถึงแม้บรีฟรอบนี้จะพูดถึง "หวยออนไลน์" เป็นหนึ่ง
// ในเจ็ดหมวดเกมก็ตาม — 123BET เป็นเว็บเกมคาสิโน ไม่ใช่เว็บหวย ทั้งสองหน้าจอดอยู่
// ที่ src/pages-disabled/ ถ้าเหลือลิงก์ไว้ verify-build จะจับเป็น href ไปยังหน้าที่
// ไม่มีอยู่ (navbar นี้ขึ้นทุกหน้า จึงผิดทั้งเว็บพร้อมกัน)
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

// บรรยายจากบิตแมปจริงของ src/assets/logo.webp ในดรอปนี้ (อ่านด้วย Read ก่อนเขียน)
// **ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลงใน alt ตรงๆ** — navbar ขึ้นทุกหน้า จึงเป็นจุดรั่ว
// ที่กว้างที่สุดในเว็บ ให้บรรยาย "รูปทรงของเวิร์ดมาร์ก" แล้วอ้างชื่อด้วย BRAND_NAME
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กสามมิติตัวหนา ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ไล่จากเงินสว่างด้านบนลงมาหาเทาเข้มด้านล่าง เหนือตัวอักษรเป็นมงกุฎผิวเงินประดับเบาะกำมะหยี่สีแดงและอัญมณีแดง ทั้งชุดวางทับโล่ตราสัญลักษณ์ผิวโครเมียมเงินที่มีริบบิ้นโค้งสองข้างและเพชรสีแดงเจียระไนอยู่ที่ปลายแหลมด้านล่าง มีประกายแสงสีขาวกระจายอยู่ตามขอบตัวอักษร`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#dca53a]/45 bg-[#330710]/92 px-4 shadow-[0_10px_30px_rgba(54,8,15,0.30)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(220,165,58,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#fdf5f6] via-[#d2d7dd] to-[#dca53a] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">{BRAND_NAME}</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#fdf5f6]" : "text-[#fdf5f6]/70 hover:text-[#dca53a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#d2d7dd] via-[#dca53a] to-[#a30d1a] shadow-[0_-2px_10px_rgba(220,165,58,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#dca53a]/55 bg-[#4d0c18]/75 px-7 py-2.5 text-sm font-bold text-[#fdf5f6] backdrop-blur-md transition-all duration-300 hover:bg-[#4d0c18]/90 hover:text-[#dca53a] hover:shadow-[0_0_15px_rgba(220,165,58,0.45)] xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#c21325] via-[#a30d1a] to-[#8a1420] px-7 py-2.5 text-sm font-black text-[#ffffff] shadow-[0_4px_15px_rgba(163,13,26,0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(163,13,26,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#dca53a]/40 bg-[#4d0c18]/75 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#dca53a] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#dca53a] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#dca53a] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#dca53a]/45 bg-[#330710]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#a30d1a]/30 text-[#fdf5f6] shadow-inner" : "text-[#fdf5f6]/70 hover:bg-[#a30d1a]/15 hover:text-[#dca53a]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#c21325] via-[#a30d1a] to-[#8a1420] py-3.5 text-lg font-black text-[#ffffff] shadow-[0_5px_15px_rgba(163,13,26,0.4)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#dca53a]/55 bg-[#4d0c18]/75 py-3.5 text-lg font-bold text-[#fdf5f6]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
