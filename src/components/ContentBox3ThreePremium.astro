---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names, which is the sanctioned sub-point shape and
   *  makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// สมหวัง168's brief (content.txt lines 16-18) writes its three steps as RUNNING
// PROSE — "ขั้นตอนที่ 1 เข้าหน้าสมัครสมาชิก เลือกเมนูสมัครจากช่องทางหลักของ…" is one
// sentence, not a labelled heading followed by a body — so index.astro leaves
// this false and the three "ขั้นตอนที่ N …" openers stay <p>. Only the section's
// own as="h2" title is a heading here, which is what keeps the page's inventory
// at the brief's h1x1 / h2x5 / h3x2.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffe5a8] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fa0513] shadow-[0_0_8px_rgba(250,5,19,0.9)]";

// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2):
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ ทองไทยรอง** — แดงแบรนด์ #fa0513 (เลข 168 กับ
// เปลวไฟบนโลโก้) คู่กับทองไทย #e3b23c / #ffe5a8 (ลายกนกและนาคทองในงานอาร์ต)
// พื้นเพจ **ดำอมแดง #290f0f** (bg.json) ลำดับความลึก: #2c1413 ยก (ใบนี้) / #1f0d0c
// กลาง / #140706 จม / #290f0f พื้น
//
// ใบนี้ถือ docx H2 §6 ("สมัครเล่นสล็อต <แบรนด์> ง่ายๆ 3 ขั้นตอน") และนั่งอยู่ระหว่าง
// ContentBoxNeumorphism (§5 แผ่นนูนมุม 25px ผิวกลาง หัวข้อแดงทึบกึ่งกลาง) กับ
// ContentBoxTwoFloatingBadge (§7 มุม 2xl ไล่ผิวกลางขึ้นผิวยก ป้ายลอยทองทึบ) จึงเป็น
// ใบ **"มุมกลม rounded-3xl ผิวยก #2c1413 ทึบ สามคอลัมน์"** ที่ยกตัวขึ้นเหนือทั้งสอง
// ใบที่ขนาบอยู่ และต่างจาก ContentBox (§4) ที่เป็นมุมกลมผิวยกเหมือนกันแต่เป็น
// คอลัมน์เดียว มีเส้นไรผมทองพาดบนสุด และไม่มีแถบตั้งนำหน้าหัวข้อ
// หัวข้อไล่ ทองไทย #e3b23c → ทองสว่าง #ffe5a8 → แดงสว่าง #ff5a5f ("ทองไล่ลงแดง")
// เป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ ส่วนแถบตั้งนำหน้าไล่ ทองสว่าง
// #ffe5a8 → ทองไทย #e3b23c → แดงลึก #b90203 จึงไม่ซ้ำกับหัวข้อของตัวเอง
// ป้ายสามคอลัมน์เป็นทองสว่าง #ffe5a8 (14.1:1 บนผิวยก) พร้อมจุดนำแดงแบรนด์ #fa0513
// กรอบการ์ดเป็นทองลึก #8a6210 ที่อิ่มเป็นทองไทยตอน hover ออราใบเดียวบนหัวการ์ดเป็น
// แดงแบรนด์โปร่ง เส้นคั่นคอลัมน์เป็นทองลึก #8a6210
// เนื้อความ #f4ecea (= BRAND_TEXT) — 14.9:1 บนผิวยก #2c1413
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้อยู่ที่ขอบ เส้นคั่น จุดนำ ออรา และไล่เฉดของแถบเท่านั้น
// #ffadaf สงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทองมาแล้วเกือบ
// ทุกรอบ และสองแบรนด์ก่อนหน้าก็เป็นแดงทั้งคู่** ทองรอบนี้ #e3b23c (G=178) ไม่ใช่
// #dfa310 ของ TND168 (G=163) ไม่ใช่ #e5a81b ของ UFA324 (G=168) และไม่ใช่ #e2b33f
// ของ KMD88 (ต่างกันหลักเดียว) ส่วนแดงรอบนี้ #fa0513 (G=5) ไม่ใช่ #fb141b ของ
// GT66B (G=20) และไม่ใช่ #fb131b ของ TKB55 (G=19)
// ชุดทองมังกรของ TND168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#dfa310 #ffe4a3 #c9b88e
// #f0e9dc #8a5c09 #43240b #1b1307) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733
// #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #2d1c0a #1c1206 #0f0903) ชุดชมพูฮอตพิงก์
// ของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426)
// ชุดทองแชมเปี้ยนของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #f0e8d4 #ffe08a
// #7d5a07 #43300a #464f5a) ชุดชมพู-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #f5c53d)
// ชุดทอง-ดำของ WIN999 (#fcc403 #fdda04 #fffbea #4a3402 #e9e4d6) และชุดชมพูนีออน-
// ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #8b3df3 #c9a4ff #1d0c33 #f2dcee) ออกครบแล้ว
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีฟ้า
// และไม่มีส้ม** #b9c2cc #464f5a #cfd6e3 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a6210] bg-[#2c1413]/95 p-8 text-[#f4ecea] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b23c]/80 hover:shadow-[0_15px_40px_rgba(250,5,19,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#fa0513]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#fa0513]/34">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a6210]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe5a8] via-[#e3b23c] to-[#b90203] shadow-[0_0_10px_rgba(227,178,60,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#e3b23c] via-[#ffe5a8] to-[#ff5a5f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f4ecea]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#8a6210] pb-8 text-left text-base leading-relaxed text-[#f4ecea] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#8a6210] pb-8 text-left text-base leading-relaxed text-[#f4ecea] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4ecea] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
