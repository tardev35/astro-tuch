---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave
   *  it true when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §6** ("ระบบฝากถอน <แบรนด์> ได้ทุกธนาคารและทรูมันนี่" —
// content.txt บรรทัด 13) ซึ่งบรีฟเขียนเป็นย่อหน้าเดียวยาว (บรรทัด 14) หน้าแรกจึงหั่น
// ตามประโยคลงสามคอลัมน์และ **ไม่ส่งป้ายคอลัมน์มาเลย** `heading` จึงคาที่ false และ
// brand-spec §4 ตรึง inventory ของหน้าไว้ที่ **h1×1 / h2×5 / h3×2** — ถ้าพลิก
// heading เป็น true จะได้ h3 เพิ่มสามตัวที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#0f5684] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#12b4ef] shadow-[0_0_8px_rgba(18,180,239,0.7)]";

// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-อะซัวร์บนน้ำเงินเที่ยงคืนของ
// มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์ — **รอบนี้เป็นธีมสว่าง** พื้นเพจคือ #00bfff
// (bg.json) = ฟ้าสกายอิ่มตัว ไม่ใช่น้ำเงินเกือบดำ **ห้ามแก้กลับไปเป็นพื้นมืด**
// ลำดับผิว: #ffffff การ์ด (ใบนี้) · #f0faff ยก · #e4f6fb wash · #00bfff พื้นเพจ
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้: โลโก้เป็น **หัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว
// ทำหน้าตกใจ สองมือแตะแก้ม** ข้างคำว่า **"โบ๊ะบ๊ะ168" ตัวบับเบิลสามมิติไล่เฉด
// ฟ้าสกายเข้มลงหาฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา** · แบนเนอร์/สไลด์เป็น **สตูดิโอ
// พื้นขาวนวล ประดับเมฆการ์ตูน หัวใจฟ้า ประกาย และตู้สล็อต 777**
// ⚠️ **เสื้อคลุมถักฟ้าอ่อน เสื้อกล้ามขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงเป็น
// วัตถุในภาพ ไม่ใช่สีแบรนด์** — ห้ามดึงทอง เหลือง ครีม พีช หรือแรมป์เทาเงินเข้ามา
//
// จังหวะรูปทรงของใบนี้: มุมกลม rounded-3xl บนผิวการ์ดขาว กรอบ #7fcbe8
// **สามคอลัมน์คั่นด้วยเส้นไรผม ไม่ใช่การ์ดย่อย** — เส้นคั่นเป็น #7fcbe8 ซึ่ง §2
// อนุญาตให้เป็นขอบ/พื้นเท่านั้น (**ห้ามถือตัวอักษร**) และเป็นที่ที่สีเส้นของรอบนี้
// ได้งานจริงโดยไม่แตะเนื้อความ
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "เหนือ" หัวข้อ**
// — text-center อยู่บน <header> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>** เพื่อไม่
// ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// หัวข้อเป็น **ฟ้าลึก #0f5684 ทึบสีเดียว** (7.8:1 บนการ์ดขาว) พร้อมเรืองแสง
// rgba(18,180,239,α) ต่างจาก §3 ContentBoxCyberCut ที่ทึบเหมือนกันแต่ชิดซ้ายบนสัน
// หนาสี่พิกเซลและไม่มีเรืองแสง และต่างจาก §1 ที่หัวข้อนั่งบนแผ่นถมน้ำเงินหมึกขาว
// จุดนำหน้าป้ายคอลัมน์เป็น **ฟ้าสกาย #12b4ef** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// ⚠️⚠️ §2 ห้าม **#12b4ef / #00bfff / #b6e3f0 / #7fcbe8 / #4fb8ea** ถือตัวอักษรบน
// ผิวสว่างทุกกรณี — ในไฟล์นี้มันอยู่ที่จุด เส้นคั่น ขอบ และออราล้วน
// เนื้อความ #06283f (= BRAND_TEXT) — 15.2:1 บนการ์ดขาว
// ไฮไลต์ <strong> ในเนื้อความเป็นงานของหน้าเพจ และมีสีเดียวคือ **#0f5684**
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักสองชั้นของไฟล์นี้คือทองกับฟ้า**
// ทองผ่านมาแล้วเกือบทุกแบรนด์ในรีโปนี้ และ **รอบนี้ไม่มีทองเลยสักค่า**:
// fee45d e6a416 b8780d 7a4e05 (ยูฟ้า168) · fdfc71 d4922c (ufalion168) · ffe08a
// e5a81b (UFA324) · fef54b (นินจา168) · f0bb4e (รวยเทพ168) · f0c878 (ดวงเศรษฐี168) ·
// fcd434 (มีโชค168) · f7c92b (ขวัญใจ168) · f0b429 (รับตัง168) · e3b23c (สมหวัง168) ·
// cd9a2c fdeb7c (หวยคิง) · ffc93c (หวย365) · dcb95f c99a3f (รวยแท้168) · f0b46a
// (โปรดี168) · f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12 fded41 9f600d (พักยก168) ·
// fbc134 ffe87a cf9a18 (NAZA168 ตัวละติน) · ffd94a e3a712 (รวย168)
// 🚨🚨 **ฟ้าคือตระกูลของรอบนี้ จึงต้องเทียบทีละค่าแน่นที่สุด** ฟ้ารอบนี้คือ
// **#12b4ef / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 / #1a6ea8 / #06283f**
// เท่านั้น ไม่ใช่ 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f f4eef1
// d9dfe9 b3bdd6 (**มาดาม168 — ชุดที่เพิ่งอยู่ทั้งใบนี้** ⚠️ 0a4ea8 ใกล้ #0b4a73
// ที่ G) ไม่ใช่ 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434
// 121722 33455f 0d1017 (นาซ่า168) ไม่ใช่ 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff
// eef4ff dce9fb (ร่ำรวย168 — ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13**)
// ไม่ใช่ 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff (สบาย168 — ⚠️
// **063a57 R=06 ตรงกับ #06283f เป๊ะ**) ไม่ใช่ 039cfa 0494f5 c3ebfc 04366b
// (รวยแทร่168) ไม่ใช่ 32bcfb a9e9ff 07335f 0c2a3d 071a28 (นินจา168 — ⚠️ **07335f
// ใกล้ #06283f ที่ R**) ไม่ใช่ 2f9ff5 a8dcff d6ecff 0b3f78 (สบายเบท168) และไม่ใช่
// 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f (TSDET911)
// ⚠️⚠️ **ชมพู/แดงที่เคยนำมาก่อนก็ห้ามทั้งหมด** — fa539c c2185b 8e0f41 fb8cc0 fdc6c3
// ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463
// (**หมูบิน168 — แบรนด์ขาออก**) · fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7
// e3d6d4 7d6f6e 140000 0b0000 1c0607 2a0c0d 551c1e (สล็อต168) · ff2e52 e01238
// c9102f (มาดาม168) · c30303 8f0505 e81313 (รวยแท้168) · eb0305 e40303 c20305
// (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16 (ดวงเศรษฐี168) ·
// fb141b ff5f63 ffa0a2 (GT66B) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) ·
// d30304 a00203 (รับตัง168) · dc0203 f5282a (หวย365) · b3121b f2bba5 (ขวัญใจ168) ·
// dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) · fa63b9 ffb3de (ถอนชัวร์168) · f5469f
// ff8dc6 8c0f52 (มีโชค168) · ff3b14 6d0804 (FLASH877)
// ⚠️ แรมป์เทาเงินที่เคยอยู่ในไฟล์นี้และต้องไม่กลับมา: 5a6472 8792a0 b9c2cc 464f5a
// e8ecf1 a8b2bf 78828f cfd9e6 e0e0df c0c0bf a1a09e d9dfe9 b3bdd6
// ⚠️ ครีม/น้ำตาลที่เคยอยู่ในไฟล์นี้: eae3d4 15130f 1e1a13 (ยูฟ้า168) f4e4d3 e4cbb3
// (ร่ำรวย168) ecd5c4 d2b9a4 (เงินทอง168) — **รอบนี้ไม่มีครีมเลย**
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมฟ้า (B>G>R)** ซึ่งต่างจากครีม/งาช้าง (R>G>B)
// และจากขาวอมชมพู (R≥B>G) ของรอบก่อนทุกค่า — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีเขียว ไม่มีม่วง ไม่มีชมพู/ฟูเชีย
// ไม่มีแดง ไม่มีโรสโกลด์ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7fcbe8] bg-white p-8 text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.13)] transition-all duration-500 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#12b4ef]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#12b4ef]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-48 w-48 rounded-full bg-[#b6e3f0]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#b6e3f0]/70">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#12b4ef] to-transparent shadow-[0_0_10px_rgba(18,180,239,0.5)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#0f5684] uppercase drop-shadow-[0_0_12px_rgba(18,180,239,0.3)]`}>{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#06283f]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#7fcbe8] pb-8 text-left text-base leading-relaxed text-[#06283f] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#7fcbe8] pb-8 text-left text-base leading-relaxed text-[#06283f] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#06283f] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
