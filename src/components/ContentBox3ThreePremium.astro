---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names, which is the sanctioned sub-point shape and
   *  makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §7** ("ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด 24ชม." —
// content.txt บรรทัด 22) ซึ่งบรีฟเขียนเป็นย่อหน้าเดียวยาว หน้าแรกจึงหั่นตามประโยค
// ลงสามคอลัมน์และ **ไม่ส่งป้ายคอลัมน์มาเลย** `heading` จึงคาที่ false และ
// brand-spec §4 ตรึง inventory ของหน้าไว้ที่ h1×1 / h2×5 / h3×5 — h3 ทั้งห้าตัวมา
// จาก §4, §5 และสามการ์ดของ FeatureHighlights เท่านั้น ถ้าพลิก heading เป็น true
// จะได้ h3 เพิ่มสามตัวที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f0c878] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#d9212a] shadow-[0_0_8px_rgba(217,33,42,0.9)]";

// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
// 2026-10-20) — พาเลตต์ตาม brand-spec §2
// งานศิลป์: หัวไฉ่ซิงเอี๊ยยิ้มหัวเราะสวมหมวกทรงจีนแดงขลิบทอง คำว่า "ดวงเศรษฐี"
// ตัวอักษรไทยสามมิติผิวทองมันวาว เลข "168" สามมิติสีแดงสดขลิบทอง แบนเนอร์เป็น
// ห้องโถงหรูโทนขาว-งาช้าง มงกุฎทอง กองเหรียญทอง ชิปคาสิโนดำ-ทอง ไพ่เอซโพดำขลิบทอง
// — **ทองนำทั้งฉาก แดงเป็นหมวกกับเลข 168**
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #4e2120 ยก (ใบนี้) /
// #300605 กลาง / #150303 จม / #000000 พื้น
//
// จังหวะรูปทรง: ใบนี้นั่งระหว่าง ContentBoxTwoCyberCut (§6 มุมตัด 30px ผิวจม หัวข้อ
// ไล่เฉดกึ่งกลาง) กับ Faq4 (§8 แถวมุมกลมบนผิวจม) จึงเป็นใบ **"มุมกลม rounded-3xl
// ผิวยก #4e2120 ทึบ กรอบแดงเลือดหมู สามคอลัมน์"** ที่ยกตัวขึ้นเหนือทั้งสองใบที่ขนาบอยู่
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "เหนือ" หัวข้อ**
// (§2 เป็นเส้นใต้ · §6 เป็นกึ่งกลางแต่ไม่มีเส้น) — text-center อยู่บน <header>
// เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> เพื่อไม่ให้ไหลลงไปจัดกึ่งกลางย่อหน้าด้วย
// หัวข้อเป็น **ทองน้ำผึ้ง #f0c878 ทึบสีเดียว** พร้อมเรืองแสง rgba(240,200,120,α)
// (8.5:1 บนผิวยก จึงผ่าน AA ทุกขนาด) ต่างจาก §2 ที่ทึบเหมือนกันแต่ไม่มีเรืองแสง
// และมีเส้นใต้แทน
// ป้ายสามคอลัมน์เป็นทองน้ำผึ้งพร้อมจุดนำ **แดงชาด #d9212a** — §2 ย้ำว่าฮิวรองต้อง
// เห็นจริงบนหน้า ไม่ใช่แค่อยู่ในสเปก และจุดนำเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// กรอบการ์ดเป็นแดงเลือดหมู #8e1a16 ที่อิ่มเป็นทองตอน hover ออราใบเดียวบนหัวการ์ด
// เป็นแดงชาด #d9212a โปร่ง เส้นคั่นคอลัมน์เป็นแดงเลือดหมู #8e1a16
// เนื้อความ #fff8d8 (= BRAND_TEXT) — 12.6:1 บนผิวยก
// §2 ห้าม #d9212a (2.7:1) และ #8e1a16 ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่กรอบ
// เส้นคั่น จุดนำ และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทองและแดง** เพราะรอบที่
// แล้ว (ufalion168) ก็ทองบนดำเหมือนกัน ต่างกันที่ค่าและที่รอบก่อน **ไม่มีแดงเลย**
// ทองรอบนี้ **#f0c878** (R240 G200 B120) ไม่ใช่ d4922c fdfc71 f6e3b4 d39c45
// (ufalion168) f0bb4e ffeccb (รวยเทพ168) fcd45c (มีเฮ168) f9a826 (รวยแทร่168)
// fef54b (นินจา168) ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) f0b429 ffdc8c (รับตัง168 — ตัวที่ใกล้ที่สุดในรีโป ระยะ 32)
// e3b23c (สมหวัง168) dfa310 (TND168) e5a81b (UFA324) e2b33f (KMD88) f2c230
// (KINGKONG555) fad354 (789BETTING) fcc403 (WIN999) f5c53d (FAH999) หรือ f7b733
// (TIGERWIN369)
// แดงรอบนี้ **#d9212a / #8e1a16** ไม่ใช่ e4021b (รวยเทพ168) fb1b32 ff8f9c 5c0410
// (มีเฮ168) fa0513 ffadaf ff5a5f b90203 8c0204 (สมหวัง168) d30304 ff6b6e a00203
// 4a0202 (รับตัง168) b3121b 5a0a0e (ขวัญใจ168) หรือ fb131b (TKB55)
// ชุดบรอนซ์-ทองอำพันของ ufalion168 ที่เพิ่งออก (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000 กับ rgba 212/146/44, rgba 253/252/113
// และ rgba 162/91/36) ชุดเต็มของถอนชัวร์168 ที่เพิ่งอยู่ในไฟล์นี้ (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดทองไทย-
// โรสโกลด์-แดงชาดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6 f5ece0) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c
// ffe5a8 8a6210 b90203 f4ecea) และชุดทองแชมเปี้ยน-เงินของ UFA324 (b9c2cc 464f5a
// f0e8d4 ffe08a 7d5a07) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้มสด เงิน/โครเมียม โรสโกลด์
// ชมพู/ฟูเชีย และบรอนซ์** — cfd9e6 b9c2cc 464f5a cfd6e3 a25b24 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8e1a16] bg-[#4e2120]/95 p-8 text-[#fff8d8] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0c878]/80 hover:shadow-[0_15px_40px_rgba(240,200,120,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#d9212a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#d9212a]/65">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#d9212a] to-transparent shadow-[0_0_10px_rgba(217,33,42,0.6)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#f0c878] uppercase drop-shadow-[0_0_12px_rgba(240,200,120,0.45)]`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fff8d8]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#8e1a16] pb-8 text-left text-base leading-relaxed text-[#fff8d8] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#8e1a16] pb-8 text-left text-base leading-relaxed text-[#fff8d8] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fff8d8] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
