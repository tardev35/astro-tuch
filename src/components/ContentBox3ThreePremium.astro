---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names, which is the sanctioned sub-point shape and
   *  makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// บรีฟของถอนชัวร์168 (content.txt บรรทัด 15–20) เขียน "ขั้นตอนที่ 1/2/3 …" เป็น
// **บรรทัดป้ายสั้น** ตามด้วยประโยคของตัวเอง แต่บรีฟไม่ได้มาร์กทั้งสามเป็นหัวข้อ และ
// brand-spec §5 ตรึง inventory ของหน้าไว้ที่ h1×1 / h2×5 / h3×2 — index.astro จึง
// ปล่อย `heading` ไว้ที่ false: ป้ายสามคอลัมน์เป็น <p> และมีแค่ as="h2" ของตัว
// section เองที่เป็นหัวข้อ ถ้าพลิกเป็น true จะได้ h3 เพิ่มสามตัวที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd84d] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fa63b9] shadow-[0_0_8px_rgba(250,99,185,0.9)]";

// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// งานศิลป์: แมวการ์ตูนขาว-ชมพูคู่มือถือจอชมพูที่ขึ้นเครื่องหมายถูกและคำว่า ถอนสำเร็จ
// ปึกแบงก์ชมพู กองเหรียญทอง ริบบิ้นซาตินชมพู หัวใจชมพู และประกายดาวทอง —
// **ชมพูนำทั้งฉาก ทองเป็นเหรียญกับเส้นขอบ**
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0f20 ยก (ใบนี้) /
// #1a0914 กลาง / #0d040a จม / #000000 พื้น
//
// ใบนี้ถือ **docx H2 §6** ("สมัครเข้าเล่นสล็อต <แบรนด์> ได้ทุกค่ายง่ายๆ 3 ขั้นตอน")
// จังหวะรูปทรง: นั่งระหว่าง ContentBoxSevenThreeCyberCut (§5 มุมตัด 30px ผิวกลาง
// หัวข้อชมพูทึบ) กับ ContentBoxTwoPremium (§7 สองคอลัมน์บนผิวกลาง หัวข้อมีสันตั้งนำ)
// จึงเป็นใบ **"มุมกลม rounded-3xl ผิวยก #2b0f20 ทึบ กรอบทองลึก สามคอลัมน์"** ที่ยก
// ตัวขึ้นเหนือทั้งสองใบที่ขนาบอยู่
// ⚠️ **ใบนี้เป็นใบเดียวในกลุ่มกล่องเนื้อหาที่หัวข้ออยู่กึ่งกลาง** โดยมีเส้นคาด
// **เหนือ** หัวข้อ (ไม่ใช่ใต้) — text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บน
// การ์ดหรือ <section> เพื่อไม่ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// หัวข้อไล่ ชมพูบับเบิลกัม #fa63b9 → ทองเนย #ffd84d → ชมพูอ่อน #ffb3de ("ชมพูออก
// ผ่านทองกลับเข้าชมพู") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (6.6 / 12.7 / 10.7 บนผิวยก) — ห้ามเอา #6d0b3f หรือ #6b4708 มาเป็นสต็อป
// ป้ายสามคอลัมน์เป็นทองเนย #ffd84d (12.7:1 บนผิวยก) พร้อมจุดนำ **ชมพูบับเบิลกัม**
// #fa63b9 — §2 ย้ำว่าฮิวนำต้องเห็นจริงบนหน้า ไม่ใช่แค่อยู่ในสเปก
// กรอบการ์ดเป็นทองลึก #6b4708 ที่อิ่มเป็นชมพูตอน hover ออราใบเดียวบนหัวการ์ดเป็น
// พลัมเข้ม #6d0b3f โปร่ง เส้นคั่นคอลัมน์เป็นทองลึก #6b4708
// เนื้อความ #fdeaf5 (= BRAND_TEXT) — 15.3:1 บนผิวยก
// §2 ห้าม #6d0b3f (1.5:1) และ #6b4708 (2.1:1) ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// กรอบ เส้นคั่น และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้นคือชมพูและทอง**
// เพราะรอบที่แล้ว (มีโชค168) ก็ทอง+ชมพูบนดำเหมือนกัน ต่างกันที่ใครนำและค่าอะไร
// ชมพูรอบนี้ **#fa63b9 / #ffb3de** ไม่ใช่ f5469f / ff8dc6 (มีโชค168) f41571 / ff5ca8
// (PUNPRO168) ff3fa4 / ff6cbb / ffd1ea (FAH999) หรือ fa42b5 / ffb3e2 (SEXYGAME666)
// ทองรอบนี้ **#ffd84d** (R=255 G=216 B=77) ไม่ใช่ fcd434 (มีโชค168) f7c92b
// (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 (TND168) e5a81b (UFA324)
// e2b33f (KMD88) f2c230 (KINGKONG555) fad354 (789BETTING) fcc403 (WIN999) f5c53d
// (FAH999) หรือ f7b733 (TIGERWIN369)
// ชุดเต็มของมีโชค168 ที่เพิ่งอยู่ในไฟล์นี้ (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508
// 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดทองไทย-โรสโกลด์-แดงชาดของขวัญใจ168 (f7c92b
// ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603)
// ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0)
// ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 f4ecea) และชุด
// ทองแชมเปี้ยน-เงินของ UFA324 (b9c2cc 464f5a f0e8d4 ffe08a 7d5a07) ออกครบแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด** — cfd9e6 b9c2cc 464f5a cfd6e3 ต้องไม่เหลืออยู่ในไฟล์นี้
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4708] bg-[#2b0f20]/95 p-8 text-[#fdeaf5] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fa63b9]/80 hover:shadow-[0_15px_40px_rgba(250,99,185,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#6d0b3f]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#6d0b3f]/75">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#fa63b9] to-transparent shadow-[0_0_10px_rgba(250,99,185,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fa63b9] via-[#ffd84d] to-[#ffb3de] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#fdeaf5]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#6b4708] pb-8 text-left text-base leading-relaxed text-[#fdeaf5] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#6b4708] pb-8 text-left text-base leading-relaxed text-[#fdeaf5] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fdeaf5] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
