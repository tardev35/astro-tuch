---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave
   *  it true when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §3** ("โปรโมชั่นสมาชิก <แบรนด์> อัปเดตใหม่ตลอดทั้งเดือน"
// — content.txt บรรทัด 7) ซึ่งบรีฟเขียนเป็นย่อหน้าเดียวยาว (บรรทัด 8) หน้าแรกจึงหั่น
// ตามประโยคลงสามคอลัมน์และ **ไม่ส่งป้ายคอลัมน์มาเลย** `heading` จึงคาที่ false และ
// brand-spec §4 ตรึง inventory ของหน้าไว้ที่ **h1×1 / h2×5 / h3×2** — ถ้าพลิก
// heading เป็น true จะได้ h3 เพิ่มสามตัวที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff2e52] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#1177e8] shadow-[0_0_8px_rgba(17,119,232,0.7)]";

// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-madum168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองคานารีบนน้ำตาลโอลีฟของ ยูฟ้า168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ — **รอบนี้ยังเป็นธีมมืด แต่พื้นเพจคือ #00091f (bg.json) =
// น้ำเงินเที่ยงคืนเกือบดำ ไม่ใช่ดำสนิท** และ **ไม่มีทองอยู่บนหน้านี้เลยสักเฉด**
// ลำดับผิว: #16234a ยก (ชิป) · **#0b1733 กลาง (การ์ดใบนี้)** · #050e26 จม ·
// #00091f พื้นเพจ
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้: โลโก้เป็น **ผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน
// ขยิบตา ลิปสติกแดง ทำท่ามินิฮาร์ท** ข้างคำว่า **"มาดาม" สามมิติสีฟ้าอมน้ำเงิน**
// ต่อด้วย **เลข "168" สีแดงสด** · แบนเนอร์/สไลด์เป็น **โถงห้างหรูโทนขาว-ดำ
// หน้าร้านแบรนด์เนมสองฝั่ง พื้นหินขัดสะท้อนเงา**
// ⚠️ **ผมขาวเงิน สูทขาวครีม สูทดำ โซฟาหนังดำ และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สีแบรนด์** — ห้ามดึงครีม พีช เบจ หรือแรมป์เทาเงินเข้ามาเป็นสี UI
//
// จังหวะรูปทรงของใบนี้: มุมกลม rounded-3xl บนผิวกลาง #0b1733 กรอบ #2a3c70
// **สามคอลัมน์คั่นด้วยเส้นไรผม ไม่ใช่การ์ดย่อย** — เส้นคั่นเป็น #2a3c70 ซึ่ง §2
// อนุญาตให้เป็นขอบ/พื้นเท่านั้น (**ห้ามถือตัวอักษร**) และเป็นที่ที่สีเส้นของรอบนี้
// ได้งานจริงโดยไม่แตะเนื้อความ
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "เหนือ" หัวข้อ**
// — text-center อยู่บน <header> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>** เพื่อไม่
// ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// หัวข้อเป็น **แดงคริมสัน #ff2e52 ทึบสีเดียว** พร้อมเรืองแสง rgba(255,46,82,α)
// (4.9:1 บนผิวกลาง และเป็น text-xl/2xl font-black = large text) ต่างจาก §6
// ContentBoxCyberCut ที่ทึบเหมือนกันแต่ชิดซ้ายบนสันหนาสี่พิกเซลและไม่มีเรืองแสง
// และต่างจาก §1 ที่หัวข้อนั่งบนแผ่นถมแดงพร้อมหมึกขาว
// จุดนำหน้าป้ายคอลัมน์เป็น **อะซัวร์ #1177e8** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// ⚠️⚠️ §2 ห้าม **#1177e8 / #0e68cc / #0a4ea8 / #c9102f / #2a3c70** ถือตัวอักษร
// ทุกกรณี — ในไฟล์นี้มันอยู่ที่จุด เส้นคั่น ขอบ และออราล้วน
// เนื้อความ #f4eef1 (= BRAND_TEXT) — 15.7:1 บนผิวกลาง
// ไฮไลต์ <strong> ในเนื้อความเป็นงานของหน้าเพจ และมีสีเดียวคือ **#ff2e52**
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) · rgba(217,223,233,α) ·
// rgba(0,9,31,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักสองชั้นของไฟล์นี้คือทองกับฟ้า**
// ทองผ่านมาแล้วเกือบทุกแบรนด์ในรีโปนี้ และ **รอบนี้ไม่มีทองเลยสักค่า**:
// fee45d e6a416 b8780d 7a4e05 (ยูฟ้า168 — ชุดที่เพิ่งอยู่ทั้งใบนี้) · fdfc71 d4922c
// (ufalion168) · ffe08a e5a81b (UFA324) · fef54b (นินจา168) · f0bb4e (รวยเทพ168) ·
// f0c878 (ดวงเศรษฐี168) · fcd434 (มีโชค168) · f7c92b (ขวัญใจ168) · f0b429 (รับตัง168) ·
// e3b23c (สมหวัง168) · cd9a2c fdeb7c (หวยคิง) · ffc93c (หวย365) · dcb95f c99a3f
// (รวยแท้168) · f0b46a (โปรดี168) · f5ba14 fcee52 b37c0b (เงินทอง168) · eeae12
// fded41 9f600d (พักยก168) · fbc134 ffe87a cf9a18 96690a (NAZA168 ตัวละติน)
// ⚠️ ฟ้า/ไซยานนำมาแล้วเจ็ดแบรนด์ อะซัวร์รอบนี้คือ **#1177e8 / #0e68cc / #0a4ea8**
// เท่านั้น ไม่ใช่ 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434
// 121722 33455f 0d1017 (**นาซ่า168 — แบรนด์ขาออก เสี่ยงที่สุด**) ไม่ใช่ 18a5e2
// 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f 202a66 31408a e9f1ff
// adc0e4 (ร่ำรวย168) ไม่ใช่ 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff
// (สบาย168) ไม่ใช่ 039cfa 0494f5 c3ebfc 04366b (รวยแทร่168) ไม่ใช่ 32bcfb a9e9ff
// 07335f 0c2a3d 071a28 030e16 (นินจา168) ไม่ใช่ 2f9ff5 a8dcff d6ecff 0b3f78
// (สบายเบท168) และไม่ใช่ 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f
// 102a5e 0a1c42 (TSDET911)
// ⚠️⚠️ **แดงเป็นฮิวนำรอบนี้** — #ff2e52 / #e01238 / #c9102f เท่านั้น ไม่ใช่ c30303
// 8f0505 e81313 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb (รวยแท้168) eb0305 e40303
// c20305 9b0a0c ff4446 401107 2c1004 1a0802 (โปรดี168) d9212a 8e1a16 2a0608 4e2120
// 300605 150303 (ดวงเศรษฐี168) fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B) fa0513
// ff5a5f ffadaf (สมหวัง168) fb1b32 ff8f9c 5c0410 (มีเฮ168) e4021b (รวยเทพ168)
// d30304 a00203 ff6b6e (รับตัง168) dc0203 f5282a (หวย365) b3121b f2bba5 c98a74
// (ขวัญใจ168) dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) fa63b9 ffb3de (ถอนชัวร์168)
// f5469f ff8dc6 8c0f52 (มีโชค168) หรือ ff3b14 6d0804 2b0000 (FLASH877)
// ⚠️ แรมป์เทาเงินที่เคยอยู่ในไฟล์นี้และต้องไม่กลับมา: 5a6472 8792a0 b9c2cc 464f5a
// e8ecf1 a8b2bf 78828f cfd9e6 e0e0df c0c0bf a1a09e — รอบนี้มี **#d9dfe9 ตัวเดียว**
// เป็นแพลทินัม ซึ่งเป็นค่าใหม่ ไม่อยู่ในลิสต์นั้น
// ⚠️ ครีม/น้ำตาลที่เคยอยู่ในไฟล์นี้: eae3d4 15130f 1e1a13 0a0908 000000 (ยูฟ้า168)
// f4e4d3 e4cbb3 (ร่ำรวย168) ecd5c4 d2b9a4 (เงินทอง168) — **รอบนี้ไม่มีครีมเลย
// ทั้งที่สูทขาวครีมอยู่ในภาพ เพราะมันเป็นวัตถุในภาพ**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีเขียว ไม่มีม่วง ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#2a3c70] bg-[#0b1733] p-8 text-[#f4eef1] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-500 hover:border-[#ff2e52] hover:shadow-[0_15px_40px_rgba(255,46,82,0.2)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#ff2e52]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2e52]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-48 w-48 rounded-full bg-[#1177e8]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#1177e8]/40">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#ff2e52] to-transparent shadow-[0_0_10px_rgba(255,46,82,0.5)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#ff2e52] uppercase drop-shadow-[0_0_12px_rgba(255,46,82,0.3)]`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f4eef1]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2a3c70] pb-8 text-left text-base leading-relaxed text-[#f4eef1] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2a3c70] pb-8 text-left text-base leading-relaxed text-[#f4eef1] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f4eef1] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
