---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave
   *  it true when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §6** ("สมัครเล่นบาคาร่าสล็อต <แบรนด์> ไม่มีขั้นต่ำ
// 3 ขั้นตอน" — content.txt บรรทัด 13) โดยย่อหน้าแนะนำ (บรรทัด 14) เข้า default slot
// และ **ขั้นตอนที่ 1/2/3 (บรรทัด 15-20)** เข้า titleleft/titlecenter/titleright
// พร้อมย่อหน้าของแต่ละขั้นในสล็อต left/center/right
// 🚨🚨 บรรทัด 15/17/19 ของบรีฟ **ไม่มี prefix H** หน้าแรกจึง **ไม่ส่ง `heading`**
// `heading` คาที่ false ป้ายสามใบจึงเป็น <p> — brand-spec §4 ตรึง inventory ของหน้า
// ไว้ที่ **h1×1 / h2×5 / h3×2** ถ้าพลิก heading เป็น true จะได้ h2 เพิ่มสามตัว
// ที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#a30d1a] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#c21325] shadow-[0_0_8px_rgba(163,13,26,0.7)]";

// ───────────────────────────────────────────────────────────────────────────
// 123BET (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-123bet.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกาย 0f5684 / 12b4ef ของ โบ๊ะบ๊ะ168**
// ทั้งใบ จึงรีเธมทั้งไฟล์ — **รอบนี้เป็นธีมสว่าง** พื้นเพจคือ #f7e4e9 (bg.json)
// = ชมพูบลัชจาง **ห้ามแก้กลับไปเป็นพื้นมืด และห้ามเหลือฟ้า/ไซแอนไว้เลยสักค่า**
// ลำดับผิว: #fdf5f6 การ์ด (ใบนี้) · #f7dfe4 ยก · #eec3cc เส้นบาง · #f7e4e9 พื้นเพจ
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้: โลโก้เป็น **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวเลข
// ผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา
// ใต้มงกุฎเงินประดับกำมะหยี่แดงและอัญมณีแดง บนโล่โครเมียมเงินที่มีเพชรแดง** ·
// แบนเนอร์/สไลด์เป็น **โถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง หญิงสาวสวมมงกุฎทอง
// ประดับอัญมณีแดง ชุดราตรีแดง-ขาวปักทอง กองชิปคาสิโนแดง-ขาว และไพ่เอซโพดำ**
// ⚠️ **ผนังหินอ่อนสีงาช้าง สีผิวของนางแบบ และลูกไม้ขาวเป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
// — ห้ามดึงครีม งาช้าง พีช หรือแรมป์เทาเงินเข้ามา พื้นเพจมาจาก bg.json เท่านั้น
//
// จังหวะรูปทรงของใบนี้: มุมกลม rounded-3xl บนผิวการ์ด #fdf5f6 กรอบ #eec3cc
// **สามคอลัมน์คั่นด้วยเส้นไรผม ไม่ใช่การ์ดย่อย** — เส้นคั่นเป็น #eec3cc ซึ่ง §2
// อนุญาตให้เป็นขอบ/พื้นเท่านั้น (**ห้ามถือตัวอักษร**) และเป็นที่ที่สีเส้นของรอบนี้
// ได้งานจริงโดยไม่แตะเนื้อความ
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "เหนือ" หัวข้อ**
// — text-center อยู่บน <header> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>** เพื่อไม่
// ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// หัวข้อเป็น **แดงชาด #a30d1a ทึบสีเดียว** (7.4:1 บนการ์ด) พร้อมเรืองแสง
// rgba(163,13,26,α) ต่างจาก §1 ContentBoxCyberCut ที่ทึบเหมือนกันแต่ชิดซ้ายบนสัน
// หนาสี่พิกเซลและไม่มีเรืองแสง และต่างจาก §2 ที่หัวข้อนั่งข้างแท่งตั้งบนพื้นเพจ
// จุดนำหน้าป้ายคอลัมน์เป็น **แดงสด #c21325** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// ⚠️⚠️ §2 ห้าม **#eec3cc (1.5:1) / #d98fa0 (2.3:1) / #ef4a5e** ถือตัวอักษรบน
// ผิวสว่างทุกกรณี — ในไฟล์นี้มันอยู่ที่จุด เส้นคั่น ขอบ และออราล้วน
// เนื้อความ #36080f (= BRAND_TEXT) — 16.3:1 บนการ์ด
// ไฮไลต์ <strong> ในเนื้อความเป็นงานของหน้าเพจ และมีสีเดียวคือ **#a30d1a**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,26,α) · rgba(220,165,58,α) ·
// rgba(217,143,160,α) · rgba(54,8,15,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักสองชั้นของไฟล์นี้คือฟ้ากับแดง**
// ฟ้าคือชุดที่เพิ่งอยู่ทั้งใบ และ **แดงคือฮิวนำของรอบนี้ ซึ่งแบรนด์เก่าใช้มาแล้ว
// สิบกว่าเจ้า** แดงรอบนี้คือ **#a30d1a / #8a1420 / #c21325 / #36080f / #330710 /
// #1c050b / #6b2b33** และทองคือ **#dca53a / #7a4a0c** เท่านั้น ไม่ใช่:
//   **โบ๊ะบ๊ะ168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea
//     06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8
//   **ZORO365 (แบรนด์ขาออกทันที)** — 002908 010d04 031b09 073c1a 0e5424 1e7033
//     35a043 3ddc4a 23823a dfe6e3 e8c86a eef7f0 9dc2a5
//   🚨🚨 **LOTTO189 (ตระกูลสีเดียวกับรอบนี้เป๊ะ — เสี่ยงที่สุด)** — fff0f0 ffe4e6
//     ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436
//     e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//     ⚠️⚠️ **c1071b / b00718 ↔ #a30d1a · 7e1221 / 8a0412 ↔ #8a1420 · 3d0d16 /
//     24060c ↔ #36080f · 6e3b44 ↔ #6b2b33 · e9b53c ↔ #dca53a · ffe4e6 / ffd4d7 ↔
//     #f7e4e9 / #f7dfe4 — เจอค่าซ้ายให้สงสัยว่าพิมพ์ผิดก่อนเสมอ**
//   **MEXICANOSLOT** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
//     2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3
//     fff3ea fef6fb f2543f ⚠️ **a81410 ↔ #a30d1a · c81e12 ↔ #c21325 · fef6fb ↔ #fdf5f6**
//   **TEVA69 / ZANE96 / ZNOVA168** — f0ffeb e6f7df d7f0cd b2dba3 3f7a2e 10280f
//     3c5b36 116018 0b4a12 1a7d24 8a6a0e 28c437 e3bb45 c6cfd2 · 7a1bd6 2b3fd9
//     c2178b f23bb4 bb6dff 5411c4 241046 f8e6f9 f6edfe ece0fb dcc6f4 · 2a1206 7a3a0c
//     fff3e0 e0b784 c98a24 c23400 d13800 fa4903 e8a000 ff8a2b d8dde6 6a4a30
//   **แดงของแบรนด์เก่ากว่านั้น** — fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238
//     c9102f c30303 8f0505 e81313 eb0305 e40303 c20305 fa0513 ff5a5f d9212a 8e1a16
//     fb141b ff5f63 d30304 a00203 dc0203 f5282a b3121b 5a0a0e ff3b14 fb1b32 5c0410
//     cf1111 e01f26 1a0709 2a0b0e 120406 1c0607
//   **ชมพู/แมเจนต้า** — ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b
//     9c0f55 fb439b fc74b5 d91a73 b01160 85094a fa539c c2185b 8e0f41 fb8cc0 fdc6c3
//     ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 7a4463
//     ⚠️⚠️ **fdc6c3 ↔ #fdf5f6 · f7bcd9 / ef8dbd ↔ #eec3cc / #d98fa0**
//   **ทอง/เหลืองของแบรนด์เก่า (ทองรอบนี้คือ #dca53a กับ #7a4a0c)** — fee45d e6a416
//     b8780d fdfc71 d4922c ffe08a e5a81b fef54b f0bb4e f0c878 fcd434 f7c92b f0b429
//     e3b23c cd9a2c fdeb7c ffc93c dcb95f c99a3f f0b46a f5ba14 fcee52 b37c0b eeae12
//     fded41 9f600d fbc134 ffe87a cf9a18 ffd94a e3a712 e0b03a b07d08
//   **แรมป์เทาเงิน/ครีมที่เคยอยู่ในไฟล์นี้** — 5a6472 8792a0 b9c2cc 464f5a e8ecf1
//     a8b2bf 78828f cfd9e6 e0e0df c0c0bf a1a09e d9dfe9 b3bdd6 eae3d4 15130f 1e1a13
//     f4e4d3 e4cbb3 ecd5c4 d2b9a4 cfd6e3 c3ccd6 c6cfd2 d8dde6 e8eaee
//     ⚠️ **เงินโครเมียมรอบนี้คือ #d2d7dd ค่าเดียว และใช้บนโครมเข้มเท่านั้น
//     จึงไม่อยู่ในไฟล์นี้เลยสักจุด**
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งต่างจากขาวอมฟ้า (B>G>R)
// ของรอบที่ไฟล์นี้ค้างมา และต่างจากครีม/งาช้าง (R>G>B) ทุกค่า — ตรวจทีละค่า
// อย่าตัดสินด้วยสายตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีเขียว ไม่มีม่วง ไม่มีชมพู/ฟูเชีย ไม่มีส้ม
// ไม่มีโรสโกลด์ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#eec3cc] bg-[#fdf5f6] p-8 text-[#36080f] shadow-[0_10px_30px_rgba(54,8,15,0.13)] transition-all duration-500 hover:border-[#d98fa0] hover:shadow-[0_15px_40px_rgba(163,13,26,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#a30d1a]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#a30d1a]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-48 w-48 rounded-full bg-[#dca53a]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#dca53a]/60">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#a30d1a] to-transparent shadow-[0_0_10px_rgba(163,13,26,0.5)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#a30d1a] uppercase drop-shadow-[0_0_12px_rgba(163,13,26,0.3)]`}>{title}</HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#36080f]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#eec3cc] pb-8 text-left text-base leading-relaxed text-[#36080f] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#eec3cc] pb-8 text-left text-base leading-relaxed text-[#36080f] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#36080f] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
