---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave
   *  it true when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §2** ("<แบรนด์> ทางเข้าแทงบอล เล่นสล็อต บาคาร่า
// จากค่ายเว็บตรง100%" — content.txt บรรทัด 6) ซึ่งบรีฟเขียนเป็นย่อหน้าเดียวยาว
// หน้าแรกจึงหั่นตามประโยคลงสามคอลัมน์และ **ไม่ส่งป้ายคอลัมน์มาเลย** `heading` จึงคา
// ที่ false และ brand-spec §4 ตรึง inventory ของหน้าไว้ที่ h1×1 / h2×5 / h3×5 —
// ถ้าพลิก heading เป็น true จะได้ h3 เพิ่มสามตัวที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#e6a416] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fee45d] shadow-[0_0_8px_rgba(254,228,93,0.6)]";

// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 (2026-10-22) — พาเลตตาม .claude/brand-spec-ufabet168.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-ทองโบราณบนผิวขาว ของ รวยแท้168**
// ทั้งใบ จึงกลับทิศทั้งไฟล์: **รอบนี้กลับมาเป็นธีมมืด** พื้นเพจ #000000 (bg.json)
// การ์ดเนื้อหาเป็น **ผิวมืด + หมึกครีม** ห้ามแก้กลับเป็นพื้นสว่าง
// ลำดับผิว: #15130f ยก (การ์ดใบนี้) · #1e1a13 อุ่น · #0a0908 จม · #000000 พื้นเพจ
// งานศิลป์: โลโก้เป็นลูกฟุตบอลลายทอง + หางวงโคจรทอง ข้างคำว่า "ยูฟ้า" ทองสามมิติ
// และเลข "168" ผิวโครเมียมเงิน · แบนเนอร์/สไลด์เป็นสนามฟุตบอลกลางคืน ไฟสปอตไลต์
// คู่ชาย-หญิงชุดบอลดำ-ทอง ลูกฟุตบอลทองคำ และเหรียญทอง
// ⚠️ ขาว-ดำของลูกฟุตบอล ฟ้าของจอหลัง และสีผิวนักแสดงเป็น **วัตถุในภาพ** ไม่ใช่สีแบรนด์
//
// จังหวะรูปทรงของใบนี้: มุมกลม rounded-3xl บนผิวยก #15130f กรอบทองกลางโปร่ง
// **สามคอลัมน์คั่นด้วยเส้นโครเมียม ไม่ใช่การ์ดย่อย** — เส้นคั่นเป็น #5a6472 ซึ่ง §2
// อนุญาตให้เป็นขอบ/พื้นเท่านั้น (ห้ามถือตัวอักษร) และเป็นที่ที่สีที่สองของรอบนี้
// ได้งานจริงโดยไม่แตะเนื้อความ
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "เหนือ" หัวข้อ**
// — text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> เพื่อไม่ให้
// ไหลลงไปจัดกึ่งกลางย่อหน้าด้วย
// หัวข้อเป็น **ทองคานารี #fee45d ทึบสีเดียว** พร้อมเรืองแสง rgba(254,228,93,α)
// (14.8:1 บนผิวยก) ต่างจาก §3 ContentBoxCyberCut ที่ทึบเหมือนกันแต่ชิดซ้ายบนสันหนา
// สี่พิกเซลและไม่มีเรืองแสง และต่างจาก §1 ที่หัวข้อนั่งบนแผ่นถมทองหมึกเข้ม
// เนื้อความ #eae3d4 (= BRAND_TEXT) — 14.6:1 บนผิวยก
// ⚠️ §2 ห้าม #7a4e05 (2.4:1) และ #5a6472 (3.3:1) ถือตัวอักษร — ในไฟล์นี้ #5a6472
// อยู่ที่เส้นคั่นคอลัมน์ล้วน · ไฮไลต์ <strong> ในเนื้อความเป็นงานของหน้าเพจและมี
// สีเดียวคือ #fee45d
// rgba() ที่อนุญาตรอบนี้: rgba(254,228,93,α) · rgba(230,164,22,α) ·
// rgba(168,178,191,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** เพราะทองผ่านมาแล้ว
// เกือบทุกแบรนด์ในรีโปนี้ ทองรอบนี้ **#fee45d (R254 G228 B93)** วัดจาก logo.webp เอง
// และไม่ใช่ fdfc71 d4922c (ufalion168 — แบรนด์บอลเหมือนกัน ⚠️ ห้ามเทียบด้วยแนวเรื่อง)
// ffe08a e5a81b (UFA324 — ชื่อใกล้ที่สุด ⚠️) fef54b (นินจา168) f0bb4e (รวยเทพ168)
// f0c878 (ดวงเศรษฐี168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168)
// e3b23c (สมหวัง168) cd9a2c fdeb7c (หวยคิง) ffc93c (หวย365) dcb95f c99a3f (รวยแท้168)
// หรือ f0b46a (โปรดี168)
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุด **แดงคริมสัน-ทองโบราณ** ของ รวยแท้168 (c30303
// 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f
// กับ rgba 195/3/3 α) rgba 74/15/15 α)) และแบรนด์ขาออกของรอบนี้ **โปรดี168** (eb0305
// e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4
// fff4ea ffd1d1 1a0802) ต้องไม่เหลือเลยสักค่า เช่นเดียวกับชุดของ ดวงเศรษฐี168 ที่เคย
// อยู่ทั้งใบนี้ (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) ufalion168
// (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000)
// UFA324 (e5a81b ffe08a bb8410 7d5a07 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4
// b9c2cc 464f5a) CEO66 (020617 7e22ce d946ef f5d0fe a855f7) นินจา168 (32bcfb a9e9ff
// 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) รวยเทพ168 (f0bb4e ffeccb
// e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) สาธุ168 (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) หวยคิง (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) มีโชค168 (fcd434 ffeaa0 f5469f
// ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) หวย365 (140203 dc0203
// f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) มีเฮ168 (fb1b32 ff8f9c
// 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec ffe3e6 1b0308) รวยแทร่168 (039cfa
// 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320 7fa8cc)
// สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5)
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509)
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f)
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303)
// และ มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้ และไม่มีส้ม** — 8792a0 b9c2cc 464f5a cfd9e6 ของ
// UFA324/รับตัง168 เป็น "เทา" คนละค่ากับโครเมียมรอบนี้ ห้ามเหลืออยู่
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e6a416]/40 bg-[#15130f] p-8 text-[#eae3d4] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-500 hover:border-[#fee45d]/75 hover:shadow-[0_15px_40px_rgba(254,228,93,0.2)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#fee45d]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fee45d]/30">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#fee45d] to-transparent shadow-[0_0_10px_rgba(254,228,93,0.45)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#fee45d] uppercase drop-shadow-[0_0_12px_rgba(254,228,93,0.28)]`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#eae3d4]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#5a6472]/45 pb-8 text-left text-base leading-relaxed text-[#eae3d4] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#5a6472]/45 pb-8 text-left text-base leading-relaxed text-[#eae3d4] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#eae3d4] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
