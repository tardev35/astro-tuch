---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes, so chrome never emits a heading tag. Leave
   *  it true when the labels ARE the docx's own sub-point names. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
//
// รอบนี้ใบนี้ถือ **docx H2 §6** ("สมัครเล่น <แบรนด์> บาคาร่า สล็อต คาสิโนครบ" —
// content.txt บรรทัด 13) โดยย่อหน้าแนะนำ (บรรทัด 14) เข้า default slot
// และ **ขั้นตอนที่ 1/2/3 (บรรทัด 15-20)** เข้า titleleft/titlecenter/titleright
// พร้อมย่อหน้าของแต่ละขั้นในสล็อต left/center/right
// 🚨🚨 บรรทัด 15/17/19 ของบรีฟ **ไม่มี prefix H** หน้าแรกจึง **ไม่ส่ง `heading`**
// `heading` คาที่ false ป้ายสามใบจึงเป็น <p> — brand-spec §4 ตรึง inventory ของหน้า
// ไว้ที่ **h1×1 / h2×5 / h3×2** ถ้าพลิก heading เป็น true จะได้ h2 เพิ่มสามตัว
// ที่บรีฟไม่มี
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#a30d63] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#d11a7e] shadow-[0_0_8px_rgba(209,26,126,0.7)]";

// ───────────────────────────────────────────────────────────────────────────
// ABM96 (ดรอป 2026-10-29) — พาเลตตาม .claude/brand-spec-abm96.md §2
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงชาด/ชมพูบลัชของ 123BET** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ — **รอบนี้ยังเป็นธีมสว่าง แต่คนละค่าทุกตัว** พื้นเพจคือ #f8b9f0
// (bg.json) = ชมพูพาสเทลอิ่มตัว **ห้ามแก้กลับไปเป็นพื้นมืด**
// 🚨🚨 **a30d1a (123BET, แดงชาด) ↔ #a30d63 (รอบนี้, ชมพูบานเย็น) ต่างกันสองหลัก
// ท้ายเท่านั้น** — ตาเปล่าแยกไม่ออก ต้องอ่านค่าให้ครบหกหลักทุกจุด
// ลำดับผิว: **#ffffff การ์ด (ใบนี้)** · #fff5fb การ์ดสำรอง · #fcd9ee ผิวยก ·
// #f3a7d3 เส้นบาง · #f8b9f0 พื้นเพจ
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้: โลโก้เป็น **เวิร์ดมาร์กละตินสามมิติตัวอ้วนมน
// ผิวไล่จากขาวนวลลงชมพูอ่อน ตัดขอบชมพูเข้มหนาสองชั้น โดยตัว A มีหัวใจชมพูเล็ก
// ซ้อนอยู่ในช่องกลางตัวอักษร** คู่กับ **มาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพู หูตก
// แก้มแดง ขยิบตา เกาะขอบจานวงกลมชมพูขอบขาว** · แบนเนอร์/สไลด์เป็น **ผ้าซาติน
// ชมพูนวลพลิ้ว หญิงสาวผูกโบว์ริบบิ้นซาตินชมพูในชุดลูกไม้ชมพูอ่อน ต่างหูรูปหัวใจ
// ไพ่เอซ ลูกเต๋าชมพูจุดขาว ชิปคาสิโนชมพู-ขาว วงล้อรูเล็ตขอบทอง และหัวใจชมพู
// สามมิติผิวมันเงาลอยกระจาย**
// ⚠️ **ผ้าซาติน ดอกไม้ สีผิวของนางแบบ และลูกไม้ขาวเป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
// — ห้ามดึงครีม งาช้าง พีช หรือแรมป์เทาเงินเข้ามา พื้นเพจมาจาก bg.json เท่านั้น
//
// จังหวะรูปทรงของใบนี้: มุมกลม rounded-3xl บนผิวการ์ด #ffffff กรอบ #f3a7d3
// **สามคอลัมน์คั่นด้วยเส้นไรผม ไม่ใช่การ์ดย่อย** — เส้นคั่นเป็น #f3a7d3 ซึ่ง §2
// อนุญาตให้เป็นขอบ/พื้นเท่านั้น (**ห้ามถือตัวอักษร**) และเป็นที่ที่สีเส้นของรอบนี้
// ได้งานจริงโดยไม่แตะเนื้อความ
// ⚠️ **ใบนี้เป็นใบเดียวของหน้าที่หัวข้ออยู่กึ่งกลางโดยมีเส้นคาดอยู่ "ใต้" หัวข้อ**
// — §2 ContentBoxTwoCyberCut ก็จัดกึ่งกลาง แต่แถบสั้นของมันอยู่ "เหนือ" หัวข้อและ
// การ์ดเป็นมุมตัดเฉียง **สลับทิศกันโดยตั้งใจ**
// — text-center อยู่บน <header> เท่านั้น **ไม่ได้อยู่บนการ์ดหรือ <section>** เพื่อไม่
// ให้ไหลลงไปจัดกึ่งกลางย่อหน้าในสล็อตด้วย
// หัวข้อเป็น **ชมพูบานเย็น #a30d63 ทึบสีเดียว** (7.5:1 บนการ์ดขาว) พร้อมเรืองแสง
// rgba(163,13,99,α) ต่างจาก §5 ที่ทึบเหมือนกันแต่ชิดซ้ายคู่แถบตั้งบนแผ่นนูน และ
// ต่างจาก §7 ที่หัวข้อเป็นไล่เฉด clip-text
// จุดนำหน้าป้ายคอลัมน์เป็น **ชมพูสด #d11a7e** ซึ่งเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// ⚠️⚠️ §2 ห้าม **#f3a7d3 / #fcd9ee / #e0509f (3.6:1) / #ff7ac2** ถือตัวอักษรบน
// ผิวสว่างทุกกรณี — ในไฟล์นี้มันอยู่ที่จุด เส้นคั่น ขอบ และออราล้วน
// ⚠️ **#f2c14e ถือตัวอักษรได้เฉพาะบนโครมเข้ม (1.7:1 บนการ์ดขาว)** จึงไม่อยู่ในไฟล์นี้
// เนื้อความ #3d0a2c (= BRAND_TEXT) — 16.4:1 บนการ์ด · หมึกรอง #7a4263 (7.5:1)
// ไฮไลต์ <strong> ในเนื้อความเป็นงานของหน้าเพจ และมีสีเดียวคือ **#a30d63**
// rgba() ที่อนุญาตรอบนี้: rgba(163,13,99,α) · rgba(224,80,159,α) ·
// rgba(255,122,194,α) · rgba(209,26,126,α) · rgba(61,10,44,α) · rgba(43,6,32,α)
// **เงาบนการ์ดสว่างต้องเบา**: ปกติ rgba(61,10,44,0.10) · hover rgba(163,13,99,0.18)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักสองชั้นของไฟล์นี้คือแดงกับชมพู**
// แดงคือชุดที่เพิ่งอยู่ทั้งใบ (123BET) และ **ชมพูคือฮิวนำของรอบนี้ ซึ่งแบรนด์เก่า
// ใช้มาแล้วหลายเจ้า** ชมพูรอบนี้คือ **#a30d63 / #d11a7e / #7a0449 / #e0509f /
// #ff7ac2 / #f3a7d3 / #fcd9ee / #fff5fb / #f8b9f0** หมึกคือ **#3d0a2c / #7a4263**
// และทองคือ **#6e4705 (ผิวสว่าง) / #f2c14e (โครมเท่านั้น)**
// ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (**123BET**): a30d1a c21325 8a1420
// 36080f 6b2b33 f7e4e9 fdf5f6 f7dfe4 eec3cc d98fa0 dca53a ef4a5e
// + rgba(163,13,26) rgba(220,165,58) rgba(217,143,160) rgba(54,8,15)
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์ที่ต้องกวาดออกอยู่ที่ .claude/brand-spec-abm96.md §2b
// — ไม่ซ้ำลงที่นี่โดยตั้งใจ** คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ:
//   a30d1a (123BET) / 9c0f55 b01160 (okkub88) / c2178b (ZANE96) ↔ #a30d63 ·
//   d91a73 (okkub88) ↔ #d11a7e · fb439b fc4da1 (okkub88) / fa63b9 (ถอนชัวร์168) ↔
//   #e0509f · f9b2d9 (okkub88) / ffb3de (ถอนชัวร์168) ↔ #f3a7d3 ·
//   ffd6fa ffe3f5 (okkub88) / f7dfe4 fdf5f6 f7e4e9 (123BET) / f8e6f9 (ZANE96) ↔
//   #fcd9ee #fff5fb · 6a0f3c (okkub88) / 6d0b3f (ถอนชัวร์168) ↔ #440d31 #3d0a2c
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพูอิ่มกว่ารอบก่อนมาก (R>B>G ชัดเจน)**
// ซึ่งต่างจากเขียวมินต์ e1fef3 f0fdf7 d2f3e4 ของ LOTTOPLUS แบรนด์ขาออกทันที —
// **เขียวทั้งตระกูลต้องไม่เหลือเลยสักค่า**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีเขียว ไม่มีม่วง ไม่มีส้ม ไม่มีแดงชาด
// ไม่มีโรสโกลด์ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f3a7d3] bg-[#ffffff] p-8 text-[#3d0a2c] shadow-[0_10px_30px_rgba(61,10,44,0.10)] transition-all duration-500 hover:border-[#e0509f] hover:shadow-[0_15px_40px_rgba(163,13,99,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#ff7ac2]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ff7ac2]/60">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-48 w-48 rounded-full bg-[#e0509f]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#e0509f]/50">
    </div>

    {
      title && (
        <header class="mb-8 flex flex-col items-center gap-4 text-center">
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-widest text-[#a30d63] uppercase drop-shadow-[0_0_12px_rgba(163,13,99,0.25)]`}>{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-[#d11a7e] to-transparent shadow-[0_0_10px_rgba(209,26,126,0.45)]" />
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#3d0a2c]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#f3a7d3] pb-8 text-left text-base leading-relaxed text-[#3d0a2c] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#f3a7d3] pb-8 text-left text-base leading-relaxed text-[#3d0a2c] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#3d0a2c] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
