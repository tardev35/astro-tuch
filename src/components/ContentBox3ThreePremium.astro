---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names (a numbered "3 ขั้นตอน" list, say), which is the
   *  sanctioned sub-point shape and makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `heading` defaults to FALSE: on this template a three-column split is almost
// always one docx paragraph broken into three readable columns, so the safe
// default is the one that keeps chrome out of the heading inventory. A page
// whose labels really are docx sub-points opts in with heading={true}.
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#c2c8d0] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fdd32a] shadow-[0_0_8px_rgba(253,211,42,0.9)]";

// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): การ์ดผิว #12100a ในเส้นพื้นยก
// #2a2110 ที่สว่างขึ้นเป็นทองแบรนด์ #fdd32a ตอน hover ออร่าใบเดียวบนหัวการ์ดเป็นทอง
// ส่วนหัวข้อกับแถบนำไล่ตามลำดับโลหะบนเวิร์ดมาร์ก PKG44 คือทองสว่าง #ffe27a → ขาว
// โครเมียม #f2f4f7 → ทองลึก #c8920a ป้ายสามคอลัมน์กลับด้านกัน คือตัวอักษรเป็นเงิน
// โครเมียม #c2c8d0 กับจุดนำสีทอง — เงินจึงเป็นแอคเซนต์ที่สองจริงๆ ตามตัว K ในโลโก้
// ไม่ใช่หน้าทองล้วน เนื้อความ #efe6d2 (BRAND_TEXT) — ชุดทอง-โครเมียมของ MIRACLE55
// (#fcda65 #fee47b #d9a62b #fcfcfc #d2d3d4 #8c5f14 #14100a #2c241c #e8e6e1)
// ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#2a2110] bg-[#12100a]/92 p-8 text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32a]/70 hover:shadow-[0_15px_40px_rgba(253,211,42,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#c8920a]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/26">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4a3a12]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] shadow-[0_0_10px_rgba(253,211,42,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#efe6d2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2a2110] pb-8 text-left text-base leading-relaxed text-[#efe6d2] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2a2110] pb-8 text-left text-base leading-relaxed text-[#efe6d2] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#efe6d2] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
