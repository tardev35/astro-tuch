---
export interface Props {
  /** The section's own docx heading — the ONLY heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// The three column labels are NOT docx headings — they are captions this page
// writes to break one docx paragraph into three readable columns — so they
// render as <p> carrying the same classes. Only `title` becomes a heading. With
// no `title` the box is pure chrome and takes its accessible name from
// aria-label instead.
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#e4c67f] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#d9b45e] shadow-[0_0_8px_rgba(217,180,94,0.9)]";
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a6b2c]/55 bg-[#02101f]/92 p-8 text-[#ccd6e6] shadow-[0_10px_30px_rgba(2,16,31,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9b45e]/70 hover:shadow-[0_15px_40px_rgba(217,180,94,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#d9b45e]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f2dc9a]/28">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a6b2c]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] shadow-[0_0_10px_rgba(217,180,94,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#8a6b2c]/45 pb-8 text-left text-base leading-relaxed text-[#ccd6e6] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#8a6b2c]/45 pb-8 text-left text-base leading-relaxed text-[#ccd6e6] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ccd6e6] md:pl-8">
        {
          titleright && (
            <p class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
