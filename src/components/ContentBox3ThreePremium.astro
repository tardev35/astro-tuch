---
export interface Props {
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-[#6b1fa8]/45 bg-[#0d0114]/92 p-8 text-[#e6cfe9] shadow-[0_10px_30px_rgba(194,36,155,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb44b3]/60 hover:shadow-[0_15px_40px_rgba(251,68,179,0.28)] md:p-10">
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#6b1fa8]/45 pb-8 text-left text-base leading-relaxed text-[#e6cfe9] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fb44b3] uppercase">
              <span aria-hidden="true" class="block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fb44b3] shadow-[0_0_8px_rgba(251,68,179,1)]" /> {titleleft}
            </h3>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#6b1fa8]/45 pb-8 text-left text-base leading-relaxed text-[#e6cfe9] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fb44b3] uppercase">
              <span aria-hidden="true" class="block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fb44b3] shadow-[0_0_8px_rgba(251,68,179,1)]" /> {titlecenter}
            </h3>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e6cfe9] md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fb44b3] uppercase">
              <span aria-hidden="true" class="block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fb44b3] shadow-[0_0_8px_rgba(251,68,179,1)]" /> {titleright}
            </h3>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
