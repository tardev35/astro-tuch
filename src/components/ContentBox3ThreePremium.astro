---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names (a numbered "3 ขั้นตอน" list, say), which is the
   *  sanctioned sub-point shape and makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffb3bf] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#cd1437] shadow-[0_0_8px_rgba(205,20,55,0.9)]";

// NEXT55 palette: page-ink card (#0c0d10) inside a neutral graphite hairline
// (#3a3d45) that lights to crimson on hover. The single aura bloom and the three
// column dots are the logo's arrow red; everything structural stays graphite and
// silver so the red reads as an accent rather than a wash.
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3a3d45] bg-[#0c0d10]/92 p-8 text-[#d5dae2] shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#cd1437]/70 hover:shadow-[0_15px_40px_rgba(205,20,55,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#cd1437]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f0435f]/28">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#cd1437]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] shadow-[0_0_10px_rgba(205,20,55,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#e7eaef] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#3a3d45] pb-8 text-left text-base leading-relaxed text-[#d5dae2] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#3a3d45] pb-8 text-left text-base leading-relaxed text-[#d5dae2] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d5dae2] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
