---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
  /** Set false when the three column labels are captions this page invented to
   *  break one docx paragraph into three readable columns — they then render as
   *  <p> carrying the same classes and the <section> is named by aria-label, so
   *  chrome never emits a heading tag. Leave it true when the labels ARE the
   *  docx's own sub-point names (a numbered "3 ขั้นตอน" list, say), which is the
   *  sanctioned sub-point shape and makes them real headings at `as`. */
  heading?: boolean;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = true } = Astro.props;

// Optional intro slot — the docx paragraph that sits under the section heading
// and above the three columns. Its wrapper carries a real `mb-8` and sits beside
// the grid, so it is a layout wrapper rather than a hoistable text wrapper; it
// renders only when the page actually passes default children.
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
const columnLabel = "flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fff6ae] uppercase";
const columnDot = "block h-1.5 w-1.5 shrink-0 rounded-full bg-[#fcdc2b] shadow-[0_0_8px_rgba(252,220,43,0.9)]";

// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): การ์ดพื้นเขียวเข้ม #0d2312 ในเส้น
// พื้นยก #143a1c ที่สว่างขึ้นเป็นทองหลัก #fcdc2b ตอน hover ออร่าใบเดียวบนหัวการ์ด
// และจุดนำสามคอลัมน์เป็นทองของวงแหวนโลโก้ ส่วนหัวข้อไล่ตามลำดับสีบนโลโก้จริง คือ
// เลข 888 เขียวสด #1fae1c → ทองสว่าง #fff6ae → คำว่า PARUAY แดง #cf1111 โครงสร้าง
// ที่เหลือคุมเป็นเขียวทั้งหมด ทองจึงอ่านเป็นแอคเซนต์ไม่ใช่พื้น — ชุดแดงเลือดนก
// ของ NEXT55 (#0c0d10 #3a3d45 #cd1437 #f0435f #ffb3bf #e7eaef #d5dae2) ออกทั้งหมด
---

<section aria-label={title ? undefined : sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#143a1c] bg-[#0d2312]/92 p-8 text-[#e8e4c6] shadow-[0_10px_30px_rgba(7,19,10,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcdc2b]/70 hover:shadow-[0_15px_40px_rgba(252,220,43,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-1/3 -z-10 h-48 w-48 rounded-full bg-[#fcdc2b]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fff6ae]/26">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a87d0c]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] shadow-[0_0_10px_rgba(252,220,43,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8e4c6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#143a1c] pb-8 text-left text-base leading-relaxed text-[#e8e4c6] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#143a1c] pb-8 text-left text-base leading-relaxed text-[#e8e4c6] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8e4c6] md:pl-8">
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={columnDot} /> {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
