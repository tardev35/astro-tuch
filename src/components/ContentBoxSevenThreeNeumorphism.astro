---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): แผ่นนูนวางบนผิวการ์ดเขียวเข้ม
// #0f1b0e ในกรอบเขียวนีออนแบรนด์ #8bfc13 กดเงาลงไปหาพื้นเพจ #030703 และยกแสงขึ้น
// ด้วยผิวแผงยก #1b2f19 ซึ่งไต่ขึ้นเป็นเขียวลึก #1a7a08 ตอน hover ความนูนแบบ
// neumorphic ต้องใช้คู่มืด/สว่างไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนเขียว
// เกือบดำโทนเดียว และปล่อยให้หัวข้อรับโครเมียมขาวทึบ #e8f0e6 ไว้เป็นตัวเน้นเพียง
// จุดเดียว — คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่เหนือขึ้นไปในหน้าเดียวกัน
// ซึ่งหัวข้อเป็นเขียวนีออนในการ์ดมุมตัด จึงคนละจังหวะสายตาทั้งรูปทรง ด้านที่วางรูป
// และสี เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่ค้างในไฟล์นี้
// (#dc020e #6b0207 #f3c623 #1f0a0c #2f1013 #050505 #f0e2e2) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#8bfc13]/50 bg-[#0f1b0e] p-8 shadow-[10px_10px_20px_#030703,-10px_-10px_20px_#1b2f19] transition-all duration-300 hover:shadow-[15px_15px_30px_#030703,-15px_-15px_30px_#1a7a08]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#e8f0e6]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6cd] md:border-l md:border-[#8bfc13]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#e8f0e6]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
