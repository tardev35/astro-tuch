---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// YADOM168 palette: soft-extruded card on the brand's card surface (#071508)
// inside a deep-green hairline border, shadowed into near-black (#020602) with a
// green-lit highlight (#0f3d0d). The heading takes the light accent (#8fe06f).
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#0f3d0d]/80 bg-[#071508] p-8 shadow-[10px_10px_20px_#020602,-10px_-10px_20px_#0f3d0d] transition-all duration-300 hover:shadow-[15px_15px_30px_#020602,-15px_-15px_30px_#1d6b18]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#8fe06f]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4e8cb] md:border-l md:border-[#0f3d0d]/80 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#8fe06f]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
