---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): แผ่นนูนวางบนผิวการ์ดอุ่น
// #1b1005 ในกรอบทองแบรนด์ #ebbb54 กดเงาลงไปหาพื้นดำอมน้ำตาลลึกสุด #050201 และ
// ยกแสงขึ้นด้วยผิวกรอบอุ่น #2e1d08 ซึ่งไต่ขึ้นเป็นทองแบรนด์ตอน hover ความนูนแบบ
// neumorphic ต้องใช้คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนอุ่นโทนเดียว
// และปล่อยให้หัวข้อรับเงินโครเมียมทึบ #d5d4d3 ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ
// ContentBoxSevenThreeCyberCut ที่อยู่ใต้ลงไปในหน้าเดียวกันซึ่งหัวข้อเป็นทองแบรนด์ใน
// การ์ดมุมตัด จึงคนละจังหวะสายตาทั้งรูปทรง ด้านที่วางรูป และสี เนื้อความ #f8eed9
// (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#1a1710 #edbb23 #050505 #2a2115
// #c8cbce #f0e6d2) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ebbb54]/50 bg-[#1b1005] p-8 shadow-[10px_10px_20px_#050201,-10px_-10px_20px_#2e1d08] transition-all duration-300 hover:shadow-[15px_15px_30px_#050201,-15px_-15px_30px_#ebbb54]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#d5d4d3]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f8eed9] md:border-l md:border-[#ebbb54]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#d5d4d3]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
