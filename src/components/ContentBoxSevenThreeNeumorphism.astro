---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// FAH999 palette (royal purple + gold): the soft-extruded slab sits on the
// brand's card surface (#2a0a4d) inside a gold hairline (#fbbf13), shadowed down
// into the page purple-black (#0d0119) and lifted with purple-deep (#4a1188),
// which steps up to purple-mid (#7c2fd4) on hover. A neumorphic relief needs a
// dark/light pair rather than two hues, so the relief is brightness inside the
// one purple and the heading takes the bright gold (#fef354). The previous
// brand's reds are gone.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#fbbf13]/50 bg-[#2a0a4d] p-8 shadow-[10px_10px_20px_#0d0119,-10px_-10px_20px_#4a1188] transition-all duration-300 hover:shadow-[15px_15px_30px_#0d0119,-15px_-15px_30px_#7c2fd4]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#fef354]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdcff] md:border-l md:border-[#fbbf13]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#fef354]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
