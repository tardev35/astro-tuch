---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// THE88 palette (แดง-ทอง 2026-09-23): แผ่นนูนวางบนพื้นการ์ด #2d0908 ในกรอบแดง
// แบรนด์ #a40201 กดเงาลงไปหาพื้นเพจแดงเกือบดำ #1c0504 และยกแสงขึ้นด้วยพื้นยก
// #4a0d0b ซึ่งไต่ขึ้นเป็นแดงเข้มสด #6b0302 ตอน hover ความนูนแบบ neumorphic ต้องใช้
// คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนแดงเดียว และปล่อยให้หัวข้อ
// รับทองของโลโก้ #f2c14e ไว้เป็นสีที่สองเพียงจุดเดียว ชมพู-เหลืองของ ABM96 กับ
// ชมพูมาเจนตา-ทองของ WY88 ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#a40201]/50 bg-[#2d0908] p-8 shadow-[10px_10px_20px_#1c0504,-10px_-10px_20px_#4a0d0b] transition-all duration-300 hover:shadow-[15px_15px_30px_#1c0504,-15px_-15px_30px_#6b0302]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#f2c14e]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3dd] md:border-l md:border-[#a40201]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#f2c14e]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
