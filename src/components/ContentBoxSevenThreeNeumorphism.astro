---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// KINGDOM66 palette (ทอง-ดำ 2026-09-25): แผ่นนูนวางบนผิวการ์ดดำอมน้ำตาล #151109
// ในกรอบทองแบรนด์ #e6bf4e กดเงาลงไปหาพื้นเพจดำสนิท #050403 และยกแสงขึ้นด้วยผิว
// การ์ดยก #241c13 ซึ่งไต่ขึ้นเป็นทองแบรนด์ตอน hover ความนูนแบบ neumorphic ต้องใช้
// คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนทอง-ดำโทนเดียว และปล่อยให้
// หัวข้อรับทองสว่าง #f2d683 ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ
// ContentBoxSevenThreeFloatingBadge ในหน้าเดียวกันที่หัวข้ออยู่ในป้ายลอยไล่เฉด
// ทอง-ครีม จึงคนละจังหวะสายตา เนื้อความ #ebe3d3 (BRAND_TEXT) — ชุดแดง-ดำ-เงิน
// โครเมียมของ MAHAGAME66 (#de161d #ff4d52 #7a0a0e #16090a #26100f #080506
// #e8e3e1) ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e6bf4e]/50 bg-[#151109] p-8 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#241c13] transition-all duration-300 hover:shadow-[15px_15px_30px_#050403,-15px_-15px_30px_#e6bf4e]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#f2d683]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3] md:border-l md:border-[#e6bf4e]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#f2d683]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
