---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): แผ่นนูนวางบนผิวแผงยกอุ่น #17120a ในกรอบ
// ทองแบรนด์ #edb543 กดเงาลงไปหาพื้นเพจดำสนิท #070707 และยกแสงขึ้นด้วยผิวทองหม่น
// #241a09 ซึ่งไต่ขึ้นเป็นทองแบรนด์ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่าง
// ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนอุ่นโทนเดียว และปล่อยให้หัวข้อรับเงินทึบ
// #e6e6e6 ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่
// เหนือขึ้นไปในหน้าเดียวกันซึ่งหัวข้อเป็นทองแบรนด์ในการ์ดมุมตัด จึงคนละจังหวะสายตาทั้ง
// รูปทรง ด้านที่วางรูป และสี เนื้อความ #f4ead3 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#2b0909 #f4bc5d #0b0202 #4a0f0f
// #dc2224 #ffefc2 #fbe3d4) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#edb543]/50 bg-[#17120a] p-8 shadow-[10px_10px_20px_#070707,-10px_-10px_20px_#241a09] transition-all duration-300 hover:shadow-[15px_15px_30px_#070707,-15px_-15px_30px_#edb543]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#e6e6e6]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4ead3] md:border-l md:border-[#edb543]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#e6e6e6]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
