---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แผ่นนูนวางบนผิวการ์ดแดงเข้ม #2b0909 ใน
// กรอบทองรอง #f4bc5d กดเงาลงไปหาเงาลึกสุด #0b0202 และยกแสงขึ้นด้วยผิวแผงยก #4a0f0f
// ซึ่งไต่ขึ้นเป็นแดงแบรนด์ #dc2224 ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่าง
// ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนแดงโทนเดียว และปล่อยให้หัวข้อรับทองอ่อนทึบ
// #ffefc2 ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่
// เหนือขึ้นไปในหน้าเดียวกันซึ่งหัวข้อเป็นทองรองในการ์ดมุมตัด จึงคนละจังหวะสายตาทั้ง
// รูปทรง ด้านที่วางรูป และสี เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวป่า-ทองของ หวยเต็ง ที่เคยค้างในไฟล์นี้ (#0b3d18 #e5c04f #010a04 #026314
// #0bb42f #eafbe9 #d8ead9) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f4bc5d]/50 bg-[#2b0909] p-8 shadow-[10px_10px_20px_#0b0202,-10px_-10px_20px_#4a0f0f] transition-all duration-300 hover:shadow-[15px_15px_30px_#0b0202,-15px_-15px_30px_#dc2224]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#ffefc2]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d4] md:border-l md:border-[#f4bc5d]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#ffefc2]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
