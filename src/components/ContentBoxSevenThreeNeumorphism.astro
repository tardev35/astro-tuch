---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// WIN8S palette: soft-extruded near-black card (#1c0a02) inside an orange
// hairline border, shadowed into #050201 with a warm orange-lit highlight.
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#8a3103]/80 bg-[#1c0a02] p-8 shadow-[10px_10px_20px_#050201,-10px_-10px_20px_#3a1405] transition-all duration-300 hover:shadow-[15px_15px_30px_#050201,-15px_-15px_30px_#6a2606]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#fd9a1e]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4d6] md:border-l md:border-[#8a3103]/80 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#fd9a1e]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
