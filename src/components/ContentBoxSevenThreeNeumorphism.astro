---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// SAGAME66 palette (ทอง-เงินโครเมียม 2026-09-23): แผ่นนูนวางบนพื้นการ์ด #171006
// ในกรอบทองหลัก #e8b93f กดเงาลงไปหาพื้นเพจน้ำตาลเกือบดำ #0d0903 และยกแสงขึ้นด้วย
// พื้นยก #2a1d0b ซึ่งไต่ขึ้นเป็นทองลึก #96671a ตอน hover ความนูนแบบ neumorphic
// ต้องใช้คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนน้ำตาลเดียว และปล่อย
// ให้หัวข้อรับทองหลักของโลโก้ไว้เป็นสีที่สองเพียงจุดเดียว เนื้อความ #e3d8c0
// (BRAND_TEXT) — แดง-ทองของ THE88 ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e8b93f]/50 bg-[#171006] p-8 shadow-[10px_10px_20px_#0d0903,-10px_-10px_20px_#2a1d0b] transition-all duration-300 hover:shadow-[15px_15px_30px_#0d0903,-15px_-15px_30px_#96671a]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#e8b93f]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0] md:border-l md:border-[#e8b93f]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#e8b93f]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
