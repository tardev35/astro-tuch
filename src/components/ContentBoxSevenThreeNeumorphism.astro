---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// BRAZIL999 palette (เขียว-โครเมียม-ดำ 2026-09-25): แผ่นนูนวางบนผิวการ์ดเขียวเข้ม
// #0a1a0c ในกรอบเขียวแบรนด์ #22c55e กดเงาลงไปหาพื้นเพจดำอมเขียว #040a05 และยกแสง
// ขึ้นด้วยผิวการ์ดยก #123a18 ซึ่งไต่ขึ้นเป็นเขียวแบรนด์ตอน hover ความนูนแบบ
// neumorphic ต้องใช้คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนเขียว-ดำ
// โทนเดียว และปล่อยให้หัวข้อรับเขียวสว่าง #7cf25c ไว้เป็นตัวเน้นเพียงจุดเดียว —
// คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่ถัดลงไปในหน้าเดียวกันซึ่งหัวข้ออยู่ใน
// รางมุมตัดสีโครเมียม จึงคนละจังหวะสายตา เนื้อความ #dfeadd (BRAND_TEXT) — ชุด
// ทอง-ดำของ KINGDOM66 (#e6bf4e #f2d683 #241c13 #151109 #050403 #ebe3d3) ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#22c55e]/50 bg-[#0a1a0c] p-8 shadow-[10px_10px_20px_#040a05,-10px_-10px_20px_#123a18] transition-all duration-300 hover:shadow-[15px_15px_30px_#040a05,-15px_-15px_30px_#22c55e]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#7cf25c]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeadd] md:border-l md:border-[#22c55e]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#7cf25c]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
