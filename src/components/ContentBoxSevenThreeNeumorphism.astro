---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// ABM96 palette (ชมพู-เหลือง): แผ่นนูนวางบนพื้นการ์ด #2a0a1a ในกรอบชมพูหลัก
// #fd6494 กดเงาลงไปหาพื้นเพจชมพูเกือบดำ #12030a และยกแสงขึ้นด้วยพื้นการ์ดสว่าง
// #3d0f26 ซึ่งไต่ขึ้นเป็นชมพูเข้มสด #d92e6e ตอน hover ความนูนแบบ neumorphic ต้องใช้
// คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนชมพูเดียว และปล่อยให้หัวข้อ
// รับเหลืองโลโก้ #feda2a ไว้เป็นสีที่สองเพียงจุดเดียว ม่วง-ทองของ FAH999 ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#fd6494]/50 bg-[#2a0a1a] p-8 shadow-[10px_10px_20px_#12030a,-10px_-10px_20px_#3d0f26] transition-all duration-300 hover:shadow-[15px_15px_30px_#12030a,-15px_-15px_30px_#d92e6e]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#feda2a]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3ee] md:border-l md:border-[#fd6494]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#feda2a]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
