---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#4a2409]/70 bg-[#140a05] p-8 shadow-[10px_10px_20px_#050201,-10px_-10px_20px_#241208] transition-all duration-300 hover:shadow-[15px_15px_30px_#050201,-15px_-15px_30px_#331a0b]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#ffc48a]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded4cb] md:border-l md:border-[#4a2409]/70 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#ffc48a]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
