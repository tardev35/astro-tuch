---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// MHEEPOOH168 palette: the soft-extruded slab sits on the brand's card red
// (#540202) inside a mid-gold hairline (#f5b70a), shadowed down into the page
// near-black (#120303) and lifted with the primary accent red (#8f0505), which
// steps up to bright red (#c4161c) on hover. A neumorphic relief needs a
// dark/light pair rather than two hues, so the relief is brightness inside the
// one red and the heading takes the bright gold (#fced74). The previous brands'
// brown-gold and navy are gone.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f5b70a]/50 bg-[#540202] p-8 shadow-[10px_10px_20px_#120303,-10px_-10px_20px_#8f0505] transition-all duration-300 hover:shadow-[15px_15px_30px_#120303,-15px_-15px_30px_#c4161c]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#fced74]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1dccd] md:border-l md:border-[#f5b70a]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#fced74]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
