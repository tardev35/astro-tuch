---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading. The
// heading sits in normal flow, never `absolute`, so there is no floating badge
// here and no vertical-clearance arithmetic to do: a title that wraps pushes
// the slot down instead of covering it.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-[1400px] + px-4, card p-8, grid gap-8, image column md:pl-8):
//   >= 1400px : (1400 - 32 - 64 - 32) x 0.3 - 32 = 349.6 -> 350px
//   md..1399  : (100vw - 128) x 0.3 - 32          = calc(30vw - 70px)
//   < md      : one column at p-8                 = calc(100vw - 96px)
// Change any of those four numbers and the page's `sizes` has to move with it.
//
// HI59 (รอบฟ้า-ทองบนการ์ดสว่าง 2026-10-07, brand-spec §2): รอบนี้ neumorphism กลับมา
// อยู่ในรูปแบบที่มันเกิดมาเพื่อสิ่งนี้จริงๆ คือแผ่นนูนบนผิวสว่าง ไม่ใช่บนผิวเกือบดำ —
// ผิวแผ่นเป็นฟ้าน้ำแข็ง #e7f2fd กดเงาลงด้วยฟ้าหม่น #bed4e9 และยกแสงขึ้นด้วยขาวบริสุทธิ์
// #ffffff ซึ่งเป็นคู่มืด/สว่างในโทนเดียวตามที่ความนูนแบบนี้ต้องการ ตอน hover เงาฝั่งสว่าง
// ไต่ขึ้นเป็นทองแบรนด์ #fdbc04 ซึ่งเป็นสีที่โลโก้ใช้กับตัวเลข 59
// หัวข้อรับทองหมึก #8a6102 ไว้เป็นตัวเน้นเพียงจุดเดียว (10.3:1 บนผิวแผ่น) คู่กับ
// SevenThreeCyberCut ที่อยู่เหนือขึ้นไปในหน้าเดียวกันซึ่งหัวข้อเป็นฟ้าลึกทึบในการ์ดมุมตัด
// สองบล็อกจึงคนละจังหวะสายตาทั้งรูปทรง ด้านที่วางรูป และสี กรอบการ์ดเป็นทองแบรนด์
// เส้นคั่นคอลัมน์เป็นฟ้าขอบการ์ด #9ecbf2 เนื้อความ #0d2744 (= BRAND_TEXT)
//
// ชุดแดงแบรนด์+ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#170707 #050101 #2a0606 #7a0505
// #f5c33b #ff3b3b #f7e2d6) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#fdbc04]/55 bg-[#e7f2fd] p-8 shadow-[10px_10px_20px_#bed4e9,-10px_-10px_20px_#ffffff] transition-all duration-300 hover:shadow-[15px_15px_30px_#bed4e9,-15px_-15px_30px_#fdbc04]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#8a6102]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0d2744] md:border-l md:border-[#9ecbf2] md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#8a6102]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
