---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): แผ่นนูนวางบนผิวการ์ดเขียวกลาง #0b3d18 ใน
// กรอบทองแบรนด์ #e5c04f กดเงาลงไปหาเงาลึกสุด #010a04 และยกแสงขึ้นด้วยเขียวแบรนด์
// #026314 ซึ่งไต่ขึ้นเป็นเขียวมรกตสว่าง #0bb42f ตอน hover ความนูนแบบ neumorphic
// ต้องใช้คู่มืด/สว่างไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนเขียวป่าโทนเดียว และ
// ปล่อยให้หัวข้อรับขาวอมเขียวทึบ #eafbe9 ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ
// ContentBoxSevenThreeCyberCut ที่อยู่เหนือขึ้นไปในหน้าเดียวกันซึ่งหัวข้อเป็นทอง
// ในการ์ดมุมตัด จึงคนละจังหวะสายตาทั้งรูปทรง ด้านที่วางรูป และสี เนื้อความ
// #d8ead9 (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างในไฟล์นี้
// (#8bfc13 #1a7a08 #e8f0e6 #0f1b0e #1b2f19 #030703 #d5e6cd) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e5c04f]/50 bg-[#0b3d18] p-8 shadow-[10px_10px_20px_#010a04,-10px_-10px_20px_#026314] transition-all duration-300 hover:shadow-[15px_15px_30px_#010a04,-15px_-15px_30px_#0bb42f]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#eafbe9]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8ead9] md:border-l md:border-[#e5c04f]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#eafbe9]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
