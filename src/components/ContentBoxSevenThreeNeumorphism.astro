---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreePremium, which runs image-then-text. The home page renders
// one of each, so the two image+text blocks alternate sides instead of stacking
// both pictures down the same edge. The wide column is therefore the LEFT one
// and `title` falls back to it, so a caller that passes a single docx heading
// gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading. The
// heading sits in normal flow, never `absolute`, so there is no floating badge
// here and no vertical-clearance arithmetic to do: a title that wraps pushes
// the slot down instead of covering it.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-[1400px] + px-4(16×2=32), card p-8(32×2=64), grid gap-8(32),
// image column md:pl-8(32)):
//   >= 1400px : (1400 - 32 - 64 - 32) x 0.3 - 32 = 1272 x 0.3 - 32 = 349.6 -> 350px
//   md..1399  : (100vw - 128) x 0.3 - 32          = calc(30vw - 70px)
//   < md      : one column at p-8                 = calc(100vw - 96px)
// Change any of those four numbers and the page's `sizes` has to move with it.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// กล่องนี้ถือ docx H3 #5 ("แนะนำเพื่อน โบนัส 0.8%") คู่กับ slide2 ซึ่งพิมพ์ข้อความนั้น
// ไว้บนป้ายแดงในตัวภาพเอง
//
// แผ่นนูนใบนี้เป็นใบที่ลึกที่สุดในสามแผ่นนูนของหน้า: ผิวแผ่นเป็นผิวลึกสุด #090302
// กดเงาลงด้วยดำสนิท และยกแสงขึ้นด้วยผิวการ์ดยก #1d0b08 ซึ่งเป็นคู่มืด/สว่างในโทนอุ่น
// เดียวกันตามที่ความนูนแบบนี้ต้องการ ตอน hover เงาฝั่งสว่างไต่ขึ้นเป็นเขียวมรกต #0b7a33
// (ContentBoxTwoNeumorphism ใช้ผิว #1d0b08 และ ContentBoxNeumorphism ใช้ผิว #140705
// จึงไม่ซ้ำกันทั้งสามใบ)
// หัวข้อรับทองอ่อน #ffdf91 ทึบสีเดียวเป็นตัวเน้นเพียงจุดเดียว (ทองอ่อนให้คอนทราสต์สูง
// บนผิวลึกสุด) คู่กับ SevenThreePremium ที่อยู่เหนือขึ้นไปในหน้าเดียวกันซึ่งหัวข้อเป็น
// ไล่สามสีในการ์ดไล่เฉดกรอบเขียวลึก สองบล็อกจึงคนละจังหวะสายตาทั้งรูปทรง ด้านที่วางรูป
// และสี กรอบการ์ดเป็นทองแบรนด์ #d9a521 แบบโปร่ง เส้นคั่นคอลัมน์เป็นเขียวลึก #063f1c
// เนื้อความ #f6e3cf (= BRAND_TEXT)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #036b26 #0b231b #041109
// #07170f #cfe9d7) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#d9a521]/35 bg-[#090302] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1d0b08] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#0b7a33]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#ffdf91]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf] md:border-l md:border-[#063f1c] md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#ffdf91]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
