---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#7e5f1f]/70 bg-[#031234] p-8 shadow-[10px_10px_20px_#00040f,-10px_-10px_20px_#062052] transition-all duration-300 hover:shadow-[15px_15px_30px_#00040f,-15px_-15px_30px_#0a2f7a]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe4f5]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#e9c55d]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe4f5] md:border-l md:border-[#7e5f1f]/70 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#e9c55d]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
