---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading. The
// heading sits in normal flow, never `absolute`, so there is no floating badge
// here and no vertical-clearance arithmetic to do: a title that wraps pushes
// the slot down instead of covering it.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-[1400px] + px-4, card p-8, grid gap-8, image column md:pl-8):
//   >= 1400px : (1400 - 32 - 64 - 32) x 0.3 - 32 = 349.6 -> 350px
//   md..1399  : (100vw - 128) x 0.3 - 32          = calc(30vw - 70px)
//   < md      : one column at p-8                 = calc(100vw - 96px)
// Change any of those four numbers and the page's `sizes` has to move with it.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04): แผ่นนูนวางบนผิวการ์ด #170707
// ซึ่งลึกกว่าผิวการ์ดยก #230d0d ของ ContentBoxTwoNeumorphism ที่อยู่เหนือขึ้นไปใน
// หน้าเดียวกัน กดเงาลงไปหาเงาลึกสุด #050101 และยกแสงขึ้นด้วยผิวกรอบ #2a0606 ซึ่ง
// ไต่ขึ้นเป็นทองแบรนด์ #f5c33b ตอน hover — คนละคู่กับอีกใบที่ไต่ขึ้นเป็นแดงแบรนด์
// ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่างในโทนเดียว ไม่ใช่สองสี หัวข้อจึงรับ
// แดงสว่างทึบ #ff3b3b ไว้เป็นตัวเน้นเพียงจุดเดียว คู่กับ SevenThreeCyberCut ที่อยู่
// ใต้ลงไปในหน้าเดียวกันซึ่งหัวข้อเป็นทองแบรนด์ทึบในการ์ดมุมตัด สองบล็อกจึงคนละ
// จังหวะสายตาทั้งรูปทรง ด้านที่วางรูป และสี กรอบการ์ดเป็นทองแบรนด์
// เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดทอง-เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#1b1005 #ebbb54 #050201
// #2e1d08 #d5d4d3 #f8eed9) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f5c33b]/45 bg-[#170707] p-8 shadow-[10px_10px_20px_#050101,-10px_-10px_20px_#2a0606] transition-all duration-300 hover:shadow-[15px_15px_30px_#050101,-15px_-15px_30px_#f5c33b]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#ff3b3b]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:border-l md:border-[#7a0505]/55 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#ff3b3b]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
