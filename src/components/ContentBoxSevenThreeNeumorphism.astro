---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// PGW44 palette (ทอง-เขียว-ดำ 2026-09-27): แผ่นนูนวางบนผิวการ์ดดำอมเขียว #0b1408 ใน
// กรอบทองแบรนด์ #fde90e กดเงาลงไปหาพื้นเพจ #050803 และยกแสงขึ้นด้วยผิวแผงยก #101a0b
// ซึ่งไต่ขึ้นเป็นทองแบรนด์ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่าง ไม่ใช่
// สองสี เงาจึงเป็นความสว่างภายในโทนดำอมเขียวโทนเดียว และปล่อยให้หัวข้อรับทองแบรนด์
// ทึบไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่ถัดลง
// ไปในหน้าเดียวกันซึ่งหัวข้อเป็นเขียวสว่างอยู่ในรางมุมตัด จึงคนละจังหวะสายตาทั้งรูป
// ทรงและสี เนื้อความ #e9f0dd (BRAND_TEXT) — ชุดเขียวมรกต-โครเมียมของ BRAZIL999
// (#22c55e #7cf25c #0a1a0c #040a05 #123a18 #dfeadd) ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#fde90e]/50 bg-[#0b1408] p-8 shadow-[10px_10px_20px_#050803,-10px_-10px_20px_#101a0b] transition-all duration-300 hover:shadow-[15px_15px_30px_#050803,-15px_-15px_30px_#1f5a16]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#fde90e]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f0dd] md:border-l md:border-[#fde90e]/40 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#fde90e]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
