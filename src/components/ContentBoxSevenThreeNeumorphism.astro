---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// VAK88 palette: soft-extruded card on the brand's navy card surface (#0b1020)
// inside a deep-gold hairline border, shadowed into the deepest navy (#04060e)
// with a gold-lit highlight (#241a08). The heading takes the light gold accent
// (#ffd873).
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#8a5f14]/75 bg-[#0b1020] p-8 shadow-[10px_10px_20px_#04060e,-10px_-10px_20px_#241a08] transition-all duration-300 hover:shadow-[15px_15px_30px_#04060e,-15px_-15px_30px_#3a2a0c]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8ca]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#ffd873]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8ca] md:border-l md:border-[#8a5f14]/75 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#ffd873]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
