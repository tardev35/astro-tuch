---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// GODBET88 palette: the soft-extruded slab sits on the raised brown-black
// (#161208) inside a primary-gold hairline (#c2a55c), shadowed down into the
// page black (#050403) and lifted with the darkest brown-gold (#5c4418), which
// steps up to deep gold (#9a7f3f) on hover. A neumorphic relief needs a
// dark/light pair rather than two hues, so a single-hue brand gets it from
// brightness inside the gold. The heading takes the sheen gold (#f6e7b8); the
// previous brand's navy is gone.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#c2a55c]/50 bg-[#161208] p-8 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#5c4418] transition-all duration-300 hover:shadow-[15px_15px_30px_#050403,-15px_-15px_30px_#9a7f3f]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#f6e7b8]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cc] md:border-l md:border-[#c2a55c]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#f6e7b8]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
