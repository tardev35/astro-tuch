---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Column order: TEXT (7fr) then IMAGE (3fr) — the mirror of
// ContentBoxSevenThreeCyberCut, which runs image-then-text. The home page
// renders one of each, so the two image+text blocks alternate sides instead of
// stacking both pictures down the same edge. The wide column is therefore the
// LEFT one and `title` falls back to it, so a caller that passes a single docx
// heading gets it on the prose, never on the picture.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleright`, so this block emits exactly one docx heading.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): แผ่นนูนวางบนผิวการ์ดอุ่น #1a1710 ใน
// กรอบทองแบรนด์ #edbb23 กดเงาลงไปหาพื้นดำสนิท #050505 และยกแสงขึ้นด้วยผิวกรอบอุ่น
// #2a2115 ซึ่งไต่ขึ้นเป็นทองแบรนด์ตอน hover ความนูนแบบ neumorphic ต้องใช้คู่มืด/สว่าง
// ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนอุ่นโทนเดียว และปล่อยให้หัวข้อรับเงินโครเมียม
// ทึบ #c8cbce ไว้เป็นตัวเน้นเพียงจุดเดียว — คู่กับ ContentBoxSevenThreeCyberCut ที่อยู่
// ใต้ลงไปในหน้าเดียวกันซึ่งหัวข้อเป็นทองแบรนด์ในการ์ดมุมตัด จึงคนละจังหวะสายตาทั้งรูปทรง
// ด้านที่วางรูป และสี เนื้อความ #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#17120a #edb543 #070707 #241a09
// #e6e6e6 #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#edbb23]/50 bg-[#1a1710] p-8 shadow-[10px_10px_20px_#050505,-10px_-10px_20px_#2a2115] transition-all duration-300 hover:shadow-[15px_15px_30px_#050505,-15px_-15px_30px_#edbb23]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {leftHeading && <HeadingTag class="text-xl leading-normal font-black text-[#c8cbce]">{leftHeading}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#edbb23]/40 md:pl-8">
        {titleright && <HeadingTag class="text-xl leading-normal font-black text-[#c8cbce]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
