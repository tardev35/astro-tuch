---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
//
// MAHAGAME66 palette (แดง-ดำ-เงินโครเมียม 2026-09-24): แผ่นนูนวางบนผิวการ์ด
// #16090a ในกรอบแดงแบรนด์ #de161d กดเงาลงไปหาพื้นเพจเกือบดำ #080506 และยกแสงขึ้น
// ด้วยผิวการ์ดยก #26100f ซึ่งไต่ขึ้นเป็นแดงแบรนด์ตอน hover ความนูนแบบ neumorphic
// ต้องใช้คู่มืด/สว่าง ไม่ใช่สองสี เงาจึงเป็นความสว่างภายในโทนแดงเกือบดำโทนเดียว และ
// ปล่อยให้หัวข้อรับแดงสว่าง #ff4d52 ของโลโก้ไว้เป็นสีที่สองเพียงจุดเดียว — คู่กับ
// ContentBoxSevenThree ในหน้าเดียวกันที่หัวข้อเป็นเงินโครเมียม จึงคนละจังหวะสายตา
// เนื้อความ #e8e3e1 (BRAND_TEXT) — ทอง #e8b93f/#ffe9a3/#96671a พื้นน้ำตาล
// #171006/#0d0903/#2a1d0b และครีม #e3d8c0 ของ SAGAME66 ออกหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#de161d]/50 bg-[#16090a] p-8 shadow-[10px_10px_20px_#080506,-10px_-10px_20px_#26100f] transition-all duration-300 hover:shadow-[15px_15px_30px_#080506,-15px_-15px_30px_#de161d]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1]">
        {titleleft && <HeadingTag class="text-xl leading-normal font-black text-[#ff4d52]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e3e1] md:border-l md:border-[#de161d]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-xl leading-normal font-black text-[#ff4d52]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
