---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// Flattened multi-column variant: the text classes live on each <article> and
// the slot is a direct child, so the heading that sits beside it carries
// `leading-normal` to cancel the hoisted `leading-relaxed`. Do not re-add a
// wrapper <div>.
//
// PAOTUNG palette: the soft-extruded slab sits on the brand's navy card surface
// (#04203c) inside a primary-blue hairline, shadowed into the page black-navy
// (#010a16) with a lifted brand-blue highlight (#0a3a68) — the same relief pair
// ContentBoxNeumorphism uses, so the two read as one system. The heading takes
// the light-gold metallic (#f5e3b3) against it.
//
// Only one column ever carries a heading on the page — the image column is
// passed no `titleleft`, so this block emits exactly one docx heading.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#226ca9]/50 bg-[#04203c] p-8 shadow-[10px_10px_20px_#010a16,-10px_-10px_20px_#0a3a68] transition-all duration-300 hover:shadow-[15px_15px_30px_#010a16,-15px_-15px_30px_#0d4a82]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-black text-[#f5e3b3]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfdeed] md:border-l md:border-[#226ca9]/50 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#f5e3b3]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
