---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

const images = [
  {
    src: slide1,
    alt: "โปสเตอร์โปรโมชั่น UFASLOT พื้นหลังสีดำ มีโลโก้ UFASLOT ตัวอักษรทองและเงิน ข้อความ โปรโมชั่น แนะนำเพื่อน รับโบนัส 0.8% พร้อมตัวเลข 0.8% สีทองขนาดใหญ่ หญิงสาวสวมชุดดำขลิบทอง ยืนข้างกองเหรียญทองและชิปคาสิโน",
  },
  {
    src: slide2,
    alt: "โปสเตอร์โปรโมชั่น UFASLOT พื้นหลังสีดำ มีโลโก้ UFASLOT ตัวอักษรทองและเงิน ข้อความ โปรโมชั่น คืนยอดเสีย รับโบนัส 0.3% พร้อมตัวเลข 0.3% สีทองขนาดใหญ่ หญิงสาวสวมชุดเดรสดำ-ทอง ยืนข้างกองชิปคาสิโนและเหรียญทอง",
  },
];

const COPIES = 6;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c518]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f5c518]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#b6821d]/45 object-cover shadow-[0_10px_30px_rgba(245,197,24,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
