---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

// Only slide1 and slide2 exist for this brand. slide3/slide4 are previous
// brands' artwork and must never be imported here — an import is an emit, so
// importing them would ship them to dist/ even if nothing rendered them.
//
// The alt strings below are read off the artwork itself, not guessed from the
// filename: an earlier rebrand shipped them swapped (slide1 described as the
// 0.8% poster when 0.8% is the other one), so they are rewritten every round.
const images = [
  {
    src: slide1,
    alt: "โปสเตอร์โปรโมชั่น 12PLAY พื้นหลังดำลายวงจรไฟฟ้าเรืองแสงสีแดง มุมบนซ้ายเป็นโลโก้ 12PLAY ตัวอักษรโครเมียมสลับแดง ถัดลงมาเป็นแผ่นป้ายเขียนว่า โปรโมชั่น คืนยอดเสีย รับโบนัส และตัวเลข 0.3% ขนาดใหญ่สีแดง หญิงสาวในชุดแดงดำยืนแบมือทางซ้าย ด้านข้างมีไพ่เอซกับไพ่เค ชิปคาสิโนสีแดงและขาวสลักเลข 12 แถบล่างเขียนว่า มั่นคง ปลอดภัย เชื่อถือได้ 100% ฝาก-ถอน ออโต้ รวดเร็ว ทันใจ บริการดูแล 24 ชม. พร้อมดูแลคุณ และ งานบริการมาตรฐานระดับสากล",
  },
  {
    src: slide2,
    alt: "โปสเตอร์โปรโมชั่น 12PLAY พื้นหลังดำลายวงจรไฟฟ้าเรืองแสงสีแดง โลโก้ 12PLAY ตัวอักษรโครเมียมสลับแดงอยู่ด้านบนซ้าย ถัดลงมาเป็นแผ่นป้ายเขียนว่า โปรโมชั่น แนะนำเพื่อน รับโบนัส 0.8% โดยตัวเลข 0.8% เป็นตัวใหญ่สีขาวขอบแดง หญิงสาวในชุดกีฬาแดงดำติดโลโก้ 12PLAY ยืนแบมือทางซ้าย รอบตัวมีชิปคาสิโนสีแดงและไพ่เอซลอยอยู่",
  },
];

const COPIES = 6;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e01020]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff5a63]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e01020]/45 object-cover shadow-[0_10px_30px_rgba(224,16,32,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
