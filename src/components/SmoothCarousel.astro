---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

// Only slide1 and slide2 belong to this brand's asset drop. slide3/slide4 are
// previous brands' artwork and must never be imported here — an import is an
// emit, so importing them would ship them to dist/ even if nothing rendered
// them.
//
// slide1 is the แนะนำเพื่อน 0.8% poster and slide2 is the คืนยอดเสีย 0.3% poster.
// The alt strings below describe what is actually printed on each one.
const images = [
  {
    src: slide1,
    alt: "โปสเตอร์โปรโมชั่นสี่เหลี่ยมจัตุรัส พื้นหลังสีดำเขียวทองมีลูกบิลเลียดเลข 8 และเลข 9 กับกองเหรียญทอง ด้านบนเป็นโลโก้ LEKDED สีทองเขียวมีมงกุฎและลูกบิลเลียดเลข 8 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น แนะนำเพื่อน พร้อมตัวเลขทองขนาดใหญ่ 0.8% ด้านขวาเป็นผู้หญิงผมยาวสีเงินในชุดสีทองเขียวยืนแบมือ ด้านล่างมีสลากลอตเตอรี่สองใบวางซ้อนกัน และแถบข้อความ มั่นคง ปลอดภัย 100% ฝาก-ถอน ออโต้ บริการตลอด 24 ชม.",
  },
  {
    src: slide2,
    alt: "โปสเตอร์โปรโมชั่นสี่เหลี่ยมจัตุรัส พื้นหลังสีดำเขียวทองมีลูกบิลเลียดเลข 8 เลข 9 เลข 3 และกองเหรียญทอง ด้านบนเป็นโลโก้ LEKDED สีทองเขียวมีมงกุฎและลูกบิลเลียดเลข 8 กลางภาพเป็นกรอบทองเขียนว่า โปรโมชั่น คืนยอดเสีย พร้อมตัวเลขทองขนาดใหญ่ 0.3% ด้านขวาเป็นผู้หญิงผมยาวสีเงินในชุดสีทองเขียวยืนแบมือ ด้านล่างซ้ายมีโพยหวยสามใบติดป้ายว่า รัฐบาลไทย ฮานอย และ ลาว พร้อมแถบข้อความ กดรับได้ทุกวัน มั่นคงปลอดภัยเชื่อถือได้ 100% บริการตลอด 24 ชม. และแถบล่างสุดเขียนว่า ซื้อหวยง่าย จ่ายจริง จ่ายเต็มทุกบิล",
  },
];

const COPIES = 6;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e2c466]/70 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fff4cd]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e2c466]/55 object-cover shadow-[0_10px_30px_rgba(226,196,102,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 767px) 46vw, 31vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
