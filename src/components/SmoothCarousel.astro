---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

// Only slide1 and slide2 belong to this brand's asset drop. slide3/slide4 are
// previous brands' artwork and must never be imported here — an import is an
// emit, so importing them would ship them to dist/ even if nothing rendered
// them.
//
// The alt strings below describe what is actually printed on each poster.
const images = [
  {
    src: slide1,
    alt: "โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ด้านซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงินเมทัลลิก ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น แนะนำเพื่อน รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรียาวสีทองเงิน รอบตัวมีลูกเต๋าและเหรียญทองกระจายอยู่ แถบด้านล่างเขียนว่า ชวนเพื่อนเลย รับโบนัสไม่อั้น! ใต้แถบมีไอคอนสามช่อง มั่นคง ปลอดภัย เชื่อถือได้ 100% ชวนง่าย ได้จริง รับโบนัสทันที และ ไม่จำกัดยอดเพื่อน ยิ่งชวน ยิ่งได้",
  },
  {
    src: slide2,
    alt: "โปสเตอร์โปรโมชั่นพื้นหลังสีดำ ด้านซ้ายบนเป็นโลโก้ DARK168 ตัวอักษร DARK สีทองและเลข 168 สีเงินเมทัลลิก ถัดลงมาเป็นข้อความสีทอง โปรโมชั่น คืนยอดเสีย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวสวมชุดราตรียาวสีเงินตัดทอง ฉากหลังเป็นลำแสงเรขาคณิตสีทองพาดผ่านพื้นสีดำ",
  },
];

const COPIES = 6;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e6b74e]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f6dfa4]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e6b74e]/45 object-cover shadow-[0_10px_30px_rgba(230,183,78,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
