---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

// Only slide1 and slide2 belong to this brand's asset drop. slide3/slide4 are
// previous brands' artwork and must never be imported here — an import is an
// emit, so importing them would ship them to dist/ even if nothing rendered
// them.
//
// The alt strings below describe what is actually printed on each poster.
const images = [
  {
    src: slide1,
    alt: "โปสเตอร์โปรโมชั่นพื้นเงินขาวลายวงกลมจีน ด้านบนเป็นโลโก้ HONGHAO ตัวอักษรเขียวหยกสลับเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น คืนยอดเสีย และป้าย รับโบนัส พร้อมตัวเลข 0.3% ขนาดใหญ่ ด้านซ้ายมีไพ่และชิปคาสิโนสีเขียว ด้านขวาเป็นหญิงสาวชุดกี่เพ้าสีเขียวมะกอกปักลายดอกไม้ เกล้าผมประดับเครื่องประดับทอง แบฝ่ามือไปทางข้อความ แถวล่างมีไอคอนสี่ช่อง คืนยอดเสียทุกวัน ทำเทิร์นครบรับโบนัสทันที มั่นคง ปลอดภัย เชื่อถือได้ และบริการลูกค้าตลอด 24 ชม.",
  },
  {
    src: slide2,
    alt: "โปสเตอร์โปรโมชั่นพื้นเงินขาวลายจีนมีเจดีย์และภูเขาหมอก ด้านบนเป็นโลโก้ HONGHAO ตัวอักษรเขียวหยกสลับเงิน ถัดลงมาเป็นคำว่า โปรโมชั่น แนะนำเพื่อน และ รับโบนัส พร้อมตัวเลข 0.8% ขนาดใหญ่ ด้านขวาเป็นหญิงสาวชุดกี่เพ้าสีครีมทองปักลายดอกไม้เขียว เกล้าผมประดับปิ่นทอง แบฝ่ามือไปทางข้อความ มุมล่างมีไพ่ กองเหรียญทอง และกล่องของขวัญ",
  },
];

const COPIES = 6;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#62ae2d]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f2f8ec]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#62ae2d]/45 object-cover shadow-[0_10px_30px_rgba(98,174,45,0.24)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 767px) 46vw, 31vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
