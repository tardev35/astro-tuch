---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §2
// exempts colours that carry their own meaning: LINE green, live dots and real
// bank logos).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️ บรีฟรอบนี้เป็น **เว็บสล็อตออนไลน์** ที่พูดถึง เกมสล็อตสนุกสุดมันส์ ·
// รวมค่ายดัง · เบทต่ำ 1 บาท · ไม่ทำเทิร์น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ฝากถอนทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม. คำที่แผงนี้ใช้จึงมีแค่คำกลางของบรีฟ:
// สมาชิก · รายการ · ธุรกรรม · ตรวจสอบ · เว็บไซต์ทางการ · ผู้ใช้งาน
// **ไม่มีคำว่า คาสิโน บาคาร่า แทงบอล จ่ายจริง การันตี หรือคำหมวดหวย (หวย ·
// ตรวจหวย · แนวทาง · สลาก · เลขเด็ด) ที่ไหนเลย** (brand-spec §5) และ §5 ยังห้าม
// คำของแบรนด์ก่อน (หมูบิน · เกมสล็อตแท้ · เว็บตรงถูกลิขสิทธิ์ · เชื่อถือได้ ·
// สมัคร 3 ขั้นตอน · ฝากถอนไม่มีขั้นต่ำ · ไม่จำกัดยอด · ระบบสล็อตเว็บนอก ·
// ทางเข้าแท้ · ไม่ผ่านเอเย่นต์100% · ยอดเข้าบริษัทแม่โดยตรง) ซึ่งไม่เหลือในไฟล์นี้
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ และ **ไม่มีตัวเลขที่บรีฟไม่ได้ให้**
// (ยอดในแถวเป็นตัวอย่างรูปแบบการแสดงผล และบรรทัดใต้หัวแผงบอกไว้ตรง ๆ ว่าไม่ใช่
// ยอดจริงของผู้ใช้งาน)
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (หมูบิน168) ใช้ LatestWinners ตัวฐาน จึงหมุนมาที่
// ไฟล์นี้ (ห่างออกไปแปดคอมมิต)
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง และแผงนี้อยู่ใน "โซนเนื้อหา" ไม่ใช่โครมสีเข้ม** —
// §2 สงวนผิวโครมเข้ม (#06283f / #0b4a73 / #2a87c4 / #eaf7ff) ไว้ให้
// navbar/footer/ticker/overlay/แถบมือถือ ส่วนแผงนี้ถูกวาง **ต่อท้าย §6 (ระบบฝากถอน)
// กลางสายเนื้อหา** จึงต้องอ่านต่อเนื่องกับการ์ดเนื้อหาสองใบที่ขนาบมันอยู่
// **ห้าม "แก้" ให้เป็นแผงพื้นมืด** — ถ้าทำ หมึก #06283f ของแถวจะหายไปเลย ไม่ใช่
// แค่จางลง (ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองคานารีบนน้ำตาลกาแฟเข้มของ พักยก168**
// ทั้งใบ จึงรีเธมทั้งไฟล์)
// พื้นเพจ #00bfff (bg.json = ฟ้าสกายอิ่มตัว) ลำดับผิวที่ใช้ในไฟล์นี้: #ffffff การ์ด
// (แถวรายการ) / **#f0faff ยก (ตัวแผง)** / #e4f6fb wash / #00bfff พื้นเพจ
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งแปดใบ: แผงคือผิวยก #f0faff ในกรอบฟ้าสกาย #12b4ef หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นฟ้าเส้นเข้ม #4fb8ea และจุดบนเส้นเป็นฟ้าสกาย
// #12b4ef (หัวใจฟ้ากับฟองอากาศในงานศิลป์) ที่มีออรา rgba(18,180,239,0.55)
// ⚠️ **§2 ห้าม #12b4ef ถือตัวอักษรบนผิวสว่างเด็ดขาด (2.4:1 บนขาว)** ในไฟล์นี้มันจึง
// อยู่ที่กรอบแผง จุดบนไทม์ไลน์ และออราเท่านั้น **ไม่มีกลีฟไหนเป็นสีนี้เลย**
// เช่นเดียวกับ #4fb8ea / #7fcbe8 / #b6e3f0 / #00bfff
// หัวแผงเป็น **ฟ้าลึก #0f5684 ทึบสีเดียว** (7.3:1 บนผิวยก) — ⚠️ **ตั้งใจไม่ใช้
// bg-clip-text ที่นี่** เพราะ §8 Faq4 เป็นใบเดียวบนหน้าที่ถือหัวข้อไล่เฉด และ
// ไล่เฉดที่ปลอดภัยบนผิวสว่างมีชุดเดียว (#0f5684 → #1a6ea8) ถ้าใช้ทั้งสองที่
// สองก้อนจะอ่านซ้ำกันทันที
// ตัวเลขยอดเป็น **ฟ้าลึก #0f5684** (7.8:1 บนแถวขาว) ซึ่ง §2 อนุญาตให้ถือตัวอักษร
// ได้เต็มที่ — ต่างจากฟ้าสกายที่ถือไม่ได้ ชื่อยูสเซอร์เป็นหมึกหลัก #06283f
// (15.2:1) ป้ายกำกับเป็นหมึกรอง #355f7d (6.8:1 บนขาว · 6.4:1 บนผิวยก)
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้หมึกรอง
// #355f7d แบบกรอบจาง (เงียบ ไม่ใช่สีแบรนด์ — สถานะรอที่ถูกทาด้วยฮิวนำจะหยุดอ่าน
// เป็นสถานะรอ) และสถานะสำเร็จคงเขียว success ไว้ ทั้งคู่เป็นคลาสใน <style>
// ด้านล่าง เพื่อให้ src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตของแบรนด์เลย
// ⚠️⚠️ **เขียว success ยังเป็นเขียวเชิงความหมายตัวเดิม (hue 150 เท่าเดิม ไม่ใช่
// สีแบรนด์) แต่ต้องลด lightness ลงเพราะแถวรอบนี้เป็นผิวขาว** — ค่าเดิม
// oklch(79.2% …) ถูกเลือกไว้สำหรับแถวพื้นมืดของรอบก่อน และบนขาวมันอ่านได้ราว
// 1.8:1 คือมองไม่เห็น ค่าใหม่ oklch(52.7% …) ได้ราว 4.8:1 บนแถวขาว
// **ห้ามเปลี่ยนฮิวของมันไปเป็นฟ้าของแบรนด์ และห้ามแตะ LINE green #00B900**
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือฟ้า เพราะฟ้าเคยนำมาแล้ว
// แปดเจ้าในรีโปนี้** ฟ้ารอบนี้คือ **#12b4ef / #b6e3f0 / #00bfff / #7fcbe8 /
// #4fb8ea / #0f5684 / #1a6ea8 / #06283f** วัดจากอาร์ตเวิร์กกับ bg.json ของดรอปนี้
// ⚠️⚠️ **ไม่ใช่ 18a5e2 / 0d6b9b / a9d7f2 ของ ร่ำรวย168** (18a5e2 ห่างจาก #12b4ef
// แค่ R6/G15/B13 — ใกล้ที่สุดในลิสต์) ไม่ใช่ 2cc3fc 6bdcfb 0a7fbd 063a57 ของ
// สบาย168 (063a57 มี R=06 ตรงกับ #06283f เป๊ะ) ไม่ใช่ 32bcfb a9e9ff 07335f ของ
// นินจา168 ไม่ใช่ 1fd8f0 0bb6d4 1d4fd8 143aa0 ของ นาซ่า168 ไม่ใช่ 1177e8 0e68cc
// 0a4ea8 ของ มาดาม168 ไม่ใช่ 039cfa 0494f5 c3ebfc ของ รวยแทร่168 ไม่ใช่ 2f9ff5
// a8dcff d6ecff 0b3f78 ของ สบายเบท168 และไม่ใช่ 0360f3 0292fb 6ec8ff ของ TSDET911
// ⚠️ **ทองของ พักยก168 ที่เพิ่งอยู่ทั้งใบนี้ต้องไม่เหลือเลยสักค่า**: eeae12 fded41
// 9f600d e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f 1f0f04 4e2f11 3a2713
// 32200f 1f1308 + rgba(238,174,18,α)
// ⚠️ **ชมพูของ หมูบิน168 (แบรนด์ขาออก) ก็ต้องไม่เหลือ**: fa539c c2185b 8e0f41
// fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350
// ffe9f5 7a4463
// ชุดอื่นที่เคยอยู่ในไฟล์นี้และออกครบแล้ว: **มีทรัพย์168** (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) · **มีโชค168** (fcd434 ff8dc6 f5469f 8c0f52 7a5508 f6e4ee
// 24101c 160a12 0b0509) · **สมหวัง168** (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706) · **TSDET911**
// (cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f) · **PUNPRO168** (f41571 ff5ca8
// fce343) · **สบาย168** (04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff
// a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c 2a1f02) · **ufalion168** (d4922c fdfc71
// f6e3b4 a25b24 5a3310) · **สล็อต168** (fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4
// c9b9b7 e3d6d4 7d6f6e 140000 0b0000 1c0607 2a0c0d 551c1e)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีม่วง/ไวโอเลต ไม่มีเขียว
// ไม่มีส้ม ไม่มีโรสโกลด์ ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน**
// (ยกเว้นสีประจำธนาคารใน bankPool ด้านบน และเขียว success ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#12b4ef] bg-[#f0faff] px-4 py-8 shadow-[0_10px_30px_rgba(15,86,132,0.14)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#12b4ef]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#b6e3f0]/60 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="text-xl font-black text-[#0f5684] md:text-3xl">รายการในระบบสมาชิก {BRAND_NAME} ที่ตรวจสอบสถานะได้จากเว็บไซต์ทางการ</p>
      <p class="mt-2 text-base leading-relaxed text-[#355f7d]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้ใช้งาน</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#4fb8ea] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#f0faff] bg-[#12b4ef] shadow-[0_0_10px_rgba(18,180,239,0.55)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] border border-[#7fcbe8] bg-gradient-to-r from-white to-[#f0faff] p-4 transition-colors hover:to-white">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#355f7d]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#06283f]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#0f5684]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-status.is-pending {
    color: #355f7d;
    border-color: color-mix(in oklab, #355f7d 45%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(52.7% 0.154 150.069);
    border-color: color-mix(in oklab, oklch(62.7% 0.194 149.214) 55%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
