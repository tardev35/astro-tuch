---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §2
// exempts colours that carry their own meaning: LINE green, live dots and real
// bank logos).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️ บรีฟรอบนี้เป็น **เว็บสล็อตล้วน** ที่ขาย "ฐานหลักเว็บสล็อตลิขสิทธิ์แท้ นำเข้าตรง
// จากสิงคโปร์ รวม PG SOFT / JOKER / JILI" คำที่แผงนี้ใช้จึงมีแค่คำของบรีฟเอง:
// สมาชิก · ฝากถอน · เจ้าหน้าที่ · เว็บไซต์ทางการ · ตรวจสอบ
// **ไม่มีคำว่า คาสิโน บาคาร่า ไฮโล บอล แทงบอล อัตราต่อรอง เว็บตรง ไม่มีขั้นต่ำ
// จ่ายจริง การันตี หรือคำหมวดหวยที่ไหนเลย** (brand-spec §6) และ §6 ยังห้ามวลีของ
// แบรนด์ก่อน (ศูนย์บริการหลัก · ศูนย์รวมช่องทางบริการ · ช่องทางรับบริการ ·
// ลิขสิทธิ์เว็บแท้100%) ซึ่งไม่เหลือในไฟล์นี้แล้ว
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ และไม่มีตัวเลขที่บรีฟไม่ได้ให้
//
// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2-§3): ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (ขวัญใจ168) ใช้
// LatestWinnersPremium จึงหมุนมาที่ไฟล์นี้
// โลโก้เป็นแมวกวักนำโชคขนขาวลายส้มทอง นั่งเหนือคำว่า "มีโชค" ตัวอักษรไทยสามมิติ
// ไล่เฉดชมพูบานเย็นขึ้นทอง ต่อด้วยเลข "168" ทอง ล้อมด้วยริบบิ้นซาตินชมพู เหรียญจีน
// ทองรูสี่เหลี่ยม ทองแท่งจีน หัวใจชมพู และดอกซากุระ บนพื้น **ดำสนิท #000000**
// ⚠️ ลำดับความลึก: #24101c ยก / #160a12 กลาง / #0b0509 จม / #000000 พื้น
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งแปดใบ: แผงคือผิวจม #0b0509 ในกรอบชมพูบานเย็น #f5469f หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นทองลึก #7a5508 และจุดบนเส้นเป็นทองแบรนด์
// #fcd434 (เหรียญจีนทอง) ที่มีออรา rgba(252,212,52,0.9)
// ออราสองมุมแยกด้วย **ค่า**: ชมพูบานเย็น #f5469f มุมขวาบน (ริบบิ้นซาติน) กับพลัมเข้ม
// #8c0f52 มุมซ้ายล่าง (เงาใต้กองเหรียญ)
// หัวแผงไล่ ทองแบรนด์ #fcd434 → ชมพูอ่อน #ff8dc6 → ชมพูบานเย็น #f5469f
// ตัวเลขยอดใช้ชมพูบานเย็น #f5469f เป็นตัวเน้น (6.2:1 และเป็น text-xl font-black จึง
// เป็น large text) ซึ่งเป็นจุดที่ฮิวที่สองของรอบนี้ปรากฏตัวชัดที่สุดในแผงนี้
// แถวรายการวางบนผิวกลาง #160a12 และสว่างขึ้นเป็นผิวยก #24101c ตอน hover ชื่อยูสเซอร์
// เป็นสีเนื้อความ #f6e4ee (= BRAND_TEXT) ป้ายกำกับเป็นชมพูอ่อน #ff8dc6 (9.9:1)
// §2 ห้าม #8c0f52 #7a5508 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสองค่าอยู่ที่กรอบ
// เส้นไทม์ไลน์ และออราเท่านั้น และ #ffeaa0 สงวนไว้ให้ <strong> ในเนื้อความของหน้า
// จึงไม่อยู่ในไฟล์นี้
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้สีเนื้อความ
// #f6e4ee แบบกรอบจาง (เงียบ ไม่ใช่สีแบรนด์ — สถานะรอที่ถูกทาด้วยฮิวนำจะหยุดอ่านเป็น
// สถานะรอ) และสถานะสำเร็จคงเขียว success ของทุกแบรนด์ไว้ ทั้งคู่เป็นคลาสใน <style>
// ด้านล่าง เพื่อให้ src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตต์ของแบรนด์เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** ไฟล์นี้เพิ่งถือชุด
// แดงมังกร-ทองไทยของสมหวัง168 มาทั้งไฟล์ (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ก่อนนั้นเป็น
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e 041a43) ชุดทองมังกรของ
// TND168 และชุดชมพูฮอต-ทองของ PUNPRO168 — ถอดออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้คือ #fcd434 ไม่ใช่ f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c
// (สมหวัง168) dfa310 ffe4a3 8a5c09 (TND168) e5a81b (UFA324) หรือ fad354 (789BETTING)
// ⚠️ ชมพูรอบนี้คือ #f5469f / #ff8dc6 ไม่ใช่ f41571 / ff5ca8 ของ PUNPRO168 และไม่ใช่
// โรสโกลด์ f2bba5 / c98a74 ของขวัญใจ168 — เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ ไม่มีแดง** (ยกเว้นสีประจำธนาคารใน bankPool
// ด้านบน และเขียว success ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f5469f] bg-[#0b0509]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.9)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#f5469f]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#8c0f52]/75 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#fcd434] via-[#ff8dc6] to-[#f5469f] bg-clip-text text-xl font-black text-transparent md:text-3xl">
        รายการในระบบสมาชิก {BRAND_NAME} ที่ตรวจสอบสถานะได้จากเว็บไซต์ทางการ
      </p>
      <p class="mt-2 text-base leading-relaxed text-[#ff8dc6]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้ใช้งาน</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#7a5508] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#0b0509] bg-[#fcd434] shadow-[0_0_10px_rgba(252,212,52,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#160a12]/90 to-transparent p-4 transition-colors hover:from-[#24101c]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#ff8dc6]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f6e4ee]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#f5469f]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on the quiet body colour with a faded border — a waiting
     state painted in the brand's lead gold or its hot-pink second hue stops
     reading as a waiting state — and "verified" stays the semantic success
     green on every brand. */
  .winner-status.is-pending {
    color: #f6e4ee;
    border-color: color-mix(in oklab, #f6e4ee 45%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
