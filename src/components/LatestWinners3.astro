---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §2
// exempts colours that carry their own meaning: LINE green, live dots and real
// bank logos).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️ บรีฟรอบนี้เป็น **เว็บสล็อตออนไลน์** ที่พูดถึง ค่ายแท้ · ถูกลิขสิทธิ์100% ·
// ไม่ผ่านม้า · ทดลองเล่นฟรี · โปรโมชั่น · ฝากถอน คำที่แผงนี้ใช้จึงมีแค่คำของบรีฟเอง:
// สมาชิก · รายการ · ธุรกรรม · ตรวจสอบ · เว็บไซต์ทางการ · ผู้ใช้งาน
// **ไม่มีคำว่า คาสิโน บาคาร่า แทงบอล เว็บตรง100% ไม่มีขั้นต่ำ จ่ายจริง การันตี
// แตกง่าย หรือคำหมวดหวย (หวย · ตรวจหวย · แนวทาง · สลาก · เลขเด็ด) ที่ไหนเลย**
// (brand-spec §5) และ §5 ยังห้ามคำของแบรนด์ก่อน (เบทต่ำ · สบายเป๋า · ทุนน้อย ·
// เล่นง่าย · ยอดเข้าบริษัทโดยตรง · ปรับระดับการเดิมพัน · ยอดเดิมพันขั้นต่ำ ·
// งบประมาณ · นิติบุคคล) ซึ่งไม่เหลือในไฟล์นี้แล้ว
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ และไม่มีตัวเลขที่บรีฟไม่ได้ให้
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22) — พาเลตตาม .claude/brand-spec-pakyok168.md §2–§3
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (สบาย168) ใช้ LatestWinners4 จึงหมุนมาที่ไฟล์นี้
// ⚠️⚠️ **รอบนี้เป็นธีมมืด และไฟล์นี้คือ "โครม" ไม่ใช่เนื้อหา** — brand-spec §2
// แยกไว้ชัด แต่รอบนี้ **โครมกับเนื้อหาอยู่ทิศเดียวกัน (มืดทั้งคู่)** ต่างจากรอบก่อน
// ที่โครมเข้มคร่อมเนื้อหาสว่าง สิ่งที่แยกหัว-ท้ายออกจากตัวหน้ารอบนี้คือ **โทนน้ำตาล
// ที่ลึกกว่า + เส้นขอบทอง #eeae12 + ออราทอง** ไม่ใช่ความต่างของความสว่าง
// **ห้าม "แก้" ให้เนื้อหาสว่างขึ้นหรือทำแผงนี้เป็นผิวขาวตามรอบก่อน**
// พื้นเพจ #291d0f (bg.json = น้ำตาลกาแฟเข้ม) ลำดับผิวของโครม: #4e2f11 ยก
// (แถวรายการ) / #2f1e0f กลาง (ตัวแผง) / #1f0f04 จม
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งเจ็ดใบ: แผงคือผิวกลาง #2f1e0f ในกรอบทองแกน #eeae12 หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นทองลึก #9f600d และจุดบนเส้นเป็นทองแกน #eeae12
// (ทองคำแท่งและเหรียญทองในงานศิลป์) ที่มีออรา rgba(238,174,18,0.9)
// ออราสองมุมแยกด้วย **ค่า**: ทองแกน #eeae12 มุมขวาบน กับทองลึก #9f600d มุมซ้ายล่าง
// ⚠️ **§2 ห้าม #9f600d ถือตัวอักษรเด็ดขาด (2.8:1)** ในไฟล์นี้มันจึงอยู่ที่รางไทม์ไลน์
// และออราเท่านั้น ไม่มีกลีฟไหนเป็นสีนี้เลย
// หัวแผงไล่ หมึกไอวอรี #f4ead6 → ทองสว่าง #fded41 → โครเมียมสว่าง #e0e0df ซึ่งทั้งสาม
// ค่าอยู่ที่ 11:1 ขึ้นไปบนผิวกลาง #2f1e0f ⚠️ bg-clip-text = พิกเซลของตัวอักษร จึงเอา
// เฉพาะค่าที่ §2 ให้ถือตัวอักษรบนโครมได้ และลำดับนี้คือ "ไอวอรี → ทอง → โครเมียม"
// ซึ่งเดินผ่านสองวัสดุของโลโก้พอดี
// ตัวเลขยอดเป็น **ทองสว่าง #fded41** (13.3:1 บนผิวยก #4e2f11) ซึ่ง §2 อนุญาตให้ถือ
// ตัวอักษรได้เต็มที่ — ต่างจากทองลึกที่ถือไม่ได้ ชื่อยูสเซอร์เป็นโครเมียมสว่าง
// #e0e0df ป้ายกำกับเป็นหมึกรอง #d6c6a8
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้หมึกรอง
// #d6c6a8 แบบกรอบจาง (เงียบ ไม่ใช่สีแบรนด์ — สถานะรอที่ถูกทาด้วยฮิวนำจะหยุดอ่าน
// เป็นสถานะรอ) และสถานะสำเร็จคงเขียว success ของทุกแบรนด์ไว้ ทั้งคู่เป็นคลาสใน
// <style> ด้านล่าง เพื่อให้ src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตของแบรนด์เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง เพราะทองเคยผ่าน
// รีโปนี้มาแล้วเกือบทุกเจ้า** ทองรอบนี้คือ **#eeae12 / #fded41 / #9f600d** วัดจาก
// อาร์ตเวิร์กของดรอปนี้เอง ⚠️ **ไม่ใช่ e6a416 / fee45d / b8780d / 7a4e05 ของ
// ยูฟ้า168** ซึ่งเป็นเจ้าเดียวที่เดินทอง+เงินเหมือนรอบนี้ (e6a416 ห่าง #eeae12 แค่
// R8/G10/B4) ไม่ใช่ e5a81b / ffe08a / bb8410 ของ UFA324 ไม่ใช่ fef54b ของ นินจา168
// และไม่ใช่ fdcb0c / fefb6b / 8a6504 ของรอบขาออก สบาย168
// ไฟล์นี้เพิ่งถือชุด **ชมพูบานเย็น-พลัม ของมีทรัพย์168** มาทั้งใบ (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5 + rgba 221,27,116 + rgba 74,13,53) ก่อนนั้นเป็นชุด
// ทอง-ชมพูบานเย็นของมีโชค168 (fcd434 ff8dc6 f5469f 8c0f52 7a5508 f6e4ee 24101c
// 160a12 0b0509) ชุดแดงมังกร-ทองไทยของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f)
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f) ชุดทองมังกรของ TND168 และชุดชมพูฮอต-
// ทองของ PUNPRO168 (f41571 ff5ca8 fce343) — ถอดออกครบทุกค่าแล้ว เช่นเดียวกับชุดของ
// รอบขาออก **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff
// ccf7ff f2fbff dff4fd eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c 2a1f02)
// และ ufalion168 (d4922c fdfc71 f6e3b4 a25b24 5a3310)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู ไม่มีโรสโกลด์ และไม่มีแดง** (ยกเว้นสีประจำธนาคารใน bankPool ด้านบน
// และเขียว success ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#eeae12] bg-[#2f1e0f] px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#eeae12]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#9f600d]/55 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#f4ead6] via-[#fded41] to-[#e0e0df] bg-clip-text text-xl font-black text-transparent md:text-3xl">
        รายการในระบบสมาชิก {BRAND_NAME} ที่ตรวจสอบสถานะได้จากเว็บไซต์ทางการ
      </p>
      <p class="mt-2 text-base leading-relaxed text-[#d6c6a8]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้ใช้งาน</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#9f600d] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#2f1e0f] bg-[#eeae12] shadow-[0_0_10px_rgba(238,174,18,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#4e2f11]/90 to-transparent p-4 transition-colors hover:from-[#4e2f11]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#d6c6a8]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#e0e0df]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#fded41]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on the quiet secondary ink with a faded border — a waiting
     state painted in the brand's lead gold stops reading as a waiting state —
     and "verified" stays the semantic success green on every brand. */
  .winner-status.is-pending {
    color: #d6c6a8;
    border-color: color-mix(in oklab, #d6c6a8 45%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
