---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says the numbers are a sample
// of the row format, so no payout rate, prize figure or bank fact is asserted.
// The brief's own vocabulary is all this panel uses (ตรวจสอบเครดิต · ติดตามรายการ ·
// Login · บัญชีสมาชิก) and the brand name is interpolated from BRAND_NAME, never
// typed. The brief is a MIXED CASINO brief this round (บาคาร่า สล็อต รูเล็ต ไฮโล
// แทงบอล + คาสิโนไลฟ์สด), not PUNPRO168's slots-only one, so no wording about
// สล็อตปันโปร / เว็บเล่นสล็อตออนไลน์ / ทางเข้าเล่นใหม่ 2026 survives here.
//
// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12, brand-spec §2-§3):
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน PUNPRO168 ใช้ LatestWinners2 จึงหมุนมาที่ไฟล์นี้
// รอบนี้เป็น **ฮิวเดียวล้วน (ทอง) ไม่มีสีที่สองเลย** ต่างจาก FAH999 ที่เคยค้างอยู่
// ทั้งไฟล์นี้ซึ่งเป็นคู่ชมพูฮอต-ทอง จึงไม่มี "คู่สีของโลโก้" ให้แยกออร่าสองมุมอีก
// ออร่าถูกแยกด้วย **ค่า** แทน: ทองหลัก #dfa310 มุมขวาบน (เหรียญทองและริบบิ้นแสงทอง
// ในงานอาร์ต) กับบรอนซ์ลึก #43240b มุมซ้ายล่าง (เงาใต้กองเหรียญ)
// แผงคือผิวจม #070502 ในกรอบทองหลัก #dfa310 เส้นไทม์ไลน์เป็นบรอนซ์ลึก #43240b และ
// จุดบนเส้นเป็นทองหลัก #dfa310
// ยอดเงินรับทองสว่าง #ffe4a3 ไว้เป็นตัวเน้น (13.5:1) — กองเหรียญทองที่เรียงตลอดแนว
// ล่างของสไลด์คือสิ่งที่ตัวเลขเงินควรอ่านเป็น และทองสว่างให้คอนทราสต์สูงสุดในพาเลตต์
// บนผิวจม ต่างจากทองหลักที่เป็นสีของกรอบและจุดไทม์ไลน์
// แถวรายการวางบนผิวกลาง #120c04 และสว่างขึ้นเป็นผิวยก #1b1307 ตอน hover ชื่อยูสเซอร์
// เป็นสีเนื้อความ #f0e9dc ตัวรองใช้ #f0e9dc แบบลดความทึบ เพื่อไม่ต้องสร้างสีนอก
// พาเลตต์ขึ้นมาใหม่
// ป้ายสถานะยังคงสีเชิงความหมายไว้ (เทากลางระหว่างรอตรวจสอบ เขียวเมื่อโอนสำเร็จ) และถูก
// กำหนดใน <style> ด้านล่าง — §2 ระบุไว้ว่าสีเชิงความหมายไม่เข้าพาเลตต์สวีป
// §2 ห้าม #8a5c09 (2.9:1) และ #43240b ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งคู่อยู่ที่
// เส้นไทม์ไลน์ ขอบ และออร่าเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** ทองมาแล้วเก้าใน
// สิบเอ็ดรอบ: ชุดชมพูฮอต-ทองของ FAH999 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#ff3fa4 #ff6cbb
// #ffd1ea #fde8f3 #f5c53d #7a0046 #4a0b42 #3a0534 #210220) ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 รอบก่อน (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426
// #4a1038 #3a0a2a #1c0014) ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #6b0402
// #f5b61d #ffd87a #fdeedd) ชุดมรกต-ทองของ KOON234 (#cc920a #fde9a6 #8a6204 #2fbf6a
// #07170c) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a #f58b2a #f6ecd9
// #1f1709) และชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #cfd6e3 #241700)
// ออกครบทุกจุดแล้ว
// ⚠️ #f5c53d ของ FAH999 และ #f5b61d ของ PIGPG เป็นทองที่ตาเห็นว่าใกล้ #dfa310 ของ
// รอบนี้ที่สุด แต่ G=197 และ G=182 ไม่ใช่ G=163 — เทียบเป็นตัวเลขทีละค่า
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มี
// ส้มอำพัน และไม่มีแดงเลย** (ยกเว้นสีประจำธนาคารใน bankPool และสีสถานะเชิงความหมาย)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบประวัติรายการของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#dfa310] bg-[#070502]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.9)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#dfa310]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#43240b]/55 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#f0e9dc] via-[#c9b88e] to-[#dfa310] bg-clip-text text-xl font-black text-transparent md:text-3xl">ประวัติรายการของสมาชิก {BRAND_NAME} ที่ตรวจสอบได้จากบัญชีเดียว</p>
      <p class="mt-2 text-base leading-relaxed text-[#f0e9dc]/75">รายการด้านล่างเป็นข้อมูลตัวอย่างสำหรับแสดงรูปแบบรายการเท่านั้น ไม่ใช่ยอดจริงของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#43240b] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#070502] bg-[#dfa310] shadow-[0_0_10px_rgba(223,163,16,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#120c04]/90 to-transparent p-4 transition-colors hover:from-[#1b1307]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#f0e9dc]/75">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f0e9dc]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#ffe4a3]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="กำลังตรวจสอบ"
                data-done-text="โอนสำเร็จ"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "กำลังตรวจสอบ" : "โอนสำเร็จ"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on a neutral slate — a waiting state painted in the brand's
     own gold stops reading as a waiting state — and "verified" stays the
     semantic success green on every brand. */
  .winner-status.is-pending {
    color: #9ca3af;
    border-color: color-mix(in oklab, #9ca3af 55%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
