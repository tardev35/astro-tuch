---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §8).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️ บรีฟรอบนี้เป็น **เว็บเกมสล็อตล้วน** ที่ขาย "ช่องทางติดต่อผู้ให้บริการ" ไม่ใช่
// แบรนด์คาสิโน+กีฬาแบบสองรอบก่อน คำที่แผงนี้ใช้จึงมีแค่คำของบรีฟเอง: ตรวจสอบบัญชี ·
// ระบบสมาชิก · รายการ · ติดตามสถานะการแก้ไขปัญหา · 24 ชั่วโมง
// **ไม่มีคำว่า บาคาร่า ไฮโล บอล แทงบอล คาสิโน อัตราต่อรอง ไม่มีขั้นต่ำ หรือคำหมวด
// หวยที่ไหนเลย** (brand-spec §7) และชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ
//
// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2-§3):
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (GT66B) ใช้ LatestWinnersPremium จึงหมุนมาที่ไฟล์นี้
// รอบนี้เป็น **สองโทนจริง: แดงมังกรนำ ทองไทยรอง** โลโก้คือคำว่า "สมหวัง" สามมิติ
// โครเมียมขาวอมเงินขอบแดง ต่อด้วยเลข "168" แดงสด มีเปลวไฟแดงกับลายกนกไทยสีแดงพันรอบ
// งานอาร์ตเป็นฉากคาสิโนไทย-จีนพื้นดำ ผ้าซาตินแดงพลิ้ว ลายกนก/นาคทองไทยขนาบสองข้าง
// ⚠️ สีรองของระบบคือ **ทองจากลายกนก** ไม่ใช่โครเมียมในโลโก้ — §2 สั่งไว้ตรงๆ
// ⚠️ พื้นเพจเป็น **ดำอมแดง #290f0f** (bg.json) ลำดับความลึก: #2c1413 ยก / #1f0d0c
// กลาง / #140706 จม / #290f0f พื้น
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งแปดใบ: แผงคือผิวจม #140706 ในกรอบแดงแบรนด์ #fa0513 หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นทองลึก #8a6210 และจุดบนเส้นเป็นทองไทย #e3b23c
// (ลายกนกทอง) ที่มีออรา rgba(227,178,60,0.9)
// ออราสองมุมแยกด้วย **ค่า**: แดงแบรนด์ #fa0513 มุมขวาบน (เปลวไฟรอบเลข 168) กับ
// แดงมืด #3c0303 มุมซ้ายล่าง (เงาใต้กองชิป)
// หัวแผงไล่ ทองสว่าง #ffe5a8 → แดงสว่าง #ff5a5f → ทองไทย #e3b23c
// ตัวเลขยอดใช้แดงสว่าง #ff5a5f เป็นตัวเน้น (5.7:1 บนผิวยก และสูงกว่านั้นบนผิวจม)
// แถวรายการวางบนผิวกลาง #1f0d0c และสว่างขึ้นเป็นผิวยก #2c1413 ตอน hover ชื่อยูสเซอร์
// เป็นสีเนื้อความ #f4ecea (= BRAND_TEXT) ตัวรองเป็น #ccb9b6 (9.2:1)
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้ทั้งหกค่าอยู่ที่กรอบ เส้นไทม์ไลน์ และออราเท่านั้น และ #ffadaf สงวนไว้ให้
// <strong> ในเนื้อความของหน้า จึงไม่อยู่ในไฟล์นี้
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้ตัวรอง #ccb9b6
// (เงียบ ไม่ใช่สีนำ) และสถานะสำเร็จคงเขียว success ของทุกแบรนด์ไว้ — §8 ระบุว่าสีเชิง
// ความหมายไม่เข้าพาเลตต์สวีป ทั้งคู่เป็นคลาสใน <style> ด้านล่าง เพื่อให้
// src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตต์ของแบรนด์เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** ไฟล์นี้เพิ่งถือชุด
// น้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 มาทั้งไฟล์ (#0360f3 #0292fb #6ec8ff #4fb4ff
// #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f #032dad #04186e #041a43)
// และก่อนนั้นเป็นชุดทองมังกรของ TND168 กับชุดชมพูฮอต-ทองของ PUNPRO168 — ถอดออกครบ
// ทุกค่าแล้ว แดงของ GT66B คือ #fb141b (G=20) ของ TKB55 คือ #fb131b (G=19) ของ
// SUPERSLOTCLUB คือ #e8232a ของ PIGPG คือ #d4200d และของ FLASH877 คือ #ff3b14 —
// ไม่มีตัวไหนเป็น #fa0513 (R=250 G=5 B=19) ของรอบนี้
// ⚠️ ทองรอบนี้ #e3b23c / #ffe5a8 / #8a6210 ไม่ใช่ #dfa310 / #ffe4a3 / #8a5c09 ของ
// TND168 ที่ใกล้ที่สุด — ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
// ⚠️ **รอบนี้ไม่มีโครเมียม/เงิน ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม** (ยกเว้นสีประจำธนาคารใน bankPool ด้านบน และเขียว success ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#fa0513] bg-[#140706]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.9)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#fa0513]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#3c0303]/75 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#ffe5a8] via-[#ff5a5f] to-[#e3b23c] bg-clip-text text-xl font-black text-transparent md:text-3xl">
        รายการในระบบสมาชิก {BRAND_NAME} ที่ผู้เล่นตรวจสอบสถานะได้เอง
      </p>
      <p class="mt-2 text-base leading-relaxed text-[#ccb9b6]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้เล่น</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#8a6210] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#140706] bg-[#e3b23c] shadow-[0_0_10px_rgba(227,178,60,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#1f0d0c]/90 to-transparent p-4 transition-colors hover:from-[#2c1413]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#ccb9b6]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f4ecea]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#ff5a5f]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on the quiet warm-grey secondary — a waiting state painted in
     the brand's lead red stops reading as a waiting state — and "verified" stays
     the semantic success green on every brand. */
  .winner-status.is-pending {
    color: #ccb9b6;
    border-color: color-mix(in oklab, #ccb9b6 55%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
