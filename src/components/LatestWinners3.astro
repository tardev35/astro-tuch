---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says the numbers are a sample
// of the row format, so no payout rate, prize figure or bank fact is asserted.
//
// หวยเต็ง (รอบเขียวป่า-ทอง 2026-10-01): แผงคือพื้นเพจเขียวเกือบดำ #03150a ในกรอบ
// เขียวแบรนด์ลึก #024a0f เส้นไทม์ไลน์เป็นเขียวลึกเดียวกันและจุดบนเส้นเป็นทองแบรนด์
// #e5c04f ออร่าสองมุมแยกด้วยคู่สีโลโก้คือทองแบรนด์กับเขียวมรกตสว่าง #0bb42f ยอดเงิน
// รับทองแบรนด์ไว้เป็นตัวเน้นแบบคำว่า "เต็ง" บนโลโก้จริง แถวรายการวางบนผิวแผงยก
// เขียวกลาง #0b3d18 ป้ายสถานะยังคงสีเชิงความหมายไว้ (เทากลางระหว่างรอตรวจสอบ
// เขียวเมื่อโอนสำเร็จ) และถูกกำหนดใน <style> ด้านล่าง ชุดทอง-เขียวนีออนของ PGW44
// (#050803 #1f5a16 #fde90e #35d413 #101a0b #e9f0dd #fbffe8 #fff89a #f5c518)
// หายไปทั้งหมด
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ประวัติรายการถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#024a0f]/80 bg-[#03150a]/92 px-4 py-8 shadow-[0_10px_30px_rgba(229,192,79,0.18)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#e5c04f]/24 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#0bb42f]/16 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#fae474] via-[#e5c04f] to-[#0bb42f] bg-clip-text text-xl font-black text-transparent md:text-3xl">ประวัติรายการถอนของสมาชิก {BRAND_NAME} แบบเรียลไทม์</p>
      <p class="mt-2 text-base leading-relaxed text-[#d8ead9]">รายการด้านล่างเป็นข้อมูลตัวอย่างสำหรับแสดงรูปแบบรายการเท่านั้น ไม่ใช่ยอดจริงของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#024a0f]/80 pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#03150a] bg-[#e5c04f] shadow-[0_0_10px_rgba(229,192,79,0.85)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#0b3d18]/80 to-transparent p-4 transition-colors hover:from-[#0b3d18]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#d8ead9]/70">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#eafbe9]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#e5c04f]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="กำลังตรวจสอบ"
                data-done-text="โอนสำเร็จ"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "กำลังตรวจสอบ" : "โอนสำเร็จ"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on a neutral slate — a waiting state painted in the brand's
     own gold stops reading as a waiting state — and "verified" stays the
     semantic success green on every brand. */
  .winner-status.is-pending {
    color: #9ca3af;
    border-color: color-mix(in oklab, #9ca3af 55%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
