---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
// This brief is a MIXED CASINO + SPORTS brief (บาคาร่า · ไฮโล · สล็อต · แทงบอล ·
// ไม่มีขั้นต่ำ), and the only wording used here is its own: ยอดเดิมพัน ·
// บัญชีเดียว · ตรวจสอบ · รายการ. The brand name is interpolated from BRAND_NAME,
// never typed.
//
// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13, brand-spec §2):
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (แบรนด์ม่วง-ทองที่กำลังออก) ใช้ LatestWinnersCyber
// จึงหมุนมาที่ไฟล์นี้
// รอบนี้เป็น **สองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง ไม่มีทองที่ไหนเลย** โลโก้คือ
// ตัวอักษร TSDET สามมิติสีเงินโครเมียมขัดเงา ต่อด้วยเลข 911 น้ำเงินไฟฟ้า และปีกเหยี่ยว
// สีน้ำเงิน งานอาร์ตเป็นฉากสตูดิโอดำที่ส่องด้วยริบบิ้นแสงน้ำเงินกับแฟลร์เลนส์สีฟ้า
// ⚠️ พื้นเพจเป็นกรมเกือบดำ #00081f (bg.json) ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง /
// #040e26 จม / #00081f พื้น — ไม่มีชั้นไหนจมต่ำกว่าพื้นได้
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งแปดใบ: แผงคือผิวจม #040e26 ในกรอบน้ำเงินแบรนด์ #0360f3
// หนาสองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นน้ำเงินลึก #04186e และจุดบนเส้นเป็นฟ้าสด
// #0292fb (ริบบิ้นแสงและแฟลร์ในงานอาร์ต) ที่มีออรา rgba(2,146,251,0.9)
// ออราสองมุมแยกด้วย **ค่า**: ฟ้าสด #0292fb มุมขวาบน (แฟลร์เลนส์) กับน้ำเงินลึกสุด
// #041a43 มุมซ้ายล่าง (เงาใต้กองชิป)
// หัวข้อไล่ เงินโครเมียมสว่าง #cfdcec → ฟ้าสว่าง #6ec8ff → ฟ้าอ่อน #4fb4ff ซึ่งเป็น
// ลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ตัวเลขยอดใช้ฟ้าสว่าง #6ec8ff เป็นตัวเน้น (7.4:1 บนผิวยก และสูงกว่านั้นบนผิวจม) —
// ริบบิ้นแสงน้ำเงินคือสิ่งที่ตัวเลขควรอ่านเป็นรอบนี้ ต่างจากน้ำเงินแบรนด์ที่เป็นสีของ
// กรอบ และฟ้าสดที่เป็นสีของจุดไทม์ไลน์
// แถวรายการวางบนผิวกลาง #0a1c42 และสว่างขึ้นเป็นผิวยก #102a5e ตอน hover ชื่อยูสเซอร์
// เป็นสีเนื้อความ #dde8f7 (= BRAND_TEXT) ตัวรองเป็นเงินโครเมียมหม่น #9db4d4 (~6:1)
// §2 ห้าม #0360f3 #0292fb #032dad #04186e #041a43 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งห้า
// ค่าอยู่ที่กรอบ เส้นไทม์ไลน์ จุด และออราเท่านั้น
// ป้ายสถานะยังแยก "รอตรวจสอบ vs สำเร็จ" ด้วยความหมาย: สถานะรอใช้เงินโครเมียมหม่น
// #9db4d4 (เงียบ ไม่ใช่สีนำ) และสถานะสำเร็จคงเขียว success ของทุกแบรนด์ไว้ — §2 ระบุว่า
// สีเชิงความหมายไม่เข้าพาเลตต์สวีป ทั้งคู่ถูกกำหนดเป็นคลาสใน <style> ด้านล่าง เพื่อให้
// src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตต์ของแบรนด์เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักของไฟล์นี้คือทอง** ไฟล์นี้เพิ่งถือ
// ชุดทองมังกรบนดำสนิทมาทั้งไฟล์ (ทองหลัก + ทองสว่างที่ตัวเลขเงิน + บรอนซ์ลึกที่เส้น
// ไทม์ไลน์ + เนื้อความครีม) และก่อนนั้นเป็นชุดชมพูฮอต-ทอง — ถอดออกครบทุกค่าแล้ว
// **รอบนี้ไม่มีทอง ไม่มีชมพู ไม่มีม่วง ไม่มีส้ม/อำพัน และไม่มีแดงเลย** (ยกเว้นสีประจำ
// ธนาคารใน bankPool ด้านบน และเขียว success เชิงความหมายใน <style>)
// ⚠️ ฟ้า false friend ที่ใกล้ที่สุดในประวัติโค้ดเบสคือฟ้าสดของแบรนด์ "แตกดี168"
// (R=1 G=147 B=251) ซึ่งไม่ใช่ #0292fb (R=2 G=146 B=251) ของรอบนี้ และเงินโครเมียม
// #cfdcec / #9db4d4 รอบนี้ไม่ใช่เทาอมฟ้าของแบรนด์เงินโครเมียมรอบก่อนๆ — เทียบเป็น
// ตัวเลขทีละค่า ห้ามกะด้วยตา
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในบัญชีสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#0360f3] bg-[#040e26]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.9)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#0292fb]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#041a43]/75 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#cfdcec] via-[#6ec8ff] to-[#4fb4ff] bg-clip-text text-xl font-black text-transparent md:text-3xl">รายการในบัญชีสมาชิก {BRAND_NAME} ที่ตรวจสอบได้จากบัญชีเดียว</p>
      <p class="mt-2 text-base leading-relaxed text-[#9db4d4]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#04186e] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#040e26] bg-[#0292fb] shadow-[0_0_10px_rgba(2,146,251,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#0a1c42]/90 to-transparent p-4 transition-colors hover:from-[#102a5e]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#9db4d4]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#dde8f7]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#6ec8ff]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on the quiet chrome-silver secondary — a waiting state
     painted in the brand's lead blue stops reading as a waiting state — and
     "verified" stays the semantic success green on every brand. */
  .winner-status.is-pending {
    color: #9db4d4;
    border-color: color-mix(in oklab, #9db4d4 55%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
