---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §2
// exempts colours that carry their own meaning: LINE green, live dots and real
// bank logos).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical. **ห้าม Math.random() / Date.now() / new Date()
// ใน frontmatter ของไฟล์นี้ — verify-build ทำให้ build แดง**
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️⚠️ บรีฟรอบนี้เป็น **เว็บหวย/ลอตโต้ ไม่ใช่เว็บสล็อต** (กลับทิศจากรอบก่อน) และ
// พูดถึง หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ · จ่ายเต็ม จ่ายสด ·
// รับทุกเลข ไม่มีอั้นเลข · อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 · สมัครด้วยมือถือ
// 3 ขั้นตอน · แอดมินออนไลน์ 24ชม. คำที่แผงนี้ใช้จึงมีแค่คำกลางของบรีฟ:
// สมาชิก · รายการ · ธุรกรรม · ตรวจสอบ · เว็บไซต์ทางการ · ผู้ใช้งาน
// **ไม่มีคำว่า อัตราจ่าย เลขเด็ด งวด จ่ายจริง การันตี หรือคำหมวดสล็อต (สล็อต ·
// ค่ายเกม · ฟรีสปิน · เกมโบนัส · ค่า RTP · คืนยอดเสีย · แนะนำเพื่อน) ที่ไหนเลย**
// (brand-spec §5) และ §5 ยังห้ามคำของแบรนด์ก่อน (ZNOVA168 · ZOLO99 ·
// สล็อต1บาททรูวอลเลท · ฝากถอนธนาคารและวอลเลท · เบทเริ่มต้น1บาท · ZANE96 ·
// MEXICANOSLOT · okkub88 · รวย168 · แทงหวยเว็บรวย · บาทละ 1,000 · 888PARUAY ·
// JEDI66 · LOTTOPLUS · หวยเต็ง) ซึ่งไม่เหลือในไฟล์นี้
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ และ **ไม่มีตัวเลขที่บรีฟไม่ได้ให้**
// (ยอดในแถวเป็นตัวอย่างรูปแบบการแสดงผล และบรรทัดใต้หัวแผงบอกไว้ตรง ๆ ว่าไม่ใช่
// ยอดจริงของผู้ใช้งาน) · **ไม่มี 0.3% / 0.8% ที่ไหนในไฟล์นี้** (brand-spec §5
// อนุญาตสองค่านั้นเฉพาะใน alt ของสไลด์เท่านั้น)
//
// ───────────────────────────────────────────────────────────────────────────
// LOTTO189 (ดรอป 2026-10-27) — พาเลตตาม .claude/brand-spec-lotto189.md §2
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (ZNOVA168) ใช้ LatestWinnersCyber จึงหมุนมาที่
// ไฟล์นี้ และไฟล์นี้ยังถือ **ฟ้าสกายบนธีมสว่างของ โบ๊ะบ๊ะ168** ทั้งใบ จึงรีเธมทั้งไฟล์
// ⚠️⚠️ **รอบนี้เป็นธีมเนื้อหาสว่าง และแผงนี้อยู่ใน "โซนเนื้อหา" ไม่ใช่โครมสีเข้ม** —
// §2 สงวนผิวโครมเข้ม (#24060c / #3d0d16 / #120307 / #7e1221 / #ffeaea) ไว้ให้
// navbar/footer/ticker/overlay/แถบมือถือ ส่วนแผงนี้ถูกวาง **หลัง §8 ปลายสายเนื้อหา**
// คู่กับการ์ดรีวิว จึงต้องอ่านต่อเนื่องกับกล่องเนื้อหาสว่างที่อยู่เหนือมัน
// **ห้าม "แก้" ให้เป็นแผงพื้นมืด** — ถ้าทำ หมึก #25090f ของแถวจะหายไปเลย ไม่ใช่
// แค่จางลง
// พื้นเพจ #fff0f0 (bg.json = ขาวอมชมพูจาง) ลำดับผิวที่ใช้ในไฟล์นี้: #ffffff การ์ด
// (แถวรายการ) / **#ffe4e6 ยก (ตัวแผง)** / #ffd4d7 wash / #fff0f0 พื้นเพจ
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งหกใบ: แผงคือผิวยก #ffe4e6 ในกรอบเส้นเข้ม #a8333f หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นเส้นอ่อน #f5b9bd และจุดบนเส้นเป็นแดงแบรนด์
// #c1071b ที่มีออรา rgba(193,7,27,0.45)
// ⚠️ **§2 ห้าม #ff2436 (3.9:1 บนขาว) #e9b53c #f5b9bd #ffd4d7 #ffe4e6 #c3ccd6
// ถือตัวอักษรบนผิวสว่างเด็ดขาด** ในไฟล์นี้มันจึงอยู่ที่กรอบแผง ออรา และรางไทม์ไลน์
// เท่านั้น **ไม่มีกลีฟไหนเป็นสีพวกนี้เลย** เช่นเดียวกับ #a8333f ที่เป็น **เส้น** เท่านั้น
// หัวแผงเป็น **แดงเลือดนก #b00718 ทึบสีเดียว** (6.8:1 บนผิวยก) — ⚠️ **ตั้งใจไม่ใช้
// bg-clip-text ที่นี่** เพราะ §8 (Faq2) เป็นใบเดียวบนหน้าที่ถือหัวข้อไล่เฉดสองสต็อป
// และ §1/§4/§5 ถือไล่เฉดสามสต็อป ถ้าแผงนี้ไล่เฉดด้วยก็จะอ่านซ้ำกันทันที
// ตัวเลขยอดเป็น **แดงลึก #8a0412** (10.4:1 บนแถวขาว) ซึ่ง §2 อนุญาตให้ถือตัวอักษร
// ได้เต็มที่ — ต่างจากแดงสดที่ถือไม่ได้ ชื่อยูสเซอร์เป็นหมึกหลัก #25090f (18.7:1)
// ป้ายกำกับเป็นหมึกรอง #6e3b44 (8.8:1 บนขาว · 8.0:1 บนผิวยก)
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้หมึกรอง
// #6e3b44 แบบกรอบจาง (เงียบ ไม่ใช่สีแบรนด์ — สถานะรอที่ถูกทาด้วยฮิวนำจะหยุดอ่าน
// เป็นสถานะรอ) และสถานะสำเร็จคงเขียว success ไว้ ทั้งคู่เป็นคลาสใน <style>
// ด้านล่าง เพื่อให้ src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตของแบรนด์เลย
// ⚠️⚠️ **เขียว success เป็นสีเชิงความหมาย ไม่ใช่สีของแบรนด์ไหน — ห้ามเปลี่ยนฮิว
// ของมันไปเป็นแดงของแบรนด์ และห้ามแตะ LINE green #00B900** ค่า oklch(52.7% …)
// ถูกเลือกไว้สำหรับ **แถวพื้นขาว** อยู่แล้ว (ราว 4.8:1) รอบนี้แถวก็ยังขาว จึงคงค่าเดิม
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) · rgba(138,4,18,α) ·
// rgba(255,36,54,α) · rgba(168,51,63,α) · rgba(37,9,15,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง/ทอง/ครีม เพราะเคย
// นำมาแล้วสิบกว่าเจ้าในรีโปนี้** แดงรอบนี้คือ **#b00718 / #c1071b / #8a0412 /
// #d61023 / #ff2436** วัดจาก palette.json (vivid ของ logo.webp = c40203 a40303
// 8c0103 bc0203 9d0202 = แดงเลือดนกล้วน) แล้วแปลงให้ถือตัวอักษรได้ตาม §2
// ⚠️⚠️ **ฟ้าของ โบ๊ะบ๊ะ168 ที่เพิ่งอยู่ทั้งใบนี้ต้องไม่เหลือเลยสักค่า**: 00bfff
// 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb 355f7d
// 0f5684 1a6ea8 + rgba(18,180,239,α) rgba(182,227,240,α) rgba(15,86,132,α)
// rgba(6,40,63,α) rgba(127,203,232,α)
// ⚠️⚠️ **ZNOVA168 แบรนด์ขาออกทันที (ส้ม/ทอง/ครีม = ตระกูลเดียวกับรอบนี้ เสี่ยง
// หลงเหลือสูงสุด)**: 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784 fffbf0
// fff4e0 ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 fde90b
// e8a000 ff8a2b d8dde6 8f9aa8 6a4a30
// 🚨 คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ: b8300a / c23400 / 9a2a00 และ a81410 /
// c81e12 / 9d140c (MEXICANOSLOT) ↔ #b00718 / #c1071b / #8a0412 · de2b1e / d13800
// ↔ #d61023 · fa4903 ↔ #ff2436 · 2a1206 / 3f130d ↔ #25090f · fffbf0 / fde4d3 /
// fff3ea ↔ #fff0f0 / #ffe4e6 / #ffd4d7 · f3d9a8 / e8c6ae / f6c4a4 ↔ #f5b9bd
// ⚠️ ชุดอื่นที่เคยอยู่ในไฟล์นี้และต้องไม่เหลือ: **พักยก168** (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 2f1e0f 1f0f04 4e2f11 3a2713 32200f
// 1f1308) · **หมูบิน168** (fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd
// ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463) · **มีทรัพย์168**
// (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) · **มีโชค168** (fcd434 ff8dc6 f5469f
// 8c0f52 7a5508) · **สมหวัง168** (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203
// 8c0204 5b0203 3c0303) · **TSDET911** (cfdcec 9db4d4 dde8f7 102a5e 0a1c42) ·
// **PUNPRO168** (f41571 ff5ca8 fce343) · **สบาย168** (04293d 0a4f74 9ae0fa fdcb0c
// fefb6b 8a6504) · **ufalion168** (d4922c fdfc71 f6e3b4 a25b24) · **สล็อต168**
// (fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 140000 1c0607 2a0c0d 551c1e) ·
// **แบรนด์หวยเก่า** (cf1111 e01f26 1fae1c 0d2312 143a1c 07130a e8e4c6 fcdc2b
// fff6ae a87d0c) · **รวย168** (ffd94a e3a712 9d6f06 e8eaee f3ece0 121110 070707)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองในไฟล์นี้ ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/ฟูเชีย
// ไม่มีม่วง/ไวโอเลต ไม่มีเขียวแบรนด์ ไม่มีส้ม ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล
// และไม่มีแรมป์เทาเงิน** (ยกเว้นสีประจำธนาคารใน bankPool ด้านบน และเขียว success
// ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#a8333f] bg-[#ffe4e6] px-4 py-8 shadow-[0_10px_30px_rgba(138,4,18,0.14)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#ff2436]/20 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#ffd4d7] blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="text-xl font-black text-[#b00718] md:text-3xl">รายการในระบบสมาชิก {BRAND_NAME} ที่ตรวจสอบสถานะได้จากเว็บไซต์ทางการ</p>
      <p class="mt-2 text-base leading-relaxed text-[#6e3b44]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้ใช้งาน</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#f5b9bd] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#ffe4e6] bg-[#c1071b] shadow-[0_0_10px_rgba(193,7,27,0.45)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] border border-[#f5b9bd] bg-gradient-to-r from-white to-[#ffe4e6] p-4 transition-colors hover:to-white">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#6e3b44]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#25090f]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#8a0412]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-status.is-pending {
    color: #6e3b44;
    border-color: color-mix(in oklab, #6e3b44 45%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(52.7% 0.154 150.069);
    border-color: color-mix(in oklab, oklch(62.7% 0.194 149.214) 55%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
