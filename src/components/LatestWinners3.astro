---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

// The bg-[#...] values here are the banks' own brand colours and stay put
// through every rebrand — they are not part of the palette swap (brand-spec §2
// exempts colours that carry their own meaning: LINE green, live dots and real
// bank logos).
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// This component must never go back to a `<script define:vars={{ bankPool }}>`:
// define:vars forces is:inline, which strips type/async/defer and leaves a
// parser-blocking script three quarters of the way down the document —
// tools/verify-build.mjs fails the build on it. The rows are server-rendered
// here, the bank list travels as inert JSON below, and src/lib/winnersFeed.ts
// (shared with every other LatestWinners* variant, and selector-driven so it
// needs no changes) takes over the rotation with on-screen, hidden-tab and
// reduced-motion guards. Every data-* hook below is part of that contract.
//
// The values come from the brand's own domain hash, NOT Math.random(): a
// Math.random() in frontmatter runs at BUILD time, so every deploy would churn
// the live site's markup for nothing. brandPick()/brandFlag() make two builds of
// the same domain byte-identical.
//
// The block title is a <p> and the <section> carries an aria-label — a live
// transaction feed is chrome and never emits a heading tag at any level. The
// sub-line claims nothing the brief does not: it says outright that the rows are
// a sample of the row FORMAT, so no payout rate, prize figure, minimum stake or
// bank fact is asserted anywhere in this panel. No bank is named in any visible
// string either — the pool travels as inert JSON for the badge colour/logo only.
//
// ⚠️ บรีฟรอบนี้ขาย **"ระบบดูแลการเงิน — ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า"** คำที่
// แผงนี้ใช้จึงมีแค่คำของบรีฟเอง: สมาชิก · ฝากถอน · ธุรกรรม · สถานะธุรกรรม ·
// เจ้าหน้าที่ · เว็บไซต์ทางการ · ตรวจสอบ
// **ไม่มีคำว่า คาสิโน บาคาร่า เว็บตรง ไม่ผ่านเอเย่นต์ ไม่มีขั้นต่ำ จ่ายจริง การันตี
// แตกง่าย หรือคำหมวดหวยที่ไหนเลย** (brand-spec §6) และ §6 ยังห้ามคำของแบรนด์ก่อน
// (เว็บสอนเล่นเกมออนไลน์ · จากเศรษฐีพนันมือ1 · สอนเล่น · ผู้สอน · บทเรียน · หลักสูตร ·
// สูตร · เทคนิค · บาคาร่า · 3 ขั้นตอน) ซึ่งไม่เหลือในไฟล์นี้แล้ว
// ชื่อแบรนด์ interpolate จาก BRAND_NAME เสมอ และไม่มีตัวเลขที่บรีฟไม่ได้ให้
//
// มีทรัพย์168 (2026-10-21) — พาเลตตาม .claude/brand-spec-meesub168.md §2–§3
// ฟีดที่ใช้งานจริงรอบนี้ — รอบก่อน (ดวงเศรษฐี168) ใช้ LatestWinners2 จึงหมุนมาที่
// ไฟล์นี้ ซึ่งว่างมาแล้วไม่น้อยกว่า 8 รอบ
// ⚠️⚠️ **รอบนี้เป็นธีมสว่างแบรนด์แรกของรีโปนี้ แต่ไฟล์นี้คือ "โครม" ไม่ใช่เนื้อหา** —
// brand-spec §2 แยกไว้ชัด: ทุก `ContentBox*` / `Faq*` / review card เป็นผิวสว่าง
// หมึกเข้ม ส่วน `Navbar* Footer* Announcement* LatestWinners* BankStrip CtaRedirect`
// **ยังเป็นพลัมเข้มตัวอักษรสว่าง** หัว-ท้ายเข้มคร่อมเนื้อหาสว่างคือกรอบที่อ่านง่าย
// **ห้าม "แก้" แผงนี้ให้กลายเป็นผิวขาวตามการ์ดเนื้อหา**
// พื้นเพจ #f0ccf5 (bg.json) ลำดับผิวของโครม: #4a0d35 ยก (แถวรายการ) /
// #2d0720 จม (ตัวแผง)
//
// ไฟล์นี้เป็นก้อนเดียวบนหน้าที่เป็น **ไทม์ไลน์** (รางตั้งซ้าย + จุดบนเส้น) จึงไม่ซ้ำ
// รูปทรงกับกล่องเนื้อหาทั้งแปดใบ: แผงคือผิวจม #2d0720 ในกรอบชมพูบานเย็น #dd1b74 หนา
// สองพิกเซล มุม 30px เส้นไทม์ไลน์เป็นโรสเข้ม #a4186b และจุดบนเส้นเป็นชมพูบานเย็น
// #dd1b74 (เหรียญชมพูในงานศิลป์) ที่มีออรา rgba(221,27,116,0.9)
// ออราสองมุมแยกด้วย **ค่า**: ชมพูบานเย็น #dd1b74 มุมขวาบน กับโรสเข้ม #a4186b มุมซ้ายล่าง
// ⚠️ **§2 ห้าม #dd1b74 ถือตัวอักษรบนพื้นเข้มเด็ดขาด (3.2:1)** ในไฟล์นี้มันจึงอยู่ที่
// กรอบ จุดไทม์ไลน์ และออราเท่านั้น ไม่มีกลีฟไหนเป็นสีนี้เลย
// หัวแผงไล่ ขาว #ffffff → พื้นเพจ #f0ccf5 → ชมพูอ่อน #f7dcf6 ซึ่งทั้งสามค่าอยู่ที่
// 12.6:1 ขึ้นไปบนผิวจม #2d0720 ⚠️ bg-clip-text = พิกเซลของตัวอักษร จึงเอาเฉพาะค่า
// ที่ §2 ให้ถือตัวอักษรบนโครมได้
// ตัวเลขยอดเป็น **ขาวทึบ** #ffffff (ไม่ใช่ชมพู) เพราะ §2 กำหนดว่าถ้าอยากได้ตัวอักษร
// ที่อ่านว่าชมพูสดบนพื้นเข้ม ต้องถม #dd1b74 เป็นพื้นแล้ววางขาวทับ ไม่ใช่ทาชมพูลงบน
// ตัวอักษร ชื่อยูสเซอร์เป็นชมพูอ่อน #f7dcf6 ป้ายกำกับเป็นพื้นเพจ #f0ccf5
// ป้ายสถานะยังแยก "รอตรวจสอบ vs ตรวจสอบแล้ว" ด้วยความหมาย: สถานะรอใช้สีเนื้อความ
// สว่าง #f0ccf5 แบบกรอบจาง (เงียบ ไม่ใช่สีแบรนด์ — สถานะรอที่ถูกทาด้วยฮิวนำจะหยุด
// อ่านเป็นสถานะรอ) และสถานะสำเร็จคงเขียว success ของทุกแบรนด์ไว้ ทั้งคู่เป็นคลาสใน
// <style> ด้านล่าง เพื่อให้ src/lib/winnersFeed.ts ไม่ต้องรู้พาเลตของแบรนด์เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือชมพู เพราะชมพูเคยนำมาแล้ว
// สามแบรนด์** (ถอนชัวร์168 fa63b9 · มีโชค168 f5469f · มีเฮ168 ff8f9c) ไฟล์นี้เพิ่ง
// ถือชุด **ทอง-ชมพูบานเย็น-พลัม ของมีโชค168** มาทั้งใบ (fcd434 ff8dc6 f5469f 8c0f52
// 7a5508 f6e4ee 24101c 160a12 0b0509 + rgba 252,212,52) ก่อนนั้นเป็นชุดแดงมังกร-
// ทองไทยของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203
// 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ
// TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26
// 00081f 032dad 04186e 041a43) ชุดทองมังกรของ TND168 และชุดชมพูฮอต-ทองของ PUNPRO168
// (f41571 ff5ca8 fce343) — ถอดออกครบทุกค่าแล้ว
// ⚠️ ชมพูรอบนี้คือ **#dd1b74 / #a4186b** ไม่ใช่ f5469f / ff8dc6 / 8c0f52 ของมีโชค168
// (ตัวที่ใกล้ที่สุด ห่าง 65) ไม่ใช่ fa63b9 / ffb3de ของถอนชัวร์168 และไม่ใช่โรสโกลด์
// f2bba5 / c98a74 ของขวัญใจ168 — เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
// ชุดของ ดวงเศรษฐี168 รอบขาออก (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605
// 150303 000000) และ ufalion168 (d4922c fdfc71 f6e3b4 a25b24 5a3310) ก็ไม่เหลือ
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีทอง/เหลือง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีแดง** (ยกเว้นสีประจำธนาคาร
// ใน bankPool ด้านบน และเขียว success ใน <style>)
const AMOUNT_MIN = 15000;
const AMOUNT_MAX = 95000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={`ตัวอย่างรูปแบบรายการในระบบสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#dd1b74] bg-[#2d0720] px-4 py-8 shadow-[0_10px_30px_rgba(74,13,53,0.45)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#dd1b74]/35 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#a4186b]/55 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-white via-[#f0ccf5] to-[#f7dcf6] bg-clip-text text-xl font-black text-transparent md:text-3xl">
        รายการในระบบสมาชิก {BRAND_NAME} ที่ตรวจสอบสถานะได้จากเว็บไซต์ทางการ
      </p>
      <p class="mt-2 text-base leading-relaxed text-[#f0ccf5]">แถวด้านล่างเป็นข้อมูลตัวอย่างเพื่อแสดงรูปแบบการแสดงรายการเท่านั้น ไม่ใช่ยอดจริงของผู้ใช้งาน</p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#a4186b] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#2d0720] bg-[#dd1b74] shadow-[0_0_10px_rgba(221,27,116,0.9)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#4a0d35]/90 to-transparent p-4 transition-colors hover:from-[#4a0d35]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#f0ccf5]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f7dcf6]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-white">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="อยู่ระหว่างตรวจสอบ"
                data-done-text="ตรวจสอบแล้ว"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "อยู่ระหว่างตรวจสอบ" : "ตรวจสอบแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // Not `define:vars` — that forces is:inline, which strips type/async/defer and
  // leaves a parser-blocking script in the middle of the document. The bank list
  // arrives as inert JSON above instead, and this module is bundled and deferred
  // like any other.
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* The two status colours are classes rather than inline strings so the JS in
     src/lib/winnersFeed.ts never has to know what this brand's palette is.
     "pending" runs on the quiet light body colour with a faded border — a
     waiting state painted in the brand's lead pink stops reading as a waiting
     state, and brand-spec §2 bars #dd1b74 from carrying text on dark chrome
     anyway — and "verified" stays the semantic success green on every brand. */
  .winner-status.is-pending {
    color: #f0ccf5;
    border-color: color-mix(in oklab, #f0ccf5 45%, transparent);
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
