---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// The logo <Picture> below carries widths + sizes on purpose. Without them
// Astro has no reason to resize and ships the source file — 1024x481, 73,938
// bytes on this brand — into a box drawn about 110x50. Three candidates cover
// 1x/2x/3x. (The note is here because the tag sits in a ternary branch, where a
// {/* comment */} beside it makes the branch two expressions and fails the
// build with "Expected ) but found $$render".)
//
// ONE links array, read by both the desktop bar and the mobile drawer. This
// file used to declare the menu twice, which is how one copy drifts from the
// other. Order: หน้าแรก first, then โปรโมชั่น, then the two conversion actions
// (สมัครสมาชิก / เข้าสู่ระบบ), then the informational pages.
//
// No /ทางเข้า entry: the cta toggle is on for this brand, so เข้าสู่ระบบ and
// สมัครสมาชิก are menu items in their own right and that page would be a third
// link to the same two destinations. The page stays routed and indexed.
//
// No /ตรวจหวย or /แนวทาง either — CASINO888 is a casino brand, so both lottery
// pages stay parked in src/pages-disabled/ and must not be linked from here.
//
// The desktop bar switches on at xl, not lg: seven items with icons plus the
// pair of CTA buttons does not fit a 1024 px row without crushing the labels.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "♠️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#e4c25a]/45 bg-[#050403]/95 px-4 shadow-[0_5px_20px_rgba(5,4,3,0.85)] backdrop-blur-lg xl:px-6">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ CASINO888 ตัวอักษร CASINO สีทองเมทัลลิกวางอยู่บนเลข 888 สีเงินโครเมียม"
            loading="eager"
            fetchpriority="high"
            widths={[110, 220, 330]}
            sizes="110px"
            height={50}
            class="h-[40px] w-auto object-contain drop-shadow-[0_0_12px_rgba(228,194,90,0.5)] xl:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <p class="text-3xl font-black tracking-widest text-[#fdf49c]">
            CASINO<span class="text-[#c9c9c9]">888</span>
          </p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-3 xl:flex 2xl:gap-5">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-2 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#fdf49c]" : "text-[#e9ddc4]/85 hover:text-[#fff8dd]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-md bg-gradient-to-r from-[#6b5216] via-[#b28a2a] to-[#fdf49c] shadow-[0_-2px_10px_rgba(228,194,90,0.75)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-3">
      <a
        href="/login"
        class="hidden rounded-full border border-[#c9c9c9]/50 bg-[#17120a]/80 px-6 py-2.5 text-sm font-bold text-[#f0e6cc] shadow-inner transition-all hover:border-[#c9c9c9] hover:bg-[#221a0d]/90 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full border border-[#fdf49c]/50 bg-gradient-to-r from-[#fdf49c] to-[#b28a2a] px-6 py-2.5 text-sm font-black text-[#1a1206] shadow-[0_4px_15px_rgba(228,194,90,0.4)] transition-all hover:scale-105 hover:shadow-[0_6px_20px_rgba(228,194,90,0.6)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#e4c25a]/55 bg-[#17120a] xl:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#fdf49c] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#fdf49c] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#fdf49c] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b-2 border-[#e4c25a] bg-[#050403]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 xl:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3 text-base font-bold transition-colors ${isActive(item.path) ? "border-l-4 border-[#e4c25a] bg-[#17120a] text-[#fdf49c]" : "text-[#e9ddc4]/80 hover:bg-white/5 hover:text-[#fff8dd]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full border border-[#fdf49c]/50 bg-gradient-to-r from-[#fdf49c] to-[#b28a2a] py-3.5 text-lg font-black text-[#1a1206] shadow-md">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#c9c9c9]/50 bg-[#17120a]/80 py-3.5 text-lg font-bold text-[#f0e6cc]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
