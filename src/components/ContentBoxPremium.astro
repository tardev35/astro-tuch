---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// HERO1688 palette: near-black base (#1a0509 -> #04060d) inside a deep-red
// border (#7d0507 / #e11015) with a red heading gradient
// (#ff5a5d -> #e11015 -> #7d0507). The two aura blooms are deliberately
// two-tone — red top-left, chrome silver bottom-right — so the card carries the
// logo's red-and-silver pairing rather than a single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7d0507]/70 bg-gradient-to-br from-[#1a0509]/92 to-[#04060d]/94 p-8 text-left text-base leading-relaxed text-[#dbe1ea] shadow-[0_10px_30px_rgba(1,2,7,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11015]/80 hover:shadow-[0_15px_40px_rgba(225,16,21,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e11015]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#ff2d2d]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c4c5ca]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#e3e7ec]/24">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7d0507]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5a5d] via-[#e11015] to-[#7d0507] shadow-[0_0_10px_rgba(225,16,21,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ff5a5d] via-[#e11015] to-[#7d0507] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
