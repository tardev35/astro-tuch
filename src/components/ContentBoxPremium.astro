---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// YADOM168 palette: near-black green base (#0a1c0a -> #020602) inside a deep
// green border (#0f3d0d / #5cc23f) with a green heading gradient
// (#8fe06f -> #5cc23f -> #1d6b18). The two aura blooms are deliberately
// two-tone — green top-left, coin gold bottom-right — so the card carries the
// artwork's green-and-gold pairing rather than a single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0f3d0d]/70 bg-gradient-to-br from-[#0a1c0a]/92 to-[#020602]/94 p-8 text-left text-base leading-relaxed text-[#d4e8cb] shadow-[0_10px_30px_rgba(2,8,3,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#5cc23f]/80 hover:shadow-[0_15px_40px_rgba(92,194,63,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#5cc23f]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#8fe06f]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e6bd5c]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#e6bd5c]/24">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0f3d0d]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] shadow-[0_0_10px_rgba(92,194,63,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#8fe06f] via-[#5cc23f] to-[#1d6b18] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
