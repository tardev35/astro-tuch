---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b5316]/60 bg-gradient-to-br from-[#241a08]/92 to-[#050403]/94 p-8 text-left text-base leading-relaxed text-[#e6dcc2] shadow-[0_10px_30px_rgba(5,4,3,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3db5b]/85 hover:shadow-[0_15px_40px_rgba(243,219,91,0.32)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a37c14]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#f3db5b]/36"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d8dce2]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#d8dce2]/32"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b5316]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff3bf] via-[#f3db5b] to-[#a37c14] shadow-[0_0_10px_rgba(243,219,91,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
