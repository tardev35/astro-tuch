---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอป 2026-10-23 **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน**
// (banner2.png mtime 10-08 / banner3.png 09-27 เป็นของแบรนด์ก่อน และ eager import
// = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (2026-10-23) — พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ **รอบนี้เป็น "ธีมสว่าง" กลับทิศจากรอบก่อน (เงินทอง168) 180 องศา**
// bg.json ของดรอปนี้คือ {"mode":"color","color":"#dbe6ff"} = ฟ้าเพอริวิงเคิลอ่อน
// และ bg.json คือแหล่งเดียวของพื้นเพจ **ห้าม "แก้" การ์ดกลับไปเป็นผิวน้ำตาลเข้ม
// เพราะรอบก่อนเป็นแบบนั้น** — รอบนี้เนื้อหา = ผิวสว่าง + หมึกเข้ม ส่วนโครม
// (navbar / footer / ticker / winners feed / Navfoot) ต่างหากที่เป็นน้ำเงินอินดิโกเข้ม
// ลำดับผิว: **#ffffff ยก (การ์ดใบนี้)** · #eef4ff กลาง · #dce9fb อินเซ็ต ·
// #f4e4d3 ครีม (วัสดุที่สอง) · #dbe6ff พื้นเพจ
//
// บทบาทสีในไฟล์นี้:
//   ฟ้าเข้ม #0d6b9b + ฟ้าลึก #0a5176 = แผ่นถมหัวข้อ (สูตร "ปุ่ม CTA หลัก" ของ §2
//     ตรงๆ) บนหมึก **#ffffff** (5.6:1 ที่สต็อปอ่อนสุด · 8.0:1 ที่สต็อปเข้ม)
//   ฟ้าไซยาน #18a5e2 = ขอบตอน hover · ออรา · ต้นเส้นใต้หัวข้อ
//     ⚠️⚠️ **2.6:1 บนขาว — ห้ามถือตัวอักษรบนผิวสว่างเด็ดขาด** ในไฟล์นี้จึงอยู่ที่
//     เส้น/ขอบ/ชั้นเบลอล้วน ไม่มีกลีฟวางทับสักตัว
//   ฟ้าอ่อน #a9d7f2 = ขอบการ์ดปกติ · กลางของเส้นใต้หัวข้อ (พื้นถม ไม่ใช่ตัวอักษร)
//   ครีม #f4e4d3 = ออรามุมขวาล่าง (วัสดุที่สองของรอบนี้ วัดจาก slide1.png)
//   หมึก #16294a = เนื้อความ (= BRAND_TEXT) 13.9:1 บนผิวขาว
// ⚠️ **#0d6b9b สงวนไว้สามงาน: หัวข้อ · ลิงก์ · <strong> ในเนื้อความ** ตัว <strong>
// เป็นงานของหน้าเพจ ไม่ใช่ของไฟล์นี้
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีเก้ากล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบในสายปกติ** ส่วนใบอื่นใช้
// §2 ขีดใต้ + แท่งสั้น · §3 เส้นคู่คร่อมบน-ล่าง · §4 ป้ายลอยผิวโครมเข้ม ·
// §5 ชิปถมฟ้าคู่กลีฟบนการ์ดมุมตัด 36px · §6 สันซ้ายสี่พิกเซลบนการ์ดมุมตัด 40px ·
// §7 แท่งตั้งข้างหัวข้อแบบไม่มีการ์ดครอบ · §8 หัวข้อจัดกลางพร้อมขีดใต้จางสองข้าง
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วห้าแบรนด์ในรีโปนี้
// การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ **#18a5e2** กับ **#0d6b9b**
// และค่าที่ต้องไม่เหลือคือ: 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff
// ccf7ff f2fbff dff4fd eafaff a9e3f9 0f3a4a 06293c (สบาย168 — ⚠️ 6bdcfb ห่างค่า
// vivid ดิบของโลโก้รอบนี้แค่ 1 หน่วย) · 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52
// (รวยแทร่168) · 32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 (นินจา168) · 2f9ff5
// a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 (TSDET911)
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือ **ทองคานารี-โครเมียมเงินบนน้ำตาลกาแฟ ของ
// พักยก168** (eeae12 fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6 d6c6a8
// 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04 4e2f11) และต้องไม่เหลือชุดของแบรนด์
// ขาออก **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810
// 201906 2e2512 1b1407 4d3c15) สักค่าเดียว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI เลยสักเฉด** (ทองในอาร์ตเวิร์กคือตะกร้าเหรียญ
// นาฬิกา เข็มขัด — เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์) ไม่มีแดง ไม่มีชมพู/โรสโกลด์
// ไม่มีม่วง/ฟูเชีย/อินดิโก utility ไม่มีเขียว ไม่มีส้ม และไม่มีแรมป์เทาเงิน
// rgba() ที่อนุญาตรอบนี้: rgba(24,165,226,α) · rgba(13,107,155,α) ·
// rgba(244,228,211,α) · rgba(17,26,63,α) · rgba(22,41,74,α) · rgba(255,255,255,α) ·
// rgba(0,0,0,α)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#a9d7f2] bg-white p-8 text-left text-base leading-relaxed text-[#16294a] shadow-[0_12px_34px_rgba(22,41,74,0.12)] transition-all duration-500 hover:border-[#18a5e2] hover:shadow-[0_18px_44px_rgba(24,165,226,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#18a5e2]/25 blur-[62px] transition-all duration-500 group-hover:bg-[#18a5e2]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#f4e4d3]/80 blur-[62px] transition-all duration-500 group-hover:bg-[#a9d7f2]/70">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#0d6b9b] to-[#0a5176] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#18a5e2] via-[#a9d7f2] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
