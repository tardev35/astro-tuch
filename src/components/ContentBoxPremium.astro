---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): เว็บแทงบอลออนไลน์ โลโก้เป็นเวิร์ดมาร์ก
// สองส่วน BRAVO เป็นโครเมียมไล่น้ำเงินรอยัล #1558c4 แล้วปิดด้วยเลข 168 ทองตัน #f4cb69
// งานอาร์ตเป็นสนามกลางคืนพื้นกรมท่า มีริ้วแสงทองพาดโค้ง ลูกฟุตบอลทอง-กรมท่า เหรียญทอง
// กองสูง และถ้วยรางวัลทอง แบรนด์นี้จึงเป็นสองสีจริง ไม่ใช่ทองน้ำหนักเดียว — การ์ดใบนี้
// ถือ H1 ของหน้าแรก จึงไล่จากผิวการ์ดกรมท่า #04142f ลงไปหาพื้นเพจกรมท่าเกือบดำ #02081a
// ในกรอบน้ำเงินเส้น #0e3f8f ที่สว่างขึ้นเป็นทองแบรนด์ #f4cb69 ตอน hover ออร่าสองมุมแยก
// หน้าที่ตามคู่สีของโลโก้ คือทองแบรนด์มุมซ้ายบนตามเลข 168 และน้ำเงินรอยัล #1558c4
// มุมขวาล่างตามคำว่า BRAVO แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ทองอ่อน #ffe39a →
// ทองแบรนด์ #f4cb69 → ทองลึก #c9922e เนื้อความ #dbe5f5 (BRAND_TEXT) — ชุดทอง-แดง
// เลือดหมูของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622 #7b0304 #4c0301 #160b06
// #0a0503 #ece0cb) ออกครบทุกจุด และไม่มีเขียวนีออนของ CK268 เหลืออยู่เลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0e3f8f]/80 bg-gradient-to-br from-[#04142f]/94 to-[#02081a]/96 p-8 text-left text-base leading-relaxed text-[#dbe5f5] shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f4cb69]/75 hover:shadow-[0_15px_40px_rgba(244,203,105,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f4cb69]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffe39a]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1558c4]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#2f86f0]/35">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0e3f8f]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe39a] via-[#f4cb69] to-[#c9922e] shadow-[0_0_10px_rgba(244,203,105,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
