---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e01020]/40 bg-gradient-to-br from-[#1a0304]/92 to-[#0a0102]/90 p-8 text-left text-base leading-relaxed text-[#e0d7d8] shadow-[0_10px_30px_rgba(224,16,32,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e01020]/75 hover:shadow-[0_15px_40px_rgba(224,16,32,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01020]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#ff5a63]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f4eff0]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#f4eff0]/26"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e01020]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f4eff0] via-[#ff5a63] to-[#4b0304] shadow-[0_0_10px_rgba(224,16,32,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#e01020] via-[#ff5a63] to-[#f4eff0] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
