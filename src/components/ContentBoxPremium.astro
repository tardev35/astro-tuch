---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): เว็บเกมสล็อตออนไลน์ โลโก้เป็นเวิร์ดมาร์ก
// สองส่วน GOT เป็นทองเมทัลลิก #f5c518 มีอัญมณีแดงฝังกลางตัว O แล้วปิดด้วยเลข 777 สีแดง
// เลือดหมู #d21622 ขอบทอง แบรนด์นี้จึงเป็นสองสีจริง ไม่ใช่ทองน้ำหนักเดียว — การ์ดใบนี้
// ถือทั้ง H1 ของหน้าแรกและ H2 หัวข้อติดต่อแอดมิน จึงไล่จากผิวการ์ดดำอมน้ำตาล #160b06
// ลงไปหาพื้นเพจดำสนิท #0a0503 ในกรอบทองลึก #96690f ที่สว่างขึ้นเป็นทองแบรนด์ #f5c518
// ตอน hover ออร่าสองมุมแยกหน้าที่ตามคู่สีของโลโก้ คือทองแบรนด์ #f5c518 มุมซ้ายบนตาม
// คำว่า GOT และแดงแบรนด์ #d21622 มุมขวาล่างตามเลข 777 แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อ
// ไล่ทองอ่อน #ffe9a8 → ทองแบรนด์ #f5c518 → ทองลึก #96690f เนื้อความ #ece0cb
// (BRAND_TEXT) — ชุดทอง-ขาวของ WIN999 (#fcc403 #fdda04 #8a6502 #4a3402 #191712
// #050505 #e9e4d6) ออกครบทุกจุด และชุดแดง-ขาวของ LOTTOPLUS ไม่ได้อยู่ในไฟล์นี้
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#96690f]/70 bg-gradient-to-br from-[#160b06]/94 to-[#0a0503]/96 p-8 text-left text-base leading-relaxed text-[#ece0cb] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/75 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c518]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffe9a8]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d21622]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#d21622]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4c0301]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c518] to-[#96690f] shadow-[0_0_10px_rgba(245,197,24,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
