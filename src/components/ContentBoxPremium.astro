---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#25cb0e]/40 bg-gradient-to-br from-[#031204]/92 to-[#010301]/90 p-8 text-left text-base leading-relaxed text-[#d5e8d0] shadow-[0_10px_30px_rgba(37,203,14,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#25cb0e]/75 hover:shadow-[0_15px_40px_rgba(37,203,14,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#25cb0e]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#6ef25a]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f0f7ee]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#f0f7ee]/26"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#25cb0e]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f0f7ee] via-[#6ef25a] to-[#063f04] shadow-[0_0_10px_rgba(37,203,14,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#25cb0e] via-[#6ef25a] to-[#f0f7ee] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
