---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H2 §2** ของหน้าแรก (content.txt บรรทัด 6): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย
//
// นินจา168 (รอบ **ฟ้าไซยานนำ · เหลืองมะนาวเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-ninja168.md §2
// งานศิลป์: โลโก้เป็นนินจาการ์ตูนชุดดำ ผูกผ้าคาดหัวฟ้า-ขาวมีดาวน้ำเงิน ขยิบตา ถือ
// ชูริเคนสีฟ้า มีผ้าพันคอฟ้าปลิว ล้อมด้วยประกายดาวทองและชูริเคนฟ้า ข้างๆ เป็น
// ตัวอักษรไทยสามมิติ **สีเหลืองทอง** ต่อด้วยเลข **ฟ้าบับเบิลผิวมันวาว**
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0c2a3d ยก / #071a28 กลาง /
// #030e16 จม / #000000 พื้น — การ์ดใบนี้ไล่จากยกลงไปจม
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่ **พลิกขั้วหัวข้อ** — หัวข้อนั่งบน **แผ่นถมสว่างทึบ**
// ที่ไล่ฟ้าน้ำแข็ง #a9e9ff → ฟ้าแบรนด์ #32bcfb → เหลืองมะนาว #fef54b แล้วถือ
// **หมึก #041019** ซึ่ง §2 ระบุว่าเป็นหมึกตัวเดียวที่วางบนพื้นถมฟ้า/เหลืองได้
// (8.9:1 บน #32bcfb · 16.5:1 บน #fef54b และสูงกว่านั้นบน #a9e9ff — ทั้งสามปลาย
// ปลอดภัย **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ส่วนอีกเจ็ดใบของหน้าเป็นตัวอักษร
// สว่างบนพื้นมืดทั้งหมด
// มุม rounded-[28px] กรอบหนา 2px ฟ้าแบรนด์ (อิ่มเป็นเหลืองมะนาวตอน hover) ออรามุม
// ซ้ายบนเป็นน้ำเงินลึก #07335f (ผ้าพันคอฟ้าในงานศิลป์) มุมขวาล่างเป็นทองลึก #6b5c10
// ที่ไต่ขึ้นเป็นฟ้าน้ำแข็งตอน hover เนื้อความ #dceefc (= BRAND_TEXT, 13:1 บนผิวยก)
// §2 ห้าม #07335f (1.4:1) และ #6b5c10 (1.9:1) ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสอง
// ค่าอยู่ที่ขอบ ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" และ **รอบนี้กับดักมีสองชั้น: ฟ้า และ ทอง**
// เพราะรอบที่แล้ว (สบายเบท168) ก็ฟ้านำ+ทองรองบนดำเหมือนกัน ต่างกันที่ค่า:
// ฟ้ารอบนี้ **#32bcfb** (R=50 G=188 B=251) ไซยานสว่างกว่า 2f9ff5 · ฮิวที่สองรอบนี้
// **#fef54b เหลืองมะนาว** ไม่ใช่ทองอำพัน ffc82e · ชุดความลึก #0c2a3d / #071a28 /
// #030e16 ไม่ใช่ 0e2238 / 081726 / 040d16
// ค่าของแบรนด์ก่อนที่ต้องไม่เหลือ: 2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 04121f
// (สบายเบท168) · fa63b9 ffb3de ffd84d 6d0b3f 6b4708 2a0617 fdeaf5 (ถอนชัวร์168) ·
// fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 f6e4ee (มีโชค168) · f7c92b ffe6a3 f2bba5
// c98a74 b3121b (ขวัญใจ168) · f0b429 ffdc8c d30304 (รับตัง168) · fa0513 e3b23c
// (สมหวัง168) · 0a84e0 04203f e4f1fd (HI59) · 04225b · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ม่วง เขียว ส้ม แดง โรสโกลด์ และเงิน/โครเมียม**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#32bcfb]/70 bg-gradient-to-br from-[#0c2a3d] via-[#071a28] to-[#030e16] p-8 text-left text-base leading-relaxed text-[#dceefc] shadow-[0_12px_34px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fef54b]/80 hover:shadow-[0_18px_44px_rgba(50,188,251,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#07335f]/55 blur-[62px] transition-all duration-500 group-hover:bg-[#07335f]/75">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#6b5c10]/80 blur-[62px] transition-all duration-500 group-hover:bg-[#a9e9ff]/26">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#a9e9ff] via-[#32bcfb] to-[#fef54b] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#041019] uppercase shadow-[0_8px_24px_rgba(50,188,251,0.4)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#6b5c10] via-[#07335f] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
