---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// NEXT55 palette: graphite card (#17181c -> #0c0d10) inside a crimson hairline
// (#cd1437 / #f0435f). The heading gradient here runs PURE CRIMSON (pale rose ->
// bright -> primary); the plain ContentBox's heading runs rose -> crimson ->
// silver instead, which is what tells the two shapes apart at a glance now that
// both carry the brand's red. The two aura blooms are deliberately two-tone —
// crimson top-left, brushed silver bottom-right — so the card carries the logo's
// pairing (dark-graphite NEXT55 wordmark, crimson interlocking arrows) rather
// than one flat hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#cd1437]/45 bg-gradient-to-br from-[#17181c]/92 to-[#0c0d10]/94 p-8 text-left text-base leading-relaxed text-[#d5dae2] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0435f]/75 hover:shadow-[0_15px_40px_rgba(205,20,55,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cd1437]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#f0435f]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e7eaef]/12 blur-[55px] transition-all duration-500 group-hover:bg-[#e7eaef]/20">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#cd1437]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] shadow-[0_0_10px_rgba(205,20,55,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#cd1437] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
