---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอป 2026-10-24 **ไม่มีรูปประกอบบทความของแบรนด์นี้เลย**
// (banner2.png / banner3.png เป็นของแบรนด์ก่อน และ eager import = emit ขึ้น dist
// ทุก build) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ถูกใช้ครบสองใบ
// แล้วที่ §4 กับ §5
//
// ───────────────────────────────────────────────────────────────────────────
// MEXICANOSLOT (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-mexicanoslot.md §2
// **แดงเม็กซิกันนำ · ทอง/พีชฟางเป็นวัสดุที่สอง · เขียวเม็กซิกันเป็นแอคเซนต์ ·
// เนื้อหาเป็นธีมสว่าง (โครม navbar/footer/ticker ต่างหากที่เป็นเอสเพรสโซเข้ม)**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกายบับเบิลของ โบ๊ะบ๊ะ168** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ พื้นเพจรอบนี้คือ {"mode":"color","color":"#fef6fb"} จาก bg.json =
// **ขาวอมชมพูจาง** (รอบก่อน okkub88 เป็น ffd6fa ที่อิ่มกว่านี้มาก — อ่าน bg.json
// ใหม่ทุกรอบ ห้ามสืบทอดค่าข้ามรอบ) **ห้ามแก้การ์ดใบนี้ให้เป็นพื้นมืดตามโครม**
// เพราะหมึก #3f130d บนพื้นมืดจะหายไปเลย ไม่ใช่แค่จางลง
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้จริง: โลโก้คือ **ชายการ์ตูนไว้หนวดสวมซอมเบรโรฟาง
// ขอบลายปักแดง-เขียว ยกนิ้วโป้ง คู่กับเวิร์ดมาร์กสามมิติ "MEXICANO" แดงสด +
// "SLOT" น้ำเงินไล่ฟ้า ตัดขอบขาวหนา** แบนเนอร์เป็นฉาก **กลางแจ้งเม็กซิกันพื้นสว่าง
// มีอาคารอะโดบีครีมและกระบองเพชรเขียว** สไลด์ทั้งสองใบเป็นฉาก **ผ้าซาราเป้ลายทาง
// แดง-เขียว** พิมพ์เลข 0.3% / 0.8% ตัวแดงเข้ม
// 🚨🚨 **"SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์กเป็นอาร์ตเวิร์ก ไม่ใช่สี UI** — ฟ้าคือ
// ฮิวนำของ โบ๊ะบ๊ะ168 เมื่อสองรอบก่อน ดึงเข้ามา = หลงเหลือข้ามแบรนด์
// ⚠️ **ซอมเบรโรฟาง ปอนโช กีตาร์ เหรียญทอง มาราคัส และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI**
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ผิวยก #fff3ea · wash #fde4d3 · พื้นเพจ #fef6fb
//   แผ่นถมหัวข้อ = ไล่ **#c81e12 → #9d140c บนหมึกขาว** ซึ่งเป็นครึ่งบนของสูตร
//     "ปุ่ม CTA หลัก" ใน §2 (ขาวบน #c81e12 = 5.7:1 · บน #9d140c = 8.3:1)
//     ⚠️⚠️ **ไล่เฉดไม่ลากขึ้นไปถึง #de2b1e หรือ #f2a033 โดยตั้งใจ** — §2 ระบุตรงๆ
//     ว่าสองค่านั้นสงวนไว้สำหรับขอบ/ออรา/พื้นถม และขาวบน #de2b1e ได้แค่ 4.7:1
//   แดงเม็กซิกัน #de2b1e = ต้นของเส้นใต้หัวข้อ + ออรามุมบนซ้าย — **พื้นถม/ออรา
//     เท่านั้น ห้ามถือตัวอักษรบนผิวสว่าง (4.0:1 บนขาว)**
//   ทอง #f2a033 = กลางของเส้นใต้หัวข้อ · พีช/ฟาง #fed7b5 = ออรามุมขวาล่าง —
//     **พื้นถมเท่านั้น**
//   เส้น/ขอบ #f6c4a4 อิ่มเป็น #de2b1e ตอน hover — **ห้ามถือตัวอักษร**
//   หมึก #3f130d = เนื้อความ (= BRAND_TEXT) 14.9:1 บนการ์ดขาว
//   ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ **#a81410** (7.6:1) และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(222,43,30,α) · rgba(242,160,51,α) ·
// rgba(168,20,16,α) · rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบพร้อมหมึกขาว + เส้นใต้เต็ม
// ความกว้าง** ส่วนใบอื่น: §2 หัวข้อกึ่งกลางบนการ์ดมุมตัด 30px ผิวยก · §3 หัวข้อ
// ชิดซ้าย + ขีดสั้นบนการ์ดมุมกลม · §4 หัวข้อชิดซ้าย + เส้นใต้สามสต็อปเต็มคอลัมน์ ·
// §5 ชิปถมเขียวคู่กลีฟกระบองเพชรบนการ์ดมุมตัด 36px · §6 สันซ้ายสี่พิกเซลบนการ์ด
// มุมตัด 40px · §7 หัวข้อคร่อมเส้นคาดในการ์ดซ้อนการ์ดอินเซ็ต · §8 หัวข้อกึ่งกลาง
// พร้อมขีดใต้จางสองข้าง
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — และกับดักของรีโปนี้รอบนี้คือแดง**
// แดง/ชมพูเคยนำมาแล้วหลายแบรนด์ แดงรอบนี้คือ **#de2b1e (R222 G43 B30) /
// #a81410 / #c81e12 / #9d140c / #6f0e08** เท่านั้น ค่าที่ห้ามเหลือ:
//   00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb
//   355f7d 0f5684 1a6ea8 (**โบ๊ะบ๊ะ168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b
//   fc74b5 ffc2e2 d91a73 b01160 85094a (**okkub88 — แบรนด์ขาออก เสี่ยงหลงเหลือ
//   สูงสุด**) ·
//   fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607 (สล็อต168 — ⚠️⚠️ **fb2e33 ↔ #de2b1e
//   ตระกูลเดียวกัน ความอิ่มใกล้กัน · cb0b0d / b00d11 ↔ #c81e12 / #a81410 ใกล้มาก
//   ตรวจด้วยค่าเท่านั้น ห้ามตัดสินด้วยสายตา**) · ff2e52 e01238 c9102f (มาดาม168) ·
//   c30303 8f0505 e81313 dcb95f 280b0b (รวยแท้168) · d9212a 8e1a16 f0c878 fff8d8
//   (ดวงเศรษฐี168) · fb141b ff5f63 (GT66B) · eb0305 2c1004 4d1c0a b44c06 f0b46a
//   (ค้างใน NavbarStyle4 — ⚠️ **f0b46a ↔ #f2a033 ต่างไบต์แรกเดียว**) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 (หมูบิน168) · f41571 ff5ca8 (PUNPRO168)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (ทองรอบนี้คือ **#f2a033 ค่าเดียว**): ffd84d f5ba14
//   fcee52 b37c0b ffd94a e3a712 9d6f06 eeae12 fded41 9f600d fcd434 fdcb0c fefb6b
//   fee45d e6a416 fef54b f7c92b d4922c fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429
//   ffc82e e0bd72 f6e4b4 d4af5a eab308 f5c53d ece2cc
// ⚠️ เขียวของแบรนด์เก่า (เขียวรอบนี้คือ **#117a41** และบนโครมคือ #2bb061):
//   0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าใน
// src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีม่วง ไม่มีชมพู/แมเจนต้า และไม่มีแรมป์
// เทาเงินเลยสักเฉด** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์
// อื่น คงไว้)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#f6c4a4] bg-white p-8 text-left text-base leading-relaxed text-[#3f130d] shadow-[0_12px_34px_rgba(168,20,16,0.14)] transition-all duration-500 hover:border-[#de2b1e] hover:shadow-[0_18px_44px_rgba(222,43,30,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#de2b1e]/22 blur-[62px] transition-all duration-500 group-hover:bg-[#de2b1e]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fed7b5]/55 blur-[62px] transition-all duration-500 group-hover:bg-[#fed7b5]/75">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#c81e12] to-[#9d140c] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white shadow-[0_8px_22px_rgba(168,20,16,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#de2b1e] via-[#f2a033] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
