---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag — and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// This card carries docx H1 §1 of the home page (content.txt line 4): one
// paragraph, one slot, no sub-headings. No FeatureHighlights this round (the
// brief has no labelled sub-list) and no illustration inside the card, because
// this drop has no current-brand article image — banner2.png (10-08) and
// banner3.png (09-27) on disk are previous brands' art and an eager import IS
// an emit, rendered or not.
//
// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2):
// โลโก้คือคำว่า "สมหวัง" ตัวอักษรสามมิติโครเมียมขาวอมเงินขอบแดง ต่อด้วยเลข "168"
// สีแดงสดตัวหนาสามมิติ มีเปลวไฟแดงกับลายกนกไทยสีแดงพันรอบ แบนเนอร์และสไลด์เป็นฉาก
// คาสิโนไทย-จีนพื้นดำ ผ้าซาตินแดงพลิ้ว ลายกนก/นาคทองไทยขนาบสองข้าง กองชิปทอง-แดง-ดำ
// วงล้อรูเล็ต และไพ่เอซ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง #290f0f** (bg.json) ไม่ใช่ดำสนิทแบบรอบก่อน
// ลำดับความลึก: #2c1413 ยก / #1f0d0c กลาง / #140706 จม / #290f0f พื้น
//
// ใบนี้เป็นการ์ดมุมกลม rounded-3xl ที่ **ไล่ผิวจากยก #2c1413 ลงไปหาจม #140706** จึง
// ไม่อ่านเป็นใบเดียวกับ ContentBox (§4) ที่เป็นมุมกลมเหมือนกันแต่เป็นผิวยกทึบและมี
// เส้นไรผมทองบนสุด และไม่ซ้ำกับ ContentBox3ThreePremium (§6) ที่เป็นมุมกลมผิวยกทึบ
// สามคอลัมน์
// หัวข้อไล่ แดงสว่าง #ff5a5f → ทองสว่าง #ffe5a8 → ทองไทย #e3b23c ("แดงนำขึ้นทอง")
// ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ และทุกสตอปผ่าน AA บนผิวมืด
// (#ff5a5f = 5.7:1 · #ffe5a8 = 14.1:1 · #e3b23c = 8.9:1)
// ออรามุมซ้ายบนเป็นแดงแบรนด์ #fa0513 (เลข 168 กับเปลวไฟบนโลโก้) มุมขวาล่างเป็น
// แดงมืด #3c0303 (เงาใต้กองชิปในแบนเนอร์) ที่ไต่ขึ้นเป็นทองลึก #8a6210 ตอน hover
// ขอบการ์ดเป็นทองลึก #8a6210 ที่อิ่มเป็นทองไทยตอน hover เส้นใต้หัวข้อเป็นแดงลึก
// #b90203 เนื้อความ #f4ecea (= BRAND_TEXT) glow เป็น rgba(250,5,19,α)
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้ทั้งหกค่าอยู่ที่ขอบ เส้นคั่น และออราเท่านั้น
// #ffadaf ถูกสงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่ในไฟล์นี้เลย
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** เพราะสองแบรนด์
// ก่อนหน้าก็เป็นแดงทั้งคู่: GT66B #fb141b (G=20) และ TKB55 #fb131b (G=19) ส่วนแดง
// รอบนี้คือ #fa0513 (R=250 G=5 B=19) "เจอแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// ชุดเต็มของ GT66B ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#fb141b #ff5f63 #ffa0a2 #db040b
// #ec151c #8a0609 #3b0405 #fdfcfd #b4bcc2 #eceaea #1c0c0b #130c0c #0b0303
// #000000 และ rgba(251,20,27,α)) ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของ TKB55
// (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304
// #c40304 #8a0206 #53050a #1a0304) และชุดน้ำเงินไฟฟ้าของ TSDET911 (#0360f3
// #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26
// #00081f #032dad #04186e #041a43)
// ⚠️ แดงของแบรนด์อื่นที่ยังค้างในไฟล์ inventory: SUPERSLOTCLUB #e8232a (R=232) ·
// PIGPG #d4200d (R=212) · FLASH877 #ff3b14 (R=255 G=59) — ไม่มีตัวไหนเป็น #fa0513
// ⚠️ ทองรอบนี้ #e3b23c ก็คนละค่ากับทองของ TND168 #dfa310 · UFA324 #e5a81b ·
// KMD88 #e2b33f ที่ค้างในไฟล์ inventory — ต่างกันหลักเดียวกับตัวหลัง
// ⚠️ **รอบนี้ไม่มีโครเมียมขาว/เงิน ไม่มีม่วง ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม ไม่มีชมพู** มีแค่แดงกับทองไทย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a6210] bg-gradient-to-br from-[#2c1413]/96 to-[#140706]/96 p-8 text-left text-base leading-relaxed text-[#f4ecea] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b23c] hover:shadow-[0_15px_40px_rgba(250,5,19,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fa0513]/32 blur-[55px] transition-all duration-500 group-hover:bg-[#fa0513]/48">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3c0303]/80 blur-[55px] transition-all duration-500 group-hover:bg-[#8a6210]/45">
    </div>

    {
      title && (
        <header class="mb-6 border-b border-[#b90203] pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ff5a5f] via-[#ffe5a8] to-[#e3b23c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
