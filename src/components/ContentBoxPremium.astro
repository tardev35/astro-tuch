---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// แบรนด์รอบนี้เป็น "คู่สีจริง" — ม่วงไฟฟ้า #a435f0 นำ (ตัวเครื่องเกมพกพาในโลโก้และ
// ผนังตู้อาร์เขตในแบนเนอร์) และทอง #fbe455 เป็นฮิวที่สองจริง (เหรียญทองกับเลข 168)
// พื้นเพจเป็นครามเกือบดำอมม่วง #0c0024 ตาม bg.json ผิวการ์ดทุกใบจึงต้อง "สว่างกว่า"
// พื้น เพื่อให้การ์ดยกลอยขึ้นจากหน้า ไม่ใช่จมลงไปแบบรอบแดงแล็กเกอร์ของ PIGPG
//
// การ์ดใบนี้ถือ docx H1 ของหน้าแรก จึงหนักแน่นที่สุดในหน้า และเป็นใบเดียวที่หัวข้อ
// ขึ้นที่ text-3xl ต้องไม่อ่านเป็นใบเดียวกับ ContentBox (ใบธรรมดาที่ถือ H2 #3),
// ContentBoxSevenThreePremium และ ContentBoxTwoPremium ที่อยู่หน้าเดียวกัน จึงแยก
// ด้วยรูปทรงและสีกรอบ: สันตั้งไล่ม่วงหน้าหัวข้อ + ผิวการ์ดไล่จากผิวยก #1e0a3c ลงไป
// หาผิวลึก #110321 และกรอบเป็น "กรอบม่วงแบรนด์" #a435f0 เข้มกว่าใบธรรมดา
// (SevenThreePremium ใช้กรอบม่วงลึก #5b1a75 ส่วน TwoPremium ใช้ผิวทึบ #17062e
// กรอบทองเข้ม #c98a05 และ ContentBox ใบธรรมดาเป็นผิวทึบ #1e0a3c กับเส้นคาดบนสุด)
//
// หัวข้อไล่ม่วงอ่อน #d2a6ff → เงินอมม่วง #efe6ff → ทองแบรนด์ #fbe455 คือ "ม่วงนำ
// เข้าทอง" ซึ่งเป็นทิศคนละชุดกับทุกกล่องบนหน้าเดียวกัน — ม่วงนำเพราะทั้งโลโก้และฉาก
// อาร์เขตในแบนเนอร์เป็นม่วงเป็นมวลสีหลัก
//
// ออรามุมซ้ายบนเป็นม่วงแบรนด์ มุมขวาล่างเป็นทองเข้ม #c98a05 (เหรียญทองในงานอาร์ต)
// เส้นใต้หัวข้อเป็นม่วงลึก #5b1a75 เนื้อความ #ece2ff (= BRAND_TEXT, 12.5:1 บนผิวยก
// และสูงกว่านั้นบนผิวลึก) glow ทุกจุดเป็น rgba(164,53,240,…)
// §2 ห้าม #a435f0 ถือตัวอักษรปกติ (3.1:1 กับตัวอักษรสว่าง) จึงอยู่ที่ขอบ สัน และออรา
// เท่านั้น ส่วน #c98a05 ไม่เคยเป็นตัวอักษรบนพื้นมืดเลย
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0193fb #7bcffb #d4ecfd
// #064a86 #fce604 #fff48a #c9a703 #0a1726 #040b14 #dbeafe rgba(1,147,251,…))
// ออกครบทุกจุดแล้ว — และทองของรอบนี้เป็นคนละค่ากับ #fce604 รอบก่อน
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a435f0]/60 bg-gradient-to-br from-[#1e0a3c]/96 to-[#110321]/96 p-8 text-left text-base leading-relaxed text-[#ece2ff] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#a435f0]/90 hover:shadow-[0_15px_40px_rgba(164,53,240,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a435f0]/34 blur-[55px] transition-all duration-500 group-hover:bg-[#a435f0]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c98a05]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#fbe455]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5b1a75] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d2a6ff] via-[#a435f0] to-[#5b1a75] shadow-[0_0_10px_rgba(164,53,240,0.7)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#d2a6ff] via-[#efe6ff] to-[#fbe455] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
