---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5e0505]/80 bg-gradient-to-br from-[#1c0606]/92 to-[#070202]/94 p-8 text-left text-base leading-relaxed text-[#f2e3c9] shadow-[0_10px_30px_rgba(7,2,2,0.65)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd121]/75 hover:shadow-[0_15px_40px_rgba(253,209,33,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ef1622]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#ef1622]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdd121]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#fdd121]/30">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5e0505]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fdd121] to-[#b00a12] shadow-[0_0_10px_rgba(253,209,33,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#ef1622] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
