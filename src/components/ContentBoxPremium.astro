---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่จาก
// พื้นการ์ดดำอมน้ำตาล #161106 ลงไปหาพื้นเพจ #080602 ในกรอบทองลึก #7a5407 ที่สว่าง
// ขึ้นเป็นทองแบรนด์ #e0b429 ตอน hover ออร่าสองมุมแยกด้วยคู่สีของโลโก้จริง คือทอง
// #e0b429 กับเงินโครเมียม #dfe4ec แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ตามลำดับสีบน
// โลโก้ คือเงินโครเมียม #dfe4ec → ทองสว่าง #fbd564 → ทองแบรนด์ #e0b429 ตรงกับตัว U
// ที่เป็นทอง คำว่า WIN ที่เป็นเงิน และเลข 33 ที่กลับมาเป็นทอง เนื้อความ #ece6d8
// (BRAND_TEXT) — ชุดทอง-เขียวเข้ม-แดงของ 888PARUAY (#fcdc2b #fff6ae #a87d0c
// #1fae1c #cf1111 #0d2312 #07130a #143a1c #e8e4c6) ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7a5407]/60 bg-gradient-to-br from-[#161106]/94 to-[#080602]/96 p-8 text-left text-base leading-relaxed text-[#ece6d8] shadow-[0_10px_30px_rgba(8,6,2,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0b429]/75 hover:shadow-[0_15px_40px_rgba(224,180,41,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e0b429]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fbd564]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dfe4ec]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#dfe4ec]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7a5407]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe4ec] via-[#fbd564] to-[#e0b429] shadow-[0_0_10px_rgba(224,180,41,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
