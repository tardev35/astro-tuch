---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// แบรนด์รอบนี้เป็น "คู่สีจริง" — ฟ้าสด #0193fb นำ (เลข 168 ในโลโก้) และเหลืองมะนาว
// #fce604 เป็นฮิวที่สองจริง (คำว่า แตกดี) ไม่ใช่โลหะคั่นแบบรอบทองของ 789BETTING
// พื้นเพจเป็นดำตัน #000000 ตาม bg.json การ์ดจึงต้องยกขึ้นจากพื้นด้วยผิวกรมท่า
//
// การ์ดใบนี้ถือ docx H1 ของหน้าแรก จึงหนักแน่นที่สุดในหน้า และเป็นใบเดียวที่หัวข้อ
// ขึ้นที่ text-3xl ต้องไม่อ่านเป็นใบเดียวกับ ContentBoxTwoPremium และ
// ContentBoxSevenThreePremium ที่อยู่หน้าเดียวกัน จึงแยกด้วยรูปทรงและสีกรอบ:
// สันตั้งไล่ฟ้าหน้าหัวข้อ + ผิวการ์ดไล่จากผิวยก #0a1726 ลงไปหาผิวลึก #040b14 และ
// กรอบเป็น "กรอบฟ้าแบรนด์" #0193fb (SevenThreePremium ใช้กรอบฟ้าเข้ม #064a86
// ส่วน TwoPremium ใช้ผิวทึบ #07111d กรอบเหลืองเข้ม #c9a703)
// หัวข้อไล่ฟ้าอ่อน #7bcffb → ฟ้าซีด #d4ecfd → เหลืองมะนาว #fce604 คือ "ฟ้านำเข้า
// เหลือง" ซึ่งเป็นทิศคนละชุดกับทุกกล่องบนหน้าเดียวกัน — ฟ้านำเพราะบนโลโก้จริง
// เลข 168 สีฟ้าคือมวลสีที่วัดได้มากที่สุด (43.8%)
//
// ออรามุมซ้ายบนเป็นฟ้าแบรนด์ มุมขวาล่างเป็นเหลืองเข้ม #c9a703 (เหรียญทองในงานอาร์ต)
// เส้นใต้หัวข้อเป็นฟ้าเข้ม #064a86 เนื้อความ #dbeafe (= BRAND_TEXT, 14.4:1 บนผิวยก
// และ 16.2:1 บนผิวลึก) glow ทุกจุดเป็น rgba(1,147,251,…)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f
// #7a0505 #0b7a33 #2bbf63 #d9a521 #ffdf91 #1d0b08 #090302 #f6e3cf
// rgba(196,17,21,…)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0193fb]/55 bg-gradient-to-br from-[#0a1726]/96 to-[#040b14]/96 p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#0193fb]/90 hover:shadow-[0_15px_40px_rgba(1,147,251,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0193fb]/32 blur-[55px] transition-all duration-500 group-hover:bg-[#0193fb]/48">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c9a703]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#fce604]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#064a86] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7bcffb] via-[#0193fb] to-[#064a86] shadow-[0_0_10px_rgba(1,147,251,0.65)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#7bcffb] via-[#d4ecfd] to-[#fce604] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
