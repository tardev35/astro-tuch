---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): การ์ดใบนี้ถือทั้ง H1 ของหน้าแรกและ
// หัวข้อ "แอดมินออนไลน์ 24 ชั่วโมง" จึงไล่จากพื้นการ์ดเขียวเข้ม #0d2312 ลงไปหาพื้น
// เพจ #07130a ในกรอบทองลึก #a87d0c ที่สว่างขึ้นเป็นทองหลัก #fcdc2b ตอน hover
// แถบแนวตั้งหน้าหัวข้อเป็นทองไล่สามระดับ ส่วนตัวหัวข้อไล่ตามลำดับสีของโลโก้จริง คือ
// เลข 888 เขียวสด #1fae1c → วงแหวนทองสว่าง #fff6ae → คำว่า PARUAY แดง #cf1111
// ออร่าสองมุมแยกด้วยคู่สีรองของแบรนด์ คือทองกับเขียวสด — ชุดแดง-เงินโครเมียมของ
// UFAGOOL (#241a1a #0a0708 #c50d12 #ef1f25 #5e0507 #b8c3cf #f4f7fa #cdd5dd)
// หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a87d0c]/60 bg-gradient-to-br from-[#0d2312]/94 to-[#07130a]/96 p-8 text-left text-base leading-relaxed text-[#e8e4c6] shadow-[0_10px_30px_rgba(7,19,10,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcdc2b]/75 hover:shadow-[0_15px_40px_rgba(252,220,43,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fcdc2b]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fff6ae]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1fae1c]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#1fae1c]/36">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a87d0c]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6ae] via-[#fcdc2b] to-[#a87d0c] shadow-[0_0_10px_rgba(252,220,43,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
