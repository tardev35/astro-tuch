---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H2 สองใบ** ของหน้าแรก — §3 ("โปรโมชั่น <แบรนด์> อัปเดตใหม่
// ตลอดสัปดาห์" content.txt บรรทัด 7 ย่อหน้าบรรทัด 8) และ §6 ("สมัครเล่น <แบรนด์>
// คาสิโนไม่มีขั้นต่ำ 3 ขั้นตอน" บรรทัด 13 intro บรรทัด 14 + สามขั้นตอนบรรทัด 15-20)
// ⚠️ §6 ส่งเนื้อหาหลายบล็อกเข้าสล็อตเดียว หน้าเพจจึง **ห่อทั้งชุดไว้ใน <div> เดียว**
// ตามกฎบ้าน "หนึ่งสล็อตรับ element เดียว" — ป้าย "ขั้นตอนที่ 1/2/3" ในนั้นเป็น
// <p class="font-bold"> **ไม่ใช่ heading ระดับไหนเลย** เพราะบรีฟไม่ได้ใส่ prefix H
// ดรอป 2026-10-28 **ไม่มีรูปประกอบบทความของแบรนด์นี้เลย** (banner2.png /
// banner3.png ลงวันที่ 10-23 เป็นของแบรนด์ก่อน และ eager import = emit ขึ้น dist
// ทุก build แม้ไม่มีหน้าไหน render) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน —
// playbook ตรึง slide* ไว้กับ ContentBoxSevenThree* เท่านั้น ซึ่งรอบนี้ใช้ครบสองใบ
// ที่ §4 และ §5 แล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// ZORO365 (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-zoro365.md §2
// **เขียวมรกตนำ · เงินโครเมียม/ทองอำพันเป็นวัสดุที่สอง · มืดทั้งเว็บ**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเลือดนก/ทองบนการ์ดขาวของ LOTTO189** ทั้งใบ
// จึงรีเธมทั้งไฟล์ และ **กลับทิศ 180° เป็นผิวเข้ม** พื้นเพจรอบนี้คือ
// {"mode":"color","color":"#002908"} จาก bg.json = **เขียวป่าจมเกือบดำ**
// (รอบก่อนเป็น f0ffeb = ขาวอมมิ้นต์จาง **คนละปลายของสเกล** — อ่าน bg.json ใหม่
// ทุกรอบ ห้ามสืบทอดค่าข้ามรอบ) **ห้ามแก้การ์ดใบนี้ให้กลับไปเป็นพื้นขาว** เพราะหมึก
// #eef7f0 บนพื้นขาวจะหายไปเลย ไม่ใช่แค่จางลง และขาวเป็นพื้นถมใหญ่บนธีมมืด =
// จอสว่างแปลบกลางหน้า
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้จริง: โลโก้คือ **เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็น
// ตัวอักษรละตินผิวโครเมียมเงินขัดเงา ครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา
// เรืองแสง ตัดขอบดำหนา วางทับวงพู่กันหมึกดำ-เขียว มีดาบคาทานะปักตั้งผ่ากลางวง**
// แบนเนอร์และสไลด์เป็นฉาก **ห้องสไตล์ญี่ปุ่นที่มีกอไผ่และดอกไม้ขาว หญิงสาวสวม
// กิโมโนลายดอกไม้เขียว-ขาว ดาบคาทานะวางพาด และชิปคาสิโนเขียว-ขาวกองซ้อนกัน**
// ⚠️ **ผิวโครเมียมเงิน มงกุฎทองบนโปสเตอร์ กอไผ่ และสีผิวนักแสดงเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #073c1a · ชั้นยก #0e5424 · โครม #031b09 / #010d04 · พื้นเพจ #002908
//   แผ่นถมหัวข้อ = ไล่ **#0e5424 → #1e7033 บนหมึกขาว** ซึ่งเป็นสองสต็อปแรกของสูตร
//     "ปุ่ม CTA หลัก" ใน §2 (ขาวบน #0e5424 = 8.4:1 · บน #1e7033 = 6.1:1)
//     ⚠️⚠️ **ไล่เฉดไม่ลากขึ้นไปถึง #35a043 หรือ #3ddc4a โดยตั้งใจ** — ขาวบนสองค่านั้น
//     ตกต่ำกว่า 4.5:1 §2 สงวนไว้ให้ขอบ/ออรา/พื้นถมและตัวอักษรบนผิวเข้ม
//   เขียวมรกต #3ddc4a = ออรามุมบนซ้าย + ต้นเส้นใต้หัวข้อ (ถือตัวอักษรได้ 6.9:1
//     บนการ์ด แต่ที่นี่เป็นพื้นถม)
//   ทองอำพัน #e8c86a = ออรามุมขวาล่าง + กลางเส้นใต้หัวข้อ (ถือตัวอักษรได้ 8.0:1
//     แต่ที่นี่เป็นพื้นถม)
//   เส้น/ขอบ #1e7033 อิ่มเป็น #35a043 ตอน hover — **ทั้งคู่เป็นเส้นเท่านั้น**
//   หมึก #eef7f0 = เนื้อความ (= BRAND_TEXT) 12.0:1 บนการ์ด · หมึกรอง #9dc2a5 (6.3:1)
//   ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ **#3ddc4a** (6.9:1) และเป็นงานของหน้าเพจ
// 🚨🚨 **#35a043 (3.8:1) และ #1e7033 (2.1:1) ห้ามถือตัวอักษรบนการ์ดนี้เด็ดขาด**
// rgba() ที่อนุญาตรอบนี้: rgba(61,220,74,α) · rgba(53,160,67,α) ·
// rgba(30,112,51,α) · rgba(232,200,106,α) · rgba(223,230,227,α) · rgba(1,13,4,α)
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกรอบนี้มีกล่อง docx เจ็ดใบ ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบพร้อมหมึกขาว + เส้นใต้เต็ม
// ความกว้าง** ส่วนใบอื่น: §1 แผ่นนูน 12px/-12px หัวข้อเขียวทึบจัดกึ่งกลาง · §2
// แผ่นนูน rounded-[30px] ไม่มีกรอบ หัวข้อไล่เงิน→เขียว · §4 การ์ด 7fr/3fr ไล่ผิว
// การ์ด→ชั้นยก หัวข้อทองทึบชิดซ้าย + เส้นใต้สามสต็อป · §5 แผ่นนูน 10px/-10px
// หัวข้อเขียวทึบ + แถบตั้ง · §7 การ์ดมุมตัดเฉียง 30px หัวข้อเงินจัดกึ่งกลางใต้แถบสั้น ·
// §8 ไม่มีการ์ดครอบ หัวข้อเขียวจัดกึ่งกลาง + ขีดใต้จางสองข้าง
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — และกับดักที่แหลมที่สุดของรอบนี้คือ
// เขียว/เงิน/ทอง ซึ่งเป็นชุดเดียวกับ TEVA69 ที่เป็นแบรนด์ขาออกทันที ต่างกันแค่
// กลับทิศสว่าง-มืด** เขียวรอบนี้คือ **#3ddc4a (R61 G220 B74) / #35a043 / #1e7033 /
// #0e5424 / #073c1a / #031b09 / #002908** เงินคือ **#dfe6e3** ทองคือ **#e8c86a**
// เท่านั้น ค่าที่ห้ามเหลือ (เขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสี
// ของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง):
//   f0ffeb ffffff e6f7df d7f0cd b2dba3 3f7a2e 10280f 3c5b36 116018 0b4a12 1a7d24
//   8a6a0e 28c437 e3bb45 c6cfd2 0b2a12 15401d 051409 2d6b2f e8fbe4 b4d6ad
//   (**TEVA69 — แบรนด์ขาออกทันที เสี่ยงหลงเหลือสูงสุด**)
//   ⚠️⚠️ **28c437 ↔ #3ddc4a · e3bb45 ↔ #e8c86a · c6cfd2 ↔ #dfe6e3 · e8fbe4 ↔
//   #eef7f0 · b4d6ad ↔ #9dc2a5 · 15401d ↔ #0e5424 · 0b2a12 ↔ #002908 —
//   เจอค่าซ้ายแปลว่าพิมพ์ผิด ไม่ใช่ว่า "มันก็เขียว/เงิน/ทองเหมือนกัน"**
//   fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310
//   d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
//   (**LOTTO189 — ชุดที่เพิ่งอยู่ทั้งใบนี้**)
//   0c3a16 0a5f1c 0b7d28 0f9b35 061f0c (**สาธุ168 — ⚠️⚠️ 0c3a16 ↔ #073c1a ต่างกัน
//   หลักเดียวและสลับหลักท้าย เจอแล้วให้ถือว่าพิมพ์ผิดเสมอ · 0a5f1c ↔ #0e5424**)
//   8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05 06220a a87a08 f2c230 ffe066
//   (**KINGKONG555 — bde397 ↔ #9dc2a5 · 1a5c04 ↔ #1e7033**)
//   1fae1c 0d2312 143a1c 07130a e8e4c6 cf1111 e01f26 (**888PARUAY — 143a1c ↔
//   #073c1a**) · 117a41 2bb061 2fbf6a (**MEXICANOSLOT/KOON234 — 2bb061 ↔ #3ddc4a**)
//   7a1bd6 2b3fd9 c2178b f23bb4 bb6dff 7aa7ff 5411c4 241046 6b4a86 f8e6f9 f6edfe
//   ece0fb dcc6f4 9a6fd0 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 (**ZANE96**)
//   2a1206 1a0c04 2b1608 7a3a0c fff3e0 e0b784 fffbf0 fff4e0 ffe9c7 f3d9a8 c98a24
//   c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 e8a000 ff8a2b d8dde6 (**ZNOVA168**)
//   de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 2b100a fdeee2 e8c6ae fed7b5
//   fec28d f6c4a4 fde4d3 fff3ea fef6fb f2543f (**MEXICANOSLOT — e8c6ae ↔ #e8c86a**)
//   fb2e33 cb0b0d d81115 b00d11 8a0608 ff2e52 e01238 c9102f c30303 8f0505 e81313
//   dc0203 f5282a (แดงของแบรนด์เก่า) · ffd6fa fff4fb ffe3f5 f9b2d9 9c0f55 fb439b
//   d91a73 b01160 85094a (okkub88) · 00bfff 12b4ef 06283f 0f5684 1a6ea8 (โบ๊ะบ๊ะ168)
// ⚠️ ทอง/เหลือง/ครีม/เทาเงินของแบรนด์เก่ากว่านั้น (**ทองกับเงินเป็นวัสดุรองของรอบนี้
//   จริง จึงต้องเทียบเท่ากัน**): ffd84d f5ba14 fcee52 b37c0b eeae12 fded41 9f600d
//   fcd434 ffeaa0 fcd45c fdcb0c fefb6b fee45d e6a416 fef54b f7c92b ffe6a3 d4922c
//   fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429 ffc82e e0bd72 f6e4b4 d4af5a eab308
//   f5c53d ece2cc dcb95f f0c878 f0b46a fbc134 ffe87a cf9a18 fcdc2b fff6ae a87d0c
//   fadc64 fdf3b4 e0b03a e3b23c · f4e4d3 e4cbb3 ecd5c4 d2b9a4 bfb8aa e8eaee b4b9c2
//   6b7079 e0e0df c0c0bf a1a09e e8ecf1 a8b2bf 78828f d9c9a6 cfd6e3 f3f6fa
//   (⚠️ **f0c878 / e3b23c ↔ #e8c86a · cfd6e3 / e8eaee / d8dde6 ↔ #dfe6e3**)
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/แมเจนต้า ไม่มีแดง ไม่มีส้ม
// และไม่มีผิวสว่างทั้งหน้า** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีด
// อยู่ไฟล์อื่น คงไว้ **ห้ามกลืนเข้าพาเลตเขียวของรอบนี้ แม้รอบนี้แบรนด์จะเขียวก็ตาม**)
//
// **ห้ามใส่ `text-center` บนการ์ดหรือบน <section>** — มันตกทอดเข้าไปจัดกึ่งกลาง
// ย่อหน้าในสล็อต
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#1e7033] bg-[#073c1a] p-8 text-left text-base leading-relaxed text-[#eef7f0] shadow-[0_12px_34px_rgba(1,13,4,0.5)] transition-all duration-500 hover:border-[#35a043] hover:shadow-[0_18px_44px_rgba(61,220,74,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#3ddc4a]/18 blur-[62px] transition-all duration-500 group-hover:bg-[#3ddc4a]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e8c86a]/18 blur-[62px] transition-all duration-500 group-hover:bg-[#e8c86a]/30">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#0e5424] to-[#1e7033] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white shadow-[0_8px_22px_rgba(1,13,4,0.5)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#3ddc4a] via-[#e8c86a] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
