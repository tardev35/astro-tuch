---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่
// จากผิวการ์ดดำอมม่วง #170a22 ลงไปหาพื้นเพจ #08020d ในกรอบชมพูลึก #7d1550 ที่สว่าง
// ขึ้นเป็นชมพูแบรนด์ #fa42b5 ตอน hover ออร่าสองมุมแยกด้วยคู่สีของโลโก้จริง คือชมพู
// บานเย็น #fa42b5 กับม่วงแบรนด์ #8b3df3 แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ตามลำดับ
// ตัวอักษรบนเวิร์ดมาร์ก SEXYGAME666 คือชมพูอ่อน #ffd6f0 → ชมพูแบรนด์ #fa42b5 →
// ม่วงแบรนด์ #8b3df3 ตรงกับ SEXY ที่เป็นชมพู GAME ที่ไล่ไปม่วง แล้ว 666 ที่กลับมา
// เป็นชมพู เนื้อความ #f2dcee (BRAND_TEXT) — ชุดทองเมทัลลิก-โครเมียมของ PKG44
// (#fdd32a #ffe27a #c8920a #c2c8d0 #f2f4f7 #4a3a12 #12100a #080602 #efe6d2)
// ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7d1550]/70 bg-gradient-to-br from-[#170a22]/94 to-[#08020d]/96 p-8 text-left text-base leading-relaxed text-[#f2dcee] shadow-[0_10px_30px_rgba(8,2,13,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fa42b5]/75 hover:shadow-[0_15px_40px_rgba(250,66,181,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fa42b5]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffa6dd]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8b3df3]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#8b3df3]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a0e33]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd6f0] via-[#fa42b5] to-[#8b3df3] shadow-[0_0_10px_rgba(250,66,181,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffd6f0] via-[#fa42b5] to-[#8b3df3] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
