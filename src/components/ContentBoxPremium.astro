---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ebbb4a]/40 bg-gradient-to-br from-[#240607]/92 to-[#0a0202]/90 p-8 text-left text-base leading-relaxed text-[#efe3d2] shadow-[0_10px_30px_rgba(200,17,24,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebbb4a]/75 hover:shadow-[0_15px_40px_rgba(235,187,74,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c81118]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#f5333c]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ebbb4a]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fbe289]/28"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ebbb4a]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbe289] via-[#ebbb4a] to-[#7a0d10] shadow-[0_0_10px_rgba(235,187,74,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#f5333c] via-[#ebbb4a] to-[#fbe289] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
