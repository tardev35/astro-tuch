---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1687c9]/50 bg-gradient-to-br from-[#04223f]/92 to-[#01050b]/92 p-8 text-left text-base leading-relaxed text-[#cfe7f2] shadow-[0_10px_30px_rgba(1,5,11,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#1687c9]/85 hover:shadow-[0_15px_40px_rgba(22,135,201,0.34)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1687c9]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#22b8e8]/36"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4bdbee]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#9df1ff]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1687c9]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4bdbee] via-[#9df1ff] to-[#1687c9] shadow-[0_0_10px_rgba(75,219,238,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#eafcff] via-[#4bdbee] to-[#1687c9] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
