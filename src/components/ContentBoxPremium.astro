---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#cfd4da]/45 bg-gradient-to-br from-[#1c1f24]/92 to-[#0a0b0d]/90 p-8 text-left text-base leading-relaxed text-[#dfe4ea] shadow-[0_10px_30px_rgba(10,11,13,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#cfd4da]/80 hover:shadow-[0_15px_40px_rgba(207,212,218,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cfd4da]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#f4f6f8]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8d1420]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#c02434]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#cfd4da]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c02434] via-[#f4f6f8] to-[#5b636b] shadow-[0_0_10px_rgba(207,212,218,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f4f6f8] via-[#cfd4da] to-[#c02434] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
