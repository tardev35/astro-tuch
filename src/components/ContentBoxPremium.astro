---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอป 2026-10-23 **ไม่มีรูปประกอบบทความของแบรนด์นี้เลย**
// (banner2.png / banner3.png mtime 18:43 เป็นของแบรนด์ก่อน และ eager import = emit
// ขึ้น dist ทุก build) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook
// ตรึง slide* ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้
// ถูกใช้ครบสองใบแล้วที่ §4 กับ §5
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-slot168.md §2
// **แดงเจลมันวาวเป็นฮิวนำ · ขาว/มุกอุ่นเป็นวัสดุที่สอง · บนดำอมแดงเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-ฟ้าอะซัวร์บนน้ำเงินเที่ยงคืนของ
// มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมมืด แต่คนละฮิว**: bg.json
// ของดรอปนี้คือ {"mode":"color","color":"#140000"} = **ดำอมแดงเข้มมาก** ไม่ใช่
// น้ำเงิน **ห้าม "แก้" การ์ดใบนี้ให้เป็นพื้นสว่าง และห้ามเหลือฟ้า/น้ำเงินไว้เลย
// สักเฉด** — ฟ้าเป็นวัสดุที่สองของแบรนด์ก่อน ไม่ใช่ของรอบนี้
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้จริง: โลโก้คือคำว่า **สล็อต168 ตัวอักษรเจลแดงสาม
// มิติมันวาว ไฮไลต์ขาวสเปกคูลาร์ มีมงกุฎเล็กประดับหัวใจแดงบนตัวแรก** แบนเนอร์เป็น
// **สตูดิโอพื้นขาว ผู้หญิงคาร์ดิแกนแดงถือโทรศัพท์โชว์ตารางเกมสล็อต** สไลด์เป็น
// **สตูดิโอดำสนิท แคปซูลดำขอบแดง 0.3% / 0.8%**
// ⚠️ **คาร์ดิแกนแดง เสื้อกล้ามขาว พื้นสตูดิโอขาว สีผิวนักแสดง และมงกุฎทองเล็ก
// เป็นวัตถุในภาพ ไม่ใช่สี UI** — รอบนี้จึงไม่มีทอง ไม่มีครีม ไม่มีพีช ไม่มีเบจ
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #1c0607 · ชั้นจม #0b0000 · ชั้นยก #2a0c0d · พื้นเพจ #140000
//   แผ่นถมหัวข้อ = ไล่ **#d81115 → #b00d11 บนหมึกขาว** ซึ่งเป็นครึ่งบนของสูตร
//     "CTA หลัก" ใน §2 (ขาวบน #d81115 = 5.2:1 · บน #b00d11 = 7.2:1)
//     ⚠️⚠️ **ไล่เฉดไม่ลากขึ้นไปถึง #fb2e33 โดยตั้งใจ** — §2 ระบุตรงๆ ว่า
//     **ห้ามวางหมึกขาวบน #fb2e33 (3.8:1)**
//   แดงเจล #fb2e33 = ต้นของเส้นใต้หัวข้อ (ถือตัวอักษรได้ 5.1:1 บนผิวการ์ดนี้
//     แต่ในไฟล์นี้หัวข้ออยู่บนแผ่นถมแล้ว จึงสงวนค่านี้ไว้ให้ <strong> ของหน้าเพจ)
//   แดงลึก #cb0b0d = ออรามุมบนซ้าย · กลางเส้นใต้ — **พื้นถม ห้ามถือตัวอักษร**
//   แดงลึกสุด #8a0608 = ออรามุมขวาล่าง — **พื้นถม ห้ามถือตัวอักษร**
//   เส้น/ขอบ #551c1e — **ห้ามถือตัวอักษร**
//   หมึก #f0e6e4 = เนื้อความ (= BRAND_TEXT) 16.0:1 บนผิวการ์ดนี้
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(216,17,21,α) · rgba(240,230,228,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบพร้อมหมึกขาว + เส้นใต้เต็ม
// ความกว้าง** ส่วนใบอื่นใช้ §2 ไล่เฉดสองสต็อปจัดกึ่งกลางบนเส้นคาด · §3 ไล่เฉดสาม
// สต็อปชิดซ้ายพร้อมแถบตั้ง บนการ์ดมุมตัด 30px · §4 ทึบแดงชิดซ้ายพร้อมขีดสั้นใต้
// หัวข้อ · §5 ชิปถมแดงคู่กลีฟ บนการ์ดมุมตัด 36px · §6 หัวข้อคร่อมเส้นคู่บน-ล่าง ·
// §7 สันซ้ายสี่พิกเซล บนการ์ดมุมตัด 40px · §8 ทึบจัดกึ่งกลางพร้อมขีดใต้จางสองข้าง
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — และรอบนี้เป็นแบรนด์แดงจริง จึงต้อง
// เทียบแดงของแบรนด์อื่นทีละหลัก** แดงรอบนี้คือ **#fb2e33 (R251 G46 B51) /
// #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น ค่าที่ห้ามเหลือ:
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (**มาดาม168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd94a e3a712 9d6f06 b07d08 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16
//   3d3425 f3ece0 bfb8aa (**รวย168 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด**
//   ⚠️ 1c1a16 ของรอบก่อนห่างจาก 1c0607 ของรอบนี้แค่ G/B — ต้อง grep ทีละค่า) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B — ⚠️ fb141b ห่าง #fb2e33 หนึ่งก้าว
//   และ 8a0609 ห่าง #8a0608 หนึ่งก้าว **เจอค่าพวกนี้แปลว่าพิมพ์ผิด**) ·
//   b3121b 5a0a0e f2bba5 c98a74 (ขวัญใจ168) · c30303 8f0505 e81313 4a0f0f ffdbdb
//   fff1ef ffeee8 (รวยแท้168) · eb0305 e40303 c20305 9b0a0c ff4446 (โปรดี168) ·
//   fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16 (ดวงเศรษฐี168) · fb1b32
//   ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) · d30304 a00203 ff6b6e (รับตัง168) ·
//   dc0203 f5282a (หวย365) · ff3b14 6d0804 2b0000 (FLASH877)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าใน
// src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#551c1e] bg-[#1c0607] p-8 text-left text-base leading-relaxed text-[#f0e6e4] shadow-[0_12px_34px_rgba(0,0,0,0.6)] transition-all duration-500 hover:border-[#fb2e33] hover:shadow-[0_18px_44px_rgba(251,46,51,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#cb0b0d]/30 blur-[62px] transition-all duration-500 group-hover:bg-[#cb0b0d]/45">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8a0608]/40 blur-[62px] transition-all duration-500 group-hover:bg-[#8a0608]/60">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#d81115] to-[#b00d11] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white shadow-[0_8px_22px_rgba(138,6,8,0.55)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#fb2e33] via-[#cb0b0d] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
