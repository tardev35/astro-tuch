---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// HENG38 (รอบมรกต-ทอง 2026-09-22): การ์ดไล่จากพื้นยก #0a2d16 ลงไปหาพื้นการ์ด
// #061f0f ในกรอบทองหลัก #f3cf63 หัวข้อมีแถบทองแนวตั้งนำหน้าและเส้นคั่นมรกตกลาง
// #0f4423 ใต้หัวข้อ ซึ่งเป็นรูปทรงที่ต่างจาก ContentBox ตัวหลัก (เส้นทองพาดขอบบน
// + ขีดสั้นใต้หัวข้อ) เพราะหน้าแรกวางสองการ์ดนี้ไว้ในหน้าเดียวกัน ออร่าสองมุมเป็น
// ทองหลักกับมรกตสด #15833c ตามมงกุฎทองบนตรามรกตของโลโก้ — แบรนด์นี้มีสองสีจริง
// จึงแยกชั้นด้วยคู่ทอง/เขียว ไม่ใช่ด้วยความสว่างอย่างรอบก่อน ชุดดำ-ทองของรอบก่อน
// (#1c1710 #12100b #ecc55c #5e4418 #fefac4 #a3732c #ece1cb) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f3cf63]/45 bg-gradient-to-br from-[#0a2d16]/94 to-[#061f0f]/96 p-8 text-left text-base leading-relaxed text-[#e6e2d2] shadow-[0_10px_30px_rgba(3,20,10,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbeeb0]/70 hover:shadow-[0_15px_40px_rgba(243,207,99,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f3cf63]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#f3cf63]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#15833c]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#1faa4e]/38">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0f4423] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] shadow-[0_0_10px_rgba(243,207,99,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
