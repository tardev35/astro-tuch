---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#62ae2d]/45 bg-gradient-to-br from-[#122008]/92 to-[#060a04]/90 p-8 text-left text-base leading-relaxed text-[#dbe5d3] shadow-[0_10px_30px_rgba(4,8,3,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#62ae2d]/80 hover:shadow-[0_15px_40px_rgba(98,174,45,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#62ae2d]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#a8e37c]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a6320]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#d9b95c]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#62ae2d]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d9b95c] via-[#a8e37c] to-[#2f6a0c] shadow-[0_0_10px_rgba(98,174,45,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f2f8ec] via-[#8fd45e] to-[#d9b95c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
