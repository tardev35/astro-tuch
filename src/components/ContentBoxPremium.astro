---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H1 ของหน้า จึงเป็นการ์ดที่หนักแน่นที่สุดในหน้า
// และเป็นใบเดียวที่หัวข้อขึ้นที่ text-3xl
//
// ไฟล์นี้ต้องไม่อ่านเป็นใบเดียวกับ ContentBox (หัวข้อ 24 ชั่วโมง) และ
// ContentBoxNeumorphism (หัวข้ออัตราการจ่าย) ที่อยู่หน้าเดียวกัน จึงแยกด้วยรูปทรง:
// สันตั้งไล่แดงหน้าหัวข้อ + ผิวการ์ดไล่เฉดจากผิวยก #211016 ลงไปหาพื้นลึกสุด #0d0407
// (ContentBox เป็นผิวทึบ ส่วน Neumorphism เป็นแผ่นนูนเงาคู่)
// และหัวข้อไล่ทอง #f3c54e → เงินสว่าง #eef0f4 → แดงแบรนด์ #dc0409 ซึ่งเป็นลำดับสี
// คนละชุดกับอีกสองใบ (ContentBox ไล่เงินสว่าง → เงินกลาง → แดงสว่าง,
// Neumorphism ไล่แดงแบรนด์ → เงินกลาง → เงินสว่าง) — ทองนำหน้าเพราะมงกุฎทอง
// ในโลโก้อยู่เหนือตัวอักษร ตรงกับลำดับที่ตาเห็นบนโลโก้จริง
//
// กรอบแดงแบรนด์ #dc0409 สว่างขึ้นเป็นแดงสว่าง #f5363d ตอน hover ออร่ามุมซ้ายบน
// เป็นแดงแบรนด์ มุมขวาล่างเป็นเงินกลาง #c3c7d1 (คำว่า "หวย" ในโลโก้เป็นโครเมียม)
// เส้นใต้หัวข้อเป็นแดงดำ #4b0205 เนื้อความ #edeaf0 (= BRAND_TEXT)
// glow ทุกจุดเป็น rgba(220,4,9,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #0c0b0a #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…))
// ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#dc0409]/55 bg-gradient-to-br from-[#211016]/96 to-[#0d0407]/96 p-8 text-left text-base leading-relaxed text-[#edeaf0] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5363d]/80 hover:shadow-[0_15px_40px_rgba(220,4,9,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#dc0409]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#f5363d]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c3c7d1]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#eef0f4]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4b0205] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5363d] via-[#dc0409] to-[#8e0206] shadow-[0_0_10px_rgba(220,4,9,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f3c54e] via-[#eef0f4] to-[#dc0409] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
