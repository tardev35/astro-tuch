---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the two
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// This card carries docx H1 §1 of the home page (content.txt line 4) — one
// paragraph, one slot, no sub-headings, no FeatureHighlights this round and no
// illustration inside the card, because this drop has no current-brand article
// image (banner2/banner3 on disk are previous brands' art; an eager import IS
// an emit, so importing one would ship it into dist/).
//
// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13, brand-spec §2):
// งานอาร์ตรอบนี้อ่านตรงๆ ได้ว่าโลโก้คือคำว่า TSDET เป็นตัวอักษรสามมิติสีเงินโครเมียม
// ขัดเงา ต่อด้วยเลข 911 สีน้ำเงินไฟฟ้า มีเครื่องหมายปีกเหยี่ยว/สวูชสีน้ำเงินอยู่ด้าน
// ซ้ายของคำ แบนเนอร์และสไลด์ทั้งสองใบเป็นฉากสตูดิโอสีดำที่ส่องด้วยริบบิ้นแสงน้ำเงิน
// และแฟลร์เลนส์สีฟ้า มีชายหนุ่มและหญิงสาวผมสีขาวเงินในชุดดำ-ขาว ชิปคาสิโนน้ำเงินสลับ
// เงิน ไพ่เอซดำ-เงิน และวงล้อรูเล็ตขอบโครเมียม
// ⚠️ **รอบนี้ไม่มีทองที่ไหนเลย** เป็น **สองโทนจริง: น้ำเงินไฟฟ้านำ เงินโครเมียมรอง**
// ⚠️ พื้นเพจเป็นกรมเกือบดำ #00081f (bg.json) ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง
// (ใบนี้ไล่จากกลางลงไปหาจม) / #040e26 จม / #00081f พื้น — ไม่มีชั้นไหนจมต่ำกว่าพื้น
//
// ใบนี้เป็นการ์ดมุมกลม rounded-3xl ไล่ผิวจาก **กลาง #0a1c42 ลงไปหาจม #040e26** จึง
// ไม่อ่านเป็นใบเดียวกับ ContentBox (§3) ที่เป็นมุมกลมเหมือนกันแต่เป็นผิวยก #102a5e
// ทึบ และต่างจาก ContentBoxTwoNeumorphism (§2) ที่ตามมาทันทีทั้งมุม (rounded-[30px]
// นูน) ผิว (ยก) และเงา (ไม่มีกรอบ มีแต่คู่เงานูน)
// หัวข้อไล่ ฟ้าสว่าง #6ec8ff → เงินโครเมียมสว่าง #cfdcec → ฟ้าอ่อน #4fb4ff ซึ่งเป็น
// ลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ และทุกสตอปอ่านออกบนผิวมืด
// (#4fb4ff = 6.0:1 · #6ec8ff = 7.4:1 · #cfdcec = 10.6:1)
// ออรามุมซ้ายบนเป็นน้ำเงินแบรนด์ #0360f3 (เลข 911 และปีกเหยี่ยว) มุมขวาล่างเป็น
// น้ำเงินลึกสุด #041a43 (เงาใต้กองชิป) ที่อิ่มขึ้นเป็น #032dad ตอน hover
// เส้นใต้หัวข้อเป็นน้ำเงินลึก #04186e เนื้อความขาวอมฟ้า #dde8f7 (= BRAND_TEXT,
// ~15:1 บนผิวกลาง และสูงกว่านั้นบนครึ่งล่างของไล่เฉด) glow ทุกจุดเป็น
// rgba(3,96,243,α) หรือ rgba(2,146,251,α)
// §2 ห้าม #0360f3 #0292fb #032dad #04186e #041a43 ถือตัวอักษรทุกขนาด — ในไฟล์นี้
// ทั้งห้าค่าอยู่ที่ขอบ เส้น และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ไฟล์นี้เพิ่งถือชุดทองมังกรของ TND168 มา
// ทั้งไฟล์ (#dfa310 #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02 #1b1307 #120c04
// #070502) ก่อนหน้านั้นเป็นชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a
// #f7e4c0) และชุดม่วงราชา-ทองของ KMD88 ที่กำลังออกรอบนี้ (#7505cc #b453ff #c07cff
// #d9b8ff #3a0565 #2c0349 #1d0832 #140522 #0a0213 #e2b33f #ffd45e #ffdf8c #ece2f8
// #bba8d4 #1a0526 #7a5a0a) — ออกครบทุกค่าแล้ว
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว ไม่มีส้ม และไม่มีแดงเลย** และ
// เงินโครเมียมของรอบนี้ (#cfdcec / #9db4d4) ไม่ใช่เทาอมฟ้า #b9c2cc / #464f5a ของ
// UFA324 หรือ #cfd6e3 / #9aa6bb / #3f4859 ของ NAZA168 — เทียบเป็นตัวเลขทีละค่า
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0360f3]/60 bg-gradient-to-br from-[#0a1c42]/96 to-[#040e26]/96 p-8 text-left text-base leading-relaxed text-[#dde8f7] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#0292fb]/90 hover:shadow-[0_15px_40px_rgba(3,96,243,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0360f3]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#0292fb]/46">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#041a43]/80 blur-[55px] transition-all duration-500 group-hover:bg-[#032dad]/45">
    </div>

    {
      title && (
        <header class="mb-6 border-b border-[#04186e] pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#6ec8ff] via-[#cfdcec] to-[#4fb4ff] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
