---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่
// จากผิวการ์ด #12100a ลงไปหาพื้นเพจ #080602 ในกรอบทองลึก #4a3a12 ที่สว่างขึ้นเป็นทอง
// แบรนด์ #fdd32a ตอน hover ออร่าสองมุมแยกด้วยคู่โลหะของโลโก้จริง คือทองลึก #c8920a
// กับเงินโครเมียม #c2c8d0 แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ตามลำดับโลหะบนเวิร์ดมาร์ก
// PKG44 คือทองสว่าง #ffe27a → ขาวโครเมียม #f2f4f7 → ทองลึก #c8920a ตรงกับ P ที่เป็น
// ทอง K ที่เป็นเงิน แล้ว G44 ที่กลับมาเป็นทอง เนื้อความ #efe6d2 (BRAND_TEXT) — ชุด
// ทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b #d9a62b #fcfcfc #d2d3d4 #8c5f14
// #14100a #050403 #e8e6e1) ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#4a3a12]/60 bg-gradient-to-br from-[#12100a]/94 to-[#080602]/96 p-8 text-left text-base leading-relaxed text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32a]/75 hover:shadow-[0_15px_40px_rgba(253,211,42,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c8920a]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffe27a]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c2c8d0]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#c2c8d0]/26">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a3a12]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] shadow-[0_0_10px_rgba(253,211,42,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
