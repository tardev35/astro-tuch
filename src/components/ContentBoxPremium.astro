---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b5216]/80 bg-gradient-to-br from-[#17120a]/92 to-[#050403]/94 p-8 text-left text-base leading-relaxed text-[#e9ddc4] shadow-[0_10px_30px_rgba(5,4,3,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4c25a]/75 hover:shadow-[0_15px_40px_rgba(228,194,90,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e4c25a]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#e4c25a]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c9c9c9]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#c9c9c9]/28">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b5216]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] shadow-[0_0_10px_rgba(228,194,90,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
