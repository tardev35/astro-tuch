---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02): เว็บแทงหวยออนไลน์ โลโก้เป็นเวิร์ดมาร์กแดงสดล้วน
// บนพื้นขาว คำว่า "หวย" กับเลข 6 เป็นแดงสด #dc0203 ส่วนเลข 3 กับ 5 เป็นดำ งานอาร์ตเป็น
// ผ้าซาตินแดงเข้มกับลายไทยทอง เหรียญทอง และลูกหวยแดง-ขาว แบรนด์นี้จึงเป็นแดงนำ ทองรอง
// การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่จากผิวการ์ด #240406 ลงไปหาผิวแถบ #180303 ในกรอบทอง
// #ffc93c ที่สว่างขึ้นเป็นทองอ่อน #ffeab0 ตอน hover ออร่าสองมุมแยกหน้าที่ตามคู่สีของโลโก้
// คือทองมุมซ้ายบนและแดงแบรนด์ #dc0203 มุมขวาล่าง แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่
// ทองอ่อน #ffeab0 → ทอง #ffc93c → แดงแบรนด์ #dc0203 เนื้อความ #f6e7e0 (BRAND_TEXT)
// — ชุดแดง-ทองของ หวยเฮง24/หวยเฮง789 (#e0a52a #fdea83 #8b0302 #c01616 #2e0707
// #1a0505 #720202 #f6e6cf #dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ffc93c]/55 bg-gradient-to-br from-[#240406]/94 to-[#180303]/96 p-8 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffeab0]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#ffeab0]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/32 blur-[55px] transition-all duration-500 group-hover:bg-[#f5282a]/38">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#9c0201] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#dc0203] shadow-[0_0_10px_rgba(255,201,60,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
