---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// UVO88 palette: near-black emerald base (#071f10 -> #010905) inside a deep
// green border (#0a3b1c / #0f9d47). The heading gradient is GOLD here
// (#ffe08a -> #f2c230 -> #a9791a) rather than green — this is the "premium"
// shape of the family and the gold is what separates it at a glance from the
// plain ContentBox, whose heading stays green. The two aura blooms are
// deliberately two-tone — emerald top-left, coin gold bottom-right — so the
// card carries the artwork's green-and-gold pairing rather than a single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0a3b1c]/70 bg-gradient-to-br from-[#071f10]/92 to-[#010905]/94 p-8 text-left text-base leading-relaxed text-[#c8e3d0] shadow-[0_10px_30px_rgba(2,13,7,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#0f9d47]/80 hover:shadow-[0_15px_40px_rgba(15,157,71,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0f9d47]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#57dd8f]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f2c230]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#f2c230]/24">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0a3b1c]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f2c230] to-[#a9791a] shadow-[0_0_10px_rgba(242,194,48,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe08a] via-[#f2c230] to-[#a9791a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
