---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// OSAKA198 palette: black-lacquer base (#0b0906 / #141210 / #1c1509), warm gold
// borders (#a37c4b / #d1ae72) and a gold heading gradient
// (#e4cc95 -> #d1ae72 -> #a37c4b), with brushed silver kept for the two-tone
// accents elsewhere on the page.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a37c4b]/55 bg-gradient-to-br from-[#1c1509]/92 to-[#0b0906]/94 p-8 text-left text-base leading-relaxed text-[#e8ddc8] shadow-[0_10px_30px_rgba(11,9,6,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#d1ae72]/75 hover:shadow-[0_15px_40px_rgba(209,174,114,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d1ae72]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#d1ae72]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a37c4b]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#e4cc95]/32">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a37c4b]/50 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e4cc95] via-[#d1ae72] to-[#a37c4b] shadow-[0_0_10px_rgba(209,174,114,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#e4cc95] via-[#d1ae72] to-[#a37c4b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
