---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7e5f1f]/80 bg-gradient-to-br from-[#031234]/92 to-[#00081f]/94 p-8 text-left text-base leading-relaxed text-[#dbe4f5] shadow-[0_10px_30px_rgba(0,4,18,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#d0a63a]/75 hover:shadow-[0_15px_40px_rgba(233,197,93,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e9c55d]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#e9c55d]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5ec2f5]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#5ec2f5]/28">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7e5f1f]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] shadow-[0_0_10px_rgba(233,197,93,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
