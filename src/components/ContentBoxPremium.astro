---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// WIN8S palette: near-black base (#050201 / #1c0a02 / #2a0f03), orange borders
// (#8a3103 / #f36403) and an orange heading gradient
// (#fd9a1e -> #f36403 -> #8a3103), with chrome silver kept for the two-tone
// accents elsewhere on the page.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a3103]/70 bg-gradient-to-br from-[#2a0f03]/92 to-[#050201]/94 p-8 text-left text-base leading-relaxed text-[#f6e4d6] shadow-[0_10px_30px_rgba(5,2,1,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f36403]/80 hover:shadow-[0_15px_40px_rgba(243,100,3,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f36403]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#f36403]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a3103]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#fc8d13]/32">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a3103]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fd9a1e] via-[#f36403] to-[#8a3103] shadow-[0_0_10px_rgba(243,100,3,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fd9a1e] via-[#f36403] to-[#8a3103] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
