---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน**
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit) จึงไม่มี
// รูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม .claude/brand-spec-tonchua168.md §2
// งานศิลป์: โลโก้เป็นแมวการ์ตูนขาว-ชมพูหน้ายิ้มหลับตา นั่งคู่มือถือจอชมพูที่มีลูกศร
// ดาวน์โหลดและปึกแบงก์ชมพู เหนือคำว่า "ถอน" ตัวอักษรไทยหนาสามมิติ **สีทองเนย**
// ตัดขอบชมพู ต่อด้วย "ชัวร์168" **สีชมพูบับเบิลกัม** ตัดขอบทอง ล้อมด้วยหัวใจชมพู
// และประกายดาวทอง
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0f20 ยก / #1a0914 กลาง /
// #0d040a จม / #000000 พื้น — การ์ดใบนี้ไล่จากยกลงไปจม
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่ **พลิกขั้วหัวข้อ** — หัวข้อนั่งบน **แผ่นถมสว่างทึบ**
// ที่ไล่ชมพูอ่อน #ffb3de → ชมพูบับเบิลกัม #fa63b9 → ทองเนย #ffd84d แล้วถือ
// **หมึก #2a0617** ซึ่ง §2 ระบุว่าเป็นหมึกตัวเดียวที่วางบนพื้นถมชมพู/ทองได้
// (7.0:1 บน #fa63b9 · 13.4:1 บน #ffd84d และสูงกว่านั้นบน #ffb3de — ทั้งสามปลาย
// ปลอดภัย **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ส่วนอีกเจ็ดใบของหน้าเป็นตัวอักษร
// สว่างบนพื้นมืดทั้งหมด
// มุม rounded-[28px] กรอบหนา 2px ชมพูบับเบิลกัม (อิ่มเป็นทองเนยตอน hover) ออรามุม
// ซ้ายบนเป็นพลัมเข้ม #6d0b3f (ริบบิ้นซาตินชมพูในงานศิลป์) มุมขวาล่างเป็นทองลึก
// #6b4708 ที่ไต่ขึ้นเป็นชมพูอ่อนตอน hover เนื้อความ #fdeaf5 (= BRAND_TEXT, 15.3:1
// บนผิวยก)
// §2 ห้าม #6d0b3f (1.5:1) และ #6b4708 (2.1:1) ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสอง
// ค่าอยู่ที่ขอบ ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" และ **รอบนี้กับดักมีสองชั้น: ชมพู และ ทอง**
// เพราะรอบที่แล้ว (มีโชค168) ก็ทอง+ชมพูบนดำเหมือนกัน ต่างกันที่ **ใครนำและค่าอะไร**:
// รอบก่อน ทองนำ fcd434 ชมพูบานเย็น f5469f เป็นตัวรอง — รอบนี้กลับด้าน
// ชมพูบับเบิลกัม **#fa63b9** (R=250 G=99 B=185) นำ ทองเนย **#ffd84d** (R=255 G=216
// B=77) เป็นตัวรอง
// ค่าของแบรนด์ก่อนที่ต้องไม่เหลือ: fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612
// f6e4ee 24101c 160a12 0b0509 (มีโชค168) · f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e
// 8a5f12 eadfce 140c06 241509 160d06 0b0603 (ขวัญใจ168) · f0b429 ffdc8c d30304
// ff6b6e (รับตัง168) · e3b23c fa0513 (สมหวัง168) · f41571 ff5ca8 (PUNPRO168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#fa63b9]/70 bg-gradient-to-br from-[#2b0f20] via-[#1a0914] to-[#0d040a] p-8 text-left text-base leading-relaxed text-[#fdeaf5] shadow-[0_12px_34px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd84d]/80 hover:shadow-[0_18px_44px_rgba(250,99,185,0.32)] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#6d0b3f]/55 blur-[62px] transition-all duration-500 group-hover:bg-[#6d0b3f]/75">
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#6b4708]/80 blur-[62px] transition-all duration-500 group-hover:bg-[#ffb3de]/26">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#ffb3de] via-[#fa63b9] to-[#ffd84d] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#2a0617] uppercase shadow-[0_8px_24px_rgba(250,99,185,0.4)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#6b4708] via-[#6d0b3f] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
