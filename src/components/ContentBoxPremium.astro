---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2.png mtime 10-08 / banner3.png 09-27 เป็นของแบรนด์ก่อน และ eager import
// = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// พักยก168 (2026-10-22) — พาเลตตาม .claude/brand-spec-pakyok168.md §2
// ⚠️⚠️ **รอบนี้เป็นธีมมืด ส่วนรอบก่อน (สบาย168) เป็นธีมสว่างฟ้าพาสเทล** bg.json ของ
// ดรอปนี้คือ {"mode":"color","color":"#291d0f"} = น้ำตาลกาแฟเข้ม และ bg.json เป็น
// แหล่งเดียวของพื้นเพจ **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนเป็นแบบนั้น**
// งานศิลป์: โลโก้เป็นหัวมังกรจีนทองสามมิติหันซ้าย ตามด้วยคำว่า "พักยก" ตัวอักษรไทย
// สามมิติผิวทองมันวาว และเลข "168" ผิวโครเมียมเงิน — สองวัสดุคู่กัน แบนเนอร์/สไลด์
// เป็นห้องนิรภัยทองคำ ประตูเซฟวงกลมทองเหลือง ชั้นวางทองคำแท่ง ชายสูทดำแว่นกันแดด
// ถือซิการ์บนโซฟาหนัง หีบสมบัติ มงกุฎทอง ปึกธนบัตร และกองเหรียญทอง
// ⚠️ สีผิวนักแสดง สูทดำ หนังโซฟาน้ำตาล และอัญมณีแดงบนมงกุฎเป็น **วัตถุในภาพ
// ไม่ใช่สีแบรนด์**
//
// บทบาทสีในไฟล์นี้ (ลำดับผิว: #3a2713 ยก · #32200f กลาง · #1f1308 จม · #291d0f เพจ):
//   ทองสว่าง #fded41 = ต้นแผ่นถมหัวข้อ · ขอบตอน hover · ออรา · ต้นเส้นใต้หัวข้อ
//     (11.7:1 บนผิวการ์ด)
//   ทองแกน #eeae12 = ขอบการ์ดปกติ · สต็อปกลางของแผ่นถม (7.2:1 ถือตัวอักษรได้)
//   ทองลึก #9f600d = ปลายของแผ่นถมหัวข้อ (**2.8:1 — ห้ามถือตัวอักษร** ที่นี่เป็น
//     พื้นถม และหมึก #1f0f04 ที่วางทับยังได้ 4.9:1 ที่ขนาด text-2xl/3xl font-black
//     ซึ่งนับเป็น large text เกณฑ์ 3:1)
//   หมึกเข้ม #1f0f04 = ตัวอักษรบนแผ่นถมทอง (15.4:1 บน #fded41 · 9.5:1 บน #eeae12)
//     ⚠️ §2 ห้ามขาวบนทองทุกกรณี
//   โครเมียมสว่าง #e0e0df = ออรารอง (สีที่สองของรอบนี้ มาจากเลข "168" ในโลโก้)
//   หมึกไอวอรี #f4ead6 = เนื้อความ (= BRAND_TEXT) 11.9:1 บนผิวการ์ด
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีเจ็ดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทองทึบ** ไล่สามสต็อป
// #fded41 → #eeae12 → #9f600d พร้อม **หมึกเข้ม #1f0f04** ซึ่งเป็นสูตรปุ่ม CTA หลัก
// ของ §2 ตรงๆ กล่องอื่นบนหน้าเดียวกันใช้หัวข้อแบบ: §2 ไล่ ทอง→โครเมียม→ทอง แบบ
// clip-text จัดกลาง · §3 ทองสว่างทึบบนสันซ้ายหนาสี่พิกเซลในกรอบมุมตัดเฉียง ·
// §4 ไล่ ทองสว่าง→ทองแกน แบบ clip-text สองสต็อป · §5 โครเมียมสว่างทึบคู่กลีฟ ✦ ·
// §6 ทองสว่างทึบพร้อมเส้นใต้สั้น (ContentBox ตัวฐาน) · §7 ไล่ โครเมียม→ทอง→โครเมียม
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอทองในไฟล์จึงไม่พิสูจน์อะไรเลย ทองรอบนี้คือ **#eeae12 (R238 G174 B18)**
// เป็นสีอัตลักษณ์ และ **#fded41 (R253 G237 B65)** เป็นทองสว่างสำหรับตัวอักษร
// ⚠️ เพื่อนบ้านที่ใกล้ที่สุด: e6a416 (ยูฟ้า168) ห่าง R8/G10/B4 · e5a81b (UFA324)
// ห่าง R9/G6/B7 · fef54b (นินจา168) ห่าง R1/G8/B10 จาก #fded41 · fee45d (ยูฟ้า168)
// ห่าง R1/G9/B28 — **ทั้งสี่ใกล้กว่าที่รีโปนี้ยอมตามปกติ จึงต้อง grep ทีละค่า**
// ⚠️ โครเมียมรอบนี้ #e0e0df #c0c0bf #a1a09e เป็น **เทากลาง-อุ่น (R ≥ G ≥ B)** ต่างจาก
// เงินอมฟ้าเย็นของยูฟ้า168 (e8ecf1 a8b2bf 78828f) และรอบนี้โครเมียมเป็น **สีประกอบ
// บนตัวเลขเท่านั้น ไม่ใช่สีที่สองที่เท่าเทียมกับทอง**
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุด **ฟ้าสกาย-ทองคานารีบนธีมสว่าง** ของแบรนด์ขาออก
// **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff
// dff4fd eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c 2a1f02) และชุด
// **ทองคานารี-เงินโครเมียมบนดำสนิท** ของ **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05
// e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) —
// ต้องไม่เหลือสักค่าในไฟล์นี้ เช่นเดียวกับ ufalion168 (d4922c fdfc71 d39c45 f6e3b4
// a25b24 5a3310) UFA324 (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a)
// นินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc)
// รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec)
// ดวงเศรษฐี168 (d9212a 8e1a16 f0c878 2a0608 4e2120 300605 150303) สาธุ168 (0b7d28
// 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) หวยคิง (cd9a2c
// fdeb7c ab7314 f5e7c8 0c0b0a 120a02 1c140b) มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6
// 8c0f52 7a5508 1a0612 f6e4ee) หวย365 (140203 dc0203 f5282a ffc93c ffeab0 8c0402
// 3a0a0c c08a07) มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205)
// รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d)
// สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5)
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e eadfce) รับตัง168 (f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6) สมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203) รวยแท้168 (c30303 8f0505 e81313 dcb95f
// b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) โปรดี168 (eb0305
// e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
// fff0e4 fff4ea ffd1d1 1a0802) มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6
// f0ccf5) และ CEO66 (020617 7e22ce d946ef f5d0fe a855f7)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/บานเย็น ไม่มีม่วง/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน
// (ซึ่งเป็นสีนำของรอบก่อน) ไม่มีเขียว ไม่มีโรสโกลด์ และไม่มีส้ม**
// rgba() ที่อนุญาตรอบนี้: rgba(238,174,18,α) · rgba(253,237,65,α) ·
// rgba(224,224,223,α) · rgba(31,15,4,α) · rgba(0,0,0,α)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#eeae12]/50 bg-[#3a2713] p-8 text-left text-base leading-relaxed text-[#f4ead6] shadow-[0_12px_34px_rgba(0,0,0,0.6)] transition-all duration-500 hover:border-[#fded41]/80 hover:shadow-[0_18px_44px_rgba(253,237,65,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fded41]/20 blur-[62px] transition-all duration-500 group-hover:bg-[#fded41]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e0e0df]/14 blur-[62px] transition-all duration-500 group-hover:bg-[#eeae12]/22">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#fded41] via-[#eeae12] to-[#9f600d] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#1f0f04] uppercase shadow-[0_8px_24px_rgba(238,174,18,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#fded41] via-[#eeae12] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
