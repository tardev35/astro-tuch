---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): การ์ดนี้ถือ H1 ของหน้าแรก จึงไล่จาก
// พื้นการ์ดยกระดับ #241a1a ลงไปหาพื้นเพจ #0a0708 ในกรอบแดงแบรนด์ #c50d12 หัวข้อมี
// แถบแดงแนวตั้งนำหน้าและเส้นคั่นแดงลึก #5e0507 ใต้หัวข้อ รูปทรงนี้ต่างจาก ContentBox
// ตัวหลักที่ใช้เส้นเงินพาดขอบบนกับขีดสั้นใต้หัวข้อ เพราะหน้าแรกวางสองการ์ดนี้ไว้หน้า
// เดียวกัน หัวข้อไล่ตามลำดับสีบนโลโก้จริง คือ UFA แดงเงาวาว #ef1f25 แล้วต่อด้วย
// GOOL เงินโครเมียม #f4f7fa → #b8c3cf ส่วนออร่าสองมุมแยกด้วยคู่สีจริงของแบรนด์
// คือแดงกับเงิน — ชุดชมพูมาเจนตา-ทองของ WY88 (#24081a #170411 #e8b33a #ec2b84
// #fced94 #c3832b #a3145a #f9a8cd #fce9f3) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c50d12]/50 bg-gradient-to-br from-[#241a1a]/94 to-[#0a0708]/96 p-8 text-left text-base leading-relaxed text-[#cdd5dd] shadow-[0_10px_30px_rgba(10,7,8,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#ef1f25]/75 hover:shadow-[0_15px_40px_rgba(197,13,18,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c50d12]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#ef1f25]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b8c3cf]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#f4f7fa]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5e0507] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef1f25] via-[#c50d12] to-[#7a0103] shadow-[0_0_10px_rgba(197,13,18,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
