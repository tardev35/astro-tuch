---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit)
// จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// รวยแท้168 (2026-10-21 ดรอปที่สองของวัน) — พาเลตตาม
// .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" ตัวที่สามของรีโปนี้** bg.json =
// {"mode":"color","color":"#ffdbdb"} = ชมพูกุหลาบสว่าง การ์ดเนื้อหาทุกใบจึงเป็น
// **ผิวสว่าง + หมึกเข้ม** ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะรอบก่อนๆ เป็นแบบนั้น
// งานศิลป์: โลโก้เป็นเครื่องหมายสวูชสามมิติแดง-ทอง ตามด้วยคำว่า "รวยแท้" ตัวอักษรไทย
// สามมิติสีแดงคริมสันขอบทองหนา และเลข "168" สามมิติผิวทองขัดเงา แบนเนอร์เป็นฉากวัดไทย
// ริมน้ำกลางแดด เจดีย์และยอดปรางค์ทอง คู่หนุ่มสาวในชุดไทยปักทองถือสลากกินแบ่งรัฐบาล
// ⚠️ ฟ้าของท้องฟ้า เขียวของใบไม้ ครีมของชุดไทย ขาวของดอกบัว และดำของลูกบอลหวย
// เป็น **วัตถุในภาพ ไม่ใช่สีแบรนด์** ห้ามดึงเข้ามาเป็นสีของ UI
//
// บทบาทสีในไฟล์นี้ (ลำดับผิว: #ffffff ยก · #fff1ef กลาง · #ffdbdb พื้นเพจ):
//   แดงคริมสัน #c30303 = กรอบการ์ด ออรา และต้นของแผ่นถมหัวข้อ (6.3:1 บนขาว และ
//     **ถมแล้ววางตัวอักษรขาวได้ที่ 6.3:1**)
//   หมึกเลือดหมู #4a0f0f = เนื้อความ (= BRAND_TEXT, 15.4:1 บนผิวขาว) และปลายของ
//     แผ่นถมหัวข้อ (ขาวบนค่านี้ได้ 15.4:1)
//   สกาเล็ต #e81313 = ออราเท่านั้น (4.0:1 บนขาว = ตก AA) ⚠️ **ห้ามถือตัวอักษร
//     และห้ามเป็นพื้นของตัวอักษร**
// ⚠️ **แดงเข้ม #8f0505 ถูกสงวนไว้ให้ <strong> ในเนื้อความของหน้าเท่านั้น** จึงไม่
// ปรากฏในไฟล์นี้ และ ⚠️ **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของโครมล้วน**
// (1.9–3.5:1 บนการ์ดขาว) **ห้ามโผล่ในไฟล์นี้แม้แต่ค่าเดียว**
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีสิบบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **แผ่นถมแดงทึบ ตัวอักษรขาว** ไล่
// #c30303 → #4a0f0f ซึ่งเป็นวิธีเดียวที่ §2 อนุญาตให้ "อ่านว่าแดงสด" ได้บนธีมสว่าง
// (ถม #c30303 แล้ววางขาวทับ = 6.3:1 ผ่าน AA · บน #4a0f0f 15.4:1 — ทั้งสองสต็อป
// ปลอดภัย **ห้ามพลิกแผ่นนี้ไปใช้หมึกเข้ม** และ **ห้ามลากต้นแผ่นไปที่ #e81313**)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วมากกว่าฮิวใดในรีโปนี้**
// การเจอแดงในไฟล์จึงไม่พิสูจน์อะไร แดงรอบนี้คือ #c30303 (R195 G3 B3) ซึ่งห่าง
// d30304 ของรับตัง168 แค่ 16 หน่วย และห่าง b90203 ของสมหวัง168 แค่ 10 หน่วย
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** ที่ต้องไม่เหลือที่ไหนเลย
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ
// rgba 11/125/40, 10/95/28, 12/58/22, 174/176/74) และชุดชมพูบานเย็นของ มีทรัพย์168
// ที่เคยอยู่ทั้งใบนี้ (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5 กับ rgba 221/27/116,
// 164/24/107, 74/13/53) ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของ ดวงเศรษฐี168 (d9212a
// 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) ufalion168 (d4922c fdfc71 a25b24
// 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) รวยเทพ168 (f0bb4e ffeccb
// e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) มีเฮ168 (fb1b32 ff8f9c
// 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308) รวยแทร่168 (039cfa 0494f5
// c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d) นินจา168 (32bcfb a9e9ff
// fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) สบายเบท168 (2f9ff5 a8dcff
// d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16) ถอนชัวร์168 (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) มีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12) ขวัญใจ168 (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509) รับตัง168 (f0b429 ffdc8c
// d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f) สมหวัง168 (fa0513 ffadaf
// ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303) หวย365 (140203 dc0203
// f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) หวยคิง (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) และ UFA324 (e5a81b ffe08a bb8410
// 7d5a07 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4 b9c2cc 464f5a)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีส้ม และไม่มีทองในไฟล์นี้**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#c30303]/55 bg-white p-8 text-left text-base leading-relaxed text-[#4a0f0f] shadow-[0_12px_34px_rgba(74,15,15,0.18)] transition-all duration-500 hover:border-[#c30303]/85 hover:shadow-[0_18px_44px_rgba(195,3,3,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c30303]/25 blur-[62px] transition-all duration-500 group-hover:bg-[#e81313]/35">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#ffdbdb]/95 blur-[62px] transition-all duration-500 group-hover:bg-[#c30303]/25">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#c30303] to-[#4a0f0f] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-white uppercase shadow-[0_8px_24px_rgba(195,3,3,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#c30303] via-[#e81313] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
