---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit)
// จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// ufalion168 (รอบ **ทองสองเฉด + บรอนซ์ บนดำสนิท — ไม่มีสีที่สองที่เป็นคนละวงศ์**
// 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ufalion168.md §2
// งานศิลป์: โลโก้เป็น **หัวสิงโตทองคำขนแผงฟูสวมมงกุฎทองแหลม** ล้อมด้วยริ้วทองเหลว
// โค้งสาดกระเซ็นและประกายดาวทอง ใต้ลงมาเป็นคำว่า **ufalion168** ตัวอักษรหนาสามมิติ
// ผิวทองมันวาว โดย `ufa` กับ `168` เป็นทองเข้ม `lion` เป็นทองอ่อนกว่า และตัว `o`
// ในคำว่า `lion` มีมงกุฎทองเล็กวางอยู่ข้างใน
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #33200a ยก / #1f1304 กลาง /
// #0a0601 จม / #000000 พื้น — การ์ดใบนี้ไล่จากยกลงไปจม
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่ **พลิกขั้วหัวข้อ** — หัวข้อนั่งบน **แผ่นถมสว่างทึบ**
// ที่ไล่ครีมทอง #f6e3b4 → ทองสว่าง #fdfc71 → ทองนำ #d4922c แล้วถือ **หมึก #1a1000**
// ซึ่ง §2 ระบุว่าเป็นหมึกตัวเดียวที่วางบนพื้นถมทอง/เลมอน/ครีมได้ (สูงมากบน #f6e3b4 ·
// 17.3:1 บน #fdfc71 · 7.10:1 บน #d4922c — ทั้งสามปลายปลอดภัย **ห้ามพลิกแผ่นสว่าง
// ไปใช้หมึกสว่าง** และห้ามลากปลายเข้มลงไปถึง #a25b24 หรือ #5a3310 เพราะหมึกจะ
// อ่านไม่ออก) ส่วนอีกเจ็ดใบของหน้าเป็นตัวอักษรสว่างบนพื้นมืดทั้งหมด
// ⚠️ ลำดับไล่เฉดของแผ่นนี้ (ครีม → เลมอน → ทองนำ) ไม่ซ้ำกับหัวข้อใบไหนบนหน้าเดียวกัน
// มุม rounded-[28px] กรอบหนา 2px ทองนำ (อิ่มเป็นทองสว่างตอน hover) ออรามุมซ้ายบน
// เป็นบรอนซ์ #a25b24 (เฉดเงาของขนแผงสิงโตในงานศิลป์) มุมขวาล่างเป็นบรอนซ์ไหม้
// #5a3310 ที่ไต่ขึ้นเป็นบรอนซ์ตอน hover เนื้อความ #fbf6e3 (= BRAND_TEXT, 14.3:1
// บนผิวยก) §2 ห้าม #a25b24 (3.0:1 บนผิวการ์ด) และ #5a3310 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้ทั้งสองค่าอยู่ที่ขอบ ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" และ **รอบนี้กับดักคือทอง เพราะทองเคยนำ
// มาแล้วเกือบทุกแบรนด์ในรีโปนี้** การเจอ "ทอง" ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ทองนำรอบนี้คือ **#d4922c (R212 G146 B44)** ⚠️ ตัวที่ใกล้ที่สุดคือ dfa310 ของ
// TND168 (R223 G163 B16) — ตัวตัดสินคือ G146 vs G163 และ B44 vs B16 · ห่างจาก
// f0bb4e ของรวยเทพ168 รอบขาออกชัดเจน (R240 G187) · ห่างจาก e3b23c ของสมหวัง168
// (R227 G178) · ทองสว่างรอบนี้คือ **#fdfc71** ⚠️ ใกล้ fef54b ของนินจา168 (B113 vs
// B75 · G252 vs G245) · บรอนซ์ **#a25b24 ไม่มีแบรนด์ไหนในรีโปนี้เคยใช้** และไม่ใช่
// d9701a ทองแดงของรอบขาออก (R217 G112 B26)
// ค่าของแบรนด์ก่อนที่ต้องไม่เหลือ: f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501
// 5c2a06 fff8ec 2b1400 (รวยเทพ168 รอบขาออก) · fb1b32 ff8f9c 5c0410 fcd45c 6b4a08
// 2b0711 1a040a 0c0205 fdeaec 1b0308 (มีเฮ168) · 039cfa c3ebfc 04366b f9a826 704504
// 0b2d52 071e38 030f1d (รวยแทร่168) · 32bcfb a9e9ff fef54b 6b5c10 (นินจา168) ·
// 2f9ff5 a8dcff ffc82e 5c4a16 (สบายเบท168) · fa63b9 ffb3de ffd84d (ถอนชัวร์168) ·
// fcd434 ffeaa0 f5469f ff8dc6 (มีโชค168) · f7c92b ffe6a3 f2bba5 c98a74 b3121b 8a5f12
// (ขวัญใจ168) · f0b429 ffdc8c d30304 9a6c0c (รับตัง168) · fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 (สมหวัง168) · e5a81b ffe08a bb8410 8792a0 (UFA324) · 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงเลย** (รอบขาออกแดงเป็นฮิวที่สอง) **ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย และไม่มี
// ส้มสด** — ทุกค่าในไฟล์นี้อยู่ในวงศ์ทอง/บรอนซ์เดียวกันตาม §2
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#d4922c]/70 bg-gradient-to-br from-[#33200a] via-[#1f1304] to-[#0a0601] p-8 text-left text-base leading-relaxed text-[#fbf6e3] shadow-[0_12px_34px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdfc71]/80 hover:shadow-[0_18px_44px_rgba(212,146,44,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#a25b24]/55 blur-[62px] transition-all duration-500 group-hover:bg-[#a25b24]/75">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#5a3310]/80 blur-[62px] transition-all duration-500 group-hover:bg-[#a25b24]/26">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#f6e3b4] via-[#fdfc71] to-[#d4922c] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#1a1000] uppercase shadow-[0_8px_24px_rgba(212,146,44,0.4)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#5a3310] via-[#a25b24] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
