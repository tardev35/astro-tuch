---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c2249b]/50 bg-gradient-to-br from-[#2a0640]/92 to-[#0d0114]/92 p-8 text-left text-base leading-relaxed text-[#e6cfe9] shadow-[0_10px_30px_rgba(13,1,20,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#c2249b]/85 hover:shadow-[0_15px_40px_rgba(194,36,155,0.34)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c2249b]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#e0359f]/36"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fb44b3]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ffb3e2]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c2249b]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb44b3] via-[#ffb3e2] to-[#c2249b] shadow-[0_0_10px_rgba(251,68,179,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdeaf8] via-[#fb44b3] to-[#c2249b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
