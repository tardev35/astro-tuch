---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): เว็บแทงหวยออนไลน์ พาเลตต์อ่านจาก logo.webp
// ที่ vivid เป็นแดงล้วนทั้งชุด (#dc0203 #e00104 #e2020a) และ dominant เป็นดำ #020202
// ส่วนทองมาจากตัวอักษรบนแบนเนอร์/สไลด์ แบรนด์นี้จึงเป็น "แดงคือสีตัวตน ทองคือสีเน้น
// ดำคือพื้น" การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่จากพื้นการ์ด #240406 ลงไปหาพื้นลึกสุด
// #140203 ในกรอบทองลึก #c08a07 ที่สว่างขึ้นเป็นทองแบรนด์ #ffc93c ตอน hover ออร่าสองมุม
// แยกกันด้วยสองสีของแบรนด์จริง ไม่ใช่สีเดียวสองระดับ — ทองแบรนด์มุมซ้ายบน แดงแบรนด์
// #dc0203 มุมขวาล่าง แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ทองอ่อน #ffeab0 → ทองแบรนด์
// #ffc93c → ทองลึก #c08a07 (6.3:1 บนผิวการ์ด) ไม่พาดลงแดงเพราะหัวข้อ H1 ยาวและ
// หางแดงบนพื้นแดงอมดำจะจมในบรรทัดสุดท้าย เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #241404
// #140c02 #f3e8cf) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c08a07]/55 bg-gradient-to-br from-[#240406]/94 to-[#140203]/96 p-8 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#ffeab0]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#f5282a]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c08a07] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
