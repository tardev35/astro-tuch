---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): brand-spec §2
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H2 #3 (อัตราการจ่าย 2ตัว/3ตัว) ซึ่งเป็นหัวข้อแม่
// ของสอง H3 ที่ตามมา จึงเป็นการ์ดคอลัมน์เดียวที่หนักแน่นที่สุดในหน้า
//
// ไฟล์นี้ต้องไม่อ่านเป็นใบเดียวกับ ContentBoxHuay (H1 ใบสลาก) และ ContentBox
// (หัวข้อ 24 ชั่วโมง) ที่อยู่หน้าเดียวกัน จึงแยกด้วยรูปทรง: สันตั้งไล่ทองหน้าหัวข้อ
// + ผิวการ์ดไล่เฉดจาก #1c140b ลงไปหาพื้นลึกสุด #0c0b0a (อีกสองใบเป็นผิวทึบ)
// และหัวข้อไล่ครีมอ่อน #fce2d4 → ทองสว่าง #fdeb7c → ทองแบรนด์ #cd9a2c ซึ่งเป็น
// ลำดับสีคนละชุดกับสองใบนั้นที่ไล่ทองสว่างไปครีม
//
// กรอบทองแบรนด์ #cd9a2c สว่างขึ้นเป็นทองสว่าง #fdeb7c ตอน hover ออร่ามุมซ้ายบน
// เป็นทองแบรนด์ มุมขวาล่างเป็นครีมอมพีช #fcd4c3 (ชุดขาวของนางแบบใน slide1/slide2)
// เส้นใต้หัวข้อเป็นเส้นจาง #5c3f12 เนื้อความ #f5e7c8 (= BRAND_TEXT)
// glow ทุกจุดเป็น rgba(205,154,44,…)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #12c23a
// #01841b #fb252b #ff6b6e #0a4a18 #0a1a0e #030a05 #ffe9a8 #f2b422 #e4f2e4)
// ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#cd9a2c]/55 bg-gradient-to-br from-[#1c140b]/96 to-[#0c0b0a]/96 p-8 text-left text-base leading-relaxed text-[#f5e7c8] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdeb7c]/75 hover:shadow-[0_15px_40px_rgba(205,154,44,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#cd9a2c]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#fdeb7c]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fcd4c3]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#fce2d4]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5c3f12] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] shadow-[0_0_10px_rgba(205,154,44,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fce2d4] via-[#fdeb7c] to-[#cd9a2c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
