---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// ENTER55: การ์ดดำสนิท #0b0b0a ไล่ลง #000000 ในกรอบทองหลัก #c4a255 หัวข้อมีแถบ
// ทองแนวตั้งนำหน้าและเส้นคั่นใต้หัวข้อ ซึ่งเป็นรูปทรงที่ต่างจาก ContentBox ตัวหลัก
// (เส้นทองพาดขอบบน + ขีดสั้นใต้หัวข้อ) เพราะหน้าแรกวางสองการ์ดนี้ไว้ในหน้าเดียวกัน
// ออร่าสองมุมเป็นทองหลักกับทองประกาย #ebd484 ตามลายวงจรเส้นทองบนแบนเนอร์
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c4a255]/45 bg-gradient-to-br from-[#0b0b0a]/94 to-[#000000]/96 p-8 text-left text-base leading-relaxed text-[#ded8cb] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebd484]/70 hover:shadow-[0_15px_40px_rgba(196,162,85,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c4a255]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#d2b262]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ebd484]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#ebd484]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8a6d2c]/55 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ebd484] via-[#c4a255] to-[#8a6d2c] shadow-[0_0_10px_rgba(196,162,85,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#c4a255] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
