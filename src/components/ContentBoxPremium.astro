---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f472b6]/45 bg-gradient-to-br from-[#1e0a30]/92 to-[#150724]/90 p-8 text-left text-base leading-relaxed text-[#f2e3f7] shadow-[0_10px_30px_rgba(10,3,19,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#f472b6]/80 hover:shadow-[0_15px_40px_rgba(244,114,182,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f472b6]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#ec4899]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4c1d6b]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#fcd34d]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f472b6]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcd34d] via-[#ec4899] to-[#4c1d6b] shadow-[0_0_10px_rgba(244,114,182,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf2f8] via-[#f9a8d4] to-[#fcd34d] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
