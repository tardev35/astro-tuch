---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): สล็อตคาสิโนเว็บตรง
// ต่างประเทศ โลโก้เป็นตัว D เขียว (vivid #01841b #018b1b) ซ้อนตัว M แดง
// (#fb252b #bb0303 #f91c20) ตามด้วยเลข 899 โครเมียม ส่วนแบนเนอร์เป็นพื้นดำอมเขียว
// (dominant #05140c #0b1b13 #031404) กับตัวอักษรทองไล่เฉด แบรนด์นี้จึงเป็น
// "เขียวนำ แดงรอง ทองเสริม" การ์ดใบนี้ถือ H1 ของหน้าแรก จึงใช้กรอบเขียวแบรนด์
// #01a326 บนผิวการ์ด #0a1a0e ที่ไล่ลงไปหาพื้นลึกสุด #030a05 ออร่าสองมุมเป็น
// คู่เขียว-แดงของโลโก้ตรงๆ — เขียว rgba(1,163,38,α) มุมซ้ายบน แดง
// rgba(251,37,43,α) มุมขวาล่าง ตัวหัวข้อไล่ทองอ่อน #ffe9a8 → ทองแบรนด์ #f2b422
// → เขียวสว่าง #12c23a (ไล่ "ทองไปเขียว" ซึ่งเป็นคู่ที่ต่างจากการ์ด H2 ใบถัดไป
// ที่ใช้ขาว-เขียว-แดง จะได้ไม่อ่านเป็นการ์ดใบเดียวกันซ้ำ) เนื้อความ #e4f2e4
// (BRAND_TEXT) <strong> ใช้ทองอ่อน #ffe9a8 สีเดียวทั้งเว็บ
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #ffc93c #ffeab0
// #c08a07 #240406 #140203 #f6e7e0) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#01a326]/55 bg-gradient-to-br from-[#0a1a0e]/95 to-[#030a05]/96 p-8 text-left text-base leading-relaxed text-[#e4f2e4] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#12c23a]/75 hover:shadow-[0_15px_40px_rgba(1,163,38,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#01a326]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#4ade6b]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fb252b]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#ff6b6e]/32">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0a4a18] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_10px_rgba(1,163,38,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#12c23a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
