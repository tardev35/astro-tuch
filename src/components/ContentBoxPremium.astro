---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// OCZPLUS palette: navy base (#0b2547 -> #02101f) inside a deep gold border
// (#8a6b2c / #d9b45e). The heading gradient is PURE METALLIC GOLD here
// (#f2dc9a -> #d9b45e -> #8a6b2c); the plain ContentBox's heading runs warm
// white -> gold -> crimson instead, which is what tells the two shapes apart at
// a glance now that both carry the brand's gold. The two aura blooms are
// deliberately two-tone — gold top-left, crimson bottom-right — so the card
// carries the logo's gold-and-red pairing (OCZ silver, red +, PLUS gold)
// rather than a single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a6b2c]/70 bg-gradient-to-br from-[#0b2547]/92 to-[#02101f]/94 p-8 text-left text-base leading-relaxed text-[#ccd6e6] shadow-[0_10px_30px_rgba(2,16,31,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9b45e]/80 hover:shadow-[0_15px_40px_rgba(217,180,94,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d9b45e]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#f2dc9a]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c0202b]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#dd3a3f]/26">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a6b2c]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] shadow-[0_0_10px_rgba(217,180,94,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
