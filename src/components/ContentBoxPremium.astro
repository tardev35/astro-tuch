---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): การ์ดไล่จากพื้นการ์ดพลัม #24081a ลงไปหา
// พื้นเพจ #170411 ในกรอบทองหลัก #e8b33a หัวข้อมีแถบทองแนวตั้งนำหน้าและเส้นคั่น
// มาเจนตาเข้ม #a3145a ใต้หัวข้อ รูปทรงนี้ต่างจาก ContentBox ตัวหลักที่ใช้เส้นทอง
// พาดขอบบนกับขีดสั้นใต้หัวข้อ เพราะหน้าแรกวางสองการ์ดนี้ไว้หน้าเดียวกัน หัวข้อที่นี่
// ไล่เฉดทองล้วน (#fced94 → #e8b33a → #c3832b) ตามเลข 88 บนโลโก้ ส่วนออร่าสองมุม
// แยกด้วยคู่สีจริงของแบรนด์คือทองกับมาเจนตา #ec2b84 — ชุดมรกต-ทองของ HENG38
// (#0a2d16 #061f0f #f3cf63 #15833c #fbeeb0 #a5761a #e6e2d2) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e8b33a]/45 bg-gradient-to-br from-[#24081a]/94 to-[#170411]/96 p-8 text-left text-base leading-relaxed text-[#fce9f3] shadow-[0_10px_30px_rgba(23,4,17,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fced94]/70 hover:shadow-[0_15px_40px_rgba(232,179,58,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8b33a]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#e8b33a]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ec2b84]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#f9a8cd]/38">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a3145a] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced94] via-[#e8b33a] to-[#c3832b] shadow-[0_0_10px_rgba(232,179,58,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#c3832b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
