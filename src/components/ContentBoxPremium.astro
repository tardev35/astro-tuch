---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// FAH999: การ์ดไล่จากแผงยก #1c160e ลงไปหาพื้นการ์ด #12100b ในกรอบทองหลัก
// #e8c25a หัวข้อมีแถบทองแนวตั้งนำหน้าและเส้นคั่นบรอนซ์ใต้หัวข้อ ซึ่งเป็นรูปทรงที่
// ต่างจาก ContentBox ตัวหลัก (เส้นทองพาดขอบบน + ขีดสั้นใต้หัวข้อ) เพราะหน้าแรก
// วางสองการ์ดนี้ไว้ในหน้าเดียวกัน ออร่าสองมุมเป็นทองหลักกับทองประกาย #f7e7a8
// ตามโลโก้ที่เป็นทองบนดำสีเดียว ไม่มีสีที่สอง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e8c25a]/45 bg-gradient-to-br from-[#1c160e]/94 to-[#12100b]/96 p-8 text-left text-base leading-relaxed text-[#e7dcc4] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#f7e7a8]/70 hover:shadow-[0_15px_40px_rgba(232,194,90,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8c25a]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#e8c25a]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f7e7a8]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#f7e7a8]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b4a18]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e7a8] via-[#e8c25a] to-[#6b4a18] shadow-[0_0_10px_rgba(232,194,90,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
