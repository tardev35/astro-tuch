---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอป 2026-10-23 **ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน**
// (banner2.png mtime 10-08 / banner3.png 09-27 เป็นของแบรนด์ก่อน และ eager import
// = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// มาดาม168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-madum168.md §2
// ⚠️⚠️ **รอบนี้เป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#00091f"} = **น้ำเงินเที่ยงคืนเกือบดำ** (รอบก่อน นาซ่า168
// เป็น 0d1017 ถ่านอมน้ำเงินที่เทากว่ามาก) และ bg.json คือแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดใบนี้ให้เป็นพื้นสว่าง**
// ทิศของรอบนี้: **แดงคริมสันเป็นฮิวนำ · น้ำเงินอะซัวร์เป็นวัสดุที่สอง (พื้นถม/ขอบ/
// ออรา เท่านั้น) · แพลทินัมเป็นหมึกรอง** — รอบก่อนไม่มีแดงเลยสักเฉด
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้จริง: โลโก้เป็น **ผู้หญิงวัยกลางคนผมสั้นดัดลอนสีขาวเงิน
// ขยิบตา ทาลิปสติกแดง ทำท่ามินิฮาร์ท** ตามด้วยคำว่า **"มาดาม" ตัวอักษรไทยสามมิติ
// สีฟ้าอมน้ำเงิน และเลข "168" สีแดงสด** แบนเนอร์/สไลด์เป็น **โถงห้างสรรพสินค้าหรู
// โทนขาว-ดำ หน้าร้านแบรนด์เนมสองฝั่ง พื้นหินขัดสะท้อนเงา**
// ⚠️ **ผมขาวเงิน สูทขาวครีม สูทดำ โซฟาหนัง พื้นหินขัด และสีผิวนักแสดง (พีช #f5bba3
// ที่ palette.json วัดได้) เป็นวัตถุในภาพ ไม่ใช่สี UI** — รอบนี้จึงไม่มีครีม
// ไม่มีพีช ไม่มีเบจ และไม่มีแรมป์เทาเงินเลยสักค่า
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด (กลาง) #0b1733 · ชั้นจม #050e26 · ชั้นยก #16234a · พื้นเพจ #00091f
//   แผ่นถมหัวข้อ = ไล่ **#e01238 → #c9102f บนหมึกขาว** ซึ่งเป็นครึ่งเข้มของสูตร
//     "ปุ่มหลัก" ของ §2 (ขาวบน #e01238 = 4.9:1 · บน #c9102f = 5.8:1)
//     ⚠️⚠️ **ไล่เฉดไม่ลากขึ้นไปถึง #ff2e52 โดยตั้งใจ** — §2 ระบุตรงๆ ว่า
//     **ห้ามวางหมึกขาวบน #ff2e52 (3.6:1)** แผ่นถมนี้จึงเริ่มที่ #e01238 ขึ้นไป
//   แดงคริมสัน #ff2e52 = ต้นของเส้นใต้หัวข้อ · ออรามุมบนซ้าย · ขอบตอน hover
//     (ถือตัวอักษรได้ 4.9:1 บนผิวการ์ดนี้ แต่ในไฟล์นี้หัวข้ออยู่บนแผ่นถมแล้ว)
//   น้ำเงินอะซัวร์ #1177e8 = ปลายของเส้นใต้หัวข้อ · ออรามุมขวาล่าง
//     ⚠️⚠️ **ต่ำกว่า AA บนผิวการ์ด ห้ามถือตัวอักษรในไฟล์นี้เด็ดขาด**
//   เส้น/ขอบ #2a3c70 — **ห้ามถือตัวอักษร**
//   หมึก #f4eef1 = เนื้อความ (= BRAND_TEXT) 15.7:1 บนผิวการ์ดนี้
// ⚠️ **#ff2e52 สงวนไว้ให้ <strong> ในเนื้อความด้วย** ซึ่งเป็นงานของหน้าเพจ ไม่ใช่
// ของไฟล์นี้ — และเป็นไฮไลต์สีเดียวที่หน้าแรกใช้
// rgba() ที่อนุญาตรอบนี้: rgba(255,46,82,α) · rgba(224,18,56,α) · rgba(201,16,47,α) ·
// rgba(17,119,232,α) · rgba(14,104,204,α) · rgba(10,78,168,α) · rgba(217,223,233,α) ·
// rgba(0,9,31,α) · rgba(0,0,0,α)
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบพร้อมหมึกขาว** ส่วนใบอื่นใช้
// §2 แท่งตั้งข้างหัวข้อโดยไม่มีการ์ดครอบ · §3 เส้นคาดเหนือหัวข้อที่จัดกึ่งกลาง ·
// §4 แท่งตั้งสามสต็อปบนการ์ดมุมกลม · §5 ชิปถมอะซัวร์คู่กลีฟบนการ์ดมุมตัด 36px ·
// §6 สันซ้ายสี่พิกเซลบนการ์ดมุมตัด 40px · §7 เส้นคู่คร่อมบน-ล่าง · §8 หัวข้อไล่เฉด
// bg-clip-text จัดกึ่งกลางพร้อมขีดใต้
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วเจ็ดแบรนด์ในรีโปนี้
// การเจอฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย อะซัวร์รอบนี้คือ **#1177e8 / #0e68cc /
// #0a4ea8** และ **ไม่ถือตัวอักษร** ค่าที่ต้องไม่เหลือ:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (นาซ่า168 — **แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด**) ·
//   18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f 202a66 31408a
//   e9f1ff adc0e4 (ร่ำรวย168 — ชุดที่เพิ่งถอดออกจากไฟล์นี้ทั้งใบ) ·
//   2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
//   eafaff a9e3f9 (สบาย168) · 039cfa 0494f5 c3ebfc 04366b e3f2fc 0b2d52 (รวยแทร่168) ·
//   32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 041019 dceefc (นินจา168) ·
//   2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff
//   cfdcec 9db4d4 dde8f7 00081f 102a5e 0a1c42 032dad 04186e (TSDET911)
// ⚠️⚠️ **แดงเป็นฮิวนำรอบนี้ จึงต้องเทียบแดงของแบรนด์เก่าให้แน่นที่สุด** — แดงรอบนี้
// คือ **#ff2e52 / #e01238 / #c9102f เท่านั้น** ไม่ใช่ b3121b f2bba5 c98a74 (ขวัญใจ168)
// c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef (รวยแท้168) fb141b ff5f63 ffa0a2 db040b
// 8a0609 (GT66B) eb0305 e40303 c20305 9b0a0c ff4446 (โปรดี168) fa0513 ff5a5f ffadaf
// (สมหวัง168) d9212a 8e1a16 (ดวงเศรษฐี168) fb1b32 ff8f9c 5c0410 (มีเฮ168) e4021b
// (รวยเทพ168) d30304 a00203 ff6b6e (รับตัง168) dc0203 f5282a (หวย365) dd1b74 a4186b
// 4a0d35 2d0720 (มีทรัพย์168) fa63b9 ffb3de (ถอนชัวร์168) f5469f ff8dc6 8c0f52
// (มีโชค168) หรือ ff3b14 6d0804 2b0000 (FLASH877)
// ⚠️ ครีม/เบจ/น้ำตาลของแบรนด์เก่าที่ต้องไม่กลับมา: f4e4d3 e4cbb3 (ร่ำรวย168) ·
// ecd5c4 d2b9a4 (เงินทอง168) · eadfce (ขวัญใจ168) · f4ead6 d6c6a8 1f0f04 2f1e0f
// 4e2f11 291d0f (พักยก168) — **สูทขาวครีมในภาพเป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
// ⚠️ แรมป์เทาเงิน: e0e0df c0c0bf a1a09e (พักยก168) · e8ecf1 a8b2bf 78828f 5a6472
// (ยูฟ้า168) · 8792a0 b9c2cc f0e8d4 464f5a (UFA324) · cfd9e6 (รับตัง168) —
// รอบนี้มี **#d9dfe9 ตัวเดียว** เป็นแพลทินัม ซึ่งเป็นค่าใหม่ ไม่อยู่ในลิสต์นั้น
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าใน
// src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีเหลือง ไม่มีส้ม ไม่มีเขียว ไม่มีม่วง ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีน้ำตาล ไม่มีครีม และไม่มีแรมป์เทาเงิน**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#2a3c70] bg-[#0b1733] p-8 text-left text-base leading-relaxed text-[#f4eef1] shadow-[0_12px_34px_rgba(0,0,0,0.55)] transition-all duration-500 hover:border-[#ff2e52] hover:shadow-[0_18px_44px_rgba(255,46,82,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ff2e52]/25 blur-[62px] transition-all duration-500 group-hover:bg-[#ff2e52]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1177e8]/35 blur-[62px] transition-all duration-500 group-hover:bg-[#1177e8]/55">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#e01238] to-[#c9102f] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#ff2e52] via-[#1177e8] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
