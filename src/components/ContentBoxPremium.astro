---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// VAK88 palette: near-black navy base (#0e1526 -> #04060e) inside a deep gold
// border (#8a5f14 / #e6b23c). The heading gradient is PURE METALLIC GOLD here
// (#ffd873 -> #e6b23c -> #8a5f14); the plain ContentBox's heading runs warm
// white -> gold -> crimson instead, which is what tells the two shapes apart at
// a glance now that both carry the brand's gold. The two aura blooms are
// deliberately two-tone — gold top-left, phoenix crimson bottom-right — so the
// card carries the logo's gold-and-red pairing rather than a single hue.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a5f14]/70 bg-gradient-to-br from-[#0e1526]/92 to-[#04060e]/94 p-8 text-left text-base leading-relaxed text-[#ded8ca] shadow-[0_10px_30px_rgba(3,6,14,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#e6b23c]/80 hover:shadow-[0_15px_40px_rgba(230,178,60,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e6b23c]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd873]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#cf2027]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#ee3a34]/26">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a5f14]/65 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd873] via-[#e6b23c] to-[#8a5f14] shadow-[0_0_10px_rgba(230,178,60,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffd873] via-[#e6b23c] to-[#8a5f14] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
