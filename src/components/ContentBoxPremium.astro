---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// JOKERSLOTZ palette: a maroon card (#2b0204 -> #1c0202) inside an ANTIQUE GOLD
// hairline. That hairline is what tells this box apart from the plain shared
// ContentBox, which runs the same rounded shape behind a CRIMSON hairline — the
// index puts both on one page, so the two must not read as the same card twice.
// The heading gradient runs gold-light -> gold -> crimson (jester hat into the
// logo's red); the plain box runs gold -> crimson -> gold instead. The two aura
// blooms carry the brand's own pairing: crimson top-left, gold bottom-right.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#bc9b5b]/45 bg-gradient-to-br from-[#2b0204]/92 to-[#1c0202]/94 p-8 text-left text-base leading-relaxed text-[#ecdfd0] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2dc9a]/70 hover:shadow-[0_15px_40px_rgba(217,180,94,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a51515]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#c81e1e]/42">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d9b45e]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#f2dc9a]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#bc9b5b]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#6d0d0d] shadow-[0_0_10px_rgba(217,180,94,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c81e1e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
