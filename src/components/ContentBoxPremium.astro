---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน mtime 10-08 / 09-27 และ eager
// import = emit) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง
// slide* ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 (2026-10-22) — พาเลตตาม .claude/brand-spec-ufabet168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็นธีมมืดหลังสามรอบติดที่เป็นธีมสว่าง** bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#000000"} = ดำสนิท และ bg.json เป็นแหล่งเดียวของพื้นเพจ
// **ห้าม "แก้" การ์ดกลับไปเป็นผิวสว่างเพราะรอบก่อนๆ เป็นแบบนั้น**
// งานศิลป์: โลโก้เป็นลูกฟุตบอลขาว-ดำลายทองพร้อมหางวงโคจรทอง ข้างคำว่า "ยูฟ้า"
// ตัวอักษรไทยสามมิติสีทองอร่าม ต่อด้วยเลข "168" ผิวโครเมียมเงิน — สองวัสดุคู่กัน
// แบนเนอร์/สไลด์เป็นอัฒจันทร์สนามฟุตบอลกลางคืน ไฟสปอตไลต์ คู่ชาย-หญิงชุดบอลดำ-ทอง
// ลูกฟุตบอลทองคำ และเหรียญทองกองอยู่
// ⚠️ ขาว-ดำของลูกฟุตบอล ฟ้าของจอหลัง และสีผิวนักแสดงเป็น **วัตถุในภาพ ไม่ใช่สีแบรนด์**
//
// บทบาทสีในไฟล์นี้ (ลำดับผิว: #15130f ยก · #1e1a13 อุ่น · #0a0908 จม · #000000 พื้น):
//   ทองคานารี #fee45d = ต้นแผ่นถมหัวข้อ · ขอบตอน hover · ออรา · เส้นใต้หัวข้อ
//     (14.8:1 บนผิวการ์ด)
//   ทองกลาง #e6a416 = ขอบการ์ดปกติ · สต็อปกลางของแผ่นถม (8.7:1 ถือตัวอักษรได้)
//   ทองลึก #b8780d = ปลายของแผ่นถมหัวข้อ (5.2:1 — หมึก #140e02 บนค่านี้ยังได้ 5.3:1)
//   หมึกเข้ม #140e02 = ตัวอักษรบนแผ่นถมทอง (15.1:1 บน #fee45d)
//   โครเมียมกลาง #a8b2bf = ออรารอง (สีที่สองของรอบนี้ มาจากเลข "168" ในโลโก้)
//   หมึกครีม #eae3d4 = เนื้อความ (= BRAND_TEXT) 14.6:1 บนผิวการ์ด
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทองทึบ** ไล่สามสต็อป
// #fee45d → #e6a416 → #b8780d พร้อม **หมึกเข้ม #140e02** ซึ่งเป็นสูตรปุ่ม CTA หลัก
// ของ §2 ตรงๆ ⚠️ **ห้ามพลิกแผ่นนี้ไปใช้ตัวอักษรขาว** (§2 ข้อ 2 ห้ามไว้ชัด)
// กล่องอื่นบนหน้าเดียวกันใช้หัวข้อแบบ: §2 ทองทึบกึ่งกลางมีเส้นคาดเหนือหัวข้อ ·
// §3 ทองทึบชิดซ้ายบนสันหนาสี่พิกเซล · §4 ไล่ทอง→ทองกลางแบบ clip-text ไม่มีแถบ ·
// §5 ไล่โครเมียม→ทองพร้อมแถบตั้ง · §7 ไล่สามสต็อปโครเมียม→ทอง→ทองกลาง
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองถูกใช้มาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอทองในไฟล์จึงไม่พิสูจน์อะไรเลย ทองรอบนี้คือ **#fee45d (R254 G228 B93)**
// ทองคานารีสว่างอมเหลือง ซึ่งเป็นค่า vivid อันดับหนึ่งที่วัดจาก logo.webp เอง และ
// ตัวแยกที่แข็งที่สุดของรอบนี้คือ **โครเมียมเงิน #e8ecf1 / #a8b2bf / #78828f**
// ที่รีโปนี้แทบไม่เคยใช้ (รอบก่อนประกาศชัดว่า "ไม่มีเงิน/โครเมียม")
// ⚠️ ufalion168 เป็นแบรนด์บอลเหมือนกันและเคยใช้สนามฟุตบอล — **ห้ามเทียบด้วย
// "เป็นบอลเหมือนกัน" ต้องเทียบทีละค่า** รอบนี้ไม่มีสิงโตทองและไม่มีถ้วยรางวัล
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือชุด **แดงคริมสัน-ทองโบราณบนธีมสว่าง** ของ
// **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b
// ffeee8 fff1ef ffdbdb c99a3f กับ rgba 195/3/3 α) rgba 74/15/15 α))
// และแบรนด์ขาออกของรอบนี้คือ **โปรดี168** (eb0305 e40303 c20305 9b0a0c ff4446
// 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802
// กับ rgba 235/3/5 α) rgba 180/76/6 α) rgba 64/17/7 α) rgba 77/28/10 α)) —
// ต้องไม่เหลือสักค่าในไฟล์นี้ เช่นเดียวกับ ufalion168 (d4922c fdfc71 a25b24 8c4312
// d39c45 f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) UFA324 (e5a81b ffe08a bb8410
// 7d5a07 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4 b9c2cc 464f5a)
// นินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc)
// รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400)
// ดวงเศรษฐี168 (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) สาธุ168
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) หวยคิง
// (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) มีโชค168 (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) หวย365
// (140203 dc0203 f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) มีเฮ168
// (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec ffe3e6 1b0308)
// รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d)
// สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5)
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509)
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f)
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303)
// มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) และ CEO66 (020617 7e22ce
// d946ef f5d0fe a855f7)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/บานเย็น ไม่มีม่วง/ฟูเชีย ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีเขียว ไม่มีโรสโกลด์ ไม่มีทองแดงไหม้ และไม่มีส้ม**
// ⚠️ #7a4e05 และ #5a6472 เป็นสีขอบ/พื้นเท่านั้น **ห้ามถือตัวอักษร** และ #15130f
// #1e1a13 #0a0908 เป็นสีผิวล้วน
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#e6a416]/50 bg-[#15130f] p-8 text-left text-base leading-relaxed text-[#eae3d4] shadow-[0_12px_34px_rgba(0,0,0,0.6)] transition-all duration-500 hover:border-[#fee45d]/80 hover:shadow-[0_18px_44px_rgba(254,228,93,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fee45d]/20 blur-[62px] transition-all duration-500 group-hover:bg-[#fee45d]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#a8b2bf]/14 blur-[62px] transition-all duration-500 group-hover:bg-[#e6a416]/22">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#fee45d] via-[#e6a416] to-[#b8780d] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#140e02] uppercase shadow-[0_8px_24px_rgba(230,164,22,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#fee45d] via-[#e6a416] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
