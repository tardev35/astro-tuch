---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// HENG35 (รอบดำ-ทอง 2026-09-21): การ์ดไล่จากแผงยก #1c1710 ลงไปหาพื้นการ์ด
// #12100b ในกรอบทองหลัก #ecc55c หัวข้อมีแถบทองแนวตั้งนำหน้าและเส้นคั่นบรอนซ์
// #5e4418 ใต้หัวข้อ ซึ่งเป็นรูปทรงที่ต่างจาก ContentBox ตัวหลัก (เส้นทองพาดขอบบน
// + ขีดสั้นใต้หัวข้อ) เพราะหน้าแรกวางสองการ์ดนี้ไว้ในหน้าเดียวกัน ออร่าสองมุมเป็น
// ทองหลักกับทองสว่าง #fefac4 ตามโลโก้มงกุฎทองบนพื้นดำที่มีสีเดียว ไม่มีสีที่สอง
// ชุดทองของแบรนด์ก่อนหน้า (#e8c25a #f7e7a8 #6b4a18) หายไปทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ecc55c]/45 bg-gradient-to-br from-[#1c1710]/94 to-[#12100b]/96 p-8 text-left text-base leading-relaxed text-[#ece1cb] shadow-[0_10px_30px_rgba(7,6,5,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fefac4]/70 hover:shadow-[0_15px_40px_rgba(236,197,92,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ecc55c]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ecc55c]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fefac4]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#fefac4]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5e4418]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fefac4] via-[#ecc55c] to-[#5e4418] shadow-[0_0_10px_rgba(236,197,92,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
