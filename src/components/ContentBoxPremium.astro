---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// แบรนด์รอบนี้เป็นคู่สีจริง — แดงเสือโคร่ง #e8232a นำ (ป้ายโล่และตัวอักษรสามมิติ
// บนโลโก้) และทองถ่านไฟ #f2b705 เป็นฮิวที่สองจริง (เหรียญทองลายรอยเท้าเสือกับ
// ตัวหนังสือไทยบนแบนเนอร์) พื้นเพจเป็นน้ำตาลถ่านเกือบดำ #241000 ตาม bg.json
// ผิวการ์ดทุกใบจึงต้อง "สว่างกว่า" พื้น เพื่อให้การ์ดยกลอยขึ้นจากหน้าเหมือนป้ายโล่
// แดงในโลโก้ที่ลอยอยู่หน้าฉากป่า
//
// การ์ดใบนี้ถือ docx H1 ของหน้าแรก จึงหนักแน่นที่สุดในหน้า และเป็นใบเดียวที่หัวข้อ
// ขึ้นที่ text-3xl ต้องไม่อ่านเป็นใบเดียวกับ ContentBox (ใบธรรมดาที่ถือ H2 #3 —
// ผิวทึบ #3d1709 กับเส้นคาดทองบนสุด), ContentBoxSevenThreePremium (กรอบแดงลึก
// #7d0f12) และ ContentBoxTwoPremium (ผิวกลาง #301105 กรอบทองเข้ม #a8730a) ที่อยู่
// หน้าเดียวกัน จึงแยกด้วยรูปทรงและสีกรอบ: สันตั้งไล่แดงหน้าหัวข้อ + ผิวการ์ดไล่จาก
// ผิวยก #3d1709 ลงไปหาผิวเพจ #241000 และกรอบเป็น "กรอบแดงแบรนด์" #e8232a เข้มกว่า
// ใบธรรมดา
//
// หัวข้อไล่แดงเรืองไฟ #ff5a46 → ครีมอุ่น #f5cbb0 → ทองแบรนด์ #f2b705 คือ "แดงนำ
// เข้าทอง" ซึ่งเป็นทิศคนละชุดกับทุกกล่องบนหน้าเดียวกัน — แดงนำเพราะทั้งป้ายโล่ของ
// โลโก้และนามบัตรกลางแบนเนอร์เป็นแดงเป็นมวลสีหลัก
//
// ออรามุมซ้ายบนเป็นแดงแบรนด์ มุมขวาล่างเป็นทองเข้ม #a8730a (เหรียญทองในงานอาร์ต)
// เส้นใต้หัวข้อเป็นแดงลึก #7d0f12 เนื้อความ #fbe8d5 (= BRAND_TEXT, 13.3:1 บนผิวยก
// และสูงกว่านั้นบนผิวเพจ) glow ทุกจุดเป็น rgba(232,35,42,…)
// §2 ห้าม #e8232a ถือตัวอักษร (3.5:1 — ตก) จึงอยู่ที่ขอบ สัน และออราเท่านั้น
// ส่วน #a8730a กับ #7d0f12 ไม่เคยเป็นตัวอักษรที่ไหนเลย
//
// ⚠️ รอบนี้ฮิวแบรนด์เองเป็น "แดง" และแบรนด์ก่อนๆ หลายเจ้าก็แดง เจอแดงที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168
// ที่เคยค้างในไฟล์นี้ (#a435f0 #5b1a75 #d2a6ff #efe6ff #fbe455 #c98a05 #1e0a3c
// #110321 #ece2ff rgba(164,53,240,α)) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ก่อน
// นั้น (#0193fb #7bcffb #d4ecfd #064a86 #fce604 #fff48a #c9a703 #0a1726 #040b14
// #dbeafe) ออกครบทุกจุดแล้ว — ทองของรอบนี้ก็เป็นคนละค่ากับ #fbe455 และ #fce604
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e8232a]/60 bg-gradient-to-br from-[#3d1709]/96 to-[#241000]/96 p-8 text-left text-base leading-relaxed text-[#fbe8d5] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8232a]/90 hover:shadow-[0_15px_40px_rgba(232,35,42,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8232a]/34 blur-[55px] transition-all duration-500 group-hover:bg-[#e8232a]/50">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8730a]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#f2b705]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7d0f12] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5a46] via-[#e8232a] to-[#7d0f12] shadow-[0_0_10px_rgba(232,35,42,0.7)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ff5a46] via-[#f5cbb0] to-[#f2b705] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
