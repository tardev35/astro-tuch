---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1f74d6]/55 bg-gradient-to-br from-[#062a72]/92 to-[#01102e]/94 p-8 text-left text-base leading-relaxed text-[#d3e6ff] shadow-[0_10px_30px_rgba(1,12,38,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#4aa4f4]/75 hover:shadow-[0_15px_40px_rgba(74,164,244,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#4aa4f4]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#4aa4f4]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1f74d6]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#5ee7ff]/32">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1f74d6]/50 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] shadow-[0_0_10px_rgba(74,164,244,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#9ad4ff] via-[#4aa4f4] to-[#1f74d6] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
