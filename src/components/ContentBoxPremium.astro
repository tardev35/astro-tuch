---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม-ดำ 2026-09-25): การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่
// จากพื้นการ์ดดำอมน้ำตาล #14100a ลงไปหาพื้นเพจ #050403 ในกรอบทองลึก #8c5f14 ที่
// สว่างขึ้นเป็นทองแบรนด์ #fcda65 ตอน hover ออร่าสองมุมแยกด้วยคู่โลหะของโลโก้จริง คือ
// ทอง #d9a62b กับเงินโครเมียม #d2d3d4 แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ตามลำดับ
// โลหะบนโลโก้ คือทองสว่าง #fee47b → ขาวโครเมียม #fcfcfc → ทองแบรนด์ #d9a62b ตรงกับ
// MI ที่เป็นทอง คำว่า RACLE ที่เป็นเงิน และเลข 55 ที่กลับมาเป็นทอง เนื้อความ #e8e6e1
// (BRAND_TEXT) — ชุดทอง-โครเมียมของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec
// #161106 #080602 #ece6d8) ออกทั้งหมด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8c5f14]/60 bg-gradient-to-br from-[#14100a]/94 to-[#050403]/96 p-8 text-left text-base leading-relaxed text-[#e8e6e1] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcda65]/75 hover:shadow-[0_15px_40px_rgba(252,218,101,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d9a62b]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fee47b]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d2d3d4]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#d2d3d4]/26">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8c5f14]/70 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] shadow-[0_0_10px_rgba(252,218,101,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
