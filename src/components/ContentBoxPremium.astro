---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอป 2026-10-24 **ไม่มีรูปประกอบบทความของแบรนด์นี้เลย**
// (banner2.png / banner3.png เป็นของแบรนด์ก่อน และ eager import = emit ขึ้น dist
// ทุก build) จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide*
// ไว้กับ ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ถูกใช้ครบสองใบ
// แล้วที่ §4 กับ §5
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// **ฟ้าสกายบับเบิล/แคนดี้บนธีมสว่าง · การ์ดขาว หมึกน้ำเงินมหาสมุทรเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้กลับทิศเป็นธีมสว่าง**: bg.json ของดรอปนี้คือ
// {"mode":"color","color":"#00bfff"} = ฟ้าสกายอิ่มตัว **ห้าม "แก้" การ์ดใบนี้ให้
// กลับไปเป็นพื้นมืด และห้ามเหลือแดง/มุก/ดำอมแดงไว้เลยสักค่า**
//
// อ่านจากอาร์ตเวิร์กของดรอปนี้จริง: โลโก้คือ **หัวการ์ตูนผู้หญิงผมมวยสูงผูกโบว์ขาว
// ทำหน้าตกใจ คู่กับคำว่า โบ๊ะบ๊ะ168 ตัวอักษรบับเบิลสามมิติไล่เฉดฟ้าสกายเข้มลงหา
// ฟ้าอ่อนเกือบขาว ตัดขอบขาวหนา** แบนเนอร์เป็น **สตูดิโอพื้นขาว ผู้หญิงเสื้อคลุมถัก
// ฟ้าอ่อนถือโทรศัพท์** ประดับด้วย **เมฆการ์ตูน หัวใจฟ้า ประกาย และตู้สล็อต 777**
// ⚠️ **เสื้อคลุมฟ้าอ่อน ฉากสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงเป็น
// วัตถุในภาพ ไม่ใช่สี UI** — รอบนี้จึงไม่มีทอง ไม่มีเหลือง ไม่มีพีช ไม่มีครีม
//
// บทบาทสีในไฟล์นี้:
//   ผิวการ์ด #ffffff · ผิวยก #f0faff · wash #e4f6fb · พื้นเพจ #00bfff
//   แผ่นถมหัวข้อ = ไล่ **#1a6ea8 → #0f5684 บนหมึกขาว** ซึ่งเป็นครึ่งบนของสูตร
//     "CTA หลัก" ใน §2 (ขาวบน #1a6ea8 = 5.5:1 · บน #0f5684 = 7.8:1)
//     ⚠️⚠️ **ไล่เฉดไม่ลากขึ้นไปถึง #12b4ef หรือ #00bfff โดยตั้งใจ** — §2 ระบุตรงๆ
//     ว่า **ห้ามวางหมึกขาวบนสองเฉดนั้น (2.4:1 / 2.1:1)**
//   ฟ้าสกาย #12b4ef = ต้นของเส้นใต้หัวข้อ + ออรามุมบนซ้าย — **พื้นถม/ออราเท่านั้น
//     ห้ามถือตัวอักษรบนผิวสว่าง (2.4:1 บนขาว)**
//   ฟ้าพาสเทล #b6e3f0 = ปลายเส้นใต้หัวข้อ + ออรามุมขวาล่าง — **พื้นถมเท่านั้น**
//   เส้น/ขอบ #7fcbe8 อิ่มเป็น #12b4ef ตอน hover — **ห้ามถือตัวอักษร**
//   หมึก #06283f = เนื้อความ (= BRAND_TEXT) 15.2:1 บนการ์ดขาว
//   ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ **#0f5684** (7.8:1) และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดกล่อง ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็น **ใบเดียวของหน้าที่หัวข้อนั่งบนแผ่นถมทึบพร้อมหมึกขาว + เส้นใต้เต็ม
// ความกว้าง** ส่วนใบอื่นใช้ §2 แท่งตั้งข้างหัวข้อโดยไม่มีการ์ดครอบ · §3 สันซ้าย
// สี่พิกเซลบนการ์ดมุมตัด 40px · §4 หัวข้อทึบชิดซ้ายพร้อมขีดสั้น บนการ์ดมุมกลม ·
// §5 ชิปถมฟ้าคู่กลีฟเมฆ บนการ์ดมุมตัด 36px · §6 หัวข้อกึ่งกลางโดยมีเส้นคาดอยู่
// "เหนือ" หัวข้อ · §7 หัวข้อคร่อมเส้นคู่บน-ล่างในการ์ดซ้อนการ์ด · §8 แผ่นป้าย
// มุมมนรางซ้ายพร้อมหัวข้อไล่เฉด bg-clip-text
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — และรอบนี้เป็นแบรนด์ฟ้าจริง จึงต้อง
// เทียบฟ้าของแบรนด์อื่นทีละหลัก** ฟ้ารอบนี้คือ **#12b4ef (R18 G180 B239) /
// #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 / #1a6ea8 / #06283f** เท่านั้น
// ค่าที่ห้ามเหลือ:
//   fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
//   1c0607 2a0c0d 551c1e (**สล็อต168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 (**หมูบิน168 — แบรนด์ขาออก เสี่ยงหลงเหลือ
//   สูงสุด**) ·
//   1177e8 0e68cc 0a4ea8 (มาดาม168 — ⚠️ 0a4ea8 ใกล้ #0b4a73 ที่ G) · 1fd8f0 0bb6d4
//   1d4fd8 143aa0 (นาซ่า168) · 18a5e2 0d6b9b a9d7f2 (ร่ำรวย168 — ⚠️⚠️ **18a5e2
//   ห่างจาก #12b4ef แค่ R6/G15/B13 เจอที่ไหนแปลว่าพิมพ์ผิด**) · 32bcfb a9e9ff
//   07335f (นินจา168) · 2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168 — ⚠️ 063a57 มี R=06
//   ตรงกับ #06283f เป๊ะ) · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 2f9ff5 a8dcff d6ecff
//   0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff cfdcec 9db4d4 (TSDET911)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าใน
// src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้า ไม่มีแดง ไม่มีทอง/เหลือง ไม่มีส้ม ไม่มีม่วง
// ไม่มีเขียว ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน**
// (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น คงไว้)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#7fcbe8] bg-white p-8 text-left text-base leading-relaxed text-[#06283f] shadow-[0_12px_34px_rgba(15,86,132,0.14)] transition-all duration-500 hover:border-[#12b4ef] hover:shadow-[0_18px_44px_rgba(18,180,239,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#12b4ef]/25 blur-[62px] transition-all duration-500 group-hover:bg-[#12b4ef]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#b6e3f0]/45 blur-[62px] transition-all duration-500 group-hover:bg-[#b6e3f0]/65">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#1a6ea8] to-[#0f5684] px-5 py-3 ${headingSize} leading-normal font-black tracking-wide text-white shadow-[0_8px_22px_rgba(15,86,132,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#12b4ef] via-[#b6e3f0] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
