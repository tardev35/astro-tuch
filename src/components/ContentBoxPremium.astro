---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// MHEEPOOH168: การ์ดไล่จากแดงเข้ม #2b0101 ลงไปหาดำอมแดง #120303 ในกรอบแดงสด
// #c4161c หัวข้อมีแถบทองแนวตั้งนำหน้าและเส้นคั่นทองเข้มใต้หัวข้อ ซึ่งเป็นรูปทรงที่ต่าง
// จาก ContentBox ตัวหลัก (เส้นทองพาดขอบบน + ขีดสั้นใต้หัวข้อ) เพราะหน้าแรกวาง
// สองการ์ดนี้ไว้ในหน้าเดียวกัน ออร่าสองมุมเป็นแดงสดกับทองสว่าง #fced74 ตามคู่สี
// ทองบนแดงของโลโก้
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c4161c]/45 bg-gradient-to-br from-[#2b0101]/94 to-[#120303]/96 p-8 text-left text-base leading-relaxed text-[#f1dccd] shadow-[0_10px_30px_rgba(0,0,0,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fced74]/70 hover:shadow-[0_15px_40px_rgba(245,183,10,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c4161c]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#c4161c]/42">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fced74]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#fced74]/24">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8a5a06]/55 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced74] via-[#f5b70a] to-[#8a5a06] shadow-[0_0_10px_rgba(245,183,10,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
