---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit)
// จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน — playbook ตรึง slide* ไว้กับ
// ContentBoxSevenThree* เท่านั้น และโควตา SevenThree รอบนี้ใช้ครบ 2 แล้ว
//
// มีทรัพย์168 (2026-10-21) — พาเลตตาม .claude/brand-spec-meesub168.md §2
// ⚠️⚠️ **รอบนี้เป็นแบรนด์ "ธีมสว่าง" ตัวแรกของรีโปนี้ — การ์ดกลับทิศจากทุกรอบก่อน**
// bg.json = {"mode":"color","color":"#f0ccf5"} = ชมพูอมม่วงสว่าง ไม่ใช่ดำ การ์ด
// เนื้อหาทุกใบจึงเป็น **ผิวสว่าง + หมึกเข้ม** ห้าม "แก้" กลับไปเป็นพื้นเข้มเพราะ
// รอบก่อนๆ เป็นแบบนั้น
// งานศิลป์: โลโก้เป็นหัวหมูการ์ตูนชมพูอ่อนสวมหน้ากากโจรสีดำ คู่กับคำว่า "มีทรัพย์"
// ตัวอักษรไทยสามมิติไล่เฉดชมพู และเลข 168 ผิวเงิน ส่วนแบนเนอร์เป็นฉากฟาร์มทุ่งหญ้า
// แดดจัด ยุ้งฉางไม้แดง กังหันลม ฟ่อนฟาง และหมูสวมหน้ากากโจร
// ⚠️ ฟ้าของท้องฟ้า เขียวของหญ้า แดงของยุ้งฉาง เหลืองของฟ่อนฟาง และเงินของเลข 168
// เป็น **วัตถุในภาพ ไม่ใช่สีแบรนด์** ห้ามดึงเข้ามาเป็นสีของ UI
//
// บทบาทสีในไฟล์นี้ (ลำดับผิว: #ffffff ยก · #f7dcf6 กลาง · #f0ccf5 พื้นเพจ):
//   ชมพูบานเย็น #dd1b74 = กรอบการ์ด ออรา และต้นของแผ่นหัวข้อ
//   โรสเข้ม #a4186b = กลางของแผ่นหัวข้อ และ <strong> ในเนื้อความของหน้า
//   พลัมเข้ม #4a0d35 = เนื้อความ (= BRAND_TEXT, 14.9:1 บนผิวขาว) และปลายของแผ่นหัวข้อ
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่หัวข้อนั่งบน **แผ่นถมชมพูสด ตัวอักษรขาว** ไล่
// #dd1b74 → #a4186b → #4a0d35 ซึ่งเป็นวิธีเดียวที่ §2 อนุญาตให้ "อ่านว่าชมพูสด"
// ได้ (ถม #dd1b74 แล้ววาง #ffffff ทับ = 4.67:1 ผ่าน AA · บน #a4186b 7.2:1 · บน
// #4a0d35 14.9:1 — ทั้งสามสต็อปปลอดภัย **ห้ามพลิกแผ่นนี้ไปใช้หมึกเข้ม**)
// คู่ตรงข้ามของมันคือ §5 (ContentBoxSevenThreeFloatingBadge) ที่เป็นแผ่นถม
// **พลัมเข้มทึบ ตัวอักษรชมพูอ่อน** — สองขั้วของแผ่นถมบนหน้าเดียวกัน
//
// ⚠️ §2 ห้าม #dd1b74 ถือตัวอักษรบนพื้นเข้ม (3.2:1) และห้าม #f0ccf5/#f7dcf6 ถือ
// ตัวอักษรบนผิวขาว — ในไฟล์นี้ #dd1b74 อยู่ที่กรอบ ออรา และพื้นถมเท่านั้น
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ชมพูเคยนำมาแล้วสามแบรนด์** (ถอนชัวร์168
// fa63b9 · มีโชค168 f5469f · มีเฮ168 ff8f9c) การเจอชมพูในไฟล์จึงไม่พิสูจน์อะไร
// ตัวที่ใกล้ dd1b74 ที่สุดคือ f5469f (ห่าง 65) และ fa63b9 (ห่าง 104)
// ชุดทองน้ำผึ้ง-แดงชาดของ ดวงเศรษฐี168 (รอบขาออก: d9212a 8e1a16 f0c878 fff8d8 2a0608
// 4e2120 300605 150303 000000 + rgba 217/33/42 240/200/120 142/26/22) และชุดทองสองเฉด-
// บรอนซ์ของ ufalion168 ที่เคยอยู่ทั้งใบนี้ (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4
// 33200a 1f1304 0a0601 5a3310 1a1000 fbf6e3) ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของ
// รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400)
// มีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205 fdeaec 1b0308)
// รวยแทร่168 (039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d)
// นินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28 030e16 041019 dceefc)
// สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5)
// มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12)
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509)
// รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f)
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303)
// และ UFA324 (e5a81b ffe08a bb8410 7d5a07 43300a 8792a0 f0e8d4 b9c2cc 464f5a)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีแดงชาด ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้ม**
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#dd1b74]/55 bg-white p-8 text-left text-base leading-relaxed text-[#4a0d35] shadow-[0_12px_34px_rgba(74,13,53,0.18)] transition-all duration-500 hover:border-[#dd1b74]/85 hover:shadow-[0_18px_44px_rgba(221,27,116,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#dd1b74]/25 blur-[62px] transition-all duration-500 group-hover:bg-[#dd1b74]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#f0ccf5]/95 blur-[62px] transition-all duration-500 group-hover:bg-[#a4186b]/25">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#dd1b74] via-[#a4186b] to-[#4a0d35] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-white uppercase shadow-[0_8px_24px_rgba(221,27,116,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#a4186b] via-[#dd1b74] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
