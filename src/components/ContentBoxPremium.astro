---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a87a1e]/50 bg-gradient-to-br from-[#08234c]/92 to-[#01091b]/92 p-8 text-left text-base leading-relaxed text-[#d5e3f7] shadow-[0_10px_30px_rgba(1,9,27,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfb455]/85 hover:shadow-[0_15px_40px_rgba(223,180,85,0.34)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a87a1e]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#dfb455]/36"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3d8fd8]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#3d8fd8]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a87a1e]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d979] via-[#dfb455] to-[#12508f] shadow-[0_0_10px_rgba(223,180,85,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf1cd] via-[#dfb455] to-[#a87a1e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
