---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): รอบนี้เป็นการ
// พลิกขั้วจากแบรนด์สว่างของ HI59 กลับมาเป็นแบรนด์มืด พื้นเพจเป็นดำสนิท #000000
// ตาม bg.json การ์ดใบนี้ถือ docx H1 ของหน้าแรก จึงเป็นการ์ดที่หนักแน่นที่สุดในหน้า
// และเป็นใบเดียวที่หัวข้อขึ้นที่ text-3xl
//
// ไฟล์นี้ต้องไม่อ่านเป็นใบเดียวกับ ContentBoxTwoPremium และ
// ContentBoxSevenThreePremium ที่อยู่หน้าเดียวกัน จึงแยกด้วยรูปทรง: สันตั้งไล่เขียว
// นีออนหน้าหัวข้อ + ผิวการ์ดไล่เฉดจากผิวยก #0b231b ลงไปหาพื้นลึกสุด #041109
// (TwoPremium เป็นผิวทึบ #07170f ส่วน SevenThreePremium ไล่เฉดเดียวกันแต่กรอบเขียวลึก)
// และหัวข้อไล่เขียวนีออน #42fb5a → ขาว #ffffff → ทอง #f3c44a ซึ่งเป็นลำดับสีคนละ
// ชุดกับทุกกล่องบนหน้าเดียวกัน — นีออนนำหน้าเพราะบนโลโก้จริงคำว่า BOOM สีเขียวนีออน
// คือสิ่งที่ตาอ่านก่อนตัวเลข 369 สีเงินและก่อนเหรียญทองในฉาก
//
// กรอบเขียวนีออน #42fb5a/55 สว่างขึ้นตอน hover ออร่ามุมซ้ายบนเป็นเขียวนีออน
// มุมขวาล่างเป็นเงินโครเมียม #dadcdc (ตัวเลข 369 ในโลโก้เป็นเงินแปรง)
// เส้นใต้หัวข้อเป็นเขียวลึก #036b26 เนื้อความ #cfe9d7 (= BRAND_TEXT, 12.0:1 บน
// ผิวยก #0b231b) glow ทุกจุดเป็น rgba(66,251,90,…)
//
// ชุดแดงแบรนด์ + เงินโครเมียมของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#dc0409 #f5363d
// #8e0206 #4b0205 #211016 #0d0407 #17080c #eef0f4 #c3c7d1 #f3c54e #edeaf0
// rgba(220,4,9,…)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#42fb5a]/55 bg-gradient-to-br from-[#0b231b]/96 to-[#041109]/96 p-8 text-left text-base leading-relaxed text-[#cfe9d7] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#42fb5a]/85 hover:shadow-[0_15px_40px_rgba(66,251,90,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#42fb5a]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#42fb5a]/42">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#dadcdc]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#dadcdc]/26">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#036b26] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#42fb5a] via-[#ffffff] to-[#f3c44a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
