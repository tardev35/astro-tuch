---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#b5811e]/50 bg-gradient-to-br from-[#123209]/92 to-[#030803]/92 p-8 text-left text-base leading-relaxed text-[#ecdfb4] shadow-[0_10px_30px_rgba(3,8,3,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2c466]/85 hover:shadow-[0_15px_40px_rgba(226,196,102,0.34)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#b5811e]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#e2c466]/36"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1c9b22]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#1c9b22]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#b5811e]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbe479] via-[#e2c466] to-[#0b530d] shadow-[0_0_10px_rgba(226,196,102,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fff4cd] via-[#e2c466] to-[#b5811e] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
