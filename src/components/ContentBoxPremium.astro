---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): เว็บสล็อตออนไลน์ โลโก้เป็นตัวอักษรทองเมทัลลิกล้วน
// บนพื้นโปร่ง (#e4b34d นำ รองด้วย #fdf2ac) และแบนเนอร์เป็นฉากทองอร่ามบนพื้นดำอมน้ำตาล
// แบรนด์นี้จึงเป็น "สีเดียว: ทอง" ไม่มีสีคู่ตรงข้าม ความต่างสร้างจากระดับความสว่างของทอง
// การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่จากผิวการ์ด #241404 ลงไปหาผิวดำสนิท #140c02 ในกรอบ
// ทองแบรนด์ #e4b34d ที่สว่างขึ้นเป็นแชมเปญ #fdf2ac ตอน hover ออร่าสองมุมเป็นทองสองระดับ
// คือทองแบรนด์มุมซ้ายบนและแชมเปญมุมขวาล่าง แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่แชมเปญ
// #fdf2ac → ทองแบรนด์ #e4b34d → ทองลึก #8a5f12 เนื้อความ #f3e8cf (BRAND_TEXT)
// — ชุดแดงสด-ทองของ หวย365/หวยเฮง789 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07
// #240406 #180303 #f6e7e0 #dc2224 #f4bc5d #ffefc2 #fbe3d4) ออกครบทุกจุด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e4b34d]/55 bg-gradient-to-br from-[#241404]/94 to-[#140c02]/96 p-8 text-left text-base leading-relaxed text-[#f3e8cf] shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdf2ac]/70 hover:shadow-[0_15px_40px_rgba(228,179,77,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e4b34d]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#fdf2ac]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdf2ac]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#e4b34d]/32">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8a5f12] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] shadow-[0_0_10px_rgba(228,179,77,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
