---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// This card carries docx H1 §1 of the home page (content.txt line 6): one
// paragraph, one slot, no sub-headings. This drop has NO current-brand article
// illustration (banner2/banner3 on disk belong to previous brands and an eager
// import IS an emit), so there is no picture inside the card, and a slide is
// never substituted — the playbook pins slide* to ContentBoxSevenThree* only.
//
// ขวัญใจ168 (รอบทองนำ · โรสโกลด์เป็นฮิวที่สอง · แดงชาดเป็นสำเนียงลึก บนดำสนิท
// 2026-10-18) — พาเลตต์ตาม .claude/brand-spec-kwanjai168.md §2
// งานศิลป์: คำว่า "ขวัญใจ" เป็นตัวอักษรไทยหนาสามมิติผิวทองขัดเงาตัดขอบแดงเข้ม
// ต่อด้วยเลข "168" ทองสามมิติ บนโบว์ริบบิ้นทอง ด้านหลังเป็นหญิงสาวผมดำเกล้ามวย
// ประดับปิ่นทองห้อยระย้าและดอกไม้ขาว ในชุดไทยแดงปักทอง ล้อมด้วยเหรียญจีนทอง
// รูสี่เหลี่ยมและหัวใจแดง
// ⚠️ โรสโกลด์ #f2bba5 คือ vivid อันดับหนึ่งที่ palette.json วัดได้จากทั้งโลโก้และ
// แบนเนอร์ และเป็น **สิ่งที่แยกรอบนี้ออกจากสองรอบก่อน** (รอบก่อนทองนำ+แดงสดคู่หู
// รอบก่อนหน้านั้นแดงนำ) จึงต้องเห็นจริงบนการ์ด — ที่นี่มันเป็นปลายของแผ่นป้ายหัวข้อ
// สีขอบตอน hover และออรามุมขวาล่างตอน hover
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #241509 ยก /
// #160d06 กลาง / #0b0603 จม / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่ **พลิกขั้วหัวข้อ** — หัวข้อนั่งบน **แผ่นทองทึบ** ที่ไล่
// ทองสว่าง #ffe6a3 → ทองแบรนด์ #f7c92b → โรสโกลด์ #f2bba5 แล้วถือ **หมึกเข้ม
// #140c06** (7.9:1 บนทองแบรนด์ · 15.6:1 บนทองสว่าง · 11.2:1 บนโรสโกลด์) ส่วนอีก
// เจ็ดใบของหน้าเป็นตัวอักษรสว่างบนพื้นมืดทั้งหมด
// ผิวการ์ด **ไล่จากยก #241509 ลงไปหาจม #0b0603** จึงไม่อ่านเป็นใบเดียวกับ
// ContentBox (§3) ที่เป็นมุมกลมเหมือนกันแต่ผิวยกทึบและหัวข้อเป็นตัวอักษรไล่เฉด
// มุมเป็น rounded-[28px] กรอบหนา 2px ทองแบรนด์ (อิ่มเป็นโรสโกลด์ตอน hover)
// ออรามุมซ้ายบนเป็นแดงชาด #b3121b (หัวใจแดงกับชุดไทยในงานศิลป์) มุมขวาล่างเป็น
// แดงลึก #5a0a0e ที่ไต่ขึ้นเป็นโรสโกลด์ตอน hover เนื้อความ #eadfce (= BRAND_TEXT,
// 13.5:1 บนผิวยก)
// §2 ห้าม #b3121b #5a0a0e #8a5f12 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ทั้งสามค่าอยู่ที่
// ขอบ ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" และ **กับดักรอบนี้คือทอง** เพราะทองคือฮิวนำ
// ทั้งที่เกือบทุกแบรนด์ที่ผ่านไฟล์นี้ก็มีทอง — ทองรอบนี้คือ #f7c92b (R=247 G=201
// B=43) เท่านั้น ทองของแบรนด์ก่อนๆ ที่เคยอยู่ในไฟล์นี้: f0b429 (รับตัง168) ·
// e3b23c (สมหวัง168) · e2b33f (KMD88) · dfa310 + ffc93d + ffe4a3 (TND168) ·
// f2c230 + ffe066 (KINGKONG555) · e5a81b (UFA324) · fad354 (789BETTING) ·
// f5c518 (FLASH877) · f3bb34 (DUCK1688) · fbe455 (WEPLAY168) — ออกครบแล้ว
// ชุดเต็มของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505 1a0505 + rgba 240,180,41 / 211,3,4 / 255,220,140 /
// 255,107,110) และชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706 290f0f) ไม่เหลือเลย
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ แดงรอบนี้คือ #b3121b และ **มันไม่เคยนำ** — ไม่ใช่ d30304 fa0513 fb131b fb141b
// d4200d e8232a หรือ ff3b14
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีชมพูบานเย็น ไม่มีเขียว ไม่มีส้ม
// และไม่มีเงิน/โครเมียมอมฟ้า** (cfd9e6 เป็นของรับตัง168 โลโก้รอบนี้ไม่มีโครเมียมเลย)
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#f7c92b]/70 bg-gradient-to-br from-[#241509] via-[#160d06] to-[#0b0603] p-8 text-left text-base leading-relaxed text-[#eadfce] shadow-[0_12px_34px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2bba5]/80 hover:shadow-[0_18px_44px_rgba(247,201,43,0.3)] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#b3121b]/45 blur-[62px] transition-all duration-500 group-hover:bg-[#b3121b]/60">
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#5a0a0e]/85 blur-[62px] transition-all duration-500 group-hover:bg-[#f2bba5]/28">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#ffe6a3] via-[#f7c92b] to-[#f2bba5] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#140c06] uppercase shadow-[0_8px_24px_rgba(247,201,43,0.35)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#8a5f12] via-[#b3121b] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
