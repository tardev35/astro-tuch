---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0b6cf0]/45 bg-gradient-to-br from-[#0a1836]/92 to-[#03081c]/90 p-8 text-left text-base leading-relaxed text-[#cfdcea] shadow-[0_10px_30px_rgba(2,6,15,0.5)] backdrop-blur-xl transition-all duration-500 hover:border-[#0b6cf0]/80 hover:shadow-[0_15px_40px_rgba(11,108,240,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b6cf0]/24 blur-[55px] transition-all duration-500 group-hover:bg-[#4aa3ff]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0a2a6b]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#c3ced9]/34"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0b6cf0]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c3ced9] via-[#4aa3ff] to-[#0a2a6b] shadow-[0_0_10px_rgba(11,108,240,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#eaf3fd] via-[#9dd2fa] to-[#c3ced9] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
