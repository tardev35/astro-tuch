---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and every
// decorative aura carries `-z-10`, so the slot renders as a direct child with no
// `relative z-10` wrapper. Do not re-add one. No level is hardcoded — `as`
// decides the tag — and nothing here is `absolute`/`whitespace-nowrap`, so a
// full docx sentence wraps instead of overflowing.
//
// รอบนี้ใบนี้ถือ **docx H1 §1** ของหน้าแรก (content.txt บรรทัด 4): หนึ่งย่อหน้า
// หนึ่งสล็อต ไม่มีหัวข้อย่อย ดรอปนี้ไม่มีรูปประกอบบทความของแบรนด์ปัจจุบัน
// (banner2/banner3 ที่ค้างบนดิสก์เป็นของแบรนด์ก่อน และ eager import = emit)
// จึงไม่มีรูปในการ์ดใบนี้ และห้ามเอา slide มาแทน
//
// มีเฮ168 (รอบ **แดงชาดนำ · ทองเนยเป็นฮิวที่สอง · แดงลึก/บรอนซ์ลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม .claude/brand-spec-meehay168.md §2
// งานศิลป์: โลโก้เป็นคำว่า "มี" ตัวอักษรไทยหนาสามมิติสีขาวมุกตัดขอบเทา ต่อด้วย
// "เฮ168" สีแดงชาดบับเบิลผิวมันวาว ทางซ้ายเป็นหน้ายิ้มหัวเราะสีเหลืองทองแก้มชมพู
// นั่งบนกองเหรียญทอง ล้อมด้วยประกายดาวสีทองและขีดประกายสีแดงบนพื้นขาว
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0711 ยก / #1a040a กลาง /
// #0c0205 จม / #000000 พื้น — การ์ดใบนี้ไล่จากยกลงไปจม
//
// จังหวะรูปทรงของใบนี้ (หน้าแรกมีแปดบล็อก ไม่มีใบไหนอ่านซ้ำกัน):
// ใบนี้เป็นใบเดียวของหน้าที่ **พลิกขั้วหัวข้อ** — หัวข้อนั่งบน **แผ่นถมสว่างทึบ**
// ที่ไล่ครีมชมพู #ffe3e6 → แดงแบรนด์ #fb1b32 → ทองเนย #fcd45c แล้วถือ
// **หมึก #1b0308** ซึ่ง §2 ระบุว่าเป็นหมึกตัวเดียวที่วางบนพื้นถมแดง/ทองได้
// (5.0:1 บน #fb1b32 · 13.8:1 บน #fcd45c และสูงกว่านั้นบน #ffe3e6 — ทั้งสามปลาย
// ปลอดภัย **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ส่วนอีกเจ็ดใบของหน้าเป็นตัวอักษร
// สว่างบนพื้นมืดทั้งหมด
// มุม rounded-[28px] กรอบหนา 2px แดงแบรนด์ (อิ่มเป็นทองเนยตอน hover) ออรามุม
// ซ้ายบนเป็นแดงลึก #5c0410 (โบว์แดงกับหัวใจแดงในงานศิลป์) มุมขวาล่างเป็นบรอนซ์ลึก
// #6b4a08 ที่ไต่ขึ้นเป็นชมพูบลัชตอน hover เนื้อความ #fdeaec (= BRAND_TEXT, 15:1
// บนผิวยก) §2 ห้าม #5c0410 (1.4:1) และ #6b4a08 (1.8:1) ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้ทั้งสองค่าอยู่ที่ขอบ ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" และ **รอบนี้กับดักมีสองชั้น: แดง และ ทอง**
// เพราะทั้งคู่เคยผ่านรีโปนี้มาหลายแบรนด์ โดยเฉพาะ **fa0513 ของสมหวัง168 ที่อยู่ห่าง
// จาก #fb1b32 ของรอบนี้แค่นิดเดียว** (G27 vs G5 · B50 vs B19) ห้ามกะด้วยตา
// ค่าของแบรนด์ก่อนที่ต้องไม่เหลือ: 32bcfb a9e9ff fef54b 07335f 6b5c10 0c2a3d 071a28
// 030e16 041019 dceefc (นินจา168) · 039cfa 0494f5 c3ebfc 04366b f9a826 704504 e3f2fc
// 0b2d52 071e38 030f1d 031320 (รวยแทร่168 รอบที่แล้ว) · 2f9ff5 a8dcff d6ecff 0b3f78
// ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f (สบายเบท168) · fa0513 ffadaf
// ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 (สมหวัง168) · f0b429
// ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c (รับตัง168) · f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e 8a5f12 (ขวัญใจ168) · fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 (มีโชค168) · fa63b9 ffb3de ffd84d 6d0b3f 6b4708 (ถอนชัวร์168) · 04225b ·
// 2563eb
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ม่วง เขียว ส้ม เงิน/โครเมียม โรสโกลด์
// เหลืองมะนาว และชมพูฟูเชีย** ชมพูตัวเดียวที่อนุญาตคือบลัช #ff8f9c ซึ่งเป็นแดงจาง
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-[#fb1b32]/70 bg-gradient-to-br from-[#2b0711] via-[#1a040a] to-[#0c0205] p-8 text-left text-base leading-relaxed text-[#fdeaec] shadow-[0_12px_34px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcd45c]/80 hover:shadow-[0_18px_44px_rgba(251,27,50,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#5c0410]/55 blur-[62px] transition-all duration-500 group-hover:bg-[#5c0410]/75">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#6b4a08]/80 blur-[62px] transition-all duration-500 group-hover:bg-[#ff8f9c]/26">
    </div>

    {
      title && (
        <header class="mb-7 flex flex-col gap-4">
          <HeadingTag
            class={`w-fit rounded-2xl bg-gradient-to-r from-[#ffe3e6] via-[#fb1b32] to-[#fcd45c] px-5 py-3 ${headingSize} leading-normal font-black tracking-widest text-[#1b0308] uppercase shadow-[0_8px_24px_rgba(251,27,50,0.4)]`}>
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#6b4a08] via-[#5c0410] to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
