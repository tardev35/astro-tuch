---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): เว็บคาสิโนออนไลน์ โลโก้เป็นเวิร์ดมาร์กสองส่วน WIN
// เป็นทองสด #fcc403 แล้ว 999 เป็นขาว การ์ดใบนี้ถือทั้ง H1 ของหน้าแรกและ H2 หัวข้อ
// โปรโมชั่น จึงไล่จากผิวการ์ดดำอมทอง #191712 ลงไปหาพื้นเพจดำสนิท #050505 ในกรอบทองลึก
// #8a6502 ที่สว่างขึ้นเป็นทองแบรนด์ #fcc403 ตอน hover ออร่าสองมุมแยกด้วยทองแบรนด์
// #fcc403 กับทองสว่าง #fdda04 แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ทองสว่าง #fdda04 →
// ทองแบรนด์ #fcc403 → ทองลึก #8a6502 เนื้อความ #e9e4d6 (BRAND_TEXT) — ชุดชมพูนีออน-
// ม่วงของ SEXYGAME666 (#fa42b5 #ffd6f0 #ffa6dd #8b3df3 #7d1550 #4a0e33 #170a22
// #08020d #f2dcee) ออกครบทุกจุด
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a6502]/70 bg-gradient-to-br from-[#191712]/94 to-[#050505]/96 p-8 text-left text-base leading-relaxed text-[#e9e4d6] shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcc403]/75 hover:shadow-[0_15px_40px_rgba(252,196,3,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fcc403]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#fdda04]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fdda04]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#fdda04]/28">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a3402]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdda04] via-[#fcc403] to-[#8a6502] shadow-[0_0_10px_rgba(252,196,3,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#8a6502] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
