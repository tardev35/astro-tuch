---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): เว็บเล่นหวยออนไลน์ โลโก้เป็นเวิร์ดมาร์กสามมิติ
// สองส่วน คำว่า "หวย" เป็นแดงเลือดนกเงาวาวขอบทอง แล้วปิดด้วย "เฮง24" ทองไล่เฉด งาน
// อาร์ตเป็นผ้าซาตินแดงที่มีเงาปราสาททอง เหรียญทองกองสูง และลูกหวยแดง-ขาว แบรนด์นี้
// จึงเป็นสองสีจริง คือแดงเป็นพื้น ทองเป็นแอ็กเซนต์ — การ์ดใบนี้ถือ H1 ของหน้าแรก จึงไล่
// จากผิวการ์ดแดงเข้ม #2e0707 ลงไปหาพื้นเพจแดงเกือบดำ #1a0505 ในกรอบทองแบรนด์
// #e0a52a ที่สว่างขึ้นเป็นทองอ่อน #fdea83 ตอน hover ออร่าสองมุมแยกหน้าที่ตามคู่สีของ
// โลโก้ คือทองมุมซ้ายบนตาม "เฮง24" และแดงแบรนด์ #8b0302 มุมขวาล่างตาม "หวย"
// แถบแนวตั้งหน้าหัวข้อและตัวหัวข้อไล่ทองอ่อน #fdea83 → ทองแบรนด์ #e0a52a → แดง
// แบรนด์ #8b0302 ตามลำดับสีบนเวิร์ดมาร์ก เนื้อความ #f6e6cf (BRAND_TEXT) — ชุดน้ำเงิน
// รอยัล-ทองของ BRAVO168 (#1558c4 #0e3f8f #2f86f0 #f4cb69 #ffe39a #c9922e #04142f
// #02081a #dbe5f5) ออกครบทุกจุด และไม่มีเขียวของ หวยเต็ง หลงเหลืออยู่เลย
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e0a52a]/55 bg-gradient-to-br from-[#2e0707]/94 to-[#1a0505]/96 p-8 text-left text-base leading-relaxed text-[#f6e6cf] shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdea83]/70 hover:shadow-[0_15px_40px_rgba(224,165,42,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e0a52a]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#fdea83]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8b0302]/32 blur-[55px] transition-all duration-500 group-hover:bg-[#c01616]/38">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#720202] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#8b0302] shadow-[0_0_10px_rgba(224,165,42,0.60)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
