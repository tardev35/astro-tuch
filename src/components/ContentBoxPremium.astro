---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a3060c]/45 bg-gradient-to-br from-[#1a0507]/92 to-[#0a0304]/90 p-8 text-left text-base leading-relaxed text-[#d8dae0] shadow-[0_10px_30px_rgba(255,42,48,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2a30]/70 hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff2a30]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#ff6b70]/28"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c0203]/45 blur-[55px] transition-all duration-500 group-hover:bg-[#d3d6db]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a3060c]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff6b70] via-[#ff2a30] to-[#5c0203] shadow-[0_0_10px_rgba(255,42,48,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ff2a30] via-[#ff6b70] to-[#d3d6db] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
