---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fced0b]/30 bg-gradient-to-br from-[#171200]/92 to-[#0c0900]/88 p-8 text-left text-base leading-relaxed text-[#f4ecc9] shadow-[0_10px_30px_rgba(252,237,11,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fced0b]/60 hover:shadow-[0_15px_40px_rgba(252,237,11,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fced0b]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#fff6b0]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b38f00]/45 blur-[55px] transition-all duration-500 group-hover:bg-[#6b5300]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fced0b]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6b0] via-[#fced0b] to-[#b38f00] shadow-[0_0_10px_rgba(252,237,11,0.45)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#fff6b0] via-[#fced0b] to-[#b38f00] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
