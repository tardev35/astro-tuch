---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// Single-slot variant, already flattened: the card carries `isolate` and the
// decorative aura layers carry `-z-10`, so the slot renders as a direct child
// with no `relative z-10` wrapper. Do not re-add one.
//
// No level is hardcoded below — `as` decides the tag, and the header carries no
// `whitespace-nowrap`, so a full docx sentence wraps instead of overflowing.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// แบรนด์รอบนี้เป็นแบรนด์ "สามสี" ไม่ใช่สองสี — แดง #c41115 นำ เขียวมรกต #0b7a33 รอง
// และทอง #d9a521 เป็นโลหะคั่น ตามโลโก้ที่เป็นเทพเจ้าโชคลาภจีนสวมหมวกเขียวคาดแดง
// ตัวอักษร GUCCI ขาวเงินขอบเขียว ทับเลข 168 แดงเมทัลลิกขอบทอง
//
// การ์ดใบนี้ถือ docx H1 ของหน้าแรก จึงเป็นการ์ดที่หนักแน่นที่สุดในหน้า และเป็นใบเดียว
// ที่หัวข้อขึ้นที่ text-3xl ไฟล์นี้ต้องไม่อ่านเป็นใบเดียวกับ ContentBoxTwoPremium และ
// ContentBoxSevenThreePremium ที่อยู่หน้าเดียวกัน จึงแยกด้วยรูปทรงและสีกรอบ: สันตั้ง
// ไล่แดงหน้าหัวข้อ + ผิวการ์ดไล่เฉดจากผิวยก #1d0b08 ลงไปหาผิวลึกสุด #090302 และกรอบ
// เป็น "กรอบแดงแบรนด์" #c41115 (SevenThreePremium ใช้กรอบเขียวลึก #063f1c ส่วน
// TwoPremium ใช้ผิวทึบ #140705 กรอบทอง) หัวข้อไล่แดงสว่าง #e0201f → ทองอ่อน #ffdf91
// → เขียวสว่าง #2bbf63 ซึ่งเป็นลำดับสีคนละชุดกับทุกกล่องบนหน้าเดียวกัน — แดงนำหน้า
// เพราะบนโลโก้จริง เลข 168 แดงเมทัลลิกคือมวลสีที่ตาอ่านก่อนเขียวของหมวกและก่อนเหรียญทอง
//
// ออรามุมซ้ายบนเป็นแดงแบรนด์ มุมขวาล่างเป็นทองแบรนด์ (เหรียญทองจีนสองเหรียญในโลโก้)
// เส้นใต้หัวข้อเป็นแดงลึก #7a0505 เนื้อความ #f6e3cf (= BRAND_TEXT, 16.4:1 บนผิวลึกสุด
// และ 14.2:1 บนผิวยก) glow ทุกจุดเป็น rgba(196,17,21,…)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #04ab3a #036b26
// #0b231b #041109 #f3c44a #ffffff #cfe9d7 rgba(66,251,90,…) rgba(218,220,220,…))
// ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c41115]/55 bg-gradient-to-br from-[#1d0b08]/96 to-[#090302]/96 p-8 text-left text-base leading-relaxed text-[#f6e3cf] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#c41115]/85 hover:shadow-[0_15px_40px_rgba(196,17,21,0.35)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c41115]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#c41115]/45">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d9a521]/22 blur-[55px] transition-all duration-500 group-hover:bg-[#d9a521]/34">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7a0505] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] shadow-[0_0_10px_rgba(196,17,21,0.65)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#e0201f] via-[#ffdf91] to-[#2bbf63] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
