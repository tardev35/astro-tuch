---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// `alt` is each tile's real logo, so the names stay as the artwork prints them —
// they are not copy to be swapped for the brief's wording. The brief names no
// individual provider, only "เกมจากหลายค่ายให้เลือก", so the label says that and
// the tiles say which ones.
//
// The block title is a <p> and the <section> carries an aria-label: a provider
// grid is chrome and never emits a heading tag at any level.
//
// FAH999: ไทล์วางบนพื้นการ์ด #12100b หลังเส้นขอบทองหลัก #e8c25a ที่สว่างขึ้นเป็น
// ทองประกาย #f7e7a8 ตอน hover ป้าย HOT ไล่จากบรอนซ์ #a3732c ไปหาทองหลัก
// และตัวอักษรบนป้ายเป็นสีบนทอง #140f06
const providers = [
  { alt: "PG Soft", users: "4,592", isHot: true, img: img1 },
  { alt: "Joker Gaming", users: "3,845", isHot: true, img: img2 },
  { alt: "JILI", users: "2,901", isHot: true, img: img3 },
  { alt: "Evolution", users: "2,184", isHot: true, img: img4 },
  { alt: "SA Gaming", users: "1,754", isHot: false, img: img5 },
  { alt: "Sexy Baccarat", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมสล็อตที่ FAH999 เปิดให้สมาชิกเลือกเล่นแบบไม่ล็อคยูส" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(232,194,90,0.6)]">🎰</span>
    <p class="bg-gradient-to-r from-[#f7e7a8] via-[#c49a41] to-[#e8c25a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      เกมสล็อตจากหลายค่าย เลือกได้จากหน้าเดียวของ FAH999
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8c25a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#12100b] shadow-[0_5px_15px_rgba(0,0,0,0.65)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(232,194,90,0.32)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#e8c25a]/45 transition-all duration-500 group-hover:border-[#f7e7a8]/65 group-hover:shadow-[inset_0_0_20px_rgba(232,194,90,0.18)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#a3732c]/55 bg-[#0a0907]/80 px-3 py-1.5 text-[10px] font-medium text-[#e7dcc4]/80 backdrop-blur-md transition-colors group-hover:text-[#f7e7a8]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#f7e7a8]/60 bg-gradient-to-r from-[#a3732c] to-[#e8c25a] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#140f06] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={p.alt}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#a3732c]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
