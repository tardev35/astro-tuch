---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// `alt` is each tile's real logo, so the names stay as the artwork prints them —
// they are not copy to be swapped for the brief's provider list. The block title
// is a <p> and the <section> carries an aria-label: a provider grid is chrome
// and never emits a heading tag.
const providers = [
  { alt: "PG Soft", users: "4,592", isHot: true, img: img1 },
  { alt: "Joker Gaming", users: "2,184", isHot: true, img: img2 },
  { alt: "JILI", users: "3,845", isHot: true, img: img3 },
  { alt: "Evolution", users: "2,901", isHot: true, img: img4 },
  { alt: "SA Gaming", users: "1,754", isHot: false, img: img5 },
  { alt: "Sexy Baccarat", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมสล็อตพันธมิตร HIX168" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(30,123,245,0.6)]">🎰</span>
    <p class="bg-gradient-to-r from-[#cfd8e6] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ค่ายเกมสล็อตพันธมิตร HIX168</p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#1e7bf5] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#060c1c] shadow-[0_5px_15px_rgba(1,3,10,0.55)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(30,123,245,0.32)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#1e7bf5]/40 transition-all duration-500 group-hover:border-[#6fb4ff]/60 group-hover:shadow-[inset_0_0_20px_rgba(30,123,245,0.18)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#1e7bf5]/40 bg-[#01030a]/80 px-3 py-1.5 text-[10px] font-medium text-[#d6e2f5]/80 backdrop-blur-md transition-colors group-hover:text-[#6fb4ff]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#1e7bf5]/55 bg-gradient-to-r from-[#0a3fa8] to-[#1e7bf5] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#cfd8e6] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={p.alt}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#1e7bf5]/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
