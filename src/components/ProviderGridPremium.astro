---
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// `alt` names the provider whose wordmark the tile shows — these are real
// third-party logos, so the names are not copy to be swapped for the brief's
// wording, and the artwork itself is never tinted or filtered by a palette
// sweep. The same six files carry the same six names in PopularGamesStrip.
//
// The block title is a <p> and the <section> carries an aria-label: a provider
// grid is chrome and never emits a heading tag at any level. Each tile's own
// name badge is a card label, so it is a <p> too. **ห้ามเลื่อน <p> นั้นขึ้นเป็น
// h2 เพื่อ "แก้ชื่อที่ขาด"** — จะทำให้การนับหัวข้อเทียบบรีฟของทุกรอบถัดไปพัง
//
// 🚨 **บรีฟรอบนี้ (WIN8S) ระบุ "สามหมวดเกม" เท่านั้น: บาคาร่าออนไลน์ · คาสิโนสด ·
// สล็อต** (content.txt บรรทัด 4, 13, 25) ป้ายมุมขวาบนของไทล์จึงพูดได้แค่สามคำนี้
// ❌ **ไฮโล / รูเล็ต / ยิงปลา / เดิมพันฟุตบอล / หวย ไม่มีในบรีฟรอบนี้เลยสักคำ**
// (ทั้งห้าเป็นของ 123BET รอบก่อนทันที — ห้ามสืบทอดลิสต์หมวดข้ามรอบเด็ดขาด)
// และไม่มีไทล์ไหนระบุจำนวนค่าย จำนวนเกม หรืออัตราจ่าย — ตัวเลขที่บรีฟอนุญาตมีแค่
// 0.3% · 0.8% · 100% · 3 ขั้นตอน · 24ชม.
// อีโมจิ 🎴 เป็นไพ่ญี่ปุ่น ซึ่งอยู่ในภาษาภาพของดรอปนี้ (ฉากห้องญี่ปุ่น ซากุระ
// กิโมโน) และอยู่ใน <span aria-hidden="true"> ของตัวเอง ไม่ใช่กลิฟในข้อความป้าย
// ❌ ⚔️ (ดาบคาทานะ) เป็นของ ZORO365 — ห้ามกลับมา
//
// ธีมรอบนี้ (.claude/brand-spec-win8s.md §2): การ์ดไทล์เป็นผิวการ์ด 2a0a04 บน
// พื้นเพจดำอมเลือดหมู 1e0101 ขอบตกแต่ง 8a3a12 สว่างขึ้นเป็นส้มเพลิง f27a1a ตอน
// hover · ชื่อค่ายเป็นเงินโครเมียม c9d2dc บนแผ่นจม 140302 · ป้ายหมวดเป็นทองอำพัน
// e5a92b บนไล่ชั้นยก 3b130b -> 5a2410 · หัวแถบไล่ clip-text c9d2dc -> e5a92b ->
// f27a1a ซึ่งทุกสต็อปถือตัวอักษรได้บนพื้นเพจ (13.0 / 9.5 / 7.1:1)
// 🚨 **5a2410 กับ 8a3a12 ห้ามถือตัวอักษร** — เส้น/ขอบ/พื้นถมเท่านั้น
// ชุดเขียวมรกต/ทองของ ZORO365 ที่เพิ่งอยู่ทั้งไฟล์นี้ (3ddc4a 35a043 1e7033 0e5424
// 073c1a 010d04 dfe6e3 e8c86a eef7f0) กวาดออกครบแล้ว **ลิสต์เต็มของทุกแบรนด์อยู่
// ที่ brand-spec §2** (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์)
const providers = [
  { name: "PG Soft", category: "สล็อต", img: img1 },
  { name: "Joker Gaming", category: "สล็อต", img: img2 },
  { name: "JILI", category: "สล็อต", img: img3 },
  { name: "Evolution", category: "คาสิโนสด", img: img4 },
  { name: "SA Gaming", category: "บาคาร่า", img: img5 },
  { name: "Sexy Baccarat", category: "บาคาร่า", img: img6 },
];
---

<section
  aria-label={`ค่ายเกมบาคาร่า คาสิโนสด และสล็อตที่ ${BRAND_NAME} รวบรวมข้อมูลไว้`}
  class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8"
>
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(242,122,26,0.6)]">🎴</span>
    <p class="bg-gradient-to-r from-[#c9d2dc] via-[#e5a92b] to-[#f27a1a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      รวมเกมบาคาร่าออนไลน์ คาสิโนสด และสล็อต จากค่ายเกมของ {BRAND_NAME}
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#8a3a12] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#2a0a04] shadow-[0_5px_15px_rgba(20,3,2,0.65)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(242,122,26,0.32)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#8a3a12]/45 transition-all duration-500 group-hover:border-[#f27a1a]/65 group-hover:shadow-[inset_0_0_20px_rgba(242,122,26,0.18)]" />

          <p class="absolute top-0 left-0 z-10 max-w-[80%] truncate rounded-br-xl border-r border-b border-[#5a2410]/70 bg-[#140302]/80 px-3 py-1.5 text-[10px] font-medium text-[#c9d2dc] backdrop-blur-md transition-colors group-hover:text-[#fdf0e6]">
            {p.name}
          </p>

          <p class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#e5a92b]/60 bg-gradient-to-r from-[#3b130b] to-[#5a2410] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#e5a92b] shadow-md">
            {p.category}
          </p>

          <Picture
            src={p.img}
            alt={`โลโก้ค่ายเกม ${p.name}`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#8a3a12]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
