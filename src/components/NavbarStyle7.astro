---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🌐" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
];
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full border-b border-[#b38f00]/40 bg-[#0c0900]/95 shadow-[0_5px_25px_rgba(252,237,11,0.25)] backdrop-blur-xl">
    <div class="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-4 lg:h-[80px] xl:px-8">
      <div class="flex items-center gap-4">
        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2 lg:hidden" aria-label="Menu">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#fced0b] shadow-[0_0_5px_rgba(252,237,11,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-[#fced0b] shadow-[0_0_5px_rgba(252,237,11,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#fced0b] shadow-[0_0_5px_rgba(252,237,11,0.5)] transition-all duration-300"></span>
        </button>

        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="JOJO789"
                loading="eager"
                fetchpriority="high"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(252,237,11,0.4)] lg:h-[50px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fff6b0] to-[#b38f00] bg-clip-text text-2xl font-black text-transparent drop-shadow-[0_0_8px_rgba(252,237,11,0.5)] lg:text-3xl">JOJO789</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-8 lg:flex xl:gap-12">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
              <span class={`flex items-center gap-1.5 transition-colors duration-300 ${isActive(link.path) ? "text-[#fced0b] drop-shadow-[0_0_8px_rgba(252,237,11,0.5)]" : "text-[#cfc199]/70 group-hover:text-[#fff6b0]"}`}>
                <span aria-hidden="true">{link.icon}</span>
                {link.name}
              </span>
              <div
                aria-hidden="true"
                class={`absolute bottom-5 h-1.5 w-1.5 rounded-full bg-[#fced0b] transition-all duration-300 ${isActive(link.path) ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(252,237,11,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#b38f00]/40 bg-[#171200]/60 px-6 py-2.5 text-sm font-bold text-[#fff6b0] transition-all hover:bg-[#201800]/70 hover:text-[#fced0b] md:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #6b5300, #fced0b, #6b5300);"
          class="flex items-center justify-center rounded-full px-5 py-2 text-xs font-extrabold text-[#201800] shadow-[0_0_20px_rgba(252,237,11,0.3)] transition-all hover:shadow-[0_0_25px_rgba(252,237,11,0.5)] hover:brightness-110 lg:px-7 lg:py-2.5 lg:text-sm">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-400 lg:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[60] w-full translate-y-full transform rounded-t-3xl border-t border-[#b38f00]/40 bg-[#0c0900] shadow-[0_-10px_40px_rgba(0,0,0,0.8)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex w-full cursor-pointer justify-center pt-3 pb-2" id="close-sheet-btn">
      <div class="h-1.5 w-12 rounded-full bg-[#201800]/70"></div>
    </div>

    <div class="flex flex-col space-y-2 px-6 pt-2 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive(link.path) ? "bg-gradient-to-r from-[#fced0b]/20 to-transparent border border-[#b38f00]/30 text-[#fced0b]" : "bg-white/5 border-transparent text-gray-400"}`}>
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="text-2xl drop-shadow-lg">{link.icon}</span>
              <span class="text-base font-bold tracking-wide">{link.name}</span>
            </div>
            {isActive(link.path) && <span class="h-2 w-2 rounded-full bg-[#fced0b] shadow-[0_0_8px_rgba(252,237,11,1)]" />}
          </a>
        ))
      }

      <div class="mt-2 grid grid-cols-2 gap-3 border-t border-white/5 pt-4">
        <a href="/login" class="flex items-center justify-center rounded-xl border border-[#b38f00]/30 bg-[#fced0b]/5 py-3.5 text-sm font-bold text-[#fced0b]">เข้าสู่ระบบ</a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #6b5300, #fced0b, #6b5300);"
          class="flex items-center justify-center rounded-xl py-3.5 text-sm font-extrabold text-[#201800] shadow-[0_0_15px_rgba(252,237,11,0.4)]">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  a {
    font-family: var(--font-sans) !important;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileBottomSheet = document.getElementById("mobile-bottom-sheet");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const closeSheetBtn = document.getElementById("close-sheet-btn");
  const hamburgerLines = document.querySelectorAll(".hamburger-line");

  function toggleMenu() {
    const isOpen = mobileBottomSheet?.classList.contains("translate-y-0");

    if (!isOpen) {
      mobileBottomSheet?.classList.remove("translate-y-full");
      mobileBottomSheet?.classList.add("translate-y-0");
      mobileOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.add("opacity-100");

      hamburgerLines[0].classList.add("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.add("opacity-0");
      hamburgerLines[2].classList.add("-rotate-45", "-translate-y-[8px]");
    } else {
      mobileBottomSheet?.classList.add("translate-y-full");
      mobileBottomSheet?.classList.remove("translate-y-0");
      mobileOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.remove("opacity-100");

      hamburgerLines[0].classList.remove("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.remove("opacity-0");
      hamburgerLines[2].classList.remove("-rotate-45", "-translate-y-[8px]");
    }
  }

  hamburgerBtn?.addEventListener("click", toggleMenu);
  mobileOverlay?.addEventListener("click", toggleMenu);
  closeSheetBtn?.addEventListener("click", toggleMenu);

  const sheetItems = document.querySelectorAll(".sheet-item");
  sheetItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (mobileBottomSheet?.classList.contains("translate-y-0")) {
        toggleMenu();
      }
    });
  });
</script>
