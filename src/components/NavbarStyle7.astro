---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ต่อจากโปรโมชั่นทันที เพราะเป็นสองรายการเดียวใน
// เมนูที่เป็น "การกระทำ" ไม่ใช่หน้าให้อ่าน คนกวาดสายตาจากซ้ายจึงต้องเจอก่อน
// หน้าข้อมูล — ไม่ใช่ท้ายลิสต์ตามที่ uploader append มาให้
//
// /ทางเข้า ไม่มีในเมนูโดยตั้งใจ: หน้านั้นมีไว้เสนอเข้าสู่ระบบกับสมัครสมาชิก
// อยู่แล้ว พอสองอันนั้นขึ้นเป็นเมนูเอง มันก็กลายเป็นลิงก์ที่สามไปที่เดิม
// (หน้ายังถูก route และ index ตามปกติ)
//
// ไม่มี /ตรวจหวย และ /แนวทาง: สมหวัง168 เป็น **เว็บเกมสล็อต** บรีฟไม่พูดถึงหวย
// เลยสักคำ สองหน้านั้นจอดอยู่ที่ src/pages-disabled/ จึงไม่ถูก route ถ้าปล่อย
// ลิงก์ไว้ verify-build จะจับว่าเป็น href ไปยัง route ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงแนวสล็อตตามบรีฟ (วงล้อสล็อต = ทดลองเล่น, กล่องของขวัญ =
// โปรโมชั่น, กรอบแชต = ติดต่อเรา ซึ่งบรีฟเน้นช่องทางติดต่อเป็นหัวข้อหลัก)
// ตัวละหนึ่งอัน และอยู่ใน <span aria-hidden> ที่เป็น "พี่น้อง" ของตัวหนังสือเสมอ
// ไม่ใช่อยู่ข้างใน — รอบก่อน (TSDET911) ใช้ไพ่/ลูกเต๋า/ลูกบอลเพราะเป็นคาสิโน+กีฬา
// รอบนี้ไม่มีสองหมวดนั้น
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่ง เป็นคำว่า สมหวัง เขียนด้วยตัวอักษรสามมิติสีขาวอมเงินไล่เฉดฟ้าอ่อนและมีขอบสีแดงสด ต่อด้วยตัวเลข 168 สีแดงสดตัวหนาสามมิติที่มีขอบขาว ด้านบนของตัวอักษรเป็นลายกนกไทยสีแดงม้วนเป็นเกลียวคล้ายยอดเจดีย์ และด้านขวาบนเป็นเปลวไฟสีแดง มีเส้นโค้งสีแดงพาดใต้คำทั้งหมด`;

// พาเลตต์ สมหวัง168 (แดงมังกร + ทองไทย บนดำอมแดง 2026-10-17):
// งานศิลป์รอบนี้เป็นสองโทนจริงๆ — คำว่า "สมหวัง" กับเลข "168" เดินแดงสด
// (#fa0513) ส่วนลายกนก/นาคทองไทยที่ขนาบแบนเนอร์ทั้งสองข้าง กองชิปทอง และเจดีย์
// ในสไลด์เดินทอง (#e3b23c) navbar จึงเดินสองโทนนั้นคู่กัน: **แดงถือปุ่มสมัครกับ
// จุดไฟใต้เมนู ส่วนทองถือสถานะ active, กรอบปุ่มเข้าสู่ระบบ และเส้นคั่น**
// เมนูที่ยังไม่ถูกเลือกใช้ขาวนวลอมอุ่นหม่น #ccb9b6 (≈ 10.5:1 บนพื้น #140706)
// พื้นเป็นดำอมแดง #140706 (จม) / #1f0d0c (กลาง) / #2c1413 (ยก) ตาม bg.json
// ของดรอปนี้ที่เป็น #290f0f
//
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 ที่เคยอยู่ในไฟล์นี้ (#0360f3 #0292fb
// #6ec8ff #cfdcec #9db4d4 #00081f #040e26 #0a1c42 #102a5e #032dad #04186e
// #021026 และ rgba(3,96,243,α)/rgba(2,146,251,α)/rgba(207,220,236,α)) ออกครบ
// ทุกจุดแล้ว และชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #f58b2a #ffc98a #d8c69b #8a5f08 #5c3f04 #1a1203 #0d0903 #1f1709) กับชุด
// ม่วง-ทองของ KMD88 (#7505cc #e2b33f #ffd45e #1a0526) ไม่เหลือในไฟล์นี้เช่นกัน
//
// ⚠️ กับดักรอบนี้: **สองแบรนด์ก่อนหน้าก็เป็นแดง** (GT66B #fb141b, TKB55 #fb131b)
// และ KMD88 ก็มีทอง (#e2b33f) ต่างจากทองรอบนี้ (#e3b23c) แค่หลักเดียว
// "เจอแดง" หรือ "เจอทอง" จึงไม่พิสูจน์อะไรเลย ต้อง grep เทียบเป็นค่าทีละตัวกับ
// ตารางใน .claude/brand-spec-somwang168.md §2
// ⚠️ รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีม่วง ไม่มีชมพู ไม่มีเขียว และไม่มีส้มเลย
//
// หมึกบนปุ่มสมัคร: #170504 บนแดงแบรนด์ #fa0513 = 4.8:1 และบนแดงสว่าง #ff5a5f
// = 6.5:1 ผ่าน AA ทั้งคู่ — ปลายเกรเดียนต์ตั้งไว้ที่ #fa0513 ห้ามลากลงไปถึง
// #b90203 หรือ #8c0204 (หมึกเข้มจะตกต่ำกว่า 3:1 ทันที) ถ้าจะทำปลายให้เข้มกว่านี้
// ต้องสลับหมึกเป็นทองสว่างแทน
// หมึกทองสว่าง #ffe5a8 บนปุ่มเข้าสู่ระบบพื้น #1f0d0c = 15.1:1
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full border-b border-[#8c0204]/70 bg-[#140706]/95 shadow-[0_5px_25px_rgba(250,5,19,0.22)] backdrop-blur-xl">
    <div class="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-4 lg:h-[80px] xl:px-8">
      <div class="flex items-center gap-4">
        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2 lg:hidden" aria-label="Menu">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#fa0513] shadow-[0_0_5px_rgba(250,5,19,0.55)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-[#e3b23c] shadow-[0_0_5px_rgba(227,178,60,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#fa0513] shadow-[0_0_5px_rgba(250,5,19,0.55)] transition-all duration-300"></span>
        </button>

        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(250,5,19,0.45)] lg:h-[50px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#ffe5a8] via-[#e3b23c] to-[#ff5a5f] bg-clip-text text-2xl font-black text-transparent drop-shadow-[0_0_8px_rgba(250,5,19,0.5)] lg:text-3xl">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-6 lg:flex xl:gap-9">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
              <span class={`flex items-center gap-1.5 transition-colors duration-300 ${isActive(link.path) ? "text-[#ffe5a8] drop-shadow-[0_0_8px_rgba(227,178,60,0.55)]" : "text-[#ccb9b6] group-hover:text-[#ffe5a8]"}`}>
                <span aria-hidden="true">{link.icon}</span>
                {link.name}
              </span>
              <div
                aria-hidden="true"
                class={`absolute bottom-5 h-1.5 w-1.5 rounded-full transition-all duration-300 ${isActive(link.path) ? "bg-[#fa0513] opacity-100 scale-100 shadow-[0_0_10px_rgba(250,5,19,1)]" : "bg-[#b90203] opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#e3b23c]/55 bg-[#1f0d0c]/80 px-6 py-2.5 text-sm font-bold text-[#ffe5a8] transition-all hover:border-[#ffe5a8]/85 hover:bg-[#2c1413]/90 md:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #fa0513, #ff5a5f, #fa0513);"
          class="flex items-center justify-center rounded-full px-5 py-2 text-xs font-extrabold text-[#170504] shadow-[0_0_20px_rgba(250,5,19,0.35)] transition-all hover:shadow-[0_0_25px_rgba(250,5,19,0.55)] hover:brightness-110 lg:px-7 lg:py-2.5 lg:text-sm">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-400 lg:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[60] w-full translate-y-full transform rounded-t-3xl border-t border-[#8c0204]/70 bg-[#1f0d0c] shadow-[0_-10px_40px_rgba(0,0,0,0.85)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex w-full cursor-pointer justify-center pt-3 pb-2" id="close-sheet-btn">
      <div class="h-1.5 w-12 rounded-full bg-[#5b0203]"></div>
    </div>

    <div class="flex flex-col space-y-2 px-6 pt-2 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive(link.path) ? "bg-gradient-to-r from-[#8c0204]/35 to-transparent border border-[#e3b23c]/55 text-[#ffe5a8]" : "bg-white/5 border-transparent text-[#ccb9b6]"}`}>
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="text-2xl drop-shadow-lg">{link.icon}</span>
              <span class="text-base font-bold tracking-wide">{link.name}</span>
            </div>
            {isActive(link.path) && <span class="h-2 w-2 rounded-full bg-[#fa0513] shadow-[0_0_8px_rgba(250,5,19,1)]" />}
          </a>
        ))
      }

      <div class="mt-2 grid grid-cols-2 gap-3 border-t border-white/5 pt-4">
        <a href="/login" class="flex items-center justify-center rounded-xl border border-[#e3b23c]/50 bg-[#2c1413]/80 py-3.5 text-sm font-bold text-[#ffe5a8]">เข้าสู่ระบบ</a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #fa0513, #ff5a5f, #fa0513);"
          class="flex items-center justify-center rounded-xl py-3.5 text-sm font-extrabold text-[#170504] shadow-[0_0_15px_rgba(250,5,19,0.45)]">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileBottomSheet = document.getElementById("mobile-bottom-sheet");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const closeSheetBtn = document.getElementById("close-sheet-btn");
  const hamburgerLines = document.querySelectorAll(".hamburger-line");

  function toggleMenu() {
    const isOpen = mobileBottomSheet?.classList.contains("translate-y-0");

    if (!isOpen) {
      mobileBottomSheet?.classList.remove("translate-y-full");
      mobileBottomSheet?.classList.add("translate-y-0");
      mobileOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.add("opacity-100");

      hamburgerLines[0].classList.add("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.add("opacity-0");
      hamburgerLines[2].classList.add("-rotate-45", "-translate-y-[8px]");
    } else {
      mobileBottomSheet?.classList.add("translate-y-full");
      mobileBottomSheet?.classList.remove("translate-y-0");
      mobileOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.remove("opacity-100");

      hamburgerLines[0].classList.remove("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.remove("opacity-0");
      hamburgerLines[2].classList.remove("-rotate-45", "-translate-y-[8px]");
    }
  }

  hamburgerBtn?.addEventListener("click", toggleMenu);
  mobileOverlay?.addEventListener("click", toggleMenu);
  closeSheetBtn?.addEventListener("click", toggleMenu);

  const sheetItems = document.querySelectorAll(".sheet-item");
  sheetItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (mobileBottomSheet?.classList.contains("translate-y-0")) {
        toggleMenu();
      }
    });
  });
</script>
