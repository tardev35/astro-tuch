---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ต่อจากโปรโมชั่นทันที เพราะเป็นสองรายการเดียวใน
// เมนูที่เป็น "การกระทำ" ไม่ใช่หน้าให้อ่าน คนกวาดสายตาจากซ้ายจึงต้องเจอก่อน
// หน้าข้อมูล — ไม่ใช่ท้ายลิสต์ตามที่ uploader append มาให้
//
// /ทางเข้า ไม่มีในเมนูโดยตั้งใจ: หน้านั้นมีไว้เสนอเข้าสู่ระบบกับสมัครสมาชิก
// อยู่แล้ว พอสองอันนั้นขึ้นเป็นเมนูเอง มันก็กลายเป็นลิงก์ที่สามไปที่เดิม
// (หน้ายังถูก route และ index ตามปกติ)
//
// ไม่มี /ตรวจหวย และ /แนวทาง: TSDET911 เป็นเว็บคาสิโน+กีฬา (บาคาร่า ไฮโล สล็อต
// แทงบอล) บรีฟไม่พูดถึงหวยเลยสักคำ สองหน้านั้นจอดอยู่ที่ src/pages-disabled/
// จึงไม่ถูก route ถ้าปล่อยลิงก์ไว้ verify-build จะจับว่าเป็น href ไปยัง route
// ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงแนวคาสิโน+กีฬาตามบรีฟ (ไพ่ = บาคาร่า, ลูกเต๋า = ไฮโล,
// วงล้อ = สล็อต, ลูกบอล = แทงบอล) ตัวละหนึ่งอัน และอยู่ใน <span aria-hidden>
// ที่เป็น "พี่น้อง" ของตัวหนังสือเสมอ ไม่ใช่อยู่ข้างใน
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎲" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเครื่องหมายปีกเหยี่ยวสีน้ำเงินไฟฟ้าซ้อนกับแถบโลหะสีเงินโครเมียมอยู่ทางซ้าย ต่อด้วยตัวอักษร TSDET สีเงินโครเมียมขัดเงาแบบสามมิติ และตัวเลข 911 สีน้ำเงินไฟฟ้าไล่เฉดเข้มขึ้นทางขอบล่าง ทั้งหมดเรียงติดกันเป็นบรรทัดเดียวบนพื้นโปร่ง`;

// พาเลตต์ TSDET911 (น้ำเงินไฟฟ้า + เงินโครเมียม บนกรมเกือบดำ 2026-10-13):
// โลโก้แบรนด์นี้เป็นสองโทนจริงๆ — TSDET เป็นเงินโครเมียม (#cfdcec #9db4d4) ส่วน
// 911 กับปีกเหยี่ยวเป็นน้ำเงินไฟฟ้า (#0292fb #0360f3 #032dad) navbar จึงเดิน
// สองโทนนั้นคู่กัน: ฟ้าถือสถานะ active / ปุ่มสมัคร / จุดไฟใต้เมนู ส่วนเงินถือ
// ตัวอักษรเมนูที่ยังไม่ถูกเลือกและโลโก้ fallback พื้นเป็นกรมเกือบดำ #00081f /
// #040e26 ตาม bg.json ของดรอปนี้
//
// ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 ที่เคยอยู่ในไฟล์นี้ (#f3bb34 #fde464
// #c8901a #f58b2a #ffc98a #d8c69b #8a5f08 #5c3f04 #1a1203 #0d0903 #1f1709 และ
// rgba(243,187,52,α)/rgba(245,139,42,α)) ออกครบทุกจุดแล้ว และชุดม่วง-ทองของ
// KMD88 (#7505cc #e2b33f #ffd45e #1a0526) ไม่เคยเข้ามาในไฟล์นี้ตั้งแต่แรก
//
// เมนูที่ยังไม่ถูกเลือกใช้เงินหม่น #9db4d4 (≈ 8.0:1 บนพื้น #00081f) ไม่ใช่ครีม
// แบบรอบก่อน — รอบนี้ไม่มีฮิวอุ่นเลยสักจุด
// หมึกบนปุ่มสมัคร: #021026 บนปลายเกรเดียนต์ฟ้าสด #0292fb = 6.0:1 และบนฟ้าสว่าง
// #6ec8ff = 9.8:1 ผ่าน AA ทั้งคู่ — ปลายเกรเดียนต์ตั้งไว้ที่ #0292fb ไม่ใช่
// น้ำเงินแบรนด์ #0360f3 (ซึ่งหมึกเข้มตกไปที่ 3.4:1) ถ้าจะทำปลายให้เข้มกว่านี้
// ต้องสลับหมึกเป็นขาวอมฟ้าแทน
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full border-b border-[#032dad]/70 bg-[#00081f]/95 shadow-[0_5px_25px_rgba(3,96,243,0.22)] backdrop-blur-xl">
    <div class="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-4 lg:h-[80px] xl:px-8">
      <div class="flex items-center gap-4">
        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2 lg:hidden" aria-label="Menu">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#0292fb] shadow-[0_0_5px_rgba(2,146,251,0.55)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-[#cfdcec] shadow-[0_0_5px_rgba(207,220,236,0.45)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#0292fb] shadow-[0_0_5px_rgba(2,146,251,0.55)] transition-all duration-300"></span>
        </button>

        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(2,146,251,0.45)] lg:h-[50px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#cfdcec] via-[#6ec8ff] to-[#0360f3] bg-clip-text text-2xl font-black text-transparent drop-shadow-[0_0_8px_rgba(2,146,251,0.5)] lg:text-3xl">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-6 lg:flex xl:gap-9">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
              <span class={`flex items-center gap-1.5 transition-colors duration-300 ${isActive(link.path) ? "text-[#6ec8ff] drop-shadow-[0_0_8px_rgba(2,146,251,0.55)]" : "text-[#9db4d4] group-hover:text-[#6ec8ff]"}`}>
                <span aria-hidden="true">{link.icon}</span>
                {link.name}
              </span>
              <div
                aria-hidden="true"
                class={`absolute bottom-5 h-1.5 w-1.5 rounded-full transition-all duration-300 ${isActive(link.path) ? "bg-[#0292fb] opacity-100 scale-100 shadow-[0_0_10px_rgba(2,146,251,1)]" : "bg-[#0360f3] opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#0360f3]/55 bg-[#040e26]/80 px-6 py-2.5 text-sm font-bold text-[#9db4d4] transition-all hover:border-[#0292fb]/85 hover:bg-[#0a1c42]/90 hover:text-[#6ec8ff] md:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #0292fb, #6ec8ff, #0292fb);"
          class="flex items-center justify-center rounded-full px-5 py-2 text-xs font-extrabold text-[#021026] shadow-[0_0_20px_rgba(2,146,251,0.35)] transition-all hover:shadow-[0_0_25px_rgba(2,146,251,0.55)] hover:brightness-110 lg:px-7 lg:py-2.5 lg:text-sm">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-400 lg:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[60] w-full translate-y-full transform rounded-t-3xl border-t border-[#032dad]/70 bg-[#040e26] shadow-[0_-10px_40px_rgba(0,0,0,0.85)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex w-full cursor-pointer justify-center pt-3 pb-2" id="close-sheet-btn">
      <div class="h-1.5 w-12 rounded-full bg-[#04186e]"></div>
    </div>

    <div class="flex flex-col space-y-2 px-6 pt-2 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive(link.path) ? "bg-gradient-to-r from-[#0360f3]/25 to-transparent border border-[#032dad]/60 text-[#6ec8ff]" : "bg-white/5 border-transparent text-[#9db4d4]"}`}>
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="text-2xl drop-shadow-lg">{link.icon}</span>
              <span class="text-base font-bold tracking-wide">{link.name}</span>
            </div>
            {isActive(link.path) && <span class="h-2 w-2 rounded-full bg-[#0292fb] shadow-[0_0_8px_rgba(2,146,251,1)]" />}
          </a>
        ))
      }

      <div class="mt-2 grid grid-cols-2 gap-3 border-t border-white/5 pt-4">
        <a href="/login" class="flex items-center justify-center rounded-xl border border-[#0360f3]/50 bg-[#0360f3]/12 py-3.5 text-sm font-bold text-[#6ec8ff]">เข้าสู่ระบบ</a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #0292fb, #6ec8ff, #0292fb);"
          class="flex items-center justify-center rounded-xl py-3.5 text-sm font-extrabold text-[#021026] shadow-[0_0_15px_rgba(2,146,251,0.45)]">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileBottomSheet = document.getElementById("mobile-bottom-sheet");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const closeSheetBtn = document.getElementById("close-sheet-btn");
  const hamburgerLines = document.querySelectorAll(".hamburger-line");

  function toggleMenu() {
    const isOpen = mobileBottomSheet?.classList.contains("translate-y-0");

    if (!isOpen) {
      mobileBottomSheet?.classList.remove("translate-y-full");
      mobileBottomSheet?.classList.add("translate-y-0");
      mobileOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.add("opacity-100");

      hamburgerLines[0].classList.add("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.add("opacity-0");
      hamburgerLines[2].classList.add("-rotate-45", "-translate-y-[8px]");
    } else {
      mobileBottomSheet?.classList.add("translate-y-full");
      mobileBottomSheet?.classList.remove("translate-y-0");
      mobileOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.remove("opacity-100");

      hamburgerLines[0].classList.remove("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.remove("opacity-0");
      hamburgerLines[2].classList.remove("-rotate-45", "-translate-y-[8px]");
    }
  }

  hamburgerBtn?.addEventListener("click", toggleMenu);
  mobileOverlay?.addEventListener("click", toggleMenu);
  closeSheetBtn?.addEventListener("click", toggleMenu);

  const sheetItems = document.querySelectorAll(".sheet-item");
  sheetItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (mobileBottomSheet?.classList.contains("translate-y-0")) {
        toggleMenu();
      }
    });
  });
</script>
