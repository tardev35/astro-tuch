---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// สมัครสมาชิก/เข้าสู่ระบบ อยู่ต่อจากโปรโมชั่นทันที เพราะเป็นสองรายการเดียวใน
// เมนูที่เป็น "การกระทำ" ไม่ใช่หน้าให้อ่าน คนกวาดสายตาจากซ้ายจึงต้องเจอก่อน
// หน้าข้อมูล — ไม่ใช่ท้ายลิสต์ตามที่ uploader append มาให้
//
// /ทางเข้า ไม่มีในเมนูโดยตั้งใจ: หน้านั้นมีไว้เสนอเข้าสู่ระบบกับสมัครสมาชิก
// อยู่แล้ว พอสองอันนั้นขึ้นเป็นเมนูเอง มันก็กลายเป็นลิงก์ที่สามไปที่เดิม
// (หน้ายังถูก route และ index ตามปกติ)
//
// ไม่มี /ตรวจหวย และ /แนวทาง: DUCK1688 เป็นเว็บสล็อตพีจี บรีฟไม่พูดถึงหวยเลย
// สักคำ สองหน้านั้นจอดอยู่ที่ src/pages-disabled/ จึงไม่ถูก route ถ้าปล่อยลิงก์ไว้
// verify-build จะจับว่าเป็น href ไปยัง route ที่ไม่มีจริง
//
// ไอคอนเลือกให้ตรงแนวสล็อตล้วนตามบรีฟ ตัวละหนึ่งอัน และอยู่ใน <span aria-hidden>
// ที่เป็น "พี่น้อง" ของตัวหนังสือเสมอ ไม่ใช่อยู่ข้างใน
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt =
  "โลโก้ DUCK1688 เป็นเป็ดการ์ตูนสีเหลืองสวมมงกุฎทอง ขยิบตาหนึ่งข้างและยิ้มกว้าง ปากสีส้มอำพัน โผล่อยู่เหนือแผ่นป้ายสีดำขอบทองหนา บนแผ่นป้ายเขียนคำว่า DUCK เป็นตัวอักษรสามมิติสีทองและเลข 1688 สีขาวโครเมียมขอบทอง เรียงติดกันเป็นบรรทัดเดียว";

// พาเลตต์ DUCK1688 (ทองเป็ด + ส้มปากเป็ด บนดำสนิท 2026-10-10): โลโก้แบรนด์นี้
// เป็นทองเป็นหลักจริงๆ — ตัว DUCK มงกุฎ ขอบป้าย และตัวเป็ดเป็นทอง (#f3bb34
// #fde464 #c8901a) ส่วน "ฮิวที่สอง" คือส้มอำพันของปากเป็ด (#f58b2a #ffc98a)
// navbar จึงเดินสองโทนนั้นคู่กัน: ทองถือสถานะ active / ปุ่มสมัคร / เส้นขอบ ส่วน
// ส้มถือจุดเรืองใต้เมนูที่ hover และขีดกลางของแฮมเบอร์เกอร์ แทนที่จะไล่เฉดทอง
// อย่างเดียว พื้นเป็นดำสนิท #000000 / #0d0903 ตาม bg.json ของดรอปนี้
//
// ชุดทอง-เงินของ UP555 ที่เคยอยู่ในไฟล์นี้ (#ebbb54 #fce675 #ab6d24 #d5d4d3
// #f3f3f2 #0c0502 #130b03 #241705 #160d02 #c08a30) ออกครบทุกจุดแล้ว และชุด
// ทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cfd6e3 #3f4859) ไม่เคย
// เข้ามาในไฟล์นี้ตั้งแต่แรก
//
// เมนูที่ยังไม่ถูกเลือกใช้ครีมหม่น #d8c69b (≈ 10.8:1 บนพื้น #000000) ไม่ใช่เงิน
// โครเมียมแบบรอบก่อน — รอบนี้ไม่มีฮิวเย็นเลย
// หมึกบนปุ่มสมัคร: #1a1203 บนปลายเกรเดียนต์ทองเข้ม #c8901a = 6.4:1 และบนทองหลัก
// #f3bb34 = 10.4:1 ผ่าน AA ทั้งคู่ — ปลายเกรเดียนต์ตั้งไว้ที่ #c8901a ไม่ใช่ทองลึก
// #8a5f08 (ซึ่งตกต่ำกว่า 4.5:1) ถ้าจะทำปลายให้เข้มกว่านี้ต้องสลับหมึกเป็นทองอ่อน
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full border-b border-[#8a5f08]/70 bg-[#000000]/95 shadow-[0_5px_25px_rgba(243,187,52,0.18)] backdrop-blur-xl">
    <div class="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-4 lg:h-[80px] xl:px-8">
      <div class="flex items-center gap-4">
        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2 lg:hidden" aria-label="Menu">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#f3bb34] shadow-[0_0_5px_rgba(243,187,52,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-[#f58b2a] shadow-[0_0_5px_rgba(245,139,42,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#f3bb34] shadow-[0_0_5px_rgba(243,187,52,0.5)] transition-all duration-300"></span>
        </button>

        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(243,187,52,0.45)] lg:h-[50px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fde464] via-[#f3bb34] to-[#c8901a] bg-clip-text text-2xl font-black text-transparent drop-shadow-[0_0_8px_rgba(243,187,52,0.5)] lg:text-3xl">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-6 lg:flex xl:gap-9">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
              <span class={`flex items-center gap-1.5 transition-colors duration-300 ${isActive(link.path) ? "text-[#fde464] drop-shadow-[0_0_8px_rgba(243,187,52,0.5)]" : "text-[#d8c69b]/75 group-hover:text-[#fde464]"}`}>
                <span aria-hidden="true">{link.icon}</span>
                {link.name}
              </span>
              <div
                aria-hidden="true"
                class={`absolute bottom-5 h-1.5 w-1.5 rounded-full transition-all duration-300 ${isActive(link.path) ? "bg-[#f3bb34] opacity-100 scale-100 shadow-[0_0_10px_rgba(243,187,52,1)]" : "bg-[#f58b2a] opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#f58b2a]/50 bg-[#0d0903]/80 px-6 py-2.5 text-sm font-bold text-[#ffc98a] transition-all hover:border-[#f3bb34]/80 hover:bg-[#1f1709]/90 hover:text-[#fde464] md:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #c8901a, #f3bb34, #c8901a);"
          class="flex items-center justify-center rounded-full px-5 py-2 text-xs font-extrabold text-[#1a1203] shadow-[0_0_20px_rgba(243,187,52,0.3)] transition-all hover:shadow-[0_0_25px_rgba(243,187,52,0.5)] hover:brightness-110 lg:px-7 lg:py-2.5 lg:text-sm">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-400 lg:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[60] w-full translate-y-full transform rounded-t-3xl border-t border-[#8a5f08]/70 bg-[#0d0903] shadow-[0_-10px_40px_rgba(0,0,0,0.85)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex w-full cursor-pointer justify-center pt-3 pb-2" id="close-sheet-btn">
      <div class="h-1.5 w-12 rounded-full bg-[#5c3f04]"></div>
    </div>

    <div class="flex flex-col space-y-2 px-6 pt-2 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive(link.path) ? "bg-gradient-to-r from-[#f3bb34]/20 to-transparent border border-[#8a5f08]/60 text-[#fde464]" : "bg-white/5 border-transparent text-[#d8c69b]/70"}`}>
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="text-2xl drop-shadow-lg">{link.icon}</span>
              <span class="text-base font-bold tracking-wide">{link.name}</span>
            </div>
            {isActive(link.path) && <span class="h-2 w-2 rounded-full bg-[#f3bb34] shadow-[0_0_8px_rgba(243,187,52,1)]" />}
          </a>
        ))
      }

      <div class="mt-2 grid grid-cols-2 gap-3 border-t border-white/5 pt-4">
        <a href="/login" class="flex items-center justify-center rounded-xl border border-[#f58b2a]/45 bg-[#f58b2a]/10 py-3.5 text-sm font-bold text-[#ffc98a]">เข้าสู่ระบบ</a>
        <a
          href="/register"
          style="background-image: linear-gradient(in oklab to right, #c8901a, #f3bb34, #c8901a);"
          class="flex items-center justify-center rounded-xl py-3.5 text-sm font-extrabold text-[#1a1203] shadow-[0_0_15px_rgba(243,187,52,0.4)]">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileBottomSheet = document.getElementById("mobile-bottom-sheet");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const closeSheetBtn = document.getElementById("close-sheet-btn");
  const hamburgerLines = document.querySelectorAll(".hamburger-line");

  function toggleMenu() {
    const isOpen = mobileBottomSheet?.classList.contains("translate-y-0");

    if (!isOpen) {
      mobileBottomSheet?.classList.remove("translate-y-full");
      mobileBottomSheet?.classList.add("translate-y-0");
      mobileOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.add("opacity-100");

      hamburgerLines[0].classList.add("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.add("opacity-0");
      hamburgerLines[2].classList.add("-rotate-45", "-translate-y-[8px]");
    } else {
      mobileBottomSheet?.classList.add("translate-y-full");
      mobileBottomSheet?.classList.remove("translate-y-0");
      mobileOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileOverlay?.classList.remove("opacity-100");

      hamburgerLines[0].classList.remove("rotate-45", "translate-y-[8px]");
      hamburgerLines[1].classList.remove("opacity-0");
      hamburgerLines[2].classList.remove("-rotate-45", "-translate-y-[8px]");
    }
  }

  hamburgerBtn?.addEventListener("click", toggleMenu);
  mobileOverlay?.addEventListener("click", toggleMenu);
  closeSheetBtn?.addEventListener("click", toggleMenu);

  const sheetItems = document.querySelectorAll(".sheet-item");
  sheetItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (mobileBottomSheet?.classList.contains("translate-y-0")) {
        toggleMenu();
      }
    });
  });
</script>
