---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  /** "red" is the brand accent, "silver" the chrome tone. The older
   *  "gold"/"blue" spellings stay accepted so an inventory page that still
   *  passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "red" | "silver" | "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#2a0508] bg-[#170406]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#e8121d]/50 hover:bg-[#260609] hover:shadow-[0_10px_20px_rgba(232,18,29,0.18)]"
              : "hover:border-[#c2c9d4]/50 hover:bg-[#16181c] hover:shadow-[0_10px_20px_rgba(194,201,212,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#e8121d]/50 bg-gradient-to-br from-[#ff4d55] to-[#e8121d] text-[#1a0204] shadow-[0_0_15px_rgba(232,18,29,0.45)] group-hover:rotate-3"
                : "border border-[#c2c9d4]/60 bg-gradient-to-br from-[#eef1f6] to-[#c2c9d4] text-[#1a0204] shadow-[0_0_15px_rgba(194,201,212,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#ff4d55] to-[#e8121d] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#dfe3ea] to-[#8b929e] bg-clip-text text-transparent transition-colors group-hover:text-[#dfe3ea]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#dfe3ea]/75 transition-colors group-hover:text-[#dfe3ea]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
