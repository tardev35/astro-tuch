---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isBright = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#220a0a] bg-[#0c0505]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isBright
              ? "hover:border-[#f6d78a]/50 hover:bg-[#150806] hover:shadow-[0_10px_20px_rgba(246,215,138,0.16)]"
              : "hover:border-[#c9a869]/60 hover:bg-[#150806] hover:shadow-[0_10px_20px_rgba(201,168,105,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isBright
                ? "border border-[#f6d78a]/50 bg-gradient-to-br from-[#f6d78a] to-[#c8102e] shadow-[0_0_15px_rgba(246,215,138,0.5)] text-white group-hover:rotate-3"
                : "border border-[#c9a869]/60 bg-gradient-to-br from-[#c9a869] to-[#8a1420] shadow-[0_0_15px_rgba(201,168,105,0.45)] text-[#f4e3c8]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isBright
                  ? "bg-gradient-to-r from-[#f6d78a] to-[#c8102e] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e3cdb0] to-[#c9a869] bg-clip-text text-transparent transition-colors group-hover:text-[#e3cdb0]"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-[#f4e3c8]/75 transition-colors group-hover:text-[#f4e3c8]/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
