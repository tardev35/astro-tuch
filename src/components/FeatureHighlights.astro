---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#7e22ce]/50 bg-[#1e0a30]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#f472b6]/50 hover:bg-[#2c0f45] hover:shadow-[0_10px_20px_rgba(244,114,182,0.18)]"
              : "hover:border-[#c4b5fd]/50 hover:bg-[#150724] hover:shadow-[0_10px_20px_rgba(196,181,253,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#f472b6]/50 bg-gradient-to-br from-[#fbcfe8] to-[#ec4899] text-[#0a0313] shadow-[0_0_15px_rgba(244,114,182,0.45)] group-hover:rotate-3"
                : "border border-[#c4b5fd]/60 bg-gradient-to-br from-[#ede9fe] to-[#c4b5fd] text-[#0a0313] shadow-[0_0_15px_rgba(196,181,253,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#fbcfe8] to-[#f472b6] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#ddd6fe] to-[#c4b5fd] bg-clip-text text-transparent transition-colors group-hover:text-[#ddd6fe]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#f2e3f7]/75 transition-colors group-hover:text-[#f2e3f7]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
