---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** 365LOTTO's identity is a PAIR — the logo's gold "365" beside the red
   *  rings in "LOTTO" — so the two accents are the two hues rather than two
   *  brightnesses of one: "gold" is the bright gold plate (#fdf3b4 -> #e0b03a,
   *  dark glyph) and "red" the deep red one (#e01f26 -> #a40304, gold glyph).
   *  Every earlier brand's spelling stays accepted so an inventory page that
   *  still passes one keeps building — "sheen"/"steel"/"silver"/"blue" render
   *  as the gold plate and "deep"/"crimson"/"green" as the red plate. */
  accent?: "gold" | "red" | "sheen" | "deep" | "crimson" | "steel" | "silver" | "green" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// 365LOTTO palette: every card sits on the card surface (#1a0709) inside a deep
// gold hairline (#9c6a12), hovering onto the raised surface (#2a0b0e), and the
// icon plate alternates between the gold and the red above — the logo's own
// two-colour pair, alternating down the list.
//
// The title is the number highlight (#ffe9a3) rather than a gradient: every
// docx sub-point this component carries on the 365LOTTO landing page IS a
// payout or bonus figure (2 ตัวจ่าย 100, 3 ตัวจ่าย 1,000, แนะนำเพื่อน 0.8%,
// คืนยอดเสีย 0.3%), which is the one thing that colour is reserved for. The
// gold/red accent still separates the cards — on the plate, border and hover.
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
const GOLD = new Set(["gold", "sheen", "steel", "silver", "blue"]);
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isGold = GOLD.has(item.accent ?? "gold");
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#9c6a12] bg-[#1a0709]/90 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#fadc64]/75 hover:bg-[#2a0b0e] hover:shadow-[0_10px_20px_rgba(250,220,100,0.28)]"
              : "hover:border-[#e01f26]/75 hover:bg-[#2a0b0e] hover:shadow-[0_10px_20px_rgba(224,31,38,0.28)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#fadc64]/60 bg-gradient-to-br from-[#fdf3b4] to-[#e0b03a] text-[#120406] shadow-[0_0_15px_rgba(250,220,100,0.4)]"
                : "border border-[#e01f26]/70 bg-gradient-to-br from-[#e01f26] to-[#a40304] text-[#fadc64] shadow-[0_0_15px_rgba(224,31,38,0.45)] group-hover:rotate-3"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#ffe9a3] drop-shadow-[0_0_8px_rgba(224,31,38,0.35)]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#f0ddc4]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
