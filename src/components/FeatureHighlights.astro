---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** ร่ำรวย168's identity is a **two-material pair** read straight off this
   *  drop's artwork — the Thai word "ร่ำรวย" in the logo is glossy 3-D CYAN
   *  lettering, and the whole foreground of both slides is the model's
   *  IVORY/CREAM satin suit against a cream-ivory room. So the two accents are
   *  the lead cyan plate (#a9d7f2 → #18a5e2, ink #111a3f at 6.0:1 — brand-spec
   *  §2's "ปุ่มเน้น (สว่าง)" formula, and **white ink on #18a5e2 is banned at
   *  2.6:1**) and the second material, the cream plate (#f4e4d3 → #e4cbb3, ink
   *  #16294a at 11.9:1).
   *  ⚠️ The union was `"gold" | "cream"` when this file arrived, for the
   *  outgoing เงินทอง168's gold plates. **§2 has NO gold/yellow as a UI colour
   *  this round** — the gold in the artwork (coin basket, watch, belt buckle) is
   *  an object in the picture, not a brand colour — so the gold branch is gone
   *  from both the type and the implementation rather than being left
   *  accepted-but-recoloured: a spelling that still builds is a spelling the
   *  next page quietly passes.
   *  Only index.astro renders this component, so narrowing the union breaks
   *  nothing. */
  accent?: "cyan" | "cream";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 palette (.claude/brand-spec-ruaythear168club.md §2) — **ฟ้าไซยานนำ ·
// ครีมอุ่นเป็นวัสดุที่สอง · บนผิวสว่าง**
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน 180 องศา: ธีมสว่าง** bg.json =
// {"mode":"color","color":"#dbe6ff"} = ฟ้าเพอริวิงเคิลอ่อน (รอบก่อน เงินทอง168
// เป็น 29210f น้ำตาลโอลีฟเข้ม — **ค่านี้ต้องมาจาก bg.json ห้ามสืบทอดข้ามรอบ**)
// ลำดับผิว: **#ffffff ยก / #eef4ff ชั้นกลาง (การ์ดแต่ละใบที่นี่) / #dce9fb อินเซ็ต
// / #f4e4d3 ครีม / #dbe6ff พื้นเพจ** การ์ดแต่ละใบเป็น **ผิวกลางในเส้นฟ้าอ่อน**
// และยกขึ้นไปที่ผิวขาวตอน hover — **ห้าม "แก้" กลับไปเป็นการ์ดเข้ม**
// แผ่นไอคอนสลับระหว่าง **แผ่นฟ้า** กับ **แผ่นครีม** ไล่ลงไปตามลำดับรายการ —
// วัสดุนำสลับกับวัสดุที่สอง ตรงกับอาร์ตเวิร์กที่ตัวอักษร "ร่ำรวย" ฟ้าไซยานอยู่คู่กับ
// ชุดซาตินสีงาช้างและห้องโทนครีมซึ่งกินพื้นที่มากที่สุดของภาพ
// ⚠️⚠️ **แผ่นสองชนิดใช้หมึกคนละค่ากัน และนั่นคือกฎของ §2 ที่ตัดสิน ไม่ใช่รสนิยม**:
//   แผ่นฟ้า #a9d7f2 → #18a5e2 ใช้หมึก **#111a3f** (6.0:1 บน #18a5e2 · 12.7:1 บน
//     #a9d7f2) ⚠️⚠️ **ห้ามขาวบน #18a5e2 เด็ดขาด — 2.6:1**
//   แผ่นครีม #f4e4d3 → #e4cbb3 ใช้หมึก **#16294a** (11.9:1 บน #f4e4d3)
// ⚠️ **#18a5e2 และ #a9d7f2 โผล่ได้แค่เป็นขอบ/พื้นถม/ออรา** §2 ห้ามทั้งสองถือ
// ตัวอักษรบนพื้นสว่าง · **#0d6b9b ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ**
// ไม่ใช่ของไฟล์นี้
//
// หัวข้อรายการเป็น **ฟ้าเข้ม #0d6b9b ทึบสีเดียว** (5.2:1 บนผิวกลาง #eef4ff และเป็น
// text-xl font-black จึงนับเป็น large text ซึ่งเกณฑ์คือ 3:1) ไม่ใช่ไล่เฉด:
// บนหน้าแรกรายการสามใบที่คอมโพเนนต์นี้ถือคือป้าย **ขั้นตอนที่ 1 / 2 / 3** ของบรีฟเอง
// (content.txt บรรทัด 15-20) ใต้ docx H2 §6 สีทึบจึงอ่านเป็นลำดับขั้นตอน ส่วน
// ไล่เฉดจะอ่านเป็นสามหัวข้อแยกกัน · หัวข้อ H2 ของ §6 ที่อยู่เหนือมันเป็น #0d6b9b
// เหมือนกันแต่ **นั่งบนสันซ้ายสี่พิกเซลในการ์ดมุมตัด 40px** ลำดับชั้นจึงอ่านออกจาก
// รูปทรงและขนาด ไม่ใช่จากการเพิ่มค่าสีใหม่นอกตาราง §2
// ⚠️ ไอคอนที่หน้าแรกส่งมาเป็นกลุ่ม **"ตรวจที่อยู่เว็บ → กรอกและยืนยันบัญชี →
// เข้าสู่ระบบแล้วดูรายละเอียดเกม"** (🔎 📝 🔑) ซึ่งเป็นไอคอนของ *ขั้นตอน* ล้วน
// ⚠️ **ห้ามใช้ ⚖️ 🏦 💰 🐉 🎰 🃏 👑 🦁 🐰 🐱 ⚽ 🥬 🌽 🚜 หรือสัญลักษณ์หวย** —
// brand-spec §1 ระบุว่าทั้งหมดเป็นของแบรนด์ก่อน (ตราชั่งสองจานเป็นเอมเบลมของ
// เงินทอง168 ส่วนรอบนี้เป็น **ตะกร้าเหรียญทอง** ตัวเดียว และตะกร้า/นาฬิกา/เข็มขัด
// ในภาพเป็นวัตถุประกอบฉาก ไม่ใช่ไอคอนหลัก)
// ไอคอนอยู่ในแผ่น aria-hidden="true" ซึ่งเป็น **พี่น้อง** ของป้ายชื่อ ไม่ใช่อักขระ
// ในข้อความ
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ฟ้า/ไซยานนำมาแล้วห้าแบรนด์ในรีโปนี้
// และครีมเป็นวัสดุที่สองของแบรนด์ขาออกพอดี** การเจอฟ้าหรือครีมในไฟล์นี้จึงไม่พิสูจน์
// อะไรเลย ฟ้ารอบนี้คือ **#18a5e2 (R24 G165 B226)** กับ **#0d6b9b (R13 G107 B155)**
// และครีมคือ **#f4e4d3 / #e4cbb3** ซึ่งวัดจาก **slide1.png ของดรอปนี้เอง**
// ⚠️⚠️ ค่า vivid ดิบของ logo.webp รอบนี้คือ 6bddfb ซึ่งห่าง **6bdcfb ของ สบาย168
// แค่ 1 หน่วย** — รอบนี้จึงไม่ใช้ค่าดิบ ชุดที่ต้องไม่เหลือ: 2cc3fc 6bdcfb 0a7fbd
// 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff a9e3f9 0f3a4a
// 06293c fdcb0c fefb6b 8a6504 (สบาย168) · 039cfa 0494f5 c3ebfc 04366b e3f2fc
// 0b2d52 f9a826 704504 (รวยแทร่168) · 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d
// 071a28 (นินจา168) · 2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff ffc82e 5c4a16 (สบายเบท168)
// · 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 (TSDET911)
// ⚠️ ครีมรอบนี้ไม่ใช่ ecd5c4 d2b9a4 (เงินทอง168 — **แบรนด์ขาออก**) ไม่ใช่ eadfce
// (ขวัญใจ168) ไม่ใช่ f5e7c8 fce2d4 fcd4c3 (หวยคิง) และไม่ใช่ f4ead6 d6c6a8 f6e3b4
// (พักยก168 / ufalion168)
// ไฟล์นี้เพิ่งค้างชุด **ทองนำ-ครีมอุ่นบนน้ำตาลโอลีฟ ของแบรนด์ขาออก เงินทอง168**
// ไว้ทั้งใบ (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906 กับ
// rgba 252/238/82, rgba 245/186/20 และ rgba 236/213/196) ก่อนนั้นเป็นชุดของ
// พักยก168 (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 291d0f 3a2713 32200f
// 1f1308) และ สบาย168 — ออกครบทุกค่าแล้ว รวมถึง รวยแท้168 (c30303 8f0505 e81313
// dcb95f b8862b 96681f ffeee8 fff1ef ffdbdb) มีทรัพย์168 (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a)
// และ CEO66 (020617 7e22ce d946ef f5d0fe a855f7)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองทุกเฉด ไม่มีแดง ไม่มีทองแดงไหม้ ไม่มีบรอนซ์ ไม่มีม่วง
// ไม่มีเขียว (ยกเว้น LINE green กับเขียว success ที่อื่น) ไม่มีโรสโกลด์
// ไม่มีชมพู/ฟูเชีย ไม่มีส้ม และไม่มีแรมป์เทาเงิน**
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isCyan = (item.accent ?? "cyan") === "cyan";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#a9d7f2] bg-[#eef4ff] p-6 transition-all duration-300 hover:-translate-y-1 hover:bg-white sm:flex-row ${
            isCyan ? "hover:border-[#18a5e2] hover:shadow-[0_10px_20px_rgba(24,165,226,0.26)]" : "hover:border-[#e4cbb3] hover:shadow-[0_10px_20px_rgba(244,228,211,0.9)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isCyan
                ? "border border-[#18a5e2] bg-gradient-to-br from-[#a9d7f2] to-[#18a5e2] text-[#111a3f] shadow-[0_0_15px_rgba(24,165,226,0.35)] group-hover:rotate-3"
                : "border border-[#e4cbb3] bg-gradient-to-br from-[#f4e4d3] to-[#e4cbb3] text-[#16294a] shadow-[0_0_15px_rgba(244,228,211,0.9)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#0d6b9b]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#16294a]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
