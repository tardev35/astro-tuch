---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** รวยเทพ168's identity is a PAIR — gold "รวย" + pearl-white "เทพ" + scarlet
   *  "168" on black, with the laughing Chinese god-of-wealth in a gold-and-red
   *  winged cap — so the two accents are the two HUES rather than two
   *  brightnesses of one hue: "gold" is the solid imperial-gold plate
   *  (#f0bb4e, dark ink) and "red" the solid scarlet plate (#e4021b, cream
   *  glyph).
   *  ⚠️ The union was `"gold" | "blue"` when this file arrived. **Blue is banned
   *  this round** (brand-spec §2 bans every blue/azure/cyan outright), so the
   *  blue branch is gone from both the type and the implementation rather than
   *  being left accepted-but-recoloured — a spelling that still builds is a
   *  spelling the next page quietly passes. Only index.astro renders this
   *  component, so narrowing the union breaks nothing. */
  accent?: "gold" | "red";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// รวยเทพ168 palette (brand-spec §2): every card sits on the raised surface
// (#3b1b0e) inside a burnt-bronze hairline (#5c2a06), hovering down onto the mid
// surface (#260d04), and the icon plate alternates between the imperial-gold
// plate and the scarlet plate — the logo's own two-colour pair, alternating down
// the list.
// ⚠️ The two plates take DIFFERENT ink, and that is the §2 rule that decides it,
// not taste: ink #2b1400 on gold #f0bb4e is 9.91:1 ✓, but the same ink on
// scarlet #e4021b would be far under AA, so the scarlet plate takes #fff8ec
// (4.60:1 ✓ — the one combination §2 sanctions for text on a scarlet fill).
// ⚠️ Scarlet #e4021b scores 3.20:1 on this card's own surface, so it NEVER
// carries a glyph directly on the card — only as a FILL behind cream, as a
// border, and in the hover glow. Burnt bronze #5c2a06 carries no text anywhere
// in this file either; it is the resting hairline and nothing else.
//
// The title is cream gold #ffeccb (13.4:1 on the raised surface) rather than a
// gradient: on this landing page the three items this component carries are the
// brief's own ขั้นตอนที่ 1 / 2 / 3 labels under docx H2 §6 (content.txt lines
// 15-20), and a flat accent reads as a numbered list where a gradient would read
// as three separate section headings. The gold/red accent still separates the
// cards — on the plate, the border and the hover.
// ⚠️ ทองแบรนด์ #f0bb4e ถูก §2 สงวนไว้ให้ <strong> ในเนื้อความ จึงอยู่ในไฟล์นี้ได้
// เฉพาะที่แผ่นไอคอน ขอบ และเงา hover ไม่ใช่ที่ตัวอักษรหัวข้อ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ทั้งทองและแดงเคยถูกใช้มาแล้ว
// หลายแบรนด์ในรีโปนี้** การเจอทองหรือแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ไฟล์นี้เพิ่งค้างชุดแดงชาด-ทองเนยของมีเฮ168 ไว้ทั้งใบ (fb1b32 ff8f9c 5c0410 fcd45c
// 6b4a08 2b0711 1a040a 1b0308 fdeaec กับ rgba 251/27/50 และ rgba 252/212/92)
// ก่อนนั้นเป็นชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 (039cfa c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52 071e38 031320) ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb
// ffd1ea fde8f3 f5c53d ffe49a d19a12 9c6f08 b3006a 7a0046 4d002b 3a0534 4a0b42
// 2b0019) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (f3bb34 fde464 c8901a 8a5f08 5c3f04
// f58b2a ffc98a a3510c 1a1203 f6ecd9 1f1709 171106) และชุดทอง-แดงของ 365LOTTO
// (fdf3b4 e0b03a e01f26 a40304 fadc64 ffe9a3 9c6a12 1a0709 2a0b0e 120406 f0ddc4)
// — ออกครบทุกค่าแล้ว
// ⚠️ ทองของรอบนี้คือ **#f0bb4e (R240 G187 B78)** เท่านั้น ตัวที่อันตรายที่สุดคือ
// **f0b429 ของรับตัง168 ซึ่งมีค่า R เท่ากันเป๊ะ** ต่างกันที่ B78 vs B41 · และไม่ใช่
// fcd45c (มีเฮ168 รอบก่อน G212 vs G187) f9a826 (รวยแทร่168) fef54b (นินจา168)
// ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// e3b23c (สมหวัง168) f5c53d (FAH999) f3bb34 (DUCK1688) fbc134 (NAZA168) หรือ
// f5c518 (FLASH877) · แดงของรอบนี้คือ **#e4021b (R228 G2 B27)** เท่านั้น ⚠️ ไม่ใช่
// fb1b32 ของมีเฮ168 ที่เพิ่งอยู่ในไฟล์นี้ และ **ไม่ใช่ fa0513 ของสมหวัง168 ซึ่งอยู่
// ห่างกันแค่นิดเดียว** ไม่ใช่ d30304 (รับตัง168) b3121b (ขวัญใจ168) e01f26
// (365LOTTO) fb131b (TKB55) หรือ fb141b (GT66B)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์
// ไม่มีเหลืองมะนาว และไม่มีชมพู/ฟูเชีย** ส้มตัวเดียวที่อนุญาตคือทองแดง #d9701a
// ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isGold = (item.accent ?? "gold") === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#5c2a06] bg-[#3b1b0e]/92 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f0bb4e]/75 hover:bg-[#260d04] hover:shadow-[0_10px_20px_rgba(240,187,78,0.3)]"
              : "hover:border-[#e4021b]/80 hover:bg-[#260d04] hover:shadow-[0_10px_20px_rgba(228,2,27,0.32)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#d9701a] bg-[#f0bb4e] text-[#2b1400] shadow-[0_0_15px_rgba(240,187,78,0.45)] group-hover:rotate-3"
                : "border border-[#5c2a06] bg-[#e4021b] text-[#fff8ec] shadow-[0_0_15px_rgba(228,2,27,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#ffeccb] drop-shadow-[0_0_8px_rgba(240,187,78,0.35)]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#fff8ec]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
