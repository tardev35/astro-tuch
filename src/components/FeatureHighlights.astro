---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4c1095]/50 bg-[#0d0616]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#a855f7]/50 hover:bg-[#1c0b2a] hover:shadow-[0_10px_20px_rgba(168,85,247,0.18)]"
              : "hover:border-[#b3b8c2]/50 hover:bg-[#060210] hover:shadow-[0_10px_20px_rgba(230,232,236,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#a855f7]/50 bg-gradient-to-br from-[#d8a7ff] to-[#9d16f1] text-[#060210] shadow-[0_0_15px_rgba(168,85,247,0.45)] group-hover:rotate-3"
                : "border border-[#b3b8c2]/60 bg-gradient-to-br from-[#e6e8ec] to-[#b3b8c2] text-[#060210] shadow-[0_0_15px_rgba(230,232,236,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#d8a7ff] to-[#a855f7] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e6e8ec] to-[#a897c4] bg-clip-text text-transparent transition-colors group-hover:text-[#e6e8ec]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#e4d9f5]/75 transition-colors group-hover:text-[#e4d9f5]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
