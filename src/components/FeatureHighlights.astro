---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** สบาย168's identity is a **two-material pair** read straight off the
   *  artwork — the word "สบาย" is 3-D GOLD lettering while the "168" beside it
   *  is glossy SKY BLUE, and slide1/slide2 repeat the pair in the sky-blue
   *  percentage numerals above the piled gold coins. So the two accents are the
   *  lead sky blue and the second material: "sky" is the sky-blue plate
   *  (#2cc3fc → #6bdcfb, dark #06293c glyph at 7.5:1) and "gold" the canary
   *  plate (#fdcb0c → #fefb6b, #2a1f02 glyph at ~9:1). Both are combinations
   *  brand-spec §2 sanctions by name as the only inks allowed on those fills.
   *  ⚠️ The union was `"gold" | "chrome"` when this file arrived, for the
   *  outgoing ยูฟ้า168's canary/chrome plates. **§2 has NO silver or chrome of
   *  any shade this round** — so the chrome branch is gone from both the type
   *  and the implementation rather than being left accepted-but-recoloured: a
   *  spelling that still builds is a spelling the next page quietly passes.
   *  Only index.astro renders this component, so narrowing the union breaks
   *  nothing. */
  accent?: "sky" | "gold";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ───────────────────────────────────────────────────────────────────────────
// สบาย168 palette (.claude/brand-spec-sabai168.md §2): ⚠️⚠️ **รอบนี้กลับมาเป็น
// ธีมสว่างหลังรอบก่อน (ยูฟ้า168) เป็นดำสนิท** bg.json =
// {"mode":"color","color":"#ccf7ff"} = ฟ้าพาสเทลสว่าง ลำดับความลึกจึงกลับหัวจาก
// รอบที่แล้ว: **#ffffff ผิวยก / #f2fbff ชั้นกลาง (การ์ดแต่ละใบที่นี่) /
// #dff4fd อินเซ็ต / #ccf7ff พื้นเพจ** การ์ดแต่ละใบเป็น **ผิวกลางในเส้นฟ้าอ่อน**
// และสว่างขึ้นไปที่ผิวยก #ffffff ตอน hover ซึ่งกลับทางกับรอบที่แล้วที่มืดลง —
// **ห้าม "แก้" กลับไปเป็นการ์ดดำบนพื้นดำ**
// แผ่นไอคอนสลับระหว่าง **แผ่นฟ้าสกาย** กับ **แผ่นทองคานารี** ไล่ลงไปตามลำดับ
// รายการ — วัสดุนำสลับกับวัสดุที่สอง ตรงกับโลโก้ที่ "สบาย" ทอง + "168" ฟ้าสกาย
// ⚠️ แผ่นทั้งสองใช้ **หมึกเข้มคนละค่า** และนั่นคือกฎของ §2 ที่ตัดสิน ไม่ใช่รสนิยม:
// หมึก #06293c บนฟ้า #2cc3fc = 7.5:1 ✓ และหมึก #2a1f02 บนทอง #fdcb0c = ~9:1 ✓
// **ห้ามพลิกแผ่นไหนไปใช้หมึกขาว** (ขาวบน #fdcb0c ได้ 1.4:1 ตกทุกเกณฑ์)
// ⚠️ **#2cc3fc #6bdcfb #9ae0fa #fdcb0c #fefb6b โผล่ได้แค่เป็นพื้นถมของแผ่น ขอบ
// และออรา** §2 ห้ามทั้งห้าถือตัวอักษรบนพื้นสว่าง (1.5–2.4:1) ·
// **#8a6504 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// หัวข้อรายการเป็น **ฟ้าลึก #0a7fbd ทึบสีเดียว** (4.2:1 บนผิวกลาง และเป็น text-xl
// font-black จึงนับเป็น large text ซึ่งเกณฑ์คือ 3:1) ไม่ใช่ไล่เฉด: บนหน้าแรก
// รายการสามใบที่คอมโพเนนต์นี้ถือคือป้าย **ขั้นตอนที่ 1 / 2 / 3** ของบรีฟเอง
// (content.txt บรรทัด 15-20) ใต้ docx H2 §6 สีทึบจึงอ่านเป็นลำดับขั้นตอน ส่วน
// ไล่เฉดจะอ่านเป็นสามหัวข้อแยกกัน · หัวข้อ H2 ของ §6 ที่อยู่เหนือมันเป็น
// **น้ำเงินหมึก #063a57** ใน ContentBox ตัวฐาน การขึ้นมาเป็นฟ้าลึกตรงนี้จึงทำให้
// ลำดับชั้นอ่านออกโดยไม่ต้องลดขนาด
// ⚠️ ไอคอนที่หน้าแรกส่งมาเป็นกลุ่ม **"ตรวจที่อยู่เว็บ → กรอกและยืนยันบัญชี →
// เข้าสู่ระบบแล้วดูรายละเอียดเกม"** (🔎 📝 🔑) ซึ่งเป็นไอคอนของ *ขั้นตอน* ล้วน
// ⚠️ **ห้ามใช้ ⚽ ของรอบก่อน** (บรีฟรอบนี้ไม่มีฟุตบอล) และ **ห้ามใช้ 🎰 🃏 👑 🦁 🐰
// 🐱 🐉 หรือสัญลักษณ์หวย** — brand-spec §1 ระบุว่าทั้งหมดเป็นของแบรนด์ก่อนและ
// ไม่มีอยู่ในอาร์ตเวิร์กรอบนี้ ไอคอนอยู่ในแผ่น aria-hidden="true" ซึ่งเป็น
// **พี่น้อง** ของป้ายชื่อ ไม่ใช่อักขระในข้อความ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองเป็นฮิวที่แน่นที่สุดในรีโปนี้และ
// ผ่านมาแล้วเกือบทุกแบรนด์ ส่วนฟ้าผ่านมาแล้วสามเจ้า** การเจอฟ้าหรือทองในไฟล์นี้
// จึงไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ **#2cc3fc (R44 G195 B252)** และทองคือ
// **#fdcb0c (R253 G203 B12)** วัดจากอาร์ตเวิร์กของดรอปนี้เอง
// ⚠️⚠️ **สบายเบท168 เป็นชื่อที่ใกล้ที่สุดในรีโปและเป็นฟ้า+ทองเหมือนกัน — คนละ
// ลูกค้ากันสิ้นเชิง** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238
// 081726 040d16 04121f) · **นินจา168** (32bcfb a9e9ff fef54b 6b5c10 07335f
// 0c2a3d 071a28 030e16 041019 dceefc) ⚠️ 32bcfb ห่าง #2cc3fc แค่ R6/G7/B1 และ
// fef54b ห่าง #fefb6b แค่ G6/B32 · **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b
// f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320 7fa8cc 9dc4e4)
// ไฟล์นี้เพิ่งค้างชุด **ทองคานารี-โครเมียมเงินบนดำสนิท** ของแบรนด์ขาออก
// **ยูฟ้า168** ไว้ทั้งใบ (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472
// 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000 กับ rgba 254/228/93 α) rgba
// 168/178/191 α)) ⚠️ **fee45d ห่าง #fdcb0c แค่ G25/B81** จึงต้อง grep เป็นค่า
// ก่อนนั้นเป็นชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** (eb0305 e40303 c20305
// 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea
// ffd1d1 1a0802) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505 e81313
// dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ชุดทอง
// น้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** (f0c878 fff8d8 d9212a 8e1a16 4e2120 300605
// 2a0608) ชุดทองอิมพีเรียลของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 5c2a06 fff8ec) ชุดแดงชาด-ทองเนยของ **มีเฮ168** (fb1b32 ff8f9c 5c0410
// fcd45c 6b4a08 2b0711 1a040a) ชุดเขียวมรกตของ **สาธุ168** (0b7d28 0a5f1c 0f9b35
// 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดชมพูของ **มีทรัพย์168**
// (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) และ **CEO66** (020617 7e22ce d946ef
// f5d0fe a855f7) — ออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้ไม่ใช่ fee45d fdfc71 fef54b fcd434 f7c92b f0b429 e3b23c f0bb4e
// f0c878 ffc82e f9a826 ffd84d fcd45c dcb95f cd9a2c fdeb7c ffc93c e5a81b หรือ
// f0b46a และฟ้ารอบนี้ไม่ใช่ 2f9ff5 32bcfb 039cfa 0494f5 0360f3 0292fb 6ec8ff
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงทุกเฉด ไม่มีทองแดงไหม้ ไม่มีบรอนซ์ ไม่มีม่วง ไม่มีเขียว
// (ยกเว้น LINE green ที่อื่น) ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้ม
// และไม่มีเงิน/โครเมียม**
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isSky = (item.accent ?? "sky") === "sky";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#9ae0fa] bg-[#f2fbff] p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isSky ? "hover:border-[#2cc3fc] hover:bg-white hover:shadow-[0_10px_20px_rgba(44,195,252,0.26)]" : "hover:border-[#fdcb0c] hover:bg-white hover:shadow-[0_10px_20px_rgba(253,203,12,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isSky
                ? "border border-[#0a7fbd] bg-gradient-to-br from-[#2cc3fc] to-[#6bdcfb] text-[#06293c] shadow-[0_0_15px_rgba(44,195,252,0.35)] group-hover:rotate-3"
                : "border border-[#fdcb0c] bg-gradient-to-br from-[#fdcb0c] to-[#fefb6b] text-[#2a1f02] shadow-[0_0_15px_rgba(253,203,12,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#0a7fbd]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#0f3a4a]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
