---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4a2409]/70 bg-[#140a05]/80 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#f26a02]/60 hover:bg-[#1e0f06] hover:shadow-[0_10px_20px_rgba(242,106,2,0.2)]"
              : "hover:border-[#9ba3ad]/55 hover:bg-[#0b0503] hover:shadow-[0_10px_20px_rgba(227,231,236,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#f26a02]/55 bg-gradient-to-br from-[#ffb266] to-[#8c3a01] text-[#070403] shadow-[0_0_15px_rgba(242,106,2,0.45)] group-hover:rotate-3"
                : "border border-[#9ba3ad]/60 bg-gradient-to-br from-[#e3e7ec] to-[#9ba3ad] text-[#070403] shadow-[0_0_15px_rgba(227,231,236,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#e3e7ec] to-[#f26a02] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e3e7ec] to-[#9ba3ad] bg-clip-text text-transparent transition-colors group-hover:text-[#ff9130]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#ded4cb]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
