---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** มีเฮ168's identity is a PAIR — the pearl-white "มี" + scarlet "เฮ168"
   *  bubble lettering with the red bows and red hearts, and the butter-gold
   *  laughing face sitting on its pile of gold coins under a gold crown — so
   *  the two accents are the two hues rather than two brightnesses of one:
   *  "red" is the scarlet plate (#ff8f9c -> #fb1b32, dark glyph) and "gold" the
   *  solid butter-gold plate (#fcd45c, dark glyph). Every earlier brand's
   *  spelling stays accepted so an inventory page that still passes one keeps
   *  building — "amber"/"sheen"/"steel"/"silver" render as the gold plate and
   *  "blue"/"pink"/"deep"/"crimson"/"green" as the red one. */
  accent?: "red" | "gold" | "blue" | "amber" | "pink" | "deep" | "crimson" | "sheen" | "steel" | "silver" | "green";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// มีเฮ168 palette (brand-spec §2): every card sits on the raised surface
// (#2b0711) inside a deep-red hairline (#5c0410), hovering onto the mid surface
// (#1a040a), and the icon plate alternates between the scarlet plate and the
// butter-gold plate above — the logo's own two-colour pair, alternating down the
// list. Both plates are LIGHT with dark ink #1b0308 (5.0:1 on #fb1b32, 9.1:1 on
// #ff8f9c, 13.8:1 on #fcd45c); §2 forbids flipping a red/gold fill to a light
// glyph, and it forbids #5c0410 / #6b4a08 carrying text at any size, so neither
// plate gradient runs down into them under a glyph — the scarlet plate stops at
// #fb1b32 and the gold plate is a flat #fcd45c fill rather than a gradient,
// because a second gold stop would have to come from outside the palette (the
// pale gold #ffeec0 is reserved for gradient light ends elsewhere).
//
// The title is blush pink #ff8f9c rather than a gradient: on this landing page
// the three items this component carries are the brief's own ขั้นตอนที่ 1 / 2 / 3
// labels under docx H2 §6 (content.txt lines 15-20), and a flat accent reads as
// a numbered list where a gradient would read as three separate section
// headings. The red/gold accent still separates the cards — on the plate, the
// border and the hover.
// ⚠️ ทองเนย #fcd45c ถูก §2 สงวนไว้ให้ <strong> ในเนื้อความ + หัวข้อ/พื้นถมปุ่มหลัก
// จึงอยู่ในไฟล์นี้ได้เฉพาะที่แผ่นไอคอน ขอบ และเงา hover ไม่ใช่ที่ตัวอักษรหัวข้อ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ทั้งแดงและทองเคยถูกใช้มาแล้ว
// หลายแบรนด์ในรีโปนี้** การเจอแดงหรือทองในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ไฟล์นี้เพิ่งค้างชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ไว้ทั้งใบ (039cfa c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 031320 กับ rgba 3/156/250 และ rgba
// 249/168/38) ก่อนนั้นเป็นชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb ffd1ea fde8f3
// f5c53d ffe49a d19a12 9c6f08 b3006a 7a0046 4d002b 3a0534 4a0b42 2b0019) ชุดทอง
// เป็ด-ส้มอำพันของ DUCK1688 (f3bb34 fde464 c8901a 8a5f08 5c3f04 f58b2a ffc98a
// a3510c 1a1203 f6ecd9 1f1709 171106) และชุดทอง-แดงของ 365LOTTO (fdf3b4 e0b03a
// e01f26 a40304 fadc64 ffe9a3 9c6a12 1a0709 2a0b0e 120406 f0ddc4) — ออกครบทุกค่าแล้ว
// ทองของรอบนี้คือ **#fcd45c** เท่านั้น ไม่ใช่ f9a826 (รวยแทร่168) fef54b (นินจา168)
// ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// f0b429 (รับตัง168) e3b23c (สมหวัง168) f5c53d ffe49a d19a12 (FAH999) f3bb34
// (DUCK1688) fbc134 (NAZA168) หรือ f5c518 (GOT777/FLASH877) · แดงของรอบนี้คือ
// **#fb1b32 / #ff8f9c / #5c0410** เท่านั้น ⚠️ **ไม่ใช่ fa0513 ของสมหวัง168 ซึ่งอยู่
// ห่างกันแค่นิดเดียว** และไม่ใช่ d30304 (รับตัง168) b3121b (ขวัญใจ168) e01f26
// (365LOTTO) fb131b (TKB55) หรือ fb141b (GT66B)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีเหลืองมะนาว และไม่มีชมพูฟูเชีย** ชมพูตัวเดียวที่อนุญาตคือ
// บลัช #ff8f9c ซึ่งเป็นแดงจาง อ่านจากแก้มของหน้ายิ้มและโทนพื้นของแบนเนอร์
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
const GOLD = new Set(["gold", "amber", "sheen", "steel", "silver"]);
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isGold = GOLD.has(item.accent ?? "red");
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#5c0410] bg-[#2b0711]/92 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#fcd45c]/75 hover:bg-[#1a040a] hover:shadow-[0_10px_20px_rgba(252,212,92,0.28)]"
              : "hover:border-[#fb1b32]/75 hover:bg-[#1a040a] hover:shadow-[0_10px_20px_rgba(251,27,50,0.28)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#6b4a08] bg-[#fcd45c] text-[#1b0308] shadow-[0_0_15px_rgba(252,212,92,0.45)] group-hover:rotate-3"
                : "border border-[#5c0410] bg-gradient-to-br from-[#ff8f9c] to-[#fb1b32] text-[#1b0308] shadow-[0_0_15px_rgba(251,27,50,0.4)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#ff8f9c] drop-shadow-[0_0_8px_rgba(251,27,50,0.35)]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#fdeaec]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
