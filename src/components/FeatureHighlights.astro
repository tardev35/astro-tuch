---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  /** "red" is the brand accent, "silver" the chrome tone. The older
   *  "gold"/"blue" spellings stay accepted so an inventory page that still
   *  passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "red" | "silver" | "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#1e0709] bg-[#0d0304]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#ff2a30]/50 hover:bg-[#1a0507] hover:shadow-[0_10px_20px_rgba(255,42,48,0.18)]"
              : "hover:border-[#d3d6db]/50 hover:bg-[#141518] hover:shadow-[0_10px_20px_rgba(211,214,219,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#ff2a30]/50 bg-gradient-to-br from-[#ff6b70] to-[#ff2a30] text-[#2b070a] shadow-[0_0_15px_rgba(255,42,48,0.45)] group-hover:rotate-3"
                : "border border-[#d3d6db]/60 bg-gradient-to-br from-[#f1f2f4] to-[#d3d6db] text-[#12060a] shadow-[0_0_15px_rgba(211,214,219,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#ff6b70] to-[#ff2a30] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#d8dae0] to-[#8a8f98] bg-clip-text text-transparent transition-colors group-hover:text-[#d8dae0]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#d8dae0]/75 transition-colors group-hover:text-[#d8dae0]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
