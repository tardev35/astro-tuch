---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** ENTER55 has a single identity hue, so the two accents are two
   *  BRIGHTNESSES of the same gold rather than two colours: "sheen" is the
   *  bright plate (#ebd484 -> #c4a255, dark glyph) and "deep" the dark one
   *  (#c4a255 -> #8a6d2c, gold glyph). Every earlier brand's spelling stays
   *  accepted so an inventory page that still passes one keeps building —
   *  "gold"/"steel"/"silver"/"blue" render as the sheen plate and
   *  "crimson"/"red"/"green" as the deep plate. */
  accent?: "sheen" | "deep" | "crimson" | "gold" | "steel" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ENTER55 palette: every card sits on the card surface (#0b0b0a) inside a deep
// gold hairline (#8a6d2c), hovering onto the raised surface (#16140f), and the
// icon plate alternates between the sheen and deep golds above — one hue, told
// apart by brightness down an alternating list.
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
const SHEEN = new Set(["sheen", "gold", "steel", "silver", "blue"]);
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isDeep = !SHEEN.has(item.accent ?? "deep");
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#8a6d2c] bg-[#0b0b0a]/88 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isDeep
              ? "hover:border-[#c4a255]/75 hover:bg-[#16140f] hover:shadow-[0_10px_20px_rgba(196,162,85,0.28)]"
              : "hover:border-[#ebd484]/60 hover:bg-[#16140f] hover:shadow-[0_10px_20px_rgba(235,212,132,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isDeep
                ? "border border-[#8a6d2c]/70 bg-gradient-to-br from-[#c4a255] to-[#8a6d2c] text-[#ebd484] shadow-[0_0_15px_rgba(138,109,44,0.5)] group-hover:rotate-3"
                : "border border-[#ebd484]/60 bg-gradient-to-br from-[#ebd484] to-[#c4a255] text-[#000000] shadow-[0_0_15px_rgba(235,212,132,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isDeep ? "bg-gradient-to-r from-[#d2b262] to-[#8a6d2c] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#ebd484] to-[#c4a255] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#ded8cb]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
