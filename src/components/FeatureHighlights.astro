---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#7c0207]/50 bg-[#170406]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#e8121d]/55 hover:bg-[#2a0508] hover:shadow-[0_10px_20px_rgba(232,18,29,0.18)]"
              : "hover:border-[#aeb6c2]/50 hover:bg-[#0d0203] hover:shadow-[0_10px_20px_rgba(238,241,246,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#e8121d]/50 bg-gradient-to-br from-[#ff4d55] to-[#7c0207] text-[#0d0203] shadow-[0_0_15px_rgba(232,18,29,0.45)] group-hover:rotate-3"
                : "border border-[#aeb6c2]/60 bg-gradient-to-br from-[#eef1f6] to-[#aeb6c2] text-[#0d0203] shadow-[0_0_15px_rgba(238,241,246,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#eef1f6] to-[#e8121d] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#eef1f6] to-[#aeb6c2] bg-clip-text text-transparent transition-colors group-hover:text-[#ff4d55]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#d7dce4]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
