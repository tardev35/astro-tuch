---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#062d94]/50 bg-[#040e22]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#0e6efb]/50 hover:bg-[#08203f] hover:shadow-[0_10px_20px_rgba(14,110,251,0.18)]"
              : "hover:border-[#b6c2d4]/50 hover:bg-[#01050f] hover:shadow-[0_10px_20px_rgba(230,232,236,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#0e6efb]/50 bg-gradient-to-br from-[#7db4ff] to-[#1160e0] text-[#01050f] shadow-[0_0_15px_rgba(14,110,251,0.45)] group-hover:rotate-3"
                : "border border-[#b6c2d4]/60 bg-gradient-to-br from-[#e6e8ec] to-[#b6c2d4] text-[#01050f] shadow-[0_0_15px_rgba(230,232,236,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#a9ccff] to-[#0e6efb] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e6e8ec] to-[#93a7c6] bg-clip-text text-transparent transition-colors group-hover:text-[#e6e8ec]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#dce9ff]/75 transition-colors group-hover:text-[#dce9ff]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
