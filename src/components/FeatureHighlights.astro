---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "green" is the brand accent, "silver" the chrome tone. The older
   *  "red"/"gold"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "green" | "silver" | "red" | "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#0b7a06]/50 bg-[#031204]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#25cb0e]/50 hover:bg-[#052008] hover:shadow-[0_10px_20px_rgba(37,203,14,0.18)]"
              : "hover:border-[#cfd6cd]/50 hover:bg-[#010301] hover:shadow-[0_10px_20px_rgba(240,247,238,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#25cb0e]/50 bg-gradient-to-br from-[#6ef25a] to-[#25cb0e] text-[#031204] shadow-[0_0_15px_rgba(37,203,14,0.45)] group-hover:rotate-3"
                : "border border-[#cfd6cd]/60 bg-gradient-to-br from-[#f0f7ee] to-[#cfd6cd] text-[#031204] shadow-[0_0_15px_rgba(240,247,238,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#6ef25a] to-[#25cb0e] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#f0f7ee] to-[#8fa08c] bg-clip-text text-transparent transition-colors group-hover:text-[#f0f7ee]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#d5e8d0]/75 transition-colors group-hover:text-[#d5e8d0]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
