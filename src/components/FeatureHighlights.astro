---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isBright = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#1c1030] bg-[#0f0818]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isBright
              ? "hover:border-[#a78bfa]/50 hover:bg-[#150c24] hover:shadow-[0_10px_20px_rgba(167,139,250,0.16)]"
              : "hover:border-[#9ca3af]/60 hover:bg-[#150c24] hover:shadow-[0_10px_20px_rgba(156,163,175,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isBright
                ? "border border-[#a78bfa]/50 bg-gradient-to-br from-[#a78bfa] to-[#7c3aed] shadow-[0_0_15px_rgba(167,139,250,0.5)] text-white group-hover:rotate-3"
                : "border border-[#9ca3af]/60 bg-gradient-to-br from-[#9ca3af] to-[#6b7280] shadow-[0_0_15px_rgba(156,163,175,0.45)] text-[#f0e9fc]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isBright
                  ? "bg-gradient-to-r from-[#a78bfa] to-[#7c3aed] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e5e7eb] to-[#9ca3af] bg-clip-text text-transparent transition-colors group-hover:text-[#e5e7eb]"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-[#f0e9fc]/75 transition-colors group-hover:text-[#f0e9fc]/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
