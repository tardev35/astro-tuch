---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** ยูฟ้า168's identity is a **two-material pair** read straight off the
   *  artwork — the word "ยูฟ้า" is 3-D glossy GOLD lettering while the "168"
   *  beside it is brushed CHROME, and banner1/slide1/slide2 repeat the pair in
   *  the gold footballs against the black-and-gold kit. So the two accents are
   *  the lead gold and the second material: "gold" is the gold-gradient plate
   *  (#fee45d → #e6a416, dark #140e02 glyph at 15.1:1) and "chrome" the
   *  chrome-gradient plate (#e8ecf1 → #a8b2bf, #0b0d10 glyph at 15.9:1). Both
   *  are combinations brand-spec §2 sanctions by name as the primary and the
   *  secondary CTA fills.
   *  ⚠️ The union was `"red" | "copper"` when this file arrived, for the
   *  outgoing โปรดี168's cherry/burnt-copper plates. **§2 has NO red of any
   *  shade this round** — so the red branch is gone from both the type and the
   *  implementation rather than being left accepted-but-recoloured: a spelling
   *  that still builds is a spelling the next page quietly passes. Only
   *  index.astro renders this component, so narrowing the union breaks nothing. */
  accent?: "gold" | "chrome";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ───────────────────────────────────────────────────────────────────────────
// ยูฟ้า168 palette (.claude/brand-spec-ufabet168.md §2): ⚠️⚠️ **รอบนี้กลับมาเป็น
// ธีมมืดหลังสามรอบติดที่เป็นธีมสว่าง** bg.json = {"mode":"color","color":"#000000"}
// = ดำสนิท ลำดับความลึกจึงกลับหัวจากสามรอบก่อนของไฟล์นี้: **#15130f ผิวยก /
// #1e1a13 ผิวอุ่น / #0a0908 ผิวจม / #000000 พื้นเพจ** การ์ดแต่ละใบเป็น **ผิวมืด
// ในเส้นทองโปร่ง** และสว่างขึ้นไปที่ผิวอุ่น #1e1a13 ตอน hover —
// **ห้าม "แก้" กลับไปเป็นการ์ดขาวบนพื้นชมพู**
// แผ่นไอคอนสลับระหว่าง **แผ่นทองคานารี** กับ **แผ่นโครเมียมเงิน** ไล่ลงไปตามลำดับ
// รายการ — วัสดุนำสลับกับวัสดุที่สอง ตรงกับโลโก้ที่ "ยูฟ้า" ทอง + "168" โครเมียม
// ⚠️ แผ่นทั้งสองใช้ **หมึกเข้มคนละค่า** และนั่นคือกฎของ §2 ที่ตัดสิน ไม่ใช่รสนิยม:
// หมึก #140e02 บนทอง #fee45d = 15.1:1 ✓ และหมึก #0b0d10 บนโครเมียม #e8ecf1 =
// 15.9:1 ✓ **ห้ามพลิกแผ่นไหนไปใช้หมึกขาว** (§2 ข้อ 2 ห้ามขาวบนทองไว้ชัด)
// ⚠️ **#7a4e05 (2.4:1) และ #5a6472 (3.3:1) โผล่ได้แค่เป็นขอบของแผ่น** §2 ห้ามทั้งคู่
// ถือตัวอักษร · **#fee45d ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// หัวข้อรายการเป็น **ทองกลาง #e6a416 ทึบสีเดียว** (8.7:1 บนผิวยก และเป็น text-xl
// font-black จึงเป็น large text ด้วย) ไม่ใช่ไล่เฉด: บนหน้าแรกรายการสามใบที่
// คอมโพเนนต์นี้ถือคือป้าย **ขั้นตอนที่ 1 / 2 / 3** ของบรีฟเอง (content.txt บรรทัด
// 15-20) ใต้ docx H2 §6 สีทึบจึงอ่านเป็นลำดับขั้นตอน ส่วนไล่เฉดจะอ่านเป็นสามหัวข้อ
// แยกกัน · หัวข้อ H2 ของ §6 ที่อยู่เหนือมันเป็น **ทองคานารี #fee45d** ใน ContentBox
// ตัวฐาน การลดลงมาเป็นทองกลางตรงนี้จึงทำให้ลำดับชั้นอ่านออกโดยไม่ต้องลดขนาด
// ⚠️ ไอคอนที่หน้าแรกส่งมาเป็นกลุ่ม **"ตรวจที่อยู่เว็บ → กรอกและยืนยันบัญชี →
// เข้าสู่ระบบแล้วดูรายละเอียดบริการ"** (🔎 📝 ⚽) ตรงกับแกนของบรีฟรอบนี้ซึ่งเป็น
// **เว็บพนันออนไลน์ที่แกนคือแทงบอล + สล็อต + บาคาร่า** ไม่ใช่ชุดสล็อตล้วนของรอบก่อน
// และ **ห้ามใช้ 🐰 ของรอบก่อน** ไอคอนอยู่ในแผ่น aria-hidden="true" ซึ่งเป็น
// **พี่น้อง** ของป้ายชื่อ ไม่ใช่อักขระในข้อความ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองเป็นฮิวที่แน่นที่สุดในรีโปนี้ และ
// ผ่านมาแล้วเกือบทุกแบรนด์** การเจอทองในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ทองรอบนี้คือ
// **#fee45d (R254 G228 B93)** วัดจาก logo.webp เอง และตัวแยกที่แข็งที่สุดคือ
// **โครเมียมเงิน #e8ecf1 / #a8b2bf / #78828f** ที่รีโปนี้แทบไม่เคยใช้
// ⚠️ **ufalion168 เป็นแบรนด์บอลเหมือนกัน** (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) และ **UFA324 ชื่อใกล้ที่สุด** (e5a81b
// ffe08a bb8410 7d5a07 43300a 17130a 312713 0d0b06 140d01 8792a0 f0e8d4 b9c2cc
// 464f5a) — ทั้งคู่ต้องไม่เหลือสักค่า ห้ามเทียบด้วยแนวเรื่องหรือชื่อ
// ไฟล์นี้เพิ่งค้างชุด **แดงเชอร์รี่-ทองแดงไหม้บนผิวขาว** ของแบรนด์ขาออก **โปรดี168**
// ไว้ทั้งใบ (eb0305 e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a
// 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802 กับ rgba 235/3/5 α) rgba 180/76/6 α)
// rgba 64/17/7 α)) ก่อนนั้นเป็นชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303
// 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb
// c99a3f) ชุดทองน้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** (f0c878 fff8d8 d9212a 8e1a16
// 4e2120 300605 2a0608) ชุดทองอิมพีเรียล-แดงชาดของ **รวยเทพ168** (f0bb4e ffeccb
// e4021b d9701a 3b1b0e 260d04 5c2a06 fff8ec 2b1400) ชุดแดงชาด-ทองเนยของ **มีเฮ168**
// (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 1b0308 fdeaec) และชุดฟ้าอะซัวร์-
// ทองอำพันของ **รวยแทร่168** (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52
// 071e38 031320) — ออกครบทุกค่าแล้ว เช่นเดียวกับ นินจา168 (32bcfb a9e9ff 07335f
// fef54b 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) สาธุ168 (0b7d28 0a5f1c 0f9b35
// 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) มีทรัพย์168 (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) และ CEO66 (020617 7e22ce d946ef f5d0fe a855f7)
// ⚠️ ทองรอบนี้ไม่ใช่ fdfc71 fef54b fcd434 f7c92b f0b429 e3b23c f0bb4e f0c878 ffc82e
// f9a826 ffd84d fcd45c dcb95f cd9a2c fdeb7c ffc93c e5a81b หรือ f0b46a
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงทุกเฉด ไม่มีทองแดงไหม้ ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง
// ไม่มีเขียว (ยกเว้น LINE green ที่อื่น) ไม่มีโรสโกลด์ และไม่มีชมพู/ฟูเชีย**
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isGold = (item.accent ?? "gold") === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#e6a416]/35 bg-[#15130f] p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#fee45d]/75 hover:bg-[#1e1a13] hover:shadow-[0_10px_20px_rgba(254,228,93,0.22)]"
              : "hover:border-[#a8b2bf]/70 hover:bg-[#1e1a13] hover:shadow-[0_10px_20px_rgba(168,178,191,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#7a4e05] bg-gradient-to-br from-[#fee45d] to-[#e6a416] text-[#140e02] shadow-[0_0_15px_rgba(254,228,93,0.3)] group-hover:rotate-3"
                : "border border-[#5a6472] bg-gradient-to-br from-[#e8ecf1] to-[#a8b2bf] text-[#0b0d10] shadow-[0_0_15px_rgba(168,178,191,0.28)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#e6a416]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#eae3d4]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
