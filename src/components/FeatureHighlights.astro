---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** พักยก168's identity is a **two-material pair** read straight off the
   *  artwork — the Thai word "พักยก" is 3-D GOLD lettering while the "168"
   *  beside it is CHROME SILVER, and the same pair repeats on the logo's gold
   *  dragon head against the chrome numerals. So the two accents are the lead
   *  gold plate (#fded41 → #eeae12) and the second material, the chrome plate
   *  (#e0e0df → #a1a09e); both take the dark ink #1f0f04, which brand-spec §2
   *  names as the only ink allowed on a gold or chrome fill (15.4:1 on #fded41,
   *  9.5:1 on #eeae12, 14.1:1 on #e0e0df).
   *  ⚠️ The union was `"sky" | "gold"` when this file arrived, for the outgoing
   *  สบาย168's sky-blue/canary plates. **§2 has NO blue of any shade this
   *  round** — so the sky branch is gone from both the type and the
   *  implementation rather than being left accepted-but-recoloured: a spelling
   *  that still builds is a spelling the next page quietly passes.
   *  Only index.astro renders this component, so narrowing the union breaks
   *  nothing. */
  accent?: "gold" | "chrome";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ───────────────────────────────────────────────────────────────────────────
// พักยก168 palette (.claude/brand-spec-pakyok168.md §2): ⚠️⚠️ **รอบนี้เป็นธีมมืด
// ส่วนรอบก่อน (สบาย168) เป็นฟ้าพาสเทลสว่าง** bg.json =
// {"mode":"color","color":"#291d0f"} = น้ำตาลกาแฟเข้ม ลำดับความลึกจึงกลับหัวจาก
// รอบที่แล้ว: **#3a2713 ผิวยก / #32200f ชั้นกลาง (การ์ดแต่ละใบที่นี่) /
// #1f1308 อินเซ็ต / #291d0f พื้นเพจ** การ์ดแต่ละใบเป็น **ผิวกลางในเส้นทองลึก**
// และยกขึ้นไปที่ผิวยก #3a2713 ตอน hover — **ห้าม "แก้" กลับไปเป็นการ์ดขาว
// บนพื้นฟ้าพาสเทล**
// แผ่นไอคอนสลับระหว่าง **แผ่นทอง** กับ **แผ่นโครเมียม** ไล่ลงไปตามลำดับรายการ —
// วัสดุนำสลับกับวัสดุที่สอง ตรงกับโลโก้ที่ "พักยก" ทอง + "168" โครเมียม
// ⚠️ แผ่นทั้งสองใช้ **หมึกเข้มค่าเดียวกันคือ #1f0f04** และนั่นคือกฎของ §2 ที่ตัดสิน
// ไม่ใช่รสนิยม: 15.4:1 บน #fded41 · 9.5:1 บน #eeae12 · 14.1:1 บน #e0e0df
// **ห้ามพลิกแผ่นไหนไปใช้หมึกขาว** (§2 ห้ามขาวบนทองไว้ชัด)
// ⚠️ **ทองลึก #9f600d (2.8:1) โผล่ได้แค่เป็นขอบและพื้นถม** §2 ห้ามมันถือตัวอักษร ·
// **#fded41 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// หัวข้อรายการเป็น **ทองแกน #eeae12 ทึบสีเดียว** (7.9:1 บนผิวกลาง และเป็น text-xl
// font-black จึงนับเป็น large text ซึ่งเกณฑ์คือ 3:1) ไม่ใช่ไล่เฉด: บนหน้าแรก
// รายการสามใบที่คอมโพเนนต์นี้ถือคือป้าย **ขั้นตอนที่ 1 / 2 / 3** ของบรีฟเอง
// (content.txt บรรทัด 15-20) ใต้ docx H2 §6 สีทึบจึงอ่านเป็นลำดับขั้นตอน ส่วน
// ไล่เฉดจะอ่านเป็นสามหัวข้อแยกกัน · หัวข้อ H2 ของ §6 ที่อยู่เหนือมันเป็น
// **ทองสว่าง #fded41** ใน ContentBox ตัวฐาน การลดลงมาเป็นทองแกนตรงนี้จึงทำให้
// ลำดับชั้นอ่านออกโดยไม่ต้องลดขนาด
// ⚠️ ไอคอนที่หน้าแรกส่งมาเป็นกลุ่ม **"ตรวจที่อยู่เว็บ → กรอกและยืนยันบัญชี →
// เข้าสู่ระบบแล้วดูรายละเอียดเกม"** (🔎 📝 🔑) ซึ่งเป็นไอคอนของ *ขั้นตอน* ล้วน
// ⚠️ **ห้ามใช้ 🥬 🌽 🍓 🚜 ของรอบก่อน** (บรีฟรอบนี้ไม่มีฟาร์ม/ผัก) และ **ห้ามใช้
// 🎰 🃏 👑 🦁 🐰 🐱 ⚽ หรือสัญลักษณ์หวย** — brand-spec §1 ระบุว่าทั้งหมดเป็นของ
// แบรนด์ก่อนและไม่ใช่สัญลักษณ์ของรอบนี้ (สัญลักษณ์รอบนี้คือหัวมังกรทองตัวเดียว
// และมงกุฎในภาพเป็นวัตถุประกอบฉาก ไม่ใช่ไอคอนหลัก) ไอคอนอยู่ในแผ่น
// aria-hidden="true" ซึ่งเป็น **พี่น้อง** ของป้ายชื่อ ไม่ใช่อักขระในข้อความ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองเป็นฮิวที่แน่นที่สุดในรีโปนี้และ
// ผ่านมาแล้วเกือบทุกแบรนด์** การเจอทองในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ทองรอบนี้คือ
// **#eeae12 (R238 G174 B18)** กับ **#fded41 (R253 G237 B65)** วัดจากอาร์ตเวิร์กของ
// ดรอปนี้เอง และโครเมียมคือ **#e0e0df / #c0c0bf / #a1a09e** ซึ่งเป็นเทากลาง-อุ่น
// (R ≥ G ≥ B)
// ⚠️⚠️ **ยูฟ้า168 เป็นเจ้าเดียวในรีโปที่เดินทอง+เงินเหมือนรอบนี้ — คนละลูกค้ากัน
// สิ้นเชิง** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13
// 0a0908 eae3d4 140e02 0b0d10 000000) ⚠️ e6a416 ห่าง #eeae12 แค่ R8/G10/B4 และ
// fee45d ห่าง #fded41 แค่ R1/G9/B28 · **UFA324** (e5a81b ffe08a bb8410 7d5a07
// 8792a0 f0e8d4 b9c2cc 464f5a) ⚠️ e5a81b ห่าง #eeae12 แค่ R9/G6/B7 · **นินจา168**
// (32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28 030e16 041019 dceefc) ⚠️ fef54b
// ห่าง #fded41 แค่ R1/G8/B10
// ไฟล์นี้เพิ่งค้างชุด **ฟ้าสกาย-ทองคานารีบนธีมสว่าง** ของแบรนด์ขาออก **สบาย168**
// ไว้ทั้งใบ (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504 ffffff
// f2fbff dff4fd ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74 06293c 2a1f02 กับ rgba
// 44/195/252 α) rgba 253/203/12 α)) ก่อนนั้นเป็นชุดทองคานารี-โครเมียมเงินบนดำสนิท
// ของ **ยูฟ้า168** ชุดแดงเชอร์รี่-ทองแดงไหม้ของ **โปรดี168** (eb0305 e40303 c20305
// 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea
// ffd1d1 1a0802) ชุดแดงคริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505 e81313
// dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) ชุดทอง
// น้ำผึ้ง-แดงชาดของ **ดวงเศรษฐี168** (f0c878 fff8d8 d9212a 8e1a16 4e2120 300605
// 2a0608) ชุดทองอิมพีเรียลของ **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 5c2a06 fff8ec) ชุดแดงชาด-ทองเนยของ **มีเฮ168** (fb1b32 ff8f9c 5c0410
// fcd45c 6b4a08 2b0711 1a040a) ชุดเขียวมรกตของ **สาธุ168** (0b7d28 0a5f1c 0f9b35
// 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) ชุดชมพูของ **มีทรัพย์168**
// (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) และ **CEO66** (020617 7e22ce d946ef
// f5d0fe a855f7) — ออกครบทุกค่าแล้ว
// ⚠️ ทองรอบนี้ไม่ใช่ fee45d fdfc71 fef54b fcd434 f7c92b f0b429 e3b23c f0bb4e f0c878
// ffc82e f9a826 ffd84d fcd45c dcb95f cd9a2c fdeb7c ffc93c e5a81b fdcb0c fefb6b
// หรือ f0b46a และรอบนี้ไม่มีฟ้าเลยสักเฉด (2cc3fc 2f9ff5 32bcfb 039cfa 0494f5 0360f3
// 0292fb 6ec8ff)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดงทุกเฉด ไม่มีทองแดงไหม้ ไม่มีบรอนซ์ ไม่มีม่วง ไม่มีเขียว
// (ยกเว้น LINE green ที่อื่น) ไม่มีโรสโกลด์ ไม่มีชมพู/ฟูเชีย ไม่มีส้ม
// และไม่มีฟ้า/น้ำเงิน**
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isGold = (item.accent ?? "gold") === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#9f600d] bg-[#32200f] p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold ? "hover:border-[#fded41] hover:bg-[#3a2713] hover:shadow-[0_10px_20px_rgba(253,237,65,0.26)]" : "hover:border-[#e0e0df] hover:bg-[#3a2713] hover:shadow-[0_10px_20px_rgba(224,224,223,0.26)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#9f600d] bg-gradient-to-br from-[#fded41] to-[#eeae12] text-[#1f0f04] shadow-[0_0_15px_rgba(238,174,18,0.35)] group-hover:rotate-3"
                : "border border-[#a1a09e] bg-gradient-to-br from-[#e0e0df] to-[#a1a09e] text-[#1f0f04] shadow-[0_0_15px_rgba(224,224,223,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#eeae12]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#f4ead6]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
