---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** หมูบิน168's identity is a **two-material pair** read straight off this
   *  drop's artwork — the bubble wordmark "หมูบิน168" and the floating hearts
   *  are VIVID PINK, while the piglet's body, the cheeks and the capsule
   *  outlines on both slides are the softer PEACH/BLUSH pink. So the two plates
   *  are the lead pink plate (#fdc6c3 → #fa539c, ink #3b0b26 at 5.3:1 — and
   *  **white ink on #fa539c is banned at 3.2:1**) and the second material, the
   *  peach plate (#ffd1cd → #fb8cc0, ink #3b0b26 at 7.6:1).
   *  ⚠️ The union was `"cyan" | "cream"` when this file arrived, for ร่ำรวย168's
   *  cyan/cream plates. **§2 has NO cyan and NO cream as a UI colour this
   *  round**, so both spellings are gone from the type as well as from the
   *  implementation rather than being left accepted-but-recoloured: a spelling
   *  that still builds is a spelling the next page quietly passes.
   *  Only index.astro renders this component, so narrowing the union breaks
   *  nothing. */
  accent?: "pink" | "peach";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";

// ───────────────────────────────────────────────────────────────────────────
// หมูบิน168 palette (.claude/brand-spec-moobin168.md §2) — **ชมพูแคนดี้นำ ·
// พีช/ชมพูนวลเป็นวัสดุที่สอง · บนผิวสว่าง**
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน 180 องศา: ธีมสว่าง** bg.json =
// {"mode":"color","color":"#ffe5ff"} = ชมพูพาสเทลสว่างมาก (รอบก่อน สล็อต168
// เป็น 140000 ดำอมแดง — **ค่านี้ต้องมาจาก bg.json ห้ามสืบทอดข้ามรอบ**)
// ลำดับผิว: **#ffffff ยก / #fff0f8 ชั้นกลาง / #ffeef7 wash / #ffe5ff พื้นเพจ**
// การ์ดแต่ละใบที่นี่เป็น **ผิวขาว #ffffff ในเส้นชมพูอ่อน #f7bcd9** และยกขอบเป็น
// ชมพูสดตอน hover — **ห้าม "แก้" กลับไปเป็นการ์ดเข้ม** หมึก #3b0b26 บนการ์ดมืด
// คือตัวอักษรหายไปเลย
// แผ่นไอคอนสลับระหว่าง **แผ่นชมพูสด** กับ **แผ่นพีช** ไล่ลงไปตามลำดับรายการ —
// วัสดุนำสลับกับวัสดุที่สอง ตรงกับอาร์ตเวิร์กที่ตัวอักษรบับเบิลชมพูบานเย็นกับ
// หัวใจชมพูสดอยู่คู่กับตัวลูกหมูและแคปซูลโทนพีชนวลบนพื้นสตูดิโอขาว
// ⚠️⚠️ **แผ่นสองชนิดใช้หมึกค่าเดียวกันรอบนี้ และนั่นคือกฎของ §2 ที่ตัดสิน ไม่ใช่
// รสนิยม**:
//   แผ่นชมพู #fdc6c3 → #fa539c ใช้หมึก **#3b0b26** (5.3:1 บน #fa539c · 15.3:1
//     บน #fdc6c3) ⚠️⚠️ **ห้ามขาวบน #fa539c เด็ดขาด — 3.2:1**
//   แผ่นพีช #ffd1cd → #fb8cc0 ใช้หมึก **#3b0b26** (7.6:1 บน #fb8cc0)
// ⚠️ **#fa539c #fb8cc0 #fdc6c3 #ffd1cd #f7bcd9 #ef8dbd โผล่ได้แค่เป็นขอบ/พื้นถม/
// ออรา** §2 ห้ามทุกค่าถือตัวอักษรบนพื้นสว่าง · **#c2185b ในเนื้อความเป็นงานของ
// <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// หัวข้อรายการเป็น **ชมพูเข้ม #c2185b ทึบสีเดียว** (5.9:1 บนผิวขาว และเป็น
// text-xl font-black จึงนับเป็น large text ซึ่งเกณฑ์คือ 3:1) ไม่ใช่ไล่เฉด:
// บนหน้าแรกรายการสามใบที่คอมโพเนนต์นี้ถือคือป้าย **ขั้นตอนที่ 1 / 2 / 3** ของ
// บรีฟเอง (content.txt บรรทัด 13-18) ใต้ docx H2 §5 สีทึบจึงอ่านเป็นลำดับขั้นตอน
// ส่วนไล่เฉดจะอ่านเป็นสามหัวข้อแยกกัน · หัวข้อ H2 ของ §5 ที่อยู่เหนือมันมาจาก
// ContentBox ตัวฐาน ซึ่งเป็น #c2185b เหมือนกันแต่ **นั่งบนการ์ดที่มีเส้นไรผม
// ชมพูพาดขอบบนและออราสองมุม** ลำดับชั้นจึงอ่านออกจากรูปทรงและขนาด ไม่ใช่จากการ
// เพิ่มค่าสีใหม่นอกตาราง §2
// ⚠️ ไอคอนที่หน้าแรกส่งมาเป็นกลุ่ม **"ตรวจที่อยู่เว็บแล้วเข้าหน้าสมัคร → กรอก
// ข้อมูลและยืนยันบัญชี → เข้าสู่ระบบแล้วดูรายละเอียดเกม"** (🔎 📝 🎮) ซึ่งเป็น
// ไอคอนของ *ขั้นตอน* ล้วน
// ⚠️ **ห้ามใช้ ⚖️ 🏦 💰 🐉 🃏 👑 🦁 🐰 🐱 ⚽ 🥬 🌽 🚜 หรือสัญลักษณ์หวย
// (ลูกบอลหวย ใบสลาก ตารางอัตราจ่าย)** — brand-spec §6 ระบุว่าทั้งหมดเป็นของ
// แบรนด์ก่อน ๆ และ ⚠️⚠️ **ห้ามใช้หน้ากากโจร โจร หรือถุงเงิน** ซึ่งเป็นของ
// มีทรัพย์168 ที่เป็นหมูการ์ตูนชมพูเหมือนกัน รอบนี้คือ **หมูมีปีกนางฟ้าขาวกับ
// หัวใจ** · ห้ามมงกุฎทอง/วงล้อสล็อตแดง (สล็อต168 แบรนด์ขาออก)
// ไอคอนอยู่ในแผ่น aria-hidden="true" ซึ่งเป็น **พี่น้อง** ของป้ายชื่อ ไม่ใช่อักขระ
// ในข้อความ
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ชมพูนำมาแล้วหลายแบรนด์ในรีโปนี้**
// การเจอชมพูในไฟล์นี้จึงไม่พิสูจน์อะไรเลย ชมพูรอบนี้คือ **#fa539c (R250 G83
// B156)** กับ **#fb8cc0** และพีชคือ **#fdc6c3 / #ffd1cd** ซึ่งวัดจาก logo.webp
// และสไลด์ของดรอปนี้เอง หมึกชมพูคือ **#c2185b / #8e0f41**
// ⚠️⚠️ ชุดที่ต้องไม่เหลือ: **f5469f ff8dc6 8c0f52** (มีโชค168 — **f5469f ห่างจาก
// #fa539c แค่ R5/G13/B3** และ **8c0f52 ห่างจาก #8e0f41 แค่ R2/B17**) ·
// **fa63b9 ffb3de** (ถอนชัวร์168 — **fa63b9 มี R=fa ตรงกัน**) · **dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5** (มีทรัพย์168 — **a4186b มี 18 กลางค่าเหมือน
// #c2185b**) · ff2e52 e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) ·
// fa0513 ff5a5f ffadaf (สมหวัง168) · b3121b f2bba5 (ขวัญใจ168) · **fce2d4 fcd4c3
// f5e7c8** (หวยคิง — ⚠️ ใกล้ #fdc6c3) · ff3fa4 ffd1ea (FAH999)
// ⚠️⚠️ **สล็อต168 คือแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด** (แดงเจล + มุกอุ่นบน
// ดำอมแดง): fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e
// 140000 0b0000 1c0607 2a0c0d 551c1e
// ไฟล์นี้เพิ่งค้างชุด **ฟ้าไซยาน-ครีมอุ่นบนฟ้าเพอริวิงเคิล ของ ร่ำรวย168** ไว้
// ทั้งใบ (18a5e2 0d6b9b a9d7f2 f4e4d3 e4cbb3 eef4ff dce9fb dbe6ff 111a3f 16294a
// กับ rgba 24,165,226 และ rgba 244,228,211) ก่อนนั้นเป็นชุดของ เงินทอง168
// (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906) พักยก168
// (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6 291d0f) และ สบาย168 — ออกครบ
// ทุกค่าแล้ว รวมถึง รวยแท้168 (c30303 8f0505 e81313 dcb95f b8862b 96681f) สาธุ168
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63) และ CEO66 (020617 7e22ce d946ef
// f5d0fe a855f7)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองทุกเฉด ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีครีม/เบจ/น้ำตาล
// ไม่มีม่วง ไม่มีเขียว (ยกเว้น LINE green กับเขียว success ที่อื่น) ไม่มีโรสโกลด์
// ไม่มีส้ม และไม่มีแรมป์เทาเงิน**
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ต่างจากครีม/งาช้าง (R>G>B) และ
// จากขาวอมฟ้า (B>G>R) ของรอบก่อน ๆ — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
//
// The block is its own top-level container (max width + gutter): under a docx H2
// it renders as a sibling of the ContentBox holding that heading, not inside its
// slot, because a ContentBox* slot takes exactly one element and no wrapper
// <div> may be re-added inside one.
---

<div class="relative z-10 mx-auto mb-8 flex w-full max-w-[1400px] flex-col gap-5 px-4 font-sans">
  {
    items.map((item) => {
      const isPink = (item.accent ?? "pink") === "pink";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#f7bcd9] bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:bg-[#fff0f8] sm:flex-row ${
            isPink ? "hover:border-[#fa539c] hover:shadow-[0_10px_20px_rgba(250,83,156,0.26)]" : "hover:border-[#fb8cc0] hover:shadow-[0_10px_20px_rgba(253,198,195,0.9)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isPink
                ? "border border-[#fa539c] bg-gradient-to-br from-[#fdc6c3] to-[#fa539c] text-[#3b0b26] shadow-[0_0_15px_rgba(250,83,156,0.35)] group-hover:rotate-3"
                : "border border-[#fb8cc0] bg-gradient-to-br from-[#ffd1cd] to-[#fb8cc0] text-[#3b0b26] shadow-[0_0_15px_rgba(253,198,195,0.9)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag class="text-xl font-black tracking-wide text-[#c2185b]">{item.title}</TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#3b0b26]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
