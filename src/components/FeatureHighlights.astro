---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isBright = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#122008] bg-[#07100a]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isBright
              ? "hover:border-[#a4e254]/50 hover:bg-[#0a1207] hover:shadow-[0_10px_20px_rgba(164,226,84,0.16)]"
              : "hover:border-[#55aa25]/60 hover:bg-[#0a1207] hover:shadow-[0_10px_20px_rgba(85,170,37,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isBright
                ? "border border-[#a4e254]/50 bg-gradient-to-br from-[#a4e254] to-[#3fa316] shadow-[0_0_15px_rgba(164,226,84,0.5)] text-white group-hover:rotate-3"
                : "border border-[#55aa25]/60 bg-gradient-to-br from-[#55aa25] to-[#2f6b0f] shadow-[0_0_15px_rgba(85,170,37,0.45)] text-[#dfeacf]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isBright
                  ? "bg-gradient-to-r from-[#a4e254] to-[#3fa316] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#dfeacf] to-[#55aa25] bg-clip-text text-transparent transition-colors group-hover:text-[#dfeacf]"
              }`}>
              {item.title}
            </TitleTag>
            <p class="text-sm leading-relaxed text-[#dfeacf]/75 transition-colors group-hover:text-[#dfeacf]/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
