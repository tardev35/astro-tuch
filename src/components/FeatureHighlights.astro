---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4a0b8f]/50 bg-[#150726]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#9d16f1]/50 hover:bg-[#1c0b33] hover:shadow-[0_10px_20px_rgba(157,22,241,0.18)]"
              : "hover:border-[#c3b2d4]/50 hover:bg-[#06020e] hover:shadow-[0_10px_20px_rgba(232,230,238,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#9d16f1]/50 bg-gradient-to-br from-[#c47bff] to-[#7a0fc4] text-[#06020e] shadow-[0_0_15px_rgba(157,22,241,0.45)] group-hover:rotate-3"
                : "border border-[#c3b2d4]/60 bg-gradient-to-br from-[#e8e6ee] to-[#c3b2d4] text-[#06020e] shadow-[0_0_15px_rgba(232,230,238,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#e0b7ff] to-[#9d16f1] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e8e6ee] to-[#a892bd] bg-clip-text text-transparent transition-colors group-hover:text-[#e8e6ee]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#ece0fb]/75 transition-colors group-hover:text-[#ece0fb]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
