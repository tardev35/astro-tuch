---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#0a1207] bg-[#0a1207]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#22c55e]/50 hover:bg-[#04120a] hover:shadow-[0_10px_20px_rgba(34,197,94,0.16)]"
              : "hover:border-[#ec4899]/50 hover:bg-[#16050f] hover:shadow-[0_10px_20px_rgba(236,72,153,0.18)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#4ade80]/50 bg-gradient-to-br from-[#bbf7d0] to-[#4ade80] shadow-[0_0_15px_rgba(74,222,128,0.5)] text-[#04120a] group-hover:rotate-3"
                : "border border-[#f9a8d4]/60 bg-gradient-to-br from-[#fbcfe8] to-[#f472b6] shadow-[0_0_15px_rgba(244,114,182,0.4)] text-[#4a0a29]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-[#bbf7d0] to-[#4ade80] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e9f7e6] to-[#f9a8d4] bg-clip-text text-transparent transition-colors group-hover:text-[#e9f7e6]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && (
              <p class="text-sm leading-relaxed text-[#e9f7e6]/75 transition-colors group-hover:text-[#e9f7e6]/95">{item.description}</p>
            )}
          </div>
        </div>
      );
    })
  }
</div>
