---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  /** "red" is the brand accent, "silver" the chrome tone. The older
   *  "gold"/"blue" spellings stay accepted so an inventory page that still
   *  passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "red" | "silver" | "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#2c0507] bg-[#1a0304]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#e01020]/50 hover:bg-[#260406] hover:shadow-[0_10px_20px_rgba(224,16,32,0.18)]"
              : "hover:border-[#cbd0d8]/50 hover:bg-[#17181c] hover:shadow-[0_10px_20px_rgba(203,208,216,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#e01020]/50 bg-gradient-to-br from-[#ff5a63] to-[#e01020] text-[#1a0304] shadow-[0_0_15px_rgba(224,16,32,0.45)] group-hover:rotate-3"
                : "border border-[#cbd0d8]/60 bg-gradient-to-br from-[#f4eff0] to-[#cbd0d8] text-[#1a0304] shadow-[0_0_15px_rgba(203,208,216,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#ff5a63] to-[#e01020] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e0d7d8] to-[#8f959f] bg-clip-text text-transparent transition-colors group-hover:text-[#e0d7d8]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#e0d7d8]/75 transition-colors group-hover:text-[#e0d7d8]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
