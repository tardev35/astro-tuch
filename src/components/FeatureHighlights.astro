---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the secondary tone (this brand's
   *  red). The older "green"/"red"/"blue" spellings stay accepted so an
   *  inventory page that still passes them keeps building; "blue" maps to the
   *  secondary tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#5e0505]/75 bg-[#120404]/85 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#fdd121]/65 hover:bg-[#1c0606] hover:shadow-[0_10px_20px_rgba(253,209,33,0.2)]"
              : "hover:border-[#ff2a36]/60 hover:bg-[#1c0606] hover:shadow-[0_10px_20px_rgba(239,22,34,0.2)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#fdd121]/55 bg-gradient-to-br from-[#ffe98a] to-[#c99a10] text-[#070202] shadow-[0_0_15px_rgba(253,209,33,0.45)] group-hover:rotate-3"
                : "border border-[#ff2a36]/55 bg-gradient-to-br from-[#ff2a36] to-[#b00a12] text-[#f2e3c9] shadow-[0_0_15px_rgba(239,22,34,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent ? "bg-gradient-to-r from-[#ffe98a] to-[#fdd121] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#ffe98a] to-[#ff2a36] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-left text-base leading-relaxed text-[#f2e3c9]">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
