---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isBright = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#0a1f12] bg-[#0a1f12]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isBright
              ? "hover:border-[#fbbf24]/50 hover:bg-[#04120a] hover:shadow-[0_10px_20px_rgba(251,191,36,0.16)]"
              : "hover:border-[#22c55e]/60 hover:bg-[#04120a] hover:shadow-[0_10px_20px_rgba(34,197,94,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isBright
                ? "border border-[#fbbf24]/50 bg-gradient-to-br from-[#fde68a] to-[#fbbf24] shadow-[0_0_15px_rgba(251,191,36,0.5)] text-[#04120a] group-hover:rotate-3"
                : "border border-[#22c55e]/60 bg-gradient-to-br from-[#4ade80] to-[#16a34a] shadow-[0_0_15px_rgba(34,197,94,0.45)] text-[#e9f7e6]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isBright
                  ? "bg-gradient-to-r from-[#fde68a] to-[#fbbf24] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#e9f7e6] to-[#4ade80] bg-clip-text text-transparent transition-colors group-hover:text-[#e9f7e6]"
              }`}>
              {item.title}
            </TitleTag>
            <p class="text-sm leading-relaxed text-[#e9f7e6]/75 transition-colors group-hover:text-[#e9f7e6]/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
