---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isBright = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#2a1c0a] bg-[#120d06]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isBright
              ? "hover:border-[#ebbc4c]/50 hover:bg-[#1c140a] hover:shadow-[0_10px_20px_rgba(235,188,76,0.16)]"
              : "hover:border-[#9a6d25]/60 hover:bg-[#1c140a] hover:shadow-[0_10px_20px_rgba(154,109,37,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isBright
                ? "border border-[#fcf3ab]/50 bg-gradient-to-br from-[#fcf3ab] to-[#ebbc4c] shadow-[0_0_15px_rgba(235,188,76,0.5)] text-[#241705] group-hover:rotate-3"
                : "border border-[#9a6d25]/60 bg-gradient-to-br from-[#9a6d25] to-[#744b1b] shadow-[0_0_15px_rgba(154,109,37,0.45)] text-[#f0e6c8]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isBright
                  ? "bg-gradient-to-r from-[#fcf3ab] to-[#ebbc4c] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#ebbc4c] to-[#9a6d25] bg-clip-text text-transparent transition-colors group-hover:text-[#ebbc4c]"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-[#f0e6c8]/75 transition-colors group-hover:text-[#f0e6c8]/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
