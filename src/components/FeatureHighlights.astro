---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#1c1509] bg-[#0d0b06]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f5c518]/50 hover:bg-[#171208] hover:shadow-[0_10px_20px_rgba(245,197,24,0.18)]"
              : "hover:border-[#d3d3d3]/50 hover:bg-[#15150f] hover:shadow-[0_10px_20px_rgba(211,211,211,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#f5c518]/50 bg-gradient-to-br from-[#fff2c3] to-[#f5c518] shadow-[0_0_15px_rgba(245,197,24,0.45)] text-[#2b1c05] group-hover:rotate-3"
                : "border border-[#d3d3d3]/60 bg-gradient-to-br from-[#f1f1f1] to-[#d3d3d3] shadow-[0_0_15px_rgba(211,211,211,0.35)] text-[#1a1a1a]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-[#fff2c3] to-[#f5c518] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#f2e6cd] to-[#d3d3d3] bg-clip-text text-transparent transition-colors group-hover:text-[#f2e6cd]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && (
              <p class="text-sm leading-relaxed text-[#f2e6cd]/75 transition-colors group-hover:text-[#f2e6cd]/95">{item.description}</p>
            )}
          </div>
        </div>
      );
    })
  }
</div>
