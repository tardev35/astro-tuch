---
export interface FeatureItem {
  icon: string;
  title: string;
  description?: string;
  /** "gold" is the brand accent, "silver" the chrome tone. The older
   *  "green"/"red"/"blue" spellings stay accepted so an inventory page that
   *  still passes them keeps building; "blue" maps to the chrome tone. */
  accent?: "gold" | "silver" | "green" | "red" | "blue";
}

export interface Props {
  items: FeatureItem[];
  /** Set false when these items are chrome/UI (not docx sub-points of a real
   *  heading above them) — renders the title as a <p> instead of an <h3>, so
   *  a non-article widget never emits a heading tag with no docx backing. */
  heading?: boolean;
}

const { items, heading = true } = Astro.props;
const TitleTag = heading ? "h3" : "p";
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isAccent = item.accent !== "silver" && item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#8a6320]/50 bg-[#131009]/75 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isAccent
              ? "hover:border-[#e6b74e]/50 hover:bg-[#1c170d] hover:shadow-[0_10px_20px_rgba(230,183,78,0.18)]"
              : "hover:border-[#c8cfd8]/50 hover:bg-[#050505] hover:shadow-[0_10px_20px_rgba(200,207,216,0.14)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isAccent
                ? "border border-[#e6b74e]/50 bg-gradient-to-br from-[#f6dfa4] to-[#8a6320] text-[#050505] shadow-[0_0_15px_rgba(230,183,78,0.45)] group-hover:rotate-3"
                : "border border-[#8f9aa6]/60 bg-gradient-to-br from-[#eef2f6] to-[#c8cfd8] text-[#050505] shadow-[0_0_15px_rgba(200,207,216,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <TitleTag
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isAccent
                  ? "bg-gradient-to-r from-[#f6dfa4] to-[#e6b74e] bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-[#c8cfd8] to-[#8f9aa6] bg-clip-text text-transparent transition-colors group-hover:text-[#c8cfd8]"
              }`}>
              {item.title}
            </TitleTag>
            {item.description && <p class="text-sm leading-relaxed text-[#ece3d1]/75 transition-colors group-hover:text-[#ece3d1]/95">{item.description}</p>}
          </div>
        </div>
      );
    })
  }
</div>
