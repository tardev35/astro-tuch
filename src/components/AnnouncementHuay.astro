---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบนี้ (รวย168 2026-10-23) ไฟล์นี้คือ **ticker หลักของทั้งเว็บ** ตามการหมุน
// variant (AnnouncementPremium -> AnnouncementHuay) — ทุกหน้าที่มี ticker เรียก
// ไฟล์นี้: index, /promotion, /about-us, /contact-us, /ทางเข้า, /ทดลองเล่น,
// /login, /register, /ตรวจหวย, /แนวทาง
// ⚠️ ต่างจากรอบก่อนที่ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น — รอบนี้แบรนด์เอง
// เป็นเว็บหวย ชุด *Huay จึงขึ้นมาเป็นธีมหลักทั้งเว็บ ไม่ใช่ซับธีมอีกต่อไป
//
// เกือบทุกหน้าเรียก <Announcement /> แบบไม่ส่ง prop ข้อความที่วิ่งจริงจึงเป็น default
// ตัวนี้ — ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ชื่อแบรนด์มาจาก BRAND_NAME ไม่พิมพ์ทับ
// และ **ห้ามมี emoji ในสตริงนี้** เพราะ emoji ที่ฝังอยู่ใน text prop ใส่ aria-hidden
// ให้ไม่ได้ และ marquee ตัวนี้พิมพ์ข้อความซ้ำสองรอบ screen reader จะอ่าน emoji ซ้ำ
// ตามจำนวนรอบ glyph ตกแต่งอยู่ในมาร์กอัปรอบนอกที่มี aria-hidden
//
// ticker เป็น chrome จึงไม่มี heading tag ทุกระดับ
//
// คำทุกคำมาจาก src/assets/content.txt เท่านั้น (brand-spec §5 คลังคำของรอบนี้ —
// **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน**) ห้ามมีชื่อธนาคาร
// ห้ามมีชื่อค่ายเกม ห้ามมีเวลาเปิด-ปิดรับเป็นตัวเลข ห้ามมียอดขั้นต่ำ — บรีฟไม่ได้
// ให้ไว้ ตัวเลขที่ใช้ได้มีแค่ บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 · 0.3% ·
// 0.8% · 24ชม.
// ⚠️⚠️ **"หวยลาวพัฒนา" / "หวยหุ้นต่างประเทศ" / "หวยหุ้น" / "ระบบจริงจากเว็บแม่" /
// "ไม่มีประวัติโกง" ไม่มีในบรีฟรอบนี้** (เป็นคำของเจ้าของไฟล์เดิม) ถอดออกแล้ว
// ⚠️ และคำของ **มาดาม168 รอบก่อน** ก็ห้ามเช่นกัน: เกมสล็อตเปย์แรง · เปย์แรง ·
// จ่ายไม่มีอั้น · ไม่อั้น · แจกโบนัสสมาชิกทุกวัน · เว็บสล็อต · สล็อตออนไลน์
// คำเฮดจ์ของบรีฟเอง (ควรตรวจสอบรอบปิดรับ อัตราจ่าย และเงื่อนไขจากประกาศล่าสุด)
// ติดมาด้วยโดยตั้งใจ เพราะบรีฟรอบนี้โฆษณาและกำกับความเสี่ยงในย่อหน้าเดียวกัน
//
// พาเลตรอบนี้ (brand-spec §2 — โซน "โครม" = พื้นผิวการ์ดมืด ตัวอักษรสว่าง):
//   แคปซูลพื้น #121110 (ผิวการ์ด) ขอบทอง #e3a712
//   ป้าย "ประกาศ" ไล่เฉดทอง #ffd94a -> #e3a712 -> #b07d08 บนหมึกดำ #0a0a0a
//     (14.6 / 9.2 / 5.4 ตามลำดับ — ผ่านทุกสต็อป คือ CTA ทองมาตรฐานของ §2)
//   เนื้อความ ticker #f3ece0 (16.0:1 บน #121110) จุดนำหน้าเป็นทอง #ffd94a
//     กับโครเมียมเงิน #e8eaee (จุดเป็นวงกลมตกแต่ง ไม่ใช่ตัวอักษร)
//   glow/เงาใช้ rgba(227,167,18,*) กับ rgba(0,0,0,*) เท่านั้น
// ⚠️⚠️ **หมึกขาวบนพื้นทองได้แค่ ~1.2:1 — ป้าย "ประกาศ" จึงเป็นหมึกดำบนทองเสมอ
// ห้ามกลับด้าน** และ **ห้ามใช้ #9d6f06 เป็น stop ล่าง** (ได้ 4.5:1 กับหมึกดำ)
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองของรอบนี้เป็นทองน้ำผึ้งอิ่มสี**
// ชุดเขียวมรกต-ทองสัมฤทธิ์อมเขียวของ สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c
// c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) · ชุดทองโบราณบนแดงเลือดหมูของ รวยแท้168
// ซึ่งเป็นเจ้าของไฟล์นี้รอบล่าสุด (461212 280b0b b8862b dcb95f c99a3f ffeee8
// 96681f rgba 74/15/15 a · rgba 184/134/43 a) · ชุดทองส้มบนดำอมน้ำตาลของ หวยคิง
// (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · ชุดชมพู
// บานเย็นของ มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) · และชุด
// แดงคริมสัน+น้ำเงินอะซัวร์ของ **มาดาม168 รอบก่อนทันที** (ff2e52 e01238 c9102f
// 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9)
// ออกครบทุกค่าแล้ว ไม่เหลือค่าไหน
// ⚠️⚠️ ffd84d ของ ถอนชัวร์168 ห่างจาก #ffd94a ของรอบนี้แค่ G1 — เจอที่ไหนแปลว่า
// พิมพ์ผิด ไม่ใช่ค่าของรอบนี้
// (เฮกซ์ของแบรนด์เก่าเขียนแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์นี้)
const {
  message = `${BRAND_NAME} แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท เปิดรับหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 พร้อมโปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ควรตรวจสอบรอบปิดรับ อัตราจ่าย และเงื่อนไขจากประกาศล่าสุดก่อนยืนยันบิลทุกครั้ง ติดต่อแอดมิน 24ชม.`,
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#e3a712]/60 bg-[#121110]/95 shadow-[0_5px_15px_rgba(0,0,0,0.75)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#ffd94a] via-[#e3a712] to-[#b07d08] px-6 py-2.5 font-black text-[#0a0a0a] shadow-[4px_0_15px_rgba(0,0,0,0.75)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#121110] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f3ece0]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffd94a] shadow-[0_0_8px_rgba(227,167,18,0.85)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#e8eaee] shadow-[0_0_8px_rgba(227,167,18,0.85)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
