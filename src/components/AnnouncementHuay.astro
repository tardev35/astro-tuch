---
// /ตรวจหวย and /แนวทาง both pass an explicit `message` — that is the copy that
// actually renders. This default is the same brand's copy kept in step, so a
// bare <Announcement /> can never fall back to a previous brand's slogan; if you
// rebrand, update all three together.
// No emoji in it: an emoji baked into a text prop cannot be given its own
// aria-hidden span, and this marquee prints the string twice.
const {
  message = "KINDEE365 เปิดรับแทงหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ ตามรอบที่เปิดบริการ อัตราจ่ายที่กำหนดไว้คือเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 ควรตรวจสอบตัวเลขที่ระบบแสดงจริงก่อนยืนยันโพยทุกครั้ง เลือกประเภทหวย ส่งโพย และเช็กประวัติรายการได้เองจากบัญชีสมาชิก ฝากถอนระบบออโต้รองรับทั้งธนาคารและวอลเลทตามช่องทางที่เปิดให้บริการ เจ้าหน้าที่ KINDEE365 รับเรื่องตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#c1121f]/55 bg-[#511014]/85 shadow-[0_5px_15px_rgba(26,4,5,0.55)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#8a6a26] via-[#e3c56a] to-[#8a6a26] px-6 py-2.5 font-black text-[#1a0405] shadow-[4px_0_15px_rgba(26,4,5,0.55)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#511014] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f4e7d3]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#e3c56a] shadow-[0_0_8px_rgba(227,197,106,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#2a9d5c] shadow-[0_0_8px_rgba(42,157,92,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
