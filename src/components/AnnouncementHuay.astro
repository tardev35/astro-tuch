---
const { message = "7LOTTO เว็บแทงหวยครบทุกประเภท หวยรัฐบาลไทย หวยออมสิน หวย ธ.ก.ส. หวยลาว หวยฮานอย หวยหุ้น เรท 2 ตัว 100 3 ตัว 1,000 ปล่อยยอดทันที" } = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-full border border-[#a3060c]/45 bg-[#150406]/85 shadow-[0_5px_15px_rgba(0,0,0,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#8f0104] via-[#ff2a30] to-[#8f0104] px-6 py-2.5 font-black text-white shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#150406] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#d8dae0]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#ff2a30] shadow-[0_0_8px_rgba(255,42,48,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#ff2a30] shadow-[0_0_8px_rgba(255,42,48,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: var(--font-sans);
  }
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
