---
// /ตรวจหวย and /แนวทาง both pass an explicit `message` — that is the copy that
// actually renders. This default is the same brand's copy kept in step, so a
// bare <Announcement /> can never fall back to a previous brand's slogan; if you
// rebrand, update all three together.
// No emoji in it: an emoji baked into a text prop cannot be given its own
// aria-hidden span, and this marquee prints the string twice.
const {
  message = "หวยพยัคฆ์ รวมรายการแทงหวยหลายประเภทไว้ในระบบเดียว ทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ เลือกดูรอบที่เปิดรับและตรวจสอบเลขที่ต้องการได้จากหน้าเดียว อัตราจ่ายเลข 2 ตัวอยู่ที่ 100 และเลข 3 ตัวอยู่ที่ 1,000 ตามเงื่อนไขของแต่ละรายการ ควรตรวจสอบรอบหวย ประเภทบิล และรายละเอียดของรายการก่อนยืนยันทุกครั้ง สมัครสมาชิกทำเองได้ผ่านหน้าเว็บไซต์ใน 3 ขั้นตอน กรอกข้อมูล ตรวจสอบความถูกต้อง แล้วยืนยันบัญชีเพื่อเข้าสู่ระบบ แอดมินหวยพยัคฆ์ ดูแลผ่าน Line Official ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#ab6d13]/60 bg-[#08152f]/90 shadow-[0_5px_15px_rgba(3,11,28,0.7)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#ab6d13] via-[#fadb6c] to-[#ab6d13] px-6 py-2.5 font-black text-[#030b1c] shadow-[4px_0_15px_rgba(3,11,28,0.7)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#08152f] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#dbe4f7]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#fadb6c] shadow-[0_0_8px_rgba(250,219,108,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#e8eef8] shadow-[0_0_8px_rgba(232,238,248,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
