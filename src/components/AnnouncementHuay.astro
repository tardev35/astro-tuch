---
// /ตรวจหวย and /แนวทาง both pass an explicit `message` — that is the copy that
// actually renders. This default is the same brand's copy kept in step, so a
// bare <Announcement /> can never fall back to a previous brand's slogan; if you
// rebrand, update all three together.
// No emoji in it: an emoji baked into a text prop cannot be given its own
// aria-hidden span, and this marquee prints the string twice.
const {
  message = "MHEEPOOH168 เว็บรวมคาสิโนเกม เปิดหมวดหวยไว้ในระบบเดียวกับบาคาร่า สล็อต และบอล สลับรูปแบบการเล่นได้จากบัญชีเดียว ไม่ต้องเปลี่ยนหลายเว็บไซต์ ระบบจัดหมวดหมู่ชัดเจน พร้อมตัวเลือกจากหลายค่ายและหลายตลาดตามรอบที่เปิดบริการ ควรตรวจสอบอัตราจ่ายและรายการที่เปิดให้ใช้งานจริงในระบบก่อนยืนยันทุกครั้ง โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตรวจสอบรอบคำนวณและขั้นตอนรับสิทธิ์ได้จากหน้าโปรโมชั่น รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ ตรวจสอบสถานะรายการผ่านบัญชีสมาชิกได้ด้วยตนเอง แอดมิน MHEEPOOH168 ดูแลผ่าน Line Official ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#c21e22]/55 bg-[#1c0d0f]/90 shadow-[0_5px_15px_rgba(0,0,0,0.55)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#7d1114] via-[#c21e22] to-[#7d1114] px-6 py-2.5 font-black text-[#ffe9ea] shadow-[4px_0_15px_rgba(0,0,0,0.55)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1c0d0f] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#ded9da]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#ff8a8d] shadow-[0_0_8px_rgba(255,138,141,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#c21e22] shadow-[0_0_8px_rgba(194,30,34,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
