---
const { message = "LOTTO42 รับหวยเลขอั้นทั้ง 2 ตัว 3 ตัว รับยอดแทงตามเงื่อนไขของแต่ละรอบ เรทจ่ายสูงสุด 1,000 ตามประเภทหวย ตรวจโพยผ่านมือถือ ฝากถอนอัตโนมัติ แอดมินดูแลตลอด 24 ชั่วโมง" } = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#7c0207]/45 bg-[#2a0508]/85 shadow-[0_5px_15px_rgba(0,0,0,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#5a0104] via-[#e8121d] to-[#5a0104] px-6 py-2.5 font-black text-white shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#2a0508] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#dfe3ea]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#e8121d] shadow-[0_0_8px_rgba(232,18,29,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#e8121d] shadow-[0_0_8px_rgba(232,18,29,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
