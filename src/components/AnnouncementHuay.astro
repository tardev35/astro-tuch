---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบ หวย365 (2026-10-03) ไฟล์นี้เป็น ticker ของ **ทั้งเว็บ** ไม่ใช่เฉพาะสองหน้าหวย
// อีกต่อไป — แบรนด์รอบนี้เป็นเว็บแทงหวยล้วน ธีม Huay แดง-ทองจึงเป็นธีมของแบรนด์เอง
// ไม่ใช่ข้อยกเว้นเฉพาะหมวด ทุกหน้าใน src/pages/ import ตัวนี้ตัวเดียวกัน ticker
// จึงพูดเหมือนกันหมดทั้งไซต์ (SKILL.md Phase 4.5 ข้อ 3)
//
// ทุกหน้าเรียก <Announcement /> แบบไม่ส่ง prop ข้อความที่วิ่งจริงจึงเป็น
// default ตัวนี้ — ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ชื่อแบรนด์จึงมาจาก BRAND_NAME
// ไม่พิมพ์ทับ No emoji in the message: an emoji baked into a text prop cannot be
// given its own aria-hidden span, and this marquee prints the string twice.
//
// เนื้อหาทุกท่อนมาจาก src/assets/content.txt เท่านั้น — เว็บหวยล้วน ไม่มีใบอนุญาต
// ไม่มีชื่อธนาคาร ไม่มียอดฝากขั้นต่ำ และไม่มีตัวเลขนอกชุดที่บรีฟระบุ
// (2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง)
// ชุดรายการของบรีฟรอบนี้คือ รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หวยหุ้นต่างประเทศ และมุม
// ของบรีฟคือ แนวทางหวย/กลุ่มหวย/สถิติหวยย้อนหลัง/ผลหวยตามรอบ มุมของบรีฟรอบก่อน
// (เลขเด็ด/เลขดัง · ไม่จำกัด-แทงได้ไม่อั้น · ฮานอยปกติ/พิเศษ/วีไอพี) ถูกตัดออกหมด
// คำเฮดจ์ที่บรีฟเขียนมาเอง (สถิติไม่รับประกันงวดถัดไป) ติดมาด้วยโดยตั้งใจ
//
// พาเลตต์รอบนี้ (brand-spec §2 แดงสด-ทอง): แคปซูลพื้น #240406 ขอบทองลึก #c08a07
// ป้าย "ประกาศ" ไล่เฉด #c08a07 → #ffeab0 → #c08a07 (ปลายเฉดต้องไม่เข้มกว่า #c08a07
// เพราะหมึกเป็นดำอมแดง #1a0303 ซึ่งได้ 6.4:1 ที่ปลายนี้) จุดนำหน้าข้อความเป็นทอง
// #ffc93c กับแดงแบรนด์ #dc0203 เนื้อความ #f6e7e0 — ชุดเดิมของรอบ หวยเฮง789
// (#2b0909 #a8690c #d99a10 #ffefc2 #f4bc5d #dc2224 #fbe3d4 #1c0606) ออกครบแล้ว
const {
  message = `${BRAND_NAME} รวมแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว ครบทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ สมาชิกตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง อัตราจ่ายของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่งอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน จึงควรยึดอัตราที่แสดงในหน้าส่งโพยก่อนยืนยันทุกครั้ง สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบสำหรับย้อนดูผลรอบที่ผ่านมา ไม่สามารถรับประกันเลขที่จะออกในงวดถัดไปได้ สมัครผ่านมือถือง่ายๆ 3 ขั้นตอน และติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#c08a07]/60 bg-[#240406]/90 shadow-[0_5px_15px_rgba(8,1,1,0.7)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#c08a07] via-[#ffeab0] to-[#c08a07] px-6 py-2.5 font-black text-[#1a0303] shadow-[4px_0_15px_rgba(8,1,1,0.7)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#240406] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f6e7e0]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffc93c] shadow-[0_0_8px_rgba(255,201,60,0.8)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#dc0203] shadow-[0_0_8px_rgba(220,2,3,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
