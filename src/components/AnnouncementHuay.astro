---
import { BRAND_NAME } from "../lib/brandProfile";

// รอบ หวยคิง (2026-10-04) ไฟล์นี้เป็น ticker ของ **ทั้งเว็บ** ไม่ใช่เฉพาะสองหน้าหวย
// แบรนด์รอบนี้เป็นเว็บรับแทงหวยล้วน ธีม Huay จึงเป็นธีมของแบรนด์เอง ไม่ใช่ข้อยกเว้น
// เฉพาะหมวด ทุกหน้าใน src/pages/ import ตัวนี้ตัวเดียวกัน ticker จึงพูดเหมือนกันหมด
// ทั้งไซต์ (SKILL.md Phase 4.5 ข้อ 3)
//
// เกือบทุกหน้าเรียก <Announcement /> แบบไม่ส่ง prop ข้อความที่วิ่งจริงจึงเป็น
// default ตัวนี้ — ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ชื่อแบรนด์มาจาก BRAND_NAME
// ไม่พิมพ์ทับ และ **ห้ามมี emoji ในสตริงนี้** เพราะ emoji ที่ฝังอยู่ใน text prop
// ใส่ aria-hidden ให้ไม่ได้ และ marquee ตัวนี้พิมพ์ข้อความซ้ำสองรอบ screen reader
// จะอ่าน emoji ซ้ำตามจำนวนรอบ glyph ตกแต่งอยู่ในมาร์กอัปรอบนอกที่มี aria-hidden
//
// ticker เป็น chrome จึงไม่มี heading tag ทุกระดับ
//
// คำทุกคำมาจาก src/assets/content.txt เท่านั้น (brand-spec §4 "คำศัพท์ที่ใช้ได้")
// ห้ามมีชื่อตลาดหวย (ฮานอย/ลาวพัฒนา/หวยหุ้น/ยี่กี) ห้ามมีเวลาเปิด-ปิดรับ ห้ามมี
// ชื่อธนาคาร ห้ามมียอดฝากขั้นต่ำ — บรีฟไม่ได้ให้ไว้ ตัวเลขที่ใช้ได้มีแค่
// 100 / 1,000 / 2 ตัว / 3 ตัว / 3 ขั้นตอน / 24 ชั่วโมง
// คำเฮดจ์ของบรีฟเอง (ยึดอัตราบนหน้าส่งโพยก่อนยืนยัน) ติดมาด้วยโดยตั้งใจ
//
// พาเลตต์รอบนี้ (brand-spec §2 ทองบนดำอมน้ำตาล): แคปซูลพื้น #1c140b ขอบทองแบรนด์
// #cd9a2c ป้าย "ประกาศ" ไล่เฉด #cd9a2c → #fdeb7c → #cd9a2c (ปลายเฉดต้องไม่เข้มกว่า
// #cd9a2c เพราะหมึกเป็นดำอมน้ำตาล #120a02 ซึ่งได้ 7.6:1 ที่ปลายนี้) จุดนำหน้า
// ข้อความเป็นทองสว่าง #fdeb7c กับครีมอมพีช #fcd4c3 เนื้อความ #f5e7c8 glow เป็น
// rgba(205,154,44,*) ชุดแดง-ทองของรอบก่อน (#240406 #c08a07 #ffeab0 #1a0303
// #ffc93c #dc0203 #f6e7e0 rgba(255,201,60,*) rgba(220,2,3,*)) ออกครบแล้ว
const {
  message = `${BRAND_NAME} รับแทงหวย เลขเด็ด เลขดัง อัตราจ่าย 2 ตัวจ่าย 100 บาท และ 3 ตัวจ่าย 1,000 บาท ตรวจอัตราจ่ายและวงเงินรับแทงบนหน้าส่งโพยก่อนยืนยันทุกครั้ง สมัคร 3 ขั้นตอน ติดต่อแอดมิน 24 ชั่วโมง`,
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#cd9a2c]/60 bg-[#1c140b]/90 shadow-[0_5px_15px_rgba(12,11,10,0.75)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#cd9a2c] via-[#fdeb7c] to-[#cd9a2c] px-6 py-2.5 font-black text-[#120a02] shadow-[4px_0_15px_rgba(12,11,10,0.75)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1c140b] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f5e7c8]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#fdeb7c] shadow-[0_0_8px_rgba(205,154,44,0.85)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#fcd4c3] shadow-[0_0_8px_rgba(205,154,44,0.85)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
