---
import { BRAND_NAME } from "../lib/brandProfile";

// Ticker for the two lottery sub-sections (/ตรวจหวย และ /แนวทาง) ซึ่งคงธีม Huay
// แดง-ทองของตัวเองไว้ตามข้อยกเว้นใน SKILL.md Phase 4.5 ข้อ 5 — หน้าอื่นของเว็บ
// ใช้ Announcement3 บนพาเลตต์เขียว-ทองของแบรนด์ ไฟล์นี้จึง "ไม่ต้อง" ตามพาเลตต์
// §2 แต่ต้องไม่มีชื่อแบรนด์เก่าและไม่มีคำนอกหมวดหวยเหลืออยู่
//
// ทั้งสองหน้าเรียก <Announcement /> แบบไม่ส่ง prop ข้อความที่วิ่งจริงจึงเป็น
// default ตัวนี้ — ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ชื่อแบรนด์จึงมาจาก BRAND_NAME
// ไม่พิมพ์ทับ No emoji in it: an emoji baked into a text prop cannot be given
// its own aria-hidden span, and this marquee prints the string twice.
//
// เนื้อหาทุกท่อนมาจาก src/assets/content.txt เท่านั้น — เว็บหวยล้วน ไม่มีใบอนุญาต
// ไม่มีชื่อธนาคาร ไม่มียอดฝากขั้นต่ำ และไม่มีตัวเลขนอกชุดที่บรีฟระบุ
// (2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท · 3 ขั้นตอน · 24 ชั่วโมง)
// รอบก่อนมี "โบนัสคืนยอดเสีย 0.3% / แนะนำเพื่อน 0.8% / ฝากเข้าบัญชีบริษัทโดยตรง"
// ของแบรนด์เก่าค้างอยู่ในสตริงนี้ ซึ่งบรีฟรอบนี้ไม่ได้ระบุ จึงถูกถอดออกทั้งชุด
//
// พาเลตต์ Huay แดง-ทอง-ดำ: แคปซูลพื้นดำอมแดง #1f0a0c ขอบทองลึก #8a6a0a ป้าย
// "ประกาศ" ไล่เฉดทองสว่าง #e0a808 → #fde79a → #e0a808 (ต้องสว่างทั้งเส้นเพราะ
// หมึกเป็นดำอมแดง #1a0203 — ทองลึกให้แค่ 3.8:1 ซึ่งตก) จุดนำหน้าข้อความเป็น
// ทองรอง #f3c623 กับแดง #dc020e เนื้อความ #f0e2e2
const {
  message = `${BRAND_NAME} เว็บแทงหวยออนไลน์ รวมรายการหวยยอดนิยมไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศ เลือกเลข ส่งโพย ตรวจสอบรายการ และดูผลรางวัลตามรอบที่เปิดให้บริการได้จากหน้าเว็บไซต์บนมือถือ อัตราจ่ายของรายการที่ร่วมเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ตามประเภทหวยและรูปแบบการเดิมพันที่ระบบกำหนด ควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยก่อนยืนยันทุกครั้ง เพราะหวยแต่ละประเภทมีตารางเวลาและเงื่อนไขแตกต่างกัน สมัครผ่านมือถือได้ง่ายๆ 3 ขั้นตอน และติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#8a6a0a]/60 bg-[#1f0a0c]/90 shadow-[0_5px_15px_rgba(5,1,2,0.7)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#e0a808] via-[#fde79a] to-[#e0a808] px-6 py-2.5 font-black text-[#1a0203] shadow-[4px_0_15px_rgba(5,1,2,0.7)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1f0a0c] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f0e2e2]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f3c623] shadow-[0_0_8px_rgba(243,198,35,0.8)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#dc020e] shadow-[0_0_8px_rgba(220,2,14,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
