---
// Default is this brand's copy — the หวย pages call <Announcement /> bare, so
// this string has to stay in sync with the explicit `message` index.astro passes.
// No emoji in it: an emoji baked into a text prop cannot be given its own
// aria-hidden span, and this marquee prints the string twice.
const {
  message = "HUAY928 รับแทงหวยออนไลน์ ครบทุกประเภท ครอบคลุมหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น รองรับเลข 2 ตัวและ 3 ตัวตามอัตราจ่ายที่กำหนด เลือกเลข ตรวจเรท และส่งโพยผ่านมือถือได้ด้วยตัวเอง แอดมินดูแลตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3">
  <div class="relative flex overflow-hidden rounded-full border border-[#2c4d84]/45 bg-[#08234c]/85 shadow-[0_5px_15px_rgba(0,0,0,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#a87a1e] via-[#dfb455] to-[#a87a1e] px-6 py-2.5 font-black text-[#01091b] shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#08234c] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#e3edfb]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#dfb455] shadow-[0_0_8px_rgba(223,180,85,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#dfb455] shadow-[0_0_8px_rgba(223,180,85,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
