---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a three-column split is the page's own
   *  layout wording for one docx section, not a docx sub-heading — so they
   *  render as <p> carrying exactly the classes a heading would. Do NOT promote
   *  them back to HeadingTag: they used to be hardcoded <h2>, which put three
   *  phantom entries into the h2 inventory that gets diffed against the docx,
   *  AND hardcoded a level the docx never chose. */
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3ThreePremium so the two siblings
   *  take the same props. Defaults to FALSE — the column labels are chrome on
   *  every brand so far, and the safe default is the one that keeps chrome out
   *  of the heading inventory. A page whose three labels really ARE docx
   *  sub-points passes heading={true}, and only then do they become real
   *  headings at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech when the box is called with no
   *  `title`, since <p> labels leave it with no accessible name. */
  label?: string;
  iconleft?: string;
  iconcenter?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false, iconleft = "🔎", iconcenter = "📝", iconright = "✅" } = Astro.props;

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ";
const hasIntro = Astro.slots.has("default");

// The default slot is the section's INTRO paragraph and sits above the grid at
// full width; the three named slots are the columns. Its wrapper carries a real
// `mb-8` and is a sibling of the grid, so it is layout rather than an
// inheritable-class carrier — it stays, exactly like ContentBoxTwoCyberCut's.
// House rule still holds: ONE element per slot. The columns themselves are
// flattened (each <article> carries the text classes and the slot is a direct
// child) — do not re-add a wrapper <div> inside a column.
//
// รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §7** ("<แบรนด์> มีแอดมินออนไลน์ตลอด 24ชม." —
// content.txt บรรทัด 21) โดยแบ่งย่อหน้าเดียวของบรีฟ (บรรทัด 22) เป็นสามช่วงประโยค
// ลงสามคอลัมน์ ⚠️ บรีฟรอบนี้ **ไม่มี sub-list ใต้หัวข้อไหนเลยนอกจาก §6** หน้าเพจ
// จึงไม่ส่ง titleleft/titlecenter/titleright และไม่ส่ง intro มา — `heading` คงค่า
// false และกล่องนี้ปล่อยหัวข้อออกมาใบเดียว ไอคอนสามใบจึงไม่ถูก render รอบนี้
// (มันอยู่ในป้ายคอลัมน์) โค้ดคงไว้ให้แบรนด์ถัดไป
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// MEXICANOSLOT (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-mexicanoslot.md §2
// **แดงเม็กซิกันนำ · ทอง/พีชฟางเป็นวัสดุที่สอง · เขียวเม็กซิกันแอคเซนต์ · ธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-ครีมบนธีมสว่างของ ร่ำรวย168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมสว่างเหมือนกัน แต่คนละค่าทุกตัว** พื้นเพจ
// #fef6fb (bg.json) = ขาวอมชมพูจาง **ห้ามเหลือฟ้า/ไซแอน/น้ำเงิน และครีมเย็นไว้
// เลยสักค่า** และ **ห้ามแก้การ์ดให้มืดตามโครม** (navbar/footer รอบนี้เป็นผิวเข้ม
// #2b100a แต่ไฟล์นี้เป็นการ์ดเนื้อหา — หมึก #3f130d บนพื้นมืดจะหายไปเลย)
// ลำดับผิว: **#ffffff การ์ด (ใบนี้)** · **#fff3ea ผิวยก (สามคอลัมน์อินเซ็ต)** ·
// #fde4d3 wash · #fef6fb พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่ **หัวข้อคร่อมด้วยเส้นคาดเต็มความกว้าง
// ทั้งบนและล่าง** (border-y) โดยไม่มีขีดสั้นใต้ตัวอักษร และเป็นใบเดียวของหน้าที่
// **คอลัมน์เป็นการ์ดอินเซ็ต #fff3ea ซ้อนอยู่ในการ์ดขาว** ⚠️ §3 (ContentBox ตัวฐาน)
// ใช้หัวข้อชิดซ้าย + ขีดสั้น w-20 และ §4 ใช้เส้นใต้สามสต็อปเต็มคอลัมน์ — สามใบนี้
// จึงไม่อ่านซ้ำกัน
// หัวข้อเป็น **แดงลึก #a81410 ทึบสีเดียว ไม่ไล่เฉด** (7.6:1 บนผิวขาว)
// ⚠️ ไม่ใช้ bg-clip-text ที่นี่โดยตั้งใจ: ไล่เฉดบนพื้นสว่างจะลากค่าที่ §2 ห้ามถือ
// ตัวอักษร (#de2b1e ที่ 4.0:1 บนขาว) เข้ามาเป็นพิกเซลของตัวอักษรได้ง่ายเกินไป
// เส้นคาดบน-ล่างเป็น **พื้นถม ไม่ใช่ตัวอักษร** #f6c4a4 จึงใช้ได้
// ป้ายสามคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็น #a81410 — 7.2:1 บนผิวอินเซ็ต #fff3ea
// และเลขลำดับ/ไอคอนอยู่บน **แผ่นถมทอง** ไล่ #fed7b5 → #f2a033 บนหมึก **#3f130d**
// ซึ่งเป็นสูตร "ปุ่มรอง/ปุ่มเน้นบนผิวสว่าง" ของ §2 (11.1:1 บน #fed7b5 · 6.9:1 บน
// #f2a033) **ห้ามพลิกแผ่นนี้ไปใช้หมึกขาว** (§2 ห้ามขาวบนทองไว้ชัด)
// ออรามุมขวาบนเป็นแดงเม็กซิกัน #de2b1e มุมซ้ายล่างเป็นพีชฟาง #fed7b5 — ทั้งสองชั้น
// เป็น **ออราเบลอใต้ -z-10 ไม่มีตัวอักษรวางทับ** ซึ่งเป็นงานเดียวที่ §2 ยอมให้
// #de2b1e ทำบนพื้นสว่าง เนื้อความ #3f130d (= BRAND_TEXT) — 14.9:1 บนผิวขาว ·
// 14.0:1 บนผิวอินเซ็ต #fff3ea
// ⚠️ §2 ห้าม #fff3ea/#fde4d3/#fef6fb/#f6c4a4/#e2855c/#fed7b5/#fec28d/#f2a033/
// #de2b1e ถือตัวอักษร · **#a81410 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ**
// ไม่ใช่ของไฟล์นี้ · **#f2543f และ #2bb061 เป็นสีของโครมเข้มเท่านั้น**
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — แดง/ชมพูเคยนำมาแล้วหลายแบรนด์ในรีโปนี้
// การเจอแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย แดงรอบนี้คือ **#de2b1e (R222 G43 B30)**
// กับ **#a81410 / #c81e12 / #9d140c / #6f0e08**
// ไฟล์นี้เพิ่งค้างชุด **ฟ้าไซยาน-ครีมธีมสว่างของ ร่ำรวย168** ไว้ทั้งใบ
// (18a5e2 0d6b9b 0a5176 a9d7f2 16294a 111a3f dbe6ff eef4ff dce9fb f4e4d3 e4cbb3)
// ออกครบแล้ว เช่นเดียวกับ **okkub88 (แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด)** (ffd6fa
// fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2 d91a73
// b01160 85094a) **โบ๊ะบ๊ะ168** (00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0f5684
// 1a6ea8 e4f6fb f0faff) **สบาย168** (2cc3fc 6bdcfb 0a7fbd 063a57 9ae0fa fdcb0c
// fefb6b) **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e) **นินจา168** (32bcfb
// a9e9ff fef54b 07335f) **รวยแทร่168** (039cfa 0494f5 c3ebfc f9a826) **TSDET911**
// (0360f3 0292fb 6ec8ff cfdcec 9db4d4) **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4
// d2b9a4 29210f) **พักยก168** (eeae12 fded41 9f600d e0e0df c0c0bf a1a09e f4ead6)
// **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f)
// 🚨 แดงของแบรนด์อื่นที่ต้องเทียบทีละค่า: fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607
// (สล็อต168 — ⚠️⚠️ **fb2e33 ↔ #de2b1e · cb0b0d / b00d11 ↔ #c81e12 / #a81410**) ·
// ff2e52 e01238 c9102f (มาดาม168) · d9212a 8e1a16 f0c878 (ดวงเศรษฐี168) ·
// fb141b ff5f63 (GT66B) · eb0305 b44c06 f0b46a (NavbarStyle4) ·
// fa539c c2185b 8e0f41 fb8cc0 f7bcd9 ffe5ff fff0f8 ffeef7 3b0b26 (หมูบิน168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีครีม/เบจเย็น
// และไม่มีแรมป์เทาเงิน** — ทองรอบนี้คือ **#f2a033 ค่าเดียว** และเขียวคือ **#117a41**
const columnLabel = "flex items-center gap-3 text-lg leading-normal font-black tracking-wide text-[#a81410]";
const stepBadge = "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#e2855c] bg-gradient-to-br from-[#fed7b5] to-[#f2a033] text-base text-[#3f130d] shadow-[0_5px_15px_rgba(242,160,51,0.35)]";
const column = "flex flex-col gap-3 text-left text-base leading-relaxed text-[#3f130d] transition-all hover:-translate-y-1";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c4a4] bg-white p-8 text-[#3f130d] shadow-[0_10px_30px_rgba(63,19,13,0.12)] transition-all duration-500 hover:border-[#de2b1e] hover:shadow-[0_15px_40px_rgba(222,43,30,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-44 w-44 rounded-full bg-[#de2b1e]/22 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-44 w-44 rounded-full bg-[#fed7b5]/70 blur-[60px]"></div>

    {
      title && (
        <header class="mb-6 border-y-2 border-[#f6c4a4] py-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#a81410]">{title}</HeadingTag>
        </header>
      )
    }

    {
      hasIntro && (
        <div class="mb-8 text-left text-base leading-relaxed text-[#3f130d]">
          <slot />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class={`${column} rounded-2xl border border-[#f6c4a4] bg-[#fff3ea] p-6 hover:border-[#de2b1e]`}>
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconleft}
              </span>
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class={`${column} rounded-2xl border border-[#f6c4a4] bg-[#fff3ea] p-6 hover:border-[#de2b1e]`}>
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconcenter}
              </span>
              {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class={`${column} rounded-2xl border border-[#f6c4a4] bg-[#fff3ea] p-6 hover:border-[#de2b1e]`}>
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconright}
              </span>
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
