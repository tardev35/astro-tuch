---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a three-column split is the page's own
   *  layout wording for one docx section, not a docx sub-heading — so they
   *  render as <p> carrying exactly the classes a heading would. Do NOT promote
   *  them back to HeadingTag: they used to be hardcoded <h2>, which put three
   *  phantom entries into the h2 inventory that gets diffed against the docx,
   *  AND hardcoded a level the docx never chose. */
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3ThreePremium so the two siblings
   *  take the same props. Defaults to FALSE — the column labels are chrome on
   *  every brand so far, and the safe default is the one that keeps chrome out
   *  of the heading inventory. A page whose three labels really ARE docx
   *  sub-points passes heading={true}, and only then do they become real
   *  headings at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech when the box is called with no
   *  `title`, since <p> labels leave it with no accessible name. */
  label?: string;
  iconleft?: string;
  iconcenter?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false, iconleft = "🔎", iconcenter = "📝", iconright = "✅" } = Astro.props;

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ";
const hasIntro = Astro.slots.has("default");

// The default slot is the section's INTRO paragraph and sits above the grid at
// full width; the three named slots are the columns. Its wrapper carries a real
// `mb-8` and is a sibling of the grid, so it is layout rather than an
// inheritable-class carrier — it stays, exactly like ContentBoxTwoCyberCut's.
// House rule still holds: ONE element per slot. The columns themselves are
// flattened (each <article> carries the text classes and the slot is a direct
// child) — do not re-add a wrapper <div> inside a column.
//
// รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §2** ("<แบรนด์> สล็อตเดิมพันไม่มีขั้นต่ำ
// ทุนน้อยเล่นได้ ไม่อั้นจ่าย ไม่อั้นถอน" — content.txt บรรทัด 5) โดยแบ่งย่อหน้าเดียว
// ของบรีฟ (บรรทัด 6) เป็นสามช่วงประโยคลงสามคอลัมน์ ⚠️ บรีฟรอบนี้ **ไม่มี sub-list
// ใต้หัวข้อไหนเลยนอกจาก §6** หน้าเพจจึงไม่ส่ง titleleft/titlecenter/titleright และ
// ไม่ส่ง intro มา — `heading` คงค่า false และกล่องนี้ปล่อยหัวข้อออกมาใบเดียว
// ไอคอนสามใบจึงไม่ถูก render รอบนี้ (มันอยู่ในป้ายคอลัมน์) โค้ดคงไว้ให้แบรนด์ถัดไป
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (2026-10-23) — พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง กลับทิศจากรอบก่อน (เงินทอง168) 180 องศา** พื้นเพจ
// #dbe6ff (bg.json) การ์ดเนื้อหาเป็น **ผิวสว่าง + หมึกน้ำเงินเข้ม** ห้ามแก้กลับไป
// เป็นพื้นน้ำตาลเข้มเพราะ "รอบก่อนเป็นแบบนั้น" — โครมรอบนี้ต่างหากที่เป็น
// น้ำเงินอินดิโกเข้ม
// ลำดับผิว: **#ffffff ยก (การ์ดใบนี้)** · #eef4ff กลาง · **#dce9fb อินเซ็ต
// (สามคอลัมน์)** · #f4e4d3 ครีม · #dbe6ff พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่หัวข้อมี **ทั้งเส้นคาดใต้ header และ
// แท่งขีดสั้นใต้ตัวอักษร** และเป็นใบเดียวของหน้าที่ **คอลัมน์เป็นการ์ดอินเซ็ต
// #dce9fb** หัวข้อเป็น **ฟ้าเข้ม #0d6b9b ทึบสีเดียว ไม่ไล่เฉด** (5.6:1 บนผิวขาว)
// ⚠️ ไม่ใช้ bg-clip-text ที่นี่โดยตั้งใจ: ไล่เฉดบนพื้นสว่างจะลากค่าที่ §2 ห้ามถือ
// ตัวอักษร (#18a5e2 ที่ 2.6:1 บนขาว) เข้ามาเป็นพิกเซลของตัวอักษรได้ง่ายเกินไป
// แท่งขีดสั้นและเส้นคาดเป็น **พื้นถม ไม่ใช่ตัวอักษร** #18a5e2 กับ #a9d7f2 จึงใช้ได้
// ป้ายสามคอลัมน์ (ถ้าแบรนด์ถัดไปส่งมา) เป็น #0d6b9b — 5.0:1 บนผิวอินเซ็ต #dce9fb
// และเลขลำดับขั้นตอนอยู่บน **แผ่นถมฟ้า** ไล่ #a9d7f2 → #18a5e2 บนหมึก **#111a3f**
// ซึ่งเป็นสูตร "ปุ่มเน้น (สว่าง)" ของ §2 ตรงๆ (6.0:1 บน #18a5e2 · 12.7:1 บน #a9d7f2)
// **ห้ามพลิกแผ่นนี้ไปใช้หมึกขาว** (§2 ห้ามขาวบน #18a5e2 ไว้ชัด: 2.6:1)
// ออรามุมขวาบนเป็นฟ้าไซยาน #18a5e2 มุมซ้ายล่างเป็นครีม #f4e4d3 — ทั้งสองชั้นเป็น
// **ออราเบลอใต้ -z-10 ไม่มีตัวอักษรวางทับ** ซึ่งเป็นงานเดียวที่ §2 ยอมให้ #18a5e2
// ทำบนพื้นสว่าง เนื้อความ #16294a (= BRAND_TEXT) — 13.9:1 บนผิวขาว · 11.8:1 บน
// ผิวอินเซ็ต #dce9fb
// ⚠️ §2 ห้าม #dce9fb/#eef4ff/#dbe6ff/#a9d7f2/#f4e4d3/#e4cbb3 ถือตัวอักษร ·
// **#0d6b9b ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานเคยนำมาแล้วห้าแบรนด์ในรีโปนี้
// (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911) การเจอฟ้าในไฟล์นี้จึง
// ไม่พิสูจน์อะไรเลย ฟ้ารอบนี้คือ **#18a5e2 (R24 G165 B226)** กับ **#0d6b9b**
// ไฟล์นี้เพิ่งค้างชุด **ฟ้าสกาย-ทองคานารีธีมสว่างของ สบาย168** ไว้ทั้งใบ
// (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
// eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c) ⚠️ 2cc3fc ห่าง #18a5e2 แค่
// R20/G30/B26 และ 6bdcfb ห่างค่า vivid ดิบของโลโก้รอบนี้แค่ 1 หน่วย — **ต้อง grep
// ทีละค่า ห้ามตัดสินด้วยตา** ออกครบแล้ว เช่นเดียวกับ **สบายเบท168** (2f9ff5 a8dcff
// d6ecff 0b3f78 e8f4ff ffc82e 5c4a16) **นินจา168** (32bcfb a9e9ff fef54b 6b5c10
// 07335f 0c2a3d 071a28 030e16) **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52) **TSDET911** (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4
// dde8f7) และแบรนด์ขาออก **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f
// 3d3016 332810 201906 2e2512 1b1407 4d3c15) กับ **พักยก168** (eeae12 fded41 9f600d
// e0e0df c0c0bf a1a09e f4ead6 291d0f 3a2713 32200f 1f1308) **รวยแท้168** (c30303
// 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f ffeee8 fff1ef ffdbdb)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง
// ไม่มีเขียว ไม่มีส้ม ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
const columnLabel = "flex items-center gap-3 text-lg leading-normal font-black tracking-wide text-[#0d6b9b]";
const stepBadge = "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#18a5e2] bg-gradient-to-br from-[#a9d7f2] to-[#18a5e2] text-base text-[#111a3f] shadow-[0_5px_15px_rgba(24,165,226,0.35)]";
const column = "flex flex-col gap-3 text-left text-base leading-relaxed text-[#16294a] transition-all hover:-translate-y-1";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a9d7f2] bg-white p-8 text-[#16294a] shadow-[0_10px_30px_rgba(22,41,74,0.12)] transition-all duration-500 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(24,165,226,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-44 w-44 rounded-full bg-[#18a5e2]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-44 w-44 rounded-full bg-[#f4e4d3]/80 blur-[60px]"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 border-b border-[#a9d7f2] pb-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0d6b9b]">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#18a5e2] to-[#a9d7f2] shadow-[0_0_10px_rgba(24,165,226,0.45)]" />
        </header>
      )
    }

    {
      hasIntro && (
        <div class="mb-8 text-left text-base leading-relaxed text-[#16294a]">
          <slot />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class={`${column} rounded-2xl border border-[#a9d7f2] bg-[#dce9fb] p-6 hover:border-[#18a5e2]`}>
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconleft}
              </span>
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class={`${column} rounded-2xl border border-[#a9d7f2] bg-[#dce9fb] p-6 hover:border-[#18a5e2]`}>
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconcenter}
              </span>
              {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class={`${column} rounded-2xl border border-[#a9d7f2] bg-[#dce9fb] p-6 hover:border-[#18a5e2]`}>
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconright}
              </span>
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
