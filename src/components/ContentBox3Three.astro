---
export interface Props {
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titlecenter, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titlecenter ?? titleright ?? "หมวดหมู่เกมและบริการ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-[#22c55e]/30 bg-[#0a0605]/85 p-8 text-[#e8f5ee] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#4ade80]/50 md:p-10">
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#16a34a]/40 pb-8 text-left text-base leading-relaxed text-[#e8f5ee]/75 transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 text-lg font-black leading-normal tracking-widest text-[#4ade80] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(74,222,128,0.8)]">🎯</span> {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#16a34a]/40 pb-8 text-left text-base leading-relaxed text-[#e8f5ee]/75 transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h2 class="flex items-center gap-2 text-lg font-black leading-normal tracking-widest text-[#4ade80] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(74,222,128,0.8)]">⚡</span> {titlecenter}
            </h2>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e8f5ee]/75 transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <h2 class="flex items-center gap-2 text-lg font-black leading-normal tracking-widest text-[#4ade80] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(74,222,128,0.8)]">🚀</span> {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
