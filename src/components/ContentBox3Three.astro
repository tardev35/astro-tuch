---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a three-column split is the page's own
   *  layout wording for one docx section, not a docx sub-heading — so they
   *  render as <p> carrying exactly the classes a heading would. Do NOT promote
   *  them back to HeadingTag: they used to be hardcoded <h2>, which put three
   *  phantom entries into the h2 inventory that gets diffed against the docx,
   *  AND hardcoded a level the docx never chose. */
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3ThreePremium so the two siblings
   *  take the same props. Defaults to FALSE — the column labels are chrome on
   *  every brand so far, and the safe default is the one that keeps chrome out
   *  of the heading inventory. A page whose three labels really ARE docx
   *  sub-points passes heading={true}, and only then do they become real
   *  headings at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech when the box is called with no
   *  `title`, since <p> labels leave it with no accessible name. */
  label?: string;
  iconleft?: string;
  iconcenter?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false, iconleft = "🔎", iconcenter = "📝", iconright = "✅" } = Astro.props;

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? titlecenter ?? titleright ?? "ขั้นตอนการใช้งาน";
const hasIntro = Astro.slots.has("default");

// The default slot is the section's INTRO paragraph and sits above the grid at
// full width; the three named slots are the columns. Its wrapper carries a real
// `mb-8` and is a sibling of the grid, so it is layout rather than an
// inheritable-class carrier — it stays, exactly like ContentBoxTwoCyberCut's.
// House rule still holds: ONE element per slot. The columns themselves are
// flattened (each <article> carries the text classes and the slot is a direct
// child) — do not re-add a wrapper <div> inside a column.
//
// รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §10** ("ช่องทางติดต่อแอดมิน <แบรนด์> ตลอด
// 24ชม." — content.txt บรรทัด 22) โดยแบ่งย่อหน้าเดียวของบรีฟเป็นสามช่วงประโยคลงสาม
// คอลัมน์ ⚠️ บรีฟรอบนี้ **ไม่มี sub-list ใต้หัวข้อไหนเลย** หน้าเพจจึงไม่ส่ง
// titleleft/titlecenter/titleright และไม่ส่ง intro มา — `heading` คงค่า false และ
// กล่องนี้ปล่อยหัวข้อออกมาใบเดียว ไอคอนสามใบจึงไม่ถูก render รอบนี้ (มันอยู่ในป้าย
// คอลัมน์) โค้ดคงไว้ให้แบรนด์ถัดไปที่บรีฟมีสามขั้นตอนจริง
//
// รวยแท้168 (2026-10-21 ดรอปที่สองของวัน) — พาเลตตาม
// .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **ธีมสว่างรอบที่สามของรีโปนี้** พื้นเพจ #ffdbdb (bg.json) การ์ดเนื้อหาเป็น
// **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับไปเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก (การ์ดใบนี้) · #fff1ef กลาง (สามคอลัมน์) · #ffdbdb พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่หัวข้อมี **ทั้งเส้นใต้การ์ดและแท่งขีด
// สั้นใต้ตัวอักษร** และเป็นใบเดียวในตระกูลสามคอลัมน์ที่ **คอลัมน์เป็นการ์ดอินเซ็ต
// #fff1ef** (ฝาแฝด §2 ContentBox3ThreePremium คั่นคอลัมน์ด้วยเส้นเปล่าบนผิวขาว)
// หัวข้อไล่ แดงคริมสัน #c30303 → หมึกเลือดหมู #4a0f0f ("คริมสันจมลงเลือดหมู")
// ⚠️ bg-clip-text = พิกเซลของตัวอักษร ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2
// (บนผิวขาว: 6.3 / 15.4 ที่ text-2xl font-black = large text) **ห้ามเอา #e81313
// #ffdbdb หรือ #fff1ef มาเป็นสต็อป**
// ป้ายสามคอลัมน์เป็นแดงคริมสัน #c30303 (6.0:1 บนผิวชมพูอ่อน) และเลขลำดับขั้นตอนอยู่
// บน **แผ่นถมแดง** ไล่ #c30303 → #4a0f0f บนหมึก **ขาว** ซึ่ง §2 ระบุว่าเป็นวิธีเดียว
// ที่จะได้ตัวอักษรบนพื้นแดงสด (6.3:1 บน #c30303 · 15.4:1 บน #4a0f0f) —
// **ห้ามพลิกแผ่นนี้ไปใช้หมึกเข้ม และห้ามลากต้นแผ่นไปที่ #e81313**
// กรอบการ์ดและกรอบคอลัมน์เป็นแดงคริมสันโปร่ง ออรามุมขวาบนเป็นแดงคริมสัน #c30303
// และมุมซ้ายล่างเป็นพื้นเพจ #ffdbdb เนื้อความ #4a0f0f (= BRAND_TEXT) — 15.4:1 บน
// ผิวขาว และ 14.6:1 บนผิวชมพูอ่อนของคอลัมน์
// ⚠️ §2 ห้าม #ffdbdb/#fff1ef ถือตัวอักษร · ห้าม #e81313 ถือตัวอักษรหรือเป็นพื้นของ
// ตัวอักษร · **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #8f0505** ซึ่งเป็นงานของ
// หน้าเพจ ไม่ใช่ของไฟล์นี้ · และ **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของ
// โครมล้วน ห้ามโผล่ในไฟล์นี้**
//
// ⚠️ ไฟล์นี้เคยเป็น **ชมพูบานเย็นของ มีทรัพย์168** ทั้งใบ (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) ก่อนหน้านั้นเป็น **ฟ้าบับเบิล-ทองของสบายเบท168** (2f9ff5
// a8dcff d6ecff ffefbb 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ก่อนนั้นเป็น **ชมพูฮอตพิงก์-ทองของ PUNPRO168** (f41571 ff5ca8 fce343 ffc554 f0c3dc
// fde7f2 8a0a45 4a0426 2a0012 4a1038 1c0014 2e0022) และก่อนนั้นเป็น **เขียวมรกต**
// (22c55e 4ade80 16a34a e8f5ee 0a0605) — ออกครบทุกค่าแล้ว
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วมากกว่าฮิวใดในรีโปนี้**
// แดงรอบนี้คือ #c30303 เท่านั้น ห่าง d30304 (รับตัง168) 16 หน่วย และห่าง b90203
// (สมหวัง168) 10 หน่วย และไม่ใช่ d9212a 8e1a16 (ดวงเศรษฐี168) e4021b (รวยเทพ168)
// fb1b32 (มีเฮ168) fa0513 ff5a5f (สมหวัง168) b3121b (ขวัญใจ168) dc0203 f5282a
// (หวย365) ff3fa4 (FAH999) หรือ d4200d (PIGPG)
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40, 10/95/28, 12/58/22,
// 174/176/74) ชุดของ ดวงเศรษฐี168 (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605
// 150303) ufalion168 (d4922c fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708) มีโชค168
// (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) ขวัญใจ168 (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce) รับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204) หวยคิง (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02
// 1c140b) TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214 4a2a08 1a0d02)
// FAH999 (ff3fa4 ff6cbb ffd1ea fde8f3 f5c53d 7a0046 4a0b42 3a0534 2e002c) และ PIGPG
// (d4200d f5b61d ffd87a fdf9e4 fdeedd) ไม่เหลือในไฟล์นี้แล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีทอง/เหลือง ไม่มีม่วง
// ไม่มีส้ม ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
const columnLabel = "flex items-center gap-3 text-lg leading-normal font-black tracking-widest text-[#c30303] uppercase";
const stepBadge =
  "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#4a0f0f] bg-gradient-to-br from-[#c30303] to-[#4a0f0f] text-base text-white shadow-[0_5px_15px_rgba(195,3,3,0.3)]";
const column = "flex flex-col gap-3 text-left text-base leading-relaxed text-[#4a0f0f] transition-all hover:-translate-y-1";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c30303]/40 bg-white p-8 text-[#4a0f0f] shadow-[0_10px_30px_rgba(74,15,15,0.16)] transition-all duration-500 hover:border-[#c30303]/70 hover:shadow-[0_15px_40px_rgba(195,3,3,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-44 w-44 rounded-full bg-[#c30303]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-44 w-44 rounded-full bg-[#ffdbdb]/95 blur-[60px]"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 border-b border-[#c30303]/40 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#c30303] to-[#4a0f0f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#c30303] to-[#4a0f0f] shadow-[0_0_10px_rgba(195,3,3,0.4)]" />
        </header>
      )
    }

    {
      hasIntro && (
        <div class="mb-8 text-left text-base leading-relaxed text-[#4a0f0f]">
          <slot />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class={`${column} rounded-2xl border border-[#c30303]/30 bg-[#fff1ef] p-6 hover:border-[#c30303]/70`}>
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconleft}
              </span>
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class={`${column} rounded-2xl border border-[#c30303]/30 bg-[#fff1ef] p-6 hover:border-[#c30303]/70`}>
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconcenter}
              </span>
              {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class={`${column} rounded-2xl border border-[#c30303]/30 bg-[#fff1ef] p-6 hover:border-[#c30303]/70`}>
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconright}
              </span>
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
