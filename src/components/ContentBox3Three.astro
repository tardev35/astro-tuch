---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a three-column split is the page's own
   *  layout wording for one docx section, not a docx sub-heading — so they
   *  render as <p> carrying exactly the classes a heading would. Do NOT promote
   *  them back to HeadingTag: they used to be hardcoded <h2>, which put three
   *  phantom entries into the h2 inventory that gets diffed against the docx,
   *  AND hardcoded a level the docx never chose. */
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3ThreePremium so the two siblings
   *  take the same props. Defaults to FALSE — the column labels are chrome on
   *  every brand so far, and the safe default is the one that keeps chrome out
   *  of the heading inventory. A page whose three labels really ARE docx
   *  sub-points passes heading={true}, and only then do they become real
   *  headings at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech when the box is called with no
   *  `title`, since <p> labels leave it with no accessible name. */
  label?: string;
  iconleft?: string;
  iconcenter?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label, heading = false, iconleft = "🔎", iconcenter = "📝", iconright = "✅" } = Astro.props;

const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? titlecenter ?? titleright ?? "ขั้นตอนการใช้งาน";
const hasIntro = Astro.slots.has("default");

// The default slot is the section's INTRO paragraph and sits above the grid at
// full width; the three named slots are the columns. Its wrapper carries a real
// `mb-8` and is a sibling of the grid, so it is layout rather than an
// inheritable-class carrier — it stays, exactly like ContentBoxTwoCyberCut's.
// House rule still holds: ONE element per slot. The columns themselves are
// flattened (each <article> carries the text classes and the slot is a direct
// child) — do not re-add a wrapper <div> inside a column.
//
// รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §2** ("<แบรนด์> เกมเดิมพันออนไลน์ค่ายแท้
// มีทุนน้อย ก็ฝากยอดเล่นได้" — content.txt บรรทัด 5) โดยแบ่งย่อหน้าเดียวของบรีฟ
// (บรรทัด 6) เป็นสามช่วงประโยคลงสามคอลัมน์ ⚠️ บรีฟรอบนี้ **ไม่มี sub-list ใต้หัวข้อ
// ไหนเลยนอกจาก §6** หน้าเพจจึงไม่ส่ง titleleft/titlecenter/titleright และไม่ส่ง
// intro มา — `heading` คงค่า false และกล่องนี้ปล่อยหัวข้อออกมาใบเดียว ไอคอนสามใบ
// จึงไม่ถูก render รอบนี้ (มันอยู่ในป้ายคอลัมน์) โค้ดคงไว้ให้แบรนด์ถัดไปที่บรีฟมี
// สามขั้นตอนจริง หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading
//
// สบาย168 (2026-10-22) — พาเลตตาม .claude/brand-spec-sabai168.md §2
// ⚠️⚠️ **รอบนี้กลับมาเป็นธีมสว่าง หลังรอบก่อนเป็นดำสนิท** พื้นเพจ #ccf7ff
// (bg.json) การ์ดเนื้อหาเป็น **ผิวสว่าง + หมึกน้ำเงินเข้ม** ห้ามแก้กลับไปเป็นพื้นเข้ม
// เพราะ "รอบก่อนเป็นแบบนั้น" ส่วนโครมรอบนี้ต่างหากที่เป็นน้ำเงินมหาสมุทรลึก
// ลำดับผิว: #ffffff ยก (การ์ดใบนี้) · #f2fbff กลาง · **#dff4fd อินเซ็ต (สามคอลัมน์)**
// · #ccf7ff พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่หัวข้อมี **ทั้งเส้นใต้การ์ดและแท่งขีด
// สั้นใต้ตัวอักษร** และเป็นใบเดียวในหน้าที่ **คอลัมน์เป็นการ์ดอินเซ็ต #dff4fd**
// หัวข้อไล่ ฟ้าลึก #0a7fbd → น้ำเงินหมึก #063a57 ("ฟ้าลึกจมลงน้ำเงินหมึก")
// ⚠️ bg-clip-text = พิกเซลของตัวอักษร ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2
// (บนผิวขาว: #0a7fbd 4.2:1 และ #063a57 7.5:1 ที่ text-2xl font-black = large text)
// **ห้ามเอา #2cc3fc #6bdcfb #9ae0fa #fdcb0c #fefb6b #dff4fd หรือ #ccf7ff มาเป็นสต็อป**
// ป้ายสามคอลัมน์เป็นน้ำเงินหมึก #063a57 (7.0:1 บนผิวอินเซ็ต #dff4fd) และเลขลำดับ
// ขั้นตอนอยู่บน **แผ่นถมฟ้า** ไล่ #2cc3fc → #0a7fbd บนหมึก **#06293c** ซึ่ง §2 ระบุ
// ว่าเป็นหมึกของพื้นถมฟ้า (7.5:1 บน #2cc3fc) — **ห้ามพลิกแผ่นนี้ไปใช้หมึกขาว**
// กรอบการ์ดและกรอบคอลัมน์เป็นฟ้าสกายโปร่ง ออรามุมขวาบนเป็นฟ้าสกาย #2cc3fc และ
// มุมซ้ายล่างเป็นทองคานารี #fdcb0c — ทั้งสองชั้นเป็น **ออราเบลอใต้ -z-10**
// ไม่มีตัวอักษรวางทับ ซึ่งเป็นงานเดียวที่ §2 ยอมให้สองค่านี้ทำบนพื้นสว่าง
// เนื้อความ #0f3a4a (= BRAND_TEXT) — 12.2:1 บนผิวขาว และ 11.0:1 บนผิวอินเซ็ต
// ⚠️ §2 ห้าม #dff4fd/#f2fbff/#ccf7ff ถือตัวอักษร · ห้าม #2cc3fc/#6bdcfb/#9ae0fa/
// #fdcb0c/#fefb6b ถือตัวอักษรบนพื้นสว่าง (1.5–2.4:1) ·
// **สีไฮไลต์ <strong> ในเนื้อความมีตัวเดียวคือ #8a6504** ซึ่งเป็นงานของหน้าเพจ
// ไม่ใช่ของไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ฟ้าและเหลืองเคยผ่านรีโปนี้มาหลายเจ้า
// และชื่อก็เกือบซ้ำ** การเจอฟ้าหรือทองในไฟล์จึงไม่พิสูจน์ว่าเป็นของรอบนี้
// ⚠️⚠️ **สบายเบท168 ชื่อใกล้ที่สุดในรีโปและเป็นฟ้า+ทองเหมือนกัน — คนละลูกค้า**
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ⚠️ ไฟล์นี้เคยเป็น **ฟ้าบับเบิล-ทองของสบายเบท168 ทั้งใบ** มาก่อน จึงต้อง grep
// ทีละค่า ไม่ใช่กะด้วยตา · **นินจา168** (32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d
// 071a28 030e16 041019 dceefc) · **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b
// f9a826 704504 e3f2fc 0b2d52 071e38 030f1d 031320 7fa8cc)
// แบรนด์ขาออก **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f
// 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) · **โปรดี168** (eb0305
// e40303 c20305 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004
// fff0e4 fff4ea ffd1d1 1a0802) · **รวยแท้168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบ (c30303
// 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb
// c99a3f กับ rgba 195/3/3 α) rgba 74/15/15 α)) · **มีทรัพย์168** (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) · **PUNPRO168** (f41571 ff5ca8 fce343 ffc554 f0c3dc
// fde7f2 8a0a45 4a0426 2a0012 4a1038 1c0014 2e0022) · **สาธุ168** (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) · **ดวงเศรษฐี168**
// (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303) · **หวยคิง** (cd9a2c
// fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · **สมหวัง168** (fa0513
// ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204) · **รับตัง168** (f0b429 ffdc8c
// d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6) — ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีเงิน/โครเมียม**
const columnLabel = "flex items-center gap-3 text-lg leading-normal font-black tracking-widest text-[#063a57] uppercase";
const stepBadge =
  "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#0a7fbd] bg-gradient-to-br from-[#2cc3fc] to-[#0a7fbd] text-base text-[#06293c] shadow-[0_5px_15px_rgba(44,195,252,0.35)]";
const column = "flex flex-col gap-3 text-left text-base leading-relaxed text-[#0f3a4a] transition-all hover:-translate-y-1";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#2cc3fc]/45 bg-white p-8 text-[#0f3a4a] shadow-[0_10px_30px_rgba(6,58,87,0.14)] transition-all duration-500 hover:border-[#2cc3fc]/80 hover:shadow-[0_15px_40px_rgba(44,195,252,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-44 w-44 rounded-full bg-[#2cc3fc]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-44 w-44 rounded-full bg-[#fdcb0c]/25 blur-[60px]"></div>

    {
      title && (
        <header class="mb-6 flex flex-col gap-3 border-b border-[#2cc3fc]/45 pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#0a7fbd] to-[#063a57] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
          <div aria-hidden="true" class="h-[3px] w-20 rounded-full bg-gradient-to-r from-[#2cc3fc] to-[#fdcb0c] shadow-[0_0_10px_rgba(44,195,252,0.45)]" />
        </header>
      )
    }

    {
      hasIntro && (
        <div class="mb-8 text-left text-base leading-relaxed text-[#0f3a4a]">
          <slot />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class={`${column} rounded-2xl border border-[#9ae0fa] bg-[#dff4fd] p-6 hover:border-[#2cc3fc]`}>
        {
          titleleft && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconleft}
              </span>
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class={`${column} rounded-2xl border border-[#9ae0fa] bg-[#dff4fd] p-6 hover:border-[#2cc3fc]`}>
        {
          titlecenter && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconcenter}
              </span>
              {titlecenter}
            </LabelTag>
          )
        }
        <slot name="center" />
      </article>

      <article class={`${column} rounded-2xl border border-[#9ae0fa] bg-[#dff4fd] p-6 hover:border-[#2cc3fc]`}>
        {
          titleright && (
            <LabelTag class={columnLabel}>
              <span aria-hidden="true" class={stepBadge}>
                {iconright}
              </span>
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
