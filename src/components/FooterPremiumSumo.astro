---
import { Image } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// MEXICANOSLOT (รอบแดงเม็กซิกันนำ + ทองรอง **เนื้อหาสว่าง โครมเข้ม** 2026-10-24):
// ไฟล์นี้เป็น footer ที่ใช้งานจริงรอบนี้ — หมุนออกจาก `FooterStyle3` ของ okkub88
// ซึ่งเป็นแผ่นแบนที่มี **การ์ด CTA ลอยคร่อมขอบบน** (-top-14 พร้อม pt-* รับ) และ
// BankStrip อยู่ในแถบของตัวเอง ไฟล์นี้คนละทรง: แผ่น rounded-t-[3rem] ที่มีออรา
// เรืองแสงเบลอคร่อม **ทั้งขอบบนและขอบล่าง** กริด 12 คอลัมน์แบ่ง 5/3/4
// **ไม่มีการ์ด CTA ลอย และไม่มี BankStrip** และมีย่อหน้าเนื้อความยาวคั่นก่อน
// บรรทัดลิขสิทธิ์
//
// 🚨🚨 **กับดักรอบนี้คือแดง ไม่ใช่สีแปลกปลอม** — แดงเคยนำมาแล้วหลายแบรนด์ในรีโปนี้
// (สล็อต168 · มาดาม168 · รวยแท้168 · ดวงเศรษฐี168 · GT66B) จึง **ห้ามตัดสินด้วยตา
// ต้องเทียบทีละค่า** แดงของรอบนี้คือ **#de2b1e** (R222 G43 B30) คู่กับ **แดงหัวข้อ
// #a81410** และ **แดงไฮไลต์บนโครม #f2543f** ตัวที่ใกล้ที่สุดในรีโปคือ fb2e33 ของ
// สล็อต168 (ห่าง R29/G3/B21) และ d9212a ของดวงเศรษฐี168 (ห่าง R5/G18/B12) —
// ให้ grep เป็นค่าทีละตัวกับตารางใน .claude/brand-spec-mexicanoslot.md §2
// ⚠️ ค่า vivid ดิบของ slide1.png รอบนี้คือ fd0203 และของ logo.webp คือ c30c0a
// ทั้งคู่ดิบเกินไปสำหรับ UI — รอบนี้จึงเลื่อนมาที่ #de2b1e / #a81410 **ห้ามใช้ค่าดิบ**
// ไฟล์นี้เคยค้างชุดฟ้าไซยาน-น้ำเงินกรมของร่ำรวย168 มาเต็มไฟล์ (18a5e2 0d6b9b a9d7f2
// 202a66 31408a 111a3f e9f1ff และ rgba ของฟ้านั้น) — กวาดออกครบแล้ว ไม่เหลือสักค่า
// ⚠️ **ฟ้า/น้ำเงินไม่ใช่สีของรอบนี้เลยสักเฉด** — "SLOT" สีน้ำเงินไล่ฟ้าในเวิร์ดมาร์ก
// เป็น **อาร์ตเวิร์กของโลโก้ ไม่ใช่สี UI** และฟ้าคือฮิวของ โบ๊ะบ๊ะ168 เมื่อสองรอบก่อน
// การดึงมันเข้ามาคือหลงเหลือข้ามแบรนด์แบบตรงตัว
//
// แกนสี: **โครมเข้มคร่อมเนื้อหาสว่าง** — พื้นเพจเป็น #fef6fb ขาวอมชมพูจาง (จาก
// bg.json) ส่วน footer เป็นพื้นถม #2b100a กลาง / #431a10 ยก / #1d0a06 ลึก ·
// ทอง #f2a033 เป็นหัวข้อคอลัมน์ เส้นคั่น ขอบ และสีลิงก์ hover (8.3:1) · แดงลึก
// #9d140c เป็นพื้นถมป้ายใบที่สอง · #8c3a22 เป็นเส้นคั่น · ออราขอบบนเป็น #de2b1e
// ออราขอบล่างเป็น #1d0a06 · เนื้อความ #fdeee2 (17.6:1 บน #2b100a)
// ⚠️ **#de2b1e ห้ามถือตัวอักษรบนพื้นโครม** (2.5:1 บน #2b100a = ตก AA ขาดลอย)
// ใช้เป็นขอบ/พื้นถม/ออราเท่านั้น ป้าย "แนะนำเพื่อน 0.8%" จึงเป็น **ถมแดงลึก #9d140c
// แล้ววางตัวอักษรขาวทับ** (8.3:1 ผ่าน AA) ไม่ใช่ตัวอักษรแดงบนพื้นเข้ม
// ⚠️ **ทอง #f2a033 บนพื้นโครมได้ 8.3:1 ผ่านสบาย แต่บนผิวการ์ดขาวได้แค่ 2.2:1**
// — ค่านี้จึงห้ามหลุดออกจากไฟล์โครมไปถือตัวอักษรใน ContentBox ใดๆ
// เช่นเดียวกับ #f2543f (5.2:1 บนโครม · 3.5:1 บนขาว)
//
// ⚠️ แกนเนื้อหารอบนี้คือ **เว็บสล็อตออนไลน์ธีมเม็กซิกัน** — ย่อหน้าท้ายฟุตเตอร์เดิม
// เป็นคลังคำของร่ำรวย168 (ระดับการเดิมพัน · ค่า RTP · ยอดฝากขั้นต่ำ · วงเงินถอน ·
// ไม่อั้นจ่าย/ไม่อั้นถอน · ปรับเรทแตกหนัก) ถูกเขียนใหม่หมดทั้งย่อหน้าแล้ว
// **ห้ามเติมกลับแม้แต่คำเดียว** บรีฟรอบนี้ไม่มีคำพวกนั้นเลยสักคำ
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนเรื่องฝากถอน ทรูวอลเลท (คำของ okkub88 รอบก่อน) หรือออโต้ที่ไหนในไฟล์นี้
// ⚠️ ห้ามระบุชื่อค่ายเกม ชื่อธนาคาร ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ค่า RTP
// เป็นตัวเลข จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟไม่ได้ให้มาสักตัว ตัวเลขที่อ้างได้
// มีสี่ตัวเท่านั้นคือ **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.** และทุกประโยคกำกับของบรีฟ
// ต้อง ship ครบ (บรีฟรอบนี้โฆษณาแล้วเบรกเองตลอด ครึ่งที่เบรกคือเนื้อหา ไม่ใช่ filler)
//
// ⚠️ **ไฟล์นี้ไม่ render BankStrip** (ต่างจาก FooterStyle3 ของรอบก่อนที่ import มันเอง)
// และนั่นคือเหตุผลหนึ่งที่เลือกไฟล์นี้รอบนี้: บรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารหรือ
// วอลเลทแม้แต่แห่งเดียว** แถบโลโก้ธนาคารคือการอ้างว่ารองรับธนาคารชุดนั้นจริง ซึ่ง
// ไม่มีอะไรในบรีฟรองรับ ไฟล์ BankStrip.astro ยังอยู่ครบในฐานะ inventory **ห้ามลบ**
//
// ลิงก์ของ **สองหน้าหวยที่ปิดอยู่รอบนี้** (/ตรวจหวย · /แนวทาง) ไม่มีในไฟล์นี้
// และห้ามเติมกลับ — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นจอดอยู่ใน
// src/pages-disabled/ ซึ่ง Astro ไม่ route ให้ การทิ้งลิงก์ไว้จึงเป็น href ที่ชี้
// route ที่ไม่มีจริง และ verify-build.mjs จะทำให้ build แดง
// route ที่มีจริงรอบนี้: / /about-us /contact-us /login /privacy /promotion /register
// /terms /ทดลองเล่น /ทางเข้า /line
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ cta toggle เปิด
// และ /register กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// ⚠️ ไฟล์นี้เป็นโครมที่ render ทุกหน้า จึง **ห้ามมี heading tag ทุกระดับ** หัวข้อคอลัมน์
// เป็น <p> ที่ถือคลาสเดิมไว้ และ <nav>/<section> ที่เสียชื่อเรียกไปใช้ aria-label แทน
//
// บล็อก <address> ด้านล่างคัดลอกจาก SKILL.md แบบ verbatim — ห้ามใส่ hex ของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer ทุกตัวใน
// ไลบรารีซึ่งเป็นพื้นเข้มหมด รวมถึงรอบนี้ที่ตัวเพจสว่างแต่ footer เข้ม
// ⚠️ รอบก่อน (okkub88) footer เป็นผิว **ขาว** จึงต้องเบี่ยงบล็อกนี้เป็นสีชมพู —
// **รอบนี้ไม่ต้องเบี่ยง ให้กลับไปใช้ค่า verbatim ตาม SKILL.md** การ retheme มันคือ
// การทิ้ง hex ของรอบนี้ไว้ให้รอบหน้า
// ที่อยู่กับอีเมลมาจาก BRAND_ADDRESS ล้วน (อนุมานจาก BRAND_NAME + site:) ห้ามพิมพ์เอง
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-24 ที่เปิดอ่านจริง (ไม่มีตะกร้าเหรียญทอง
// ของร่ำรวย168 ไม่มีหน้าการ์ตูนกลมชมพูชู V ของ okkub88 และไม่มีลูกหมูมีปีกของ
// หมูบิน168 อยู่ในรูปนี้เลย) ชื่อแบรนด์ interpolate เสมอ
//
// ไฟล์ต้นทางเป็นจัตุรัส 500x500 และกล่องนี้วาดมันสูง 36px → กว้าง 36px เช่นกัน
// widths/sizes จึงอิง 36px ไม่ใช่ความกว้างของกล่อง
//
// ⚠️ **เป็น <Image format="webp"> ไม่ใช่ <Picture> ที่มี avif โดยตั้งใจ** — ที่
// 36w/72w/108w ค่าโสหุ้ยของคอนเทนเนอร์ AVIF กินมากกว่าที่มันประหยัดได้ ซึ่ง
// `tools/verify-build.mjs` ทำให้ build แดงถูกต้องแล้ว เพราะเบราว์เซอร์ที่รองรับ avif
// จะหยิบไฟล์ที่ **ใหญ่กว่า** การลด quality ไม่ช่วยเพราะพื้นของ avif อยู่ที่
// ~700 ไบต์ไม่ว่าจะลดแค่ไหน **ห้ามเติม avif กลับเข้ามาที่ขนาดนี้**
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นรูปชายการ์ตูนไว้หนวด สวมซอมเบรโรฟางขอบลายปักแดง-เขียว ขยิบตาและยกนิ้วโป้ง สวมปอนโชลายทอ อยู่ข้างเวิร์ดมาร์กสามมิติที่เขียนว่า ${BRAND_NAME} โดยครึ่งแรกเป็นตัวอักษรสีแดงสดและครึ่งหลังเป็นสีน้ำเงินไล่ฟ้า ตัดขอบขาวหนา มีแถบธงชาติเม็กซิโกเขียว-ขาว-แดงพาดอยู่ด้านหลัง`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#8c3a22] bg-[#2b100a] pt-16 pb-8 font-sans text-[#fdeee2] shadow-[0_-15px_40px_rgba(222,43,30,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#de2b1e]/25 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#1d0a06]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a
          href="/"
          class="flex h-[56px] max-w-max items-center gap-3 overflow-hidden rounded-xl border border-[#8c3a22] bg-[#1d0a06] px-5 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Image
                src={mainLogo}
                alt={logoAlt}
                widths={[36, 72, 108]}
                sizes="36px"
                quality={65}
                loading="lazy"
                decoding="async"
                class="h-[36px] w-auto object-contain"
                format="webp"
              />
            ) : (
              <span class="text-2xl font-black tracking-widest text-[#f2a033]">{BRAND_NAME}</span>
            )
          }
          <span class="text-xl font-black tracking-wide text-[#f2a033]">{BRAND_NAME}</span>
        </a>
        <p class="border-l-2 border-[#f2a033] pl-4 text-sm leading-relaxed text-[#fdeee2]/85">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์ภายใต้คอนเซปต์สล็อตเมกซิกัน รวมรายละเอียดเกม กติกา และโปรโมชั่นไว้ในช่องทางเดียว ผู้ใช้งานสามารถศึกษาข้อมูลก่อนสมัครสมาชิกได้จากเว็บไซต์ทางการ
          ทั้งนี้ ข้อมูลเกี่ยวกับการส่งตรงจากเม็กซิโกควรตรวจสอบแหล่งที่มาของเกมและผู้ให้บริการก่อนใช้งาน เพื่อให้เข้าใจรายละเอียดของแพลตฟอร์มอย่างถูกต้อง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#8c3a22] bg-[#431a10] px-4 py-1 text-xs font-medium text-[#fdeee2]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน</span>
          <span class="rounded-full border border-[#1d0a06] bg-[#9d140c] px-4 py-1 text-xs font-medium text-white">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f2a033] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f2a033]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fdeee2]/85">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#f2a033]">{link.name}</a></li>)}
        </ul>
      </nav>

      <section aria-label="ช่องทางติดต่อเจ้าหน้าที่" class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f2a033] uppercase drop-shadow-sm">แอดมินออนไลน์ 24ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f2a033]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#8c3a22] bg-[#431a10]/80 py-3 text-sm font-bold text-[#fdeee2] transition-all hover:bg-[#431a10]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </section>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#fdeee2]/75 md:block">
