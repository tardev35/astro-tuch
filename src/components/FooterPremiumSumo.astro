---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ขวัญใจ168 (รอบทองนำ-โรสโกลด์รอง บนดำสนิท 2026-10-18): ไฟล์นี้เป็น footer ที่
// ใช้งานจริงรอบนี้ — รอบก่อน (รับตัง168) ใช้ FooterStyle2 ซึ่งเป็นแผ่นแบน ขอบบน
// เส้นหนา กริด 4 คอลัมน์เท่ากัน ไม่มีออราและไม่มีย่อหน้าท้าย ไฟล์นี้เป็นคนละทรง:
// แผ่น rounded-t-[3rem] ที่มีออราเรืองแสงเบลอคร่อมทั้งขอบบนและขอบล่าง กริด 12
// คอลัมน์แบ่ง 5/3/4 และมีย่อหน้าเนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์
//
// ของเดิมที่ค้างอยู่เป็นชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #8a5c09
// #43240b #f0e9dc #c9b88e #070502 #120c04 #1b1307 และ rgba(223,163,16,α))
// ทั้งสีและเนื้อหาถูกเขียนใหม่หมดแล้ว
//
// ⚠️ **กับดักรอบนี้คือทอง ไม่ใช่สีแปลกปลอม** — ไฟล์นี้ค้างทองมาจากแบรนด์ทองเหมือนกัน
// ทองของ TND168 คือ #dfa310/#ffc93d · ของรับตัง168 (รอบที่แล้ว) คือ #f0b429 ·
// ของสมหวัง168 คือ #e3b23c · **ทองรอบนี้คือ #f7c92b** ให้เทียบเป็นค่า ไม่ใช่ด้วยตา
//
// รอบนี้ **มีคู่สีรองจริง** ต่างจาก TND168 ที่ใช้ "ทองอีกระดับ" แทนสีที่สอง:
// palette.json วัด vivid อันดับหนึ่งของทั้ง logo.webp และ banner1.png ได้เป็น
// **โรสโกลด์ #f2bba5** (ผิวนางแบบ ดอกลิลลี่ขาว ผ้าครีมปักทอง) ป้ายสองใบใน
// คอลัมน์แรกจึงต่างกันที่ **ทอง vs โรสโกลด์** ไม่ใช่ที่ค่าของทองเดียวกัน
// ส่วนแดงชาด #b3121b เป็นสำเนียงลึกที่ถือได้แค่ขอบและออรา **ไม่เคยนำ**
//
// แกนสี: พื้นดำสนิท #000000 (ตรงกับ bg.json) ยกระดับด้วย #0b0603 / #160d06 /
// #241509 · ทองแบรนด์ #f7c92b เป็นขอบและเส้นคั่น · ทองสว่าง #ffe6a3 เป็นหัวคอลัมน์
// และลิงก์ hover · โรสโกลด์ #f2bba5 เป็นป้ายใบที่สองและสีลิงก์รอง · ทองลึก #8a5f12
// เป็นเส้นคั่นท้ายหน้า · แดงลึก #5a0a0e เป็นออรามุมล่าง · เนื้อความหลัก #eadfce
// (= BRAND_TEXT) เนื้อความรอง #c98a74
// ⚠️ #8a5f12 · #5a0a0e · #b3121b ห้ามถือตัวอักษรทุกขนาด ใช้เป็นเส้น ขอบ และออราเท่านั้น
//
// ⚠️ เนื้อความรอบนี้เป็น **เว็บเกมสล็อตล้วนที่ขายตัวเองว่าเป็น "ศูนย์บริการหลัก"**
// ตามบรีฟ — ต่างจากรอบ TND168 ที่เป็นคาสิโนรวมทุกหมวด คำของแบรนด์ก่อนๆ
// (บาคาร่า รูเล็ต ไฮโล แทงบอล คาสิโนไลฟ์สด อัตราต่อรอง · ฐานหลักเกมสล็อต
// ช่องทางรับบริการ ผู้ให้บริการเว็บตรง ลิขสิทธิ์แท้ ของรับตัง168) ถูกถอดออกหมด
// ห้ามเติมกลับ และห้ามอ้างใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP
// จำนวนสมาชิก หรือที่ตั้งเซิร์ฟเวอร์ เพราะบรีฟไม่ได้ระบุไว้ — บรีฟถึงกับบอกเองว่า
// "ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน"
// ตัวเลขที่อ้างได้มีสี่ตัวคือ 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง (และ 100%
// ที่อยู่ในวลี "ลิขสิทธิ์เว็บแท้100%" ของบรีฟเอง)
//
// ลิงก์ /ตรวจหวย กับ /แนวทาง ไม่มีในนี้ และห้ามเติม — ขวัญใจ168 ไม่ใช่เว็บหวย
// สองหน้านั้นอยู่ใน src/pages-disabled/ การทิ้งลิงก์ไว้จะเป็น href ที่ชี้ไป route
// ที่ไม่มีจริง ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer
// ทุกตัวในไลบรารีซึ่งเป็นพื้นเข้มหมด การ retheme มันคือการทิ้ง hex ของรอบนี้
// ไว้ให้รอบหน้า
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-18 ที่เปิดอ่านจริง ไม่ใช่คัดจากสเปก
// (เหรียญตรามังกรจีนของ TND168 ไม่มีอยู่ในรูปนี้เลย)
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นคำว่า ขวัญใจ ตัวอักษรไทยหนาสามมิติผิวทองขัดเงาตัดขอบสีแดงเข้ม ต่อด้วยเลข 168 สีทองสามมิติ วางพาดอยู่บนโบว์ริบบิ้นสีทอง ด้านหลังเป็นหญิงสาวผมยาวสีดำเกล้ามวยประดับปิ่นทองและดอกไม้ขาว สวมชุดไทยสีแดงปักทอง ทำมือเป็นรูปหัวใจเล็ก ล้อมรอบด้วยเหรียญจีนสีทองรูสี่เหลี่ยมและหัวใจสีแดง`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f7c92b]/60 bg-[#000000] pt-16 pb-8 font-sans text-[#eadfce] shadow-[0_-15px_40px_rgba(247,201,43,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f7c92b]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#5a0a0e]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f7c92b]/30 bg-[#0b0603] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffe6a3]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f7c92b]/50 pl-4 text-sm leading-relaxed text-[#c98a74]">
          {BRAND_NAME} ศูนย์รวมช่องทางบริการเกมสล็อตออนไลน์ที่จัดเตรียมเมนูสำหรับสมัครสมาชิก เข้าเล่น ฝากถอน และติดต่อเจ้าหน้าที่ไว้ในเว็บไซต์เดียว ช่วยให้ผู้ใช้งานค้นหาข้อมูลที่ต้องการได้สะดวก ไม่ว่าจะเป็นขั้นตอนเริ่มต้นใช้งาน รายละเอียดโปรโมชั่น
          หรือการสอบถามปัญหาต่าง ๆ พร้อมช่องทางติดต่อทีมงานตลอด 24 ชั่วโมง ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการก่อนใช้งาน
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f7c92b]/35 bg-[#0b0603] px-4 py-1 text-xs font-medium text-[#ffe6a3] backdrop-blur-sm">คืนยอดเสีย 0.3% เข้ายูสทุกวัน</span>
          <span class="rounded-full border border-[#f2bba5]/45 bg-[#160d06] px-4 py-1 text-xs font-medium text-[#f2bba5] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe6a3] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f7c92b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#c98a74]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#ffe6a3]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe6a3] uppercase drop-shadow-sm">ติดต่อเจ้าหน้าที่ 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f7c92b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#f7c92b]/50 bg-[#160d06]/80 py-3 text-sm font-bold text-[#eadfce] transition-all hover:bg-[#241509]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#c98a74] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#c98a74] md:block">
      {BRAND_NAME} ออกแบบช่องทางบริการให้ผู้ใช้งานเข้าถึงเมนูสำคัญได้จากจุดเดียว ตั้งแต่การลงทะเบียนสมาชิก การเข้าสู่ระบบเพื่อเลือกเกมสล็อต ไปจนถึงการตรวจสอบรายการฝากถอนและโปรโมชั่นที่เปิดให้เข้าร่วม โดยแต่ละเมนูควรมีรายละเอียดขั้นตอนและเงื่อนไขให้ศึกษาอย่างชัดเจน
      หากพบปัญหาระหว่างใช้งานสามารถสอบถามเจ้าหน้าที่ผ่านช่องทางติดต่อที่เว็บไซต์ประกาศไว้ ช่วยลดความยุ่งยากในการค้นหาข้อมูลและทำให้ติดตามสถานะรายการต่าง ๆ ได้สะดวกยิ่งขึ้น โปรโมชั่นที่ระบุไว้คือคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนโบนัส 0.8% ไม่จำกัด
      ซึ่งแต่ละรายการมีรูปแบบการรับสิทธิ์แตกต่างกัน ผู้ใช้งานควรอ่านรายละเอียดเกี่ยวกับยอดที่นำมาคำนวณ ระยะเวลารับสิทธิ์ และเงื่อนไขการใช้โบนัสก่อนเข้าร่วม รวมถึงตรวจสอบว่าระบบเพิ่มเครดิตให้อัตโนมัติหรือต้องดำเนินการด้วยตนเอง ทั้งนี้ เครดิตคืนยอดเสียไม่ใช่การรับประกันว่าจะได้รับผลตอบแทนจากการเดิมพัน
      สำหรับผู้ที่ต้องการเริ่มต้นใช้งาน ควรตรวจสอบความถูกต้องของช่องทางสมัครและอ่านเงื่อนไขก่อนกรอกข้อมูลส่วนตัว กรอกข้อมูลตามความเป็นจริง ตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่ควรใช้ข้อมูลของบุคคลอื่นในการลงทะเบียน ส่วนการติดต่อเจ้าหน้าที่ ควรเพิ่มเพื่อนผ่านลิงก์หรือ QR Code
      ที่แสดงอยู่บนเว็บไซต์ทางการเท่านั้น เพื่อหลีกเลี่ยงบัญชีปลอมหรือผู้แอบอ้าง เมื่อแจ้งปัญหาควรอธิบายรายละเอียดให้ชัดเจนและเก็บหลักฐานรายการที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น ทั้งนี้ ระยะเวลาตอบกลับขึ้นอยู่กับการให้บริการจริงของเจ้าหน้าที่
      และควรตรวจสอบข้อมูลผู้ให้บริการและสถานะลิขสิทธิ์จากหลักฐานทางการ รวมถึงอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตนก่อนใช้งาน
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a5f12]/60 pt-8 text-xs font-medium tracking-wide text-[#c98a74] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe6a3]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe6a3]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
