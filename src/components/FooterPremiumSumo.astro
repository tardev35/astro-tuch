---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด บนดำสนิท 2026-10-10): ไฟล์นี้เป็น footer ที่ใช้
// งานจริงรอบนี้ (รอบก่อน NAZA168 ใช้ FooterStyle3) ของเดิมที่ค้างอยู่เป็นพาเลตต์
// ทอง-เงินโครเมียมของ 1SS365 ซึ่งเอาเงินมาจากตัวอักษร 1SS ในโลโก้ของแบรนด์นั้น —
// ทั้งสีและเนื้อหาถูกเขียนใหม่หมดแล้ว
//
// คู่สีรองรอบนี้เป็น "ส้มอำพัน" ไม่ใช่เงินโครเมียม เพราะโลโก้ DUCK1688 เป็นทอง
// เกือบทั้งใบ (ตัว DUCK มงกุฎ ขอบป้าย ตัวเป็ด) แล้วมีส้มอยู่จุดเดียวคือปากเป็ด
// เงิน #c8cbce/#e6e9eb ของ 1SS365 จึงถูกแทนด้วย #f58b2a/#ffc98a ทั้งหมด
//
// ⚠️ เนื้อความรอบนี้พูดถึง "เกมสล็อต" อย่างเดียว บรีฟของ DUCK1688 ระบุเฉพาะสล็อต
// พีจีและค่ายหลักเท่านั้น — คำว่า บาคาร่า รูเล็ต ไฮโล บอล และคำหวยทุกคำ ถูกถอด
// ออกทั้งหมด ห้ามเติมกลับ และห้ามอ้างใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ
// หรือตัวเลข RTP เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสี่ตัวคือ 0.3% ·
// 0.8% · 3 ขั้นตอน · 24 ชั่วโมง และข้อความโฆษณาของแบรนด์ (ทุนน้อยกำไรงาม
// การันตีความน่าเชื่อถือ) ต้องมาพร้อมคำกำกับของบรีฟเองเสมอว่าใช้รับประกันผลไม่ได้
//
// ลิงก์ /ตรวจหวย กับ /แนวทาง ไม่มีในนี้ และห้ามเติม — DUCK1688 ไม่ใช่เว็บหวย สองหน้า
// นั้นอยู่ใน src/pages-disabled/ การทิ้งลิงก์ไว้จะเป็น href ที่ชี้ไป route ที่ไม่มีจริง
// ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// แกนสี: พื้นดำสนิท #000000 ยกระดับด้วย #0d0903 / #171106 / #1f1709 · ทองแบรนด์
// #f3bb34 (vivid ของ logo.webp) เป็นขอบและเส้นคั่น · ทองอ่อน #fde464 เป็นหัวคอลัมน์
// และลิงก์ hover · ทองลึก #8a5f08 เป็นเส้นคั่นท้ายหน้า · ส้มอำพัน #f58b2a เป็น
// คู่สีรอง ส้มอ่อน #ffc98a เวลาใช้เป็นตัวอักษร · เนื้อความหลัก #f6ecd9
// (BRAND_TEXT) เนื้อความรอง #d8c69b
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f3bb34]/60 bg-[#000000] pt-16 pb-8 font-sans text-[#f6ecd9] shadow-[0_-15px_40px_rgba(243,187,52,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f3bb34]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#f58b2a]/16 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f3bb34]/30 bg-[#0d0903] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ DUCK1688 เป็นเป็ดการ์ตูนสีเหลืองสวมมงกุฎทอง ขยิบตาหนึ่งข้าง ปากสีส้มอำพัน โผล่อยู่เหนือแผ่นป้ายดำขอบทองที่เขียนคำว่า DUCK เป็นตัวอักษรสามมิติสีทองและเลข 1688 สีขาวโครเมียมขอบทอง"
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#fde464]">
                DUCK<span class="text-[#ffc98a]">1688</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f3bb34]/50 pl-4 text-sm leading-relaxed text-[#d8c69b]">
          {BRAND_NAME} สล็อตพีจีเว็บเป็ด รวบรวมเกมสล็อตจากค่ายหลักไว้ให้เลือกหลายรูปแบบ ทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมที่มีฟีเจอร์พิเศษ รองรับการเข้าเล่นผ่านมือถือ
          โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม สมาชิกค้นหาเกม เลือกยอดเดิมพัน และตรวจสอบรายละเอียดของแต่ละค่ายได้จากระบบเดียว ส่วนคำว่าทุนน้อยกำไรงามไม่ได้หมายความว่าจะได้กำไรทุกครั้ง
          เพราะผลการเล่นเป็นแบบสุ่มและมีโอกาสเสียเงินเดิมพัน
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f3bb34]/35 bg-[#0d0903] px-4 py-1 text-xs font-medium text-[#fde464] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8%</span>
          <span class="rounded-full border border-[#f58b2a]/45 bg-[#171106] px-4 py-1 text-xs font-medium text-[#ffc98a] backdrop-blur-sm">คืนยอดเสีย โบนัส 0.3%</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fde464] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f3bb34]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d8c69b]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#fde464]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fde464] uppercase drop-shadow-sm">แอดมิน 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f3bb34]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#f58b2a]/50 bg-[#171106]/80 py-3 text-sm font-bold text-[#f6ecd9] transition-all hover:bg-[#1f1709]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#d8c69b] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#d8c69b] md:block">
      {BRAND_NAME} สล็อตพีจีเว็บเป็ด รวมเกมเดิมพันจากค่ายหลักไว้ให้เลือกตามรายการที่เปิดให้บริการ ทั้งสล็อตวงล้อทั่วไป เกมฟรีสปิน เกมที่มีโบนัสตัวคูณ และเกมที่มีฟีเจอร์พิเศษ
      สมาชิกเข้าเล่นผ่านมือถือได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่มเติม และค้นหาเกม เลือกยอดเดิมพัน รวมถึงตรวจสอบรายละเอียดของแต่ละค่ายได้จากระบบเดียว ช่วงเดิมพันและรูปแบบโบนัสขึ้นอยู่กับ
      เกมและค่ายที่เลือก จึงไม่ควรถือว่าทุกเกมเริ่มต้นที่ยอดเดียวกันทั้งหมด ควรเปิดตารางจ่ายและตรวจสอบช่วงเดิมพันก่อนเริ่มเล่นทุกครั้ง โปรโมชั่นที่ระบุไว้สำหรับหน้านี้คือโบนัสคืนยอดเสีย 0.3%
      และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนดรอบคำนวณ ประเภทเกม ยอดที่เข้าเกณฑ์ และระยะเวลาใช้โบนัสต่างกัน ให้ยึดรายละเอียดล่าสุดที่แสดงในหน้าโปรโมชั่น ณ เวลากดรับสิทธิ์เป็นหลัก
      หากพบปัญหาเกี่ยวกับเกมควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ส่วนเรื่องบัญชีหรือธุรกรรมควรเตรียมข้อมูลรายการที่เกี่ยวข้องไว้สำหรับตรวจสอบ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP
      ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม คำว่าการันตีความน่าเชื่อถือควรพิจารณาจากข้อมูลผู้ดำเนินงาน ช่องทางติดต่อ และรายละเอียดค่ายเกมที่ตรวจสอบได้ เพราะ
      ข้อความว่าไม่ผ่านเว็บเอเย่นต์เพียงอย่างเดียวไม่ได้รับประกันว่าผลการเล่นจะมีกำไรหรือธุรกรรมจะไม่มีความเสี่ยง
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a5f08]/50 pt-8 text-xs font-medium tracking-wide text-[#d8c69b] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fde464]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fde464]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
