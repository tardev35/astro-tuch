---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): ไฟล์นี้เป็น footer ที่ใช้งานจริงรอบนี้
// (รอบก่อน หวย365 ใช้ FooterHuay) ของเดิมที่ค้างอยู่เป็นพาเลตต์ทอง-แดงของ GOT777
// ซึ่งเอาแดงมาจากเลข 777 ในโลโก้ของแบรนด์นั้น — ทั้งสีและเนื้อหาถูกเขียนใหม่หมดแล้ว
//
// คู่สีรองรอบนี้เป็น "เงินโครเมียม" ไม่ใช่แดง เพราะโลโก้ 1SS365 เป็นสองโลหะจริง:
// เหรียญเลข 1 ทอง · ตัวอักษร 1SS เงินโครเมียม · เลข 365 ทอง แดง #d21622/#f3b0b5
// ของ GOT777 จึงถูกแทนด้วย #c8cbce/#e6e9eb ทั้งหมด
//
// ⚠️ เนื้อความรอบนี้พูดถึง "เกมสล็อต" อย่างเดียว บรีฟของ 1SS365 ระบุเฉพาะสล็อตจาก
// แพลตฟอร์มต่างประเทศเท่านั้น — คำว่า บาคาร่า รูเล็ต ไฮโล บอล และคำหวยทุกคำ
// (แทงหวย ส่งโพย อัตราจ่าย งวด ฮานอย ลาวพัฒนา) ถูกถอดออกทั้งหมด ห้ามเติมกลับ
// และห้ามอ้างใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ หรือตัวเลข RTP เพราะ
// บรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มีสี่ตัวคือ 0.3% · 0.8% · 24 ชั่วโมง · 100%
// และข้อความโฆษณาของแบรนด์ (แตกง่าย จ่ายไว ไม่ติดสแกม มั่นใจได้ 100%) ต้องมา
// พร้อมคำกำกับของบรีฟเองเสมอว่าเป็นลักษณะเชิงโฆษณา ใช้รับประกันผลไม่ได้
//
// ลิงก์ /ตรวจหวย กับ /แนวทาง ไม่มีในนี้ และห้ามเติม — 1SS365 ไม่ใช่เว็บหวย สองหน้า
// นั้นถูกย้ายกลับไปไว้ใน src/pages-disabled/ แล้ว การทิ้งลิงก์ไว้จะเป็น href ที่ชี้ไป
// route ที่ไม่มีจริง ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// แกนสี: พื้นดำ #050505 ยกระดับด้วย #121010 / #1a1710 / #2a2115 · ทองแบรนด์
// #edbb23 (vivid ของ logo.webp) เป็นขอบและเส้นคั่น · ทองอ่อน #ffeeb4 เป็นหัวคอลัมน์
// และลิงก์ hover · ทองลึก #a87708 เป็นเส้นคั่นท้ายหน้า · เงินโครเมียม #c8cbce เป็น
// คู่สีรอง เงินสว่าง #e6e9eb เวลาใช้เป็นตัวอักษร · เนื้อความหลัก #f0e6d2
// (BRAND_TEXT) เนื้อความรอง #cfc2a6
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#edbb23]/60 bg-[#050505] pt-16 pb-8 font-sans text-[#f0e6d2] shadow-[0_-15px_40px_rgba(237,187,35,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#edbb23]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#c8cbce]/16 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#edbb23]/30 bg-[#121010] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ 1SS365 เป็นวงกลมโลหะเงินขอบทองมีเลข 1 สีทองสามมิตินูนอยู่ข้างใน ถัดมาเป็นตัวอักษร 1SS สีเงินโครเมียม ต่อด้วยเลข 365 สีทองสามมิติ"
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#e6e9eb]">
                1SS<span class="text-[#ffeeb4]">365</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#edbb23]/50 pl-4 text-sm leading-relaxed text-[#cfc2a6]">
          {BRAND_NAME} ให้บริการเกมสล็อตออนไลน์จากแพลตฟอร์มต่างประเทศ รวมเกมหลายรูปแบบไว้ให้เลือกผ่านบัญชีเดียว ทั้งสล็อตคลาสสิก ฟรีสปิน ตัวคูณ และเกมโบนัส รองรับการเข้าเล่นผ่านมือถือ
          โดยไม่ต้องสลับหลายเว็บไซต์ สมาชิกตรวจสอบค่ายเกม เครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียว ส่วนคำว่าแตกง่ายหรือจ่ายไวเป็นลักษณะเชิงโฆษณา
          ไม่สามารถใช้รับประกันผลการเล่นหรือระยะเวลาของธุรกรรมได้ในทุกกรณี
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#edbb23]/35 bg-[#121010] px-4 py-1 text-xs font-medium text-[#ffeeb4] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8%</span>
          <span class="rounded-full border border-[#c8cbce]/40 bg-[#1a1710] px-4 py-1 text-xs font-medium text-[#e6e9eb] backdrop-blur-sm">คืนยอดเสีย โบนัส 0.3%</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffeeb4] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#edbb23]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#cfc2a6]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#ffeeb4]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffeeb4] uppercase drop-shadow-sm">เจ้าหน้าที่ 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#edbb23]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#c8cbce]/50 bg-[#1a1710]/70 py-3 text-sm font-bold text-[#f0e6d2] transition-all hover:bg-[#2a2115]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#cfc2a6] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#cfc2a6] md:block">
      {BRAND_NAME} รวมเกมสล็อตออนไลน์จากแพลตฟอร์มต่างประเทศไว้ให้เลือกตามรายการที่เปิดให้บริการ ทั้งสล็อตคลาสสิก เกมที่มีฟรีสปิน เกมที่มีตัวคูณ และเกมโบนัสตามค่ายที่ระบบเปิดให้ใช้งาน
      สมาชิกใช้บัญชีเดียวเข้าเล่นผ่านมือถือได้โดยไม่ต้องสลับหลายเว็บไซต์ และตรวจสอบค่ายเกม เครดิต โปรโมชั่น รวมถึงประวัติรายการได้จากระบบเดียว ยอดเดิมพันขั้นต่ำและสูงสุดขึ้นอยู่กับ
      ค่ายและเกมที่เลือก จึงไม่ควรถือว่าทุกเกมไม่มีขั้นต่ำเหมือนกันทั้งหมด ควรเปิดข้อมูลเกมและตรวจสอบช่วงเดิมพันก่อนเริ่มเล่นทุกครั้ง โปรโมชั่นที่ระบุไว้สำหรับหน้านี้คือโบนัสคืนยอดเสีย 0.3%
      และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนดรอบคำนวณ ค่ายเกม ยอดที่เข้าเกณฑ์ และระยะเวลารับโบนัสต่างกัน ให้ยึดรายละเอียดล่าสุดที่แสดงในหน้าโปรโมชั่น ณ เวลากดรับสิทธิ์เป็นหลัก
      หากเครดิตไม่แสดงหรือรายการฝากถอนอยู่ระหว่างตรวจสอบ ควรเก็บหลักฐาน เวลา และจำนวนเงินไว้จนกว่าการตรวจสอบจะเสร็จสิ้น และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้เจ้าหน้าที่หรือบุคคลอื่น
      คำว่าไม่ติดสแกมหรือมั่นใจได้ 100% ควรมีข้อมูลที่ตรวจสอบได้รองรับ เช่น ผู้ดำเนินงาน ช่องทางติดต่อ ระบบรักษาความปลอดภัย และรายละเอียดธุรกรรม เพราะการเป็นเว็บต่างประเทศหรือ
      ไม่ผ่านเอเย่นต์เพียงอย่างเดียวไม่ได้รับประกันว่าเว็บไซต์หรือธุรกรรมจะปลอดภัย 100%
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a87708]/40 pt-8 text-xs font-medium tracking-wide text-[#cfc2a6] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffeeb4]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffeeb4]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
