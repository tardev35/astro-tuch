---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ KINDEE365 ตัวอักษร KINDEE สีฟ้าไล่เฉดเป็นประกายโครเมียม วางเหนือเลข 365 สีทองขัดเงา คั่นด้วยเส้นโค้งสีทองบาง มุมซ้ายบนมีประกายดาวสีทอง";

// KINDEE365 เป็นเว็บหวย /ตรวจหวย กับ /แนวทาง จึงอยู่ใน src/pages/ และต้องมีลิงก์
// ที่นี่ด้วย ไม่ใช่แค่ในเมนูบน ส่วน /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มี
// รายการในเมนูบน เพราะ /register กับ /login เป็นหน้าจริงแล้ว) ลิงก์นี้จึงไม่ตาย
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทางหวย", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e8bb4a]/60 bg-[#010b26] pt-16 pb-8 font-sans text-[#cfe3f7] shadow-[0_-15px_40px_rgba(232,187,74,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e8bb4a]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#2b8ae9]/28 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e8bb4a]/30 bg-[#02153c] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#a3dbfb]">
                KINDEE<span class="text-[#f8dc8c]">365</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e8bb4a]/50 pl-4 text-sm leading-relaxed text-[#8fb3d9]">
          {BRAND_NAME} เปิดบริการแทงหวยออนไลน์ผ่านระบบที่ใช้งานง่ายบนมือถือและคอมพิวเตอร์ มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ สมาชิกตรวจสอบเรท ส่งโพย ฝากถอน
          และติดตามประวัติรายการได้จากบัญชีของตนเอง โดยเวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของแต่ละรอบอาจต่างกัน ควรตรวจสอบให้ครบก่อนยืนยันโพยทุกครั้ง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e8bb4a]/35 bg-[#02153c] px-4 py-1 text-xs font-medium text-[#f8dc8c] backdrop-blur-sm">3 ตัวบาทละ 1,000</span>
          <span class="rounded-full border border-[#2b8ae9]/45 bg-[#083163] px-4 py-1 text-xs font-medium text-[#a3dbfb] backdrop-blur-sm">2 ตัวบาทละ 100</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f8dc8c] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#e8bb4a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#8fb3d9]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#f8dc8c]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f8dc8c] uppercase drop-shadow-sm">เจ้าหน้าที่ 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#e8bb4a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#2b8ae9]/55 bg-[#083163]/70 py-3 text-sm font-bold text-[#a3dbfb] transition-all hover:bg-[#124a94]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#8fb3d9] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#8fb3d9] md:block">
      {BRAND_NAME} จัดหมวดหวยออนไลน์หลายประเภทไว้ให้เลือกตามรอบที่เปิดบริการ ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ อัตราจ่ายที่ระบุไว้สำหรับหน้านี้คือเลข 3 ตัว
      บาทละ 1,000 และเลข 2 ตัวบาทละ 100 อย่างไรก็ตามควรตรวจสอบตัวเลขที่แสดงจริงในระบบก่อนยืนยันทุกครั้ง เพราะประเภทหวยหรือรอบเดิมพันอาจมีเงื่อนไขแตกต่างกัน ข้อความ “รับทุกเลข”
      และ “จ่ายไม่อั้น” ให้ยึดวงเงินและเงื่อนไขที่ระบบแสดง ณ เวลาส่งโพยเป็นหลัก เนื่องจากบางเลขหรือบางรอบอาจมีข้อกำหนดเฉพาะ ก่อนทำธุรกรรมฝากถอนควรตรวจสอบชื่อบัญชี จำนวนเงิน
      ยอดขั้นต่ำ และวงเงินต่อรายการให้ถูกต้อง หากเครดิตไม่เข้าหรือรายการถอนค้าง ควรเก็บหลักฐานรายการไว้ประกอบการตรวจสอบกับเจ้าหน้าที่ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      ผลของการเดิมพันมีความไม่แน่นอน จึงไม่มีรอบหรือบัญชีผู้เล่นใดที่รับประกันผลตอบแทนได้
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#b98213]/40 pt-8 text-xs font-medium tracking-wide text-[#8fb3d9] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f8dc8c]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f8dc8c]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
