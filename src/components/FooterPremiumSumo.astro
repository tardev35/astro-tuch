---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น footer ที่ใช้
// งานจริงรอบนี้ (รอบก่อน MAHAGAME66 ใช้ FooterStyle2) ของเดิมที่ค้างอยู่เป็น
// พาเลตต์น้ำเงิน-ทองของ KINDEE365 ซึ่งเป็นเว็บหวย — ทั้งสีและเนื้อหาถูกเขียนใหม่
// หมดแล้ว รวมถึงลิงก์ /ตรวจหวย กับ /แนวทาง ที่ถอดออก เพราะ UWIN33 ไม่ใช่เว็บหวย
// เฉพาะทาง สองหน้านั้นถูกปิดไว้ใน src/pages-disabled/ การทิ้งลิงก์ไว้จะเป็น href
// ที่ชี้ไป route ที่ไม่มีจริง ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// แกนสี: พื้นดำอมน้ำตาล #0a0702 ยกระดับด้วย #161106 / #26200e · ทองแบรนด์
// #e0b429 เป็นขอบและเส้นคั่น · ทองอ่อน #fde9a3 เป็นหัวคอลัมน์และลิงก์ hover ·
// เงินโครเมียม #dfe4ec เป็นคู่สีรอง (ตามโลโก้ที่ WIN เป็นเงิน) · เนื้อความหลัก
// #ece6d8 (BRAND_TEXT) เนื้อความรอง #b8b09c
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e0b429]/60 bg-[#0a0702] pt-16 pb-8 font-sans text-[#ece6d8] shadow-[0_-15px_40px_rgba(224,180,41,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e0b429]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#dfe4ec]/14 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e0b429]/30 bg-[#161106] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ UWIN33 ตัวอักษรตัวหนาสามมิติ ตัว U และเลข 33 เป็นสีทองขัดเงา ส่วนคำว่า WIN ตรงกลางเป็นสีเงินโครเมียม"
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#fde9a3]">
                U<span class="text-[#dfe4ec]">WIN</span>33
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e0b429]/50 pl-4 text-sm leading-relaxed text-[#b8b09c]">
          {BRAND_NAME} รวมเกมเดิมพันหลายประเภทสำหรับผู้ใช้งานชาวไทยไว้ในระบบเดียว ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย พร้อมเมนูที่แบ่งหมวดชัดเจน รองรับการเข้าใช้งานผ่านมือถือและคอมพิวเตอร์
          สมาชิกเลือกเกมที่สนใจ ตรวจสอบรายละเอียด และจัดการบัญชีได้จากที่เดียวโดยไม่ต้องสลับใช้งานหลายเว็บไซต์ ทั้งนี้เงื่อนไข รอบรับสิทธิ์ และรายการที่เปิดให้บริการของแต่ละหมวดอาจต่างกัน
          ควรตรวจสอบข้อมูลที่ระบบแสดงก่อนใช้งานทุกครั้ง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e0b429]/35 bg-[#161106] px-4 py-1 text-xs font-medium text-[#fde9a3] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8%</span>
          <span class="rounded-full border border-[#dfe4ec]/35 bg-[#26200e] px-4 py-1 text-xs font-medium text-[#dfe4ec] backdrop-blur-sm">คืนยอดเสีย โบนัส 0.3%</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fde9a3] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#e0b429]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#b8b09c]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#fde9a3]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fde9a3] uppercase drop-shadow-sm">เจ้าหน้าที่ 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#e0b429]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#dfe4ec]/45 bg-[#26200e]/70 py-3 text-sm font-bold text-[#dfe4ec] transition-all hover:bg-[#3a3116]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#b8b09c] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#b8b09c] md:block">
      {BRAND_NAME} จัดหมวดเกมเดิมพันไว้ให้เลือกตามรายการที่เปิดให้บริการ ทั้งบาคาร่า รูเล็ต ไฮโล สล็อต บอล และหวย โดยรายละเอียดของแต่ละหมวด รูปแบบการเดิมพัน และช่วงเวลาที่เปิดให้ใช้งาน
      อาจแตกต่างกัน ควรตรวจสอบข้อมูลที่ระบบแสดงจริงก่อนเข้าเล่นทุกครั้ง โปรโมชั่นที่ระบุไว้สำหรับหน้านี้คือโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ซึ่งแต่ละรายการมีเงื่อนไข
      รอบคำนวณ และยอดที่เข้าเกณฑ์ต่างกัน ให้ยึดรายละเอียดที่แสดงในหน้าโปรโมชั่น ณ เวลากดรับสิทธิ์เป็นหลัก ก่อนทำธุรกรรมฝากถอนควรตรวจสอบชื่อบัญชี จำนวนเงิน ยอดขั้นต่ำ
      และวงเงินต่อรายการให้ถูกต้อง หากเครดิตไม่เข้าหรือรายการถอนค้าง ควรเก็บหลักฐานรายการไว้ประกอบการตรวจสอบกับเจ้าหน้าที่ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP ให้บุคคลอื่น
      ผลของการเดิมพันมีความไม่แน่นอน จึงไม่มีเกมหรือบัญชีผู้เล่นใดที่รับประกันผลตอบแทนได้
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#b8860b]/40 pt-8 text-xs font-medium tracking-wide text-[#b8b09c] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fde9a3]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fde9a3]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
