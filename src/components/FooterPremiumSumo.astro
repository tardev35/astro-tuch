---
import { Image } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// 123BET (รอบแดงชาดนำ + เงินโครเมียม/ทองอำพันรอง **เนื้อหาสว่าง โครมเข้ม**
// 2026-10-28): ไฟล์นี้เป็น footer ที่ใช้งานจริงรอบนี้ — หมุนออกจาก `FooterCyber`
// ของ ZORO365 ซึ่งเป็นแผ่น rounded-t-[3rem] ที่มีออราคร่อมสองขอบ **กริด 12
// คอลัมน์แบ่ง 5/3/4 เหมือนกัน** แต่คนละไฟล์และคนละรายละเอียด: ไฟล์นี้มี
// **ย่อหน้าเนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์** และ **ไม่มีการ์ด CTA ลอย**
//
// 🚨🚨 **กับดักรอบนี้คือแดง ไม่ใช่สีแปลกปลอม** — แดงเคยนำมาแล้วหลายแบรนด์ในรีโปนี้
// (MEXICANOSLOT ซึ่งเป็นแบรนด์ล่าสุดที่ ship ไฟล์นี้ · LOTTO189 · สล็อต168 ·
// มาดาม168 · รวยแท้168 · ดวงเศรษฐี168 · GT66B) จึง **ห้ามตัดสินด้วยตา ต้องเทียบ
// ทีละค่า** แดงของรอบนี้คือ **#a30d1a** (R163 G13 B26) คู่กับ **แดงสด #c21325**
// **แดงเลือดหมู #8a1420** และ **แดงไฮไลต์บนโครม #ef4a5e**
// ตัวที่ใกล้ที่สุดในรีโปคือ **a81410 ของ MEXICANOSLOT** (ห่าง R5/G7/B6) และ
// **c1071b / b00718 ของ LOTTO189** — ให้ grep เป็นค่าทีละตัวกับตารางใน
// .claude/brand-spec-123bet.md §2
// ⚠️ ค่า vivid ดิบของ logo.webp รอบนี้คือ ac0404 ซึ่งดิบเกินไปสำหรับ UI — รอบนี้จึง
// เลื่อนมาที่ #a30d1a / #c21325 / #8a1420 **ห้ามใช้ค่าดิบ**
// ไฟล์นี้เคยค้างชุดแดงเม็กซิกัน-ทองส้มของ MEXICANOSLOT มาเต็มไฟล์ (de2b1e a81410
// c81e12 9d140c 6f0e08 2b100a 431a10 1d0a06 8c3a22 fdeee2 f2a033 f2543f และ rgba
// ของแดงนั้น) — กวาดออกครบแล้ว ไม่เหลือสักค่า
// ⚠️ **เขียวมรกตของ ZORO365 รอบก่อนก็ไม่มีในไฟล์นี้เลยสักเฉด** (073c1a 0e5424
// 1e7033 35a043 3ddc4a e8c86a eef7f0 9dc2a5)
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// แกนสี: **โครมเข้มคร่อมเนื้อหาสว่าง** — พื้นเพจเป็น #f7e4e9 ชมพูบลัชจาง (จาก
// bg.json) ส่วน footer เป็นพื้นถม #330710 กลาง / #4d0c18 ยก / #1c050b ลึก ·
// ทองอำพัน #dca53a เป็นหัวข้อคอลัมน์ เส้นคั่น ขอบ และสีลิงก์ hover (8.1:1) ·
// แดงชาด #a30d1a เป็นพื้นถมป้ายใบที่สอง · #8a1420 เป็นเส้นคั่น · ออราขอบบนเป็น
// #a30d1a ออราขอบล่างเป็น #1c050b · เนื้อความ #fdf5f6 (16.6:1 บน #330710)
// ⚠️ **#a30d1a ห้ามถือตัวอักษรบนพื้นโครม** (2.3:1 บน #330710 = ตก AA ขาดลอย)
// ใช้เป็นขอบ/พื้นถม/ออราเท่านั้น ป้าย "แนะนำเพื่อน 0.8%" จึงเป็น **ถมแดงชาด #a30d1a
// แล้ววางตัวอักษรขาวทับ** (8.0:1 ผ่าน AA) ไม่ใช่ตัวอักษรแดงบนพื้นเข้ม
// ⚠️ **ทอง #dca53a บนพื้นโครมได้ 8.1:1 ผ่านสบาย แต่บนผิวการ์ดสว่าง #fdf5f6 ได้แค่
// 2.1:1** — ค่านี้จึงห้ามหลุดออกจากไฟล์โครมไปถือตัวอักษรใน ContentBox ใดๆ
// (ทองที่ถือตัวอักษรบนการ์ดสว่างได้คือ #7a4a0c เท่านั้น) เช่นเดียวกับ #ef4a5e
// ซึ่งเป็น **ออรา/ขอบเท่านั้น ห้ามถือตัวอักษรทุกบริบท**
//
// ⚠️ แกนเนื้อหารอบนี้คือ **เว็บเกมคาสิโนออนไลน์** (บรีฟเรียกตัวเองว่า "เจ้าของ
// บาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์" และระบุ **เจ็ดหมวดเกม**: บาคาร่า ·
// สล็อตออนไลน์ · ไฮโล · รูเล็ต · ยิงปลา · เดิมพันฟุตบอล · หวยออนไลน์) —
// ย่อหน้าท้ายฟุตเตอร์เดิมเป็นคลังคำของ MEXICANOSLOT (สล็อตเมกซิกัน · ส่งตรงจาก
// เม็กซิโก · ไม่ผ่านเอเย่นต์ · ยอดเข้าบริษัท) ถูกเขียนใหม่หมดทั้งย่อหน้าแล้ว
// **ห้ามเติมกลับแม้แต่คำเดียว** บรีฟรอบนี้ไม่มีคำพวกนั้นเลยสักคำ
// 🚨 **"เว็บตรง" กับ "ถูกลิขสิทธิ์" เป็นถ้อยคำของบรีฟรอบนี้เอง** (บรรทัด 1-3)
// ต่างจาก "เว็บตรงไม่ผ่านเอเย่นต์" ของ ZANE96 และ "การันตีเว็บตรง" ของ
// MEXICANOSLOT ซึ่งเป็นคนละวลี — **ใช้ของบรีฟได้ อย่าสลับกลับไปเป็นของแบรนด์เก่า**
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// ห้ามเขียนเรื่องฝากถอน ทรูวอลเลท หรือออโต้ที่ไหนในไฟล์นี้
// ⚠️ ห้ามระบุชื่อค่ายเกม ชื่อธนาคาร ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ค่า RTP
// เป็นตัวเลข จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟไม่ได้ให้มาสักตัว ตัวเลขที่อ้างได้
// มีสี่ตัวเท่านั้นคือ **0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง** และทุกประโยคกำกับ
// ของบรีฟต้อง ship ครบ (บรีฟรอบนี้โฆษณาแล้วเบรกเองตลอด ครึ่งที่เบรกคือเนื้อหา
// ไม่ใช่ filler)
//
// ⚠️ **ไฟล์นี้ไม่ render BankStrip** และนั่นคือเหตุผลหนึ่งที่เลือกไฟล์นี้รอบนี้:
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารหรือวอลเลทแม้แต่แห่งเดียว** แถบโลโก้ธนาคารคือ
// การอ้างว่ารองรับธนาคารชุดนั้นจริง ซึ่งไม่มีอะไรในบรีฟรองรับ ไฟล์ BankStrip.astro
// ยังอยู่ครบในฐานะ inventory **ห้ามลบ**
//
// ลิงก์ของ **สองหน้าหวยที่ปิดอยู่รอบนี้** (/ตรวจหวย · /แนวทาง) ไม่มีในไฟล์นี้
// และห้ามเติมกลับ — รอบนี้เป็นเว็บคาสิโน ไม่ใช่เว็บหวย สองหน้านั้นจอดอยู่ใน
// src/pages-disabled/ ซึ่ง Astro ไม่ route ให้ การทิ้งลิงก์ไว้จึงเป็น href ที่ชี้
// route ที่ไม่มีจริง และ verify-build.mjs จะทำให้ build แดง
// route ที่มีจริงรอบนี้: / /about-us /contact-us /login /privacy /promotion /register
// /terms /ทดลองเล่น /ทางเข้า /line
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ cta toggle เปิด
// และ /register กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// ⚠️ ไฟล์นี้เป็นโครมที่ render ทุกหน้า จึง **ห้ามมี heading tag ทุกระดับ** หัวข้อคอลัมน์
// เป็น <p> ที่ถือคลาสเดิมไว้ และ <nav>/<section> ที่เสียชื่อเรียกไปใช้ aria-label แทน
//
// บล็อก <address> ด้านล่างคัดลอกจาก SKILL.md แบบ verbatim — ห้ามใส่ hex ของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer ทุกตัวใน
// ไลบรารีซึ่งเป็นพื้นเข้มหมด รวมถึงรอบนี้ที่ตัวเพจสว่างแต่ footer เข้ม
// ที่อยู่กับอีเมลมาจาก BRAND_ADDRESS ล้วน (อนุมานจาก BRAND_NAME + site:) ห้ามพิมพ์เอง
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-28 ที่เปิดอ่านจริง — **ไม่มี** ชายการ์ตูน
// ไว้หนวด ซอมเบรโร ปอนโช หรือธงชาติเม็กซิโกของ MEXICANOSLOT อยู่ในรูปนี้เลย
// และ **ไม่มี** วงพู่กันหมึกดำ-เขียวหรือดาบคาทานะของ ZORO365 เช่นกัน
// ชื่อแบรนด์ interpolate เสมอ **ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลง alt ตรงๆ**
//
// ไฟล์ต้นทางเป็นจัตุรัส 500x500 และกล่องนี้วาดมันสูง 36px → กว้าง 36px เช่นกัน
// widths/sizes จึงอิง 36px ไม่ใช่ความกว้างของกล่อง
//
// ⚠️ **เป็น <Image format="webp"> ไม่ใช่ <Picture> ที่มี avif โดยตั้งใจ** — ที่
// 36w/72w/108w ค่าโสหุ้ยของคอนเทนเนอร์ AVIF กินมากกว่าที่มันประหยัดได้ ซึ่ง
// `tools/verify-build.mjs` ทำให้ build แดงถูกต้องแล้ว เพราะเบราว์เซอร์ที่รองรับ avif
// จะหยิบไฟล์ที่ **ใหญ่กว่า** การลด quality ไม่ช่วยเพราะพื้นของ avif อยู่ที่
// ~700 ไบต์ไม่ว่าจะลดแค่ไหน **ห้ามเติม avif กลับเข้ามาที่ขนาดนี้**
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นเวิร์ดมาร์กสามมิติตัวหนา ครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา เหนือตัวอักษรเป็นมงกุฎผิวเงินประดับเบาะกำมะหยี่สีแดงและอัญมณีแดง ทั้งชุดวางทับโล่ตราสัญลักษณ์ผิวโครเมียมเงินที่มีริบบิ้นโค้งสองข้างและเพชรสีแดงเจียระไนอยู่ที่ปลายแหลมด้านล่าง`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#8a1420] bg-[#330710] pt-16 pb-8 font-sans text-[#fdf5f6] shadow-[0_-15px_40px_rgba(163,13,26,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#a30d1a]/25 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#1c050b]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a
          href="/"
          class="flex h-[56px] max-w-max items-center gap-3 overflow-hidden rounded-xl border border-[#8a1420] bg-[#1c050b] px-5 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Image
                src={mainLogo}
                alt={logoAlt}
                widths={[36, 72, 108]}
                sizes="36px"
                quality={65}
                loading="lazy"
                decoding="async"
                class="h-[36px] w-auto object-contain"
                format="webp"
              />
            ) : (
              <span class="text-2xl font-black tracking-widest text-[#dca53a]">{BRAND_NAME}</span>
            )
          }
          <span class="text-xl font-black tracking-wide text-[#dca53a]">{BRAND_NAME}</span>
        </a>
        <p class="border-l-2 border-[#dca53a] pl-4 text-sm leading-relaxed text-[#fdf5f6]/85">
          {BRAND_NAME} นำเสนอข้อมูลเกมคาสิโนออนไลน์หลายหมวดหมู่ ทั้งบาคาร่า สล็อตออนไลน์ ไฮโล รูเล็ต ยิงปลา เดิมพันฟุตบอล และหวยออนไลน์ รวมกติกาเกมและรายละเอียดโปรโมชั่นไว้ในเว็บไซต์เดียว
          ทั้งนี้ คำกล่าวอ้างเกี่ยวกับการเป็นเจ้าของระบบเกม เว็บตรง และลิขสิทธิ์ถูกต้อง ควรตรวจสอบข้อมูลบริษัทและหลักฐานการได้รับอนุญาตจากแหล่งที่เชื่อถือได้ก่อนใช้งาน
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#8a1420] bg-[#4d0c18] px-4 py-1 text-xs font-medium text-[#fdf5f6]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน</span>
          <span class="rounded-full border border-[#1c050b] bg-[#a30d1a] px-4 py-1 text-xs font-medium text-white">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#dca53a] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#dca53a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fdf5f6]/85">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#dca53a]">{link.name}</a></li>)}
        </ul>
      </nav>

      <section aria-label="ช่องทางติดต่อเจ้าหน้าที่" class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#dca53a] uppercase drop-shadow-sm">แอดมินออนไลน์ 24ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#dca53a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#8a1420] bg-[#4d0c18]/80 py-3 text-sm font-bold text-[#fdf5f6] transition-all hover:bg-[#4d0c18]"
