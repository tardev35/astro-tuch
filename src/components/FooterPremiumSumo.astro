---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12): ไฟล์นี้เป็น footer ที่ใช้งานจริงรอบนี้
// (รอบก่อน PUNPRO168 ใช้ FooterStyle2) ของเดิมที่ค้างอยู่เป็นพาเลตต์ทองเป็ด-ส้ม
// ปากเป็ดของ DUCK1688 ซึ่งเอาส้มมาจากปากเป็ดในโลโก้ของแบรนด์นั้น — ทั้งสีและ
// เนื้อหาถูกเขียนใหม่หมดแล้ว
//
// รอบนี้ **ไม่มีคู่สีรอง** เลย เพราะโลโก้ TND168 เป็นเหรียญตรามังกรจีนทองขัดเงา
// กับตัวอักษร TND168 ทองสามมิติ บนพื้นดำล้วน ไม่มีโลหะหรือสีที่สองในงานศิลป์
// ส้ม #f58b2a/#ffc98a ของ DUCK1688 จึงถูกแทนด้วย "ทองอีกระดับหนึ่ง" (#ffc93d /
// #ffe4a3) ไม่ใช่ด้วยสีใหม่ — ป้ายสองใบในคอลัมน์แรกต่างกันที่ค่าของทองเดียวกัน
//
// ⚠️ เนื้อความรอบนี้เป็น **คาสิโนรวมทุกหมวด** ตามบรีฟ: บาคาร่า สล็อต รูเล็ต ไฮโล
// แทงบอล และคาสิโนไลฟ์สด — ต่างจากรอบก่อนที่เป็นสล็อตล้วน คำของแบรนด์ก่อน
// (สล็อตปันโปรในตำนาน เว็บเล่นสล็อตออนไลน์ เว็บตรงในตำนาน ทางเข้าเล่นใหม่ 2026
// ฝากถอนเข้า บช. บริษัทตรง) และคำขายของของแบรนด์เก่าๆ (เว็บเป็ด สล็อตพีจี
// ทุนน้อยกำไรงาม ไม่ผ่านเอเย่นต์ การันตีเว็บแท้) ถูกถอดออกหมด ห้ามเติมกลับ
// และห้ามอ้างใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร ยอดฝากขั้นต่ำ ค่า RTP หรือที่ตั้ง
// เซิร์ฟเวอร์ เพราะบรีฟไม่ได้ระบุไว้ — บรีฟถึงกับบอกเองว่าจำนวนค่ายและที่ตั้ง
// เซิร์ฟเวอร์ "ควรตรวจสอบจากข้อมูลผู้ให้บริการจริง" ตัวเลขที่อ้างได้มีสี่ตัวคือ
// 0.3% · 0.8% · 3 ขั้นตอน · 24 ชั่วโมง
//
// ลิงก์ /ตรวจหวย กับ /แนวทาง ไม่มีในนี้ และห้ามเติม — TND168 ไม่ใช่เว็บหวย สองหน้า
// นั้นอยู่ใน src/pages-disabled/ การทิ้งลิงก์ไว้จะเป็น href ที่ชี้ไป route ที่ไม่มีจริง
// ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// แกนสี: พื้นดำสนิท #000000 (ตรงกับ bg.json) ยกระดับด้วย #070502 / #120c04 /
// #1b1307 · ทองหลัก #dfa310 (ฮิวเดียวของแบรนด์) เป็นขอบและเส้นคั่น · ทองสว่าง
// #ffe4a3 เป็นหัวคอลัมน์และลิงก์ hover · ทองไฮไลต์ #ffc93d เป็นป้ายโปรโมชั่นใบที่
// สอง · ทองลึก #8a5c09 เป็นเส้นคั่นท้ายหน้า · บรอนซ์ลึก #43240b เป็นออรามุมล่าง ·
// เนื้อความหลัก #f0e9dc (BRAND_TEXT) เนื้อความรอง #c9b88e
// ⚠️ #8a5c09 และ #43240b ห้ามถือตัวอักษรทุกขนาด ใช้เป็นเส้น ขอบ และออราเท่านั้น
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#dfa310]/60 bg-[#000000] pt-16 pb-8 font-sans text-[#f0e9dc] shadow-[0_-15px_40px_rgba(223,163,16,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#dfa310]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#43240b]/55 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#dfa310]/30 bg-[#070502] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ TND168 เป็นเหรียญตรากลมพื้นดำ มีมังกรจีนสีทองขัดเงาขดตัวล้อมรอบ หัวมังกรหันไปทางขวาและอ้าปาก ด้านล่างเป็นลายเมฆทอง พาดกลางเหรียญเป็นคำว่า TND168 ตัวอักษรเซริฟสีทองสามมิติ"
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffe4a3]">
                TND<span class="text-[#ffc93d]">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#dfa310]/50 pl-4 text-sm leading-relaxed text-[#c9b88e]">
          {BRAND_NAME} แบรนด์คาสิโนเซิร์ฟไทย ที่นำเสนอเกมเดิมพันออนไลน์หลายประเภทไว้ในแพลตฟอร์มเดียว ทั้งบาคาร่า สล็อต รูเล็ต ไฮโล และแทงบอล พร้อมหมวดคาสิโนไลฟ์สดสำหรับผู้ที่สนใจเกมถ่ายทอดสดจากโต๊ะจริง
          รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ สมาชิกสามารถ Login เพื่อค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้ ส่วนจำนวนค่ายที่เปิดให้บริการและที่ตั้งเซิร์ฟเวอร์ในประเทศไทย
          ควรตรวจสอบจากข้อมูลผู้ให้บริการจริง และไม่มีเกมประเภทใดรับประกันผลตอบแทน
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#dfa310]/35 bg-[#070502] px-4 py-1 text-xs font-medium text-[#ffe4a3] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8%</span>
          <span class="rounded-full border border-[#ffc93d]/45 bg-[#120c04] px-4 py-1 text-xs font-medium text-[#ffc93d] backdrop-blur-sm">คืนยอดเสีย 0.3%</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe4a3] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#dfa310]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#c9b88e]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#ffe4a3]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe4a3] uppercase drop-shadow-sm">แอดมิน 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#dfa310]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#dfa310]/50 bg-[#120c04]/80 py-3 text-sm font-bold text-[#f0e9dc] transition-all hover:bg-[#1b1307]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#c9b88e] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#c9b88e] md:block">
      {BRAND_NAME} รวบรวมเกมคาสิโนและการเดิมพันกีฬาไว้หลายรูปแบบในแพลตฟอร์มเดียว โดยบาคาร่าเป็นเกมไพ่ที่มีตัวเลือกการเดิมพันตามกติกา สล็อตมีทั้งเกมวงล้อทั่วไป ฟรีสปิน และฟีเจอร์ตัวคูณ ส่วนรูเล็ต
      และไฮโลมีรูปแบบการทายผลที่แตกต่างกัน ขณะที่แทงบอลมีข้อมูลคู่แข่งขันและอัตราต่อรองให้ตรวจสอบก่อนทำรายการ สมาชิกเลือกประเภทเกมตามความสนใจและศึกษารายละเอียดผ่านระบบได้ สำหรับคำว่ามีโบนัสทุกเกม
      ควรตรวจสอบว่าหมายถึงฟีเจอร์โบนัสภายในเกมหรือโปรโมชั่นของเว็บไซต์ เพราะแต่ละค่ายมีเงื่อนไขไม่เหมือนกัน บางเกมอาจไม่มีรอบโบนัสหรือสิทธิพิเศษเพิ่มเติม และไม่มีเกมประเภทใดรับประกันผลตอบแทน
      จึงควรตรวจสอบตารางจ่าย กติกา และยอดเดิมพันก่อนเริ่มเล่นทุกครั้ง โปรโมชั่นที่ระบุไว้คือโบนัสคืนยอดเสีย 0.3% เข้ายูสทุกวัน และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนดรอบคำนวณ ประเภทเกม
      ยอดที่เข้าเกณฑ์ และเวลาตัดยอดต่างกัน ให้ยึดรายละเอียดล่าสุดที่แสดงในหน้าโปรโมชั่น ณ เวลากดรับสิทธิ์เป็นหลัก ส่วนคาสิโนไลฟ์สดที่ระบุว่าเปิดให้บริการ 24 ชั่วโมง ควรตรวจสอบตารางเปิดโต๊ะและสถานะ
      ผู้ให้บริการแต่ละค่าย เพราะบางเกมอาจมีช่วงปิดปรับปรุงหรือเปลี่ยนรอบถ่ายทอดสด หากพบปัญหาเกี่ยวกับคาสิโนไลฟ์สดควรแจ้งชื่อเกม ค่าย และเวลาที่เกิดเหตุ ส่วนการเดิมพันกีฬาควรเตรียมชื่อคู่แข่งขัน
      และหมายเลขรายการ โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม ผู้สมัครควรตรวจสอบโดเมนหลัก ข้อมูลผู้ดำเนินงาน และข้อกำหนดการใช้งาน
      ก่อนส่งข้อมูลส่วนตัว รวมถึงตรวจสอบอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตน
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8a5c09]/50 pt-8 text-xs font-medium tracking-wide text-[#c9b88e] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe4a3]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe4a3]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
