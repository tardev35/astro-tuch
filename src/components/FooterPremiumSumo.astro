---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ดวงเศรษฐี168 (รอบทองน้ำผึ้ง + แดงชาดจีน บนดำสนิท 2026-10-20): ไฟล์นี้เป็น footer
// ที่ใช้งานจริงรอบนี้ — หมุนออกจาก FooterStyle2 ของ ufalion168 ซึ่งเป็นแผ่นแบน ขอบบน
// หนา กริด 4 คอลัมน์เท่ากัน + แถบ claim chips คั่นก่อนบรรทัดลิขสิทธิ์ ไฟล์นี้คนละทรง:
// แผ่น rounded-t-[3rem] ที่มีออราเรืองแสงเบลอคร่อมทั้งขอบบนและขอบล่าง กริด 12 คอลัมน์
// แบ่ง 5/3/4 และมีย่อหน้าเนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์
//
// ⚠️ **กับดักรอบนี้คือทองกับแดง ไม่ใช่สีแปลกปลอม** — ไฟล์นี้เคยค้างชุดทอง-โรสโกลด์
// ของขวัญใจ168 มาเต็มไฟล์ (ทองแบรนด์ ทองสว่าง โรสโกลด์ เนื้อความโรสโกลด์ แดงชาด
// แดงลึก ทองลึก งาช้าง และผิวการ์ดสามชั้น รวม 12 ค่า บวก rgba ของทองนั้น) ซึ่ง
// "อ่านเป็นทองเหมือนกัน" แต่คนละค่าทั้งหมด — กวาดออกครบแล้ว ไม่เหลือสักค่า
// ทองของรอบนี้คือ **#f0c878** (R240 G200 B120) ตัวที่ใกล้ที่สุดในรีโปคือทองของ
// รับตัง168 ตัวตัดสินคือ R240 vs R255 และ B120 vs B140 — ให้ grep เป็นค่าทีละตัวกับ
// ตารางใน .claude/brand-spec-duangsetthi168.md §2 ห้ามกะด้วยตา
//
// แกนสี: พื้นเพจดำสนิท #000000 (ตรงกับ bg.json) ยกระดับด้วย #150303 จม / #300605 กลาง /
// #4e2120 ยก · ทองน้ำผึ้ง #f0c878 เป็นหัวข้อคอลัมน์ เส้นคั่น ขอบ และสีลิงก์ hover ·
// แดงชาด #d9212a เป็นพื้นถมป้ายใบที่สอง ขอบซ้ายของย่อหน้า และออราขอบบน · แดงเลือดหมู
// #8e1a16 เป็นเส้นคั่นท้ายหน้ากับออราขอบล่าง · เนื้อความงาช้าง #fff8d8 (= BRAND_TEXT)
// ⚠️ **#d9212a และ #8e1a16 ห้ามถือตัวอักษรทุกขนาด** (2.69:1 และต่ำกว่า = ตก AA)
// ป้าย "แนะนำเพื่อน 0.8%" จึงเป็น **ถมแดงแล้ววางงาช้างทับ** (4.68:1 ผ่าน AA) ไม่ใช่
// ตัวอักษรแดงบนพื้นเข้ม ส่วนหมึกบนพื้นถมทองมีตัวเดียวคือ #2a0608
//
// ⚠️ แกนเนื้อหารอบนี้คือ **เว็บ "สอนเล่น" เกมเดิมพันออนไลน์หลายประเภท** (สล็อต บาคาร่า
// ยิงปลา ไฮโล บอล หวย) รวมสูตรและเทคนิค — **ไม่ใช่เว็บบอล** ย่อหน้าท้ายฟุตเตอร์เดิม
// เป็นคลังคำเว็บบอลของ ufalion168 ล้วน (ชุดคำข่าว/ตาราง/ผลแข่ง/การวิเคราะห์ก่อนเกม
// และศัพท์เฉพาะของฝั่งเว็บบอลทุกคำ — รายการเต็มอยู่ใน brand spec §6) ถูกเขียนใหม่หมดทั้ง
// ย่อหน้าแล้ว ห้ามเติมกลับแม้แต่คำเดียว (คำว่า "บอล"/"ฟุตบอล" เฉยๆ ยังใช้ได้
// เพราะบรีฟรอบนี้ระบุเอง แต่คำแวดล้อมของเว็บบอลไม่ได้)
// ⚠️ ห้ามระบุชื่อค่ายเกม ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ยอดฝากขั้นต่ำ ค่า RTP
// จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟไม่ได้ให้มาสักตัว ตัวเลขที่อ้างได้มีสี่ตัวเท่านั้นคือ
// 0.3% · 0.8% · 24ชม. · 3 ขั้นตอน และทุกประโยคเตือนของบรีฟต้อง ship ครบ
//
// ลิงก์ของ **สองหน้าหวยที่ปิดอยู่รอบนี้** (ชื่อเต็มอยู่ใน brand spec §7) ไม่มีในไฟล์นี้
// และห้ามเติมกลับ — รอบนี้เป็นเว็บสอนเล่นเกมหลายประเภท ไม่ใช่เว็บหวย สองหน้านั้นจอด
// อยู่ใน src/pages-disabled/ ซึ่ง Astro ไม่ route ให้ การทิ้งลิงก์ไว้จึงเป็น href ที่ชี้
// route ที่ไม่มีจริง และ verify-build.mjs จะทำให้ build แดง
// route ที่มีจริงรอบนี้: / /about-us /contact-us /login /privacy /promotion /register
// /terms /ทดลองเล่น /ทางเข้า /line
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ cta toggle เปิด
// และ /register กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// ⚠️ ไฟล์นี้เป็นโครมที่ render ทุกหน้า จึง **ห้ามมี heading tag ทุกระดับ** หัวข้อคอลัมน์
// เป็น <p> ที่ถือคลาสเดิมไว้ และ <nav>/<section> ที่เสียชื่อเรียกไปใช้ aria-label แทน
//
// บล็อก <address> ด้านล่างคัดลอกจาก SKILL.md แบบ verbatim — ห้ามใส่ hex ของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer ทุกตัวใน
// ไลบรารีซึ่งเป็นพื้นเข้มหมด การ retheme มันคือการทิ้ง hex ของรอบนี้ไว้ให้รอบหน้า
// ที่อยู่กับอีเมลมาจาก BRAND_ADDRESS ล้วน (อนุมานจาก BRAND_NAME + site:) ห้ามพิมพ์เอง
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-20 ที่เปิดอ่านจริง (ไม่มีโบว์ริบบิ้นทองหรือ
// หญิงสาวชุดไทยของขวัญใจ168 อยู่ในรูปนี้เลย) ชื่อแบรนด์ interpolate เสมอ
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นหัวไฉ่ซิงเอี๊ย เทพเจ้าโชคลาภจีน ยิ้มหัวเราะ สวมหมวกทรงจีนสีแดงขลิบทอง มีลูกปัดทองห้อยสองข้าง ถัดมาเป็นคำว่า ดวงเศรษฐี ตัวอักษรไทยสามมิติผิวทองมันวาว ต่อด้วยเลข 168 สามมิติสีแดงสดขลิบทอง`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f0c878]/60 bg-[#000000] pt-16 pb-8 font-sans text-[#fff8d8] shadow-[0_-15px_40px_rgba(240,200,120,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d9212a]/25 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#8e1a16]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a
          href="/"
          class="flex h-[44px] w-[176px] max-w-max items-center overflow-hidden rounded-xl border border-[#f0c878]/30 bg-[#150303] transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[176, 352]}
                sizes="176px"
                quality={45}
                loading="lazy"
                decoding="async"
                class="h-auto w-[176px] max-w-none object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f0c878]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d9212a] pl-4 text-sm leading-relaxed text-[#fff8d8]/80">
          {BRAND_NAME} รวบรวมเนื้อหาสอนเล่นเกมเดิมพันออนไลน์หลายประเภทไว้ในที่เดียว ทั้งสล็อต บาคาร่า ยิงปลา ไฮโล บอล และหวยออนไลน์ โดยอธิบายกติกา สัญลักษณ์ ตารางจ่ายรางวัล ประเภทการเดิมพัน และอัตราจ่ายของแต่ละเกม พร้อมสูตรและเทคนิคที่จัดไว้เป็นหัวข้อเรียน
          ทั้งนี้ เทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ และคำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f0c878]/40 bg-[#300605] px-4 py-1 text-xs font-medium text-[#f0c878]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน</span>
          <span class="rounded-full border border-[#8e1a16] bg-[#d9212a] px-4 py-1 text-xs font-medium text-[#fff8d8]">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f0c878] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f0c878]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fff8d8]/80">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#f0c878]">{link.name}</a></li>)}
        </ul>
      </nav>

      <section aria-label="ช่องทางติดต่อเจ้าหน้าที่" class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f0c878] uppercase drop-shadow-sm">ติดต่อแอดมิน 24ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f0c878]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#f0c878]/50 bg-[#300605]/80 py-3 text-sm font-bold text-[#fff8d8] transition-all hover:bg-[#4e2120]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <p class="mt-2 text-xs font-medium tracking-widest text-[#fff8d8]/70 uppercase">ช่องทางฝาก-ถอนที่รองรับ</p>
        <BankStrip size={30} />
      </section>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#fff8d8]/70 md:block">
      {BRAND_NAME} จัดวางเนื้อหาสอนเล่นเกมเดิมพันออนไลน์ให้ผู้เริ่มต้นเข้าถึงได้จากจุดเดียว ตั้งแต่กติกาพื้นฐานของเกมสล็อต การอ่านสัญลักษณ์และตารางจ่ายรางวัล ความน่าจะเป็นของบาคาร่า รูปแบบการเล่นที่ต่างกันของยิงปลาและไฮโล ไปจนถึงประเภทการเดิมพันและอัตราจ่ายของบอลและหวยออนไลน์
      โดยรวมสูตรและเทคนิคไว้เป็นหัวข้อเรียนแยกตามประเภทเกม เทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ เพราะผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้ ส่วนคำกล่าวอ้างเกี่ยวกับผู้สอนระดับมือหนึ่งควรตรวจสอบประสบการณ์และผลงานจากหลักฐานที่เชื่อถือได้
      ด้านโปรโมชั่นที่ระบุไว้คือคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนโบนัส 0.8% ไม่จำกัด ซึ่งแต่ละรายการอาจกำหนดเงื่อนไขเกี่ยวกับประเภทเกม ยอดที่ใช้คำนวณเครดิต รอบคำนวณยอด และช่วงเวลารับสิทธิ์แตกต่างกัน ควรอ่านรายละเอียดจากประกาศล่าสุดและตรวจสอบข้อจำกัดจำนวนบัญชีก่อนเข้าร่วม
      ทั้งนี้ การคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพัน สำหรับผู้ที่สนใจสมัครสมาชิกมีขั้นตอนหลักเพียง 3 ขั้นตอน คือตรวจสอบช่องทางสมัครเรียนรู้จากเว็บไซต์ทางการ ศึกษาเงื่อนไขและลงทะเบียนด้วยข้อมูลที่ถูกต้อง แล้วจึงเริ่มศึกษากติกาและความเสี่ยงของแต่ละเกม
      ควรอ่านข้อกำหนดเกี่ยวกับการใช้ข้อมูลส่วนบุคคลให้ครบถ้วน ตั้งรหัสผ่านที่คาดเดาได้ยาก และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น หากต้องการสอบถามเรื่องหัวข้อเรียน ผู้สอน เงื่อนไขการสมัคร หรือโปรโมชั่น สามารถติดต่อเจ้าหน้าที่ได้ตลอด 24ชม.
      ผ่านช่องทางทางการที่ประกาศไว้บนเว็บไซต์เท่านั้น เพื่อหลีกเลี่ยงบัญชีแอบอ้าง และควรตรวจสอบข้อมูลให้แน่ใจก่อนส่งข้อมูลส่วนบุคคลทุกครั้ง รวมถึงศึกษาข้อจำกัดด้านอายุและข้อกฎหมายที่เกี่ยวข้องในพื้นที่ของตนก่อนใช้งาน
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8e1a16] pt-8 text-xs font-medium tracking-wide text-[#fff8d8]/70 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f0c878]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f0c878]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
