---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// GOT777 (รอบทอง-แดง-ดำ 2026-09-29): ไฟล์นี้ถูกเลื่อนขึ้นมาเป็น footer ที่ใช้งาน
// จริงรอบนี้ (รอบก่อน LOTTOPLUS ใช้ FooterHuay) ของเดิมที่ค้างอยู่เป็นพาเลตต์
// ทอง-โครเมียมของ UWIN33 ซึ่งขายเกมหลายหมวดรวมหวย — ทั้งสีและเนื้อหาถูกเขียนใหม่
// หมดแล้ว
//
// ⚠️ เนื้อความรอบนี้พูดถึง "เกมสล็อต" อย่างเดียว บรีฟของ GOT777 ระบุเฉพาะสล็อต
// จากหลายค่ายเท่านั้น — คำว่า บาคาร่า รูเล็ต ไฮโล บอล และหวย ที่ค้างจาก UWIN33
// ถูกถอดออกทั้งหมด ห้ามเติมกลับ และห้ามอ้างใบอนุญาต ชื่อค่ายเกม ชื่อธนาคาร
// ยอดฝากขั้นต่ำ หรือตัวเลข RTP เพราะบรีฟไม่ได้ระบุไว้สักคำ ตัวเลขที่อ้างได้มี
// สี่ตัวคือ 0.3% · 0.8% · 24 ชั่วโมง · 777 ในชื่อแบรนด์
//
// ลิงก์ /ตรวจหวย กับ /แนวทาง ไม่มีในนี้ และห้ามเติม — GOT777 ไม่ใช่เว็บหวย สองหน้า
// นั้นถูกย้ายกลับไปไว้ใน src/pages-disabled/ แล้ว การทิ้งลิงก์ไว้จะเป็น href ที่ชี้ไป
// route ที่ไม่มีจริง ซึ่ง verify-build.mjs จะทำให้ build แดง
//
// แกนสี: พื้นดำอมน้ำตาล #0a0503 ยกระดับด้วย #160b06 / #241108 · ทองแบรนด์
// #f5c518 เป็นขอบและเส้นคั่น · ทองอ่อน #ffe9a8 เป็นหัวคอลัมน์และลิงก์ hover ·
// แดงเลือดหมู #d21622 เป็นคู่สีรอง (ตามเลข 777 ในโลโก้) แดงอ่อน #f3b0b5 เวลาใช้
// เป็นตัวอักษร · เนื้อความหลัก #ece0cb (BRAND_TEXT) เนื้อความรอง #bdae92
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ /register
// กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// บล็อก <address> ด้านล่างวางไว้ตามต้นฉบับเป๊ะๆ — ห้ามใส่สีของแบรนด์ลงไป
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f5c518]/60 bg-[#0a0503] pt-16 pb-8 font-sans text-[#ece0cb] shadow-[0_-15px_40px_rgba(245,197,24,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f5c518]/16 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#d21622]/16 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f5c518]/30 bg-[#160b06] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ GOT777 ตัวอักษร GOT สีทองเมทัลลิกมีอัญมณีสีแดงฝังอยู่กลางตัว O ต่อด้วยเลข 777 สีแดงเลือดหมูขอบทอง"
                widths={[150, 300, 450]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffe9a8]">
                GOT<span class="text-[#d21622]">777</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f5c518]/50 pl-4 text-sm leading-relaxed text-[#bdae92]">
          {BRAND_NAME} รวมเกมสล็อตจากแพลตฟอร์มค่ายใหญ่หลายรายไว้ในบัญชีเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมแจ็กพอต รองรับการเข้าเล่นผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์
          สมาชิกเลือกเกม ตรวจสอบเครดิต โปรโมชั่น และประวัติรายการได้จากระบบเดียวโดยไม่ต้องสมัครหลายบัญชี ทั้งนี้จำนวนเกมและแจ็กพอตที่เปิดให้เล่นจริงขึ้นอยู่กับแต่ละค่าย
          ควรตรวจสอบกติกา ช่วงเดิมพัน และเงื่อนไขภายในเกมก่อนเดิมพันทุกครั้ง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f5c518]/35 bg-[#160b06] px-4 py-1 text-xs font-medium text-[#ffe9a8] backdrop-blur-sm">แนะนำเพื่อน โบนัส 0.8%</span>
          <span class="rounded-full border border-[#d21622]/40 bg-[#241108] px-4 py-1 text-xs font-medium text-[#f3b0b5] backdrop-blur-sm">คืนยอดเสีย โบนัส 0.3%</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe9a8] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f5c518]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#bdae92]">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#ffe9a8]">{link.name}</a></li>)}
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe9a8] uppercase drop-shadow-sm">เจ้าหน้าที่ 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f5c518]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อเจ้าหน้าที่ผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#d21622]/50 bg-[#241108]/70 py-3 text-sm font-bold text-[#ece0cb] transition-all hover:bg-[#3a1a0c]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#bdae92] uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#bdae92] md:block">
      {BRAND_NAME} รวบรวมเกมสล็อตหลากหลายรูปแบบจากแพลตฟอร์มค่ายใหญ่ไว้ให้เลือกตามรายการที่เปิดให้บริการ ทั้งเกมวงล้อแบบดั้งเดิม สล็อตธีมเอเชีย เกมผจญภัย เกมที่มีฟรีสปิน ตัวคูณ
      และสล็อตแจ็กพอตตามค่ายที่ระบบเปิดให้ใช้งาน โดยจำนวนเกม กติกา ช่วงเดิมพัน ฟีเจอร์โบนัส และเงื่อนไขของแจ็กพอตอาจแตกต่างกันในแต่ละค่าย ควรตรวจสอบข้อมูลภายในเกมก่อนเดิมพันทุกครั้ง
      เพราะไม่ใช่เกมสล็อตทุกเกมหรือทุกค่ายที่จะมีระบบแจ็กพอตเหมือนกัน โปรโมชั่นที่ระบุไว้สำหรับหน้านี้คือโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% ซึ่งแต่ละรายการอาจกำหนด
      ประเภทเกมสล็อต รอบคำนวณ ยอดที่เข้าเกณฑ์ และช่วงเวลารับสิทธิ์ต่างกัน ให้ยึดรายละเอียดล่าสุดที่แสดงในหน้าโปรโมชั่น ณ เวลากดรับสิทธิ์เป็นหลัก ก่อนทำธุรกรรมฝากถอนควรตรวจสอบ
      ชื่อบัญชีและจำนวนเงินให้ถูกต้อง หากเครดิตไม่เข้าหรือรายการถอนค้าง ควรเก็บหลักฐานรายการไว้ประกอบการตรวจสอบกับเจ้าหน้าที่ และไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น
      เกมสล็อตเป็นเกมที่มีผลลัพธ์แบบสุ่ม แม้บางเกมจะมีแจ็กพอตหรือโบนัสให้ลุ้น แต่ไม่สามารถรับประกันว่าจะชนะหรือทำกำไรได้ตลอดเกม
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#96690f]/40 pt-8 text-xs font-medium tracking-wide text-[#bdae92] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe9a8]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe9a8]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
