---
import { Image } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โปรดี168 (รอบแดงเชอร์รี่ + ทองแดงไหม้ **ธีมสว่าง** 2026-10-22): ไฟล์นี้เป็น footer
// ที่ใช้งานจริงรอบนี้ — หมุนออกจาก FooterCyber ของรวยแท้168 ซึ่งเป็นแผ่นเหลี่ยม
// ภาษาไซเบอร์ เส้นสแกน และกริดเท่ากัน ไฟล์นี้คนละทรง: แผ่น rounded-t-[3rem] ที่มี
// ออราเรืองแสงเบลอคร่อมทั้งขอบบนและขอบล่าง กริด 12 คอลัมน์แบ่ง 5/3/4 และมีย่อหน้า
// เนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์
//
// ⚠️ **กับดักรอบนี้คือแดงกับทอง ไม่ใช่สีแปลกปลอม** — ไฟล์นี้เคยค้างชุดทองน้ำผึ้ง +
// แดงชาดจีนของดวงเศรษฐี168 มาเต็มไฟล์ (f0c878 d9212a 8e1a16 fff8d8 150303 300605
// 4e2120 2a0608 และ rgba ของทองนั้น) ซึ่ง "อ่านเป็นแดง-ทองเหมือนกัน" แต่คนละค่า
// ทั้งหมด — กวาดออกครบแล้ว ไม่เหลือสักค่า
// ทองของรอบนี้คือ **ทองสาลี่ #f0b46a** (R240 G180 B106) คู่กับ **ทองแดงไหม้
// #b44c06 / #7a2f03** ตัวที่ใกล้ที่สุดในรีโปคือ f0c878 ของดวงเศรษฐี168 ตัวตัดสินคือ
// G180 vs G200 และ B106 vs B120 — ให้ grep เป็นค่าทีละตัวกับตารางใน
// .claude/brand-spec-prodeee168.md §2 ห้ามกะด้วยตา
// และ **แดงรอบนี้คือ #eb0305 เท่านั้น** ไม่ใช่ c30303 ของรวยแท้168 (รอบก่อน
// จึงเสี่ยงที่สุด) ไม่ใช่ d9212a ของดวงเศรษฐี168 ไม่ใช่ dc0203 ของหวย365
//
// แกนสี: **โครมเข้มคร่อมเนื้อหาสว่าง** — พื้นเพจเป็น #ffd1d1 ชมพูพาสเทล (จาก bg.json)
// แต่ footer เป็นพื้นถม #2c1004 จม / #4d1c0a ยก / #1a0802 ลึก · ทองสาลี่ #f0b46a
// เป็นหัวข้อคอลัมน์ เส้นคั่น ขอบ และสีลิงก์ hover · แดงเชอร์รี่ #eb0305 เป็นพื้นถม
// ป้ายใบที่สองและออราขอบบน · ทองแดงเข้ม #7a2f03 เป็นเส้นคั่นท้ายหน้ากับออราขอบล่าง ·
// เนื้อความครีม #fff0e4 (15.9:1 บน #2c1004)
// ⚠️ **#b44c06 และ #7a2f03 ห้ามถือตัวอักษรบนพื้นโครม** (2.8:1 และต่ำกว่า = ตก AA)
// ใช้เป็นขอบ/พื้นถม/ออราเท่านั้น ป้าย "แนะนำเพื่อน 0.8%" จึงเป็น **ถมแดง #eb0305
// แล้ววางตัวอักษรขาวทับ** (4.6:1 ผ่าน AA) ไม่ใช่ตัวอักษรแดงบนพื้นเข้ม
// ⚠️ **ทองสาลี่ #f0b46a บนพื้นโครมได้ 9.7:1 ผ่านสบาย แต่บนผิวการ์ดขาวได้แค่ 1.8:1**
// — ค่านี้จึงห้ามหลุดออกจากไฟล์โครมไปอยู่ใน ContentBox ใดๆ
//
// ⚠️ แกนเนื้อหารอบนี้คือ **เว็บสล็อตออนไลน์ล้วน** — ย่อหน้าท้ายฟุตเตอร์เดิมเป็นคลังคำ
// "เว็บสอนเล่นเกม" ของดวงเศรษฐี168 ล้วน (ผู้สอน · บทเรียน · หลักสูตร · สูตร · เทคนิค ·
// สัญลักษณ์ · ตารางจ่ายรางวัล · บาคาร่า · ยิงปลา · ไฮโล · บอล · หวย) ถูกเขียนใหม่หมด
// ทั้งย่อหน้าแล้ว **ห้ามเติมกลับแม้แต่คำเดียว** บรีฟรอบนี้ไม่มีคำพวกนั้นเลยสักคำ
// ⚠️ ห้ามระบุชื่อค่ายเกม ชื่อธนาคาร ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ยอดฝากขั้นต่ำ
// ค่า RTP จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟไม่ได้ให้มาสักตัว ตัวเลขที่อ้างได้มีสี่ตัว
// เท่านั้นคือ 0.3% · 0.8% · 24ชม. · ปี 2026 และทุกประโยคเตือนของบรีฟต้อง ship ครบ
//
// ⚠️ **BankStrip ถูกถอดออกจากไฟล์นี้รอบนี้** (รอบก่อนฟุตเตอร์ render มัน) เพราะ
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารหรือวอลเลทแม้แต่แห่งเดียว** แถบโลโก้ธนาคารคือการ
// อ้างว่ารองรับธนาคารชุดนั้นจริง ซึ่งไม่มีอะไรในบรีฟรองรับ ไฟล์ BankStrip.astro
// ยังอยู่ครบในฐานะ inventory ของแบรนด์ถัดไป **ห้ามลบ**
//
// ลิงก์ของ **สองหน้าหวยที่ปิดอยู่รอบนี้** (/ตรวจหวย · /แนวทาง) ไม่มีในไฟล์นี้
// และห้ามเติมกลับ — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นถูกย้ายกลับไปจอด
// อยู่ใน src/pages-disabled/ ซึ่ง Astro ไม่ route ให้ การทิ้งลิงก์ไว้จึงเป็น href ที่ชี้
// route ที่ไม่มีจริง และ verify-build.mjs จะทำให้ build แดง
// route ที่มีจริงรอบนี้: / /about-us /contact-us /login /privacy /promotion /register
// /terms /ทดลองเล่น /ทางเข้า /line
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ cta toggle เปิด
// และ /register กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// ⚠️ ไฟล์นี้เป็นโครมที่ render ทุกหน้า จึง **ห้ามมี heading tag ทุกระดับ** หัวข้อคอลัมน์
// เป็น <p> ที่ถือคลาสเดิมไว้ และ <nav>/<section> ที่เสียชื่อเรียกไปใช้ aria-label แทน
//
// บล็อก <address> ด้านล่างคัดลอกจาก SKILL.md แบบ verbatim — ห้ามใส่ hex ของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer ทุกตัวใน
// ไลบรารีซึ่งเป็นพื้นเข้มหมด การ retheme มันคือการทิ้ง hex ของรอบนี้ไว้ให้รอบหน้า
// ที่อยู่กับอีเมลมาจาก BRAND_ADDRESS ล้วน (อนุมานจาก BRAND_NAME + site:) ห้ามพิมพ์เอง
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-21 ที่เปิดอ่านจริง (ไม่มีหัวไฉ่ซิงเอี๊ยหรือ
// เลข 168 สีแดงขลิบทองของดวงเศรษฐี168 อยู่ในรูปนี้เลย) ชื่อแบรนด์ interpolate เสมอ
//
// ไฟล์ต้นทางเป็นจัตุรัส 500x500 และกล่องนี้วาดมันสูง 36px → กว้าง 36px เช่นกัน
// widths/sizes จึงอิง 36px ไม่ใช่ความกว้างของกล่อง ของเดิมบังคับ w-[176px] บนรูป
// จัตุรัสในกล่องสูง 44px overflow-hidden = เห็นแค่แถบกลางของโลโก้
//
// ⚠️ **เป็น <Image format="webp"> ไม่ใช่ <Picture> ที่มี avif โดยตั้งใจ** — ที่
// 36w/72w/108w ค่าโสหุ้ยของคอนเทนเนอร์ AVIF กินมากกว่าที่มันประหยัดได้ รอบนี้วัดได้
// avif 748 ไบต์ ปะทะ webp 642 ไบต์ (+17%) ซึ่ง `tools/verify-build.mjs` ทำให้
// build แดงถูกต้องแล้ว เพราะเบราว์เซอร์ที่รองรับ avif จะหยิบไฟล์ที่ **ใหญ่กว่า**
// การลด quality ไม่ช่วยเพราะพื้นของ avif อยู่ที่ ~700 ไบต์ไม่ว่าจะลดแค่ไหน
// **ห้ามเติม avif กลับเข้ามาที่ขนาดนี้** (NavbarStyle4 เจอเรื่องเดียวกันและแก้ทางเดียวกัน)
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นรูปกระต่ายการ์ตูนขนขาวผูกผ้าพันคอสีแดงยกนิ้วโป้งและขยิบตา อยู่ข้างคำว่า ${BRAND_NAME} ตัวอักษรไทยสามมิติผิวมันวาวสีแดงเชอร์รี่ตัดขอบขาว`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f0b46a]/60 bg-[#2c1004] pt-16 pb-8 font-sans text-[#fff0e4] shadow-[0_-15px_40px_rgba(240,180,106,0.2)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#eb0305]/25 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#7a2f03]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a
          href="/"
          class="flex h-[56px] max-w-max items-center gap-3 overflow-hidden rounded-xl border border-[#f0b46a]/30 bg-[#1a0802] px-5 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Image
                src={mainLogo}
                alt={logoAlt}
                widths={[36, 72, 108]}
                sizes="36px"
                quality={65}
                loading="lazy"
                decoding="async"
                class="h-[36px] w-auto object-contain"
                format="webp"
              />
            ) : (
              <span class="text-2xl font-black tracking-widest text-[#f0b46a]">{BRAND_NAME}</span>
            )
          }
          <span class="text-xl font-black tracking-wide text-[#f0b46a]">{BRAND_NAME}</span>
        </a>
        <p class="border-l-2 border-[#eb0305] pl-4 text-sm leading-relaxed text-[#fff0e4]/85">
          {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์หลากหลายรูปแบบ ข้อมูลค่ายเกม โปรโมชั่น และบริการสมาชิกไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถเลือกศึกษารายละเอียดเกมที่สนใจ ตรวจสอบกติกาและเงื่อนไขการเดิมพัน รวมถึงติดตามข้อมูลโปรโมชั่นที่ประกาศก่อนสิ้นปี 2026 ได้สะดวก
          ทั้งนี้ ควรตรวจสอบสถานะลิขสิทธิ์ของเกมและข้อมูลผู้ให้บริการจากหลักฐานทางการก่อนใช้งานทุกครั้ง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f0b46a]/40 bg-[#4d1c0a] px-4 py-1 text-xs font-medium text-[#f0b46a]">คืนยอดเสีย 0.3% เข้ายูสทุกวัน</span>
          <span class="rounded-full border border-[#7a2f03] bg-[#eb0305] px-4 py-1 text-xs font-medium text-white">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f0b46a] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f0b46a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fff0e4]/85">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#f0b46a]">{link.name}</a></li>)}
        </ul>
      </nav>

      <section aria-label="ช่องทางติดต่อเจ้าหน้าที่" class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f0b46a] uppercase drop-shadow-sm">ติดต่อแอดมิน 24ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f0b46a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#f0b46a]/50 bg-[#4d1c0a]/80 py-3 text-sm font-bold text-[#fff0e4] transition-all hover:bg-[#4d1c0a]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </section>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#fff0e4]/75 md:block">
      {BRAND_NAME} จัดวางข้อมูลเกมสล็อตออนไลน์ให้ผู้ใช้งานเข้าถึงได้จากจุดเดียว ตั้งแต่รูปแบบเกมและฟีเจอร์พิเศษของแต่ละค่าย ไปจนถึงเงื่อนไขการเดิมพันที่ควรอ่านก่อนเลือกใช้งาน โดยรายชื่อค่ายเกมและรายการที่เปิดให้บริการอาจเปลี่ยนแปลงได้
      จึงควรตรวจสอบข้อมูลล่าสุดรวมถึงหลักฐานการได้รับอนุญาตจากเจ้าของเกมก่อนตัดสินใจทุกครั้ง ด้านโปรโมชั่นที่ระบุไว้คือคืนยอดเสีย 0.3% เข้ายูสทุกวัน และแนะนำเพื่อนโบนัส 0.8% ไม่จำกัด ซึ่งแต่ละรายการอาจกำหนดเงื่อนไขเกี่ยวกับยอดเดิมพัน รอบคำนวณเครดิต
      และวิธีรับสิทธิ์แตกต่างกัน ก่อนเข้าร่วมควรตรวจสอบรายละเอียดจากประกาศล่าสุด รวมถึงข้อจำกัดในการใช้โบนัสและการรับโปรโมชั่นร่วมกัน ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำกำไรได้ในครั้งต่อไป
