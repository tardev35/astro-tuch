---
import { Image } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ร่ำรวย168 (รอบฟ้าไซยานนำ + ครีมอุ่นรอง **ธีมสว่าง** 2026-10-23): ไฟล์นี้เป็น footer
// ที่ใช้งานจริงรอบนี้ — หมุนออกจาก FooterStyle2 ของเงินทอง168 ซึ่งเป็นแผ่นแบนกริด
// สี่คอลัมน์เท่ากันพร้อม BankStrip ท้ายคอลัมน์ที่สี่ ไฟล์นี้คนละทรง: แผ่น
// rounded-t-[3rem] ที่มีออราเรืองแสงเบลอคร่อมทั้งขอบบนและขอบล่าง กริด 12 คอลัมน์
// แบ่ง 5/3/4 และมีย่อหน้าเนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์
//
// 🚨🚨 **กับดักรอบนี้คือฟ้า ไม่ใช่สีแปลกปลอม** — ฟ้าเคยนำมาแล้วห้าแบรนด์ในรีโปนี้
// (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911) จึง **ห้ามตัดสินด้วยตา
// ต้องเทียบทีละค่า** ฟ้าของรอบนี้คือ **#18a5e2** (R24 G165 B226) คู่กับ **ฟ้าเข้ม
// #0d6b9b** และ **ฟ้าอ่อน #a9d7f2** ตัวที่ใกล้ที่สุดในรีโปคือ 2cc3fc ของสบาย168
// (ห่าง R20/G30/B26) และ 32bcfb ของนินจา168 (ห่าง R26/G23/B25) — ให้ grep เป็นค่า
// ทีละตัวกับตารางใน .claude/brand-spec-ruaythear168club.md §2 ห้ามกะด้วยตา
// ⚠️ ค่า vivid ดิบของ logo.webp รอบนี้คือ 6bddfb ซึ่งห่าง 6bdcfb ของสบาย168
// **แค่ 1 หน่วย** — รอบนี้จึงไม่ใช้ค่าดิบ แต่เลื่อนมาที่ #18a5e2
// ไฟล์นี้เคยค้างชุดทองสาลี่ + แดงเชอร์รี่ของโปรดี168 มาเต็มไฟล์ (f0b46a eb0305 b44c06
// 7a2f03 2c1004 4d1c0a 1a0802 fff0e4 และ rgba ของทองนั้น) — กวาดออกครบแล้ว ไม่เหลือ
// สักค่า พร้อมกับชุดทองน้ำผึ้ง-แดงชาดของดวงเศรษฐี168 ที่เคยอยู่ก่อนหน้านั้น
// ⚠️ **ทองไม่ใช่สีของรอบนี้เลยสักเฉด** — ทองที่เห็นในอาร์ตเวิร์ก (ตะกร้าเหรียญทอง
// ในโลโก้ นาฬิกาทอง หัวเข็มขัดทอง) เป็น **วัตถุในภาพ ไม่ใช่สี UI**
//
// แกนสี: **โครมเข้มคร่อมเนื้อหาสว่าง** — พื้นเพจเป็น #dbe6ff ฟ้าเพอริวิงเคิล (จาก
// bg.json) ส่วน footer เป็นพื้นถม #202a66 กลาง / #31408a ยก / #111a3f ลึก ·
// ฟ้าไซยาน #18a5e2 เป็นหัวข้อคอลัมน์ เส้นคั่น ขอบ และสีลิงก์ hover · ฟ้าเข้ม #0d6b9b
// เป็นพื้นถมป้ายใบที่สองและออราขอบบน · #111a3f เป็นเส้นคั่นท้ายหน้ากับออราขอบล่าง ·
// เนื้อความ #e9f1ff (11.9:1 บน #202a66)
// ⚠️ **#0d6b9b ห้ามถือตัวอักษรบนพื้นโครม** (1.5:1 บน #202a66 = ตก AA ขาดลอย)
// ใช้เป็นขอบ/พื้นถม/ออราเท่านั้น ป้าย "แนะนำเพื่อน 0.8%" จึงเป็น **ถมฟ้าเข้ม #0d6b9b
// แล้ววางตัวอักษรขาวทับ** (6.2:1 ผ่าน AA) ไม่ใช่ตัวอักษรฟ้าบนพื้นเข้ม
// ⚠️ **ฟ้าไซยาน #18a5e2 บนพื้นโครมได้ 5.0:1 ผ่าน AA แต่บนผิวการ์ดขาวได้แค่ 2.6:1**
// — ค่านี้จึงห้ามหลุดออกจากไฟล์โครมไปถือตัวอักษรใน ContentBox ใดๆ
//
// ⚠️ แกนเนื้อหารอบนี้คือ **เว็บสล็อตออนไลน์ล้วน** — ย่อหน้าท้ายฟุตเตอร์เดิมเป็นคลังคำ
// ของโปรดี168 (ค่ายเกม · ฟีเจอร์พิเศษ · สถานะลิขสิทธิ์ · หลักฐานการได้รับอนุญาต ·
// ปี 2026) และของเงินทอง168 (เงินดี · อัตราจ่ายสูง · 1,000 เกม · ค่ายมาตรฐานสากล ·
// ลิขสิทธิ์แท้100%) ถูกเขียนใหม่หมดทั้งย่อหน้าแล้ว **ห้ามเติมกลับแม้แต่คำเดียว**
// บรีฟรอบนี้ไม่มีคำพวกนั้นเลยสักคำ
// ⚠️ ห้ามระบุชื่อค่ายเกม ชื่อธนาคาร ใบอนุญาต หน่วยงานกำกับ ชื่อนิติบุคคล ยอดฝากขั้นต่ำ
// ค่า RTP เป็นตัวเลข จำนวนสมาชิก หรือปีก่อตั้ง — บรีฟไม่ได้ให้มาสักตัว ตัวเลขที่อ้างได้
// มีสี่ตัวเท่านั้นคือ **0.3% · 0.8% · 3 ขั้นตอน · 24ชม.** และทุกประโยคเตือนของบรีฟ
// ต้อง ship ครบ (บรีฟรอบนี้โฆษณาแล้วเบรกเองตลอด ครึ่งที่เบรกคือเนื้อหา ไม่ใช่ filler)
//
// ⚠️ **ไฟล์นี้ไม่ render BankStrip** (ต่างจาก FooterStyle2 ของรอบก่อนที่ import มันเอง)
// บรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารหรือวอลเลทแม้แต่แห่งเดียว** แถบโลโก้ธนาคารคือการ
// อ้างว่ารองรับธนาคารชุดนั้นจริง ซึ่งไม่มีอะไรในบรีฟรองรับ ไฟล์ BankStrip.astro
// ยังอยู่ครบในฐานะ inventory ของแบรนด์ถัดไป **ห้ามลบ**
//
// ลิงก์ของ **สองหน้าหวยที่ปิดอยู่รอบนี้** (/ตรวจหวย · /แนวทาง) ไม่มีในไฟล์นี้
// และห้ามเติมกลับ — รอบนี้เป็นเว็บสล็อต ไม่ใช่เว็บหวย สองหน้านั้นจอดอยู่ใน
// src/pages-disabled/ ซึ่ง Astro ไม่ route ให้ การทิ้งลิงก์ไว้จึงเป็น href ที่ชี้
// route ที่ไม่มีจริง และ verify-build.mjs จะทำให้ build แดง
// route ที่มีจริงรอบนี้: / /about-us /contact-us /login /privacy /promotion /register
// /terms /ทดลองเล่น /ทางเข้า /line
//
// /ทางเข้า ยังเป็นหน้าจริงที่ route อยู่ (แค่ไม่มีรายการในเมนูบน เพราะ cta toggle เปิด
// และ /register กับ /login เป็นหน้าปุ่มจริงแล้ว) ลิงก์ในนี้จึงไม่ตาย
//
// ⚠️ ไฟล์นี้เป็นโครมที่ render ทุกหน้า จึง **ห้ามมี heading tag ทุกระดับ** หัวข้อคอลัมน์
// เป็น <p> ที่ถือคลาสเดิมไว้ และ <nav>/<section> ที่เสียชื่อเรียกไปใช้ aria-label แทน
//
// บล็อก <address> ด้านล่างคัดลอกจาก SKILL.md แบบ verbatim — ห้ามใส่ hex ของแบรนด์ลงไป
// border-white/15 + bg-black/20 + opacity บนสีที่ inherit มา ลงตัวกับ footer ทุกตัวใน
// ไลบรารีซึ่งเป็นพื้นเข้มหมด รวมถึงรอบนี้ที่ตัวเพจสว่างแต่ footer ยังเข้มอยู่
// การ retheme มันคือการทิ้ง hex ของรอบนี้ไว้ให้รอบหน้า
// ที่อยู่กับอีเมลมาจาก BRAND_ADDRESS ล้วน (อนุมานจาก BRAND_NAME + site:) ห้ามพิมพ์เอง
const quickLinks = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// alt เขียนจาก logo.webp ของดรอป 2026-10-23 ที่เปิดอ่านจริง (ไม่มีกระต่ายการ์ตูน
// ผ้าพันคอแดงของโปรดี168 ไม่มีตราชั่งทองสองจานของเงินทอง168 และไม่มีหัวไฉ่ซิงเอี๊ย
// ของดวงเศรษฐี168 อยู่ในรูปนี้เลย) ชื่อแบรนด์ interpolate เสมอ
//
// ไฟล์ต้นทางเป็นจัตุรัส 500x500 และกล่องนี้วาดมันสูง 36px → กว้าง 36px เช่นกัน
// widths/sizes จึงอิง 36px ไม่ใช่ความกว้างของกล่อง
//
// ⚠️ **เป็น <Image format="webp"> ไม่ใช่ <Picture> ที่มี avif โดยตั้งใจ** — ที่
// 36w/72w/108w ค่าโสหุ้ยของคอนเทนเนอร์ AVIF กินมากกว่าที่มันประหยัดได้ ซึ่ง
// `tools/verify-build.mjs` ทำให้ build แดงถูกต้องแล้ว เพราะเบราว์เซอร์ที่รองรับ avif
// จะหยิบไฟล์ที่ **ใหญ่กว่า** การลด quality ไม่ช่วยเพราะพื้นของ avif อยู่ที่
// ~700 ไบต์ไม่ว่าจะลดแค่ไหน **ห้ามเติม avif กลับเข้ามาที่ขนาดนี้**
const logoAlt = `โลโก้ ${BRAND_NAME} เป็นรูปตะกร้าสานทองคำใส่เหรียญทองล้นตะกร้า อยู่ข้างคำว่า ร่ำรวย ตัวอักษรไทยสามมิติผิวมันวาวสีฟ้าไซยาน ต่อท้ายด้วยเลข 168 ผิวโครเมียมเงิน ตัดขอบดำหนา`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#18a5e2]/60 bg-[#202a66] pt-16 pb-8 font-sans text-[#e9f1ff] shadow-[0_-15px_40px_rgba(24,165,226,0.2)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#18a5e2]/25 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#111a3f]/60 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a
          href="/"
          class="flex h-[56px] max-w-max items-center gap-3 overflow-hidden rounded-xl border border-[#18a5e2]/30 bg-[#111a3f] px-5 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Image
                src={mainLogo}
                alt={logoAlt}
                widths={[36, 72, 108]}
                sizes="36px"
                quality={65}
                loading="lazy"
                decoding="async"
                class="h-[36px] w-auto object-contain"
                format="webp"
              />
            ) : (
              <span class="text-2xl font-black tracking-widest text-[#18a5e2]">{BRAND_NAME}</span>
            )
          }
          <span class="text-xl font-black tracking-wide text-[#18a5e2]">{BRAND_NAME}</span>
        </a>
        <p class="border-l-2 border-[#18a5e2] pl-4 text-sm leading-relaxed text-[#e9f1ff]/85">
          {BRAND_NAME} รวบรวมข้อมูลเกมสล็อตออนไลน์หลายรูปแบบ พร้อมรายละเอียดอัตราจ่าย ระดับการเดิมพัน และโปรโมชั่นสำหรับสมาชิกไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถตรวจสอบวิธีสมัครสมาชิก ช่องทางฝากถอน และช่องทางติดต่อเจ้าหน้าที่ได้ก่อนเริ่มใช้งาน
          ทั้งนี้ ผลลัพธ์ของเกมสล็อตมีความไม่แน่นอน และไม่มีเว็บไซต์ใดสามารถรับประกันการชนะในแต่ละรอบได้
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#18a5e2]/40 bg-[#31408a] px-4 py-1 text-xs font-medium text-[#e9f1ff]">คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน</span>
          <span class="rounded-full border border-[#111a3f] bg-[#0d6b9b] px-4 py-1 text-xs font-medium text-white">แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด</span>
        </div>
      </div>

      <nav aria-label="ทางลัดหน้าเว็บ" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#18a5e2] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#18a5e2]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#e9f1ff]/85">
          {quickLinks.map((link) => <li><a href={link.path} class="transition-colors hover:text-[#18a5e2]">{link.name}</a></li>)}
        </ul>
      </nav>

      <section aria-label="ช่องทางติดต่อเจ้าหน้าที่" class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#18a5e2] uppercase drop-shadow-sm">ติดต่อแอดมิน 24ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#18a5e2]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมินผ่าน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#18a5e2]/50 bg-[#31408a]/80 py-3 text-sm font-bold text-[#e9f1ff] transition-all hover:bg-[#31408a]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>
      </section>
    </div>

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e9f1ff]/75 md:block">
      {BRAND_NAME} จัดวางข้อมูลเกมสล็อตออนไลน์ให้ผู้ใช้งานเข้าถึงได้จากจุดเดียว ตั้งแต่ระดับการเดิมพันของแต่ละเกม ไปจนถึงกติกาและเงื่อนไขที่ควรอ่านก่อนเลือกใช้งาน โดยเกมที่เปิดให้บริการมีระดับการเดิมพันแตกต่างกัน
      รวมถึงเกมที่กำหนดเงินเดิมพันเริ่มต้นในระดับต่ำ ผู้ใช้งานจึงควรศึกษากติกา ตารางจ่ายรางวัล และค่า RTP ที่ผู้พัฒนาเปิดเผยก่อนเลือกเกม พร้อมตรวจสอบยอดฝากขั้นต่ำและวงเงินถอนตามเงื่อนไขจริง เพราะแต่ละบริการอาจกำหนดข้อจำกัดแตกต่างกัน
      แม้จะมีข้อความระบุว่าไม่อั้นจ่ายหรือไม่อั้นถอน ก็ไม่ควรสรุปว่าไม่มีเพดานธุรกรรมโดยไม่ตรวจสอบข้อกำหนดล่าสุด ด้านโปรโมชั่นที่ระบุไว้คือคืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน และแนะนำเพื่อนโบนัส 0.8% ไม่จำกัด
      ซึ่งแต่ละรายการอาจกำหนดประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิตแตกต่างกัน แม้จะระบุว่ากดรับได้ไม่จำกัด แต่ควรตรวจสอบจำนวนครั้งที่รับสิทธิ์ได้จริงจากประกาศล่าสุด ทั้งนี้ การคืนเครดิตไม่ได้หมายความว่าจะได้รับเงินคืนจากทุกการเดิมพันหรือทำให้มีโอกาสชนะมากขึ้น
      สำหรับผู้ที่สนใจลงทะเบียนสมาชิกมีขั้นตอนหลักเพียง 3 ขั้นตอน คือตรวจสอบที่อยู่เว็บไซต์ให้ถูกต้องแล้วเข้าสู่หน้าสมัครสมาชิก กรอกข้อมูลตามที่ระบบกำหนดและตั้งรหัสผ่านที่คาดเดาได้ยาก แล้วจึงเข้าสู่ระบบเพื่อศึกษารายชื่อเกมสล็อต กติกาการเล่น และยอดเดิมพันขั้นต่ำ
      ก่อนลงทะเบียนควรตรวจสอบคุณสมบัติผู้สมัคร ข้อกำหนดด้านอายุ และกฎหมายที่เกี่ยวข้อง รวมถึงศึกษานโยบายความเป็นส่วนตัวเพื่อทำความเข้าใจวิธีจัดเก็บข้อมูลส่วนบุคคล ไม่ควรใช้ข้อมูลของบุคคลอื่น และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้ใครทราบ
