---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx level this section's own heading sits at. Never hardcoded below. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven heading below is the docx's own FAQ
// heading, so it stays a heading — at whatever level `as` says.
//
// `faqs` defaults to an empty list on purpose: the page always passes the docx's
// own Q/A pairs, so there is no default copy here that could silently ship a
// previous brand's wording.
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all.
//
// NAZA168 (รอบทองอวกาศ-เงินโครเมียม บนน้ำตาลคั่วเข้ม 2026-10-10, brand-spec §2):
// แถวที่ปิดอยู่ไล่จากผิวกลาง #432b03 ลงไปหาผิวลึกสุด #241700 ในกรอบทองลึกสุด #6b4a05
// ซึ่งเป็นกรอบที่เงียบที่สุดในหน้า แล้วสว่างขึ้นเป็นทองแบรนด์ #fbc134 ตอน hover และตอน
// แถวถูกเปิด เครื่องหมายบวกเป็นทองแบรนด์แล้วสลับเป็นโครเมียมสว่าง #eef2f8 ตอนเปิด —
// สถานะเปิดจึง "เปลี่ยนฮิว" จากทองไปเงินจริงๆ ตามคู่สีของเหรียญตรา (NAZA ทอง / 168 เงิน)
// ไม่ใช่แค่หมุนเครื่องหมาย
// หัวข้อไล่โครเมียมสว่าง #eef2f8 → ทองสว่าง #ffe87a → ทองแบรนด์ #fbc134 ซึ่งเป็นลำดับ
// "เงินนำเข้าทอง" ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกัน และทุกจุดของไล่เฉดยังอ่านออกบน
// ผิวมืด — §2 ห้าม #96690a ถือตัวอักษร จึงไม่ถูกใช้เป็นปลายเข้มของหัวข้อที่นี่
// คำถามเป็นทองสว่าง #ffe87a เนื้อความ #fdf3df (= BRAND_TEXT)
//
// ⚠️ หกในเจ็ดแบรนด์ก่อนหน้าก็มีทอง เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดแดงสด-ทองของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #9c0201
// #ffc93c #ffeab0 #c08a07 #240406 #180303 #f6e7e0) ชุดทอง-แดงเลือดหมูของ GOT777
// (#f5c518 #ffe9a8 #96690f #d21622 #160b06 #0a0503 #fff6dd #ece0cb) และชุดแดง-ทอง
// ของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุดแล้ว —
// #96690f ของ GOT777 ต่างจาก #96690a ของรอบนี้อยู่หลักเดียว และ #f5c518 ก็ไม่ใช่
// #fbc134 นี่คือกรณีที่พลาดง่ายที่สุด ต้องเทียบเป็นค่า ไม่ใช่เทียบตระกูลสี
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <HeadingTag class="mb-8 bg-gradient-to-r from-[#eef2f8] via-[#ffe87a] to-[#fbc134] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">
        {title}
      </HeadingTag>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#6b4a05]/80 bg-gradient-to-br from-[#432b03] to-[#241700] transition-all hover:border-[#fbc134]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#ffe87a]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#fbc134]/50 text-lg leading-none font-black text-[#fbc134] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#6b4a05]/80 p-5 pt-0 text-left text-base leading-relaxed text-[#fdf3df]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(251, 193, 52, 0.6);
    box-shadow: 0 0 20px rgba(251, 193, 52, 0.28);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #cfd6e3;
    color: #eef2f8;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
