---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx level this section's own heading sits at. Never hardcoded below. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven heading below is the docx's own FAQ
// heading, so it stays a heading — at whatever level `as` says.
//
// `faqs` defaults to an empty list on purpose: the page always passes the docx's
// own Q/A pairs, so there is no default copy here that could silently ship a
// previous brand's wording.
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02): แถวที่ปิดอยู่นั่งบนผิวการ์ด #240406 ที่ไล่ลงไปหาผิว
// แถบ #180303 ในกรอบแดงลึก #9c0201 เครื่องหมายบวกเป็นทอง #ffc93c แล้วสลับเป็นแดงแบรนด์
// #dc0203 ตอนแถวถูกเปิด ซึ่งเป็นสีของคำว่า "หวย" ในเวิร์ดมาร์ก และทำให้สถานะเปิดมีการ
// เปลี่ยนสีจริง ไม่ใช่แค่หมุนเครื่องหมาย หัวข้อไล่ทองอ่อน #ffeab0 → ทอง #ffc93c → ทองลึก
// #c08a07 คำถามเป็นทองอ่อน #ffeab0 เนื้อความ #f6e7e0 (BRAND_TEXT) — ชุดทอง-แดงเลือดหมู
// ของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622 #160b06 #0a0503 #fff6dd #ece0cb) และชุด
// แดง-ทองของ หวยเฮง789 (#dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <HeadingTag class="mb-8 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">
        {title}
      </HeadingTag>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#9c0201]/70 bg-gradient-to-br from-[#240406] to-[#180303] transition-all hover:border-[#ffc93c]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#ffeab0]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#ffc93c]/50 text-lg leading-none font-black text-[#ffc93c] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#9c0201]/70 p-5 pt-0 text-left text-base leading-relaxed text-[#f6e7e0]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(255, 201, 60, 0.6);
    box-shadow: 0 0 20px rgba(255, 201, 60, 0.28);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #dc0203;
    color: #f5282a;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
