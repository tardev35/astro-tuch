---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx level this section's own heading sits at. Never hardcoded below. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven heading below is the docx's own FAQ
// heading, so it stays a heading — at whatever level `as` says.
//
// `faqs` defaults to an empty list on purpose: the page always passes the docx's
// own Q/A pairs, so there is no default copy here that could silently ship a
// previous brand's wording.
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all. Do not reintroduce
// one; a button + max-height accordion leaves the collapsed panel in the tab
// order while invisible.
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// ใบนี้ปิดท้ายหน้าและเป็นบล็อกเดียวที่ **ไม่มีการ์ดครอบ** — แถวคำถามวางลงบนพื้นเพจ
// ดำสนิทตรงๆ จึงเป็นจังหวะโปร่งสุดท้ายของหน้า
// แถวที่ปิดอยู่ไล่จากผิวกลาง #1a0914 ลงไปหาผิวจม #0d040a ในกรอบพลัมเข้ม #6d0b3f
// ซึ่งเป็นกรอบที่เงียบที่สุดในหน้า แล้วสว่างขึ้นเป็นชมพูบับเบิลกัม #fa63b9 ตอน hover
// และตอนแถวถูกเปิด
// ⚠️ สถานะ "เปิด" ของรอบนี้ **สลับฮิว** ไม่ใช่เลื่อนค่าของสีเดียว: เครื่องหมายบวก
// เป็นชมพูบับเบิลกัม #fa63b9 ตอนปิด แล้วสลับเป็นทองเนย #ffd84d ตอนเปิด ตรงกับโลโก้
// ที่ตัวอักษรชมพูตัดขอบทอง
// หัวข้อไล่ เนื้อความครีมอมชมพู #fdeaf5 → ชมพูบับเบิลกัม #fa63b9 → ทองเนย #ffd84d
// ("ครีม → ชมพูนำ → ทอง") ซึ่งเป็นลำดับที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (18.3 / 7.7 / 14.4 บนพื้นดำ) — §2 ห้าม #6d0b3f (1.5:1) กับ #6b4708
// (2.1:1) ถือตัวอักษร จึงไม่ถูกใช้เป็นปลายเข้มของหัวข้อหรือของคำถามที่นี่
// คำถามเป็นชมพูอ่อน #ffb3de (10.7:1) คำตอบเป็น #fdeaf5 (= BRAND_TEXT)
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ชมพู และ ทอง** เพราะรอบที่แล้ว (มีโชค168) ก็เป็น
// ทอง+ชมพูบนดำเหมือนกัน การเจอชมพูหรือทองในไฟล์นี้ไม่พิสูจน์อะไร ต้องเทียบเป็น "ค่า"
// ทีละตัว: ชมพูรอบนี้ **#fa63b9 / #ffb3de** ไม่ใช่ f5469f / ff8dc6 (มีโชค168) หรือ
// f41571 / ff5ca8 (PUNPRO168) · ทองรอบนี้ **#ffd84d** ไม่ใช่ fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) dfa310 / ffe4a3 / ffc93d (TND168 — ชุดที่เพิ่งค้างอยู่ทั้งไฟล์
// นี้ รวมถึงใน <style> ด้านล่าง ซึ่งเป็นจุดที่ชุดเก่ารอดการสวีปมาก่อน) f0b429
// (รับตัง168) e3b23c (สมหวัง168) fbc134 / ffe87a (NAZA168) หรือ f5c518 (GOT777)
// ชุดเต็มของ TND168 ที่ต้องออกให้หมด (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b
// 120c04 070502 + rgba 223,163,16) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6
// 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดทองอวกาศ-เงินโครเมียมของ
// NAZA168 (fbc134 ffe87a cf9a18 96690a 6b4a05 eef2f8 cfd6e3 9aa6bb fdf3df) และชุด
// แดงสด-ทองของ หวย365 (dc0203 f5282a 9c0201 ffc93c ffeab0 c08a07 240406 f6e7e0)
// ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/เทา/โครเมียม โรสโกลด์ และ
// แดงชาด** — eef2f8 cfd6e3 9aa6bb 3f4859 ต้องไม่เหลือในไฟล์นี้
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <HeadingTag class="mb-8 bg-gradient-to-r from-[#fdeaf5] via-[#fa63b9] to-[#ffd84d] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">
        {title}
      </HeadingTag>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#6d0b3f] bg-gradient-to-br from-[#1a0914] to-[#0d040a] transition-all hover:border-[#fa63b9]/60">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#ffb3de]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#fa63b9]/60 text-lg leading-none font-black text-[#fa63b9] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#6d0b3f] p-5 pt-0 text-left text-base leading-relaxed text-[#fdeaf5]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(250, 99, 185, 0.65);
    box-shadow: 0 0 20px rgba(250, 99, 185, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #ffd84d;
    color: #ffd84d;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
