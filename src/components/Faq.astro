---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx level this section's own heading sits at. Never hardcoded below. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven heading below is the docx's own FAQ
// heading, so it stays a heading — at whatever level `as` says.
//
// `faqs` defaults to an empty list on purpose: the page always passes the docx's
// own Q/A pairs, so there is no default copy here that could silently ship a
// previous brand's wording. รอบนี้หน้าแรกส่งสามคู่ Q/A ของบรีฟมา (content.txt
// บรรทัด 24-29) และส่ง array เดียวกันนั้นเข้า pageGraph ด้วย
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all. Do not reintroduce
// one; a button + max-height accordion leaves the collapsed panel in the tab
// order while invisible.
//
// ───────────────────────────────────────────────────────────────────────────
// หมูบิน168 (ดรอป 2026-10-24, .claude/brand-spec-moobin168.md §2) —
// **ชมพูแคนดี้นำ · พลัมเข้มเป็นหมึก · บนพื้นชมพูพาสเทลสว่าง**
// 🚨🚨 **ธีมสว่าง** bg.json = {"mode":"color","color":"#ffe5ff"} (รอบก่อน สล็อต168
// เป็น 140000 ดำอมแดง) → **ห้ามแก้แถวกลับไปเป็นผิวมืด** ผิวมืดใต้หมึก #3b0b26
// = ตัวอักษรหายไปเลย ซึ่งเป็นความผิดพลาดกลับด้านของรอบก่อนเป๊ะ ๆ
//
// ใบนี้ปิดท้ายหน้าและเป็นบล็อกเดียวที่ **ไม่มีการ์ดครอบ** — แถวคำถามวางลงบนพื้นเพจ
// ชมพูพาสเทล #ffe5ff ตรง ๆ จึงเป็นจังหวะโปร่งสุดท้ายของหน้า
// แถวที่ปิดอยู่ไล่จากผิวขาว #ffffff ลงไปหา wash #ffeef7 ในกรอบ #f7bcd9 แล้วเข้มขึ้น
// เป็น #ef8dbd ตอน hover และตอนแถวถูกเปิด
// ⚠️ สถานะ "เปิด" ของรอบนี้ **สลับฮิว** ไม่ใช่เลื่อนค่าของสีเดียว: เครื่องหมายบวก
// เป็นชมพูเข้ม #c2185b ตอนปิด แล้วสลับเป็นโรสเข้มสุด #8e0f41 ตอนเปิด
// ⚠️ หัวข้อของใบนี้นั่งบน **พื้นเพจ ไม่ใช่การ์ด** จึงไล่เฉดด้วยค่าที่ §2 ให้ถือ
// ตัวอักษรได้เท่านั้น: #8e0f41 (7.8:1 บน #ffe5ff) → #c2185b (5.0:1) → #8e0f41
// **ห้ามเอา #fa539c เข้าไปเป็นสต็อปในไล่เฉดนี้** — มันได้แค่ 2.8:1 บนพื้นเพจ
// คำถามเป็น #8e0f41 (9.2:1 บนขาว) คำตอบเป็น #3b0b26 (= BRAND_TEXT, 16.8:1)
// ⚠️ **#f7bcd9 #ef8dbd #fa539c ห้ามถือตัวอักษร** — ในไฟล์นี้อยู่ที่เส้นและพื้นเท่านั้น
// rgba() ที่ใช้รอบนี้: rgba(194,24,91,α) (เงานูนฝั่งมืด) · rgba(250,83,156,α) (ออราตอนเปิด)
//
// ⚠️⚠️ **กับดักรอบนี้คือชมพู เพราะชมพูเคยนำมาแล้วหลายแบรนด์** การเจอชมพูในไฟล์นี้
// ไม่พิสูจน์อะไร ต้องเทียบเป็น "ค่า" ทีละตัว ชมพูรอบนี้คือ **#fa539c (R250 G83 B156)**
// วัดตรงจาก logo.webp ของดรอปนี้
// ⚠️⚠️ **ไฟล์นี้เพิ่งถือชุดแมเจนต้าของ มีทรัพย์168 มาทั้งใบ** (dd1b74 a4186b 4a0d35
// f7dcf6 f0ccf5 + rgba 221,27,116 / 164,24,107 รวมถึงใน <style> ด้านล่าง ซึ่งเป็นจุด
// ที่ชุดเก่ารอดการสวีปมาก่อน) — ออกครบทุกค่าแล้ว **a4186b มี 18 อยู่กลางค่าเหมือน
// #c2185b และ 4a0d35/2d0720 ใกล้ #3b0b26** เจอค่าไหนก็แปลว่าพิมพ์ผิด
// ⚠️⚠️ **มีทรัพย์168 ก็เป็นหมูการ์ตูนสีชมพูเหมือนกัน แต่เป็นหมูสวมหน้ากากโจรบนธีม
// แมเจนต้าพื้นมืด** ส่วนรอบนี้คือหมูมีปีกนางฟ้าสีขาวกับหัวใจบนธีมแคนดี้พื้นสว่าง
// ⚠️ ชมพู/แดงของแบรนด์อื่นที่ห้ามใช้เพิ่มเติม: fa63b9 ffb3de (ถอนชัวร์168) ·
// f5469f ff8dc6 8c0f52 (มีโชค168 — 8c0f52 ห่างจาก #8e0f41 แค่ R2/B17) · ff2e52
// e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · fa0513 ff5a5f ffadaf
// (สมหวัง168) · b3121b f2bba5 fce2d4 fcd4c3 (ขวัญใจ168 / หวยคิง) · f41571 ff5ca8
// (PUNPRO168) · ff3fa4 ffd1ea (FAH999)
// ⚠️⚠️ **สล็อต168 คือแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**: fb2e33 cb0b0d d81115
// b00d11 8a0608 c9060a fa292c f92124 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
// 1c0607 2a0c0d 551c1e — ไม่มีเหลือในไฟล์นี้
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองสักเฉด ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีส้ม
// ไม่มีเขียว (LINE green กับเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น) ไม่มีครีม/เบจ/
// น้ำตาล และไม่มีแรมป์เทาเงินเย็น**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <HeadingTag class="mb-8 bg-gradient-to-r from-[#8e0f41] via-[#c2185b] to-[#8e0f41] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent md:text-4xl">
        {title}
      </HeadingTag>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-plain"
          class="faq-item group overflow-hidden rounded-2xl border border-[#f7bcd9] bg-gradient-to-br from-white to-[#ffeef7] shadow-[6px_6px_16px_rgba(194,24,91,0.10),-6px_-6px_16px_#ffffff] transition-all hover:border-[#ef8dbd]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#8e0f41]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#ef8dbd] bg-[#fff0f8] text-lg leading-none font-black text-[#c2185b] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#f7bcd9] p-5 pt-0 text-left text-base leading-relaxed text-[#3b0b26]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: #ef8dbd;
    box-shadow: 0 0 22px rgba(250, 83, 156, 0.25);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #c2185b;
    color: #8e0f41;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
