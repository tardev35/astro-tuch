---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question used to be an <h3>. The docx's only two h3s are the two
// promotion sections, so a question rendering as a heading would add three more
// and break the heading inventory — it is a <p> with the same classes now, and
// the section takes its accessible name from aria-label.
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <h2 class="mb-8 bg-gradient-to-b from-[#ffe98a] to-[#d31411] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">
        {title}
      </h2>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#a97a08]/30 bg-gradient-to-br from-[#1c0707] to-[#0d0303] transition-all hover:border-[#fdd32d]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#f7e4dc] md:text-lg">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f5322e]/50 text-lg leading-none font-black text-[#f5322e] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#a97a08]/45 p-5 pt-0 text-left text-base leading-relaxed text-[#f7e4dc]/80">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* State comes from the [open] attribute, not from an `active` class a script
     toggles — that is why this variant has no <script> at all. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(253, 211, 45, 0.6);
    box-shadow: 0 0 20px rgba(211, 20, 17, 0.45);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #fdd32d;
    color: #ffe98a;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
