---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  /** The docx level this section's own heading sits at. Never hardcoded below. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FaqItem[];
}

const { title, as: HeadingTag = "h2", faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven heading below is the docx's own FAQ
// heading, so it stays a heading — at whatever level `as` says.
//
// `faqs` defaults to an empty list on purpose: the page always passes the docx's
// own Q/A pairs, so there is no default copy here that could silently ship a
// previous brand's wording. รอบนี้หน้าแรกส่งสามคู่ Q/A ของบรีฟมา (content.txt
// บรรทัด 24-29) และส่ง array เดียวกันนั้นเข้า pageGraph ด้วย
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all. Do not reintroduce
// one; a button + max-height accordion leaves the collapsed panel in the tab
// order while invisible.
//
// ───────────────────────────────────────────────────────────────────────────
// TEVA69 (ดรอป 2026-10-28, .claude/brand-spec-teva69.md §2) —
// **เขียวป่านำ · หมึกเขียวจมเป็นเนื้อความ · บนพื้นขาวอมมิ้นต์จางสว่าง**
// 🚨🚨 **ธีมสว่าง** bg.json = {"mode":"color","color":"#f0ffeb"} (รอบก่อน LOTTO189
// เป็น fff0f0 ขาวอมชมพูจาง — **คนละค่า เปิด bg.json ทุกรอบ**) → **ห้ามแก้แถว
// กลับไปเป็นผิวมืด** ผิวมืดใต้หมึก #10280f = ตัวอักษรหายไปเลย
//
// ใบนี้ปิดท้ายเนื้อหา docx ของหน้าและเป็นบล็อกเดียวที่ **ไม่มีการ์ดครอบ** — แถว
// คำถามวางลงบนพื้นเพจขาวอมมิ้นต์ #f0ffeb ตรง ๆ จึงเป็นจังหวะโปร่งสุดท้ายของบทความ
// แถวที่ปิดอยู่ไล่จากผิวขาว #ffffff ลงไปหาผิวยก #e6f7df ในกรอบ #b2dba3 แล้วเข้มขึ้น
// เป็น #3f7a2e ตอน hover และตอนแถวถูกเปิด
// ⚠️ สถานะ "เปิด" ของรอบนี้ **สลับค่า** ไม่ใช่เลื่อนความสว่างของสีเดียว: เครื่องหมาย
// บวกเป็นเขียวป่า #116018 ตอนปิด แล้วสลับเป็นเขียวลึก #0b4a12 ตอนเปิด
// ⚠️ หัวข้อของใบนี้นั่งบน **พื้นเพจ ไม่ใช่การ์ด** จึงไล่เฉดด้วยค่าที่ §2 ให้ถือ
// ตัวอักษรได้เท่านั้น: #0b4a12 (10.1:1 บน #f0ffeb) → #116018 (7.5:1) → #0b4a12
// **ห้ามเอา #28c437 หรือ #e3bb45 เข้าไปเป็นสต็อปในไล่เฉดนี้** — สองค่านั้นได้
// 2.3:1 และ 2.0:1 บนผิวสว่าง และพิกเซลของ bg-clip-text **คือตัวอักษร** ไม่ใช่พื้นหลัง
// คำถามเป็น #0b4a12 (10.5:1 บนขาว) คำตอบเป็น #10280f (= BRAND_TEXT, 15.8:1)
// ⚠️ **#b2dba3 #3f7a2e #28c437 #e3bb45 #c6cfd2 #e6f7df #d7f0cd #f0ffeb ห้ามถือ
// ตัวอักษร** — ในไฟล์นี้อยู่ที่เส้น ขอบ เงา และพื้นเท่านั้น
// rgba() ที่ใช้รอบนี้: rgba(17,96,24,α) (เงานูนฝั่งมืด) · rgba(40,196,55,α) (ออราตอนเปิด)
//
// ⚠️⚠️ **กับดักรอบนี้คือเขียว เพราะเขียวเคยนำมาแล้วหลายแบรนด์ และเป็นฮิวที่ตาแยกค่า
// ได้ยากที่สุด** การเจอเขียวในไฟล์นี้ไม่พิสูจน์อะไร ต้องเทียบเป็น "ค่า" ทีละตัว
// เขียวรอบนี้คือ **#116018 (R17 G96 B24) · #0b4a12 · #1a7d24 · #28c437 · #3f7a2e ·
// #b2dba3** วัดตรงจาก logo.webp / banner1.png / slide1.png ของดรอปนี้
// ⚠️⚠️ **ไฟล์นี้เพิ่งถือชุดชมพูแคนดี้ของ หมูบิน168 มาทั้งใบ** (fa539c c2185b 8e0f41
// fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 + rgba 194/24/91
// และ rgba 250/83/156 รวมถึงใน <style> ด้านล่าง ซึ่งเป็นจุดที่ชุดเก่ารอดการสวีป
// มาก่อน) — ออกครบทุกค่าแล้ว **และ <style> ด้านล่างถูกตรวจซ้ำแล้วรอบนี้**
// ⚠️⚠️ **LOTTO189 คือแบรนด์ขาออกทันที = เสี่ยงหลงเหลือสูงสุด**: fff0f0 ffe4e6 ffd4d7
// f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c
// 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6 — ไม่มีเหลือในไฟล์นี้
// **e9b53c ↔ e3bb45 · c3ccd6 ↔ c6cfd2 · 8f6310 ↔ 8a6a0e**
// ⚠️ เขียวของแบรนด์อื่นที่ห้ามใช้: 8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05
// 06220a a87a08 f2c230 ffe066 (KINGKONG555 — **e9f7d6 ↔ e6f7df · bde397 ↔ b2dba3 ·
// 1a5c04 ↔ 1a7d24**) · 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168 — **0b7d28 ↔
// 0b4a12**) · 1fae1c 0d2312 143a1c 07130a (888PARUAY) · 117a41 2bb061 2fbf6a
// (MEXICANOSLOT/KOON234 — **2bb061 ↔ 28c437**)
// ⚠️ ชุดอื่นที่ห้ามกลับเข้ามา: 2a1206 7a3a0c fff3e0 e0b784 c98a24 c23400 d13800
// fa4903 fde90b e8a000 ff8a2b d8dde6 (ZNOVA168) · 7a1bd6 2b3fd9 c2178b f23bb4
// bb6dff 7aa7ff 5411c4 241046 f8e6f9 f6edfe ece0fb dcc6f4 (ZANE96) · de2b1e f2a033
// a81410 c81e12 3f130d fdeee2 fff3ea fed7b5 (MEXICANOSLOT) · fb2e33 cb0b0d d81115
// 140000 (สล็อต168) · ff2e52 e01238 c9102f (มาดาม168) · 18a5e2 0d6b9b a9d7f2
// (ร่ำรวย168) · 00bfff 12b4ef b6e3f0 eaf7ff (โบ๊ะบ๊ะ168)
// ⚠️ **รอบนี้ไม่มีชมพู/แมเจนต้า ไม่มีแดง ไม่มีทอง/เหลืองเป็นฮิวนำ ไม่มีฟ้า/น้ำเงิน/
// ไซยาน ไม่มีม่วง ไม่มีส้ม ไม่มีครีม/เบจ/น้ำตาล และไม่มีแรมป์เทาเงินบนผิวสว่าง**
// (LINE green 00B900 กับเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืน
// เข้าพาเลตเขียวของรอบนี้**)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <HeadingTag class="mb-8 bg-gradient-to-r from-[#0b4a12] via-[#116018] to-[#0b4a12] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent md:text-4xl">
        {title}
      </HeadingTag>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-plain"
          class="faq-item group overflow-hidden rounded-2xl border border-[#b2dba3] bg-gradient-to-br from-white to-[#e6f7df] shadow-[6px_6px_16px_rgba(17,96,24,0.10),-6px_-6px_16px_#ffffff] transition-all hover:border-[#3f7a2e]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#0b4a12]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#b2dba3] bg-[#e6f7df] text-lg leading-none font-black text-[#116018] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#b2dba3] p-5 pt-0 text-left text-base leading-relaxed text-[#10280f]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: #3f7a2e;
    box-shadow: 0 0 22px rgba(40, 196, 55, 0.25);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #3f7a2e;
    color: #0b4a12;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
