---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven <h2> below is the docx's own FAQ
// heading, so it stays a heading.
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {title && <h2 class="mb-8 bg-gradient-to-b from-[#f4f6f8] to-[#e01a2b] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">{title}</h2>}

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#7a1219]/60 bg-gradient-to-br from-[#170a0b] to-[#0a0607] transition-all hover:border-[#ff3b4d]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#f4f6f8]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#ff3b4d]/50 text-lg leading-none font-black text-[#e01a2b] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#7a1219]/60 p-5 pt-0 text-left text-base leading-relaxed text-[#e8dadb]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* State comes from the [open] attribute, not from an `active` class a script
     toggles — that is why this variant has no <script> at all. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(224, 26, 43, 0.6);
    box-shadow: 0 0 20px rgba(224, 26, 43, 0.32);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e01a2b;
    color: #f4f6f8;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
