---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question used to be an <h3>. This brand's docx is flat H1 + H2, so a
// question rendering as a heading would add three levels the brief does not
// have — it is a <p> with the same classes, and the section takes its
// accessible name from aria-label. The prop-driven <h2> below is the docx's
// own FAQ heading, so it stays a heading.
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <h2 class="mb-8 bg-gradient-to-b from-[#eefae4] to-[#69b522] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">
        {title}
      </h2>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#2f7a2a]/45 bg-gradient-to-br from-[#0b2415] to-[#04120a] transition-all hover:border-[#69b522]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#eefae4] md:text-lg">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#69b522]/50 text-lg leading-none font-black text-[#9ada4e] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#2f7a2a]/45 p-5 pt-0 text-left text-base leading-relaxed text-[#d6e6cc]/85">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* State comes from the [open] attribute, not from an `active` class a script
     toggles — that is why this variant has no <script> at all. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(105, 181, 34, 0.6);
    box-shadow: 0 0 20px rgba(105, 181, 34, 0.32);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #9ada4e;
    color: #eefae4;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
