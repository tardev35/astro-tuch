---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question used to be an <h3>. A FAQ question is not a docx heading, so it
// renders as a <p> with the same classes and the section takes its accessible
// name from aria-label. The prop-driven <h2> below is the docx's own FAQ
// heading, so it stays a heading.
//
// State comes from the [open] attribute, not from an `active` class a script
// toggles — that is why this variant has no <script> at all.
//
// Closed rows sit on gold; an open row switches its plus-sign to brushed
// silver, which is the second half of the MEPAY77 wordmark and gives the open
// state a colour change rather than only a rotation.
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {title && <h2 class="mb-8 bg-gradient-to-b from-[#fff6e0] to-[#f2ae35] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">{title}</h2>}

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#5c3a08]/70 bg-gradient-to-br from-[#1b1206] to-[#130c01] transition-all hover:border-[#f2ae35]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <p class="text-base leading-normal font-bold text-[#fff6e0]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f2ae35]/50 text-lg leading-none font-black text-[#fdcc5c] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#5c3a08]/70 p-5 pt-0 text-left text-base leading-relaxed text-[#f1e5cd]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(242, 174, 53, 0.6);
    box-shadow: 0 0 20px rgba(253, 204, 92, 0.28);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #dfe3e8;
    color: #dfe3e8;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
