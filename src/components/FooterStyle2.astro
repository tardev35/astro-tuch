---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน KINGKONG555 ใช้ FooterStyle3 ส่วนไฟล์นี้ค้างเป็นชุดแดงแล็กเกอร์-ทอง
// ตรุษจีนของ PIGPG ย้ายทั้งไฟล์มาเป็นพื้นน้ำตาลถ่านเกือบดำ #180800 + แดงเสือโคร่ง
// #e8232a + แดงลึก #7d0f12 + ผิวยก #4a0605 + ทองถ่านไฟ #f2b705 + ทองอ่อน #ffd666
// + ทองเข้ม #a8730a เนื้อความครีม #fbe8d5 และตัวรองครีมหม่น #c9a898 (8.9:1 บนพื้นนี้)
//
// FooterStyle3 ของรอบก่อนเป็นแผ่นที่มีการ์ด CTA ลอยคร่อมขอบบน (-top-14) แล้วตาม
// ด้วยกริด 12 คอลัมน์ — ไฟล์นี้เป็นคนละทรง: แผ่นแบนขอบบนเป็นเส้นหนา 3px ไม่มี
// การ์ดลอย และเนื้อในเป็นกริด 4 คอลัมน์เท่ากัน
//
// ⚠️ รอบนี้ฮิวของแบรนด์เองเป็น "สีแดง" และไฟล์นี้ค้างแดงของ PIGPG อยู่ก่อนแล้ว
// เจอแดงที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดแดงแล็กเกอร์ของ
// PIGPG (#d4200d #f5b61d #ffd87a #b07a06 #120302 #2a0806 #6b0402 #fdeedd #c9a48d
// #fdf9e4 rgba(245,182,29,α) rgba(212,32,13,α)) ชุดทองเมทัลลิกของ 789BETTING
// (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #f3e7cd #17130a) และชุดเขียวป่า
// ของ หวยเต็ง (#e5c04f #03150a #d8ead9 #0bb42f #bd8d2d) ออกครบทุกจุดแล้ว
// ทองของรอบนี้ก็เป็นคนละค่ากับทองของทุกชุดข้างบน อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
//
// SUPERSLOTCLUB เป็นคลับ/ชุมชนคนเล่นสล็อต ไม่ใช่เว็บหวยและไม่ใช่คาสิโนรวมหมวด
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
// ไม่มี "1 บาท" ซึ่งเป็นตัวเลขพาดหัวของ KINGKONG555 รอบก่อน ไม่ใช่ของบรีฟนี้
// และไม่มีคำว่าหวย บาคาร่า รูเล็ต หรือบอล เพราะบรีฟรอบนี้เป็นสล็อตล้วน
const gameCategories = ["สล็อตคลาสสิกตามรายการที่เปิดให้บริการ", "เกมฟรีสปินและรอบโบนัส", "สล็อตที่มีโบนัสตัวคูณ", "เกมใหม่จากค่ายที่เปิดให้บริการ", "จัดหมวดหมู่ไว้ให้ค้นหาเกมได้สะดวก"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นครีม คำหลังเป็นทองแบรนด์ ทุกคู่เป็นคำที่บรีฟพูดไว้เอง
// ไม่มีคำโฆษณาอย่าง "เว็บตรง" "จ่ายจริง" "ค่ายแท้" หรือ "การันตีเว็บแท้"
const claimChips = [
  { lead: "ดับเบิ้ล", tail: "โบนัส" },
  { lead: "จัดเต็ม", tail: "ทุกค่าย" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

const logoAlt =
  "โลโก้ SUPERSLOTCLUB บนพื้นโปร่งใส ด้านบนเป็นหัวเสือโคร่งลายส้มสลับดำมองตรงมาทางผู้ชม ดวงตาสีเหลืองอำพัน สองข้างเป็นอุ้งเท้าเสือที่มีเล็บสีขาวเกี่ยวขอบป้ายไว้ ด้านล่างเป็นป้ายโล่สีแดงเลือดหมูขอบแดงเข้ม คาดคำว่า SUPERSLOTCLUB ด้วยตัวอักษรละตินหนาสามมิติสีแดงไล่เงาโครเมียม และมีพลอยแดงทรงข้าวหลามตัดอยู่กึ่งกลางขอบล่างของป้าย";
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f2b705] bg-[#180800] pt-16 pb-8 font-sans text-[#fbe8d5] shadow-[0_-10px_30px_rgba(242,183,5,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f2b705]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#e8232a]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(242,183,5,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(242,183,5,0.45)]">
                <span class="bg-gradient-to-b from-[#fbe8d5] to-[#c9a898] bg-clip-text text-transparent">SUPERSLOT</span>
                <span class="bg-gradient-to-b from-[#ffd666] to-[#a8730a] bg-clip-text text-transparent">CLUB</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fbe8d5]">
          {BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ที่นำเสนอรูปแบบชุมชนสำหรับผู้สนใจเกมสล็อตออนไลน์ รวบรวมข้อมูลเกมจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่นที่เปิดให้รับในแต่ละช่วงไว้ในระบบเดียว สมาชิกติดตามเกมใหม่
          ตรวจสอบรายละเอียดโบนัส และเลือกหมวดเกมที่สนใจได้จากที่เดียว ส่วนการกล่าวถึงกลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลกิจกรรมและผู้เข้าร่วมที่ตรวจสอบได้ เพื่อไม่ให้เกิดความเข้าใจคลาดเคลื่อน
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f2b705]/50 bg-[#f2b705]/10 px-3 py-1.5 text-xs font-bold text-[#ffd666] shadow-[0_0_10px_rgba(242,183,5,0.25)]">
            <span aria-hidden="true" class="text-base">🎰</span> ดับเบิ้ลโบนัส
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#7d0f12] bg-[#4a0605]/80 px-3 py-1.5 text-xs font-bold text-[#fbe8d5]">
            <span aria-hidden="true" class="text-base">⏰</span> แอดมิน 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd666]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd666] to-[#a8730a]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#fbe8d5] transition-all hover:text-[#ffd666]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#e8232a] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดเกมสล็อตที่เปิดให้บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd666]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd666] to-[#a8730a]"></span> หมวดเกมสล็อต
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#fbe8d5] transition-all hover:text-[#ffd666]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a898] transition-colors group-hover:bg-[#e8232a] group-hover:shadow-[0_0_8px_rgba(232,35,42,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd666]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd666] to-[#a8730a]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#ffd666]/90 uppercase">รองรับวอลเลทและธนาคารชั้นนำ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f2b705]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#fbe8d5] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#f2b705]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#c9a898] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffd666]">{BRAND_NAME}</span>. All rights reserved. คลับคนเล่นสล็อตซุปเปอร์ รวมสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ
        และเกมใหม่จากค่ายที่เปิดให้บริการไว้ในระบบเดียว ส่วนคำว่าดับเบิ้ลโบนัสไม่ได้หมายความว่าจะได้รับโบนัสสองเท่าจากทุกเกมเสมอไป ควรตรวจสอบค่ายเกมที่เข้าร่วม ระยะเวลา และข้อกำหนดของแต่ละกิจกรรมก่อนรับสิทธิ์
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffd666]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd666]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
