---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// OCZPLUS เป็นเว็บสล็อต ไม่ใช่เว็บหวย — /ตรวจหวย และ /แนวทาง ถูกพักไว้ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีลิงก์ทั้งสองในคอลัมน์นี้ (ไฟล์คอมโพเนนต์
// *Huay ยังอยู่ครบในฐานะ inventory ของแบรนด์หวยรอบหน้า)
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// สิทธิประโยชน์ตามที่ content.txt ระบุไว้เท่านั้น — อะไรที่เจาะจงกว่านี้
// (เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ชื่อค่ายเกม) คือการแต่งขึ้นเอง
const privileges = ["การันตียอดถอนทุกวัน จ่ายเต็มจำนวน", "ไม่ล็อคยูส ควบคุมด้วย RNG 100%", "แนะนำเพื่อนรับคอมมิชชั่น 0.8%", "คืนยอดเสีย 0.3% ทุกยอดการเล่น", "ฝาก-ถอนออโต้ 3-5 วินาที ไม่มีขั้นต่ำ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นทอง คำหลังเป็นเงินโครเมียม ล้อโลโก้ที่เป็น
// OCZ เงิน + แดง + PLUS ทอง
const claimChips = [
  { lead: "สล็อต", tail: "อันดับหนึ่ง" },
  { lead: "การันตี", tail: "ยอดถอนทุกวัน" },
  { lead: "ไม่ล็อค", tail: "ยูสเซอร์" },
  { lead: "ฝากถอน", tail: "ออโต้24ชม." },
  { lead: "รีวิว", tail: "จากสมาชิกจริง" },
];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#d9b45e] bg-[#071a36] pt-16 pb-8 font-sans text-[#ccd6e6] shadow-[0_-10px_30px_rgba(217,180,94,0.18)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#d9b45e]/10 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#c0202b]/15 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ OCZPLUS ตัวอักษร OCZ สีเงินโครเมียม ตามด้วยเครื่องหมายบวกสีแดง และคำว่า PLUS สีทองเมทัลลิค"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(217,180,94,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(217,180,94,0.4)]">
                <span class="bg-gradient-to-b from-[#e6ebf0] to-[#8b939c] bg-clip-text text-transparent">OCZ</span>
                <span class="text-[#c0202b]">+</span>
                <span class="bg-gradient-to-b from-[#f2dc9a] via-[#d9b45e] to-[#8a6b2c] bg-clip-text text-transparent">PLUS</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#ccd6e6]">
          OCZPLUS สล็อตอันดับหนึ่ง แหล่งเดิมพันชั้นเยี่ยมที่ดีที่สุด พัฒนาระบบนิเวศการเดิมพันในรูปแบบ Portal &amp; Privilege บนอินเทอร์เฟซโทนสีกรมท่าตัดทองเมทัลลิค
          พร้อมกราฟิกเกมสล็อตระดับ Cinematic Lighting เราการันตียอดถอนทุกวันและจ่ายเต็มจำนวน แจกโบนัสหนักทุกยูสเซอร์แบบไม่ล็อคยูสด้วยระบบสุ่ม RNG 100%
          ฝาก-ถอนอัตโนมัติภายใน 3-5 วินาที รองรับทุกธนาคารและ TrueMoney Wallet โดยไม่มีขั้นต่ำ
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#d9b45e]/50 bg-[#d9b45e]/10 px-3 py-1.5 text-xs font-bold text-[#f2dc9a] shadow-[0_0_10px_rgba(217,180,94,0.22)]">
            <span aria-hidden="true" class="text-base">🛡️</span> RNG 100%
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#c0202b]/55 bg-[#0b2547]/70 px-3 py-1.5 text-xs font-bold text-[#c9d2dc]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f2dc9a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f2dc9a] to-[#8a6b2c]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#ccd6e6] transition-all hover:text-[#f2dc9a]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#d9b45e] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="สิทธิประโยชน์สำหรับสมาชิก" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f2dc9a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f2dc9a] to-[#8a6b2c]"></span> สิทธิประโยชน์
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            privileges.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#ccd6e6] transition-all hover:text-[#f2dc9a]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c0202b] transition-colors group-hover:bg-[#d9b45e] group-hover:shadow-[0_0_8px_rgba(217,180,94,0.8)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f2dc9a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f2dc9a] to-[#8a6b2c]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @OCZPLUS
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#d9b45e]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#d9b45e]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#d9b45e] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#c9d2dc]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#8fa2bd] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#f2dc9a]">OCZPLUS</span>. All rights reserved. สล็อตอันดับหนึ่ง การันตียอดถอนทุกวัน ไม่ล็อคยูส
        ฝาก-ถอนอัตโนมัติรองรับทุกธนาคารและ TrueMoney Wallet แอดมินดูแลผ่าน Line Official ตลอด 24 ชั่วโมง
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#f2dc9a]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f2dc9a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
