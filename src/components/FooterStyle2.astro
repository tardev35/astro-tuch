---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// รับตัง168 (รอบทองไทยนำ-แดงมังกรรอง 2026-10-18): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน สมหวัง168 ใช้ FooterPremium ส่วนไฟล์นี้ค้างเป็นชุดแดงเลือดนก-เงิน
// โครเมียมของ TKB55 ย้ายทั้งไฟล์มาเป็นพื้นแดงเกือบดำ #140505 + ทองแบรนด์
// #f0b429 + ทองสว่าง #ffdc8c + ทองลึก #9a6c0c + แดงแบรนด์ #d30304 + แดงสว่าง
// #ff6b6e + แดงลึก #a00203 #4a0202 + ผิวยก #2b100f + โครเมียมอมฟ้า #cfd9e6
// และเนื้อความขาวนวลอมอุ่น #f5ece0
//
// FooterPremium ของรอบก่อนเป็นแผ่น rounded-t-[3rem] มีออราคร่อมขอบบนและจัดสาม
// คอลัมน์ 5/3/4 — ไฟล์นี้เป็นคนละทรง: แผ่นแบนขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอย
// และเนื้อในเป็นกริด 4 คอลัมน์เท่ากัน
//
// ⚠️ **กับดักรอบนี้คือแดง** และไฟล์นี้ค้างแดงของแบรนด์อื่นมาแล้วสองรอบ เจอแดง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับ
// .claude/brand-spec-rubtang168.md §2: ชุดแดงเลือดนก-เงินโครเมียมของ TKB55
// (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #0d0304 #8a0206
// #1a0304) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffc554
// #f0c3dc #fde7f2 #8a0a45 #4a1038 #1c0014) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ
// SUPERSLOTCLUB (#e8232a #7d0f12 #4a0605 #180800 #f2b705 #ffd666 #a8730a
// #fbe8d5 #c9a898) ชุดแดงแล็กเกอร์ของ PIGPG (#d4200d #f5b61d #ffd87a #b07a06
// #120302 #2a0806 #6b0402 #fdeedd #c9a48d #fdf9e4) ชุดทองเมทัลลิกของ
// 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #f3e7cd #17130a)
// และชุดเขียวป่าของ หวยเต็ง (#e5c04f #03150a #d8ead9 #0bb42f #bd8d2d)
// ออกครบทุกจุดแล้ว
// แดงรอบนี้ #d30304 (R=211 G=3 B=4) **ไม่ใช่** #d4200d ของ PIGPG (ต่างสองหลัก)
// ไม่ใช่ #e8232a ของ SUPERSLOTCLUB และไม่ใช่ #fb131b ของ TKB55
// ทองรอบนี้ #f0b429 **ไม่ใช่** #f2b705 #fad354 #ffd87a หรือ #e3b23c ของรอบก่อน
// รอบนี้ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีเขียว ไม่มีส้ม และไม่มีม่วง
// (ยกเว้นเขียว LINE #00B900 ซึ่งเป็นสีของแบรนด์ LINE เอง ไม่ใช่ของเว็บ และ
//  สีแบรนด์ธนาคารจริงที่อยู่ใน BankStrip)
//
// ⚠️ รอบนี้ **ทองนำ แดงรอง** สลับขั้วจากรอบก่อน เส้นขอบบนหนา 3px จึงเป็นทอง
// และออรามุมบนขวาเป็นทอง ส่วนแดงถอยไปเป็นออรามุมล่างซ้ายกับกรอบชิป
// ⚠️ #d30304 #a00203 #4a0202 #9a6c0c ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
// ตัวที่ถือตัวอักษรได้: #ffdc8c (≈12:1 บนพื้น footer) #f0b429 (≈8.9:1)
// #cfd9e6 (≈11.4:1) #f5ece0 (≈14.7:1) และ #ff6b6e (≈6.1:1)
//
// รับตัง168 เป็น **เว็บเกมสล็อตล้วน** ไม่ใช่คาสิโนและไม่ใช่เว็บกีฬา — คำว่า
// บาคาร่า ไฮโล บอล อัตราต่อรอง เซิร์ฟเวอร์ต่างประเทศ และ ฝากถอนทุกธนาคาร
// ที่รอบ TKB55 เคยเขียนไว้ในไฟล์นี้ **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออก
// ทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม คอลัมน์ที่สามเปลี่ยนจาก "หมวดเกมคาสิโน"
// เป็น "บริการที่สอบถามได้" ซึ่งเป็นสิ่งที่บรีฟรอบนี้มีจริง (content.txt
// บรรทัด 4 + 6 + 8 + 14 + 20)
//
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
// รอบนี้เป็นเว็บเกมสล็อตล้วน คอลัมน์นี้จึงเป็น "เรื่องที่สอบถามเจ้าหน้าที่ได้"
// ไม่ใช่รายชื่อหมวดเกม — บรีฟไม่ได้ไล่หมวดเกมไว้เลย
const supportTopics = ["การเข้าเล่นเกมสล็อตออนไลน์", "การทำรายการฝากถอน", "รายละเอียดโปรโมชั่นและวิธีรับสิทธิ์", "ขั้นตอนสมัครสมาชิกและการยืนยันบัญชี", "ข้อกำหนดและเงื่อนไขของแต่ละรายการ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นทองสว่าง ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-3, 8-12, 20) ไม่มีคำโฆษณาอย่าง "จ่ายจริง"
// "แตกง่าย" หรือ "การันตีเว็บแท้"
const claimChips = [
  { lead: "ผู้ให้บริการ", tail: "เว็บตรง" },
  { lead: "ลิขสิทธิ์", tail: "แท้" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "เจ้าหน้าที่", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-18 จริง — มาสคอตโจรเด็กการ์ตูนของ
// TKB55 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส กลางภาพเป็นคำว่า รับตัง ตัวอักษรไทยหนาสามมิติผิวโครเมียมสีเงินอมฟ้าตัดขอบสีแดง ต่อท้ายด้วยตัวเลข 168 หนาสามมิติสีแดงสด ด้านหลังเป็นริบบิ้นผ้าซาตินสีแดงพลิ้ว และมีเหรียญจีนสีทองเจาะรูสี่เหลี่ยมกองอยู่ด้านบนพร้อมเหรียญที่ร่วงกระจายรอบ ๆ`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f0b429] bg-[#140505] pt-16 pb-8 font-sans text-[#f5ece0] shadow-[0_-10px_30px_rgba(240,180,41,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f0b429]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#d30304]/14 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(240,180,41,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(240,180,41,0.45)]">
                <span class="bg-gradient-to-b from-[#f5ece0] to-[#cfd9e6] bg-clip-text text-transparent">รับตัง</span>
                <span class="text-[#ff6b6e]">168</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#f5ece0]">
          {BRAND_NAME} เป็นช่องทางรับบริการจากผู้ให้บริการเว็บตรงสำหรับผู้ที่ต้องการเข้าใช้งานเกมสล็อตออนไลน์และสอบถามข้อมูลเกี่ยวกับบริการต่าง ๆ ทั้งการเข้าเล่น ฝากถอน และโปรโมชั่น
          ผู้ใช้งานสามารถติดต่อเจ้าหน้าที่ผ่านช่องทางที่เว็บไซต์กำหนด เพื่อขอคำแนะนำเกี่ยวกับขั้นตอนการใช้งานและตรวจสอบรายละเอียดบริการได้ตลอด 24 ชั่วโมง โดยควรอ่านเงื่อนไขของแต่ละรายการก่อนดำเนินการทุกครั้ง
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f0b429]/50 bg-[#f0b429]/10 px-3 py-1.5 text-xs font-bold text-[#ffdc8c] shadow-[0_0_10px_rgba(240,180,41,0.25)]">
            <span aria-hidden="true" class="text-base">🎰</span> ฐานหลักเกมสล็อตออนไลน์
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#a00203] bg-[#2b100f]/80 px-3 py-1.5 text-xs font-bold text-[#f5ece0]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffdc8c]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0b429] to-[#9a6c0c]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#f5ece0] transition-all hover:text-[#ffdc8c]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#f0b429] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="เรื่องที่ติดต่อสอบถามเจ้าหน้าที่ได้" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffdc8c]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0b429] to-[#9a6c0c]"></span> บริการที่สอบถามได้
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            supportTopics.map((item) => (
              <li>
                <a href="/contact-us" class="group flex items-start text-[#f5ece0] transition-all hover:text-[#ffdc8c]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#cfd9e6] transition-colors group-hover:bg-[#f0b429] group-hover:shadow-[0_0_8px_rgba(240,180,41,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffdc8c]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0b429] to-[#9a6c0c]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#ffdc8c]/90 uppercase">ช่องทางฝากถอนที่รองรับ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f0b429]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#f5ece0] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#ffdc8c]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#cfd9e6] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffdc8c]">{BRAND_NAME}</span>. All rights reserved. ช่องทางรับบริการจากผู้ให้บริการเว็บตรงสำหรับเกมสล็อตออนไลน์ ครอบคลุมการสอบถามเรื่องการเข้าเล่น การทำรายการฝากถอน และรายละเอียดโปรโมชั่น
        ก่อนทำรายการควรตรวจสอบข้อมูลบัญชีและรายละเอียดที่เกี่ยวข้องให้ถูกต้อง รวมถึงอ่านข้อกำหนดของเว็บไซต์เพื่อให้เข้าใจขั้นตอนและเงื่อนไขการให้บริการอย่างชัดเจน และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffdc8c]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffdc8c]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
