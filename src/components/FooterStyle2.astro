---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// TEVA69 (รอบเขียวมรกตนำ-เงินโครเมียมรอง บนโครมเขียวป่า 2026-10-28): footer ที่ใช้
// งานจริงรอบนี้ — รอบก่อน LOTTO189 ใช้ FooterHuay ซึ่งเป็นแผ่น rounded-t-[3rem]
// ที่มีออราเบลอคร่อมขอบบนและกริด 12 คอลัมน์แบบ 5/3/4 ส่วนไฟล์นี้เป็นคนละทรง:
// **แผ่นแบน ขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอยและไม่มีมุมมน** เนื้อในเป็น
// **กริด 4 คอลัมน์เท่ากัน**
//
// ⚠️⚠️ **เหตุผลที่เลือกไฟล์นี้แทน FooterPremium ซึ่งเป็นตัวเดียวที่ไม่เคยใช้ใน 7
// รอบหลัง**: FooterPremium กับ Footer ตัวฐาน **มีทรงเหมือน FooterHuay ขาออกเป๊ะ**
// (rounded-t-[3rem] + ออราเบลอคร่อมขอบบน + กริด 12 คอลัมน์ 5/3/4) การหมุนไปหามัน
// จะได้แค่ "เปลี่ยนสี" ซึ่งเป็นสิ่งที่กฎการหมุน variant มีไว้ป้องกันโดยตรง
// ไฟล์นี้ใช้ครั้งล่าสุด 4 รอบก่อน (โบ๊ะบ๊ะ168) และเป็นทรงที่ต่างจากขาออกจริง
//
// 🚨🚨 **ไฟล์นี้ค้างชุด "ฟ้าสกาย-น้ำเงินมหาสมุทร" ของ โบ๊ะบ๊ะ168 ไว้ทั้งไฟล์**
// (12b4ef b6e3f0 06283f 0b4a73 2a87c4 eaf7ff + rgba 18/180/239 α) และก่อนหน้านั้น
// เป็นชุดทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b 1b1407 4d3c15 2e2512
// ecd5c4 d2b9a4) — **ออกครบทุกจุดแล้ว ไม่เหลือฟ้า น้ำเงิน ทอง หรือครีม**
// ⚠️⚠️ **และแดง/ขาวชมพูของ LOTTO189 รอบก่อนทันที (b00718 c1071b 8a0412 ff2436
// e9b53c 24060c 3d0d16 120307 fff0f0 ffe4e6 ffd4d7 f5b9bd 25090f c3ccd6) ก็ต้องไม่มี
// หลุดเข้ามาเช่นกัน** — เจอแดงที่ไหนในไฟล์นี้คือหลงเหลือข้ามแบรนด์ ไม่ใช่สีของรอบนี้
// 🚨🚨 **กับดักรอบนี้คือเขียว** เพราะเขียวเคยเป็นฮิวนำของ KINGKONG555 (8ce023 e9f7d6
// bde397 1a5c04 2f8c07 051400 0f2e05 06220a) · สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c) · 888PARUAY (1fae1c 0d2312 143a1c 07130a) · MEXICANOSLOT (117a41 2bb061)
// มาแล้ว **"เจอเขียว" ไม่พิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบเป็นค่าทีละตัว**
// กับ .claude/brand-spec-teva69.md §2
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// ย้ายทั้งไฟล์มาเป็น **พื้นโครมเขียวป่า #0b2a12 (ฐาน) / #051409 (จม) / #15401d (ยก)
// + เขียวสด #28c437 เป็นแกน (ขอบบน หัวคอลัมน์ ลูกศร ออรา) + เงินโครเมียม #c6cfd2
// เป็นออราใบที่สองและเส้น (ลายเซ็นของเวิร์ดมาร์ก) + ทองอำพัน #e3bb45 เป็นกรอบชิป
// ใบที่สอง + หมึก #e8fbe4 (14.3:1) และหมึกรอง #b4d6ad (9.7:1)**
// ⚠️ #15401d #2d6b2f #1a7d24 ห้ามถือตัวอักษรในไฟล์นี้ (เป็นพื้น/เส้น/ขอบเท่านั้น)
// ตัวที่ถือตัวอักษรได้บนพื้น #0b2a12: #e8fbe4 (14.3:1) · #b4d6ad (9.7:1) ·
// #c6cfd2 (9.8:1) · #e3bb45 (8.5:1) · #28c437 (6.7:1)
//
// 🚨 TEVA69 เป็น **เว็บเกมพนัน/คาสิโนออนไลน์** ไม่ใช่เว็บหวย ไม่ใช่เว็บบอล —
// คำที่รอบก่อน (LOTTO189) เขียนไว้ในไฟล์นี้ไม่ได้ (แนะนำเว็บหวยลอตโต้ / แทงหวย
// จ่ายสด / รับทุกเลข ไม่มีอั้น / หวยรัฐบาลไทย ลาว ฮานอย หุ้น / อัตราจ่าย 2 ตัว 100 /
// 3 ตัว 1,000 / รอบปิดรับ / บิลหวย) **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออก
// ทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม บรีฟรอบนี้เรียกตัวเองว่า เกมพนันเบอร์ต้นๆของไทย
// สมัครเล่นไม่มีขั้นต่ำ และพูดถึง เกมเดิมพันออนไลน์หลากหลายประเภท · ค่ายแท้
// ถูกลิขสิทธิ์ · เซิร์ฟนอก ปลอดภัยในไทย · โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ ·
// คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
//
// 🚨🚨 **รอบนี้ถอด BankStrip ออกจาก footer โดยตั้งใจ** — บรีฟรอบนี้ (content.txt)
// **ไม่มีหมวดฝากถอน ธนาคาร หรือวอลเลทเลยแม้แต่คำเดียว** การคง BankStrip ไว้คือการ
// อ้างบริการที่บรีฟไม่ได้พูดถึง และป้าย "ช่องทางฝากถอนที่รองรับ" ที่คู่กับมันก็เป็น
// คำของแบรนด์ก่อน **BankStrip.astro ยังอยู่ครบในฐานะ inventory ของแบรนด์ถัดไป
// ห้ามลบไฟล์** คอลัมน์ที่สี่จึงเหลือ ปุ่ม LINE + บล็อก <address> ซึ่งเป็นช่องทาง
// ติดต่อจริงที่บรีฟรองรับ (content.txt บรรทัด 21-22)
//
// 🚨 — /ตรวจหวย และ /แนวทาง **ถูกย้ายกลับไปจอดที่ src/pages-disabled/ รอบนี้**
// (กลับทิศจากรอบก่อนที่เปิดไว้) จึงไม่มี route และไม่มีสองบรรทัดนั้นใน quickLinks
// ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่ src/pages/ พร้อมใส่ลิงก์คืน
// ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้รอบนี้มี: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 3 ขั้นตอน · 24ชม.
const supportTopics = ["ประเภทเกมเดิมพันที่เปิดให้บริการและกติกาการเล่น", "ขั้นตอนสมัครสมาชิกและการยืนยันบัญชี", "เงื่อนไขโปรโมชั่นคืนยอดเสียและแนะนำเพื่อน", "ข้อมูลค่ายเกมและหลักฐานการได้รับอนุญาต", "ข้อกำหนดการใช้บริการและนโยบายข้อมูลส่วนบุคคล"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นเขียวสด ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-2, 5, 7-12, 21) ไม่มีคำโฆษณาที่บรีฟไม่ได้เขียน
const claimChips = [
  { lead: "เกมพนัน", tail: "เบอร์ต้นๆของไทย" },
  { lead: "ค่ายแท้", tail: "ถูกลิขสิทธิ์" },
  { lead: "สมัครเล่น", tail: "ไม่มีขั้นต่ำ" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-28 จริง — เวิร์ดมาร์กแดงเลือดนกคู่โครเมียม
// ของ LOTTO189 ที่เคยอยู่ในตัวแปรนี้ไม่มีในรูปรอบนี้เลย และหัวการ์ตูนผู้หญิงหน้าตกใจ
// ของ โบ๊ะบ๊ะ168 (เจ้าของธีมเดิมของไฟล์นี้) ก็ไม่มีเช่นกัน
// ⚠️ โลโก้รอบนี้ **ไม่มีคน ไม่มีสัตว์ ไม่มีมงกุฎ ไม่มีชิป** มีแค่เวิร์ดมาร์กกับ
// แสงเรืองใต้ตัวอักษร
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นเวิร์ดมาร์กสามมิติตัวหนาวางเรียงเป็นแถวเดียว ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ไล่จากเงินสว่างด้านบนลงมาหาเทาเข้มด้านล่าง และครึ่งหลังเป็นตัวเลขผิวเขียวมรกตเคลือบเงา ไล่จากเขียวสดด้านบนลงมาหาเขียวเข้มด้านล่าง ทั้งชุดตัดขอบสีดำหนาและมีเส้นไฮไลต์สีขาวพาดอยู่ที่ขอบบนของตัวอักษร ใต้เวิร์ดมาร์กมีแถบแสงเรืองสีเขียวมรกตทอดยาวเป็นเงาสะท้อน`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#28c437] bg-[#0b2a12] pt-16 pb-8 font-sans text-[#e8fbe4] shadow-[0_-10px_30px_rgba(40,196,55,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#28c437]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#c6cfd2]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(40,196,55,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#c6cfd2] to-[#28c437] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(40,196,55,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#e8fbe4]">
          {BRAND_NAME} นำเสนอข้อมูลเกมเดิมพันออนไลน์หลากหลายประเภท พร้อมรายละเอียดระบบสมาชิก โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ ภายในเว็บไซต์มีข้อมูลเกมจากค่ายต่าง ๆ ให้ผู้ใช้งานศึกษากติกา รูปแบบการเดิมพัน และเงื่อนไขการใช้บริการ
          โดยระบุว่าสามารถสมัครสมาชิกได้โดยไม่มีขั้นต่ำ ทั้งนี้ ควรตรวจสอบข้อกำหนดเกี่ยวกับยอดฝากและยอดเดิมพันของแต่ละเกม รวมถึงความน่าเชื่อถือของผู้ให้บริการก่อนใช้งาน เนื่องจากคำกล่าวอ้างว่าเป็นเกมถูกลิขสิทธิ์หรือมีความปลอดภัยในไทย
          ไม่สามารถยืนยันได้จากข้อความโฆษณาเพียงอย่างเดียว
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#28c437]/50 bg-[#28c437]/10 px-3 py-1.5 text-xs font-bold text-[#b4d6ad] shadow-[0_0_10px_rgba(40,196,55,0.25)]">
            <span aria-hidden="true" class="text-base">🎮</span> เกมเดิมพันหลายประเภท
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#e3bb45] bg-[#15401d]/80 px-3 py-1.5 text-xs font-bold text-[#e8fbe4]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24ชม.
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#28c437]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#c6cfd2] to-[#28c437]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#e8fbe4] transition-all hover:text-[#28c437]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#28c437] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="เรื่องที่ติดต่อสอบถามเจ้าหน้าที่ได้" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#28c437]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#c6cfd2] to-[#28c437]"></span> บริการที่สอบถามได้
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            supportTopics.map((item) => (
              <li>
                <a href="/contact-us" class="group flex items-start text-[#e8fbe4] transition-all hover:text-[#28c437]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#28c437] transition-colors group-hover:bg-[#c6cfd2] group-hover:shadow-[0_0_8px_rgba(198,207,210,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#28c437]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#c6cfd2] to-[#28c437]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>
    </div>

