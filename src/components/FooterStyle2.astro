---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน TSDET911 ใช้ FooterPremium ส่วนไฟล์นี้ค้างเป็นชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 ย้ายทั้งไฟล์มาเป็นพื้นแดงเกือบดำ #0d0304 + แดงแบรนด์ #fb131b +
// แดงสว่าง #ff4d55 + แดงอ่อน #ff8a8f + ผิวยก #2a0d0f + เส้นลึก #8a0206 +
// เงินโครเมียมสว่าง #e9eef4 + เงินหม่น #aeb9c6 และเนื้อความขาวอมชมพู #f2e4e5
//
// FooterPremium ของรอบก่อนเป็นแผ่น rounded-t-[3rem] มีออราคร่อมขอบบนและจัดสาม
// คอลัมน์ 5/3/4 — ไฟล์นี้เป็นคนละทรง: แผ่นแบนขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอย
// และเนื้อในเป็นกริด 4 คอลัมน์เท่ากัน
//
// ⚠️ **กับดักรอบนี้คือแดง** และไฟล์นี้ค้างแดงของแบรนด์อื่นมาแล้วสองรอบ เจอแดงที่ไหน
// ห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ: ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168
// (#f41571 #ff5ca8 #fce343 #ffc554 #f0c3dc #fde7f2 #8a0a45 #4a1038 #1c0014)
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #7d0f12 #4a0605 #180800
// #f2b705 #ffd666 #a8730a #fbe8d5 #c9a898) ชุดแดงแล็กเกอร์ของ PIGPG (#d4200d
// #f5b61d #ffd87a #b07a06 #120302 #2a0806 #6b0402 #fdeedd #c9a48d #fdf9e4)
// ชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407
// #f3e7cd #17130a) และชุดเขียวป่าของ หวยเต็ง (#e5c04f #03150a #d8ead9 #0bb42f
// #bd8d2d) ออกครบทุกจุดแล้ว
// แดงของรอบนี้ #fb131b (R=251 G=19 B=27) **ไม่ใช่** #e8232a ของ SUPERSLOTCLUB
// และ **ไม่ใช่** #d4200d ของ PIGPG — อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
// และรอบนี้ไม่มีทอง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีเขียว ไม่มีส้ม
// (ยกเว้นเขียว LINE #00B900 ซึ่งเป็นสีของแบรนด์ LINE เอง ไม่ใช่ของเว็บ และ
//  สีแบรนด์ธนาคารจริงที่อยู่ใน BankStrip)
//
// TKB55 เป็นเว็บคาสิโน+กีฬา (บาคาร่า ไฮโล บอล สล็อต) ไม่ใช่เว็บหวย
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
// รอบนี้เป็นคาสิโน+กีฬา คำเกมจึงมีสี่คำ: บาคาร่า ไฮโล บอล สล็อต — ไม่มียิงปลาและไม่มีหวย
const gameCategories = ["บาคาร่า เกมไพ่ที่มีตัวเลือกเดิมพันตามกติกา", "ไฮโล ตัดสินผลจากลูกเต๋า", "บอลออนไลน์ มีรายการแข่งขันและอัตราต่อรอง", "สล็อตเกมวงล้อทั่วไปและฟรีสปิน", "สล็อตที่มีฟีเจอร์โบนัสจากค่ายที่เปิดให้บริการ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นแดงอ่อน ทุกคู่เป็นคำที่บรีฟพูดไว้เอง
// ไม่มีคำโฆษณาอย่าง "จ่ายจริง" "ค่ายแท้" "แตกง่าย" หรือ "การันตีเว็บแท้"
const claimChips = [
  { lead: "เว็บคาสิโน", tail: "ไทย" },
  { lead: "เซิร์ฟ", tail: "ต่างประเทศ" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-13 จริง — เครื่องเล่นเกมพกพาการ์ตูน
// สีชมพูของ PUNPRO168 ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านบนเป็นมาสคอตการ์ตูนรูปโจรเด็กสวมหน้ากากโจรสีดำคาดตาและผ้าโพกหัวสีดำ ใส่เสื้อแขนยาวสีดำกับถุงมือสีดำ ยิ้มกว้างและชูนิ้วโป้ง แบกถุงผ้าใส่เงินสีครีมที่มีเครื่องหมายดอลลาร์สีแดง ถัดลงมาเป็นคำว่า TKB ตัวอักษรละตินหนาสามมิติสีแดงสดตัดขอบแดงเข้ม ต่อท้ายด้วยตัวเลข 55 หนาสามมิติสีเงินโครเมียมขัดเงา`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#fb131b] bg-[#0d0304] pt-16 pb-8 font-sans text-[#f2e4e5] shadow-[0_-10px_30px_rgba(251,19,27,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#fb131b]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#e9eef4]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(251,19,27,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(251,19,27,0.45)]">
                <span class="bg-gradient-to-b from-[#ff4d55] to-[#fb131b] bg-clip-text text-transparent">TKB</span>
                <span class="bg-gradient-to-b from-[#e9eef4] to-[#aeb9c6] bg-clip-text text-transparent">55</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#f2e4e5]">
          {BRAND_NAME} เว็บพนันคาสิโนไทยที่นำเสนอระบบเดิมพันออนไลน์ผ่านแพลตฟอร์มเดียว รวมเกมคาสิโนและกีฬาไว้หลายประเภท ทั้งบาคาร่า ไฮโล บอล และสล็อต รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์
          สมาชิกสามารถค้นหาเกม ตรวจสอบเครดิต และติดตามรายการต่างๆ ได้สะดวก โดยเว็บไซต์ระบุว่าใช้เซิร์ฟเวอร์ต่างประเทศเพื่อรองรับการเข้าใช้งาน ส่วนความปลอดภัยและตำแหน่งเซิร์ฟเวอร์จริงควรมีข้อมูลทางเทคนิคและรายละเอียดผู้ให้บริการที่สามารถตรวจสอบได้ประกอบ
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#fb131b]/50 bg-[#fb131b]/10 px-3 py-1.5 text-xs font-bold text-[#ff8a8f] shadow-[0_0_10px_rgba(251,19,27,0.25)]">
            <span aria-hidden="true" class="text-base">🌐</span> เซิร์ฟต่างประเทศ
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#8a0206] bg-[#2a0d0f]/80 px-3 py-1.5 text-xs font-bold text-[#f2e4e5]">
            <span aria-hidden="true" class="text-base">⏰</span> แอดมิน 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e9eef4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e9eef4] to-[#aeb9c6]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#f2e4e5] transition-all hover:text-[#ff8a8f]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#fb131b] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดเกมคาสิโนและกีฬาที่เปิดให้บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e9eef4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e9eef4] to-[#aeb9c6]"></span> หมวดเกมคาสิโน
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#f2e4e5] transition-all hover:text-[#ff8a8f]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#aeb9c6] transition-colors group-hover:bg-[#fb131b] group-hover:shadow-[0_0_8px_rgba(251,19,27,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e9eef4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e9eef4] to-[#aeb9c6]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#e9eef4]/90 uppercase">รองรับวอลเลทและธนาคารชั้นนำ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#fb131b]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#f2e4e5] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#ff8a8f]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#aeb9c6] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#e9eef4]">{BRAND_NAME}</span>. All rights reserved. เว็บคาสิโนไทยที่รวมบาคาร่า ไฮโล บอล และสล็อตไว้ในบัญชีเดียว พร้อมระบบฝากถอนที่ระบุว่ารองรับทุกธนาคารและส่งยอดเข้าบัญชีบริษัทโดยตรง
        ทั้งนี้หากใช้บัญชีบริษัทเจ้าของเว็บไซต์ ควรแสดงชื่อนิติบุคคลที่สามารถตรวจสอบได้และตรงกับบัญชีรับชำระจริง ก่อนทำรายการควรตรวจสอบชื่อบัญชีปลายทางจากช่องทางหลัก และเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสิ้น
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ff8a8f]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ff8a8f]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
