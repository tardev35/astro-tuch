---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// เงินทอง168 (รอบทองนำ-ครีมรอง บนน้ำตาลโอลีฟ 2026-10-22): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน พักยก168 ใช้ FooterStyle3 ซึ่งเป็นการ์ด CTA ลอยคร่อมขอบบน (-top-14)
// แล้วแผ่นเว้น pt-64 ไว้รับ ส่วนไฟล์นี้ค้างเป็นชุดทองอำพันของ ufalion168
// ย้ายทั้งไฟล์มาเป็นพื้นน้ำตาลลึก #1b1407 + ทองแกน #f5ba14 + ทองสว่าง #fcee52 +
// ทองลึก #b37c0b (เส้น/ขอบ/ออราเท่านั้น) + ผิวยก #4d3c15 + ผิวกลาง #2e2512
// และเนื้อความครีมอุ่น #ecd5c4 กับครีมจาง #d2b9a4
//
// FooterStyle3 ของรอบก่อนเป็นแผ่นที่มีการ์ด CTA ลอยคร่อมขอบบน — ไฟล์นี้เป็น
// คนละทรง: **แผ่นแบน ขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอย** เนื้อในเป็น
// **กริด 4 คอลัมน์เท่ากัน** และ BankStrip อยู่ท้ายคอลัมน์ที่สี่ ไม่ได้พาดเต็มความกว้าง
//
// ⚠️⚠️ **กับดักรอบนี้คือทอง และหนักกว่าทุกรอบ** — ไฟล์นี้ค้างทองของแบรนด์อื่นมาแล้ว
// หลายรอบ **และแบรนด์รอบก่อนทันที (พักยก168) ก็ทองนำเช่นกัน** เจอทองที่ไหนห้าม
// เหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับ
// .claude/brand-spec-ngernthong168.md §2:
// ชุดทองแกน-โครเมียมเงินของ พักยก168 (eeae12 fded41 9f600d e29f0f fdf051 e0e0df
// c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04 4e2f11
// — ⚠️ **รอบก่อนทันที และ eeae12 ห่างจาก #f5ba14 แค่ R7/G12/B2**)
// ชุดทองอำพัน-ทองเลมอนของ ufalion168 (d4922c fdfc71 d39c45 f6e3b4 a25b24 8c4312
// 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3 — **เจ้าของธีมเดิมของไฟล์นี้**)
// ชุดฟ้าบับเบิล-ทองของ สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16
// e8f4ff 0e2238 081726 040d16 04121f) ชุดทองจักรพรรดิ-แดงชาดของ รวยเทพ168
// (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400)
// ชุดทองไทย-แดงมังกรของ รับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202
// 9a6c0c cfd9e6 f5ece0 2b100f 140505) ชุดแดงเลือดนก-เงินโครเมียมของ TKB55
// (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 0d0304 8a0206 1a0304)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2
// 8a0a45 4a1038 1c0014) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (e8232a
// 7d0f12 4a0605 180800 f2b705 ffd666 a8730a fbe8d5 c9a898) ชุดแดงแล็กเกอร์ของ
// PIGPG (d4200d f5b61d ffd87a b07a06 120302 2a0806 6b0402 fdeedd c9a48d fdf9e4)
// ชุดทองเมทัลลิกของ 789BETTING (fad354 ffe79a ddab33 8a6410 c9881f 4a3407 f3e7cd
// 17130a) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (e5a81b ffe08a bb8410 7d5a07
// 8792a0 f0e8d4 b9c2cc 464f5a) และชุดเขียวป่าของ หวยเต็ง (e5c04f 03150a d8ead9
// 0bb42f bd8d2d) ออกครบทุกจุดแล้ว
// ทองรอบนี้ #f5ba14 (R=245 G=186 B=20) **ไม่ใช่** eeae12 ของ พักยก168
// ไม่ใช่ d4922c ของ ufalion168 ไม่ใช่ f7c92b ของ ขวัญใจ168 ไม่ใช่ e5a81b ของ
// UFA324 และไม่ใช่ fdcb0c ของ สบาย168
// รอบนี้ไม่มีฟ้า ไม่มีแดง ไม่มีชมพู ไม่มีเขียว ไม่มีม่วง ไม่มีส้มสด และ
// ⚠️⚠️ **ไม่มีเงิน/โครเมียมเด็ดขาด** (ยกเว้นเขียว LINE #00B900 ซึ่งเป็นสีของแบรนด์
// LINE เอง ไม่ใช่ของเว็บ และสีแบรนด์ธนาคารจริงที่อยู่ใน BankStrip)
// ⚠️ เลข 168 ในโลโก้เป็นผิวโครเมียมจริง แต่นั่นเป็นวัสดุในภาพ ไม่ใช่สีของ UI —
// **แรมป์เทาเงินเป็นของ พักยก168 กับ ยูฟ้า168 ไปแล้ว รอบนี้ใช้ครีมอุ่น #ecd5c4
// เป็นวัสดุที่สองแทน** (วัดจาก slide1.png — ชุดซาตินสีงาช้างของผู้หญิงในภาพ)
//
// ⚠️ รอบนี้ **ทองนำ คู่ครีมเป็นวัสดุที่สอง** เส้นขอบบนหนา 3px จึงเป็นทองแกน
// ออรามุมบนขวาเป็นทองแกน ส่วนออรามุมล่างซ้ายเป็นครีม และทองสว่างถอยไปเป็น
// สีหัวคอลัมน์ ปลายคำโปรย และชื่อแบรนด์ในบรรทัดลิขสิทธิ์
// ⚠️ #b37c0b ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้ (เป็นเส้น/ขอบ/ไล่เฉดเท่านั้น)
// ตัวที่ถือตัวอักษรได้บนพื้น #1b1407: #ecd5c4 (≈14.1:1) #fcee52 (≈15.4:1)
// #f5ba14 (≈10.5:1) และ #d2b9a4 (≈9.8:1)
//
// เงินทอง168 เป็น **เว็บสล็อตออนไลน์** ไม่ใช่เว็บบอลและไม่ใช่เว็บหวย — คำว่า
// แฟนเพจเว็บบอลยูฟ่า / ข่าวสารฟุตบอล / โปรแกรมแข่งขัน / ผลการแข่งขัน / ราคาบอล /
// ค่าน้ำ / แนวทางวิเคราะห์ก่อนเกม ที่รอบก่อนเขียนไว้ในไฟล์นี้ **ไม่มีอยู่ในบรีฟ
// รอบนี้สักคำ** จึงถูกถอดออกทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม บรีฟรอบนี้เรียกตัวเองว่า
// สล็อตเงินดี อัตราจ่ายสูง ค่ายเกมลิขสิทธิ์แท้100% และพูดถึงเกมสล็อตมากกว่า
// 1,000 เกม จากค่ายมาตรฐานสากล · ค่า RTP · ตารางจ่ายรางวัล · โปรโมชั่นคืนยอดเสีย
// 0.3% และแนะนำเพื่อน 0.8% · ขั้นตอนสมัคร 3 ขั้น · ช่องทางติดต่อแอดมิน 24ชม.
// คอลัมน์ที่สามจึงเป็น "บริการที่สอบถามได้" ซึ่งเป็นสิ่งที่บรีฟรอบนี้มีจริง
// (content.txt บรรทัด 4 + 14 + 22)
// ⚠️ **คำของ พักยก168 รอบก่อนทันที ห้ามหลุดเข้ามา**: เจ้าดัง · ไม่ผ่านม้า ·
// บัญชีม้า · ค่ายแท้ · ถูกลิขสิทธิ์100% · ทดลองเล่นฟรี · โหมดทดลองเล่น
//
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มี: 1,000 เกม · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24ชม. ·
// 3 ขั้นตอน · 100%
const supportTopics = ["ขั้นตอนสมัครสมาชิกและการเข้าสู่ระบบ", "รายการฝากถอนและหมายเลขรายการ", "รายละเอียดโปรโมชั่นและวิธีรับเครดิต", "กติกาเกมและเงื่อนไขการเดิมพัน", "ข้อกำหนดการใช้บริการและนโยบายข้อมูลส่วนบุคคล"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นทองสว่าง ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-8, 13, 21) ไม่มีคำโฆษณาอย่าง "จ่ายจริง"
// "แตกหนัก" หรือ "เว็บตรง"
const claimChips = [
  { lead: "สล็อต", tail: "เงินดี" },
  { lead: "รวมเกมกว่า", tail: "1,000 เกม" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-22 จริง — หัวสิงโตทองสวมมงกุฎของ
// ufalion168 ที่เคยอยู่ในตัวแปรนี้ไม่มีในรูปรอบนี้เลย และหัวมังกรจีนทองของ
// พักยก168 รอบก่อนก็ไม่มีเช่นกัน
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านซ้ายเป็นตราชั่งสองจานสามมิติสีทองเงางาม มีเหรียญทองกองอยู่บนจานทั้งสองข้าง เสาและคานของตราชั่งเป็นทองขัดเงา ถัดมาทางขวาเป็นคำว่า เงินทอง ตัวอักษรไทยหนาสามมิติผิวทองมันวาว ต่อด้วยตัวเลข 168 หนาสามมิติผิวโครเมียมเงิน ทั้งตัวอักษรและตัวเลขตัดขอบสีดำหนาและมีแสงสะท้อนสีขาวที่ขอบบน`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f5ba14] bg-[#1b1407] pt-16 pb-8 font-sans text-[#ecd5c4] shadow-[0_-10px_30px_rgba(245,186,20,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f5ba14]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#ecd5c4]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(245,186,20,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fcee52] to-[#f5ba14] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(245,186,20,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#ecd5c4]">
          {BRAND_NAME} นำเสนอเกมสล็อตออนไลน์หลากหลายรูปแบบ พร้อมข้อมูลค่ายเกม อัตราจ่าย และโปรโมชั่นสำหรับสมาชิก ภายในเว็บไซต์มีเมนูสำหรับเลือกศึกษาเกมที่สนใจ ตรวจสอบกติกาและเงื่อนไขการเดิมพัน
          รวมถึงรายละเอียดการสมัครสมาชิกและช่องทางติดต่อเจ้าหน้าที่ ส่วนคำกล่าวอ้างเกี่ยวกับอัตราจ่ายสูงและลิขสิทธิ์เกม ควรตรวจสอบจากข้อมูลผู้พัฒนาและหลักฐานการอนุญาตที่เชื่อถือได้ก่อนใช้งาน
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f5ba14]/50 bg-[#f5ba14]/10 px-3 py-1.5 text-xs font-bold text-[#fcee52] shadow-[0_0_10px_rgba(245,186,20,0.25)]">
            <span aria-hidden="true" class="text-base">🎰</span> รวมเกมกว่า 1,000 เกม
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#b37c0b] bg-[#4d3c15]/80 px-3 py-1.5 text-xs font-bold text-[#ecd5c4]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24ชม.
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fcee52]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f5ba14] to-[#b37c0b]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#ecd5c4] transition-all hover:text-[#fcee52]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#f5ba14] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="เรื่องที่ติดต่อสอบถามเจ้าหน้าที่ได้" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fcee52]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f5ba14] to-[#b37c0b]"></span> บริการที่สอบถามได้
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            supportTopics.map((item) => (
              <li>
                <a href="/contact-us" class="group flex items-start text-[#ecd5c4] transition-all hover:text-[#fcee52]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#f5ba14] transition-colors group-hover:bg-[#fcee52] group-hover:shadow-[0_0_8px_rgba(252,238,82,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fcee52]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f5ba14] to-[#b37c0b]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
