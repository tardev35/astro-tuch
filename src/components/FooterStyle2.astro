---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// MAHAGAME66 (รอบแดง-ดำ-เงินโครเมียม 2026-09-24): footer ที่ใช้งานจริงรอบนี้
// (รอบก่อน 888PARUAY ใช้ FooterStyle3) ของเดิมในไฟล์เป็นชมพู-เหลืองของ ABM96
// ย้ายทั้งไฟล์มาเป็นพื้นเกือบดำ #16090a + แดงแบรนด์ #de161d (คำว่า GAME บนโลโก้)
// + เงินโครเมียม #e2e8ef (คำว่า MAHA กับเลข 66) ชมพู/เหลืองออกครบทุกจุดแล้ว
//
// MAHAGAME66 เป็นเว็บพนันรวมเกม ไม่ใช่เว็บหวยเฉพาะทาง — /ตรวจหวย และ /แนวทาง ถูกพัก
// ไว้ใน src/pages-disabled/ รอบนี้ จึงไม่มีลิงก์ทั้งสองในคอลัมน์นี้ (ไฟล์
// คอมโพเนนต์ *Huay ยังอยู่ครบในฐานะ inventory ของแบรนด์หวยรอบหน้า)
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// สิทธิประโยชน์ตามที่ content.txt ระบุไว้เท่านั้น — อะไรที่เจาะจงกว่านี้
// (เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ชื่อค่ายเกม อัตราฝากถอน) คือการแต่งขึ้นเอง
const privileges = ["บาคาร่า สล็อต หวย บอล รูเล็ต ในบัญชีเดียว", "หมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ", "แนะนำเพื่อนรับโบนัส 0.8%", "คืนยอดเสียรับโบนัส 0.3%", "ฝากถอนวอลเลทและธนาคารชั้นนำ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นเงินโครเมียมตามตัวอักษร MAHA กับเลข 66 บนโลโก้
// คำหลังเป็นแดงตามคำว่า GAME ตรงกลาง — คู่สีเดียวกับโลโก้เป๊ะๆ
const claimChips = [
  { lead: "เว็บ", tail: "ตรง" },
  { lead: "ระบบ", tail: "แท้" },
  { lead: "ไลฟ์", tail: "สด" },
  { lead: "เกม", tail: "ครบ" },
  { lead: "บัญชี", tail: "เดียว" },
];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#de161d] bg-[#16090a] pt-16 pb-8 font-sans text-[#e8e3e1] shadow-[0_-10px_30px_rgba(222,22,29,0.22)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#de161d]/12 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#e2e8ef]/8 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ MAHAGAME66 ตัวอักษรหนาแบบเหลี่ยม คำว่า MAHA และเลข 66 เป็นสีดำ ส่วนคำว่า GAME ตรงกลางเป็นสีแดงสด"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(222,22,29,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(222,22,29,0.45)]">
                <span class="bg-gradient-to-b from-[#e2e8ef] to-[#9ba3ad] bg-clip-text text-transparent">MAHA</span>
                <span class="text-[#de161d]">GAME</span>
                <span class="bg-gradient-to-b from-[#e2e8ef] to-[#9ba3ad] bg-clip-text text-transparent">66</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#e8e3e1]">
          {BRAND_NAME} รวมเกมพนันออนไลน์หลายประเภทไว้ในระบบเดียว ทั้งบาคาร่า สล็อต หวย บอล และรูเล็ต พร้อมหมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ สมาชิกตรวจสอบค่ายเกม รายละเอียดโต๊ะ
          และรูปแบบเดิมพันก่อนเข้าเล่นได้ เมนูจัดหมวดหมู่ชัดเจน รองรับการใช้งานทั้งบนมือถือและคอมพิวเตอร์ เลือกเกมที่ต้องการได้ง่ายจากบัญชีเดียวโดยไม่ต้องสลับหลายเว็บไซต์
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#de161d]/50 bg-[#de161d]/10 px-3 py-1.5 text-xs font-bold text-[#e2e8ef] shadow-[0_0_10px_rgba(222,22,29,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> เว็บตรง ปลอดภัย
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#3a1413] bg-[#26100f]/80 px-3 py-1.5 text-xs font-bold text-[#e2e8ef]">
            <span aria-hidden="true" class="text-base">⚡</span> ระบบแท้ 100%
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e2e8ef]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ff4d52] to-[#7a0a0e]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#e8e3e1] transition-all hover:text-[#e2e8ef]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#de161d] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="สิทธิประโยชน์สำหรับสมาชิก" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e2e8ef]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ff4d52] to-[#7a0a0e]"></span> สิทธิประโยชน์
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            privileges.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#e8e3e1] transition-all hover:text-[#e2e8ef]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#9ba3ad] transition-colors group-hover:bg-[#de161d] group-hover:shadow-[0_0_8px_rgba(222,22,29,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#e2e8ef]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ff4d52] to-[#7a0a0e]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @{BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#e2e8ef]/90 uppercase">รองรับวอลเลทและธนาคารชั้นนำ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#de161d]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#e2e8ef] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#de161d]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#9ba3ad] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#e2e8ef]">{BRAND_NAME}</span>. All rights reserved. เว็บพนันออนไลน์เว็บตรง
        รวมบาคาร่า สล็อต หวย บอล และรูเล็ตไว้ในบัญชีเดียว พร้อมหมวดเกมไลฟ์สดตามรายการที่เปิดให้บริการ ฝากถอนผ่านวอลเลทและธนาคารตามช่องทางที่เว็บไซต์เปิดใช้งาน
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#e2e8ef]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#e2e8ef]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
