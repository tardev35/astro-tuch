---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// PUNPRO168 (รอบชมพูฮอตพิงก์-ทอง 2026-10-12): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน TIGERWIN369 ใช้ FooterPremium ส่วนไฟล์นี้ค้างเป็นชุดแดงเสือโคร่ง-ทอง
// ถ่านไฟของ SUPERSLOTCLUB ย้ายทั้งไฟล์มาเป็นพื้นพลัมเกือบดำ #1c0014 + ชมพู
// บานเย็น #f41571 + ชมพูสว่าง #ff5ca8 + ผิวยก #4a1038 + ทองสว่าง #fce343 +
// ทองอำพัน #ffc554 + เส้นลึก #8a0a45 เนื้อความครีมอมชมพู #fde7f2 และตัวรอง
// หม่น #f0c3dc (12.8:1 บนพื้นนี้)
//
// FooterPremium ของรอบก่อนเป็นแผ่น rounded-t-[3rem] มีออราคร่อมขอบบนและจัดสาม
// คอลัมน์ 5/3/4 — ไฟล์นี้เป็นคนละทรง: แผ่นแบนขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอย
// และเนื้อในเป็นกริด 4 คอลัมน์เท่ากัน
//
// ⚠️ รอบนี้ฮิวของแบรนด์เองมี "ทอง" เป็นตัวที่สอง และไฟล์นี้ค้างทองของ
// SUPERSLOTCLUB อยู่ก่อนแล้ว เจอทองที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่า
// เป็นตัวๆ: ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #7d0f12 #4a0605
// #180800 #f2b705 #ffd666 #a8730a #fbe8d5 #c9a898) ชุดแดงแล็กเกอร์ของ PIGPG
// (#d4200d #f5b61d #ffd87a #b07a06 #120302 #2a0806 #6b0402 #fdeedd #c9a48d
// #fdf9e4) ชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410
// #c9881f #4a3407 #f3e7cd #17130a) และชุดเขียวป่าของ หวยเต็ง (#e5c04f #03150a
// #d8ead9 #0bb42f #bd8d2d) ออกครบทุกจุดแล้ว
// ทองของรอบนี้ (#fce343 เหลืองสด) เป็นคนละค่ากับทองของทุกชุดข้างบน และชมพู
// #f41571 ก็คนละค่ากับชมพู #ff3fa4 ของ FAH999 ที่ค้างในไฟล์อื่น — อย่าปล่อย
// ของเก่าไว้เพราะ "ดูคล้ายกัน"
//
// PUNPRO168 เป็นเว็บเล่นสล็อตออนไลน์ล้วน ไม่ใช่เว็บหวยและไม่ใช่คาสิโนรวมหมวด
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
// (บวกปี 2026 ที่บรีฟเขียนไว้เองในหัวข้อ H1)
// ไม่มีคำว่าบาคาร่า บอลออนไลน์ ไฮโล ยิงปลา หรือหวย เพราะบรีฟรอบนี้เป็นสล็อตล้วน
const gameCategories = ["สล็อตคลาสสิกตามรายการที่เปิดให้บริการ", "เกมวงล้อแบบดั้งเดิม", "สล็อตภาพสมัยใหม่", "เกมที่มีฟีเจอร์โบนัสและฟรีสปิน", "จัดหมวดเกมไว้ให้ค้นหาได้สะดวก"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นครีม คำหลังเป็นชมพูแบรนด์ ทุกคู่เป็นคำที่บรีฟพูดไว้เอง
// ไม่มีคำโฆษณาอย่าง "จ่ายจริง" "ค่ายแท้" "แตกง่าย" หรือ "การันตีเว็บแท้"
const claimChips = [
  { lead: "สล็อตปันโปร", tail: "ในตำนาน" },
  { lead: "ทางเข้าเล่นใหม่", tail: "2026" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-12 จริง — หัวเสือโคร่งกับป้ายโล่แดง
// เลือดหมูของ SUPERSLOTCLUB ที่เคยอยู่ในตัวแปรนี้ไม่มีอยู่ในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านบนเป็นเครื่องเล่นเกมพกพาการ์ตูนสีชมพูอมบานเย็น มีปุ่มกากบาททิศทางสีดำทางซ้ายและปุ่มกลมสีชมพูเข้มทางขวา หน้าจอสีครีมวาดเป็นใบหน้าการ์ตูนยิ้มกว้างกำลังขยิบตา แก้มเป็นวงกลมสีชมพู ถัดลงมาเป็นคำว่า PUNPRO ตัวอักษรละตินหนาสามมิติสีชมพูบานเย็นตัดขอบสีทอง และใต้สุดเป็นตัวเลข 168 หนาสามมิติสีทองวาว`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f41571] bg-[#1c0014] pt-16 pb-8 font-sans text-[#fde7f2] shadow-[0_-10px_30px_rgba(244,21,113,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f41571]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#fce343]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(244,21,113,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(244,21,113,0.45)]">
                <span class="bg-gradient-to-b from-[#ff5ca8] to-[#f41571] bg-clip-text text-transparent">PUNPRO</span>
                <span class="bg-gradient-to-b from-[#fce343] to-[#ffc554] bg-clip-text text-transparent">168</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fde7f2]">
          {BRAND_NAME} สล็อตปันโปรในตำนาน เว็บเล่นสล็อตออนไลน์ที่รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว ทั้งเกมวงล้อแบบดั้งเดิม สล็อตภาพสมัยใหม่ และเกมที่มีฟีเจอร์โบนัสกับฟรีสปิน พร้อมเมนูตรวจสอบเครดิต โปรโมชั่น และข้อมูลบัญชีสมาชิกในหน้าเดียว รองรับการใช้งานผ่านมือถือและคอมพิวเตอร์ ผู้สนใจควรตรวจสอบช่องทางเข้าเล่นล่าสุดและรายละเอียดค่ายเกมจากเว็บไซต์หลักก่อนใช้งาน
          เพื่อหลีกเลี่ยงการเข้าสู่เว็บไซต์เลียนแบบ
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f41571]/50 bg-[#f41571]/10 px-3 py-1.5 text-xs font-bold text-[#ff5ca8] shadow-[0_0_10px_rgba(244,21,113,0.25)]">
            <span aria-hidden="true" class="text-base">🎰</span> ทางเข้าเล่นใหม่ 2026
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#8a0a45] bg-[#4a1038]/80 px-3 py-1.5 text-xs font-bold text-[#fde7f2]">
            <span aria-hidden="true" class="text-base">⏰</span> แอดมิน 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fce343]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fce343] to-[#ffc554]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#fde7f2] transition-all hover:text-[#fce343]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#f41571] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดเกมสล็อตที่เปิดให้บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fce343]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fce343] to-[#ffc554]"></span> หมวดเกมสล็อต
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#fde7f2] transition-all hover:text-[#fce343]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#f0c3dc] transition-colors group-hover:bg-[#f41571] group-hover:shadow-[0_0_8px_rgba(244,21,113,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fce343]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fce343] to-[#ffc554]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#fce343]/90 uppercase">รองรับวอลเลทและธนาคารชั้นนำ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f41571]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#fde7f2] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#fce343]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#f0c3dc] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#fce343]">{BRAND_NAME}</span>. All rights reserved. สล็อตปันโปรในตำนาน รวมสล็อตคลาสสิก เกมวงล้อแบบดั้งเดิม สล็อตภาพสมัยใหม่
        และเกมที่มีฟีเจอร์โบนัสกับฟรีสปินไว้ในระบบเดียว ส่วนภาพลักษณ์เว็บคนนิยมเล่นมายาวนานนั้น จำนวนปีที่เปิดเว็บไซต์และความนิยมไม่สามารถยืนยันได้จากชื่อแบรนด์เพียงอย่างเดียว ควรตรวจสอบโดเมนหลักและข้อมูลผู้ให้บริการให้ชัดเจนก่อนสมัครสมาชิก
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#fce343]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fce343]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
