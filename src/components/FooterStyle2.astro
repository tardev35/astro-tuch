---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// สบายเบท168 (รอบฟ้าบับเบิลนำ-ทองรอง 2026-10-19): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน ถอนชัวร์168 ใช้ FooterCyber ส่วนไฟล์นี้ค้างเป็นชุดทองไทยนำ-แดงมังกรรอง
// ของ รับตัง168 ย้ายทั้งไฟล์มาเป็นพื้นน้ำเงินเกือบดำ #040d16 + ฟ้าแบรนด์
// #2f9ff5 + ฟ้าอ่อน #a8dcff + ฟ้าลึก #0b3f78 + ทอง #ffc82e + ทองอ่อน #ffefbb +
// ทองลึก #5c4a16 + ผิวยก #0e2238 + ผิวกลาง #081726 และเนื้อความขาวอมฟ้า #e8f4ff
//
// FooterCyber ของรอบก่อนเป็นแผ่นที่ clip-path ตัดขอบบนเป็นหลังคาแหลมกลางจอ
// พร้อมตารางเส้นพื้นหลังและปุ่มตัดมุมทแยง — ไฟล์นี้เป็นคนละทรง: แผ่นแบนขอบบน
// เป็นเส้นหนา 3px ไม่มีการ์ดลอย และเนื้อในเป็นกริด 4 คอลัมน์เท่ากัน
//
// ⚠️ **กับดักรอบนี้คือทอง** และไฟล์นี้ค้างทองของแบรนด์อื่นมาแล้วหลายรอบ เจอทอง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับ
// .claude/brand-spec-sabuybet168.md §2: ชุดทองไทย-แดงมังกรของ รับตัง168
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0
// 2b100f 140505) ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 (fb131b ff8a8f
// ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 0d0304 8a0206 1a0304) ชุดชมพู
// ฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2
// 8a0a45 4a1038 1c0014) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (e8232a 7d0f12 4a0605 180800 f2b705 ffd666 a8730a fbe8d5 c9a898)
// ชุดแดงแล็กเกอร์ของ PIGPG (d4200d f5b61d ffd87a b07a06 120302 2a0806
// 6b0402 fdeedd c9a48d fdf9e4) ชุดทองเมทัลลิกของ 789BETTING (fad354
// ffe79a ddab33 8a6410 c9881f 4a3407 f3e7cd 17130a) และชุดเขียวป่าของ
// หวยเต็ง (e5c04f 03150a d8ead9 0bb42f bd8d2d) ออกครบทุกจุดแล้ว
// ทองรอบนี้ #ffc82e (R=255 G=200 B=46) **ไม่ใช่** f0b429 ของ รับตัง168
// ไม่ใช่ ffd84d ของ ถอนชัวร์168 ไม่ใช่ fcd434 ของ มีโชค168 และไม่ใช่ f2b705
// ของ SUPERSLOTCLUB
// รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีเขียว ไม่มีส้ม ไม่มีม่วง และไม่มีเงิน/โครเมียม
// (ยกเว้นเขียว LINE #00B900 ซึ่งเป็นสีของแบรนด์ LINE เอง ไม่ใช่ของเว็บ และ
//  สีแบรนด์ธนาคารจริงที่อยู่ใน BankStrip)
//
// ⚠️ รอบนี้ **ฟ้านำ ทองรอง** เส้นขอบบนหนา 3px จึงเป็นฟ้า และออรามุมบนขวาเป็นฟ้า
// ส่วนทองถอยไปเป็นออรามุมล่างซ้าย ปลายคำโปรย และกรอบชิปใบที่สอง
// ⚠️ #0b3f78 และ #5c4a16 ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
// ตัวที่ถือตัวอักษรได้บนพื้น #040d16: #a8dcff (≈12.4:1) #e8f4ff (≈16.8:1)
// #ffc82e (≈12.1:1) และ #2f9ff5 (≈6.3:1)
//
// สบายเบท168 เป็น **เว็บสล็อตล้วน** ไม่ใช่คาสิโนและไม่ใช่เว็บกีฬา — คำว่า
// เว็บตรง และ ลิขสิทธิ์แท้ ที่สองรอบก่อนเขียนไว้ในไฟล์นี้ **ไม่มีอยู่ในบรีฟ
// รอบนี้สักคำ** จึงถูกถอดออกทั้งหมด ไม่ใช่แก้คำทับประโยคเดิม บรีฟรอบนี้เรียก
// ตัวเองว่า เว็บสล็อตทางการ / ผู้ให้บริการฐานเกมหลัก / เว็บแท้อันดับ1 เท่านั้น
// และ **ไม่ระบุชื่อค่ายเกมแม้แต่ค่ายเดียว** คอลัมน์ที่สามจึงเป็น "บริการที่
// สอบถามได้" ซึ่งเป็นสิ่งที่บรีฟรอบนี้มีจริง (content.txt บรรทัด 4 + 6 + 14 + 22)
//
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
const supportTopics = ["ขั้นตอนสมัครสมาชิกและการเข้าสู่ระบบ", "การทำรายการฝากถอน", "รายละเอียดโปรโมชั่นและวิธีรับสิทธิ์", "รายชื่อค่ายเกมและกติกาของแต่ละเกม", "ข้อกำหนดและเงื่อนไขบริการ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นทอง ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-3, 8-12, 22) ไม่มีคำโฆษณาอย่าง "จ่ายจริง"
// "แตกง่าย" หรือ "เว็บตรง"
const claimChips = [
  { lead: "เว็บสล็อต", tail: "ทางการ" },
  { lead: "ผู้ให้บริการ", tail: "ฐานเกมหลัก" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "เจ้าหน้าที่", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-19 จริง — ตัวอักษรโครเมียมเงินอมฟ้า
// ตัดขอบแดงกับเหรียญจีนของ รับตัง168 ที่เคยอยู่ในตัวแปรนี้ไม่มีในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส ด้านบนเป็นแมวการ์ตูนขนขาวลายส้มหน้ายิ้มหลับตา ยกอุ้งเท้าขึ้น สวมปลอกคอสีฟ้ามีกระดิ่งทอง นั่งข้างมือถือจอสีฟ้าที่มีลูกศรดาวน์โหลดและปึกธนบัตรสีฟ้า มีเหรียญทองสลักสัญลักษณ์บิตคอยน์กับหัวใจสีฟ้าลอยอยู่รอบ ใต้ลงมาเป็นคำว่า สบาย ตัวอักษรไทยหนาสามมิติสีทอง ต่อด้วย เบท168 สามมิติผิวมันวาวสีฟ้า`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#2f9ff5] bg-[#040d16] pt-16 pb-8 font-sans text-[#e8f4ff] shadow-[0_-10px_30px_rgba(47,159,245,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#2f9ff5]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#ffc82e]/14 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(47,159,245,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#a8dcff] to-[#2f9ff5] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(47,159,245,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#e8f4ff]">
          {BRAND_NAME} เป็นเว็บไซต์ที่นำเสนอช่องทางเข้าใช้งานเกมสล็อตออนไลน์ พร้อมเมนูสำหรับจัดการบัญชีสมาชิกและตรวจสอบรายละเอียดบริการต่าง ๆ ทั้งการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน และโปรโมชั่น
          ผู้ใช้งานสามารถศึกษารายชื่อค่ายเกม กติกา และเงื่อนไขการทำรายการผ่านช่องทางที่เว็บไซต์จัดเตรียมไว้ รวมถึงสอบถามเจ้าหน้าที่เมื่อมีข้อสงสัย ทั้งนี้ ควรตรวจสอบข้อมูลผู้ให้บริการและความน่าเชื่อถือจากหลักฐานที่ตรวจสอบได้ก่อนใช้งาน
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#2f9ff5]/50 bg-[#2f9ff5]/10 px-3 py-1.5 text-xs font-bold text-[#a8dcff] shadow-[0_0_10px_rgba(47,159,245,0.25)]">
            <span aria-hidden="true" class="text-base">🎰</span> ฐานเกมสล็อตออนไลน์
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#5c4a16] bg-[#0e2238]/80 px-3 py-1.5 text-xs font-bold text-[#e8f4ff]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8dcff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#2f9ff5] to-[#0b3f78]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#e8f4ff] transition-all hover:text-[#a8dcff]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#2f9ff5] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="เรื่องที่ติดต่อสอบถามเจ้าหน้าที่ได้" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8dcff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#2f9ff5] to-[#0b3f78]"></span> บริการที่สอบถามได้
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            supportTopics.map((item) => (
              <li>
                <a href="/contact-us" class="group flex items-start text-[#e8f4ff] transition-all hover:text-[#a8dcff]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#a8dcff] transition-colors group-hover:bg-[#ffc82e] group-hover:shadow-[0_0_8px_rgba(255,200,46,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8dcff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#2f9ff5] to-[#0b3f78]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#a8dcff]/90 uppercase">ช่องทางฝากถอนที่รองรับ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#2f9ff5]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#e8f4ff] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#ffc82e]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#a8dcff] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffc82e]">{BRAND_NAME}</span>. All rights reserved. เว็บไซต์ที่รวบรวมข้อมูลการสมัครสมาชิก การเข้าสู่ระบบ การฝากถอน และโปรโมชั่นของเกมสล็อตออนไลน์ไว้ในที่เดียว
        ก่อนทำรายการควรตรวจสอบรายละเอียดบัญชีและเงื่อนไขของแต่ละรายการให้ครบถ้วน รวมถึงพิจารณาข้อมูลผู้ให้บริการจากหลักฐานที่ตรวจสอบได้ และไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffc82e]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffc82e]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
