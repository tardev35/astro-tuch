---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#25cb0e] bg-[#010301] pt-16 pb-8 font-sans text-[#d5e8d0] shadow-[0_-10px_30px_rgba(37,203,14,0.18)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#25cb0e]/10 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#f0f7ee]/8 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ JUMBOBET ตัวอักษรเอียงหนา คำว่า JUMBO สีโครเมียมเงิน และคำว่า BET สีเขียวนีออน"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(37,203,14,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#f0f7ee] via-[#6ef25a] to-[#0b7a06] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(37,203,14,0.4)]">JUMBOBET</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#d5e8d0]">
          JUMBOBET เว็บพนันเบอร์1ยอดนิยม รวมสล็อต บาคาร่า คาสิโนสด รูเล็ต เสือมังกร เกมไพ่ และหวยไว้ในบัญชีเดียว รองรับการใช้งานทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
          พร้อมระบบฝากถอนอัตโนมัติที่ทำรายการเองได้ตลอด 24 ชั่วโมง และทีมงานคอยดูแลสมาชิกทั้งวันทั้งคืน
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#25cb0e]/50 bg-[#25cb0e]/10 px-3 py-1.5 text-xs font-bold text-[#6ef25a] shadow-[0_0_10px_rgba(37,203,14,0.22)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#cfd6cd]/40 bg-[#031204]/60 px-3 py-1.5 text-xs font-bold text-[#cfd6cd]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f0f7ee]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#6ef25a] to-[#063f04]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            [
              { name: "หน้าแรก", path: "/" },
              { name: "โปรโมชั่น", path: "/promotion" },
              { name: "ทางเข้า", path: "/ทางเข้า" },
              { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
              { name: "เกี่ยวกับเรา", path: "/about-us" },
              { name: "ติดต่อเรา", path: "/contact-us" },
            ].map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#d5e8d0] transition-all hover:text-[#6ef25a]">
                  <span class="mr-2 -ml-4 text-[#25cb0e] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">➤</span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Game Categories" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f0f7ee]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#6ef25a] to-[#063f04]"></span> หมวดหมู่เกม
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            ["สล็อตออนไลน์ (Slot)", "คาสิโนสด (Live Casino)", "บาคาร่า (Baccarat)", "รูเล็ต (Roulette)", "เสือมังกร (Dragon Tiger)"].map((game) => (
              <li>
                <a href="/register" class="group flex items-center text-[#d5e8d0] transition-all hover:text-[#6ef25a]">
                  <span class="mr-3 h-1.5 w-1.5 rounded-full bg-[#0b7a06] transition-colors group-hover:bg-[#25cb0e] group-hover:shadow-[0_0_8px_rgba(37,203,14,0.8)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f0f7ee]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#6ef25a] to-[#063f04]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @JUMBOBET
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#25cb0e]/90 uppercase">รองรับทุกธนาคาร & True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#25cb0e]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-[#cfd6cd] italic md:text-2xl">PG<span class="text-[#25cb0e]">SOFT</span></span>
      <span class="text-lg font-black text-[#cfd6cd] italic md:text-2xl">PRAGMATIC<span class="text-[#25cb0e]">PLAY</span></span>
      <span class="text-lg font-black text-[#cfd6cd] italic md:text-2xl">EVO<span class="text-[#25cb0e]">LUTION</span></span>
      <span class="text-lg font-black text-[#cfd6cd] italic md:text-2xl">JILI<span class="text-[#25cb0e]">GAMES</span></span>
      <span class="text-lg font-black text-[#cfd6cd] italic md:text-2xl">MICRO<span class="text-[#25cb0e]">GAMING</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#8fa08c] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#f0f7ee]">JUMBOBET</span>. All rights reserved. เว็บพนันเบอร์1 โบนัสคืนยอดเสีย 0.3% ฝากถอนอัตโนมัติ</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#6ef25a]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#6ef25a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
