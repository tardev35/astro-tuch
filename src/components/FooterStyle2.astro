---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน KOON234 ใช้ FooterPremium ส่วนไฟล์นี้ค้างเป็นชุดทองเมทัลลิกบนดำสนิทของ
// 789BETTING ย้ายทั้งไฟล์มาเป็นพื้นแดงเกือบดำ #120302 + ทองแบรนด์ #f5b61d
// + ทองอ่อน #ffd87a + ทองเข้ม #b07a06 + แดงสด #d4200d + แดงลึก #6b0402
// เนื้อความครีม #fdeedd และตัวรองครีมหม่น #c9a48d (8.6:1 บนพื้นนี้)
// ชุดทองเมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407
// #f3e7cd #b5a888 #17130a #060402 rgba(250,211,84,α)) และชุดเขียวป่า-ทองของ
// หวยเต็ง ก่อนหน้านั้น (#e5c04f #03150a #d8ead9 #0bb42f #bd8d2d) ออกครบทุกจุดแล้ว
// ทองของรอบนี้เป็นคนละค่า อย่าปล่อยของเก่าไว้เพราะ "ดูคล้ายกัน"
//
// PIGPG เป็นฐานเข้าเล่นสล็อตเว็บหลัก ไม่ใช่เว็บหวยและไม่ใช่คาสิโนรวมหมวด
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสี่ตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · สมัคร 3 ขั้นตอน ·
// 24 ชั่วโมง และไม่มีคำว่าหวย บาคาร่า รูเล็ต หรือบอล เพราะบรีฟรอบนี้เป็นสล็อตล้วน
const gameCategories = ["สล็อตคลาสสิกตามรายการที่เปิดให้บริการ", "เกมโบนัสและรอบฟรีสปิน", "สล็อตที่มีฟีเจอร์ตัวคูณ", "เกมใหม่จากค่ายที่เพิ่มเข้าระบบ", "เลือกค่ายและตรวจเครดิตผ่านบัญชีเดียว"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นครีม คำหลังเป็นทองแบรนด์ ทุกคู่เป็นคำที่บรีฟพูดไว้เอง
// ไม่มีคำโฆษณาอย่าง "เว็บตรง" "จ่ายจริง" หรือ "การันตีเว็บแท้"
const claimChips = [
  { lead: "สล็อต", tail: "ค่ายแท้" },
  { lead: "ถอนยอด", tail: "24ชม." },
  { lead: "บัญชี", tail: "เดียว" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
];

const logoAlt =
  "โลโก้ PIGPG บนพื้นโปร่งใส ด้านบนเป็นหัวหมูการ์ตูนสีชมพูแก้มแดง ขยิบตาและยิ้มกว้าง สวมหมวกทรงจีนสีแดงที่มีเหรียญทองกลางหมวกและยอดทรงกลมสีทองด้านบน รอบหัวหมูมีเหรียญทองและก้อนทองวางเรียงเป็นพัด ด้านล่างเป็นป้ายแล็กเกอร์สีแดงขอบทองหนา คาดคำว่า PIGPG ด้วยตัวอักษรหนาสามมิติสีครีมงาช้าง และมีพลอยสีแดงทรงข้าวหลามตัดอยู่ใต้ป้าย";
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f5b61d] bg-[#120302] pt-16 pb-8 font-sans text-[#fdeedd] shadow-[0_-10px_30px_rgba(245,182,29,0.22)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f5b61d]/12 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#d4200d]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(245,182,29,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(245,182,29,0.45)]">
                <span class="bg-gradient-to-b from-[#fdf9e4] to-[#c9a48d] bg-clip-text text-transparent">PIG</span>
                <span class="bg-gradient-to-b from-[#ffd87a] to-[#b07a06] bg-clip-text text-transparent">PG</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fdeedd]">
          {BRAND_NAME} ฐานเข้าเล่นสล็อตเว็บหลักที่รวบรวมเกมสล็อตหลากหลายรูปแบบไว้ในระบบเดียว ทั้งสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ สมาชิกเลือกค่าย ตรวจสอบเครดิต ดูโปรโมชั่น
          และติดตามประวัติรายการผ่านบัญชีเดียวได้สะดวก ส่วนการระบุว่าเป็นศูนย์รวมเกมสล็อตค่ายแท้ ควรมีข้อมูลผู้ให้บริการและรายชื่อค่ายเกมที่ตรวจสอบได้รองรับ
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f5b61d]/50 bg-[#f5b61d]/10 px-3 py-1.5 text-xs font-bold text-[#ffd87a] shadow-[0_0_10px_rgba(245,182,29,0.25)]">
            <span aria-hidden="true" class="text-base">📱</span> เล่นผ่านมือถือ
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#6b0402] bg-[#2a0806]/80 px-3 py-1.5 text-xs font-bold text-[#fdeedd]">
            <span aria-hidden="true" class="text-base">⏰</span> แอดมิน 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd87a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd87a] to-[#b07a06]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#fdeedd] transition-all hover:text-[#ffd87a]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#f5b61d] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดเกมสล็อตที่เปิดให้บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd87a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd87a] to-[#b07a06]"></span> หมวดเกมสล็อต
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#fdeedd] transition-all hover:text-[#ffd87a]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a48d] transition-colors group-hover:bg-[#f5b61d] group-hover:shadow-[0_0_8px_rgba(245,182,29,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffd87a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffd87a] to-[#b07a06]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#ffd87a]/90 uppercase">รองรับวอลเลทและธนาคารชั้นนำ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f5b61d]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#fdeedd] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#f5b61d]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#c9a48d] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffd87a]">{BRAND_NAME}</span>. All rights reserved. ฐานเข้าเล่นสล็อตเว็บหลัก รวมสล็อตคลาสสิก เกมโบนัส ฟรีสปิน ตัวคูณ
        และเกมใหม่จากค่ายที่เปิดให้บริการไว้ในบัญชีเดียว ระบบเปิดรับคำขอถอนยอดได้ 24 ชั่วโมง แต่ระยะเวลาที่เงินเข้าบัญชีขึ้นอยู่กับขั้นตอนตรวจสอบและช่องทางชำระเงิน
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffd87a]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd87a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
