---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// หวยกินดี365 เป็นเว็บหวย — /ตรวจหวย และ /แนวทาง เปิดอยู่ใน src/pages/ รอบนี้
// จึงมีลิงก์ทั้งใน NavbarStyle9 และตรงนี้ ส่วน /ทางเข้า ไม่มีในเมนู navbar เพราะ
// toggle register/login เปิดอยู่ แต่ยังลิงก์จากตรงนี้ให้เข้าถึงได้
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// หมวดหวยตามที่ content.txt ระบุไว้เท่านั้น — อะไรที่เจาะจงกว่านี้คือการแต่งขึ้นเอง
const lottoTypes = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย 3 รูปแบบ", "หวยหุ้นต่างประเทศ", "3 ตัวบาทละ 1,000 / 2 ตัวบาทละ 100"];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f6db6b] bg-[#03153b] pt-16 pb-8 font-sans text-[#dce7fb] shadow-[0_-10px_30px_rgba(246,219,107,0.18)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f6db6b]/10 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#0a6dfb]/15 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ หวยกินดี365 คำว่า หวย สีน้ำเงินสดวางติดกับคำว่า กินดี สีทองไล่เงา ด้านล่างเป็นเลข 365 สีน้ำเงินไล่เฉดขอบขาว ล้อมด้วยเส้นโค้งสีทองปลายเป็นใบไม้ทองสามใบ"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(246,219,107,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fbe473] via-[#f6db6b] to-[#c9a23a] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(246,219,107,0.4)]">หวยกินดี365</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#dce7fb]">
          หวยกินดี365 รวมบริการแทงหวยออนไลน์หลายประเภทไว้ในระบบเดียว เหมาะกับคนที่ต้องการเลือกเล่นได้หลายตลาดโดยไม่ต้องสลับเว็บไซต์ มีทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ
          พร้อมอัตราจ่ายตามที่กำหนด 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100 สมาชิกสามารถตรวจสอบเรทก่อนส่งโพย ฝากเครดิตผ่านระบบออโต้ และติดต่อเจ้าหน้าที่ได้ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f6db6b]/50 bg-[#f6db6b]/10 px-3 py-1.5 text-xs font-bold text-[#fbe473] shadow-[0_0_10px_rgba(246,219,107,0.22)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#0a6dfb]/55 bg-[#041b44]/70 px-3 py-1.5 text-xs font-bold text-[#5ec2f5]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fbe473]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fbe473] to-[#c9a23a]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#dce7fb] transition-all hover:text-[#fbe473]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#f6db6b] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหวยที่เปิดให้บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fbe473]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fbe473] to-[#c9a23a]"></span> หมวดหวย
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            lottoTypes.map((lotto) => (
              <li>
                <a href="/register" class="group flex items-center text-[#dce7fb] transition-all hover:text-[#fbe473]">
                  <span aria-hidden="true" class="mr-3 h-1.5 w-1.5 rounded-full bg-[#0a6dfb] transition-colors group-hover:bg-[#f6db6b] group-hover:shadow-[0_0_8px_rgba(246,219,107,0.8)]" />
                  {lotto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#fbe473]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fbe473] to-[#c9a23a]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @หวยกินดี365
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#f6db6b]/90 uppercase">รองรับทุกธนาคาร & True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f6db6b]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      <span class="text-lg font-black text-[#f6db6b] italic md:text-2xl">หวย<span class="text-[#5ec2f5]">รัฐบาลไทย</span></span>
      <span class="text-lg font-black text-[#f6db6b] italic md:text-2xl">หวย<span class="text-[#5ec2f5]">ลาวพัฒนา</span></span>
      <span class="text-lg font-black text-[#f6db6b] italic md:text-2xl">หวย<span class="text-[#5ec2f5]">ฮานอย</span></span>
      <span class="text-lg font-black text-[#f6db6b] italic md:text-2xl">หวย<span class="text-[#5ec2f5]">หุ้นต่างประเทศ</span></span>
      <span class="text-lg font-black text-[#f6db6b] italic md:text-2xl">3ตัว<span class="text-[#5ec2f5]">บาทละ1,000</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#93a8ce] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#fbe473]">หวยกินดี365</span>. All rights reserved. เว็บหวยออนไลน์ รับแทงหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหุ้นต่างประเทศ
        เจ้าหน้าที่ดูแลตลอด 24 ชั่วโมง
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#fbe473]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fbe473]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
