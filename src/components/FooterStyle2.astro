---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ABM96 (รอบชมพู-เหลือง 2026-09-22): เดิมไฟล์นี้เป็นของ NEXT55 โทนแดงเลือดนก-
// กราไฟต์ และ hardcode ชื่อแบรนด์ไว้สามจุด ตอนนี้ทุกจุดอ่านจาก BRAND_NAME แล้ว
// ธีมย้ายมาเป็นชมพู #fd6494 กับเหลืองโลโก้ #feda2a บนพื้นชมพูเกือบดำ #12030a
//
// ABM96 เป็นเว็บเดิมพันรวม ไม่ใช่เว็บหวยเฉพาะทาง — /ตรวจหวย และ /แนวทาง ถูกพัก
// ไว้ใน src/pages-disabled/ รอบนี้ จึงไม่มีลิงก์ทั้งสองในคอลัมน์นี้ (ไฟล์
// คอมโพเนนต์ *Huay ยังอยู่ครบในฐานะ inventory ของแบรนด์หวยรอบหน้า)
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// สิทธิประโยชน์ตามที่ content.txt ระบุไว้เท่านั้น — อะไรที่เจาะจงกว่านี้
// (เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ชื่อค่ายเกม อัตราฝากถอน) คือการแต่งขึ้นเอง
const privileges = ["เว็บเดิมพันออนไลน์เจ้าของเดิม", "ทางเข้าและระบบใช้งานอัปเดตใหม่", "บาคาร่า สล็อต หวย ไฮโล บอล ในบัญชีเดียว", "แนะนำเพื่อนรับโบนัส 0.8%", "คืนยอดเสียรับโบนัส 0.3%"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นชมพูตามตัวอักษร ABM บนโลโก้ คำหลังเป็นเหลือง
// ตามตัวเลข 96 — คู่สีเดียวกับโลโก้เป๊ะๆ
const claimChips = [
  { lead: "เจ้าของ", tail: "เดิม" },
  { lead: "อัปเดต", tail: "ใหม่" },
  { lead: "ปลอดภัย", tail: "สูง" },
  { lead: "เกม", tail: "ครบ" },
  { lead: "บัญชี", tail: "เดียว" },
];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#fd6494] bg-[#12030a] pt-16 pb-8 font-sans text-[#fbe3ee] shadow-[0_-10px_30px_rgba(253,100,148,0.2)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#fd6494]/12 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#feda2a]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ ABM96 ตัวอักษร ABM แบบสามมิติอวบกลมสีชมพูวางอยู่แถวบน ใต้ลงมาเป็นตัวเลข 96 แบบสามมิติอวบกลมสีเหลือง"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(253,100,148,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(253,100,148,0.4)]">
                <span class="bg-gradient-to-b from-[#ffc9dc] to-[#fd6494] bg-clip-text text-transparent">ABM</span>
                <span class="text-[#feda2a]">96</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fbe3ee]">
          {BRAND_NAME} เว็บเดิมพันออนไลน์เจ้าของเดิมที่ปรับระบบใหม่ให้ใช้งานได้สะดวกขึ้น ทั้งหน้าเกม เมนูสมาชิก และการเข้าถึงผ่านมือถือ รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต
          หวย ไฮโล และบอล ระบบจัดหมวดหมู่ชัดเจน สลับระหว่างเกมแต่ละประเภทได้สะดวกโดยไม่ต้องเปลี่ยนหลายเว็บไซต์ พร้อมยกระดับการดูแลข้อมูลและระบบหลังบ้านให้เป็นระบบมากกว่าเดิม
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#fd6494]/50 bg-[#fd6494]/10 px-3 py-1.5 text-xs font-bold text-[#ffc9dc] shadow-[0_0_10px_rgba(253,100,148,0.22)]">
            <span aria-hidden="true" class="text-base">🛡️</span> ความปลอดภัยสูง
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#5c0e2e] bg-[#2a0a1a]/70 px-3 py-1.5 text-xs font-bold text-[#feda2a]">
            <span aria-hidden="true" class="text-base">⚡</span> ระบบอัปเดตใหม่
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffc9dc]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fd6494] to-[#b8325f]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#fbe3ee] transition-all hover:text-[#ffc9dc]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#feda2a] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="สิทธิประโยชน์สำหรับสมาชิก" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffc9dc]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fd6494] to-[#b8325f]"></span> สิทธิประโยชน์
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            privileges.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#fbe3ee] transition-all hover:text-[#ffc9dc]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#d79ab4] transition-colors group-hover:bg-[#feda2a] group-hover:shadow-[0_0_8px_rgba(254,218,42,0.8)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffc9dc]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#fd6494] to-[#b8325f]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @{BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#feda2a]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#fd6494]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#fd6494] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#feda2a]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#d79ab4] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffc9dc]">{BRAND_NAME}</span>. All rights reserved. เว็บเดิมพันออนไลน์เจ้าของเดิม
        ทางเข้าเกมอัปเดตใหม่ อัปเกรดระบบการใช้งานและระบบหลังบ้านให้เสถียรขึ้น ความปลอดภัยได้มาตรฐานสูง รวมบาคาร่า สล็อต หวย ไฮโล และบอลไว้ในบัญชีเดียว
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffc9dc]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffc9dc]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
