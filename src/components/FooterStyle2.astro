---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ufalion168 (รอบทองอำพันนำ-ทองเลมอนเฉดสว่าง 2026-10-20): footer ที่ใช้งานจริงรอบนี้ —
// รอบก่อน รวยเทพ168 ใช้ Footer ตัวฐาน ส่วนไฟล์นี้ค้างเป็นชุดฟ้าบับเบิล-ทองของ
// สบายเบท168 ย้ายทั้งไฟล์มาเป็นพื้นดำบรอนซ์ #0a0601 + ทองอำพัน #d4922c +
// ทองเลมอน #fdfc71 + ครีมทอง #f6e3b4 + บรอนซ์ #a25b24 + บรอนซ์ไหม้ #5a3310 +
// ผิวยก #33200a + ผิวกลาง #1f1304 และเนื้อความงาช้างอมเลมอน #fbf6e3
//
// Footer ตัวฐานของรอบก่อนเป็นกริด 12 คอลัมน์แบบไม่สมมาตรที่มี BankStrip พาดอยู่
// ด้านบนสุดของฟุตเตอร์ — ไฟล์นี้เป็นคนละทรง: แผ่นแบน ขอบบนเป็นเส้นหนา 3px
// ไม่มีการ์ดลอย เนื้อในเป็นกริด 4 คอลัมน์เท่ากัน และ BankStrip อยู่ท้ายคอลัมน์ที่สี่
// ไม่ได้พาดเต็มความกว้าง
//
// ⚠️ **กับดักรอบนี้คือทอง** และไฟล์นี้ค้างทองของแบรนด์อื่นมาแล้วหลายรอบ เจอทอง
// ที่ไหนห้ามเหมาว่าเป็นของรอบนี้ ให้เทียบค่าเป็นตัวๆ กับ
// .claude/brand-spec-ufalion168.md §2: ชุดฟ้าบับเบิล-ทองของ สบายเบท168
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16 04121f)
// ชุดทองจักรพรรดิ-แดงชาดของ รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e
// 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดทองไทย-แดงมังกรของ รับตัง168
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 140505)
// ชุดแดงเลือดนก-เงินโครเมียมของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6
// f2e4e5 2a0d0f 0d0304 8a0206 1a0304) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168
// (f41571 ff5ca8 fce343 ffc554 f0c3dc fde7f2 8a0a45 4a1038 1c0014) ชุดแดงเสือโคร่ง-
// ทองถ่านไฟของ SUPERSLOTCLUB (e8232a 7d0f12 4a0605 180800 f2b705 ffd666 a8730a
// fbe8d5 c9a898) ชุดแดงแล็กเกอร์ของ PIGPG (d4200d f5b61d ffd87a b07a06 120302
// 2a0806 6b0402 fdeedd c9a48d fdf9e4) ชุดทองเมทัลลิกของ 789BETTING (fad354
// ffe79a ddab33 8a6410 c9881f 4a3407 f3e7cd 17130a) ชุดทองแชมเปี้ยน-เงินโครเมียม
// ของ UFA324 (e5a81b ffe08a bb8410 7d5a07 8792a0 f0e8d4 b9c2cc 464f5a) และชุด
// เขียวป่าของ หวยเต็ง (e5c04f 03150a d8ead9 0bb42f bd8d2d) ออกครบทุกจุดแล้ว
// ทองรอบนี้ #d4922c (R=212 G=146 B=44) **ไม่ใช่** ffc82e ของ สบายเบท168
// ไม่ใช่ f0bb4e ของ รวยเทพ168 ไม่ใช่ e5a81b ของ UFA324 และไม่ใช่ dfa310
// ของ TND168 ซึ่งใกล้ที่สุด (ต่างที่ G146 vs G163 และ B44 vs B16)
// รอบนี้ไม่มีฟ้า ไม่มีแดง ไม่มีชมพู ไม่มีเขียว ไม่มีม่วง ไม่มีส้มสด และไม่มีเงิน/
// โครเมียม (ยกเว้นเขียว LINE #00B900 ซึ่งเป็นสีของแบรนด์ LINE เอง ไม่ใช่ของเว็บ และ
//  สีแบรนด์ธนาคารจริงที่อยู่ใน BankStrip)
// ⚠️ ถ้วยแชมเปี้ยนส์ลีกในแบนเนอร์เป็นสีเงินจริง แต่นั่นเป็นวัตถุในภาพ ไม่ใช่สีแบรนด์
// ห้ามดึงเงิน/โครเมียมเข้ามาเป็นสีของ UI (นั่นคือสิ่งที่ UFA324 ทำ และเป็นคนละแบรนด์)
//
// ⚠️ รอบนี้ **ทองนำล้วน ไม่มีฮิวที่สองที่เป็นคนละวงศ์** เส้นขอบบนหนา 3px จึงเป็น
// ทองอำพัน ออรามุมบนขวาเป็นทองอำพัน ส่วนทองเลมอนถอยไปเป็นออรามุมล่างซ้าย
// ปลายคำโปรย และตัวอักษรชื่อแบรนด์ในบรรทัดลิขสิทธิ์
// ⚠️ #a25b24 และ #5a3310 ห้ามถือตัวอักษรทุกขนาดในไฟล์นี้
// ตัวที่ถือตัวอักษรได้บนพื้น #0a0601: #f6e3b4 (≈16.0:1) #fbf6e3 (≈19.2:1)
// #fdfc71 (≈18.6:1) และ #d4922c (≈7.6:1)
//
// ufalion168 เป็น **แฟนเพจเว็บบอลยูฟ่า** ไม่ใช่เว็บสล็อตและไม่ใช่เว็บหวย — คำว่า
// เว็บสล็อต / ฐานเกมสล็อตออนไลน์ / ค่ายเกม / ยิงปลา / ไฮโล / หวยออนไลน์ ที่สอง
// รอบก่อนเขียนไว้ในไฟล์นี้ **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออกทั้งหมด
// ไม่ใช่แก้คำทับประโยคเดิม บรีฟรอบนี้เรียกตัวเองว่า แฟนเพจเว็บบอลยูฟ่า และพูดถึง
// ข่าวสารฟุตบอล โปรแกรมแข่งขัน ผลการแข่งขัน แนวทางวิเคราะห์ก่อนเกม ราคาบอล ค่าน้ำ
// โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ คอลัมน์ที่สามจึงเป็น "บริการที่สอบถามได้"
// ซึ่งเป็นสิ่งที่บรีฟรอบนี้มีจริง (content.txt บรรทัด 4 + 6 + 14 + 22)
//
// — /ตรวจหวย และ /แนวทาง จอดอยู่ใน src/pages-disabled/ รอบนี้ จึงไม่มี route และ
// ไม่มีสองบรรทัดนั้นใน quickLinks ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่
// src/pages/ พร้อมใส่ลิงก์คืน ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต
// ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝากขั้นต่ำ ชื่อลีก ชื่อสโมสร ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้มีสามตัว: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · 24 ชั่วโมง
const supportTopics = ["ขั้นตอนสมัครสมาชิกและการเข้าสู่ระบบ", "การทำรายการฝากถอน", "ข้อมูลราคาบอลและค่าน้ำแต่ละแมตช์", "รายละเอียดโปรโมชั่นและวิธีรับสิทธิ์", "ข้อกำหนดและเงื่อนไขบริการ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นทองเลมอน ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-3, 8-12, 22) ไม่มีคำโฆษณาอย่าง "จ่ายจริง"
// "บอลเต็ง100%" หรือ "เว็บตรง"
const claimChips = [
  { lead: "แฟนเพจ", tail: "เว็บบอลยูฟ่า" },
  { lead: "อัปเดตข่าวสาร", tail: "ทุกแมตช์" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "เจ้าหน้าที่", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-20 จริง — แมวการ์ตูนขนขาวลายส้มกับมือถือ
// จอฟ้าของ สบายเบท168 ที่เคยอยู่ในตัวแปรนี้ไม่มีในรูปรอบนี้เลย
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส กลางภาพเป็นหัวสิงโตทองคำขนแผงฟู สวมมงกุฎทองยอดแหลม วางอยู่บนริ้วทองเหลวโค้งที่สาดกระเซ็นออกไปทั้งสองข้าง ล้อมด้วยประกายดาวสีทอง ใต้ลงมาเป็นชื่อแบรนด์ตัวอักษรหนาสามมิติผิวทองมันวาว โดยส่วน ufa และ 168 เป็นทองเข้มกว่า ส่วน lion เป็นทองอ่อนกว่า และตัวอักษรโอในคำว่า lion มีมงกุฎทองขนาดเล็กวางอยู่ข้างใน`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#d4922c] bg-[#0a0601] pt-16 pb-8 font-sans text-[#fbf6e3] shadow-[0_-10px_30px_rgba(212,146,44,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#d4922c]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#fdfc71]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(212,146,44,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fdfc71] to-[#d4922c] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(212,146,44,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fbf6e3]">
          {BRAND_NAME} เป็นเว็บไซต์ที่นำเสนอช่องทางติดตามข่าวสารฟุตบอลสำหรับผู้ที่สนใจการแข่งขันจากลีกต่าง ๆ พร้อมข้อมูลโปรแกรมแข่งขัน ผลการแข่งขัน และแนวทางวิเคราะห์ก่อนเกม
          ภายในเว็บไซต์ยังมีรายละเอียดเกี่ยวกับราคาบอล ค่าน้ำ โปรโมชั่น และช่องทางติดต่อเจ้าหน้าที่ เพื่อให้ผู้ใช้งานศึกษาข้อมูลประกอบการตัดสินใจได้สะดวก ทั้งนี้
          ควรตรวจสอบความถูกต้องของข่าวสารและราคาที่เปลี่ยนแปลงก่อนการแข่งขันทุกครั้ง
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#d4922c]/50 bg-[#d4922c]/10 px-3 py-1.5 text-xs font-bold text-[#f6e3b4] shadow-[0_0_10px_rgba(212,146,44,0.25)]">
            <span aria-hidden="true" class="text-base">⚽</span> แฟนเพจเว็บบอลยูฟ่า
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#5a3310] bg-[#33200a]/80 px-3 py-1.5 text-xs font-bold text-[#fbf6e3]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24 ชั่วโมง
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f6e3b4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#d4922c] to-[#5a3310]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#fbf6e3] transition-all hover:text-[#f6e3b4]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#d4922c] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="เรื่องที่ติดต่อสอบถามเจ้าหน้าที่ได้" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f6e3b4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#d4922c] to-[#5a3310]"></span> บริการที่สอบถามได้
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            supportTopics.map((item) => (
              <li>
                <a href="/contact-us" class="group flex items-start text-[#fbf6e3] transition-all hover:text-[#f6e3b4]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#f6e3b4] transition-colors group-hover:bg-[#fdfc71] group-hover:shadow-[0_0_8px_rgba(253,252,113,0.85)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f6e3b4]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#d4922c] to-[#5a3310]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> ติดต่อแอดมิน {BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#f6e3b4]/90 uppercase">ช่องทางฝากถอนที่รองรับ</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#d4922c]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#fbf6e3] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#fdfc71]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#f6e3b4] md:flex-row">
