---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// NEXT55 เป็นเว็บคาสิโน ไม่ใช่เว็บหวย — /ตรวจหวย และ /แนวทาง ถูกพักไว้ใน
// src/pages-disabled/ รอบนี้ จึงไม่มีลิงก์ทั้งสองในคอลัมน์นี้ (ไฟล์คอมโพเนนต์
// *Huay ยังอยู่ครบในฐานะ inventory ของแบรนด์หวยรอบหน้า)
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// สิทธิประโยชน์ตามที่ content.txt ระบุไว้เท่านั้น — อะไรที่เจาะจงกว่านี้
// (เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ชื่อค่ายเกม) คือการแต่งขึ้นเอง
const privileges = ["เว็บตรง 100% ไม่ผ่านเอเย่นต์", "ฝาก-ถอนออโต้ ไม่มีขั้นต่ำ", "เดิมพันเริ่มต้นเพียง 1 บาท", "แนะนำเพื่อนรับคอมมิชชั่น 0.8%", "คืนยอดเสีย 0.3% ทุกยอดการเล่น"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นแดงเลือดหมูตามโลโก้ คำหลังเป็นเงินกราไฟต์
// ล้อโลโก้ที่เป็น NEXT55 เทาเข้ม คั่นด้วยลูกศรแดง
const claimChips = [
  { lead: "คาสิโน", tail: "เว็บตรง" },
  { lead: "ไม่มี", tail: "ขั้นต่ำ" },
  { lead: "ฝากถอน", tail: "ออโต้" },
  { lead: "รับทุก", tail: "วอลเลท" },
  { lead: "เริ่มต้น", tail: "1บาท" },
];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#cd1437] bg-[#0c0d10] pt-16 pb-8 font-sans text-[#c3c8d1] shadow-[0_-10px_30px_rgba(205,20,55,0.2)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#cd1437]/12 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#e7eaef]/8 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ NEXT55 ตัวอักษร NEXT55 สีเทาเข้มแบบหนา โดยตัว X ถูกแทนด้วยลูกศรสองหัวสีแดงเข้มที่ชี้เข้าหากัน"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(205,20,55,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black drop-shadow-[0_0_10px_rgba(205,20,55,0.4)]">
                <span class="bg-gradient-to-b from-[#e7eaef] to-[#8d939e] bg-clip-text text-transparent">NE</span>
                <span class="text-[#cd1437]">X</span>
                <span class="bg-gradient-to-b from-[#e7eaef] to-[#8d939e] bg-clip-text text-transparent">T55</span>
              </span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#c3c8d1]">
          NEXT55 คาสิโนออนไลน์เว็บตรงครบวงจร ไม่ผ่านเอเย่นต์ รวมบาคาร่าและคาสิโนสด Full HD สล็อตลิขสิทธิ์แท้ เกมยิงปลา หวยรัฐบาล ลาว ฮานอย และแทงบอลทุกลีกดังไว้ในเว็บเดียว
          เดิมพันเริ่มต้นเพียง 1 บาท ฝาก-ถอนอัตโนมัติภายใน 5 วินาที ไม่มีขั้นต่ำ รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet พร้อมแอดมินดูแลผ่าน Line Official ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#cd1437]/50 bg-[#cd1437]/10 px-3 py-1.5 text-xs font-bold text-[#ffb3bf] shadow-[0_0_10px_rgba(205,20,55,0.22)]">
            <span aria-hidden="true" class="text-base">🛡️</span> เว็บตรง 100%
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#3a3d45] bg-[#22242a]/70 px-3 py-1.5 text-xs font-bold text-[#e7eaef]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffb3bf]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0435f] to-[#7a0a20]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#c3c8d1] transition-all hover:text-[#ffb3bf]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#cd1437] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="สิทธิประโยชน์สำหรับสมาชิก" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffb3bf]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0435f] to-[#7a0a20]"></span> สิทธิประโยชน์
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            privileges.map((item) => (
              <li>
                <a href="/promotion" class="group flex items-start text-[#c3c8d1] transition-all hover:text-[#ffb3bf]">
                  <span aria-hidden="true" class="mt-2 mr-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#8d939e] transition-colors group-hover:bg-[#cd1437] group-hover:shadow-[0_0_8px_rgba(205,20,55,0.8)]" />
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffb3bf]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f0435f] to-[#7a0a20]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @NEXT55
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#cd1437]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#cd1437]/25 py-6 opacity-70 transition-all duration-500 hover:opacity-100 md:gap-8">
      {
        claimChips.map((chip) => (
          <span class="text-lg font-black text-[#cd1437] italic md:text-2xl">
            {chip.lead}
            <span class="text-[#e7eaef]">{chip.tail}</span>
          </span>
        ))
      }
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#8d939e] md:flex-row">
      <p>
        &copy; {new Date().getFullYear()} <span class="font-bold text-[#ffb3bf]">NEXT55</span>. All rights reserved. คาสิโนออนไลน์เว็บตรงครบวงจร ไม่ผ่านเอเย่นต์ เดิมพันเริ่มต้น 1 บาท
        ฝาก-ถอนอัตโนมัติไม่มีขั้นต่ำ รองรับทุกธนาคารและ TrueMoney Wallet แอดมินดูแลผ่าน Line Official ตลอด 24 ชั่วโมง
      </p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffb3bf]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffb3bf]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
</style>
