---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// WIN8S (รอบส้มเพลิงนำ-ทองอำพันรอง บนดำอมเลือดหมู 2026-10-28): footer ที่ใช้
// งานจริงรอบนี้ — รอบก่อน 123BET ใช้ FooterPremiumSumo ซึ่งเป็นแผ่น
// rounded-t-[3rem] ที่มีออราเบลอคร่อมขอบบนและกริด 12 คอลัมน์แบบ 5/3/4 พร้อม
// ย่อหน้าเนื้อความยาวคั่นก่อนบรรทัดลิขสิทธิ์ ส่วนไฟล์นี้เป็นคนละทรง:
// **แผ่นแบน ขอบบนเป็นเส้นหนา 3px ไม่มีการ์ดลอยและไม่มีมุมมน** เนื้อในเป็น
// **กริด 4 คอลัมน์เท่ากัน** และแถบคำโปรยเป็น **ชิปคำคู่ lead/tail**
//
// ⚠️⚠️ **เหตุผลที่เลือกไฟล์นี้**: บรีฟรอบนี้ (content.txt) **ไม่มีหมวดฝากถอน
// ธนาคาร หรือวอลเลทเลยแม้แต่คำเดียว** จึงต้องเลือก footer ที่ **ไม่ import
// BankStrip มาแต่แรก** แทนการถอดด้วยมือ ตัวที่ไม่ import มีสี่ตัว: ไฟล์นี้ ·
// FooterCyber (ของ ZORO365 สองรอบก่อน) · FooterPremiumSumo (ตัวขาออก) ·
// FooterHuay (ธีมหวย ซึ่งรอบนี้ไม่ใช่เว็บหวย) — เหลือไฟล์นี้ตัวเดียวที่ทั้ง
// ไม่ซ้ำรอบก่อน ไม่ใช่ธีมหวย และเป็นคนละทรงกับขาออกจริง
// **BankStrip.astro ยังอยู่ครบในฐานะ inventory ของแบรนด์ถัดไป ห้ามลบไฟล์**
// คอลัมน์ที่สี่จึงเป็น ปุ่ม LINE + บล็อก <address> ซึ่งเป็นช่องทางติดต่อจริงที่
// บรีฟรองรับ (content.txt บรรทัด 21-22)
//
// 🚨🚨 **ไฟล์นี้ค้างชุด "เขียวมรกต-เงินโครเมียม" ของ TEVA69 ไว้ทั้งไฟล์**
// (28c437 1a7d24 116018 15401d 2d6b2f 0b2a12 051409 e8fbe4 b4d6ad c6cfd2 e3bb45
// + rgba 40/196/55 α) rgba 198/207/210 α)) และก่อนหน้านั้นเป็นชุดฟ้าสกาย-น้ำเงิน
// มหาสมุทรของ โบ๊ะบ๊ะ168 (12b4ef b6e3f0 06283f 0b4a73 2a87c4 eaf7ff) กับชุด
// ทองแกน-ครีมอุ่นของ เงินทอง168 (f5ba14 fcee52 b37c0b 1b1407 4d3c15 2e2512 ecd5c4
// d2b9a4) — **ออกครบทุกจุดแล้ว ไม่เหลือเขียว ฟ้า น้ำเงิน หรือครีม**
// ⚠️⚠️ **และแดงชาด/ชมพูบลัชของ 123BET รอบก่อนทันที (a30d1a c21325 8a1420 ef4a5e
// dca53a 7a4a0c d2d7dd 36080f 6b2b33 330710 1c050b 4d0c18 fdf5f6 f7e4e9 f7dfe4
// eec3cc d98fa0) ก็ต้องไม่มีหลุดเข้ามาเช่นกัน** — เจอแดงชาดหรือผิวชมพูที่ไหนใน
// ไฟล์นี้คือหลงเหลือข้ามแบรนด์ ไม่ใช่สีของรอบนี้
// 🚨🚨 **กับดักรอบนี้คือส้มกับทอง** เพราะทองเคยเป็นฮิวนำของ ZNOVA168 (e8a000
// fde90b fa4903 b8300a 7a3a0c) · เงินทอง168 (f5ba14 fcee52 b37c0b) · ยูฟ้า168
// (fee45d e6a416 b8780d) · TEVA69 (e0b03a e3bb45) · LOTTO189 (e9b53c) ·
// 123BET (dca53a) มาแล้ว **"เจอทอง" ไม่พิสูจน์ว่าเป็นของรอบนี้ ต้องเทียบเป็นค่า
// ทีละตัว** กับ .claude/brand-spec-win8s.md §2
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
//
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อน: มืดทั้งเว็บ** (รอบก่อนเนื้อหาสว่าง โครมเข้ม)
// bg.json ของดรอปนี้เป็น {"mode":"color","color":"#1e0101"} = ดำอมเลือดหมู
// ย้ายทั้งไฟล์มาเป็น **พื้นโครม #250604 (ฐาน) / #140302 (จม) / #3b130b (ยก)
// + ส้มเพลิง #f27a1a เป็นแกน (ขอบบน หัวคอลัมน์ ลูกศร ออรา) + เงินโครเมียม #c9d2dc
// เป็นออราใบที่สองและเส้น (ลายเซ็นของตัวอักษรตัวสุดท้ายบนเวิร์ดมาร์ก) + ทองอำพัน
// #e5a92b เป็นกรอบชิปใบที่สอง + หมึก #fdf0e6 (17.0:1) และหมึกรอง #e0bda4 (10.8:1)**
// ⚠️⚠️ **แถบนี้สว่างกว่าพื้นเพจแค่ระดับเดียว** ต่างจากรอบก่อนที่โครมเข้มตัดกับ
// พื้นเพจสว่างชัดเจน สิ่งที่บอกว่า footer เริ่มตรงไหนคือ **เส้นขอบบนหนา 3px
// สีส้มเพลิง** — **ห้ามถอด border-t ออกเด็ดขาด**
// ⚠️ #5a2410 #8a3a12 #3b130b ห้ามถือตัวอักษรในไฟล์นี้ (เป็นพื้น/เส้น/ขอบเท่านั้น)
// ตัวที่ถือตัวอักษรได้บนพื้น #250604: #fdf0e6 (17.0:1) · #c9d2dc (12.4:1) ·
// #e0bda4 (10.8:1) · #e5a92b (9.1:1) · #f27a1a (6.8:1)
// ✅ **ปุ่ม LINE คงเขียว #00B900 + หมึกขาวไว้ตามเดิม** — เป็นสีของแบรนด์ LINE
// ซึ่งเป็นสีเชิงความหมาย **ห้ามกลืนเข้าพาเลตส้มของรอบนี้**
//
// 🚨 WIN8S เป็น **เว็บคาสิโนออนไลน์เน้นบาคาร่า** ไม่ใช่เว็บหวย ไม่ใช่เว็บบอล
// ไม่ใช่เว็บสล็อตล้วน — คำที่รอบก่อน (123BET) เขียนไว้ในไฟล์นี้ไม่ได้
// (เจ้าของบาคาร่าสล็อต / เว็บตรง / ถูกลิขสิทธิ์ / เซิร์ฟแท้ / ปลอดภัยในไทย /
// ครบทุกค่าย / ไม่มีขั้นต่ำ / อัปเดตใหม่ตลอดสัปดาห์ / **ไฮโล รูเล็ต ยิงปลา
// เดิมพันฟุตบอล หวยออนไลน์**) **ไม่มีอยู่ในบรีฟรอบนี้สักคำ** จึงถูกถอดออกทั้งหมด
// ไม่ใช่แก้คำทับประโยคเดิม
// ⚠️⚠️ **บรีฟรอบนี้มีเพียงสามหมวดเกม: บาคาร่าออนไลน์ · เกมคาสิโนสด · เกมสล็อต**
// บรีฟรอบนี้เรียกตัวเองว่า คาสิโนเล่นบาคาร่า ทางเข้าเล่น เกมเดิมพันสด ทุกค่ายดัง
// และพูดถึง ลิขสิทธิ์แท้จากเมกา · เล่นง่าย ไม่หักเปอร์เซ็นต์ · เซิร์ฟนอก ·
// ปลอดภัย100% · โบนัสไม่อั้น · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// สมัคร 3 ขั้นตอน · แอดมิน 24ชม.
// ⚠️ **"เซิร์ฟนอก" กับ "ปลอดภัย100%" กลับทิศจากรอบก่อน** — รอบก่อนห้ามสองคำนี้
// ไว้ในฐานะคำของ TEVA69 แต่รอบนี้เป็นถ้อยคำของบรีฟเอง (บรรทัด 1-2, 5)
// **ห้ามลบออกเพราะอ่านคอมเมนต์เก่าแล้วเข้าใจผิด**
//
// 🚨 — /ตรวจหวย และ /แนวทาง **ยังจอดอยู่ที่ src/pages-disabled/ ตามเดิมรอบนี้**
// (บรีฟไม่มีคำว่าหวยเลยสักคำ) จึงไม่มี route และไม่มีสองบรรทัดนั้นใน quickLinks
// ถ้ารอบหน้าเป็นแบรนด์หวย ต้องย้ายไฟล์กลับมาที่ src/pages/ พร้อมใส่ลิงก์คืน
// ไม่งั้นลิงก์จะเป็น 404 และทำให้ build แดง
//
// /ทางเข้า ยังลิงก์จากตรงนี้: หน้านั้นยัง route และ index อยู่ แค่ไม่มีในเมนู
// navbar เพราะ toggle register/login เปิดอยู่ ทำให้มันกลายเป็นลิงก์ที่สามไปที่เดิม
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// ทุกบรรทัดมาจาก content.txt รอบนี้เท่านั้น (บรรทัด 22 ระบุหัวข้อที่ติดต่อได้ไว้
// ตรงตัว) — อะไรที่เจาะจงกว่านี้ (เลขใบอนุญาต ปีที่ก่อตั้ง จำนวนสมาชิก ยอดฝาก
// ขั้นต่ำ ชื่อค่ายเกม ชื่อธนาคาร) คือการแต่งขึ้นเอง
// ตัวเลขที่อ้างได้รอบนี้มี: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% · ปลอดภัย100% ·
// 3 ขั้นตอน · 24ชม.
const supportTopics = ["ขั้นตอนการสมัครสมาชิกและการเข้าสู่ระบบ", "กติกาบาคาร่าสดและรูปแบบการเดิมพัน", "รายชื่อเกมคาสิโนสดและเกมสล็อตที่เปิดให้บริการ", "เงื่อนไขโปรโมชั่นคืนยอดเสียและแนะนำเพื่อน", "ปัญหาการใช้งานบัญชีและการตรวจสอบรายการ"];

// แถบคำโปรยล่างสุด: คำหน้าเป็นสีเนื้อความ คำหลังเป็นส้มเพลิง ทุกคู่เป็นคำที่บรีฟ
// พูดไว้เอง (content.txt บรรทัด 1-2, 5, 7-12, 21) ไม่มีคำโฆษณาที่บรีฟไม่ได้เขียน
const claimChips = [
  { lead: "คาสิโน", tail: "เล่นบาคาร่า" },
  { lead: "ลิขสิทธิ์แท้", tail: "จากเมกา" },
  { lead: "เล่นง่าย", tail: "ไม่หักเปอร์เซ็นต์" },
  { lead: "เซิร์ฟนอก", tail: "ปลอดภัย100%" },
  { lead: "คืนยอดเสีย", tail: "0.3%" },
  { lead: "แนะนำเพื่อน", tail: "0.8%" },
  { lead: "แอดมิน", tail: "24ชม." },
];

// เขียนจากไฟล์ logo.webp ของดรอป 2026-10-28 จริง (**500x500 จัตุรัส** อ่าน
// ด้วย Read ก่อนเขียน) — เวิร์ดมาร์กเขียวมรกตคู่โครเมียมของ TEVA69 ที่เคยอยู่ใน
// ตัวแปรนี้ไม่มีในรูปรอบนี้เลย และหัวการ์ตูนผู้หญิงหน้าตกใจของ โบ๊ะบ๊ะ168
// (เจ้าของธีมเดิมของไฟล์นี้) ก็ไม่มีเช่นกัน
// ⚠️ โลโก้รอบนี้ **ไม่มีคน ไม่มีชิป ไม่มีมงกุฎบนศีรษะ** แต่ **มีมังกร เสาโทริอิ
// และดาบ** ซึ่งเป็นของจริงในดรอปนี้ — บรรยายตามที่เห็น
// ⚠️⚠️ **อาร์ตเวิร์กพิมพ์ชื่อแบรนด์อีกชื่อไว้บนรูปจริง** alt จึงบรรยายรูปทรงและ
// วัสดุ แล้วอ้างชื่อด้วย ${BRAND_NAME} เท่านั้น **ห้ามพิมพ์ตัวอักษรที่เห็นบนรูป**
const logoAlt = `โลโก้ ${BRAND_NAME} บนพื้นโปร่งใส เป็นตราสัญลักษณ์ทรงกลมผิวหินสีดำแตกลายที่มีเสาโทริอิแบบญี่ปุ่นตั้งอยู่ตรงกลาง มีมังกรตัวยาวเกล็ดเงินพ่นเปลวไฟสีส้มพันรอบ และมีดาบใบตรงประดับตราวงกลมสีทองปักลงกลางภาพ ด้านหน้าเป็นตัวอักษรสามมิติตัวหนาวางเฉียงเล็กน้อย ครึ่งแรกเป็นผิวส้มเพลิงไล่เป็นทองหลอมเหลวตัดขอบดำและมีไฮไลต์ขาววาบตามสัน ครึ่งหลังเป็นผิวโครเมียมเงินขัดเงาไล่จากเงินสว่างลงมาหาเทาเข้ม รอบตราสัญลักษณ์มีกลีบดอกซากุระสีชมพูอ่อนปลิวกระจายและมีประกายไฟสีส้มกระเด็นอยู่ตามขอบ`;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f27a1a] bg-[#250604] pt-16 pb-8 font-sans text-[#fdf0e6] shadow-[0_-10px_30px_rgba(242,122,26,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#f27a1a]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#c9d2dc]/10 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[50, 100, 150]}
                sizes="50px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(242,122,26,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#c9d2dc] to-[#f27a1a] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(242,122,26,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#fdf0e6]">
          {BRAND_NAME} นำเสนอข้อมูลคาสิโนออนไลน์ที่รวบรวมเกมบาคาร่า เกมคาสิโนสด และเกมสล็อตจากค่ายต่าง ๆ พร้อมรายละเอียดระบบสมาชิกและโปรโมชั่นไว้ในเว็บไซต์เดียว ผู้ใช้งานสามารถศึกษากติกาบาคาร่าสด รูปแบบการเดิมพัน และเงื่อนไขของแต่ละเกมผ่านมือถือได้
          โดยเว็บไซต์ระบุว่าให้บริการผ่านระบบเซิร์ฟเวอร์ต่างประเทศ ทั้งนี้ ควรตรวจสอบรายชื่อผู้ให้บริการเกม หลักฐานการได้รับอนุญาต และกติกาการคิดค่าธรรมเนียมให้ชัดเจนก่อนใช้งาน เพราะเกมคาสิโนมีความเสี่ยงและไม่สามารถรับประกันผลรางวัลได้
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f27a1a]/50 bg-[#f27a1a]/10 px-3 py-1.5 text-xs font-bold text-[#e0bda4] shadow-[0_0_10px_rgba(242,122,26,0.25)]">
            <span aria-hidden="true" class="text-base">🃏</span> บาคาร่า คาสิโนสด สล็อต
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#e5a92b] bg-[#3b130b]/80 px-3 py-1.5 text-xs font-bold text-[#fdf0e6]">
            <span aria-hidden="true" class="text-base">⏰</span> เจ้าหน้าที่ 24ชม.
          </div>
        </div>
      </div>

