---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// FAH999 มีสีเดียว (ทองบนดำ) จึงแยกสองคอลัมน์ด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง:
// สันฝั่งซ้ายเป็นทองประกาย #f7e7a8 ลงมาหาทองหลัก #e8c25a ส่วนฝั่งขวาเป็นทองกลาง
// #c49a41 ลงมาหาบรอนซ์เข้ม #6b4a18 ครึ่งซ้ายจึงอ่านสว่างกว่าครึ่งขวาเล็กน้อย
// ทำให้ย่อหน้าสองท่อนของ docx อ่านเป็นคู่ ไม่ใช่แผ่นเดียวแบนๆ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4a18] bg-[#12100b]/92 p-8 text-[#e7dcc4] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8c25a]/70 hover:shadow-[0_15px_40px_rgba(232,194,90,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1c160e]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#e8c25a]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] shadow-[0_0_10px_rgba(232,194,90,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcc4]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#e8c25a]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f7e7a8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e7a8] via-[#e8c25a] to-[#a3732c] shadow-[0_0_10px_rgba(247,231,168,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcc4] md:border-l md:border-[#6b4a18] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#6b4a18] pb-3 text-xl leading-normal font-black tracking-widest text-[#c49a41] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8c25a] via-[#c49a41] to-[#6b4a18] shadow-[0_0_10px_rgba(196,154,65,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
