---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. By default these are the page's own wording for laying one
   *  docx section out side by side — NOT docx sub-headings — so they render as
   *  <p> carrying exactly the classes a heading would. */
  titleleft?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3Three / ContentBox3ThreePremium
   *  so the whole multi-column family takes the same props. Defaults to FALSE,
   *  the value that keeps chrome out of the heading inventory. Pass
   *  heading={true} ONLY when the two labels really ARE the docx's own
   *  sub-headings; they then render at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech on any call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, heading = false, label } = Astro.props;
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// รอบนี้ใบนี้ถือ **docx H2 §2** ("<แบรนด์> ค่ายแท้ถูกลิขสิทธิ์ ฝากถอนยอดเข้า
// บริษัทแม่โดยตรง" — content.txt บรรทัด 5) โดยแบ่งย่อหน้าเดียวของบรีฟ (บรรทัด 6)
// เป็นสองครึ่ง: ซีกซ้ายคือรูปแบบเกมที่บรีฟระบุ (สล็อตคลาสสิก · รอบโบนัส ·
// สัญลักษณ์พิเศษ) ซีกขวาคือประโยคกำกับของบรีฟเอง (ตรวจรายชื่อค่ายผู้พัฒนา
// หลักฐานการอนุญาต ข้อมูลบริษัท ชื่อบัญชีรับเงิน และข้อสรุปว่าคำกล่าวอ้างเรื่อง
// ลิขสิทธิ์แท้/ยอดเข้าบริษัทแม่ยืนยันจากข้อความโฆษณาอย่างเดียวไม่ได้)
// ⚠️ สองคอลัมน์รอบนี้เป็นแค่การหั่นย่อหน้าเดียวให้อ่านง่าย **ไม่ใช่หัวข้อย่อยของ
// บรีฟ** หน้าเพจจึง **ไม่ส่ง titleleft/titleright และไม่ส่ง heading** — ค่าปริยาย
// false คือค่าที่ถูกสำหรับกรณีนี้ และกล่องนี้ปล่อยหัวข้อออกมาใบเดียวจาก `title`
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23, .claude/brand-spec-slot168.md §2) —
// **แดงเจลมันวาวนำ · ขาว/มุกอุ่นเป็นวัสดุที่สอง · บนดำอมแดงเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-อุลตรามารีนบนถ่านอมน้ำเงินของ
// นาซ่า168** ทั้งใบ จึงเปลี่ยนทั้งไฟล์ **รอบนี้เป็นธีมมืดเหมือนกันแต่คนละฮิว
// สิ้นเชิง** พื้นเพจ #140000 (bg.json) = ดำอมแดงเข้มมาก ⚠️ **ห้าม "แก้" การ์ด
// กลับไปเป็นพื้นขาว และห้ามเหลือฟ้า/ไซยานไว้เลยสักค่า**
// ลำดับผิว: **#2a0c0d ยก** · #1c0607 การ์ด · #0b0000 จม · #140000 พื้นเพจ
// การ์ดใบนี้ไล่จาก **ยกลงการ์ด (#2a0c0d → #1c0607)** ซึ่งเป็นผิวที่ยกที่สุดใน
// กลุ่มกล่องมุมมน หมึกเนื้อความ **#f0e6e4** (= BRAND_TEXT, 14.7:1 บนปลายยก ·
// 16.0:1 บนปลายการ์ด)
//
// จังหวะรูปทรงของใบนี้: เป็น **ใบเดียวของหน้าที่หัวข้อเป็นไล่เฉด "สองสต็อป จัด
// กึ่งกลาง" บนเส้นคาดเต็มความกว้าง และไม่มีแถบตั้งนำหน้า** (§1 แผ่นถมทึบหมึกขาว ·
// §3 ไล่สามสต็อปชิดซ้าย+แถบตั้ง · §4 ทึบชิดซ้าย+ขีดสั้น · §5 ชิปถมคู่กลีฟ ·
// §6 คร่อมเส้นคู่ · §7 สันซ้ายสี่พิกเซล · §8 ทึบกึ่งกลาง+ขีดจาง) และเป็นใบเดียว
// ที่ **คอลัมน์แยกกันด้วยเส้นคั่นกลางเปล่า ๆ ไม่มีกรอบของตัวเอง**
// หัวข้อไล่ **แพลทินัม #e3d6d4 → แดงเจล #fb2e33** (สองสต็อป)
// ⚠️ ไล่เฉดถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 — บนปลายผิวที่สว่างที่สุดของการ์ด (#2a0c0d): #e3d6d4 13.4:1 และ
// #fb2e33 4.8:1 ✓ **ห้ามเอา #cb0b0d (1.9:1) #8a0608 #7d6f6e #551c1e หรือค่าผิวใด
// มาเป็นสต็อป**
// สองคอลัมน์แยกกันด้วยทิศของแถบ ไม่ใช่ด้วยความสว่างของสีเดียว: ฝั่งซ้ายแถบไล่
// **แดงเจล #fb2e33 → แดงลึก #cb0b0d** ป้ายเป็นแดงเจล ฝั่งขวาแถบไล่กลับทาง
// **แดงลึกสุด #8a0608 → แดงเจล #fb2e33** ป้ายเป็นแพลทินัม #e3d6d4 —
// ป้ายทั้งสองไม่ถูก render รอบนี้ แต่ต้องถือพาเลตปัจจุบันไว้ให้แบรนด์ถัดไป
// ⚠️ แถบตั้งและออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาตให้ #cb0b0d /
// #8a0608 ไปอยู่ตรงนั้นได้ แต่ **ห้ามให้มันถือตัวอักษรหรือเป็นพื้นของตัวอักษร**
// กรอบการ์ดเป็น #551c1e เข้มขึ้นเป็นแดงเจลตอน hover ชั้นออรามุมบนซ้ายเป็นแดงเจล
// จาง มุมขวาล่างเป็นแดงลึกสุด
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(227,214,212,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
// ⚠️ **#fb2e33 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์แดงจริง และ
// รีโปนี้มีแดงของแบรนด์อื่นอยู่สิบกว่าชุด** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้คือ **#fb2e33 / #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (**นาซ่า168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd94a e3a712 9d6f06 b07d08 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16
//   3d3425 f3ece0 bfb8aa (**รวย168 — แบรนด์ขาออกรอบนี้ เสี่ยงที่สุด** ⚠️ 1c1a16
//   ห่างจากผิวการ์ดรอบนี้ 1c0607 แค่ G/B) ·
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (มาดาม168) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B — ⚠️ สองค่าแรกห่างจากค่าของรอบนี้
//   หนึ่งก้าว **เจอแล้วแปลว่าพิมพ์ผิด**) · b3121b 5a0a0e f2bba5 c98a74 (ขวัญใจ168) ·
//   c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef (รวยแท้168) · eb0305 e40303 c20305
//   9b0a0c ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) · d9212a 8e1a16
//   (ดวงเศรษฐี168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) ·
//   d30304 a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) · ff3b14 6d0804
//   2b0000 (FLASH877)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น**
// (มงกุฎทองเล็กในโลโก้เป็นรายละเอียด ~2% ของอาร์ตเวิร์ก และทองคือฮิวนำของ
// แบรนด์ขาออกพอดี — **ห้ามดึงเข้ามาเป็นสี UI**)
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#551c1e] bg-gradient-to-b from-[#2a0c0d] to-[#1c0607] p-8 text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-500 hover:border-[#fb2e33]/80 hover:shadow-[0_15px_40px_rgba(251,46,51,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fb2e33]/18 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8a0608]/40 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#551c1e] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#e3d6d4] to-[#fb2e33] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4]">
        {
          titleleft && (
            <LabelTag class={`${columnLabel} border-[#551c1e] text-[#fb2e33]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb2e33] to-[#cb0b0d] shadow-[0_0_10px_rgba(251,46,51,0.5)]" />
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4] md:border-l md:border-[#551c1e]/80 md:pl-10">
        {
          titleright && (
            <LabelTag class={`${columnLabel} border-[#551c1e] text-[#e3d6d4]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8a0608] to-[#fb2e33] shadow-[0_0_10px_rgba(138,6,8,0.6)]" />
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
