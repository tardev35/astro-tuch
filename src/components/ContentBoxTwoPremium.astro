---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// The two columns are deliberately keyed to the two halves of the MEPAY77
// wordmark: the left spine/heading runs gold, the right one runs brushed
// silver, so a two-paragraph docx section reads as a pair rather than as one
// flat gold slab.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5c3a08]/70 bg-[#1b1206]/92 p-8 text-[#f1e5cd] shadow-[0_10px_30px_rgba(19,12,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2ae35]/70 hover:shadow-[0_15px_40px_rgba(242,174,53,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#241503]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#5c3a08]/75 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdcc5c] via-[#dfe3e8] to-[#a3701c] shadow-[0_0_10px_rgba(253,204,92,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdcc5c] via-[#fff6e0] to-[#dfe3e8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e5cd]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#5c3a08]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdcc5c] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] via-[#f2ae35] to-[#5c3a08] shadow-[0_0_10px_rgba(242,174,53,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e5cd] md:border-l md:border-[#5c3a08] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#5c3a08]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#dfe3e8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe3e8] via-[#aab0b8] to-[#5c3a08] shadow-[0_0_10px_rgba(223,227,232,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
