---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// GUCCI168 homepage this box carries docx H2 #6 (สมัคร 3 ขั้นตอน คาสิโนไม่จำกัดยอด):
// the brief's two paragraphs for that section run one per column, so the block
// emits exactly one docx heading.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้วบนหมวกของเทพเจ้าโชคลาภในโลโก้ (เขียวมรกตคาดแถบแดง)
// จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว — สันฝั่งซ้ายเป็นฝั่งแดง ไล่แดง
// สว่าง #e0201f → แดงแบรนด์ #c41115 → แดงลึก #7a0505 ป้ายใช้แดงสว่าง ส่วนสันฝั่งขวา
// เป็นฝั่งเขียว ไล่เขียวสว่าง #2bbf63 → เขียวมรกต #0b7a33 → เขียวลึก #063f1c ป้ายใช้
// เขียวสว่าง ทั้งสองป้ายวางบนผิวการ์ด #140705 ไม่ได้อยู่บนพื้นสี (ถ้าเป็นพื้นเขียวสว่าง
// #2bbf63 ห้ามใช้ตัวอักษรขาวเด็ดขาดตาม §3 — ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่เขียวสว่าง #2bbf63 → แดงสว่าง #e0201f → ทองอ่อน #ffdf91 ซึ่งเป็นลำดับ
// คนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นทองแบรนด์ #d9a521 โปร่ง (ต่างจากกรอบแดง
// ของ ContentBoxPremium และกรอบเขียวลึกของ ContentBoxSevenThreePremium) เส้นคั่นกลาง
// เป็นเขียวลึก #063f1c เนื้อความ #f6e3cf (= BRAND_TEXT) glow เป็น rgba(217,165,33,…)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #04ab3a #036b26
// #9fb8aa #07170f #0b231b #041109 #f3c44a #ffffff #cfe9d7 rgba(66,251,90,…)
// rgba(218,220,220,…)) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d9a521]/35 bg-[#140705]/93 p-8 text-[#f6e3cf] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9a521]/70 hover:shadow-[0_15px_40px_rgba(217,165,33,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7a0505]/45 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0b7a33]/22 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#d9a521]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf91] via-[#d9a521] to-[#8c6410] shadow-[0_0_10px_rgba(217,165,33,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#2bbf63] via-[#e0201f] to-[#ffdf91] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#c41115]/45 text-[#e0201f]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] shadow-[0_0_10px_rgba(196,17,21,0.65)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf] md:border-l md:border-[#063f1c] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#0b7a33]/45 text-[#2bbf63]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2bbf63] via-[#0b7a33] to-[#063f1c] shadow-[0_0_10px_rgba(11,122,51,0.6)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
