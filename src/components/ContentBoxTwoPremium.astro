---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// BOOM369 homepage this box carries docx H2 #6 (สมัคร 3 ขั้นตอน): the brief's two
// paragraphs for that section run one per column, so the block emits exactly one
// docx heading.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): แบรนด์รอบนี้มีคู่
// วัสดุจริงอยู่แล้ว (คำว่า BOOM เป็นเขียวนีออนติดกับตัวเลข 369 เงินแปรงในโลโก้เดียวกัน)
// จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว — สันฝั่งซ้ายเป็นฝั่งเขียว ไล่
// เขียวนีออน #42fb5a → เขียวแบรนด์ #04ab3a → เขียวลึก #036b26 ป้ายใช้เขียวนีออน
// ส่วนสันฝั่งขวาเป็นฝั่งเงิน ไล่ขาว #ffffff → เงินโครเมียม #dadcdc → เขียวหม่น #9fb8aa
// ป้ายใช้ #dadcdc ทั้งสองป้ายวางบนผิวการ์ด #07170f ไม่ได้อยู่บนพื้นสี (ถ้าเป็นพื้น
// เขียวนีออนต้องใช้หมึก #03150a เสมอ — ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ทอง #f3c44a → เงินโครเมียม #dadcdc → เขียวนีออน #42fb5a ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นเงินโครเมียมโปร่ง เส้นคั่นกลาง
// เป็นเขียวลึก #036b26 เนื้อความ #cfe9d7 (= BRAND_TEXT) glow เป็น rgba(66,251,90,…)
//
// ชุดแดงแบรนด์ + เงินโครเมียมของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#dc0409 #f5363d
// #8e0206 #4b0205 #17080c #0d0407 #eef0f4 #c3c7d1 #8d93a1 #f3c54e #edeaf0
// rgba(220,4,9,…) rgba(195,199,209,…)) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#dadcdc]/30 bg-[#07170f]/93 p-8 text-[#cfe9d7] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#42fb5a]/60 hover:shadow-[0_15px_40px_rgba(66,251,90,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#036b26]/40 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#dadcdc]/14 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#dadcdc]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f3c44a] via-[#dadcdc] to-[#42fb5a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#42fb5a]/40 text-[#42fb5a]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe9d7] md:border-l md:border-[#036b26] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#dadcdc]/25 text-[#dadcdc]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffffff] via-[#dadcdc] to-[#9fb8aa] shadow-[0_0_10px_rgba(218,220,220,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
