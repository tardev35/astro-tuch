---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fdd32d]/30 bg-[#1c0707]/92 p-8 text-[#f7e4dc] shadow-[0_10px_30px_rgba(13,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32d]/55 hover:shadow-[0_15px_40px_rgba(253,211,45,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#8e0c0a]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#a97a08]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fdd32d] to-[#8e0c0a] shadow-[0_0_10px_rgba(253,211,45,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdd32d] via-[#ffe98a] to-[#f5322e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#a97a08]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdd32d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fdd32d] to-[#8e0c0a] shadow-[0_0_10px_rgba(253,211,45,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc] md:border-l md:border-[#8e0c0a] md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#a97a08]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdd32d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fdd32d] to-[#8e0c0a] shadow-[0_0_10px_rgba(253,211,45,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
