---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// หวย365 homepage this box carries docx H2 #2: the brief's two paragraphs run
// one per column, so the block emits exactly one docx heading.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02): โลโก้เป็นเวิร์ดมาร์กแดงสด #dc0203 ล้วน คำว่า "หวย"
// กับเลข 6 เป็นแดง เลข 3 กับ 5 เป็นดำ บนงานอาร์ตผ้าซาตินแดงที่มีลายไทยทอง #ffc93c
// เหรียญทอง และลูกหวยแดง-ขาว สองครึ่งของกล่องจึงแยกกันด้วยคู่ทอง/แดงนั้น — สันฝั่งซ้าย
// ไล่ทองอ่อน #ffeab0 → ทอง #ffc93c → ทองลึก #c08a07 ส่วนสันฝั่งขวาไล่แดงสว่าง #f5282a
// → แดงแบรนด์ #dc0203 → แดงลึก #9c0201 ป้ายฝั่งซ้ายเป็นทองอ่อน ส่วนป้ายฝั่งขวาใช้สี
// เนื้อความ #f6e7e0 ไม่ใช่แดงสว่าง เพราะแดงสว่างบนผิวการ์ด #240406 ได้คอนทราสต์ไม่พอ
// สำหรับป้ายที่ต้องอ่านเป็นข้อความ — แดงของฝั่งขวาจึงเดินผ่านสันและเส้นคั่นที่เป็นของ
// ประดับแทน เนื้อความ #f6e7e0 (BRAND_TEXT) — ชุดแดง-ทองของ หวยเฮง24/หวยเฮง789
// (#e0a52a #fdea83 #bd7c13 #8b0302 #c01616 #5a0202 #2e0707 #1a0505 #720202 #f6e6cf
// #dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#9c0201] bg-[#240406]/92 p-8 text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/60 hover:shadow-[0_15px_40px_rgba(255,201,60,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#dc0203]/30 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#ffc93c]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#ffc93c]/40 text-[#ffeab0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0] md:border-l md:border-[#9c0201] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#f5282a]/60 text-[#f6e7e0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5282a] via-[#dc0203] to-[#9c0201] shadow-[0_0_10px_rgba(245,40,42,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
