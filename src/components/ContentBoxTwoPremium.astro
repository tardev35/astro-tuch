---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// WIN999 homepage this box carries docx H2 #2: the brief's two paragraphs run
// one per column, so the block emits exactly one docx heading.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): เวิร์ดมาร์กแบรนด์นี้เขียน WIN เป็นทองสด #fcc403 แล้ว
// ปิดด้วย 999 สีขาว สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ สันฝั่งซ้ายไล่จากทองสว่าง
// #fdda04 ลงทองแบรนด์ #fcc403 ไปหาทองลึก #8a6502 ส่วนฝั่งขวาไล่จากขาวไฮไลต์ #fffbea
// ลงขาวนวล #e9e4d6 ไปหาทองลึกเดียวกัน ป้ายฝั่งซ้ายเป็นทองสว่าง ฝั่งขวาเป็นขาวนวล บนผิว
// การ์ด #101010 เหนือพื้นเพจ #050505 เนื้อความ #e9e4d6 (BRAND_TEXT) — ชุดชมพูนีออน-
// ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #b01573 #8b3df3 #ddc3ff #c9a4ff #4a0e33
// #170a22 #08020d #f2dcee) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a3402] bg-[#101010]/92 p-8 text-[#e9e4d6] shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcc403]/60 hover:shadow-[0_15px_40px_rgba(252,196,3,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#8a6502]/24 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#fcc403]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdda04] via-[#fcc403] to-[#8a6502] shadow-[0_0_10px_rgba(252,196,3,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdda04] via-[#fcc403] to-[#8a6502] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#fcc403]/40 text-[#fdda04]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdda04] via-[#fcc403] to-[#8a6502] shadow-[0_0_10px_rgba(252,196,3,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6] md:border-l md:border-[#4a3402] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#8a6502]/50 text-[#e9e4d6]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fffbea] via-[#e9e4d6] to-[#8a6502] shadow-[0_0_10px_rgba(233,228,214,0.4)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
