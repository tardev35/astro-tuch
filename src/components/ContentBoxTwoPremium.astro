---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead. On the UWIN33 homepage
// this box is passed `title` alone — the left column is the docx's intro
// paragraph and the right column is its numbered 3-step <ol>, neither of which
// has a label in the brief — so it emits exactly one docx heading.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): โลโก้แบรนด์นี้เขียนตัว U เป็นทองนูน คำว่า
// WIN เป็นเงินโครเมียม แล้วเลข 33 กลับมาเป็นทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่สี
// นั้นจริงๆ สันฝั่งซ้ายไล่จากทองสว่าง #fbd564 ลงทองแบรนด์ #e0b429 ไปหาทองลึก
// #7a5407 ส่วนฝั่งขวาไล่จากเงินโครเมียม #dfe4ec ลงเงินหม่น #a6adb9 ไปหาทองลึก
// หัวข้อฝั่งซ้ายเป็นทองสว่าง ฝั่งขวาเป็นเงินโครเมียม บนพื้นการ์ด #161106 เหนือพื้น
// เพจ #080602 เนื้อความ #ece6d8 (BRAND_TEXT) — ชุดแดง-เงินโครเมียมของ UFAGOOL
// (#c50d12 #ef1f25 #7a0103 #241a1a #b8c3cf #f4f7fa #5c6672 #cdd5dd) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7a5407] bg-[#161106]/92 p-8 text-[#ece6d8] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfe4ec]/60 hover:shadow-[0_15px_40px_rgba(223,228,236,0.2)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#e0b429]/22 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#dfe4ec]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbd564] via-[#e0b429] to-[#7a5407] shadow-[0_0_10px_rgba(224,180,41,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#e0b429]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fbd564] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbd564] via-[#e0b429] to-[#7a5407] shadow-[0_0_10px_rgba(251,213,100,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8] md:border-l md:border-[#7a5407] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#dfe4ec]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#dfe4ec] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dfe4ec] via-[#a6adb9] to-[#7a5407] shadow-[0_0_10px_rgba(223,228,236,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
