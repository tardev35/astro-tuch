---
export interface Props {
  /** The section's own docx heading, when this box carries one. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. By default these are the page's own wording for laying one
   *  docx section out side by side — NOT docx sub-headings — so they render as
   *  <p> carrying exactly the classes a heading would. */
  titleleft?: string;
  titleright?: string;
  /** Opt-in escape hatch, mirroring ContentBox3Three / ContentBox3ThreePremium
   *  so the whole multi-column family takes the same props. Defaults to FALSE,
   *  the value that keeps chrome out of the heading inventory. Pass
   *  heading={true} ONLY when the two labels really ARE the docx's own
   *  sub-headings; they then render at `as`. */
  heading?: boolean;
  /** Names the <section> for assistive tech on any call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, heading = false, label } = Astro.props;
const LabelTag = heading ? HeadingTag : "p";
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// รอบนี้ใบนี้ถือ **docx H2 §3** ("โปรโมชั่นสมาชิก <แบรนด์> กดรับได้ไม่จำกัด" —
// content.txt บรรทัด 7) โดยแบ่งย่อหน้าเดียวของบรีฟ (บรรทัด 8) เป็นสองครึ่ง
// ⚠️ สองคอลัมน์รอบนี้เป็นแค่การหั่นย่อหน้าเดียวให้อ่านง่าย **ไม่ใช่หัวข้อย่อยของ
// บรีฟ** หน้าเพจจึง **ไม่ส่ง titleleft/titleright และไม่ส่ง heading** — ค่าปริยาย
// false คือค่าที่ถูกสำหรับกรณีนี้ และกล่องนี้ปล่อยหัวข้อออกมาใบเดียวจาก `title`
// หัวข้อมาจาก prop เท่านั้น — ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้
// ⚠️ §3 เป็น H2 แม่ของ H3 สองตัวที่ตามมา (§4 คืนยอดเสีย 0.3% และ §5 แนะนำเพื่อน
// 0.8%) — บรีฟรอบนี้มีโครง H1 → H2 → H3 จริง จึงไม่ flatten เป็น H2 ล้วน
//
// ───────────────────────────────────────────────────────────────────────────
// นาซ่า168 (ดรอป 2026-10-23, .claude/brand-spec-naza168.md §2) —
// **ฟ้าไซยานนำ · น้ำเงินอุลตรามารีนเป็นวัสดุที่สอง · บนถ่านเกือบดำอมน้ำเงิน**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกาย-ทองคานารี บนผิวขาว ธีมสว่าง ของ
// สบาย168** ทั้งใบ จึงเปลี่ยนทั้งไฟล์ **รอบนี้เป็นธีมมืด** พื้นเพจ #0d1017
// (bg.json) การ์ดเนื้อหาเป็น **ผิวมืด + หมึกสว่าง** ⚠️ **ห้าม "แก้" การ์ดกลับไป
// เป็นพื้นขาวเพราะไฟล์เคยเป็นแบบนั้น และห้ามลอกทิศของรอบก่อน (ร่ำรวย168) ซึ่ง
// เป็นธีมสว่างเหมือนกัน** — bg.json คือแหล่งเดียวของทิศ และรอบนี้มันมืด
// ลำดับผิว: **#273449 ยก** · #1b2434 กลาง · #121722 จม · #0d1017 พื้นเพจ
// การ์ดใบนี้ไล่จาก **ยกลงกลาง (#273449 → #1b2434)** ซึ่งเป็นผิวที่ยกที่สุดในกลุ่ม
// กล่องมุมมน หมึกเนื้อความ **#e6edf8** (= BRAND_TEXT, 10.7:1 บนปลายยก ·
// 13.2:1 บนปลายกลาง)
//
// จังหวะรูปทรงของใบนี้: เป็น **ใบเดียวของหน้าที่หัวข้อเป็นไล่เฉด "สองสต็อป จัด
// กึ่งกลาง" บนเส้นใต้เต็มความกว้าง และไม่มีแถบตั้งนำหน้า** (§1 ทึบกึ่งกลางไม่มีไล่
// · §2 ไล่สามสต็อปชิดซ้าย+แถบตั้ง · §4 ไล่สองสต็อปชิดซ้ายไม่มีแถบ · §5 ทึบชิดซ้าย
// +แถบตั้ง · §6 ป้ายลอยพื้นถม · §7 ไล่สามสต็อปกึ่งกลาง · §8 ไล่สามสต็อปในรางซ้าย)
// และเป็นใบเดียวที่ **คอลัมน์แยกกันด้วยเส้นคั่นกลางเปล่า ๆ ไม่มีกรอบของตัวเอง**
// หัวข้อไล่ **น้ำแข็ง #8fd9ec → ไซยาน #1fd8f0** (สองสต็อป)
// ⚠️ ไล่เฉดถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 — บนปลายผิวที่สว่างที่สุดของการ์ด (#273449): #8fd9ec 8.0:1 และ
// #1fd8f0 7.3:1 ✓ **ห้ามเอา #1d4fd8 (1.9:1) #143aa0 (1.3:1) #33455f หรือค่าผิวใด
// มาเป็นสต็อป**
// สองคอลัมน์แยกกันด้วยทิศของแถบ ไม่ใช่ด้วยความสว่างของสีเดียว: ฝั่งซ้ายแถบไล่
// **ไซยาน #1fd8f0 → ฟ้าลึก #0bb6d4** ป้ายเป็นไซยาน (7.3:1) ฝั่งขวาแถบไล่กลับทาง
// **อุลตรามารีน #1d4fd8 → ไซยาน #1fd8f0** ป้ายเป็นน้ำแข็ง #8fd9ec (8.0:1) —
// ป้ายทั้งสองไม่ถูก render รอบนี้ แต่ต้องถือพาเลตปัจจุบันไว้ให้แบรนด์ถัดไป
// ⚠️ แถบตั้งและออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาตให้อุลตรามารีน
// #1d4fd8 ไปอยู่ตรงนั้นได้ แต่ **ห้ามให้มันถือตัวอักษรหรือเป็นพื้นของตัวอักษร**
// กรอบการ์ดเป็น #33455f เข้มขึ้นเป็นไซยานตอน hover ชั้นไล่พื้นบาง ๆ มุมบนซ้าย
// เป็นไซยานจาง และออรามุมขวาล่างเป็นอุลตรามารีน
// rgba() ที่อนุญาตรอบนี้: rgba(31,216,240,α) · rgba(29,79,216,α) ·
// rgba(143,217,236,α) · rgba(11,182,212,α) · rgba(13,16,23,α) · rgba(0,0,0,α)
// ⚠️ **#1fd8f0 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ฟ้า/ไซยานเคยนำมาแล้วหกแบรนด์
// ในรีโปนี้** (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911 ·
// ร่ำรวย168) **"มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย** ไซยานรอบนี้คือ
// **#1fd8f0 (R31 G216 B240)** และอุลตรามารีนคือ **#1d4fd8 (R29 G79 B216)**
// ⚠️⚠️ **ร่ำรวย168 คือแบรนด์ขาออก ฟ้านำเหมือนกัน และเป็นธีมสว่างเหมือนที่ไฟล์นี้
// เพิ่งเป็น = เสี่ยงหลงเหลือสูงสุดทั้งค่าและทิศ**: 18a5e2 0d6b9b 0a5176 a9d7f2
// 16294a dbe6ff eef4ff dce9fb f4e4d3 e4cbb3 111a3f 202a66 31408a e9f1ff adc0e4 ·
// rgba(24,165,226,…) rgba(13,107,155,…) rgba(244,228,211,…) rgba(22,41,74,…)
// ชุด **ฟ้าสกาย-ทองคานารีธีมสว่าง ของ สบาย168** ที่เพิ่งอยู่ในไฟล์นี้ทั้งใบออกครบ
// ทุกค่าแล้ว: 2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504
// ffffff f2fbff dff4fd ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74 06293c ·
// ⚠️ 2cc3fc ห่างจาก #1fd8f0 ที่ R13/G21/B12 เท่านั้น **ต้อง grep เป็นค่า**
// ⚠️⚠️ **นินจา168 เป็นเจ้าของธีมเดิมของ NavbarCyber และเป็นไซยานเหมือนกัน**
// (32bcfb a9e9ff fef54b 07335f dceefc 071a28 030e16 041019 0c2a3d 6b5c10) —
// 32bcfb ห่างจาก #1fd8f0 ที่ R19/G24/B11
// ⚠️⚠️ **NAZA168 ตัวละตินเป็นลูกค้าคนละเจ้าที่ชื่อซ้ำกับรอบนี้** ธีมทองอวกาศ-
// โครเมียม **ห้ามกลับเข้ามาเด็ดขาด**: fbc134 ffe87a cf9a18 96690a d9c9a6 cfd6e3
// 241700 1a1000 432b03 231500
// ชุดอื่นที่เคยผ่านไฟล์นี้และถอดออกครบแล้ว: **เงินทอง168** (f5ba14 fcee52 b37c0b
// ecd5c4 d2b9a4 29210f 3d3016 332810 201906 2e2512 1b1407 4d3c15) · **รวยแท้168**
// (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f 461212 280b0b ffeee8 fff1ef
// ffdbdb) · **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472
// 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) · **โปรดี168** (eb0305 9b0a0c
// ff4446 b44c06 7a2f03 f0b46a 401107 fff4ea ffd1d1) · **สาธุ168** (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c d8ffc7 e9fbdd) · **มีทรัพย์168** (dd1b74 a4186b 4a0d35
// 2d0720 f7dcf6 f0ccf5) · **ufalion168** (d4922c fdfc71 a25b24 8c4312 d39c45
// f6e3b4 33200a 1f1304 0a0601 5a3310 1a1000) · **ถอนชัวร์168** (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 fdeaf5) · **KMD88** (7505cc b453ff
// c07cff d9b8ff 3a0565 2c0349 ece2f8) · **TSDET911** (0360f3 0292fb 6ec8ff 4fb4ff
// cfdcec 9db4d4 dde8f7) · **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b e3f2fc
// 0b2d52 f9a826 704504) · **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff
// ffc82e 5c4a16)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** — ทองในอาร์ตเวิร์ก (เลข 168 ของโลโก้)
// เป็นวัตถุในภาพ ไม่ใช่สี UI · **ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีเขียว
// ไม่มีบรอนซ์ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน** (e8ecf1 a8b2bf 78828f 5a6472
// cfd9e6 fdfcfd b4bcc2 eceaea ต้องไม่เหลือที่นี่)
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#33455f] bg-gradient-to-b from-[#273449] to-[#1b2434] p-8 text-[#e6edf8] shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-500 hover:border-[#1fd8f0]/80 hover:shadow-[0_15px_40px_rgba(31,216,240,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#1fd8f0]/18 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1d4fd8]/30 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 border-b border-[#33455f] pb-4">
          <HeadingTag class="bg-gradient-to-r from-[#8fd9ec] to-[#1fd8f0] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6edf8]">
        {
          titleleft && (
            <LabelTag class={`${columnLabel} border-[#33455f] text-[#1fd8f0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#1fd8f0] to-[#0bb6d4] shadow-[0_0_10px_rgba(31,216,240,0.5)]" />
              {titleleft}
            </LabelTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6edf8] md:border-l md:border-[#33455f]/80 md:pl-10">
        {
          titleright && (
            <LabelTag class={`${columnLabel} border-[#33455f] text-[#8fd9ec]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#1d4fd8] to-[#1fd8f0] shadow-[0_0_10px_rgba(29,79,216,0.55)]" />
              {titleright}
            </LabelTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
