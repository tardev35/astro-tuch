---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// NAZA99 homepage this box carries docx H2 #2: the brief's four paragraphs run
// two per column, so the block emits exactly one docx heading.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): โลโก้เป็นตัวอักษรทองเมทัลลิกล้วน (#e4b34d นำ รองด้วย
// #fdf2ac) บนงานอาร์ตฉากทองอร่ามบนพื้นดำอมน้ำตาล #140c02 แบรนด์นี้ไม่มีสีคู่ตรงข้าม
// สองครึ่งของกล่องจึงแยกกันด้วย "ระดับความสว่างของทอง" ไม่ใช่ฮิวที่สอง — สันฝั่งซ้ายไล่
// แชมเปญ #fdf2ac → ทองแบรนด์ #e4b34d → ทองเข้ม #c08f2b เป็นฝั่งสว่าง ส่วนสันฝั่งขวาไล่
// ทองแบรนด์ #e4b34d → ทองเข้ม #c08f2b → ทองลึก #8a5f12 เป็นฝั่งเข้ม ป้ายฝั่งซ้ายเป็น
// แชมเปญ #fdf2ac ส่วนป้ายฝั่งขวาใช้สีเนื้อความ #f3e8cf เพราะทองลึกบนผิวการ์ด #241404
// ได้คอนทราสต์ไม่พอสำหรับป้ายที่ต้องอ่านเป็นข้อความ — ทองเข้มของฝั่งขวาจึงเดินผ่านสัน
// และเส้นคั่นที่เป็นของประดับแทน เนื้อความ #f3e8cf (BRAND_TEXT) — ชุดแดงสด-ทองของ
// หวย365/หวยเฮง789 (#dc0203 #f5282a #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #dc2224 #f4bc5d #ffefc2 #fbe3d4 #2b0909) ออกครบทุกจุด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a5f12] bg-[#241404]/92 p-8 text-[#f3e8cf] shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4b34d]/60 hover:shadow-[0_15px_40px_rgba(228,179,77,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#c08f2b]/26 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#e4b34d]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] shadow-[0_0_10px_rgba(228,179,77,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#e4b34d]/40 text-[#fdf2ac]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] shadow-[0_0_10px_rgba(228,179,77,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf] md:border-l md:border-[#8a5f12] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c08f2b]/60 text-[#f3e8cf]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e4b34d] via-[#c08f2b] to-[#8a5f12] shadow-[0_0_10px_rgba(192,143,43,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
