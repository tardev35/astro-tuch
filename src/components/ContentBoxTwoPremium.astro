---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// The two columns are deliberately keyed to the two halves of the SUPERMAX168
// wordmark: the left spine/heading runs gold, the right one runs brushed
// silver, so a two-paragraph docx section reads as a pair rather than as one
// flat gold slab.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ba8219]/60 bg-[#0d0904]/92 p-8 text-[#f3e6c8] shadow-[0_10px_30px_rgba(3,2,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ecc964]/70 hover:shadow-[0_15px_40px_rgba(236,201,100,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1b140b]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#ba8219]/55 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9e38b] via-[#e3e3e4] to-[#ba8219] shadow-[0_0_10px_rgba(249,227,139,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f9e38b] via-[#fff8e2] to-[#e3e3e4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#ba8219]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#f9e38b] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff8e2] via-[#ecc964] to-[#ba8219] shadow-[0_0_10px_rgba(236,201,100,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8] md:border-l md:border-[#ba8219]/45 md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#ba8219]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#e3e3e4] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e3e3e4] via-[#d2a43b] to-[#ba8219] shadow-[0_0_10px_rgba(227,227,228,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
