---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// หวยดีใจ homepage this box carries docx H2 #6 (สมัคร 3 ขั้นตอน): the brief's two
// paragraphs for that section run one per column, so the block emits exactly one
// docx heading.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04): brand-spec §2
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้ว (แดงเมทัลลิกของคำว่า "ดีใจ" กับเงินโครเมียมของคำว่า
// "หวย" ในโลโก้เดียวกัน) จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว —
// สันฝั่งซ้ายเป็นฝั่งแดง ไล่แดงสว่าง #f5363d → แดงแบรนด์ #dc0409 → แดงลึก #8e0206
// ป้ายใช้แดงสว่าง #f5363d ส่วนสันฝั่งขวาเป็นฝั่งเงิน ไล่เงินสว่าง #eef0f4 →
// เงินกลาง #c3c7d1 → เงินหม่น #8d93a1 ป้ายใช้ #c3c7d1 ทั้งสองป้ายวางบนผิวการ์ด
// #17080c ไม่ได้อยู่บนพื้นสี (พื้นเงินสว่างต้องใช้หมึก #0d0407 เสมอ — ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ทอง #f3c54e → แดงสว่าง #f5363d → เงินกลาง #c3c7d1 ซึ่งเป็นลำดับ
// คนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นเงินกลาง #c3c7d1 เส้นคั่นกลางเป็น
// แดงดำ #4b0205 เนื้อความ #edeaf0 (= BRAND_TEXT) glow เป็น rgba(220,4,9,…)
//
// ชุดทองโลหะ + ครีมอมพีชของ หวยคิง ที่เคยค้างในไฟล์นี้ (#cd9a2c #fdeb7c #ab7314
// #fcd4c3 #fce2d4 #1c140b #5c3f12 #120a02 #f5e7c8 rgba(205,154,44,…)
// rgba(252,212,195,…)) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c3c7d1]/35 bg-[#17080c]/93 p-8 text-[#edeaf0] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#eef0f4]/60 hover:shadow-[0_15px_40px_rgba(220,4,9,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#4b0205]/40 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c3c7d1]/16 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#c3c7d1]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5363d] via-[#dc0409] to-[#8e0206] shadow-[0_0_10px_rgba(220,4,9,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f3c54e] via-[#f5363d] to-[#c3c7d1] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#edeaf0]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#dc0409]/45 text-[#f5363d]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5363d] via-[#dc0409] to-[#8e0206] shadow-[0_0_10px_rgba(220,4,9,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#edeaf0] md:border-l md:border-[#4b0205] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c3c7d1]/30 text-[#c3c7d1]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef0f4] via-[#c3c7d1] to-[#8d93a1] shadow-[0_0_10px_rgba(195,199,209,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
