---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels never emit HeadingTag — that would put this page's own
// layout wording into the h2/h3 inventory that gets diffed against the docx.
// They are <p> with the same size, weight, tracking and colour a heading would
// carry. รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §7** (ช่องทางติดต่อแอดมิน … ทาง LINE
// OFFICIAL 24ชม. — content.txt บรรทัด 22): บรีฟเขียนย่อหน้าเดียวยาว หน้าแรกจึงรัน
// ครึ่งย่อหน้าลงคอลัมน์ละครึ่ง บล็อกนี้ปล่อยหัวข้อ docx ออกมาตัวเดียว และไม่มีสล็อต
// ไหนได้รับ element สองตัว **ไม่มีการส่งป้ายคอลัมน์มา** เพราะบรีฟไม่ได้ให้ §7
// มีหัวข้อย่อยของตัวเอง
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// แบรนด์มีสองโทนจริงอยู่บนโลโก้: คำว่า "ถอน" เป็นตัวอักษรไทยสามมิติ **สีทองเนย**
// ตัดขอบชมพู ต่อด้วย "ชัวร์168" **สีชมพูบับเบิลกัม** ตัดขอบทอง ล้อมด้วยหัวใจชมพู
// และประกายดาวทอง สองคอลัมน์จึงแยกด้วยคู่โทนนั้นตรงๆ ไม่ใช่ด้วยระดับความสว่างของ
// สีเดียว: สันฝั่งซ้ายเป็น **ฝั่งชมพู** ไล่ชมพูอ่อน #ffb3de → ชมพูบับเบิลกัม
// #fa63b9 → พลัมเข้ม #6d0b3f ป้ายใช้ชมพูบับเบิลกัม (§2 ระบุว่าถือตัวอักษรได้ 6.6:1
// และเป็น text-xl font-black จึงเป็น large text) ส่วนสันฝั่งขวาเป็น **ฝั่งทอง**
// ไล่ทองเนย #ffd84d → ทองลึก #6b4708 ป้ายใช้ทองเนย (12.7:1)
// ⚠️ **ชมพูมาก่อนทอง** ตามลำดับนำของรอบนี้ ซึ่งกลับทางจากรอบก่อน (มีโชค168 ทองนำ)
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #2b0f20 ยก / #1a0914 กลาง /
// #0d040a จม / #000000 พื้น การ์ดใบนี้วางที่ **ผิวกลาง #1a0914** ซึ่งอยู่ระหว่าง
// ผิวยกของ §6 ที่อยู่เหนือมัน กับผิวจมของ Faq ที่ปิดท้ายหน้า
// หัวข้อ docx ไล่ ชมพูอ่อน #ffb3de → ทองเนย #ffd84d → ชมพูบับเบิลกัม #fa63b9 ซึ่ง
// เป็นลำดับคนละชุดกับกล่อง docx ใบอื่นในหน้า ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (10.7 / 12.7 / 6.6) —
// ห้ามเอา #6d0b3f (1.5:1) หรือ #6b4708 (2.1:1) มาเป็นสต็อป
// กรอบเป็นทองลึก #6b4708 โปร่ง สว่างขึ้นเป็นชมพูบับเบิลกัมตอน hover เส้นคั่นกลางเป็น
// พลัมเข้ม #6d0b3f เนื้อความ #fdeaf5 (= BRAND_TEXT) — 15.3:1 บนผิวกลาง
// glow rgba ใช้ได้สี่ชุดตาม §2 ไฟล์นี้ใช้ rgba(250,99,185,α) และ rgba(255,216,77,α)
// §2 ห้าม #6d0b3f #6b4708 ถือตัวอักษร — ที่นี่อยู่ที่กรอบ ปลายไล่เฉดของสัน ออรา
// และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ชมพู และ ทอง**
// เพราะรอบที่แล้ว (มีโชค168) ก็เป็นทอง+ชมพูบนดำเหมือนกันทุกบทบาท "มีชมพูอยู่แล้ว"
// หรือ "มีทองอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย ชุดที่เพิ่งอยู่ในไฟล์นี้คือรับตัง168
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09
// 140505 1a0505) ก่อนหน้านั้นสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706) TKB55 (fb131b ff8a8f
// ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a) ชุดม่วง
// ราชา-ทองของ KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f ffdf8c
// ece2f8) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4
// dde8f7 102a5e) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffd94a
// f0c3dc fde7f2 8a0a45 4a1038) และชุดทองมังกรของ TND168 (dfa310 ffc93d ffe4a3
// c9b88e f0e9dc 8a5c09 43240b) ออกครบทุกจุดแล้ว
// ⚠️ ชมพูรอบนี้คือ **#fa63b9 / #ffb3de** ไม่ใช่ f5469f / ff8dc6 ของมีโชค168 (รอบก่อน
// หน้าทันที — ตระกูลชมพูเดียวกันคนละค่า) และไม่ใช่ f41571 / ff5ca8 ของ PUNPRO168
// ⚠️ ทองรอบนี้คือ **#ffd84d** ไม่ใช่ fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429
// (รับตัง168) e3b23c (สมหวัง168) dfa310 e5a81b e2b33f หรือ fad354
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด** — cfd9e6 e9eef4 aeb9c6 cfdcec 9db4d4 ต้องไม่เหลือที่นี่
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4708]/80 bg-[#1a0914]/94 p-8 text-[#fdeaf5] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fa63b9]/80 hover:shadow-[0_15px_40px_rgba(250,99,185,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#6d0b3f]/60 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fa63b9]/18 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#6b4708]/70 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3de] via-[#fa63b9] to-[#6d0b3f] shadow-[0_0_10px_rgba(250,99,185,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffb3de] via-[#ffd84d] to-[#fa63b9] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#fa63b9]/60 text-[#fa63b9]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3de] via-[#fa63b9] to-[#6d0b3f] shadow-[0_0_10px_rgba(250,99,185,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdeaf5] md:border-l md:border-[#6d0b3f] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#6b4708]/80 text-[#ffd84d]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd84d] to-[#6b4708] shadow-[0_0_10px_rgba(255,216,77,0.7)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
