---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// The two columns are keyed to the two halves of the TTN69 logo: the left
// spine/heading runs emerald (the mountain's shaded ridge), the right one runs
// chrome-white (the snow cap over the TTN wordmark), so a two-paragraph docx
// section reads as a pair rather than as one flat slab.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#046b3a]/60 bg-[#061309]/92 p-8 text-[#d5e6da] shadow-[0_10px_30px_rgba(2,8,5,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#02b961]/70 hover:shadow-[0_15px_40px_rgba(2,185,97,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0c2214]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#046b3a]/55 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ce68f] via-[#e4ece7] to-[#046b3a] shadow-[0_0_10px_rgba(76,230,143,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#4ce68f] via-[#f1faf4] to-[#e4ece7] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6da]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#046b3a]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#4ce68f] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c9f7dd] via-[#02b961] to-[#046b3a] shadow-[0_0_10px_rgba(2,185,97,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e6da] md:border-l md:border-[#046b3a]/45 md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#046b3a]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#e4ece7] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e4ece7] via-[#02b961] to-[#046b3a] shadow-[0_0_10px_rgba(228,236,231,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
