---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// BRAVO168 homepage this box carries docx H2 #2: the brief's two paragraphs run
// one per column, so the block emits exactly one docx heading.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): เวิร์ดมาร์กแบรนด์นี้เขียน BRAVO เป็นโครเมียม
// ไล่น้ำเงินรอยัล #1558c4 แล้วปิดด้วยเลข 168 ทองตัน #f4cb69 สองครึ่งของกล่องจึงแยกกัน
// ด้วยคู่สีนั้นจริงๆ สันฝั่งซ้ายไล่จากทองอ่อน #ffe39a ลงทองแบรนด์ #f4cb69 ไปหาทองลึก
// #c9922e ตามเลข 168 ส่วนฝั่งขวาไล่จากฟ้าสว่าง #2f86f0 ลงน้ำเงินรอยัล #1558c4 ไปหา
// น้ำเงินเส้น #0e3f8f ตามคำว่า BRAVO ป้ายฝั่งซ้ายเป็นทองอ่อน ฝั่งขวาเป็นฟ้าสว่าง บนผิว
// การ์ด #04142f เหนือพื้นเพจ #02081a เนื้อความ #dbe5f5 (BRAND_TEXT) — ชุดทอง-แดง
// เลือดหมูของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622 #7b0304 #4c0301 #160b06
// #0a0503 #ece0cb) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0e3f8f] bg-[#04142f]/92 p-8 text-[#dbe5f5] shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f4cb69]/60 hover:shadow-[0_15px_40px_rgba(244,203,105,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1558c4]/28 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#f4cb69]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe39a] via-[#f4cb69] to-[#c9922e] shadow-[0_0_10px_rgba(244,203,105,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#f4cb69]/40 text-[#ffe39a]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe39a] via-[#f4cb69] to-[#c9922e] shadow-[0_0_10px_rgba(244,203,105,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5] md:border-l md:border-[#0e3f8f] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#1558c4]/70 text-[#2f86f0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2f86f0] via-[#1558c4] to-[#0e3f8f] shadow-[0_0_10px_rgba(21,88,196,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
