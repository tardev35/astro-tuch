---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// HENG35 มีสีเดียว (ทองบนดำ) จึงแยกสองคอลัมน์ด้วยความสว่าง ไม่ใช่ด้วยสีที่สอง:
// สันฝั่งซ้ายเป็นทองสว่าง #fefac4 ลงมาหาทองหลัก #ecc55c ส่วนฝั่งขวาเป็นทองอ่อน
// #ffdf8a ลงมาหาบรอนซ์เข้ม #5e4418 ครึ่งซ้ายจึงอ่านสว่างกว่าครึ่งขวาเล็กน้อย
// ทำให้ย่อหน้าสองท่อนของ docx อ่านเป็นคู่ ไม่ใช่แผ่นเดียวแบนๆ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5e4418] bg-[#12100b]/92 p-8 text-[#ece1cb] shadow-[0_10px_30px_rgba(7,6,5,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ecc55c]/70 hover:shadow-[0_15px_40px_rgba(236,197,92,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1c1710]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#ecc55c]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fefac4] via-[#ecc55c] to-[#a3732c] shadow-[0_0_10px_rgba(236,197,92,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#ecc55c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fefac4] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fefac4] via-[#ecc55c] to-[#a3732c] shadow-[0_0_10px_rgba(254,250,196,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb] md:border-l md:border-[#5e4418] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#5e4418] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdf8a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf8a] via-[#a3732c] to-[#5e4418] shadow-[0_0_10px_rgba(163,115,44,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
