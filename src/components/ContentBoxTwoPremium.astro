---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// SEXYGAME666 homepage this box carries docx H2 #6: the left column is the
// brief's intro paragraph and the right column its numbered 3-step <ol>, so the
// block emits exactly one docx heading.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): เวิร์ดมาร์กแบรนด์นี้เขียน SEXY เป็น
// ชมพูบานเย็น GAME ไล่ไปเป็นม่วง แล้ว 666 กลับมาเป็นชมพู สองครึ่งของกล่องจึงแยกกันด้วย
// คู่สีนั้นจริงๆ สันฝั่งซ้ายไล่จากชมพูอ่อน #ffb3e2 ลงชมพูแบรนด์ #fa42b5 ไปหาชมพูลึก
// #4a0e33 ส่วนฝั่งขวาไล่จากม่วงอ่อน #ddc3ff ลงม่วงแบรนด์ #8b3df3 ไปหาชมพูลึก ป้ายฝั่ง
// ซ้ายเป็นชมพูอ่อน ฝั่งขวาเป็นม่วงอ่อน #c9a4ff บนผิวการ์ด #170a22 เหนือพื้นเพจ #08020d
// เนื้อความ #f2dcee (BRAND_TEXT) — ชุดทองเมทัลลิก-โครเมียมของ PKG44 (#fdd32a
// #ffe27a #c8920a #c2c8d0 #f2f4f7 #8a9099 #4a3a12 #12100a #efe6d2) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a0e33] bg-[#170a22]/92 p-8 text-[#f2dcee] shadow-[0_10px_30px_rgba(8,2,13,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#8b3df3]/60 hover:shadow-[0_15px_40px_rgba(139,61,243,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#b01573]/24 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#8b3df3]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3e2] via-[#fa42b5] to-[#4a0e33] shadow-[0_0_10px_rgba(250,66,181,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#fa42b5]/40 text-[#ffb3e2]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3e2] via-[#fa42b5] to-[#4a0e33] shadow-[0_0_10px_rgba(250,66,181,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee] md:border-l md:border-[#4a0e33] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#8b3df3]/35 text-[#c9a4ff]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ddc3ff] via-[#8b3df3] to-[#4a0e33] shadow-[0_0_10px_rgba(139,61,243,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
