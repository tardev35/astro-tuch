---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// หวยเฮง24 homepage this box carries docx H2 #2: the brief's two paragraphs run
// one per column, so the block emits exactly one docx heading.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): เวิร์ดมาร์กแบรนด์นี้เขียน "หวย" เป็นแดงเลือดนก
// เงาวาวขอบทอง แล้วปิดด้วย "เฮง24" ทองไล่เฉด สองครึ่งของกล่องจึงแยกกันด้วยคู่สีนั้นจริงๆ
// สันฝั่งซ้ายไล่จากทองอ่อน #fdea83 ลงทองแบรนด์ #e0a52a ไปหาทองกลาง #bd7c13 ตาม
// "เฮง24" ส่วนสันฝั่งขวาไล่จากแดงสว่าง #c01616 ลงแดงแบรนด์ #8b0302 ไปหาแดงลึก
// #5a0202 ตามคำว่า "หวย" ป้ายฝั่งซ้ายเป็นทองอ่อน ส่วนป้ายฝั่งขวาเป็นสีเนื้อความ #f6e6cf
// ไม่ใช่แดงสว่าง เพราะแดงสว่างบนผิวการ์ด #2e0707 ได้คอนทราสต์แค่ ~2.9:1 ซึ่งตกเกณฑ์
// ตัวอักษรใหญ่ — แดงของฝั่งขวาจึงเดินผ่านสันและเส้นคั่นที่เป็นของประดับแทน บนผิวการ์ด
// #2e0707 เหนือพื้นเพจ #1a0505 เนื้อความ #f6e6cf (BRAND_TEXT) — ชุดน้ำเงินรอยัล-ทอง
// ของ BRAVO168 (#1558c4 #0e3f8f #2f86f0 #f4cb69 #ffe39a #c9922e #04142f #02081a
// #dbe5f5) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#720202] bg-[#2e0707]/92 p-8 text-[#f6e6cf] shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a52a]/60 hover:shadow-[0_15px_40px_rgba(224,165,42,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#8b0302]/30 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#e0a52a]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#bd7c13] shadow-[0_0_10px_rgba(224,165,42,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#e0a52a]/40 text-[#fdea83]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#bd7c13] shadow-[0_0_10px_rgba(224,165,42,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf] md:border-l md:border-[#720202] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c01616]/60 text-[#f6e6cf]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c01616] via-[#8b0302] to-[#5a0202] shadow-[0_0_10px_rgba(192,22,22,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
