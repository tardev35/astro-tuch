---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// The two columns are keyed to the two halves of the NEXT55 logo: the left
// spine/heading runs crimson (the interlocking arrows that replace the X), the
// right one runs brushed silver (the graphite wordmark), so a two-paragraph docx
// section reads as a pair rather than as one flat slab.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3a3d45] bg-[#17181c]/92 p-8 text-[#d5dae2] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#cd1437]/70 hover:shadow-[0_15px_40px_rgba(205,20,55,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#22242a]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#cd1437]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#f0435f] to-[#7a0a20] shadow-[0_0_10px_rgba(205,20,55,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffb3bf] via-[#e7eaef] to-[#f0435f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#cd1437]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#f0435f] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3bf] via-[#cd1437] to-[#7a0a20] shadow-[0_0_10px_rgba(205,20,55,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2] md:border-l md:border-[#3a3d45] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#3a3d45] pb-3 text-xl leading-normal font-black tracking-widest text-[#e7eaef] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e7eaef] via-[#c3c8d1] to-[#8d939e] shadow-[0_0_10px_rgba(231,234,239,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
