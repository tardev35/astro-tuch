---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels never emit HeadingTag — that would put this page's own
// layout wording into the h2/h3 inventory that gets diffed against the docx.
// They are <p> with the same size, weight, tracking and colour a heading would
// carry. On this brand's homepage the box carries docx H2 §2
// (KMD88 คาสิโนรวมเกม บาคาร่า สล็อต บอล ครบวงจร): the brief's two paragraphs for
// that section run one per column, so the block emits exactly one docx heading
// and no slot receives two siblings.
//
// KMD88 (รอบม่วงราชา-ทอง 2026-10-13, brand-spec §2): แบรนด์มีคู่สีจริงอยู่บนโลโก้ —
// คำว่า KMD เป็นตัวอักษรสามมิติ **ม่วงขัดเงาขอบทอง** และเลข 88 เป็น **ทองเมทัลลิก**
// สองคอลัมน์จึงแยกด้วยคู่ฮิวนั้นตรงๆ ไม่ใช่ด้วยระดับความสว่างของม่วงเดียว: สันฝั่งซ้าย
// เป็นฝั่งม่วง ไล่ม่วงสว่าง #b453ff → ม่วงแบรนด์ #7505cc → ม่วงลึก #3a0565 ป้ายใช้
// ม่วงตัวอักษร #c07cff (§2 ระบุว่าเป็นม่วงที่ถือตัวอักษรได้ 5.3:1) ส่วนสันฝั่งขวาเป็น
// ฝั่งทอง ไล่ทองสว่าง #ffdf8c → ทองแบรนด์ #e2b33f → ทองลึก #7a5a0a ป้ายใช้ทองแบรนด์
// #e2b33f (8.1:1) ทั้งสองป้ายวางบนผิวการ์ด ไม่ได้อยู่บนพื้นถมสี (ถ้าเป็นพื้นถมทอง
// ต้องพลิกไปใช้หมึก #1a0526 ตาม §2 — ที่นี่ไม่มีพื้นถม)
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท** (bg.json = {"mode":"color","color":"#000000"}) จึงไม่มี
// ชั้นไหนจมต่ำกว่าพื้นได้ ผิวจม #0a0213 คือก้นสุด การ์ดใบนี้วางที่ผิวกลาง #140522
// ซึ่งอยู่ระหว่างผิวยก #1d0832 ของ ContentBoxCyberCut ที่อยู่เหนือมันบนหน้าเดียวกัน
// กับผิวจม #0a0213 ของ Faq3 ที่ปิดท้าย
// หัวข้อ docx ไล่ทองแบรนด์ #e2b33f → ม่วงอ่อน #d9b8ff → ม่วงตัวอักษร #c07cff ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด docx ใบอื่นในหน้า กรอบเป็นม่วงลึก #3a0565 โปร่ง สว่างขึ้นเป็น
// ม่วงแบรนด์ #7505cc ตอน hover เส้นคั่นกลางเป็นม่วงลึกสุด #2c0349
// เนื้อความ #ece2f8 (= BRAND_TEXT) — 14.1:1 บนผิวกลาง
// glow มีสองชุดเท่านั้นตาม §2: rgba(117,5,204,…) และ rgba(226,179,63,…)
// §2 ห้าม #7505cc #b453ff #3a0565 #2c0349 #7a5a0a ถือตัวอักษร — ที่นี่อยู่ที่กรอบ
// ปลายไล่เฉดของสัน ออรา และเส้นคั่น และ #ffd45e ถูกสงวนให้ <strong> ในย่อหน้าเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — เก้าในสิบสองแบรนด์หลังสุดมีทอง และ
// WEPLAY168 กับ BPLAY639 ก็เป็นแบรนด์ม่วงมาก่อน ซึ่งเป็น false friend ที่ใกล้ที่สุด:
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#f41571 #ff5ca8 #fce343
// #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426 #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014
// #ffc554) ชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09
// #43240b #140d02 #1b1307 #120c04 #070502) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324
// #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9 #8792a0 #bb8410) ชุดชมพู
// ฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a
// #7a0046 #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มอำพันของ
// DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203
// #f6ecd9 #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #3f4859 #fdf3df
// #d9c9a6 #4e3406 #432b03 #382400 #241700) และชุดแดงเสือโคร่ง-ทองถ่านไฟ (#e8232a
// #f2b705 #ffd666 #c08a0b #fbe8d5) ออกครบทุกจุดแล้ว
// ⚠️ ม่วงของ WEPLAY168 คือ #a435f0 / #d2a6ff / #c9b2e8 และของ BPLAY639 คือ #7e22ce /
// #c4b5fd / #ddd6fe ซึ่ง **ไม่ใช่** ม่วงของรอบนี้ (#7505cc / #b453ff / #c07cff /
// #d9b8ff) และทอง #f5c53d #fce343 #fbe455 ก็ไม่ใช่ #e2b33f — "มีม่วงอยู่แล้ว" และ
// "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย ต้องเทียบทีละค่า
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3a0565]/70 bg-[#140522]/94 p-8 text-[#ece2f8] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#7505cc]/80 hover:shadow-[0_15px_40px_rgba(117,5,204,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2c0349]/60 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e2b33f]/16 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#3a0565]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#b453ff] via-[#7505cc] to-[#3a0565] shadow-[0_0_10px_rgba(117,5,204,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e2b33f] via-[#d9b8ff] to-[#c07cff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2f8]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#3a0565]/70 text-[#c07cff]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#b453ff] via-[#7505cc] to-[#3a0565] shadow-[0_0_10px_rgba(117,5,204,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2f8] md:border-l md:border-[#2c0349] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#e2b33f]/40 text-[#e2b33f]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf8c] via-[#e2b33f] to-[#7a5a0a] shadow-[0_0_10px_rgba(226,179,63,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
