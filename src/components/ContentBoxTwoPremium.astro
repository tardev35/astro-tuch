---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On this
// brand's homepage the box carries docx H2 #2 (PUNPRO168 เว็บเล่นสล็อตออนไลน์
// เว็บคนนิยมเล่นมายาวนาน): the brief's two paragraphs for that section run one
// per column, so the block emits exactly one docx heading and no slot receives
// two siblings.
//
// รอบนี้ (2026-10-12, brand-spec §2): พาเลตต์ชมพูฮอตพิงก์-ทอง บนพลัมเข้มอมม่วง
// แบรนด์มีคู่สีจริงอยู่บนโลโก้ — คำว่า PUNPRO เป็นตัวหนาสามมิติ **ชมพูบานเย็น** และ
// เลข 168 เป็นตัวหนาสามมิติ **ทองสว่าง** จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่าง
// ของชมพูเดียว: สันฝั่งซ้ายเป็นฝั่งชมพู ไล่ชมพูสว่าง #ff5ca8 → ชมพูบานเย็น #f41571 →
// ชมพูลึก #8a0a45 ป้ายใช้ชมพูบานเย็น (4.3:1 บนผิวกลาง — เป็นตัวอักษร text-xl
// font-black จึงเข้าเกณฑ์ตัวอักษรขนาดใหญ่) ส่วนสันฝั่งขวาเป็นฝั่งทอง ไล่ทองสว่าง
// #fce343 → ทองอำพัน #ffc554 → ชมพูลึก #8a0a45 ป้ายใช้ทองสว่าง #fce343 (12.1:1)
// ทั้งสองป้ายวางบนผิวการ์ด #3a0a2a ไม่ได้อยู่บนพื้นสี (ถ้าเป็นพื้นชมพูหรือพื้นทองทึบ
// ต้องพลิกไปใช้หมึก #2a0012 ตาม §2 — ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ทองสว่าง #fce343 → ชมพูบานเย็น #f41571 → ชมพูสว่าง #ff5ca8 ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด docx ใบอื่นในหน้า กรอบเป็นชมพูลึก #8a0a45 โปร่ง (ต่างจากกรอบ
// ชมพูแบรนด์ของ ContentBoxFloatingBadge และกรอบชมพูลึกทึบของ
// ContentBoxSevenThreePremium) เส้นคั่นกลางเป็นชมพูลึกสุด #4a0426
// ⚠️ ผิวการ์ดเป็นผิวกลาง #3a0a2a ซึ่งสว่างกว่าพื้นเพจ #2e0022 การ์ดจึงลอยขึ้น และ
// รอบนี้ยังมีชั้นที่ลึกกว่าพื้นได้จริง (#1c0014) ต่างจากรอบก่อนที่พื้นเป็นดำสนิท
// เนื้อความ #fde7f2 (= BRAND_TEXT) — 14.2:1 บนผิวกลาง
// glow เป็น rgba(244,21,113,…) และ rgba(252,227,67,…)
// §2 ห้าม #8a0a45 / #4a0426 ถือตัวอักษร — ที่นี่อยู่ที่กรอบ ปลายไล่เฉดของสัน และเส้นคั่น
// #ffd94a ถูกสงวนให้ <strong> ในย่อหน้าเท่านั้น จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — แปดในสิบแบรนด์หลังสุดมีทอง และ FAH999 กับ
// PIGPG ก็เป็นแบรนด์ชมพูมาก่อน: ชุดทองอำพันเสือของ TIGERWIN369 ที่เคยค้างในไฟล์นี้
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206
// #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a
// #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9 #8792a0 #bb8410)
// ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08
// #b3006a #7a0046 #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-
// ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a
// #a3510c #1a1203 #f6ecd9 #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียม
// ของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb
// #3f4859 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดแดงเสือโคร่ง-ทองถ่านไฟ
// (#e8232a #f2b705 #ffd666 #c08a0b #fbe8d5) และชุดม่วงนีออน-ทอง (#a435f0 #fbe455
// #ffd23d #c98a05 #5b1a75 #1e0a3c) ออกครบทุกจุดแล้ว
// ⚠️ ชมพูของ FAH999 คือ #ff3fa4 / #ff6cbb / #ffd1ea ซึ่ง **ไม่ใช่** ชมพูของรอบนี้
// (#f41571 / #ff5ca8) และทอง #f5c53d ก็ไม่ใช่ #fce343 — "มีชมพูอยู่แล้ว" และ
// "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a0a45]/55 bg-[#3a0a2a]/94 p-8 text-[#fde7f2] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#f41571]/70 hover:shadow-[0_15px_40px_rgba(244,21,113,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#4a0426]/55 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fce343]/18 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#8a0a45]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fce343] via-[#f41571] to-[#8a0a45] shadow-[0_0_10px_rgba(244,21,113,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fce343] via-[#f41571] to-[#ff5ca8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#8a0a45]/50 text-[#f41571]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5ca8] via-[#f41571] to-[#8a0a45] shadow-[0_0_10px_rgba(244,21,113,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2] md:border-l md:border-[#4a0426] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#fce343]/40 text-[#fce343]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fce343] via-[#ffc554] to-[#8a0a45] shadow-[0_0_10px_rgba(252,227,67,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
