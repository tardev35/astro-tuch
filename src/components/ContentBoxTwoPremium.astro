---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// HENG38 (รอบมรกต-ทอง 2026-09-22): แบรนด์นี้มีสองสีจริง — มรกตเข้มกับทอง — สอง
// คอลัมน์จึงแยกกันด้วยคู่สีนั้น ไม่ใช่ด้วยความสว่างอย่างรอบก่อน สันฝั่งซ้ายไล่จาก
// ทองอ่อน #fbeeb0 ลงทองหลัก #f3cf63 ไปหาทองบรอนซ์ #a5761a ส่วนฝั่งขวาไล่จาก
// มรกตสว่าง #1faa4e ลงมรกตสด #15833c ไปหามรกตกลาง #0f4423 หัวข้อฝั่งซ้ายเป็น
// ทองอ่อน ฝั่งขวาเป็นทองเข้ม #e0b23c บนพื้นการ์ด #061f0f — ครึ่งซ้ายจึงอ่านเป็น
// ท่อนเล่าเรื่อง ครึ่งขวาเป็นท่อนขั้นตอน ชุดดำ-ทองของรอบก่อนหายไปทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0f4423] bg-[#061f0f]/92 p-8 text-[#e6e2d2] shadow-[0_10px_30px_rgba(3,20,10,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3cf63]/70 hover:shadow-[0_15px_40px_rgba(243,207,99,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0a2d16]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#f3cf63]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] shadow-[0_0_10px_rgba(243,207,99,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6e2d2]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#f3cf63]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fbeeb0] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeeb0] via-[#f3cf63] to-[#a5761a] shadow-[0_0_10px_rgba(251,238,176,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6e2d2] md:border-l md:border-[#0f4423] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#0f4423] pb-3 text-xl leading-normal font-black tracking-widest text-[#e0b23c] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#1faa4e] via-[#15833c] to-[#0f4423] shadow-[0_0_10px_rgba(21,131,60,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
