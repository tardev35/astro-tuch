---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#62ae2d]/35 bg-[#0d1408]/92 p-8 text-[#dbe5d3] shadow-[0_10px_30px_rgba(4,8,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#62ae2d]/60 hover:shadow-[0_15px_40px_rgba(98,174,45,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2f6a0c]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#3f6b23]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f0dca0] via-[#d9b95c] to-[#2f6a0c] shadow-[0_0_10px_rgba(217,185,92,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f2f8ec] via-[#8fd45e] to-[#d9b95c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5d3]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#3f6b23]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#8fd45e] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] shadow-[0_0_10px_rgba(98,174,45,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5d3] md:border-l md:border-[#2f6a0c] md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#3f6b23]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#d9b95c] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f0dca0] via-[#d9b95c] to-[#8a6320] shadow-[0_0_10px_rgba(217,185,92,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
