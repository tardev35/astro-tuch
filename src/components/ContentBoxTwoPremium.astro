---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels never emit HeadingTag — that would put this page's own
// layout wording into the h2/h3 inventory that gets diffed against the docx.
// They are <p> with the same size, weight, tracking and colour a heading would
// carry. รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §3** (โปรโมชั่น <แบรนด์> รับได้ไม่จำกัด
// — content.txt บรรทัด 8): บรีฟเขียนย่อหน้าเดียวยาว หน้าแรกจึงรันครึ่งย่อหน้าลง
// คอลัมน์ละครึ่ง บล็อกนี้ปล่อยหัวข้อ docx ออกมาตัวเดียว และไม่มีสล็อตไหนได้รับ
// element สองตัว **ไม่มีการส่งป้ายคอลัมน์มา** เพราะบรีฟไม่ได้ให้ §3 มีหัวข้อย่อย
// ของตัวเอง (โค้ดของป้ายยังคงไว้ให้แบรนด์ถัดไป)
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20) — พาเลตต์ตาม .claude/brand-spec-ruaythep168.md §2
// แบรนด์มีสองโทนจริงอยู่บนโลโก้: คำว่า **"รวย"** เป็นตัวอักษรไทยสามมิติ **สีทองไล่
// เฉด** ต่อด้วย **"เทพ"** **สีขาวมุกตัดขอบเทา** และ **"168"** **สีแดงชาดผิวมันวาว**
// ข้างๆ เป็นเทพเจ้าแห่งโชคลาภจีนสวมหมวกปีกทองแต่งแดง บนริ้วทองล้อมประกายดาวทอง
// สองคอลัมน์จึงแยกด้วยคู่โทนนั้นตรงๆ ไม่ใช่ด้วยระดับความสว่างของสีเดียว: สันฝั่งซ้าย
// เป็น **ฝั่งทอง** ไล่ครีมทอง #ffeccb → ทองแบรนด์ #f0bb4e → ทองแดง #d9701a ป้ายใช้
// ทองแบรนด์ (10.4:1 บนผิวกลาง) ส่วนสันฝั่งขวาเป็น **ฝั่งแดง** ไล่แดงชาด #e4021b →
// บรอนซ์ลึก #5c2a06 ป้ายใช้ครีมทอง (15.9:1)
// ⚠️ **ทองมาก่อนแดง** ตามลำดับนำของรอบนี้ และ ⚠️ **แดงชาดอยู่บนสันซึ่งเป็น "พื้นถม"
// ไม่ใช่ตัวอักษร** — §2 วัดแดงไว้ที่ 3.2–4.3:1 ทุกผิว จึงห้ามถือตัวอักษรเด็ดขาด
// นี่คือเหตุผลที่ป้ายฝั่งขวาเป็นครีม ไม่ใช่แดง ทั้งที่สันของมันเป็นแดง
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #3b1b0e ยก / #260d04 กลาง /
// #0d0501 จม / #000000 พื้น การ์ดใบนี้วางที่ **ผิวกลาง #260d04** ซึ่งอยู่ระหว่าง
// ผิวยกของ §4-§5 ที่ตามมา กับผิวจมของ Faq ที่ปิดท้ายหน้า
// หัวข้อ docx ไล่ ครีมทอง #ffeccb → ทองแดง #d9701a → ทองแบรนด์ #f0bb4e ซึ่งเป็น
// ลำดับคนละชุดกับกล่อง docx ใบอื่นในหน้า ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (15.9 / 5.5 / 10.4 บนผิว
// กลาง) — ห้ามเอา #e4021b (3.8:1 ที่นี่) หรือ #5c2a06 มาเป็นสต็อป
// กรอบเป็นบรอนซ์ลึก #5c2a06 สว่างขึ้นเป็นทองแบรนด์ตอน hover เส้นคั่นกลางเป็น
// บรอนซ์ลึก #5c2a06 เนื้อความ #fff8ec (= BRAND_TEXT) — 17.4:1 บนผิวกลาง
// glow rgba ใช้ได้สี่ชุดตาม §2 ไฟล์นี้ใช้ rgba(240,187,78,α) และ rgba(228,2,27,α)
// §2 ห้าม #e4021b #5c2a06 ถือตัวอักษร — ที่นี่อยู่ที่กรอบ ปลายไล่เฉดของสัน ออรา
// และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ และแดงนำ
// มาแล้วสี่แบรนด์** "มีทองอยู่แล้ว" หรือ "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// ⚠️ ทองรอบนี้คือ **#f0bb4e / #ffeccb / #d9701a / #5c2a06** (R240 G187 B78 —
// ทองน้ำผึ้ง) ⚠️ **R ตรงกับ f0b429 ของรับตัง168 เป๊ะ ตัวตัดสินคือ B78 vs B41**
// และไม่ใช่ fcd45c ของมีเฮ168 รอบก่อน (G212 vs G187) ไม่ใช่ f9a826 704504 ของ
// รวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ทั้งชุด ไม่ใช่ fef54b (นินจา168) ffc82e
// (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) e3b23c
// (สมหวัง168) e2b33f dfa310 e5a81b fad354 f5c518 หรือ fce343
// ⚠️ แดงรอบนี้คือ **#e4021b** (R228 G2 B27) ไม่ใช่ fb1b32 ff8f9c 5c0410 ของมีเฮ168
// ไม่ใช่ fa0513 ff5a5f ffadaf ของสมหวัง168 ซึ่งอยู่ห่างกันแค่นิดเดียว ไม่ใช่ d30304
// ff6b6e (รับตัง168) b3121b (ขวัญใจ168) fb131b (TKB55) หรือ fb141b (GT66B)
// ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (039cfa c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba 3/156/250 และ rgba
// 249/168/38) ชุดของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f
// 6b4708 2a0617 fdeaf5) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202
// 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706)
// ชุดของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304
// c40304 8a0206 53050a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff d9b8ff
// 3a0565 2c0349 7a5a0a e2b33f ffdf8c ece2f8) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3
// 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e) ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 (f41571 ff5ca8 fce343 ffd94a f0c3dc fde7f2 8a0a45 4a1038) และชุดทอง
// มังกรของ TND168 (dfa310 ffc93d ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** — fdeaf5 cfd9e6 e9eef4
// aeb9c6 cfdcec 9db4d4 ต้องไม่เหลือที่นี่ ส้มตัวเดียวที่อนุญาตคือทองแดง #d9701a
// ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5c2a06] bg-[#260d04]/94 p-8 text-[#fff8ec] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0bb4e]/80 hover:shadow-[0_15px_40px_rgba(240,187,78,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5c2a06]/60 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e4021b]/20 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#5c2a06] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeccb] via-[#f0bb4e] to-[#e4021b] shadow-[0_0_10px_rgba(240,187,78,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeccb] via-[#d9701a] to-[#f0bb4e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#f0bb4e]/60 text-[#f0bb4e]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeccb] via-[#f0bb4e] to-[#d9701a] shadow-[0_0_10px_rgba(240,187,78,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec] md:border-l md:border-[#5c2a06] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#5c2a06] text-[#ffeccb]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e4021b] to-[#5c2a06] shadow-[0_0_10px_rgba(228,2,27,0.7)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
