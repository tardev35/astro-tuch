---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#052ba9]/70 bg-[#020a2b]/92 p-8 text-[#d6e2f5] shadow-[0_10px_30px_rgba(1,4,28,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#1046e0]/70 hover:shadow-[0_15px_40px_rgba(61,130,255,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#072459]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#052ba9]/75 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf7] via-[#b7c6dd] to-[#7d90ad] shadow-[0_0_10px_rgba(183,198,221,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#8fc2ff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#052ba9]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#8fc2ff] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf7] via-[#3d82ff] to-[#052ba9] shadow-[0_0_10px_rgba(61,130,255,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e2f5] md:border-l md:border-[#052ba9] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#052ba9]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#b7c6dd] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8fc2ff] via-[#3d82ff] to-[#052ba9] shadow-[0_0_10px_rgba(143,194,255,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
