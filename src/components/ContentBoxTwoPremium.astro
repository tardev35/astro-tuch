---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// SUPERSLOTCLUB homepage this box carries docx H2 #6 (ระบบฝากถอนเข้าบริษัท
// โดยตรง ไม่ผ่านม้า): the brief's two paragraphs for that section run one per
// column, so the block emits exactly one docx heading.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้วบนโลโก้ (หัวเสือส้ม-ดำกับอุ้งเท้าเล็บขาวเกาะอยู่บน
// ป้ายโล่แดง ตัวอักษร SUPERSLOTCLUB แดงสามมิติขอบโครเมียม และเหรียญทองลายรอยเท้า
// เสือบนแบนเนอร์) จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว —
// สันฝั่งซ้ายเป็นฝั่งแดง ไล่แดงเรืองไฟ #ff5a46 → แดงแบรนด์ #e8232a → แดงลึก
// #7d0f12 ป้ายใช้ครีมอุ่น #f5cbb0 (10.7:1) เพราะ §2 ห้าม #e8232a ถือตัวอักษร
// ส่วนสันฝั่งขวาเป็นฝั่งทอง ไล่ทองสว่าง #ffd666 → ทองแบรนด์ #f2b705 → ทองเข้ม
// #a8730a ป้ายใช้ทองแบรนด์ #f2b705 (8.7:1) ทั้งสองป้ายวางบนผิวการ์ด #301105 ไม่ได้
// อยู่บนพื้นสี (ถ้าเป็นพื้นแดงสดหรือทองสด ต้องพลิกไปใช้หมึกเข้ม #2b0a00 ตาม §2 —
// ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ครีมอุ่น #f5cbb0 → ทองแบรนด์ #f2b705 → แดงเรืองไฟ #ff5a46 ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นทองเข้ม #a8730a โปร่ง (ต่างจาก
// กรอบแดงแบรนด์ของ ContentBoxPremium และกรอบแดงลึกของ
// ContentBoxSevenThreePremium) เส้นคั่นกลางเป็นแดงลึก #7d0f12
// เนื้อความ #fbe8d5 (= BRAND_TEXT) glow เป็น rgba(242,183,5,…) และ
// rgba(232,35,42,…)
//
// ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #5b1a75
// #d2a6ff #efe6ff #fbe455 #ffd23d #c98a05 #17062e #ece2ff rgba(251,228,85,α)
// rgba(164,53,240,α)) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ก่อนนั้น (#0193fb
// #7bcffb #d4ecfd #064a86 #fce604 #fff48a #c9a703 #07111d #dbeafe) ออกครบทุกจุด
// แล้ว — ทองของรอบนี้เป็นคนละค่ากับ #fbe455 #ffd23d #fce604 และ #c98a05
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a8730a]/40 bg-[#301105]/93 p-8 text-[#fbe8d5] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2b705]/70 hover:shadow-[0_15px_40px_rgba(242,183,5,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7d0f12]/45 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#a8730a]/24 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#a8730a]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd666] via-[#f2b705] to-[#a8730a] shadow-[0_0_10px_rgba(242,183,5,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f5cbb0] via-[#f2b705] to-[#ff5a46] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#e8232a]/45 text-[#f5cbb0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5a46] via-[#e8232a] to-[#7d0f12] shadow-[0_0_10px_rgba(232,35,42,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5] md:border-l md:border-[#7d0f12] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#a8730a]/45 text-[#f2b705]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd666] via-[#f2b705] to-[#a8730a] shadow-[0_0_10px_rgba(242,183,5,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
