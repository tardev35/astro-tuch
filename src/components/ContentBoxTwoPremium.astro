---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// WEPLAY168 homepage this box carries docx H2 #6 (ระบบฝากถอนเข้าบริษัทโดยตรง):
// the brief's two paragraphs for that section run one per column, so the block
// emits exactly one docx heading.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้วบนโลโก้ (ตัวอักษร WEPLAY เงินอมม่วงกับเลข 168 ทอง
// บนเครื่องเกมพกพาสีม่วง) จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว —
// สันฝั่งซ้ายเป็นฝั่งม่วง ไล่ม่วงอ่อน #d2a6ff → ม่วงแบรนด์ #a435f0 → ม่วงลึก
// #5b1a75 ป้ายใช้ม่วงอ่อน ส่วนสันฝั่งขวาเป็นฝั่งทอง ไล่ทองแบรนด์ #fbe455 → ทองอุ่น
// #ffd23d → ทองเข้ม #c98a05 ป้ายใช้ทองอุ่น ทั้งสองป้ายวางบนผิวการ์ด #17062e ไม่ได้
// อยู่บนพื้นสี (ถ้าเป็นพื้นม่วงสดหรือทองสด ห้ามใช้ตัวอักษรสว่างเด็ดขาดตาม §2 —
// ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่เงินอมม่วง #efe6ff → ม่วงอ่อน #d2a6ff → ทองแบรนด์ #fbe455 ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นทองเข้ม #c98a05 โปร่ง (ต่างจาก
// กรอบม่วงแบรนด์ของ ContentBoxPremium และกรอบม่วงลึกของ
// ContentBoxSevenThreePremium) เส้นคั่นกลางเป็นม่วงลึก #5b1a75
// เนื้อความ #ece2ff (= BRAND_TEXT) glow เป็น rgba(251,228,85,…) และ
// rgba(164,53,240,…)
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0193fb #7bcffb #d4ecfd
// #064a86 #fce604 #fff48a #c9a703 #07111d #dbeafe rgba(252,230,4,…)
// rgba(1,147,251,…)) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c98a05]/40 bg-[#17062e]/93 p-8 text-[#ece2ff] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbe455]/70 hover:shadow-[0_15px_40px_rgba(251,228,85,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5b1a75]/45 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c98a05]/24 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#c98a05]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbe455] via-[#ffd23d] to-[#c98a05] shadow-[0_0_10px_rgba(251,228,85,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#efe6ff] via-[#d2a6ff] to-[#fbe455] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#a435f0]/45 text-[#d2a6ff]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d2a6ff] via-[#a435f0] to-[#5b1a75] shadow-[0_0_10px_rgba(164,53,240,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2ff] md:border-l md:border-[#5b1a75] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c98a05]/45 text-[#ffd23d]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbe455] via-[#ffd23d] to-[#c98a05] shadow-[0_0_10px_rgba(251,228,85,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
