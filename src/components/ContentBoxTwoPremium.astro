---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the PKG44
// homepage this box carries docx H2 #6: the left column is the brief's intro
// paragraph and the right column its numbered 3-step <ol>, so the block emits
// exactly one docx heading.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): เวิร์ดมาร์กแบรนด์นี้เขียน P เป็นทอง
// K เป็นเงินโครเมียม แล้ว G44 กลับมาเป็นทอง สองครึ่งของกล่องจึงแยกกันด้วยคู่โลหะนั้น
// จริงๆ สันฝั่งซ้ายไล่จากทองสว่าง #ffe27a ลงทองแบรนด์ #fdd32a ไปหาทองลึก #4a3a12
// ส่วนฝั่งขวาไล่จากขาวโครเมียม #f2f4f7 ลงเงินหม่น #8a9099 ไปหาทองลึก ป้ายฝั่งซ้ายเป็น
// ทองสว่าง ฝั่งขวาเป็นเงินโครเมียม #c2c8d0 บนผิวการ์ด #12100a เหนือพื้นเพจ #080602
// เนื้อความ #efe6d2 (BRAND_TEXT) — ชุดทอง-โครเมียมของ MIRACLE55 (#fcda65 #fee47b
// #d9a62b #fcfcfc #d2d3d4 #a8acb1 #8c5f14 #14100a #050403 #e8e6e1) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a3a12] bg-[#12100a]/92 p-8 text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#c2c8d0]/60 hover:shadow-[0_15px_40px_rgba(194,200,208,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#c8920a]/22 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#c2c8d0]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe27a] via-[#fdd32a] to-[#4a3a12] shadow-[0_0_10px_rgba(253,211,42,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#fdd32a]/40 text-[#ffe27a]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe27a] via-[#fdd32a] to-[#4a3a12] shadow-[0_0_10px_rgba(253,211,42,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2] md:border-l md:border-[#4a3a12] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c2c8d0]/30 text-[#c2c8d0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2f4f7] via-[#8a9099] to-[#4a3a12] shadow-[0_0_10px_rgba(194,200,208,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
