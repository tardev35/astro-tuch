---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b5216]/70 bg-[#0d0a06]/92 p-8 text-[#e9ddc4] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4c25a]/70 hover:shadow-[0_15px_40px_rgba(228,194,90,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#17120a]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#6b5216]/75 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] shadow-[0_0_10px_rgba(228,194,90,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9ddc4]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#6b5216]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#fae582] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf49c] via-[#e4c25a] to-[#b28a2a] shadow-[0_0_10px_rgba(228,194,90,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9ddc4] md:border-l md:border-[#6b5216] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#6b5216]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#c9c9c9] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8e8e8] via-[#c9c9c9] to-[#8a8a8a] shadow-[0_0_10px_rgba(201,201,201,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
