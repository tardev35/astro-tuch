---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): แบรนด์นี้มีสองสีจริง — มาเจนตากับทอง —
// สองคอลัมน์จึงแยกกันด้วยคู่สีนั้น ไม่ใช่ด้วยความสว่าง สันฝั่งซ้ายไล่จากทองประกาย
// #fced94 ลงทองหลัก #e8b33a ไปหาทองเข้ม #c3832b ส่วนฝั่งขวาไล่จากชมพูกุหลาบ
// #f9a8cd ลงมาเจนตาหลัก #ec2b84 ไปหามาเจนตาเข้ม #a3145a หัวข้อฝั่งซ้ายเป็นทอง
// ประกาย ฝั่งขวาเป็นชมพูกุหลาบ บนพื้นการ์ด #24081a — ครึ่งซ้ายจึงอ่านเป็นท่อน
// เล่าเรื่อง ครึ่งขวาเป็นท่อนขั้นตอน ชุดมรกต-ทองของ HENG38 หายไปทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a3145a] bg-[#24081a]/92 p-8 text-[#fce9f3] shadow-[0_10px_30px_rgba(23,4,17,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8b33a]/70 hover:shadow-[0_15px_40px_rgba(232,179,58,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#a3145a]/28 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#e8b33a]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced94] via-[#e8b33a] to-[#c3832b] shadow-[0_0_10px_rgba(232,179,58,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#c3832b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#e8b33a]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fced94] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced94] via-[#e8b33a] to-[#c3832b] shadow-[0_0_10px_rgba(252,237,148,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3] md:border-l md:border-[#a3145a] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#a3145a] pb-3 text-xl leading-normal font-black tracking-widest text-[#f9a8cd] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9a8cd] via-[#ec2b84] to-[#a3145a] shadow-[0_0_10px_rgba(236,43,132,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
