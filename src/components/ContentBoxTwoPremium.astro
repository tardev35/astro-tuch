---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// DM899 homepage this box carries docx H2 #2: the brief's two paragraphs for
// that section run one per column, so the block emits exactly one docx heading.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): โลโก้คือตัว D เขียว
// (vivid #01841b #018b1b) ซ้อนตัว M แดง (#fb252b #bb0303 #f91c20) แบรนด์นี้จึงมี
// สองสีจริงอยู่แล้ว ไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว — สันฝั่งซ้าย
// เป็นฝั่งเขียว ไล่เขียวสว่าง #4ade6b → เขียวแบรนด์ #01a326 → เขียวแกน #01841b
// ส่วนสันฝั่งขวาเป็นฝั่งแดง ไล่แดงอ่อน #ff6b6e → แดงแบรนด์ #fb252b → แดงลึก
// #8f0609 ป้ายฝั่งซ้ายใช้เขียวสว่าง #4ade6b (8.6:1 บนผิวการ์ด #0a1a0e) ส่วนป้าย
// ฝั่งขวาใช้แดงอ่อน #ff6b6e (6.4:1) ทั้งคู่วางอยู่บนผิวการ์ด ไม่ได้อยู่บนพื้นสี
// (หมึกเข้มบนพื้นแดงแบรนด์ได้แค่ ~2.9:1 — พื้นแดงต้องใช้หมึกขาวเสมอ) หัวข้อ docx
// ไล่ขาวนวล #e4f2e4 → เขียวสว่าง #4ade6b → แดงแบรนด์ #fb252b ซึ่งเป็นคู่ไล่เฉด
// "ขาวไปเขียวไปแดง" คนละชุดกับการ์ด H1 ที่ใช้ "ทองไปเขียว" เนื้อความ #e4f2e4
// (BRAND_TEXT)
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #8c0402 #ffc93c
// #ffeab0 #c08a07 #240406 #f6e7e0) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#01a326]/55 bg-[#0a1a0e]/93 p-8 text-[#e4f2e4] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#12c23a]/70 hover:shadow-[0_15px_40px_rgba(1,163,38,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0a4a18]/35 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fb252b]/20 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#01a326]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_10px_rgba(1,163,38,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e4f2e4] via-[#4ade6b] to-[#fb252b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#01a326]/45 text-[#4ade6b]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_10px_rgba(1,163,38,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4] md:border-l md:border-[#0a4a18] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#fb252b]/55 text-[#ff6b6e]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff6b6e] via-[#fb252b] to-[#8f0609] shadow-[0_0_10px_rgba(251,37,43,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
