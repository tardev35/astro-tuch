---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels never emit HeadingTag — that would put this page's own
// layout wording into the h2/h3 inventory that gets diffed against the docx.
// They are <p> with the same size, weight, tracking and colour a heading would
// carry. On this brand's homepage the box carries docx H2 §7
// (ช่องทางติดต่อแอดมิน … ทาง LINE OFFICIAL 24ชม.): the brief writes that section
// as one running paragraph, so the page runs its two halves one per column, the
// block emits exactly one docx heading, and no slot receives two siblings. No
// column label is passed either — the brief gives §7 no sub-labels of its own.
//
// รับตัง168 (รอบทองไทยนำ แดงมังกรรอง บนดำอมแดง 2026-10-18, brand-spec §2):
// แบรนด์มีสองโทนจริงอยู่บนโลโก้ — คำว่า "รับตัง" เป็นตัวอักษรสามมิติผิวโครเมียม
// อมฟ้าเงินขอบแดง ต่อด้วยเลข "168" **แดงสด** สามมิติ ทั้งหมดวางอยู่บน **กองเหรียญ
// จีนทองรูสี่เหลี่ยม** กับริบบิ้นซาตินแดง สองคอลัมน์จึงแยกด้วยคู่โทนนั้นตรงๆ ไม่ใช่
// ด้วยระดับความสว่างของสีเดียว: สันฝั่งซ้ายเป็นฝั่งทอง ไล่ทองสว่าง #ffdc8c → ทอง
// แบรนด์ #f0b429 → ทองลึก #9a6c0c ป้ายใช้ทองแบรนด์ #f0b429 (§2 ระบุว่าถือตัวอักษร
// ได้ 8.5:1) ส่วนสันฝั่งขวาเป็นฝั่งแดง ไล่แดงสว่าง #ff6b6e → แดงแบรนด์ #d30304 →
// แดงเข้มสุด #4a0202 ป้ายใช้แดงสว่าง #ff6b6e (5.4:1 และเป็น text-xl font-black จึง
// เป็น large text) ทั้งสองป้ายวางบนผิวการ์ด ไม่ได้อยู่บนพื้นถมสี
// ⚠️ **ทองมาก่อนแดง** ตามลำดับนำของรอบนี้ ซึ่งกลับทางจากรอบก่อน (สมหวัง168 แดงนำ)
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง #1a0505** (bg.json) ลำดับความลึก: #2b100f ยก /
// #200a09 กลาง / #140505 จม / #1a0505 พื้น การ์ดใบนี้วางที่ **ผิวกลาง #200a09**
// ซึ่งอยู่ระหว่างผิวยกของ §6 ที่อยู่เหนือมัน กับผิวจมของ Faq3 ที่ปิดท้ายหน้า
// หัวข้อ docx ไล่ ทองสว่าง #ffdc8c → แดงสว่าง #ff6b6e → ทองแบรนด์ #f0b429 ซึ่งเป็น
// ลำดับคนละชุดกับกล่อง docx ใบอื่นในหน้า ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 — ห้ามเอา #d30304
// #a00203 #4a0202 #9a6c0c มาเป็นสต็อป และห้ามเอา #cfd9e6 มาด้วย เพราะ §2 สงวนมัน
// ไว้เป็นสีตัวอักษรรองอย่างเดียว ไม่ใช่สีระบบ
// กรอบเป็นทองลึก #9a6c0c โปร่ง สว่างขึ้นเป็นทองแบรนด์ #f0b429 ตอน hover เส้นคั่น
// กลางเป็นแดงเข้มสุด #4a0202 เนื้อความ #f5ece0 (= BRAND_TEXT) — 13.9:1 บนผิวกลาง
// glow มีได้สองชุดตาม §2 ที่ใช้ในไฟล์นี้: rgba(240,180,41,…) และ rgba(211,3,4,…)
// §2 ห้าม #d30304 #a00203 #4a0202 #9a6c0c ถือตัวอักษร — ที่นี่อยู่ที่กรอบ ปลายไล่เฉด
// ของสัน ออรา และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** โค้ดเบสนี้มีแบรนด์
// แดงมาแล้วสามเจ้าติดกันและค่าของพวกมันยังค้างในไฟล์ inventory อื่น: สมหวัง168
// (#fa0513 #ffadaf #ff5a5f #e3b23c #ffe5a8 #8a6210 #b90203 #8c0204 #5b0203 #3c0303
// #170504 #f4ecea #ccb9b6 #2c1413 #1f0d0c #140706 #290f0f) TKB55 (#fb131b #ff8a8f
// #ff4d55 #e9eef4 #aeb9c6 #f2e4e5 #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a
// #1a0304 — ชุดนี้เพิ่งอยู่ทั้งไฟล์นี้) และ GT66B (#fb141b #ff5f63 #ffa0a2 #db040b
// #ec151c #8a0609 #3b0405) — ไม่มีตัวไหนเป็น #d30304 (R=211 G=3 B=4) ของรอบนี้
// ชุดม่วงราชา-ทองของ KMD88 (#7505cc #b453ff #c07cff #d9b8ff #3a0565 #2c0349 #7a5a0a
// #e2b33f #ffdf8c #ece2f8 #1d0832 #140522 #0a0213 #1a0526) ชุดน้ำเงินไฟฟ้าของ
// TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42
// #040e26 #00081f #04186e #021026) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571
// #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a1038 #2a0012 #1c0014) ชุดทอง
// มังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b #140d02)
// และชุดทองแชมเปี้ยนของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06 #f0e8d4
// #ffe08a #7d5a07 #464f5a #f2f5f9 #8792a0) ออกครบทุกจุดแล้ว
// ⚠️ ทองรอบนี้คือ #f0b429 ซึ่งไม่ใช่ #e3b23c ของสมหวัง168 (รอบก่อนหน้าทันที) ไม่ใช่
// #dfa310 #e5a81b #e2b33f หรือ #fad354 — "มีทองอยู่แล้ว" ไม่พิสูจน์อะไร
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม** และ
// ไม่มีโครเมียม/เงินเป็นสีระบบ #e9eef4 #aeb9c6 #cfdcec #9db4d4 ต้องไม่เหลือที่นี่
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#9a6c0c]/70 bg-[#200a09]/94 p-8 text-[#f5ece0] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0b429]/80 hover:shadow-[0_15px_40px_rgba(240,180,41,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#4a0202]/60 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#f0b429]/18 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#9a6c0c]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdc8c] via-[#f0b429] to-[#9a6c0c] shadow-[0_0_10px_rgba(240,180,41,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffdc8c] via-[#ff6b6e] to-[#f0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5ece0]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#9a6c0c]/70 text-[#f0b429]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdc8c] via-[#f0b429] to-[#9a6c0c] shadow-[0_0_10px_rgba(240,180,41,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5ece0] md:border-l md:border-[#4a0202] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#d30304]/50 text-[#ff6b6e]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff6b6e] via-[#d30304] to-[#4a0202] shadow-[0_0_10px_rgba(211,3,4,0.7)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
