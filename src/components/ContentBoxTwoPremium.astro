---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels never emit HeadingTag — that would put this page's own
// layout wording into the h2/h3 inventory that gets diffed against the docx.
// They are <p> with the same size, weight, tracking and colour a heading would
// carry. รอบนี้หน้าแรกให้ใบนี้ถือ **docx H2 §3** (โปรโมชั่น <แบรนด์> รับได้ไม่จำกัด
// — content.txt บรรทัด 8): บรีฟเขียนย่อหน้าเดียวยาว หน้าแรกจึงรันครึ่งย่อหน้าลง
// คอลัมน์ละครึ่ง บล็อกนี้ปล่อยหัวข้อ docx ออกมาตัวเดียว และไม่มีสล็อตไหนได้รับ
// element สองตัว **ไม่มีการส่งป้ายคอลัมน์มา** เพราะบรีฟไม่ได้ให้ §3 มีหัวข้อย่อย
// ของตัวเอง
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม brand-spec §2
// แบรนด์มีสองโทนจริงอยู่บนโลโก้: คำว่า "รวย" เป็นตัวอักษรไทยสามมิติ **สีทองอำพัน**
// ตัดขอบขาว ต่อด้วย "แทร่168" **สีฟ้าอะซัวร์บับเบิลผิวมันวาว** ล้อมด้วยถุงเงินฟ้า
// ปึกธนบัตร กองเหรียญทอง หัวใจฟ้า และประกายดาวฟ้า-ทอง สองคอลัมน์จึงแยกด้วยคู่โทน
// นั้นตรงๆ ไม่ใช่ด้วยระดับความสว่างของสีเดียว: สันฝั่งซ้ายเป็น **ฝั่งฟ้า** ไล่
// ฟ้าน้ำแข็ง #c3ebfc → ฟ้าอะซัวร์ #039cfa → น้ำเงินลึก #04366b ป้ายใช้ฟ้าอะซัวร์
// (§2 ระบุว่าถือตัวอักษรได้ 4.6:1 และเป็น text-xl font-black จึงเป็น large text)
// ส่วนสันฝั่งขวาเป็น **ฝั่งทอง** ไล่ทองอำพัน #f9a826 → บรอนซ์ลึก #704504 ป้ายใช้
// ทองอำพัน (6.9:1)
// ⚠️ **ฟ้ามาก่อนทอง** ตามลำดับนำของรอบนี้
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0b2d52 ยก / #071e38 กลาง /
// #030f1d จม / #000000 พื้น การ์ดใบนี้วางที่ **ผิวกลาง #071e38** ซึ่งอยู่ระหว่าง
// ผิวยกของ §4 ที่ตามมา กับผิวจมของ Faq ที่ปิดท้ายหน้า
// หัวข้อ docx ไล่ ฟ้าน้ำแข็ง #c3ebfc → ทองอำพัน #f9a826 → ฟ้าอะซัวร์ #039cfa ซึ่ง
// เป็นลำดับคนละชุดกับกล่อง docx ใบอื่นในหน้า ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (10.8 / 6.9 / 4.6 ที่
// text-2xl font-black = large text) — ห้ามเอา #04366b (1.15:1) หรือ #704504 (1.7:1)
// มาเป็นสต็อป
// กรอบเป็นบรอนซ์ลึก #704504 โปร่ง สว่างขึ้นเป็นฟ้าอะซัวร์ตอน hover เส้นคั่นกลางเป็น
// น้ำเงินลึก #04366b เนื้อความ #e3f2fc (= BRAND_TEXT) — 13.9:1 บนผิวกลาง
// glow rgba ใช้ได้สี่ชุดตาม §2 ไฟล์นี้ใช้ rgba(3,156,250,α) และ rgba(249,168,38,α)
// §2 ห้าม #04366b #704504 ถือตัวอักษร — ที่นี่อยู่ที่กรอบ ปลายไล่เฉดของสัน ออรา
// และเส้นคั่นเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// นินจา168 (รอบก่อน) ฟ้าไซยาน 32bcfb + เหลืองมะนาว fef54b · สบายเบท168 ก่อนหน้านั้น
// ฟ้าท้องฟ้า 2f9ff5 + ทองอำพัน ffc82e "มีฟ้าอยู่แล้ว" หรือ "มีทองอยู่แล้ว" จึงไม่
// พิสูจน์อะไรเลย ชุดที่เพิ่งอยู่ในไฟล์นี้คือถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20
// 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5 กับ rgba 250/99/185 และ rgba 255/216/77)
// ก่อนหน้านั้นรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c cfd9e6
// f5ece0 2b100f 200a09 140505 1a0505) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8
// 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea 2c1413 1f0d0c 140706) TKB55 (fb131b
// ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a)
// ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f
// ffdf8c ece2f8) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 102a5e) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343
// ffd94a f0c3dc fde7f2 8a0a45 4a1038) และชุดทองมังกรของ TND168 (dfa310 ffc93d ffe4a3
// c9b88e f0e9dc 8a5c09 43240b) ออกครบทุกจุดแล้ว
// ⚠️ ฟ้ารอบนี้คือ **#039cfa / #c3ebfc / #04366b** (R=3 G=156 B=250 อะซัวร์อิ่มสีจัด)
// ไม่ใช่ 32bcfb a9e9ff 07335f ของนินจา168 ไม่ใช่ 2f9ff5 a8dcff 0b3f78 ของสบายเบท168
// ไม่ใช่ 0360f3 0292fb 6ec8ff ของ TSDET911 ไม่ใช่ 0a84e0 ของ HI59 ไม่ใช่ 2563eb
// 04225b และไม่ใช่ cfd9e6 (เงินอมฟ้าของรับตัง168)
// ⚠️ ทองรอบนี้คือ **#f9a826** (R=249 G=168 B=38 อำพันออกส้ม) ไม่ใช่ fef54b ของ
// นินจา168 (เหลืองมะนาว) ไม่ใช่ ffc82e ของสบายเบท168 ไม่ใช่ ffd84d fcd434 f7c92b
// f0b429 e3b23c dfa310 e5a81b e2b33f หรือ fad354
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู แดง ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// เหลืองมะนาว** — fdeaf5 cfd9e6 e9eef4 aeb9c6 cfdcec 9db4d4 ต้องไม่เหลือที่นี่
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#704504]/80 bg-[#071e38]/94 p-8 text-[#e3f2fc] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#039cfa]/80 hover:shadow-[0_15px_40px_rgba(3,156,250,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#04366b]/60 to-transparent opacity-75"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#039cfa]/18 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#704504]/70 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c3ebfc] via-[#039cfa] to-[#04366b] shadow-[0_0_10px_rgba(3,156,250,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#c3ebfc] via-[#f9a826] to-[#039cfa] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#039cfa]/60 text-[#039cfa]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c3ebfc] via-[#039cfa] to-[#04366b] shadow-[0_0_10px_rgba(3,156,250,0.7)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc] md:border-l md:border-[#04366b] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#704504]/80 text-[#f9a826]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f9a826] to-[#704504] shadow-[0_0_10px_rgba(249,168,38,0.7)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
