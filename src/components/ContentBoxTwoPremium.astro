---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b5316]/55 bg-[#14100a]/92 p-8 text-[#e6dcc2] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#d4af37]/70 hover:shadow-[0_15px_40px_rgba(243,219,91,0.26)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#241a08]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#6b5316]/75 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff3bf] via-[#f3db5b] to-[#a37c14] shadow-[0_0_10px_rgba(243,219,91,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff3bf] via-[#f3db5b] to-[#a37c14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6dcc2]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#6b5316]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#f3db5b] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f3db5b] via-[#d4af37] to-[#a37c14] shadow-[0_0_10px_rgba(212,175,55,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6dcc2] md:border-l md:border-[#6b5316] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#6b5316]/75 pb-3 text-xl leading-normal font-black tracking-widest text-[#d8dce2] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f2f5f8] via-[#d8dce2] to-[#8b929c] shadow-[0_0_10px_rgba(216,220,226,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
