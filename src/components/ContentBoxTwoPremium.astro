---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// หวยคิง homepage this box carries docx H2 #6 (สมัคร 3 ขั้นตอน): the brief's two
// paragraphs for that section run one per column, so the block emits exactly one
// docx heading.
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): brand-spec §2
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้ว (ทองโลหะของโลโก้/มงกุฎ กับครีมอมพีชของชุดขาว
// นางแบบใน slide1/slide2) จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว —
// สันฝั่งซ้ายเป็นฝั่งทอง ไล่ทองสว่าง #fdeb7c → ทองแบรนด์ #cd9a2c → ทองลึก #ab7314
// ป้ายใช้ทองสว่าง #fdeb7c ส่วนสันฝั่งขวาเป็นฝั่งครีม ไล่ครีมอ่อน #fce2d4 →
// ครีมอมพีช #fcd4c3 → ทองลึก #ab7314 ป้ายใช้ #fcd4c3 ทั้งสองป้ายวางบนผิวการ์ด
// #1c140b ไม่ได้อยู่บนพื้นสี (หมึกเข้มบนพื้นทองใช้ #120a02 เสมอ — ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ทองสว่าง #fdeb7c → ครีมอมพีช #fcd4c3 → ทองแบรนด์ #cd9a2c ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นทองแบรนด์ #cd9a2c เส้นคั่นกลาง
// เป็นเส้นจาง #5c3f12 เนื้อความ #f5e7c8 (= BRAND_TEXT) glow เป็น rgba(205,154,44,…)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #12c23a
// #01841b #fb252b #ff6b6e #8f0609 #0a4a18 #0a1a0e #e4f2e4) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#cd9a2c]/55 bg-[#1c140b]/93 p-8 text-[#f5e7c8] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdeb7c]/70 hover:shadow-[0_15px_40px_rgba(205,154,44,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5c3f12]/35 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fcd4c3]/18 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#cd9a2c]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] shadow-[0_0_10px_rgba(205,154,44,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdeb7c] via-[#fcd4c3] to-[#cd9a2c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#cd9a2c]/45 text-[#fdeb7c]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdeb7c] via-[#cd9a2c] to-[#ab7314] shadow-[0_0_10px_rgba(205,154,44,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8] md:border-l md:border-[#5c3f12] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#fcd4c3]/35 text-[#fcd4c3]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fce2d4] via-[#fcd4c3] to-[#ab7314] shadow-[0_0_10px_rgba(252,212,195,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
