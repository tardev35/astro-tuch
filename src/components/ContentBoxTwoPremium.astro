---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// แตกดี168 homepage this box carries docx H2 #6 (ร่วมเป็นสมาชิกเว็บสล็อต): the
// brief's two paragraphs for that section run one per column, so the block
// emits exactly one docx heading.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// แบรนด์รอบนี้มีคู่สีจริงอยู่แล้วบนโลโก้ (คำว่า แตกดี เหลืองมะนาว วางเหนือเลข 168
// ฟ้าสด) จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว — สันฝั่งซ้ายเป็นฝั่ง
// ฟ้า ไล่ฟ้าอ่อน #7bcffb → ฟ้าแบรนด์ #0193fb → ฟ้าเข้ม #064a86 ป้ายใช้ฟ้าอ่อน
// ส่วนสันฝั่งขวาเป็นฝั่งเหลือง ไล่เหลืองอ่อน #fff48a → เหลืองมะนาว #fce604 →
// เหลืองเข้ม #c9a703 ป้ายใช้เหลืองมะนาว ทั้งสองป้ายวางบนผิวการ์ด #07111d ไม่ได้อยู่
// บนพื้นสี (ถ้าเป็นพื้นฟ้าหรือเหลืองสด ห้ามใช้ตัวอักษรสว่างเด็ดขาดตาม §2 —
// ที่นี่ไม่มีพื้นสี)
// หัวข้อ docx ไล่ฟ้าซีด #d4ecfd → ฟ้าอ่อน #7bcffb → เหลืองมะนาว #fce604 ซึ่งเป็น
// ลำดับคนละชุดกับการ์ด H1/H2 ใบอื่นในหน้า กรอบเป็นเหลืองเข้ม #c9a703 โปร่ง (ต่างจาก
// กรอบฟ้าแบรนด์ของ ContentBoxPremium และกรอบฟ้าเข้มของ ContentBoxSevenThreePremium)
// เส้นคั่นกลางเป็นฟ้าเข้ม #064a86 เนื้อความ #dbeafe (= BRAND_TEXT)
// glow เป็น rgba(252,230,4,…) และ rgba(1,147,251,…)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f
// #7a0505 #0b7a33 #2bbf63 #063f1c #d9a521 #ffdf91 #8c6410 #140705 #f6e3cf
// rgba(196,17,21,…) rgba(217,165,33,…) rgba(11,122,51,…)) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c9a703]/40 bg-[#07111d]/93 p-8 text-[#dbeafe] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fce604]/70 hover:shadow-[0_15px_40px_rgba(252,230,4,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#064a86]/45 to-transparent opacity-70"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c9a703]/24 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#c9a703]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff48a] via-[#fce604] to-[#c9a703] shadow-[0_0_10px_rgba(252,230,4,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#d4ecfd] via-[#7bcffb] to-[#fce604] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#0193fb]/45 text-[#7bcffb]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7bcffb] via-[#0193fb] to-[#064a86] shadow-[0_0_10px_rgba(1,147,251,0.65)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:border-l md:border-[#064a86] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#c9a703]/45 text-[#fce604]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff48a] via-[#fce604] to-[#c9a703] shadow-[0_0_10px_rgba(252,230,4,0.55)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
