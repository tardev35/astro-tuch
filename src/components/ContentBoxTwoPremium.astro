---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// GOT777 homepage this box carries docx H2 #2: the brief's two paragraphs run
// one per column, so the block emits exactly one docx heading.
//
// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): เวิร์ดมาร์กแบรนด์นี้เขียน GOT เป็นทอง
// เมทัลลิก #f5c518 แล้วปิดด้วยเลข 777 สีแดงเลือดหมู #d21622 ขอบทอง สองครึ่งของกล่องจึง
// แยกกันด้วยคู่สีนั้นจริงๆ สันฝั่งซ้ายไล่จากทองอ่อน #ffe9a8 ลงทองแบรนด์ #f5c518 ไปหา
// ทองลึก #96690f ส่วนฝั่งขวาไล่จากแดงแบรนด์ #d21622 ลงแดงลึก #7b0304 ไปหาแดงเข้มสุด
// #4c0301 ป้ายฝั่งซ้ายเป็นทองอ่อน ฝั่งขวาเป็นแดงแบรนด์ บนผิวการ์ด #160b06 เหนือพื้นเพจ
// #0a0503 เนื้อความ #ece0cb (BRAND_TEXT) — ชุดทอง-ขาวของ WIN999 (#fcc403 #fdda04
// #8a6502 #4a3402 #fffbea #101010 #050505 #e9e4d6) ออกทั้งหมด
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4c0301] bg-[#160b06]/92 p-8 text-[#ece0cb] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/60 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#96690f]/24 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#f5c518]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c518] to-[#96690f] shadow-[0_0_10px_rgba(245,197,24,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#f5c518]/40 text-[#ffe9a8]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c518] to-[#96690f] shadow-[0_0_10px_rgba(245,197,24,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb] md:border-l md:border-[#4c0301] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#7b0304]/70 text-[#d21622]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d21622] via-[#7b0304] to-[#4c0301] shadow-[0_0_10px_rgba(210,22,34,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
