---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead. On the UFAGOOL homepage
// this box is passed `title` alone, so it emits exactly one docx heading.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): แบรนด์นี้มีสองสีจริง — แดงกับเงิน
// โครเมียม — สองคอลัมน์จึงแยกกันด้วยคู่สีนั้น ไม่ใช่ด้วยความสว่าง สันฝั่งซ้ายไล่จาก
// แดงสด #ef1f25 ลงแดงแบรนด์ #c50d12 ไปหาแดงลึก #7a0103 ส่วนฝั่งขวาไล่จากขาวเงิน
// #f4f7fa ลงเงินหลัก #b8c3cf ไปหาเงินเข้ม #5c6672 หัวข้อฝั่งซ้ายเป็นแดงสด ฝั่งขวา
// เป็นขาวเงิน บนพื้นการ์ดยกระดับ #241a1a — ครึ่งซ้ายจึงอ่านเป็นท่อนเล่าเรื่อง
// ครึ่งขวาเป็นท่อนขั้นตอน ชุดชมพูมาเจนตา-ทองของ WY88 หายไปทั้งหมด
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5e0507] bg-[#241a1a]/92 p-8 text-[#cdd5dd] shadow-[0_10px_30px_rgba(10,7,8,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#b8c3cf]/70 hover:shadow-[0_15px_40px_rgba(184,195,207,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#c50d12]/26 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#b8c3cf]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef1f25] via-[#c50d12] to-[#7a0103] shadow-[0_0_10px_rgba(197,13,18,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#c50d12]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#ef1f25] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef1f25] via-[#c50d12] to-[#7a0103] shadow-[0_0_10px_rgba(239,31,37,0.55)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd] md:border-l md:border-[#5e0507] md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#b8c3cf]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#f4f7fa] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f4f7fa] via-[#b8c3cf] to-[#5c6672] shadow-[0_0_10px_rgba(184,195,207,0.45)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
