---
export interface Props {
  /** The section's own docx heading — the only heading this box emits. */
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Column labels. On this template a two-column split is the page's own
   *  wording for laying one docx section out side by side, not a docx
   *  sub-heading — so they render as <p> carrying exactly the classes a heading
   *  would. Do not promote them back to HeadingTag. */
  titleleft?: string;
  titleright?: string;
  /** Names the <section> for assistive tech on the rare call that passes column
   *  labels with no `title`, since <p> labels leave it with no accessible
   *  name. */
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const sectionLabel = label ?? titleleft ?? "ข้อมูลประกอบ";

// The column labels used to emit HeadingTag, which put this page's own layout
// wording into the h2/h3 inventory that gets diffed against the docx. They are
// <p> now — same size, weight, tracking and colour, no heading tag. On the
// หวย365 homepage this box carries docx H2 #2: the brief's two paragraphs for
// that section run one per column, so the block emits exactly one docx heading.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): โลโก้เป็นคำว่า หวย สีแดงสดคู่กับเลข 365
// (vivid #dc0203 #e00104 #e2020a แดงล้วน dominant ดำ #020202) และงานอาร์ตเป็นผ้าซาติน
// แดงกับเหรียญทอง แบรนด์นี้มีสองสีจริง จึงไม่ต้องแยกสองคอลัมน์ด้วยระดับความสว่างของสีเดียว
// เหมือนรอบทองล้วน — สันฝั่งซ้ายเป็นฝั่งทอง ไล่ทองอ่อน #ffeab0 → ทองแบรนด์ #ffc93c →
// ทองลึก #c08a07 ส่วนสันฝั่งขวาเป็นฝั่งแดง ไล่แดงสว่าง #f5282a → แดงแบรนด์ #dc0203 →
// แดงลึก #8c0402 ป้ายฝั่งซ้ายใช้ทองอ่อน #ffeab0 ส่วนป้ายฝั่งขวาใช้สีเนื้อความ #f6e7e0
// เพราะป้ายทั้งสองวางอยู่บนผิวการ์ด #240406 ไม่ได้อยู่บนพื้นแดง (หมึกเข้มบนพื้นแดง
// #dc0203 ได้แค่ 2.8:1 — พื้นแดงต้องใช้หมึกขาวเสมอ) แดงจึงเดินผ่านสันและเส้นคั่น
// ที่เป็นของประดับแทน เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #241404
// #140c02 #f3e8cf) ออกครบทุกจุดแล้ว
const columnLabel = "flex items-center gap-3 border-b pb-3 text-xl leading-normal font-black tracking-widest uppercase";
---

<section aria-label={title ? undefined : sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c08a07] bg-[#240406]/92 p-8 text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/60 hover:shadow-[0_15px_40px_rgba(255,201,60,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#8c0402]/30 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#ffc93c]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
        {
          titleleft && (
            <p class={`${columnLabel} border-[#ffc93c]/40 text-[#ffeab0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.55)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0] md:border-l md:border-[#c08a07] md:pl-10">
        {
          titleright && (
            <p class={`${columnLabel} border-[#dc0203]/70 text-[#f6e7e0]`}>
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5282a] via-[#dc0203] to-[#8c0402] shadow-[0_0_10px_rgba(220,2,3,0.60)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
