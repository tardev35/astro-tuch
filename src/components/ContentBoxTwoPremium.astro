---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// titleleft / titleright emit HeadingTag, so they carry docx sub-headings only.
// A chrome two-column widget belongs in ContentBoxTwo, whose column labels are
// <p> and whose <section> takes an aria-label instead.
//
// The two columns are keyed to the two halves of the UVO88 logo: the left
// spine/heading runs emerald (the poker chip behind the wordmark), the right one
// runs coin gold (the 88), so a two-paragraph docx section reads as a pair
// rather than as one flat slab.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#116330]/60 bg-[#051a0e]/92 p-8 text-[#c8e3d0] shadow-[0_10px_30px_rgba(2,13,7,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#0f9d47]/70 hover:shadow-[0_15px_40px_rgba(15,157,71,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0b2c17]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-3 border-b border-[#116330]/55 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#57dd8f] via-[#e2f3e6] to-[#116330] shadow-[0_0_10px_rgba(87,221,143,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#57dd8f] via-[#f3fbf5] to-[#e2f3e6] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
        {
          titleleft && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#116330]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#57dd8f] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d9f7e3] via-[#0f9d47] to-[#116330] shadow-[0_0_10px_rgba(15,157,71,0.5)]" />
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0] md:border-l md:border-[#116330]/45 md:pl-10">
        {
          titleright && (
            <HeadingTag class="flex items-center gap-3 border-b border-[#f2c230]/45 pb-3 text-xl leading-normal font-black tracking-widest text-[#f2c230] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f2c230] to-[#9c7d2b] shadow-[0_0_10px_rgba(242,194,48,0.5)]" />
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
