---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// `faqs` ต้องว่างเป็นค่าเริ่มต้น ห้ามมีรายการ Q/A เป็น default
// ทุกหน้าที่เรนเดอร์ FAQ ส่ง `faqs` มาจากบรีฟของตัวเองอยู่แล้ว ส่วน default ที่เคยมี
// Q/A ติดอยู่คือช่องทางคลาสสิกที่สุดที่คำถามของแบรนด์ก่อนหลุดขึ้น production:
// หน้าที่ลืมส่ง prop จะเงียบ ๆ ขึ้นเนื้อหาของลูกค้าอีกเจ้าแทนที่จะว่างให้เห็นว่าลืม
//
// คำถามเป็น <p> ใน <summary> ไม่ใช่ heading: รายการ h2/h3 ถูก diff กับ checklist ของ
// บรีฟทุกรอบ และไม่มีหัวข้อไหนในบรีฟที่เป็นประโยคคำถาม accordion ยังทำงานได้
// เพราะตัวควบคุมคือ <summary> ไม่ใช่แท็กข้างใน ส่วน `title` มาจาก prop (คือมาจาก
// บรีฟ) จึงเป็น heading ที่ถูกต้องตามกฎ
//
// ไม่มี <script> ในไฟล์นี้โดยตั้งใจ ตัวที่เคยมี query `.icon` `.faq-content`
// `.faq-item` ทั้งเอกสาร ไม่ใช่แค่ใน component ตัวเอง accordion ตัวที่สองบนหน้า
// เดียวกันจึงถูกปิดและรีเซ็ตไอคอนไปด้วย — `name` บน <details> ให้พฤติกรรม
// เปิดได้ทีละอันจากเบราว์เซอร์เอง และ scope อยู่แค่กลุ่มนี้
//
// รอบนี้ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น (src/pages/ตรวจหวย.astro ·
// src/pages/แนวทาง.astro) ส่วนที่เหลือของเว็บใช้ Faq3 — ข้อยกเว้น Phase 4.5
// คุ้มครอง **ชุดคอมโพเนนต์** ของสองหน้านั้น ไม่ได้คุ้มครองสีหรือชื่อแบรนด์
//
// พาเลตรอบนี้ (brand-spec §2 — แดงเลือดหมูนำ **ธีมสว่าง**): ไฟล์นี้เป็นโซน "เนื้อหา"
// จึงเป็นการ์ดสว่างหมึกเข้ม — แถวคำถามพื้นขาว #ffffff ในกรอบแดงสด #c30303 คำตอบ
// ตกลงไปที่ชั้นอินเซ็ต #fff1ef หมึกคำตอบ #4a0f0f (15.4:1) คำถาม #c30303 (6.3:1)
// ปุ่ม + เป็น #c30303 บนพื้น #fff1ef แล้วกลับเป็นพื้นถมแดง #c30303 กับตัวอักษรขาว
// (6.3:1) ตอนเปิด หัวข้อไล่เฉด #4a0f0f → #c30303 → #4a0f0f (ทุกสต็อปอ่านได้บน
// พื้นเพจ #ffdbdb) glow เป็น rgba(195,3,3,*) กับ rgba(74,15,15,*)
// ⚠️ ไม่มีทองโบราณทั้งสามค่า (#dcb95f #b8862b #96681f) ในไฟล์นี้ — บนการ์ดขาวได้แค่
// 1.9–3.5:1 ตกเกณฑ์ ทองเป็นสีของโครมเท่านั้น และไม่มีแดงสแกเลต #e81313 เพราะ §2
// ห้ามมันถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร ซึ่งในการ์ดนี้ทุกชั้นมีตัวอักษรอยู่
// ส่วน #8f0505 สงวนไว้ให้ไฮไลต์บน <strong> ในย่อหน้าของหน้าเพจเท่านั้น
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — แดงนำแบรนด์ผ่านรีโปนี้มามากกว่าฮิวอื่น
// ชุดของรอบก่อนทันที เขียวมรกต-ทองสัมฤทธิ์ของ สาธุ168 (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd rgba 11/125/40 a · rgba 12/58/22 a)
// ออกครบทุกจุด · ชุดทอง-ดำของ หวยคิง เจ้าของเดิมของไฟล์ชุด Huay (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · ชุดแดง-ทองของ หวย365 (140203
// dc0203 f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) · ชุดแดงเข้มของ
// รับตัง168 (d30304 a00203 4a0202 2b100f 200a09 140505) ก็ไม่เหลือค่าไหน
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
const { title = "คำถามที่พบบ่อย", as: HeadingTag = "h2", faqs = [] } = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#4a0f0f] via-[#c30303] to-[#4a0f0f] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#c30303]/35 bg-[#ffffff] shadow-[0_4px_14px_rgba(74,15,15,0.08)] transition-all duration-300 hover:border-[#c30303]/75 hover:shadow-[0_10px_25px_rgba(195,3,3,0.18)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#c30303] transition-colors group-hover:text-[#4a0f0f]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#c30303]/55 bg-[#fff1ef] text-sm font-bold text-[#c30303] transition-all duration-300 group-hover:bg-[#c30303] group-hover:text-[#ffffff]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#c30303]/25 bg-[#fff1ef] p-5 text-left text-base leading-relaxed text-[#4a0f0f]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(195, 3, 3, 0.75);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #c30303;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
