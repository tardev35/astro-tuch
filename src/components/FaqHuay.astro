---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

// The defaults are deliberately brand-neutral: every page that renders this
// accordion passes an explicit `faqs` array built from its own brief, so the
// defaults exist only so the component never renders empty.
const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "อัตราจ่ายของหวยแต่ละตลาดดูได้ที่ไหน",
      a: "อัตราจ่ายของทุกประเภทการแทงจะแสดงอยู่ในหน้าของแต่ละตลาดหวย และระบบจะแสดงอัตราจ่ายจริงอีกครั้งบนหน้ายืนยันโพยก่อนกดส่งเสมอ",
    },
    { q: "แทงหวยขั้นต่ำกี่บาท", a: "ระบบรองรับการส่งโพยตั้งแต่จำนวนเงินขั้นต่ำที่กำหนดไว้ในแต่ละตลาด สมาชิกสามารถตรวจสอบจำนวนเงินขั้นต่ำและสูงสุดได้จากหน้ารายละเอียดของตลาดนั้นก่อนส่งโพย" },
    {
      q: "มีเลขอั้นหรือเลขเต็มหรือไม่",
      a: "มีตามรอบที่ยอดแทงเข้ามามาก เลขอั้นจะถูกปรับลดอัตราจ่ายลง ส่วนเลขเต็มจะปิดรับในรอบนั้น ทั้งสองรายการแสดงอยู่ในหน้าตลาดหวยและระบบจะแจ้งให้ทราบก่อนยืนยันโพย",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#2a9d5c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#c1121f]/55 bg-[#3d0b0e]/85 backdrop-blur-md transition-all duration-300 hover:border-[#e3c56a]/60 hover:shadow-[0_10px_25px_rgba(227,197,106,0.15)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <h3 class="text-base leading-normal font-bold text-[#f4e7d3] transition-colors group-hover:text-[#f7e8b4]">{faq.q}</h3>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#c1121f]/70 bg-[#511014] text-sm font-bold text-[#f7e8b4] transition-all duration-300 group-hover:bg-[#e3c56a] group-hover:text-[#1a0405]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#c1121f]/45 bg-[#1a0405]/70 p-5 text-left text-base leading-relaxed text-[#f4e7d3]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* The removed script queried `.icon`, `.faq-content` and `.faq-item` across
     the WHOLE document, not within its own component — so a second accordion
     anywhere on the page would have had its rows closed and its icons reset by
     this one. `name` gives the exclusive behaviour it was reaching for, scoped
     to this group by the browser. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(227, 197, 106, 0.6);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #e3c56a;
    color: #1a0405;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
