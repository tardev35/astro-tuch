---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are the brief's own Q/A pairs,
// verbatim.
//
// The question used to be an <h3>. It is a <p> inside the <summary> now: the
// h2/h3 inventory is diffed against the docx checklist every rebrand, and this
// brand's brief has exactly two H3s, neither of them a question. The accordion
// still works — <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// รอบนี้ไฟล์นี้ถูกเรียกจาก /ตรวจหวย หน้าเดียว ซึ่งเป็นข้อยกเว้น "หน้าหวยคงธีม
// Huay" ของ Phase 4.5 — หน้าแรกใช้ Faq2 ของพาเลตต์เขียว-ทองหลัก
//
// 888PARUAY (รอบทอง-แดง 2026-09-24): ธีม Huay คือแดง-ทอง ค่าสีสร้างใหม่จาก
// พาเลตต์แบรนด์นี้ — แถวคำถามเป็นพื้นการ์ด #240808 ในกรอบทองลึก #a87d0c คำตอบ
// ตกลงไปที่พื้นลึก #140404 ปุ่ม + เป็นทองอ่อน #fff6ae บนพื้นลึก แล้วกลับสีเป็น
// ทองหลัก #fcdc2b บนตัวอักษรพื้นลึกตอนเปิด หัวข้อไล่ทองอ่อน → ทองหลัก → แดงสด
// #cf1111 ตามลำดับสีบนโลโก้ — ชุดของ 365LOTTO (#fadc64 #fdf3b4 #9c6a12 #e01f26
// #f0ddc4 #1a0709 #2a0b0e #120406 #f3f6fa) และชุดกรมท่า-ทองของหวยพยัคฆ์
// (#030b1c #08152f #0f2149 #1c3566 #dbe4f7 #e8eef8 #fadb6c #fdf5a4 #ab6d13)
// ออกทั้งหมด
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: "888PARUAY มีหวยประเภทไหนให้แทงบ้าง?",
      a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหุ้นต่างประเทศ โดยรายการที่เปิดรับและช่วงเวลาของแต่ละรอบอาจแตกต่างกัน ผู้ใช้งานสามารถตรวจสอบข้อมูลล่าสุดจากหน้ารวมหวยก่อนยืนยันรายการ",
    },
    {
      q: "888PARUAY เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
      a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 โดยควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบอีกครั้งก่อนทำรายการ",
    },
    {
      q: "สามารถตรวจหวยผ่าน 888PARUAY ได้หรือไม่?",
      a: "สามารถตรวจสอบผลหวยตามรายการที่เว็บไซต์เปิดให้บริการได้ โดยเลือกประเภทหวยและรอบที่ต้องการจากหน้าตรวจผล ช่วยให้ติดตามทั้งรัฐบาลไทย ฮานอย ลาวพัฒนา และรายการอื่นได้จากหน้าเดียว",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <HeadingTag class="bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#cf1111] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
      >{title}</HeadingTag
    >
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#a87d0c]/55 bg-[#240808]/90 backdrop-blur-md transition-all duration-300 hover:border-[#fcdc2b]/65 hover:shadow-[0_10px_25px_rgba(252,220,43,0.2)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#e8e4c6] transition-colors group-hover:text-[#fcdc2b]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#a87d0c]/70 bg-[#140404] text-sm font-bold text-[#fff6ae] transition-all duration-300 group-hover:bg-[#fcdc2b] group-hover:text-[#140404]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#a87d0c]/45 bg-[#140404]/90 p-5 text-left text-base leading-relaxed text-[#e8e4c6]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(252, 220, 43, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #fcdc2b;
    color: #140404;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
