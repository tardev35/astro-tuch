---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are the brief's own Q/A pairs,
// verbatim.
//
// The question is a <p> inside the <summary>, never an <h3>: the h2/h3
// inventory is diffed against the docx checklist every rebrand, and this
// brand's brief has exactly two H3s, neither of them a question. The accordion
// still works — <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): ธีม Huay คือแดง-ทอง ซึ่งตรงกับแบรนด์นี้พอดี
// แต่ค่าสีสร้างใหม่จากพาเลตต์แบรนด์นี้ทั้งชุด — แถวคำถามเป็นพื้นการ์ด #2a0405 ใน
// กรอบทองลึก #a16207 คำตอบตกลงไปที่พื้นลึก #140202 ปุ่ม + เป็นทองอ่อน #fde68a บน
// พื้นลึก แล้วกลับสีเป็นทองหลัก #fbbf24 บนตัวอักษรพื้นลึกตอนเปิด หัวข้อไล่ทองอ่อน →
// ทองหลัก → แดงสว่าง #fc2b2c ตามลำดับทอง-แดงบนงานอาร์ต เนื้อความ #f6e2e2
// (BRAND_TEXT) — ชุดของ 888PARUAY (#fcdc2b #fff6ae #a87d0c #cf1111 #240808
// #140404 #e8e4c6) ออกทั้งหมด
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: "LOTTO24 เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
      a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวสูงสุด 1,000 โดยอัตราจริงและเงื่อนไขอาจแตกต่างกันตามประเภทหวยและรอบที่เปิดรับ ควรตรวจสอบรายละเอียดก่อนยืนยันบิลทุกครั้ง",
    },
    {
      q: "LOTTO24 ทำรายการผ่านบัญชีบริษัทได้หรือไม่?",
      a: "ตามข้อมูลของเว็บไซต์ รองรับการทำรายการผ่านช่องทางบัญชีบริษัทโดยตรง รวมถึงวอลเลทตามรายการที่ระบบเปิดให้ใช้งาน สมาชิกควรตรวจสอบชื่อบัญชีและรายละเอียดจากช่องทางทางการก่อนทำรายการ",
    },
    {
      q: "LOTTO24 มีโปรโมชั่นอะไรบ้าง?",
      a: "โปรโมชั่นหลักตามข้อมูลที่กำหนดมีโบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% โดยแต่ละรายการมีเงื่อนไขและรอบรับสิทธิ์แตกต่างกัน แนะนำให้ตรวจสอบหน้าโปรโมชั่นก่อนกดรับทุกครั้ง",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <HeadingTag class="bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
      >{title}</HeadingTag
    >
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#a16207]/55 bg-[#2a0405]/90 backdrop-blur-md transition-all duration-300 hover:border-[#fbbf24]/65 hover:shadow-[0_10px_25px_rgba(251,191,36,0.2)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#f6e2e2] transition-colors group-hover:text-[#fbbf24]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#a16207]/70 bg-[#140202] text-sm font-bold text-[#fde68a] transition-all duration-300 group-hover:bg-[#fbbf24] group-hover:text-[#140202]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#a16207]/45 bg-[#140202]/90 p-5 text-left text-base leading-relaxed text-[#f6e2e2]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(251, 191, 36, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #fbbf24;
    color: #140202;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
