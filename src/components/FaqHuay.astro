---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

// Rendered only by /ตรวจหวย, which always passes an explicit `faqs` array built
// from this brand's brief. The defaults below exist so the component can never
// render empty — they are kept in step with the current brand for the same
// reason AnnouncementHuay's default message is: a stale default is the classic
// place a previous brand's copy survives a rebrand unnoticed.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "ตรวจโพย LOTTOKA ย้อนหลังได้ที่ไหน",
      a: "เปิดประวัติโพยในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรอบที่ส่ง เลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนส่งโพย ทำให้เทียบกับสถานะที่ระบบอัปเดตหลังตรวจสอบเสร็จได้ทันที",
    },
    {
      q: "โพยที่ถูกรางวัลคิดยอดตามเรทเท่าไร",
      a: "อัตราจ่ายของ LOTTOKA คือเลข 2 ตัวบาทละ 100 และเลข 3 ตัวตรงบาทละ 1,000 จ่ายเต็มทุกบิล ไม่หักเปอร์เซ็นต์ โดยยอดตามเรทคำนวณจากอัตราจ่ายที่ระบบแสดงบนหน้าส่งโพย ณ ตอนที่กดยืนยันรายการ และอัตรานั้นถูกบันทึกไว้ในบิลของรอบนั้น",
    },
    {
      q: "สถานะบิลไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร",
      a: "ตรวจสอบประวัติโพยหรือธุรกรรมในบัญชีก่อน หากยังพบความผิดปกติ ให้ติดต่อแอดมิน LOTTOKA ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการ เพื่อให้ตรวจสอบต่อได้ตรงจุด",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#c21e22]/55 bg-[#3a0709]/85 backdrop-blur-md transition-all duration-300 hover:border-[#e2353a]/60 hover:shadow-[0_10px_25px_rgba(226,53,58,0.18)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <h3 class="text-base leading-normal font-bold text-[#ded9da] transition-colors group-hover:text-[#ff9a9d]">{faq.q}</h3>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#c21e22]/70 bg-[#7d1114] text-sm font-bold text-[#ffe9ea] transition-all duration-300 group-hover:bg-[#e2353a] group-hover:text-[#0a0608]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#c21e22]/45 bg-[#140a0c]/80 p-5 text-left text-base leading-relaxed text-[#ded9da]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(226, 53, 58, 0.6);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #e2353a;
    color: #0a0608;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
