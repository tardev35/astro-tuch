---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

import { BRAND_NAME } from "../lib/brandProfile";

// index.astro ส่ง `faqs` มาแบบระบุชัดเจน แต่ /ตรวจหวย หรือการเรียกแบบเปล่าอาจตกมาที่
// default ด้านล่าง — default จึงต้องเป็นคำของแบรนด์ปัจจุบันเสมอ ไม่ใช่ filler กลาง ๆ
// default ที่ค้างของแบรนด์ก่อนคือจุดคลาสสิกที่สุดที่เนื้อหาแบรนด์เก่ารอดข้ามรีแบรนด์
// สามคู่ด้านล่างคือ Q/A ของบรีฟรอบนี้เอง (src/assets/content.txt บรรทัด 23–28)
// คำต่อคำ โดยชื่อแบรนด์มาจาก BRAND_NAME ไม่พิมพ์ทับ
//
// คำถามเป็น <p> ใน <summary> ไม่ใช่ heading: รายการ h2/h3 ถูก diff กับ checklist ของ
// บรีฟทุกรอบ และไม่มีหัวข้อไหนในบรีฟที่เป็นประโยคคำถาม accordion ยังทำงานได้
// เพราะตัวควบคุมคือ <summary> ไม่ใช่แท็กข้างใน ส่วน `title` มาจาก prop (คือมาจาก
// บรีฟ) จึงเป็น heading ที่ถูกต้องตามกฎ
//
// ไม่มี <script> ในไฟล์นี้โดยตั้งใจ ตัวที่เคยมี query `.icon` `.faq-content`
// `.faq-item` ทั้งเอกสาร ไม่ใช่แค่ใน component ตัวเอง accordion ตัวที่สองบนหน้า
// เดียวกันจึงถูกปิดและรีเซ็ตไอคอนไปด้วย — `name` บน <details> ให้พฤติกรรม
// เปิดได้ทีละอันจากเบราว์เซอร์เอง และ scope อยู่แค่กลุ่มนี้
//
// พาเลตต์รอบนี้ (brand-spec §2 ทองบนดำอมน้ำตาล): แถวคำถามเป็นพื้น #1c140b ในกรอบ
// ทองแบรนด์ #cd9a2c คำตอบตกลงไปที่พื้นลึกสุด #0c0b0a เส้นคั่นจาง #5c3f12 ปุ่ม +
// เป็นทองสว่าง #fdeb7c บนพื้น #0c0b0a แล้วกลับสีเป็นพื้นทอง #fdeb7c กับหมึกดำ
// อมน้ำตาล #120a02 ตอนเปิด (หมึกเข้มบนพื้นทองได้ 16:1 ห้ามสลับทาง) หัวข้อไล่
// ทองสว่าง #fdeb7c → ทองแบรนด์ #cd9a2c → ครีมอมพีช #fcd4c3 เนื้อความ #f5e7c8
// glow เป็น rgba(205,154,44,*) ชุดแดง-ทองของรอบก่อน (#240406 #180303 #c08a07
// #ffeab0 #ffc93c #1a0303 #f5282a #f6e7e0 rgba(255,201,60,*)) ออกครบทุกจุดแล้ว
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: `${BRAND_NAME} รับแทงเลขเด็ดและเลขดังทุกตัวหรือไม่?`,
      a: "สามารถเลือกเลขตามรายการที่ระบบเปิดรับ แต่เลขบางชุดอาจมีวงเงินแตกต่างกัน โดยเฉพาะเลขที่มียอดเดิมพันสูง ควรกรอกเลขและตรวจสอบยอดสูงสุดที่ระบบรับได้ก่อนส่งโพยทุกครั้ง",
    },
    {
      q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 จริงหรือไม่?`,
      a: "หากรายการนั้นเข้าเงื่อนไข ระบบสามารถกำหนดอัตรา 2 ตัว 100 บาท และ 3 ตัว 1,000 บาท ได้ แต่อัตราจริงอาจขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพัน จึงควรตรวจสอบราคาบนหน้าส่งโพยก่อนยืนยัน",
    },
    {
      q: `${BRAND_NAME} ฝากเงินเข้าบัญชีบริษัทโดยตรงหรือไม่?`,
      a: "หากเว็บไซต์ระบุว่าใช้บัญชีบริษัทโดยตรง ควรมีชื่อบัญชีและข้อมูลนิติบุคคลให้ตรวจสอบ สมาชิกควรเปรียบเทียบชื่อผู้รับกับข้อมูลที่เว็บไซต์ประกาศก่อนโอน และไม่ควรใช้ข้อความประชาสัมพันธ์เพียงอย่างเดียวเป็นหลักฐานว่าบัญชีนั้นเป็นบัญชีบริษัท",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#fdeb7c] via-[#cd9a2c] to-[#fcd4c3] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#cd9a2c]/55 bg-[#1c140b]/90 backdrop-blur-md transition-all duration-300 hover:border-[#fdeb7c]/65 hover:shadow-[0_10px_25px_rgba(205,154,44,0.22)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#f5e7c8] transition-colors group-hover:text-[#fdeb7c]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#cd9a2c]/70 bg-[#0c0b0a] text-sm font-bold text-[#fdeb7c] transition-all duration-300 group-hover:bg-[#fdeb7c] group-hover:text-[#120a02]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#5c3f12] bg-[#0c0b0a]/90 p-5 text-left text-base leading-relaxed text-[#f5e7c8]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(253, 235, 124, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #fdeb7c;
    color: #120a02;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
