---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// `faqs` ต้องว่างเป็นค่าเริ่มต้น ห้ามมีรายการ Q/A เป็น default
// ทุกหน้าที่เรนเดอร์ FAQ ส่ง `faqs` มาจากบรีฟของตัวเองอยู่แล้ว ส่วน default ที่เคยมี
// Q/A ติดอยู่คือช่องทางคลาสสิกที่สุดที่คำถามของแบรนด์ก่อนหลุดขึ้น production:
// หน้าที่ลืมส่ง prop จะเงียบ ๆ ขึ้นเนื้อหาของลูกค้าอีกเจ้าแทนที่จะว่างให้เห็นว่าลืม
//
// คำถามเป็น <p> ใน <summary> ไม่ใช่ heading: รายการ h2/h3 ถูก diff กับ checklist ของ
// บรีฟทุกรอบ และไม่มีหัวข้อไหนในบรีฟที่เป็นประโยคคำถาม accordion ยังทำงานได้
// เพราะตัวควบคุมคือ <summary> ไม่ใช่แท็กข้างใน ส่วน `title` มาจาก prop (คือมาจาก
// บรีฟ) จึงเป็น heading ที่ถูกต้องตามกฎ
//
// ไม่มี <script> ในไฟล์นี้โดยตั้งใจ ตัวที่เคยมี query `.icon` `.faq-content`
// `.faq-item` ทั้งเอกสาร ไม่ใช่แค่ใน component ตัวเอง accordion ตัวที่สองบนหน้า
// เดียวกันจึงถูกปิดและรีเซ็ตไอคอนไปด้วย — `name` บน <details> ให้พฤติกรรม
// เปิดได้ทีละอันจากเบราว์เซอร์เอง และ scope อยู่แค่กลุ่มนี้
//
// พาเลตต์รอบนี้ (brand-spec §2 เขียวมรกตบนธีมสว่าง): ไฟล์นี้เป็นโซน "เนื้อหา" จึงเป็น
// การ์ดสว่างหมึกเข้ม — แถวคำถามพื้นขาว #ffffff ในกรอบเขียวมรกต #0b7d28 คำตอบตกลงไป
// ที่ชั้นอินเซ็ต #e9fbdd หมึกคำตอบ #0c3a16 (12.9:1) คำถาม #0a5f1c (7.9:1) ปุ่ม +
// เป็น #0a5f1c บนพื้น #e9fbdd แล้วกลับเป็นพื้นถมเขียว #0b7d28 กับตัวอักษรขาว (5.3:1)
// ตอนเปิด หัวข้อไล่เฉดหมึกเขียวป่า #0c3a16 → เขียวเข้ม #0a5f1c → เขียวมรกต #0b7d28
// (ทั้งสามค่าอ่านได้บนพื้นเพจ #d8ffc7) glow เป็น rgba(11,125,40,*)
// ⚠️ ไม่มีสีทองสัมฤทธิ์ทั้งสามค่าในไฟล์นี้ — บนการ์ดขาวได้แค่ 1.7–2.8:1 ตกเกณฑ์
// ทองเป็นสีของโครมเท่านั้น และไม่มีเขียวใบตอง (stop สว่างสุดของพาเลต) เพราะมัน
// ห้ามถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร ซึ่งในการ์ดนี้ทุกชั้นมีตัวอักษรอยู่
// ค่าของแบรนด์ก่อน ๆ (ชุดทอง-ดำของเจ้าของเดิมของไฟล์ชุด *Huay ชุดแดง-ทองก่อนหน้านั้น
// และชุดชมพูของรอบที่แล้ว) ออกครบทุกจุดแล้ว — เทียบทีละค่ากับตารางใน brand-spec §2
const { title = "คำถามที่พบบ่อย", as: HeadingTag = "h2", faqs = [] } = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#0c3a16] via-[#0a5f1c] to-[#0b7d28] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#0b7d28]/35 bg-[#ffffff] shadow-[0_4px_14px_rgba(12,58,22,0.08)] transition-all duration-300 hover:border-[#0b7d28]/75 hover:shadow-[0_10px_25px_rgba(11,125,40,0.18)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#0a5f1c] transition-colors group-hover:text-[#0b7d28]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#0b7d28]/55 bg-[#e9fbdd] text-sm font-bold text-[#0a5f1c] transition-all duration-300 group-hover:bg-[#0b7d28] group-hover:text-[#ffffff]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#0b7d28]/25 bg-[#e9fbdd] p-5 text-left text-base leading-relaxed text-[#0c3a16]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(11, 125, 40, 0.75);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #0b7d28;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
