---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

import { BRAND_NAME } from "../lib/brandProfile";

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are the current brief's own
// Q/A pairs out of src/assets/content.txt (L21–L26), verbatim, with the brand
// name coming from BRAND_NAME rather than being retyped.
//
// The question is a <p> inside the <summary>, never a heading: the h2/h3
// inventory is diffed against the docx checklist every rebrand, and none of
// this brand's docx headings is a question. The accordion still works —
// <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// ธีม Huay แดง-ทอง-ดำ ของหมวดหวย (/ตรวจหวย, /แนวทาง) คงรูปทรงไว้ตามข้อยกเว้นใน
// SKILL.md Phase 4.5 ข้อ 5 แต่ค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้
// แถวคำถามเป็นพื้น #240406 ในกรอบทองลึก #c08a07 คำตอบตกลงไปที่พื้น #180303 ปุ่ม +
// เป็นทองอ่อน #ffeab0 บนพื้น #180303 แล้วกลับสีเป็นทอง #ffc93c กับหมึกดำอมแดง
// #1a0303 ตอนเปิด (หมึกเข้มบนพื้นทองได้ 11.6:1 ส่วนหมึกเข้มบนพื้นแดงตก จึงห้ามสลับ)
// หัวข้อไล่ทองอ่อน #ffeab0 → ทอง #ffc93c → แดงสว่าง #f5282a เนื้อความ #f6e7e0
// ชุดเดิมของรอบ หวยเฮง789 (#2b0909 #1c0606 #a8690c #f4bc5d #ffefc2 #e43434
// #fbe3d4 rgba(244,188,93,*)) ออกครบทุกจุดแล้ว
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: `${BRAND_NAME} มีหวยอะไรให้เลือกบ้าง?`,
      a: "มีรัฐบาลไทย ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน สามารถตรวจสอบตารางหวย เวลาปิดรับ อัตราจ่าย และผลของแต่ละรอบได้จากหน้าเว็บไซต์",
    },
    {
      q: `สถิติหวยและแนวทาง${BRAND_NAME} ใช้ทำนายเลขงวดต่อไปได้หรือไม่?`,
      a: "สถิติย้อนหลังช่วยให้ดูผลและรูปแบบตัวเลขที่เคยออก ส่วนแนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ไม่สามารถรับประกันผลของงวดถัดไปได้ เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา",
    },
    {
      q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับหวยทุกประเภทหรือไม่?`,
      a: "ขึ้นอยู่กับประเภทหวยและเงื่อนไขของแต่ละรอบ อัตรา 2 ตัว 100 และ 3 ตัว 1,000 ควรตรวจสอบจากหน้าส่งโพยก่อนเดิมพันทุกครั้ง เนื่องจากบางรายการอาจกำหนดอัตราหรือวงเงินแตกต่างกัน",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#c08a07]/55 bg-[#240406]/90 backdrop-blur-md transition-all duration-300 hover:border-[#ffc93c]/65 hover:shadow-[0_10px_25px_rgba(255,201,60,0.22)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#f6e7e0] transition-colors group-hover:text-[#ffc93c]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#c08a07]/70 bg-[#180303] text-sm font-bold text-[#ffeab0] transition-all duration-300 group-hover:bg-[#ffc93c] group-hover:text-[#1a0303]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#c08a07]/45 bg-[#180303]/90 p-5 text-left text-base leading-relaxed text-[#f6e7e0]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(255, 201, 60, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #ffc93c;
    color: #1a0303;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
