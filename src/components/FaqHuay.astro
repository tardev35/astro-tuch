---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

import { BRAND_NAME } from "../lib/brandProfile";

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are the current brief's own
// Q/A pairs out of src/assets/content.txt (L23–L28), with the brand name coming
// from BRAND_NAME rather than being retyped.
//
// The question is a <p> inside the <summary>, never a heading: the h2/h3
// inventory is diffed against the docx checklist every rebrand, and none of
// this brand's docx headings is a question. The accordion still works —
// <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// ธีม Huay แดง-ทอง-ดำ ของหมวดหวย (/ตรวจหวย, /แนวทาง) คงไว้ตามข้อยกเว้นใน
// SKILL.md Phase 4.5 ข้อ 5 — ไม่ถูกดึงไปพาเลตต์เขียว-ทองของแบรนด์รอบนี้
// แถวคำถามเป็นพื้นดำอมแดง #1f0a0c ในกรอบทองลึก #8a6a0a คำตอบตกลงไปที่พื้นการ์ด
// #120b0c ปุ่ม + เป็นทองอ่อน #fde79a บนพื้นการ์ด แล้วกลับสีเป็นทองรอง #f3c623
// กับหมึกดำอมแดง #1a0203 ตอนเปิด (หมึกเข้มบนพื้นทองได้ 12.4:1 ส่วนหมึกเข้มบน
// พื้นแดงตก จึงห้ามสลับ) หัวข้อไล่ทองอ่อน → ทองรอง → แดงสว่าง #ff2d38
// เนื้อความ #f0e2e2
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: `${BRAND_NAME} มีหวยประเภทไหนเปิดให้แทงบ้าง?`,
      a: "มีทั้งรัฐบาลไทย ลาวพัฒนา ฮานอยปกติ ฮานอยพิเศษ ฮานอยวีไอพี และหวยหุ้นต่างประเทศตามรายการที่ระบบเปิดรับในแต่ละวัน ควรตรวจสอบตารางและเวลาปิดรับก่อนส่งโพยทุกครั้ง",
    },
    {
      q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?`,
      a: "อัตราจ่ายขึ้นอยู่กับประเภทหวยและรูปแบบการเดิมพันที่ร่วมเงื่อนไข จึงควรตรวจสอบอัตราที่แสดงในหน้าส่งโพยก่อนยืนยัน ไม่ควรถือว่าอัตรา 2 ตัว 100 และ 3 ตัว 1,000 ใช้เหมือนกันทุกประเภท",
    },
    {
      q: `สมัคร ${BRAND_NAME} ผ่านมือถือได้หรือไม่?`,
      a: "หากเว็บไซต์รองรับการใช้งานผ่านเว็บเบราว์เซอร์ สามารถสมัคร Login เลือกรายการหวย และส่งโพยผ่านมือถือได้โดยตรง หลังสมัครควรตรวจสอบข้อมูลบัญชีและตั้งรหัสผ่านให้ปลอดภัยก่อนเริ่มใช้งาน",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#ff2d38] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#8a6a0a]/55 bg-[#1f0a0c]/90 backdrop-blur-md transition-all duration-300 hover:border-[#f3c623]/65 hover:shadow-[0_10px_25px_rgba(243,198,35,0.22)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#f0e2e2] transition-colors group-hover:text-[#f3c623]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#8a6a0a]/70 bg-[#120b0c] text-sm font-bold text-[#fde79a] transition-all duration-300 group-hover:bg-[#f3c623] group-hover:text-[#1a0203]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#8a6a0a]/45 bg-[#120b0c]/90 p-5 text-left text-base leading-relaxed text-[#f0e2e2]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(243, 198, 35, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #f3c623;
    color: #1a0203;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
