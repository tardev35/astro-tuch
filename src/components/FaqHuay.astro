---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The brief's heading level for "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// `faqs` ต้องว่างเป็นค่าเริ่มต้น ห้ามมีรายการ Q/A เป็น default
// ทุกหน้าที่เรนเดอร์ FAQ ส่ง `faqs` มาจากบรีฟของตัวเองอยู่แล้ว ส่วน default ที่เคยมี
// Q/A ติดอยู่คือช่องทางคลาสสิกที่สุดที่คำถามของแบรนด์ก่อนหลุดขึ้น production:
// หน้าที่ลืมส่ง prop จะเงียบ ๆ ขึ้นเนื้อหาของลูกค้าอีกเจ้าแทนที่จะว่างให้เห็นว่าลืม
//
// คำถามเป็น <p> ใน <summary> ไม่ใช่ heading: รายการ h2/h3 ถูก diff กับ checklist ของ
// บรีฟทุกรอบ และไม่มีหัวข้อไหนในบรีฟที่เป็นประโยคคำถาม accordion ยังทำงานได้
// เพราะตัวควบคุมคือ <summary> ไม่ใช่แท็กข้างใน ส่วน `title` มาจาก prop (คือมาจาก
// บรีฟ) จึงเป็น heading ที่ถูกต้องตามกฎ และต้องเคารพ prop `as` เสมอ
//
// ไม่มี <script> ในไฟล์นี้โดยตั้งใจ ตัวที่เคยมี query `.icon` `.faq-content`
// `.faq-item` ทั้งเอกสาร ไม่ใช่แค่ใน component ตัวเอง accordion ตัวที่สองบนหน้า
// เดียวกันจึงถูกปิดและรีเซ็ตไอคอนไปด้วย — `name` บน <details> ให้พฤติกรรม
// เปิดได้ทีละอันจากเบราว์เซอร์เอง และ scope อยู่แค่กลุ่มนี้
// 🚨 **ห้าม reintroduce accordion แบบ button + max-height + <script>**
//
// รอบนี้ (ดรอป 2026-10-27) ไฟล์นี้ถูก render จาก **/ตรวจหวย กับ /แนวทาง** ซึ่ง
// ถูกย้ายกลับเข้า src/pages/ เพราะแบรนด์รอบนี้เป็นเว็บหวย (หน้าแรกหมุนไปใช้ FAQ
// variant ตัวอื่น) — **ห้ามลบ variant ที่ไม่ได้ใช้** มันคือ inventory ของแบรนด์ถัดไป
//
// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ (Tailwind สแกนคอมเมนต์ด้วย) และ
// **ห้ามเขียน "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้** — การ sweep ไล่หา
// สีของแบรนด์เก่าใน src/ จะสะดุดที่คอมเมนต์ของตัวเองทุกครั้ง
// **ลิสต์ค่าต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lotto189.md` §2 ที่เดียว**
//
// 🚨🚨 **รอบก่อนไฟล์นี้เป็น "การ์ดมืดหมึกสว่าง" (ผิวเข้ม + ทอง) — รอบนี้พลิกกลับ
// เป็น "การ์ดสว่างหมึกเข้ม" ทั้งไฟล์**
// พื้นเพจรอบนี้คือ **ขาวอมชมพูจาง #fff0f0** (จาก bg.json ซึ่งเป็นแหล่งเดียวของ
// พื้นเพจ — เปิดอ่านทุกรอบ ห้ามสืบทอดค่าข้ามรอบ) การ์ดมืดบนพื้นนั้นจะเป็นแผ่นดำ
// กลางหน้า ไม่เข้ากับทั้งเว็บ **ห้าม "แก้" กลับไปเป็นพื้นมืด**
//
// พาเลตรอบนี้ (`.claude/brand-spec-lotto189.md` §2 — แดงเลือดนกนำ ทองเข้มคู่รอง
// **เนื้อหาเป็นผิวสว่าง**):
//   แถวคำถามพื้นผิวการ์ด #ffffff ในกรอบ #f5b9bd คำตอบตกลงไปที่ชั้นยก #ffe4e6
//   หมึกคำตอบ #25090f (16.4:1 บน #ffe4e6 · 18.7:1 บนขาว) คำถามแดงเลือดนก
//   #b00718 (7.3:1 บนขาว) และเข้มขึ้นเป็นแดงลึก #8a0412 (10.4:1) ตอน hover
//   ปุ่ม + เป็น #b00718 บนพื้น #ffe4e6 แล้วกลับเป็นพื้นถม #b00718 กับ
//   **หมึกขาว #ffffff** (7.3:1) ตอนเปิด
//   หัวข้อไล่เฉด #8a0412 → #b00718 → #8a0412 (ทุกสต็อปอ่านได้บนพื้นเพจ #fff0f0:
//   10.0 / 7.0 / 10.0) ซึ่งอ่านเป็นเวิร์ดมาร์กจริง — ตัวอักษรละตินผิวโครเมียม
//   ตัดขอบแดง ต่อด้วยตัวเลขผิวแดงเลือดนก
//   glow เป็น rgba(176,7,24,*) กับ rgba(138,4,18,*)
// ⚠️⚠️ **ขาวบนพื้นเพจ #fff0f0 ได้แค่ 1.07:1** — ตัวอักษรที่วางบนพื้นเพจตรง ๆ
// ต้องเป็นหมึกเข้มเท่านั้น หัวข้อของไฟล์นี้จึงเป็นแดงลึก/แดงเลือดนกล้วน
// ⚠️ **ห้ามใช้ #ff2436 (3.9:1) #e9b53c (2.0:1) #f5b9bd #ffd4d7 #c3ccd6 #a8333f
// ถือตัวอักษร** ในไฟล์นี้ — เป็นพื้น/ขอบเท่านั้น
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) · rgba(138,4,18,α) ·
// rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดง/ทอง/ครีมผ่านรีโปนี้มามากกว่า
// ฮิวอื่น** และไฟล์ชุด Huay ก็เคยเป็นของแบรนด์หวยเจ้าก่อน ๆ หลายเจ้าที่ใช้
// แดง/ทองใกล้กันมาก → **"เจอแดง/ทอง ≠ เป็นของรอบนี้"** ทุกค่าในไฟล์นี้ต้องตรงกับ
// ตารางใน §2 ของ brand-spec ทีละหกหลัก **ห้ามตัดสินด้วยสายตา** และถ้าเจอค่าที่
// ต่างจาก §2 แค่ไบต์เดียว ให้ถือว่า **พิมพ์ผิด** ก่อนเสมอ ไม่ใช่ "มันก็แดงเหมือนกัน"
// ⚠️ รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพูบับเบิลกัม ไม่มีเขียวแบรนด์ และ
// ไม่มีส้มเพลิงเลยสักเฉด (เขียว #00B900 ของปุ่ม LINE และเขียว success ของฟีด
// ถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามเปลี่ยน)
const { title = "คำถามที่พบบ่อย", as: HeadingTag = "h2", faqs = [] } = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag class="mb-6 bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#8a0412] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent">{title}</HeadingTag>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#f5b9bd] bg-[#ffffff] shadow-[0_4px_14px_rgba(176,7,24,0.1)] transition-all duration-300 hover:border-[#b00718]/70 hover:shadow-[0_10px_25px_rgba(176,7,24,0.18)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#b00718] transition-colors group-hover:text-[#8a0412]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#b00718]/45 bg-[#ffe4e6] text-sm font-bold text-[#b00718] transition-all duration-300 group-hover:bg-[#b00718] group-hover:text-[#ffffff]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#f5b9bd] bg-[#ffe4e6] p-5 text-left text-base leading-relaxed text-[#25090f]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(176, 7, 24, 0.7);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #b00718;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
