---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

// Rendered only by /ตรวจหวย, which always passes an explicit `faqs` array built
// from this brand's brief. The defaults below exist so the component can never
// render empty — they are kept in step with the current brand for the same
// reason AnnouncementHuay's default message is: a stale default is the classic
// place a previous brand's copy survives a rebrand unnoticed. These three are
// the brief's own Q/A pairs, verbatim.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// พาเลตต์กรมท่า-ทองตาม §2 ของ brand spec — แดงของแบรนด์ก่อนหน้าออกทั้งหมด
const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "หวยพยัคฆ์ มีหวยประเภทไหนให้เลือกบ้าง?",
      a: "ภายในระบบมีทั้งรัฐบาลไทย หวยฮานอย ลาวพัฒนา และหวยหุ้นต่างประเทศ โดยรายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา สามารถตรวจสอบรอบล่าสุดได้จากหน้ารวมหวยก่อนทำรายการ",
    },
    {
      q: "หวยพยัคฆ์ เลข 2 ตัวและ 3 ตัวจ่ายเท่าไร?",
      a: "ตามข้อมูลที่กำหนด เลข 2 ตัวมีอัตราจ่าย 100 และเลข 3 ตัวมีอัตราจ่าย 1,000 โดยควรตรวจสอบเงื่อนไขและรายละเอียดของแต่ละรอบก่อนยืนยันรายการทุกครั้ง",
    },
    {
      q: "สมัครหวยพยัคฆ์ ต้องทำอย่างไร?",
      a: "เริ่มจากกรอกข้อมูลในหน้าสมัคร ตรวจสอบรายละเอียดให้ถูกต้อง แล้วกดยืนยันบัญชี เมื่อสมัครเสร็จสามารถเข้าสู่ระบบเพื่อเลือกรายการหวย รอบที่เปิดรับ และเลขที่ต้องการได้จากหน้าเว็บไซต์",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-[#e8eef8] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#ab6d13]/45 bg-[#0f2149]/90 backdrop-blur-md transition-all duration-300 hover:border-[#fadb6c]/60 hover:shadow-[0_10px_25px_rgba(250,219,108,0.18)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <h3 class="text-base leading-normal font-bold text-[#dbe4f7] transition-colors group-hover:text-[#fadb6c]">{faq.q}</h3>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#ab6d13]/70 bg-[#1c3566] text-sm font-bold text-[#fdf5a4] transition-all duration-300 group-hover:bg-[#fadb6c] group-hover:text-[#030b1c]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#ab6d13]/40 bg-[#08152f]/85 p-5 text-left text-base leading-relaxed text-[#dbe4f7]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(250, 219, 108, 0.6);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #fadb6c;
    color: #030b1c;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
