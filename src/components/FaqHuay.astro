---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are LOTTOPLUS's own Q/A pairs
// out of src/assets/content.txt, verbatim.
//
// The question is a <p> inside the <summary>, never a heading: the h2/h3
// inventory is diffed against the docx checklist every rebrand, and none of
// this brand's docx headings is a question. The accordion still works —
// <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): แบรนด์นี้เป็นเว็บหวย ธีมแดง-ทองของชุด
// Huay จึงเป็นสีของแบรนด์เอง ไม่ใช่ข้อยกเว้นเฉพาะหน้าหวย — ค่าสีสร้างใหม่จาก
// พาเลตต์ §2 ทั้งชุด: แถวคำถามเป็นพื้นดำอมแดง #1f0a0c ในกรอบทองลึก #8a6a0a
// คำตอบตกลงไปที่พื้นการ์ด #120b0c ปุ่ม + เป็นทองอ่อน #fde79a บนพื้นการ์ด แล้ว
// กลับสีเป็นทองรอง #f3c623 กับหมึกดำอมแดง #1a0203 ตอนเปิด (หมึกเข้มบนพื้นทอง
// ได้ 12.4:1 ส่วนหมึกเข้มบนพื้นแดงตก จึงห้ามสลับ) หัวข้อไล่ทองอ่อน → ทองรอง →
// แดงสว่าง #ff2d38 ตามลำดับทอง-แดงบนงานอาร์ต เนื้อความ #f0e2e2 (BRAND_TEXT) —
// ชุดของ LOTTO24 รอบก่อน (#2a0405 #a16207 #fbbf24 #fde68a #fc2b2c #140202
// #f6e2e2) ออกทั้งหมด
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: "LOTTOPLUS มีหวยประเภทไหนให้เลือกแทงบ้าง?",
      a: "สมาชิกสามารถเลือกหวยรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน โดยควรตรวจสอบเวลาปิดรับ อัตราจ่าย และรายละเอียดของรอบก่อนส่งโพยทุกครั้ง",
    },
    {
      q: "หวย 2 ตัว 100 และหวย 3 ตัว 1,000 ใช้กับหวยทุกประเภทหรือไม่?",
      a: "ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท อัตราจ่ายอาจแตกต่างตามรายการหวย รูปแบบการเดิมพัน และรอบที่เปิดรับ สมาชิกควรตรวจสอบตัวเลขที่ LOTTOPLUS แสดงในหน้าส่งโพยก่อนยืนยันรายการ",
    },
    {
      q: "LOTTOPLUS ต้องดาวน์โหลดแอปก่อนแทงหวยหรือไม่?",
      a: "หากระบบเปิดให้บริการผ่านเว็บไซต์ สมาชิกสามารถสมัคร Login เลือกหวย ส่งโพย และตรวจผลผ่านเว็บเบราว์เซอร์บนมือถือได้โดยไม่จำเป็นต้องติดตั้งแอป ควรเข้าผ่านช่องทางหลักของ LOTTOPLUS เพื่อหลีกเลี่ยงเว็บไซต์ที่ไม่เกี่ยวข้อง",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <HeadingTag class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#ff2d38] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
      >{title}</HeadingTag
    >
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#8a6a0a]/55 bg-[#1f0a0c]/90 backdrop-blur-md transition-all duration-300 hover:border-[#f3c623]/65 hover:shadow-[0_10px_25px_rgba(243,198,35,0.22)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#f0e2e2] transition-colors group-hover:text-[#f3c623]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#8a6a0a]/70 bg-[#120b0c] text-sm font-bold text-[#fde79a] transition-all duration-300 group-hover:bg-[#f3c623] group-hover:text-[#1a0203]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#8a6a0a]/45 bg-[#120b0c]/90 p-5 text-left text-base leading-relaxed text-[#f0e2e2]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(243, 198, 35, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #f3c623;
    color: #1a0203;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
