---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  /** The docx level of "คำถามที่พบบ่อย" on the page rendering this. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  faqs?: FAQ[];
}

import { BRAND_NAME } from "../lib/brandProfile";

// Every consumer passes an explicit `faqs` array built from this brand's brief.
// The defaults below exist so the component can never render empty — they are
// kept in step with the current brand for the same reason AnnouncementHuay's
// default message is: a stale default is the classic place a previous brand's
// copy survives a rebrand unnoticed. These three are the current brief's own
// Q/A pairs out of src/assets/content.txt (L23–L28), verbatim, with the brand
// name coming from BRAND_NAME rather than being retyped.
//
// The question is a <p> inside the <summary>, never a heading: the h2/h3
// inventory is diffed against the docx checklist every rebrand, and none of
// this brand's docx headings is a question. The accordion still works —
// <summary> is the control, not the tag inside it.
//
// No <script> here on purpose. The one this file used to carry queried `.icon`,
// `.faq-content` and `.faq-item` across the WHOLE document rather than its own
// component, so a second accordion on the page would have had its rows closed
// and its icons reset by this one. `name` on <details> gives the browser the
// exclusive behaviour it was reaching for, scoped to this group.
//
// ธีม Huay แดง-ทอง-ดำ ของหมวดหวย (/ตรวจหวย, /แนวทาง) คงรูปทรงไว้ตามข้อยกเว้นใน
// SKILL.md Phase 4.5 ข้อ 5 แต่ค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้
// แถวคำถามเป็นพื้น #2b0909 ในกรอบทองลึก #a8690c คำตอบตกลงไปที่พื้น #1c0606 ปุ่ม +
// เป็นทองอ่อน #ffefc2 บนพื้น #1c0606 แล้วกลับสีเป็นทองรอง #f4bc5d กับหมึกดำอมแดง
// #1c0606 ตอนเปิด (หมึกเข้มบนพื้นทองรองได้ 11.3:1 ส่วนหมึกเข้มบนพื้นแดงแบรนด์ตก
// จึงห้ามสลับ) หัวข้อไล่ทองอ่อน → ทองรอง → แดงสว่าง #e43434 เนื้อความ #fbe3d4
const {
  title = "คำถามที่พบบ่อย",
  as: HeadingTag = "h2",
  faqs = [
    {
      q: `${BRAND_NAME} มีหวยประเภทไหนให้เลือกแทง?`,
      a: "มีทั้งรัฐบาลไทย หวยฮานอย หวยลาว และหวยหุ้นต่างประเทศตามรายการที่ระบบเปิดรับ สมาชิกควรตรวจสอบตารางรอบ เวลาปิดรับ และอัตราจ่ายล่าสุดก่อนส่งโพยทุกครั้ง",
    },
    {
      q: `${BRAND_NAME} แทงเลขเด็ด เลขดัง ได้ไม่จำกัดจริงหรือไม่?`,
      a: "สามารถเลือกเลขที่ต้องการได้ตามรายการที่เปิดรับ แต่จำนวนเงินสูงสุดอาจขึ้นอยู่กับประเภทหวย รอบ และวงเงินของเลขนั้น จึงควรตรวจสอบยอดที่ระบบอนุญาตก่อนยืนยันโพย โดยเฉพาะเลขที่มีผู้เลือกจำนวนมาก",
    },
    {
      q: `${BRAND_NAME} 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?`,
      a: "อัตราจ่ายอาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน ไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน สมาชิกควรตรวจสอบอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของแต่ละรอบก่อนยืนยัน",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <HeadingTag
    class="mb-6 bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#e43434] bg-clip-text text-center text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm"
    >{title}</HeadingTag
  >

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#a8690c]/55 bg-[#2b0909]/90 backdrop-blur-md transition-all duration-300 hover:border-[#f4bc5d]/65 hover:shadow-[0_10px_25px_rgba(244,188,93,0.22)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <p class="text-base leading-normal font-bold text-[#fbe3d4] transition-colors group-hover:text-[#f4bc5d]">{faq.q}</p>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#a8690c]/70 bg-[#1c0606] text-sm font-bold text-[#ffefc2] transition-all duration-300 group-hover:bg-[#f4bc5d] group-hover:text-[#1c0606]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#a8690c]/45 bg-[#1c0606]/90 p-5 text-left text-base leading-relaxed text-[#fbe3d4]">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(244, 188, 93, 0.65);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #f4bc5d;
    color: #1c0606;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
