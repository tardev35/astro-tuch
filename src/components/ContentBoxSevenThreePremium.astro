---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   698..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 600 จึงติดเพดาน
//               max-w-[600px] ของรูป = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (p-10 / gap-10 / pl-10) ไม่ใช่ของ
// ContentBoxSevenThreeNeumorphism ที่เป็นคู่กันบนหน้าเดียวกัน (p-8 แบนๆ / gap-8 /
// pl-8 → 312px และ calc(30vw − 72px)) ห้ามลอกข้ามไฟล์
//
// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13, brand-spec §2-§4): บนหน้าแรกกล่องนี้
// ถือ docx H3 §4 ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ **slide2.png**
// ซึ่งเป็นงานอาร์ตที่พิมพ์คำว่า โปรโมชั่น และ คืนยอดเสีย 0.3% ไว้ในตัวภาพเอง
// ⚠️ **ตัวเลขที่พิมพ์อยู่บนภาพเป็นตัวตัดสินการจับคู่ ไม่ใช่ลำดับไฟล์** — brand-spec §4
// สลับชื่อไฟล์สองตัวนี้ไว้ แต่ภาพจริงบนดิสก์คือ slide2 = คืนยอดเสีย 0.3% และ
// slide1 = แนะนำเพื่อน โบนัส 0.8% ถ้าสลับไปใช้ slide1 ที่นี่ รูปจะขัดกับหัวข้อทันที
//
// นี่คือครึ่ง "การ์ดไล่เฉดมุมโค้ง" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeNeumorphism ที่เป็นคู่กันเป็นแผ่นนูนมุม 25px ผิวกลางทึบ สอง
// บล็อกนี้วางติดกันบนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อย แนะนำเพื่อน 0.8%) จึงต้องไม่
// อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ: ใบนี้ไล่เฉดจากผิวยก #2a0d0f ลงผิวจม #0d0304
// หัวข้อเป็นตัวอักษรไล่เฉดสามสี ส่วนใบคู่เป็นผิวกลางทึบกับหัวข้อแดงสว่างทึบสีเดียว
// ⚠️ พื้นเพจรอบนี้ **ดำสนิท** จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ #0d0304 คือก้นสุด
// กรอบและเส้นคั่นกลางเป็นแดงลึก #8a0206 สว่างขึ้นเป็นแดงแบรนด์ #fb131b ตอน hover
// ออรามุมซ้ายบนเป็นแดงแบรนด์ (ริบบิ้นแสงแดงในงานอาร์ต) มุมขวาล่างเป็นเงินโครเมียม
// สว่าง #e9eef4 (เลข 55 โครเมียมและขอบวงล้อรูเล็ต) ตามคู่โทนของโลโก้
// หัวข้อไล่ เงินโครเมียมสว่าง #e9eef4 → เงินโครเมียมหม่น #aeb9c6 → แดงสว่าง #ff4d55
// ซึ่งเป็นลำดับคนละชุดกับการ์ดคู่ของมันที่ใช้แดงสว่างทึบสีเดียว
// เนื้อความ #f2e4e5 (= BRAND_TEXT) glow ที่ใช้คือ rgba(251,19,27,…) และ
// rgba(233,238,244,…)
// §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษร — ในไฟล์นี้อยู่ที่ขอบ เส้นคั่น
// และออราเท่านั้น และ #ff8a8f ถูกสงวนให้ <strong> ในย่อหน้า จึงไม่โผล่ที่นี่
//
// ⚠️ เทียบสีเป็นค่า ไม่ใช่ตระกูลสี — **กับดักรอบนี้คือแดง**: SUPERSLOTCLUB #e8232a
// (R=232) PIGPG #d4200d (R=212) FLASH877 #ff3b14 (R=255 G=59) ไม่มีตัวไหนเป็น
// #fb131b (R=251 G=19 B=27) ของรอบนี้ ชุดม่วงราชา-ทองของ KMD88 ที่เคยค้างอยู่ทั้ง
// ไฟล์นี้ (#7505cc #b453ff #c07cff #d9b8ff #3a0565 #2c0349 #7a5a0a #e2b33f #ffdf8c
// #ece2f8 #1d0832 #140522 #0a0213) ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (#0360f3
// #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f
// #04186e #021026) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a
// #f0c3dc #fde7f2 #8a0a45 #4a1038 #2a0012 #1c0014) ชุดทองมังกรของ TND168 (#dfa310
// #ffc93d #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b) ชุดทองอำพันเสือของ TIGERWIN369
// (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206)
// และชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffe08a #7d5a07 #464f5a #f2f5f9) ออกครบทุกจุดแล้ว
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a0206] bg-gradient-to-br from-[#2a0d0f]/96 to-[#0d0304]/96 p-8 text-[#f2e4e5] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb131b]/85 hover:shadow-[0_15px_40px_rgba(251,19,27,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fb131b]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#fb131b]/55">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e9eef4]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e9eef4]/20">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e4e5]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e9eef4] via-[#aeb9c6] to-[#ff4d55] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e4e5] md:border-l md:border-[#8a0206] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#e9eef4] via-[#aeb9c6] to-[#ff4d55] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
