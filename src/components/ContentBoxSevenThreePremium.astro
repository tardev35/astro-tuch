---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   md..1279  : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   698..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 600 จึงติดเพดาน
//               max-w-[600px] ของรูป = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (p-10 / gap-10 / pl-10) ไม่ใช่ของ
// ContentBoxSevenThreeCyberCut ที่เป็นคู่กัน (p-8 / gap-8 / pl-8 → 312px และ
// calc(30vw − 72px)) ห้ามลอกข้ามไฟล์
//
// รอบนี้ (2026-10-12, brand-spec §2-§4): บนหน้าแรกกล่องนี้ถือ docx H3 #4
// ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ **slide2** ซึ่งเป็นงานอาร์ตที่
// พิมพ์คำว่า โปรโมชั่น และ คืนยอดเสีย 0.3% ไว้ในตัวภาพเอง — ตัวเลขบนภาพเป็นตัวตัดสิน
// การจับคู่ ถ้าสลับไปใช้ slide1 (แนะนำเพื่อน โบนัส 0.8%) รูปจะขัดกับหัวข้อทันที
//
// นี่คือครึ่ง "การ์ดไล่เฉดมุมโค้ง" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeCyberCut ที่เป็นคู่กันเป็นการ์ดมุมตัดผิวจม สองบล็อกนี้วางติด
// กันบนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อย แนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ด
// ใบเดียวกันซ้ำสองรอบ: ใบนี้ไล่เฉดจากผิวยก #4a1038 ลงผิวจม #1c0014 หัวข้อเป็น
// ตัวอักษรไล่เฉด ส่วนใบคู่เป็นผิวจมทึบใบเดียวกับหัวข้อสีทึบ
// กรอบและเส้นคั่นกลางเป็นชมพูลึก #8a0a45 (ไม่ใช่กรอบชมพูแบรนด์แบบ
// ContentBoxFloatingBadge และไม่ใช่กรอบชมพูลึกโปร่งแบบ ContentBoxTwoPremium)
// สว่างขึ้นเป็นชมพูแบรนด์ #f41571 ตอน hover ออรามุมซ้ายบนเป็นชมพูแบรนด์ มุมขวาล่าง
// เป็นทองสว่าง #fce343 ตามคู่สีของโลโก้ (PUNPRO ชมพู + 168 ทอง)
// หัวข้อไล่ชมพูบานเย็น #f41571 → ทองสว่าง #fce343 → ชมพูสว่าง #ff5ca8 ซึ่งเป็นลำดับสี
// คนละชุดกับการ์ดคู่ของมันที่ใช้ชมพูสว่างทึบสีเดียว
// ⚠️ พื้นเพจรอบนี้เป็นพลัมเข้ม #2e0022 ไม่ใช่ดำสนิท ปลายล่างของไล่เฉด (#1c0014) จึง
// "จม" ต่ำกว่าพื้นเพจได้จริงรอบนี้ ซึ่งเป็นสิ่งที่รอบก่อนทำไม่ได้
// เนื้อความ #fde7f2 (= BRAND_TEXT) glow เป็น rgba(244,21,113,…)
// #8a0a45 / #4a0426 ไม่ถือตัวอักษรที่ไหนในไฟล์นี้ตาม §2 — อยู่ที่ขอบ เส้นคั่น และ
// ออราเท่านั้น และ #ffd94a ถูกสงวนให้ <strong> ในย่อหน้า จึงไม่โผล่ที่นี่
//
// ⚠️ เทียบสีเป็นค่า ไม่ใช่ตระกูลสี: ชุดทองอำพันเสือของ TIGERWIN369 ที่เคยค้างในไฟล์นี้
// รอบก่อนหน้าทันที (#d98324 #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02
// #2d1c0a #1c1206 #0f0903) ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc
// #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #f2f5f9 #8792a0)
// ชุดชมพูฮอต-ทองของ FAH999 (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08
// #b3006a #7a0046 #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-
// ส้มอำพันของ DUCK1688 (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a
// #a3510c #1f1709 #171106 #0d0903 #f6ecd9) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #cfd6e3 #eef2f8 #9aa6bb #3f4859 #fdf3df
// #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดแดงเสือโคร่ง-ทองถ่านไฟ (#e8232a
// #f2b705 #ffd666 #c08a0b #fbe8d5) และชุดม่วงนีออน-ทอง (#a435f0 #5b1a75 #c98a05
// #fbe455 #ffd23d #1e0a3c) ออกครบทุกจุดแล้ว — ชมพูรอบนี้ (#f41571) เป็นคนละค่ากับ
// #ff3fa4 ของ FAH999 และรอบนี้ไม่มีเงิน ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้มอิฐ
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a0a45] bg-gradient-to-br from-[#4a1038]/96 to-[#1c0014]/96 p-8 text-[#fde7f2] shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#f41571]/80 hover:shadow-[0_15px_40px_rgba(244,21,113,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f41571]/32 blur-[60px] transition-all duration-500 group-hover:bg-[#f41571]/46">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fce343]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fce343]/26">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f41571] via-[#fce343] to-[#ff5ca8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fde7f2] md:border-l md:border-[#8a0a45] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f41571] via-[#fce343] to-[#ff5ca8] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
