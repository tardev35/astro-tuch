---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// SEXYGAME666 (รอบชมพูนีออน-ม่วง-ดำ 2026-09-28): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อก
// รูป+ข้อความ ส่วน ContentBoxSevenThree (ตัวธรรมดา) ที่เป็นคู่กันใช้หัวข้อม่วงอ่อนทึบ
// ไม่ไล่เฉด สองบล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืนยอดเสีย 0.3%)
// จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับตัวอักษรบนเวิร์ดมาร์ก
// คือชมพูอ่อน #ffb3e2 → ชมพูแบรนด์ #fa42b5 → ม่วงแบรนด์ #8b3df3 ส่วนออร่าสองมุมเป็น
// ชมพูกับม่วง บนการ์ดที่ไล่จากผิวการ์ด #170a22 ลงไปหาพื้นเพจ #08020d เส้นคั่นกลางเป็น
// ชมพูลึก #4a0e33 เนื้อความ #f2dcee (BRAND_TEXT) — ชุดทองเมทัลลิก-โครเมียมของ PKG44
// (#fdd32a #ffe27a #c8920a #c2c8d0 #f2f4f7 #4a3a12 #12100a #080602 #efe6d2)
// ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a0e33]/80 bg-gradient-to-br from-[#170a22]/94 to-[#08020d]/96 p-8 text-[#f2dcee] shadow-[0_10px_30px_rgba(8,2,13,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fa42b5]/80 hover:shadow-[0_15px_40px_rgba(250,66,181,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fa42b5]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffa6dd]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8b3df3]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#8b3df3]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2dcee] md:border-l md:border-[#4a0e33]/80 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffb3e2] via-[#fa42b5] to-[#8b3df3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
