---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThree (plain) ที่เป็นคู่กันเป็นการ์ดทึบ สองบล็อกนี้วางติดกันบนหน้าแรก
// (คืนยอดเสีย โบนัส 0.3% แล้วค่อย แนะนำเพื่อน โบนัส 0.8%) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกัน
// ซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ข้อความอยู่ขวา 7fr ส่วน
// อีกใบกลับด้านเป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา หัวข้อไล่แชมเปญ #fdf2ac →
// ทองแบรนด์ #e4b34d → ทองลึก #8a5f12 ตามโลโก้ที่เป็นตัวอักษรทองเมทัลลิกล้วน ออร่าสองมุม
// เป็นทองสองระดับ คือทองแบรนด์มุมซ้ายบนกับแชมเปญมุมขวาล่าง บนการ์ดที่ไล่จากผิวยกระดับ
// #241404 ลงไปหาผิวการ์ด #140c02 กรอบและเส้นคั่นกลางเป็นทองลึก #8a5f12 ซึ่งเป็นเส้นทอง
// ที่เข้มสุดในตาราง ไม่ใช่กรอบทองสว่างแบบการ์ดใบอื่น เพื่อให้สองบล็อกในคู่นี้ต่างกันตั้งแต่ขอบ
// เนื้อความ #f3e8cf (BRAND_TEXT) — ชุดแดงสด-ทองของ หวย365/หวยเฮง789 (#dc0203 #f5282a
// #9c0201 #ffc93c #ffeab0 #c08a07 #240406 #180303 #f6e7e0 #dc2224 #f4bc5d #ffefc2
// #fbe3d4 #2b0909) ออกครบทุกจุด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a5f12] bg-gradient-to-br from-[#241404]/94 to-[#140c02]/96 p-8 text-[#f3e8cf] shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4b34d]/70 hover:shadow-[0_15px_40px_rgba(228,179,77,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e4b34d]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#fdf2ac]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fdf2ac]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#e4b34d]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8cf] md:border-l md:border-[#8a5f12] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
