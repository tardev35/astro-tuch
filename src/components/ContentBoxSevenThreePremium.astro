---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   698..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 600 จึงติดเพดาน
//               max-w-[600px] ของรูป = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl / p-10 / gap-10 / pl-10) ไม่ใช่ของ
// ContentBoxSevenThree ที่ถือ §4 บนหน้าเดียวกัน (max-w-[1400px] / gap-8 / pl-6 →
// 352px และ calc(30vw − 68px)) ห้ามลอกข้ามไฟล์
// ⚠️ สไลด์ของดรอปนี้เป็น **จัตุรัส 600×600** เพดาน max-w-[600px] จึงเป็นพิกเซลจริง
// พอดี ไม่ใช่การอัปสเกล
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2-§5): บนหน้าแรกกล่องนี้ถือ docx H3
// §5 ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ **slide2.png** ซึ่งพิมพ์
// คำว่า โปรโมชั่น / แนะนำเพื่อน / 0.8% ไว้ในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** เปิดอ่าน
// บิตแมปทั้งสองใบจริงก่อนเขียน alt แล้วรอบนี้ และการจับคู่ **สลับทางจากดรอปก่อน**
// (รอบก่อน slide1 = 0.8% · รอบนี้ slide2 = 0.8%) ใครก๊อปบรรทัด import ของรอบก่อนมา
// โดยไม่เปิดดูจะได้รูปที่ขัดกับหัวข้อของตัวเอง
// slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์ก่อน **ห้าม import** เพราะ
// eager import = emit และจะทำให้ verify-build แดง
//
// นี่คือบล็อกรูป+ข้อความบล็อกที่สองจากสองบล็อก (เพดานของ playbook คือ 2) การ์ดเป็น
// มุมโค้ง 3xl ไล่จากผิวยก #0b2d52 ลงผิวกลาง #071e38 ในกรอบบรอนซ์ลึก #704504 ที่
// สว่างขึ้นเป็นฟ้าอะซัวร์ #039cfa ตอน hover
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0b2d52 ยก /
// #071e38 กลาง / #030f1d จม / #000000 พื้น — ไม่มีผิวไหนจมต่ำกว่าพื้นได้
// ออรามุมซ้ายบนเป็นฟ้าอะซัวร์ (หัวใจฟ้ากับถุงเงินฟ้าในงานอาร์ต) มุมขวาล่างเป็น
// น้ำเงินลึก (เงาของฟ้าเดียวกัน) และ **ฟ้ามาก่อนทอง** ตามลำดับนำของรอบนี้ ส่วน
// บรอนซ์โผล่ตอน hover ที่ออราขวาล่าง — ตรงกับที่ทองอยู่บนอาร์ตเวิร์ก คือเป็นเหรียญ
// กับประกาย ไม่ใช่พื้นที่กว้าง
// หัวข้อไล่ ฟ้าอะซัวร์ #039cfa → ทองอำพัน #f9a826 → ฟ้าน้ำแข็ง #c3ebfc ซึ่งเป็นลำดับ
// คนละชุดกับอีกเจ็ดกล่องบนหน้าเดียวกัน ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซล
// ของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (#039cfa 4.6:1 ที่ text-2xl
// font-black = large text · #f9a826 6.9:1 · #c3ebfc 10.8:1) — ห้ามเอา #04366b
// หรือ #704504 มาเป็นสต็อป
// เนื้อความ #e3f2fc (= BRAND_TEXT) glow ที่ใช้คือ rgba(3,156,250,…) ตาม §2 ·
// #f9a826 สงวนไว้ให้ <strong> ในย่อหน้า จึงโผล่ในไฟล์นี้แค่ในกลางไล่เฉดของหัวข้อ
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// ทองรอบนี้คือ #f9a826 (R=249 G=168 B=38) ไม่ใช่ fef54b (นินจา168 เหลืองมะนาว)
// ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168)
// f0b429 (รับตัง168) e3b23c (สมหวัง168) dfa310 ffc93d ffe4a3 (TND168) f2c230 ffe066
// (KINGKONG555) e2b33f (KMD88) e5a81b (UFA324) fad354 (789BETTING) f5c518 (FLASH877)
// fce343 (PUNPRO168) f3bb34 (DUCK1688) หรือ fbe455 (WEPLAY168)
// ⚠️ **ฟ้าก็เป็นกับดักเต็มตัว** เพราะสองรอบก่อนหน้าก็ฟ้า: นินจา168 32bcfb (+a9e9ff
// 07335f) · สบายเบท168 2f9ff5 (+a8dcff 0b3f78) และ TSDET911 เคยเป็นน้ำเงินไฟฟ้า
// ทั้งชุดในไฟล์ตระกูลนี้ (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e
// 0a1c42 040e26 00081f 04186e 021026) ส่วน cfd9e6 ของรับตัง168 เป็นเงินอมฟ้าที่
// หน้าตาใกล้ฟ้าอ่อนมาก — ฟ้ารอบนี้คือ #039cfa (+#c3ebfc +#04366b) เท่านั้น
// ชุดเต็มของสบายเบท168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (2f9ff5 a8dcff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16) ชุดทอง-ชมพูบานเย็นของมีโชค168 (fcd434 ffeaa0
// f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดชมพูบับเบิลกัม-
// ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708
// 2a0617 fdeaf5) ชุดทองไทย-แดงมังกรของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203
// 4a0202 9a6c0c f5ece0 2b100f 200a09 140505 1a0505) ชุดโรสโกลด์ของขวัญใจ168 (f7c92b
// ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06) ชุดของ TKB55 (fb131b
// ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a)
// ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f
// ffdf8c ece2f8 1d0832 140522 0a0213) ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571
// ff5ca8 fce343 ffd94a f0c3dc fde7f2 8a0a45 4a1038 2a0012 1c0014) ชุดทองมังกรของ
// TND168 (dfa310 ffc93d ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ชุดทองอำพันเสือของ
// TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214 4a2a08 1a0d02 2d1c0a 1c1206)
// และชุดทองแชมเปี้ยนของ UFA324 (e5a81b b9c2cc 231c0e 17130a 0d0b06 f0e8d4 ffe08a
// 7d5a07 464f5a f2f5f9) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#704504] bg-gradient-to-br from-[#0b2d52]/96 to-[#071e38]/96 p-8 text-[#e3f2fc] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#039cfa]/85 hover:shadow-[0_15px_40px_rgba(3,156,250,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#039cfa]/34 blur-[60px] transition-all duration-500 group-hover:bg-[#c3ebfc]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#04366b]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#704504]/60">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#039cfa] via-[#f9a826] to-[#c3ebfc] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3f2fc] md:border-l md:border-[#704504] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#039cfa] via-[#f9a826] to-[#c3ebfc] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
