---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading.
//
// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): นี่คือครึ่ง "การ์ดมน" ของคู่บล็อก
// รูป+ข้อความ ส่วน ContentBoxSevenThreeCyberCut ที่เป็นคู่กันใช้มุมตัดเฉียงกับหัวข้อ
// ทึบ สองบล็อกนี้วางติดกันบนหน้าแรก (2 ตัวจ่าย 100 แล้วค่อย 3 ตัวจ่าย 1,000) จึงต้อง
// ไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับสีบนโลโก้ คือเขียวสด
// #1fae1c → ทองสว่าง #fff6ae → แดงหลัก #cf1111 ส่วนออร่าสองมุมเป็นทองกับเขียว บน
// การ์ดที่ไล่จากพื้นการ์ด #0d2312 ลงไปหาพื้นเพจ #07130a ชมพูมาเจนตา-ทองของ WY88
// และแดง-เงินโครเมียมของ UFAGOOL หายไปทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a87d0c]/60 bg-gradient-to-br from-[#0d2312]/94 to-[#07130a]/96 p-8 text-[#e8e4c6] shadow-[0_10px_30px_rgba(7,19,10,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcdc2b]/80 hover:shadow-[0_15px_40px_rgba(252,220,43,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fcdc2b]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fff6ae]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1fae1c]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#1fae1c]/38">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e4c6] md:border-l md:border-[#a87d0c]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
