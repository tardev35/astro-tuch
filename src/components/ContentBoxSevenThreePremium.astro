---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งซ้าย) ที่หน้าแรกคิด `sizes` จาก — ถ้าแก้ค่าใด
// ต่อไปนี้ต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย:
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์แคบไม่มี padding ใน
//   ≥1280px: (1280 − 32 − 2 − 80 − 40) × 0.3 = 1126 × 0.3 = 337.8 → 338px
//   768–1279px: (100vw − 154) × 0.3 = calc(30vw − 46px)
//   ≤767px: ยุบเหลือคอลัมน์เดียว card p-8(32×2=64) → calc(100vw − 98px)
// md:border-l 1px อยู่ในกล่องของคอลัมน์ขวา จึงไม่กินความกว้างคอลัมน์ซ้าย
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2-§4):
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H3 #4 ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน")
// คู่กับ slide1 ซึ่งเป็นงานอาร์ตที่พิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย กับเลข 0.3%
// ตัวแดงขอบทองขนาดใหญ่ไว้ในตัวภาพเอง
//
// นี่คือครึ่ง "การ์ดไล่เฉด กรอบแดงลึก" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeNeumorphism ที่เป็นคู่กันเป็นแผ่นนูนผิวลึกสุด สองบล็อกนี้วาง
// ติดกันบนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อย แนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็น
// การ์ดใบเดียวกันซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr
// ข้อความอยู่ขวา 7fr ส่วนอีกใบกลับด้านเป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา
//
// ผิวการ์ดไล่จากผิวยก #3d1709 ลงไปหาผิวลึกสุด #180800 กรอบและเส้นคั่นกลางเป็นแดงลึก
// #7d0f12 (ไม่ใช่กรอบแดงแบรนด์แบบ ContentBoxPremium และไม่ใช่กรอบทองเข้มแบบ
// ContentBoxTwoPremium) สว่างขึ้นเป็นแดงแบรนด์ #e8232a ตอน hover ออรามุมซ้ายบนเป็น
// แดงแบรนด์ มุมขวาล่างเป็นทองเข้ม #a8730a หัวข้อไล่ทองแบรนด์ #f2b705 → ครีมอุ่น
// #f5cbb0 → แดงเรืองไฟ #ff5a46 ซึ่งเป็นลำดับสีคนละชุดกับการ์ดคู่ของมันที่ใช้ทอง
// แบรนด์ทึบสีเดียว เนื้อความ #fbe8d5 (= BRAND_TEXT) glow เป็น rgba(232,35,42,…)
// #e8232a ไม่ถือตัวอักษรที่ไหนในไฟล์นี้ตาม §2 (3.5:1) — อยู่ที่ขอบกับออราเท่านั้น
//
// ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#1e0a3c #0a0117
// #5b1a75 #a435f0 #c98a05 #fbe455 #ffd23d #efe6ff #d2a6ff #ece2ff
// rgba(164,53,240,α)) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ก่อนนั้น (#0a1726
// #020609 #064a86 #0193fb #7bcffb #fff48a #c9a703 #fce604 #dbeafe)
// ออกครบทุกจุดแล้ว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7d0f12] bg-gradient-to-br from-[#3d1709]/96 to-[#180800]/96 p-8 text-[#fbe8d5] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8232a]/80 hover:shadow-[0_15px_40px_rgba(232,35,42,0.36)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e8232a]/32 blur-[60px] transition-all duration-500 group-hover:bg-[#e8232a]/46">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#a8730a]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f2b705]/26">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#f2b705] via-[#f5cbb0] to-[#ff5a46] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe8d5] md:border-l md:border-[#7d0f12] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f2b705] via-[#f5cbb0] to-[#ff5a46] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
