---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a0710]/35 bg-gradient-to-br from-[#1a0304]/92 to-[#0a0102]/88 p-8 text-[#e0d7d8] shadow-[0_10px_30px_rgba(224,16,32,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e01020]/55 hover:shadow-[0_15px_40px_rgba(224,16,32,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e01020]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5a63]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#4b0304]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e01020]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0d7d8]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#f4eff0] via-[#cbd0d8] to-[#8a0710] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0d7d8] md:border-l md:border-[#4b0304] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ff5a63] via-[#f4eff0] to-[#e01020] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
