---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#22c55e]/30 bg-gradient-to-br from-[#0d1a0a]/92 to-[#04120a]/88 p-8 text-[#e8f5ee] shadow-[0_10px_30px_rgba(34,197,94,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/50 hover:shadow-[0_15px_40px_rgba(236,72,153,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#22c55e]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#4ade80]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#db2777]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#ec4899]/30"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f5ee]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#bbf7d0] via-[#e8f5ee] to-[#16a34a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f5ee] md:border-l md:border-[#0d1a0a] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#4ade80] via-[#e8f5ee] to-[#ec4899] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
