---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// PKG44 (รอบทองเมทัลลิก-โครเมียม-ดำ 2026-09-27): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อก
// รูป+ข้อความ ส่วน ContentBoxSevenThree (ตัวธรรมดา) ที่เป็นคู่กันใช้หัวข้อเงินโครเมียม
// ทึบไม่ไล่เฉด สองบล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืนยอดเสีย
// 0.3%) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับโลหะบน
// เวิร์ดมาร์ก คือทองสว่าง #ffe27a → ขาวโครเมียม #f2f4f7 → ทองลึก #c8920a ส่วนออร่า
// สองมุมเป็นทองกับเงินโครเมียม #c2c8d0 บนการ์ดที่ไล่จากผิวการ์ด #12100a ลงไปหาพื้นเพจ
// #080602 เส้นคั่นกลางเป็นทองลึก #4a3a12 เนื้อความ #efe6d2 (BRAND_TEXT) — ทอง-
// โครเมียมของ MIRACLE55 (#fcda65 #fee47b #d9a62b #fcfcfc #d2d3d4 #8c5f14 #14100a
// #050403 #e8e6e1) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a3a12]/60 bg-gradient-to-br from-[#12100a]/94 to-[#080602]/96 p-8 text-[#efe6d2] shadow-[0_10px_30px_rgba(8,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32a]/80 hover:shadow-[0_15px_40px_rgba(253,211,42,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c8920a]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c2c8d0]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#c2c8d0]/26">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe6d2] md:border-l md:border-[#4a3a12]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffe27a] via-[#f2f4f7] to-[#c8920a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
