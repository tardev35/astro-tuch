---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// This is the GOLD half of the pair of promo blocks — its sibling
// ContentBoxSevenThree runs the same layout in brushed silver, so two promo
// sections stacked back to back do not read as the same card twice.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ecc964]/40 bg-gradient-to-br from-[#1b140b]/92 to-[#030201]/90 p-8 text-[#f3e6c8] shadow-[0_10px_30px_rgba(3,2,1,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#f9e38b]/75 hover:shadow-[0_15px_40px_rgba(249,227,139,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ecc964]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#ecc964]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e3e3e4]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#e3e3e4]/24">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fff8e2] via-[#f9e38b] to-[#ba8219] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c8] md:border-l md:border-[#ecc964]/40 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fff8e2] via-[#f9e38b] to-[#ecc964] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
