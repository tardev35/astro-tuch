---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// GOT777 (รอบทอง-แดงเลือดหมู-ดำ 2026-09-29): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+
// ข้อความ ส่วน ContentBoxSevenThreeFloatingBadge ที่เป็นคู่กันใช้ป้ายหัวข้อลอย สองบล็อกนี้
// วางติดกันบนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อยแนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ด
// ใบเดียวกันซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ส่วนอีกใบรูปอยู่
// ขวา 7fr หัวข้อไล่ตามลำดับสีบนเวิร์ดมาร์ก คือทองอ่อน #ffe9a8 → ทองแบรนด์ #f5c518 →
// ทองลึก #96690f ออร่าสองมุมแยกหน้าที่ตามคู่สีของโลโก้ คือทองมุมซ้ายบนตามคำว่า GOT และ
// แดงแบรนด์ #d21622 มุมขวาล่างตามเลข 777 บนการ์ดที่ไล่จากผิวการ์ด #160b06 ลงไปหาพื้น
// เพจ #0a0503 กรอบและเส้นคั่นกลางเป็นแดงเข้มสุด #4c0301 เนื้อความ #ece0cb (BRAND_TEXT)
// ตัวรอง #bdae92 — ชุดทอง-ขาวของ WIN999 (#fcc403 #fdda04 #8a6502 #4a3402 #fffbea
// #191712 #050505 #e9e4d6) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4c0301] bg-gradient-to-br from-[#160b06]/94 to-[#0a0503]/96 p-8 text-[#ece0cb] shadow-[0_10px_30px_rgba(5,2,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f5c518]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a8]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#d21622]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#d21622]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0cb] md:border-l md:border-[#4c0301] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#96690f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
