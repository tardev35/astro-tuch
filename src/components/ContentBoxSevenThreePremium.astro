---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// ENTER55: นี่คือครึ่ง "การ์ดมน" ของคู่บล็อกรูป+ข้อความ ส่วน ContentBoxSevenThree
// ที่เป็นพี่น้องกันใช้ทรงเดียวกันแต่เป็นกรอบทองคมและหัวข้อทึบ สองบล็อกนี้วางห่างกัน
// บนหน้าแรก (หวย แล้วค่อยโปรสล็อต) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ
// ที่นี่ทองประกาย #ebd484 เป็นหัวไล่เฉดของหัวข้อ ส่วนออร่าสองมุมเป็นทองหลัก
// #c4a255 กับทองเข้ม #8a6d2c
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c4a255]/55 bg-gradient-to-br from-[#0b0b0a]/94 to-[#000000]/96 p-8 text-[#ded8cb] shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebd484]/80 hover:shadow-[0_15px_40px_rgba(196,162,85,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ebd484]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ebd484]/26">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8a6d2c]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#c4a255]/36">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8cb]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#c4a255] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ded8cb] md:border-l md:border-[#26200f] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ebd484] via-[#d2b262] to-[#8a6d2c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
