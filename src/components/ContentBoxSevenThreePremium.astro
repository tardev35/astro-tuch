---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7a0304]/60 bg-gradient-to-br from-[#240803]/92 to-[#0b0402]/88 p-8 text-[#e9d6ac] shadow-[0_10px_30px_rgba(226,6,10,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2060a]/70 hover:shadow-[0_15px_40px_rgba(226,6,10,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e2060a]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4b18]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fbbf14]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fae21e]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9d6ac]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#fbbf14] to-[#7a0304] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9d6ac] md:border-l md:border-[#7a0304] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fff6e0] via-[#ff4b18] to-[#fbbf14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
