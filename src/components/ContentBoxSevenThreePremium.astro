---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): นี่คือครึ่ง "การ์ดมน" ของคู่บล็อกรูป+
// ข้อความ ส่วน ContentBoxSevenThreeCyberCut ที่เป็นคู่กันใช้มุมตัดเฉียงกับหัวข้อทึบ
// สองบล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืนยอดเสีย 0.3%) จึงต้อง
// ไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับสีบนโลโก้ คือเงิน
// โครเมียม #dfe4ec → ทองสว่าง #fbd564 → ทองแบรนด์ #e0b429 ส่วนออร่าสองมุมเป็นทอง
// กับเงินโครเมียม บนการ์ดที่ไล่จากพื้นการ์ด #161106 ลงไปหาพื้นเพจ #080602
// เนื้อความ #ece6d8 (BRAND_TEXT) — ทอง-เขียวเข้ม-แดงของ 888PARUAY ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7a5407]/60 bg-gradient-to-br from-[#161106]/94 to-[#080602]/96 p-8 text-[#ece6d8] shadow-[0_10px_30px_rgba(8,6,2,0.78)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0b429]/80 hover:shadow-[0_15px_40px_rgba(224,180,41,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e0b429]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fbd564]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#dfe4ec]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#dfe4ec]/24">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6d8] md:border-l md:border-[#7a5407]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
