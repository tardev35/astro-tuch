---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดจากคลาสในไฟล์นี้สำหรับดรอป 2026-10-28** ถ้าแก้ค่าใดต่อไปนี้
// ต้องไปแก้ src/pages/index.astro ด้วย (Tailwind ตั้ง box-sizing: border-box
// ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding และ border):
//   section max-w-7xl(1280) + px-4(16x2=32) · card border(1x2=2) · md:p-10(40x2=80)
//   · grid gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   >=1280px  : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768..1279 : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//               ปลายล่างของแบนด์ (ที่ 768px) = 143px
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                          = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl · md:p-10 · gap-10 · md:pl-10) ไม่ใช่
// ของ **ContentBoxSevenThreeNeumorphism** ที่ถือ §5 บนหน้าเดียวกันรอบนี้ ซึ่งแคปที่
// max-w-[1400px] จ่าย gap-8 และคอลัมน์รูปจ่าย md:pl-8 แล้วออกมา **343px /
// calc(30vw - 77px)** — ต่างกัน 46px ที่ 1x **ห้ามลอกตัวเลขข้ามไฟล์ และห้ามลอกจาก
// รอบก่อน** (รอบก่อนคิดจาก ContentBoxSevenThree ตัวฐาน ซึ่งเป็นอีกไฟล์)
// ⚠️⚠️ **สไลด์ของดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดจึงเป็น **375**
// (1x ของใบนี้คือ 297px ซึ่ง 2x = 594 เกินบิตแมป จึงตกลงมาที่ 375)
// **ห้ามมี candidate สูงกว่านั้น** เพราะไม่ใช่พิกเซลจริง
//
// ───────────────────────────────────────────────────────────────────────────
// WIN8S (ดรอป 2026-10-28, .claude/brand-spec-win8s.md §1–§6):
// บนหน้าแรกกล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน"
// — content.txt บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide1.png** ซึ่ง
// พิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้บนตัวภาพเอง และมี **ร่มกระดาษญี่ปุ่น
// แดง-ขาว** อยู่ในฉาก
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** uploader
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ — รอบนี้
// **สลับทิศจากรอบก่อน (123BET ใช้ slide1 = แนะนำเพื่อน)**:
// slide1 = คืนยอดเสีย 0.3% (ใบนี้ · มีร่ม) · slide2 = แนะนำเพื่อน 0.8% (§5 · มีพัด)
// ⛔ slide3/slide4 (09-29) และ banner2/banner3 (10-23) เป็นอาร์ตของแบรนด์อื่น
// **ห้าม import** เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน
// render · banner1 / banner1-mobile / og.png เป็นของ MainLayout
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2 และสไลด์ที่
// ใช้ได้รอบนี้ก็มีสองใบพอดี)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **เขียวมรกต/ทองอำพันบนธีมมืดของ ZORO365** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้ยังมืดเหมือนเดิม แต่คนละฮิวสิ้นเชิง** พื้นเพจ 1e0101
// (bg.json) = ดำอมเลือดหมู **ห้ามเหลือเขียวไว้เลยสักค่า และห้าม "แก้" การ์ดกลับไป
// เป็นพื้นขาว** — หมึก fdf0e6 บนพื้นขาวจะหายไปเลย ไม่ใช่แค่จางลง
// ลำดับผิว: 140302 หมึกดำ · 250604 โครม · 2a0a04 ผิวการ์ด · 3b130b ชั้นยก ·
// 1e0101 พื้นเพจ — การ์ดใบนี้ไล่จาก **ผิวการ์ดลงชั้นยก (2a0a04 -> 3b130b)**
// ในกรอบ 5a2410 ที่อิ่มเป็น 8a3a12 ตอน hover ซึ่งเป็นผิวที่ **ยกกว่า §5** ที่นั่ง
// อยู่บนผิวการ์ดทึบ 2a0a04
// ออรามุมซ้ายบนเป็นส้มเพลิง f27a1a จาง มุมขวาล่างเป็น **ทองอำพัน e5a92b** จาง
// ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร**
// หัวข้อเป็น **ทองอำพัน e5a92b ทึบสีเดียว ชิดซ้าย พร้อมเส้นใต้สามสต็อปเต็มความกว้าง
// ของคอลัมน์ข้อความ** ไม่ใช่ bg-clip-text และไม่มีแผ่นถม (8.8:1 บนปลายการ์ด 2a0a04
// · 7.9:1 บนปลายชั้นยก 3b130b) ซึ่งเป็นทรีตเมนต์คนละชุดกับทุกกล่องอื่นบนหน้า
// เส้นคั่นคอลัมน์และเส้นใต้หัวข้อเป็น **5a2410 / c9d2dc / f27a1a / e5a92b**
// ซึ่ง §2 อนุญาตให้เป็นขอบ/พื้นถมได้ · เนื้อความ fdf0e6 (= BRAND_TEXT, 16.4:1
// บนปลายการ์ด) · หมึกรอง e0bda4 (10.5:1)
// 🚨🚨 **5a2410 และ 8a3a12 ห้ามถือตัวอักษรเด็ดขาด**
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ f27a1a** และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(242,122,26,α) · rgba(229,169,43,α) ·
// rgba(138,58,18,α) · rgba(30,1,1,α) · rgba(20,3,2,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ZNOVA168 เป็นน้ำตาลเข้ม/อำพัน =
// ตระกูลเดียวกับรอบนี้เป๊ะ** รองลงมาคือ MEXICANOSLOT (แดง/ทอง/ครีม) และ TEVA69
// **ลิสต์เฮกซ์เต็มของทุกแบรนด์อยู่ที่ .claude/brand-spec-win8s.md §2 — ไม่ซ้ำลง
// ที่นี่โดยตั้งใจ** ค่าที่เพิ่งอยู่ทั้งใบนี้และกวาดออกครบแล้ว (ZORO365):
//   3ddc4a 35a043 1e7033 0e5424 073c1a 031b09 010d04 002908 eef7f0 dfe6e3 e8c86a
//   9dc2a5 + rgba(61,220,74) rgba(1,13,4) rgba(232,200,106) rgba(223,230,227)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **ซากุระชมพู-ขาว ร่มกระดาษแดง-ขาว กิโมโนแดง-ดำปักทอง ผนังห้องสีขาวงาช้าง
// และสีผิวนักแสดงเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// (เขียว 00B900 ของปุ่ม LINE และเขียว success ของฟีดอยู่ไฟล์อื่น คงไว้)
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5a2410] bg-gradient-to-br from-[#2a0a04] to-[#3b130b] p-8 text-[#fdf0e6] shadow-[0_10px_30px_rgba(20,3,2,0.55)] transition-all duration-500 hover:border-[#8a3a12] hover:shadow-[0_15px_40px_rgba(242,122,26,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f27a1a]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f27a1a]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e5a92b]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#e5a92b]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6]">
        {
          leftHeading && (
            <header class="flex flex-col gap-3">
              <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#e5a92b]">{leftHeading}</HeadingTag>
              <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#c9d2dc] via-[#f27a1a] to-[#e5a92b]" />
            </header>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0e6] md:border-l md:border-[#5a2410] md:pl-10">
        {titleright && <HeadingTag class="text-center text-xl leading-normal font-black tracking-wide text-[#e5a92b] md:text-left">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
