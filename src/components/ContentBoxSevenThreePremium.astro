---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fb923c]/30 bg-gradient-to-br from-[#2a1206]/92 to-[#170a03]/88 p-8 text-[#fbe6d8] shadow-[0_10px_30px_rgba(251,146,60,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb923c]/60 hover:shadow-[0_15px_40px_rgba(251,146,60,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fb923c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fde68a]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c2410c]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f97316]/30"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe6d8]">
        {
          titleleft && (
            <h3 class="bg-gradient-to-r from-[#fde68a] via-[#fbe6d8] to-[#ea580c] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h3>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe6d8] md:border-l md:border-[#2a1206] md:pl-10">
        {
          rightHeading && (
            <h3 class="mb-2 bg-gradient-to-r from-[#fde68a] via-[#fbe6d8] to-[#ea580c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h3>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
