---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1d3a68]/80 bg-gradient-to-br from-[#08234c]/92 to-[#01091b]/90 p-8 text-[#d5e3f7] shadow-[0_10px_30px_rgba(1,9,27,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-[#dfb455]/80 hover:shadow-[0_15px_40px_rgba(223,180,85,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#a87a1e]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#dfb455]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#3d8fd8]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#8fc3ec]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e3f7]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fdf1cd] via-[#f7d979] to-[#a87a1e] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5e3f7] md:border-l md:border-[#1d3a68] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdf1cd] via-[#dfb455] to-[#f7d979] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
