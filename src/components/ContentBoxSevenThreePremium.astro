---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 1126 × 0.3 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   473..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 ≥ 375 จึงติดเพดาน
//               max-w-[375px] ของรูป = 375px
//   <473      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl / md:p-10 / gap-10 / md:pl-10) ไม่ใช่
// ของ ContentBoxSevenThreeNeumorphism ที่ถือ §5 บนหน้าเดียวกัน (max-w-[1400px] /
// gap-8 / md:pl-8 → **343px และ calc(30vw − 77px) จุดตัดที่ 1399**) **ห้ามลอก
// ข้ามไฟล์ และห้ามลอกจากรอบก่อน** สองใบนี้ต่างกัน 46px ที่ 1x, 10px ใน calc()
// และหนึ่งเบรกพอยต์เต็ม ๆ
// ⚠️⚠️ **สไลด์ของดรอปนี้วัดจากบิตแมปจริงได้ 375×600 แนวตั้ง — ไม่ใช่ 600×960
// อย่างที่ brand-spec §1 เขียนไว้ (อัตราส่วนเดียวกันแต่คนละขนาด) ไฟล์บนดิสก์ชนะ
// ทุกรอบ** เพดานจึงเป็น **max-w-[375px]** = ความกว้างจริงของบิตแมป candidate ที่
// เกินกว่านี้ไม่ใช่พิกเซลจริง และ `alt` บรรยายสิ่งที่วาดอยู่ ไม่ระบุทิศทางของภาพ
//
// ───────────────────────────────────────────────────────────────────────────
// นาซ่า168 (ดรอป 2026-10-23, brand-spec §1–§5): บนหน้าแรกกล่องนี้ถือ
// **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน" — content.txt
// บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide2.png** ซึ่งพิมพ์คำว่า
// โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** ผู้อัปโหลด
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ ใครก๊อปบรรทัด
// import ของรอบก่อนมาโดยไม่เปิดดูจะได้รูปที่ขัดกับหัวข้อของตัวเอง — รอบนี้เปิดอ่าน
// บิตแมปทั้งสองใบจริงแล้ว ส่วน slide3/slide4 (09-29) และ banner2/banner3
// (10-08 / 09-27) เป็นอาร์ตของแบรนด์อื่น **ห้าม import** เพราะ eager import = emit
// และจะทำให้ verify-build แดง
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2 และสไลด์ที่
// ใช้ได้รอบนี้ก็มีสองใบพอดี)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองคานารี-โครเมียมเงินบนน้ำตาลกาแฟ ของ
// พักยก168** ทั้งใบ จึงรีเธมทั้งไฟล์ **รอบนี้เป็นธีมมืดโทนน้ำเงิน-ไซยาน**
// พื้นเพจ #0d1017 (bg.json) ไม่ใช่น้ำตาล การ์ดเนื้อหาเป็น **ผิวมืด + หมึกสว่าง**
// ⚠️ รอบก่อนทันที (ร่ำรวย168) เป็น **ธีมสว่าง** — รอบนี้กลับทิศ 180 องศา
// **ห้ามลอกทิศของรอบก่อน และห้าม "แก้" การ์ดให้สว่าง**
// ลำดับผิว: #273449 ยก · #1b2434 กลาง · #121722 จม · #0d1017 พื้นเพจ — การ์ดใบนี้
// ไล่จาก **กลางลงจม (#1b2434 → #121722)** ในกรอบ #33455f ที่สว่างขึ้นเป็นไซยาน
// ตอน hover ซึ่งเป็นผิวที่ **จมกว่า §5** ที่นั่งอยู่บนผิวยกทึบ
// ออรามุมซ้ายบนเป็นไซยาน #1fd8f0 (ไฟขอบหมวกนักบินและตัวอักษร "นาซ่า") มุมขวาล่าง
// เป็น **อุลตรามารีน #1d4fd8** (ฉากอวกาศและผิวโลกในแบนเนอร์)
// ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาต #1d4fd8 ตรงนั้นได้ แต่
// **ห้ามให้มันถือตัวอักษรเด็ดขาด** (2.7:1 บนปลายจมของการ์ดใบนี้)
// หัวข้อไล่ **ไซยาน #1fd8f0 → ฟ้าลึก #0bb6d4** (สองสต็อป ไม่มีสต็อปกลาง และ
// **ไม่มีแถบตั้งนำหน้า**) ซึ่งเป็นทรีตเมนต์คนละชุดกับ §5 ที่เป็น **ทึบ #8fd9ec
// ชิดซ้าย พร้อมแถบตั้ง**
// ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษร
// ได้ตาม §2 (บนปลายจม #121722: #1fd8f0 10.4:1 · #0bb6d4 7.4:1)
// เส้นคั่นคอลัมน์เป็น **#33455f** ซึ่ง §2 อนุญาตให้เป็นขอบ/พื้นถมเท่านั้น
// เนื้อความ #e6edf8 (= BRAND_TEXT, 13.2:1 บนปลายกลาง · 15.2:1 บนปลายจม)
// glow ที่ใช้คือ rgba(31,216,240,α) rgba(29,79,216,α) rgba(0,0,0,α)
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #1fd8f0** และเป็นงานของหน้าเพจ
// ⚠️ **#33455f (1.6:1) ห้ามถือตัวอักษร** ในไฟล์นี้อยู่ที่กรอบกับเส้นคั่นเท่านั้น
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ฟ้า/ไซยานเคยนำมาแล้วหกแบรนด์ใน
// รีโปนี้** (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911 ·
// ร่ำรวย168) **"เจอฟ้าแปลว่าเป็นของรอบนี้" ใช้ไม่ได้** ไซยานรอบนี้คือ
// **#1fd8f0 (R31 G216 B240)** และอุลตรามารีนคือ **#1d4fd8 (R29 G79 B216)**
// ⚠️⚠️ **ร่ำรวย168 เป็นแบรนด์ขาออกและฟ้านำเหมือนกัน — เทียบหนักที่สุด**: 18a5e2
// 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb f4e4d3 e4cbb3 111a3f 202a66
// 31408a e9f1ff adc0e4 · rgba(24,165,226,…) rgba(13,107,155,…) rgba(22,41,74,…)
// ⚠️⚠️ **NAZA168 ตัวละตินคือลูกค้าคนละเจ้าที่ชื่อซ้ำกับรอบนี้ และธีมอวกาศเหมือนกัน**
// ชุดทองอวกาศ-โครเมียมของเจ้านั้น **ห้ามกลับเข้ามาเด็ดขาด**: fbc134 ffe87a cf9a18
// 96690a d9c9a6 cfd6e3 241700 1a1000 432b03 231500
// ชุดที่ถอดออกจากไฟล์นี้รอบนี้คือ **ทองคานารี-โครเมียมเงิน ของ พักยก168**: eeae12
// fded41 9f600d e29f0f fdf051 e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713
// 32200f 1f1308 2f1e0f 1f0f04 4e2f11 · rgba(253,237,65,α)
// ก่อนหน้านั้นเป็นชุดของ **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf
// 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) · **สบาย168**
// (2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd
// eafaff a9e3f9 fdcb0c fefb6b 8a6504 0f3a4a 06293c) ⚠️ 2cc3fc ห่างจาก #1fd8f0 แค่
// R13/G21/B12 · **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f
// 461212 280b0b ffeee8 fff1ef ffdbdb) · **ufalion168** (d4922c fdfc71 f6e3b4
// a25b24 8c4312 5a3310 33200a 1f1304 0a0601 1a1000 fbf6e3) · **UFA324** (e5a81b
// ffe08a bb8410 7d5a07 8792a0 b9c2cc f0e8d4 464f5a) · **CEO66** (020617 7e22ce
// d946ef f5d0fe a855f7) · **รวยเทพ168** (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04
// 5c2a06) · **นินจา168** (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16
// 041019 dceefc) ⚠️ 32bcfb ห่างจาก #1fd8f0 แค่ R19/G24/B11 · **สาธุ168** (0b7d28
// 0a5f1c 0f9b35 0c3a16 061f0c d8ffc7 e9fbdd) · **เงินทอง168** (f5ba14 fcee52
// b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906 2e2512 1b1407 4d3c15) ·
// **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826 704504) · **สบายเบท168**
// (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16) · **TSDET911** (0360f3 0292fb 6ec8ff
// 4fb4ff cfdcec 9db4d4 dde8f7) · **โปรดี168** (eb0305 c20305 9b0a0c ff4446 401107
// b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea ffd1d1 1a0802)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** — เลข 168 สีทองอำพันบนสไลด์เป็น
// **วัตถุในภาพ ไม่ใช่สี UI** เช่นเดียวกับชุดนักบินสีขาว สีผิวนักแสดง และดวงจันทร์
// สีเทา · **ไม่มีแดง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย ไม่มีม่วง ไม่มีโรสโกลด์
// และไม่มีแรมป์เทาเงิน**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#33455f] bg-gradient-to-br from-[#1b2434] to-[#121722] p-8 text-[#e6edf8] shadow-[0_10px_30px_rgba(0,0,0,0.55)] transition-all duration-500 hover:border-[#1fd8f0]/80 hover:shadow-[0_15px_40px_rgba(31,216,240,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#1fd8f0]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#1fd8f0]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1d4fd8]/32 blur-[60px] transition-all duration-500 group-hover:bg-[#1d4fd8]/45">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6edf8]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#1fd8f0] to-[#0bb6d4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{leftHeading}</HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6edf8] md:border-l md:border-[#33455f] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#1fd8f0] to-[#0bb6d4] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
