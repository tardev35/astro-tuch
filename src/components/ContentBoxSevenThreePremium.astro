---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a0b8f]/35 bg-gradient-to-br from-[#150726]/92 to-[#06020e]/88 p-8 text-[#ece0fb] shadow-[0_10px_30px_rgba(157,22,241,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#9d16f1]/55 hover:shadow-[0_15px_40px_rgba(157,22,241,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#9d16f1]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#c47bff]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#2c045c]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e53cfe]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#e8e6ee] via-[#c47bff] to-[#4a0b8f] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb] md:border-l md:border-[#2c045c] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#c47bff] via-[#e8e6ee] to-[#9d16f1] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
