---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-23** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้
// src/pages/index.astro ด้วย (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก
// max-w-* จึงคุมกล่องรวม padding และ border):
//   section max-w-7xl(1280) + px-4(16x2=32) · card border(1x2=2) · md:p-10(40x2=80)
//   · grid gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   >=1280px  : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768..1279 : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                          = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (md:p-10 · gap-10 · md:pl-10) ไม่ใช่ของ
// **ContentBoxSevenThreeCyberCut** ที่ถือ §5 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8
// ล้วน · gap-8 · md:pl-8 แล้วออกมา **312px / calc(30vw - 72px)** — ต่างกัน 15px
// ที่ 1x และ 15px ใน calc() **ห้ามลอกตัวเลขข้ามไฟล์ และห้ามลอกจากรอบก่อน**
// ⚠️⚠️ **สไลด์ของดรอปนี้วัดจาก IHDR ของ PNG จริงได้ 375x600 ทั้งสองใบ** เพดานกว้าง
// สุดจึงเป็น **375** (1x ของใบนี้คือ 297px ซึ่ง 2x = 594 เกินบิตแมป จึงตกลงมาที่
// 375) **ห้ามมี candidate สูงกว่านั้น** เพราะไม่ใช่พิกเซลจริง และ **alt ห้ามระบุ
// ทิศทาง/ขนาดของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23, .claude/brand-spec-slot168.md §1–§5): บนหน้าแรก
// กล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน" —
// content.txt บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide1.png** ซึ่งพิมพ์
// คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** uploader
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ — **รอบก่อน
// จับคู่กลับทางกับรอบนี้** ใครก๊อปบรรทัด import ของรอบก่อนมาโดยไม่เปิดดูบิตแมป
// จะได้รูปที่ขัดกับหัวข้อของตัวเอง รอบนี้เปิดอ่านทั้งสองใบจริงแล้ว
// ⛔ slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์อื่น **ห้าม import**
// เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน render
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2 และสไลด์ที่
// ใช้ได้รอบนี้ก็มีสองใบพอดี)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าไซยาน-อุลตรามารีนบนถ่านอมน้ำเงินของ
// นาซ่า168** ทั้งใบ จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมมืด แต่คนละฮิวสิ้นเชิง**
// พื้นเพจ #140000 (bg.json) = ดำอมแดงเข้มมาก **ห้าม "แก้" การ์ดให้สว่าง และห้าม
// เหลือฟ้า/ไซยาน/น้ำเงินไว้เลยสักค่า**
// ลำดับผิว: #2a0c0d ยก · #1c0607 การ์ด · #0b0000 จม · #140000 พื้นเพจ — การ์ดใบนี้
// ไล่จาก **การ์ดลงจม (#1c0607 → #0b0000)** ในกรอบ #551c1e ที่สว่างขึ้นเป็นแดงเจล
// ตอน hover ซึ่งเป็นผิวที่ **ยกกว่า §5** ที่นั่งอยู่บนผิวจมทึบ
// ออรามุมซ้ายบนเป็นแดงเจล #fb2e33 จาง มุมขวาล่างเป็น **แดงลึกสุด #8a0608**
// ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาต #8a0608 / #cb0b0d ตรงนั้นได้
// แต่ **ห้ามให้มันถือตัวอักษรเด็ดขาด**
// หัวข้อเป็น **แดงเจล #fb2e33 ทึบสีเดียว ชิดซ้าย พร้อมขีดสั้นใต้หัวข้อ** ไม่ใช่
// bg-clip-text และไม่มีแผ่นถม (5.1:1 บนปลายการ์ด · 5.5:1 บนปลายจม) ซึ่งเป็นทรีต
// เมนต์คนละชุดกับ §5 ที่เป็น **ชิปถมแดงคู่กลีฟ ◆ บนการ์ดมุมตัด**
// เส้นคั่นคอลัมน์และขีดใต้หัวข้อเป็น **#551c1e / #cb0b0d** ซึ่ง §2 อนุญาตให้เป็น
// ขอบ/พื้นถมเท่านั้น · เนื้อความ #f0e6e4 (= BRAND_TEXT, 16.0:1 บนปลายการ์ด ·
// 16.9:1 บนปลายจม)
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #fb2e33** และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(240,230,228,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์แดงจริง จึงต้อง
// เทียบแดงของแบรนด์อื่นทีละหลัก** แดงรอบนี้คือ **#fb2e33 (R251 G46 B51) /
// #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น ค่าที่ต้องไม่เหลือ:
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (**นาซ่า168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 070707 121110 1c1a16 3d3425
//   f3ece0 bfb8aa (**รวย168 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด** ⚠️ 1c1a16 ห่างจาก
//   1c0607 ของรอบนี้แค่ G/B) ·
//   ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (มาดาม168) ·
//   fb141b ff5f63 ffa0a2 db040b 8a0609 (GT66B — ⚠️ fb141b ห่าง #fb2e33 หนึ่งก้าว
//   8a0609 ห่าง #8a0608 หนึ่งก้าว **เจอแล้วแปลว่าพิมพ์ผิด**) · b3121b 5a0a0e f2bba5
//   c98a74 (ขวัญใจ168) · c30303 8f0505 e81313 4a0f0f ffdbdb fff1ef ffeee8 (รวยแท้168) ·
//   eb0305 e40303 c20305 9b0a0c ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) ·
//   d9212a 8e1a16 (ดวงเศรษฐี168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · e4021b (รวยเทพ168) ·
//   d30304 a00203 ff6b6e (รับตัง168) · dc0203 f5282a (หวย365) · ff3b14 6d0804 2b0000
//   (FLASH877) · eeae12 fded41 e0e0df c0c0bf a1a09e (พักยก168) · f5ba14 fcee52 b37c0b
//   ecd5c4 d2b9a4 (เงินทอง168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น** —
// เสื้อกล้ามดำ ผิวนักแสดง และไฮไลต์ขาวบนตัวอักษรเจลเป็น **วัตถุในภาพ ไม่ใช่สี UI**
// และวัสดุที่สองรอบนี้คือ **มุกอุ่น (R>G>B)** ไม่ใช่เงินเย็น
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#551c1e] bg-gradient-to-br from-[#1c0607] to-[#0b0000] p-8 text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-500 hover:border-[#fb2e33]/80 hover:shadow-[0_15px_40px_rgba(251,46,51,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fb2e33]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fb2e33]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8a0608]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#8a0608]/60">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4]">
        {
          leftHeading && (
            <header class="flex flex-col gap-3">
              <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#fb2e33]">{leftHeading}</HeadingTag>
              <div aria-hidden="true" class="h-[3px] w-16 rounded-full bg-gradient-to-r from-[#fb2e33] to-[#cb0b0d]" />
            </header>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6e4] md:border-l md:border-[#551c1e] md:pl-10">
        {titleright && <HeadingTag class="text-center text-xl leading-normal font-black tracking-wide text-[#fb2e33] md:text-left">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
