---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   698..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 600 จึงติดเพดาน
//               max-w-[600px] ของรูป = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl / p-10 / gap-10 / pl-10 + border-l)
// ไม่ใช่ของ ContentBoxSevenThree ที่ถือ §5 บนหน้าเดียวกัน (max-w-[1400px] / gap-8 /
// pl-6 ไม่มี border-l → 352px และ calc(30vw − 68px)) ห้ามลอกข้ามไฟล์
// ⚠️ สไลด์ของดรอปนี้เป็น **แถบแนวนอน 600×200** ไม่ใช่จัตุรัสของดรอปก่อน เพดาน
// max-w-[600px] จึงเป็นพิกเซลจริงพอดี ไม่ใช่การอัปสเกล
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20, brand-spec §2-§5): บนหน้าแรกกล่องนี้ถือ docx H3 §4
// ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน") คู่กับ **slide2.png** ซึ่งพิมพ์
// คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้ในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** เปิดอ่าน
// บิตแมปทั้งสองใบจริงก่อนเขียน alt แล้วรอบนี้ ผู้อัปโหลดเขียนทับสองไฟล์นี้ทุกดรอป
// การจับคู่จึงสลับไปมาระหว่างแบรนด์ ใครก๊อปบรรทัด import ของรอบก่อนมาโดยไม่เปิดดู
// จะได้รูปที่ขัดกับหัวข้อของตัวเอง
// slide3/slide4 (โปสเตอร์ LOTTOPLUS) และ banner2/banner3 เป็นอาร์ตของแบรนด์อื่น
// **ห้าม import** เพราะ eager import = emit และจะทำให้ verify-build แดง
//
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2) การ์ดเป็น
// มุมโค้ง 3xl ไล่จากผิวยก #3b1b0e ลงผิวกลาง #260d04 ในกรอบบรอนซ์ลึก #5c2a06 ที่
// สว่างขึ้นเป็นทองแบรนด์ #f0bb4e ตอน hover
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #3b1b0e ยก /
// #260d04 กลาง / #0d0501 จม / #000000 พื้น — ไม่มีผิวไหนจมต่ำกว่าพื้นได้
// ออรามุมซ้ายบนเป็นทองแบรนด์ (ริ้วทอง มงกุฎ และเหรียญทองร่วงในงานอาร์ต) มุมขวาล่าง
// เป็น **แดงชาด** (เลข 168 บนโลโก้ ชิปคาสิโนแดง-ขาว หัวใจแดง และกล่องของขวัญแดง)
// และ **ทองมาก่อนแดง** ตามลำดับนำของรอบนี้ ⚠️ ออราเป็น **พื้นถม** ไม่ใช่ตัวอักษร
// แดงจึงอยู่ตรงนั้นได้ ทั้งที่ §2 วัดแดงไว้ 3.2–4.3:1 และห้ามให้ถือตัวอักษร
// หัวข้อไล่ ทองแบรนด์ #f0bb4e → ทองแดง #d9701a → ครีมทอง #ffeccb ซึ่งเป็นลำดับ
// คนละชุดกับกล่องอื่นบนหน้าเดียวกัน ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซล
// ของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (#f0bb4e 8.8:1 · #d9701a 4.7:1
// · #ffeccb 13.4:1 บนผิวยก) — ห้ามเอา #e4021b หรือ #5c2a06 มาเป็นสต็อป
// เนื้อความ #fff8ec (= BRAND_TEXT, 14.7:1 บนผิวยก) glow ที่ใช้คือ
// rgba(240,187,78,…) ตาม §2 · #f0bb4e สงวนไว้ให้ <strong> ในย่อหน้า จึงโผล่ใน
// ไฟล์นี้แค่ที่ต้นไล่เฉดของหัวข้อกับออรา
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้
// และแดงนำมาแล้วสี่แบรนด์** การเจอทองหรือแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ทองรอบนี้คือ **#f0bb4e** (R240 G187 B78) ⚠️ **R ตรงกับ f0b429 ของรับตัง168 เป๊ะ
// ตัวตัดสินคือ B78 vs B41** และไม่ใช่ fcd45c (มีเฮ168 รอบก่อน) f9a826 704504
// (รวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ทั้งชุด) fef54b (นินจา168) ffc82e (สบายเบท168)
// ffd84d (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) e3b23c (สมหวัง168)
// dfa310 ffc93d ffe4a3 (TND168) f2c230 ffe066 (KINGKONG555) e2b33f (KMD88) e5a81b
// (UFA324) fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f3bb34
// (DUCK1688) หรือ fbe455 (WEPLAY168)
// แดงรอบนี้คือ **#e4021b** (R228 G2 B27) ไม่ใช่ fb1b32 ff8f9c 5c0410 (มีเฮ168)
// fa0513 ff5a5f ffadaf (สมหวัง168) d30304 ff6b6e a00203 4a0202 (รับตัง168) b3121b
// 5a0a0e (ขวัญใจ168) fb131b ff4d55 (TKB55) หรือ fb141b ff5f63 (GT66B)
// ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (039cfa c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba 3/156/250) ชุดของ
// สบายเบท168 (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 dceefc) ชุดทอง-ชมพูบานเย็น
// ของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c
// 160a12 0b0509) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทองไทย-แดงมังกรของรับตัง168
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c f5ece0 2b100f 200a09 140505)
// ชุดโรสโกลด์ของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06) ชุดของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f
// 1a0708 0d0304 c40304 8a0206 53050a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff
// c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f ffdf8c ece2f8) ชุดน้ำเงินไฟฟ้าของ
// TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffd94a f0c3dc fde7f2)
// ชุดทองมังกรของ TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ชุดทองอำพันเสือ
// ของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) และชุดทองแชมเปี้ยน
// ของ UFA324 (e5a81b b9c2cc 231c0e f0e8d4 ffe08a 7d5a07 464f5a) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** ส้มตัวเดียวที่อนุญาตคือ
// ทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5c2a06] bg-gradient-to-br from-[#3b1b0e]/96 to-[#260d04]/96 p-8 text-[#fff8ec] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0bb4e]/85 hover:shadow-[0_15px_40px_rgba(240,187,78,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f0bb4e]/34 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeccb]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e4021b]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#d9701a]/45">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f0bb4e] via-[#d9701a] to-[#ffeccb] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8ec] md:border-l md:border-[#5c2a06] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f0bb4e] via-[#d9701a] to-[#ffeccb] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
