---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// HENG35: นี่คือครึ่ง "การ์ดมน" ของคู่บล็อกรูป+ข้อความ ส่วน ContentBoxSevenThree
// ที่เป็นพี่น้องกันใช้ทรงเดียวกันแต่เป็นกรอบทองคมและหัวข้อทึบ สองบล็อกนี้วางติดกัน
// บนหน้าแรก (คืนยอดเสีย แล้วค่อยแนะนำเพื่อน) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกัน
// ซ้ำสองรอบ ที่นี่ทองสว่าง #fefac4 เป็นหัวไล่เฉดของหัวข้อ ส่วนออร่าสองมุมเป็น
// ทองหลัก #ecc55c กับบรอนซ์ #a3732c — แยกชั้นด้วยความสว่างของทองสีเดียว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ecc55c]/55 bg-gradient-to-br from-[#12100b]/94 to-[#070605]/96 p-8 text-[#ece1cb] shadow-[0_10px_30px_rgba(7,6,5,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fefac4]/80 hover:shadow-[0_15px_40px_rgba(236,197,92,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fefac4]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fefac4]/26">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#a3732c]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ecc55c]/36">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fefac4] via-[#ffdf8a] to-[#ecc55c] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece1cb] md:border-l md:border-[#5e4418] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fefac4] via-[#ecc55c] to-[#a3732c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
