---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// This is the BRUSHED-SILVER half of the pair of promo blocks — its sibling
// ContentBoxSevenThreeFloatingBadge runs the same 3/7 layout in crimson with a
// floating badge, so the two 0.8% / 0.3% promos stacked back to back do not read
// as the same card twice. The crimson accent shows up here twice only: as the
// deep aura on the far corner and as the tail of the right-hand heading
// gradient. It is the logo's arrow hue and it stops being an accent if it is
// everywhere.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3a3d45] bg-gradient-to-br from-[#17181c]/92 to-[#0c0d10]/94 p-8 text-[#d5dae2] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#e7eaef]/45 hover:shadow-[0_15px_40px_rgba(231,234,239,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e7eaef]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e7eaef]/20">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#cd1437]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f0435f]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#e7eaef] via-[#c3c8d1] to-[#8d939e] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2] md:border-l md:border-[#3a3d45] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e7eaef] via-[#ffb3bf] to-[#f0435f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
