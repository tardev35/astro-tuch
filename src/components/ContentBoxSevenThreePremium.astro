---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4c1095]/35 bg-gradient-to-br from-[#1c0b2a]/92 to-[#060210]/88 p-8 text-[#e4d9f5] shadow-[0_10px_30px_rgba(168,85,247,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#a855f7]/55 hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#a855f7]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#d8a7ff]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#2c046a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e53cfe]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#e6e8ec] via-[#d8a7ff] to-[#4c1095] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4d9f5] md:border-l md:border-[#2c046a] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#d8a7ff] via-[#e6e8ec] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
