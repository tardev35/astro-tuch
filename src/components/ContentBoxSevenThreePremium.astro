---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// This is the EMERALD half of the pair of promo blocks — its sibling
// ContentBoxSevenThree runs the same layout in coin gold, so the two 0.8% /
// 0.3% promos stacked back to back do not read as the same card twice.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0f9d47]/40 bg-gradient-to-br from-[#0b2c17]/92 to-[#010905]/90 p-8 text-[#c8e3d0] shadow-[0_10px_30px_rgba(2,13,7,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#57dd8f]/75 hover:shadow-[0_15px_40px_rgba(87,221,143,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0f9d47]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#0f9d47]/36">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e2f3e6]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#e2f3e6]/24">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#d9f7e3] via-[#57dd8f] to-[#116330] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8e3d0] md:border-l md:border-[#0f9d47]/40 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f3fbf5] via-[#57dd8f] to-[#0f9d47] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
