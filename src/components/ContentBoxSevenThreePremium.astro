---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// MIRACLE55 (รอบทอง-เงินโครเมียม-ดำ 2026-09-25): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่
// บล็อกรูป+ข้อความ ส่วน ContentBoxSevenThree (ตัวธรรมดา) ที่เป็นคู่กันใช้หัวข้อเงิน
// โครเมียมทึบไม่ไล่เฉด สองบล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืน
// ยอดเสีย 0.3%) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับ
// โลหะบนโลโก้ คือทองสว่าง #fee47b → ขาวโครเมียม #fcfcfc → ทองแบรนด์ #d9a62b ส่วน
// ออร่าสองมุมเป็นทองกับเงินโครเมียม #d2d3d4 บนการ์ดที่ไล่จากพื้นการ์ด #14100a ลงไป
// หาพื้นเพจ #050403 เส้นคั่นกลางเป็นทองลึก #8c5f14 เนื้อความ #e8e6e1 (BRAND_TEXT)
// — ทอง-โครเมียมของ UWIN33 (#e0b429 #fbd564 #7a5407 #dfe4ec #161106 #080602
// #ece6d8) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8c5f14]/60 bg-gradient-to-br from-[#14100a]/94 to-[#050403]/96 p-8 text-[#e8e6e1] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcda65]/80 hover:shadow-[0_15px_40px_rgba(252,218,101,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d9a62b]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fee47b]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#d2d3d4]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#d2d3d4]/26">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8e6e1] md:border-l md:border-[#8c5f14]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fee47b] via-[#fcfcfc] to-[#d9a62b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
