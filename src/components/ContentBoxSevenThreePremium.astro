---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7c0207]/35 bg-gradient-to-br from-[#170406]/92 to-[#0b0203]/88 p-8 text-[#dfe3ea] shadow-[0_10px_30px_rgba(232,18,29,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8121d]/55 hover:shadow-[0_15px_40px_rgba(232,18,29,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e8121d]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4d55]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#5a0104]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e8121d]/28"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfe3ea]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#eef1f6] via-[#c2c9d4] to-[#7c0207] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfe3ea] md:border-l md:border-[#3d0104] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ff4d55] via-[#eef1f6] to-[#e8121d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
