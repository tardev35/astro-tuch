---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// This is the CHROME-SILVER half of the pair of promo blocks — its sibling
// ContentBoxSevenThree runs the same layout in metallic gold, so the two
// 0.8% / 0.3% promos stacked back to back do not read as the same card twice.
// The red accent shows up once, as a hairline in the deep aura, and nowhere
// else: it is the logo's "+" and it stops being an accent if it is everywhere.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8b939c]/40 bg-gradient-to-br from-[#0b2547]/92 to-[#02101f]/94 p-8 text-[#ccd6e6] shadow-[0_10px_30px_rgba(2,16,31,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#e6ebf0]/60 hover:shadow-[0_15px_40px_rgba(230,235,240,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e6ebf0]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e6ebf0]/20">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c0202b]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#dd3a3f]/24">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ccd6e6]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#e6ebf0] via-[#c9d2dc] to-[#8b939c] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ccd6e6] md:border-l md:border-[#8b939c]/35 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e6ebf0] via-[#f2dc9a] to-[#d9b45e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
