---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6a5115]/75 bg-gradient-to-br from-[#120c04]/92 to-[#050301]/88 p-8 text-[#f0e2bd] shadow-[0_10px_30px_rgba(204,156,45,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#cc9c2d]/80 hover:shadow-[0_15px_40px_rgba(204,156,45,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#cc9c2d]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#d8ae3a]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e8bf4e]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fae27c]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2bd]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#6a5115] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e2bd] md:border-l md:border-[#6a5115] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fff6d4] via-[#d8ae3a] to-[#fae27c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
