---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1e3a6b]/55 bg-gradient-to-br from-[#0f1e3d]/92 to-[#03060f]/88 p-8 text-[#cbd5e1] shadow-[0_10px_30px_rgba(59,130,246,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#cbd5e1]/60 hover:shadow-[0_15px_40px_rgba(203,213,225,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#3b82f6]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#60a5fa]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#cbd5e1]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#cbd5e1]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cbd5e1]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#cbd5e1] via-[#93c5fd] to-[#1d4ed8] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cbd5e1] md:border-l md:border-[#1e3a6b] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f1f5f9] via-[#93c5fd] to-[#cbd5e1] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
