---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+ข้อความ
// ส่วน ContentBoxSevenThreeFloatingBadge ที่เป็นคู่กันใช้ป้ายหัวข้อลอย สองบล็อกนี้วางติดกัน
// บนหน้าแรก (2ตัว จ่าย100บาท แล้วค่อย 3ตัว จ่าย1,000บาท) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกัน
// ซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ข้อความอยู่ขวา 7fr ส่วน
// อีกใบกลับด้านเป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา หัวข้อไล่ตามลำดับสีบนเวิร์ดมาร์ก
// คือทองอ่อน #fdea83 → ทองแบรนด์ #e0a52a → แดงแบรนด์ #8b0302 ตามที่โลโก้เขียน
// "หวย" แดงแล้วปิดด้วย "เฮง24" ทอง ออร่าสองมุมแยกหน้าที่ตามคู่สีนั้น คือทองมุมซ้ายบนกับ
// แดงแบรนด์มุมขวาล่าง บนการ์ดที่ไล่จากผิวการ์ด #2e0707 ลงไปหาพื้นเพจ #1a0505 กรอบและ
// เส้นคั่นกลางเป็นแดงกลาง #720202 ซึ่งเป็นเส้นแดงล้วน ไม่ใช่กรอบทองแบบการ์ดใบอื่น เพื่อให้
// สองบล็อกในคู่นี้ต่างกันตั้งแต่ขอบ เนื้อความ #f6e6cf (BRAND_TEXT) — ชุดน้ำเงินรอยัล-ทอง
// ของ BRAVO168 (#1558c4 #0e3f8f #2f86f0 #f4cb69 #ffe39a #c9922e #04142f #02081a
// #dbe5f5) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#720202] bg-gradient-to-br from-[#2e0707]/94 to-[#1a0505]/96 p-8 text-[#f6e6cf] shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a52a]/70 hover:shadow-[0_15px_40px_rgba(224,165,42,0.40)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e0a52a]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#fdea83]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8b0302]/34 blur-[60px] transition-all duration-500 group-hover:bg-[#c01616]/38">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6cf] md:border-l md:border-[#720202] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
