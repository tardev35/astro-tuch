---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ebbc4c]/30 bg-gradient-to-br from-[#1c140a]/92 to-[#0a0603]/88 p-8 text-[#f0e6c8] shadow-[0_10px_30px_rgba(235,188,76,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebbc4c]/60 hover:shadow-[0_15px_40px_rgba(235,188,76,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ebbc4c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fcf3ab]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#845a23]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#9a6d25]/35"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6c8]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#fcf3ab] via-[#ebbc4c] to-[#9a6d25] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6c8] md:border-l md:border-[#2a1c0a] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#fcf3ab] via-[#ebbc4c] to-[#9a6d25] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
