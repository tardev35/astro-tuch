---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#2f7a2a]/55 bg-gradient-to-br from-[#0b2415]/92 to-[#04120a]/88 p-8 text-[#d6e6cc] shadow-[0_10px_30px_rgba(105,181,34,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#dbaa8a]/60 hover:shadow-[0_15px_40px_rgba(219,170,138,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#69b522]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#9ada4e]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#dbaa8a]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#dbaa8a]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e6cc]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#dbaa8a] via-[#b6e87a] to-[#0b5232] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6e6cc] md:border-l md:border-[#2f7a2a] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#eefae4] via-[#b6e87a] to-[#dbaa8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
