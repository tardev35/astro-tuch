---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-24** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้
// src/pages/index.astro ด้วย (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก
// max-w-* จึงคุมกล่องรวม padding และ border):
//   section max-w-7xl(1280) + px-4(16x2=32) · card border(1x2=2) · md:p-10(40x2=80)
//   · grid gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   >=1280px  : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768..1279 : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                          = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (md:p-10 · gap-10 · md:pl-10) ไม่ใช่ของ
// **ContentBoxSevenThreeCyberCut** ที่ถือ §5 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8
// ล้วน · gap-8 · md:pl-8 แล้วออกมา **312px / calc(30vw - 72px)** — ต่างกัน 15px
// ที่ 1x และ 15px ใน calc() **ห้ามลอกตัวเลขข้ามไฟล์ และห้ามลอกจากรอบก่อน**
// ⚠️⚠️ **สไลด์ของดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดจึงเป็น **375**
// (1x ของใบนี้คือ 297px ซึ่ง 2x = 594 เกินบิตแมป จึงตกลงมาที่ 375)
// **ห้ามมี candidate สูงกว่านั้น** เพราะไม่ใช่พิกเซลจริง และ **alt ห้ามระบุ
// ทิศทาง/ขนาดของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24, .claude/brand-spec-bohba168.md §1–§6): บนหน้าแรก
// กล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน" —
// content.txt บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide1.png** ซึ่งพิมพ์
// คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้บนแคปซูลในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** uploader
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ — รอบนี้เปิดอ่าน
// ทั้งสองใบจริงแล้ว: slide1 = คืนยอดเสีย 0.3% (ใบนี้) · slide2 = แนะนำเพื่อน 0.8%
// ⛔ slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์อื่น **ห้าม import**
// เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน render
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2 และสไลด์ที่
// ใช้ได้รอบนี้ก็มีสองใบพอดี)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้กลับทิศเป็นธีมสว่าง** พื้นเพจ #00bfff (bg.json) =
// ฟ้าสกายอิ่มตัว **ห้าม "แก้" การ์ดให้กลับไปมืด และห้ามเหลือแดง/มุก/ดำอมแดงไว้
// เลยสักค่า**
// ลำดับผิว: #ffffff การ์ด · #f0faff ยก · #e4f6fb wash · #00bfff พื้นเพจ — การ์ดใบนี้
// ไล่จาก **การ์ดขาวลงผิวยก (#ffffff → #f0faff)** ในกรอบ #7fcbe8 ที่อิ่มเป็นฟ้าสกาย
// ตอน hover ซึ่งเป็นผิวที่ **ยกกว่า §5** ที่นั่งอยู่บนผิวยกทึบ #f0faff
// ออรามุมซ้ายบนเป็นฟ้าสกาย #12b4ef จาง มุมขวาล่างเป็น **ฟ้าพาสเทล #b6e3f0**
// ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาต #12b4ef / #b6e3f0 ตรงนั้นได้
// แต่ **ห้ามให้มันถือตัวอักษรบนผิวสว่างเด็ดขาด (2.4:1 / 1.3:1)**
// หัวข้อเป็น **ฟ้าลึก #0f5684 ทึบสีเดียว ชิดซ้าย พร้อมขีดสั้นใต้หัวข้อ** ไม่ใช่
// bg-clip-text และไม่มีแผ่นถม (7.8:1 บนปลายการ์ดขาว · 7.3:1 บนปลายผิวยก) ซึ่งเป็น
// ทรีตเมนต์คนละชุดกับ §5 ที่เป็น **ชิปถมฟ้าคู่กลีฟเมฆ ☁ บนการ์ดมุมตัด**
// เส้นคั่นคอลัมน์และขีดใต้หัวข้อเป็น **#7fcbe8 / #12b4ef / #b6e3f0** ซึ่ง §2 อนุญาต
// ให้เป็นขอบ/พื้นถมเท่านั้น · เนื้อความ #06283f (= BRAND_TEXT, 15.2:1 บนปลายการ์ด ·
// 14.3:1 บนปลายผิวยก)
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #0f5684** และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์ฟ้าจริง จึงต้อง
// เทียบฟ้าของแบรนด์อื่นทีละหลัก** ฟ้ารอบนี้คือ **#12b4ef (R18 G180 B239) /
// #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 / #1a6ea8 / #06283f** เท่านั้น
// ค่าที่ต้องไม่เหลือ:
//   fb2e33 cb0b0d d81115 b00d11 8a0608 f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000
//   1c0607 2a0c0d 551c1e (**สล็อต168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 ffe9f5 7a4463 (**หมูบิน168 — แบรนด์ขาออก เสี่ยงหลงเหลือ
//   สูงสุด**) ·
//   1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434 121722 33455f
//   0d1017 (นาซ่า168) · 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733 050e26 00091f
//   f4eef1 d9dfe9 b3bdd6 (มาดาม168) · 18a5e2 0d6b9b 0a5176 a9d7f2 (ร่ำรวย168 —
//   ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13 เจอแล้วแปลว่าพิมพ์ผิด**) ·
//   2cc3fc 6bdcfb 0a7fbd 063a57 (สบาย168 — ⚠️ **063a57 R=06 ตรงกับ #06283f เป๊ะ**) ·
//   32bcfb a9e9ff 07335f (นินจา168) · 039cfa 0494f5 c3ebfc (รวยแทร่168) · 2f9ff5
//   a8dcff d6ecff 0b3f78 e8f4ff (สบายเบท168) · 0360f3 0292fb 6ec8ff cfdcec 9db4d4
//   (TSDET911) · eeae12 fded41 9f600d e0e0df c0c0bf a1a09e (พักยก168) · f5ba14
//   fcee52 b37c0b ecd5c4 d2b9a4 (เงินทอง168) · ffd94a e3a712 9d6f06 f3ece0 bfb8aa
//   (รวย168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน** — เสื้อคลุมถัก
// ฟ้าอ่อน ฉากสตูดิโอขาว ดาวเหลือง เหรียญทอง และสีผิวนักแสดงเป็น **วัตถุในภาพ
// ไม่ใช่สี UI** และวัสดุที่สองรอบนี้คือ **ขาว/ฟ้าพาสเทล (B>G>R)** ไม่ใช่มุกอุ่น
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7fcbe8] bg-gradient-to-br from-white to-[#f0faff] p-8 text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.13)] transition-all duration-500 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#12b4ef]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#12b4ef]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#b6e3f0]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#b6e3f0]/70">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#06283f]">
        {
          leftHeading && (
            <header class="flex flex-col gap-3">
              <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0f5684]">{leftHeading}</HeadingTag>
              <div aria-hidden="true" class="h-[3px] w-16 rounded-full bg-gradient-to-r from-[#12b4ef] to-[#b6e3f0]" />
            </header>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#06283f] md:border-l md:border-[#7fcbe8] md:pl-10">
        {titleright && <HeadingTag class="text-center text-xl leading-normal font-black tracking-wide text-[#0f5684] md:text-left">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
