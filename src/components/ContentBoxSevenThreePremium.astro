---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   698..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 600 จึงติดเพดาน
//               max-w-[600px] ของรูป = 600px
//   <698      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl / p-10 / gap-10 / pl-10 + border-l)
// ไม่ใช่ของ ContentBoxSevenThree ที่ถือ §4 บนหน้าเดียวกัน (max-w-[1400px] / gap-8 /
// pl-6 ไม่มี border-l → 352px และ calc(30vw − 68px)) ห้ามลอกข้ามไฟล์
// ⚠️ สไลด์ของดรอปนี้วัดจากบิตแมปจริงได้ **600×334** (brand-spec §5 เขียนว่าจัตุรัส
// 600×600 ซึ่งคลาดจากไฟล์จริง แต่ **ความกว้าง 600 ตรงกัน** จึงไม่กระทบ widths/sizes)
// เพดาน max-w-[600px] จึงเป็นพิกเซลจริงพอดี ไม่ใช่การอัปสเกล
//
// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
// 2026-10-20, brand-spec §2-§5): บนหน้าแรกกล่องนี้ถือ docx H3 §5
// ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด") คู่กับ **slide1.png** ซึ่งพิมพ์
// คำว่า โปรโมชั่น / แนะนำเพื่อน / 0.8% ไว้ในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** เปิดอ่าน
// บิตแมปทั้งสองใบจริงก่อนเขียน alt แล้วรอบนี้ ผู้อัปโหลดเขียนทับสองไฟล์นี้ทุกดรอป
// การจับคู่จึงสลับไปมาระหว่างแบรนด์ ใครก๊อปบรรทัด import ของรอบก่อนมาโดยไม่เปิดดู
// จะได้รูปที่ขัดกับหัวข้อของตัวเอง
// slide3/slide4 (โปสเตอร์ LOTTOPLUS) และ banner2/banner3 เป็นอาร์ตของแบรนด์อื่น
// **ห้าม import** เพราะ eager import = emit และจะทำให้ verify-build แดง
//
// นี่คือบล็อกรูป+ข้อความบล็อกที่สองจากสองบล็อก (เพดานของ playbook คือ 2) การ์ดเป็น
// มุมโค้ง 3xl ไล่จากผิวยก #4e2120 ลงผิวกลาง #300605 ในกรอบแดงเลือดหมู #8e1a16 ที่
// สว่างขึ้นเป็นทองน้ำผึ้ง #f0c878 ตอน hover
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ลำดับความลึก: #4e2120 ยก /
// #300605 กลาง / #150303 จม / #000000 พื้น — ไม่มีผิวไหนจมต่ำกว่าพื้นได้
// ออรามุมซ้ายบนเป็นทองน้ำผึ้ง (มงกุฎ กองเหรียญทอง และโคมระย้าในงานอาร์ต) มุมขวาล่าง
// เป็น **แดงชาด** (เลข 168 บนโลโก้ และหมวกทรงจีนของไฉ่ซิงเอี๊ย) และ **ทองมาก่อนแดง**
// ตามลำดับนำของรอบนี้ ⚠️ ออราเป็น **พื้นถม** ไม่ใช่ตัวอักษร แดงจึงอยู่ตรงนั้นได้
// ทั้งที่ §2 วัดแดงไว้ 2.7:1 บนผิวการ์ด และห้ามให้ถือตัวอักษร
// หัวข้อไล่ ทองน้ำผึ้ง #f0c878 → งาช้าง #fff8d8 (สองสต็อป ไม่มีสต็อปกลาง) ซึ่งเป็น
// ลำดับคนละชุดกับกล่องอื่นบนหน้าเดียวกัน ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือ
// พิกเซลของตัวอักษร** ทุกสต็อปจึงต้องถือตัวอักษรได้ตาม §2 (#f0c878 8.5:1 ·
// #fff8d8 12.6:1 บนผิวยก) — ห้ามเอา #d9212a หรือ #8e1a16 มาเป็นสต็อป
// เนื้อความ #fff8d8 (= BRAND_TEXT, 12.6:1 บนผิวยก) glow ที่ใช้คือ
// rgba(240,200,120,…) ตาม §2 · #f0c878 สงวนไว้ให้ <strong> ในย่อหน้า จึงโผล่ใน
// ไฟล์นี้แค่ที่ต้นไล่เฉดของหัวข้อกับออรา
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้
// และแดงนำมาแล้วหลายแบรนด์** การเจอทองหรือแดงในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ทองรอบนี้คือ **#f0c878** (R240 G200 B120) ตัวที่ใกล้ที่สุดในรีโปคือ ffdc8c ของ
// รับตัง168 (ระยะ 32) และ f6e3b4 ของ ufalion168 รอบก่อน · และไม่ใช่ d4922c fdfc71
// a25b24 8c4312 d39c45 33200a 1f1304 0a0601 5a3310 1a1000 (ufalion168 ที่เพิ่งออก)
// f0bb4e ffeccb d9701a 5c2a06 (รวยเทพ168) fcd45c (มีเฮ168) f9a826 704504
// (รวยแทร่168) fef54b (นินจา168) ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434
// (มีโชค168) f7c92b (ขวัญใจ168) e3b23c (สมหวัง168) dfa310 ffc93d ffe4a3 (TND168)
// f2c230 ffe066 (KINGKONG555) e2b33f (KMD88) e5a81b (UFA324) fad354 (789BETTING)
// f5c518 (FLASH877) fce343 (PUNPRO168) f3bb34 (DUCK1688) หรือ fbe455 (WEPLAY168)
// แดงรอบนี้คือ **#d9212a** (R217 G33 B42) ไม่ใช่ e4021b (รวยเทพ168) fb1b32 ff8f9c
// 5c0410 (มีเฮ168) fa0513 ff5a5f ffadaf (สมหวัง168) d30304 ff6b6e a00203 4a0202
// (รับตัง168) b3121b 5a0a0e (ขวัญใจ168) fb131b ff4d55 (TKB55) หรือ fb141b ff5f63
// (GT66B) · แดงเลือดหมู **#8e1a16** ไม่ใช่ 8c0204 (สมหวัง168)
// ชุดบรอนซ์-ทองอำพันของ ufalion168 (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4
// 33200a 1f1304 0a0601 5a3310 1a1000 กับ rgba 212/146/44, rgba 253/252/113 และ
// rgba 162/91/36) ชุดทองจักรพรรดิ-แดงชาดของรวยเทพ168 (f0bb4e ffeccb e4021b d9701a
// 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400) ชุดฟ้าอะซัวร์ของรวยแทร่168 (039cfa
// c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba 3/156/250)
// ชุดของสบายเบท168 (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 dceefc) ชุดทอง-ชมพูบานเย็น
// ของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c
// 160a12 0b0509) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทองไทย-แดงมังกรของรับตัง168
// (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c f5ece0 2b100f 200a09 140505)
// ชุดโรสโกลด์ของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12
// eadfce 140c06) ชุดของ TKB55 (fb131b ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f
// 1a0708 0d0304 c40304 8a0206 53050a) ชุดม่วงราชา-ทองของ KMD88 (7505cc b453ff
// c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f ffdf8c ece2f8) ชุดน้ำเงินไฟฟ้าของ
// TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26)
// ชุดชมพูฮอตพิงก์-ทองของ PUNPRO168 (f41571 ff5ca8 fce343 ffd94a f0c3dc fde7f2)
// ชุดทองมังกรของ TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ชุดทองอำพันเสือ
// ของ TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) และชุดทองแชมเปี้ยน
// ของ UFA324 (e5a81b b9c2cc 231c0e f0e8d4 ffe08a 7d5a07 464f5a) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม ไม่มีเหลืองมะนาว ไม่มีส้มสด และไม่มีบรอนซ์**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8e1a16] bg-gradient-to-br from-[#4e2120]/96 to-[#300605]/96 p-8 text-[#fff8d8] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0c878]/85 hover:shadow-[0_15px_40px_rgba(240,200,120,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f0c878]/34 blur-[60px] transition-all duration-500 group-hover:bg-[#fff8d8]/40">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#d9212a]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#8e1a16]/55">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8d8]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f0c878] to-[#fff8d8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fff8d8] md:border-l md:border-[#8e1a16] md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#f0c878] to-[#fff8d8] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
