---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): นี่คือครึ่ง "การ์ดไล่เฉด
// กรอบเขียว" ของคู่บล็อกรูป+ข้อความ ส่วน ContentBoxSevenThreeFloatingBadge ที่เป็น
// คู่กันเป็นการ์ดกรอบทองพร้อมป้ายลอย สองบล็อกนี้วางติดกันบนหน้าแรก (คืนยอดเสีย 0.3%
// แล้วค่อย แนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ และรูปถูก
// วางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ข้อความอยู่ขวา 7fr ส่วนอีกใบกลับด้าน
// เป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา
//
// แบรนด์นี้เป็นเขียวนำ แดงรอง ทองเสริม บนดำอมเขียว (logo.webp เป็นตัว D เขียว vivid
// #01841b #018b1b ซ้อนตัว M แดง #fb252b #bb0303 #f91c20 ส่วน banner1.png dominant
// เป็นดำอมเขียว #05140c #0b1b13 #031404) หัวข้อจึงไล่ขาวนวล #e4f2e4 → เขียวสว่าง
// #4ade6b → แดงแบรนด์ #fb252b (4.7:1 บนผิวการ์ด พอสำหรับหัวข้อตัวใหญ่หนา) ซึ่งเป็น
// คนละชุดกับการ์ดก่อนหน้าและถัดไปที่ไล่ "ทองไปเขียว" ออร่าสองมุมเป็นเขียวแบรนด์
// มุมซ้ายบนกับแดงแบรนด์มุมขวาล่าง ตามคู่ D/M ของโลโก้ บนการ์ดที่ไล่จากผิวการ์ด
// #0a1a0e ลงไปหาพื้นลึกสุด #030a05 กรอบและเส้นคั่นกลางเป็นเขียวลึก #0a4a18 ซึ่งเป็น
// เส้นเขียวที่เข้มสุดในพาเลตต์ ไม่ใช่กรอบทองสว่างแบบการ์ดคู่ของมัน เพื่อให้สองบล็อก
// ในคู่นี้ต่างกันตั้งแต่ขอบ เนื้อความ #e4f2e4 (BRAND_TEXT)
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #ffc93c #ffeab0
// #c08a07 #240406 #140203 #f6e7e0) ออกครบทุกจุดแล้ว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0a4a18] bg-gradient-to-br from-[#0a1a0e]/95 to-[#030a05]/96 p-8 text-[#e4f2e4] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#01a326]/80 hover:shadow-[0_15px_40px_rgba(1,163,38,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#01a326]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#4ade6b]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fb252b]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#ff6b6e]/32">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#e4f2e4] via-[#4ade6b] to-[#fb252b] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4f2e4] md:border-l md:border-[#0a4a18] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e4f2e4] via-[#4ade6b] to-[#fb252b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
