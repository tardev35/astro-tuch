---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const leftHeading = titleleft ?? title;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์รูป (3fr ฝั่งขวา) ที่หน้าแรกคิด `widths`/`sizes` จาก —
// **คำนวณใหม่ทั้งชุดสำหรับดรอป 2026-10-24** ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้
// src/pages/index.astro ด้วย (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก
// max-w-* จึงคุมกล่องรวม padding และ border):
//   section max-w-7xl(1280) + px-4(16x2=32) · card border(1x2=2) · md:p-10(40x2=80)
//   · grid gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   >=1280px  : (1280 - 32 - 2 - 80 - 40) x 0.3 - 41 = 1126 x 0.3 - 41 = 297px
//   768..1279 : (100vw - 154) x 0.3 - 41             = calc(30vw - 87px)
//   473..767  : ยุบเหลือคอลัมน์เดียวที่ p-8 -> 100vw - 98 ซึ่งเกิน 375 จึงติดเพดาน
//               max-w-[375px] ของบิตแมป                          = 375px
//   <473      : คอลัมน์เดียวที่ p-8                                = calc(100vw - 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (md:p-10 · gap-10 · md:pl-10) ไม่ใช่ของ
// **ContentBoxSevenThreeCyberCut** ที่ถือ §5 บนหน้าเดียวกันรอบนี้ ซึ่งเป็น p-8
// ล้วน · gap-8 · md:pl-8 แล้วออกมา **312px / calc(30vw - 72px)** — ต่างกัน 15px
// ที่ 1x และ 15px ใน calc() **ห้ามลอกตัวเลขข้ามไฟล์ และห้ามลอกจากรอบก่อน**
// ⚠️⚠️ **สไลด์ของดรอปนี้วัดได้ 375x600 ทั้งสองใบ** เพดานกว้างสุดจึงเป็น **375**
// (1x ของใบนี้คือ 297px ซึ่ง 2x = 594 เกินบิตแมป จึงตกลงมาที่ 375)
// **ห้ามมี candidate สูงกว่านั้น** เพราะไม่ใช่พิกเซลจริง และ **alt ห้ามระบุ
// ทิศทาง/ขนาดของภาพ** ให้บรรยายสิ่งที่วาดอยู่แทน
//
// ───────────────────────────────────────────────────────────────────────────
// MEXICANOSLOT (ดรอป 2026-10-24, .claude/brand-spec-mexicanoslot.md §1–§6):
// บนหน้าแรกกล่องนี้ถือ **docx H3 §4** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสได้ทุกวัน"
// — content.txt บรรทัด 9, ย่อหน้าเต็มอยู่บรรทัด 10) คู่กับ **slide2.png** ซึ่ง
// พิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% และแคปซูลแดงขอบทอง แจกโบนัสทั้งวัน
// ไว้บนตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** uploader
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ — รอบนี้เปิดอ่าน
// ทั้งสองใบจริงแล้วและ **สลับทิศจากรอบก่อน**: slide2 = คืนยอดเสีย 0.3% (ใบนี้ ·
// หญิงสาวสวมซอมเบรโรติดดอกไม้แดง โลโก้อยู่มุมบนซ้าย) · slide1 = แนะนำเพื่อน 0.8%
// ⛔ slide3/slide4 และ banner2/banner3 เป็นอาร์ตของแบรนด์อื่น **ห้าม import**
// เพราะ eager import = emit ขึ้น dist ทุก build แม้ไม่มีหน้าไหน render
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2 และสไลด์ที่
// ใช้ได้รอบนี้ก็มีสองใบพอดี)
//
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ฟ้าสกายบับเบิลบนธีมสว่างของ โบ๊ะบ๊ะ168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมสว่างเหมือนกัน แต่คนละค่าทุกตัว** พื้นเพจ
// #fef6fb (bg.json) = ขาวอมชมพูจาง **ห้ามเหลือฟ้า/ไซแอน/น้ำเงินไว้เลยสักค่า**
// ลำดับผิว: #ffffff การ์ด · #fff3ea ยก · #fde4d3 wash · #fef6fb พื้นเพจ — การ์ด
// ใบนี้ไล่จาก **การ์ดขาวลงผิวยก (#ffffff → #fff3ea)** ในกรอบ #f6c4a4 ที่อิ่มเป็น
// แดงเม็กซิกันตอน hover ซึ่งเป็นผิวที่ **ยกกว่า §5** ที่นั่งอยู่บนผิวยกทึบ #fff3ea
// ออรามุมซ้ายบนเป็นแดง #de2b1e จาง มุมขวาล่างเป็น **พีชฟาง #fed7b5**
// ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** — §2 จึงอนุญาต #de2b1e / #fed7b5 ตรงนั้นได้
// แต่ **ห้ามให้มันถือตัวอักษรบนผิวสว่างเด็ดขาด (4.0:1 / 1.3:1)**
// หัวข้อเป็น **แดงลึก #a81410 ทึบสีเดียว ชิดซ้าย พร้อมเส้นใต้สามสต็อปเต็มความกว้าง
// ของคอลัมน์ข้อความ** ไม่ใช่ bg-clip-text และไม่มีแผ่นถม (7.6:1 บนปลายการ์ดขาว ·
// 7.2:1 บนปลายผิวยก) ซึ่งเป็นทรีตเมนต์คนละชุดกับ §3 (ขีดสั้น w-20 สองสต็อป) และ
// คนละชุดกับ §5 (ชิปถมเขียวคู่กลีฟกระบองเพชร 🌵 บนการ์ดมุมตัด 36px)
// เส้นคั่นคอลัมน์และเส้นใต้หัวข้อเป็น **#f6c4a4 / #117a41 / #de2b1e / #f2a033**
// ซึ่ง §2 อนุญาตให้เป็นขอบ/พื้นถมเท่านั้น · เนื้อความ #3f130d (= BRAND_TEXT,
// 14.9:1 บนปลายการ์ดขาว · 14.0:1 บนปลายผิวยก)
// ⚠️ **ไฮไลต์ <strong> ในเนื้อความมีสีเดียวคือ #a81410** และเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(222,43,30,α) · rgba(242,160,51,α) ·
// rgba(168,20,16,α) · rgba(63,19,13,α) · rgba(246,196,164,α) · rgba(254,215,181,α)
//
// ⚠️⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้เป็นแบรนด์แดงจริง และรีโปนี้
// มีแดงของแบรนด์อื่นอยู่หกชุดขึ้นไป** "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้คือ **#de2b1e (R222 G43 B30) / #a81410 / #c81e12 / #9d140c / #6f0e08**
// เท่านั้น ค่าที่ต้องไม่เหลือ:
//   00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb
//   355f7d 0f5684 1a6ea8 (**โบ๊ะบ๊ะ168 — ชุดที่เพิ่งอยู่ทั้งใบนี้**) ·
//   ffd6fa fff4fb ffe3f5 f9b2d9 f479b9 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
//   d91a73 b01160 85094a (**okkub88 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด**) ·
//   fb2e33 cb0b0d d81115 b00d11 8a0608 1c0607 f0e6e4 c9b9b7 e3d6d4 (สล็อต168 —
//   ⚠️⚠️ **fb2e33 ↔ #de2b1e ตระกูลเดียวกัน · f0e6e4 ↔ #fdeee2 หมึกโครมรอบนี้**) ·
//   ff2e52 e01238 c9102f (มาดาม168) · c30303 8f0505 e81313 dcb95f 280b0b
//   (รวยแท้168) · d9212a 8e1a16 f0c878 fff8d8 (ดวงเศรษฐี168) · fb141b ff5f63
//   (GT66B) · eb0305 2c1004 4d1c0a b44c06 f0b46a (NavbarStyle4) ·
//   fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
//   3b0b26 54123a 7a2350 (หมูบิน168) · 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 273449
//   121722 0d1017 (นาซ่า168) · 18a5e2 0d6b9b a9d7f2 16294a (ร่ำรวย168)
// ⚠️ ทอง/เหลืองของแบรนด์เก่า (ทองรอบนี้คือ **#f2a033 ค่าเดียว** — ⚠️ **f0b46a /
//   f0c878 ต่างไบต์แรกเดียว**): ffd84d f5ba14 fcee52 b37c0b ffd94a e3a712 9d6f06
//   eeae12 fded41 9f600d fcd434 fdcb0c fefb6b fee45d e6a416 fef54b f7c92b d4922c
//   fdfc71 e5a81b ffe08a f9a826 ffdc8c f0b429 ffc82e e0bd72 f6e4b4 d4af5a
// ⚠️ เขียวของแบรนด์เก่า (เขียวรอบนี้คือ **#117a41**): 0b7d28 0a5f1c 0f9b35 0c3a16
//   061f0c (สาธุ168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีชมพู/แมเจนต้า ไม่มีม่วง และไม่มีแรมป์
// เทาเงิน** — ซอมเบรโรฟาง ปอนโช เหรียญทอง มาราคัส และสีผิวนักแสดงเป็น **วัตถุ
// ในภาพ ไม่ใช่สี UI** และวัสดุที่สองรอบนี้คือ **พีช/ฟางอุ่น (R>G>B)**
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c4a4] bg-gradient-to-br from-white to-[#fff3ea] p-8 text-[#3f130d] shadow-[0_10px_30px_rgba(168,20,16,0.12)] transition-all duration-500 hover:border-[#de2b1e] hover:shadow-[0_15px_40px_rgba(222,43,30,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#de2b1e]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#de2b1e]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fed7b5]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#fed7b5]/75">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3f130d]">
        {
          leftHeading && (
            <header class="flex flex-col gap-3">
              <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#a81410]">{leftHeading}</HeadingTag>
              <div aria-hidden="true" class="h-[3px] w-full rounded-full bg-gradient-to-r from-[#117a41] via-[#de2b1e] to-[#f2a033]" />
            </header>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#3f130d] md:border-l md:border-[#f6c4a4] md:pl-10">
        {titleright && <HeadingTag class="text-center text-xl leading-normal font-black tracking-wide text-[#a81410] md:text-left">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
