---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// BRAVO168 (รอบน้ำเงินรอยัล-ทอง 2026-09-30): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+
// ข้อความ ส่วน ContentBoxSevenThreeFloatingBadge ที่เป็นคู่กันใช้ป้ายหัวข้อลอย สองบล็อกนี้
// วางติดกันบนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อยแนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ด
// ใบเดียวกันซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ส่วนอีกใบรูปอยู่
// ขวา 7fr หัวข้อไล่ตามลำดับสีบนเวิร์ดมาร์ก คือทองอ่อน #ffe39a → ทองแบรนด์ #f4cb69 →
// ทองลึก #c9922e ตามเลข 168 ออร่าสองมุมแยกหน้าที่ตามคู่สีของโลโก้ คือทองมุมซ้ายบนตามเลข
// 168 และน้ำเงินรอยัล #1558c4 มุมขวาล่างตามคำว่า BRAVO บนการ์ดที่ไล่จากผิวการ์ด #04142f
// ลงไปหาพื้นเพจ #02081a กรอบและเส้นคั่นกลางเป็นน้ำเงินเส้น #0e3f8f เนื้อความ #dbe5f5
// (BRAND_TEXT) — ชุดทอง-แดงเลือดหมูของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622
// #4c0301 #160b06 #0a0503 #ece0cb #bdae92) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0e3f8f] bg-gradient-to-br from-[#04142f]/94 to-[#02081a]/96 p-8 text-[#dbe5f5] shadow-[0_10px_30px_rgba(1,4,12,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f4cb69]/70 hover:shadow-[0_15px_40px_rgba(244,203,105,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f4cb69]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe39a]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1558c4]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#2f86f0]/35">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5] md:border-l md:border-[#0e3f8f] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#c9922e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
