---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งซ้าย) ที่หน้าแรกคิด `sizes` จาก — ถ้าแก้ค่าใด
// ต่อไปนี้ต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย:
//   section max-w-7xl(1280) + px-4(16) · card md:p-10(40) · gap-10(40) · คอลัมน์แคบไม่มี padding ใน
//   ≥1312px: (1280 − 32 − 80 − 40) × 0.3 = 1128 × 0.3 = 338px
//   768–1311px: (100vw − 152) × 0.3 = calc(30vw − 46px)
//   ≤767px: ยุบเหลือคอลัมน์เดียว card p-8(32) → 100vw − 32 − 64 = calc(100vw − 96px)
// md:border-l 1px อยู่ในกล่องของคอลัมน์ขวา จึงไม่กินความกว้างคอลัมน์ซ้าย
//
// หวยคิง (รอบทองโลหะ + ครีมอมพีช บนดำอมน้ำตาล 2026-10-04): brand-spec §2
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H3 #5 ("3ตัว จ่าย1,000บาท") คู่กับ slide1 ซึ่งเป็น
// งานอาร์ตที่พิมพ์ข้อความนั้นไว้บนตัวภาพเอง
//
// นี่คือครึ่ง "การ์ดไล่เฉด กรอบจาง" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeHuay ที่เป็นคู่กันเป็นการ์ดผิวทึบ กรอบทองแบรนด์ สองบล็อกนี้
// วางติดกันบนหน้าแรก (2ตัว จ่าย100บาท แล้วค่อย 3ตัว จ่าย1,000บาท) จึงต้องไม่อ่าน
// เป็นการ์ดใบเดียวกันซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr
// ข้อความอยู่ขวา 7fr ส่วนอีกใบกลับด้านเป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา
//
// ผิวการ์ดไล่จาก #1c140b ลงไปหาพื้นลึกสุด #0c0b0a กรอบและเส้นคั่นกลางเป็นเส้นจาง
// #5c3f12 (ไม่ใช่กรอบทองแบรนด์แบบการ์ดคู่ของมัน) สว่างขึ้นเป็นทองแบรนด์ #cd9a2c ตอน
// hover ออร่ามุมซ้ายบนเป็นทองแบรนด์ มุมขวาล่างเป็นครีมอมพีช #fcd4c3 หัวข้อไล่
// ครีมอ่อน #fce2d4 → ครีมอมพีช #fcd4c3 → ทองแบรนด์ #cd9a2c ซึ่งเป็นลำดับสีคนละชุด
// กับการ์ดคู่ของมันที่ไล่ทองสว่างไปครีม เนื้อความ #f5e7c8 (= BRAND_TEXT)
// glow เป็น rgba(205,154,44,…)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#01a326 #4ade6b #01841b
// #fb252b #ff6b6e #0a4a18 #0a1a0e #030a05 #e4f2e4) ออกครบทุกจุดแล้ว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5c3f12] bg-gradient-to-br from-[#1c140b]/96 to-[#0c0b0a]/96 p-8 text-[#f5e7c8] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#cd9a2c]/80 hover:shadow-[0_15px_40px_rgba(205,154,44,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#cd9a2c]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#fdeb7c]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fcd4c3]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#fce2d4]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fce2d4] via-[#fcd4c3] to-[#cd9a2c] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c8] md:border-l md:border-[#5c3f12] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fce2d4] via-[#fcd4c3] to-[#cd9a2c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
