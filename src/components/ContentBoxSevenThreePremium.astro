---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+ข้อความ
// ส่วน ContentBoxSevenThreeHuay ที่เป็นคู่กันเป็นการ์ดทึบ สองบล็อกนี้วางติดกันบนหน้าแรก
// (2ตัว จ่าย100บาท แล้วค่อย 3ตัว จ่าย1,000บาท) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ
// และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ข้อความอยู่ขวา 7fr ส่วนอีกใบกลับด้าน
// เป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา
//
// แบรนด์นี้เป็นแดงนำ ทองรอง บนดำ (logo.webp vivid เป็นแดงล้วน #dc0203 #e00104 #e2020a
// dominant เป็นดำ #020202 ส่วนทองมาจากตัวอักษรบนสไลด์) หัวข้อจึงไล่ทองอ่อน #ffeab0 →
// ทองแบรนด์ #ffc93c → แดงสว่าง #f5282a (4.8:1 บนผิวการ์ด พอสำหรับหัวข้อตัวใหญ่หนา)
// ออร่าสองมุมเป็นทองแบรนด์มุมซ้ายบนกับแดงแบรนด์มุมขวาล่าง บนการ์ดที่ไล่จากพื้นการ์ด
// #240406 ลงไปหาพื้นลึกสุด #140203 กรอบและเส้นคั่นกลางเป็นทองลึก #c08a07 ซึ่งเป็นเส้นทอง
// ที่เข้มสุดในพาเลตต์ ไม่ใช่กรอบทองสว่างแบบการ์ดใบอื่น เพื่อให้สองบล็อกในคู่นี้ต่างกันตั้งแต่ขอบ
// เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #8a5f12 #241404 #140c02
// #f3e8cf) ออกครบทุกจุดแล้ว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c08a07] bg-gradient-to-br from-[#240406]/94 to-[#140203]/96 p-8 text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/70 hover:shadow-[0_15px_40px_rgba(255,201,60,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ffc93c]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#ffeab0]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#dc0203]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f5282a]/32">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e7e0] md:border-l md:border-[#c08a07] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
