---
export interface Props {
  /** The section's docx heading. Renders in the left (7fr) TEXT column unless a
   *  `titleleft` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// COLUMN ORDER: the grid is md:grid-cols-[7fr_3fr] with the TEXT column FIRST
// and the picture in slot="right". `title` is therefore the shorthand for the
// LEFT column's heading, not the right one. Two reasons: the docx heading always
// has to land on the prose rather than on the picture, and on a phone the single
// column then reads heading → text → picture instead of opening with an image.
// The image column is passed no `titleright`, so this block emits exactly one
// docx heading. No `whitespace-nowrap` anywhere: a full docx sentence wraps
// instead of overflowing at mobile width, and the heading sits in normal flow,
// never `absolute`, so there is no badge-clearance arithmetic in this file.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งขวา = คอลัมน์รูป) ที่หน้าแรกคิด `sizes` จาก —
// ถ้าแก้ค่าใดต่อไปนี้ต้องไปแก้ `widths`/`sizes` ใน src/pages/index.astro ด้วย
// (Tailwind ตั้ง box-sizing: border-box ทั้งเว็บ ทุก max-w-* จึงคุมกล่องรวม padding
// และ border):
//   section max-w-7xl(1280) + px-4(16×2=32) · card border(1×2=2) · md:p-10(40×2=80)
//   · gap-10(40) · คอลัมน์รูปมี md:border-l(1) + md:pl-10(40) = 41 อยู่ในกล่องของมันเอง
//   ≥1280px   : (1280 − 32 − 2 − 80 − 40) × 0.3 − 41 = 337.8 − 41 = 297px
//   768..1279 : (100vw − 154) × 0.3 − 41             = calc(30vw − 87px)
//   638..767  : ยุบเหลือคอลัมน์เดียว p-8 → 100vw − 98 > 540 จึงติดเพดาน
//               max-w-[540px] ของรูป = 540px
//   <638      : คอลัมน์เดียวที่ p-8                  = calc(100vw − 98px)
// ⚠️ ตัวเลขชุดนี้เป็นของ **ใบนี้** (max-w-7xl / gap-10 / pl-10) ไม่ใช่ของ
// ContentBoxSevenThreeNeumorphism ที่ถือ §8 บนหน้าเดียวกัน (max-w-[1400px] / gap-8 /
// pl-8 → 344px และ calc(30vw − 77px)) **ห้ามลอกข้ามไฟล์**
// ⚠️ สไลด์ของดรอปนี้วัดจากบิตแมปจริงได้ **540×600 แนวตั้ง** เพดาน max-w-[540px] จึง
// เป็นพิกเซลจริงพอดี ไม่ใช่การอัปสเกล และ **ห้าม alt เขียนว่าภาพแนวนอนหรือจัตุรัส**
//
// รวยแท้168 (2026-10-21 ดรอปที่สองของวัน, brand-spec §2–§5): บนหน้าแรกกล่องนี้ถือ
// **docx H3 §7** ("โปรโมชั่น คืนยอดเสีย 0.3% เข้ายูสทุกวัน" — content.txt บรรทัด 16)
// คู่กับ **slide2.png** ซึ่งพิมพ์คำว่า โปรโมชั่น / คืนยอดเสีย / 0.3% ไว้บนแผ่นป้าย
// ในตัวภาพเอง
// ⚠️ **ข้อความที่พิมพ์อยู่บนงานอาร์ตเป็นตัวตัดสินการจับคู่ ไม่ใช่เลขไฟล์** ผู้อัปโหลด
// เขียนทับ slide1/slide2 ทุกดรอป การจับคู่จึงสลับไปมาระหว่างแบรนด์ ใครก๊อปบรรทัด
// import ของรอบก่อนมาโดยไม่เปิดดูจะได้รูปที่ขัดกับหัวข้อของตัวเอง — รอบนี้เปิดอ่าน
// บิตแมปทั้งสองใบจริงแล้ว
// slide3/slide4 (09-29) และ banner2/banner3 (10-08 / 09-27) เป็นอาร์ตของแบรนด์อื่น
// **ห้าม import** เพราะ eager import = emit และจะทำให้ verify-build แดง
//
// นี่คือบล็อกรูป+ข้อความบล็อกแรกจากสองบล็อก (เพดานของ playbook คือ 2)
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทองน้ำผึ้งบนดำสนิท ของ ดวงเศรษฐี168** ทั้งใบ จึง
// กลับทิศทั้งไฟล์: **ธีมสว่างรอบที่สามของรีโปนี้** พื้นเพจ #ffdbdb (bg.json) การ์ด
// เนื้อหาเป็น **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก · #fff1ef กลาง · #ffdbdb พื้นเพจ — การ์ดใบนี้ไล่จากยกลงกลาง
// ในกรอบแดงคริมสัน #c30303 ที่อิ่มขึ้นตอน hover
// ออรามุมซ้ายบนเป็นแดงคริมสัน #c30303 (คำว่า "รวยแท้" บนโลโก้) มุมขวาล่างเป็น
// **สกาเล็ต #e81313** ⚠️ ออราเป็น **พื้นถม ไม่ใช่ตัวอักษร** สกาเล็ตจึงอยู่ตรงนั้นได้
// ทั้งที่ §2 ห้ามมันถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร
// หัวข้อไล่ แดงคริมสัน #c30303 → หมึกเลือดหมู #4a0f0f (สองสต็อป ไม่มีสต็อปกลาง
// และ **ไม่มีแถบตั้งนำหน้า**) ซึ่งเป็นทรีตเมนต์คนละชุดกับ §8 ที่เป็นสองสต็อปกลับทาง
// พร้อมแถบตั้ง ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อป
// ต้องถือตัวอักษรได้ตาม §2 (#c30303 6.3:1 · #4a0f0f 15.4:1 บนผิวขาว)
// เนื้อความ #4a0f0f (= BRAND_TEXT) glow ที่ใช้คือ rgba(195,3,3,α) และ
// rgba(74,15,15,α) ตาม §2
// ⚠️ **#8f0505 สงวนไว้ให้ <strong> ในเนื้อความของหน้าเท่านั้น** จึงไม่อยู่ในไฟล์นี้
// และ **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของโครมล้วน ห้ามโผล่ในไฟล์นี้**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วมากกว่าฮิวใดในรีโปนี้**
// แดงรอบนี้คือ **#c30303** (R195 G3 B3) ห่าง d30304 ของรับตัง168 แค่ 16 หน่วย และ
// ห่าง b90203 ของสมหวัง168 แค่ 10 หน่วย — รับไว้โดยตั้งใจเพราะเป็นค่า vivid ที่วัด
// จาก logo.webp เอง และไม่ใช่ d9212a 8e1a16 (ดวงเศรษฐี168 — เจ้าของเดิมของไฟล์นี้)
// e4021b (รวยเทพ168) fb1b32 ff8f9c 5c0410 (มีเฮ168) fa0513 ff5a5f ffadaf b90203
// 8c0204 (สมหวัง168) d30304 ff6b6e a00203 4a0202 (รับตัง168) b3121b 5a0a0e
// (ขวัญใจ168) dc0203 f5282a (หวย365) fb131b ff4d55 (TKB55) หรือ fb141b ff5f63 (GT66B)
// ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd กับ rgba 11/125/40, 10/95/28, 12/58/22,
// 174/176/74) และชุดทองน้ำผึ้ง-แดงชาดของ ดวงเศรษฐี168 ที่เคยอยู่ทั้งใบนี้ (d9212a
// 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303 000000 กับ rgba 240/200/120)
// ออกครบทุกค่าแล้ว เช่นเดียวกับชุดของ มีทรัพย์168 (dd1b74 a4186b 4a0d35 2d0720 f7dcf6
// f0ccf5) ufalion168 (d4922c fdfc71 a25b24 8c4312 d39c45 f6e3b4 33200a 1f1304 0a0601
// 5a3310 1a1000) รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06
// fff8ec 2b1400) รวยแทร่168 (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38
// 030f1d) สบายเบท168 (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// นินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 dceefc) มีโชค168 (fcd434 ffeaa0 f5469f
// ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12) ถอนชัวร์168 (fa63b9 ffb3de ffd84d
// 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) รับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c f5ece0 2b100f 200a09 140505) ขวัญใจ168 (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06) หวยคิง (cd9a2c fdeb7c ab7314
// f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) TKB55 (fb131b ff8a8f ff4d55 e9eef4
// aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a) KMD88 (7505cc b453ff
// c07cff d9b8ff 3a0565 2c0349 7a5a0a e2b33f ffdf8c ece2f8) TSDET911 (0360f3 0292fb
// 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26) PUNPRO168 (f41571 ff5ca8
// fce343 ffd94a f0c3dc fde7f2) TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b)
// TIGERWIN369 (d98324 f7b733 ffd98a f7e4c0 e3cfae 8a5214) และ UFA324 (e5a81b b9c2cc
// 231c0e f0e8d4 ffe08a 7d5a07 464f5a) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีชมพู/
// ฟูเชีย ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม ไม่มีส้มสด และไม่มีบรอนซ์**
const leftHeading = titleleft ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c30303]/50 bg-gradient-to-br from-white to-[#fff1ef] p-8 text-[#4a0f0f] shadow-[0_10px_30px_rgba(74,15,15,0.16)] transition-all duration-500 hover:border-[#c30303]/85 hover:shadow-[0_15px_40px_rgba(195,3,3,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c30303]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#c30303]/38">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e81313]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#e81313]/32">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#4a0f0f]">
        {
          leftHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#c30303] to-[#4a0f0f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {leftHeading}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#4a0f0f] md:border-l md:border-[#c30303]/35 md:pl-10">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#c30303] to-[#4a0f0f] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleright}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
