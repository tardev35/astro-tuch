---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// This is the CRIMSON half of the pair of promo blocks — its sibling
// ContentBoxSevenThree runs the same 3/7 layout in antique gold, so the two
// promos stacked back to back (แนะนำเพื่อน 0.8% then คืนยอดเสีย 0.3%) do not read
// as the same card twice. Gold shows up here only twice: as the bloom on the
// near corner and as the head of the right-hand heading gradient. It is the
// jester hat's hue and it stops being an accent if it is everywhere.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a51515]/55 bg-gradient-to-br from-[#2b0204]/92 to-[#1c0202]/94 p-8 text-[#ecdfd0] shadow-[0_10px_30px_rgba(0,0,0,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#c81e1e]/80 hover:shadow-[0_15px_40px_rgba(165,21,21,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d9b45e]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#f2dc9a]/24">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#a51515]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#c81e1e]/36">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfd0]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#bc9b5b] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ecdfd0] md:border-l md:border-[#6d0d0d] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f2dc9a] via-[#d9b45e] to-[#c81e1e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
