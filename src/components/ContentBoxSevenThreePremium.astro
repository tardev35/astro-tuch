---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8e0c0a]/45 bg-gradient-to-br from-[#2a0b0b]/92 to-[#0d0303]/88 p-8 text-[#f7e4dc] shadow-[0_10px_30px_rgba(211,20,17,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd32d]/60 hover:shadow-[0_15px_40px_rgba(253,211,45,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d31411]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f5322e]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fdd32d]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe98a]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#fdd32d] to-[#8e0c0a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4dc] md:border-l md:border-[#8e0c0a] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdd32d] via-[#ffe98a] to-[#f5322e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
