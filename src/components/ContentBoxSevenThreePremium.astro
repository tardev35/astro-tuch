---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#94a3b8]/30 bg-gradient-to-br from-[#0d1830]/92 to-[#0a1220]/88 p-8 text-[#e0f2fe] shadow-[0_10px_30px_rgba(148,163,184,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#94a3b8]/60 hover:shadow-[0_15px_40px_rgba(148,163,184,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#94a3b8]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e8f0]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#475569]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#38bdf8]/30"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0f2fe]">
        {
          titleleft && (
            <h3 class="bg-gradient-to-r from-[#e2e8f0] via-[#e0f2fe] to-[#0ea5e9] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h3>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e0f2fe] md:border-l md:border-[#0d1830] md:pl-10">
        {
          rightHeading && (
            <h3 class="mb-2 bg-gradient-to-r from-[#e2e8f0] via-[#e0f2fe] to-[#0ea5e9] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h3>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
