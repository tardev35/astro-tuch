---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
//
// WY88 (รอบชมพูมาเจนตา-ทอง 2026-09-23): นี่คือครึ่ง "การ์ดมน" ของคู่บล็อกรูป+ข้อความ
// ส่วน ContentBoxSevenThreeCyberCut ที่เป็นคู่กันใช้มุมตัดเฉียงกับหัวข้อทึบ สอง
// บล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืนยอดเสีย 0.3%) จึงต้อง
// ไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่จากทองประกาย #fced94 ลงทอง
// หลัก #e8b33a ไปหาทองเข้ม #c3832b ส่วนออร่าสองมุมเป็นทองประกายกับมาเจนตาหลัก
// #ec2b84 บนการ์ดที่ไล่จากพื้นการ์ด #24081a ลงไปหาพื้นเพจ #170411
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e8b33a]/55 bg-gradient-to-br from-[#24081a]/94 to-[#170411]/96 p-8 text-[#fce9f3] shadow-[0_10px_30px_rgba(23,4,17,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#fced94]/80 hover:shadow-[0_15px_40px_rgba(232,179,58,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fced94]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fced94]/26">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#ec2b84]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#f9a8cd]/36">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#c3832b] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fce9f3] md:border-l md:border-[#a3145a] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fced94] via-[#e8b33a] to-[#c3832b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
