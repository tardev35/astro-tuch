---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings.
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0e4f7a]/70 bg-gradient-to-br from-[#041d38]/92 to-[#01050b]/88 p-8 text-[#cfe7f2] shadow-[0_10px_30px_rgba(22,135,201,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#1687c9]/75 hover:shadow-[0_15px_40px_rgba(22,135,201,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#1687c9]/26 blur-[60px] transition-all duration-500 group-hover:bg-[#22b8e8]/34">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#4bdbee]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#9df1ff]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe7f2]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#eafcff] via-[#4bdbee] to-[#0e4f7a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe7f2] md:border-l md:border-[#0e4f7a] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#eafcff] via-[#22b8e8] to-[#4bdbee] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
