---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading.
//
// UFAGOOL (รอบแดง-เงินโครเมียม 2026-09-23): นี่คือครึ่ง "การ์ดมน" ของคู่บล็อกรูป+
// ข้อความ ส่วน ContentBoxSevenThreeCyberCut ที่เป็นคู่กันใช้มุมตัดเฉียงกับหัวข้อทึบ
// สองบล็อกนี้วางติดกันบนหน้าแรก (แนะนำเพื่อน 0.8% แล้วค่อยคืนยอดเสีย 0.3%) จึงต้อง
// ไม่อ่านเป็นการ์ดใบเดียวกันซ้ำสองรอบ ที่นี่หัวข้อไล่ตามลำดับสีบนโลโก้ คือแดงสด
// #ef1f25 → ขาวเงิน #f4f7fa → เงินหลัก #b8c3cf ส่วนออร่าสองมุมเป็นเงินกับแดงแบรนด์
// #c50d12 บนการ์ดที่ไล่จากพื้นการ์ดยกระดับ #241a1a ลงไปหาพื้นเพจ #0a0708
// ชมพูมาเจนตา-ทองของ WY88 หายไปทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c50d12]/55 bg-gradient-to-br from-[#241a1a]/94 to-[#0a0708]/96 p-8 text-[#cdd5dd] shadow-[0_10px_30px_rgba(10,7,8,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-[#ef1f25]/80 hover:shadow-[0_15px_40px_rgba(197,13,18,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#b8c3cf]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#f4f7fa]/26">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#c50d12]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ef1f25]/38">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdd5dd] md:border-l md:border-[#5e0507] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ef1f25] via-[#f4f7fa] to-[#b8c3cf] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
