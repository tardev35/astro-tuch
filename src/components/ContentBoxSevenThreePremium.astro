---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// ความกว้างจริงของคอลัมน์แคบ (3fr ฝั่งซ้าย) ที่หน้าแรกคิด `sizes` จาก — ถ้าแก้ค่าใด
// ต่อไปนี้ต้องไปแก้ `sizes` ใน src/pages/index.astro ด้วย:
//   section max-w-7xl(1280) + px-4(16×2=32) · card md:p-10(40×2=80) · gap-10(40)
//   คอลัมน์แคบไม่มี padding ใน
//   ≥1312px: (1280 − 32 − 80 − 40) × 0.3 = 1128 × 0.3 = 338.4 → 338px
//   768–1311px: (100vw − 152) × 0.3 = calc(30vw − 46px)
//   ≤767px: ยุบเหลือคอลัมน์เดียว card p-8(32×2=64) → 100vw − 32 − 64 = calc(100vw − 96px)
// md:border-l 1px อยู่ในกล่องของคอลัมน์ขวา จึงไม่กินความกว้างคอลัมน์ซ้าย
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// บนหน้าแรกรอบนี้กล่องนี้ถือ docx H3 #4 ("คืนยอดเสีย โบนัส 0.3%") คู่กับ slide1 ซึ่งเป็น
// งานอาร์ตที่พิมพ์ข้อความนั้นไว้บนป้ายแดงในตัวภาพเอง
//
// นี่คือครึ่ง "การ์ดไล่เฉด กรอบเขียวลึก" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeNeumorphism ที่เป็นคู่กันเป็นแผ่นนูนผิวลึกสุด สองบล็อกนี้วางติดกัน
// บนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อย แนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ดใบ
// เดียวกันซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ข้อความอยู่
// ขวา 7fr ส่วนอีกใบกลับด้านเป็น 7fr_3fr ให้ข้อความอยู่ซ้ายและรูปอยู่ขวา
//
// ผิวการ์ดไล่จากผิวยก #1d0b08 ลงไปหาผิวลึกสุด #090302 กรอบและเส้นคั่นกลางเป็นเขียวลึก
// #063f1c (ไม่ใช่กรอบแดงแบรนด์แบบ ContentBoxPremium และไม่ใช่กรอบทองแบบ
// ContentBoxTwoPremium) สว่างขึ้นเป็นเขียวสว่าง #2bbf63 ตอน hover ออรามุมซ้ายบนเป็น
// เขียวมรกต #0b7a33 มุมขวาล่างเป็นทองแบรนด์ #d9a521 หัวข้อไล่แดงสว่าง #e0201f →
// เขียวสว่าง #2bbf63 → ทองอ่อน #ffdf91 ซึ่งเป็นลำดับสีคนละชุดกับการ์ดคู่ของมันที่ใช้
// ทองอ่อนทึบสีเดียว เนื้อความ #f6e3cf (= BRAND_TEXT) glow เป็น rgba(11,122,51,…)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #04ab3a #036b26
// #0b231b #041109 #f3c44a #ffffff #cfe9d7 rgba(66,251,90,…) rgba(218,220,220,…))
// ออกครบทุกจุดแล้ว
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#063f1c] bg-gradient-to-br from-[#1d0b08]/96 to-[#090302]/96 p-8 text-[#f6e3cf] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#2bbf63]/80 hover:shadow-[0_15px_40px_rgba(11,122,51,0.38)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0b7a33]/32 blur-[60px] transition-all duration-500 group-hover:bg-[#0b7a33]/46">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#d9a521]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#d9a521]/32">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#e0201f] via-[#2bbf63] to-[#ffdf91] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3cf] md:border-l md:border-[#063f1c] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e0201f] via-[#2bbf63] to-[#ffdf91] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
