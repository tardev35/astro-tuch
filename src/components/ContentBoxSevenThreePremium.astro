---
export interface Props {
  /** The section's docx heading. Renders in the right (7fr) column unless a
   *  `titleright` overrides it. */
  title?: string;
  titleleft?: string;
  titleright?: string;
  /** Both columns render at this level, set from the docx's own outline — the
   *  `as` prop is what decides the tag, never a hardcoded level in here. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
// `title` is the shorthand for the right-hand column heading. Both columns only
// ever carry docx article headings. The image column is passed no `titleleft`,
// so this block emits exactly one docx heading. No `whitespace-nowrap` anywhere:
// a full docx sentence wraps instead of overflowing at mobile width.
//
// WIN999 (รอบทอง-ดำ 2026-09-29): นี่คือครึ่ง "การ์ดไล่เฉด" ของคู่บล็อกรูป+ข้อความ ส่วน
// ContentBoxSevenThreeFloatingBadge ที่เป็นคู่กันใช้ป้ายหัวข้อลอย สองบล็อกนี้วางติดกัน
// บนหน้าแรก (คืนยอดเสีย 0.3% แล้วค่อยแนะนำเพื่อน 0.8%) จึงต้องไม่อ่านเป็นการ์ดใบเดียวกัน
// ซ้ำสองรอบ และรูปถูกวางสลับฝั่งกัน — ที่นี่รูปอยู่คอลัมน์ซ้าย 3fr ส่วนอีกใบรูปอยู่ขวา 7fr
// หัวข้อไล่ตามลำดับตัวอักษรบนเวิร์ดมาร์ก คือขาวไฮไลต์ #fffbea → ทองสว่าง #fdda04 → ทอง
// แบรนด์ #fcc403 ออร่าสองมุมเป็นทองแบรนด์กับทองสว่าง บนการ์ดที่ไล่จากผิวการ์ด #191712
// ลงไปหาพื้นเพจ #050505 เส้นคั่นกลางเป็นทองลึกมาก #4a3402 เนื้อความ #e9e4d6
// (BRAND_TEXT) — ชุดชมพูนีออน-ม่วงของ SEXYGAME666 (#fa42b5 #ffb3e2 #ffa6dd #8b3df3
// #4a0e33 #170a22 #08020d #f2dcee) ออกทั้งหมด
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a3402]/90 bg-gradient-to-br from-[#191712]/94 to-[#050505]/96 p-8 text-[#e9e4d6] shadow-[0_10px_30px_rgba(3,2,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcc403]/80 hover:shadow-[0_15px_40px_rgba(252,196,3,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fcc403]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fdda04]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fdda04]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fdda04]/28">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fffbea] via-[#fdda04] to-[#fcc403] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6] md:border-l md:border-[#4a3402]/90 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fffbea] via-[#fdda04] to-[#fcc403] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
