---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also passes an explicit
// message, and the two are kept in step deliberately.
//
// No emoji in this string: the marquee prints it three times, and an emoji
// baked into a text prop cannot be given its own aria-hidden span.
const {
  message = "KINDEE365 เว็บหวยลอตเตอรี่ออนไลน์ มีครบทุกเลข จ่ายไม่อั้น รับทุกเลข • เปิดรับแทงหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ ตามรอบที่เปิดบริการ • อัตราจ่ายสำหรับหน้านี้ เลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 ควรตรวจสอบตัวเลขที่แสดงจริงในระบบก่อนยืนยัน • ฝากถอนระบบออโต้ผ่านธนาคารและวอลเลทตามช่องทางที่เปิดรองรับ • เจ้าหน้าที่ KINDEE365 รับเรื่องออนไลน์ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#010b26] shadow-[0_4px_15px_rgba(1,11,38,0.6)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#b98213] to-[#f8dc8c] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#010b26] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#010b26]"></span>
      </span>
      <span class="font-black tracking-widest text-[#010b26] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#010b26] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#010b26] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#cfe3f7] md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#2b8ae9] via-[#e8bb4a] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
