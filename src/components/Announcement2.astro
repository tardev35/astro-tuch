---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also renders it bare, so there
// is exactly one string and the ticker cannot say two different things on two
// pages.
//
// No emoji in this string: the marquee prints it three times, and an emoji baked
// into a text prop cannot be given its own aria-hidden span. The 2nd and 3rd
// copies exist only so the loop has no seam, so they carry aria-hidden="true" —
// without it a screen reader reads the whole announcement three times over.
//
// เนื้อหาทุกท่อนมาจากบรีฟ BRAZIL999 รอบนี้เท่านั้น ไม่มีชื่อค่ายเกม ใบอนุญาต
// ช่องทางฝากถอน หรือ "ฝากถอนไม่มีขั้นต่ำ" เพราะบรีฟไม่ได้ระบุไว้เลย
//
// BRAZIL999 (รอบเขียวมรกต-เงินโครเมียม 2026-09-25): แถบประกาศเลื่อน พื้นดำอมเขียว
// #040a05 ป้าย "ประกาศ" เป็นไล่เฉดเขียว #0a6b18 → #22c55e → #b6ff9c ตัวอักษรดำ
// อมเขียว เนื้อความ #dfeadd เส้นล่างไล่จากเขียวแบรนด์ #22c55e ผ่านเงินโครเมียม
// #aab4bf — พื้นแดง #1c0504 กับทอง #8a6524/#f2c14e/#ffe7a6 ของ THE88 หายไปทั้งหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง ตรวจสอบได้ทุกขั้นตอน • รวมเกมหลายประเภทไว้ให้เลือกจากบัญชีเดียว ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ • ตรวจสอบรายละเอียดเกม โปรโมชั่น และข้อมูลการใช้งานได้ก่อนเริ่มเล่น • โบนัสแนะนำเพื่อน 0.8% และโบนัสคืนยอดเสีย 0.3% ควรตรวจสอบเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ • สมัคร ${BRAND_NAME} ด้วยตัวเองผ่านหน้าเว็บไซต์ได้ใน 3 ขั้นตอน • ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#040a05] shadow-[0_4px_15px_rgba(4,10,5,0.75)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#0a6b18] via-[#22c55e] to-[#b6ff9c] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#040a05] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#040a05]"></span>
      </span>
      <span class="font-black tracking-widest text-[#040a05] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#040a05] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#040a05] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#dfeadd] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#22c55e] via-[#aab4bf] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
