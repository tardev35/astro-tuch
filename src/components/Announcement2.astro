---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also renders it bare, so there
// is exactly one string and the ticker cannot say two different things on two
// pages.
//
// No emoji in this string: the marquee prints it three times, and an emoji baked
// into a text prop cannot be given its own aria-hidden span. The 2nd and 3rd
// copies exist only so the loop has no seam, so they carry aria-hidden="true" —
// without it a screen reader reads the whole announcement three times over.
//
// เนื้อหาทุกท่อนมาจากบรีฟ HI59 รอบนี้เท่านั้น (src/assets/content.txt) — ของเดิม
// ในไฟล์เป็นคอปปี้หวยของ หวยเฮง789 (แทงหวย/ส่งโพย/หวยลาว/หวยฮานอย/อัตราจ่าย
// 2 ตัว 3 ตัว) ซึ่งไม่มีอยู่ในบรีฟรอบนี้เลยสักท่อน จึงเขียนใหม่ทั้งสตริง ไม่ใช่
// แทนที่แค่ชื่อแบรนด์ HI59 เป็นเว็บสล็อต ไม่ใช่เว็บหวย
// ตัวเลขที่ใส่ได้มีแค่ของบรีฟเอง: คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ปลอดภัย 100% · 24 ชั่วโมง และคำกำกับที่บรีฟเขียนไว้เองต้องติดไปด้วย เพราะ
// พาดหัว "เว็บตรง ลิขสิทธิ์แท้ / โบนัสสูงให้เยอะกว่าใคร / ปลอดภัย 100% /
// ฝากถอนได้ทุกช่องทาง / ไม่ผ่านบัญชีม้า" ของบรีฟมีเงื่อนไขกำกับอยู่ในบรีฟเช่นกัน
//
// HI59 (รอบฟ้า-ทอง 2026-10-07): แถบประกาศเลื่อนเป็น "โครม" จึงยังเป็นผิวเข้ม
// กรมท่า #04203f แม้ทั้งเว็บรอบนี้จะสว่าง — ตัวอักษรบนแถบประกาศสีของมันเองอยู่แล้ว
// ไม่ได้ inherit BRAND_TEXT ป้าย "ประกาศ" เป็นไล่เฉดทองล้วน #ffe27a → #fdbc04 →
// #c88a02 ตั้งใจให้จบที่ทองเข้ม ไม่ใช่ฟ้าแบรนด์ เพราะหมึกบนป้ายเป็นกรมท่าเข้ม
// #04203f ซึ่งบนฟ้า #0a84e0 ได้แค่ 3.1:1 (ตก) แต่บนทองเข้ม #c88a02 ได้ 4.9:1
// ฟ้าไปอยู่ที่เส้นล่างแทน เนื้อความ #e4f1fd (13.8:1 บนพื้นแถบ)
// ชุดแดง-ทองของ หวยเฮง789 (#1c0606 #ffefc2 #f4bc5d #d99a10 #fbe3d4 #dc2224)
// หายไปทั้งหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} สล็อตไฮคลาส รวมเกมสล็อตจากหลายค่ายไว้ในบัญชีเดียว • มีทั้งสล็อตยอดนิยม เกมเปิดใหม่ ฟรีสปิน ตัวคูณ และฟีเจอร์โบนัสหลากหลายรูปแบบ รองรับทั้งมือถือและคอมพิวเตอร์ • สลับเกมและค่ายผ่านบัญชีเดียวโดยไม่ต้องสมัครใหม่หลายครั้ง พร้อมตรวจสอบรายละเอียดเกมก่อนเริ่มเล่น • โปรโมชั่นคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% คำนวณจากยอดที่เข้าเกณฑ์ตามรอบที่กำหนด ควรตรวจสอบค่ายเกม รอบตัดยอด และเงื่อนไขก่อนกดรับสิทธิ์ทุกครั้ง • การระบุว่าเป็นเว็บตรงหรือใช้เกมลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการที่ตรวจสอบได้รองรับ และคำว่าปลอดภัย 100% ไม่ควรถือเป็นการรับประกันโดยไม่มีหลักฐานด้านระบบประกอบ • ก่อนทำรายการฝากถอนควรตรวจสอบชื่อบัญชี จำนวนเงิน และรายละเอียดปลายทางจากช่องทางหลักของ ${BRAND_NAME} และเก็บหลักฐานไว้จนกว่าธุรกรรมจะเสร็จสมบูรณ์ • ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#04203f] shadow-[0_4px_15px_rgba(3,26,52,0.55)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#ffe27a] via-[#fdbc04] to-[#c88a02] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#04203f] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#04203f]"></span>
      </span>
      <span class="font-black tracking-widest text-[#04203f] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#04203f] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#04203f] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#e4f1fd] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#fdbc04] via-[#0a84e0] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
