---
const {
  message = "CASINO888 รวมเกมเดิมพันออนไลน์ครบวงจรไว้ในบัญชีเดียว ทั้งบาคาร่า สล็อต หวย และฟุตบอล • รองรับการใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ • โปรโมชั่นแนะนำเพื่อนรับโบนัส 0.8% ตามเงื่อนไข • โปรโมชั่นคืนยอดเสียรับโบนัส 0.3% ตามรอบที่กำหนด • บางเกมรองรับการเดิมพันเริ่มต้นประมาณ 1 บาท ขึ้นอยู่กับข้อกำหนดของผู้ให้บริการแต่ละราย • ควรตรวจสอบอัตราจ่าย กติกา และขั้นต่ำของแต่ละเกมก่อนยืนยันรายการ • แอดมิน CASINO888 ให้บริการตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0d0a06] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#6b5216] to-[#e4c25a] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#1a1206] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#1a1206]"></span>
      </span>
      <span class="font-black tracking-widest text-[#1a1206] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0d0a06] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0d0a06] to-transparent"></div>

    <div class="flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#e9ddc4]/90 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#c9c9c9] via-[#e4c25a] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
</style>
