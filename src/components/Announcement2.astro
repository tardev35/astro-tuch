---
const {
  message = "DARK168 เว็บดาร์คสล็อต เจ้าของเกมแท้ รวมเกมสล็อตจากค่ายหลักไว้ในบัญชีเดียว • การันตีไม่ล็อคยูส เล่นง่าย ไม่มีขั้นต่ำ • โบนัสแนะนำเพื่อน 0.8% และคืนยอดเสียทุกวัน 0.3% ตามเงื่อนไขของแต่ละโปรโมชั่น • ฝากถอนอัตโนมัติ ทำรายการเองได้ตลอด 24 ชั่วโมง • แอดมิน DARK168 พร้อมช่วยตรวจสอบรายการทุกวัน",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0a0806] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#5c4212] to-[#e6b74e] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#050505] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#050505]"></span>
      </span>
      <span class="font-black tracking-widest text-[#1c170d] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0a0806] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0a0806] to-transparent"></div>

    <div class="flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#ece3d1]/90 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#c8cfd8] via-[#e6b74e] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
</style>
