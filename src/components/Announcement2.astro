---
// ticker หลักของแบรนด์รอบนี้ (UFA324 — เว็บเล่นเกมกีฬาออนไลน์)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของ SUPERSLOTCLUB และ HI59)
//
// ห้ามขึ้นต้นข้อความด้วย emoji และห้ามมี emoji ในสตริงนี้เลย: marquee พิมพ์
// ข้อความซ้ำสามชุด และ emoji ที่ฝังใน text prop ใส่ aria-hidden ให้ตัวมันเองไม่ได้
// ชุดที่สองกับสามมีไว้ให้ลูปไม่มีรอยต่อ จึงต้อง aria-hidden="true" ทั้งคู่
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt) — ของเดิม
// ในไฟล์เป็นคอปปี้ของ SUPERSLOTCLUB ที่พูดถึง "คลับคนเล่นสล็อตซุปเปอร์ /
// ดับเบิ้ลโบนัส / เงินฝากเข้าบัญชีบริษัท" ซึ่งบรีฟรอบนี้ไม่ได้เอ่ยสักคำ จึงเขียนใหม่
// ทั้งสตริง ไม่ใช่แทนที่แค่ชื่อแบรนด์
// UFA324 เป็น **เว็บเล่นเกมกีฬาออนไลน์** — ฟุตบอล มวย และเกมคาสิโน (เกมไพ่
// เกมโต๊ะ สล็อต) ไม่ใช่เว็บสล็อตล้วนแบบรอบก่อน และไม่ใช่เว็บหวย (ไม่มีคำว่า หวย
// โพย เลขเด็ด งวด ในสตริงนี้ และ /ตรวจหวย กับ /แนวทาง ยังจอดอยู่ใน
// src/pages-disabled/)
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง — ไม่มีตัวเลขยอดฝาก
// ขั้นต่ำ ค่า RTP ชื่อค่ายเกม ชื่อธนาคาร ชื่อลีกหรือชื่อทีม เพราะบรีฟไม่ได้ระบุ
// ประโยคกำกับที่บรีฟเขียนไว้เองต้องติดไปด้วย ไม่ตัดทิ้งเพราะฟังดูไม่ขายของ:
// อัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา · ไม่มีการเดิมพันประเภทใดรับประกัน
// ผลตอบแทน · คำว่าไม่จำกัดควรระบุให้ชัด · จ่ายตรง/ไม่บิดยูส/ไม่มีขั้นต่ำ/
// ไม่ผ่านบัญชีม้า ควรมีข้อมูลที่ตรวจสอบได้รองรับ · ห้ามเปิดเผย PIN หรือ OTP
//
// UFA324 (รอบทองแชมเปี้ยน-เงินโครเมียม 2026-10-11): แถบประกาศเลื่อนเป็น "โครม"
// จึงประกาศสีของตัวเองครบ ไม่ได้ inherit BRAND_TEXT — พื้นแถบเป็นผิวจม #0d0b06
// ที่สว่างกว่าพื้นเพจดำสนิท #000000 เพียงนิดเดียว ป้าย "ประกาศ" เป็นไล่เฉดทองล้วน
// #ffe08a → #e5a81b → #bb8410 ตั้งใจให้จบที่ทองกลางเข้ม ไม่ใช่ทองลึก #7d5a07
// เพราะหมึกบนป้ายเป็นดำน้ำตาล #140d01 ซึ่งบน #bb8410 ได้ 6.3:1 (ผ่าน) แต่บน
// #7d5a07 ได้แค่ 3.3:1 (ตก) เงินโครเมียม #b9c2cc ไปอยู่ที่เส้นล่างแทน
// เนื้อความ #f0e8d4 (16.6:1 บนพื้นแถบ)
// ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #ffd666 #c08a0b
// #180800 #2b0a00 #fbe8d5) และชุดฟ้า-ทองของ HI59 (#04203f #ffe27a #fdbc04
// #c88a02 #e4f1fd #0a84e0) หายไปทั้งหมด
// ⚠️ สองรอบนั้นก็มีทอง การเจอทองในไฟล์นี้จึงไม่ได้แปลว่าเป็นของรอบนี้ —
// #e5a81b ไม่ใช่ #f2b705 และ #ffe08a ไม่ใช่ #ffd666
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เว็บเล่นเกมกีฬาออนไลน์ รวมทางเข้าเดิมพันฟุตบอล มวย และเกมคาสิโนไว้ในระบบเดียว • ฟุตบอลมีข้อมูลคู่แข่งขัน ประเภทการเดิมพัน และอัตราต่อรองให้ศึกษาก่อนตัดสินใจ ส่วนมวยมีรายการแข่งขันและรูปแบบการเดิมพันตามที่ผู้ให้บริการเปิดให้บริการ • หมวดเกมคาสิโนมีทั้งเกมไพ่ เกมโต๊ะ และสล็อตจากค่ายต่างๆ โดยจำนวนรายการจริงขึ้นอยู่กับระบบที่เปิดใช้งาน • ก่อนเลือกเดิมพันควรตรวจสอบกติกา อัตราจ่าย และเงื่อนไขการตัดสินผลให้ครบถ้วน เพราะอัตราต่อรองอาจเปลี่ยนแปลงตามช่วงเวลา • ไม่มีการเดิมพันประเภทใดรับประกันผลตอบแทน จึงควรกำหนดวงเงินและพิจารณาความเสี่ยงก่อนทำรายการ • โปรโมชั่นหลักมี คืนยอดเสีย 0.3% เข้ายูสทุกวันตามรอบที่เว็บไซต์กำหนด และ แนะนำเพื่อน โบนัส 0.8% จากยอดที่เข้าเกณฑ์ • ส่วนคำว่าไม่จำกัด ควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือยอดโบนัสสูงสุด • ก่อนยืนยันธุรกรรมควรตรวจสอบชื่อบัญชีผู้รับเงินให้ตรงกับข้อมูลที่เว็บไซต์แจ้ง รวมถึงข้อกำหนดยอดฝากถอนและระยะเวลาดำเนินการ • ข้อความ จ่ายตรง ไม่บิดยูส ไม่มีขั้นต่ำ และไม่ผ่านบัญชีม้า ควรมีข้อมูลที่ตรวจสอบได้รองรับ เพราะไม่มีระบบธุรกรรมใดรับประกันความปลอดภัยได้ทั้งหมด • แอดมิน ${BRAND_NAME} ระบุเวลาให้บริการตลอด 24 ชั่วโมง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0d0b06] shadow-[0_4px_15px_rgba(0,0,0,0.65)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#ffe08a] via-[#e5a81b] to-[#bb8410] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#140d01] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#140d01]"></span>
      </span>
      <span class="font-black tracking-widest text-[#140d01] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0d0b06] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0d0b06] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#f0e8d4] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#e5a81b] via-[#b9c2cc] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
