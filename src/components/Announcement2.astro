---
// ticker หลักของแบรนด์รอบนี้ (SUPERSLOTCLUB — คลับคนเล่นสล็อตซุปเปอร์)
//
// ทุกหน้าเรียก <Announcement /> แบบเปล่า ไม่ส่ง prop message ค่า default
// ด้านล่างจึงเป็นข้อความ ticker ของทั้งเว็บ ถ้าปล่อยให้เป็นของแบรนด์ก่อนหน้า
// จะหลุดไปทุกหน้าพร้อมกัน (ไฟล์นี้เคยค้างสโลแกนของแบรนด์ HI59 และเก่ากว่านั้น)
//
// ห้ามขึ้นต้นข้อความด้วย emoji และห้ามมี emoji ในสตริงนี้เลย: marquee พิมพ์
// ข้อความซ้ำสามชุด และ emoji ที่ฝังใน text prop ใส่ aria-hidden ให้ตัวมันเองไม่ได้
// ชุดที่สองกับสามมีไว้ให้ลูปไม่มีรอยต่อ จึงต้อง aria-hidden="true" ทั้งคู่
//
// ⚠️ เนื้อหาทุกท่อนมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt) — ของเดิม
// ในไฟล์เป็นคอปปี้ของ HI59 ที่พูดถึง "สล็อตไฮคลาส / เว็บตรง / ลิขสิทธิ์แท้ /
// ปลอดภัย 100%" ซึ่งบรีฟรอบนี้ไม่ได้เอ่ยสักคำ จึงเขียนใหม่ทั้งสตริง ไม่ใช่แทนที่
// แค่ชื่อแบรนด์ SUPERSLOTCLUB เป็นคลับ/ชุมชนคนเล่นสล็อต ไม่ใช่เว็บหวยและไม่ใช่
// เว็บคาสิโนรวมทุกหมวด (ไม่มีคำว่า หวย โพย เลขเด็ด งวด อัตราจ่าย บาคาร่า รูเล็ต
// ไฮโล โต๊ะสด บอล กีฬา ในสตริงนี้)
// ตัวเลขที่อ้างได้มีแค่ของบรีฟเอง: 0.3% · 0.8% · 24 ชั่วโมง — ไม่มี "1 บาท"
// ซึ่งเป็นตัวเลขพาดหัวของ KINGKONG555 รอบก่อน ไม่ใช่ของบรีฟนี้
// ประโยคกำกับที่บรีฟเขียนไว้เองต้องติดไปด้วย ไม่ตัดทิ้งเพราะฟังดูไม่ขายของ:
// ดับเบิ้ลโบนัสไม่ได้แปลว่าได้โบนัสสองเท่าทุกเกม · คำว่าไม่จำกัดควรระบุให้ชัด ·
// ชื่อบัญชีบริษัทอย่างเดียวไม่รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง ·
// การกล่าวถึงกลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลที่ตรวจสอบได้
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09): แถบประกาศเลื่อนเป็น "โครม"
// จึงประกาศสีของตัวเองครบ ไม่ได้ inherit BRAND_TEXT — พื้นแถบน้ำตาลถ่านเกือบดำ
// #180800 ป้าย "ประกาศ" เป็นไล่เฉดทองล้วน #ffd666 → #f2b705 → #c08a0b ตั้งใจให้
// จบที่ทองเข้ม ไม่ใช่แดงแบรนด์ เพราะหมึกบนป้ายเป็นน้ำตาลเกือบดำ #2b0a00 ซึ่งบน
// แดง #e8232a ได้แค่ 2.7:1 (ตก) แต่บนทองเข้ม #c08a0b ได้ 6.0:1 แดงไปอยู่ที่เส้น
// ล่างแทน เนื้อความ #fbe8d5 (16.3:1 บนพื้นแถบ)
// ชุดฟ้า-ทองของ HI59 (#04203f #ffe27a #fdbc04 #c88a02 #e4f1fd #0a84e0) และชุด
// เขียว-ทองของ KINGKONG555 หายไปทั้งหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} คลับคนเล่นสล็อตซุปเปอร์ รวบรวมข้อมูลเกมสล็อตจากค่ายต่างๆ กิจกรรมสมาชิก และโปรโมชั่นที่เปิดให้รับในแต่ละช่วงไว้ในระบบเดียว • มีทั้งสล็อตคลาสสิก เกมฟรีสปิน โบนัสตัวคูณ และเกมใหม่จากค่ายที่เปิดให้บริการ จัดหมวดหมู่ไว้ให้ค้นหาเกมได้สะดวก • แนวคิดดับเบิ้ลโบนัสคือการมีโปรโมชั่นมากกว่าหนึ่งรูปแบบให้เลือกตามเงื่อนไข ไม่ได้หมายความว่าสมาชิกจะได้รับโบนัสสองเท่าจากทุกเกมหรือทุกรายการเสมอไป • ควรตรวจสอบว่าโปรโมชั่นใดรับร่วมกันได้ รวมถึงค่ายเกมที่เข้าร่วม ระยะเวลา และข้อกำหนดของแต่ละกิจกรรมก่อนรับสิทธิ์ • โปรโมชั่นหลักมี คืนยอดเสีย 0.3% เข้ายูสทุกวัน ตามรอบที่เว็บไซต์กำหนด และ แนะนำเพื่อน รับโบนัสแชร์ลิงก์ 0.8% จากยอดที่เข้าเกณฑ์ • ส่วนคำว่าไม่จำกัด ควรระบุให้ชัดว่าหมายถึงจำนวนเพื่อนที่แนะนำ จำนวนครั้งในการรับสิทธิ์ หรือวงเงินโบนัส • หากเว็บไซต์ระบุว่าเงินฝากเข้าบัญชีบริษัทโดยตรง ควรมีชื่อบริษัทหรือนิติบุคคลที่ตรวจสอบได้ เพราะชื่อบัญชีบริษัทเพียงอย่างเดียวไม่ได้รับประกันว่าธุรกรรมจะไม่มีความเสี่ยง • ควรตรวจสอบยอดเงิน ชื่อบัญชี และรายละเอียดปลายทางก่อนยืนยันรายการทุกครั้ง พร้อมเก็บหลักฐานธุรกรรมไว้จนกว่าจะดำเนินการเสร็จสิ้น • การกล่าวถึงกลุ่มลับหรือบุคคลมีชื่อเสียงควรมีข้อมูลกิจกรรมและผู้เข้าร่วมที่ตรวจสอบได้ เพื่อไม่ให้เกิดความเข้าใจคลาดเคลื่อน • แอดมิน ${BRAND_NAME} เปิดให้บริการตลอด 24 ชั่วโมง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น แม้จะอ้างว่าเป็นเจ้าหน้าที่ของเว็บไซต์ก็ตาม`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#180800] shadow-[0_4px_15px_rgba(24,8,0,0.65)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#ffd666] via-[#f2b705] to-[#c08a0b] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#2b0a00] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#2b0a00]"></span>
      </span>
      <span class="font-black tracking-widest text-[#2b0a00] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#180800] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#180800] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#fbe8d5] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#f2b705] via-[#e8232a] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
