---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also renders it bare, so there
// is exactly one string and the ticker cannot say two different things on two
// pages.
//
// No emoji in this string: the marquee prints it three times, and an emoji baked
// into a text prop cannot be given its own aria-hidden span. The 2nd and 3rd
// copies exist only so the loop has no seam, so they carry aria-hidden="true" —
// without it a screen reader reads the whole announcement three times over.
//
// เนื้อหาทุกท่อนมาจากบรีฟ PGW44 รอบนี้เท่านั้น ไม่มีชื่อค่ายเกมเจาะจง ชื่อเกม
// ใบอนุญาต ชื่อธนาคาร หรือคำว่าคาสิโน/บาคาร่า/หวย/บอล เพราะบรีฟไม่ได้ระบุไว้เลย
// — ของเดิมในไฟล์เป็นคอปปี้คาสิโนของ BRAZIL999 ("คาสิโนแท้ จากบริษัทโดยตรง
// เว็บนี้ไม่มีประวัติโกง") ซึ่งไม่มีอยู่ในบรีฟรอบนี้ จึงถูกเขียนใหม่ทั้งสตริง
// ส่วน "ช่องทางไลน์" ใส่ได้รอบนี้ เพราะบรีฟระบุไว้ตรงๆ ในหัวข้อ H2 ที่ 7
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): แถบประกาศเลื่อน พื้นดำอมเขียว #050803
// ป้าย "ประกาศ" เป็นไล่เฉดทอง-เขียวตามลำดับตัวอักษรในโลโก้ #a86f02 → #fde90e →
// #7bf05a ตัวอักษรดำอมเขียว เนื้อความ #e9f0dd เส้นล่างไล่จากทองแบรนด์ #fde90e
// ผ่านเขียวแบรนด์ #35d413 — เขียวมรกต #22c55e/#b6ff9c/#dfeadd/#aab4bf บนพื้น
// #040a05 ของ BRAZIL999 หายไปทั้งหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} อัปเดตค่ายสล็อตย่อย มัดรวมมาให้ครบทุกแนวเกม ทั้งเกมคลาสสิก เกมโบนัส เกมธีมใหม่ และสล็อตที่อัปเดตตามช่วงเวลา • เลือกเกมได้จากระบบเดียว เมนูแบ่งหมวดหมู่ชัดเจน ไม่ต้องเปลี่ยนหลายเว็บไซต์ รองรับทั้งมือถือและคอมพิวเตอร์ • เข้าดูและเลือกเกมได้ตลอดทั้งวันตามรายการที่ระบบเปิดให้บริการ แต่ละเกมมีระดับเดิมพันและรูปแบบการเล่นต่างกัน ตรวจสอบรายละเอียดได้จากหน้าเกมโดยตรง • โบนัสแนะนำเพื่อน 0.8% ตรวจสอบยอดที่เข้าเกณฑ์และขั้นตอนรับสิทธิ์ได้จากบัญชีสมาชิก • โบนัสคืนยอดเสีย 0.3% ดูรอบคำนวณและเงื่อนไขก่อนกดรับสิทธิ์ได้ • สมัคร ${BRAND_NAME} ด้วยตัวเองผ่านหน้าเว็บไซต์ได้ใน 3 ขั้นตอน • ติดต่อเจ้าหน้าที่ผ่านช่องทางไลน์ที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#050803] shadow-[0_4px_15px_rgba(3,6,2,0.75)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#a86f02] via-[#fde90e] to-[#7bf05a] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#050803] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#050803]"></span>
      </span>
      <span class="font-black tracking-widest text-[#050803] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#050803] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#050803] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#e9f0dd] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#fde90e] via-[#35d413] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
