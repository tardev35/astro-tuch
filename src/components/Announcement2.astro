---
// The default is what every bare <Announcement /> on a sub-page renders, so it
// must be the CURRENT brand's copy — index.astro also renders it bare, so there
// is exactly one string and the ticker cannot say two different things on two
// pages.
//
// No emoji in this string: the marquee prints it three times, and an emoji baked
// into a text prop cannot be given its own aria-hidden span. The 2nd and 3rd
// copies exist only so the loop has no seam, so they carry aria-hidden="true" —
// without it a screen reader reads the whole announcement three times over.
//
// เนื้อหาทุกท่อนมาจากบรีฟ หวยเฮง789 รอบนี้เท่านั้น (src/assets/content.txt)
// ไม่มีชื่อค่ายเกม ใบอนุญาต ชื่อธนาคาร หรือคำว่าสล็อต/คาสิโน/บาคาร่า/บอล เพราะ
// บรีฟไม่ได้ระบุไว้เลย — ของเดิมในไฟล์เป็นคอปปี้สล็อตของ PGW44 ("อัปเดตค่าย
// สล็อตย่อย … โบนัสแนะนำเพื่อน 0.8% … คืนยอดเสีย 0.3%") ซึ่งไม่มีอยู่ในบรีฟ
// รอบนี้เลยสักท่อน จึงถูกเขียนใหม่ทั้งสตริง ไม่ใช่แทนที่แค่ชื่อแบรนด์
// ตัวเลขที่ใส่ได้มีแค่ของบรีฟเอง: 2 ตัว จ่าย 100 บาท · 3 ตัว จ่าย 1,000 บาท ·
// 3 ขั้นตอน · 24 ชั่วโมง และคำกำกับเรื่องวงเงินที่บรีฟเขียนไว้เองต้องติดไปด้วย
// เพราะพาดหัว "ไม่จำกัด / แทงได้ไม่อั้น" ของบรีฟมีเงื่อนไขกำกับอยู่ในบรีฟเช่นกัน
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แถบประกาศเลื่อน พื้นแดงเกือบดำ #1c0606
// ป้าย "ประกาศ" เป็นไล่เฉดทองล้วน #ffefc2 → #f4bc5d → #d99a10 — ตั้งใจให้จบที่ทอง
// ไม่ใช่แดงแบรนด์ เพราะหมึกบนป้ายเป็นแดงเกือบดำ #1c0606 ซึ่งบนแดง #dc2224 ได้แค่
// 3.4:1 (ตก) แต่บนทองสว่าง #d99a10 ได้ 7.0:1 แดงไปอยู่ที่เส้นล่างแทน
// ตัวอักษรบนป้ายเป็นแดงเกือบดำ #1c0606 เนื้อความ #fbe3d4 เส้นล่างไล่จากทองรอง
// #f4bc5d ผ่านแดงแบรนด์ #dc2224 — ชุดทอง-เขียวของ PGW44
// (#050803 #a86f02 #fde90e #7bf05a #e9f0dd #35d413) หายไปทั้งหมด
import { BRAND_NAME } from "../lib/brandProfile";

const {
  message = `${BRAND_NAME} เปิดรับแทงหวยออนไลน์ เลือกได้หลายประเภทผ่านบัญชีเดียว • มีทั้งหวยรัฐบาลไทยตามกำหนดออกรางวัล หวยฮานอยและหวยลาวตามรอบที่เปิดรับ และหวยหุ้นต่างประเทศตามตลาดที่ระบบรองรับ • เลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจได้ด้วยตัวเอง พร้อมดูเวลาปิดรับและอัตราจ่ายก่อนเลือกเลข • อัตราจ่าย 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท สำหรับรายการที่เข้าเงื่อนไข ทั้งนี้แต่ละประเภทหวยอาจใช้อัตราไม่เหมือนกัน ให้ยึดอัตราที่ปรากฏในหน้าส่งโพยของรอบนั้น • คำว่าไม่จำกัดและแทงได้ไม่อั้นให้อ้างอิงวงเงินที่ระบบเปิดรับจริง เพราะหวยแต่ละประเภท เลขแต่ละชุด และแต่ละรอบอาจกำหนดวงเงินต่างกัน • สมัครแทงหวย ${BRAND_NAME} ผ่านมือถือได้ใน 3 ขั้นตอน • ก่อนส่งโพยควรตรวจสอบเลข ยอดเดิมพัน และวงเงินที่รับได้ในรอบนั้นทุกครั้ง • ติดต่อแอดมินผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง`,
} = Astro.props;
---

<section aria-label={`ประกาศจาก ${BRAND_NAME}`} class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#1c0606] shadow-[0_4px_15px_rgba(11,2,2,0.75)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#ffefc2] via-[#f4bc5d] to-[#d99a10] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span aria-hidden="true" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#1c0606] opacity-75"></span>
        <span aria-hidden="true" class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#1c0606]"></span>
      </span>
      <span class="font-black tracking-widest text-[#1c0606] italic drop-shadow-md">ประกาศ</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#1c0606] to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#1c0606] to-transparent"></div>

    <div class="flex w-max animate-[scroll_28s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#fbe3d4] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#f4bc5d] via-[#dc2224] to-transparent"></div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_28s_linear_infinite\] {
      animation: none;
    }
  }
</style>
