---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1046e0]/40 bg-[#020a2b]/92 p-6 text-[#d6e2f5] shadow-[0_10px_30px_rgba(16,70,224,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#b7c6dd]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#3d82ff] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1046e0]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf7] to-[#0a3390] shadow-[0_0_10px_rgba(61,130,255,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e6ecf7] via-[#b7c6dd] to-[#8fc2ff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1046e0]/40 bg-[#01041c]/95 p-6 text-left text-base leading-relaxed text-[#d6e2f5] transition-all duration-300 hover:-translate-y-2 hover:border-[#b7c6dd]/70 hover:bg-[#072459] hover:shadow-[0_15px_40px_rgba(61,130,255,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#3d82ff]/55 bg-gradient-to-br from-[#e6ecf7] via-[#3d82ff] to-[#052ba9] text-2xl shadow-[0_5px_15px_rgba(61,130,255,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1046e0]/45 bg-[#01041c]/95 p-6 text-left text-base leading-relaxed text-[#d6e2f5] transition-all duration-300 hover:-translate-y-2 hover:border-[#1046e0]/70 hover:bg-[#072459] hover:shadow-[0_15px_40px_rgba(16,70,224,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#1046e0]/60 bg-gradient-to-br from-[#8fc2ff] via-[#1046e0] to-[#072459] text-2xl shadow-[0_5px_15px_rgba(16,70,224,0.28)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
