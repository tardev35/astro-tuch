---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎧", iconright = "🔐" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On the FLASH877 homepage it holds docx H2 #7,
// the แอดมิน 24 ชั่วโมง pair: the left paragraph is which cases the admin channel
// is for and when it is open, the right one is what to prepare before reporting
// one — ending with the brief's own warning never to hand over a password, PIN
// or OTP.
//
// Default icons are 🎧 / 🔐 — a support headset and a locked credential, which is
// exactly what those two paragraphs are about. Both render inside an aria-hidden
// box, so neither is ever part of an accessible name.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2):
// สองครึ่งบนการ์ดกระจกผิวกลาง #6d0804 ซึ่งยังสว่างกว่าพื้นเพจ #5c0000 การ์ดจึงลอย
// รอบนี้แบรนด์มีสองฮิวจริง — ทองสายฟ้านำ แดงสายฟ้าเป็นฮิวที่สอง — สองป้ายไอคอนจึงแยกกัน
// ด้วย "ทอง vs แดง" ไม่ใช่ด้วยระดับความสว่างของโลหะเดียว: ป้ายซ้ายเป็นแผ่นทองทึบ ไล่ครีม
// #fdf0e2 → ทองสว่าง #ffdd73 → ทองสายฟ้า #f5c518 บนหมึกแดงเกือบดำ #2a0300 (11.5:1
// ที่ปลายเข้มสุด — §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ส่วนป้ายขวาเป็นแผ่นแดงกำมะหยี่ทึบ
// ไล่แดงเข้ม #8c0f0a → แดงลึกสุด #5a0603 ในกรอบแดงสายฟ้า #ff3b14 บนไอคอนทองสว่าง
// #ffdd73 — สองป้ายจึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และตรงกับโลโก้ที่เป็นสายฟ้า
// ทองผ่ากลางเหรียญพื้นแดงเข้ม
// สองครึ่งตกลงไปที่ผิวลึกสุด #430000 ครึ่งซ้ายเป็นกรอบทองสายฟ้า ครึ่งขวาเป็นกรอบแดง
// สายฟ้า ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองสายฟ้าโปร่ง
// หัวข้อไล่ครีม #fdf0e2 → ทองสายฟ้า #f5c518 → แดงสายฟ้า #ff3b14 ซึ่งไม่ซ้ำลำดับกับกล่อง
// อื่นบนหน้าเดียวกันสักตัว (#ff3b14 อยู่ปลายไล่เฉดของตัวอักษร font-black text-2xl ซึ่ง
// §2 อนุญาตเฉพาะ display ขนาดใหญ่/หนาแบบนี้)
// เนื้อความ #fdf0e2 (= BRAND_TEXT) — 12.8:1 บนผิวกลาง และ 15.8:1 บนผิวลึกสุดของสองครึ่ง
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) ก็แดง-ทองเหมือนกัน ให้เทียบเป็นค่า: ชุดเขียวป่า-ทอง
// มงกุฎของ KINGKONG555 ที่เคยค้างในไฟล์นี้ (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230
// #ffe066 #a87a08 #e9f7d6 #14380a #0f2e05 #051400 #06220a rgba(242,194,48,α)
// rgba(140,224,35,α)) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #ff5a46
// #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b #fbe8d5 #3d1709 #241000) ชุดแดงแล็กเกอร์-ทอง
// ของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #b07a06 #6b0402 #fdeedd) ชุดม่วงนีออน-ทอง
// ของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05 #1e0a3c) และชุด
// ตรุษจีนแดง-เขียว-ทองของ GUCCI168 (#c41115 #e0201f #0b7a33 #d9a521 #ffdf91 #f6e3cf)
// ออกครบทุกจุดแล้ว — GUCCI168 กับ PIGPG ก็เป็นแดง-ทองเหมือนกัน แต่เป็นคนละค่าทุกตัว
// อย่าปล่อยไว้เพราะ "แดงอยู่แล้ว"
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c518]/35 bg-[#6d0804]/95 p-6 text-[#fdf0e2] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f5c518] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c518]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdd73] via-[#f5c518] to-[#5a0603] shadow-[0_0_10px_rgba(245,197,24,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf0e2] via-[#f5c518] to-[#ff3b14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5c518]/30 bg-[#430000]/95 p-6 text-left text-base leading-relaxed text-[#fdf0e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c518]/75 hover:bg-[#6d0804] hover:shadow-[0_15px_40px_rgba(245,197,24,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b8860f] bg-gradient-to-br from-[#fdf0e2] via-[#ffdd73] to-[#f5c518] text-2xl text-[#2a0300] shadow-[0_5px_15px_rgba(245,197,24,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#ff3b14]/45 bg-[#430000]/95 p-6 text-left text-base leading-relaxed text-[#fdf0e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff3b14]/80 hover:bg-[#6d0804] hover:shadow-[0_15px_40px_rgba(255,59,20,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff3b14]/60 bg-gradient-to-br from-[#8c0f0a] to-[#5a0603] text-2xl text-[#ffdd73] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#f5c518]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
