---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a6320]/40 bg-[#050505]/92 p-6 text-[#ece3d1] shadow-[0_10px_30px_rgba(230,183,78,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e6b74e]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e6b74e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a6320]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6dfa4] to-[#5c4212] shadow-[0_0_10px_rgba(230,183,78,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e6b74e] via-[#c8cfd8] to-[#f6dfa4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a6320]/35 bg-[#131009]/95 p-6 text-left text-base leading-relaxed text-[#ece3d1] transition-all duration-300 hover:-translate-y-2 hover:border-[#e6b74e]/50 hover:bg-[#1c170d]/90 hover:shadow-[0_15px_40px_rgba(230,183,78,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e6b74e]/35 bg-gradient-to-br from-[#f6dfa4] via-[#e6b74e] to-[#8a6320] text-2xl shadow-[0_5px_15px_rgba(230,183,78,0.28)]">
          🛎️
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#c8cfd8]/20 bg-[#131009]/95 p-6 text-left text-base leading-relaxed text-[#ece3d1] transition-all duration-300 hover:-translate-y-2 hover:border-[#c8cfd8]/50 hover:bg-[#1c170d]/90 hover:shadow-[0_15px_40px_rgba(200,207,216,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c8cfd8]/50 bg-gradient-to-br from-[#eef2f6] via-[#c8cfd8] to-[#8f9aa6] text-2xl shadow-[0_5px_15px_rgba(200,207,216,0.3)]">
          💬
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
