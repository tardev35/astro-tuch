---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): สองครึ่งบนการ์ดดำอมเขียว
// #0a1a0e แบรนด์นี้มีสองสีจริง (logo.webp คือตัว D เขียว vivid #01841b #018b1b
// ซ้อนตัว M แดง #fb252b #bb0303 #f91c20 ตามด้วยเลข 899 โครเมียม ส่วนทองมาจาก
// ตัวอักษรไล่เฉดบนแบนเนอร์) สองป้ายไอคอนจึงแยกกันด้วย "สองสีของแบรนด์" ไม่ใช่ระดับ
// ความสว่างของสีเดียว — ป้ายซ้ายเป็นฝั่งเขียว ไล่เขียวสว่าง #4ade6b → เขียวสว่าง
// กลาง #12c23a → เขียวแบรนด์ #01a326 และใช้หมึกบนพื้นสว่าง #06140a (วัดได้ 5.6:1
// บนปลายไล่เฉดที่เข้มสุดคือ #01a326 ซึ่งเป็นเหตุผลที่ไล่ไม่จบลงไปถึงเขียวแกน
// #01841b ที่ตกเหลือ 3.9:1) ส่วนป้ายขวาเป็นฝั่งแดง ไล่แดงอ่อน #ff6b6e → แดงแบรนด์
// #fb252b → แดงลึก #8f0609 และใช้ตัวอักษร "ขาว" ไม่ใช่หมึกเข้ม เพราะหมึก #06140a
// บนแดงแบรนด์ได้แค่ 2.8:1 (ตก) คู่นี้จึงอ่านเป็นเขียวนำ แดงตาม ตามโลโก้จริง กรอบ
// และเส้นไรผมเป็นเขียวแบรนด์ #01a326 แถวในตกลงไปที่พื้นลึกสุด #030a05 หัวข้อไล่
// ขาวนวล #e4f2e4 → เขียวสว่าง #4ade6b → แดงแบรนด์ #fb252b เนื้อความ #e4f2e4
// (BRAND_TEXT)
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #8c0402 #ffc93c
// #ffeab0 #c08a07 #240406 #140203 #1a0303 #f6e7e0) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#01a326]/55 bg-[#0a1a0e]/93 p-6 text-[#e4f2e4] shadow-[0_10px_30px_rgba(0,0,0,0.80)] backdrop-blur-xl transition-all duration-500 hover:border-[#12c23a]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#12c23a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0a4a18] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#4ade6b] via-[#01a326] to-[#01841b] shadow-[0_0_10px_rgba(1,163,38,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e4f2e4] via-[#4ade6b] to-[#fb252b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#0a4a18] bg-[#030a05]/95 p-6 text-left text-base leading-relaxed text-[#e4f2e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#12c23a]/75 hover:bg-[#102a16] hover:shadow-[0_15px_40px_rgba(1,163,38,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#4ade6b]/65 bg-gradient-to-br from-[#4ade6b] via-[#12c23a] to-[#01a326] text-2xl text-[#06140a] shadow-[0_5px_15px_rgba(1,163,38,0.40)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#0a4a18] bg-[#030a05]/95 p-6 text-left text-base leading-relaxed text-[#e4f2e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#fb252b]/70 hover:bg-[#102a16] hover:shadow-[0_15px_40px_rgba(251,37,43,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff6b6e]/70 bg-gradient-to-br from-[#ff6b6e] via-[#fb252b] to-[#8f0609] text-2xl text-white shadow-[0_5px_15px_rgba(251,37,43,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
