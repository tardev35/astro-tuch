---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose single paragraph splits cleanly in two.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): สองครึ่งบนการ์ดแผงแดงเข้ม #2a0d0f แยกกัน
// ด้วยคู่สีประจำงานอาร์ต — ป้ายไอคอนซ้ายไล่จากทองอ่อน #fde79a ลงทองรอง #f3c623
// ไปหาทองลึก #8a6a0a (เหรียญทองกับมงกุฎทองในแบนเนอร์) ส่วนป้ายขวาไล่จากแดงสว่าง
// #ff2d38 ลงแดงแบรนด์ #dc020e ไปจบที่แดงลึก #6b0207 (บล็อกแดงของเวิร์ดมาร์กกับ
// ลูกหวยแดง-ขาว) คู่นี้จึงอ่านเป็นทองนำ แดงตาม ตามงานอาร์ตจริง ไม่ใช่สีเดียวซ้ำ
// สองครั้ง ตัวอักษรบนป้ายทองใช้หมึกเข้ม #1a0203 (12.4:1) และบนป้ายแดงใช้ขาว
// (5.17:1) ตามกฎคอนทราสต์ — ห้ามใช้หมึกเข้มบนแดง กรอบและเส้นไรผมเป็นแดงลึก แถวใน
// ตกลงไปที่ผิวดำอมแดง #120b0c เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดแดง-ทองของ
// LOTTO24 ที่ค้างในไฟล์นี้ (#dc2626 #fc2b2c #b40102 #7f1d1d #fbbf24 #fde68a
// #a16207 #2a0405 #3b0404 #140202 #fff1f1 #f6e2e2) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b0207]/70 bg-[#2a0d0f]/92 p-6 text-[#f0e2e2] shadow-[0_10px_30px_rgba(5,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3c623]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#dc020e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b0207]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde79a] via-[#f3c623] to-[#dc020e] shadow-[0_0_10px_rgba(243,198,35,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#dc020e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b0207]/70 bg-[#120b0c]/95 p-6 text-left text-base leading-relaxed text-[#f0e2e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f3c623]/70 hover:bg-[#1f0a0c] hover:shadow-[0_15px_40px_rgba(243,198,35,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f3c623]/65 bg-gradient-to-br from-[#fde79a] via-[#f3c623] to-[#8a6a0a] text-2xl text-[#1a0203] shadow-[0_5px_15px_rgba(243,198,35,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b0207]/70 bg-[#120b0c]/95 p-6 text-left text-base leading-relaxed text-[#f0e2e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2d38]/70 hover:bg-[#1f0a0c] hover:shadow-[0_15px_40px_rgba(220,2,14,0.32)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff2d38]/65 bg-gradient-to-br from-[#ff2d38] via-[#dc020e] to-[#6b0207] text-2xl text-white shadow-[0_5px_15px_rgba(220,2,14,0.36)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
