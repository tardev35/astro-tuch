---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💬", iconright = "🛡️" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected. รอบนี้หน้าแรกไม่ส่ง `actions`
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §6**
// ("โปรโมชั่นแทงหวย <แบรนด์> รับได้ไม่จำกัดยูส" — content.txt บรรทัด 14): ซีกซ้าย
// คือ **ตัวรายการโปรโมชั่น** (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% กับข้อกำหนดที่
// ต่างกันไปตามประเภทหวย ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนบัญชีที่เข้าร่วม)
// ซีกขวาคือ **สิ่งที่บรีฟสั่งให้ตรวจก่อนรับสิทธิ์** (อ่านเงื่อนไขล่าสุด และดูว่าใช้
// ร่วมกันได้หรือไม่) หน้าแรกส่งไอคอน 🎁 / 📋 ทั้งคู่อยู่ในกล่อง aria-hidden จึงไม่เคย
// เป็นส่วนหนึ่งของ accessible name
//
// รวยแท้168 (2026-10-21) — พาเลตตาม .claude/brand-spec-ruaythear168vip.md §2
// ⚠️⚠️ **ธีมสว่างรอบที่สามของรีโปนี้** พื้นเพจ #ffdbdb (bg.json) การ์ดเนื้อหาเป็น
// **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับไปเป็นพื้นเข้ม
// ลำดับผิว: #ffffff ยก (การ์ดใบนี้) · #fff1ef กลาง (สองซีก) · #ffdbdb พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ผิวขาวครอบ
// สองซีกที่ตกลงไปอยู่ผิวชมพูอ่อน ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่
// บน-ล่าง** (border-y) ไม่ใช่ขีดใต้ แถบตั้ง แผ่นถม หรือสันซ้ายแบบใบอื่น
// หัวข้อไล่ หมึกเลือดหมู #4a0f0f → แดงคริมสัน #c30303 → หมึกเลือดหมู #4a0f0f
// ("เลือดหมูผ่านคริมสันกลับลงเลือดหมู") ซึ่งไม่ซ้ำลำดับกับกล่อง docx ใบอื่นบนหน้า
// เดียวกันสักตัว ⚠️ ไล่เฉดนี้ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อป
// ต้องถือตัวอักษรได้ตาม §2 (บนผิวขาว: 15.4 / 6.3 / 15.4) **ห้ามเอา #e81313 #ffdbdb
// หรือ #fff1ef มาเป็นสต็อป**
// สองป้ายไอคอนเป็น **ขั้วกลับของกันเอง**: ซ้ายเป็น **แผ่นสว่าง** ไล่ขาว → ชมพูอ่อน
// #fff1ef ในกรอบแดงคริมสัน บนหมึก #4a0f0f ส่วนขวาเป็น **แผ่นถมแดงทึบ** ไล่ #c30303
// → #4a0f0f ในกรอบ #4a0f0f บนหมึก **ขาว** (6.3:1 ที่สต็อปอ่อนสุด)
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบแดงคริมสัน ซีกขวากรอบหมึกเลือดหมู
// เส้นคาดหัวการ์ดเป็นแดงคริมสันโปร่ง เนื้อความ #4a0f0f (= BRAND_TEXT) — 15.4:1 บน
// ผิวขาว และ 14.6:1 บนผิวชมพูอ่อนของสองซีก
// ⚠️ §2 ห้าม #e81313 ถือตัวอักษรและห้ามเป็นพื้นของตัวอักษร · ห้าม #ffdbdb/#fff1ef
// ถือตัวอักษรบนผิวขาว · **#8f0505 สงวนไว้ให้ <strong> ในเนื้อความเท่านั้น** จึงไม่มี
// ในไฟล์นี้ · และ **ทองโบราณ #dcb95f / #b8862b / #96681f เป็นสีของโครมล้วน
// ห้ามโผล่ในไฟล์นี้**
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **แดงนำมาแล้วหลายแบรนด์ในรีโปนี้**
// แดงรอบนี้ #c30303 ห่าง d30304 (รับตัง168) 16 หน่วย และห่าง b90203 (สมหวัง168)
// 10 หน่วย ชุดเขียวมรกต-ทองสัมฤทธิ์ของ **สาธุ168 (แบรนด์ขาออก)** (0b7d28 0a5f1c
// 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd) และชุดชมพูบานเย็นของ
// มีทรัพย์168 ที่เคยอยู่ทั้งใบนี้ (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ออกครบ
// ทุกค่าแล้ว รวมถึงชุดของ ดวงเศรษฐี168 (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120
// 300605 150303) ufalion168 (d4922c fdfc71 f6e3b4 a25b24 5a3310 33200a 1f1304 0a0601)
// รวยเทพ168 (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06) มีเฮ168 (fb1b32
// ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a 0c0205) รวยแทร่168 (039cfa 0494f5 c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52) นินจา168 (32bcfb a9e9ff fef54b 07335f 6b5c10
// 0c2a3d 071a28 030e16) สบายเบท168 (2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16 e8f4ff)
// ถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708) มีโชค168
// (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee) ขวัญใจ168 (f7c92b ffe6a3
// f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce) รับตัง168 (f0b429 ffdc8c d30304 ff6b6e
// a00203 4a0202 9a6c0c cfd9e6) สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210
// b90203 8c0204) หวยคิง (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02
// 1c140b) KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 ece2f8) และ TSDET911
// (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีส้ม**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c30303]/45 bg-white p-6 text-[#4a0f0f] shadow-[0_10px_30px_rgba(74,15,15,0.16)] transition-all duration-500 hover:border-[#c30303]/80 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#c30303] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#c30303]/45 py-4">
          <HeadingTag class="bg-gradient-to-r from-[#4a0f0f] via-[#c30303] to-[#4a0f0f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c30303]/45 bg-[#fff1ef] p-6 text-left text-base leading-relaxed text-[#4a0f0f] transition-all duration-300 hover:-translate-y-2 hover:border-[#c30303]/85 hover:bg-[#ffdbdb] hover:shadow-[0_15px_40px_rgba(195,3,3,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c30303] bg-gradient-to-br from-white to-[#fff1ef] text-2xl text-[#4a0f0f] shadow-[0_5px_15px_rgba(195,3,3,0.26)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#4a0f0f]/45 bg-[#fff1ef] p-6 text-left text-base leading-relaxed text-[#4a0f0f] transition-all duration-300 hover:-translate-y-2 hover:border-[#4a0f0f]/80 hover:bg-[#ffdbdb] hover:shadow-[0_15px_40px_rgba(74,15,15,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#4a0f0f] bg-gradient-to-br from-[#c30303] to-[#4a0f0f] text-2xl text-white shadow-[0_5px_15px_rgba(74,15,15,0.42)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#c30303]/40 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
