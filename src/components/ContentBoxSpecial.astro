---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎧", iconright = "🔐" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// These two wrappers are also the documented exception to the flattening sweep:
// they do real layout beside the icon box and cannot be hoisted away.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On the DUCK1688 homepage it holds docx H2 #7,
// the แอดมิน 24 ชั่วโมง pair: the left paragraph is which cases the admin channel
// is for and when it is open, the right one is what to prepare before reporting
// one — ending with the brief's own warning never to hand over a password, PIN
// or OTP.
//
// Default icons are 🎧 / 🔐 — a support headset and a locked credential, which is
// exactly what those two paragraphs are about. Both render inside an aria-hidden
// box, so neither is ever part of an accessible name.
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10, brand-spec §2):
// สองครึ่งบนการ์ดกระจกผิวกลาง #171106 ซึ่งสว่างกว่าพื้นเพจดำสนิท การ์ดจึงลอย
// รอบนี้แบรนด์มีสองฮิวจริง — ทองเป็ดนำ ส้มอำพันปากเป็ดเป็นฮิวที่สอง — สองป้ายไอคอนจึง
// แยกกันด้วย "แผ่นสว่าง vs แผ่นมืด" ซ้อนกับ "ทอง vs ส้ม" ไม่ใช่ด้วยระดับความสว่างของ
// โลหะเดียว: ป้ายซ้ายเป็นแผ่นทองทึบ ไล่ครีม #f6ecd9 → ทองสว่าง #fde464 → ทองเป็ด
// #f3bb34 บนหมึกดำอมทอง #1a1203 (10.4:1 ที่ปลายเข้มสุด — §2 ห้ามพลิกแผ่นทองไปใช้หมึก
// สว่าง และห้ามไล่ลงไปถึง #8a5f08 ใต้ตัวอักษร) ส่วนป้ายขวาเป็นแผ่นมืดทึบ ไล่ทองเส้น
// #5c3f04 → ผิวลึก #0d0903 ในกรอบส้มอำพัน #f58b2a บนไอคอนทองสว่าง #fde464 — สองป้าย
// จึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และตรงกับโลโก้ที่เป็นเป็ดทองขยิบตาอยู่บน
// แผ่นป้ายดำขอบทองหนา
// สองครึ่งตกลงไปที่ผิวลึก #0d0903 ครึ่งซ้ายเป็นกรอบทองเป็ด ครึ่งขวาเป็นกรอบส้มอำพัน
// ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองเป็ดโปร่ง
// หัวข้อไล่ส้มอำพัน #f58b2a → ทองสว่าง #fde464 → ทองเป็ด #f3bb34 ซึ่งไม่ซ้ำลำดับกับ
// กล่องอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #f6ecd9 (= BRAND_TEXT) — 15.9:1 บนผิวกลาง และ 17.4:1 บนผิวลึกของสองครึ่ง
//
// ⚠️ แบรนด์รอบก่อน (NAZA168) ก็ทองเหมือนกัน และเจ็ดในแปดรอบหลังสุดก็มีทอง ให้เทียบเป็น
// ค่า: ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 ที่เคยค้างในไฟล์นี้ (#f5c518 #ffdd73
// #b8860f #ff3b14 #8c0f0a #5a0603 #7d1008 #6d0804 #5c0000 #430000 #fdf0e2 #2a0300)
// ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05
// #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700 #231500) ชุดเขียวป่า-ทอง
// มงกุฎของ KINGKONG555 (#8ce023 #5cc211 #2f8c07 #1a5c04 #f2c230 #ffe066 #a87a08
// #e9f7d6 #14380a #0f2e05 #051400 #06220a) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB
// (#e8232a #ff5a46 #7d0f12 #4a0605 #f2b705 #ffd666 #c08a0b #fbe8d5 #3d1709 #241000)
// ชุดแดงแล็กเกอร์-ทองของ PIGPG (#d4200d #a30303 #f5b61d #ffd87a #b07a06 #6b0402)
// ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05
// #1e0a3c) และชุดตรุษจีนแดง-เขียว-ทองของ GUCCI168 (#c41115 #e0201f #0b7a33 #d9a521
// #ffdf91 #f6e3cf) ออกครบทุกจุดแล้ว — รอบนี้ไม่มีแดง ไม่มีเขียว และไม่มีเงินโครเมียม
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f3bb34]/35 bg-[#171106]/95 p-6 text-[#f6ecd9] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3bb34]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f3bb34] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f3bb34]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde464] via-[#f3bb34] to-[#a3510c] shadow-[0_0_10px_rgba(243,187,52,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f58b2a] via-[#fde464] to-[#f3bb34] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f3bb34]/30 bg-[#0d0903]/95 p-6 text-left text-base leading-relaxed text-[#f6ecd9] transition-all duration-300 hover:-translate-y-2 hover:border-[#f3bb34]/75 hover:bg-[#1f1709] hover:shadow-[0_15px_40px_rgba(243,187,52,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a5f08] bg-gradient-to-br from-[#f6ecd9] via-[#fde464] to-[#f3bb34] text-2xl text-[#1a1203] shadow-[0_5px_15px_rgba(243,187,52,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f58b2a]/45 bg-[#0d0903]/95 p-6 text-left text-base leading-relaxed text-[#f6ecd9] transition-all duration-300 hover:-translate-y-2 hover:border-[#f58b2a]/80 hover:bg-[#1f1709] hover:shadow-[0_15px_40px_rgba(245,139,42,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f58b2a]/60 bg-gradient-to-br from-[#5c3f04] to-[#0d0903] text-2xl text-[#fde464] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#f3bb34]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
