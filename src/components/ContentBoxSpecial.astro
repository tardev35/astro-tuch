---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎧", iconright = "📋" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// These two wrappers are also the documented exception to the flattening sweep:
// they do real layout beside the icon box and cannot be hoisted away.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On this brand's homepage it holds docx H2 #7,
// the แอดมิน PUNPRO168 เปิดให้บริการ 24 ชั่วโมง pair: the left paragraph is the
// support channel itself (เรื่องที่สอบถามได้ · เวลาให้บริการ · ช่องทางหลักที่
// เว็บไซต์กำหนด) and the right one is the brief's own guidance on reporting a
// problem so it matches the right record (ข้อความแจ้งเตือนและเวลาที่เกิดเหตุ ·
// ชื่อกิจกรรมและรอบรับสิทธิ์ · เวลา จำนวนเงิน และหลักฐานรายการ) และปิดท้ายด้วย
// คำเตือนเรื่องรหัสผ่าน PIN และ OTP
//
// Default icons are 🎧 / 📋 — a support channel and a filled-in report, which is
// exactly what those two paragraphs are about. Both render inside an aria-hidden
// box, so neither is ever part of an accessible name.
//
// รอบนี้ (2026-10-12, brand-spec §2): สองครึ่งบนการ์ดกระจกผิวกลาง #3a0a2a ซึ่งสว่าง
// กว่าพื้นเพจพลัมเข้ม **#2e0022 ไม่ใช่ดำสนิท** การ์ดจึงลอย และรอบนี้ยังมีชั้นที่จม
// ต่ำกว่าพื้นได้จริง (#1c0014) ซึ่งใช้เป็นพื้นของสองครึ่ง
// แบรนด์มีสองฮิวจริง — ชมพูบานเย็นนำ (คำว่า PUNPRO สามมิติและตัวเครื่องเกมบนโลโก้)
// ทองสว่างรอง (เลข 168 สามมิติ เหรียญทอง มงกุฎ) — สองป้ายไอคอนจึงแยกกันด้วย
// "แผ่นทองทึบ vs แผ่นมืดกรอบชมพู" ไม่ใช่ด้วยระดับความสว่างของชมพูเดียว: ป้ายซ้ายเป็น
// แผ่นทองทึบ ไล่ครีมชมพู #fde7f2 → ทองสว่าง #fce343 → ทองอำพัน #ffc554 บนหมึก
// #2a0012 (12.3:1 ที่ปลายเข้มสุด — §2 ห้ามไล่เข้มกว่า #ffc554 ใต้ตัวอักษร และห้าม
// พลิกแผ่นทองไปใช้หมึกสว่าง) ส่วนป้ายขวาเป็นแผ่นมืดทึบ ไล่ชมพูลึกสุด #4a0426 → ผิวจม
// #1c0014 ในกรอบชมพูแบรนด์ #f41571 บนไอคอนชมพูสว่าง #ff5ca8 — สองป้ายจึงเป็นขั้วกลับ
// ของกันเอง ทั้งพื้นและหมึก และตรงกับโลโก้ที่ตัวอักษรชมพูวางคู่เลขทองวาว
// สองครึ่งตกลงไปที่ผิวจม #1c0014 ครึ่งซ้ายเป็นกรอบชมพูแบรนด์ ครึ่งขวาเป็นกรอบทองสว่าง
// ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองสว่างโปร่ง
// หัวข้อไล่ทองสว่าง #fce343 → ชมพูสว่าง #ff5ca8 → ชมพูบานเย็น #f41571 ซึ่งไม่ซ้ำลำดับ
// กับกล่อง docx ใบอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #fde7f2 (= BRAND_TEXT) — 14.2:1 บนผิวกลาง และ 17.2:1 บนผิวจมของสองครึ่ง
// §2 ห้าม #8a0a45 / #4a0426 ถือตัวอักษรทุกขนาด — ที่นี่อยู่ที่ขอบแผ่นทองและไล่เฉด
// ของแผ่นมืดเท่านั้น และ #ffd94a สงวนไว้ให้ <strong> ในย่อหน้า จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ แปดในสิบแบรนด์หลังสุดมีทอง และ FAH999 กับ PIGPG เป็นแบรนด์ชมพูมาก่อน ให้เทียบ
// เป็นค่า ไม่ใช่ตระกูลสี: ชุดทองอำพันเสือของ TIGERWIN369 ที่เคยค้างในไฟล์นี้ (#d98324
// #f7b733 #ffd98a #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a #1c1206 #0f0903)
// ชุดทองแชมเปี้ยน-เงินโครเมียมของ UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06
// #f0e8d4 #ffe08a #7d5a07 #43300a #464f5a #140d01 #f2f5f9) ชุดชมพูฮอต-ทองของ FAH999
// (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #9c6f08 #b3006a #7a0046 #4d002b
// #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (#f3bb34
// #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c #1a1203 #f6ecd9 #1f1709
// #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #ffe87a #cf9a18
// #96690a #6b4a05 #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700 #231500)
// ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a)
// ชุดเขียวป่า-ทองมงกุฎของ KINGKONG555 (#8ce023 #f2c230 #ffe066 #a87a08 #051400) และ
// ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05
// #1e0a3c) ออกครบทุกจุดแล้ว — ⚠️ "มีทองอยู่แล้ว" และ "มีชมพูอยู่แล้ว" ไม่พิสูจน์อะไร
// ทองรอบนี้คือ #fce343 / #ffc554 และชมพูรอบนี้คือ #f41571 / #ff5ca8 ไม่ใช่ #f5c53d
// และไม่ใช่ #ff3fa4
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f41571]/35 bg-[#3a0a2a]/95 p-6 text-[#fde7f2] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f41571]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fce343] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f41571]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5ca8] via-[#f41571] to-[#4a0426] shadow-[0_0_10px_rgba(244,21,113,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fce343] via-[#ff5ca8] to-[#f41571] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f41571]/30 bg-[#1c0014]/95 p-6 text-left text-base leading-relaxed text-[#fde7f2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f41571]/75 hover:bg-[#4a1038] hover:shadow-[0_15px_40px_rgba(244,21,113,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a0a45] bg-gradient-to-br from-[#fde7f2] via-[#fce343] to-[#ffc554] text-2xl text-[#2a0012] shadow-[0_5px_15px_rgba(252,227,67,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fce343]/35 bg-[#1c0014]/95 p-6 text-left text-base leading-relaxed text-[#fde7f2] transition-all duration-300 hover:-translate-y-2 hover:border-[#fce343]/70 hover:bg-[#4a1038] hover:shadow-[0_15px_40px_rgba(252,227,67,0.2)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f41571]/60 bg-gradient-to-br from-[#4a0426] to-[#1c0014] text-2xl text-[#ff5ca8] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#f41571]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
