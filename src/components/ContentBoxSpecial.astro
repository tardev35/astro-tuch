---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// ABM96 palette (ชมพู-เหลือง): สองครึ่งบนการ์ดพื้นยก #2a0a1a แยกกันด้วยคู่สีประจำ
// โลโก้ — ป้ายไอคอนซ้ายไล่จากชมพูอ่อน #ffc9dc ลงชมพูหลัก #fd6494 ไปหาชมพูเข้ม
// #b8325f (ตัวอักษร ABM) ส่วนป้ายขวาไล่จากเหลืองอ่อน #ffe98a ลงเหลืองโลโก้ #feda2a
// ไปหาเหลืองเข้ม #d9a800 (เลข 96) คู่นี้จึงอ่านเป็น เหลืองคู่ชมพู ตามโลโก้จริง
// ไม่ใช่สีเดียวซ้ำสองครั้ง กรมท่า-ทองของรอบก่อนออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c1356a]/35 bg-[#2a0a1a]/92 p-6 text-[#fbe3ee] shadow-[0_10px_30px_rgba(18,3,10,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#fd6494]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fd6494] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c1356a]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9dc] via-[#fd6494] to-[#b8325f] shadow-[0_0_10px_rgba(253,100,148,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffc9dc] via-[#fd6494] to-[#feda2a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c1356a]/45 bg-[#1d0611]/95 p-6 text-left text-base leading-relaxed text-[#fbe3ee] transition-all duration-300 hover:-translate-y-2 hover:border-[#fd6494]/70 hover:bg-[#2a0a1a] hover:shadow-[0_15px_40px_rgba(253,100,148,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fd6494]/60 bg-gradient-to-br from-[#ffc9dc] via-[#fd6494] to-[#b8325f] text-2xl shadow-[0_5px_15px_rgba(253,100,148,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#3d0f26]/80 bg-[#1d0611]/95 p-6 text-left text-base leading-relaxed text-[#fbe3ee] transition-all duration-300 hover:-translate-y-2 hover:border-[#feda2a]/60 hover:bg-[#2a0a1a] hover:shadow-[0_15px_40px_rgba(254,218,42,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#feda2a]/50 bg-gradient-to-br from-[#ffe98a] via-[#feda2a] to-[#d9a800] text-2xl shadow-[0_5px_15px_rgba(254,218,42,0.22)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
