---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💬", iconright = "🧾" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected. รอบนี้หน้าแรกไม่ส่ง `actions`
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §6**
// ("ระบบฝากถอน <แบรนด์> ได้ทุกธนาคารและทรูมันนี่" — content.txt บรรทัด 13)
// พร้อมย่อหน้าของมัน (บรรทัด 14) แบ่งครึ่ง: ซีกซ้ายคือ **ช่องทางฝากถอนผ่านธนาคาร
// และทรูมันนี่ และสิ่งที่ต้องตรวจก่อนฝากเงิน** (รายชื่อธนาคารที่รองรับ ยอดขั้นต่ำ
// ชื่อบัญชีปลายทางให้ตรงกับข้อมูลผู้ให้บริการที่ยืนยันได้) ซีกขวาคือ **ระยะเวลา
// ดำเนินการ ข้อกำหนดการถอนเงิน และสิ่งที่ต้องทำเมื่อพบชื่อบัญชีผิดปกติ** หน้าแรก
// ส่งไอคอน 💳 / 🔎 ทั้งคู่อยู่ในกล่อง aria-hidden จึงไม่เคยเป็นส่วนหนึ่งของ
// accessible name
// ⚠️ **ไม่มี BankStrip / ProviderGrid บนหน้าแรกรอบนี้** — บรีฟพูดถึง "ธนาคารและ
// ทรูมันนี่" แบบนามธรรม ไม่ได้ระบุชื่อธนาคาร ค่ายเกม หรือผู้ให้บริการรายไหนเลย
// แถบโลโก้จึงเป็นข้อมูลที่หน้าเพจแต่งเอง ไม่ใช่ของบรีฟ
//
// ───────────────────────────────────────────────────────────────────────────
// สล็อต168 (ดรอป 2026-10-23) — พาเลตตาม .claude/brand-spec-slot168.md §2
// **แดงเจลมันวาวนำ · ขาว/มุกอุ่น (R>G>B) เป็นวัสดุที่สอง · บนดำอมแดงเข้ม**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงคริมสัน-อะซัวร์บนน้ำเงินเที่ยงคืนของ
// มาดาม168** ทั้งใบ จึงรีเธมทั้งไฟล์ **รอบนี้ยังเป็นธีมมืด แต่คนละฮิว** พื้นเพจ
// #140000 (bg.json) = ดำอมแดงเข้มมาก **ห้ามแก้กลับไปเป็นพื้นสว่าง และห้ามเหลือ
// ฟ้า/อะซัวร์/น้ำเงินไว้เลยสักค่า**
// ลำดับผิว: #2a0c0d ยก (แผ่นไอคอนซ้าย) · **#0b0000 จม (การ์ดครอบ)** ·
// **#1c0607 การ์ด (สองซีก)** · #140000 พื้นเพจ
// ⚠️⚠️ **สองซีกตั้งใจอยู่ที่ผิวการ์ด #1c0607 ไม่ใช่ผิวยก #2a0c0d** เพราะ <strong>
// ของหน้าเพจเป็น **#fb2e33** ซึ่งได้ **5.1:1 บน #1c0607 (ผ่าน AA)** แต่ตกลงเหลือ
// **4.6:1 บน #2a0c0d** (ไฮไลต์เป็น text-base ตัวหนา = normal text เกณฑ์ 4.5:1
// ไม่ใช่ large text) — **ห้ามสลับสองผิวนี้กัน**
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ผิวจมครอบ
// สองซีกที่ลอยขึ้นมาอยู่ผิวการ์ด (กลับทิศจากใบอื่นที่ซีกในจมกว่าการ์ดนอก)
// ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่บน-ล่าง** (border-y) ไม่ใช่ขีดใต้
// แท่งตั้ง แผ่นถม สันซ้าย หรือชิปกลีฟแบบใบอื่น และเป็น **แดงเจล #fb2e33 ทึบ
// สีเดียว ไม่ไล่เฉด** (5.5:1 บนผิวจม)
// สองแผ่นไอคอนเป็น **ขั้วกลับของกันเอง**: ซ้ายเป็น **แผ่นผิวยก** ไล่ #2a0c0d →
// #1c0607 ในกรอบ #551c1e บนหมึก **#f0e6e4** (เงียบ เป็นผิว ไม่ใช่สีนำ) ส่วนขวาเป็น
// **แผ่นถมแดงทึบ** ไล่ #d81115 → #b00d11 ในกรอบ #8a0608 บนหมึก **ขาว** ซึ่งเป็น
// สูตร "CTA หลัก" ของ §2 ตรง ๆ (5.2:1 ที่สต็อปอ่อนสุด · 7.2:1 ที่สต็อปเข้ม)
// ⚠️⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #fb2e33 แล้ววางหมึกขาว (3.8:1)** — §2 ระบุไว้ตรง ๆ
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบ #551c1e ซีกขวากรอบแดงลึก #cb0b0d
// เส้นคาดหัวการ์ดเป็นแดงเจล #fb2e33 โปร่ง (**พื้นถม ไม่ใช่ตัวอักษร**)
// เนื้อความ #f0e6e4 (= BRAND_TEXT) — 16.9:1 บนผิวจม และ 16.0:1 บนผิวการ์ด
// ⚠️ §2 ห้าม **#cb0b0d #8a0608 #551c1e #7d6f6e #2a0c0d #1c0607 #0b0000 #140000**
// ถือตัวอักษร · **#fb2e33 สงวนไว้ให้ <strong> ในเนื้อความด้วย** ซึ่งเป็นงานของ
// หน้าเพจ ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(251,46,51,α) · rgba(203,11,13,α) · rgba(138,6,8,α) ·
// rgba(216,17,21,α) · rgba(240,230,228,α) · rgba(20,0,0,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — รอบนี้เป็นแบรนด์แดงจริง และรีโปนี้
// มีแดงของแบรนด์อื่นอยู่สิบกว่าชุด "มีแดงอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// แดงรอบนี้คือ **#fb2e33 / #cb0b0d / #8a0608 / #d81115 / #b00d11** เท่านั้น
// ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **มาดาม168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — ff2e52 e01238 c9102f 1177e8 0e68cc
//     0a4ea8 2a3c70 16234a 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6
//   **รวย168 (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — ffd94a e3a712 9d6f06 e8eaee
//     b4b9c2 6b7079 dde1e7 070707 121110 1c1a16 3d3425 f3ece0 bfb8aa
//     ⚠️ 1c1a16 ห่างจากผิวการ์ดรอบนี้ 1c0607 แค่ G/B — **grep ทีละค่า**
//   **นาซ่า168** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722
//     33455f 0d1017
//   **ร่ำรวย168** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f
//     f4e4d3 e4cbb3
//   **GT66B** — fb141b ff5f63 ffa0a2 db040b 8a0609 ⚠️ fb141b ห่าง #fb2e33 หนึ่งก้าว
//     และ 8a0609 ห่าง #8a0608 หนึ่งก้าว **เจอค่าพวกนี้แปลว่าพิมพ์ผิด**
//   **รวยแท้168** — c30303 8f0505 e81313 4a0f0f ffeee8 fff1ef ffdbdb
//   **เงินทอง168** — f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa fdcb0c 8a6504
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b f9a826 704504
//   **นินจา168** — 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28
//   **สบายเบท168** — 2f9ff5 a8dcff d6ecff 0b3f78 ffc82e 5c4a16
//   **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f
//   **สาธุ168** — 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a
//   **มีทรัพย์168** — dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5
//   **ดวงเศรษฐี168** — d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120
//     ⚠️ 2a0608 ห่างจากผิวยกรอบนี้ 2a0c0d แค่ G/B — **grep ทีละค่า**
//   **KMD88** — 7505cc b453ff c07cff d9b8ff 3a0565 2c0349 ece2f8
//   อื่น ๆ — b3121b 5a0a0e f2bba5 c98a74 (ขวัญใจ168) · eb0305 e40303 c20305 9b0a0c
//     ff4446 (โปรดี168) · fa0513 ff5a5f ffadaf (สมหวัง168) · fb1b32 ff8f9c 5c0410
//     (มีเฮ168) · e4021b (รวยเทพ168) · d30304 a00203 ff6b6e (รับตัง168) · dc0203
//     f5282a (หวย365) · fa63b9 ffb3de (ถอนชัวร์168) · f5469f ff8dc6 8c0f52 (มีโชค168) ·
//     ff3b14 6d0804 2b0000 (FLASH877)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีทอง/เหลือง ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีส้ม
// ไม่มีชมพู/ฟูเชีย ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงินเย็น** —
// วัสดุที่สองรอบนี้คือ **มุกอุ่น (R>G>B)** และมงกุฎทองเล็กในโลโก้เป็นรายละเอียด
// ~2% ของอาร์ตเวิร์ก **ไม่ใช่สี UI**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#551c1e] bg-[#0b0000] p-6 text-[#f0e6e4] shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-500 hover:border-[#fb2e33] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fb2e33] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#551c1e] py-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#fb2e33]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#551c1e] bg-[#1c0607] p-6 text-left text-base leading-relaxed text-[#f0e6e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(251,46,51,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#551c1e] bg-gradient-to-br from-[#2a0c0d] to-[#1c0607] text-2xl text-[#f0e6e4] shadow-[0_5px_15px_rgba(0,0,0,0.5)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#cb0b0d] bg-[#1c0607] p-6 text-left text-base leading-relaxed text-[#f0e6e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#fb2e33] hover:shadow-[0_15px_40px_rgba(203,11,13,0.32)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a0608] bg-gradient-to-br from-[#d81115] to-[#b00d11] text-2xl text-white shadow-[0_5px_15px_rgba(138,6,8,0.55)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#551c1e] pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
