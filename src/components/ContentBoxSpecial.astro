---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🏦", iconright = "🧾" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On this brand's homepage it holds docx H2 §6,
// the ระบบฝากถอน ยอดเข้าบริษัทโดยตรง pair: the left paragraph is the deposit/
// withdrawal system itself (รายชื่อธนาคารที่รองรับ · ชื่อบัญชีรับเงิน · สถานะรายการ ·
// ชื่อนิติบุคคลที่ควรตรวจสอบได้) and the right one is the brief's own guidance for
// ฝากถอนทุกธนาคาร (ข้อจำกัดด้านเวลาและระบบธุรกรรม · การเทียบชื่อบัญชีปลายทางกับช่องทาง
// หลัก · การเก็บหลักฐานธุรกรรม) ปิดท้ายด้วยคำกำกับของบรีฟเองว่าการโอนเงินเข้าบัญชี
// บริษัทไม่ได้รับประกันความปลอดภัยทั้งหมด
//
// Default icons are 🏦 / 🧾 — a company bank account and a transaction record,
// which is exactly what those two paragraphs are about. Both render inside an
// aria-hidden box, so neither is ever part of an accessible name.
//
// TKB55 (รอบแดงเลือดนก-เงินโครเมียม 2026-10-13, brand-spec §2): สองครึ่งบนการ์ดกระจก
// ผิวยก #2a0d0f ⚠️ พื้นเพจรอบนี้ **ดำสนิท** (bg.json = {"mode":"color","color":
// "#000000"}) จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้ ผิวจม #0d0304 คือก้นสุด และเป็นพื้นของ
// สองครึ่ง
// แบรนด์มีสองโทนจริง — แดงนำ (ตัวอักษร TKB สามมิติสีแดงสด ริบบิ้นแสงแดง ผ้าซาตินแดง
// ชิปแดง ลูกเต๋าแดง) เงินโครเมียมรอง (เลข 55 ขัดเงา ผมขาวเงินของทั้งคู่ ขอบวงล้อรูเล็ต)
// — สองป้ายไอคอนจึงแยกกันด้วย "แผ่นเงินโครเมียมทึบ vs แผ่นมืดกรอบแดง" ไม่ใช่ด้วยระดับ
// ความสว่างของแดงเดียว: ป้ายซ้ายเป็นแผ่นเงินทึบ ไล่เงินสว่าง #e9eef4 → เงินหม่น
// #aeb9c6 บนหมึก #1a0304 (§2 ระบุว่า #1a0304 เป็นหมึกตัวเดียวที่วางบนพื้นสว่างหรือ
// พื้นแดงตันได้ — 16.9:1 บน #e9eef4 และห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง) ส่วนป้ายขวา
// เป็นแผ่นมืดทึบ ไล่แดงลึก #8a0206 → ผิวจม #0d0304 ในกรอบแดงแบรนด์ #fb131b บนไอคอน
// แดงสว่าง #ff4d55 — สองป้ายจึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และตรงกับโลโก้ที่
// ตัวอักษรแดงวางคู่ตัวเลขเงินโครเมียมวาว
// สองครึ่งตกลงไปที่ผิวจม #0d0304 ครึ่งซ้ายเป็นกรอบแดงแบรนด์ ครึ่งขวาเป็นกรอบเงิน
// โครเมียมหม่น ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นเงินโครเมียมสว่างโปร่ง
// หัวข้อไล่ เงินโครเมียมหม่น #aeb9c6 → เงินโครเมียมสว่าง #e9eef4 → แดงแบรนด์ #fb131b
// ซึ่งไม่ซ้ำลำดับกับกล่อง docx ใบอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #f2e4e5 (= BRAND_TEXT) — 14.5:1 บนผิวยก และ 16.8:1 บนผิวจมของสองครึ่ง
// §2 ห้าม #fb131b #c40304 #8a0206 #53050a ถือตัวอักษรทุกขนาด — ที่นี่อยู่ที่ขอบ
// ไล่เฉดของแผ่นมืด และออราเท่านั้น และ #ff8a8f สงวนไว้ให้ <strong> ในย่อหน้า จึงไม่
// โผล่ในไฟล์นี้เลย
//
// ⚠️ **กับดักรอบนี้คือแดง** — โค้ดเบสนี้มีแบรนด์แดงมาก่อนสามเจ้า ให้เทียบเป็นค่า ไม่ใช่
// ตระกูลสี: SUPERSLOTCLUB #e8232a (R=232 G=35 B=42) · PIGPG #d4200d (R=212 G=32 B=13)
// · FLASH877 #ff3b14 (R=255 G=59 B=20) ไม่มีตัวไหนเป็น #fb131b (R=251 G=19 B=27)
// ชุดม่วงราชา-ทองของ KMD88 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#7505cc #b453ff #c07cff #d9b8ff
// #3a0565 #2c0349 #7a5a0a #e2b33f #ffdf8c #ece2f8 #1a0526 #1d0832 #140522 #0a0213)
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec
// #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f #04186e #021026) ชุดชมพูฮอตพิงก์-
// ทองของ PUNPRO168 (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a1038
// #2a0012 #1c0014 #ffc554) ชุดทองมังกรของ TND168 (#dfa310 #ffc93d #ffe4a3 #c9b88e
// #f0e9dc #8a5c09 #43240b) ชุดทองอำพันเสือของ TIGERWIN369 (#d98324 #f7b733 #ffd98a
// #f7e4c0 #e3cfae #8a5214 #4a2a08 #1a0d02 #2d1c0a) ชุดทองแชมเปี้ยน-เงินโครเมียมของ
// UFA324 (#e5a81b #b9c2cc #231c0e #17130a #0d0b06 #f0e8d4 #ffe08a #7d5a07 #464f5a
// #f2f5f9) และชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75
// #c98a05 #1e0a3c #d2a6ff #c9b2e8 #0a0117) ออกครบทุกจุดแล้ว
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fb131b]/40 bg-[#2a0d0f]/95 p-6 text-[#f2e4e5] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb131b]/80 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e9eef4] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fb131b]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4d55] via-[#fb131b] to-[#53050a] shadow-[0_0_10px_rgba(251,19,27,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#aeb9c6] via-[#e9eef4] to-[#fb131b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fb131b]/35 bg-[#0d0304]/95 p-6 text-left text-base leading-relaxed text-[#f2e4e5] transition-all duration-300 hover:-translate-y-2 hover:border-[#fb131b]/80 hover:bg-[#2a0d0f] hover:shadow-[0_15px_40px_rgba(251,19,27,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#aeb9c6]/60 bg-gradient-to-br from-[#e9eef4] to-[#aeb9c6] text-2xl text-[#1a0304] shadow-[0_5px_15px_rgba(233,238,244,0.25)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#aeb9c6]/35 bg-[#0d0304]/95 p-6 text-left text-base leading-relaxed text-[#f2e4e5] transition-all duration-300 hover:-translate-y-2 hover:border-[#aeb9c6]/70 hover:bg-[#2a0d0f] hover:shadow-[0_15px_40px_rgba(233,238,244,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fb131b]/70 bg-gradient-to-br from-[#8a0206] to-[#0d0304] text-2xl text-[#ff4d55] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#fb131b]/35 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
