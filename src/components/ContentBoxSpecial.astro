---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💌", iconright = "🔎" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected. รอบนี้หน้าแรกไม่ส่ง `actions`
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §7**
// ("แอดมิน <แบรนด์> ออนไลน์ตลอด 24ชม." — content.txt บรรทัด 21) พร้อมย่อหน้า
// ของมัน (บรรทัด 22) แบ่งครึ่งโดยไม่ตกประโยคไหน: ซีกซ้ายคือ **เรื่องที่สอบถาม
// เจ้าหน้าที่ได้ และการตรวจช่องทางจากเว็บไซต์ทางการเพื่อเลี่ยงบัญชีแอบอ้าง**
// ซีกขวาคือ **สิ่งที่ต้องทำเมื่อพบปัญหาบัญชีสมาชิกหรือธุรกรรม** (เก็บหมายเลข
// รายการและหลักฐาน แจ้งรายละเอียดให้ชัดเจน ไม่เปิดเผยรหัสผ่านหรือรหัส OTP และ
// ตรวจเวลาให้บริการจริงจากประกาศล่าสุด) หน้าแรกส่งไอคอน 💬 / 🛡️ ซึ่งทั้งคู่อยู่ใน
// กล่อง aria-hidden จึงไม่เคยเป็นส่วนหนึ่งของ accessible name
// 🚨 **ไม่มี BankStrip บนหน้าแรกรอบนี้ และ BankStrip ห้าม render ที่ไหนทั้งสิ้น** —
// บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว แถบโลโก้ธนาคาร
// คือการอ้างว่ารองรับเจ้าเหล่านั้นจริง ซึ่งไม่มีอยู่ในบรีฟ
// (**ไฟล์ BankStrip.astro ยังอยู่ครบในฐานะ inventory — ห้ามลบ**)
//
// ⚠️ เขียนชื่อคลาสสีในคอมเมนต์แบบไม่เต็มรูปโดยตั้งใจ — Tailwind สแกนคอมเมนต์ด้วย
//
// ───────────────────────────────────────────────────────────────────────────
// TEVA69 (ดรอป 2026-10-28) — พาเลตตาม .claude/brand-spec-teva69.md §2
// **เขียวป่านำ · เขียวสด/ทองอำพันเป็นเครื่องประดับ · เนื้อหาบนธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **ไวโอเลตนีออนของ ZANE96** ทั้งใบ จึงรีเธม
// ทั้งไฟล์ พื้นเพจ #f0ffeb (bg.json) = ขาวอมมิ้นต์จาง **ห้ามแก้กลับไปเป็นพื้นมืด
// และห้ามเหลือม่วง/แมเจนต้า/ฟ้าไว้เลยสักค่า**
// ลำดับผิว: #e6f7df ยก (แผ่นไอคอนซ้าย) · **#d7f0cd wash (การ์ดครอบ)** ·
// **#ffffff การ์ด (สองซีก)** · #f0ffeb พื้นเพจ
// ⚠️⚠️ **สองซีกตั้งใจอยู่ที่ผิวการ์ดขาว #ffffff ไม่ใช่ผิวยก #e6f7df** เพราะ <strong>
// ของหน้าเพจเป็น **#116018** ซึ่งได้ **7.8:1 บนขาว** ซึ่งเป็นค่าที่สูงที่สุดที่มี
// — และซีกขาวบนการ์ด wash ยังให้ "การ์ดซ้อนการ์ด" ที่อ่านออกโดยไม่ต้องพึ่งเงา
// **ห้ามสลับสองผิวนี้กัน**
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ผิว wash ครอบ
// สองซีกที่ลอยขึ้นมาอยู่ผิวการ์ดขาว
// ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่บน-ล่าง** (border-y) ไม่ใช่ขีดใต้
// แท่งตั้ง แผ่นถม หรือเส้นคาดเต็มความกว้างแบบใบอื่น และเป็น **เขียวป่า #116018
// ทึบสีเดียว ไม่ไล่เฉด** (~7.2:1 บนผิว wash #d7f0cd)
// สองแผ่นไอคอนเป็น **ขั้วกลับของกันเอง**: ซ้ายเป็น **แผ่นผิวยก** ไล่ #e6f7df →
// #ffffff ในกรอบ #b2dba3 บนหมึก **#10280f** (เงียบ เป็นผิว ไม่ใช่สีนำ) ส่วนขวาเป็น
// **แผ่นถมทึบ** ไล่ #0b4a12 → #116018 → #1a7d24 ในกรอบ #10280f บนหมึก **ขาว**
// ซึ่งเป็นสูตร "CTA หลัก" ของ §2 ตรง ๆ (10.5:1 / 7.8:1 / 5.3:1 — ผ่าน AA ทุก stop)
// ⚠️⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #28c437 #e3bb45 #c6cfd2 หรือ #f0ffeb แล้ววาง
// หมึกขาว (2.3 / 2.0 / — / 1.07:1)** — §2 ระบุไว้ตรง ๆ
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบ #b2dba3 ซีกขวากรอบเส้นเข้ม #3f7a2e
// เส้นคาดหัวการ์ดเป็นเขียวสด #28c437 โปร่ง (**พื้นถม ไม่ใช่ตัวอักษร**)
// เนื้อความ #10280f (= BRAND_TEXT) — ~14.6:1 บนผิว wash และ 15.8:1 บนผิวการ์ดขาว
// ⚠️ §2 ห้าม **#28c437 #e3bb45 #c6cfd2 #f0ffeb #d7f0cd #e6f7df #b2dba3 #ffffff**
// ถือตัวอักษรบนผิวสว่าง · **#3f7a2e เป็นเส้น/ขอบเท่านั้น** ·
// **#116018 ใช้ทั้งหัวข้อที่นี่และ <strong> ในเนื้อความ** ซึ่งเป็นงานของหน้าเพจ
// rgba() ที่อนุญาตรอบนี้: rgba(17,96,24,α) · rgba(11,74,18,α) · rgba(26,125,36,α) ·
// rgba(40,196,55,α) · rgba(16,40,15,α) · rgba(227,187,69,α) · rgba(11,42,18,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — อาร์ตเวิร์กรอบนี้เป็น **เวิร์ดมาร์ก
// เงินโครเมียม + เขียวมรกต** และ **เขียวเคยเป็นฮิวนำของแบรนด์เก่ามาแล้วหลายเจ้า**
// → **"เจอเขียว ≠ เป็นของรอบนี้"** สีของรอบนี้คือ **#116018 / #0b4a12 / #1a7d24 /
// #28c437 / #3f7a2e / #b2dba3 / #8a6a0e / #e3bb45 / #c6cfd2 / #10280f / #3c5b36 /
// #ffffff / #e6f7df / #d7f0cd / #f0ffeb** เท่านั้น ค่าที่ต้องไม่เหลือในไฟล์นี้
// (เขียนแบบไม่มี # โดยตั้งใจ):
//   **ZANE96 (ชุดที่เพิ่งอยู่ทั้งใบนี้ — เสี่ยงหลงเหลือสูงสุดในไฟล์)** — 7a1bd6
//     2b3fd9 c2178b f23bb4 bb6dff 7aa7ff 5411c4 241046 6b4a86 f8e6f9 f6edfe ece0fb
//     dcc6f4 9a6fd0 190b3d 271257 100626 5b2f9e f3e8ff c0a6e8 8e14b8 2f1766
//     + rgba 122/27/214, rgba 84/17/196, rgba 194/23/139, rgba 242/59/180,
//     rgba 187/109/255, rgba 36/16/70, rgba 220/198/244
//     ⚠️⚠️ **5411c4 เคยเป็นสีหัวข้อของใบนี้ตรง ๆ และ c2178b → 5411c4 เคยเป็น
//     แผ่นถมของไอคอนขวา — ทั้งชุดต้องไม่เหลือ**
//   **LOTTO189 (แบรนด์ขาออกทันที)** — fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f
//     6e3b44 b00718 c1071b 8a0412 8f6310 d61023 ff2436 e9b53c 24060c 3d0d16 120307
//     7e1221 ffeaea f0bcbc c3ccd6
//     ⚠️⚠️ **e9b53c ↔ e3bb45 · c3ccd6 ↔ c6cfd2 · 8f6310 ↔ 8a6a0e**
//   **เขียวของแบรนด์อื่น (ตระกูลเดียวกับฮิวนำของรอบนี้ ต้องเทียบแน่นที่สุด)** —
//     8ce023 e9f7d6 bde397 1a5c04 2f8c07 051400 0f2e05 06220a a87a08 f2c230 ffe066
//     (KINGKONG555) · 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168) · 1fae1c 0d2312
//     143a1c 07130a e8e4c6 (888PARUAY) · 117a41 2bb061 2fbf6a (MEXICANOSLOT/KOON234)
//     ⚠️⚠️ **e9f7d6 ↔ e6f7df · bde397 ↔ b2dba3 · 1a5c04 ↔ 1a7d24 · 0b7d28 ↔ 0b4a12 ·
//     2bb061 ↔ 28c437 · a87a08 ↔ 8a6a0e — เจอที่ไหนให้ถือว่าพิมพ์ผิดก่อนเสมอ**
//   **ZNOVA168** — 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784 fffbf0 fff4e0
//     ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 fde90b e8a000
//     ff8a2b d8dde6 8f9aa8 6a4a30
//   **MEXICANOSLOT** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08 3f130d 80453a
//     2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4 e2855c fde4d3
//     fff3ea fef6fb f2543f
//   **okkub88** — ffd6fa fff4fb ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b
//     9c0f55 fb439b fc74b5 ffc2e2 d91a73 b01160 85094a · **หมูบิน168** — fa539c
//     c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26
//   **โบ๊ะบ๊ะ168** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff
//     f0faff e4f6fb · **มาดาม168** — ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8
//     16234a 0b1733 050e26 00091f f4eef1 d9dfe9 b3bdd6
//   **นาซ่า168** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722 ·
//     **ร่ำรวย168** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff f4e4d3 e4cbb3
//   **เงินทอง168** — f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 · **KMD88/CEO66** — 7505cc
//     b453ff c07cff d9b8ff 3a0565 7e22ce d946ef a855f7
//   **ค่า default ของ variant cyber-neon/dark** — 00f3ff e0ffff 60a5fa 4b5563
//     030712 1f2937
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีแดง ไม่มีชมพู/แมเจนต้า ไม่มีฟ้า/ไซแอน ไม่มีส้ม
// ไม่มีน้ำตาล และไม่มีครีม/เบจ/พีช** — วัสดุที่สองรอบนี้คือ **เงินโครเมียม #c6cfd2
// (ใช้บนโครมเข้มเท่านั้น ไม่อยู่ในไฟล์นี้) กับทองอำพัน #e3bb45 ที่เป็นเครื่องประดับ**
// และสูทขาว ห้องสีขาวครีม ชิปคาสิโนเขียวเข้ม มงกุฎทองดวงเล็ก ต้นไม้ในกระถาง
// ในอาร์ตเวิร์กเป็น **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#b2dba3] bg-[#d7f0cd] p-6 text-[#10280f] shadow-[0_10px_30px_rgba(17,96,24,0.13)] transition-all duration-500 hover:border-[#3f7a2e] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#28c437] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#b2dba3] py-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#116018]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#b2dba3] bg-white p-6 text-left text-base leading-relaxed text-[#10280f] transition-all duration-300 hover:-translate-y-2 hover:border-[#3f7a2e] hover:shadow-[0_15px_40px_rgba(26,125,36,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b2dba3] bg-gradient-to-br from-[#e6f7df] to-white text-2xl text-[#10280f] shadow-[0_5px_15px_rgba(17,96,24,0.18)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#3f7a2e] bg-white p-6 text-left text-base leading-relaxed text-[#10280f] transition-all duration-300 hover:-translate-y-2 hover:border-[#116018] hover:shadow-[0_15px_40px_rgba(17,96,24,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#10280f] bg-gradient-to-br from-[#0b4a12] via-[#116018] to-[#1a7d24] text-2xl text-white shadow-[0_5px_15px_rgba(11,74,18,0.45)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#b2dba3] pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
