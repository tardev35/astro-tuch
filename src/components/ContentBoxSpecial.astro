---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1e7bf5]/40 bg-[#01030d]/92 p-6 text-[#d6e2f5] shadow-[0_10px_30px_rgba(30,123,245,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#6fb4ff]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#1e7bf5] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1e7bf5]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#6fb4ff] to-[#0a3fa8] shadow-[0_0_10px_rgba(30,123,245,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1e7bf5]/40 bg-[#060c1c]/95 p-6 text-left text-base leading-relaxed text-[#d6e2f5] transition-all duration-300 hover:-translate-y-2 hover:border-[#6fb4ff]/75 hover:bg-[#0d1730] hover:shadow-[0_15px_40px_rgba(30,123,245,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#1e7bf5]/55 bg-gradient-to-br from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] text-2xl shadow-[0_5px_15px_rgba(30,123,245,0.3)]">
          📝
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#cfd8e6]/35 bg-[#060c1c]/95 p-6 text-left text-base leading-relaxed text-[#d6e2f5] transition-all duration-300 hover:-translate-y-2 hover:border-[#cfd8e6]/60 hover:bg-[#0d1730] hover:shadow-[0_15px_40px_rgba(207,216,230,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cfd8e6]/60 bg-gradient-to-br from-[#f4f8ff] via-[#cfd8e6] to-[#7f8ea3] text-2xl shadow-[0_5px_15px_rgba(207,216,230,0.28)]">
          🔍
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
