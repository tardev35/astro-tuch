---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The left icon plate is gold and the right one brushed silver — the same
// two-tone split the MEPAY77 wordmark uses, applied to the pair of halves.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a3701c]/40 bg-[#1b1206]/92 p-6 text-[#f1e5cd] shadow-[0_10px_30px_rgba(163,112,28,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#cdb98a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f2ae35] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a3701c]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] via-[#dfe3e8] to-[#5c3a08] shadow-[0_0_10px_rgba(242,174,53,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdcc5c] via-[#fff6e0] to-[#dfe3e8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#a3701c]/40 bg-[#130c01]/95 p-6 text-left text-base leading-relaxed text-[#f1e5cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#fdcc5c]/70 hover:bg-[#241503] hover:shadow-[0_15px_40px_rgba(253,204,92,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f2ae35]/55 bg-gradient-to-br from-[#fff6e0] via-[#f2ae35] to-[#7a4f0b] text-2xl shadow-[0_5px_15px_rgba(242,174,53,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#a3701c]/45 bg-[#130c01]/95 p-6 text-left text-base leading-relaxed text-[#f1e5cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#dfe3e8]/70 hover:bg-[#241503] hover:shadow-[0_15px_40px_rgba(223,227,232,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#aab0b8]/60 bg-gradient-to-br from-[#dfe3e8] via-[#aab0b8] to-[#5c3a08] text-2xl shadow-[0_5px_15px_rgba(223,227,232,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
