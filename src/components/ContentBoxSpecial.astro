---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💳", iconright = "🛡️" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// These two wrappers are also the documented exception to the flattening sweep:
// they do real layout beside the icon box and cannot be hoisted away.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On this brand's homepage it holds docx H2 #6,
// the ฝากถอนง่าย จ่ายตรง ไม่มีขั้นต่ำ pair: the left paragraph is the transaction
// system itself (ยอดเงิน · ช่องทางชำระเงิน · สถานะรายการ · ชื่อบัญชีผู้รับเงิน) and
// the right one is the brief's own caveat that จ่ายตรง / ไม่บิดยูส / ไม่มีขั้นต่ำ /
// ไม่ผ่านบัญชีม้า ควรมีข้อมูลที่ตรวจสอบได้รองรับ เพราะไม่มีระบบธุรกรรมใดรับประกัน
// ความปลอดภัยได้ทั้งหมด
//
// Default icons are 💳 / 🛡️ — a payment channel and a safeguard, which is exactly
// what those two paragraphs are about. Both render inside an aria-hidden box, so
// neither is ever part of an accessible name.
//
// รอบนี้ (2026-10-11, brand-spec §2): สองครึ่งบนการ์ดกระจกผิวกลาง #17130a ซึ่งสว่าง
// กว่าพื้นเพจ **ดำสนิท #000000** การ์ดจึงลอย ⚠️ รอบนี้ไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// แบรนด์มีสองฮิวจริง — ทองแชมเปี้ยนนำ เงินโครเมียม (เลข 324 บนโลโก้) เป็นฮิวที่สอง —
// สองป้ายไอคอนจึงแยกกันด้วย "แผ่นทองสว่าง vs แผ่นมืดกรอบเงิน" ไม่ใช่ด้วยระดับความ
// สว่างของโลหะเดียว: ป้ายซ้ายเป็นแผ่นทองทึบ ไล่งาช้าง #f0e8d4 → ทองสว่าง #ffe08a →
// ทองแบรนด์ #e5a81b บนหมึกดำอมทอง #140d01 (9.8:1 ที่ปลายเข้มสุด — §2 ห้ามพลิกแผ่น
// ทองไปใช้หมึกสว่าง และห้ามไล่ลงไปถึง #7d5a07 ใต้ตัวอักษร) ส่วนป้ายขวาเป็นแผ่นมืดทึบ
// ไล่ทองดำ #43300a → ผิวจม #0d0b06 ในกรอบเงินแบรนด์ #b9c2cc บนไอคอนเงินสว่าง
// #f2f5f9 — สองป้ายจึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และตรงกับโลโก้ที่ตัวอักษร
// ทองวางคู่เลขเงินโครเมียมบนแผ่นวงแหวนทอง
// สองครึ่งตกลงไปที่ผิวจม #0d0b06 ครึ่งซ้ายเป็นกรอบทองแบรนด์ ครึ่งขวาเป็นกรอบเงินแบรนด์
// ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองแบรนด์โปร่ง
// หัวข้อไล่เงินแบรนด์ #b9c2cc → ทองสว่าง #ffe08a → ทองแบรนด์ #e5a81b ซึ่งไม่ซ้ำลำดับ
// กับกล่องอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #f0e8d4 (= BRAND_TEXT) — 15.3:1 บนผิวกลาง และ 17.0:1 บนผิวจมของสองครึ่ง
//
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง ให้เทียบเป็นค่า ไม่ใช่ตระกูลสี: ชุดชมพูฮอต-ทองบน
// พลัมดำของแบรนด์รอบก่อนหน้าทันที (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d
// #9c6f08 #b3006a #7a0046 #4d002b #2b0019 #4a0b42 #3a0534 #2e002c #210220) ชุดทอง
// เป็ด-ส้มอำพันที่เคยค้างในไฟล์นี้ (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a
// #ffc98a #a3510c #1a1203 #f6ecd9 #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียม
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03
// #382400 #241700 #231500) ชุดทองสายฟ้า-แดงเลือดนก (#f5c518 #ffdd73 #b8860f #ff3b14
// #8c0f0a) ชุดเขียวป่า-ทองมงกุฎ (#8ce023 #f2c230 #ffe066 #a87a08 #051400) และชุด
// ม่วงนีออน-ทอง (#a435f0 #fbe455 #efe6ff #ffd23d #5b1a75 #c98a05 #1e0a3c) ออกครบ
// ทุกจุดแล้ว — ⚠️ "มีทองอยู่แล้ว" และ "มีเงินอยู่แล้ว" ไม่พิสูจน์อะไร ทองรอบนี้คือ
// #e5a81b และเงินรอบนี้คือ #b9c2cc ไม่ใช่ #cfd6e3
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e5a81b]/35 bg-[#17130a]/95 p-6 text-[#f0e8d4] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e5a81b]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e5a81b] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e5a81b]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#e5a81b] to-[#464f5a] shadow-[0_0_10px_rgba(229,168,27,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#b9c2cc] via-[#ffe08a] to-[#e5a81b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#e5a81b]/30 bg-[#0d0b06]/95 p-6 text-left text-base leading-relaxed text-[#f0e8d4] transition-all duration-300 hover:-translate-y-2 hover:border-[#e5a81b]/75 hover:bg-[#231c0e] hover:shadow-[0_15px_40px_rgba(229,168,27,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7d5a07] bg-gradient-to-br from-[#f0e8d4] via-[#ffe08a] to-[#e5a81b] text-2xl text-[#140d01] shadow-[0_5px_15px_rgba(229,168,27,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#b9c2cc]/40 bg-[#0d0b06]/95 p-6 text-left text-base leading-relaxed text-[#f0e8d4] transition-all duration-300 hover:-translate-y-2 hover:border-[#b9c2cc]/75 hover:bg-[#231c0e] hover:shadow-[0_15px_40px_rgba(185,194,204,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b9c2cc]/60 bg-gradient-to-br from-[#43300a] to-[#0d0b06] text-2xl text-[#f2f5f9] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#e5a81b]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
