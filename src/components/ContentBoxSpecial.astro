---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7e22ce]/55 bg-[#150724]/92 p-6 text-[#f2e3f7] shadow-[0_10px_30px_rgba(244,114,182,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#f472b6]/60 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f472b6] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7e22ce]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] to-[#4c1d6b] shadow-[0_0_10px_rgba(244,114,182,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf2f8] via-[#f9a8d4] to-[#fcd34d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7e22ce]/50 bg-[#1e0a30]/95 p-6 text-left text-base leading-relaxed text-[#f2e3f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#f472b6]/60 hover:bg-[#35134f]/90 hover:shadow-[0_15px_40px_rgba(244,114,182,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f472b6]/45 bg-gradient-to-br from-[#ec4899] via-[#f472b6] to-[#4c1d6b] text-2xl shadow-[0_5px_15px_rgba(244,114,182,0.28)]">
          🎴
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fcd34d]/40 bg-[#1e0a30]/95 p-6 text-left text-base leading-relaxed text-[#f2e3f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#fcd34d]/60 hover:bg-[#2a1d0d]/90 hover:shadow-[0_15px_40px_rgba(252,211,77,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fcd34d]/50 bg-gradient-to-br from-[#fef3c7] via-[#fcd34d] to-[#a16207] text-2xl shadow-[0_5px_15px_rgba(252,211,77,0.3)]">
          🛡️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
