---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The left icon plate is metallic gold and the right one phoenix crimson — the
// same two-tone split the VAK88 logo uses (a gold wordmark under a crimson-and-
// gold phoenix), applied to the pair of halves.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e6b23c]/35 bg-[#0b1020]/92 p-6 text-[#ded8ca] shadow-[0_10px_30px_rgba(230,178,60,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd873]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e6b23c] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e6b23c]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd873] via-[#e6b23c] to-[#cf2027] shadow-[0_0_10px_rgba(230,178,60,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd873] via-[#fff4dd] to-[#cf2027] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#e6b23c]/35 bg-[#04060e]/95 p-6 text-left text-base leading-relaxed text-[#ded8ca] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd873]/70 hover:bg-[#121a2e] hover:shadow-[0_15px_40px_rgba(230,178,60,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e6b23c]/55 bg-gradient-to-br from-[#ffd873] via-[#e6b23c] to-[#8a5f14] text-2xl shadow-[0_5px_15px_rgba(230,178,60,0.30)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#cf2027]/45 bg-[#04060e]/95 p-6 text-left text-base leading-relaxed text-[#ded8ca] transition-all duration-300 hover:-translate-y-2 hover:border-[#ee3a34]/70 hover:bg-[#121a2e] hover:shadow-[0_15px_40px_rgba(207,32,39,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ee3a34]/60 bg-gradient-to-br from-[#ee3a34] via-[#cf2027] to-[#6b0d11] text-2xl shadow-[0_5px_15px_rgba(207,32,39,0.28)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
