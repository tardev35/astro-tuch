---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6a5115]/70 bg-[#050301]/92 p-6 text-[#f0e2bd] shadow-[0_10px_30px_rgba(204,156,45,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#cc9c2d]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e8bf4e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6a5115]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fae27c] to-[#6a5115] shadow-[0_0_10px_rgba(250,226,124,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#6a5115]/65 bg-[#120c04]/95 p-6 text-left text-base leading-relaxed text-[#f0e2bd] transition-all duration-300 hover:-translate-y-2 hover:border-[#cc9c2d]/75 hover:bg-[#1d1407] hover:shadow-[0_15px_40px_rgba(204,156,45,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cc9c2d]/50 bg-gradient-to-br from-[#fae27c] via-[#cc9c2d] to-[#6a5115] text-2xl shadow-[0_5px_15px_rgba(204,156,45,0.3)]">
          🎁
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#b9a67d]/45 bg-[#120c04]/95 p-6 text-left text-base leading-relaxed text-[#f0e2bd] transition-all duration-300 hover:-translate-y-2 hover:border-[#e8bf4e]/65 hover:bg-[#1d1407] hover:shadow-[0_15px_40px_rgba(232,191,78,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e8bf4e]/55 bg-gradient-to-br from-[#fff6d4] via-[#e8bf4e] to-[#6a5115] text-2xl shadow-[0_5px_15px_rgba(232,191,78,0.32)]">
          ⚖️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
