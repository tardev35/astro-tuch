---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// `actions` is a THIRD slot, added 2026-10-07, and it sits below the grid at full
// width rather than inside either half — a call-to-action pair that belongs to
// the whole section, not to one of its two paragraphs. It renders nothing at all
// when the page does not pass it, so every other caller is unaffected. It is NOT
// a slot wrapper being re-added: the two halves are untouched.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two. It is also the only box in
// the library with an `actions` slot, which is why it is the one deliberate
// carry-over from the previous round (brand-spec §3): docx H2 #7's
// LINE + สมัครสมาชิก button row needs exactly that slot.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): สองครึ่งบนการ์ด
// กระจกผิวยก #0b231b แบรนด์นี้มีสองวัสดุจริง (logo.webp คือคำว่า BOOM เขียวนีออน
// #42fb5a ติดกับตัวเลข 369 เงินแปรง #dadcdc ในวงแหวนเขียวอมเทอร์ควอยซ์) สองป้าย
// ไอคอนจึงแยกกันด้วยคู่วัสดุนั้น ไม่ใช่ระดับความสว่างของสีเดียว และแต่ละป้ายใช้หมึก
// คนละขั้วตามกฎคอนทราสต์ §2 — ป้ายซ้ายเป็นปุ่มหลัก พื้นไล่เขียวนีออน #42fb5a →
// เขียวแบรนด์ #04ab3a → เขียวลึก #036b26 และใช้หมึกเขียวดำ #03150a (14.1:1 และเป็น
// สีตัวอักษรเดียวที่อนุญาตบนพื้น #42fb5a) ส่วนป้ายขวาเป็นปุ่มรอง พื้นไล่ผิวยก #0b231b
// → ผิวลึกสุด #041109 ขอบเขียวนีออนโปร่ง และใช้หมึกเนื้อความ #cfe9d7
// สองครึ่งตกลงไปที่ผิวลึกสุด #041109 กรอบและเส้นไรผมเป็นเขียวนีออนโปร่ง
// หัวข้อไล่เขียวนีออน #42fb5a → ทอง #f3c44a → เงินโครเมียม #dadcdc คือนีออน-ทอง-เงิน
// ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักตัว เนื้อความ #cfe9d7 (= BRAND_TEXT)
//
// ชุดฟ้า-ทองบนการ์ดสว่างของ HI59 ที่เคยค้างในไฟล์นี้ (#f6fbff #e7f2fd #9ecbf2
// #0a84e0 #065a9c #044b80 #033f70 #06355f #fdbc04 #ffe27a #c88a02 #04203f
// #eaf5ff #0d2744 rgba(6,53,95,…) rgba(10,132,224,…) rgba(200,138,2,…))
// ออกครบทุกจุดแล้ว — รอบนี้เป็นการพลิกขั้วกลับจากการ์ดสว่างเป็นการ์ดมืด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#42fb5a]/30 bg-[#0b231b]/95 p-6 text-[#cfe9d7] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#42fb5a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#42fb5a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#42fb5a]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#42fb5a] via-[#04ab3a] to-[#036b26] shadow-[0_0_10px_rgba(66,251,90,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#42fb5a] via-[#f3c44a] to-[#dadcdc] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#42fb5a]/25 bg-[#041109]/95 p-6 text-left text-base leading-relaxed text-[#cfe9d7] transition-all duration-300 hover:-translate-y-2 hover:border-[#42fb5a]/70 hover:bg-[#07170f] hover:shadow-[0_15px_40px_rgba(66,251,90,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#036b26] bg-gradient-to-br from-[#42fb5a] via-[#04ab3a] to-[#036b26] text-2xl text-[#03150a] shadow-[0_5px_15px_rgba(66,251,90,0.45)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#42fb5a]/25 bg-[#041109]/95 p-6 text-left text-base leading-relaxed text-[#cfe9d7] transition-all duration-300 hover:-translate-y-2 hover:border-[#dadcdc]/60 hover:bg-[#07170f] hover:shadow-[0_15px_40px_rgba(218,220,220,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#42fb5a]/60 bg-gradient-to-br from-[#0b231b] to-[#041109] text-2xl text-[#cfe9d7] shadow-[0_0_12px_rgba(66,251,90,0.25)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#42fb5a]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
