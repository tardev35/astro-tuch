---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): สองครึ่งบนการ์ดดำอมแดง #140203 แบรนด์นี้มีสองสี
// จริง (logo.webp เป็นคำว่า หวย สีแดงสด vivid #dc0203 #e00104 #e2020a คู่กับเลข 365 บน
// พื้นดำ #020202 ส่วนทองมาจากตัวอักษรบนแบนเนอร์และเหรียญทองในงานอาร์ต) สองป้ายไอคอนจึง
// แยกกันด้วย "สองสีของแบรนด์" ไม่ใช่ระดับความสว่างของสีเดียว — ป้ายซ้ายเป็นฝั่งทอง ไล่
// ทองอ่อน #ffeab0 → ทองแบรนด์ #ffc93c → ทองลึก #c08a07 ตัวอักษรบนป้ายนี้ใช้หมึกบนพื้นทอง
// #1a0303 ตามกฎพาเลตต์ (6.4:1 บนปลายไล่เฉดที่เข้มสุดคือ #c08a07 ซึ่งเป็นเหตุผลที่ห้าม
// ไล่จบเข้มกว่านี้) ส่วนป้ายขวาเป็นฝั่งแดง ไล่แดงสว่าง #f5282a → แดงแบรนด์ #dc0203 →
// แดงลึก #8c0402 และใช้ตัวอักษร "ขาว" ไม่ใช่หมึกเข้ม เพราะหมึก #1a0303 บนแดงแบรนด์ได้
// แค่ 2.8:1 (ตก) ส่วนขาวบนแดงแบรนด์ได้ ~5.1:1 (ผ่าน) คู่นี้จึงอ่านเป็นทองนำ แดงตาม
// ตามงานอาร์ตจริง กรอบและเส้นไรผมเป็นทองลึก #c08a07 แถวในตกลงไปที่พื้นลึกสุด #140203
// บนการ์ดพื้น #240406 เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #8a5f12 #140c02
// #0a0501 #241404 #1a1000 #f3e8cf) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c08a07] bg-[#240406]/92 p-6 text-[#f6e7e0] shadow-[0_10px_30px_rgba(8,1,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc93c]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ffc93c] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c08a07] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeab0] via-[#ffc93c] to-[#c08a07] shadow-[0_0_10px_rgba(255,201,60,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#f5282a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c08a07] bg-[#140203]/95 p-6 text-left text-base leading-relaxed text-[#f6e7e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffc93c]/70 hover:bg-[#240406] hover:shadow-[0_15px_40px_rgba(255,201,60,0.30)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffc93c]/65 bg-gradient-to-br from-[#ffeab0] via-[#ffc93c] to-[#c08a07] text-2xl text-[#1a0303] shadow-[0_5px_15px_rgba(255,201,60,0.40)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#c08a07] bg-[#140203]/95 p-6 text-left text-base leading-relaxed text-[#f6e7e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#dc0203]/80 hover:bg-[#240406] hover:shadow-[0_15px_40px_rgba(220,2,3,0.35)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5282a]/70 bg-gradient-to-br from-[#f5282a] via-[#dc0203] to-[#8c0402] text-2xl text-white shadow-[0_5px_15px_rgba(220,2,3,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
