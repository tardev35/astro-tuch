---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose body is a single paragraph plus a call to action.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): สองครึ่งบนการ์ดแดงเกือบดำ #2a0405 แยกกันด้วย
// คู่สีประจำเวิร์ดมาร์ก — ป้ายไอคอนซ้ายไล่จากทองอ่อน #fde68a ลงทองหลัก #fbbf24 ไปหา
// ทองลึก #a16207 (เหรียญทองที่ล้อมโลโก้) ส่วนป้ายขวาไล่จากแดงสว่าง #fc2b2c ลงแดง
// แบรนด์ #dc2626 ไปจบที่แดงลึก #b40102 (เลข 24 สีแดงกับลูกหวยแดง) คู่นี้จึงอ่านเป็น
// ทองนำ แดงตาม ตามงานอาร์ตจริง ไม่ใช่สีเดียวซ้ำสองครั้ง ตัวอักษรบนป้ายทองใช้หมึกเข้ม
// #2a0405 ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่างต้องเกือบดำ กรอบและเส้นไรผมเป็น
// แดงเข้ม #7f1d1d แถวในตกลงไปที่พื้นลึก #140202 เนื้อความ #f6e2e2 (BRAND_TEXT) —
// ชุดทอง-เขียวของ PGW44 (#fde90e #fff89a #f5c518 #a86f02 #35d413 #5df53a #0c6d10
// #1f5a16 #0b1408 #050803 #101a0b #10160a #e9f0dd) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7f1d1d]/70 bg-[#2a0405]/92 p-6 text-[#f6e2e2] shadow-[0_10px_30px_rgba(6,1,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fbbf24]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fbbf24] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7f1d1d]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] shadow-[0_0_10px_rgba(251,191,36,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7f1d1d]/70 bg-[#140202]/95 p-6 text-left text-base leading-relaxed text-[#f6e2e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#fbbf24]/70 hover:bg-[#3b0404] hover:shadow-[0_15px_40px_rgba(251,191,36,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fbbf24]/65 bg-gradient-to-br from-[#fde68a] via-[#fbbf24] to-[#a16207] text-2xl text-[#2a0405] shadow-[0_5px_15px_rgba(251,191,36,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#7f1d1d]/70 bg-[#140202]/95 p-6 text-left text-base leading-relaxed text-[#f6e2e2] transition-all duration-300 hover:-translate-y-2 hover:border-[#fc2b2c]/70 hover:bg-[#3b0404] hover:shadow-[0_15px_40px_rgba(220,38,38,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fc2b2c]/65 bg-gradient-to-br from-[#fc2b2c] via-[#dc2626] to-[#b40102] text-2xl text-[#fff1f1] shadow-[0_5px_15px_rgba(220,38,38,0.34)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
