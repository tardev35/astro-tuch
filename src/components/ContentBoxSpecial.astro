---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The left icon plate is emerald and the right one coin gold — the same two-tone
// split the UVO88 logo uses (a gold wordmark over a green poker chip), applied
// to the pair of halves.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0f9d47]/40 bg-[#051a0e]/92 p-6 text-[#c8e3d0] shadow-[0_10px_30px_rgba(15,157,71,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#57dd8f]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#0f9d47] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0f9d47]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#57dd8f] via-[#f2c230] to-[#116330] shadow-[0_0_10px_rgba(15,157,71,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#57dd8f] via-[#f3fbf5] to-[#f2c230] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#0f9d47]/40 bg-[#010905]/95 p-6 text-left text-base leading-relaxed text-[#c8e3d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#57dd8f]/70 hover:bg-[#0b2c17] hover:shadow-[0_15px_40px_rgba(87,221,143,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#0f9d47]/55 bg-gradient-to-br from-[#d9f7e3] via-[#0f9d47] to-[#116330] text-2xl shadow-[0_5px_15px_rgba(15,157,71,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#9c7d2b]/55 bg-[#010905]/95 p-6 text-left text-base leading-relaxed text-[#c8e3d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2c230]/70 hover:bg-[#0b2c17] hover:shadow-[0_15px_40px_rgba(242,194,48,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f2c230]/60 bg-gradient-to-br from-[#ffe08a] via-[#f2c230] to-[#9c7d2b] text-2xl shadow-[0_5px_15px_rgba(242,194,48,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
