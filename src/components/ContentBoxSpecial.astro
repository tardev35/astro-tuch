---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them. These
// two wrapper <div>s are the sanctioned kind that must stay — they are the flex
// siblings of the icon plate, not carriers of inheritable text classes.
//
// GODBET88 palette: one identity hue, metallic gold, on a near-black card. The
// two halves are told apart by brightness within that hue rather than by a
// second colour — the left icon plate runs primary gold (#c2a55c) down into the
// darkest brown-gold (#5c4418), the right one runs the sheen (#f6e7b8) down into
// primary, so the right half reads brighter without introducing a second
// colour. The previous brand's crimson and rose are gone.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c2a55c]/35 bg-[#0a0806]/92 p-6 text-[#ece1cc] shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6e7b8]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e2c87f] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c2a55c]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6e7b8] via-[#c2a55c] to-[#5c4418] shadow-[0_0_10px_rgba(194,165,92,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#9a7f3f]/50 bg-[#050403]/95 p-6 text-left text-base leading-relaxed text-[#ece1cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#c2a55c]/70 hover:bg-[#161208] hover:shadow-[0_15px_40px_rgba(194,165,92,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c2a55c]/60 bg-gradient-to-br from-[#e2c87f] via-[#c2a55c] to-[#5c4418] text-2xl shadow-[0_5px_15px_rgba(194,165,92,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f6e7b8]/30 bg-[#050403]/95 p-6 text-left text-base leading-relaxed text-[#ece1cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#f6e7b8]/60 hover:bg-[#161208] hover:shadow-[0_15px_40px_rgba(246,231,184,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f6e7b8]/60 bg-gradient-to-br from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] text-2xl shadow-[0_5px_15px_rgba(246,231,184,0.30)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
