---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// MAHAGAME66 palette (แดง-ดำ-เงินโครเมียม 2026-09-24): สองครึ่งบนการ์ดเกือบดำ
// #16090a แยกกันด้วยคู่สีประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากแดงสว่าง #ff4d52 ลงแดง
// แบรนด์ #de161d ไปหาแดงลึก #7a0a0e (คำว่า GAME ที่เป็นแดงสด) ส่วนป้ายขวาไล่จาก
// เงินโครเมียม #e2e8ef ลงเงินหม่น #9ba3ad ไปจบที่แดงลึก #7a0a0e (คำว่า MAHA และ
// เลข 66 ที่เป็นเงิน-ดำ) คู่นี้จึงอ่านเป็น แดงนำ เงินตาม ตามโลโก้จริง ไม่ใช่สีเดียว
// ซ้ำสองครั้ง — ทอง #e8b93f/#ffe9a3/#96671a พื้นน้ำตาล #171006/#0d0903/#2a1d0b
// ครีม #e3d8c0 และเงิน #eef3f8/#b6c1cd ของ SAGAME66 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7a0a0e]/55 bg-[#16090a]/92 p-6 text-[#e8e3e1] shadow-[0_10px_30px_rgba(8,5,6,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff4d52]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#de161d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7a0a0e]/50 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e2e8ef] via-[#ff4d52] to-[#de161d] shadow-[0_0_10px_rgba(222,22,29,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e2e8ef] via-[#ff4d52] to-[#de161d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7a0a0e]/55 bg-[#080506]/95 p-6 text-left text-base leading-relaxed text-[#e8e3e1] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff4d52]/70 hover:bg-[#26100f] hover:shadow-[0_15px_40px_rgba(222,22,29,0.42)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#de161d]/65 bg-gradient-to-br from-[#ff4d52] via-[#de161d] to-[#7a0a0e] text-2xl shadow-[0_5px_15px_rgba(222,22,29,0.45)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#26100f] bg-[#080506]/95 p-6 text-left text-base leading-relaxed text-[#e8e3e1] transition-all duration-300 hover:-translate-y-2 hover:border-[#e2e8ef]/55 hover:bg-[#26100f] hover:shadow-[0_15px_40px_rgba(226,232,239,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e2e8ef]/50 bg-gradient-to-br from-[#e2e8ef] via-[#9ba3ad] to-[#7a0a0e] text-2xl shadow-[0_5px_15px_rgba(226,232,239,0.28)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
