---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// PAOTUNG palette: the left icon plate is the logo's primary blue and the right
// one is gold metallic — the navy + gold pairing the brief names outright,
// applied to the pair of halves so they are told apart by hue and not only by
// position. The previous brand's crimson half is gone; this brand has no red.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#226ca9]/35 bg-[#04203c]/92 p-6 text-[#cfdeed] shadow-[0_10px_30px_rgba(2,15,30,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#3b9ddd]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e0bd72] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#226ca9]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5e3b3] via-[#e0bd72] to-[#054e83] shadow-[0_0_10px_rgba(224,189,114,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#3b9ddd] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#226ca9]/40 bg-[#020f1e]/95 p-6 text-left text-base leading-relaxed text-[#cfdeed] transition-all duration-300 hover:-translate-y-2 hover:border-[#3b9ddd]/70 hover:bg-[#0a2036] hover:shadow-[0_15px_40px_rgba(34,108,169,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#226ca9]/60 bg-gradient-to-br from-[#7fc4f0] via-[#3b9ddd] to-[#054e83] text-2xl shadow-[0_5px_15px_rgba(34,108,169,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#e0bd72]/40 bg-[#020f1e]/95 p-6 text-left text-base leading-relaxed text-[#cfdeed] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5e3b3]/70 hover:bg-[#0d2b47] hover:shadow-[0_15px_40px_rgba(224,189,114,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5e3b3]/60 bg-gradient-to-br from-[#f5e3b3] via-[#e0bd72] to-[#a5813a] text-2xl shadow-[0_5px_15px_rgba(224,189,114,0.30)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
