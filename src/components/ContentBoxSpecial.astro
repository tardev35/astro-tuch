---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them. They are two of the three sanctioned
// real-layout wrappers in the whole library.
//
// `actions` is a THIRD slot, added 2026-10-07, and it sits below the grid at full
// width rather than inside either half — a call-to-action pair that belongs to
// the whole section, not to one of its two paragraphs. It renders nothing at all
// when the page does not pass it, so every other caller is unaffected. It is NOT
// a slot wrapper being re-added: the two halves are untouched.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two. It is also the only box in
// the library with an `actions` slot, which is why it holds docx H2 #7 on the
// GUCCI168 homepage: that section is two paragraphs plus a
// LINE + สมัครสมาชิก button row, which is exactly this shape.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// สองครึ่งบนการ์ดกระจกผิวยก #1d0b08 แบรนด์นี้มีสองสีจริงอยู่บนโลโก้แล้ว (เทพเจ้าโชคลาภ
// สวมหมวกเขียวมรกตคาดแถบแดง ตัวอักษร GUCCI ขาวเงินขอบเขียวทับเลข 168 แดงเมทัลลิก)
// สองป้ายไอคอนจึงแยกกันด้วยคู่สีนั้น ไม่ใช่ระดับความสว่างของสีเดียว — ป้ายซ้ายเป็นปุ่ม
// หลัก พื้นไล่แดงสว่าง #e0201f → แดงแบรนด์ #c41115 → แดงลึก #7a0505 บนตัวอักษรขาว
// (ขาวบน #c41115 = 6.1:1 และบน #e0201f = 4.8:1 ซึ่งเป็นเพดานที่ §3 ห้ามดันให้สว่างกว่า)
// ส่วนป้ายขวาเป็นปุ่มรอง พื้นไล่เขียวมรกต #0b7a33 → เขียวลึก #063f1c บนตัวอักษรขาว
// (5.5:1) — ไม่ใช้พื้น #2bbf63 เพราะขาวบนนั้นได้แค่ 2.3:1 ซึ่ง §3 ห้ามไว้ตรงๆ
// สองครึ่งตกลงไปที่ผิวลึกสุด #090302 กรอบและเส้นไรผมบนขอบเป็นทองแบรนด์ #d9a521 โปร่ง
// หัวข้อไล่ทองแบรนด์ #d9a521 → ทองอ่อน #ffdf91 → เขียวสว่าง #2bbf63 คือทอง-ทอง-เขียว
// ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักตัว เนื้อความ #f6e3cf (= BRAND_TEXT)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #04ab3a #036b26
// #03150a #0b231b #041109 #07170f #f3c44a #cfe9d7 rgba(66,251,90,…)
// rgba(218,220,220,…)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d9a521]/35 bg-[#1d0b08]/95 p-6 text-[#f6e3cf] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9a521]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d9a521] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#d9a521]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e0201f] via-[#c41115] to-[#7a0505] shadow-[0_0_10px_rgba(196,17,21,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#d9a521] via-[#ffdf91] to-[#2bbf63] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c41115]/30 bg-[#090302]/95 p-6 text-left text-base leading-relaxed text-[#f6e3cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#c41115]/75 hover:bg-[#140705] hover:shadow-[0_15px_40px_rgba(196,17,21,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7a0505] bg-gradient-to-br from-[#e0201f] via-[#c41115] to-[#7a0505] text-2xl text-white shadow-[0_5px_15px_rgba(196,17,21,0.5)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#0b7a33]/35 bg-[#090302]/95 p-6 text-left text-base leading-relaxed text-[#f6e3cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#2bbf63]/70 hover:bg-[#140705] hover:shadow-[0_15px_40px_rgba(11,122,51,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#063f1c] bg-gradient-to-br from-[#0b7a33] to-[#063f1c] text-2xl text-white shadow-[0_5px_15px_rgba(11,122,51,0.45)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#d9a521]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
