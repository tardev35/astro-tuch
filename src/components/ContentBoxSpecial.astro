---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two.
//
// NAZA99 (รอบทอง-ดำ 2026-10-02): สองครึ่งบนการ์ดดำอมน้ำตาล #140c02 แบรนด์นี้เป็นทองล้วน
// ไม่มีสีคู่ตรงข้าม (โลโก้เป็นตัวอักษรทองเมทัลลิกบนพื้นโปร่ง แบนเนอร์เป็นฉากทองบนพื้นดำ)
// สองป้ายไอคอนจึงแยกกันด้วยระดับความสว่างของทองจริงๆ — ป้ายซ้ายไล่จากแชมเปญ #fdf2ac ลง
// ทองแบรนด์ #e4b34d ไปหาทองเข้ม #c08f2b เป็นฝั่งสว่าง ตัวอักษรบนป้ายนี้ใช้หมึกบนพื้นทอง
// #1a1000 เพราะทองเป็นพื้นสว่าง (11.0:1 บนทองแบรนด์) ส่วนป้ายขวาไล่จากทองแบรนด์ #e4b34d
// ลงทองเข้ม #c08f2b ไปจบที่ทองลึก #8a5f12 เป็นฝั่งเข้ม จึงใช้แชมเปญ #fdf2ac เป็นตัวอักษร
// เพราะหมึกเข้มบนทองลึกตกเกณฑ์ คู่นี้จึงอ่านเป็นทองสว่างนำ ทองเข้มตาม ตามงานอาร์ตจริง
// ไม่ใช่สีเดียวซ้ำสองครั้ง กรอบและเส้นไรผมเป็นทองลึก #8a5f12 แถวในตกลงไปที่พื้นดำสนิท
// #0a0501 เนื้อความ #f3e8cf (BRAND_TEXT) — ชุดแดงเข้ม-ทองของ หวยเฮง24 ที่ค้างในไฟล์นี้
// (#e0a52a #fdea83 #fbdc64 #bd7c13 #8b0302 #c01616 #5a0202 #2e0707 #1a0505 #720202
// #3d0808 #2a0606 #f6e6cf) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a5f12] bg-[#140c02]/92 p-6 text-[#f3e8cf] shadow-[0_10px_30px_rgba(10,5,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4b34d]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e4b34d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a5f12] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] shadow-[0_0_10px_rgba(228,179,77,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf2ac] via-[#e4b34d] to-[#8a5f12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a5f12] bg-[#0a0501]/95 p-6 text-left text-base leading-relaxed text-[#f3e8cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#e4b34d]/70 hover:bg-[#241404] hover:shadow-[0_15px_40px_rgba(228,179,77,0.30)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e4b34d]/65 bg-gradient-to-br from-[#fdf2ac] via-[#e4b34d] to-[#c08f2b] text-2xl text-[#1a1000] shadow-[0_5px_15px_rgba(228,179,77,0.40)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a5f12] bg-[#0a0501]/95 p-6 text-left text-base leading-relaxed text-[#f3e8cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#c08f2b]/80 hover:bg-[#241404] hover:shadow-[0_15px_40px_rgba(192,143,43,0.35)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c08f2b]/70 bg-gradient-to-br from-[#e4b34d] via-[#c08f2b] to-[#8a5f12] text-2xl text-[#fdf2ac] shadow-[0_5px_15px_rgba(192,143,43,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
