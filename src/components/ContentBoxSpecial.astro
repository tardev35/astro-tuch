---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7b5213]/40 bg-[#0d0904]/92 p-6 text-[#ece0c8] shadow-[0_10px_30px_rgba(235,195,107,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ebc36b]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ebc36b] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7b5213]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fce48c] to-[#442904] shadow-[0_0_10px_rgba(235,195,107,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ebc36b] via-[#e6e8ec] to-[#fce48c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7b5213]/35 bg-[#150e05]/95 p-6 text-left text-base leading-relaxed text-[#ece0c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ebc36b]/50 hover:bg-[#1b140c]/90 hover:shadow-[0_15px_40px_rgba(235,195,107,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ebc36b]/35 bg-gradient-to-br from-[#fce48c] via-[#ebc36b] to-[#7b5213] text-2xl shadow-[0_5px_15px_rgba(235,195,107,0.28)]">
          🛎️
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#e6e8ec]/20 bg-[#150e05]/95 p-6 text-left text-base leading-relaxed text-[#ece0c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#e6e8ec]/50 hover:bg-[#1b140c]/90 hover:shadow-[0_15px_40px_rgba(230,232,236,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e6e8ec]/50 bg-gradient-to-br from-[#f4f5f7] via-[#e6e8ec] to-[#b3b8c2] text-2xl shadow-[0_5px_15px_rgba(230,232,236,0.3)]">
          💬
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
