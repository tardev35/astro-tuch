---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e3c56a]/40 bg-[#03130a]/92 p-6 text-[#e4e7d8] shadow-[0_10px_30px_rgba(227,197,106,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f7e8b4]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e3c56a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e3c56a]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7e8b4] to-[#5c4415] shadow-[0_0_10px_rgba(227,197,106,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#e3c56a]/40 bg-[#082013]/95 p-6 text-left text-base leading-relaxed text-[#e4e7d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#f7e8b4]/75 hover:bg-[#0d3a22] hover:shadow-[0_15px_40px_rgba(227,197,106,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e3c56a]/55 bg-gradient-to-br from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] text-2xl shadow-[0_5px_15px_rgba(227,197,106,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#2a9d5c]/45 bg-[#082013]/95 p-6 text-left text-base leading-relaxed text-[#e4e7d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#2a9d5c]/70 hover:bg-[#0d3a22] hover:shadow-[0_15px_40px_rgba(42,157,92,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#2a9d5c]/60 bg-gradient-to-br from-[#2a9d5c] via-[#1c6b3f] to-[#0d3a22] text-2xl shadow-[0_5px_15px_rgba(42,157,92,0.28)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
