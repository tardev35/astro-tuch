---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them. These
// two wrapper <div>s are the sanctioned kind that must stay — they are the flex
// siblings of the icon plate, not carriers of inheritable text classes.
//
// FAH999 palette (royal purple + gold): two identity hues on a purple card. The
// two halves are told apart by which hue leads the icon plate — the left plate
// runs bright gold (#fef354) down into purple-mid (#7c2fd4), the right one runs
// bright purple (#a855f7) down into purple-deep (#4a1188) — so the pair reads as
// the logo's gold-on-purple rather than as one colour twice. The previous
// brand's reds and its warm golds are gone.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fbbf13]/35 bg-[#2a0a4d]/92 p-6 text-[#ecdcff] shadow-[0_10px_30px_rgba(13,1,25,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#fef354]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fbbf13] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fbbf13]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fef354] via-[#fbbf13] to-[#7c2fd4] shadow-[0_0_10px_rgba(251,191,19,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7c2fd4]/50 bg-[#180430]/95 p-6 text-left text-base leading-relaxed text-[#ecdcff] transition-all duration-300 hover:-translate-y-2 hover:border-[#fbbf13]/70 hover:bg-[#2a0a4d] hover:shadow-[0_15px_40px_rgba(251,191,19,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fbbf13]/60 bg-gradient-to-br from-[#fef354] via-[#fbbf13] to-[#7c2fd4] text-2xl shadow-[0_5px_15px_rgba(251,191,19,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#4a1188]/60 bg-[#180430]/95 p-6 text-left text-base leading-relaxed text-[#ecdcff] transition-all duration-300 hover:-translate-y-2 hover:border-[#a855f7]/70 hover:bg-[#2a0a4d] hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a855f7]/60 bg-gradient-to-br from-[#a855f7] via-[#7c2fd4] to-[#4a1188] text-2xl shadow-[0_5px_15px_rgba(168,85,247,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
