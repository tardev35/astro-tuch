---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them. They are two of the three sanctioned
// real-layout wrappers in the whole library.
//
// `actions` is a THIRD slot, added 2026-10-07, and it sits below the grid at full
// width rather than inside either half — a call-to-action pair that belongs to
// the whole section, not to one of its two paragraphs. It renders nothing at all
// when the page does not pass it, so every other caller is unaffected. It is NOT
// a slot wrapper being re-added: the two halves are untouched.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose two paragraphs split cleanly in two. It is also the only box in
// the library with an `actions` slot, which is why it is the one deliberate
// reuse of this rebrand and holds docx H2 #7 on the 789BETTING homepage: that
// section is two paragraphs plus a LINE + สมัครสมาชิก button row, which is
// exactly this shape. brand-spec §3 records the reuse and the reason.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2-§3):
// สองครึ่งบนการ์ดกระจกผิวยก #17130a รอบนี้แบรนด์มีฮิวเดียว — ทองเมทัลลิกบนดำสนิท — ไม่มี
// สีที่สองแบบชุดตรุษจีนของ GUCCI168 สองป้ายไอคอนจึงแยกกันด้วย "โลหะสว่าง vs โลหะลึก"
// ไม่ใช่คู่สี: ป้ายซ้ายเป็นแผ่นทองทึบ ไล่ทองแชมเปญ #ffe79a → ทองกลาง #ddab33 → บรอนซ์
// #c9881f บนหมึก #0a0802 (13.5:1 บนปลายสว่าง และ 10.3:1 บน #ddab33 — §2 ห้ามพลิกปุ่มทอง
// ไปใช้หมึกสว่าง) ส่วนป้ายขวาเป็นแผ่นดำลึก ไล่ผิวยก #17130a → ผิวลึกสุด #060402 ในกรอบ
// เส้นไรผม #4a3407 บนไอคอนสีทองแบรนด์ #fad354 — สองป้ายจึงเป็นขั้วกลับของกันเอง
// สองครึ่งตกลงไปที่ผิวลึกสุด #060402 กรอบและเส้นไรผมบนขอบเป็นทองแบรนด์ #fad354 โปร่ง
// ครึ่งซ้ายเป็นกรอบทองแบรนด์ ครึ่งขวาเป็นกรอบบรอนซ์ #c9881f ให้ต่างกันตั้งแต่ขอบ
// หัวข้อไล่ทองกลาง #ddab33 → ทองแบรนด์ #fad354 → ทองแชมเปญ #ffe79a คือไล่จากเข้มขึ้นหา
// สว่าง ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักตัว เนื้อความ #f3e7cd (= BRAND_TEXT)
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#c41115 #e0201f #7a0505
// #0b7a33 #2bbf63 #063f1c #d9a521 #ffdf91 #1d0b08 #140705 #090302 #f6e3cf
// rgba(196,17,21,…) rgba(11,122,51,…)) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fad354]/35 bg-[#17130a]/95 p-6 text-[#f3e7cd] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fad354]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fad354] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fad354]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe79a] via-[#fad354] to-[#8a6410] shadow-[0_0_10px_rgba(250,211,84,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ddab33] via-[#fad354] to-[#ffe79a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fad354]/30 bg-[#060402]/95 p-6 text-left text-base leading-relaxed text-[#f3e7cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#fad354]/75 hover:bg-[#0e0b05] hover:shadow-[0_15px_40px_rgba(250,211,84,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a6410] bg-gradient-to-br from-[#ffe79a] via-[#ddab33] to-[#c9881f] text-2xl text-[#0a0802] shadow-[0_5px_15px_rgba(250,211,84,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#c9881f]/35 bg-[#060402]/95 p-6 text-left text-base leading-relaxed text-[#f3e7cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe79a]/70 hover:bg-[#0e0b05] hover:shadow-[0_15px_40px_rgba(201,136,31,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#4a3407] bg-gradient-to-br from-[#17130a] to-[#060402] text-2xl text-[#fad354] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#fad354]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
