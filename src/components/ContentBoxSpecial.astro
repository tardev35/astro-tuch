---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💬", iconright = "🛡️" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected. รอบนี้หน้าแรกไม่ส่ง `actions`
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §3**
// ("โปรโมชั่นสมาชิก <แบรนด์> กดรับได้ไม่จำกัด" — content.txt บรรทัด 8): ซีกซ้ายคือ
// **ตัวรายการโปรโมชั่น** (คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% กับข้อกำหนดที่ต่างกัน
// ไปตามประเภทเกมที่เข้าร่วม ยอดที่นำมาคำนวณ และรอบเวลารับเครดิต) ซีกขวาคือ
// **สิ่งที่บรีฟสั่งให้ตรวจก่อนรับสิทธิ์** (จำนวนครั้งที่รับสิทธิ์ได้จริง เงื่อนไข
// การใช้โบนัสและการถอนเงินจากประกาศล่าสุด) หน้าแรกส่งไอคอน 🎁 / 📋 ทั้งคู่อยู่ใน
// กล่อง aria-hidden จึงไม่เคยเป็นส่วนหนึ่งของ accessible name
//
// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (2026-10-23) — พาเลตตาม .claude/brand-spec-ruaythear168club.md §2
// ⚠️⚠️ **รอบนี้เป็นธีมสว่าง** พื้นเพจ #dbe6ff (bg.json) การ์ดเนื้อหาเป็น
// **ผิวสว่าง + หมึกเข้ม** ห้ามแก้กลับไปเป็นพื้นเข้ม
// ลำดับผิว: **#ffffff ยก (การ์ดครอบ)** · **#f4e4d3 ครีม (สองซีก — วัสดุที่สอง
// ของรอบนี้ วัดจาก slide1.png)** · #eef4ff กลาง · #dce9fb อินเซ็ต · #dbe6ff พื้นเพจ
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ผิวขาวครอบ
// สองซีกที่ตกลงไปอยู่ **ผิวครีม** ซึ่งเป็นที่เดียวบนหน้าที่วัสดุที่สองถือเนื้อความ
// ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่บน-ล่าง** (border-y) ไม่ใช่ขีดใต้
// แท่งตั้ง แผ่นถม ป้ายลอย หรือสันซ้ายแบบใบอื่น และเป็น **ฟ้าเข้ม #0d6b9b ทึบ
// สีเดียว ไม่ไล่เฉด** (5.6:1 บนผิวขาว) เพราะ §2 ห้าม #18a5e2 (2.6:1) เข้าไปเป็น
// พิกเซลของตัวอักษรบนพื้นสว่าง
// สองป้ายไอคอนเป็น **ขั้วกลับของกันเอง**: ซ้ายเป็น **แผ่นสว่าง** ไล่ขาว → ครีม
// #f4e4d3 ในกรอบครีมเข้ม #e4cbb3 บนหมึก #16294a (11.9:1) ส่วนขวาเป็น
// **แผ่นถมฟ้าทึบ** ไล่ #0d6b9b → #0a5176 ในกรอบ #0d6b9b บนหมึก **ขาว** ซึ่งเป็น
// สูตร "ปุ่ม CTA หลัก" ของ §2 ตรงๆ (5.6:1 ที่สต็อปอ่อนสุด · 8.0:1 ที่สต็อปเข้ม)
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบครีมเข้ม #e4cbb3 ซีกขวากรอบฟ้าเข้ม #0d6b9b
// เส้นคาดหัวการ์ดเป็นฟ้าไซยาน #18a5e2 โปร่ง (**พื้นถม ไม่ใช่ตัวอักษร**)
// เนื้อความ #16294a (= BRAND_TEXT) — 13.9:1 บนผิวขาว และ 11.9:1 บนผิวครีม
// ⚠️ §2 ห้าม #18a5e2/#a9d7f2/#f4e4d3/#e4cbb3/#dce9fb/#eef4ff/#dbe6ff ถือตัวอักษร
// บนพื้นสว่าง · **#0d6b9b สงวนไว้ให้ <strong> ในเนื้อความด้วย** ซึ่งเป็นงานของ
// หน้าเพจ ไม่ใช่ของไฟล์นี้
//
// ⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — ฟ้า/ไซยานนำมาแล้วห้าแบรนด์ (สบาย168 ·
// รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911) และ **ครีมก็เป็นวัสดุที่สองของ
// แบรนด์ขาออกเงินทอง168 ด้วย** การเจอครีมหรือฟ้าในไฟล์จึงไม่พิสูจน์อะไรเลย
// ครีมรอบนี้คือ **#f4e4d3 / #e4cbb3 เท่านั้น** (วัดจาก slide1.png ของดรอปนี้)
// ไม่ใช่ ecd5c4 d2b9a4 (เงินทอง168) ไม่ใช่ eadfce (ขวัญใจ168) ไม่ใช่ f5e7c8 fce2d4
// fcd4c3 (หวยคิง) และไม่ใช่ f4ead6 d6c6a8 (พักยก168)
// ไฟล์นี้เพิ่งค้างชุด **แดงคริมสัน-หมึกเลือดหมูบนธีมสว่างของ รวยแท้168** ไว้ทั้งใบ
// (c30303 8f0505 e81313 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb dcb95f b8862b
// 96681f c99a3f กับ rgba 195/3/3 และ rgba 74/15/15) ออกครบทุกค่าแล้ว เช่นเดียวกับ
// ชุดของ **เงินทอง168 (แบรนด์ขาออก)** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f
// 3d3016 332810 201906 2e2512 1b1407 4d3c15) **สบาย168** (2cc3fc 6bdcfb 0a7fbd
// 063a57 04293d 0a4f74 9ae0fa cdf2ff ccf7ff f2fbff dff4fd eafaff a9e3f9 0f3a4a
// 06293c fdcb0c fefb6b 8a6504) **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b e3f2fc
// 0b2d52 f9a826 704504) **นินจา168** (32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d
// 071a28) **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff ffc82e 5c4a16)
// **TSDET911** (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7) **สาธุ168**
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a) **มีทรัพย์168** (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) **ดวงเศรษฐี168** (d9212a 8e1a16 f0c878 fff8d8 2a0608
// 4e2120) และ **KMD88** (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 ece2f8)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีชมพู ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a9d7f2] bg-white p-6 text-[#16294a] shadow-[0_10px_30px_rgba(22,41,74,0.14)] transition-all duration-500 hover:border-[#18a5e2] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#18a5e2] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#a9d7f2] py-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0d6b9b]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#e4cbb3] bg-[#f4e4d3] p-6 text-left text-base leading-relaxed text-[#16294a] transition-all duration-300 hover:-translate-y-2 hover:border-[#0d6b9b] hover:shadow-[0_15px_40px_rgba(244,228,211,0.9)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e4cbb3] bg-gradient-to-br from-white to-[#f4e4d3] text-2xl text-[#16294a] shadow-[0_5px_15px_rgba(22,41,74,0.18)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#0d6b9b] bg-[#f4e4d3] p-6 text-left text-base leading-relaxed text-[#16294a] transition-all duration-300 hover:-translate-y-2 hover:border-[#18a5e2] hover:shadow-[0_15px_40px_rgba(13,107,155,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#0d6b9b] bg-gradient-to-br from-[#0d6b9b] to-[#0a5176] text-2xl text-white shadow-[0_5px_15px_rgba(13,107,155,0.42)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#a9d7f2] pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
