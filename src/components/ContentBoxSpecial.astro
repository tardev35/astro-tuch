---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "☎️", iconright = "🛡️" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected. รอบนี้หน้าแรกไม่ส่ง `actions`
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §7**
// ("ติดต่อแอดมินเว็บ <แบรนด์> ได้ตลอด 24ชม." — content.txt บรรทัด 15) พร้อมย่อหน้า
// ของมัน (บรรทัด 16) แบ่งครึ่ง: ซีกซ้ายคือ **เรื่องที่สอบถามแอดมินได้** (รายชื่อ
// เกมสล็อต การเข้าสู่ระบบ รายการฝากถอน รายละเอียดโปรโมชั่น โดยเฉพาะเงื่อนไขโบนัส
// ไม่ต้องทำเทิร์นและวิธีรับเครดิตคืนยอดเสีย) ซีกขวาคือ **ความปลอดภัยในการติดต่อ**
// (ตรวจช่องทางจากเว็บไซต์ทางการ เลี่ยงบัญชีแอบอ้าง เก็บหลักฐานธุรกรรม ไม่เปิดเผย
// รหัสผ่านหรือรหัส OTP และตรวจเวลาให้บริการจริงจากประกาศล่าสุด) หน้าแรกส่งไอคอน
// ☎️ / 🛡️ ทั้งคู่อยู่ในกล่อง aria-hidden จึงไม่เคยเป็นส่วนหนึ่งของ accessible name
// ⚠️ **ไม่มี BankStrip / ProviderGrid บนหน้าแรกรอบนี้** — บรีฟพูดถึง "ธนาคารและ
// ทรูมันนี่" แบบนามธรรม ไม่ได้ระบุชื่อธนาคาร ค่ายเกม หรือผู้ให้บริการรายไหนเลย
// แถบโลโก้จึงเป็นข้อมูลที่หน้าเพจแต่งเอง ไม่ใช่ของบรีฟ
//
// ───────────────────────────────────────────────────────────────────────────
// โบ๊ะบ๊ะ168 (ดรอป 2026-10-24) — พาเลตตาม .claude/brand-spec-bohba168.md §2
// **ฟ้าสกายบับเบิลนำ · ขาว/ฟ้าพาสเทลเป็นวัสดุที่สอง · บนธีมสว่าง**
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดงเจล-มุกอุ่นบนดำอมแดงของ สล็อต168** ทั้งใบ
// จึงรีเธมทั้งไฟล์ **รอบนี้กลับทิศเป็นธีมสว่าง** พื้นเพจ #00bfff (bg.json) =
// ฟ้าสกายอิ่มตัว **ห้ามแก้กลับไปเป็นพื้นมืด และห้ามเหลือแดง/มุก/ดำอมแดงไว้เลย
// สักค่า**
// ลำดับผิว: #f0faff ยก (แผ่นไอคอนซ้าย) · **#e4f6fb wash (การ์ดครอบ)** ·
// **#ffffff การ์ด (สองซีก)** · #00bfff พื้นเพจ
// ⚠️⚠️ **สองซีกตั้งใจอยู่ที่ผิวการ์ดขาว #ffffff ไม่ใช่ผิวยก #f0faff** เพราะ <strong>
// ของหน้าเพจเป็น **#0f5684** ซึ่งได้ **7.8:1 บนขาว** เทียบกับ **7.3:1 บน #f0faff**
// — ทั้งคู่ผ่าน AA แต่ขาวคือค่าที่สูงกว่า และซีกขาวบนการ์ด wash ยังให้ "การ์ดซ้อน
// การ์ด" ที่อ่านออกโดยไม่ต้องพึ่งเงา **ห้ามสลับสองผิวนี้กัน**
//
// จังหวะรูปทรงของใบนี้: เป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ผิว wash ครอบ
// สองซีกที่ลอยขึ้นมาอยู่ผิวการ์ดขาว
// ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่บน-ล่าง** (border-y) ไม่ใช่ขีดใต้
// แท่งตั้ง แผ่นถม สันซ้าย หรือชิปกลีฟแบบใบอื่น และเป็น **ฟ้าลึก #0f5684 ทึบ
// สีเดียว ไม่ไล่เฉด** (6.9:1 บนผิว wash)
// สองแผ่นไอคอนเป็น **ขั้วกลับของกันเอง**: ซ้ายเป็น **แผ่นผิวยก** ไล่ #f0faff →
// #ffffff ในกรอบ #7fcbe8 บนหมึก **#06283f** (เงียบ เป็นผิว ไม่ใช่สีนำ) ส่วนขวาเป็น
// **แผ่นถมน้ำเงินทึบ** ไล่ #1a6ea8 → #0f5684 ในกรอบ #0f5684 บนหมึก **ขาว** ซึ่งเป็น
// สูตร "CTA หลัก" ของ §2 ตรง ๆ (5.5:1 ที่สต็อปอ่อนสุด · 7.8:1 ที่สต็อปเข้ม)
// ⚠️⚠️ **ห้ามลากไล่เฉดขึ้นไปถึง #12b4ef หรือ #00bfff แล้ววางหมึกขาว (2.4 / 2.1:1)**
// — §2 ระบุไว้ตรง ๆ
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบ #7fcbe8 ซีกขวากรอบฟ้าเส้นเข้ม #4fb8ea
// เส้นคาดหัวการ์ดเป็นฟ้าสกาย #12b4ef โปร่ง (**พื้นถม ไม่ใช่ตัวอักษร**)
// เนื้อความ #06283f (= BRAND_TEXT) — 14.0:1 บนผิว wash และ 15.2:1 บนผิวการ์ดขาว
// ⚠️ §2 ห้าม **#12b4ef #00bfff #b6e3f0 #7fcbe8 #4fb8ea #f0faff #e4f6fb #ffffff**
// ถือตัวอักษรบนผิวสว่าง · **#0f5684 ใช้ทั้งหัวข้อที่นี่และ <strong> ในเนื้อความ**
// ซึ่งเป็นงานของหน้าเพจ ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(18,180,239,α) · rgba(182,227,240,α) ·
// rgba(15,86,132,α) · rgba(6,40,63,α) · rgba(127,203,232,α)
//
// ⚠️⚠️ **เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี"** — รอบนี้เป็นแบรนด์ฟ้าจริง และรีโปนี้
// มีฟ้าของแบรนด์อื่นอยู่แปดชุด "มีฟ้าอยู่แล้ว" จึงไม่พิสูจน์อะไรเลย
// ฟ้ารอบนี้คือ **#12b4ef / #b6e3f0 / #00bfff / #7fcbe8 / #4fb8ea / #0f5684 /
// #1a6ea8 / #06283f** เท่านั้น ค่าที่ต้องไม่เหลือในไฟล์นี้:
//   **สล็อต168 (ชุดที่เพิ่งอยู่ทั้งใบนี้)** — fb2e33 cb0b0d d81115 b00d11 8a0608
//     f0e6e4 c9b9b7 e3d6d4 7d6f6e 140000 0b0000 1c0607 2a0c0d 551c1e
//   **หมูบิน168 (แบรนด์ขาออก — เสี่ยงหลงเหลือสูงสุด)** — fa539c c2185b 8e0f41
//     fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350
//     ffe9f5 7a4463
//   **มาดาม168** — ff2e52 e01238 c9102f 1177e8 0e68cc 0a4ea8 2a3c70 16234a 0b1733
//     050e26 00091f f4eef1 d9dfe9 b3bdd6 ⚠️ 0a4ea8 ใกล้ #0b4a73 ที่ G
//   **นาซ่า168** — 1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 273449 1b2434 121722
//     33455f 0d1017
//   **ร่ำรวย168** — 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb 111a3f
//     f4e4d3 e4cbb3 ⚠️⚠️ **18a5e2 ห่างจาก #12b4ef แค่ R6/G15/B13 — เจอแล้วแปลว่า
//     พิมพ์ผิด**
//   **สบาย168** — 2cc3fc 6bdcfb 0a7fbd 063a57 04293d 0a4f74 9ae0fa fdcb0c
//     ⚠️ **063a57 มี R=06 ตรงกับ #06283f เป๊ะ ต่างที่ G/B 18/24**
//   **นินจา168** — 32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d 071a28
//     ⚠️ **07335f ใกล้ #06283f ที่ R**
//   **รวยแทร่168** — 039cfa 0494f5 c3ebfc 04366b f9a826
//   **สบายเบท168** — 2f9ff5 a8dcff d6ecff 0b3f78 ffc82e
//   **TSDET911** — 0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 00081f
//   **รวย168** — ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 dde1e7 f3ece0 bfb8aa
//   **เงินทอง168** — f5ba14 fcee52 b37c0b ecd5c4 d2b9a4
//   **สาธุ168** — 0b7d28 0a5f1c 0f9b35 c9cb63 · **KMD88** — 7505cc b453ff c07cff
//   อื่น ๆ — b3121b f2bba5 (ขวัญใจ168) · eb0305 e40303 c20305 (โปรดี168) · fa0513
//     ff5a5f (สมหวัง168) · fb1b32 ff8f9c (มีเฮ168) · e4021b (รวยเทพ168) · d30304
//     a00203 (รับตัง168) · dc0203 f5282a (หวย365) · fa63b9 ffb3de (ถอนชัวร์168) ·
//     f5469f ff8dc6 8c0f52 (มีโชค168) · ff3b14 6d0804 (FLASH877) · dd1b74 a4186b
//     (มีทรัพย์168) · fb141b ff5f63 8a0609 (GT66B)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # โดยตั้งใจ เพื่อไม่ให้ sweep ที่ไล่หาสีเก่า
// สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/ฟูเชีย ไม่มีทอง/เหลือง ไม่มีม่วง ไม่มีเขียว
// ไม่มีส้ม ไม่มีครีม/เบจ/พีช ไม่มีน้ำตาล และไม่มีแรมป์เทาเงิน** — วัสดุที่สอง
// รอบนี้คือ **ขาว/ฟ้าพาสเทล (B>G>R)** และดาวเหลืองกับเหรียญทองในอาร์ตเวิร์กเป็น
// **วัตถุในภาพ ไม่ใช่สี UI**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7fcbe8] bg-[#e4f6fb] p-6 text-[#06283f] shadow-[0_10px_30px_rgba(15,86,132,0.13)] transition-all duration-500 hover:border-[#12b4ef] md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#12b4ef] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#7fcbe8] py-4">
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0f5684]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7fcbe8] bg-white p-6 text-left text-base leading-relaxed text-[#06283f] transition-all duration-300 hover:-translate-y-2 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(18,180,239,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7fcbe8] bg-gradient-to-br from-[#f0faff] to-white text-2xl text-[#06283f] shadow-[0_5px_15px_rgba(127,203,232,0.5)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#4fb8ea] bg-white p-6 text-left text-base leading-relaxed text-[#06283f] transition-all duration-300 hover:-translate-y-2 hover:border-[#12b4ef] hover:shadow-[0_15px_40px_rgba(15,86,132,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#0f5684] bg-gradient-to-br from-[#1a6ea8] to-[#0f5684] text-2xl text-white shadow-[0_5px_15px_rgba(15,86,132,0.45)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#7fcbe8] pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
