---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. It is also the only box in the library with an
// `actions` slot, which is why it holds docx H2 #7 on the KOON234 homepage: that
// section is the แอดมิน 24 ชั่วโมง pair of paragraphs plus a LINE + สมัครสมาชิก
// button row, which is exactly this shape.
//
// KOON234 (รอบมรกตเข้ม-ทองบนเขียวเกือบดำ 2026-10-09, brand-spec §2):
// สองครึ่งบนการ์ดกระจกผิวยก #0d2414 รอบนี้แบรนด์มีสองฮิวจริง — เขียวมรกตเข้มกับทอง —
// ไม่ใช่โลหะเดียวแบบ 789BETTING สองป้ายไอคอนจึงแยกกันด้วย "ทอง vs เขียว" ไม่ใช่ด้วย
// ระดับความสว่างของโลหะเดียว: ป้ายซ้ายเป็นแผ่นทองทึบ ไล่ทองซีด #fde9a6 → ทองสว่าง
// #f7d14e → ทองแบรนด์ #cc920a บนหมึก #07170c (15.5:1 บนปลายสว่าง และ 6.8:1 บน #cc920a —
// §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง) ส่วนป้ายขวาเป็นแผ่นเขียวลึก ไล่เขียวมรกต #0a6b32 →
// เขียวเข้ม #043d1c ในกรอบเขียวสว่าง #2fbf6a บนไอคอนทองสว่าง #f7d14e — สองป้ายจึงเป็น
// ขั้วกลับของกันเอง ทั้งพื้นและหมึก
// สองครึ่งตกลงไปที่ผิวลึกสุด #020803 ครึ่งซ้ายเป็นกรอบทองแบรนด์ #cc920a ครึ่งขวาเป็นกรอบ
// เขียวมรกต #0a6b32 ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองแบรนด์โปร่ง
// หัวข้อไล่ทองแบรนด์ #cc920a → ทองสว่าง #f7d14e → ทองซีด #fde9a6 คือไล่จากเข้มขึ้นหา
// สว่างในฮิวทองล้วน ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #e8f2e6 (= BRAND_TEXT) — 14.7:1 บนผิวยก และ 18.3:1 บนผิวลึกสุดของสองครึ่ง
//
// ชุดทองเมทัลลิกของ 789BETTING ที่เคยค้างในไฟล์นี้ (#fad354 #ffe79a #ddab33 #8a6410
// #c9881f #4a3407 #17130a #0e0b05 #060402 #0a0802 #f3e7cd rgba(250,211,84,…)) และชุด
// ตรุษจีนแดง-เขียว-ทองของ GUCCI168 ก่อนหน้านั้น (#c41115 #e0201f #7a0505 #0b7a33 #2bbf63
// #063f1c #d9a521 #ffdf91 #1d0b08 #140705 #090302 #f6e3cf) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#cc920a]/35 bg-[#0d2414]/95 p-6 text-[#e8f2e6] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#cc920a]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#cc920a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#cc920a]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde9a6] via-[#cc920a] to-[#043d1c] shadow-[0_0_10px_rgba(204,146,10,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#cc920a] via-[#f7d14e] to-[#fde9a6] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#cc920a]/30 bg-[#020803]/95 p-6 text-left text-base leading-relaxed text-[#e8f2e6] transition-all duration-300 hover:-translate-y-2 hover:border-[#cc920a]/75 hover:bg-[#09190d] hover:shadow-[0_15px_40px_rgba(204,146,10,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a6204] bg-gradient-to-br from-[#fde9a6] via-[#f7d14e] to-[#cc920a] text-2xl text-[#07170c] shadow-[0_5px_15px_rgba(204,146,10,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#0a6b32]/45 bg-[#020803]/95 p-6 text-left text-base leading-relaxed text-[#e8f2e6] transition-all duration-300 hover:-translate-y-2 hover:border-[#2fbf6a]/70 hover:bg-[#09190d] hover:shadow-[0_15px_40px_rgba(10,107,50,0.30)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#2fbf6a]/60 bg-gradient-to-br from-[#0a6b32] to-[#043d1c] text-2xl text-[#f7d14e] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#cc920a]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
