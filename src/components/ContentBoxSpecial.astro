---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// KINGDOM66 palette (ทอง-ดำ 2026-09-25): สองครึ่งบนการ์ดดำอมน้ำตาล #151109 แยกกัน
// ด้วยคู่สีประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากทองสว่าง #f2d683 ลงทองแบรนด์ #e6bf4e ไปหา
// ทองลึก #5c4113 (เลข 66 ที่เป็นทองเต็มดวง) ส่วนป้ายขวาไล่จากครีมแพลตินัมอุ่น
// #efe6cf ลงครีมหม่น #b5a888 ไปจบที่ทองลึก #5c4113 (คำว่า KINGDOM ที่เป็นทองแกะสลัก
// ด้าน) คู่นี้จึงอ่านเป็น ทองนำ ครีมตาม ตามโลโก้จริง ไม่ใช่สีเดียวซ้ำสองครั้ง
// เนื้อความ #ebe3d3 (BRAND_TEXT) — ชุดแดง-ดำ-เงินโครเมียมของ MAHAGAME66 (#de161d
// #ff4d52 #7a0a0e #e2e8ef #9ba3ad #16090a #26100f #080506 #e8e3e1) ออกทั้งหมด
// แบรนด์นี้ไม่มีสีเงินเย็นอยู่เลย
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5c4113]/70 bg-[#151109]/92 p-6 text-[#ebe3d3] shadow-[0_10px_30px_rgba(5,4,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2d683]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e6bf4e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5c4113]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] shadow-[0_0_10px_rgba(230,191,78,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#5c4113]/70 bg-[#050403]/95 p-6 text-left text-base leading-relaxed text-[#ebe3d3] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2d683]/70 hover:bg-[#241c13] hover:shadow-[0_15px_40px_rgba(230,191,78,0.34)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e6bf4e]/65 bg-gradient-to-br from-[#f2d683] via-[#e6bf4e] to-[#5c4113] text-2xl shadow-[0_5px_15px_rgba(230,191,78,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#241c13] bg-[#050403]/95 p-6 text-left text-base leading-relaxed text-[#ebe3d3] transition-all duration-300 hover:-translate-y-2 hover:border-[#efe6cf]/55 hover:bg-[#241c13] hover:shadow-[0_15px_40px_rgba(239,230,207,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#efe6cf]/50 bg-gradient-to-br from-[#efe6cf] via-[#b5a888] to-[#5c4113] text-2xl shadow-[0_5px_15px_rgba(239,230,207,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
