---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose single paragraph splits cleanly in two.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): สองครึ่งบนการ์ดแผงดำอมเขียว
// #0b160b แยกกันด้วยสองโทนของโลโก้ — ป้ายไอคอนซ้ายไล่จากเขียวอ่อน #c9ff8f ลง
// เขียวนีออนแบรนด์ #8bfc13 ไปหาเขียวลึก #1a7a08 (ตัว K กับเลข 2 บนเวิร์ดมาร์ก
// และริ้วแสงนีออนในแบนเนอร์) ส่วนป้ายขวาไล่จากโครเมียมขาว #e8f0e6 ลงโครเมียม
// กลาง #b9c9b4 ไปจบที่โครเมียมหม่น #8fa38a (ตัว C กับเลข 68 ที่เป็นโลหะขาวเงิน)
// คู่นี้จึงอ่านเป็นเขียวนำ โครเมียมตาม ตามงานอาร์ตจริง ไม่ใช่สีเดียวซ้ำสองครั้ง
// ตัวอักษรบนป้ายทั้งสองใช้หมึกเข้ม #030703 เพราะทั้งเขียวนีออนและโครเมียมเป็นพื้น
// สว่าง (14.9:1 และ 15.5:1) กรอบและเส้นไรผมเป็นเขียวลึก แถวในตกลงไปที่ผิวดำ
// อมเขียว #071007 เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่
// ค้างในไฟล์นี้ (#dc020e #ff2d38 #6b0207 #f3c623 #fde79a #8a6a0a #2a0d0f #120b0c
// #1f0a0c #1a0203 #f0e2e2) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1a7a08]/70 bg-[#0b160b]/92 p-6 text-[#d5e6cd] shadow-[0_10px_30px_rgba(1,4,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#8bfc13]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#8bfc13] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1a7a08]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] shadow-[0_0_10px_rgba(139,252,19,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1a7a08]/70 bg-[#071007]/95 p-6 text-left text-base leading-relaxed text-[#d5e6cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#8bfc13]/70 hover:bg-[#0f1b0e] hover:shadow-[0_15px_40px_rgba(139,252,19,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8bfc13]/65 bg-gradient-to-br from-[#c9ff8f] via-[#8bfc13] to-[#1a7a08] text-2xl text-[#030703] shadow-[0_5px_15px_rgba(139,252,19,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1a7a08]/70 bg-[#071007]/95 p-6 text-left text-base leading-relaxed text-[#d5e6cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#e8f0e6]/70 hover:bg-[#0f1b0e] hover:shadow-[0_15px_40px_rgba(232,240,230,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e8f0e6]/65 bg-gradient-to-br from-[#e8f0e6] via-[#b9c9b4] to-[#8fa38a] text-2xl text-[#030703] shadow-[0_5px_15px_rgba(232,240,230,0.3)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
