---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎧", iconright = "🧾" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On the PIGPG homepage it holds docx H2 #7,
// the แอดมิน 24 ชั่วโมง pair: the left paragraph is the contact channel, the
// right one is the detail to have ready before writing in.
//
// Default icons are 🎧 / 🧾 — a support desk and a transaction record, which is
// exactly what those two paragraphs are about on a slot site. Both render inside
// an aria-hidden box, so neither is ever part of an accessible name.
//
// PIGPG (รอบแดงแล็กเกอร์-ทองแบบตรุษจีน 2026-10-09, brand-spec §2):
// สองครึ่งบนการ์ดกระจกผิวยก #3a0d07 รอบนี้แบรนด์มีสองฮิวจริง — แดงแล็กเกอร์กับทอง —
// สองป้ายไอคอนจึงแยกกันด้วย "ทอง vs แดง" ไม่ใช่ด้วยระดับความสว่างของโลหะเดียว:
// ป้ายซ้ายเป็นแผ่นทองทึบ ไล่ครีมงาช้าง #fdf9e4 → ทองสว่าง #ffd87a → ทองแบรนด์ #f5b61d
// บนหมึกผิวลึกสุด #120302 (10:1 ขึ้นไปทั้งไล่เฉด — §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง)
// ส่วนป้ายขวาเป็นแผ่นแล็กเกอร์แดง ไล่แดงเข้ม #a30303 → แดงลึก #6b0402 ในกรอบแดงสด
// #d4200d บนไอคอนทองสว่าง #ffd87a — สองป้ายจึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และ
// ตรงกับโลโก้ที่เป็นป้ายแดงขอบทอง
// สองครึ่งตกลงไปที่ผิวลึกสุด #120302 ครึ่งซ้ายเป็นกรอบทองแบรนด์ ครึ่งขวาเป็นกรอบแดงสด
// ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองแบรนด์โปร่ง
// หัวข้อไล่ครีมงาช้าง #fdf9e4 → ทองแบรนด์ #f5b61d → ทองสว่าง #ffd87a ซึ่งไม่ซ้ำลำดับกับ
// กล่องอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #fdeedd (= BRAND_TEXT) — 14.8:1 บนผิวยก และ 18.6:1 บนผิวลึกสุดของสองครึ่ง
//
// ชุดมรกต-ทองของ KOON234 ที่เคยค้างในไฟล์นี้ (#0a6b32 #2fbf6a #043d1c #cc920a #f7d14e
// #fde9a6 #8a6204 #0d2414 #09190d #020803 #e8f2e6 #07170c rgba(204,146,10,α)) ชุดทอง
// เมทัลลิกของ 789BETTING (#fad354 #ffe79a #ddab33 #8a6410 #c9881f #4a3407 #17130a
// #0e0b05 #060402 #0a0802 #f3e7cd) และชุดตรุษจีนแดง-เขียว-ทองของ GUCCI168 ก่อนหน้านั้น
// (#c41115 #e0201f #7a0505 #0b7a33 #2bbf63 #063f1c #d9a521 #ffdf91 #1d0b08 #140705
// #090302 #f6e3cf) ออกครบทุกจุดแล้ว — GUCCI168 ก็เป็นชุดแดง-ทองตรุษจีนเหมือนกัน แต่เป็น
// คนละค่าทุกตัว อย่าปล่อยไว้เพราะ "แดงอยู่แล้ว"
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5b61d]/35 bg-[#3a0d07]/95 p-6 text-[#fdeedd] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5b61d]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f5b61d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5b61d]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf9e4] via-[#f5b61d] to-[#6b0402] shadow-[0_0_10px_rgba(245,182,29,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf9e4] via-[#f5b61d] to-[#ffd87a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5b61d]/30 bg-[#120302]/95 p-6 text-left text-base leading-relaxed text-[#fdeedd] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5b61d]/75 hover:bg-[#2a0806] hover:shadow-[0_15px_40px_rgba(245,182,29,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b07a06] bg-gradient-to-br from-[#fdf9e4] via-[#ffd87a] to-[#f5b61d] text-2xl text-[#120302] shadow-[0_5px_15px_rgba(245,182,29,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#d4200d]/45 bg-[#120302]/95 p-6 text-left text-base leading-relaxed text-[#fdeedd] transition-all duration-300 hover:-translate-y-2 hover:border-[#d4200d]/80 hover:bg-[#2a0806] hover:shadow-[0_15px_40px_rgba(212,32,13,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#d4200d]/60 bg-gradient-to-br from-[#a30303] to-[#6b0402] text-2xl text-[#ffd87a] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#f5b61d]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
