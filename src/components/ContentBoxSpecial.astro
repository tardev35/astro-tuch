---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a3060c]/30 bg-[#0a0304]/92 p-6 text-[#d8dae0] shadow-[0_10px_30px_rgba(255,42,48,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2a30]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ff2a30] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a3060c]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff6b70] to-[#5c0203] shadow-[0_0_10px_rgba(255,42,48,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff2a30] via-[#d3d6db] to-[#ff6b70] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#a3060c]/25 bg-[#150406]/95 p-6 text-left text-base leading-relaxed text-[#d8dae0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2a30]/50 hover:bg-[#1a0507]/90 hover:shadow-[0_15px_40px_rgba(255,42,48,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff2a30]/35 bg-gradient-to-br from-[#ff6b70] via-[#ff2a30] to-[#a3060c] text-2xl shadow-[0_5px_15px_rgba(255,42,48,0.28)]">
          🛎️
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#d3d6db]/20 bg-[#150406]/95 p-6 text-left text-base leading-relaxed text-[#d8dae0] transition-all duration-300 hover:-translate-y-2 hover:border-[#d3d6db]/50 hover:bg-[#141518]/90 hover:shadow-[0_15px_40px_rgba(211,214,219,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#d3d6db]/50 bg-gradient-to-br from-[#f1f2f4] via-[#d3d6db] to-[#8a8f98] text-2xl shadow-[0_5px_15px_rgba(211,214,219,0.3)]">
          💬
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
