---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// LOTTOKA palette: the left icon plate is the logo's solid red and the right one
// is the cream/rose of the outlined KA — the two halves are told apart by
// brightness within one hue rather than by a second colour, because this brand
// has exactly one identity colour. The previous brand's navy and gold are gone.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c21e22]/35 bg-[#140a0c]/92 p-6 text-[#ded9da] shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2353a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e2353a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c21e22]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9ea] via-[#e2353a] to-[#7d1114] shadow-[0_0_10px_rgba(226,53,58,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#e2353a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c21e22]/40 bg-[#0a0608]/95 p-6 text-left text-base leading-relaxed text-[#ded9da] transition-all duration-300 hover:-translate-y-2 hover:border-[#e2353a]/70 hover:bg-[#1c0d0f] hover:shadow-[0_15px_40px_rgba(194,30,34,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c21e22]/60 bg-gradient-to-br from-[#ff8a8d] via-[#e2353a] to-[#7d1114] text-2xl shadow-[0_5px_15px_rgba(194,30,34,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#ffe9ea]/30 bg-[#0a0608]/95 p-6 text-left text-base leading-relaxed text-[#ded9da] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe9ea]/60 hover:bg-[#3a0709] hover:shadow-[0_15px_40px_rgba(255,233,234,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffe9ea]/60 bg-gradient-to-br from-[#ffe9ea] via-[#ff9a9d] to-[#c21e22] text-2xl shadow-[0_5px_15px_rgba(255,154,157,0.30)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
