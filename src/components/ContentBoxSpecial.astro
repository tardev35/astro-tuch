---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// BRAZIL999 palette (เขียว-โครเมียม-ดำ 2026-09-25): สองครึ่งบนการ์ดเขียวเข้ม
// #0a1a0c แยกกันด้วยคู่วัสดุประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากเขียวสว่าง #7cf25c ลง
// เขียวแบรนด์ #22c55e ไปหาเขียวลึก #04380c (เลข 999 ที่เป็นเขียวสดเต็มดวง) ส่วน
// ป้ายขวาไล่จากโครเมียมสว่าง #f1f5f9 ลงโครเมียมกลาง #aab4bf ไปจบที่โครเมียมลึก
// #6b7580 (คำว่า BRAZIL ที่เป็นโลหะขัดเงา) คู่นี้จึงอ่านเป็น เขียวนำ โครเมียมตาม
// ตามโลโก้จริง ไม่ใช่สีเดียวซ้ำสองครั้ง กรอบและเส้นไรผมเป็นเขียวลึก #1c5a26
// เนื้อความ #dfeadd (BRAND_TEXT) — ชุดทอง-ครีมอุ่นของ KINGDOM66 (#e6bf4e #f2d683
// #5c4113 #efe6cf #b5a888 #241c13 #151109 #050403 #ebe3d3) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1c5a26]/70 bg-[#0a1a0c]/92 p-6 text-[#dfeadd] shadow-[0_10px_30px_rgba(4,10,5,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#7cf25c]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#22c55e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1c5a26]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] shadow-[0_0_10px_rgba(34,197,94,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1c5a26]/70 bg-[#040a05]/95 p-6 text-left text-base leading-relaxed text-[#dfeadd] transition-all duration-300 hover:-translate-y-2 hover:border-[#7cf25c]/70 hover:bg-[#123a18] hover:shadow-[0_15px_40px_rgba(34,197,94,0.34)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#22c55e]/65 bg-gradient-to-br from-[#7cf25c] via-[#22c55e] to-[#04380c] text-2xl shadow-[0_5px_15px_rgba(34,197,94,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#123a18] bg-[#040a05]/95 p-6 text-left text-base leading-relaxed text-[#dfeadd] transition-all duration-300 hover:-translate-y-2 hover:border-[#f1f5f9]/55 hover:bg-[#123a18] hover:shadow-[0_15px_40px_rgba(170,180,191,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f1f5f9]/50 bg-gradient-to-br from-[#f1f5f9] via-[#aab4bf] to-[#6b7580] text-2xl shadow-[0_5px_15px_rgba(170,180,191,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
