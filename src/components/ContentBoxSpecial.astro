---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// SAGAME66 palette (ทอง-เงินโครเมียม 2026-09-23): สองครึ่งบนการ์ดน้ำตาลเกือบดำ
// #171006 แยกกันด้วยคู่สีประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากทองสว่าง #ffe9a3 ลงทอง
// หลัก #e8b93f ไปหาทองลึก #96671a (ตัว SA ที่เป็นทองสามมิติ) ส่วนป้ายขวาไล่จาก
// เงินโครเมียม #eef3f8 ลงเงินกลาง #b6c1cd ไปจบที่ทองลึก #96671a (ตัว GAME ที่เป็น
// เงินแล้ววกกลับเป็นทองที่เลข 66) คู่นี้จึงอ่านเป็น ทองนำ เงินตาม ตามโลโก้จริง
// ไม่ใช่สีเดียวซ้ำสองครั้ง แดง-ทองของ THE88 กับชมพูมาเจนตาของ WY88 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#96671a]/35 bg-[#171006]/92 p-6 text-[#e3d8c0] shadow-[0_10px_30px_rgba(13,9,3,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8b93f]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e8b93f] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#96671a]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#e8b93f] to-[#96671a] shadow-[0_0_10px_rgba(232,185,63,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#96671a]/45 bg-[#0d0903]/95 p-6 text-left text-base leading-relaxed text-[#e3d8c0] transition-all duration-300 hover:-translate-y-2 hover:border-[#e8b93f]/70 hover:bg-[#171006] hover:shadow-[0_15px_40px_rgba(232,185,63,0.42)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e8b93f]/60 bg-gradient-to-br from-[#ffe9a3] via-[#e8b93f] to-[#96671a] text-2xl shadow-[0_5px_15px_rgba(232,185,63,0.45)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#2a1d0b] bg-[#0d0903]/95 p-6 text-left text-base leading-relaxed text-[#e3d8c0] transition-all duration-300 hover:-translate-y-2 hover:border-[#eef3f8]/55 hover:bg-[#171006] hover:shadow-[0_15px_40px_rgba(238,243,248,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#eef3f8]/50 bg-gradient-to-br from-[#eef3f8] via-[#b6c1cd] to-[#96671a] text-2xl shadow-[0_5px_15px_rgba(238,243,248,0.3)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
