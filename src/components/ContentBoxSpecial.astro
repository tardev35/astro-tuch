---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4aa4f4]/40 bg-[#010c26]/92 p-6 text-[#d3e6ff] shadow-[0_10px_30px_rgba(74,164,244,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#c9e8ff]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#4aa4f4] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4aa4f4]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c9e8ff] to-[#083a80] shadow-[0_0_10px_rgba(74,164,244,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#c9e8ff] via-[#4aa4f4] to-[#0b4ea8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#4aa4f4]/40 bg-[#010c26]/95 p-6 text-left text-base leading-relaxed text-[#d3e6ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#c9e8ff]/75 hover:bg-[#062a72] hover:shadow-[0_15px_40px_rgba(74,164,244,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#4aa4f4]/55 bg-gradient-to-br from-[#c9e8ff] via-[#4aa4f4] to-[#0b4ea8] text-2xl shadow-[0_5px_15px_rgba(74,164,244,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f74d6]/45 bg-[#010c26]/95 p-6 text-left text-base leading-relaxed text-[#d3e6ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#1f74d6]/70 hover:bg-[#062a72] hover:shadow-[0_15px_40px_rgba(31,116,214,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#1f74d6]/60 bg-gradient-to-br from-[#5ee7ff] via-[#1f74d6] to-[#062a72] text-2xl shadow-[0_5px_15px_rgba(31,116,214,0.28)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
