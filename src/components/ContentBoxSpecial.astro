---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The left icon plate is gold and the right one brushed silver — the same
// two-tone split the SUPERMAX168 wordmark uses, applied to the pair of halves.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d2a43b]/40 bg-[#0d0904]/92 p-6 text-[#f3e6c8] shadow-[0_10px_30px_rgba(210,164,59,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f9e38b]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ecc964] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#d2a43b]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff8e2] via-[#e3e3e4] to-[#ba8219] shadow-[0_0_10px_rgba(236,201,100,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f9e38b] via-[#fff8e2] to-[#e3e3e4] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#d2a43b]/40 bg-[#030201]/95 p-6 text-left text-base leading-relaxed text-[#f3e6c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#f9e38b]/70 hover:bg-[#1b140b] hover:shadow-[0_15px_40px_rgba(249,227,139,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ecc964]/55 bg-gradient-to-br from-[#fff8e2] via-[#ecc964] to-[#ba8219] text-2xl shadow-[0_5px_15px_rgba(236,201,100,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#d2a43b]/45 bg-[#030201]/95 p-6 text-left text-base leading-relaxed text-[#f3e6c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#e3e3e4]/70 hover:bg-[#1b140b] hover:shadow-[0_15px_40px_rgba(227,227,228,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e3e3e4]/60 bg-gradient-to-br from-[#e3e3e4] via-[#d2a43b] to-[#ba8219] text-2xl shadow-[0_5px_15px_rgba(227,227,228,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
