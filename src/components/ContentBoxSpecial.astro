---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// Those two slot wrappers are the ones that must STAY: they are flex siblings of
// the icon box, so deleting them would turn each <p> into its own flex item
// beside the icon. Do not flatten them.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant is the one that fits a docx
// section whose single paragraph splits cleanly in two.
//
// หวยเฮง24 (รอบแดงเข้ม-ทอง 2026-10-01): สองครึ่งบนการ์ดแดงเข้ม #2e0707 แยกกันด้วยสอง
// โทนของโลโก้ — ป้ายไอคอนซ้ายไล่จากทองอ่อน #fdea83 ลงทองสว่าง #fbdc64 ไปหาทองกลาง
// #bd7c13 (ตาม "เฮง24" ที่เป็นทองไล่เฉด และตามเหรียญทองกับเงาปราสาททองในแบนเนอร์)
// ส่วนป้ายขวาไล่จากแดงสว่าง #c01616 ลงแดงแบรนด์ #8b0302 ไปจบที่แดงลึก #5a0202
// (ตามคำว่า "หวย" ที่เป็นแดงเลือดนกเงาวาว และตามพื้นผ้าซาตินแดงของงานอาร์ต) คู่นี้จึงอ่าน
// เป็นทองนำ แดงตาม ตามงานอาร์ตจริง ไม่ใช่สีเดียวซ้ำสองครั้ง ตัวอักษรบนป้ายทองใช้หมึกเข้ม
// #2a0606 เพราะทองเป็นพื้นสว่าง ส่วนป้ายแดงเป็นพื้นเข้มจึงใช้ทองอ่อน #fdea83 กรอบและ
// เส้นไรผมเป็นแดงกลาง #720202 แถวในตกลงไปที่พื้นเพจ #1a0505 เนื้อความ #f6e6cf
// (BRAND_TEXT) — ชุดเขียวนีออน-โครเมียมของ CK268 ที่ค้างในไฟล์นี้ (#8bfc13 #c9ff8f
// #1a7a08 #e8f0e6 #b9c9b4 #8fa38a #030703 #071007 #0b160b #d5e6cd) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#720202] bg-[#2e0707]/92 p-6 text-[#f6e6cf] shadow-[0_10px_30px_rgba(20,3,3,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a52a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e0a52a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#720202] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdea83] via-[#e0a52a] to-[#8b0302] shadow-[0_0_10px_rgba(224,165,42,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdea83] via-[#e0a52a] to-[#8b0302] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#720202] bg-[#1a0505]/95 p-6 text-left text-base leading-relaxed text-[#f6e6cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#e0a52a]/70 hover:bg-[#3d0808] hover:shadow-[0_15px_40px_rgba(224,165,42,0.30)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e0a52a]/65 bg-gradient-to-br from-[#fdea83] via-[#fbdc64] to-[#bd7c13] text-2xl text-[#2a0606] shadow-[0_5px_15px_rgba(224,165,42,0.40)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#720202] bg-[#1a0505]/95 p-6 text-left text-base leading-relaxed text-[#f6e6cf] transition-all duration-300 hover:-translate-y-2 hover:border-[#c01616]/80 hover:bg-[#3d0808] hover:shadow-[0_15px_40px_rgba(192,22,22,0.35)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c01616]/70 bg-gradient-to-br from-[#c01616] via-[#8b0302] to-[#5a0202] text-2xl text-[#fdea83] shadow-[0_5px_15px_rgba(192,22,22,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
