---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7c3aed]/25 bg-[#0f0818]/92 p-6 text-[#f0e9fc] shadow-[0_10px_30px_rgba(124,58,237,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#7c3aed]/50 md:p-10">
    <div aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#7c3aed] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7c3aed]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a78bfa] to-[#4c1d95] shadow-[0_0_10px_rgba(124,58,237,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#a78bfa] via-[#e5e7eb] to-[#7c3aed] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7c3aed]/20 bg-[#150c24]/95 p-6 text-left text-base leading-relaxed text-[#f0e9fc] transition-all duration-300 hover:-translate-y-2 hover:border-[#7c3aed]/50 hover:bg-[#1c1030]/90 hover:shadow-[0_15px_40px_rgba(124,58,237,0.28)]">
        <div aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7c3aed]/30 bg-gradient-to-br from-[#a78bfa] via-[#7c3aed] to-[#4c1d95] text-2xl shadow-[0_5px_15px_rgba(124,58,237,0.28)]">
          💰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#9ca3af]/20 bg-[#150c24]/95 p-6 text-left text-base leading-relaxed text-[#f0e9fc] transition-all duration-300 hover:-translate-y-2 hover:border-[#9ca3af]/50 hover:bg-[#1c1030]/90 hover:shadow-[0_15px_40px_rgba(156,163,175,0.28)]">
        <div aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#9ca3af]/50 bg-gradient-to-br from-[#e5e7eb] via-[#9ca3af] to-[#9ca3af] text-2xl shadow-[0_5px_15px_rgba(156,163,175,0.3)]">
          🏧
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
