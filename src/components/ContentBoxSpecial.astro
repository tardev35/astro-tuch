---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💬", iconright = "🛡️" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
// ⚠️ These two <article> rows are the documented exception to the flattening
// sweep: they do real layout beside the icon box and cannot be hoisted away.
// Do NOT flatten them, and do not move the slot inside the icon box.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose one
// long paragraph splits cleanly in two. รอบนี้หน้าแรกให้มันถือ **docx H2 §6**
// ("ระบบฝากถอน … ธนาคารชั้นนำและวอลเลท" — content.txt บรรทัด 14): ซีกซ้ายคือช่องทาง
// ทำรายการที่บรีฟระบุ (ธนาคารและวอลเลท · รูปแบบการชำระเงินที่รองรับ · ยอดขั้นต่ำ ·
// ระยะเวลาดำเนินการ · เงื่อนไขการถอนเงิน) ซีกขวาคือสิ่งที่บรีฟสั่งให้ทำเมื่อรายการ
// ล่าช้าหรือสถานะไม่ถูกต้อง (เก็บหลักฐานการทำรายการ · ติดต่อเจ้าหน้าที่ทางการ ·
// ไม่ส่งรหัสผ่านหรือรหัส OTP)
// หน้าแรกส่งไอคอน 🏦 / 🛡️ มาเอง ค่าตั้งต้น 💬 / 🛡️ เป็นแค่ตัวกันหลง ทั้งคู่อยู่ใน
// กล่อง aria-hidden จึงไม่เคยเป็นส่วนหนึ่งของ accessible name
//
// นินจา168 (รอบ **ฟ้าไซยานนำ · เหลืองมะนาวเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19) — พาเลตต์ตาม brand-spec §2
// ⚠️ พื้นเพจ **ดำสนิท #000000** (bg.json) ลำดับความลึก: #0c2a3d ยก / #071a28 กลาง
// (การ์ดใบนี้) / #030e16 จม (สองซีก) / #000000 พื้น
//
// จังหวะรูปทรงของใบนี้: นั่งระหว่าง ContentBoxSevenThreeNeumorphism (§5 แผ่นนูน
// มุมกลมผิวจม หัวข้อไล่เฉดพร้อมแถบตั้ง) กับ ContentBox ตัวฐาน (§7 มุมกลม 3xl ผิวยก
// หัวข้อไล่เฉดใต้เส้นคาด) จึงเป็นใบ **"ผิวกลาง กรอบน้ำเงินลึก สองซีกที่ตกลงไปอยู่
// ผิวจม"** และเป็นใบเดียวของหน้าที่มี **การ์ดซ้อนการ์ด** — ความลึกสามชั้นในบล็อกเดียว
// ⚠️ หัวข้อของใบนี้เป็นใบเดียวที่ **คร่อมเส้นคู่บน-ล่าง** (border-y) ไม่ใช่ขีดใต้
// แถบตั้ง แผ่นป้าย หรือเส้นคาดเหนือหัวข้อแบบใบอื่น
// หัวข้อไล่ ฟ้าน้ำแข็ง #a9e9ff → ฟ้าแบรนด์ #32bcfb → เหลืองมะนาว #fef54b ("ฟ้าไต่
// ขึ้นเหลือง") ซึ่งไม่ซ้ำลำดับกับกล่อง docx ใบอื่นบนหน้าเดียวกันสักตัว ⚠️ ไล่เฉดนี้
// ถูก bg-clip-text จึง **คือพิกเซลของตัวอักษร** ทุกสต็อปต้องถือตัวอักษรได้ตาม §2
// (11.3 / 7.1 / 12.7 บนผิวการ์ด) — ห้ามเอา #07335f หรือ #6b5c10 มาเป็นสต็อป
// สองป้ายไอคอนเป็น **ขั้วกลับของกันเอง** ตามสองฮิวของแบรนด์: ซ้ายเป็น **แผ่นถมสว่าง**
// ไล่ฟ้าน้ำแข็ง #a9e9ff → ฟ้าแบรนด์ #32bcfb บนหมึก #041019 (§2 ระบุว่า #041019
// เป็นหมึกตัวเดียวที่วางบนพื้นถมฟ้า/เหลืองได้ — 8.9:1 บน #32bcfb และสูงกว่านั้นบน
// #a9e9ff **ห้ามพลิกแผ่นสว่างไปใช้หมึกสว่าง**) ส่วนขวาเป็น **แผ่นมืดทึบ** ไล่น้ำเงิน
// ลึก #07335f → ผิวจม #030e16 ในกรอบทองลึก #6b5c10 บนไอคอนเหลืองมะนาว #fef54b —
// ตรงกับงานศิลป์ที่ชูริเคนฟ้าวางคู่เหรียญทอง
// สองซีกยังต่างกันตั้งแต่ขอบ: ซีกซ้ายกรอบฟ้าแบรนด์ ซีกขวากรอบทองลึก
// เส้นคาดหัวการ์ดเป็นฟ้าน้ำแข็งโปร่ง เนื้อความ #dceefc (= BRAND_TEXT) — 13:1 บนผิว
// กลาง และสูงกว่านั้นบนผิวจมของสองซีก
// §2 ห้าม #07335f (1.4:1) และ #6b5c10 (1.9:1) ถือตัวอักษรทุกขนาด — ที่นี่อยู่ที่ขอบ
// ไล่เฉดของแผ่นมืด เส้นคั่น และออราเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้นคือฟ้าและทอง**
// เพราะรอบที่แล้วก็ฟ้านำ+ทองรองบนดำ ฟ้ารอบนี้ #32bcfb ไม่ใช่ 2f9ff5 / a8dcff /
// 0b3f78 (สบายเบท168) 0360f3 / 0292fb / 6ec8ff (TSDET911) 0a84e0 (HI59) 04225b หรือ
// 2563eb · เหลืองรอบนี้ #fef54b ไม่ใช่ ffc82e (สบายเบท168) ffd84d (ถอนชัวร์168)
// fcd434 / ffeaa0 (มีโชค168) f7c92b / ffe6a3 (ขวัญใจ168) f0b429 / ffdc8c (รับตัง168)
// e3b23c (สมหวัง168) dfa310 e5a81b e2b33f f2c230 fad354 หรือ f5c518
// ชุดของถอนชัวร์168 ที่เพิ่งอยู่ในไฟล์นี้ (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a
// 6d0b3f 6b4708 2a0617 fdeaf5) ชุดของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52
// 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5
// c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดม่วงราชาของ
// KMD88 (7505cc b453ff c07cff d9b8ff 3a0565 2c0349 ece2f8) และชุดน้ำเงินไฟฟ้าของ
// TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7) ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ม่วง/ไวโอเลต เขียว ส้ม แดง โรสโกลด์ และเงิน/โครเมียม**
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#07335f]/55 bg-[#071a28]/95 p-6 text-[#dceefc] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#32bcfb]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#a9e9ff] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 border-y border-[#6b5c10] py-4">
          <HeadingTag class="bg-gradient-to-r from-[#a9e9ff] via-[#32bcfb] to-[#fef54b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#32bcfb]/40 bg-[#030e16]/95 p-6 text-left text-base leading-relaxed text-[#dceefc] transition-all duration-300 hover:-translate-y-2 hover:border-[#32bcfb]/80 hover:bg-[#071a28] hover:shadow-[0_15px_40px_rgba(50,188,251,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#07335f] bg-gradient-to-br from-[#a9e9ff] to-[#32bcfb] text-2xl text-[#041019] shadow-[0_5px_15px_rgba(50,188,251,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b5c10] bg-[#030e16]/95 p-6 text-left text-base leading-relaxed text-[#dceefc] transition-all duration-300 hover:-translate-y-2 hover:border-[#fef54b]/70 hover:bg-[#071a28] hover:shadow-[0_15px_40px_rgba(254,245,75,0.2)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#6b5c10] bg-gradient-to-br from-[#07335f] to-[#030e16] text-2xl text-[#fef54b] shadow-[0_5px_15px_rgba(0,0,0,0.7)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#6b5c10] pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
