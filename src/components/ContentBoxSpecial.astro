---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them. These
// two wrapper <div>s are the sanctioned kind that must stay — they are the flex
// siblings of the icon plate, not carriers of inheritable text classes.
//
// MHEEPOOH168 palette: two identity hues, gold and red, on a near-black card.
// The two halves are told apart by which hue leads the icon plate — the left
// plate runs bright gold (#fced74) down into deep gold (#8a5a06), the right one
// runs bright red (#c4161c) down into the card red (#540202) — so the pair
// reads as the logo's gold-on-red rather than as one colour twice. The previous
// brand's brown-gold is gone.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5b70a]/35 bg-[#2b0101]/92 p-6 text-[#f1dccd] shadow-[0_10px_30px_rgba(0,0,0,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#fced74]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f5b70a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5b70a]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fced74] via-[#f5b70a] to-[#c4161c] shadow-[0_0_10px_rgba(245,183,10,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a5a06]/50 bg-[#120303]/95 p-6 text-left text-base leading-relaxed text-[#f1dccd] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5b70a]/70 hover:bg-[#2b0101] hover:shadow-[0_15px_40px_rgba(245,183,10,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5b70a]/60 bg-gradient-to-br from-[#fced74] via-[#f5b70a] to-[#8a5a06] text-2xl shadow-[0_5px_15px_rgba(245,183,10,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8f0505]/60 bg-[#120303]/95 p-6 text-left text-base leading-relaxed text-[#f1dccd] transition-all duration-300 hover:-translate-y-2 hover:border-[#c4161c]/70 hover:bg-[#2b0101] hover:shadow-[0_15px_40px_rgba(196,22,28,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c4161c]/60 bg-gradient-to-br from-[#c4161c] via-[#8f0505] to-[#540202] text-2xl shadow-[0_5px_15px_rgba(196,22,28,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
