---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// The left icon plate is emerald and the right one chrome-white — the same
// two-tone split the TTN69 logo uses (emerald ridge under a snow-capped peak),
// applied to the pair of halves.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#02b961]/40 bg-[#061309]/92 p-6 text-[#d5e6da] shadow-[0_10px_30px_rgba(2,185,97,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#4ce68f]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#02b961] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#02b961]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c9f7dd] via-[#e4ece7] to-[#046b3a] shadow-[0_0_10px_rgba(2,185,97,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#4ce68f] via-[#f1faf4] to-[#e4ece7] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#02b961]/40 bg-[#020805]/95 p-6 text-left text-base leading-relaxed text-[#d5e6da] transition-all duration-300 hover:-translate-y-2 hover:border-[#4ce68f]/70 hover:bg-[#0c2214] hover:shadow-[0_15px_40px_rgba(76,230,143,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#02b961]/55 bg-gradient-to-br from-[#c9f7dd] via-[#02b961] to-[#046b3a] text-2xl shadow-[0_5px_15px_rgba(2,185,97,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#02b961]/45 bg-[#020805]/95 p-6 text-left text-base leading-relaxed text-[#d5e6da] transition-all duration-300 hover:-translate-y-2 hover:border-[#e4ece7]/70 hover:bg-[#0c2214] hover:shadow-[0_15px_40px_rgba(228,236,231,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e4ece7]/60 bg-gradient-to-br from-[#e4ece7] via-[#02b961] to-[#046b3a] text-2xl shadow-[0_5px_15px_rgba(228,236,231,0.24)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
