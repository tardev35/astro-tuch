---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// THE88 palette (แดง-ทอง 2026-09-23): สองครึ่งบนการ์ดพื้นแดงเข้ม #2d0908 แยกกัน
// ด้วยคู่สีประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากแดงสด #dd0503 ลงแดงแบรนด์ #a40201 ไปหา
// แดงเข้ม #6b0302 (ตัวอักษร THE ที่เป็นแดงเงาขอบทอง) ส่วนป้ายขวาไล่จากทองอ่อน
// #ffe7a6 ลงทอง #f2c14e ไปหาทองลึก #8a6524 (เลข 88 ที่เป็นครีมขอบทอง) คู่นี้จึง
// อ่านเป็น แดงคู่ทอง ตามโลโก้จริง ไม่ใช่สีเดียวซ้ำสองครั้ง ชมพู-เหลืองของ ABM96
// กับชมพูมาเจนตาของ WY88 ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b0302]/35 bg-[#2d0908]/92 p-6 text-[#f7e3dd] shadow-[0_10px_30px_rgba(28,5,4,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#a40201]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f2c14e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b0302]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] shadow-[0_0_10px_rgba(242,193,78,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b0302]/45 bg-[#1c0504]/95 p-6 text-left text-base leading-relaxed text-[#f7e3dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#a40201]/70 hover:bg-[#2d0908] hover:shadow-[0_15px_40px_rgba(164,2,1,0.45)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a40201]/60 bg-gradient-to-br from-[#dd0503] via-[#a40201] to-[#6b0302] text-2xl shadow-[0_5px_15px_rgba(164,2,1,0.45)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#4a0d0b]/80 bg-[#1c0504]/95 p-6 text-left text-base leading-relaxed text-[#f7e3dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2c14e]/60 hover:bg-[#2d0908] hover:shadow-[0_15px_40px_rgba(242,193,78,0.5)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f2c14e]/50 bg-gradient-to-br from-[#ffe7a6] via-[#f2c14e] to-[#8a6524] text-2xl shadow-[0_5px_15px_rgba(255,231,166,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
