---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// PGW44 palette (ทอง-เขียว-ดำ 2026-09-27): สองครึ่งบนการ์ดดำอมเขียว #0b1408 แยกกัน
// ด้วยคู่สีประจำเวิร์ดมาร์ก — ป้ายไอคอนซ้ายไล่จากทองอ่อน #fff89a ลงทองแบรนด์ #fde90e
// ไปหาทองลึก #a86f02 (ตัว P ขอบทองกับตัว G ทอง) ส่วนป้ายขวาไล่จากเขียวสว่าง #5df53a
// ลงเขียวแบรนด์ #35d413 ไปจบที่เขียวลึก #0c6d10 (ตัว W เขียวกับเลข 44 ที่ไล่ไปเขียว)
// คู่นี้จึงอ่านเป็น ทองนำ เขียวตาม ตามโลโก้จริง ไม่ใช่สีเดียวซ้ำสองครั้ง ตัวอักษรบน
// ป้ายทองใช้หมึกเข้ม #10160a ตามกฎคอนทราสต์ที่ว่าตัวอักษรบนพื้นสว่างต้องเกือบดำ กรอบ
// และเส้นไรผมเป็นเขียวลึก #1f5a16 เนื้อความ #e9f0dd (BRAND_TEXT) — ชุดเขียวมรกต-
// โครเมียมของ BRAZIL999 (#22c55e #7cf25c #b6ff9c #04380c #1c5a26 #123a18 #0a1a0c
// #040a05 #aab4bf #f1f5f9 #6b7580 #dfeadd) ออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1f5a16]/70 bg-[#0b1408]/92 p-6 text-[#e9f0dd] shadow-[0_10px_30px_rgba(3,6,2,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde90e]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fde90e] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1f5a16]/60 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff89a] via-[#fde90e] to-[#35d413] shadow-[0_0_10px_rgba(253,233,14,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff89a] via-[#f5c518] to-[#35d413] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f5a16]/70 bg-[#050803]/95 p-6 text-left text-base leading-relaxed text-[#e9f0dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#fde90e]/70 hover:bg-[#101a0b] hover:shadow-[0_15px_40px_rgba(253,233,14,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fde90e]/65 bg-gradient-to-br from-[#fff89a] via-[#fde90e] to-[#a86f02] text-2xl text-[#10160a] shadow-[0_5px_15px_rgba(253,233,14,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f5a16]/70 bg-[#050803]/95 p-6 text-left text-base leading-relaxed text-[#e9f0dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#5df53a]/70 hover:bg-[#101a0b] hover:shadow-[0_15px_40px_rgba(53,212,19,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#35d413]/65 bg-gradient-to-br from-[#5df53a] via-[#35d413] to-[#0c6d10] text-2xl text-[#10160a] shadow-[0_5px_15px_rgba(53,212,19,0.34)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
