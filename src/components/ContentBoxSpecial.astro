---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3f6b23]/55 bg-[#060a04]/92 p-6 text-[#dbe5d3] shadow-[0_10px_30px_rgba(98,174,45,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#62ae2d]/60 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#62ae2d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#3f6b23]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8e37c] to-[#2f6a0c] shadow-[0_0_10px_rgba(98,174,45,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f2f8ec] via-[#8fd45e] to-[#d9b95c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#3f6b23]/50 bg-[#0d1408]/95 p-6 text-left text-base leading-relaxed text-[#dbe5d3] transition-all duration-300 hover:-translate-y-2 hover:border-[#62ae2d]/60 hover:bg-[#1a2c0d]/90 hover:shadow-[0_15px_40px_rgba(98,174,45,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#62ae2d]/45 bg-gradient-to-br from-[#a8e37c] via-[#62ae2d] to-[#2f6a0c] text-2xl shadow-[0_5px_15px_rgba(98,174,45,0.28)]">
          ⚡
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a6320]/45 bg-[#0d1408]/95 p-6 text-left text-base leading-relaxed text-[#dbe5d3] transition-all duration-300 hover:-translate-y-2 hover:border-[#d9b95c]/55 hover:bg-[#1c1607]/90 hover:shadow-[0_15px_40px_rgba(217,185,92,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#d9b95c]/50 bg-gradient-to-br from-[#f0dca0] via-[#d9b95c] to-[#8a6320] text-2xl shadow-[0_5px_15px_rgba(217,185,92,0.3)]">
          🕐
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
