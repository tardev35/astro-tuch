---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7a0304]/60 bg-[#0b0402]/92 p-6 text-[#e9d6ac] shadow-[0_10px_30px_rgba(226,6,10,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2060a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fbbf14] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7a0304]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbbf14] to-[#8a5a02] shadow-[0_0_10px_rgba(250,226,30,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#fbbf14] to-[#e2060a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#7a0304]/55 bg-[#240803]/95 p-6 text-left text-base leading-relaxed text-[#e9d6ac] transition-all duration-300 hover:-translate-y-2 hover:border-[#e2060a]/70 hover:bg-[#240803] hover:shadow-[0_15px_40px_rgba(226,6,10,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e2060a]/45 bg-gradient-to-br from-[#ff4b18] via-[#e2060a] to-[#7a0304] text-2xl shadow-[0_5px_15px_rgba(226,6,10,0.28)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#c2a878]/45 bg-[#240803]/95 p-6 text-left text-base leading-relaxed text-[#e9d6ac] transition-all duration-300 hover:-translate-y-2 hover:border-[#fbbf14]/60 hover:bg-[#240803] hover:shadow-[0_15px_40px_rgba(250,226,30,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fbbf14]/50 bg-gradient-to-br from-[#fae21e] via-[#fbbf14] to-[#8a5a02] text-2xl shadow-[0_5px_15px_rgba(250,226,30,0.3)]">
          ⚖️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
