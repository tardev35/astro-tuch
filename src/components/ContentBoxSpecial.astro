---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "📝", iconright = "🔍" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// หวยพยัคฆ์ palette (กรมท่า-ทอง): สองครึ่งบนการ์ดพื้นยก #0f2149 แยกกันด้วยสอง
// สีประจำโลโก้ — ป้ายไอคอนซ้ายไล่จากทองสว่าง #fdf5a4 ลงทองหลัก #fadb6c ไปหาทอง
// บรอนซ์ #ab6d13 (คำว่า พยัคฆ์) ส่วนป้ายขวาไล่จากเงิน #e8eef8 ลงสีรอง #9fb0d0
// ไปหาน้ำเงินคั่น #1c3566 (คำว่า หวย) คู่นี้จึงอ่านเป็น เงินบนทอง ตามโลโก้จริง
// ไม่ใช่สีเดียวซ้ำสองครั้ง ม่วง-ทองของรอบก่อนออกทั้งหมด
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ab6d13]/35 bg-[#0f2149]/92 p-6 text-[#dbe4f7] shadow-[0_10px_30px_rgba(3,11,28,0.72)] backdrop-blur-xl transition-all duration-500 hover:border-[#fadb6c]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fadb6c] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ab6d13]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] shadow-[0_0_10px_rgba(250,219,108,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#e8eef8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#ab6d13]/45 bg-[#08152f]/95 p-6 text-left text-base leading-relaxed text-[#dbe4f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#fadb6c]/70 hover:bg-[#0f2149] hover:shadow-[0_15px_40px_rgba(250,219,108,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fadb6c]/60 bg-gradient-to-br from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] text-2xl shadow-[0_5px_15px_rgba(250,219,108,0.35)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1c3566]/80 bg-[#08152f]/95 p-6 text-left text-base leading-relaxed text-[#dbe4f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#e8eef8]/60 hover:bg-[#0f2149] hover:shadow-[0_15px_40px_rgba(232,238,248,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e8eef8]/50 bg-gradient-to-br from-[#e8eef8] via-[#9fb0d0] to-[#1c3566] text-2xl shadow-[0_5px_15px_rgba(232,238,248,0.22)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
