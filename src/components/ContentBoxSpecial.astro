---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🏦", iconright = "🧾" } = Astro.props;
const hasActions = Astro.slots.has("actions");

// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
//
// `actions` is a THIRD slot and it sits below the grid at full width rather than
// inside either half — a call-to-action pair that belongs to the whole section,
// not to one of its two paragraphs. It renders nothing at all when the page does
// not pass it, so every other caller is unaffected.
//
// The `title` header is the ONLY heading this box emits — the two halves carry
// no label of their own, which is why this variant fits a docx section whose two
// paragraphs split cleanly in two. On the KINGKONG555 homepage it holds docx
// H2 #6, the ฝากถอนเข้าบริษัทโดยตรง pair: the left paragraph is what the system
// shows before a transaction is confirmed, the right one is what the claim
// "ปลอดภัย ไม่ผ่านม้า" needs behind it.
//
// Default icons are 🏦 / 🧾 — a bank transfer and a transaction record, which is
// exactly what those two paragraphs are about. Both render inside an aria-hidden
// box, so neither is ever part of an accessible name.
//
// KINGKONG555 (รอบเขียวป่า-ทองมงกุฎ 2026-10-09, brand-spec §2):
// สองครึ่งบนการ์ดกระจกผิวยก #14380a รอบนี้แบรนด์มีสองฮิวจริง — เขียวมะนาวกับทองมงกุฎ —
// สองป้ายไอคอนจึงแยกกันด้วย "ทอง vs เขียว" ไม่ใช่ด้วยระดับความสว่างของโลหะเดียว:
// ป้ายซ้ายเป็นแผ่นทองทึบ ไล่เขียวครีม #e9f7d6 → ทองสว่าง #ffe066 → ทองมงกุฎ #f2c230
// บนหมึกเขียวเข้มสุด #06220a (10:1 ขึ้นไปทั้งไล่เฉด — §2 ห้ามพลิกแผ่นทองไปใช้หมึกสว่าง)
// ส่วนป้ายขวาเป็นแผ่นใบไม้เขียวทึบ ไล่เขียวกลาง #2f8c07 → เขียวลึก #1a5c04 ในกรอบเขียวสด
// #5cc211 บนไอคอนทองสว่าง #ffe066 — สองป้ายจึงเป็นขั้วกลับของกันเอง ทั้งพื้นและหมึก และ
// ตรงกับโลโก้ที่เป็นกอริลลาเขียวสวมมงกุฎทอง
// สองครึ่งตกลงไปที่ผิวลึกสุด #051400 ครึ่งซ้ายเป็นกรอบทองมงกุฎ ครึ่งขวาเป็นกรอบเขียวสด
// ให้ต่างกันตั้งแต่ขอบ เส้นคาดหัวการ์ดเป็นทองมงกุฎโปร่ง
// หัวข้อไล่เขียวครีม #e9f7d6 → ทองมงกุฎ #f2c230 → เขียวมะนาว #8ce023 ซึ่งไม่ซ้ำลำดับกับ
// กล่องอื่นบนหน้าเดียวกันสักตัว
// เนื้อความ #e9f7d6 (= BRAND_TEXT) — 11:1 บนผิวยก และ 17.6:1 บนผิวลึกสุดของสองครึ่ง
//
// ชุดแดงแล็กเกอร์-ทองของ PIGPG ที่เคยค้างในไฟล์นี้ (#d4200d #a30303 #f5b61d #ffd87a
// #fdf9e4 #b07a06 #6b0402 #3a0d07 #2a0806 #120302 #fdeedd rgba(245,182,29,α)
// rgba(212,32,13,α)) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #7a1fc4 #fbe455 #efe6ff
// #ffd23d #5b1a75 #c98a05 #1e0a3c #0a0117 #ece2ff) ชุดมรกต-ทองของ KOON234 (#0a6b32
// #2fbf6a #043d1c #cc920a #f7d14e #fde9a6 #0d2414 #e8f2e6) และชุดตรุษจีนแดง-เขียว-ทอง
// ของ GUCCI168 (#c41115 #e0201f #0b7a33 #2bbf63 #063f1c #d9a521 #ffdf91 #1d0b08
// #f6e3cf) ออกครบทุกจุดแล้ว — KOON234 กับ GUCCI168 ก็มีเขียวคู่ทองเหมือนกัน แต่เป็นคนละ
// ค่าทุกตัว อย่าปล่อยไว้เพราะ "เขียวอยู่แล้ว"
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f2c230]/35 bg-[#14380a]/95 p-6 text-[#e9f7d6] shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2c230]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f2c230] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f2c230]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe066] via-[#f2c230] to-[#1a5c04] shadow-[0_0_10px_rgba(242,194,48,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e9f7d6] via-[#f2c230] to-[#8ce023] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f2c230]/30 bg-[#051400]/95 p-6 text-left text-base leading-relaxed text-[#e9f7d6] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2c230]/75 hover:bg-[#0f2e05] hover:shadow-[0_15px_40px_rgba(242,194,48,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a87a08] bg-gradient-to-br from-[#e9f7d6] via-[#ffe066] to-[#f2c230] text-2xl text-[#06220a] shadow-[0_5px_15px_rgba(242,194,48,0.4)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#5cc211]/45 bg-[#051400]/95 p-6 text-left text-base leading-relaxed text-[#e9f7d6] transition-all duration-300 hover:-translate-y-2 hover:border-[#5cc211]/80 hover:bg-[#0f2e05] hover:shadow-[0_15px_40px_rgba(140,224,35,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#5cc211]/60 bg-gradient-to-br from-[#2f8c07] to-[#1a5c04] text-2xl text-[#ffe066] shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>

    {
      hasActions && (
        <div class="mt-8 border-t border-[#f2c230]/30 pt-6">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
