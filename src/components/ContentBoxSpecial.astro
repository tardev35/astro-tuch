---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#2f7a2a]/55 bg-[#04120a]/92 p-6 text-[#d6e6cc] shadow-[0_10px_30px_rgba(105,181,34,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#69b522]/60 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#69b522] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#2f7a2a]/55 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#9ada4e] to-[#0b5232] shadow-[0_0_10px_rgba(105,181,34,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eefae4] via-[#b6e87a] to-[#dbaa8a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#2f7a2a]/50 bg-[#0b2415]/95 p-6 text-left text-base leading-relaxed text-[#d6e6cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#69b522]/60 hover:bg-[#0a2c18]/90 hover:shadow-[0_15px_40px_rgba(105,181,34,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#69b522]/45 bg-gradient-to-br from-[#9ada4e] via-[#69b522] to-[#0b5232] text-2xl shadow-[0_5px_15px_rgba(105,181,34,0.28)]">
          💬
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#dbaa8a]/40 bg-[#0b2415]/95 p-6 text-left text-base leading-relaxed text-[#d6e6cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#dbaa8a]/60 hover:bg-[#1a1208]/90 hover:shadow-[0_15px_40px_rgba(219,170,138,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#dbaa8a]/50 bg-gradient-to-br from-[#f4e2d2] via-[#dbaa8a] to-[#8a5c3a] text-2xl shadow-[0_5px_15px_rgba(219,170,138,0.3)]">
          🕐
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
