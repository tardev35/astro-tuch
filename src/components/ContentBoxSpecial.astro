---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
// House rule: exactly ONE element per slot. Each <article> is a gap-4 flex row
// whose first item is the icon box, so the slot's single element becomes its
// sibling. Passing two blocks into one slot would put a gap between them.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5e0505]/80 bg-[#070202]/92 p-6 text-[#f2e3c9] shadow-[0_10px_30px_rgba(239,22,34,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdd121]/75 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fdd121] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5e0505]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdd121] to-[#b00a12] shadow-[0_0_10px_rgba(253,209,33,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#ef1622] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#5e0505]/75 bg-[#120404]/95 p-6 text-left text-base leading-relaxed text-[#f2e3c9] transition-all duration-300 hover:-translate-y-2 hover:border-[#fdd121]/75 hover:bg-[#1c0606] hover:shadow-[0_15px_40px_rgba(253,209,33,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fdd121]/55 bg-gradient-to-br from-[#ffe98a] via-[#fdd121] to-[#c99a10] text-2xl shadow-[0_5px_15px_rgba(253,209,33,0.3)]">
          📝
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#b00a12]/55 bg-[#120404]/95 p-6 text-left text-base leading-relaxed text-[#f2e3c9] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2a36]/70 hover:bg-[#1c0606] hover:shadow-[0_15px_40px_rgba(239,22,34,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff2a36]/60 bg-gradient-to-br from-[#ff2a36] via-[#ef1622] to-[#5e0505] text-2xl shadow-[0_5px_15px_rgba(239,22,34,0.34)]">
          🔍
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
