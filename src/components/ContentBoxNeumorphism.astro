---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §7 ของหน้าแรก ("ช่องทางติดต่อแอดมิน <แบรนด์> ทาง LINE
// OFFICIAL 24ชม.") ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 22) หน้าเพจ
// จึงส่ง <p> เดียวเข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลังมี
// มากกว่าหนึ่งย่อหน้า ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
//
// มีโชค168 (รอบ **ทองนำ · ชมพูบานเย็นเป็นฮิวที่สอง · พลัมเข้มเป็นเงา บนดำสนิท**
// 2026-10-18, brand-spec §2): แผ่นนูนคือ **ผิวกลาง #160a12** ที่ถูกกดเงาลงไปหา
// ผิวจม #0b0509 ด้านหนึ่ง และยกแสงขึ้นด้วยพลัมเข้ม #8c0f52 อีกด้านหนึ่ง ความนูนแบบ
// neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สาม — พลัมเข้มเป็น
// เงาของชมพูบานเย็นในพาเลตต์ จึงทำหน้าที่ขอบแสงได้โดยไม่พาฮิวใหม่เข้ามา
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ซึ่ง **มืดกว่า** ทั้งผิวกลาง
// และผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้น ไม่ใช่จมลงไป ลำดับความลึก:
// #24101c ยก / #160a12 กลาง (ใบนี้) / #0b0509 จม / #000000 พื้น
//
// ใบนี้เป็นแผ่นนูนใบเดียวของหน้า และแยกจากกล่องอื่นได้สี่ทาง: **ไม่มี clip-path**
// (ต่างจาก §2 §5 §6 ที่เป็นมุมตัด) **มุม 25px** (ไม่ซ้ำกับ 2xl/3xl ของใบอื่น)
// **ไม่มี hover ที่เปลี่ยนเงา** และ **หัวข้อเป็นชมพูบานเย็น #f5469f ทึบสีเดียว
// จัดกึ่งกลาง** (6.2:1 — large text) ซึ่งเป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลาง
// พร้อมกัน จึงไม่ซ้ำกับใบอื่นสักใบ
// (§1 เป็นหมึกเข้มบนแผ่นถมไล่ชมพู→ทอง · §2 ไล่ ชมพู→ชมพูอ่อน→ทอง · §4 ไล่
// ทอง→ชมพู→ชมพูอ่อน · §5 ไล่ ชมพูอ่อน→ทอง→ชมพู · §6 ไล่ ทอง→ชมพูอ่อน→ชมพู ·
// §8 ไล่ ชมพู→ทอง→ชมพูอ่อน)
// กรอบเป็นพลัมเข้ม #8c0f52 เส้นใต้หัวข้อเป็นทองลึก #7a5508 แบบโปร่ง
// เนื้อความ #f6e4ee (= BRAND_TEXT) — 16.3:1 บนผิวกลาง
// §2 ห้าม #8c0f52 #7a5508 ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่กรอบ เงานูน และ
// เส้นใต้หัวข้อเท่านั้น · #ffeaa0 สงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่
// ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือทอง** แบรนด์รอบก่อนหน้า
// ทันที (ขวัญใจ168) ก็เป็นทองนำบนดำสนิทเหมือนกัน ทองของมันคือ f7c92b ส่วนรอบนี้คือ
// fcd434 และฮิวที่สองของมันคือโรสโกลด์ f2bba5/c98a74 ส่วนรอบนี้คือชมพูบานเย็น f5469f
// ชุดเต็มของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce
// 140c06 241509 160d06 0b0603) ชุดทองไทย-แดงมังกรของรับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดแดง
// มังกร-ทองไทยของสมหวัง168 ที่เคยค้างอยู่ทั้งไฟล์นี้ (fa0513 ffadaf ff5a5f e3b23c
// ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c 140706
// 290f0f) ชุดของ GT66B (fb141b ff5f63 ffa0a2 db040b ec151c 8a0609 3b0405 fdfcfd
// b4bcc2 eceaea 1c0c0b 130c0c 0b0303) ชุดของ TKB55 (fb131b ff8a8f ff4d55 e9eef4
// aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a 1a0304) ชุดน้ำเงินไฟฟ้า
// ของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42
// 040e26 00081f 032dad 04186e 041a43) ชุดทองมังกรของ TND168 (dfa310 ffe4a3 c9b88e
// f0e9dc 8a5c09 43240b) ชุดทองเป็ดของ DUCK1688 (f3bb34 fde464 c8901a f58b2a ffc98a
// f6ecd9) ชุดทองอวกาศของ NAZA168 (fbc134 eef2f8 cfd6e3 9aa6bb) ชุดแดงเสือโคร่งของ
// SUPERSLOTCLUB (e8232a f2b705 ffd666) ชุดม่วงนีออนของ WEPLAY168 (a435f0 5b1a75
// 1e0a3c) และชุดฟ้าสดของ แตกดี168 (0193fb 7bcffb fce604 fff48a 0a1726 07111d dbeafe)
// ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ไม่มีฟ้า/ไซแอน ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียมอมฟ้า ไม่มีโรสโกลด์ และไม่มีแดง**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#8c0f52] bg-[#160a12] p-8 text-left text-base leading-relaxed text-[#f6e4ee] shadow-[10px_10px_20px_#0b0509,-10px_-10px_20px_#8c0f52]">
    {
      title && (
        <header class="mb-6 border-b border-[#7a5508]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#f5469f]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
