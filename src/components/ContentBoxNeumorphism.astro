---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left` and the slot renders as a direct child; do not re-add a content
// wrapper <div>.
//
// ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น: src/pages/ตรวจหวย.astro และ
// src/pages/แนวทาง.astro ซึ่งรอบนี้ (สาธุ168 2026-10-21) **เปิดอยู่** เพราะบรีฟ
// ทั้งฉบับเป็นเว็บหวยล้วน (รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ) ไม่ใช่เว็บคาสิโน
// ⚠️ ข้อยกเว้น "หน้าหวยคงธีม Huay แดง-ทอง" ของ playbook **ไม่ใช้รอบนี้** — ข้อยกเว้น
// นั้นมีไว้กันไม่ให้แบรนด์คาสิโนบังคับฮิวของตัวเองลงหน้าหวย แต่รอบนี้ทั้งเว็บเป็น
// เว็บหวยและใช้ชุด *Huay ทั้งหมดอยู่แล้ว สองหน้านั้นจึงใช้พาเลตเดียวกับทุกหน้า
// ถ้าปล่อยเป็นแดง-ทองเดิมจะกลายเป็น "สีของแบรนด์เก่าค้าง" ไม่ใช่ธีมที่ตั้งใจ
//
// สาธุ168 (brand-spec §2 — เขียวมรกตนำ ทองสัมฤทธิ์รอง **ธีมสว่าง**):
// ไฟล์นี้อยู่ในโซน "เนื้อหา" จึงเป็น **การ์ดสว่าง หมึกเข้ม** ไม่ใช่โครม
//   ผิวการ์ด (ชั้นยก) #ffffff · ชั้นกลาง/อินเซ็ต #e9fbdd · พื้นเพจ #d8ffc7 (bg.json)
//   เนื้อความหมึกเขียวป่า #0c3a16 = 12.9:1 บนผิวการ์ด
//   หัวข้อเขียวเข้ม #0a5f1c = 7.9:1 · ขอบ/ออรา/เส้นใต้หัวข้อเขียวมรกต #0b7d28
// ความนูนแบบ neumorphic ของธีมสว่างกลับทางกับธีมมืด: เงาจมเป็น rgba(12,58,22,α)
// (หมึกของพาเลตเอง ไม่ใช่สีที่สาม) และเงายกเป็น #ffffff ซึ่งอ่านเป็นแสงได้จริง
// เพราะพื้นเพจ #d8ffc7 เข้มกว่าผิวการ์ดขาว ลำดับความลึก: #ffffff ยก /
// #e9fbdd กลาง / #d8ffc7 พื้นเพจ
// ⚠️ **ไม่มีทองสัมฤทธิ์ทั้งสามค่า (#c9cb63 #aeb04a #9ba03c) ในไฟล์นี้** — บนการ์ด
// ขาวได้แค่ 1.7–2.8:1 ตกเกณฑ์ทุกขนาด ทองเป็นสีของโครม (navbar/footer/ticker/feed)
// เท่านั้น และ **ไม่มีเขียวใบตอง #0f9b35** เพราะมันห้ามถือตัวอักษรและห้ามเป็นพื้น
// ของตัวอักษร ซึ่งในการ์ดใบนี้ทุกชั้นมีตัวอักษรอยู่
// ⚠️ #e9fbdd / #d8ffc7 เป็นสีพื้น/เส้น/เงาเท่านั้น ห้ามถือตัวอักษร
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — ทอง/แดงนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้
// ชุดแดง-ทองของเจ้าของเดิมสองรายของไฟล์นี้ออกครบทุกจุดแล้ว: หวยคิง (cd9a2c fdeb7c
// ab7314 f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b) · หวย365 (140203 dc0203 f5282a
// ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) · ชุดแดง-ทอง-เงินโครเมียมที่
// ค้างก่อนหน้านั้น (dc0409 f5363d 8e0206 4b0205 f3c54e 9a6d16 eef0f4 c3c7d1 edeaf0
// 0d0407 17080c 211016) และชุดชมพูบานเย็นของรอบก่อนทันที มีทรัพย์168 (dd1b74
// a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) · ชุดทองน้ำผึ้ง-แดงเลือดหมูของดวงเศรษฐี168
// (f0c878 fff8d8 d9212a 8e1a16 300605 150303 4e2120 2a0608)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน
// ไม่มีม่วง ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0b7d28]/30 bg-white p-8 text-left text-base leading-relaxed text-[#0c3a16] shadow-[12px_12px_26px_rgba(12,58,22,0.16),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#0b7d28]/35 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#0a5f1c]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
