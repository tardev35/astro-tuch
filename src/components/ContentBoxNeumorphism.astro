---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// รอบนี้ไฟล์นี้ถูก render จาก **src/pages/index.astro เพียงหน้าเดียว** และถือ
// **docx H1 §1** ("<แบรนด์> สล็อตนาซ่าเซิร์ฟไทย เล่นง่าย แบบฉบับไทย ฝากถอนเข้า
// บริษัทตรง ไม่ผ่านม้า" — content.txt บรรทัด 3) มาเป็น `title` พร้อม as="h1"
// จึงเดินสาขา text-3xl · หัวข้อมาจาก prop เท่านั้น —
// **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// นาซ่า168 (ดรอป 2026-10-23, .claude/brand-spec-naza168.md §2) —
// **ฟ้าไซยานนำ · น้ำเงินอุลตรามารีนเป็นวัสดุที่สอง · บนถ่านเกือบดำอมน้ำเงิน**
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน 180 องศา** — ร่ำรวย168 เป็น **ธีมสว่าง**
// (bg.json = dbe6ff ฟ้าอ่อน การ์ดขาว หมึกน้ำเงินเข้ม) ส่วนรอบนี้
// bg.json = {"mode":"color","color":"#0d1017"} = **ธีมมืด** การ์ดจึงเป็น
// **ผิวมืด + หมึกสว่าง** **ห้าม "แก้" การ์ดให้สว่างเพราะเห็นว่ารอบก่อนทำแบบนั้น**
// ⚠️ รอบนี้โครม (navbar/footer/ticker/feed/Navfoot) กับเนื้อหา **อยู่ทิศเดียวกัน
// (มืดทั้งคู่)** ต่างจากรอบก่อนที่แยกทิศ — ไม่ต้องดันครึ่งใดครึ่งหนึ่งไปอีกทาง
//
// ลำดับความลึกของรอบนี้: #273449 ยก / **#1b2434 กลาง (การ์ดใบนี้)** /
// #121722 จม / #0d1017 พื้นเพจ (จาก bg.json)
//   เนื้อความ **#e6edf8** (= BRAND_TEXT) = 13.2:1 บนผิวการ์ดใบนี้
//   หัวข้อ **ฟ้าไซยาน #1fd8f0 ทึบ จัดกึ่งกลาง** = 9.0:1 บนผิวการ์ด
//   ขอบการ์ด/เส้นใต้หัวข้อเป็น **#33455f** ซึ่ง §2 ระบุชัดว่า **ห้ามถือตัวอักษร**
//   (1.6:1 บนผิวนี้) ที่นี่มันเป็นเส้นล้วนเท่านั้น
// ความนูนแบบ neumorphic บนธีมมืดกลับทางกับธีมสว่าง: เงาจมเป็น rgba(0,0,0,α) และ
// เงายกเป็น **ผิวยก #273449** ซึ่งสว่างกว่าผิวการ์ด #1b2434 จึงอ่านเป็นแสงได้จริง
// **ห้ามใช้ขาวหรือฟ้าน้ำแข็งเป็นฝั่งสว่าง** — บนพื้นมืดมันจะอ่านเป็นเส้นขอบ
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ และ
// ไม่มีมุมตัด** — ความต่างของมันคือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อทึบจัด
// กึ่งกลาง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ (§2 มุมตัด + ไล่สามสต็อปชิดซ้าย ·
// §3 มุมมน + ไล่สองสต็อปกึ่งกลาง · §4 ไล่สองสต็อปชิดซ้ายไม่มีแถบ · §5 แผ่นนูน
// 10px หัวข้อทึบ #8fd9ec + แถบตั้ง · §6 ป้ายลอย · §7 มุมตัด + ไล่สามสต็อป
// กึ่งกลาง · §8 แถวมุมมนมีราง)
// ⚠️ **#1d4fd8 / #143aa0 ไม่อยู่ในไฟล์นี้เลย** — §2 ให้อุลตรามารีนเป็นพื้นถม/ขอบ/
// ออราเท่านั้น (2.3:1 บนการ์ด) และใบนี้ไม่มีชั้นตกแต่งให้มันอยู่
// ⚠️ **#1fd8f0 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// ⚠️ #273449 / #1b2434 / #121722 / #0d1017 เป็นสีพื้นเท่านั้น **ห้ามถือตัวอักษร**
// rgba() ที่อนุญาตรอบนี้: rgba(31,216,240,α) · rgba(29,79,216,α) ·
// rgba(143,217,236,α) · rgba(11,182,212,α) · rgba(13,16,23,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ฟ้า/ไซยานเคยนำมาแล้วหกแบรนด์
// ในรีโปนี้** (สบาย168 · รวยแทร่168 · นินจา168 · สบายเบท168 · TSDET911 ·
// ร่ำรวย168) **"เจอฟ้าแปลว่าเป็นของรอบนี้" ใช้ไม่ได้เด็ดขาด** ไซยานรอบนี้คือ
// **#1fd8f0 (R31 G216 B240)** และน้ำเงินคือ **#1d4fd8 (R29 G79 B216)**
// ⚠️⚠️ **ร่ำรวย168 เป็นแบรนด์ขาออกและฟ้านำเหมือนกัน = เสี่ยงหลงเหลือสูงสุด**:
// 18a5e2 0d6b9b 0a5176 a9d7f2 16294a dbe6ff eef4ff dce9fb f4e4d3 e4cbb3 111a3f
// 202a66 31408a e9f1ff adc0e4 · rgba(24,165,226,…) rgba(13,107,155,…)
// rgba(244,228,211,…) rgba(22,41,74,…) rgba(169,215,242,…) rgba(17,26,63,…)
// ⚠️⚠️ **ชื่อแบรนด์รอบนี้ซ้ำกับลูกค้าเก่า NAZA168 ตัวละติน ซึ่งเป็นธีมทองอวกาศ-
// เงินโครเมียม — คนละเจ้าโดยสิ้นเชิง** ชุดนั้นห้ามกลับเข้ามา: fbc134 ffe87a
// cf9a18 96690a d9c9a6 cfd6e3 241700 1a1000 432b03 231500
// ชุดที่เคยอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้ว: **เงินทอง168** ทองนำ-ครีมอุ่นบน
// น้ำตาลโอลีฟ (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810 201906
// 2e2512 1b1407 4d3c15) · **สบาย168** (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a
// fdcb0c fefb6b 8a6504 f2fbff dff4fd ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74
// 06293c) · **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472
// 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) · **โปรดี168** (eb0305 9b0a0c
// ff4446 c20305 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 1a0802 401107 fff0e4
// fff4ea ffd1d1) · **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f
// 280b0b 461212 ffeee8 fff1ef ffdbdb) · **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c d8ffc7 e9fbdd)
// ⚠️ ฟ้า/น้ำเงินของแบรนด์อื่นที่ต้องเทียบทีละค่า ห้ามกะด้วยตา: 32bcfb a9e9ff 07335f
// dceefc 071a28 030e16 041019 0c2a3d (นินจา168 — เจ้าของธีมเดิมของ NavbarCyber) ·
// 2cc3fc 6bdcfb 0a7fbd (สบาย168) · 039cfa 0494f5 c3ebfc 04366b (รวยแทร่168) ·
// 2f9ff5 a8dcff d6ecff 0b3f78 (สบายเบท168) · 0360f3 0292fb 6ec8ff 4fb4ff cfdcec
// 9db4d4 dde8f7 (TSDET911) · และทุกเฉดของ purple-* violet-* fuchsia-* indigo-*
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีทอง/เหลือง/ส้มเลยสักเฉด** — ทองในอาร์ตเวิร์ก (เลข 168 ของโลโก้)
// เป็น **วัตถุในภาพ ไม่ใช่สี UI** และทองเป็นฮิวที่แน่นที่สุดของรีโปนี้ (ผ่านมากว่า
// 20 เจ้า รวมถึง NAZA168 ตัวละตินที่ชื่อซ้ำกับรอบนี้) จึงถูกตัดออกจาก UI ทั้งหมด
// เช่นเดียวกับสีผิวนักแสดง ชุดนักบินสีขาว และดวงจันทร์สีเทา
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีเขียว (ยกเว้น LINE green และ
// เขียว success ที่ไฟล์อื่น) ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#33455f]/70 bg-[#1b2434] p-8 text-left text-base leading-relaxed text-[#e6edf8] shadow-[12px_12px_26px_rgba(0,0,0,0.55),-12px_-12px_26px_#273449]">
    {
      title && (
        <header class="mb-6 border-b border-[#33455f]/70 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#1fd8f0]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
