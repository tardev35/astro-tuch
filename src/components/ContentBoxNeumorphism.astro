---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// แตกดี168 (รอบฟ้าสด-เหลืองมะนาวบนกรมท่าเกือบดำ 2026-10-08, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #07111d ที่ถูกกดเงาลงไปหาดำสนิทด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวการ์ดยก #0a1726 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
//
// หัวข้อไล่เหลืองมะนาว #fce604 → เหลืองอ่อน #fff48a → ฟ้าอ่อน #7bcffb คือไล่
// "เหลืองนำลงฟ้า" ซึ่งเป็นทิศตรงข้ามกับ ContentBoxPremium ที่ไล่ฟ้านำเข้าเหลือง
// และคนละชุดกับ ContentBoxTwoNeumorphism จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// กรอบเป็นผิวการ์ดยก #0a1726 เส้นใต้หัวข้อเป็นเหลืองเข้ม #c9a703 แบบโปร่ง
// เนื้อความ #dbeafe (= BRAND_TEXT, 15.4:1 บนผิว #07111d)
//
// การ์ดใบนี้ถือ docx H2 #2 ของหน้าแรก และเป็นกล่องคอลัมน์เดียวที่รับ banner2
// (ภาพสลิปถอนเงินสามใบ) มาเป็นรูปประกอบในสล็อต — หน้าเพจเป็นคนกำหนด max-w ของรูป
// ไม่ใช่ไฟล์นี้ ไฟล์นี้แค่ไม่บังคับความกว้างใดๆ ให้ลูกในสล็อต
//
// ชุดตรุษจีนแดง-เขียวมรกต-ทองของ GUCCI168 ที่เคยค้างในไฟล์นี้ (#140705 #1d0b08
// #d9a521 #ffdf91 #2bbf63 #e0201f #f6e3cf) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0a1726] bg-[#07111d] p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#0a1726]">
    {
      title && (
        <header class="mb-6 border-b border-[#c9a703]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fce604] via-[#fff48a] to-[#7bcffb] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
