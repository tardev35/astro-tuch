---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// UVO88 palette: the soft-relief card reads as a lit emerald slab — the dark
// shadow is the page black (#010905) and the light shadow is deep emerald, so
// the "light source" is the brand hue rather than a neutral glow. This box
// carries the page H1, so its heading gradient is led by the logo's gold
// (#ffe08a -> #f2c230) before falling back into emerald; the H2/H3 boxes keep
// green-led headings so the top of the page is told apart at a glance.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0f9d47]/30 bg-[#051a0e] p-8 text-left text-base leading-relaxed text-[#c8e3d0] shadow-[10px_10px_20px_#010905,-10px_-10px_20px_#0a3b1c]">
    {
      title && (
        <header class="mb-8 border-b border-[#f2c230]/30 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe08a] via-[#f2c230] to-[#57dd8f] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
