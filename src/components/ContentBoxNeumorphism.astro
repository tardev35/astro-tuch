---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// PGW44 (รอบทอง-เขียว-ดำ 2026-09-27): แผ่นนูนคือผิวการ์ดดำอมเขียว #0b1408 ที่ถูกกด
// เงาลงไปหาพื้นเพจ #050803 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวแผงยก #101a0b อีกด้านหนึ่ง
// ความนูนแบบ neumorphic มาจากคู่มืด/สว่างภายในโทนดำอมเขียวเดียวกัน ไม่ใช่จากสีที่สอง
// คอนทราสต์เดียวในการ์ดคือเส้นทองแบรนด์ #fde90e ใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง
// ซึ่งวิ่งทองอ่อน #fff89a → ทองแบรนด์ #fde90e → เขียวแบรนด์ #35d413 ตรงกับโลโก้ที่
// G เป็นทอง W เป็นเขียว และ 44 ไล่จากทองไปเขียว กรอบเป็นทองลึก #a86f02 เนื้อความ
// #e9f0dd (BRAND_TEXT) — ชุดทอง-โครเมียม-ดำของ UWIN33 (#7a5407 #161106 #26200e
// #e0b429 #dfe4ec #fbd564 #ece6d8 #080602) ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a86f02] bg-[#0b1408] p-8 text-left text-base leading-relaxed text-[#e9f0dd] shadow-[10px_10px_20px_#050803,-10px_-10px_20px_#101a0b]">
    {
      title && (
        <header class="mb-6 border-b border-[#fde90e]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fff89a] via-[#fde90e] to-[#35d413] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
