---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#5a0104]/60 bg-[#170406] p-8 text-left text-base leading-relaxed text-[#dfe3ea] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#2a0508]">
    {
      title && (
        <header class="mb-8 border-b border-[#7c0207]/40 pb-4 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-[#eef1f6] via-[#e8121d] to-[#7c0207] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
