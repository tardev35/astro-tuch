---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): แผ่นนูนคือผิวการ์ดแดงเข้ม #1f0a0c ที่ถูก
// กดเงาลงไปหาพื้นเพจ #050505 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวแผงยก #2f1013 อีกด้าน
// หนึ่ง ความนูนแบบ neumorphic มาจากคู่มืด/สว่างภายในโทนแดงเกือบดำเดียวกัน ไม่ใช่
// จากสีที่สอง คอนทราสต์เดียวในการ์ดคือเส้นทองรอง #f3c623 ใต้หัวข้อกับตัวไล่เฉด
// ของหัวข้อเอง ซึ่งวิ่งทองอ่อน #fde79a → ทองรอง #f3c623 → แดงสว่าง #ff2d38 ตาม
// งานอาร์ตที่เป็นเหรียญทองกับมงกุฎทองล้อมบล็อกแดงของโลโก้ กรอบเป็นทองลึก #8a6a0a
// เนื้อความ #f0e2e2 (BRAND_TEXT) — ชุดแดง-ทองของ LOTTO24 ที่ค้างในไฟล์นี้
// (#dc2626 #fc2b2c #fbbf24 #fde68a #a16207 #2a0405 #3b0404 #0a0101 #f6e2e2)
// ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#8a6a0a] bg-[#1f0a0c] p-8 text-left text-base leading-relaxed text-[#f0e2e2] shadow-[10px_10px_20px_#050505,-10px_-10px_20px_#2f1013]">
    {
      title && (
        <header class="mb-6 border-b border-[#f3c623]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fde79a] via-[#f3c623] to-[#ff2d38] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
