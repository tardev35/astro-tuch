---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// THE88 palette (แดง-ทอง 2026-09-23): แผ่นนูนคือพื้นการ์ดแดงเข้ม #2d0908 ที่ถูก
// ไล่แสงจากพื้นเพจแดงเกือบดำ #1c0504 ด้านหนึ่ง และจากพื้นยก #4a0d0b อีกด้านหนึ่ง
// ความนูนจึงมาจากความสว่างภายในโทนแดงเดียวกัน ไม่ใช่จากสีที่สอง คอนทราสต์เดียวใน
// การ์ดคือเส้นทองใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่งวิ่งทองอ่อน #ffe7a6 → ทอง
// #f2c14e → แดงสด #dd0503 ตรงกับโลโก้ที่ตัว THE เป็นแดงขอบทองและเลข 88 เป็นครีม
// ขอบทอง ชมพูมาเจนตา-ทองของ WY88 รอบก่อนออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#6b0302] bg-[#2d0908] p-8 text-left text-base leading-relaxed text-[#f7e3dd] shadow-[10px_10px_20px_#1c0504,-10px_-10px_20px_#4a0d0b]">
    {
      title && (
        <header class="mb-6 border-b border-[#f2c14e]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe7a6] via-[#f2c14e] to-[#dd0503] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
