---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1e4b9e]/70 bg-[#061436] p-8 text-left text-base leading-relaxed text-[#cfdcea] shadow-[10px_10px_20px_#01040f,-10px_-10px_20px_#0a1836]">
    {
      title && (
        <header class="mb-8 border-b border-[#c3ced9]/50 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#eaf3fd] via-[#c3ced9] to-[#0b6cf0] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
