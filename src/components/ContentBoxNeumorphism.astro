---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// 888PARUAY (รอบทอง-เขียวเข้ม-แดง 2026-09-24): แผ่นนูนคือพื้นการ์ดเขียวเข้ม
// #0d2312 ที่ถูกกดเงาลงไปหาพื้นเพจ #07130a ด้านหนึ่ง และยกแสงขึ้นด้วยพื้นยก
// #143a1c อีกด้านหนึ่ง ความนูนจึงมาจากความสว่างภายในโทนเขียวเดียวกัน ไม่ใช่จากสีที่
// สอง คอนทราสต์เดียวในการ์ดคือเส้นทอง #fcdc2b ใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่ง
// วิ่งทองสว่าง #fff6ae → ทองหลัก #fcdc2b → เขียวสด #1fae1c ตรงกับวงแหวนทองที่ล้อม
// เลข 888 สีเขียวบนโลโก้ เนื้อความ #e8e4c6 (BRAND_TEXT) — ชุดทอง-เงินโครเมียมของ
// SAGAME66 (#171006 #0d0903 #2a1d0b #96671a #e8b93f #ffe9a3 #eef3f8 #e3d8c0)
// ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a87d0c] bg-[#0d2312] p-8 text-left text-base leading-relaxed text-[#e8e4c6] shadow-[10px_10px_20px_#07130a,-10px_-10px_20px_#143a1c]">
    {
      title && (
        <header class="mb-6 border-b border-[#fcdc2b]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fff6ae] via-[#fcdc2b] to-[#1fae1c] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
