---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// รอบนี้ไฟล์นี้ถือ **docx H1 §1** ของหน้าแรก ("<แบรนด์>เกมสล็อตแท้ เว็บตรง
// ถูกลิขสิทธิ์ เชื่อถือได้" — content.txt บรรทัด 3 ย่อหน้าเต็มอยู่บรรทัด 4)
// มีแค่ src/pages/index.astro ที่ render ไฟล์นี้รอบนี้ จึงรีเธมในที่ได้
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// หมูบิน168 (ดรอป 2026-10-24, .claude/brand-spec-moobin168.md §2) —
// **ชมพูแคนดี้นำ · พลัมเข้มเป็นหมึก · บนพื้นชมพูพาสเทลสว่าง**
// 🚨🚨 **รอบนี้กลับทิศจากรอบก่อนทั้งเว็บ: จากธีมมืด เป็นธีมสว่าง**
// bg.json = {"mode":"color","color":"#ffe5ff"} = **ชมพูพาสเทลสว่างมาก**
// (รอบก่อน สล็อต168 เป็น 140000 ดำอมแดง) bg.json คือแหล่งเดียวของพื้นเพจ
// → **ห้าม "แก้" การ์ดกลับไปเป็นพื้นมืด** การ์ดมืดบนหมึก #3b0b26 = ตัวอักษร
// หายไปเลย ไม่ใช่แค่จางลง ซึ่งเป็นความผิดพลาดกลับด้านของรอบก่อนเป๊ะ ๆ
//
// ลำดับผิวของรอบนี้: #ffffff ยก (= ฝั่งสว่างของเงานูน) · **#fff0f8 ผิวการ์ด
// (ใบนี้)** · #ffeef7 wash · #ffe5ff พื้นเพจ
//   เนื้อความ **#3b0b26** (= BRAND_TEXT) = 16.2:1 บนผิวการ์ดใบนี้
//   หัวข้อ **ชมพูเข้ม #c2185b ทึบ จัดกึ่งกลาง** = 5.7:1 บนผิวการ์ดใบนี้
//   ขอบการ์ด/เส้นใต้หัวข้อเป็น **#f7bcd9** ซึ่ง §2 ระบุชัดว่า **ห้ามถือตัวอักษร**
//   ที่นี่มันเป็นเส้นล้วนเท่านั้น
// ⚠️ ความนูนแบบ neumorphic บนธีมสว่างกลับทางกับธีมมืด: **เงาฝั่งมืดเป็น
// rgba(194,24,91,α)** และ **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งสว่างกว่าทั้ง
// ผิวการ์ด #fff0f8 และพื้นเพจ #ffe5ff จึงอ่านเป็นแสงได้จริง
// **ห้ามใช้ดำหรือชมพูสดเป็นฝั่งสว่าง** — บนพื้นสว่างมันจะอ่านเป็นเส้นขอบ ไม่ใช่แสง
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ
// และไม่มีแถบตั้งนำหน้า** — ความต่างของมันคือ **เงานูน-จมคู่ 12px/-12px กับ
// หัวข้อทึบจัดกึ่งกลางบนเส้นใต้เต็มความกว้าง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ
// 🚨🚨 **#fa539c บนผิวสว่างได้แค่ 3.2:1 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
// และ **ห้ามถมพื้น #fa539c แล้ววางหมึกขาว** (3.2:1 เหมือนกัน) ใบนี้จึงไม่มี
// #fa539c อยู่เลยแม้แต่จุดเดียว
// ⚠️ **#ffffff #fff0f8 #ffeef7 #ffe5ff #f7bcd9 #ef8dbd ห้ามถือตัวอักษร** ส่วน
// **#3b0b26 (16.8:1 บนขาว) · #7a4463 (7.4:1) · #c2185b (5.9:1) · #8e0f41 (9.2:1)
// ถือตัวอักษรได้**
// ⚠️ **#c2185b ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(250,83,156,α) · rgba(251,140,192,α) ·
// rgba(194,24,91,α) · rgba(59,11,38,α) · rgba(253,198,195,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ชมพูผ่านรีโปนี้มาแล้วหลายเจ้า**
// "เจอชมพูแปลว่าเป็นของรอบนี้" ใช้ไม่ได้เด็ดขาด ชมพูรอบนี้คือ
// **#fa539c (R250 G83 B156)** วัดตรงจาก logo.webp ของดรอปนี้เอง
// ⚠️⚠️ เพื่อนบ้านที่ใกล้ที่สุดคือ **f5469f ของ มีโชค168 ห่างแค่ R5/G13/B3** และ
// **fa63b9 ของ ถอนชัวร์168 ซึ่งมี R=fa ตรงกับรอบนี้เป๊ะ** — เจอค่าไหนก็แปลว่า
// พิมพ์ผิด ไม่ใช่ค่าของรอบนี้ · **8c0f52 (มีโชค168) ห่างจาก #8e0f41 แค่ R2/B17**
// และ **a4186b (มีทรัพย์168) มี 18 อยู่กลางค่าเหมือน #c2185b**
// ⚠️⚠️ **สล็อต168 เป็นแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด** (แดงเจล + มุกอุ่น
// บนดำอมแดง): fb2e33 cb0b0d d81115 b00d11 8a0608 c9060a fa292c f92124 f0e6e4
// c9b9b7 e3d6d4 7d6f6e 140000 0b0000 1c0607 2a0c0d 551c1e — และชุดทองของ รวย168
// ที่เคยอยู่ทั้งใบนี้ (ffd94a e3a712 9d6f06 e8eaee b4b9c2 6b7079 f3ece0 121110
// 1c1a16 070707 000000 3d3425) ออกครบทุกค่าแล้ว
// ⚠️ ชมพู/แดงของแบรนด์อื่นที่ห้ามใช้: dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5
// (มีทรัพย์168 — ⚠️⚠️ **ก็เป็นหมูการ์ตูนชมพูเหมือนกัน แต่เป็นหมูสวมหน้ากากโจร
// บนธีมแมเจนต้าพื้นมืด** ส่วนรอบนี้เป็นหมูมีปีกนางฟ้าบนธีมแคนดี้พื้นสว่าง) ·
// fa63b9 ffb3de (ถอนชัวร์168) · f5469f ff8dc6 8c0f52 (มีโชค168) · ff2e52 e01238
// c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · fa0513 ff5a5f ffadaf
// (สมหวัง168) · b3121b f2bba5 (ขวัญใจ168) · fce2d4 fcd4c3 (หวยคิง — ⚠️ ใกล้
// #fdc6c3) · f41571 ff5ca8 (PUNPRO168) · ff3fa4 ffd1ea (FAH999)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองสักเฉด ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีส้ม
// ไม่มีเขียว (ยกเว้น LINE green และเขียว success ของฟีดถอนเงินซึ่งอยู่ไฟล์อื่น)
// ไม่มีครีม/เบจ/น้ำตาล และไม่มีแรมป์เทาเงินเย็น**
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งต่างจากครีม/งาช้าง (R>G>B)
// และจากขาวอมฟ้า (B>G>R) — ตรวจทีละค่า อย่าตัดสินด้วยสายตา
// ⚠️ **คาร์ดิแกนชมพู เสื้อกล้ามขาว และสีผิวนักแสดงในอาร์ตเวิร์กเป็นวัตถุในภาพ
// ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f7bcd9] bg-[#fff0f8] p-8 text-left text-base leading-relaxed text-[#3b0b26] shadow-[12px_12px_26px_rgba(194,24,91,0.14),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#f7bcd9] pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#c2185b]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
