---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// GUCCI168 (รอบแดง-เขียวมรกต-ทอง บนพื้นเกือบดำอมแดง 2026-10-08, brand-spec §3):
// แผ่นนูนคือผิวการ์ดกลาง #140705 ที่ถูกกดเงาลงไปหาดำสนิทด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวการ์ดยก #1d0b08 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทน
// เดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
//
// หัวข้อไล่ทองอ่อน #ffdf91 → เขียวสว่าง #2bbf63 → แดงสว่าง #e0201f คือไล่
// "ทองขึ้นเขียวลงแดง" ซึ่งเป็นทิศคนละชุดกับ ContentBoxTwoNeumorphism ที่ไล่เขียวนำ
// และกับ ContentBoxPremium ที่ไล่แดงนำ จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// กรอบเป็นผิวการ์ดยก #1d0b08 เส้นใต้หัวข้อเป็นทองแบรนด์ #d9a521 แบบโปร่ง
// เนื้อความ #f6e3cf (= BRAND_TEXT, 15.1:1 บนผิว #140705)
//
// ชุดเขียวนีออน-เงินของ BOOM369 ที่เคยค้างในไฟล์นี้ (#42fb5a #dadcdc #0b231b #07170f
// #f3c44a #cfe9d7 #000000 เป็นเงาฝั่งมืดที่ยังคงไว้) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1d0b08] bg-[#140705] p-8 text-left text-base leading-relaxed text-[#f6e3cf] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1d0b08]">
    {
      title && (
        <header class="mb-6 border-b border-[#d9a521]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffdf91] via-[#2bbf63] to-[#e0201f] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
