---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// 1SS365 (รอบทอง-เงินโครเมียม-ดำ 2026-10-03): แผ่นนูนคือผิวการ์ดอุ่น #1a1710 ที่ถูก
// กดเงาลงไปหาพื้นดำสนิท #050505 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวกรอบอุ่น #2a2115 อีก
// ด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง
// สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน หัวข้อไล่ทองลึก #a87708 → ทองแบรนด์
// #edbb23 → เงินโครเมียม #c8cbce คือไล่ "ทองขึ้นเงิน" ซึ่งเป็นทิศกลับด้านกับ ContentBox
// ตัวกลางที่ไล่ทองอ่อน → ทองแบรนด์ → เงิน จึงคนละจังหวะสายตาบนหน้าเดียวกัน เนื้อความ
// #f0e6d2 (BRAND_TEXT)
//
// ชุดทอง-เงินของ NATO168 ที่เคยค้างในไฟล์นี้ (#17120a #070707 #241a09 #3a2a0d
// #a9761f #edb543 #e6e6e6 #f4ead3) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#2a2115] bg-[#1a1710] p-8 text-left text-base leading-relaxed text-[#f0e6d2] shadow-[10px_10px_20px_#050505,-10px_-10px_20px_#2a2115]">
    {
      title && (
        <header class="mb-6 border-b border-[#edbb23]/45 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#a87708] via-[#edbb23] to-[#c8cbce] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
