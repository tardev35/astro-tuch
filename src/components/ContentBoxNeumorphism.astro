---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#5c0f14]/70 bg-[#120808] p-8 text-left text-base leading-relaxed text-[#e8dadb] shadow-[10px_10px_20px_#040202,-10px_-10px_20px_#2a0f11]">
    {
      title && (
        <header class="mb-8 border-b border-[#5c0f14]/60 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f4f6f8] via-[#ff6470] to-[#c1121f] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
