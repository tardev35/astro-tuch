---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// JOKERSLOTZ palette: the soft-relief card reads as a lit slab of dark maroon.
// The dark shadow is the page base (#0d0101) and the light shadow is a lifted
// maroon (#3d0507), so the slab stays inside the brand's one hue and the only
// contrast in the card is the antique-gold rule under the heading. The heading
// gradient runs gold-light -> crimson -> gold, the jester hat crossing the
// logo's red.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#6d0d0d] bg-[#2b0204] p-8 text-left text-base leading-relaxed text-[#ecdfd0] shadow-[10px_10px_20px_#0d0101,-10px_-10px_20px_#3d0507]">
    {
      title && (
        <header class="mb-6 border-b border-[#bc9b5b]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f2dc9a] via-[#c81e1e] to-[#d9b45e] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
