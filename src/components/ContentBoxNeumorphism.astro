---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H1 (§1) ของหน้าแรก — ย่อหน้าเดียว (content.txt บรรทัด 4) จึงเป็น
// สล็อตเดี่ยวตรงๆ ไม่มีหัวข้อย่อย ไม่มี FeatureHighlights รอบนี้ และไม่มีรูปประกอบใน
// กล่องนี้เลย เพราะดรอปนี้ไม่มี banner2 ของแบรนด์ปัจจุบัน (ไฟล์ banner2/banner3 ที่
// ค้างบนดิสก์เป็นงานอาร์ตของแบรนด์ก่อน ห้าม import — eager import = emit)
//
// TND168 (รอบทองมังกรบนดำสนิท 2026-10-12, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #120c04 ที่ถูกกดเงาลงไปหา **ดำสนิท #000000** ด้านหนึ่ง และ
// ยกแสงขึ้นด้วยผิวการ์ดยก #1b1307 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่
// มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง — ซึ่งรอบนี้ไม่มีสีที่สองอยู่แล้ว แบรนด์นี้
// เป็น **ฮิวเดียวล้วน (ทอง)** ตามเหรียญตรามังกรจีนทองขัดเงาในโลโก้ สีเน้นจึงถูกเก็บไว้
// ที่หัวข้อกับเส้นคั่นใต้หัวข้อเท่านั้น
// ⚠️ พื้นเพจรอบนี้เป็นดำสนิทจริง (bg.json = {"mode":"color","color":"#000000"}) เงา
// ด้านมืดจึงเท่ากับพื้นเพจพอดี ขอบด้านนั้นกลืนหายไปในพื้น — เป็นผลที่ต้องการ
// ลำดับความลึก: #1b1307 ยก / #120c04 กลาง (ใบนี้) / #070502 จม / #000000 พื้น
//
// หัวข้อไล่งาช้างอุ่น #f0e9dc → ทองสว่าง #ffe4a3 → ทองหลัก #dfa310 คือลำดับ
// "งาช้างนำลงทอง" ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ
// (ContentBoxTwoCyberCut ไล่ ทองหลัก→ทราย→สว่าง · ContentBox ไล่ สว่าง→ไฮไลต์→ทองหลัก ·
// ContentBoxSevenThree เป็นทองหลักทึบสีเดียว · ContentBoxSevenThreeFloatingBadge เป็น
// แผ่นทองทึบหมึกเข้ม · ContentBox3ThreePremium ไล่ ทราย→สว่าง→ทองหลัก ·
// ContentBoxPremium ไล่ ทองหลัก→สว่าง→ทราย · Faq ไล่ งาช้าง→ทองหลัก→สว่าง)
// กรอบเป็นผิวการ์ดยก #1b1307 เส้นใต้หัวข้อเป็นทองลึก #8a5c09 แบบโปร่ง
// เนื้อความงาช้างอุ่น #f0e9dc (= BRAND_TEXT, 15.3:1 บนผิว #1b1307 และสูงกว่านั้นบน
// ผิว #120c04 ของใบนี้)
//
// ⚠️ **กับดักรอบนี้คือทอง** — ทองมาแล้วเก้าในสิบเอ็ดรอบหลังสุด "มีทองอยู่แล้ว" จึง
// ไม่ได้พิสูจน์อะไรเลย ต้องเทียบเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดชมพูฮอตพิงก์-ทองของ
// PUNPRO168 รอบก่อน (#f41571 #ff5ca8 #fce343 #ffd94a #f0c3dc #fde7f2 #8a0a45 #4a0426
// #2a0012 #4a1038 #3a0a2a #2e0022 #1c0014) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 ที่เคย
// ค้างอยู่ทั้งไฟล์นี้ (#f3bb34 #fde464 #c8901a #8a5f08 #5c3f04 #f58b2a #ffc98a #a3510c
// #f6ecd9 #d8c69b #1f1709 #171106 #0d0903) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168
// (#fbc134 #ffe87a #cf9a18 #96690a #6b4a05 #eef2f8 #cfd6e3 #9aa6bb #fdf3df #241700
// #231500) ชุดแดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #f2b705 #ffd666
// #c08a0b) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดฟ้าสด-
// เหลืองมะนาวของ แตกดี168 (#0a1726 #07111d #fce604 #fff48a #7bcffb #c9a703 #dbeafe)
// ออกครบทุกจุดแล้ว
// ⚠️ #f3bb34 ของ DUCK1688 (G=187) และ #fad354 ของ 789BETTING (G=211) ไม่ใช่ #dfa310
// (G=163) ของรอบนี้ ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีม่วง/พลัม ไม่มีเงิน/เทา ไม่มีเขียว ไม่มีน้ำเงิน ไม่มีส้ม
// อำพัน และไม่มีแดงเลย** · #8a5c09 กับ #43240b ห้ามถือตัวอักษรทุกขนาด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1b1307] bg-[#120c04] p-8 text-left text-base leading-relaxed text-[#f0e9dc] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1b1307]">
    {
      title && (
        <header class="mb-6 border-b border-[#8a5c09]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f0e9dc] via-[#ffe4a3] to-[#dfa310] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
