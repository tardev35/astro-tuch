---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// LOTTO24 (รอบแดง-ทอง-ดำ 2026-09-28): แผ่นนูนคือผิวการ์ดแดงเกือบดำ #2a0405 ที่ถูก
// กดเงาลงไปหาพื้นลึก #0a0101 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวแผงยก #3b0404 อีกด้าน
// หนึ่ง ความนูนแบบ neumorphic มาจากคู่มืด/สว่างภายในโทนแดงเกือบดำเดียวกัน ไม่ใช่
// จากสีที่สอง คอนทราสต์เดียวในการ์ดคือเส้นทองแบรนด์ #fbbf24 ใต้หัวข้อกับตัวไล่เฉด
// ของหัวข้อเอง ซึ่งวิ่งทองอ่อน #fde68a → ทองหลัก #fbbf24 → แดงสว่าง #fc2b2c ตรงกับ
// โลโก้ที่ LOTTO เป็นโครเมียมแล้ว 24 เป็นแดง กรอบเป็นทองลึก #a16207 เนื้อความ
// #f6e2e2 (BRAND_TEXT) — ชุดทอง-เขียว-ดำของ PGW44 (#fde90e #fff89a #35d413 #a86f02
// #0b1408 #050803 #101a0b #e9f0dd) ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a16207] bg-[#2a0405] p-8 text-left text-base leading-relaxed text-[#f6e2e2] shadow-[10px_10px_20px_#0a0101,-10px_-10px_20px_#3b0404]">
    {
      title && (
        <header class="mb-6 border-b border-[#fbbf24]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fde68a] via-[#fbbf24] to-[#fc2b2c] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
