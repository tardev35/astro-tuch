---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>, and do not remove one that is doing
// real layout.
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น
// heading ในไฟล์นี้ และห้าม hardcode ระดับ heading**
//
// รอบนี้ (ดรอป 2026-10-27) ไฟล์นี้ถูก render จาก **/ตรวจหวย กับ /แนวทาง** ซึ่ง
// ถูกย้ายกลับเข้า src/pages/ เพราะแบรนด์รอบนี้เป็นเว็บหวย ส่วนหน้าแรกไม่ได้ใช้
// ไฟล์นี้ (index หมุนไปใช้ชุดอื่น) — **ห้ามลบ variant ที่ไม่ได้ใช้** มันคือ
// inventory ของแบรนด์ถัดไป
//
// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ — Tailwind สแกนไฟล์นี้เป็น plain text
// รวมถึงคอมเมนต์ด้วย ยูทิลิตี้ของค่านั้นจะถูก generate ลง stylesheet จริง
// ⚠️ และห้ามเขียน "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้ — การ sweep
// ไล่หาสีของแบรนด์เก่าใน src/ จะสะดุดที่คอมเมนต์ของตัวเองทุกครั้ง
// **ลิสต์ค่าต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lotto189.md` §2 ที่เดียว**
//
// ───────────────────────────────────────────────────────────────────────────
// พาเลตรอบนี้ตาม `.claude/brand-spec-lotto189.md` §2 —
// **แดงเลือดนกนำ · ทองเข้มคู่รอง · เนื้อหาเป็นผิวสว่าง**
// 🚨 bg.json ของดรอปนี้ = {"mode":"color","color":"#fff0f0"} = ขาวอมชมพูจาง
// และ bg.json คือแหล่งเดียวของพื้นเพจ — ให้เปิดอ่านทุกรอบ ห้ามสืบทอดค่าข้ามรอบ
// **ห้ามแก้การ์ดกลับไปเป็นผิวเข้มตามโครม** — navbar/footer/ticker รอบนี้เป็น
// ออกซ์บลัด #24060c ก็จริง แต่หมึก #25090f บนการ์ดมืด = ตัวอักษรหายไปเลย ไม่ใช่
// แค่จางลง และสองหน้าหวยที่เรียกไฟล์นี้อยู่ใน **โซนเนื้อหา** ไม่ใช่โซนโครม
// 🚨 **สองหน้านั้นรอบก่อนเป็นผิวการ์ดเข้มทั้งหน้า — รอบนี้พลิกเป็นการ์ดสว่าง
// ทั้งไฟล์ ห้าม "แก้" กลับเป็นพื้นมืด**
//
// ลำดับผิวรอบนี้: #ffffff ฝั่งสว่างของเงานูน · **#ffe4e6 ผิวยก (ใบนี้)** ·
// #ffd4d7 wash · #fff0f0 พื้นเพจ
//   เนื้อความ **#25090f** (= BRAND_TEXT) = 18.7:1 บนการ์ดขาว · 16.4:1 บนผิวยกใบนี้
//   หัวข้อ **แดงเลือดนก #b00718 ทึบ จัดกึ่งกลาง** = 7.3:1 บนขาว · ~6.8:1 บนผิวยกใบนี้
//   ขอบการ์ด/เส้นใต้หัวข้อ **#f5b9bd** ซึ่ง §2 ห้ามถือตัวอักษร — ที่นี่เป็นเส้นล้วน
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืด rgba(176,7,24,α)** และ
// **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งสว่างกว่าทั้งผิวการ์ด #ffe4e6 และพื้นเพจ
// #fff0f0 จึงอ่านเป็นแสงได้จริง **ห้ามใช้ดำหรือแดงสดเป็นฝั่งสว่าง**
//
// ความต่างของใบนี้คือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อทึบจัดกึ่งกลางบนเส้นใต้
// เต็มความกว้าง** — ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ
// 🚨🚨 **#ff2436 บนผิวสว่างได้แค่ 3.9:1 และ #e9b53c ได้ 2.0:1 — ห้ามเป็นสี
// ตัวอักษรในไฟล์นี้เด็ดขาด และห้ามถมพื้นสองค่านั้นแล้ววางหมึกขาว** ใบนี้จึงไม่มี
// ทั้งสองค่าเลยสักจุด
// ⚠️ **#ffffff #ffe4e6 #ffd4d7 #fff0f0 #f5b9bd #a8333f #ff2436 #e9b53c #c3ccd6
// ห้ามถือตัวอักษรบนผิวสว่าง** ส่วน **#25090f (18.7:1) · #6e3b44 (8.8:1) ·
// #b00718 (7.3:1) · #c1071b (6.6:1) · #8a0412 (10.4:1) · #8f6310 (5.3:1)
// ถือตัวอักษรได้**
// ⚠️ **#b00718 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) ·
// rgba(138,4,18,α) · rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นแบรนด์ **แดง/ทอง/ครีม**
// ซึ่งเป็นตระกูลเดียวกับแบรนด์เมื่อสามรอบก่อน และใกล้กับรอบก่อนทันที (ส้ม/ทอง/
// ครีม) → **"เจอแดง/ทอง/ครีม ≠ เป็นของรอบนี้"** ต้องตรวจทีละหกหลักกับตารางใน
// §2 ของ brand-spec ห้ามตัดสินด้วยสายตา ทั้งใบนี้เคยถือพาเลตไวโอเลตนีออน/
// ไลแลคของแบรนด์สองรอบก่อนมาเต็มไฟล์ จึงเป็นใบที่เสี่ยงหลงเหลือสูงที่สุด
// ⚠️ **รอบนี้ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพูบับเบิลกัม ไม่มีเขียวแบรนด์
// และไม่มีส้มเพลิงเลยสักเฉด** (เขียว #00B900 ของปุ่ม LINE และเขียว success ของ
// ฟีดถอนเงินอยู่ไฟล์อื่น คงไว้ ห้ามเปลี่ยน)
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู** ต่างจากไลแลคของรอบก่อนและครีมอมงาช้าง
// ของรอบก่อนหน้านั้นทุกค่า — **ดูทิศช่องสีไม่พอ ต้องเทียบค่าเต็ม**
// ⚠️ **ผิวโครเมียมเงินของเวิร์ดมาร์ก ลูกบอลหวยขาว โพยหวย ปากกาทอง สูทขาว และ
// อาร์มแชร์ขอบทองในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก
// bg.json เท่านั้น
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f5b9bd] bg-[#ffe4e6] p-8 text-left text-base leading-relaxed text-[#25090f] shadow-[12px_12px_26px_rgba(176,7,24,0.14),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#f5b9bd] pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#b00718]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
