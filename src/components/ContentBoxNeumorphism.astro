---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// FAH999 palette: the soft-relief slab is the card surface (#12100b) lit from
// the page black (#000000) on one diagonal and from the raised panel (#1c160e)
// on the other, so the relief comes from brightness inside the one gold-on-black
// scheme rather than from a second hue. The only contrast in the card is the
// gold rule under the heading and the heading gradient itself, which runs
// highlight gold -> mid gold -> deep bronze, exactly as the logo's wordmark does.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#6b4a18] bg-[#12100b] p-8 text-left text-base leading-relaxed text-[#e7dcc4] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1c160e]">
    {
      title && (
        <header class="mb-6 border-b border-[#e8c25a]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f7e7a8] via-[#c49a41] to-[#a3732c] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
