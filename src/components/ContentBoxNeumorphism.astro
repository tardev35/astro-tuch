---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#ef4fae]/55 bg-[#1a0730] p-8 text-left text-base leading-relaxed text-[#dfd0ee] shadow-[10px_10px_20px_#06020b,-10px_-10px_20px_#5a1141]">
    {
      title && (
        <header class="mb-8 border-b border-[#ef4fae]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f4ebff] via-[#ff6fd0] to-[#e5399f] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
