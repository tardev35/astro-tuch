---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// NATO168 (รอบทอง-เงิน-ดำ 2026-10-02): แผ่นนูนคือผิวแผงยกอุ่น #17120a ที่ถูกกดเงาลง
// ไปหาพื้นเพจดำสนิท #070707 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวทองหม่น #241a09 อีกด้านหนึ่ง
// ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึง
// ถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน หัวข้อไล่เฉดทองลึก #a9761f → ทองแบรนด์
// #edb543 → เงิน #e6e6e6 คือไล่ "ทองขึ้นเงิน" ซึ่งเป็นทิศกลับด้านกับ ContentBox
// ตัวกลางที่ไล่ทองอ่อน → เงิน → ทองลึก จึงคนละจังหวะสายตาบนหน้าเดียวกัน และทุก stop
// ของไล่เฉดนี้ยังอยู่เหนือ 4:1 บนผิวการ์ด #17120a (ทองลึกวัดได้ 4.7:1) กรอบเป็น
// #3a2a0d เนื้อความ #f4ead3 (BRAND_TEXT)
//
// ชุดแดง-ทองของ หวยเฮง789 ที่เคยค้างในไฟล์นี้ (#2b0909 #0b0202 #4a0f0f #5c0a0a
// #e43434 #f4bc5d #ffefc2 #fbe3d4) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3a2a0d] bg-[#17120a] p-8 text-left text-base leading-relaxed text-[#f4ead3] shadow-[10px_10px_20px_#070707,-10px_-10px_20px_#241a09]">
    {
      title && (
        <header class="mb-6 border-b border-[#edb543]/45 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#a9761f] via-[#edb543] to-[#e6e6e6] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
