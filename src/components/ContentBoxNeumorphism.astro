---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// รอบนี้ไฟล์นี้ถือ **docx H1 §1 ของหน้าแรก ใบเดียว** ("<แบรนด์> สล็อตลิขสิทธิ์แท้
// ในไทย เว็บตรงไม่ผ่านเอเย่นต์" — content.txt บรรทัด 3 ย่อหน้าเต็มอยู่บรรทัด 4)
// ระดับหัวข้อมาจาก prop `as` เท่านั้น และหน้าเพจส่ง as="h1" มา
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
// (src/pages-disabled/ อ้างไฟล์นี้อยู่ด้วย แต่ Astro ไม่ route โฟลเดอร์นั้น
// จึงไม่มีหน้าอื่นที่ render ไฟล์นี้จริงรอบนี้ — รีเธมในที่ได้)
//
// ⚠️ เขียนชื่อคลาสสีในคอมเมนต์แบบไม่เต็มรูปโดยตั้งใจ — Tailwind สแกนไฟล์นี้เป็น
// plain text รวมถึงคอมเมนต์ด้วย การพิมพ์คลาสสีเต็มรูปในคอมเมนต์จะทำให้ยูทิลิตี้
// ของค่านั้นถูก generate ลง stylesheet จริง
//
// ───────────────────────────────────────────────────────────────────────────
// ZANE96 (ดรอป 2026-10-25, .claude/brand-spec-zane96.md §2) —
// **ไวโอเลตนีออนนำ · ฟ้าอิเล็กทริก/แมเจนต้าเป็นคู่รอง · เนื้อหาบนธีมสว่าง**
// 🚨 bg.json = {"mode":"color","color":"#f8e6f9"} = ไลแลคอมชมพูจาง
// **ห้ามแก้การ์ดกลับไปเป็นพื้นมืดตามโครม** — navbar/footer/ticker รอบนี้เป็นผิวเข้ม
// #190b3d ก็จริง แต่หมึก #241046 บนการ์ดมืด = ตัวอักษรหายไปเลย ไม่ใช่แค่จางลง
//
// ลำดับผิวรอบนี้: #ffffff การ์ด/ฝั่งสว่างของเงานูน · **#f6edfe ผิวยก (ใบนี้)** ·
// #ece0fb wash · #f8e6f9 พื้นเพจ
//   เนื้อความ **#241046** (= BRAND_TEXT) = 16.8:1 บนการ์ดขาว · ~16:1 บนผิวยกใบนี้
//   หัวข้อ **ไวโอเลตลึก #5411c4 ทึบ จัดกึ่งกลาง** = 9.3:1 บนขาว · ~9:1 บนผิวยกใบนี้
//   ขอบการ์ด/เส้นใต้หัวข้อ **#dcc6f4** ซึ่ง §2 ห้ามถือตัวอักษร — ที่นี่เป็นเส้นล้วน
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืด rgba(84,17,196,α)** และ
// **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งสว่างกว่าทั้งผิวการ์ด #f6edfe และพื้นเพจ
// #f8e6f9 จึงอ่านเป็นแสงได้จริง **ห้ามใช้ดำหรือม่วงสดเป็นฝั่งสว่าง**
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ
// และไม่มีแถบตั้งนำหน้า** — ความต่างของมันคือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อ
// ทึบจัดกึ่งกลางบนเส้นใต้เต็มความกว้าง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ
// 🚨🚨 **#f23bb4 บนผิวสว่างได้แค่ 3.5:1 และ #bb6dff ได้ 3.1:1 — ห้ามเป็นสี
// ตัวอักษรในไฟล์นี้เด็ดขาด** และ **ห้ามถมพื้นสองค่านั้นแล้ววางหมึกขาว** (2.6 / 2.0:1)
// ใบนี้จึงไม่มีทั้งสองค่าเลยสักจุด
// ⚠️ **#ffffff #f6edfe #ece0fb #f8e6f9 #dcc6f4 #9a6fd0 #f23bb4 #bb6dff #7aa7ff
// ห้ามถือตัวอักษร** ส่วน **#241046 (16.8:1) · #6b4a86 (7.1:1) · #5411c4 (9.3:1) ·
// #7a1bd6 (7.1:1) · #2b3fd9 (7.5:1) · #c2178b (5.6:1) ถือตัวอักษรได้**
// ⚠️ **#5411c4 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(122,27,214,α) · rgba(84,17,196,α) ·
// rgba(194,23,139,α) · rgba(242,59,180,α) · rgba(43,63,217,α) ·
// rgba(187,109,255,α) · rgba(36,16,70,α) · rgba(220,198,244,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — อาร์ตเวิร์กรอบนี้ไล่ **ฟ้า → ม่วง →
// แมเจนต้า** ซึ่งคร่อมฮิวนำของแบรนด์ก่อนๆ **สามเจ้าพร้อมกัน** จึงต้องตรวจทีละหกหลัก
// ค่าที่กวาดออกจากไฟล์นี้แล้วและห้ามกลับเข้ามา (เขียนแบบไม่มี # โดยตั้งใจ):
//   **okkub88 (ชุดที่เพิ่งอยู่ทั้งใบนี้ — เสี่ยงหลงเหลือสูงสุด)** — ffd6fa fff4fb
//     ffe3f5 ffe9f7 f9b2d9 f479b9 f4a7cf 6a0f3c 95486b 9c0f55 fb439b fc74b5 ffc2e2
//     d91a73 b01160 85094a fd6cb2 fc7cba fc4da1 + rgba 156/15/85 และ rgba 106/15/60
//     ⚠️⚠️ **9c0f55 / 85094a ↔ #5411c4 คนละตระกูลจริง แต่เป็นค่าที่เคยถือหัวข้อ
//     ของใบนี้มาก่อน · d91a73 ↔ #c2178b · fb439b / fc4da1 ↔ #f23bb4**
//   **MEXICANOSLOT (แบรนด์ขาออก)** — de2b1e f2a033 a81410 c81e12 9d140c 6f0e08
//     3f130d 80453a 2b100a 431a10 1d0a06 8c3a22 fdeee2 e8c6ae fed7b5 fec28d f6c4a4
//     e2855c fde4d3 fff3ea fef6fb 117a41 2bb061 f2543f
//   **ม่วงของแบรนด์อื่น — รอบนี้ม่วงเป็นฮิวนำ จึงต้องเทียบแน่นที่สุด** — 7e22ce
//     d946ef a855f7 (CEO66) · 7505cc b453ff c07cff d9b8ff 3a0565 (KMD88)
//     ⚠️⚠️ **b453ff ↔ #bb6dff ต่างไบต์เดียว · 7505cc ↔ #7a1bd6 ใกล้ที่สุดในลิสต์**
//   **ฟ้า/ไซแอนของแบรนด์อื่น** — 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73
//     2a87c4 eaf7ff f0faff e4f6fb 355f7d 0f5684 1a6ea8 · 1177e8 0e68cc 0a4ea8 ·
//     1fd8f0 0bb6d4 1d4fd8 143aa0 · 18a5e2 0d6b9b 0a5176 a9d7f2 · 2cc3fc 6bdcfb ·
//     039cfa 0494f5 · 32bcfb a9e9ff · 2f9ff5 a8dcff · 0360f3 0292fb 6ec8ff ·
//     00f3ff e0ffff 60a5fa 4b5563 030712 1f2937
//     ⚠️⚠️ **60a5fa ↔ #7aa7ff · 1d4fd8 ↔ #2b3fd9**
//   **ชมพู/แดงของแบรนด์อื่น** — fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9
//     ef8dbd ffe5ff fff0f8 ffeef7 3b0b26 54123a 7a2350 ffe9f5 7a4463 · f41571 ff5ca8
//     · f5469f ff8dc6 8c0f52 · fa63b9 ffb3de · dd1b74 a4186b 4a0d35 2d0720 · fb2e33
//     cb0b0d d81115 b00d11 8a0608 · ff2e52 e01238 c9102f · fb1b32 ff8f9c 5c0410 ·
//     fa0513 ff5a5f ffadaf · b3121b f2bba5 · ff3fa4 ffd1ea
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีทอง/เหลือง ไม่มีส้ม ไม่มีเขียวแบรนด์ ไม่มีครีม/เบจ
// และไม่มีแรมป์เทาเงินเลยสักเฉด** (เขียว #00B900 ของปุ่ม LINE และเขียว success
// ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้)
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นไลแลคอมชมพู (B≥R>G)** ต่างจากขาวอมชมพูของรอบก่อน
// (R≥B>G) และจากขาวอมฟ้า (B>G>R) ทุกค่า — **ดูทิศช่องสีไม่พอ ต้องเทียบค่าเต็ม**
// ⚠️ **ชุดเมทัลลิกโฮโลแกรม ตู้สล็อต 777 ชิปคาสิโน เชอร์รี่ และสีผิวนักแสดงใน
// อาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#dcc6f4] bg-[#f6edfe] p-8 text-left text-base leading-relaxed text-[#241046] shadow-[12px_12px_26px_rgba(84,17,196,0.14),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#dcc6f4] pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#5411c4]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
