---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// หวย24 (รอบแดงแบรนด์ + ทอง บนดำอมแดง 2026-10-04, brand-spec §2): แผ่นนูนคือ
// ผิวการ์ด #170707 ที่ถูกกดเงาลงไปหาพื้นดำอมแดงลึกสุด #0a0303 ด้านหนึ่ง และยกแสง
// ขึ้นด้วยผิวการ์ดอุ่น #230d0d อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่
// มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่น
// ใต้หัวข้อแทน หัวข้อไล่แดงแบรนด์ #d20a0a → ทองแบรนด์ #f5c33b → ทองสว่าง #ffd45e
// คือไล่ "แดงขึ้นทอง" ซึ่งเป็นทิศกลับด้านกับ ContentBox/Faq3 ที่ไล่ทองสว่าง →
// ทองแบรนด์ → แดงสว่าง จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// เนื้อความ #f7e2d6 (= BRAND_TEXT)
//
// ชุดทอง + เงินโครเมียมของ UP555 ที่เคยค้างในไฟล์นี้ (#1b1005 #050201 #2e1d08
// #ab6d24 #ebbb54 #d5d4d3 #f8eed9) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#230d0d] bg-[#170707] p-8 text-left text-base leading-relaxed text-[#f7e2d6] shadow-[10px_10px_20px_#0a0303,-10px_-10px_20px_#230d0d]">
    {
      title && (
        <header class="mb-6 border-b border-[#f5c33b]/45 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#d20a0a] via-[#f5c33b] to-[#ffd45e] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
