---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// หวยพยัคฆ์ palette (กรมท่า-ทอง): แผ่นนูนคือพื้นการ์ด #08152f ที่ถูกไล่แสงจาก
// พื้นเพจกรมท่าเข้ม #030b1c ด้านหนึ่ง และจากพื้นยก #0f2149 อีกด้านหนึ่ง ความนูน
// จึงมาจากความสว่างภายในโทนกรมท่าเดียวกัน ไม่ใช่จากสีที่สอง คอนทราสต์เดียวใน
// การ์ดคือเส้นทองใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่งวิ่งทองสว่าง #fdf5a4 →
// ทองหลัก #fadb6c → ทองบรอนซ์ #ab6d13 เหมือนคำว่า พยัคฆ์ บนโลโก้ ดำ-ทองของ
// HENG35 ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#ab6d13] bg-[#08152f] p-8 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[10px_10px_20px_#030b1c,-10px_-10px_20px_#0f2149]">
    {
      title && (
        <header class="mb-6 border-b border-[#fadb6c]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
