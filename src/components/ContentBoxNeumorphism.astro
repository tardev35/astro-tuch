---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0a2d6d]/60 bg-[#04122e] p-8 text-left text-base leading-relaxed text-[#cfdcf2] shadow-[10px_10px_20px_#000206,-10px_-10px_20px_#0a2144]">
    {
      title && (
        <header class="mb-8 border-b border-[#123a7e]/50 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#e6edf7] via-[#7db4ff] to-[#2f7bf6] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
