---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// ABM96 palette (ชมพู-เหลือง): แผ่นนูนคือพื้นการ์ด #1d0611 ที่ถูกไล่แสงจากพื้นเพจ
// ชมพูเกือบดำ #12030a ด้านหนึ่ง และจากพื้นยก #2a0a1a อีกด้านหนึ่ง ความนูนจึงมาจาก
// ความสว่างภายในโทนชมพูเดียวกัน ไม่ใช่จากสีที่สอง คอนทราสต์เดียวในการ์ดคือเส้นชมพู
// ใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่งวิ่งชมพูอ่อนสุด #ffe0ec → ชมพูหลัก #fd6494
// → เหลืองโลโก้ #feda2a ตามโลโก้ที่ตัว ABM เป็นชมพูและเลข 96 เป็นเหลือง
// กรมท่า-ทองของ หวยพยัคฆ์ และมรกต-ทองของ HENG38 ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#c1356a] bg-[#1d0611] p-8 text-left text-base leading-relaxed text-[#fbe3ee] shadow-[10px_10px_20px_#12030a,-10px_-10px_20px_#2a0a1a]">
    {
      title && (
        <header class="mb-6 border-b border-[#fd6494]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe0ec] via-[#fd6494] to-[#feda2a] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
