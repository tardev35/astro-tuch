---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f36403]/30 bg-[#1c0a02] p-8 text-left text-base leading-relaxed text-[#f6e4d6] shadow-[10px_10px_20px_#050201,-10px_-10px_20px_#5c2a08]">
    {
      title && (
        <header class="mb-8 border-b border-[#fd9a1e]/28 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fff2e6] via-[#fd9a1e] to-[#f36403] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
