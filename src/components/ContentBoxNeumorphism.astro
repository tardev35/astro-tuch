---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// WEPLAY168 (รอบม่วงนีออน-ทองอาร์เขต 2026-10-09, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #17062e ที่ถูกกดเงาลงไปหาดำสนิทด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวการ์ดยก #1e0a3c อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
//
// หัวข้อไล่ทองแบรนด์ #fbe455 → ทองอุ่น #ffd23d → ม่วงอ่อน #d2a6ff คือไล่
// "ทองนำลงม่วง" ซึ่งเป็นทิศตรงข้ามกับ ContentBoxPremium ที่ไล่ม่วงนำเข้าทอง
// และคนละชุดกับ ContentBoxTwoNeumorphism จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// กรอบเป็นผิวการ์ดยก #1e0a3c เส้นใต้หัวข้อเป็นทองเข้ม #c98a05 แบบโปร่ง
// เนื้อความ #ece2ff (= BRAND_TEXT, 13.9:1 บนผิว #17062e)
//
// การ์ดใบนี้ถือ docx H2 #2 ของหน้าแรก ซึ่งบรีฟรอบนี้ให้มาสองย่อหน้า หน้าเพจเป็นคน
// ห่อสองย่อหน้านั้นไว้ใน <div> เดียวตามกฎ "หนึ่งอิลิเมนต์ต่อหนึ่งสล็อต" ไฟล์นี้ไม่ได้
// บังคับความกว้างหรือสีให้ลูกในสล็อตเลย — รอบนี้ไม่มี banner2 ของดรอปปัจจุบัน
// (ไฟล์ที่ค้างบนดิสก์เป็นงานอาร์ตของแบรนด์ก่อน) จึงไม่มีรูปประกอบในกล่องนี้
//
// ชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 ที่เคยค้างในไฟล์นี้ (#0a1726 #07111d #fce604
// #fff48a #7bcffb #c9a703 #dbeafe) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1e0a3c] bg-[#17062e] p-8 text-left text-base leading-relaxed text-[#ece2ff] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1e0a3c]">
    {
      title && (
        <header class="mb-6 border-b border-[#c98a05]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fbe455] via-[#ffd23d] to-[#d2a6ff] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
