---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// BOOM369 (รอบเขียวนีออน-เงิน บนดำสนิท 2026-10-07, brand-spec §2): แผ่นนูนคือผิว
// การ์ดกลาง #07170f ที่ถูกกดเงาลงไปหาพื้นเพจดำสนิท #000000 ด้านหนึ่ง และยกแสงขึ้น
// ด้วยผิวการ์ดยก #0b231b อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่าง
// ในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
//
// หัวข้อไล่เงินโครเมียม #dadcdc → เขียวนีออน #42fb5a → ทอง #f3c44a คือไล่
// "เงินขึ้นนีออนขึ้นทอง" ซึ่งเป็นทิศคนละชุดกับ ContentBoxTwoNeumorphism ที่ไล่ทองนำ
// และกับ ContentBoxPremium ที่ไล่นีออนนำ จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// กรอบเป็นผิวการ์ดยก #0b231b เส้นใต้หัวข้อเป็นเขียวนีออนโปร่ง
// เนื้อความ #cfe9d7 (= BRAND_TEXT, 13.5:1 บนผิว #07170f)
//
// ชุดแดงแบรนด์ + เงินโครเมียมของ หวยดีใจ ที่เคยค้างในไฟล์นี้ (#17080c #0d0407
// #211016 #dc0409 #c3c7d1 #eef0f4 #edeaf0) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0b231b] bg-[#07170f] p-8 text-left text-base leading-relaxed text-[#cfe9d7] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#0b231b]">
    {
      title && (
        <header class="mb-6 border-b border-[#42fb5a]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#dadcdc] via-[#42fb5a] to-[#f3c44a] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
