---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// SAGAME66 palette (ทอง-เงินโครเมียม 2026-09-23): แผ่นนูนคือพื้นการ์ดน้ำตาลเกือบดำ
// #171006 ที่ถูกกดเงาลงไปหาพื้นเพจ #0d0903 ด้านหนึ่ง และยกแสงขึ้นด้วยพื้นยก
// #2a1d0b อีกด้านหนึ่ง ความนูนจึงมาจากความสว่างภายในโทนน้ำตาลเดียวกัน ไม่ใช่จาก
// สีที่สอง คอนทราสต์เดียวในการ์ดคือเส้นทอง #e8b93f ใต้หัวข้อกับตัวไล่เฉดของหัวข้อ
// เอง ซึ่งวิ่งทองสว่าง #ffe9a3 → เงินโครเมียม #eef3f8 → ทองหลัก #e8b93f ตรงกับ
// โลโก้ที่ตัว SA เป็นทองสามมิติ GAME เป็นเงินโครเมียม แล้ว 66 กลับมาเป็นทอง
// เนื้อความ #e3d8c0 (BRAND_TEXT) — ชุดแดง-ทองของ THE88 (#2d0908 #1c0504 #4a0d0b
// #6b0302 #f2c14e #ffe7a6 #dd0503 #f7e3dd) ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#96671a] bg-[#171006] p-8 text-left text-base leading-relaxed text-[#e3d8c0] shadow-[10px_10px_20px_#0d0903,-10px_-10px_20px_#2a1d0b]">
    {
      title && (
        <header class="mb-6 border-b border-[#e8b93f]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
