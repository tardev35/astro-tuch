---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// SUPERSLOTCLUB (รอบแดงเสือโคร่ง-ทองถ่านไฟ 2026-10-09, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #301105 ที่ถูกกดเงาลงไปหาดำสนิทด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวการ์ดยก #3d1709 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
//
// หัวข้อไล่ทองสว่าง #ffd666 → ทองแบรนด์ #f2b705 → แดงเรืองไฟ #ff5a46 คือไล่
// "ทองนำลงแดง" ซึ่งเป็นทิศตรงข้ามกับ ContentBoxPremium ที่ไล่แดงนำเข้าทอง
// และคนละชุดกับ ContentBoxTwoNeumorphism จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// กรอบเป็นผิวการ์ดยก #3d1709 เส้นใต้หัวข้อเป็นทองเข้ม #a8730a แบบโปร่ง
// เนื้อความ #fbe8d5 (= BRAND_TEXT, 14.6:1 บนผิว #301105)
//
// การ์ดใบนี้ถือ docx H2 #7 ของหน้าแรก (แอดมิน เปิดให้บริการ 24 ชั่วโมง) ซึ่งบรีฟ
// รอบนี้ให้มาสองย่อหน้า หน้าเพจเป็นคนห่อสองย่อหน้านั้นไว้ใน <div> เดียวตามกฎ
// "หนึ่งอิลิเมนต์ต่อหนึ่งสล็อต" ไฟล์นี้ไม่ได้บังคับความกว้างหรือสีให้ลูกในสล็อตเลย
// — รอบนี้ไม่มี banner2 ของดรอปปัจจุบัน (ไฟล์ที่ค้างบนดิสก์เป็นงานอาร์ตของแบรนด์
// ก่อน) จึงไม่มีรูปประกอบในกล่องนี้
//
// ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#17062e #1e0a3c
// #c98a05 #fbe455 #ffd23d #d2a6ff #ece2ff) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168
// ก่อนนั้น (#0a1726 #07111d #fce604 #fff48a #7bcffb #c9a703 #dbeafe)
// ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3d1709] bg-[#301105] p-8 text-left text-base leading-relaxed text-[#fbe8d5] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#3d1709]">
    {
      title && (
        <header class="mb-6 border-b border-[#a8730a]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffd666] via-[#f2b705] to-[#ff5a46] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
