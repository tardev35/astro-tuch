---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#c2249b]/55 bg-[#2a0640] p-8 text-left text-base leading-relaxed text-[#e6cfe9] shadow-[10px_10px_20px_#0d0114,-10px_-10px_20px_#4a1070]">
    {
      title && (
        <header class="mb-8 border-b border-[#c2249b]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffb3e2] via-[#fb44b3] to-[#c98cff] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
