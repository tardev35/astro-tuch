---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// TTN69 palette: the soft-relief card reads as a lit emerald ridge — the dark
// shadow is the page black (#020805) and the light shadow is deep emerald, so
// the "light source" is the brand hue rather than a neutral glow.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#02b961]/30 bg-[#061309] p-8 text-left text-base leading-relaxed text-[#d5e6da] shadow-[10px_10px_20px_#020805,-10px_-10px_20px_#04331d]">
    {
      title && (
        <header class="mb-8 border-b border-[#4ce68f]/28 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f1faf4] via-[#4ce68f] to-[#046b3a] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
