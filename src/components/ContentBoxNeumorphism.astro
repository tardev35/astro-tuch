---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#2c045c]/70 bg-[#06020e] p-8 text-left text-base leading-relaxed text-[#ece0fb] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1c0b33]">
    {
      title && (
        <header class="mb-8 border-b border-[#4a0b8f]/60 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#e8e6ee] via-[#c47bff] to-[#9d16f1] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
