---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// NEXT55 palette: the soft-relief card reads as a lit graphite slab — the dark
// shadow is the page black (#050507) and the light shadow is a lifted charcoal
// (#2b2d34), so the slab keeps its neutral metal feel and the only colour in the
// card is the crimson rule under the heading. This is the box several sub-pages
// hang their H1 and sections on, so the heading gradient runs pale rose ->
// crimson -> silver, matching the logo's graphite-and-red pairing.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3a3d45] bg-[#17181c] p-8 text-left text-base leading-relaxed text-[#d5dae2] shadow-[10px_10px_20px_#050507,-10px_-10px_20px_#2b2d34]">
    {
      title && (
        <header class="mb-8 border-b border-[#cd1437]/35 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#e7eaef] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
