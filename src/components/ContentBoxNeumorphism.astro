---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left` and the slot renders as a direct child; do not re-add a content
// wrapper <div>.
//
// รอบนี้ไฟล์นี้ถูก render จาก **src/pages/index.astro เพียงหน้าเดียว** และถือ
// **docx H2 §3** ("โปรโมชั่นสมาชิก <แบรนด์> กดรับได้ไม่จำกัด" — content.txt
// บรรทัด 7) มาเป็น `title` พร้อม as="h2" จึงเดินสาขา text-2xl
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// เงินทอง168 (ดรอป 2026-10-22, .claude/brand-spec-ngernthong168.md §2) —
// **ทองนำ · ครีมอุ่นเป็นวัสดุที่สอง · บนน้ำตาลโอลีฟเข้ม**
// ⚠️⚠️ **ธีมมืด** — bg.json = {"mode":"color","color":"#29210f"} น้ำตาลโอลีฟเข้ม
// ไฟล์นี้อยู่ในโซน "เนื้อหา" จึงเป็น **การ์ดผิวมืด หมึกครีม** ไม่ใช่โครม (โครมคือ
// navbar/footer/ticker/Navfoot/CtaRedirect ซึ่งเป็นแรมป์ #2e2512 / #1b1407 /
// #4d3c15) **ห้าม "แก้" ครึ่งใดครึ่งหนึ่งให้เข้าหากัน**
//   ผิวการ์ด (ชั้นกลาง) **#332810** · พื้นเพจ #29210f (bg.json)
//   เนื้อความครีมอุ่น #ecd5c4 (= BRAND_TEXT) = 10.3:1 บนผิวการ์ดใบนี้
//   หัวข้อทองสว่าง #fcee52 = 12.1:1 บนผิวการ์ด และเป็น text-2xl font-black
//   ขอบการ์ด/เส้นใต้หัวข้อเป็นทองลึก #b37c0b แบบโปร่ง — **เส้นล้วน ไม่ถือตัวอักษร**
//   (#b37c0b ได้ 4.0:1 บนผิวนี้ แต่ §2 สงวนให้เป็นขอบ/ออรา/พื้นถมเท่านั้น)
// ความนูนแบบ neumorphic บนธีมมืดกลับทางกับธีมสว่าง: เงาจมเป็น rgba(0,0,0,α) และ
// เงายกเป็น **ผิวยก #3d3016** ซึ่งสว่างกว่าผิวการ์ด #332810 จึงอ่านเป็นแสงได้จริง
// **ห้ามใช้ขาวหรือครีมเป็นฝั่งสว่าง** — บนพื้นมืดมันจะอ่านเป็นเส้นขอบ ไม่ใช่แสงนูน
// ลำดับความลึก: #3d3016 ยก / #332810 กลาง / #201906 อินเซ็ต / #29210f พื้นเพจ
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ และ
// ไม่มีมุมตัด** — ความต่างของมันคือ **เงานูน-จมคู่ (12px/-12px) กับหัวข้อทึบจัด
// กึ่งกลาง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ (§1 เป็นป้ายลอย · §2/§7 เป็นมุมตัด ·
// §4 เป็นแผ่นนูน 10px พร้อมหัวข้อไล่เฉด · §5 เป็นเส้นคาดบน+ออรามุม · §6 เป็นขีดใต้
// หัวข้อบนการ์ดเบลอ · §8 เป็นแถวมุมตัด)
// ⚠️ **#f5ba14 ไม่อยู่ในไฟล์นี้เลย** — หัวข้อใช้ #fcee52 และขอบใช้ #b37c0b อยู่แล้ว
// ซึ่งทำให้ใบนี้เป็นกล่องที่ "เงียบ" ที่สุดของหน้า ตรงกับบทบาทของมัน ·
// **#fcee52 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// ⚠️ #3d3016 / #332810 / #201906 / #29210f เป็นสีพื้นเท่านั้น **ห้ามถือตัวอักษร**
// rgba() ที่อนุญาตรอบนี้: rgba(245,186,20,α) · rgba(252,238,82,α) ·
// rgba(236,213,196,α) · rgba(32,25,6,α) · rgba(0,0,0,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทองนำสองรอบติดกันแล้ว** การเจอทอง
// ในไฟล์จึงไม่พิสูจน์อะไร ทองรอบนี้คือ **#f5ba14 (R245 G186 B20)** กับ
// **#fcee52 (R252 G238 B82)** วัดจาก logo.webp เอง
// ⚠️⚠️ **พักยก168 เป็นแบรนด์ขาออกและเดินทองเหมือนกัน — ต้องเทียบค่าหนักที่สุด**
// eeae12 ห่าง #f5ba14 แค่ R7/G12/B2 · fded41 ห่าง #fcee52 แค่ R1/G17/B17 ·
// 291d0f ห่างพื้นเพจ #29210f แค่ 4 ที่เขียว: eeae12 fded41 9f600d e29f0f fdf051
// e0e0df c0c0bf a1a09e f4ead6 d6c6a8 291d0f 3a2713 32200f 1f1308 2f1e0f 1f0f04
// 4e2f11
// ⚠️⚠️ **วัสดุที่สองรอบนี้คือครีมอุ่น #ecd5c4 / #d2b9a4 ไม่ใช่เทาเงิน** — e0e0df
// c0c0bf a1a09e เป็นของพักยก168 และ e8ecf1 a8b2bf 78828f 5a6472 เป็นของยูฟ้า168
// **ห้ามเอาแรมป์เทาเงินกลับเข้ามาในไฟล์นี้**
// ชุดที่เคยอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้ว: **สบาย168** ฟ้าสกาย-ทองคานารี
// ธีมสว่าง (2cc3fc 6bdcfb 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504 ffffff
// f2fbff dff4fd ccf7ff cdf2ff eafaff a9e3f9 04293d 0a4f74 06293c 2a1f02) ·
// **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f
// 1e1a13 0a0908 eae3d4 140e02 0b0d10 000000) · **โปรดี168** (eb0305 e40303 c20305
// 9b0a0c ff4446 401107 b44c06 7a2f03 f0b46a d9803a 4d1c0a 2c1004 fff0e4 fff4ea
// ffd1d1 1a0802) · **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f ffeee8
// fff1ef ffdbdb c99a3f) · **สาธุ168** (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63
// aeb04a 9ba03c d8ffc7 e9fbdd) · **หวยคิง** (cd9a2c fdeb7c ab7314 f5e7c8 0c0b0a
// 120a02 1c140b) · **หวย365** (dc0203 f5282a ffc93c ffeab0 8c0402 3a0a0c c08a07
// 140203) · **มีทรัพย์168** (dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5) ·
// **ดวงเศรษฐี168** (d9212a 8e1a16 f0c878 fff8d8 2a0608 4e2120 300605 150303)
// ⚠️ ทองของแบรนด์อื่นที่ต้องเทียบทีละค่า: f7c92b ffe6a3 (ขวัญใจ168) · d4922c fdfc71
// d39c45 f6e3b4 (ufalion168) · e5a81b ffe08a bb8410 7d5a07 (UFA324) · fef54b 6b5c10
// (นินจา168) · f9a826 704504 (รวยแทร่168) · ffc82e 5c4a16 (สบายเบท168) · ffd84d
// 6b4708 (ถอนชัวร์168) · e3b23c ffe5a8 8a6210 (สมหวัง168) · fcd434 ffeaa0 (มีโชค168)
// · f0bb4e ffeccb (รวยเทพ168) · fcd45c 6b4a08 (มีเฮ168) · ffdc8c f0b429 (รับตัง168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีเขียว (ยกเว้น LINE green และ
// เขียว success ที่ไฟล์อื่น) ไม่มีฟ้า/น้ำเงิน ไม่มีส้ม ไม่มีทองแดงไหม้
// ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#b37c0b]/45 bg-[#332810] p-8 text-left text-base leading-relaxed text-[#ecd5c4] shadow-[12px_12px_26px_rgba(0,0,0,0.5),-12px_-12px_26px_#3d3016]">
    {
      title && (
        <header class="mb-6 border-b border-[#b37c0b]/45 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#fcee52]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
