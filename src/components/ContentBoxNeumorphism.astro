---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §7 ของหน้าแรก ("แอดมิน TSDET911 เปิดบริการ 24 ชั่วโมง") ซึ่ง
// บรีฟให้มาสองย่อหน้า (content.txt บรรทัด 20 กับ 21) หน้าเพจจึงห่อทั้งคู่ไว้ใน
// <div class="flex flex-col gap-4"> เดียวตามกฎบ้าน เพราะสล็อตเดี่ยวนี้รับลูกได้หนึ่ง
// element และการส่งสอง <p> เป็นพี่น้องกันจะเปลี่ยนระยะห่างของการ์ด
//
// TSDET911 (รอบน้ำเงินไฟฟ้า-เงินโครเมียม 2026-10-13, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #0a1c42 ที่ถูกกดเงาลงไปหา **พื้นเพจ #00081f** ด้านหนึ่ง และ
// ยกแสงขึ้นด้วยผิวการ์ดยก #102a5e อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่
// มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้
// หัวข้อเท่านั้น
// ⚠️ พื้นเพจรอบนี้เป็นกรมเกือบดำ (bg.json = {"mode":"color","color":"#00081f"}) เงา
// ด้านมืดจึงเท่ากับพื้นเพจพอดี ขอบด้านนั้นกลืนหายไปในพื้น — เป็นผลที่ต้องการ
// ลำดับความลึก: #102a5e ยก / #0a1c42 กลาง (ใบนี้) / #040e26 จม / #00081f พื้น
//
// ใบนี้เป็นแผ่นนูนใบที่สองของหน้า และต่างจาก ContentBoxTwoNeumorphism (§2) สามอย่าง:
// มุม rounded-[25px] เทียบกับ rounded-[30px] · มีกรอบ #102a5e เทียบกับไม่มีกรอบเลย ·
// และนั่งอยู่ที่ผิวกลาง #0a1c42 เทียบกับผิวยก #102a5e ของใบนั้น ทั้งสองยังถูกคั่นด้วย
// สี่ส่วนของหน้า (§3-§6) จึงไม่อ่านเป็นใบเดียวกันสองรอบ
//
// หัวข้อไล่ เงินโครเมียมสว่าง #cfdcec → ฟ้าอ่อน #4fb4ff → ฟ้าสว่าง #6ec8ff ซึ่งเป็น
// ลำดับ "เงินนำลงฟ้า" ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// (§1 ไล่ ฟ้าสว่าง→เงินสว่าง→ฟ้าอ่อน · §2 ไล่ เงินหม่น→ฟ้าสว่าง→เงินสว่าง · §3 ไล่
// เงินสว่าง→ฟ้าสว่าง→น้ำเงินแบรนด์ · §4 เป็นแผ่นโครเมียมทึบหมึกเข้ม · §5 เป็นเงิน
// โครเมียมทึบสีเดียว · §6 ไล่ ฟ้าอ่อน→เงินสว่าง→เงินหม่น · §8 ไล่ ฟ้าสว่าง→ฟ้าอ่อน→
// เงินสว่าง)
// กรอบเป็นผิวการ์ดยก #102a5e เส้นใต้หัวข้อเป็นน้ำเงินลึก #04186e แบบโปร่ง
// เนื้อความ #dde8f7 (= BRAND_TEXT, 11.6:1 บนผิว #102a5e และสูงกว่านั้นบนผิว #0a1c42
// ของใบนี้)
//
// ⚠️ **รอบนี้ไม่มีทองที่ไหนเลย** ต้องเทียบเป็น "ค่า" ไม่ใช่ "ตระกูลสี": ชุดทองมังกรของ
// TND168 ที่เคยค้างอยู่ทั้งไฟล์นี้ (#dfa310 #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b
// #1b1307 #120c04 #070502) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688 (#f3bb34 #fde464 #c8901a
// #f58b2a #ffc98a #f6ecd9 #d8c69b) ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 (#fbc134 #eef2f8
// #cfd6e3 #9aa6bb #fdf3df) ชุดแดงเสือโคร่ง-ทองของ SUPERSLOTCLUB (#e8232a #f2b705
// #ffd666) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดฟ้าสด-เหลือง
// มะนาวของ แตกดี168 (#0193fb #7bcffb #fce604 #fff48a #0a1726 #07111d #dbeafe) ออกครบ
// ทุกค่าแล้ว
// ⚠️ ตัวที่ต้องระวังที่สุดรอบนี้คือ **#0193fb ของ แตกดี168 กับ #0292fb ของรอบนี้** —
// ต่างกันแค่ไม่กี่หน่วย (R=1 G=147 B=251 เทียบกับ R=2 G=146 B=251) และ #7bcffb ก็ไม่ใช่
// #6ec8ff ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
// ⚠️ #0360f3 #0292fb #032dad #04186e #041a43 ห้ามถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// กรอบและเส้นใต้หัวข้อเท่านั้น
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#102a5e] bg-[#0a1c42] p-8 text-left text-base leading-relaxed text-[#dde8f7] shadow-[10px_10px_20px_#00081f,-10px_-10px_20px_#102a5e]">
    {
      title && (
        <header class="mb-6 border-b border-[#04186e]/60 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#cfdcec] via-[#4fb4ff] to-[#6ec8ff] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
