---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// PAOTUNG palette: the soft-relief card reads as a lit navy slab — the dark
// shadow is the page black-navy (#010a16) and the light shadow is a lifted
// brand blue (#0a3a68), so the "light source" is the logo hue rather than a
// neutral glow. This is the box every sub-page hangs its H1 and sections on,
// so the heading gradient leads with the metallic gold (#f5e3b3 -> #e0bd72)
// before falling into blue, matching the brief's navy + gold pairing.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#226ca9]/30 bg-[#04203c] p-8 text-left text-base leading-relaxed text-[#cfdeed] shadow-[10px_10px_20px_#010a16,-10px_-10px_20px_#0a3a68]">
    {
      title && (
        <header class="mb-8 border-b border-[#e0bd72]/30 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f5e3b3] via-[#e0bd72] to-[#7fc4f0] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
