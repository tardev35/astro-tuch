---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// UWIN33 (รอบทอง-โครเมียม-ดำ 2026-09-24): แผ่นนูนคือพื้นการ์ดดำอมน้ำตาล #161106
// ที่ถูกกดเงาลงไปหาพื้นเพจ #080602 ด้านหนึ่ง และยกแสงขึ้นด้วยพื้นยก #26200e อีก
// ด้านหนึ่ง ความนูนจึงมาจากความสว่างภายในโทนดำ-น้ำตาลเดียวกัน ไม่ใช่จากสีที่สอง
// คอนทราสต์เดียวในการ์ดคือเส้นทอง #e0b429 ใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่ง
// วิ่งเงินโครเมียม #dfe4ec → ทองสว่าง #fbd564 → ทองแบรนด์ #e0b429 ตรงกับตัว U ทอง
// คำว่า WIN เงิน และเลข 33 ทองบนโลโก้ เนื้อความ #ece6d8 (BRAND_TEXT) — ชุดทอง-
// เขียวเข้ม-แดงของ 888PARUAY (#fcdc2b #fff6ae #a87d0c #1fae1c #0d2312 #07130a
// #143a1c #e8e4c6) ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#7a5407] bg-[#161106] p-8 text-left text-base leading-relaxed text-[#ece6d8] shadow-[10px_10px_20px_#080602,-10px_-10px_20px_#26200e]">
    {
      title && (
        <header class="mb-6 border-b border-[#e0b429]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#dfe4ec] via-[#fbd564] to-[#e0b429] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
