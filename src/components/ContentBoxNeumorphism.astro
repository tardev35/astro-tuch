---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// รอบนี้ไฟล์นี้ถือ **สองหัวข้อของหน้าแรก**: docx H1 §1 ("<แบรนด์> เว็บสล็อตเงินดี
// ทางเข้าเล่นง่าย ยูสใหม่แตกไว" — content.txt บรรทัด 3 ย่อหน้าเต็มบรรทัด 4) และ
// docx H2 §4 ("โปรโมชั่น <แบรนด์> เปิดรับสมาชิกใหม่ทุกวัน" — บรรทัด 15 ย่อหน้า
// บรรทัด 16) ระดับหัวข้อมาจาก prop `as` ทั้งสองครั้ง
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
// (src/pages-disabled/ อ้างไฟล์นี้อยู่ด้วย แต่โฟลเดอร์นั้น Astro ไม่ route จึงไม่มี
// หน้าอื่นที่ render ไฟล์นี้จริงรอบนี้ — รีเธมในที่ได้)
//
// ───────────────────────────────────────────────────────────────────────────
// okkub88 (ดรอป 2026-10-24, .claude/brand-spec-okkub88.md §2) —
// **ชมพูบับเบิลกัมนำ · เบอร์รีเข้มเป็นหมึก · บนธีมสว่าง**
// 🚨 รอบนี้ยังสว่างเหมือนรอบก่อน (โบ๊ะบ๊ะ168) แต่คนละตระกูลฮิวสิ้นเชิง
// bg.json = {"mode":"color","color":"#ffd6fa"} = ชมพูบับเบิลกัมพาสเทล
// **ห้ามแก้การ์ดกลับไปเป็นพื้นมืด** — หมึก #6a0f3c บนการ์ดมืด = ตัวอักษรหายไปเลย
//
// ลำดับผิวรอบนี้: #ffffff การ์ด/ฝั่งสว่างของเงานูน · **#fff4fb ผิวยก (ใบนี้)** ·
// #ffe3f5 wash · #ffd6fa พื้นเพจ
//   เนื้อความ **#6a0f3c** (= BRAND_TEXT) = 11.6:1 บนผิวยกใบนี้
//   หัวข้อ **ชมพูลึก #9c0f55 ทึบ จัดกึ่งกลาง** = 7.7:1 บนผิวยกใบนี้
//   ขอบการ์ด/เส้นใต้หัวข้อ **#f9b2d9** ซึ่ง §2 ห้ามถือตัวอักษร — ที่นี่เป็นเส้นล้วน
// ⚠️ ความนูน neumorphic บนธีมสว่าง: **เงาฝั่งมืด rgba(156,15,85,α)** และ
// **เงาฝั่งสว่างเป็นผิวขาว #ffffff** ซึ่งสว่างกว่าทั้งผิวการ์ด #fff4fb และพื้นเพจ
// #ffd6fa จึงอ่านเป็นแสงได้จริง **ห้ามใช้ดำหรือชมพูสดเป็นฝั่งสว่าง**
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ
// และไม่มีแถบตั้งนำหน้า** — ความต่างของมันคือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อ
// ทึบจัดกึ่งกลางบนเส้นใต้เต็มความกว้าง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ
// 🚨🚨 **#fb439b บนผิวสว่างได้แค่ 3.3:1 — ห้ามเป็นสีตัวอักษรในไฟล์นี้เด็ดขาด**
// และ **ห้ามถมพื้น #fb439b แล้ววางหมึกขาว** (3.3:1) ใบนี้จึงไม่มี #fb439b เลย
// ⚠️ **#ffffff #fff4fb #ffe3f5 #ffd6fa #f9b2d9 #f479b9 #fc74b5 #ffc2e2 ห้ามถือ
// ตัวอักษร** ส่วน **#6a0f3c (12.1:1 บนขาว) · #95486b (6.2:1) · #9c0f55 (8.1:1) ·
// #b01160 (6.8:1) · #85094a (9.8:1) ถือตัวอักษรได้**
// ⚠️ **#9c0f55 ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(251,67,155,α) · rgba(255,194,226,α) ·
// rgba(156,15,85,α) · rgba(106,15,60,α) · rgba(249,178,217,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ชมพูผ่านรีโปนี้มาแล้วหลายเจ้า**
// "เจอชมพูแปลว่าเป็นของรอบนี้" ใช้ไม่ได้เด็ดขาด ชมพูรอบนี้คือ
// **#fb439b (R251 G67 B155)** วัดตรงจาก logo.webp ของดรอปนี้เอง
// ⚠️⚠️ **หมูบิน168 (สองรอบก่อน) ก็เป็นชมพู จึงเป็นกับดักหลักของรอบนี้**:
// fa539c c2185b 8e0f41 fb8cc0 fdc6c3 ffd1cd f7bcd9 ef8dbd ffe5ff fff0f8 ffeef7
// 3b0b26 54123a 7a2350 ffe9f5 7a4463 — ⚠️ **ffe9f5 ↔ #ffe9f7 ต่างแค่ไบต์สุดท้าย ·
// fb8cc0 ↔ #fb439b R เท่ากันเป๊ะ · f7bcd9 ↔ #f9b2d9 B เท่ากันเป๊ะ** ชุดนี้เคยอยู่
// ทั้งใบนี้ — ออกครบทุกค่าแล้ว
// ⚠️⚠️ **โบ๊ะบ๊ะ168 เป็นแบรนด์ขาออก (ฟ้าสกาย) = เสี่ยงหลงเหลือรองลงมา**:
// 00bfff 12b4ef b6e3f0 7fcbe8 4fb8ea 06283f 0b4a73 2a87c4 eaf7ff f0faff e4f6fb
// 355f7d 0f5684 1a6ea8
// ⚠️ ชมพู/แดงของแบรนด์อื่นที่ห้ามใช้: f41571 ff5ca8 (PUNPRO168 — **f41571 ใกล้
// #fb439b ที่สุดในลิสต์**) · f5469f ff8dc6 8c0f52 (มีโชค168) · fa63b9 ffb3de
// (ถอนชัวร์168) · dd1b74 a4186b 4a0d35 2d0720 (มีทรัพย์168) · fb2e33 cb0b0d d81115
// b00d11 8a0608 (สล็อต168 — ⚠️ **b00d11 ↔ #b01160 สี่ตัวแรก b01 ตรงกัน**) ·
// ff2e52 e01238 c9102f (มาดาม168) · fb1b32 ff8f9c 5c0410 (มีเฮ168) · fa0513 ff5a5f
// ffadaf (สมหวัง168) · b3121b f2bba5 (ขวัญใจ168) · ff3fa4 ffd1ea (FAH999)
// ⚠️ **รอบนี้ไม่มีฟ้า/ไซแอน/น้ำเงิน ไม่มีเขียวมิ้นต์ ไม่มีทอง/เหลือง ไม่มีส้ม
// ไม่มีม่วง ไม่มีครีม/เบจ และไม่มีแรมป์เทาเงิน** (ยกเว้น LINE green กับเขียว
// success ของฟีดถอนเงินซึ่งอยู่ไฟล์อื่น)
// ⚠️⚠️ **ผิวสว่างของรอบนี้เป็นขาวอมชมพู (R≥B>G)** ซึ่งเป็นทิศเดียวกับผิวของหมูบิน168
// — ดูทิศช่องสีไม่พอ ต้องเทียบค่าเต็มทั้งหกหลัก
// ⚠️ **หมูชมพู เหรียญทอง กล่องของขวัญ ฉากสตูดิโอขาว และสีผิวนักแสดงในอาร์ตเวิร์ก
// เป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json เท่านั้น
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f9b2d9] bg-[#fff4fb] p-8 text-left text-base leading-relaxed text-[#6a0f3c] shadow-[12px_12px_26px_rgba(156,15,85,0.14),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#f9b2d9] pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#9c0f55]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
