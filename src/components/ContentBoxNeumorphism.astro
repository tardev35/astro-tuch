---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §2 ของหน้าแรก ("<แบรนด์> ช่องทางเล่นสล็อตเว็บหลัก
// เว็บแท้อันดับ1") ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 6) หน้าเพจ
// จึงส่ง <p> เดียวเข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลังมี
// มากกว่าหนึ่งย่อหน้า ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
// ⚠️ ไฟล์นี้ยังถูกเรียกจาก src/pages-disabled/ตรวจหวย.astro และ แนวทาง.astro ด้วย
// ซึ่งรอบนี้ **จอดอยู่** (เว็บสล็อตล้วน ไม่ใช่เว็บหวย) Astro ไม่ route โฟลเดอร์นั้น
// จึงไม่มีผลกับบิลด์ แต่ก็อย่าแปลกใจที่ grep เจอ
//
// สบายเบท168 (รอบ **ฟ้าบับเบิลนำ · ทองเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือตัวอักษร
// บนดำสนิท** 2026-10-19, brand-spec §2): แผ่นนูนคือ **ผิวกลาง #081726** ที่ถูกกดเงา
// ลงไปหาผิวจม #040d16 ด้านหนึ่ง และยกแสงขึ้นด้วยน้ำเงินลึก #0b3f78 อีกด้านหนึ่ง
// ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สาม —
// น้ำเงินลึกเป็นเงาของฟ้าแบรนด์ในพาเลตต์ จึงทำหน้าที่ขอบแสงได้โดยไม่พาฮิวใหม่เข้ามา
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ซึ่ง **มืดกว่า** ทั้งผิวกลาง
// และผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้น ไม่ใช่จมลงไป ลำดับความลึก:
// #0e2238 ยก / #081726 กลาง (ใบนี้) / #040d16 จม / #000000 พื้น
//
// ใบนี้เป็นแผ่นนูนใบเดียวของหน้าที่เป็น **การ์ดเดี่ยว** และแยกจากกล่องอื่นได้สี่ทาง:
// **ไม่มี clip-path** (ต่างจาก §5 ที่เป็นมุมตัด) **มุม 25px** (ไม่ซ้ำกับ 2xl/3xl/30px
// ของใบอื่น) **ไม่มี hover ที่เปลี่ยนเงา** (ต่างจาก §3 ที่เป็นแผ่นนูนเหมือนกันแต่
// เงาไต่ขึ้นตอน hover) และ **หัวข้อเป็นฟ้าแบรนด์ #2f9ff5 ทึบสีเดียว จัดกึ่งกลาง**
// (5.9:1 — large text) ซึ่งเป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลางพร้อมกัน
// จึงไม่ซ้ำกับใบอื่นสักใบ
// (§1 เป็นหมึกเข้มบนแผ่นถมไล่ ฟ้า→ฟ้าอ่อน→ทองอ่อน · §3 ไล่ ทอง→ทองอ่อน→ฟ้า ·
// §4 ไล่ ฟ้า→ฟ้าอ่อน→ทอง · §5 ไล่ ฟ้าอ่อน→ทอง→ฟ้า · §6 ไล่ ทองอ่อน→ฟ้า→ทอง ·
// §7 ไล่ ฟ้าอ่อน→ฟ้า→ทอง · §8 ไล่ ฟ้า→ทองอ่อน→ฟ้าอ่อน)
// กรอบเป็นน้ำเงินลึก #0b3f78 เส้นใต้หัวข้อเป็นทองลึก #5c4a16 แบบโปร่ง
// เนื้อความ #e8f4ff (= BRAND_TEXT) — 16.5:1 บนผิวกลาง
// §2 ห้าม #0b3f78 #5c4a16 ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่กรอบ เงานูน และ
// เส้นใต้หัวข้อเท่านั้น · #ffc82e สงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่
// ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้มีสองชั้น: ทอง และ ฟ้า**
// ทองเป็นกับดักเดิมเพราะแทบทุกแบรนด์ที่ผ่านไฟล์นี้มีทอง ส่วนฟ้าเป็นกับดักใหม่เพราะ
// TSDET911 เคยเป็นน้ำเงินไฟฟ้าทั้งชุด และ แตกดี168 เคยเป็นฟ้าสด
// ฟ้ารอบนี้คือ #2f9ff5 / #a8dcff / #0b3f78 ไม่ใช่ 0360f3 0292fb 6ec8ff 4fb4ff
// (TSDET911) 0193fb 7bcffb (แตกดี168) 0a84e0 (HI59) หรือ cfd9e6 (เงินอมฟ้าของ
// รับตัง168) และทองรอบนี้คือ #ffc82e ไม่ใช่ ffd84d (ถอนชัวร์168) fcd434 (มีโชค168)
// f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c (สมหวัง168) e2b33f (KMD88) dfa310
// (TND168) f2c230 (KINGKONG555) e5a81b (UFA324) fad354 (789BETTING) f5c518
// (FLASH877) fce343 (PUNPRO168) f3bb34 (DUCK1688) หรือ fbe455 (WEPLAY168)
// ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (fa63b9 ffb3de
// ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทอง-ชมพูบานเย็นของ
// มีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12
// 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce
// 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203
// 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของสมหวัง168 (fa0513
// ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6
// 2c1413 1f0d0c 140706 290f0f) ชุดของ GT66B (fb141b ff5f63 ffa0a2 db040b ec151c
// 8a0609 3b0405 fdfcfd b4bcc2 eceaea 1c0c0b 130c0c 0b0303) ชุดของ TKB55 (fb131b
// ff8a8f ff4d55 e9eef4 aeb9c6 f2e4e5 2a0d0f 1a0708 0d0304 c40304 8a0206 53050a
// 1a0304) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4
// dde8f7 102a5e 0a1c42 040e26 00081f 032dad 04186e 041a43) ชุดทองมังกรของ TND168
// (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ชุดทองเป็ดของ DUCK1688 (f3bb34 fde464
// c8901a f58b2a ffc98a f6ecd9) ชุดทองอวกาศของ NAZA168 (fbc134 eef2f8 cfd6e3 9aa6bb)
// ชุดแดงเสือโคร่งของ SUPERSLOTCLUB (e8232a f2b705 ffd666) ชุดม่วงนีออนของ WEPLAY168
// (a435f0 5b1a75 1e0a3c) และชุดฟ้าสดของ แตกดี168 (0193fb 7bcffb fce604 fff48a 0a1726
// 07111d dbeafe) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม และไม่มีโรสโกลด์**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0b3f78] bg-[#081726] p-8 text-left text-base leading-relaxed text-[#e8f4ff] shadow-[10px_10px_20px_#040d16,-10px_-10px_20px_#0b3f78]">
    {
      title && (
        <header class="mb-6 border-b border-[#5c4a16]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#2f9ff5]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
