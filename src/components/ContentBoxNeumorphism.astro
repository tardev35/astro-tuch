---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// UP555 (รอบทอง + เงินโครเมียม บนดำอมน้ำตาล 2026-10-03): แผ่นนูนคือผิวการ์ดอุ่น
// #1b1005 ที่ถูกกดเงาลงไปหาพื้นดำอมน้ำตาลลึกสุด #050201 ด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวกรอบอุ่น #2e1d08 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
// หัวข้อไล่ทองลึก #ab6d24 → ทองแบรนด์ #ebbb54 → เงินโครเมียม #d5d4d3 คือไล่
// "ทองขึ้นเงิน" ซึ่งเป็นทิศกลับด้านกับ ContentBox ตัวกลางที่ไล่ทองสว่าง → ทองแบรนด์ →
// เงิน จึงคนละจังหวะสายตาบนหน้าเดียวกัน เนื้อความ #f8eed9 (BRAND_TEXT)
//
// ชุดทอง-เงินของ 1SS365 ที่เคยค้างในไฟล์นี้ (#1a1710 #2a2115 #050505 #edbb23
// #a87708 #c8cbce #f0e6d2) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#2e1d08] bg-[#1b1005] p-8 text-left text-base leading-relaxed text-[#f8eed9] shadow-[10px_10px_20px_#050201,-10px_-10px_20px_#2e1d08]">
    {
      title && (
        <header class="mb-6 border-b border-[#ebbb54]/45 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ab6d24] via-[#ebbb54] to-[#d5d4d3] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
