---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §2 ของหน้าแรก ("<แบรนด์> สล็อตไม่มีขั้นต่ำ ทุนน้อยก็เล่นได้
// การันตีได้เงินสูงทุกรอบ") ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 6)
// หน้าเพจจึงส่ง <p> เดียวเข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลัง
// มีมากกว่าหนึ่งย่อหน้า ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
// ⚠️ หัวข้อของ §2 มีคำว่า "ไม่มีขั้นต่ำ" และ "การันตีได้เงินสูงทุกรอบ" ซึ่งเป็น
// **คำของบรีฟเอง** และย่อหน้าของบรีฟก็หักล้างมันทันทีว่า "ไม่มีระบบใดรับประกันว่า
// จะได้รับเงินรางวัลสูงทุกรอบ" — ทั้งสองส่วนต้องลงครบ ห้ามตัดประโยคกำกับทิ้ง และ
// ห้ามขยายคำโฆษณานั้นไปใช้ที่อื่นที่บรีฟไม่ได้เขียนไว้ (brand-spec §6)
// ⚠️ ไฟล์นี้ยังถูกเรียกจาก src/pages-disabled/ตรวจหวย.astro และ แนวทาง.astro ด้วย
// ซึ่งรอบนี้ **จอดอยู่** (เว็บสล็อตล้วน ไม่ใช่เว็บหวย) Astro ไม่ route โฟลเดอร์นั้น
// จึงไม่มีผลกับบิลด์ แต่ก็อย่าแปลกใจที่ grep เจอ
//
// รวยแทร่168 (รอบ **ฟ้าอะซัวร์นำ · ทองอำพันเป็นฮิวที่สอง · น้ำเงินลึกไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-19, brand-spec §2): แผ่นนูนคือ **ผิวกลาง #071e38**
// ที่ถูกกดเงาลงไปหาผิวจม #030f1d ด้านหนึ่ง และยกแสงขึ้นด้วยน้ำเงินลึก #04366b
// อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จาก
// สีที่สาม — น้ำเงินลึกเป็นเงาของฟ้าอะซัวร์ในพาเลตต์ จึงทำหน้าที่ขอบแสงได้โดยไม่พา
// ฮิวใหม่เข้ามา
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ซึ่ง **มืดกว่า** ทั้งผิวกลาง
// และผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้น ไม่ใช่จมลงไป ลำดับความลึก:
// #0b2d52 ยก / #071e38 กลาง (ใบนี้) / #030f1d จม / #000000 พื้น
//
// ใบนี้เป็นแผ่นนูนใบเดียวของหน้าที่เป็น **การ์ดเดี่ยว** และแยกจากกล่องอื่นได้สี่ทาง:
// **ไม่มี clip-path** (ต่างจาก §4 ที่เป็นมุมตัด) **มุม 25px** (ไม่ซ้ำกับ 2xl/3xl/30px
// ของใบอื่น) **ไม่มี hover ที่เปลี่ยนเงา** (ต่างจาก §7 ที่เป็นแผ่นนูนเหมือนกันแต่
// เงาไต่ขึ้นตอน hover) และ **หัวข้อเป็นฟ้าอะซัวร์ #039cfa ทึบสีเดียว จัดกึ่งกลาง**
// ซึ่งเป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลางพร้อมกัน จึงไม่ซ้ำกับใบอื่นสักใบ
// (#039cfa อยู่ที่ 4.6:1 บนผิวกลางนี้ และหัวข้อนี้เป็น text-2xl/3xl font-black =
// large text จึงผ่าน AA — แต่ **ห้ามเอาไปใช้กับเนื้อความยาว**)
// (§1 เป็นหมึกเข้มบนแผ่นถมไล่ ฟ้า→ฟ้าน้ำแข็ง→ทอง · §3 ไล่ ฟ้าน้ำแข็ง→ทอง→ฟ้า ·
// §4 ไล่ ทอง→ฟ้าน้ำแข็ง→ฟ้า · §5 ไล่ ฟ้า→ทอง→ฟ้าน้ำแข็ง · §6 ไล่ ฟ้าน้ำแข็ง→ฟ้า→ทอง ·
// §7 ไล่ ทอง→ฟ้า→ฟ้าน้ำแข็ง · §8 ไล่สองสต็อป ฟ้า→ทอง)
// กรอบเป็นน้ำเงินลึก #04366b เส้นใต้หัวข้อเป็นบรอนซ์ลึก #704504 แบบโปร่ง
// เนื้อความ #e3f2fc (= BRAND_TEXT) — 13.9:1 บนผิวกลาง
// §2 ห้าม #04366b #704504 ถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่กรอบ เงานูน และ
// เส้นใต้หัวข้อเท่านั้น · #f9a826 สงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่
// ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **รอบนี้ฟ้า+ทองเป็นรอบที่สามติดกัน**
// (นินจา168 ฟ้าไซยาน+เหลืองมะนาว · สบายเบท168 ฟ้าท้องฟ้า+ทองอำพัน) การเจอฟ้าหรือทอง
// ในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ฟ้ารอบนี้คือ #039cfa / #c3ebfc / #04366b ไม่ใช่ 32bcfb a9e9ff 07335f (นินจา168)
// 2f9ff5 a8dcff 0b3f78 (สบายเบท168) 0360f3 0292fb 6ec8ff 4fb4ff (TSDET911) 0193fb
// 7bcffb (แตกดี168) 0a84e0 (HI59) หรือ cfd9e6 (เงินอมฟ้าของรับตัง168)
// และทองรอบนี้คือ #f9a826 ไม่ใช่ fef54b (นินจา168) ffc82e (สบายเบท168) ffd84d
// (ถอนชัวร์168) fcd434 (มีโชค168) f7c92b (ขวัญใจ168) f0b429 (รับตัง168) e3b23c
// (สมหวัง168) e2b33f (KMD88) dfa310 (TND168) f2c230 (KINGKONG555) e5a81b (UFA324)
// fad354 (789BETTING) f5c518 (FLASH877) fce343 (PUNPRO168) f3bb34 (DUCK1688)
// หรือ fbe455 (WEPLAY168)
// ชุดเต็มของสบายเบท168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (2f9ff5 a8dcff 0b3f78 ffc82e
// 5c4a16 e8f4ff 0e2238 081726 040d16) ชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b
// 6b5c10 0c2a3d 071a28 030e16 041019 dceefc) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168
// (fa63b9 ffb3de ffd84d 2b0f20 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทอง-
// ชมพูบานเย็นของมีโชค168 (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee
// 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e
// 8a5f12 eadfce 140c06 241509 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304
// ff6b6e a00203 4a0202 9a6c0c cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของ
// สมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303
// f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ชุดน้ำเงินไฟฟ้าของ TSDET911 (0360f3
// 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e 0a1c42 040e26 00081f) ชุดทอง
// มังกรของ TND168 (dfa310 ffe4a3 c9b88e f0e9dc 8a5c09 43240b) ชุดทองเป็ดของ DUCK1688
// (f3bb34 fde464 c8901a f58b2a ffc98a f6ecd9) ชุดทองอวกาศของ NAZA168 (fbc134 eef2f8
// cfd6e3 9aa6bb) ชุดแดงเสือโคร่งของ SUPERSLOTCLUB (e8232a f2b705 ffd666) ชุดม่วง
// นีออนของ WEPLAY168 (a435f0 5b1a75 1e0a3c) และชุดฟ้าสดของ แตกดี168 (0193fb 7bcffb
// fce604 fff48a 0a1726 07111d dbeafe) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีชมพู ไม่มีแดง ไม่มีม่วง/ไวโอเลต ไม่มีเขียว ไม่มีส้ม
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีเหลืองมะนาว**
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#04366b] bg-[#071e38] p-8 text-left text-base leading-relaxed text-[#e3f2fc] shadow-[10px_10px_20px_#030f1d,-10px_-10px_20px_#04366b]">
    {
      title && (
        <header class="mb-6 border-b border-[#704504]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#039cfa]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
