---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// หวยดีใจ (รอบแดงแบรนด์ + เงินโครเมียม บนดำอมแดง 2026-10-04, brand-spec §2):
// แผ่นนูนคือผิวการ์ด #17080c ที่ถูกกดเงาลงไปหาพื้นดำอมแดงลึกสุด #0d0407 ด้านหนึ่ง
// และยกแสงขึ้นด้วยผิวการ์ดสว่าง #211016 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมา
// จากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับ
// เส้นคั่นใต้หัวข้อแทน หัวข้อไล่แดงแบรนด์ #dc0409 → เงินกลาง #c3c7d1 → เงินสว่าง
// #eef0f4 คือไล่ "แดงขึ้นเงิน" ซึ่งเป็นทิศกลับด้านกับ ContentBox/Faq4 ที่ไล่เงินสว่าง
// → เงินกลาง → แดงสว่าง จึงคนละจังหวะสายตาบนหน้าเดียวกัน
// เนื้อความ #edeaf0 (= BRAND_TEXT)
//
// ชุดแดง + ทองของ หวย24 ที่เคยค้างในไฟล์นี้ (#170707 #0a0303 #230d0d #d20a0a
// #f5c33b #ffd45e #f7e2d6) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#211016] bg-[#17080c] p-8 text-left text-base leading-relaxed text-[#edeaf0] shadow-[10px_10px_20px_#0d0407,-10px_-10px_20px_#211016]">
    {
      title && (
        <header class="mb-6 border-b border-[#dc0409]/50 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#dc0409] via-[#c3c7d1] to-[#eef0f4] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
