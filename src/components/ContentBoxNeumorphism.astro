---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left text-base leading-relaxed` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// รอบนี้ (รวย168) ไฟล์นี้เป็น **shared chrome** เพราะถูก render จากสามหน้า:
// src/pages/index.astro (ถือ **docx H3 §4** "อัตราจ่าย 3 ตัว 1,000" พร้อมรูป
// ประกอบ banner2) · src/pages/ตรวจหวย.astro · src/pages/แนวทาง.astro
// หัวข้อมาจาก prop เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น heading ในไฟล์นี้**
//
// ───────────────────────────────────────────────────────────────────────────
// รวย168 (ดรอป 2026-10-23, .claude/brand-spec-ruay168.md §2) —
// **ทองนำ · โครเมียมเงินเป็นวัสดุที่สอง · บนดำสนิท**
// ⚠️⚠️ **รอบนี้ยังเป็นธีมมืดเหมือนรอบก่อน แต่คนละฮิวสิ้นเชิง** —
// bg.json = {"mode":"color","color":"#000000"} = **ดำสนิท** (รอบก่อน มาดาม168
// เป็น 00091f = น้ำเงินเที่ยงคืน) การ์ดจึงเป็น **ผิวมืด + หมึกสว่าง**
// **ห้าม "แก้" การ์ดให้สว่าง** — หน้าที่พึ่ง BRAND_TEXT จะตัวอักษรหายไปเลย
// ⚠️ รอบนี้โครม (navbar/footer/ticker/feed/Navfoot) กับเนื้อหา **อยู่ทิศเดียวกัน
// (มืดทั้งคู่)** ไม่ต้องดันครึ่งใดครึ่งหนึ่งไปอีกทาง
//
// ลำดับความลึกของรอบนี้: #1c1a16 ยก / **#121110 กลาง (การ์ดใบนี้)** /
// #070707 จม / #000000 พื้นเพจ (จาก bg.json)
//   เนื้อความ **#f3ece0** (= BRAND_TEXT) = 16.0:1 บนผิวการ์ดใบนี้
//   หัวข้อ **ทอง #ffd94a ทึบ จัดกึ่งกลาง** = 13.8:1 บนผิวการ์ด
//   ขอบการ์ด/เส้นใต้หัวข้อเป็น **#3d3425** ซึ่ง §2 ระบุชัดว่า **ห้ามถือตัวอักษร**
//   ที่นี่มันเป็นเส้นล้วนเท่านั้น
// ความนูนแบบ neumorphic บนธีมมืดกลับทางกับธีมสว่าง: เงาจมเป็น rgba(0,0,0,α) และ
// เงายกเป็น **ผิวยก #1c1a16** ซึ่งสว่างกว่าผิวการ์ด #121110 จึงอ่านเป็นแสงได้จริง
// **ห้ามใช้ขาวหรือทองสว่างเป็นฝั่งสว่าง** — บนพื้นมืดมันจะอ่านเป็นเส้นขอบเรืองแสง
//
// ใบนี้เป็น **ใบเดียวของหน้าที่ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ และ
// ไม่มีมุมตัด** — ความต่างของมันคือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อทึบจัด
// กึ่งกลาง** ซึ่งไม่มีกล่องอื่นบนหน้านี้ทำ
// ⚠️ **#9d6f06 / #6b7079 / #b4b9c2 / #3d3425 ห้ามถือตัวอักษร** — §2 ให้เป็น
// พื้นถม/ขอบ/ออราเท่านั้น และใบนี้ไม่มีชั้นตกแต่งให้มันอยู่
// ⚠️ **#ffd94a ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// ⚠️ #1c1a16 / #121110 / #070707 / #000000 เป็นสีพื้นเท่านั้น **ห้ามถือตัวอักษร**
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — **ทอง/เหลืองเคยผ่านรีโปนี้มา
// เกือบทุกเจ้า** "เจอทองแปลว่าเป็นของรอบนี้" ใช้ไม่ได้เด็ดขาด ทองรอบนี้คือ
// **#ffd94a (R255 G217 B74)** วัดเลื่อนมาจาก fdeb7a ของ logo.webp เอง
// ⚠️⚠️ เพื่อนบ้านที่ใกล้ที่สุดคือ **ffd84d ของถอนชัวร์168 ห่างแค่ R0/G1/B3 —
// เจอค่านั้นที่ไหนแปลว่าพิมพ์ผิด ไม่ใช่ค่าของรอบนี้**
// ⚠️⚠️ **มาดาม168 เป็นแบรนด์ขาออก = เสี่ยงหลงเหลือสูงสุด**: ff2e52 e01238 c9102f
// 1177e8 0e68cc 0a4ea8 00091f 050e26 0b1733 16234a 2a3c70 f4eef1 b3bdd6 d9dfe9
// ชุดที่เคยอยู่ในไฟล์นี้ทั้งใบและถอดออกครบแล้ว: **นาซ่า168** ฟ้าไซยาน-น้ำเงิน
// อุลตรามารีน (1fd8f0 0bb6d4 8fd9ec 1d4fd8 143aa0 e6edf8 9fb2cb 273449 1b2434
// 121722 33455f 0d1017) · **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4
// 29210f 3d3016 332810 201906 2e2512 1b1407 4d3c15) · **สบาย168** (2cc3fc 6bdcfb
// 9ae0fa 0a7fbd 063a57 0f3a4a fdcb0c fefb6b 8a6504 f2fbff dff4fd ccf7ff cdf2ff
// eafaff a9e3f9 04293d 0a4f74 06293c) · **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05
// e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10) ·
// **โปรดี168** (eb0305 9b0a0c ff4446 c20305 b44c06 7a2f03 f0b46a d9803a 4d1c0a
// 2c1004 1a0802 401107 fff0e4 fff4ea ffd1d1) · **รวยแท้168** (c30303 8f0505 e81313
// dcb95f b8862b 96681f 4a0f0f 280b0b 461212 ffeee8 fff1ef ffdbdb) · **สาธุ168**
// (0b7d28 0a5f1c 0f9b35 0c3a16 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd)
// ⚠️ ทองของแบรนด์อื่นที่ต้องเทียบทีละค่า ห้ามกะด้วยตา: eeae12 fded41 9f600d
// (พักยก168) · fbc134 ffe87a cf9a18 96690a (NAZA168 ตัวละติน) · e5a81b ffe08a
// (UFA324) · fef54b (นินจา168) · d4922c fdfc71 (ufalion168) · fcd434 ffeaa0
// (มีโชค168) · cd9a2c fdeb7c ab7314 (หวยคิง) · f0b429 ffdc8c (รับตัง168) ·
// ffc93c ffeab0 (หวย365) · fcd45c (มีเฮ168) · e3b23c (สมหวัง168) · ffc82e
// (สบายเบท168) · f9a826 (รวยแทร่168) · f7c92b (ขวัญใจ168) · f0bb4e (รวยเทพ168) ·
// f0c878 (ดวงเศรษฐี168) · f5b61d (PIGPG)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีน้ำเงิน/ฟ้า ไม่มีส้ม
// ไม่มีเขียว (ยกเว้น LINE green และเขียว success ที่ไฟล์อื่น) ไม่มีครีม ไม่มีพีช
// และไม่มีน้ำตาล** — ลิปสติกแดง ผมขาวเงิน และสูทขาวในอาร์ตเวิร์กเป็น **วัตถุใน
// ภาพ ไม่ใช่สี UI** ส่วนโครเมียมเงิน #e8eaee มาจาก **เวิร์ดมาร์ก "รวย"** โดยตรง
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3d3425]/70 bg-[#121110] p-8 text-left text-base leading-relaxed text-[#f3ece0] shadow-[12px_12px_26px_rgba(0,0,0,0.55),-12px_-12px_26px_#1c1a16]">
    {
      title && (
        <header class="mb-6 border-b border-[#3d3425]/70 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#ffd94a]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
