---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once, and it is checked every
// round). The card keeps `text-left text-base leading-relaxed` and the slot
// renders as a direct child; do not re-add a content wrapper <div>, and do not
// remove one that is doing real layout.
//
// หัวข้อมาจาก prop `title` + `as` เท่านั้น — **ห้าม hardcode ข้อความไทยเป็น
// heading ในไฟล์นี้ และห้าม hardcode ระดับ heading**
//
// รอบนี้ (ดรอป 2026-10-28) ไฟล์นี้ถูก render จาก **/ตรวจหวย กับ /แนวทาง** เท่านั้น
// (หน้าแรกหมุน shape-mix ไปใช้ตระกูลอื่นทั้งชุด) สองหน้านั้นถูกย้ายกลับเข้า
// src/pages/ เพราะแบรนด์รอบนี้เป็นเว็บหวยเต็มตัว หัวข้อที่ส่งเข้ามาจึงเป็น
// **หัวข้อของบทความในหน้านั้นเอง** ไม่ใช่หัวข้อจากเช็กลิสต์ของหน้าแรก
//
// ⚠️ ห้ามพิมพ์ชื่อคลาสสีเต็มรูปในคอมเมนต์ — Tailwind สแกนไฟล์นี้เป็น plain text
// รวมถึงคอมเมนต์ด้วย ยูทิลิตี้ของค่านั้นจะถูก generate ลง stylesheet จริง
// (เฮกซ์ด้านล่างจึงเขียนแบบ **ไม่มี #** ด้วยเหตุผลเดียวกัน และเพื่อไม่ให้ sweep
// ที่ไล่หาสีของแบรนด์เก่าใน src/ สะดุดที่คอมเมนต์ของไฟล์นี้เอง)
// ⚠️ และ **ห้ามคัดลอก "คลังเฮกซ์ของแบรนด์เก่า" ลงในคอมเมนต์ของไฟล์นี้** —
// ลิสต์เดียวที่อัปเดตที่เดียวอยู่ที่ `.claude/brand-spec-lottoplus.md` §2
//
// ───────────────────────────────────────────────────────────────────────────
// รอบนี้ (ดรอป 2026-10-28) พาเลตตาม `.claude/brand-spec-lottoplus.md` §2 —
// **เขียวมรกตนำ · ทองอำพัน/เงินโครเมียมคู่รอง · เนื้อหาเป็นผิวสว่าง**
// 🚨🚨 bg.json ของดรอปนี้ = {"mode":"color","color":"#e1fef3"} = เขียวมินต์จาง
// เกือบขาว และ bg.json คือ **แหล่งเดียว** ของพื้นเพจ — เปิดอ่านทุกรอบ ห้ามสืบทอด
// ค่าข้ามรอบ
// 🚨🚨 **ไฟล์นี้เพิ่งถือพาเลตการ์ดมืดของแบรนด์ก่อนมาเต็มใบ — รอบนี้กลับทิศ 180°**
// การ์ดเป็น **ผิวสว่าง หมึกเข้ม** ทั้งใบ **ห้าม "แก้" กลับไปเป็นการ์ดมืด** เพราะ
// หมึก 0d3326 (= BRAND_TEXT ของรอบนี้) บนการ์ดมืดคือตัวอักษรที่ **หายไปเลย**
// ไม่ใช่แค่จางลง และการ์ดมืดใบเดียวบนพื้นเพจสว่างคือแผ่นดำกลางหน้า
// ⚠️ โครม (navbar/footer/ticker) เป็นเขียวเข้ม 052e22 / 03201a / 0a4433 แต่ไฟล์นี้
// อยู่ใน **โซนเนื้อหา** จึงไม่เดินตามโครม
//
// ลำดับผิวรอบนี้: ffffff ฝั่งสว่างของเงานูน · **f0fdf7 ผิวการ์ด (ใบนี้)** ·
// d2f3e4 พื้นถม/ชั้นยก · e1fef3 พื้นเพจ
//   เนื้อความ **0d3326** (= BRAND_TEXT) = 13.4:1 บนผิวการ์ดใบนี้
//   หัวข้อ **เขียวมรกต 046c4e ทึบ จัดกึ่งกลาง** = 6.5:1 บนผิวการ์ดใบนี้
//   ขอบการ์ด/เส้นใต้หัวข้อ **a3ddc3** ซึ่ง §2 ห้ามถือตัวอักษร — ที่นี่เป็นเส้นล้วน
// ⚠️ ความนูน neumorphic บนธีมสว่างกลับทางกับธีมมืด: **เงาฝั่งมืดเป็น
// rgba(13,51,38,α) แบบเบา** และ **เงาฝั่งสว่างเป็นขาว ffffff** ซึ่งอ่านเป็นแสง
// ได้จริงเพราะสว่างกว่าทั้งผิวการ์ด f0fdf7 และพื้นเพจ e1fef3
// 🚨 **ห้ามใช้ดำหรือเขียวสดเป็นเงาฝั่งสว่าง** และ **ห้ามลอกค่า alpha 0.45-0.55
// ของธีมมืดรอบก่อนมา** — บนการ์ดสว่างจะกลายเป็นคราบเทาหนา รอบนี้ฝั่งมืดคือ
// rgba(13,51,38,0.10) และ hover ยกเป็น rgba(4,108,78,0.18)
//
// ความต่างของใบนี้คือ **เงานูน-จมคู่ 12px/-12px กับหัวข้อทึบจัดกึ่งกลางบนเส้นใต้
// เต็มความกว้าง** — ไม่มีป้ายลอย ไม่มีออราเบลอ ไม่มีไล่เฉดบนหัวข้อ
// 🚨🚨 **19a97c (3.0:1) · 2fd49b · a3ddc3 · d2f3e4 · e2b32a (2.0:1) ห้ามเป็นสี
// ตัวอักษรในไฟล์นี้เด็ดขาด** เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น
// ⚠️ ค่าที่ถือตัวอักษรบนการ์ดสว่างได้: **0d3326 (13.4:1) · 046c4e (6.5:1) ·
// 3f6f5c (5.8:1) · 8a6508 (5.2:1)**
// ⚠️ **046c4e ในเนื้อความเป็นงานของ <strong> บนหน้าเพจ** ไม่ใช่ของไฟล์นี้
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) ·
// rgba(47,212,155,α) · rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) ·
// rgba(3,32,26,α)
//
// ⚠️⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — รอบนี้เป็นแบรนด์เขียว และ
// **มีแบรนด์เก่าหลายเจ้าในรีโปนี้ที่ก็เป็นเขียว** (รวมถึงเจ้าที่เป็นเขียวมรกต/
// ทองสัมฤทธิ์ = ตระกูลสีเดียวกับรอบนี้เป๊ะ) → **"เจอเขียวหรือทอง ไม่ได้แปลว่า
// เป็นของรอบนี้"** ต้องตรวจทีละหกหลักกับตารางใน §2 และถ้าเจอค่าที่ต่างจาก §2
// แค่ไบต์เดียว ให้ถือว่า **พิมพ์ผิด** ก่อนเสมอ ไม่ใช่ "มันก็เขียวเหมือนกัน"
// ⚠️ รอบนี้ **ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีชมพู/แมเจนต้า ไม่มีแดง/เลือดหมู
// ไม่มีส้มเพลิง และไม่มีผิวมืดในโซนเนื้อหาเลยสักเฉด** (เขียว 00B900 ของปุ่ม LINE
// และเขียว success ของฟีดถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืนเข้าเขียวมรกต
// ของรอบนี้** — รอบนี้สับสนง่ายที่สุดเพราะแบรนด์ก็เป็นเขียว)
// ⚠️ **ผิวโครเมียมเงินของเวิร์ดมาร์ก ผนังห้องสีขาวงาช้าง สีผิวนางแบบ ดอกลีลาวดี
// และยอดปรางค์ทองในอาร์ตเวิร์กเป็นวัตถุในภาพ ไม่ใช่สี UI** — พื้นเพจมาจาก bg.json
// เท่านั้น **ห้ามอนุมานจากรูป** (รอบนี้รูปสว่างและเว็บก็สว่าง ซึ่งเป็นเรื่องบังเอิญ
// รอบก่อนรูปสว่างแต่เว็บมืดสนิท)
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a3ddc3] bg-[#f0fdf7] p-8 text-left text-base leading-relaxed text-[#0d3326] shadow-[12px_12px_26px_rgba(13,51,38,0.10),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#a3ddc3] pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#046c4e]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
