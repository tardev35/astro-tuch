---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// CK268 (รอบเขียวนีออน-โครเมียม-ดำ 2026-09-30): แผ่นนูนคือผิวการ์ดเขียวเข้ม
// #0f1b0e ที่ถูกกดเงาลงไปหาพื้นเพจ #030703 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวแผงยก
// #1b2f19 อีกด้านหนึ่ง ความนูนแบบ neumorphic มาจากคู่มืด/สว่างภายในโทนเขียว
// เกือบดำเดียวกัน ไม่ใช่จากสีที่สอง คอนทราสต์เดียวในการ์ดคือเส้นเขียวนีออน
// #8bfc13 ใต้หัวข้อกับตัวไล่เฉดของหัวข้อเอง ซึ่งวิ่งโครเมียมขาว #e8f0e6 →
// เขียวนีออน → เขียวลึก #1a7a08 ตามโลโก้ที่สลับตัวอักษรโครเมียมกับเขียวนีออน
// กรอบเป็นเขียวลึก เนื้อความ #d5e6cd (BRAND_TEXT) — ชุดแดง-ทองของ LOTTOPLUS ที่
// ค้างในไฟล์นี้ (#dc2626 #ff2d38 #f3c623 #fde79a #8a6a0a #1f0a0c #2f1013
// #050505 #f0e2e2) ออกทั้งหมด
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1a7a08] bg-[#0f1b0e] p-8 text-left text-base leading-relaxed text-[#d5e6cd] shadow-[10px_10px_20px_#030703,-10px_-10px_20px_#1b2f19]">
    {
      title && (
        <header class="mb-6 border-b border-[#8bfc13]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#e8f0e6] via-[#8bfc13] to-[#1a7a08] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
