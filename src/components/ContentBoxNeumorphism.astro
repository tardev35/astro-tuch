---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H3 §5 ของหน้าแรก ("โปรโมชั่น แนะนำเพื่อน โบนัส 0.8% ไม่จำกัด")
// ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 13) หน้าเพจจึงส่ง <p> เดียว
// เข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลังมีมากกว่าหนึ่งย่อหน้า
// ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
//
// สมหวัง168 (รอบแดงมังกร-ทองไทย 2026-10-17, brand-spec §2):
// แผ่นนูนคือ **ผิวกลาง #1f0d0c** ที่ถูกกดเงาลงไปหาผิวจม #140706 ด้านหนึ่ง และยกแสง
// ขึ้นด้วยแดงมืด #3c0303 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำอมแดง #290f0f** (bg.json) ซึ่ง **สว่างกว่า** ผิวกลางกับ
// ผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่จมลงไปในพื้น ไม่ใช่ลอยขึ้นมา — เป็นผลที่ต้องการ
// และเป็นจังหวะเดียวของหน้าที่ทำแบบนี้ ลำดับความลึก: #2c1413 ยก / #1f0d0c กลาง
// (ใบนี้) / #140706 จม / #290f0f พื้น
//
// ใบนี้เป็นแผ่นนูนใบที่สองของหน้า และแยกจาก ContentBoxTwoNeumorphism (§2) ได้สี่ทาง:
// **ความลึกของผิว** (กลางที่นี่ vs ยกที่นั่น) **มุม** (25px vs 30px) **กรอบ** (ใบนี้
// มีกรอบ #3c0303 ใบนั้นไม่มีกรอบเลย) และ **จำนวนคอลัมน์** (เดี่ยว vs สอง) นอกจากนี้
// ใบนี้ไม่มี hover ที่เปลี่ยนเงา ส่วนใบนั้นเงาขยายตอน hover
// หัวข้อเป็น **แดงสว่าง #ff5a5f ทึบสีเดียว จัดกึ่งกลาง** (5.7:1 — large text) ซึ่ง
// เป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลางพร้อมกัน จึงไม่ซ้ำกับใบอื่นสักใบ
// (§1 ไล่ แดงสว่าง→ทองสว่าง→ทองไทย · §2 ไล่ ทองไทย→แดงสว่าง→ทองสว่าง · §3 ทองสว่าง
// ทึบชิดซ้าย · §4 ไล่ ทองสว่าง→ทองไทย→แดงสว่าง · §6 ไล่ ทองไทย→ทองสว่าง→แดงสว่าง ·
// §7 เป็นหมึกเข้มบนแผ่นทองทึบ · §8 ไล่ แดงสว่าง→ทองไทย→ทองสว่าง)
// กรอบเป็นแดงมืด #3c0303 เส้นใต้หัวข้อเป็นทองลึก #8a6210 แบบโปร่ง
// เนื้อความ #f4ecea (= BRAND_TEXT)
// §2 ห้าม #fa0513 #b90203 #8c0204 #5b0203 #3c0303 #8a6210 ถือตัวอักษรทุกขนาด —
// ในไฟล์นี้อยู่ที่กรอบ เงานูน และเส้นใต้หัวข้อเท่านั้น
// #ffadaf สงวนไว้ให้ <strong> ในเนื้อความตาม §2 จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** แบรนด์สองรอบก่อน
// หน้าก็เป็นแดง: GT66B #fb141b (G=20) · TKB55 #fb131b (G=19) ส่วนรอบนี้ #fa0513
// (R=250 G=5 B=19) ชุดเต็มของ GT66B ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#fb141b #ff5f63
// #ffa0a2 #db040b #ec151c #8a0609 #3b0405 #fdfcfd #b4bcc2 #eceaea #1c0c0b #130c0c
// #0b0303 #000000) ชุดของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5
// #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ชุดน้ำเงินไฟฟ้าของ
// TSDET911 (#0360f3 #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e
// #0a1c42 #040e26 #00081f #032dad #04186e #041a43) ชุดทองมังกรของ TND168 (#dfa310
// #ffe4a3 #c9b88e #f0e9dc #8a5c09 #43240b) ชุดทองเป็ดของ DUCK1688 (#f3bb34 #fde464
// #c8901a #f58b2a #ffc98a #f6ecd9) ชุดทองอวกาศของ NAZA168 (#fbc134 #eef2f8 #cfd6e3
// #9aa6bb) ชุดแดงเสือโคร่งของ SUPERSLOTCLUB (#e8232a #f2b705 #ffd666) ชุดม่วงนีออน
// ของ WEPLAY168 (#a435f0 #5b1a75 #1e0a3c) และชุดฟ้าสดของ แตกดี168 (#0193fb #7bcffb
// #fce604 #fff48a #0a1726 #07111d #dbeafe) ออกครบทุกค่าแล้ว
// ⚠️ **รอบนี้ไม่มีโครเมียม/เงิน ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว
// ไม่มีส้ม** และแดงของแบรนด์อื่นที่ยังอยู่ในไฟล์ inventory — #e8232a
// (SUPERSLOTCLUB) #d4200d (PIGPG) #ff3b14 (FLASH877) — ไม่ใช่ #fa0513 สักค่าเดียว
// ⚠️ ทองรอบนี้ #e3b23c / #ffe5a8 / #8a6210 ไม่ใช่ #dfa310 / #ffe4a3 / #8a5c09 ของ
// TND168 ที่ใกล้ที่สุด — ให้เทียบเป็นตัวเลขทีละค่า ห้ามกะด้วยตา
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3c0303] bg-[#1f0d0c] p-8 text-left text-base leading-relaxed text-[#f4ecea] shadow-[10px_10px_20px_#140706,-10px_-10px_20px_#3c0303]">
    {
      title && (
        <header class="mb-6 border-b border-[#8a6210]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#ff5a5f]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
