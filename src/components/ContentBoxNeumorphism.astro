---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §7 ของหน้าแรก ("แอดมิน <แบรนด์> เปิดบริการ 24 ชั่วโมง")
// ซึ่งบรีฟรอบนี้ให้มาสองย่อหน้า (content.txt บรรทัด 20 กับ 21) หน้าเพจจึงห่อทั้งคู่
// ไว้ใน <div class="flex flex-col gap-4"> เดียวตามกฎบ้าน เพราะสล็อตเดี่ยวนี้รับลูก
// ได้หนึ่ง element และการส่งสอง <p> เป็นพี่น้องกันจะเปลี่ยนระยะห่างของการ์ด
//
// GT66B (รอบแดงมังกร-โครเมียมขาวบนดำสนิท 2026-10-13, brand-spec §2):
// แผ่นนูนคือผิวการ์ดยก #1c0c0b ที่ถูกกดเงาลงไปหา **พื้นเพจดำสนิท #000000** ด้านหนึ่ง
// และยกแสงขึ้นด้วยแดงดำ #3b0405 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่
// มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่น
// ใต้หัวข้อเท่านั้น
// ⚠️ พื้นเพจรอบนี้เป็นดำสนิท (bg.json = {"mode":"color","color":"#000000"}) เงา
// ด้านมืดจึงเท่ากับพื้นเพจพอดี ขอบด้านนั้นกลืนหายไปในพื้น — เป็นผลที่ต้องการ
// ลำดับความลึก: #1c0c0b ยก (ใบนี้) / #130c0c กลาง / #0b0303 จม / #000000 พื้น
//
// ใบนี้เป็น **แผ่นนูนใบเดียวของหน้า** และเป็นใบเดียวที่ไม่มีเงาทิศเดียวแบบการ์ดอื่น
// แต่มีคู่เงากด/ยกตรงข้ามกัน จึงแยกจาก ContentBox (§3) ที่เป็น rounded-3xl ผิวยก
// ทึบพร้อมออราสองมุม และจาก ContentBoxPremium (§1) ที่เป็น rounded-3xl ไล่ผิว
// มุมของใบนี้เป็น rounded-[25px] ซึ่งไม่ซ้ำกับใบไหนบนหน้าเดียวกัน
//
// หัวข้อไล่ โครเมียมหม่น #b4bcc2 → โครเมียมสว่าง #fdfcfd → แดงสว่าง #ff5f63 ซึ่งเป็น
// ลำดับ "โครเมียมนำลงแดง" ที่ไม่ซ้ำกับกล่องอื่นบนหน้าเดียวกันสักใบ
// (§1 ไล่ แดงสว่าง→โครเมียมสว่าง→โครเมียมหม่น · §2 ไล่ แดงแบรนด์→โครเมียมหม่น→
// โครเมียมสว่าง · §3 ไล่ โครเมียมสว่าง→แดงอ่อน→แดงแบรนด์ · §4 เป็นโครเมียมสว่างทึบ
// สีเดียว · §5 ไล่ โครเมียมหม่น→แดงสว่าง→โครเมียมสว่าง · §6 ไล่ โครเมียมสว่าง→
// โครเมียมหม่น→แดงสว่าง · §8 ไล่ แดงแบรนด์→แดงสว่าง→โครเมียมสว่าง)
// กรอบเป็นแดงดำ #3b0405 เส้นใต้หัวข้อเป็นแดงถ่าน #8a0609 แบบโปร่ง
// เนื้อความ #eceaea (= BRAND_TEXT, 15.9:1 บนผิวยก #1c0c0b)
// #ffa0a2 ถูกสงวนไว้ให้ <strong> ในย่อหน้าตาม §2 จึงไม่โผล่ในไฟล์นี้
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** แบรนด์รอบก่อนหน้า
// ทันที (TKB55) ก็เป็นแดง-โครเมียม-ดำ และแดงของมันคือ #fb131b ส่วนรอบนี้คือ #fb141b
// ต่างกันหนึ่งหลัก ชุดเต็มของ TKB55 (#fb131b #ff8a8f #ff4d55 #e9eef4 #aeb9c6 #f2e4e5
// #2a0d0f #1a0708 #0d0304 #c40304 #8a0206 #53050a #1a0304) ไม่เหลือในไฟล์นี้
// ชุดน้ำเงินไฟฟ้า-เงินโครเมียมของ TSDET911 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (#0360f3
// #0292fb #6ec8ff #4fb4ff #cfdcec #9db4d4 #dde8f7 #102a5e #0a1c42 #040e26 #00081f
// #032dad #04186e #041a43) ชุดทองมังกรของ TND168 (#dfa310 #ffe4a3 #c9b88e #f0e9dc
// #8a5c09 #43240b #1b1307 #120c04 #070502) ชุดทองเป็ด-ส้มปากเป็ดของ DUCK1688
// (#f3bb34 #fde464 #c8901a #f58b2a #ffc98a #f6ecd9 #d8c69b) ชุดทองอวกาศ-เงินโครเมียม
// ของ NAZA168 (#fbc134 #eef2f8 #cfd6e3 #9aa6bb #fdf3df) ชุดแดงเสือโคร่ง-ทองของ
// SUPERSLOTCLUB (#e8232a #f2b705 #ffd666) ชุดม่วงนีออน-ทองของ WEPLAY168 (#a435f0
// #5b1a75 #1e0a3c) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168 (#0193fb #7bcffb #fce604
// #fff48a #0a1726 #07111d #dbeafe) ออกครบทุกค่าแล้ว
// ⚠️ **รอบนี้ไม่มีทอง ไม่มีม่วง ไม่มีชมพู ไม่มีน้ำเงิน ไม่มีฟ้า ไม่มีเขียว ไม่มีส้ม**
// และแดงของแบรนด์อื่นที่ยังอยู่ในไฟล์ inventory — #e8232a (SUPERSLOTCLUB) #d4200d
// (PIGPG) #ff3b14 (FLASH877) — ไม่ใช่ #fb141b ของรอบนี้สักค่าเดียว
// ⚠️ #fb141b #db040b #ec151c #8a0609 #3b0405 ห้ามถือตัวอักษรทุกขนาด — ในไฟล์นี้อยู่ที่
// กรอบ เงานูน และเส้นใต้หัวข้อเท่านั้น
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3b0405] bg-[#1c0c0b] p-8 text-left text-base leading-relaxed text-[#eceaea] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#3b0405]">
    {
      title && (
        <header class="mb-6 border-b border-[#8a0609]/60 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#b4bcc2] via-[#fdfcfd] to-[#ff5f63] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
