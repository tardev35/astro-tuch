---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too (that exact bug shipped in this file once). The card keeps
// `text-left` and the slot renders as a direct child; do not re-add a content
// wrapper <div>.
//
// ไฟล์นี้ถูก render จากสองหน้าหวยเท่านั้น: src/pages/ตรวจหวย.astro และ
// src/pages/แนวทาง.astro ซึ่งรอบนี้ **เปิดอยู่** เพราะบรีฟทั้งฉบับเป็นเว็บหวยล้วน
// (หวยรัฐบาลไทย · หวยลาวพัฒนา · หวยฮานอย · หวยหุ้นต่างประเทศ)
// ⚠️ ข้อยกเว้น Phase 4.5 ของ playbook คุ้มครอง **ชุดคอมโพเนนต์** ของสองหน้านั้น
// (ชุด Huay/Neumorphism) ไม่ได้คุ้มครองสีหรือชื่อแบรนด์ — ไฟล์นี้จึงใช้พาเลตของ
// รอบปัจจุบันเต็มรูปแบบเหมือนทุกไฟล์ที่ render
//
// พาเลตรอบนี้ (brand-spec §2 — แดงเลือดหมูนำ ทองโบราณรอง **ธีมสว่าง**):
// ไฟล์นี้อยู่ในโซน "เนื้อหา" จึงเป็น **การ์ดสว่าง หมึกเข้ม** ไม่ใช่โครม
//   ผิวการ์ด (ชั้นยก) #ffffff · ชั้นกลาง/อินเซ็ต #fff1ef · พื้นเพจ #ffdbdb (bg.json)
//   เนื้อความหมึกแดงเลือดหมู #4a0f0f = 15.4:1 บนผิวการ์ด
//   หัวข้อ/ขอบ/เส้นใต้หัวข้อแดงสด #c30303 = 6.3:1 บนผิวการ์ด
// ความนูนแบบ neumorphic ของธีมสว่างกลับทางกับธีมมืด: เงาจมเป็น rgba(74,15,15,α)
// (หมึกของพาเลตเอง ไม่ใช่สีที่สาม) และเงายกเป็น #ffffff ซึ่งอ่านเป็นแสงได้จริง
// เพราะพื้นเพจ #ffdbdb เข้มกว่าผิวการ์ดขาว ลำดับความลึก: #ffffff ยก /
// #fff1ef กลาง / #ffdbdb พื้นเพจ
// ⚠️ **ไม่มีทองโบราณทั้งสามค่า (#dcb95f #b8862b #96681f) ในไฟล์นี้** — บนการ์ด
// ขาวได้แค่ 1.9–3.5:1 ตกเกณฑ์ทุกขนาด ทองเป็นสีของโครม (navbar/footer/ticker/feed)
// เท่านั้น และ **ไม่มีแดงสแกเลต #e81313** เพราะ §2 ห้ามมันถือตัวอักษรและห้ามเป็น
// พื้นของตัวอักษร ซึ่งในการ์ดใบนี้ทุกชั้นมีตัวอักษรอยู่ · #8f0505 สงวนไว้ให้
// ไฮไลต์บน <strong> ในย่อหน้าเท่านั้น หน้าเพจเป็นผู้เขียนคลาสนั้นเอง
// ⚠️ #fff1ef / #ffdbdb เป็นสีพื้น/เส้น/เงาเท่านั้น ห้ามถือตัวอักษร
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **กับดักรอบนี้คือแดง** เพราะแดงนำแบรนด์
// ผ่านรีโปนี้มามากกว่าฮิวอื่นทั้งหมด ชุดของเจ้าของเดิมและของรอบก่อน ๆ ออกครบทุกจุด
// แล้ว: รอบก่อนทันที เขียวมรกต-ทองสัมฤทธิ์ธีมสว่าง (0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c c9cb63 aeb04a 9ba03c d8ffc7 e9fbdd rgba 11/125/40 a · rgba 12/58/22 a) ·
// เจ้าของเดิมของไฟล์ชุด Huay ทอง-ดำ (cd9a2c fdeb7c ab7314 f5e7c8 fcd4c3 fce2d4
// 0c0b0a 120a02 1c140b) · ชุดแดง-ทองของ หวย365 (140203 dc0203 f5282a ffc93c
// ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) · ชุดชมพูบานเย็น (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) · ชุดทองน้ำผึ้ง-แดงเลือดหมู (f0c878 fff8d8 d9212a
// 8e1a16 300605 150303 4e2120 2a0608)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีเขียว ไม่มีชมพู ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม และไม่มีทองส้มสด** — ความต่างของรอบนี้คือพื้นเพจชมพูอมแดง
// #ffdbdb กับหมึก #4a0f0f ไม่ใช่ค่าแดงเดี่ยว ๆ
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#c30303]/30 bg-white p-8 text-left text-base leading-relaxed text-[#4a0f0f] shadow-[12px_12px_26px_rgba(74,15,15,0.16),-12px_-12px_26px_#ffffff]">
    {
      title && (
        <header class="mb-6 border-b border-[#c30303]/35 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#c30303]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
