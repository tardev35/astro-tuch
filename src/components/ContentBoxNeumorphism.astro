---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 #6 ของหน้าแรก (สมัครเล่นสล็อต 3 ขั้นตอน) ซึ่งบรีฟรอบนี้ให้มา
// หนึ่งย่อหน้าเกริ่น ส่วน "ขั้นตอนที่ 1/2/3" ที่ตามมาเป็นหัวข้อย่อยสามข้อ จึงถูกส่งไป
// ให้ FeatureHighlights เรนเดอร์เป็น <h3> สามใบที่วางถัดจากการ์ดนี้ (เป็น sibling
// ไม่ใช่ลูกในสล็อต เพราะสล็อตรับได้หนึ่งอิลิเมนต์และห้ามเติม wrapper <div> ข้างใน)
// ไฟล์นี้ไม่ได้บังคับความกว้างหรือสีให้ลูกในสล็อตเลย — รอบนี้ไม่มี banner2 ของดรอป
// ปัจจุบัน (ไฟล์ที่ค้างบนดิสก์เป็นงานอาร์ตของแบรนด์ก่อน) จึงไม่มีรูปประกอบในกล่องนี้
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10, brand-spec §2):
// แผ่นนูนคือผิวการ์ดกลาง #171106 ที่ถูกกดเงาลงไปหาดำสนิทด้านหนึ่ง และยกแสงขึ้นด้วย
// ผิวการ์ดยก #1f1709 อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างใน
// โทนเดียวกัน ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน
// ⚠️ รอบนี้พื้นเพจเป็นดำสนิท เงาด้านมืดจึงเท่ากับพื้นเพจพอดี (#000000) ซึ่งทำให้ขอบ
// ด้านนั้นกลืนหายไปในพื้นจริงๆ — เป็นผลที่ต้องการ ไม่ใช่ความผิดพลาด
//
// หัวข้อไล่ครีมอุ่น #f6ecd9 → ทองสว่าง #fde464 → ส้มอำพัน #f58b2a คือไล่ "ครีมนำลงส้ม"
// ซึ่งไม่ซ้ำลำดับกับกล่องอื่นบนหน้าเดียวกันสักใบ (ContentBoxCyberCut ไล่
// ทองสว่าง→ส้ม→ทอง · ContentBoxTwoPremium ไล่ส้มอ่อน→ทอง→ทองสว่าง ·
// ContentBoxSevenThreePremium ไล่ทอง→ส้มอ่อน→ส้ม · ContentBoxSpecial ไล่
// ส้ม→ทองสว่าง→ทอง)
// กรอบเป็นผิวการ์ดยก #1f1709 เส้นใต้หัวข้อเป็นทองลึก #8a5f08 แบบโปร่ง
// เนื้อความ #f6ecd9 (= BRAND_TEXT, 15.9:1 บนผิว #171106)
//
// ⚠️ ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 รอบก่อน (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) ชุดแดงเสือโคร่ง-
// ทองถ่านไฟของ SUPERSLOTCLUB ที่เคยค้างในไฟล์นี้ (#301105 #3d1709 #ffd666 #f2b705
// #ff5a46 #a8730a #fbe8d5) ชุดม่วงนีออน-ทองอาร์เขตของ WEPLAY168 (#17062e #1e0a3c
// #c98a05 #fbe455 #ffd23d #d2a6ff #ece2ff) และชุดฟ้าสด-เหลืองมะนาวของ แตกดี168
// (#0a1726 #07111d #fce604 #fff48a #7bcffb #c9a703 #dbeafe) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1f1709] bg-[#171106] p-8 text-left text-base leading-relaxed text-[#f6ecd9] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1f1709]">
    {
      title && (
        <header class="mb-6 border-b border-[#8a5f08]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#f6ecd9] via-[#fde464] to-[#f58b2a] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
