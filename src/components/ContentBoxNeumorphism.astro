---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §2 ของหน้าแรก ("<แบรนด์> เล่นสล็อต ยิงปลา ไฮโล แทงหวย
// ครบวงจร") ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 6) หน้าเพจจึงส่ง
// <p> เดียวเข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลังมีมากกว่า
// หนึ่งย่อหน้า ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
// ⚠️ หัวข้อของ §2 ไล่ชื่อหมวดเกมสี่หมวดที่ **บรีฟรอบนี้ระบุเอง** (สล็อต ยิงปลา
// ไฮโล แทงหวย) ซึ่งต่างจากรอบก่อนที่คำเหล่านี้ถูกแบน — brand-spec §6 รอบนี้อนุญาต
// เพราะบรีฟใช้เอง และย่อหน้าของบรีฟก็กำกับทันทีว่า "เกมเหล่านี้มีความเสี่ยงต่อการ
// สูญเสียเงิน และไม่มีรูปแบบใดรับประกันผลกำไรจากการเดิมพัน" — ทั้งสองส่วนต้องลงครบ
// ห้ามตัดประโยคกำกับทิ้ง และห้ามขยายคำโฆษณาไปใช้ที่อื่นที่บรีฟไม่ได้เขียนไว้
// ⚠️ ไฟล์นี้ยังถูกเรียกจาก src/pages-disabled/ตรวจหวย.astro และ แนวทาง.astro ด้วย
// ซึ่งรอบนี้ **จอดอยู่** (แบรนด์บอกตัวเองว่าเป็นเกมสล็อต ไม่ใช่เว็บหวย) Astro ไม่
// route โฟลเดอร์นั้น จึงไม่มีผลกับบิลด์ แต่ก็อย่าแปลกใจที่ grep เจอ
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20, brand-spec §2): แผ่นนูนคือ **ผิวกลาง #260d04** ที่ถูกกด
// เงาลงไปหาผิวจม #0d0501 ด้านหนึ่ง และยกแสงขึ้นด้วยบรอนซ์ลึก #5c2a06 อีกด้านหนึ่ง
// ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สาม —
// บรอนซ์ลึกเป็นเงาของทองในพาเลตต์ จึงทำหน้าที่ขอบแสงได้โดยไม่พาฮิวใหม่เข้ามา
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ซึ่ง **มืดกว่า** ทั้งผิวกลาง
// และผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้น ไม่ใช่จมลงไป ลำดับความลึก:
// #3b1b0e ยก / #260d04 กลาง (ใบนี้) / #0d0501 จม / #000000 พื้น
//
// ใบนี้เป็นแผ่นนูนใบเดียวของหน้าที่เป็น **การ์ดเดี่ยว** และแยกจากกล่องอื่นได้สี่ทาง:
// **ไม่มี clip-path** (ต่างจาก §5 ที่เป็นมุมตัด) **มุม 25px** (ไม่ซ้ำกับ 2xl/3xl/30px
// ของใบอื่น) **ไม่มี hover ที่เปลี่ยนเงา** (ต่างจาก §6 ที่เป็นแผ่นนูนเหมือนกันแต่
// เงาไต่ขึ้นตอน hover) และ **หัวข้อเป็นทองแบรนด์ #f0bb4e ทึบสีเดียว จัดกึ่งกลาง**
// ซึ่งเป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลางพร้อมกัน จึงไม่ซ้ำกับใบอื่นสักใบ
// (#f0bb4e อยู่ที่ 10.4:1 บนผิวกลางนี้ จึงผ่าน AA ทุกขนาด ไม่ใช่แค่ large text)
// (§1 เป็นหมึกเข้มบนแผ่นถมไล่ ทอง→ครีม→ทองแดง · §3 ไล่ ครีม→ทองแดง→ทอง ·
// §4 ไล่ ทอง→ทองแดง→ครีม · §5 ไล่ ทองแดง→ครีม→ทอง · §6 ไล่ ทองแดง→ทอง→ครีม ·
// §7 ไล่ ครีม→ทอง→ทองแดง · §8 ไล่สองสต็อป ทอง→ทองแดง)
// กรอบเป็นบรอนซ์ลึก #5c2a06 เส้นใต้หัวข้อเป็นทองแดง #d9701a แบบโปร่ง
// เนื้อความ #fff8ec (= BRAND_TEXT) — 17.4:1 บนผิวกลาง
// §2 ห้าม #e4021b และ #5c2a06 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ #5c2a06 อยู่ที่กรอบ
// กับเงานูน และ **แดงชาดไม่ปรากฏในไฟล์นี้เลย** เพราะใบนี้ไม่มีงานที่เป็นพื้นถม/เส้น
// ให้แดงทำ · #d9701a (5.5:1 บนผิวกลาง) อยู่ที่เส้นใต้หัวข้อเท่านั้น
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอทองในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ทองรอบนี้คือ **#f0bb4e / #ffeccb / #d9701a / #5c2a06** ⚠️ **#f0bb4e มีค่า R
// ตรงกับ f0b429 ของรับตัง168 เป๊ะ** ต่างกันที่ B78 vs B41 · และไม่ใช่ fcd45c 6b4a08
// (มีเฮ168 รอบก่อน) f9a826 704504 (รวยแทร่168 ที่เพิ่งอยู่ในไฟล์นี้ทั้งชุด) fef54b
// 6b5c10 (นินจา168) ffc82e 5c4a16 (สบายเบท168) ffd84d (ถอนชัวร์168) fcd434 ffeaa0
// (มีโชค168) f7c92b ffe6a3 8a5f12 (ขวัญใจ168) ffdc8c 9a6c0c (รับตัง168) e3b23c
// ffe5a8 8a6210 (สมหวัง168) e2b33f dfa310 f2c230 e5a81b fad354 f5c518 fce343
// f3bb34 หรือ fbe455
// ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (039cfa c3ebfc
// 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba 3/156/250) ชุดของ
// สบายเบท168 (2f9ff5 a8dcff 0b3f78 ffc82e 5c4a16 e8f4ff 0e2238 081726 040d16)
// ชุดของนินจา168 (32bcfb a9e9ff 07335f fef54b 6b5c10 0c2a3d 071a28 030e16 041019
// dceefc) ชุดชมพูบับเบิลกัม-ทองเนยของถอนชัวร์168 (fa63b9 ffb3de ffd84d 2b0f20
// 1a0914 0d040a 6d0b3f 6b4708 2a0617 fdeaf5) ชุดทอง-ชมพูบานเย็นของมีโชค168 (fcd434
// ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509) ชุดของ
// ขวัญใจ168 (f7c92b ffe6a3 f2bba5 c98a74 b3121b 5a0a0e 8a5f12 eadfce 140c06 241509
// 160d06 0b0603) ชุดของรับตัง168 (f0b429 ffdc8c d30304 ff6b6e a00203 4a0202 9a6c0c
// cfd9e6 f5ece0 2b100f 200a09 140505 1a0505) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f
// e3b23c ffe5a8 8a6210 b90203 8c0204 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c
// 140706 290f0f) และชุดของมีเฮ168 (fb1b32 ff8f9c 5c0410 fcd45c 6b4a08 2b0711 1a040a
// 0c0205 fdeaec 1b0308) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม และไม่มีเหลืองมะนาว** ส้มตัวเดียวที่อนุญาตคือ
// ทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง ไม่ใช่ส้มอิสระ
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#5c2a06] bg-[#260d04] p-8 text-left text-base leading-relaxed text-[#fff8ec] shadow-[10px_10px_20px_#0d0501,-10px_-10px_20px_#5c2a06]">
    {
      title && (
        <header class="mb-6 border-b border-[#d9701a]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#f0bb4e]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
