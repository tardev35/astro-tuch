---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// การ์ดใบนี้ถือ docx H2 §2 ของหน้าแรก ("<แบรนด์> สล็อต บาคาร่า ยิงปลา ไฮโล บอล
// หวย รวมสูตรและเทคนิคครบ") ซึ่งบรีฟรอบนี้ให้มาหนึ่งย่อหน้า (content.txt บรรทัด 6)
// หน้าเพจจึงส่ง <p> เดียวเข้าสล็อตตามกฎบ้าน "หนึ่ง element ต่อหนึ่งสล็อต" ถ้าวันหลัง
// มีมากกว่าหนึ่งย่อหน้า ต้องห่อรวมใน <div> เดียว ไม่ใช่ส่งสอง <p> เป็นพี่น้องกัน
// ⚠️ หัวข้อของ §2 ไล่ชื่อหมวดเกมหกหมวดที่ **บรีฟรอบนี้ระบุเอง** (สล็อต บาคาร่า
// ยิงปลา ไฮโล บอล หวย) — brand-spec §6 อนุญาตเพราะบรีฟใช้เอง และย่อหน้าของบรีฟก็
// กำกับทันทีว่า "เทคนิคต่าง ๆ ควรใช้เพื่อทำความเข้าใจเกม ไม่ใช่สูตรรับประกันชัยชนะ
// เพราะผลการเดิมพันมีความไม่แน่นอนและอาจทำให้สูญเสียเงินได้" — **ทั้งสองส่วนต้องลง
// ครบ ห้ามตัดประโยคกำกับทิ้ง** และห้ามขยายคำโฆษณาไปใช้ที่อื่นที่บรีฟไม่ได้เขียนไว้
// ⚠️ ไฟล์นี้ยังถูกเรียกจาก src/pages-disabled/ตรวจหวย.astro และ แนวทาง.astro ด้วย
// ซึ่งรอบนี้ **จอดอยู่** (บรีฟเป็นเว็บสอนเล่นเกมหลายประเภท ไม่ใช่เว็บหวย) Astro ไม่
// route โฟลเดอร์นั้น จึงไม่มีผลกับบิลด์ แต่ก็อย่าแปลกใจที่ grep เจอ
//
// ดวงเศรษฐี168 (รอบ **ทองน้ำผึ้งนำ · แดงชาดจีนเป็นฮิวที่สอง · บนดำสนิท**
// 2026-10-20, brand-spec §2): แผ่นนูนคือ **ผิวกลาง #300605** ที่ถูกกดเงาลงไปหา
// ผิวจม #150303 ด้านหนึ่ง และยกแสงขึ้นด้วยแดงเลือดหมู #8e1a16 อีกด้านหนึ่ง
// ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนเดียวกัน ไม่ใช่จากสีที่สาม —
// แดงเลือดหมูเป็นปลายเข้มของแดงชาดในพาเลตต์ จึงทำหน้าที่ขอบแสงได้โดยไม่พาฮิวใหม่เข้ามา
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) ซึ่ง **มืดกว่า** ทั้งผิวกลาง
// และผิวจม การ์ดใบนี้จึงอ่านเป็นแผ่นที่ลอยขึ้นมาจากพื้น ไม่ใช่จมลงไป ลำดับความลึก:
// #4e2120 ยก / #300605 กลาง (ใบนี้) / #150303 จม / #000000 พื้น
//
// ใบนี้เป็นแผ่นนูนใบเดียวของหน้าที่เป็น **การ์ดเดี่ยว** และแยกจากกล่องอื่นได้สี่ทาง:
// **ไม่มี clip-path** (ต่างจาก §6 ที่เป็นมุมตัด) **มุม 25px** (ไม่ซ้ำกับ 2xl/3xl/36px
// ของใบอื่น) **ไม่มี hover ที่เปลี่ยนเงา** และ **หัวข้อเป็นทองน้ำผึ้ง #f0c878 ทึบ
// สีเดียว จัดกึ่งกลาง** ซึ่งเป็นหัวข้อเดียวของหน้าที่ทั้งทึบและกึ่งกลางพร้อมกัน
// (#f0c878 อยู่ที่ 10.9:1 บนผิวกลางนี้ จึงผ่าน AA ทุกขนาด ไม่ใช่แค่ large text)
// (§1 เป็นหมึกเข้มบนแผ่นถมสว่าง · §3 ไล่ งาช้าง→ทอง→งาช้าง · §4 ไล่ ทอง→งาช้าง→ทอง ·
// §5 ไล่ ทอง→งาช้าง · §6 ไล่ งาช้าง→ทอง กึ่งกลาง · §7 ทองทึบกึ่งกลางพร้อมเส้นคาดบน ·
// §8 ไล่ ทอง→งาช้าง→ทอง บนแผ่นป้ายรางแดง)
// กรอบเป็นแดงเลือดหมู #8e1a16 เส้นใต้หัวข้อเป็นแดงชาด #d9212a แบบโปร่ง
// เนื้อความ #fff8d8 (= BRAND_TEXT) — 16.2:1 บนผิวกลาง
// §2 ห้าม #d9212a และ #8e1a16 ถือตัวอักษรทุกขนาด — ในไฟล์นี้ #8e1a16 อยู่ที่กรอบ
// กับเงานูน และ #d9212a อยู่ที่เส้นใต้หัวข้อเท่านั้น ทั้งคู่เป็น "เส้น/พื้นถม"
//
// ⚠️ เทียบสีเป็น "ค่า" ไม่ใช่ "ตระกูลสี" — **ทองนำมาแล้วเกือบทุกแบรนด์ในรีโปนี้**
// การเจอทองในไฟล์นี้จึงไม่พิสูจน์อะไรเลย
// ทองรอบนี้คือ **#f0c878** (R240 G200 B120) ⚠️ ตัวที่ใกล้ที่สุดคือ ffdc8c ของ
// รับตัง168 และ f6e3b4 ของ ufalion168 รอบก่อน · และไม่ใช่ d4922c fdfc71 a25b24
// 8c4312 d39c45 33200a 1f1304 0a0601 5a3310 1a1000 (ufalion168 ที่เพิ่งออก)
// f0bb4e ffeccb d9701a 5c2a06 (รวยเทพ168) fcd45c 6b4a08 (มีเฮ168) f9a826 704504
// (รวยแทร่168) fef54b 6b5c10 (นินจา168) ffc82e 5c4a16 (สบายเบท168) ffd84d
// (ถอนชัวร์168) fcd434 ffeaa0 (มีโชค168) f7c92b ffe6a3 8a5f12 (ขวัญใจ168) f0b429
// 9a6c0c (รับตัง168) e3b23c ffe5a8 8a6210 (สมหวัง168) e5a81b (UFA324) e2b33f
// dfa310 f2c230 fad354 f5c518 fce343 f3bb34 หรือ fbe455
// แดงรอบนี้คือ **#d9212a / #8e1a16** ไม่ใช่ e4021b (รวยเทพ168) fb1b32 ff8f9c
// 5c0410 (มีเฮ168) fa0513 ff5a5f ffadaf 8c0204 (สมหวัง168) d30304 ff6b6e
// (รับตัง168) b3121b 5a0a0e (ขวัญใจ168) หรือ e4021b
// ชุดฟ้าอะซัวร์ของรวยแทร่168 (039cfa c3ebfc 04366b e3f2fc 0b2d52 071e38 030f1d
// กับ rgba 3/156/250) ชุดของสบายเบท168 (2f9ff5 a8dcff 0b3f78 e8f4ff 0e2238 081726
// 040d16) ชุดของนินจา168 (32bcfb a9e9ff 07335f 0c2a3d 071a28 030e16 041019 dceefc)
// ชุดชมพูบับเบิลกัมของถอนชัวร์168 (fa63b9 ffb3de 2b0f20 1a0914 0d040a 6d0b3f 6b4708
// 2a0617 fdeaf5) ชุดทอง-ชมพูบานเย็นของมีโชค168 (f5469f ff8dc6 8c0f52 7a5508 1a0612
// f6e4ee 24101c 160a12 0b0509) ชุดของขวัญใจ168 (f2bba5 c98a74 eadfce 140c06 241509
// 160d06 0b0603) ชุดของรับตัง168 (a00203 4a0202 cfd9e6 f5ece0 2b100f 200a09 140505
// 1a0505) และชุดของสมหวัง168 (b90203 5b0203 3c0303 f4ecea ccb9b6 2c1413 1f0d0c
// 140706 290f0f) ออกครบทุกค่าแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน/ไซยาน ไม่มีม่วง ไม่มีเขียว ไม่มีชมพู/ฟูเชีย
// ไม่มีโรสโกลด์ ไม่มีเงิน/โครเมียม ไม่มีเหลืองมะนาว ไม่มีส้มสด และ
// **ไม่มีบรอนซ์** (บรอนซ์ a25b24 คือสีที่สามของ ufalion168 รอบก่อน)
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#8e1a16] bg-[#300605] p-8 text-left text-base leading-relaxed text-[#fff8d8] shadow-[10px_10px_20px_#150303,-10px_-10px_20px_#8e1a16]">
    {
      title && (
        <header class="mb-6 border-b border-[#d9212a]/60 pb-4">
          <HeadingTag class={`text-center ${headingSize} leading-normal font-black tracking-wide text-[#f0c878]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
