---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too. The card keeps `text-left` and the slot renders as a direct child;
// do not re-add a content wrapper <div>.
//
// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): แผ่นนูนคือผิวการ์ดแดงเข้ม #2b0909 ที่ถูก
// กดเงาลงไปหาเงาลึกสุดของแบรนด์ #0b0202 ด้านหนึ่ง และยกแสงขึ้นด้วยผิวแผงยกแดงอ่อน
// #4a0f0f อีกด้านหนึ่ง ความนูนแบบ neumorphic ต้องมาจากคู่มืด/สว่างในโทนแดงเดียวกัน
// ไม่ใช่จากสีที่สอง สีเน้นจึงถูกเก็บไว้ที่หัวข้อกับเส้นคั่นใต้หัวข้อแทน หัวข้อไล่เฉด
// แดงสว่าง #e43434 → ทองรอง #f4bc5d → ทองอ่อน #ffefc2 คือไล่ "แดงขึ้นทอง" ซึ่งเป็น
// ทิศกลับด้านกับ ContentBox ตัวกลางที่ไล่ทองอ่อน → ทองรอง → แดงแบรนด์ จึงคนละจังหวะ
// สายตาบนหน้าเดียวกัน และทุก stop ของไล่เฉดนี้ยังอยู่เหนือ 4:1 บนผิวการ์ด #2b0909
// (แดงลึก #ab0204 วัดได้แค่ 2.4:1 จึงห้ามเป็น stop ของตัวอักษร ใช้ได้แค่เป็นเส้น/เงา)
// กรอบเป็นแดงเข้มสุด #5c0a0a เนื้อความ #fbe3d4 (BRAND_TEXT)
//
// ชุดเขียวนีออน-โครเมียมของ CK268 ที่เคยค้างในไฟล์นี้ (#8bfc13 #e8f0e6 #1a7a08
// #0f1b0e #1b2f19 #030703 #d5e6cd) ออกครบทุกจุดแล้ว
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#5c0a0a] bg-[#2b0909] p-8 text-left text-base leading-relaxed text-[#fbe3d4] shadow-[10px_10px_20px_#0b0202,-10px_-10px_20px_#4a0f0f]">
    {
      title && (
        <header class="mb-6 border-b border-[#e43434]/45 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#e43434] via-[#f4bc5d] to-[#ffefc2] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
