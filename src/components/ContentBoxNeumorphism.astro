---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#5e0505]/80 bg-[#120404] p-8 text-left text-base leading-relaxed text-[#f2e3c9] shadow-[10px_10px_20px_#050101,-10px_-10px_20px_#2a0808]">
    {
      title && (
        <header class="mb-8 border-b border-[#5e0505]/70 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe98a] via-[#ff2a36] to-[#c99a10] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
