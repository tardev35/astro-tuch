---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
//
// MHEEPOOH168 palette: the soft-relief slab is the brand's card red (#540202)
// lit from the page near-black (#120303) on one diagonal and from the primary
// accent red (#8f0505) on the other, so the relief comes from brightness inside
// the one red rather than from a second hue. The only contrast in the card is
// the gold rule under the heading and the heading gradient itself, which runs
// bright gold -> bright red -> mid gold, the logo's own gold-on-red pair.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#8f0505] bg-[#540202] p-8 text-left text-base leading-relaxed text-[#f1dccd] shadow-[10px_10px_20px_#120303,-10px_-10px_20px_#8f0505]">
    {
      title && (
        <header class="mb-6 border-b border-[#f5b70a]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fced74] via-[#c4161c] to-[#f5b70a] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
