---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
// text-center lives on the heading itself, never on the card or the <section> —
// centering an ancestor inherits straight into the slot and centers the body
// copy too.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#cc9c2d]/55 bg-[#120c04] p-8 text-left text-base leading-relaxed text-[#f0e2bd] shadow-[10px_10px_20px_#050301,-10px_-10px_20px_#1d1407]">
    {
      title && (
        <header class="mb-8 border-b border-[#cc9c2d]/40 pb-4">
          <HeadingTag class={`bg-gradient-to-r from-[#fff6d4] via-[#fae27c] to-[#cc9c2d] bg-clip-text text-center ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
