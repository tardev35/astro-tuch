---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#0b7a06]/40 bg-gradient-to-b from-[#031204]/95 to-[#010301]/95 p-8 pt-40 text-left text-base leading-relaxed text-[#d5e8d0] shadow-[0_10px_30px_rgba(37,203,14,0.16)] sm:pt-32 md:pt-32">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#25cb0e]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#cfd6cd]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#25cb0e]/50 bg-[#010301] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(37,203,14,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#6ef25a]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#6ef25a] via-[#f0f7ee] to-[#25cb0e] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#6ef25a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
