---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance re-derived for KINGDOM66 (2026-09-25), which puts this box on the
// homepage H1: "KINGDOM66 เล่นบาคาร่าเครดิตฟรี เกมคาสิโน ไลฟ์สดส่งตรงครบ" — 56
// code points, ~50 advancing glyphs once the 6 zero-width Thai marks
// (่ ่ ิ ี ์ ่) are discounted. That is 5 glyphs LONGER than MAHAGAME66's title
// and it sits at the H1 size notch, so pt-36/md:pt-40 is re-derived rather than
// inherited. The heading keeps `leading-normal` (1.5), the badge adds py-2.5
// (20px) plus border-2 (4px), and the two spark spans plus gap-2 take ~48px out
// of the line box. Budget is one line beyond the measured wrap at every
// breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 50 glyphs wraps to 3. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px       -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px       -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px    -> 25px clear
// An H2 sits one size notch smaller and fits inside the same budgets. Do NOT
// shrink further on the assumption the box keeps a short title — redo the
// arithmetic with the real docx sentence the next brand puts in here instead.
//
// KINGDOM66 palette (ทอง-ดำ 2026-09-25): การ์ดไล่จากผิวการ์ดดำอมน้ำตาล #151109
// ลงไปหาพื้นเพจดำสนิท #050403 ในกรอบทองแบรนด์ #e6bf4e ป้ายหัวข้อลอยอยู่บนผิวการ์ด
// ยก #241c13 ในกรอบทองเดียวกัน และประกายสองข้างแยกกันด้วยคู่สีของโลโก้ — ทองสว่าง
// #f2d683 ฝั่งซ้าย ครีมแพลตินัมอุ่น #efe6cf ฝั่งขวา ออร่าสองมุมเป็นทองกับครีมตาม
// โลโก้ที่คำว่า KINGDOM ไล่ทองอ่อนไปเข้มก่อนจบที่เลข 66 สีทองเต็ม เนื้อความ
// #ebe3d3 (BRAND_TEXT) — ชุดแดง-ดำ-เงินโครเมียมของ MAHAGAME66 (#de161d #ff4d52
// #7a0a0e #e2e8ef #16090a #26100f #080506 #e8e3e1) ออกหมดทุกจุด แบรนด์นี้ไม่มีสี
// เงินเย็นอยู่เลย
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#e6bf4e]/55 bg-gradient-to-b from-[#151109]/95 to-[#050403]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#ebe3d3] shadow-[0_10px_30px_rgba(230,191,78,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e6bf4e]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#efe6cf]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e6bf4e]/65 bg-[#241c13] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(5,4,3,0.85)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f2d683]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#efe6cf] via-[#f2d683] to-[#e6bf4e] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#efe6cf]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
