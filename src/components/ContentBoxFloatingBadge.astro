---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance recomputed for FAH999 (2026-09-21), which puts this box on the
// homepage H1: "FAH999 สล็อตออโต้Top3 เว็บตรง ติดอันดับมาแรง" — 44 code points,
// 38 advancing glyphs once the six zero-width Thai marks are discounted. The
// heading carries `leading-normal` (1.5), the badge adds py-2.5 (20px) plus
// border-2 (4px), and the two spark spans plus gap-2 take ~48px out of the line
// box. Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~247px of text width at 360px
//         (w-[92%] 331 - px-4 32 - border 4 - sparks 48) = ~24 glyphs/line,
//         so 38 glyphs wraps to 2. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px      -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~473px of text width
//         (w-[92%] 589 - px-8 64 - border 4 - sparks 48) = ~39 glyphs/line,
//         fits on 1. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px      -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px   -> 25px clear
// An H1 needs pt-36/pt-40; an H2 sits one size notch smaller and can live with
// pt-32/pt-36. Do not shrink this on the assumption the box keeps an H2.
//
// FAH999 palette (royal purple + gold): the card fades from the card base
// (#180430) into the page purple-black (#0d0119) inside a gold border
// (#fbbf13), the badge frame is bright gold (#fef354) on the card surface
// (#2a0a4d), and the spark pair is told apart by brightness within the gold —
// bright on the left, primary on the right. The two auras are the brand's
// purple (#a855f7) and gold. The previous round's black-and-gold is gone.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#fbbf13]/60 bg-gradient-to-b from-[#2a0a4d]/95 to-[#0d0119]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#ecdcff] shadow-[0_10px_30px_rgba(251,191,19,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#a855f7]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fbbf13]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fef354]/60 bg-[#180430] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(251,191,19,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fef354]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fef354] via-[#fbbf13] to-[#ffdf6b] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fbbf13]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
