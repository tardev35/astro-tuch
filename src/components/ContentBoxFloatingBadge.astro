---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance re-derived for BRAZIL999 (2026-09-25), which puts this box on the
// homepage H1: "BRAZIL999 คาสิโนแท้ จากบริษัทโดยตรง เว็บนี้ไม่มีประวัติโกง" — 58
// code points, ~47 advancing glyphs once the 11 zero-width Thai marks
// (ิ ้ ิ ั ็ ี ้ ่ ี ั ิ) are discounted. That is 3 glyphs SHORTER than
// KINGDOM66's title at the same H1 size notch, so the previous pt-36/md:pt-40
// still clears — re-derived here rather than inherited on trust. The heading
// keeps `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2
// (4px), and the two spark spans plus gap-2 take ~48px out of the line box.
// Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 47 glyphs wraps to 3. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px       -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px       -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px    -> 25px clear
// An H2 sits one size notch smaller and fits inside the same budgets. Do NOT
// shrink further on the assumption the box keeps a short title — redo the
// arithmetic with the real docx sentence the next brand puts in here instead.
//
// BRAZIL999 palette (เขียว-โครเมียม-ดำ 2026-09-25): การ์ดไล่จากผิวการ์ดเขียวเข้ม
// #0a1a0c ลงไปหาพื้นเพจดำอมเขียว #040a05 ในกรอบเขียวแบรนด์ #22c55e ป้ายหัวข้อลอย
// อยู่บนผิวการ์ดยก #123a18 ในกรอบเขียวเดียวกัน และประกายสองข้างแยกกันด้วยคู่สีของ
// โลโก้ — เขียวสว่าง #7cf25c ฝั่งซ้าย โครเมียมสว่าง #f1f5f9 ฝั่งขวา ตัวหัวข้อไล่
// จากโครเมียมไปจบที่เขียวแบรนด์ ตามโลโก้ที่คำว่า BRAZIL เป็นโครเมียมขัดเงาแล้วปิด
// ท้ายด้วยเลข 999 สีเขียวสด ออร่าสองมุมเป็นเขียวกับโครเมียมตามคู่เดียวกัน เนื้อความ
// #dfeadd (BRAND_TEXT) — ชุดทอง-ครีมอุ่นของ KINGDOM66 (#e6bf4e #f2d683 #efe6cf
// #241c13 #151109 #050403 #ebe3d3) และชุดทองของ MIRACLE55 ออกหมดทุกจุด แบรนด์นี้
// ไม่ได้นำด้วยทอง ทองเหลือเป็นแค่ของประดับเล็กๆ ที่อื่น
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#22c55e]/55 bg-gradient-to-b from-[#0a1a0c]/95 to-[#040a05]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#dfeadd] shadow-[0_10px_30px_rgba(34,197,94,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#22c55e]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#aab4bf]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#22c55e]/65 bg-[#123a18] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(4,10,5,0.85)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#7cf25c]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f1f5f9] via-[#b6ff9c] to-[#22c55e] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f1f5f9]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
