---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance recomputed for หวยพยัคฆ์ (2026-09-22), which puts this box on the
// homepage H2: "หวยพยัคฆ์ แทงหวย อันดับ1 เปิดรับทุกเลขเด็ด เลขดัง ไม่อั้นเลข จ่ายเต็ม"
// — 69 code points, ~56 advancing glyphs once the 13 zero-width Thai marks
// (ั ่ ้ ็ ์ ิ ุ) are discounted. This is the longest title this box has carried.
// The heading keeps `leading-normal` (1.5), the badge adds py-2.5 (20px) plus
// border-2 (4px), and the two spark spans plus gap-2 take ~48px out of the line
// box. Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 56 glyphs wraps to 3. Budget 4 lines = 4x27 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px      -> 36px clear
//   sm    text-xl 20px -> 30px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~40 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-36/144px       -> 54px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-40/160px   -> 52px clear
// An H1 sits one size notch larger and still fits the same pt-36/pt-40. Do not
// shrink this on the assumption the box keeps a short title.
//
// หวยพยัคฆ์ palette (กรมท่า-ทอง): การ์ดไล่จากพื้นยก #0f2149 ลงไปหาพื้นเพจกรมท่าเข้ม
// #030b1c ในกรอบทองบรอนซ์ #ab6d13 ป้ายหัวข้อลอยอยู่บนพื้นการ์ด #08152f ในกรอบทอง
// หลัก #fadb6c และประกายสองข้างแยกกันด้วยความสว่างในโทนทองเดียวกัน — สว่าง
// #fdf5a4 ฝั่งซ้าย ทองหลักฝั่งขวา ออร่าสองมุมเป็นทองกับเงิน #e8eef8 ตามโลโก้ที่เป็น
// คำว่า หวย สีเงินทับ พยัคฆ์ สีทอง ม่วง-ทองของรอบ FAH999 ออกทั้งหมด
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#ab6d13]/60 bg-gradient-to-b from-[#0f2149]/95 to-[#030b1c]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#dbe4f7] shadow-[0_10px_30px_rgba(250,219,108,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fadb6c]/26 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e8eef8]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fadb6c]/60 bg-[#08152f] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(250,219,108,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fdf5a4]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fdf5a4] via-[#fadb6c] to-[#e3a92f] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fadb6c]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
