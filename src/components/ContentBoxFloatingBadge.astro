---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance redone for PAOTUNG's H1, "PAOTUNG รวมเกมออนไลน์ เดิมพันได้ครบทุกค่าย"
// — an H1 this round, so every size step is one notch LARGER than the previous
// brand's H2 and the padding goes up with it. The heading carries
// `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and
// the two spark spans plus gap-2 take ~48px out of the line box. The title is 42
// code points, 6 of them zero-width Thai marks, so ~36 advancing glyphs.
// Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~20 glyphs/line,
//         so 36 glyphs wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-32/128px     -> 38px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~34 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-32/128px    -> 20px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~33 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px -> 25px clear
// Do not shrink this on the assumption the box keeps an H1 — if a future brand
// drops an H2 in here the sizes step down one notch and the arithmetic has to
// be redone in the other direction.
//
// PAOTUNG palette: a navy card (#04203c) fading into the page black-navy inside
// a primary-blue border, a gold-metallic badge frame on the page ground, and a
// two-tone spark pair — light gold on the left, pale blue on the right —
// matching the logo's gold money bag against its mid-blue wordmark. No red
// anywhere: this brand is blue-led with gold as the secondary metallic.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#226ca9]/70 bg-gradient-to-b from-[#04203c]/95 to-[#020f1e]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#cfdeed] shadow-[0_10px_30px_rgba(34,108,169,0.28)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#226ca9]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e0bd72]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e0bd72]/55 bg-[#020f1e] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(224,189,114,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f5e3b3]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f5e3b3] via-[#eef6fd] to-[#3b9ddd] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#7fc4f0]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
