---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance RE-DERIVED for PGW44 (2026-09-27), which puts this box on the
// homepage H1: "PGW44 อัปเดตค่ายสล็อตย่อย จัดมาให้สมาชิก ครบทุกแนวเกม" — 53 code
// points, ~45 advancing glyphs once the 8 zero-width Thai marks
// (ั ่ ็ ่ ั ้ ิ ุ) are discounted. That is 2 glyphs SHORTER than BRAZIL999's
// title at the same H1 size notch, so the existing pt-36/md:pt-40 still clears;
// measured here rather than inherited on trust. The heading keeps
// `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and
// the two spark spans plus gap-2 take ~48px out of the line box. Budget is one
// line beyond the measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 45 glyphs wraps to 3. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px       -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px       -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~37 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px    -> 25px clear
// An H2 sits one size notch smaller and fits inside the same budgets. Do NOT
// shrink further on the assumption the box keeps a short title — redo the
// arithmetic with the real docx sentence the next brand puts in here instead.
//
// PGW44 palette (ทอง-เขียว-ดำ 2026-09-27): การ์ดไล่จากผิวการ์ดดำอมเขียว #0b1408 ลง
// ไปหาพื้นเพจ #050803 ในกรอบทองแบรนด์ #fde90e ป้ายหัวข้อลอยอยู่บนผิวแผงยก #101a0b
// ในกรอบทองเดียวกัน และประกายสองข้างแยกกันด้วยคู่สีของเวิร์ดมาร์ก — ทองอ่อน #fff89a
// ฝั่งซ้าย เขียวสว่าง #5df53a ฝั่งขวา ตัวหัวข้อไล่ทองแบรนด์ → ทองกลาง #f5c518 →
// เขียวแบรนด์ #35d413 ตามโลโก้ที่อ่านซ้ายไปขวาว่า P ดำขอบทอง G ทอง W เขียว แล้วปิด
// ด้วย 44 ที่ไล่ทองไปเขียว ออร่าสองมุมเป็นทองกับเขียวตามคู่เดียวกัน เนื้อความ
// #e9f0dd (BRAND_TEXT) — ชุดเขียวมรกต-โครเมียมของ BRAZIL999 (#22c55e #7cf25c
// #b6ff9c #f1f5f9 #aab4bf #0a1a0c #040a05 #123a18 #dfeadd) ออกหมดทุกจุด แบรนด์นี้
// นำด้วยทองแล้วให้เขียวตามหลัง ไม่ใช่เขียวคู่โครเมียม
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#fde90e]/55 bg-gradient-to-b from-[#0b1408]/95 to-[#050803]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#e9f0dd] shadow-[0_10px_30px_rgba(253,233,14,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fde90e]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#35d413]/18 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fde90e]/65 bg-[#101a0b] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(3,6,2,0.85)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fff89a]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fde90e] via-[#f5c518] to-[#35d413] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#5df53a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
