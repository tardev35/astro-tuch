---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance redone for YADOM168's H1, "YADOM168 สล็อตเกมแตกง่าย จ่ายไว ไม่จำกัดยอดแทง"
// (46 characters) — an H1 this round, so every size step is one notch larger
// than the previous brand's H2 and the old pt-28 no longer clears. The heading
// carries `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2
// (4px), and the two ✦ spans plus gap-2 take ~48px out of the line box. Budget
// is one line beyond the measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~19 chars/line,
//         so 46 chars wraps to 3. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px    -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width = ~34 chars/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px    -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~33 chars/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px -> 25px clear
// Do not shrink this on the assumption the box keeps an H1 — if a future brand
// drops an H2 in here the sizes step down one notch and the arithmetic has to
// be redone in the other direction.
//
// YADOM168 palette: near-black green card inside a deep-green border, a green
// heading gradient through chrome white, and a two-tone spark pair — brand green
// on the left, coin gold on the right — matching the logo's green 168 against
// the gold coins in the artwork.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#0f3d0d]/70 bg-gradient-to-b from-[#071508]/95 to-[#020602]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#d4e8cb] shadow-[0_10px_30px_rgba(92,194,63,0.22)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#5cc23f]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e6bd5c]/15 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#5cc23f]/50 bg-[#040d04] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(92,194,63,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#8fe06f]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#8fe06f] via-[#f2fbef] to-[#5cc23f] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#e6bd5c]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
