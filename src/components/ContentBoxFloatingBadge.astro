---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#22c55e]/25 bg-gradient-to-b from-[#0a1207]/95 to-[#04120a]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#e9f7e6] shadow-[0_10px_30px_rgba(34,197,94,0.16)] md:pt-28">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#22c55e]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#ec4899]/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ec4899]/35 bg-[#0a0605] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(236,72,153,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ec4899]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#4ade80] via-[#f9a8d4] to-[#ec4899] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ec4899]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
