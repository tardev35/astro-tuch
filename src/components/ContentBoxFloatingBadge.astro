---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone. Re-checked for
// this brand: there is no `whitespace-nowrap` anywhere in this file.
//
// Clearance RE-DERIVED for หวย365 (2026-10-03), which puts this box on docx H2
// #3: "อัตราการจ่าย หวย365 2ตัว จ่าย100บาท 3ตัว จ่าย1,000บาท" — 52 code points,
// ~42 advancing glyphs once the 5 zero-width Thai marks (ั ่ ั ่ ่) are
// discounted, plus 5 spaces, i.e. ~47 advancing cells. That is the LONGEST title
// this box has carried in several rounds, so the padding is re-derived rather
// than inherited on trust. It arrives as an H2, so the badge keeps py-2.5 (20px)
// + border-2 (4px), with two ✦ spans plus gap-2 taking ~48px of the line box:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~21 cells/line.
//         It breaks only at the brief's own spaces:
//         "อัตราการจ่าย หวย365 2ตัว" 21 | "จ่าย100บาท 3ตัว" 13 |
//         "จ่าย1,000บาท" 11 -> 3 lines.
//         Real 3 lines = 3x27 + 24 = 105, bottom edge 81 vs pt-32/128px
//                                                -> 47px clear
//         Budget 4 lines = 4x27 + 24 = 132, edge 108  -> 20px clear
//         (re-checked at 320px too: the same three breaks, still 3 lines)
//   sm    text-xl 20px -> 30px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~40 cells/line,
//         so 47 cells fits on 2 lines. Budget 3 lines = 3x30 + 24 = 114,
//         edge 90 vs pt-32/128px                 -> 38px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 cells/line,
//         so 2 lines. Budget 3 lines = 3x36 + 24 = 132,
//         edge 108 vs md:pt-36/144px             -> 36px clear
//         (the real 2 lines = 96, edge 72        -> 72px clear)
// Every breakpoint clears with a full spare line of budget, so pt-32/md:pt-36
// stands for this brand — it is NOT reduced. Do NOT shrink it on the assumption
// the box keeps a title this length; redo the arithmetic with the real docx
// sentence the next brand puts here.
//
// หวย365 (รอบแดงสด-ทอง-ดำ 2026-10-03): การ์ดไล่จากพื้นการ์ด #240406 ลงไปหาพื้นลึกสุด
// #140203 ในกรอบทองแบรนด์ #ffc93c ป้ายหัวข้อลอยอยู่บนพื้นเพจดำอมแดง #140203 ในกรอบ
// ทองเดียวกัน แบรนด์นี้มีสองสีจริง (โลโก้เป็นคำว่า หวย สีแดงสด vivid #dc0203 คู่กับเลข
// 365 บนพื้นดำ #020202 ส่วนทองมาจากตัวอักษรบนแบนเนอร์) ประกายสองข้างจึงเป็นทองอ่อน
// #ffeab0 ฝั่งซ้ายและแดงสว่าง #f5282a ฝั่งขวา ตัวหัวข้อไล่ทองอ่อน #ffeab0 → ทองแบรนด์
// #ffc93c → ทองลึก #c08a07 เท่านั้น ไม่พาดลงแดง เพราะหัวข้อนี้ตกสามบรรทัดบนมือถือและ
// หางแดงบนป้ายพื้น #140203 จะอ่านยากทั้งบรรทัดสุดท้าย (ทองลึกบนพื้นนี้ได้ 7.0:1)
// ออร่าสองมุมเป็นทองแบรนด์กับแดงแบรนด์ เนื้อความ #f6e7e0 (BRAND_TEXT)
//
// ชุดทองล้วนของ NAZA99 ที่เคยค้างในไฟล์นี้ (#e4b34d #fdf2ac #c08f2b #241404 #140c02
// #f3e8cf) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#ffc93c]/55 bg-gradient-to-b from-[#240406]/95 to-[#140203]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#f6e7e0] shadow-[0_10px_30px_rgba(255,201,60,0.22)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ffc93c]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#dc0203]/28 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ffc93c]/65 bg-[#140203] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(8,1,2,0.85)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffeab0]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#c08a07] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f5282a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
