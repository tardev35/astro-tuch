---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Worst case re-checked for กินดี365's h2, "เจ้าหน้าที่ กินดี365 คอยแก้ปัญหา
// ฝากถอนตลอด 24 ชั่วโมง". The heading grows one step per breakpoint, so each one
// is measured against its OWN line-height, not the base's:
//   base  text-lg  (28px/line) -> up to 3 lines = 3x28 + 20 py + 4 border
//                               = 108px, bottom edge 84px vs pt-44/176px
//   sm    text-xl  (28px/line) -> up to 2 lines = 80px, edge 56px vs pt-32/128px
//   md    text-2xl (32px/line) -> up to 2 lines = 88px, edge 64px vs pt-36/144px
// The h1 case is tighter still (text-3xl, 45px/line, up to 3 lines = 159px,
// edge 135px against md:pt-36/144px), so do not trim any of these back for a
// short title — the next brand's may be longer, and md is the tight one.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#e9c55d]/40 bg-gradient-to-b from-[#062052]/95 to-[#00081f]/95 p-8 pt-44 text-left text-base leading-relaxed text-[#dbe4f5] shadow-[0_10px_30px_rgba(233,197,93,0.22)] sm:pt-32 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e9c55d]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#5ec2f5]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e9c55d]/40 bg-[#00081f] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(233,197,93,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#5ec2f5]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#5ec2f5]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
