---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Worst case re-checked for HIX168: the h1 title "HIX168 สล็อตปั่นแตกไว
// แหล่งรวมเกมเล่นง่าย กำไรดี" wraps to 3 lines at 320px (3 x 30px + 20px py +
// 4px border = 114px, bottom edge at 90px) against pt-44/176px, and to 2 lines
// from sm up (2 x 36px + 24px = 96px, bottom edge at 72px) against pt-32/128px.
// Do not trim it back for a short title — the next brand's may be longer.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#1e7bf5]/40 bg-gradient-to-b from-[#0d1730]/95 to-[#01030d]/95 p-8 pt-44 text-left text-base leading-relaxed text-[#d6e2f5] shadow-[0_10px_30px_rgba(30,123,245,0.22)] sm:pt-32 md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#1e7bf5]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#cfd8e6]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#1e7bf5]/40 bg-[#01030d] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(30,123,245,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#6fb4ff]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#cfe4ff] via-[#1e7bf5] to-[#0a3fa8] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#6fb4ff]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
