---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#0891b2]/25 bg-gradient-to-b from-[#050b16]/95 to-[#0a1628]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(8,145,178,0.16)] md:pt-28">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#0891b2]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#155e75]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fcd34d]/35 bg-[#050b16] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(245,158,11,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fcd34d]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fcd34d] via-[#22d3ee] to-[#0891b2] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fcd34d]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
