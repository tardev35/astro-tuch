---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance recomputed for ABM96 (2026-09-22), which puts this box on the
// homepage H2: "ABM96 อัปเกรดระบบการใช้งานให้ดีมากขึ้น ไม่โดนล้วงระบบหลังบ้านได้ง่ายๆ"
// — 69 code points, ~57 advancing glyphs once the 12 zero-width Thai marks
// (ั ้ ี ึ ่) are discounted. That is one glyph longer than หวยพยัคฆ์'s title,
// the previous longest this box has carried, so the padding below still holds.
// The heading keeps `leading-normal` (1.5), the badge adds py-2.5 (20px) plus
// border-2 (4px), and the two spark spans plus gap-2 take ~48px out of the line
// box. Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 57 glyphs wraps to 3. Budget 4 lines = 4x27 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px      -> 36px clear
//   sm    text-xl 20px -> 30px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~40 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-36/144px       -> 54px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-40/160px   -> 52px clear
// An H1 sits one size notch larger and still fits the same pt-36/pt-40. Do not
// shrink this on the assumption the box keeps a short title.
//
// ABM96 palette (ชมพู-เหลือง): การ์ดไล่จากพื้นยก #2a0a1a ลงไปหาพื้นเพจชมพูเกือบดำ
// #12030a ในกรอบชมพูเข้ม #c1356a ป้ายหัวข้อลอยอยู่บนพื้นการ์ด #1d0611 ในกรอบชมพู
// หลัก #fd6494 และประกายสองข้างแยกกันด้วยคู่สีของโลโก้ — ชมพูอ่อนสุด #ffe0ec
// ฝั่งซ้าย เหลือง #feda2a ฝั่งขวา ออร่าสองมุมเป็นชมพูหลักกับเหลืองโลโก้ ตามโลโก้ที่
// ตัว ABM เป็นชมพูและเลข 96 เป็นเหลือง กรมท่า-ทองของรอบก่อนออกทั้งหมด
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#c1356a]/60 bg-gradient-to-b from-[#2a0a1a]/95 to-[#12030a]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#fbe3ee] shadow-[0_10px_30px_rgba(253,100,148,0.26)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fd6494]/26 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#feda2a]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fd6494]/60 bg-[#1d0611] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(253,100,148,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffe0ec]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffe0ec] via-[#fd6494] to-[#feda2a] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#feda2a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
