---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance recomputed for MHEEPOOH168, which puts this box in one slot: docx
// H2 #2 "เกมเว็บ MHEEPOOH168 บาคาร่า สล็อต หวย บอล ครบวงจร" (~45 code points,
// ~40 advancing glyphs after the zero-width Thai marks). The heading carries
// `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and
// the two spark spans plus gap-2 take ~48px out of the line box. Budget is one
// line beyond the measured wrap at every breakpoint:
//   base  text-lg 18px -> 27px/line, ~247px of text width at 360px
//         (w-[92%] 331 - px-4 32 - border 4 - sparks 48) = ~23 glyphs/line,
//         so 40 glyphs wraps to 2. Budget 4 lines = 4x27 + 24 = 132px,
//         bottom edge 108px vs pt-32/128px    -> 20px clear
//   sm    text-xl 20px -> 30px/line, ~473px of text width
//         (w-[92%] 589 - px-8 64 - border 4 - sparks 48) = ~24 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-32/128px     -> 38px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~39 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-36/144px -> 36px clear
// The previous brand put an H1 in here and needed pt-36/pt-40; an H2 sits one
// size notch smaller at every breakpoint, which is where pt-32/pt-36 comes
// from. Do not shrink it further on the assumption the box keeps an H2.
//
// MHEEPOOH168 palette: the card fades from the brand's card red (#540202) into
// the page near-black (#120303) inside a mid-gold border (#f5b70a), the badge
// frame is bright gold (#fced74) on an inner-panel ground (#2b0101), and the
// spark pair is told apart by brightness within the gold — bright on the left,
// mid on the right. The previous brands' champagne and brown-black are gone.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#f5b70a]/60 bg-gradient-to-b from-[#540202]/95 to-[#120303]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#f1dccd] shadow-[0_10px_30px_rgba(245,183,10,0.26)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c4161c]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fced74]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fced74]/60 bg-[#2b0101] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(245,183,10,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fced74]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fced74] via-[#f5b70a] to-[#c4161c] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f5b70a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
