---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
// The h1 case runs one step SMALLER at base width than the h2 case does at sm,
// on purpose: this box carries the page's longest sentence (the docx H1) inside
// a floating badge, and every extra pixel of font size there turns into another
// wrapped line and another 28px of card padding. It catches up at sm/md, where
// the badge is wide enough to afford it.
const headingSize = HeadingTag === "h1" ? "text-lg sm:text-2xl" : "text-lg sm:text-xl md:text-2xl";

// Flattened single-slot variant: `isolate` on the card, `-z-10` on both aura
// layers, the slot renders as a direct child. Do not re-add a wrapper <div>.
// The badge gets its own `isolate` too, because its hairlines are `-z-10` and
// would otherwise paint against the card's stacking context instead of its own.
//
// There is no `whitespace-nowrap` anywhere in this file. The badge is width
// capped (w-[92%] max-w-2xl) and centred, so a long Thai title wraps instead of
// blowing past the viewport. The two ornaments stay OUT of the line box — they
// are `absolute` hairlines, so 100% of the badge's inner width belongs to the
// title.
//
// BADGE CLEARANCE RE-DERIVED FOR 789BETTING (2026-10-08). This box carries docx
// H1 #1:
//   "789BETTING คาสิโนฐานเข้าหลัก เดิมพันตรงกับบริษัท100%"
// 52 code points; 8 of them are zero-width Thai marks (ิ ้ ั ั ั ิ ั plus one
// more sara i), so it advances 44 cells including its 2 spaces. Its three
// space-delimited chunks measure 10 / 14 / 18 cells, and the worst case assumed
// below is that the line breaker only breaks at those 2 spaces (no Thai
// dictionary breaking). No single chunk is wider than one line at any width, so
// nothing can overflow sideways.
//
// Badge height = (line-height x wrapped lines) + py-2.5 (20px) + border-2 (4px),
// with `leading-normal` (1.5) on the heading, and its bottom edge sits at that
// minus 24px (`-top-6`), measured from the card's top. Text width = badge width
// - horizontal padding - border:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-lg 18px -> ~10.4px/cell = 22 cells/line, 27px/line.
//               Greedy at the 2 spaces: 10 | 14 | 18 -> 3 lines.
//               Budget 4 lines = 4x27 + 24 = 132, edge 108 vs pt-36/144px
//                                                        -> 36px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-2xl 24px -> ~13.9px/cell = 35 cells/line, 36px/line.
//               10+1+14 | 18 -> 2 lines. Budget 3 = 3x36 + 24 = 132, edge 108
//               vs pt-36/144px (sm inherits it)            -> 36px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl stays (the h1 size tops out at sm) -> 43 cells/line,
//               36px/line. 44 cells is one over 43 -> 2 lines.
//               Budget 3 = 3x36 + 24 = 132, edge 108
//               vs pt-36/144px                             -> 36px clear
// One flat pt-36 covers every width with 36px of daylight, because the h1 size
// stops growing at sm: the badge keeps getting wider while the line box stays
// 36px, so the worst case is the same at every breakpoint. All three
// *FloatingBadge files are held at this same flat pt-36 so the next brand
// cannot inherit a padding that was only ever sized for the short one. Do NOT
// shrink it assuming the next brand's heading is shorter — redo the arithmetic
// with that brand's real docx sentence.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): การ์ดไล่จากผิวยก
// #17130a ลงไปหาผิวกลาง #0e0b05 ในกรอบทองแบรนด์ #fad354 ซึ่งมาจาก vivid อันดับ 1
// ของ logo.webp (#fad354/#feda5c) ตรงๆ
// จุดต่างของใบนี้คือป้ายลอยเป็น "แผ่นทองทึบ" ไม่ใช่แผ่นสีเดียวกับการ์ด — ไล่ทองแชมเปญ
// #ffe79a ไปหาทองกลาง #ddab33 บนหมึก #0a0802 ตามกฎคอนทราสต์ของ §2 ที่ว่าพื้นทองต้องใช้
// หมึกเข้มเสมอ ห้ามพลิกเป็นตัวอักษรขาว/งาช้าง (#0a0802 บน #fad354 = 13.5:1 และบนปลาย
// ไล่เฉดที่เข้มสุดคือ #ddab33 = 10.3:1 — ทองลึก #8a6410 ไม่ถูกใช้เป็นพื้นของตัวหนังสือ
// ที่ไหนในไฟล์นี้) ป้ายจึงเป็นจุดเดียวบนหน้านี้ที่หัวข้อเป็นหมึกทึบบนพื้นทองแทนที่จะเป็น
// ตัวอักษรไล่เฉดบนพื้นมืด และทำให้มันไม่จมไปกับขอบการ์ดตอนที่มันคร่อมเส้นขอบอยู่ ซึ่งเป็น
// ขั้วตรงข้ามกับป้ายแผ่นดำของ ContentBoxTwoFloatingBadge ที่อยู่ใต้ลงไปบนหน้าเดียวกัน —
// ป้ายลอยสองใบบนหน้าเดียวจึงไม่อ่านเป็นแผ่นเดียวกันสองรอบ
// ออร่าสองมุมเป็นบรอนซ์ #c9881f กับทองลึก #8a6410 คือ "ทองอุ่น/ทองเข้ม" ของฮิวเดียวกัน
// รอบนี้ไม่มีสีที่สองเลย (bg.json = {"mode":"color","color":"#000000"} ดำตัน)
// เนื้อความ #f3e7cd (= BRAND_TEXT) — 15.0:1 บนผิวยก
//
// ชุดทองเมทัลลิก-เงินโครเมียมของ UOK365 ที่เคยค้างในไฟล์นี้ (#c8912f #f5d98a #6d4412
// #d8dbe0 #191108 #120c07 #191005 #ece1cc rgba(200,145,47,…)) ออกครบทุกจุดแล้ว —
// รอบก่อนบังเอิญเป็นทองอีกเฉดหนึ่ง ซึ่งเป็นกรณีที่พลาดง่ายที่สุด เพราะ "ทองอยู่แล้ว"
// ไม่ได้หมายความว่าเป็นทองของแบรนด์นี้
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#fad354]/60 bg-gradient-to-b from-[#17130a] to-[#0e0b05] p-8 pt-36 text-left text-base leading-relaxed text-[#f3e7cd] shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c9881f]/35 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#8a6410]/40 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 isolate flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center overflow-hidden rounded-xl border-2 border-[#8a6410] bg-gradient-to-r from-[#ffe79a] to-[#ddab33] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(0,0,0,0.55)] sm:px-8">
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#0a0802] to-transparent" />
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[3px] bg-gradient-to-r from-transparent via-[#8a6410] to-transparent" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-tight text-[#0a0802] uppercase`}>{title}</HeadingTag>
        </div>
      )
    }

    <slot />
  </div>
</section>
