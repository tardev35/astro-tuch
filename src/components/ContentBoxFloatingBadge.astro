---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#7a0d10]/40 bg-gradient-to-b from-[#170405]/95 to-[#0a0202]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#efe3d2] shadow-[0_10px_30px_rgba(200,17,24,0.16)] md:pt-28">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c81118]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#ebbb4a]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ebbb4a]/50 bg-[#0a0202] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(235,187,74,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ebbb4a]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f5333c] via-[#fbe289] to-[#c81118] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ebbb4a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
