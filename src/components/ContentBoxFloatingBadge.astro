---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Worst case re-checked for PREMSUK365's h1, "PREMSUK365 หวยที่ดีต้องเปรมสุข
// เว็บแทงหวยออนไลน์ที่ดีที่สุดในตอนนี้". The heading grows one step per
// breakpoint, so each one is measured against its OWN line-height, not the
// base's:
//   base  text-xl  (30px/line) -> up to 4 lines = 4x30 + 20 py + 4 border
//                                = 144px, bottom edge 120px vs pt-44/176px
//   sm    text-2xl (36px/line) -> up to 3 lines = 132px, edge 108px vs
//                                pt-32/128px
//   md    text-3xl (45px/line) -> up to 3 lines = 159px, edge 135px, which
//                                OVERFLOWS pt-32/128px — hence md:pt-36/144px
// Do not trim any of these back for a short title — the next brand's may be
// longer, and md is the tight one.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#e3c56a]/40 bg-gradient-to-b from-[#0d3a22]/95 to-[#03130a]/95 p-8 pt-44 text-left text-base leading-relaxed text-[#e4e7d8] shadow-[0_10px_30px_rgba(227,197,106,0.22)] sm:pt-32 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e3c56a]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#2a9d5c]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e3c56a]/40 bg-[#03130a] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(227,197,106,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#2a9d5c]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#2a9d5c]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
