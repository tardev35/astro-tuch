---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Clearance re-done for MEPAY77's h1, "MEPAY77 คาสิโน แตกง่าย เว็บตรง รวมเกมแท้
// ทุกค่าย" — 46 characters, the longest title this box has carried. Each
// breakpoint is measured against its OWN line-height, and the budget is FOUR
// wrapped lines at base / TWO from sm, so a longer title than this brand's still
// clears:
//   base  text-xl  (28px/line) -> 4 lines = 4x28 + 20 py + 4 border = 136px,
//                                 bottom edge 112px vs pt-32/128px
//   sm    text-2xl (32px/line) -> 2 lines = 88px,  edge 64px vs sm:pt-24/96px
//   md    text-3xl (36px/line) -> 2 lines = 96px,  edge 72px vs md:pt-24/96px
// base was pt-28 (112px), i.e. exactly zero clearance at four lines; it is pt-32
// now. Do not push these back down without redoing the arithmetic above.
//
// Two-tone: the left spark is gold and the right one silver, matching the
// logo's gold "ME"/"77" against the brushed-silver "PAY".
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#7a4f0b]/70 bg-gradient-to-b from-[#241503]/95 to-[#130c01]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#f1e5cd] shadow-[0_10px_30px_rgba(242,174,53,0.22)] sm:pt-24 md:pt-24">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fdcc5c]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#dfe3e8]/15 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#f2ae35]/50 bg-[#130c01] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(253,204,92,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fdcc5c]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fdcc5c] via-[#fff6e0] to-[#f2ae35] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#dfe3e8]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
