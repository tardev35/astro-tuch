---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Clearance re-done for KINDEE365's h3, "แทงหวย 2 ตัว ถูกจ่ายบาทละ 100". Each
// breakpoint is measured against its OWN line-height, not the base's, and the
// budget is kept at THREE wrapped lines at base / TWO from sm so a longer title
// than this brand's still clears:
//   base  text-lg  (28px/line) -> 3 lines = 3x28 + 20 py + 4 border = 108px,
//                                 bottom edge 84px vs pt-28/112px
//   sm    text-xl  (28px/line) -> 3 lines = 108px, edge 84px vs sm:pt-24/96px
//   md    text-2xl (32px/line) -> 2 lines = 88px,  edge 64px vs md:pt-24/96px
// The h1 case: base text-xl 3 lines = edge 84px (clears 112), md text-3xl
// (36px/line) 2 lines = edge 72px (clears 96). The previous brand reserved
// pt-44 at base for a one-line badge, which left ~120px of dead space above the
// copy; do not push these back up without redoing the arithmetic above.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#2b8ae9]/40 bg-gradient-to-b from-[#083163]/95 to-[#010b26]/95 p-8 pt-28 text-left text-base leading-relaxed text-[#cfe3f7] shadow-[0_10px_30px_rgba(43,138,233,0.22)] sm:pt-24 md:pt-24">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#2b8ae9]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e8bb4a]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e8bb4a]/45 bg-[#010b26] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(232,187,74,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#e8bb4a]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#e8bb4a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
