---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone. Re-checked for
// this brand: there is no `whitespace-nowrap` anywhere in this file.
//
// Clearance RE-DERIVED for DM899 (2026-10-03), which puts this box on docx H2
// #3: "โปรโมชั่นเล่นสล็อต DM899 อัปเดตใหม่ทุกเดือน" — 43 code points, 35
// advancing cells once the 8 zero-width Thai marks (ั ่ ่ ็ ั ่ ุ ื) are
// discounted and the 2 spaces counted. It arrives as an H2, so the badge keeps
// py-2.5 (20px) + border-2 (4px), with two ✦ spans plus gap-2 taking ~48px of
// the line box:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~21 cells/line.
//         It breaks only at the brief's own two spaces:
//         "โปรโมชั่นเล่นสล็อต DM899" 20 | "อัปเดตใหม่ทุกเดือน" 14 -> 2 lines.
//         Real 2 lines = 2x27 + 24 = 78, bottom edge 54 vs pt-32/128px
//                                                -> 74px clear
//         Budget 3 lines = 3x27 + 24 = 105, edge 81  -> 47px clear
//         (re-checked at 320px: the same single break, still 2 lines)
//   sm    text-xl 20px -> 30px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~38 cells/line,
//         so 35 cells fits on 1 line. Budget 3 lines = 3x30 + 24 = 114,
//         edge 90 vs pt-32/128px                 -> 38px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~40 cells/line,
//         so 1 line. Budget 3 lines = 3x36 + 24 = 132,
//         edge 108 vs md:pt-36/144px             -> 36px clear
// Every breakpoint clears with at least a full spare line of budget, so
// pt-32/md:pt-36 stands for this brand — it is NOT reduced. Do NOT shrink it on
// the assumption the box keeps a title this length; redo the arithmetic with the
// real docx sentence the next brand puts here.
//
// DM899 (รอบเขียวมรกต-แดงสด-ทอง บนดำอมเขียว 2026-10-03): การ์ดไล่จากผิวการ์ด
// #0a1a0e ลงไปหาพื้นลึกสุด #030a05 ในกรอบเขียวแบรนด์ #01a326 ป้ายหัวข้อลอยอยู่บน
// พื้นเพจดำอมเขียว #030a05 ในกรอบเขียวเดียวกัน แบรนด์นี้มีสองสีจริง (โลโก้เป็นตัว D
// เขียว vivid #01841b ซ้อนตัว M แดง #fb252b) ประกายสองข้างจึงเป็นทองอ่อน #ffe9a8
// ฝั่งซ้ายและแดงแบรนด์ #fb252b ฝั่งขวา ตัวหัวข้อไล่ทองอ่อน #ffe9a8 → ทองแบรนด์
// #f2b422 → เขียวแบรนด์ #01a326 ซึ่งจบเข้มกว่าการ์ด H1 ที่จบที่เขียวสว่าง #12c23a
// หนึ่งขั้น เพราะหัวข้อนี้ตกสองบรรทัดบนมือถือและหางไล่เฉดต้องยังอ่านออกบนป้ายพื้น
// #030a05 (เขียวแบรนด์บนพื้นนี้ได้ 6.2:1) ออร่าสองมุมเป็นคู่เขียว-แดงของโลโก้
// เนื้อความ #e4f2e4 (BRAND_TEXT)
//
// ชุดแดงสด-ทอง-ดำของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #f5282a #ffc93c #ffeab0
// #c08a07 #240406 #140203 #f6e7e0) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#01a326]/60 bg-gradient-to-b from-[#0a1a0e]/95 to-[#030a05]/96 p-8 pt-32 text-left text-base leading-relaxed text-[#e4f2e4] shadow-[0_10px_30px_rgba(1,163,38,0.20)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fb252b]/26 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#01a326]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#01a326]/70 bg-[#030a05] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(0,0,0,0.85)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffe9a8]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f2b422] to-[#01a326] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fb252b]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
