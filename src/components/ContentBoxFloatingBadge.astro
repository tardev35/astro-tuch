---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance redone for VAK88's H2, "โปรโมชั่นพิเศษ VAK88 แจกโบนัสหนักทุกยูส ไม่ล็อค"
// — an H2 this round, so every size step is one notch smaller than the previous
// brand's H1 and the padding comes down with it. The heading carries
// `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and
// the two spark spans plus gap-2 take ~48px out of the line box. The title is 47
// code points, 8 of them zero-width Thai marks, so ~39 advancing glyphs. Budget
// is one line beyond the measured wrap at every breakpoint:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~21 glyphs/line,
//         so 39 glyphs wraps to 3. Budget 4 lines = 4x27 + 24 = 132px,
//         bottom edge 108px vs pt-32/128px    -> 20px clear
//   sm    text-xl 20px -> 30px/line, ~475px of text width = ~43 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-32/128px     -> 38px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-36/144px -> 36px clear
// Do not shrink this on the assumption the box keeps an H2 — if a future brand
// drops an H1 in here the sizes step up one notch and the arithmetic has to be
// redone in the other direction.
//
// VAK88 palette: near-black navy card inside a deep-gold border, a metallic-gold
// heading gradient through warm white, and a two-tone spark pair — brand gold on
// the left, phoenix crimson on the right — matching the logo's gold wordmark
// against the crimson phoenix.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#8a5f14]/70 bg-gradient-to-b from-[#0b1020]/95 to-[#04060e]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#ded8ca] shadow-[0_10px_30px_rgba(230,178,60,0.22)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e6b23c]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#cf2027]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e6b23c]/50 bg-[#060913] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(230,178,60,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffd873]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffd873] via-[#fff4dd] to-[#e6b23c] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ee3a34]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
