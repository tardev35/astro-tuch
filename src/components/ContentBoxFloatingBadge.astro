---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance redone for GODBET88, which puts this box in TWO slots: docx H1 #1
// "GODBET88 เว็บสล็อตไม่ติดเทิร์น ปั่นได้ทั้งวัน ไม่จำกัดรอบถอน" (60 code points,
// ~46 advancing glyphs after the zero-width Thai marks) and docx H2 #7
// "ช่องทางติดต่อแอดมิน GODBET88 เกี่ยวกับเกมสล็อต 24 ชั่วโมง" (~47 advancing
// glyphs, one size notch smaller at every breakpoint). The H1 is the binding
// case, so the numbers below are its. The heading carries `leading-normal`
// (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and the two spark
// spans plus gap-2 take ~48px out of the line box. Budget is one line beyond the
// measured wrap at every breakpoint:
//   base  text-xl 20px -> 30px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~19 glyphs/line,
//         so 46 glyphs wraps to 3. Budget 4 lines = 4x30 + 24 = 144px,
//         bottom edge 120px vs pt-36/144px    -> 24px clear
//   sm    text-2xl 24px -> 36px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~34 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs pt-36/144px    -> 36px clear
//   md    text-3xl 30px -> 45px/line, max-w-2xl gives ~556px = ~33 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x45 + 24 = 159px,
//         bottom edge 135px vs md:pt-40/160px -> 25px clear
// The base step went pt-32 -> pt-36 this round: the previous brand put an H2 in
// here and 128px only left 8px of clearance once the H1's sizes stepped up one
// notch. Do not shrink it back on the assumption the box keeps an H2.
//
// GODBET88 palette: the card fades from the raised brown-black (#161208) into
// the page black (#050403) inside a primary-gold border (#c2a55c), the badge
// frame is the lighter gold (#e2c87f) on a card-surface ground (#0a0806), and
// the spark pair is told apart by brightness within the one hue — sheen
// (#f6e7b8) on the left, primary gold on the right. This brand has a single
// identity colour; the previous brand's crimson and oxblood are gone.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#c2a55c]/70 bg-gradient-to-b from-[#161208]/95 to-[#050403]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#ece1cc] shadow-[0_10px_30px_rgba(194,165,92,0.28)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c2a55c]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#f6e7b8]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e2c87f]/60 bg-[#0a0806] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(194,165,92,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f6e7b8]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#f6e7b8] via-[#e2c87f] to-[#c2a55c] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#c2a55c]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
