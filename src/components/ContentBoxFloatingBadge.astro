---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card.
//
// Worst case re-checked for TIGER88: the h2 title "4 อันดับเกมสล็อต TIGER88
// แตกง่าย ได้เงินไว" wraps to 3 lines at 320px (3 x 27px + 20px py + 4px border
// = 105px, bottom edge at 81px) against pt-44/176px, and to 2 lines from sm up
// (2 x 30px + 24px = 84px, bottom edge at 60px) against pt-32/128px.
// Do not trim it back for a short title — the next brand's may be longer.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#5e0505]/80 bg-gradient-to-b from-[#1c0606]/95 to-[#070202]/95 p-8 pt-44 text-left text-base leading-relaxed text-[#f2e3c9] shadow-[0_10px_30px_rgba(239,22,34,0.22)] sm:pt-32 md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ef1622]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fdd121]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#5e0505]/80 bg-[#070202] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(253,209,33,0.3)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fdd121]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffe98a] via-[#fdd121] to-[#ef1622] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fdd121]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
