---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The badge is `absolute -top-6`, so the card's top padding must exceed the
// badge's own height minus 24px. It is width-capped (w-[92%] max-w-2xl) and
// centred rather than whitespace-nowrap, so a long Thai title wraps instead of
// overflowing the card and forcing horizontal scroll on a phone.
//
// Clearance redone for LOTTOKA's docx H2 #2,
// "LOTTOKA รัฐบาลไทย ลาว ออมสิน ฮานอย หวยหุ้น ครบทุกแนว" — an H2 this round, so
// every size step is one notch SMALLER than the previous brand's H1 while the
// padding is kept where it was, which only adds clearance. The heading carries
// `leading-normal` (1.5), the badge adds py-2.5 (20px) plus border-2 (4px), and
// the two spark spans plus gap-2 take ~48px out of the line box. The title is 52
// code points, 3 of them zero-width Thai marks, so ~49 advancing glyphs.
// Budget is one line beyond the measured wrap at every breakpoint:
//   base  text-lg 18px -> 27px/line, ~218px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4 - sparks 48) = ~22 glyphs/line,
//         so 49 glyphs wraps to 3. Budget 4 lines = 4x27 + 24 = 132px,
//         bottom edge 108px vs pt-32/128px    -> 20px clear
//   sm    text-xl 20px -> 30px/line, ~443px of text width
//         (w-[92%] 559 - px-8 64 - border 4 - sparks 48) = ~40 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x30 + 24 = 114px,
//         bottom edge 90px vs pt-32/128px     -> 38px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl gives ~556px = ~42 glyphs/line,
//         wraps to 2. Budget 3 lines = 3x36 + 24 = 132px,
//         bottom edge 108px vs md:pt-40/160px -> 52px clear
// Do not shrink this on the assumption the box keeps an H2 — if a future brand
// drops an H1 in here the sizes step up one notch and the arithmetic has to be
// redone in the other direction.
//
// LOTTOKA palette: a deep oxblood card (#3a0709) fading into the page near-black
// inside a logo-red border, a bright-red badge frame on the page ground, and a
// two-tone spark pair — cream on the left, light rose on the right — matching the
// logo's solid red LOTTO against its white-outlined KA. No gold and no navy:
// this brand is red on near-black and nothing else.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#c21e22]/70 bg-gradient-to-b from-[#3a0709]/95 to-[#0a0608]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#ded9da] shadow-[0_10px_30px_rgba(194,30,34,0.28)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c21e22]/28 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#ffe9ea]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e2353a]/60 bg-[#0a0608] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(226,53,58,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffe9ea]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#e2353a] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ff8a8d]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
