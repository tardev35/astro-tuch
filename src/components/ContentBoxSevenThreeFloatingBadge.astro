---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#9d16f1]/25 bg-gradient-to-b from-[#150726]/95 to-[#06020e]/95 p-8 pt-32 shadow-[0_10px_30px_rgba(157,22,241,0.16)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#e53cfe]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e8e6ee]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#9d16f1]/35 bg-[#150726] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(157,22,241,0.22)] sm:px-8">
          <h2 class="bg-gradient-to-r from-[#e0b7ff] via-[#c47bff] to-[#9d16f1] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb]">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-[#c47bff]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0fb] md:border-l md:border-[#9d16f1]/25 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-[#c47bff]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
