---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// Checked against NEXT55's section 5 title, "โปรโมชั่น คืนยอดเสีย 0.3%"
// (24 characters):
//   base  text-lg  (28px/line) — badge content ~313px on a 375px viewport, so
//         the title fits on 1-2 lines; budgeted at 3 = 3x28 + 20 py + 4 border
//         = 108px, bottom edge 84px, cleared by pt-28 (112px)
//   sm    text-xl  (28px/line) — 1 line = 52px, edge 28px, cleared by 112px
//   md    text-2xl (32px/line) — badge content ~608px at the max-w-2xl cap, so
//         1 line = 56px, edge 32px, cleared by 112px
// Do not shrink pt-28: it was sized for a three-line base title, not for this
// brand's one.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#cd1437]/45 bg-gradient-to-b from-[#17181c]/95 to-[#0c0d10]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(0,0,0,0.7)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#cd1437]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e7eaef]/14 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#cd1437]/70 bg-[#0c0d10] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(205,20,55,0.32)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#ffb3bf] via-[#f0435f] to-[#cd1437] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#e7eaef]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5dae2] md:border-l md:border-[#cd1437]/35 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#f0435f]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
