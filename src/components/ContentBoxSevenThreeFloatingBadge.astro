---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap — re-checked for this brand, the string does not appear in
// this file. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// RE-DERIVED for BRAVO168's docx H3 #4 "คืนยอดเสีย โบนัส 0.3%" — 21 code points,
// ~18 advancing glyphs once the 3 zero-width marks (ื ี ั) are discounted.
// Measured here rather than inherited on trust. The heading keeps
// `leading-normal` (1.5) and the badge adds py-2.5 (20px) plus border-2 (4px);
// there are no spark spans in this variant, so the full inner width is text:
//   base  text-lg 18px -> 27px/line, ~266px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4) = ~26 glyphs/line, so 18 glyphs
//         is 1 line. Budget 3 lines = 3x27 + 24 = 105px,
//         bottom edge 81px vs pt-28/112px   -> 31px clear
//   sm    text-xl 20px -> 30px/line, ~491px of text width
//         (w-[92%] 559 - px-8 64 - border 4) = ~44 glyphs/line -> 1 line.
//         Budget 3 lines = 3x30 + 24 = 114px, edge 90px vs 112px -> 22px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl caps text at ~604px -> 1 line.
//         Budget 3 lines = 3x36 + 24 = 132px, edge 108px vs md:pt-32 (128px)
//         -> 20px clear, and the realistic 2-line budget (2x36 + 24 = 96px,
//         edge 72px) clears by 56px.
// pt-28/md:pt-32 is the same pair its two sibling *FloatingBadge variants use,
// so the three stay in sync. Do not shrink it without redoing the arithmetic
// against the real docx sentence the next brand puts in here.
//
// This block carries the image column on the RIGHT (7fr) — its sibling
// ContentBoxSevenThreePremium carries its image on the left, so the pair reads
// as two different blocks rather than the same card twice. The page passes
// neither titleleft nor titleright, so the badge is the only heading it emits.
//
// BRAVO168 palette (น้ำเงินรอยัล-ทอง 2026-09-30): การ์ดไล่จากผิวแผงยก #072247 ลงไปหา
// พื้นเพจกรมท่าเกือบดำ #02081a ในกรอบน้ำเงินเส้น #0e3f8f ป้ายหัวข้อลอยบนพื้นเพจในกรอบ
// ทองแบรนด์ #f4cb69 ไล่เฉดทองอ่อน #ffe39a → ทองแบรนด์ #f4cb69 → น้ำเงินรอยัล #1558c4
// ตามลำดับสีในเวิร์ดมาร์กที่ BRAVO เป็นโครเมียมน้ำเงินแล้วปิดด้วยเลข 168 สีทอง ออร่า
// สองมุมแยกกันด้วยคู่สีเดียวกันคือน้ำเงินมุมขวาล่างกับทองมุมซ้ายบน เนื้อความ #dbe5f5
// (BRAND_TEXT) — ชุดทอง-แดงเลือดหมูของ GOT777 (#f5c518 #ffe9a8 #96690f #d21622
// #241108 #0a0503 #ece0cb #bdae92) ออกหมด
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#0e3f8f] bg-gradient-to-b from-[#072247]/95 to-[#02081a]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(1,4,12,0.85)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#1558c4]/35 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#f4cb69]/24 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#f4cb69]/70 bg-[#02081a] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(1,4,12,0.8)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#ffe39a] via-[#f4cb69] to-[#1558c4] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#ffe39a]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe5f5] md:border-l md:border-[#0e3f8f]/80 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#f4cb69]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
