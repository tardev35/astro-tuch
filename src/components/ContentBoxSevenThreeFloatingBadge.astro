---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// Re-done for KINDEE365's section 6 title, "เว็บ KINDEE365 ฝากถอนระบบออโต้
// ทุกช่องทางและวอลเลท" (49 characters):
//   base  text-lg  (28px/line) — badge content ~283px on a 375px viewport, so
//         the title wraps to 2 lines; budgeted at 3 = 3x28 + 20 py + 4 border
//         = 108px, bottom edge 84px, cleared by pt-28 (112px)
//   sm    text-xl  (28px/line) — 2 lines = 80px, edge 56px, cleared by 112px
//   md    text-2xl (32px/line) — badge content ~608px at the max-w-2xl cap, so
//         2 lines = 88px, edge 64px, cleared by 112px
// Do not shrink pt-28: it was sized for a three-line base title, not for this
// brand's two.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#e8bb4a]/35 bg-gradient-to-b from-[#083163]/95 to-[#02153c]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(1,11,38,0.6)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#2b8ae9]/35 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e8bb4a]/22 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#e8bb4a]/60 bg-[#02153c] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(232,187,74,0.30)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe3f7]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#a3dbfb]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfe3f7] md:border-l md:border-[#e8bb4a]/30 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#e8bb4a]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
