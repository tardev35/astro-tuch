---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// Checked against SAGAME66's docx H3 #4, "แนะนำเพื่อน โบนัส 0.8%" — 21 code
// points, ~18 advancing glyphs once the 3 zero-width marks (ื ่ ั) are
// discounted. The heading keeps `leading-normal` (1.5) and the badge adds py-2.5
// (20px) plus border-2 (4px); there are no spark spans in this variant, so the
// full inner width is text:
//   base  text-lg 18px -> 27px/line, ~266px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4) = ~26 glyphs/line, so 18 glyphs
//         is 1 line. Budget 3 lines = 3x27 + 24 = 105px,
//         bottom edge 81px vs pt-28/112px   -> 31px clear
//   sm    text-xl 20px -> 30px/line, ~491px of text width -> 1 line.
//         Budget 3 lines = 3x30 + 24 = 114px, edge 90px vs 112px -> 22px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl caps text at ~604px -> 1 line.
//         Budget 2 lines = 2x36 + 24 = 96px, edge 72px vs 112px  -> 40px clear
// Do not shrink pt-28: it was sized for a three-line base title, not for this
// brand's one.
//
// SAGAME66 palette (ทอง-เงินโครเมียม 2026-09-23): การ์ดไล่จากพื้นการ์ด #171006 ลง
// ไปหาพื้นเพจน้ำตาลเกือบดำ #0d0903 ในกรอบทองลึก #96671a ป้ายหัวข้อลอยบนพื้นเพจใน
// กรอบทองหลัก #e8b93f ไล่เฉดทองสว่าง #ffe9a3 → เงินโครเมียม #eef3f8 → ทองหลัก
// #e8b93f ตามลำดับสีในโลโก้ SA ทอง / GAME เงิน / 66 ทอง ออร่าสองมุมแยกกันด้วยคู่สี
// นั้นคือทองกับเงิน แดง-ทองของ THE88 ออกหมด
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#96671a]/45 bg-gradient-to-b from-[#171006]/95 to-[#0d0903]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(13,9,3,0.7)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#e8b93f]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#eef3f8]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#e8b93f]/70 bg-[#0d0903] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(13,9,3,0.75)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#eef3f8] to-[#e8b93f] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#ffe9a3]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e3d8c0] md:border-l md:border-[#96671a]/35 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#e8b93f]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
