---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// RE-DERIVED for WIN999's docx H3 #9, "แนะนำเพื่อน โบนัส 0.8%" — 21 code points,
// ~19 advancing glyphs once the 3 zero-width marks (ื ่ ั) are discounted, i.e.
// one glyph longer than KINGDOM66's title at the same notch, so pt-28 still
// clears; measured here rather than inherited on trust. The heading keeps
// `leading-normal` (1.5) and the badge adds py-2.5 (20px) plus border-2 (4px);
// there are no spark spans in this variant, so the full inner width is text:
//   base  text-lg 18px -> 27px/line, ~266px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4) = ~26 glyphs/line, so 19 glyphs
//         is 1 line. Budget 3 lines = 3x27 + 24 = 105px,
//         bottom edge 81px vs pt-28/112px   -> 31px clear
//   sm    text-xl 20px -> 30px/line, ~491px of text width -> 1 line.
//         Budget 3 lines = 3x30 + 24 = 114px, edge 90px vs 112px -> 22px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl caps text at ~604px -> 1 line.
//         Budget 2 lines = 2x36 + 24 = 96px, edge 72px vs 112px  -> 40px clear
// Do not shrink pt-28: it was sized for a three-line base title, not for this
// brand's one.
//
// This block carries the image column on the RIGHT (7fr) — its sibling
// ContentBoxSevenThreePremium carries its image on the left, so the pair reads
// as two different blocks rather than the same card twice. The page passes
// neither titleleft nor titleright, so the badge is the only heading it emits.
//
// WIN999 palette (ทอง-ดำ 2026-09-29): การ์ดไล่จากผิวการ์ด #101010 ลงไปหาพื้นเพจดำสนิท
// #050505 ในกรอบทองลึก #8a6502 ป้ายหัวข้อลอยบนพื้นเพจในกรอบทองแบรนด์ #fcc403 ไล่เฉด
// ขาวไฮไลต์ #fffbea → ทองสว่าง #fdda04 → ทองแบรนด์ #fcc403 ตามลำดับสีในโลโก้ที่คำว่า
// WIN เป็นทองเต็มและเลข 999 เป็นขาว ออร่าสองมุมแยกกันด้วยคู่สีนั้นคือทองกับขาวนวล
// เนื้อความ #e9e4d6 (BRAND_TEXT) — ชุดทอง-ดำอุ่นของ KINGDOM66 (#e6bf4e #f5e196
// #efe6cf #5c4113 #151109 #0c0b09 #ebe3d3) ออกหมด
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#8a6502]/70 bg-gradient-to-b from-[#101010]/95 to-[#050505]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(3,2,0,0.85)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#fcc403]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e9e4d6]/12 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#fcc403]/70 bg-[#050505] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(3,2,0,0.8)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#fffbea] via-[#fdda04] to-[#fcc403] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#fdda04]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9e4d6] md:border-l md:border-[#8a6502]/60 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#fcc403]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
