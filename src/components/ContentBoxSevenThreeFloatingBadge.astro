---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap — re-checked for this brand, the string does not appear in
// this file. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// BADGE CLEARANCE RE-DERIVED FOR 789BETTING (2026-10-08). This box carries docx
// H3 #5 "แนะนำเพื่อน โบนัส 0.8%" — 22 code points, 19 advancing cells once the
// 3 zero-width marks (ื ่ ั) are discounted and the 2 spaces counted. Measured
// here rather than inherited on trust. The heading keeps `leading-normal` (1.5)
// and the badge adds py-2.5 (20px) plus border-2 (4px); there are no spark spans
// in this variant, so the full inner width is text:
//   base 320px  card 288, badge 92% = 265, -px-4 32 -border 4 -> 229px.
//               text-lg 18px -> ~10.4px/cell = 22 cells/line, 27px/line.
//               19 cells fits on 1 line. Budget 2 lines = 2x27 + 24 = 78,
//               edge 54 vs pt-36/144px                     -> 90px clear
//   sm  640px   badge 92% of 608 = 559, -px-8 64 -border 4 -> 491px.
//               text-xl 20px -> ~11.6px/cell = 42 cells/line, 30px/line.
//               19 cells, 1 line. Budget 2 = 2x30 + 24 = 84, edge 60
//               vs pt-36/144px                             -> 84px clear
//   md  768px+  badge hits max-w-2xl/672, text 672 - 64 - 4 = 604px.
//               text-2xl 24px -> 43 cells/line, 36px/line. 19 cells, 1 line.
//               Budget 2 = 2x36 + 24 = 96, edge 72 vs pt-36/144px
//                                                          -> 72px clear
// This round's heading is the SHORT one of the three, so the clearance is
// generous rather than tight — and the flat pt-36 is deliberate anyway: all
// three *FloatingBadge files are held on the same value so the next brand
// cannot inherit a padding that was only ever sized for the short one (the
// previous round shipped pt-36 / pt-28 / pt-32+md:pt-36, and the pt-28 one went
// down to 4px of clearance the moment it got a 53-cell sentence). Do not shrink
// it without redoing the arithmetic against the real docx sentence the next
// brand puts in here.
//
// This block carries the image column on the RIGHT — and the grid stays at
// md:grid-cols-[7fr_3fr] so the image lands in the NARROW 3fr column and the
// paragraph gets the wide 7fr one. At [3fr_7fr] the image would take 70% of the
// card and squeeze the docx paragraph into a 30% gutter. Its sibling
// ContentBoxSevenThreeCyberCut keeps [3fr_7fr] with the image on the left, so
// the pair mirrors instead of stacking both pictures down one edge. The page
// passes neither titleleft nor titleright, so the badge is the only heading it
// emits.
//
// Drawn width of the 3fr image column, for the `widths`/`sizes` the page passes
// (section max-w-7xl/1280px + px-4, card p-8, grid gap-10, and the image column
// adds md:pl-10 plus a 1px md:border-l):
//   >= 1280px : (1280 - 32 - 64 - 40) x 0.3 - 41 = 343.2 - 41 = 302.2 -> 302px
//   md..1279  : (100vw - 136) x 0.3 - 41         = calc(30vw - 82px)
//   < md      : one column at p-8, no md: padding = calc(100vw - 96px)
// Change any of those numbers and the page's `sizes` has to move with it.
//
// 789BETTING (รอบทองเมทัลลิกบนดำสนิท 2026-10-08, brand-spec §2): นี่คือครึ่ง "ป้ายลอย"
// ของคู่บล็อกรูป+ข้อความ คู่ของมันคือ ContentBoxSevenThreeCyberCut ที่เป็นการ์ดมุมตัด
// ผิวลึกสุด ใบนี้จึงเป็นการ์ดมนไล่จากผิวยก #17130a ลงไปหาผิวลึกสุด #060402 ในกรอบทอง
// แบรนด์ #fad354 ให้ต่างกันตั้งแต่ขอบ ป้ายหัวข้อลอยบนพื้น #060402 ในกรอบทองเดียวกัน
// ไล่ทองแชมเปญ #ffe79a → ทองกลาง #ddab33 → บรอนซ์ #c9881f (6.9:1 บนพื้นป้าย — หัวข้อนี้
// สั้น อยู่บรรทัดเดียวทุกความกว้าง หางไล่เฉดจึงยังอ่านออกทั้งบรรทัด) ซึ่งเป็นลำดับเดียว
// บนหน้านี้ที่จบด้วยบรอนซ์
// ออร่าสองมุมเป็นบรอนซ์ #c9881f มุมซ้ายบนกับทองลึก #8a6410 มุมขวาล่าง คือ "ทองอุ่น/
// ทองเข้ม" ของฮิวเดียวกัน รอบนี้ไม่มีสีที่สองเลย เนื้อความ #f3e7cd (= BRAND_TEXT)
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#f2b422 #ffe9a8 #12c23a #01a326
// #fb252b #102a16 #061008 #e4f2e4) ออกครบทุกจุดแล้ว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#fad354]/55 bg-gradient-to-b from-[#17130a]/95 to-[#060402]/96 p-8 pt-36 shadow-[0_10px_30px_rgba(0,0,0,0.80)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#c9881f]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#8a6410]/40 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#fad354]/70 bg-[#060402] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(0,0,0,0.85)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#ffe79a] via-[#ddab33] to-[#c9881f] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[7fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#ffe79a]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7cd] md:border-l md:border-[#fad354]/35 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#ddab33]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
