---
export interface Props {
  title?: string;
  /** The docx heading level this block sits at. The badge, and the two column
   *  labels, all follow it — a variant that hardcodes its own level is how the
   *  rendered heading inventory stops matching the brief. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// The badge is width-capped (w-[92%] max-w-2xl) and centred, never
// whitespace-nowrap, so a full docx sentence wraps instead of blowing past the
// viewport. It sits at -top-6, so the card's top padding has to clear the badge
// height minus that 24px offset.
//
// Checked against KINGDOM66's docx H3 #5, "คืนยอดเสีย โบนัส 0.3%" — 20 code
// points, ~18 advancing glyphs once the 2 zero-width marks (ื ่) are discounted.
// The heading keeps `leading-normal` (1.5) and the badge adds py-2.5 (20px) plus
// border-2 (4px); there are no spark spans in this variant, so the full inner
// width is text:
//   base  text-lg 18px -> 27px/line, ~266px of text width at 360px
//         (w-[92%] 302 - px-4 32 - border 4) = ~26 glyphs/line, so 18 glyphs
//         is 1 line. Budget 3 lines = 3x27 + 24 = 105px,
//         bottom edge 81px vs pt-28/112px   -> 31px clear
//   sm    text-xl 20px -> 30px/line, ~491px of text width -> 1 line.
//         Budget 3 lines = 3x30 + 24 = 114px, edge 90px vs 112px -> 22px clear
//   md    text-2xl 24px -> 36px/line, max-w-2xl caps text at ~604px -> 1 line.
//         Budget 2 lines = 2x36 + 24 = 96px, edge 72px vs 112px  -> 40px clear
// Do not shrink pt-28: it was sized for a three-line base title, not for this
// brand's one.
//
// This block carries the image column, and the page passes neither titleleft nor
// titleright, so the badge is the only heading it emits.
//
// KINGDOM66 palette (ทอง-ดำ 2026-09-25): การ์ดไล่จากผิวการ์ดดำอมน้ำตาล #151109 ลง
// ไปหาพื้นเพจเกือบดำ #0c0b09 ในกรอบทองลึก #5c4113 ป้ายหัวข้อลอยบนพื้นเพจในกรอบทอง
// แบรนด์ #e6bf4e ไล่เฉดทองอ่อน #f5e196 → ครีมแพลตินัมอุ่น #efe6cf → ทองแบรนด์
// #e6bf4e ตามลำดับสีในโลโก้ที่คำว่า KINGDOM ไล่จากทองอ่อนไปเข้มก่อนจบที่เลข 66 สีทอง
// เต็ม ออร่าสองมุมแยกกันด้วยคู่สีนั้นคือทองกับครีม เนื้อความ #ebe3d3 (BRAND_TEXT) —
// ชุดทอง-เงินโครเมียมเย็นของ SAGAME66 (#e8b93f #ffe9a3 #96671a #eef3f8 #171006
// #0d0903 #e3d8c0) ออกหมด แบรนด์นี้ไม่มีสีเงินเย็นอยู่เลย
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#5c4113]/70 bg-gradient-to-b from-[#151109]/95 to-[#0c0b09]/95 p-8 pt-28 shadow-[0_10px_30px_rgba(5,4,3,0.85)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#e6bf4e]/32 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#efe6cf]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#e6bf4e]/70 bg-[#0c0b09] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(5,4,3,0.8)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#f5e196] via-[#efe6cf] to-[#e6bf4e] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3]">
        {titleleft && <HeadingTag class="text-2xl leading-normal font-bold text-[#f5e196]">{titleleft}</HeadingTag>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ebe3d3] md:border-l md:border-[#5c4113]/60 md:pl-10">
        {titleright && <HeadingTag class="text-2xl leading-normal font-bold text-[#e6bf4e]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
