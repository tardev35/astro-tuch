---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what this drop's brief actually names (src/assets/content.txt, vocabulary
// listed in brand-spec §5). This brand is **สล็อตออนไลน์เบทต่ำ** and nothing
// else — the brief names no second game category at all. The previous holders of
// this file were multi-category and sports brands; their chips — เกมยิงปลา,
// ไฮโล, หวยออนไลน์, ตรวจสอบอัตราจ่าย, เดิมพันฟุตบอล, เกมคาสิโน, เกมไพ่ —
// are all on §5's banned list and are gone rather than re-typed. No game studio,
// no bank and no wallet is named as a provider: **this brief names none**, and an
// invented ค่ายเกม on a gambling page is a real claim. The only figures here are
// the brief's own (0.3% · 0.8% · 24ชม.).
// The module picks one chip per row through data-winners-markets /
// data-winner-market.
const marketPool = [
  "เข้าเล่นเกมสล็อตออนไลน์",
  "เกมสล็อตคลาสสิก",
  "เกมที่มีฟีเจอร์โบนัส",
  "ปรับระดับการเดิมพัน",
  "สมัครสมาชิก",
  "เข้าสู่ระบบ",
  "ยืนยันบัญชี",
  "ฝากถอน",
  "รับโปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "รอบสรุปยอด",
  "ติดต่อแอดมิน",
  "บริการ 24ชม.",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it tells users
// to เตรียมหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ when a
// transaction stalls, so the two states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#fdcb0c]/70 text-[#fdcb0c]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#eafaff]";
const BIG_AMOUNT_CLASS = "text-[#fefb6b]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The 🧾 is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// สบาย168 (ดรอป 2026-10-22, .claude/brand-spec-sabai168.md §2): รอบนี้เป็น
// **ฟ้าสกายนำ · ทองคานารีรอง · ธีมสว่าง**
// ⚠️⚠️ **พื้นเพจรอบนี้เป็นฟ้าพาสเทลสว่าง #ccf7ff (bg.json) ไม่ใช่ดำสนิทอย่างรอบก่อน**
// แต่ฟีดฝากถอนเป็น **"โครม" เหมือนแถบประกาศกับเมนู ไม่ใช่การ์ดเนื้อหา** ตามที่ §2
// จัดกลุ่มไว้ แผงนี้จึงเป็น **ผิวน้ำเงินมหาสมุทรลึกขอบทอง ตัวอักษรฟ้าขาว** คร่อม
// อยู่เหนือตัวหน้าที่สว่าง — **ห้าม "แก้" ให้แผงนี้สว่างตามพื้นเพจ** หัว-ท้าย-ticker-
// ฟีดที่เข้มคือสมอที่คร่อมเนื้อหาสว่างเอาไว้ ซึ่งเป็นทิศของธีมทั้งรอบ ไม่ใช่ความ
// ไม่สม่ำเสมอ · แผงนี้ตั้งสีตัวอักษรเองทั้งใบ จึงไม่ inherit BRAND_TEXT #0f3a4a
// (ซึ่งเป็นหมึกเข้มสำหรับการ์ดสว่าง และอ่านไม่ออกบนผิวโครม)
// ลำดับผิวโครม: **#04293d จม (ตัวแผง) · #063a57 กลาง (เม็ดยา) · #0a4f74 ยก (ขอบ)**
// เม็ดยาแต่ละเม็ดอยู่ในกรอบเส้นไรผม #0a4f74 ที่สว่างขึ้นเป็นฟ้าสกาย #2cc3fc ตอน hover
// ชิปหมวดบริการเป็นเส้นฟ้าสกาย #2cc3fc กับตัวอักษรฟ้าหมอก #a9e3f9 (8.6:1 บน #063a57)
// ⚠️ ฟ้าสกายอยู่ที่ **เส้นขอบ ไม่ใช่ตัวอักษรขนาดเล็ก** — §2 ให้ #2cc3fc ถือตัวอักษร
// บนโครมได้ที่ 5.9:1 แต่ชิปนี้เป็น text-[10px] จึงเลือกค่าที่สูงกว่าไว้ก่อน
// ยอดเงินเริ่มที่หมึกบนโครม #eafaff (11.4:1) แล้วกระโดดไปทองซีด #fefb6b (11.0:1)
// เมื่อเกิน data-big-win-above ซึ่งเป็น **การสลับฮิว ฟ้าขาว→ทอง ไม่ใช่สลับน้ำหนัก
// ภายในฮิวเดียว** และตรงกับโลโก้จริงที่เป็น **"สบาย" ทองคานารี + "168" ฟ้าสกาย**
// ชื่อผู้ทำรายการเป็น #eafaff · หัวแถบเป็น #eafaff โดยมีชื่อแบรนด์เป็นทองคานารี
// #fdcb0c (7.8:1 บน #063a57 และสูงกว่านั้นบน #04293d) — **ตัวอักษรทึบสองค่า
// ไม่ใช่ bg-clip-text ไล่เฉด** เพราะการไล่เฉดจากทองไปฟ้าใน sRGB จะพาดผ่านโทนเขียว
// ซึ่งรอบนี้ไม่มีเขียวเป็นสีแบรนด์เลย
// ไอคอน 🧾 สื่อถึง "รายการฝากถอน" ตรงตามหน้าที่ของแผง — รอบเก่ากว่าของไฟล์นี้ใช้ 🎰
// ซึ่ง §1 รอบนี้ระบุว่า **ตู้สล็อต 777 ไม่มีอยู่ในอาร์ตเวิร์กและห้ามใช้เป็นไอคอน**
// (ฉากรอบนี้เป็นฟาร์ม/โรงเรือนปลูกผักกลางวัน ไม่ใช่สนามบอลกลางคืนอย่างรอบก่อน)
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีเชิงความหมาย และสีโลโก้ธนาคารทั้งสี่
// เป็นสีจริงของธนาคาร **ทั้งสองชุดไม่ถูกรีแมปทุกรอบ**
//
// ⚠️ เทียบเป็นค่า ไม่ใช่ตระกูลสี — **ทองมีมาแล้วเกือบทุกแบรนด์ในรีโปนี้ และฟ้าก็ผ่าน
// มาแล้วหลายเจ้า** ชุดทองจักรพรรดิ-แดงชาดของ **รวยเทพ168** ที่เพิ่งค้างอยู่ทั้งไฟล์นี้
// (f0bb4e ffeccb e4021b d9701a 3b1b0e 260d04 0d0501 5c2a06 fff8ec 2b1400 กับ rgba
// 240/187/78) ออกครบทุกจุดแล้ว เช่นเดียวกับชุดฟ้าอะซัวร์-ทองอำพันของ **รวยแทร่168**
// (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d) ชุดทองไทย-
// แดงมังกรของ **รับตัง168** (f0b429 ffdc8c 9a6c0c cfd9e6 f5ece0 140505 200a09 d30304
// 4a0202 1a0505) ชุดทองแชมเปี้ยน-เงินโครเมียมของ **UFA324** (e5a81b ffe08a f0e8d4
// b9c2cc 17130a 43300a 0d0b06 7d5a07 464f5a) ชุดของ **สมหวัง168** (fa0513 ffadaf
// ff5a5f e3b23c ffe5a8 8a6210 f4ecea ccb9b6 2c1413 1f0d0c 140706 290f0f) ชุดแดง
// คริมสัน-ทองโบราณของ **รวยแท้168** (c30303 8f0505 e81313 dcb95f b8862b 96681f
// 4a0f0f 461212 280b0b ffeee8 fff1ef ffdbdb c99a3f) และชุดทองคานารี-โครเมียมเงิน
// บนดำสนิทของ **ยูฟ้า168 (แบรนด์ขาออก — ความเสี่ยงสูงสุด)** (fee45d e6a416 b8780d
// 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f 1e1a13 0a0908 eae3d4 140e02 0b0d10)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ ฟ้ารอบนี้คือ **#2cc3fc (R44 G195 B252)** ⚠️ **ตัวที่ใกล้ที่สุดในรีโปคือ 32bcfb
// ของนินจา168 (ห่าง 6 ที่ R)** และไม่ใช่ 2f9ff5 a8dcff d6ecff 0b3f78 ของ
// **สบายเบท168 ซึ่งเป็นคนละลูกค้าที่ชื่อใกล้ที่สุด** ไม่ใช่ 039cfa 0494f5 c3ebfc
// (รวยแทร่168) — "มีฟ้าอยู่แล้ว" ไม่พิสูจน์อะไรเลย
// ⚠️ ทองรอบนี้คือ **#fdcb0c (R253 G203 B12)** กับทองซีด **#fefb6b** ไม่ใช่ fee45d
// e6a416 ของรอบขาออก ไม่ใช่ ffc82e ของสบายเบท168 ไม่ใช่ fef54b ของนินจา168
// (⚠️ ใกล้ #fefb6b มาก G245/B75 vs G251/B107) ไม่ใช่ f0bb4e f0b429 f9a826 e5a81b
// fcd434 หรือ e3b23c
// ⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง ไม่มีส้ม ไม่มีทองแดงไหม้
// ไม่มีโรสโกลด์ และไม่มีเงิน/โครเมียม** (0ea5e9 กับ 1155cc 4e1c80 fcd34d ด้านบน
// เป็นสีจริงของโลโก้ธนาคาร **ห้ามแตะ**) เขียวมีได้ตัวเดียวคือ #4ade80 ของสถานะ
// ซึ่งไม่ใช่สีแบรนด์
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#fdcb0c]/45 bg-[#04293d]/95 px-4 py-8 shadow-[0_15px_40px_rgba(6,58,87,0.3)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">🧾</span>
      <p class="text-xl font-black text-[#eafaff] md:text-2xl">
        <span class="text-[#fdcb0c]">{BRAND_NAME}</span> รายการฝากถอนล่าสุดของสมาชิก
      </p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#0a4f74] bg-[#063a57] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(44,195,252,0.16)] hover:border-[#2cc3fc]">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#eafaff]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#2cc3fc]/70 px-2 py-0.5 text-[10px] font-bold text-[#a9e3f9]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
