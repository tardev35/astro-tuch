---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what this drop's brief actually names (src/assets/content.txt, listed in
// brand-spec §7). This brand is a เว็บเล่นเกมกีฬาออนไลน์ — ฟุตบอล + มวย + เกม
// คาสิโน (เกมไพ่ เกมโต๊ะ สล็อต) — NOT a slot-only site and NOT a lottery site, so
// every chip below is one of the brief's own phrases. The previous holders of
// this file were slot-only and multi-category brands; their chips —
// เว็บตรงฐานสล็อตหลัก, ไม่ผ่านเอเย่นต์, ไม่ผ่านม้า, สล็อตคลาสสิก, เกมฟรีสปิน,
// โบนัสตัวคูณ, เล่นสล็อตออโต้, เบทต่ำ, บาคาร่า, รูเล็ต, โต๊ะ, ตลาดเดิมพัน — are all
// on §7's banned list and are gone rather than re-typed. There is no หวย anywhere
// on this site this round. No game studio, no league, no team, no fighter and no
// bank is named as a game provider: the brief names none, and an invented ค่ายเกม
// or ลีก on a gambling page is a real claim. The module picks one chip per row
// through data-winners-markets / data-winner-market.
const marketPool = [
  "เดิมพันฟุตบอล",
  "เดิมพันมวย",
  "เกมคาสิโน",
  "เกมไพ่",
  "เกมโต๊ะ",
  "สล็อตจากค่ายต่างๆ",
  "อัตราต่อรอง",
  "ประเภทการเดิมพัน",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ฝากถอนไม่มีขั้นต่ำ",
  "แอดมิน 24 ชั่วโมง",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it tells
// members to ตรวจสอบ...สถานะรายการ before confirming a transaction, so the two
// states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#bb8410]/80 text-[#e5a81b]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#f0e8d4]";
const BIG_AMOUNT_CLASS = "text-[#ffe08a]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The ⚽ is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// รอบนี้ (2026-10-11, brand-spec §2): พาเลตต์ทองแชมเปี้ยน-เงินโครเมียมบนพื้น
// **ดำสนิท #000000** ฟีดฝากถอนเป็น "โครม" เหมือนแถบประกาศกับเมนู จึงอยู่ที่ผิวจม
// #0d0b06 ซึ่งลึกกว่าการ์ดเนื้อหาทุกใบ ⚠️ แต่ยังสว่างกว่าพื้นเพจ — รอบนี้ไม่มีชั้น
// ไหนจมต่ำกว่าพื้นได้ แผงนี้ทำหน้าที่เป็นสะพานระหว่างแถบประกาศด้านบนกับการ์ดเนื้อหา
// ผิวยกด้านล่าง ตัวมันตั้งสีตัวอักษรเองทั้งแผง จึงไม่ inherit BRAND_TEXT ผ่าน <html>
// เม็ดยาแต่ละเม็ดเป็นพื้นผิวกลาง #17130a ในกรอบเส้นไรผมทองดำ #43300a ที่สว่างขึ้นเป็น
// ทองแบรนด์ #e5a81b ตอน hover ชิปหมวดเดิมพันเป็นเส้นทองแบรนด์ตัวอักษรเงินแบรนด์
// #b9c2cc ซึ่งอ้างถึงเลข 324 เงินโครเมียมในโลโก้
// ยอดเงินเริ่มที่งาช้าง #f0e8d4 แล้วกระโดดไปทองสว่าง #ffe08a เมื่อเกิน
// data-big-win-above ซึ่งเป็นการสลับน้ำหนักภายในฮิวทองของแบรนด์
// ชื่อผู้ทำรายการเป็นงาช้าง #f0e8d4 หัวแถบไล่ทองสว่าง #ffe08a → ทองแบรนด์ #e5a81b
// ตามถ้วยแชมป์ทองกับลูกฟุตบอลทองบนโลโก้ ไอคอน ⚽ มาจากลูกฟุตบอลทองกลางเหรียญ
// (รอบก่อนใช้ ⚡ ซึ่งเป็นสายฟ้าของแบรนด์อื่น ไม่เกี่ยวกับแบรนด์กีฬารอบนี้)
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีของสถานะ และสีโลโก้ธนาคารทั้งสี่เป็นสี
// จริงของธนาคาร จึงไม่ถูกรีแมปทั้งคู่ · ทองลึก #7d5a07 ทองดำ #43300a และเงินลึก
// #464f5a ไม่ถือตัวอักษรที่ไหนในไฟล์นี้ตาม §2
//
// ⚠️ เจ็ดในสิบแบรนด์หลังสุดมีทอง ให้เทียบเป็นค่า ไม่ใช่ตระกูลสี: ชุดทองสายฟ้า-แดง
// เลือดนกที่เคยค้างในไฟล์นี้ (#f5c518 #ffdd73 #b8860f #ff3b14 #8c0f0a #6d0804
// #5c0000 #430000 #fdf0e2 #f8d2bb rgba(245,197,24,α)) ชุดชมพูฮอต-ทองบนพลัมดำของ
// แบรนด์รอบก่อนหน้าทันที (#ff3fa4 #ff6cbb #ffd1ea #e8b9d4 #fde8f3 #f5c53d #b3006a
// #4d002b #4a0b42 #3a0534 #2e002c #210220) ชุดทองเป็ด-ส้มอำพัน (#f3bb34 #fde464
// #c8901a #8a5f08 #5c3f04 #f58b2a #a3510c #1f1709 #171106 #0d0903 #f6ecd9) ชุดทอง
// อวกาศ-เงินโครเมียม (#fbc134 #ffe87a #cf9a18 #cfd6e3 #eef2f8 #9aa6bb #3f4859
// #4e3406 #382400 #241700) และชุดม่วงนีออน-ทอง (#a435f0 #5b1a75 #efe6ff #d2a6ff
// #ffd23d #c98a05 #1e0a3c) ออกครบทุกจุดแล้ว
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#e5a81b]/45 bg-[#0d0b06]/92 px-4 py-8 shadow-[0_15px_40px_rgba(229,168,27,0.2)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">⚽</span>
      <p class="bg-gradient-to-b from-[#ffe08a] to-[#e5a81b] bg-clip-text text-xl font-black text-transparent md:text-2xl">{BRAND_NAME} รายการฝากถอนล่าสุดของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#43300a] bg-[#17130a] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(229,168,27,0.16)] hover:border-[#e5a81b]/70">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#f0e8d4]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#e5a81b]/60 px-2 py-0.5 text-[10px] font-bold text-[#b9c2cc]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
