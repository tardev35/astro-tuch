---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what this drop's brief actually names (src/assets/content.txt, vocabulary
// listed in brand-spec §5). This brand is **เว็บสล็อตออนไลน์** and nothing else —
// the brief names no second game category at all. The previous holders of this
// file were multi-category, lottery and sports brands; their chips —
// เกมยิงปลา, ไฮโล, หวยออนไลน์, เดิมพันฟุตบอล, เกมคาสิโน, เกมไพ่ — are all on
// §5's banned list and are gone rather than re-typed. ⚠️ So are the OUTGOING
// brand เงินทอง168's own words: สล็อตคลาสสิก · เกมที่มีฟีเจอร์โบนัส ·
// อัตราจ่ายสูง · ค่ายมาตรฐานสากล — and สบาย168's ปรับระดับการเดิมพัน. No game
// studio, no bank and no wallet is named as a provider: **this brief names
// none**, and an invented ค่ายเกม on a gambling page is a real claim. The only
// figures here are the brief's own (0.3% · 0.8% · 24ชม.).
// The module picks one chip per row through data-winners-markets /
// data-winner-market.
const marketPool = [
  "เข้าเล่นเกมสล็อตออนไลน์",
  "ระดับการเดิมพัน",
  "เดิมพันไม่มีขั้นต่ำ",
  "สมัครสมาชิก",
  "เข้าสู่ระบบ",
  "ยืนยันบัญชี",
  "ฝากถอน",
  "รับโปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "รอบสรุปยอด",
  "รอบจ่ายเครดิต",
  "ติดต่อแอดมิน",
  "บริการ 24ชม.",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it tells users
// to เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ when a
// transaction stalls, so the two states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#adc0e4]/70 text-[#adc0e4]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#e9f1ff]";
const BIG_AMOUNT_CLASS = "text-[#18a5e2]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The 🧾 is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// ───────────────────────────────────────────────────────────────────────────
// ร่ำรวย168 (ดรอป 2026-10-23, .claude/brand-spec-ruaythear168club.md §2): รอบนี้เป็น
// **ฟ้าไซยานนำ · ครีมอุ่นรอง · ธีมสว่าง**
// ⚠️⚠️ **พื้นเพจรอบนี้เป็นฟ้าเพอริวิงเคิลสว่าง #dbe6ff (bg.json) ไม่ใช่น้ำตาลโอลีฟ
// เข้มอย่างรอบก่อน** แต่ฟีดฝากถอนเป็น **"โครม" เหมือนแถบประกาศกับเมนู ไม่ใช่การ์ด
// เนื้อหา** ตามที่ §2 จัดกลุ่มไว้ แผงนี้จึงเป็น **ผิวน้ำเงินอินดิโกเข้มขอบฟ้าไซยาน
// ตัวอักษรขาวฟ้า** คร่อมอยู่ใต้ตัวหน้าที่สว่าง — **ห้าม "แก้" ให้แผงนี้สว่างตาม
// พื้นเพจ** หัว-ท้าย-ticker-ฟีด-แผงรีวิวที่เข้มคือสมอที่คร่อมเนื้อหาสว่างเอาไว้
// ซึ่งเป็นทิศของธีมทั้งรอบ ไม่ใช่ความไม่สม่ำเสมอ · แผงนี้ตั้งสีตัวอักษรเองทั้งใบ
// จึงไม่ inherit BRAND_TEXT #16294a (ซึ่งเป็นหมึกเข้มสำหรับการ์ดสว่าง และอ่านไม่ออก
// บนผิวโครม)
// ลำดับผิวโครม: **#111a3f จม (ตัวแผง) · #202a66 กลาง (เม็ดยา) · #31408a ยก (ขอบ)**
// เม็ดยาแต่ละเม็ดอยู่ในกรอบเส้นไรผม #31408a ที่สว่างขึ้นเป็นฟ้าไซยาน #18a5e2 ตอน hover
// ชิปหมวดบริการเป็นเส้นฟ้าไซยาน #18a5e2 กับตัวอักษรฟ้าหมอก #adc0e4 (6.4:1 บน #202a66)
// ⚠️ ฟ้าไซยานอยู่ที่ **เส้นขอบ ไม่ใช่ตัวอักษรขนาดเล็ก** — §2 ให้ #18a5e2 ถือตัวอักษร
// บนโครมได้ (6.1:1 บน #111a3f · 4.7:1 บน #202a66) แต่ชิปนี้เป็น text-[10px]
// จึงเลือกค่าที่สูงกว่าไว้ก่อน
// ยอดเงินเริ่มที่หมึกบนโครม #e9f1ff (11.0:1 บนเม็ดยา) แล้วกระโดดไปฟ้าไซยาน #18a5e2
// เมื่อเกิน data-big-win-above ซึ่งเป็น **การสลับฮิว ขาวฟ้า → ฟ้าไซยาน ไม่ใช่สลับ
// น้ำหนักภายในฮิวเดียว** และตรงกับโลโก้จริงที่เป็น **"ร่ำรวย" ฟ้าไซยาน + "168"
// โครเมียมเงิน** ⚠️ **ห้ามเอาแรมป์เทาเงินของโครเมียมเข้ามาเป็นสี UI** — §2 ระบุว่า
// แรมป์เทาเงินเป็นของพักยก168/ยูฟ้า168 ไปแล้ว
// ชื่อผู้ทำรายการเป็น #e9f1ff · หัวแถบเป็น #e9f1ff โดยมีชื่อแบรนด์เป็นฟ้าไซยาน
// #18a5e2 (6.1:1 บน #111a3f) — **ตัวอักษรทึบสองค่า ไม่ใช่ bg-clip-text ไล่เฉด**
// ไอคอน 🧾 สื่อถึง "รายการฝากถอน" ตรงตามหน้าที่ของแผงและตรงกับคำของบรีฟ
// (หมายเลขรายการ · หลักฐาน · ธุรกรรม) — รอบเก่ากว่าของไฟล์นี้ใช้ 🎰 ซึ่ง §1 รอบนี้
// ระบุว่า **ตู้สล็อต 777 ไม่มีอยู่ในอาร์ตเวิร์กและห้ามใช้เป็นไอคอน** (ฉากรอบนี้เป็น
// ห้องนั่งเล่นหรูโทนครีม-งาช้าง สัญลักษณ์ประจำแบรนด์คือ **ตะกร้าเหรียญทอง** ตัวเดียว)
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีเชิงความหมาย และสีโลโก้ธนาคารทั้งสี่
// เป็นสีจริงของธนาคาร **ทั้งสองชุดไม่ถูกรีแมปทุกรอบ**
//
// ⚠️ เทียบเป็นค่า ไม่ใช่ตระกูลสี — **ฟ้า/ไซยานนำมาแล้วห้าแบรนด์ในรีโปนี้**
// ฟ้ารอบนี้คือ **#18a5e2 (R24 G165 B226)** ⚠️ ค่า vivid ดิบของ logo.webp รอบนี้คือ
// 6bddfb ซึ่งห่าง **6bdcfb ของ สบาย168 แค่ 1 หน่วย** — รอบนี้จึงไม่ใช้ค่าดิบ
// ชุดฟ้าสกาย-ทองคานารีของ **สบาย168** ที่เพิ่งค้างอยู่ทั้งไฟล์นี้ (2cc3fc 6bdcfb
// 0a7fbd 063a57 04293d 0a4f74 9ae0fa eafaff a9e3f9 fdcb0c fefb6b 0f3a4a 06293c
// กับ rgba 44/195/252 และ rgba 6/58/87) ออกครบทุกจุดแล้ว เช่นเดียวกับชุดของแบรนด์
// ขาออก **เงินทอง168** (f5ba14 fcee52 b37c0b ecd5c4 d2b9a4 29210f 3d3016 332810
// 201906 2e2512 1b1407 4d3c15) **รวยแทร่168** (039cfa 0494f5 c3ebfc 04366b f9a826
// 704504 e3f2fc 0b2d52) **นินจา168** (32bcfb a9e9ff fef54b 6b5c10 07335f 0c2a3d)
// **สบายเบท168** (2f9ff5 a8dcff d6ecff 0b3f78 e8f4ff ffc82e) **TSDET911** (0360f3
// 0292fb 6ec8ff 4fb4ff cfdcec 9db4d4 dde8f7 102a5e) **รับตัง168** (f0b429 ffdc8c
// 9a6c0c cfd9e6 d30304 4a0202) **UFA324** (e5a81b ffe08a f0e8d4 b9c2cc 7d5a07
// 464f5a) **สมหวัง168** (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210) **รวยแท้168**
// (c30303 8f0505 e81313 dcb95f b8862b 96681f 4a0f0f ffeee8 fff1ef ffdbdb) และ
// **ยูฟ้า168** (fee45d e6a416 b8780d 7a4e05 e8ecf1 a8b2bf 78828f 5a6472 15130f
// 1e1a13 0a0908 eae3d4 140e02 0b0d10)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีทอง/เหลืองเป็นสี UI ไม่มีแดง ไม่มีชมพู/มาเจนตา ไม่มีม่วง
// ไม่มีส้ม ไม่มีทองแดงไหม้ ไม่มีโรสโกลด์ และไม่มีแรมป์เทาเงิน** (0ea5e9 กับ
// 1155cc 4e1c80 fcd34d ด้านบนเป็นสีจริงของโลโก้ธนาคาร **ห้ามแตะ**) เขียวมีได้
// ตัวเดียวคือ #4ade80 ของสถานะ ซึ่งไม่ใช่สีแบรนด์
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#18a5e2]/45 bg-[#111a3f]/95 px-4 py-8 shadow-[0_15px_40px_rgba(17,26,63,0.3)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">🧾</span>
      <p class="text-xl font-black text-[#e9f1ff] md:text-2xl">
        <span class="text-[#18a5e2]">{BRAND_NAME}</span> รายการฝากถอนล่าสุดของสมาชิก
      </p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#31408a] bg-[#202a66] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(24,165,226,0.16)] hover:border-[#18a5e2]">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#e9f1ff]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#18a5e2]/70 px-2 py-0.5 text-[10px] font-bold text-[#adc0e4]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
