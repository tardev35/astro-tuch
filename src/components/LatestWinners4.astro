---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what the brief actually names. HI59 is a สล็อตไฮคลาส brand, so every chip
// below is one of the brief's own words: เกมสล็อต, ค่ายเกมพรีเมียม, เกมเปิดใหม่,
// ฟรีสปิน, ตัวคูณ, ฟีเจอร์โบนัส, plus the two promotions it runs (คืนยอดเสีย 0.3%,
// แนะนำเพื่อน 0.8%) and the ฝากถอน rail itself. The lottery markets the previous
// holder of this file shipped (รัฐบาลไทย, หวยลาว, หวยฮานอย, หวยออมสิน, ธ.ก.ส.,
// เลขเด็ด, อัตราจ่าย) are gone rather than re-typed, because this brand runs no
// lottery at all — brand-spec §7 bans that whole vocabulary. No game studio is
// named: the brief names none, and an invented ค่ายเกม on a gambling page is a
// real claim. The module picks one chip per row through data-winners-markets /
// data-winner-market.
const marketPool = ["เกมสล็อต", "ค่ายเกมพรีเมียม", "เกมเปิดใหม่", "ฟรีสปิน", "ตัวคูณ", "ฟีเจอร์โบนัส", "โบนัสคืนยอดเสีย 0.3%", "โบนัสแนะนำเพื่อน 0.8%", "ฝากถอน"];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brand's: the brief's own
// phrase for a transaction still being checked is "รายการฝากถอนอยู่ระหว่าง
// ตรวจสอบ", so the two states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#c88a02]/70 text-[#ffe27a]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#5ec2ff]";
const BIG_AMOUNT_CLASS = "text-[#fdbc04]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The 🎰 is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// HI59 (รอบฟ้า-ทอง 2026-10-07, brand-spec §2): รอบนี้ทั้งเว็บเป็นการ์ดสว่าง แต่ฟีด
// ถอนเงินเป็น "โครม" เหมือนแถบประกาศกับเมนู จึงอยู่ฝั่งผิวกรมท่าเข้ม #04203f ไม่ใช่
// ฝั่งการ์ดสว่าง ตัวมันตั้งสีตัวอักษรเองทั้งแผง จึงไม่ inherit BRAND_TEXT และแถบนี้
// ทำหน้าที่เป็นสะพานสีระหว่าง Announcement2 (กรมท่า) ด้านบนกับการ์ดเนื้อหาสว่างด้านล่าง
// เม็ดยาแต่ละเม็ดเป็นพื้นลึกสุด #02162c ในกรอบผิวยก #073059 ที่สว่างขึ้นเป็นฟ้าแบรนด์
// #0a84e0 ตอน hover ชิปหมวดเกมเป็นเส้นฟ้าแบรนด์ตัวอักษรฟ้าเรือง #5ec2ff
// ยอดเงินเริ่มที่ฟ้าเรืองแล้วกระโดดไปทองแบรนด์ #fdbc04 เมื่อเกิน data-big-win-above
// ซึ่งเป็นการสลับ "ฮิว" ตามคู่สีของโลโก้ (ตัวอักษร HI ฟ้า กับตัวเลข 59 ทอง) ไม่ใช่แค่
// เปลี่ยนความสว่างของสีเดียว ชื่อผู้ถอนเป็นหมึกบนโครม #e4f1fd (13.8:1 บนผิวแผง)
// หัวแถบไล่ทองอ่อน #ffe27a → ฟ้าเรือง #5ec2ff ตามเวิร์ดมาร์กทอง-ฟ้าบนแบนเนอร์
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีของสถานะ และสีโลโก้ธนาคารทั้งสี่เป็น
// สีจริงของธนาคาร จึงไม่ถูกรีแมปทั้งคู่
//
// ชุดเขียวมรกต-แดงสด-ทองของ DM899 ที่เคยค้างในไฟล์นี้ (#0a1a0e #030a05 #01a326
// #0a4a18 #12c23a #4ade6b #ffe9a8 #f2b422 #fb252b #8f0609 #a8780f #e4f2e4)
// ออกครบทุกจุดแล้ว
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#0a84e0]/45 bg-[#04203f]/92 px-4 py-8 shadow-[0_15px_40px_rgba(6,53,95,0.30)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">🎰</span>
      <p class="bg-gradient-to-b from-[#ffe27a] to-[#5ec2ff] bg-clip-text text-xl font-black text-transparent md:text-2xl">{BRAND_NAME} รายการถอนล่าสุดของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#073059] bg-[#02162c] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(10,132,224,0.22)] hover:border-[#0a84e0]/70">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#e4f1fd]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#0a84e0]/60 px-2 py-0.5 text-[10px] font-bold text-[#5ec2ff]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
