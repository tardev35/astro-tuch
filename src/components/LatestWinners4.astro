---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette. `name` below is
// never rendered: src/lib/winnersFeed.ts only reads `color` and `icon`, so the
// badges are decorative avatars (alt="" inside an aria-hidden wrapper) and no
// payment provider is NAMED anywhere in this component's text. That matters
// this round — see below.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// คลังคำของชิปหมวดบริการมาจากบรีฟรอบนี้เท่านั้น (src/assets/content.txt +
// .claude/brand-spec-win8s.md §5)
// 🚨 **บรีฟรอบนี้ระบุสามหมวดเกมเท่านั้น: บาคาร่าออนไลน์ · คาสิโนสด · สล็อต**
// รอบก่อนมีเจ็ดหมวด — **ห้ามสืบทอดลิสต์ข้ามรอบ** คำว่า ไฮโล · รูเล็ต · ยิงปลา ·
// เดิมพันฟุตบอล/บอล · หวย/หวยออนไลน์ ไม่มีในบรีฟนี้เลยสักคำ จึงไม่มีในไฟล์นี้
// 🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** —
// คำว่า ฝากถอน / ออโต้ / ทรูวอลเลท / ทรูมันนี่ / ทุกธนาคาร / ไม่มีขั้นต่ำ
// ไม่ปรากฏในไฟล์นี้ และไม่มีค่ายเกม ธนาคาร หรือวอลเล็ตไหนถูกเอ่ยชื่อเป็นผู้ให้บริการ
// (การแต่งชื่อขึ้นมาบนหน้าพนันคือการกล่าวอ้างจริง และบรีฟไม่ได้ระบุสักราย)
// ❌ คำของแบรนด์ก่อน ๆ ที่ห้ามกลับเข้ามา: เว็บตรง · ถูกลิขสิทธิ์ · เซิร์ฟแท้ ·
// ปลอดภัยในไทย · ครบทุกค่าย · อัปเดตใหม่ตลอดสัปดาห์ (แบรนด์ขาออก) · ฟรีสปิน ·
// ค่า RTP · เกมโบนัส · ยูสใหม่แตกไว · เบทต่ำ · ไม่ทำเทิร์น · แตกง่าย
// ตัวเลขในข้อความที่นี่มีแค่ของบรีฟเอง (0.3% · 0.8% · 24ชม.)
// The module picks one chip per row through data-winners-markets /
// data-winner-market.
const marketPool = [
  "บาคาร่าออนไลน์",
  "คาสิโนสด",
  "สล็อต",
  "เกมเดิมพันสด",
  "ทางเข้าเล่น",
  "กติกาบาคาร่าสด",
  "อัตราจ่าย",
  "สมัครสมาชิก",
  "เข้าสู่ระบบ",
  "ยืนยันบัญชี",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "โบนัสไม่อั้น",
  "รอบสรุปยอด",
  "รอบจ่ายเครดิต",
  "ติดต่อแอดมิน",
  "บริการ 24ชม.",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it tells users
// to เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ when something
// stalls (content.txt บรรทัด 22) → สองสถานะจึงเป็น อยู่ระหว่างตรวจสอบ /
// ทำรายการสำเร็จ **ไม่ใช่ "ฝากถอนสำเร็จ" ของรอบก่อน ๆ**
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ทำรายการสำเร็จ";
const PENDING_CLASS = "border-[#e0bda4]/60 text-[#e0bda4]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#fdf0e6]";
const BIG_AMOUNT_CLASS = "text-[#e5a92b]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`slip-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`slip-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`slip-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`slip-a-${i}`, 26))}${LETTERS.charAt(pick(`slip-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`slip-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — this panel is
// chrome and **never emits a heading tag at any level**; ห้ามอัปเป็น h2/h3 เพื่อ
// "ตั้งชื่อให้ section" เพราะจะทำให้การนับหัวข้อเทียบบรีฟของทุกรอบถัดไปพัง
// ไม่มี HTML comment สักตัวในส่วนที่ render (Astro ship ลง dist ตรง ๆ) ·
// ไม่มี href="#" / onclick= / define:vars · ชื่อแบรนด์ interpolate จาก BRAND_NAME
//
// ── รูปทรงรอบนี้ (เปลี่ยนโครง ไม่ใช่แค่เปลี่ยนสี) ──────────────────────────
// เดิม: เม็ดยา rounded-full บรรทัดเดียว ลอยเป็นก้อนเมฆ flex-wrap กลางแผง
//       แทรกแถวใหม่แบบ scatter
// รอบนี้: **กริดสลิปสองคอลัมน์** แต่ละใบเป็นการ์ดสี่เหลี่ยมมุมมน มีแถบไล่เฉดส้ม
//       คาดขอบซ้าย ข้อมูลแบ่งเป็นสองบรรทัด (บน: อวาตาร์ + ชื่อผู้ทำรายการ + ยอด /
//       ล่าง: ชิปหมวด + ชิปสถานะ คั่นด้วยเส้นไรผม) และแทรกแถวใหม่จากด้านบน
//
// ── พาเลตของแบรนด์รอบนี้ (.claude/brand-spec-win8s.md §2) ──────────────────
// 🚨 **รอบนี้มืดทั้งเว็บ** bg.json = {"mode":"color","color":"#1e0101"} แผงนี้เป็น
// "โครม" เหมือน navbar/footer/ticker จึงนั่งบนผิวโครม **#250604 (ฐาน)** มีแถว
// เป็นชั้นยก **#3b130b** เส้นไรผม **#5a2410** และขอบตกแต่ง/ออรา **#8a3a12**
// 🚨 **#5a2410 กับ #8a3a12 เป็นเส้น/ออรา/พื้นถมเท่านั้น ห้ามถือตัวอักษร** — ในไฟล์นี้
// ทั้งสองค่าอยู่ที่ border / blur aura / เส้นคั่น ไม่มีจุดไหนเป็น glyph เลย
// ตัวอักษร: หมึกหลัก **#fdf0e6** · หมึกรอง **#e0bda4** · ส้มเพลิง **#f27a1a**
// (ชื่อแบรนด์ + ขอบตอน hover) · ทองอำพัน **#e5a92b** (ยอดใหญ่ + ป้าย 24ชม.)
// ยอดเริ่มที่หมึกครีม #fdf0e6 แล้วกระโดดไปทองอำพัน #e5a92b เมื่อเกิน
// data-big-win-above = **การสลับฮิว ครีม → ทอง** ตรงกับอาร์ตเวิร์กที่เป็นทองคาดดำ
// ⚠️ เทียบเป็นค่าหกหลัก ไม่ใช่ตระกูลสี — ส้ม/ทอง/น้ำตาลเป็นฮิวนำของหลายแบรนด์ใน
// รีโปนี้มาแล้ว ค่าที่ไฟล์นี้เคยถือไว้ทั้งใบ (ผิวเอสเพรสโซ + แดงไฮไลต์ + ครีม
// fdeee2 e8c6ae f2a033 f2543f 2b100a 431a10 8c3a22) ออกครบทุกจุดแล้ว
// ✅ **เขียว #4ade80 ของสถานะ "ทำรายการสำเร็จ" เป็นสีเชิงความหมาย ไม่ใช่สีแบรนด์**
// รอบนี้แบรนด์เป็นส้ม-ทอง จึงไม่มีเหตุผลใดที่จะเปลี่ยนมันเป็นส้ม — และ **ห้าม
// สับสนกับเขียวป่าของ *FloatingBadge ซึ่งเป็นสีแบรนด์เก่าที่ต้องกวาดออก**
// สีโลโก้ธนาคารทั้งสี่ (1155cc 4e1c80 fcd34d 0ea5e9) เป็นสีจริงของโลโก้ **ห้ามแตะ**
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
---

<div class="mx-auto w-full max-w-[1100px] px-4 py-6 font-sans">
  <section
    aria-label={`รายการล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-2xl border border-[#5a2410] bg-[#250604] p-5 shadow-[0_18px_44px_rgba(20,3,2,0.55)] md:p-6">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-10 h-44 w-44 rounded-full bg-[#8a3a12]/30 blur-[70px]"></div>

    <div class="relative z-10 mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-[#5a2410] pb-4">
      <div class="flex items-center gap-2.5">
        <span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#f27a1a] shadow-[0_0_10px_rgba(242,122,26,0.85)]"></span>
        <p class="text-lg font-black tracking-wide text-[#fdf0e6] md:text-xl">
          <span class="text-[#f27a1a]">{BRAND_NAME}</span> รายการล่าสุดของสมาชิก
        </p>
      </div>
      <span class="rounded-md border border-[#8a3a12] bg-[#140302] px-2.5 py-1 text-[11px] font-bold tracking-wider text-[#e5a92b]"> บริการ 24ชม. </span>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="10"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-style="letters"
      data-user-digits="0"
      data-insert="prepend"
      data-big-win-above="70000"
      class="relative z-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-slip transition-all duration-500 ease-out">
            <div class="relative overflow-hidden rounded-xl border border-[#5a2410] bg-[#3b130b] py-3 pr-3 pl-4 transition-colors duration-300 hover:border-[#f27a1a]">
              <span aria-hidden="true" class="absolute top-0 left-0 h-full w-1 bg-gradient-to-b from-[#f0a21e] to-[#e8620e]" />

              <div class="flex items-center justify-between gap-3">
                <div class="flex min-w-0 items-center gap-2.5">
                  <div aria-hidden="true" data-winner-bank class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-md ${row.bank.color}`}>
                    <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
                  </div>
                  <span data-winner-user class="truncate text-sm font-bold tracking-wide text-[#fdf0e6]">
                    {row.user}
                  </span>
                </div>
                <div
                  data-winner-big
                  data-normal-class={AMOUNT_CLASS}
                  data-big-class={BIG_AMOUNT_CLASS}
                  class={`shrink-0 text-base font-black tabular-nums ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                  +<span data-winner-amount>{row.amount}</span> ฿
                </div>
              </div>

              <div class="mt-2.5 flex items-center justify-between gap-2 border-t border-[#5a2410] pt-2.5">
                <span data-winner-market class="truncate rounded-sm bg-[#250604] px-2 py-0.5 text-[10px] font-bold text-[#e0bda4]">
                  {row.market}
                </span>
                <span
                  data-winner-status
                  data-pending-text={PENDING_TEXT}
                  data-done-text={DONE_TEXT}
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`shrink-0 rounded-sm border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? PENDING_TEXT : DONE_TEXT}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-slip.is-entering {
    transform: translateY(-8px);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-slip {
      transition: none;
    }
  }
</style>
