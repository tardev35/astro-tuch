---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what this drop's brief actually names (src/assets/content.txt, listed in
// brand-spec §6). FLASH877 is a เว็บตรงฐานสล็อตหลัก and nothing else, so every
// chip below is one of the brief's own phrases. The previous holders of this
// file were WEPLAY168 (a สล็อตออโต้ site) and 789BETTING (a multi-category hub);
// their chips — เล่นสล็อตออโต้, เบทเริ่มต้น 1 บาท, เบทต่ำ, ไม่มีขั้นต่ำ, ค่ายหลัก,
// บาคาร่า, รูเล็ต, บอล, หวย, โต๊ะ, ตลาดเดิมพัน — are all on §6's banned list and
// are gone rather than re-typed. There is no หวย anywhere on this site this
// round. No game studio and no bank is named as a game provider: the brief names
// none, and an invented ค่ายเกม on a gambling page is a real claim. The module
// picks one chip per row through data-winners-markets / data-winner-market.
const marketPool = [
  "เว็บตรงฐานสล็อตหลัก",
  "ไม่ผ่านเอเย่นต์",
  "ไม่ผ่านม้า",
  "สล็อตคลาสสิก",
  "เกมฟรีสปิน",
  "โบนัสตัวคูณ",
  "เกมใหม่จากค่ายที่เปิดให้บริการ",
  "บัญชีเดียว",
  "ตรวจสอบเครดิต",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ฝากถอนเข้าบัญชีบริษัทโดยตรง",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it calls a
// transaction still being checked "รายการฝากถอนอยู่ระหว่างตรวจสอบ", so the two
// states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#b8860f]/80 text-[#f5c518]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#fdf0e2]";
const BIG_AMOUNT_CLASS = "text-[#ffdd73]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The ⚡ is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// FLASH877 (รอบทองสายฟ้า-แดงเลือดนก 2026-10-10, brand-spec §2): ฟีดฝากถอนเป็น
// "โครม" เหมือนแถบประกาศกับเมนู จึงอยู่ที่ผิวลึกสุด #430000 ซึ่งจมลงไปจากพื้นเพจแดง
// เลือดนก #5c0000 และลึกกว่าการ์ดเนื้อหาทุกใบ ทำหน้าที่เป็นสะพานระหว่าง Announcement5
// ด้านบนกับการ์ดเนื้อหาผิวยกด้านล่าง ตัวมันตั้งสีตัวอักษรเองทั้งแผง จึงไม่ inherit
// BRAND_TEXT ผ่าน <html>
// เม็ดยาแต่ละเม็ดเป็นพื้นผิวกลาง #6d0804 ในกรอบเส้นไรผมแดงเข้ม #8c0f0a ที่สว่างขึ้นเป็น
// ทองสายฟ้า #f5c518 ตอน hover ชิปหมวดเกมเป็นเส้นทองสายฟ้าตัวอักษรครีมอมส้ม #f8d2bb
// ยอดเงินเริ่มที่ครีม #fdf0e2 แล้วกระโดดไปทองสว่าง #ffdd73 เมื่อเกิน data-big-win-above
// ซึ่งเป็นการสลับน้ำหนักภายในฮิวทองของแบรนด์ — ไม่ใช้ #ff3b14 ตรงนี้เพราะยอดเงินเป็น
// text-sm ไม่ใช่ display ขนาดใหญ่ ซึ่ง §2 ห้ามไว้ (3.6:1 บนผิวการ์ด)
// ชื่อผู้ทำรายการเป็นครีม #fdf0e2 หัวแถบไล่ทองสว่าง #ffdd73 → ทองสายฟ้า #f5c518 ตาม
// คำว่า FLASH ที่เป็นทองสามมิติบนโลโก้ ไอคอน ⚡ มาจากสายฟ้าทองที่ผ่ากลางเหรียญ
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีของสถานะ และสีโลโก้ธนาคารทั้งสี่เป็นสีจริง
// ของธนาคาร จึงไม่ถูกรีแมปทั้งคู่
//
// ⚠️ แบรนด์รอบก่อน (SUPERSLOTCLUB) ก็แดง-ทองเหมือนกัน ให้เทียบเป็นค่า: ชุดม่วงนีออน-
// ทองอาร์เขตของ WEPLAY168 ที่เคยค้างในไฟล์นี้ (#a435f0 #5b1a75 #0a0117 #17062e #efe6ff
// #d2a6ff #ece2ff #ffd23d #c98a05 rgba(164,53,240,α)) ชุดทองเมทัลลิกของ 789BETTING
// (#fad354 #ffe79a #ddab33 #c9881f #8a6410 #4a3407 #0e0b05 #060402 #f3e7cd) และชุด
// แดงเสือโคร่ง-ทองถ่านไฟของ SUPERSLOTCLUB (#e8232a #7d0f12 #f2b705 #ffd666 #fbe8d5
// #3d1709 #241000) ออกครบทุกจุดแล้ว
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f5c518]/45 bg-[#430000]/92 px-4 py-8 shadow-[0_15px_40px_rgba(245,197,24,0.2)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">⚡</span>
      <p class="bg-gradient-to-b from-[#ffdd73] to-[#f5c518] bg-clip-text text-xl font-black text-transparent md:text-2xl">{BRAND_NAME} รายการฝากถอนล่าสุดของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#8c0f0a] bg-[#6d0804] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(245,197,24,0.16)] hover:border-[#f5c518]/70">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#fdf0e2]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#f5c518]/60 px-2 py-0.5 text-[10px] font-bold text-[#f8d2bb]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
