---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what the brief actually names. LOTTOPLUS is a เว็บหวยออนไลน์, and its
// brief lists exactly the lottery types it opens (รัฐบาลไทย, ลาวพัฒนา, ฮานอย,
// หวยหุ้น) plus two promotions (คืนยอดเสีย 0.3%, แนะนำเพื่อน 0.8%). So the chips
// are those, and the คาสิโนออนไลน์ / โปรโมชั่น list the previous holder of this
// variant shipped is gone — a casino word here would contradict every paragraph
// on the page above it. The module picks one per row through
// data-winners-markets / data-winner-market.
const marketPool = ["หวยรัฐบาลไทย", "หวยลาวพัฒนา", "หวยฮานอย", "หวยหุ้น", "โบนัสคืนยอดเสีย", "โบนัสแนะนำเพื่อน"];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in.
const PENDING_TEXT = "รอตรวจสอบ";
const DONE_TEXT = "ถอนสำเร็จ";
const PENDING_CLASS = "border-[#8a6a0a]/60 text-[#f3c623]";
const DONE_CLASS = "border-[#45d67a]/50 text-[#45d67a]";
const AMOUNT_CLASS = "text-[#f3c623]";
const BIG_AMOUNT_CLASS = "text-[#ff2d38]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag.
//
// LOTTOPLUS (รอบแดง-ทอง-ดำ 2026-09-29): เม็ดยาแต่ละเม็ดเป็นพื้นเพจ #050505 ใน
// กรอบผิวการ์ดยกแดงเข้ม #1f0a0c ที่สว่างขึ้นเป็นแดงแบรนด์ #dc020e ตอน hover ชิป
// ประเภทหวยเป็นแดงลึก #6b0207 ตัวอักษรทองรอง #f3c623 ยอดเงินเป็นทองรองและกระโดด
// ไปแดงสว่าง #ff2d38 เมื่อเกิน data-big-win-above ชื่อผู้ถอนเป็น BRAND_TEXT
// #f0e2e2 ส่วนกรอบนอกเป็นผิวการ์ด #120b0c ในเส้นแดงแบรนด์ และหัวแถบไล่ทองอ่อน
// #fde79a → แดงแบรนด์ ตามโลโก้ที่เป็นตัวอักษรขาวบนบล็อกแดงล้อมด้วยเหรียญทอง
// เขียว #45d67a ของสถานะ "ถอนสำเร็จ" เป็นสีของสถานะไม่ใช่สีแบรนด์ จึงไม่ถูกรีแมป
// — ชุดเขียวมรกต-โครเมียมของ BRAZIL999 ที่ค้างในไฟล์นี้ (#22c55e #b6ff9c #1c5a26
// #123a18 #0a1a0c #040a05 #aab4bf #dfeadd) ออกทั้งหมด
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#dc020e]/40 bg-[#120b0c]/90 px-4 py-8 shadow-[0_15px_40px_rgba(220,2,14,0.2)] backdrop-blur-md">
    <div class="mb-6 text-center">
      <p class="bg-gradient-to-b from-[#fde79a] to-[#dc020e] bg-clip-text text-xl font-black text-transparent md:text-2xl"><span aria-hidden="true">🎫</span> {BRAND_NAME} รายการถอนล่าสุดของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#1f0a0c] bg-[#050505] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(220,2,14,0.2)] hover:border-[#dc020e]/60">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#f0e2e2]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#6b0207]/70 px-2 py-0.5 text-[10px] font-bold text-[#f3c623]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div
                data-winner-big
                data-normal-class={AMOUNT_CLASS}
                data-big-class={BIG_AMOUNT_CLASS}
                class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
