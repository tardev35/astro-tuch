---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandPick, brandFlag } from "../lib/brandProfile";

// Real bank brand colours — never remapped to the site palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Only what this drop's brief actually names (src/assets/content.txt, listed in
// brand-spec §6). This brand is **เว็บเกมสล็อตเป็นแกน** and the brief itself
// names FOUR game categories — สล็อต · ยิงปลา · ไฮโล · หวยออนไลน์ — so those
// four words ARE allowed this round (the previous round banned them; this
// brief uses them, which is what decides it). It is still not a เว็บหวย.
// Every chip below is one of the brief's own phrases. The previous holders of
// this file were a sports brand and multi-category brands; their chips —
// เดิมพันฟุตบอล, เดิมพันมวย, เกมคาสิโน, เกมไพ่, เกมโต๊ะ, อัตราต่อรอง,
// ฝากถอนไม่มีขั้นต่ำ, ตรวจสอบเดิมพันขั้นต่ำ — are all on §6's banned list and are
// gone rather than re-typed. No game studio, no league and no bank is named as a
// game provider: **this brief names no studio at all**, and an invented ค่ายเกม
// on a gambling page is a real claim. The only figures here are the brief's own
// (0.3% · 0.8% · 24ชม.).
// The module picks one chip per row through data-winners-markets /
// data-winner-market.
const marketPool = [
  "เข้าเล่นเกมสล็อตออนไลน์",
  "เกมยิงปลา",
  "ไฮโล",
  "หวยออนไลน์",
  "สมัครสมาชิก",
  "เข้าสู่ระบบ",
  "ฝากถอน",
  "รับโปรโมชั่น",
  "คืนยอดเสีย 0.3%",
  "แนะนำเพื่อน 0.8%",
  "ตรวจสอบอัตราจ่าย",
  "รอบเวลารับเครดิต",
  "ติดต่อเจ้าหน้าที่",
  "บริการ 24ชม.",
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";

// brandPick / brandFlag, not Math.random: frontmatter runs at build time, so a
// random call here would make two builds of the same domain differ. No
// `new Date()` either.
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const flag = (salt: string) => brandFlag(Astro.site, salt);

// The status chip's two states are declared on the row itself
// (data-pending-text / data-done-text and the matching -class pairs), so the
// server-rendered state has to agree with one of them. `pending` below picks
// which one this row shipped in. The wording is this brief's own: it tells users
// to เตรียมข้อมูลและหลักฐานที่เกี่ยวข้องไว้สำหรับการตรวจสอบ when a transaction
// stalls, so the two states read อยู่ระหว่างตรวจสอบ / ฝากถอนสำเร็จ.
const PENDING_TEXT = "อยู่ระหว่างตรวจสอบ";
const DONE_TEXT = "ฝากถอนสำเร็จ";
const PENDING_CLASS = "border-[#d9701a]/80 text-[#f0bb4e]";
const DONE_CLASS = "border-[#4ade80]/55 text-[#4ade80]";
const AMOUNT_CLASS = "text-[#fff8ec]";
const BIG_AMOUNT_CLASS = "text-[#f0bb4e]";

const initialRows = Array.from({ length: 8 }, (_, i) => {
  const amount = 15000 + pick(`pill-amount-${i}`, 80001);
  return {
    bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
    market: marketPool[pick(`pill-market-${i}`, marketPool.length)],
    user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
    amount: amount.toLocaleString("en-US"),
    big: amount > 70000,
    pending: flag(`pill-pending-${i}`),
  };
});

// The rows are server-rendered; src/lib/winnersFeed.ts only takes over the
// rotation, reading its configuration from the data-* attributes below. No
// define:vars, no empty container filled by JS, no unguarded setInterval. The
// feed's title is a <p> and the <section> carries an aria-label — a withdrawal
// feed is chrome and never emits a heading tag. The 🎰 is a real sibling of that
// <p>, not a glyph inside its text, so it can carry its own aria-hidden.
//
// รวยเทพ168 (รอบ **ทองจักรพรรดินำ · แดงชาดเป็นฮิวที่สอง · ทองแดงเป็นฮิวที่สาม ·
// บนดำสนิท** 2026-10-20, brand-spec §2): ฟีดฝากถอนเป็น "โครม" เหมือนแถบประกาศกับ
// เมนู จึงอยู่ที่ **ผิวจม #0d0501** ซึ่งลึกกว่าการ์ดเนื้อหาทุกใบ
// ⚠️ พื้นเพจรอบนี้เป็น **ดำสนิท #000000** (bg.json) จึงไม่มีชั้นไหนจมต่ำกว่าพื้นได้
// — #0d0501 คือก้นสุดที่ใช้ได้ แผงนี้ทำหน้าที่เป็นสะพานระหว่างแถบประกาศด้านบนกับ
// การ์ดเนื้อหาผิวยกด้านล่าง ตัวมันตั้งสีตัวอักษรเองทั้งแผง จึงไม่ inherit BRAND_TEXT
// ผ่าน <html>
// เม็ดยาแต่ละเม็ดเป็นพื้นผิวกลาง #260d04 ในกรอบเส้นไรผมบรอนซ์ลึก #5c2a06 ที่สว่างขึ้น
// เป็นทองแบรนด์ #f0bb4e ตอน hover ชิปหมวดบริการเป็น **เส้นแดงชาด #e4021b** กับ
// ตัวอักษรครีมทอง #ffeccb ⚠️ แดงอยู่ที่ **เส้นขอบ ไม่ใช่ตัวอักษร** ตาม §2 ซึ่งวัดแดง
// ไว้ 3.2–4.3:1 ทุกผิวและห้ามให้มันถือตัวอักษรเด็ดขาด ครีมทองอยู่ที่ 15.9:1 บนเม็ดยา
// ยอดเงินเริ่มที่สีเนื้อความ #fff8ec แล้วกระโดดไปทองแบรนด์ #f0bb4e เมื่อเกิน
// data-big-win-above ซึ่งเป็นการสลับฮิว ไม่ใช่สลับน้ำหนักภายในฮิวเดียว
// ชื่อผู้ทำรายการเป็น #fff8ec หัวแถบไล่ ครีมทอง #ffeccb → ทองแบรนด์ #f0bb4e ตาม
// **ตัวอักษร "รวย" สีทองสามมิติ** ที่เป็นครึ่งแรกของโลโก้ดรอปนี้
// ไอคอน 🎰 มาจากตัวแบรนด์ที่บอกตัวเองว่าเป็นเกมสล็อตเป็นแกน (รอบเก่ากว่าของไฟล์นี้
// ใช้ ⚽ ซึ่งเป็นของแบรนด์กีฬาคนละเจ้า และ §6 รอบนี้ไม่มีคำว่า บอล/กีฬา เลย)
// เขียว #4ade80 ของสถานะ "ฝากถอนสำเร็จ" เป็นสีของสถานะ และสีโลโก้ธนาคารทั้งสี่เป็น
// สีจริงของธนาคาร จึงไม่ถูกรีแมปทั้งคู่ · แดงชาด #e4021b และบรอนซ์ลึก #5c2a06
// ไม่ถือตัวอักษรที่ไหนในไฟล์นี้ตาม §2
//
// ⚠️ เทียบเป็นค่า ไม่ใช่ตระกูลสี — **ทองมีมาแล้วเกือบทุกแบรนด์ในรีโปนี้ และแดงนำ
// มาแล้วสี่แบรนด์** ชุดฟ้าอะซัวร์-ทองอำพันของรวยแทร่168 ที่เพิ่งค้างอยู่ทั้งไฟล์นี้
// (039cfa c3ebfc 04366b f9a826 704504 e3f2fc 0b2d52 071e38 030f1d กับ rgba
// 3/156/250) ชุดทองไทย-แดงมังกรของรับตัง168 (f0b429 ffdc8c 9a6c0c cfd9e6 f5ece0
// 140505 200a09 d30304 4a0202 1a0505 กับ rgba 240/180/41) ชุดทองแชมเปี้ยน-เงิน
// โครเมียมของ UFA324 (e5a81b ffe08a f0e8d4 b9c2cc 17130a 43300a 0d0b06 7d5a07
// 464f5a) ชุดของสมหวัง168 (fa0513 ffadaf ff5a5f e3b23c ffe5a8 8a6210 f4ecea ccb9b6
// 2c1413 1f0d0c 140706 290f0f) ชุดทองสายฟ้า-แดงเลือดนกของ FLASH877 (f5c518 ffdd73
// b8860f ff3b14 8c0f0a fdf0e2) ชุดชมพูฮอต-ทองของ FAH999 (ff3fa4 ff6cbb ffd1ea
// fde8f3 f5c53d b3006a 4a0b42 2e002c) ชุดทองเป็ด-ส้มอำพันของ DUCK1688 (f3bb34
// fde464 c8901a 8a5f08 5c3f04 f58b2a a3510c f6ecd9) ชุดทองอวกาศของ NAZA168 (fbc134
// ffe87a cf9a18 cfd6e3 eef2f8 9aa6bb 3f4859) และชุดม่วงนีออน-ทอง (a435f0 5b1a75
// efe6ff d2a6ff ffd23d c98a05 1e0a3c) ออกครบทุกจุดแล้ว
// ⚠️ ทองรอบนี้คือ #f0bb4e (R240 G187 B78) ⚠️ **R ตรงกับ f0b429 ของรับตัง168 ที่เคย
// อยู่ในไฟล์นี้เป๊ะ ตัวตัดสินคือ B78 vs B41** และไม่ใช่ fcd45c ของมีเฮ168 รอบก่อน
// (G212 vs G187) ไม่ใช่ f9a826 ของรวยแทร่168 ไม่ใช่ fef54b (นินจา168) ffc82e
// (สบายเบท168) e5a81b ffe08a (UFA324) e3b23c dfa310 e2b33f หรือ fad354 —
// "มีทองอยู่แล้ว" ไม่พิสูจน์อะไรเลย ต้องเทียบเป็นตัวเลข
// ⚠️ แดงรอบนี้คือ #e4021b ไม่ใช่ fb1b32 (มีเฮ168) fa0513 (สมหวัง168) d30304
// (รับตัง168) ff3b14 (FLASH877) หรือ b3121b (ขวัญใจ168)
// ⚠️ **รอบนี้ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีชมพู ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์
// และไม่มีเหลืองมะนาว** (0ea5e9 กับ 1155cc 4e1c80 fcd34d ด้านบนเป็นสีจริงของโลโก้
// ธนาคาร **ห้ามแตะ**) เขียวมีได้ตัวเดียวคือ #4ade80 ของสถานะ ไม่ใช่สีแบรนด์ ·
// ส้มตัวเดียวที่อนุญาตคือทองแดง #d9701a ซึ่งเป็นเฉดเงาของทอง
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label={`รายการฝากถอนล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f0bb4e]/45 bg-[#0d0501]/92 px-4 py-8 shadow-[0_15px_40px_rgba(240,187,78,0.2)] backdrop-blur-md">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span aria-hidden="true" class="text-xl md:text-2xl">🎰</span>
      <p class="bg-gradient-to-b from-[#ffeccb] to-[#f0bb4e] bg-clip-text text-xl font-black text-transparent md:text-2xl">{BRAND_NAME} รายการฝากถอนล่าสุดของสมาชิก</p>
    </div>

    <div
      data-winners-feed
      data-interval="3000"
      data-max-rows="12"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.35"
      data-user-digits="0"
      data-insert="scatter"
      data-big-win-above="70000"
      class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#5c2a06] bg-[#260d04] py-1.5 pr-4 pl-1.5 shadow-[0_0_10px_rgba(240,187,78,0.16)] hover:border-[#f0bb4e]/70">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#fff8ec]">
                {row.user}
              </div>
              <span data-winner-market class="rounded-full border border-[#e4021b]/70 px-2 py-0.5 text-[10px] font-bold text-[#ffeccb]">
                {row.market}
              </span>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
              <div data-winner-big data-normal-class={AMOUNT_CLASS} data-big-class={BIG_AMOUNT_CLASS} class={`text-sm font-black drop-shadow-sm ${row.big ? BIG_AMOUNT_CLASS : AMOUNT_CLASS}`}>
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
