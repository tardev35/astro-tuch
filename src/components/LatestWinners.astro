---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts
// for what that cost. The rows below are server-rendered, the bank list travels
// as inert JSON, and the shared module takes over the rotation. Never move the
// rotation back into a <script define:vars>: that forces is:inline, which fails
// the build on an indexable page, and it would render the feed container empty.
//
// Values come from the brand's own domain hash, never Math.random(): frontmatter
// runs at BUILD time, so a random call there makes two builds of the same domain
// differ and tools/verify-build.mjs fails on it. เกลือของ brandPick/brandFlag ถูก
// เปลี่ยนเป็นของแบรนด์รอบนี้ (`tonchua-*`) เพื่อให้ชุดแถวตั้งต้นไม่ใช่ชุดเดิมกับ
// แบรนด์ก่อน ทั้งที่ยังนิ่งต่อโดเมนเดียวกันทุกบิลด์
//
// Every live value the module updates keeps its data-winner-* hook, and the
// numbers it needs sit on the feed element as data-* (interval, row cap, amount
// range, pending chance, user style/digits) — the module never learns the
// palette, so this file is free to restyle the row markup as much as it likes.
// The brand name is interpolated from BRAND_NAME and never typed.
//
// ถอนชัวร์168 (รอบ **ชมพูบับเบิลกัมนำ · ทองเนยเป็นฮิวที่สอง · พลัมเข้มไม่เคยถือ
// ตัวอักษร · บนดำสนิท** 2026-10-18) — พาเลตต์ตาม brand-spec §2
// รอบนี้หมุนจาก LatestWinners3 ของมีโชค168 มาที่ **ตัวฐาน** ตาม brand-spec §3 ทรงของ
// ไฟล์นี้คือ "สมุดรายการสันสี": แต่ละแถวมีสันแนวตั้งอยู่ซ้ายสุด แล้วไล่เป็นไอคอน
// ธนาคาร → ยูสเซอร์/REF → ยอดเงิน/สถานะ อ่านเป็นบรรทัดรายการ ไม่ใช่การ์ดซ้อน
// แผงเป็นผิวกลาง #1a0914 ในกรอบพลัมเข้ม #6d0b3f แถวรายการตกลงไปที่ผิวจม #0d040a
// แล้ว hover ขึ้นผิวยก #2b0f20 — ทั้งสามชั้นสว่างกว่าพื้นเพจดำสนิท #000000 จึงลอยหมด
// ฟีดนี้ตรงกับแกนของแบรนด์พอดี: บรีฟรอบนี้ขายเรื่อง **ความง่ายในการถอนเงิน** และ
// งานศิลป์มีมือถือจอชมพูขึ้นคำว่า ถอนสำเร็จ อยู่กลางภาพ
// บรรทัดหัวเรื่อง (เป็น <p> ไม่ใช่หัวข้อ) ไล่ชมพูอ่อน #ffb3de → ชมพูบับเบิลกัม
// #fa63b9 → ทองเนย #ffd84d · ยอดเงินเป็น **ทองเนย** ตาม §2 ที่ให้ทองถือตัวเลข
// (12.7:1) · ชื่อผู้ใช้เป็นชมพูบับเบิลกัม (7.7:1 บนผิวจม) · หน่วย THB เป็นชมพูอ่อน ·
// REF/เวลาเป็นชมพูอ่อน #ffb3de (10.7:1) · สันซ้ายไล่ #ffb3de → #fa63b9 → #ffd84d
// ซึ่งคือคู่สีของโลโก้ตรงๆ (ตัวอักษรชมพูตัดขอบทอง)
// ป้ายสถานะยังใช้เขียว/เทากลางของระบบ (semantic ไม่ใช่สีแบรนด์) และสีประจำธนาคารใน
// ไอคอนห้ามรีแมป
// §2 ห้าม #6d0b3f (1.5:1) กับ #6b4708 (2.1:1) ถือตัวอักษร — ที่นี่อยู่ที่กรอบและ
// ขอบวงไอคอนเท่านั้น
//
// ⚠️ **กับดักรอบนี้มีสองชั้น: ชมพู และ ทอง** เพราะรอบที่แล้ว (มีโชค168) ก็ทอง+ชมพู
// บนดำ ชมพูรอบนี้ **#fa63b9 / #ffb3de** ไม่ใช่ f5469f / ff8dc6 · ทองรอบนี้
// **#ffd84d** ไม่ใช่ fcd434 (มีโชค168) f3bb34 / fde464 / c8901a / f58b2a (DUCK1688
// ซึ่งเพิ่งอยู่ทั้งไฟล์นี้) fbc134 / ffe87a / cf9a18 / 96690a / 6b4a05 (NAZA168)
// หรือ ffc93c / ffeab0 / c08a07 (หวย365)
// ชุดเต็มของ DUCK1688 ที่ต้องออกให้หมด (f3bb34 fde464 ffc98a c8901a f58b2a d8c69b
// f6ecd9 171106 0d0903 1f1709 8a5f08 5c3f04 + rgba 243,187,52) ชุดของมีโชค168
// (fcd434 ffeaa0 f5469f ff8dc6 8c0f52 7a5508 1a0612 f6e4ee 24101c 160a12 0b0509)
// และชุดเงินโครเมียมของ NAZA168 (cfd6e3 fdf3df d9c9a6 4e3406 432b03 382400 241700)
// ออกครบทุกจุดแล้ว
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️ **รอบนี้ไม่มีน้ำเงิน ฟ้า ม่วง/ไวโอเลต เขียว ส้ม เงิน/โครเมียม โรสโกลด์ และ
// แดงชาด** — ยกเว้นสีแบรนด์ธนาคารในไอคอนกับป้ายสถานะ semantic ซึ่งไม่ใช่สีแบรนด์
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pad = (n: number) => String(n).padStart(2, "0");
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`tonchua-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`tonchua-a-${i}`, 26))}${LETTERS.charAt(pick(`tonchua-b-${i}`, 26))}***${digits(`tonchua-u${i}`, 4)}`,
  amount: (15000 + pick(`tonchua-amount-${i}`, 80001)).toLocaleString("en-US"),
  ref: digits(`tonchua-ref${i}`, 8),
  time: `${pad(pick(`tonchua-h-${i}`, 24))}:${pad(pick(`tonchua-m-${i}`, 60))}:${pad(pick(`tonchua-s-${i}`, 60))}`,
  pending: brandFlag(Astro.site, `tonchua-pending-${i}`),
}));

const PENDING_CLASS = "bg-gray-700/50 text-gray-300 animate-pulse border border-gray-500/50";
const DONE_CLASS = "bg-[#10b981]/20 text-[#34d399] border border-[#10b981]/50";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[20px] border border-[#6d0b3f] bg-[#1a0914]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#fa63b9]/80 to-transparent"></div>

    <div class="relative z-10 mb-6 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,99,185,0.6)]">💸</span>
      <p class="bg-gradient-to-r from-[#ffb3de] via-[#fa63b9] to-[#ffd84d] bg-clip-text text-center text-xl font-black tracking-wide text-transparent drop-shadow-sm md:text-3xl">
        รายการถอนเงินล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,99,185,0.6)]">💸</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row grid grid-rows-[1fr] transition-all duration-700 ease-in-out">
            <div class="overflow-hidden">
              <div class="mb-3 flex items-stretch gap-3 rounded-xl border border-[#6d0b3f] bg-[#0d040a]/85 p-3 transition-all hover:border-[#fa63b9]/60 hover:bg-[#2b0f20] md:gap-4 md:p-4">
                <span aria-hidden="true" class="w-1 shrink-0 rounded-full bg-gradient-to-b from-[#ffb3de] via-[#fa63b9] to-[#ffd84d]" />

                <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
                  <div class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#6b4708] bg-[#1a0914]">
                    <div data-winner-bank class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-full ${row.bank.color}`}>
                      <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                    </div>
                  </div>
                  <div class="flex min-w-0 flex-col justify-center">
                    <div class="truncate text-sm font-bold text-[#fdeaf5] md:text-base">
                      User: <span data-winner-user class="tracking-wider text-[#fa63b9]">{row.user}</span>
                    </div>
                    <div class="mt-0.5 truncate text-[10px] text-[#ffb3de] md:text-xs">
                      REF#<span data-winner-ref data-ref-length="8">{row.ref}</span> · <span data-winner-time>{row.time}</span>
                    </div>
                  </div>
                </div>

                <div class="flex shrink-0 flex-col items-end justify-center gap-1.5">
                  <div class="text-lg font-black tracking-tight text-[#ffd84d] drop-shadow-[0_0_5px_rgba(255,216,77,0.35)] md:text-2xl">
                    <span data-winner-amount>{row.amount}</span> <span class="text-[10px] font-medium text-[#ffb3de] md:text-xs">THB</span>
                  </div>
                  <div
                    data-winner-status
                    data-pending-text="กำลังทำรายการ..."
                    data-done-text="ถอนสำเร็จแล้ว"
                    data-pending-class={PENDING_CLASS}
                    data-done-class={DONE_CLASS}
                    class={`rounded-full px-3 py-1 text-[9px] font-medium md:text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                    {row.pending ? "กำลังทำรายการ..." : "ถอนสำเร็จแล้ว"}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* Entry state is a class the module toggles, not a list of utilities it has to
     know by name — restyling the animation here needs no JS change. */
  .winner-row.is-entering {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-1rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
