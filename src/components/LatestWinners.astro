---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts
// for what that cost. The rows below are server-rendered, the bank list travels
// as inert JSON, and the shared module takes over the rotation. Never move the
// rotation back into a <script define:vars>: that forces is:inline, which fails
// the build on an indexable page.
//
// Values come from the brand's own domain hash, never Math.random(): frontmatter
// runs at BUILD time, so a random call there makes two builds of the same domain
// differ and tools/verify-build.mjs fails on it.
//
// หวย365 (รอบแดงสด-ทอง 2026-10-02): ชื่อแบรนด์มาจาก BRAND_NAME ไม่พิมพ์ทับ (ไฟล์นี้เคย
// hardcode ชื่อแบรนด์เก่าไว้ใน JSX ตรงๆ) ผิวแผงเป็นการ์ด #240406 ในกรอบแดงแบรนด์ #dc0203
// แถวรายการตกลงไปที่ผิวแถบ #180303 บรรทัดหัวเรื่องไล่ทองอ่อน #ffeab0 → ทอง #ffc93c →
// แดงแบรนด์ #dc0203 ยอดเงินเป็นทอง ชื่อผู้ใช้เป็นทองอ่อน ตัวรองเป็นสีรอง #d9b9b1 ป้าย
// สถานะยังใช้เขียว/เทากลางของระบบ และสีประจำธนาคารในไอคอนห้ามรีแมป
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pad = (n: number) => String(n).padStart(2, "0");
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) =>
  Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`std-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`std-a-${i}`, 26))}${LETTERS.charAt(pick(`std-b-${i}`, 26))}***${digits(`std-u${i}`, 4)}`,
  amount: (15000 + pick(`std-amount-${i}`, 80001)).toLocaleString("en-US"),
  ref: digits(`std-ref${i}`, 8),
  time: `${pad(pick(`std-h-${i}`, 24))}:${pad(pick(`std-m-${i}`, 60))}:${pad(pick(`std-s-${i}`, 60))}`,
  pending: brandFlag(Astro.site, `std-pending-${i}`),
}));

const PENDING_CLASS = "bg-gray-700/50 text-gray-300 animate-pulse border border-gray-500/50";
const DONE_CLASS = "bg-[#10b981]/20 text-[#34d399] border border-[#10b981]/50";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[20px] border border-[#dc0203]/40 bg-[#240406]/80 px-4 py-8 shadow-[0_10px_30px_rgba(220,2,3,0.15)] backdrop-blur-md md:p-10">
    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(255,201,60,0.6)]">🏆</span>
      <p class="bg-gradient-to-r from-[#ffeab0] via-[#ffc93c] to-[#dc0203] bg-clip-text text-center text-xl font-black tracking-wide text-transparent drop-shadow-sm md:text-3xl">
        รายการถอนเงินล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(255,201,60,0.6)]">🏆</span>
    </div>

    <div data-winners-feed data-interval="5000" data-max-rows="4" class="relative z-10 flex flex-col">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row grid grid-rows-[1fr] transition-all duration-700 ease-in-out">
            <div class="overflow-hidden">
              <div class="mb-3 flex items-center justify-between rounded-xl border border-[#dc0203]/25 bg-[#180303]/70 p-4 shadow-sm backdrop-blur-md transition-all hover:border-[#ffc93c]/55 hover:bg-[#240406]">
                <div class="flex items-center gap-4">
                  <div class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#dc0203]/35 bg-white/5 shadow-sm">
                    <div data-winner-bank class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-full ${row.bank.color}`}>
                      <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                    </div>
                  </div>
                  <div class="flex flex-col justify-center">
                    <div class="text-sm font-bold text-[#f6e7e0] md:text-base">
                      User: <span data-winner-user class="tracking-wider text-[#ffeab0]">{row.user}</span>
                    </div>
                    <div class="mt-0.5 text-[10px] text-[#d9b9b1] md:text-xs">
                      REF#<span data-winner-ref data-ref-length="8">{row.ref}</span> · <span data-winner-time>{row.time}</span>
                    </div>
                  </div>
                </div>
                <div class="flex flex-col items-end justify-center gap-1.5">
                  <div class="text-lg font-black tracking-tight text-[#ffc93c] drop-shadow-[0_0_5px_rgba(255,201,60,0.35)] md:text-2xl">
                    <span data-winner-amount>{row.amount}</span> <span class="text-[10px] font-medium text-[#c08a07] md:text-xs">THB</span>
                  </div>
                  <div
                    data-winner-status
                    data-pending-text="กำลังทำรายการ..."
                    data-done-text="ถอนสำเร็จแล้ว"
                    data-pending-class={PENDING_CLASS}
                    data-done-class={DONE_CLASS}
                    class={`rounded-full px-3 py-1 text-[9px] font-medium md:text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                    {row.pending ? "กำลังทำรายการ..." : "ถอนสำเร็จแล้ว"}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* Entry state is a class the module toggles, not a list of utilities it has to
     know by name — restyling the animation here needs no JS change. */
  .winner-row.is-entering {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-1rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
