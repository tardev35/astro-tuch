---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts
// for what that cost. The rows below are server-rendered, the bank list travels
// as inert JSON, and the shared module takes over the rotation. Never move the
// rotation back into a <script define:vars>: that forces is:inline, which fails
// the build on an indexable page, and it would render the feed container empty.
//
// Values come from the brand's own domain hash, never Math.random(): frontmatter
// runs at BUILD time, so a random call there makes two builds of the same domain
// differ and tools/verify-build.mjs fails on it.
//
// Every live value the module updates keeps its data-winner-* hook, and the
// numbers it needs sit on the feed element as data-* (interval, row cap, amount
// range, pending chance, user style/digits) — the module never learns the
// palette, so this file is free to restyle the row markup as much as it likes.
// The brand name is interpolated from BRAND_NAME and never typed (this file used
// to hardcode a previous brand's name straight into the JSX).
//
// DUCK1688 (รอบทองเป็ด-ส้มปากเป็ด 2026-10-10, brand-spec §2):
// รอบนี้เปลี่ยนทรงจาก LatestWinnersCyber ของ NAZA168 ที่เป็นแถวการ์ดลอยมุมตัด มาเป็น
// "สมุดรายการสันทอง": แต่ละแถวมีสันทองแนวตั้งอยู่ซ้ายสุด แล้วไล่เป็นไอคอนธนาคาร →
// ยูสเซอร์/REF → ยอดเงิน/สถานะ ทรงนี้อ่านเป็นบรรทัดรายการ ไม่ใช่การ์ดซ้อน
// แผงเป็นผิวกลาง #171106 ในกรอบทองลึก #8a5f08 แถวรายการตกลงไปที่ผิวลึก #0d0903 แล้ว
// hover ขึ้นผิวยก #1f1709 — ทั้งสามชั้นสว่างกว่าพื้นเพจดำสนิท #000000 จึงลอยขึ้นหมด
// บรรทัดหัวเรื่อง (เป็น <p> ไม่ใช่หัวข้อ) ไล่ส้มอ่อน #ffc98a → ทองสว่าง #fde464 →
// ทองเป็ด #f3bb34 ยอดเงินเป็นทองเป็ด ชื่อผู้ใช้เป็นทองสว่าง หน่วย THB เป็นทองกลาง
// #c8901a (6.3:1 — §2 อนุญาตให้ถือตัวอักษร) ตัวรองเป็นครีมมัสตาร์ด #d8c69b (~11:1)
// สันทองซ้ายไล่ทองสว่าง → ทองเป็ด → ส้มอำพัน #f58b2a ซึ่งคือคู่สีของโลโก้ตรงๆ
// ป้ายสถานะยังใช้เขียว/เทากลางของระบบ (semantic ไม่ใช่สีแบรนด์) และสีประจำธนาคารใน
// ไอคอนห้ามรีแมป
//
// ⚠️ ชุดทองอวกาศ-เงินโครเมียมของ NAZA168 รอบก่อน (#fbc134 #ffe87a #cf9a18 #96690a
// #6b4a05 #cfd6e3 #fdf3df #d9c9a6 #4e3406 #432b03 #382400 #241700) และชุดแดงสด-ทอง
// ของ หวย365 ที่เคยค้างในไฟล์นี้ (#dc0203 #ffc93c #ffeab0 #c08a07 #240406 #180303
// #f6e7e0 #d9b9b1 rgba(220,2,3,α) rgba(255,201,60,α)) ออกครบทุกจุดแล้ว — รอบนี้ไม่มี
// สีแดงและไม่มีเงินโครเมียมเป็นฮิวเลย
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pad = (n: number) => String(n).padStart(2, "0");
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`duck-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`duck-a-${i}`, 26))}${LETTERS.charAt(pick(`duck-b-${i}`, 26))}***${digits(`duck-u${i}`, 4)}`,
  amount: (15000 + pick(`duck-amount-${i}`, 80001)).toLocaleString("en-US"),
  ref: digits(`duck-ref${i}`, 8),
  time: `${pad(pick(`duck-h-${i}`, 24))}:${pad(pick(`duck-m-${i}`, 60))}:${pad(pick(`duck-s-${i}`, 60))}`,
  pending: brandFlag(Astro.site, `duck-pending-${i}`),
}));

const PENDING_CLASS = "bg-gray-700/50 text-gray-300 animate-pulse border border-gray-500/50";
const DONE_CLASS = "bg-[#10b981]/20 text-[#34d399] border border-[#10b981]/50";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={`รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`}
    class="relative overflow-hidden rounded-[20px] border border-[#8a5f08]/55 bg-[#171106]/92 px-4 py-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#f3bb34]/70 to-transparent"></div>

    <div class="relative z-10 mb-6 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(243,187,52,0.6)]">🪙</span>
      <p class="bg-gradient-to-r from-[#ffc98a] via-[#fde464] to-[#f3bb34] bg-clip-text text-center text-xl font-black tracking-wide text-transparent drop-shadow-sm md:text-3xl">
        รายการถอนเงินล่าสุดของสมาชิก {BRAND_NAME}
      </p>
      <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(243,187,52,0.6)]">🪙</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row grid grid-rows-[1fr] transition-all duration-700 ease-in-out">
            <div class="overflow-hidden">
              <div class="mb-3 flex items-stretch gap-3 rounded-xl border border-[#5c3f04] bg-[#0d0903]/85 p-3 transition-all hover:border-[#f3bb34]/55 hover:bg-[#1f1709] md:gap-4 md:p-4">
                <span aria-hidden="true" class="w-1 shrink-0 rounded-full bg-gradient-to-b from-[#fde464] via-[#f3bb34] to-[#f58b2a]" />

                <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
                  <div class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#8a5f08] bg-[#171106]">
                    <div data-winner-bank class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-full ${row.bank.color}`}>
                      <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                    </div>
                  </div>
                  <div class="flex min-w-0 flex-col justify-center">
                    <div class="truncate text-sm font-bold text-[#f6ecd9] md:text-base">
                      User: <span data-winner-user class="tracking-wider text-[#fde464]">{row.user}</span>
                    </div>
                    <div class="mt-0.5 truncate text-[10px] text-[#d8c69b] md:text-xs">
                      REF#<span data-winner-ref data-ref-length="8">{row.ref}</span> · <span data-winner-time>{row.time}</span>
                    </div>
                  </div>
                </div>

                <div class="flex shrink-0 flex-col items-end justify-center gap-1.5">
                  <div class="text-lg font-black tracking-tight text-[#f3bb34] drop-shadow-[0_0_5px_rgba(243,187,52,0.35)] md:text-2xl">
                    <span data-winner-amount>{row.amount}</span> <span class="text-[10px] font-medium text-[#c8901a] md:text-xs">THB</span>
                  </div>
                  <div
                    data-winner-status
                    data-pending-text="กำลังทำรายการ..."
                    data-done-text="ถอนสำเร็จแล้ว"
                    data-pending-class={PENDING_CLASS}
                    data-done-class={DONE_CLASS}
                    class={`rounded-full px-3 py-1 text-[9px] font-medium md:text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                    {row.pending ? "กำลังทำรายการ..." : "ถอนสำเร็จแล้ว"}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* Entry state is a class the module toggles, not a list of utilities it has to
     know by name — restyling the animation here needs no JS change. */
  .winner-row.is-entering {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-1rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
