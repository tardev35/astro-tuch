---
import { BRAND_NAME } from "../lib/brandProfile";

// LOTTO189 (ดรอป 2026-10-27, .claude/brand-spec-lotto189.md §2–§5): สี่ตลาดที่บรีฟ
// รอบนี้ระบุไว้ใน **docx H2 §2** ("<แบรนด์> ลาว ฮานอย รัฐบาลไทย หุ้น จ่ายเต็ม
// รับทุกเลข ไม่มีอั้นเลข" — content.txt บรรทัด 5) และย่อหน้าบรรทัด 6 ไล่ชื่อไว้
// ตรงตัวว่า **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ** และไม่มี
// มากกว่านั้น ⚠️ **รอบนี้บรีฟเขียน "หวยลาว" เฉย ๆ ไม่ใช่ "หวยลาวพัฒนา"** และ
// **ไม่มี "หวยออมสิน"** (ทั้งสองคำเป็นของแบรนด์หวยเจ้าก่อน ๆ ที่เคยถือไฟล์นี้)
// `detail` ประกอบจากประโยคของบรีฟรอบนี้เองเท่านั้น (แต่ละรายการมีวันประกาศผลและ
// รูปแบบการเดิมพันแตกต่างกัน / รับทุกเลข ไม่มีเลขอั้น และจ่ายเต็มตามอัตราที่กำหนด /
// ควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัล
// ของแต่ละประเภทให้ชัดเจนก่อนยืนยันบิล / หวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้น
// อาจมีข้อกำหนดแตกต่างกัน) `note` เป็นชิปสรุปจากประโยคเดียวกัน **ไม่ใช่อัตราจ่าย
// และไม่ใช่วันออกรางวัล** — บรีฟไม่ได้ระบุเวลาเปิด-ปิดรับของตลาดไหนไว้เป็นตัวเลขเลย
// ส่วนเรทเดียวที่เอกสารมีคือ 2 ตัว 100 กับ 3 ตัว 1,000 ซึ่งอยู่ใน docx H2 §3 และ
// H3 §4/§5 **ไม่ใช่ในกริดนี้**
// ⚠️ **ไม่มี 0.3% / 0.8% ในไฟล์นี้** (brand-spec §5 อนุญาตสองค่านั้นเฉพาะใน alt
// ของสไลด์ในฐานะ "ตัวเลขที่พิมพ์อยู่บนโปสเตอร์") และไม่มีคำของแบรนด์ก่อน
// (888PARUAY · รวย168 · แทงหวยเว็บรวย · บาทละ 1,000 · JEDI66 · LOTTOPLUS ·
// หวยเต็ง · เลขเด็ด · ZNOVA168 · ZOLO99 · สล็อต · ค่ายเกม · ฝากถอน)
//
// The block title is a <p> and the <section> carries an aria-label: a market
// grid is chrome, so it never emits a heading tag at any level. ทุกอีโมจิอยู่ใน
// <span aria-hidden="true"> ของตัวเอง (build แดงถ้าไม่มี) และไฟล์นี้ไม่มีลิงก์
// สักเส้น จึงไม่มี href ให้ตรวจ
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "รายการที่บรีฟระบุไว้เป็นประเภทแรก มีวันประกาศผลและรูปแบบการเดิมพันของตัวเอง ตรวจสอบรอบประกาศผลและเงื่อนไขการเดิมพันได้จากหน้าเดียว",
    note: "ตรวจรอบประกาศผลก่อนแทง",
    icon: "🏛️",
  },
  {
    name: "หวยลาว",
    detail: "อยู่ในหน้ารวมหวยเดียวกับรายการอื่น โดยวันประกาศผลและรูปแบบการเดิมพันแตกต่างจากประเภทอื่นตามที่ระบุไว้",
    note: "วันประกาศผลต่างจากรายการอื่น",
    icon: "🎫",
  },
  {
    name: "หวยฮานอย",
    detail: "เปิดรับในระบบเดียวกัน เว็บไซต์ระบุว่ารับทุกเลข ไม่มีเลขอั้น และจ่ายเต็มตามอัตราที่กำหนด โดยควรตรวจสอบข้อจำกัดการรับหมายเลขก่อนยืนยันบิล",
    note: "ตรวจข้อจำกัดการรับหมายเลข",
    icon: "🏮",
  },
  {
    name: "หวยหุ้นต่างประเทศ",
    detail: "รวมอยู่ในรายการที่ระบบเปิดรับเช่นกัน และอาจมีข้อกำหนดแตกต่างจากหวยประเภทอื่น ควรตรวจสอบวงเงินเดิมพันสูงสุดและเงื่อนไขการจ่ายรางวัลก่อนยืนยันบิล",
    note: "ตรวจวงเงินก่อนยืนยันบิล",
    icon: "📈",
  },
];

// พาเลตรอบนี้ (brand-spec §2 — **โซนเนื้อหา ธีมสว่าง** ไม่ใช่โครม):
// วิดเจ็ตนี้ถูกวางต่อท้าย docx §2 กลางสายเนื้อหา จึงต้องอ่านต่อเนื่องกับการ์ด
// เนื้อหาสว่างที่ขนาบมันอยู่ **ห้าม "แก้" ให้เป็นกริดพื้นมืด** — ถ้าทำ หมึก #25090f
// จะหายไปเลย ไม่ใช่แค่จางลง (ไฟล์นี้มาถึงรอบนี้ยังเป็น **ทอง-เขียวเข้ม-แดงของ
// แบรนด์หวยเจ้าก่อน** ทั้งใบ จึงรีเธมทั้งไฟล์ และคอมเมนต์เก่าที่อ้างแบรนด์นั้น
// กับพาเลตเขียว-ทองถูกเขียนใหม่ทั้งหมด)
//   พื้นเพจ #fff0f0 (bg.json) · การ์ด #ffffff · ชั้นยก #ffe4e6 (hover) ·
//   wash #ffd4d7 (ออรา) · เส้น #f5b9bd อิ่มเป็น #a8333f ตอน hover
//   ชื่อตลาดเป็น **แดงเลือดนก #b00718** (7.3:1 บนการ์ดขาว) คำอธิบายเป็นหมึกรอง
//   **#6e3b44** (8.8:1) และบรรทัดสรุปใต้กริดก็เป็นค่าเดียวกันบนพื้นเพจ (8.4:1)
//   ชิปด้านล่างการ์ดเป็น **แผ่นถมไล่ #8a0412 → #b00718 บนหมึกขาว** (10.4 / 7.3:1 —
//   ครึ่งเข้มของสูตร "ปุ่ม CTA หลัก" ของ §2)
//   หัวแถบเป็น **แดงเลือดนก #b00718 ทึบสีเดียว** บนพื้นเพจ (7.0:1) + ขีดใต้ที่เป็น
//   **พื้นถม** ไล่ผ่าน #ff2436
// ⚠️⚠️ **ห้ามลากไล่เฉดของชิปขึ้นไปถึง #d61023 / #ff2436 / #e9b53c แล้ววางหมึกขาว**
// (#ff2436 ได้ 3.9:1 · #e9b53c 2.0:1 — ตกเกณฑ์) และ **#ff2436 #e9b53c #f5b9bd
// #ffd4d7 #ffe4e6 #fff0f0 #c3ccd6 ห้ามถือตัวอักษรบนผิวสว่างเด็ดขาด** ·
// #a8333f เป็น **เส้น** เท่านั้น
// ⚠️ **หัวแถบนี้ตั้งใจไม่ใช้ bg-clip-text** เพราะบนหน้าเดียวกัน §1/§4/§5 ถือหัวข้อ
// ไล่เฉดสามสต็อป และ §8 ถือสองสต็อปอยู่แล้ว
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) · rgba(138,4,18,α) ·
// rgba(255,36,54,α) · rgba(168,51,63,α) · rgba(37,9,15,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — แดง/ทองผ่านรีโปนี้มาแล้วสิบกว่าเจ้า
// แดงรอบนี้คือ **#b00718 / #c1071b / #8a0412 / #d61023 / #ff2436** เท่านั้น
// ⚠️⚠️ **ชุดที่เพิ่งอยู่ทั้งใบนี้คือเขียว-ทอง-แดงของแบรนด์หวยเจ้าก่อน** กวาดก่อนใคร:
// 1fae1c 0d2312 143a1c 07130a e8e4c6 fcdc2b fff6ae a87d0c cf1111 e01f26 1a0709
// 2a0b0e 120406 fadc64 fdf3b4 e0b03a f3f6fa d8bda6 fffdf0
// — 🚨 **cf1111 ↔ #d61023 และ e01f26 ↔ #c1071b เป็นคู่ที่ใกล้ที่สุด เจอที่ไหน
// แปลว่าพิมพ์ผิด ไม่ใช่ว่า "มันก็แดงเหมือนกัน"**
// ⚠️⚠️ **ZNOVA168 แบรนด์ขาออกทันที (ส้ม/ทอง/ครีม = ตระกูลเดียวกับรอบนี้ เสี่ยง
// หลงเหลือสูงสุด)**: 2a1206 1a0c04 2b1608 0e0602 7a3a0c fff3e0 e0b784 fffbf0
// fff4e0 ffe9c7 f3d9a8 c98a24 c23400 b8300a 9a5b00 9a2a00 d13800 fa4903 fde90b
// e8a000 ff8a2b d8dde6 8f9aa8 6a4a30
// 🚨 คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ: b8300a / c23400 / 9a2a00 และ a81410 /
// c81e12 / 9d140c (MEXICANOSLOT) ↔ #b00718 / #c1071b / #8a0412 · de2b1e / d13800
// ↔ #d61023 · fa4903 ↔ #ff2436 · 2a1206 / 3f130d ↔ #25090f · fffbf0 / fde4d3 /
// fff3ea ↔ #fff0f0 / #ffe4e6 / #ffd4d7 · f3d9a8 / e8c6ae / f6c4a4 ↔ #f5b9bd ·
// f2a033 / d4922c / f0b429 / e0b03a ↔ #e9b53c
// ⚠️ ทอง/เขียว/แดงของแบรนด์หวยเก่ากว่าที่ต้อง grep ทีละค่า: ffd94a e3a712 9d6f06
// f3ece0 e8eaee (รวย168) · cd9a2c fdeb7c ab7314 fcd4c3 f5e7c8 (หวยคิง) · dc0409
// f5363d 8e0206 c3c7d1 f3c54e (หวยดีใจ) · dc0203 f5282a ffc93c ffeab0 (หวย365) ·
// 0b7d28 0a5f1c 0f9b35 0c3a16 061f0c (สาธุ168) · dd1b74 a4186b (มีทรัพย์168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีเขียวเลยสักเฉดในไฟล์นี้** (LINE green #00B900 กับเขียว success
// ของฟีดถอนเงินอยู่ไฟล์อื่น คงไว้) **ไม่มีทอง/เหลืองบนผิวสว่าง ไม่มีม่วง ไม่มีฟ้า/
// ไซแอน ไม่มีชมพูบับเบิลกัม ไม่มีส้ม ไม่มีครีม/งาช้าง และไม่มีแรมป์เทาเงิน**
//
// **ห้ามใส่ `text-center` บน <section>** — ใส่บนกล่องหัวแถบกับการ์ดแต่ละใบเท่านั้น
// (กริดนี้ไม่มีสล็อต จึงไม่มีย่อหน้าของหน้าเพจให้ตกทอดไปโดน แต่คงกฎไว้ให้เหมือนกัน
// ทั้งโปรเจกต์)
---

<section aria-label={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับแทง`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl leading-normal font-black tracking-widest text-[#b00718] uppercase">ประเภทหวยที่ {BRAND_NAME} เปิดรับแทง</p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2436] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#f5b9bd] bg-white p-5 text-center shadow-[0_10px_26px_rgba(138,4,18,0.12)] transition-all duration-300 hover:-translate-y-2 hover:border-[#a8333f] hover:bg-[#ffe4e6] hover:shadow-[0_14px_34px_rgba(176,7,24,0.2)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(255,36,54,0.35)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#b00718]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#6e3b44]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#8a0412] to-[#b00718] px-4 py-1.5 text-center text-[11px] font-bold text-white shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.note}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#6e3b44]">
    ทั้งสี่รายการข้างต้นรวมอยู่ในระบบเดียวของ {BRAND_NAME} ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลผลรางวัลได้ในช่องทางเดียว โดยแต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน จึงควรตรวจสอบข้อจำกัดการรับหมายเลข วงเงินเดิมพันสูงสุด และเงื่อนไขการจ่ายรางวัลของแต่ละประเภทให้ชัดเจนก่อนยืนยันบิล
  </p>
</section>
