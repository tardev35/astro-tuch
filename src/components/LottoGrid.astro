---
import { BRAND_NAME } from "../lib/brandProfile";

// 888PARUAY (2026-09-24): สี่ตลาดที่บรีฟระบุไว้ในหัวข้อ H2 "แทงหวย รัฐบาลไทย ฮานอย
// ลาวพัฒนา หุ้นต่างประเทศ ได้ 24 ชั่วโมง" และไม่มีมากกว่านั้น — หุ้นต่างประเทศกลับ
// เข้ามาในรอบนี้เพราะบรีฟเอ่ยถึงโดยตรง `detail` ประกอบจากประโยคของบรีฟเอง
// (ตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการจากหน้าเดียว / แต่ละ
// ประเภทจะมีช่วงเวลาเปิดและปิดรับแตกต่างกันตามรอบที่ระบบกำหนด) `note` เป็นชิปสรุป
// จากประโยคเดียวกัน ไม่ใช่อัตราจ่ายและไม่ใช่วันออกรางวัล — บรีฟไม่ได้ระบุเวลาเปิด-ปิด
// ของตลาดไหนไว้เป็นตัวเลขเลย ส่วนเรทเดียวที่เอกสารมีคือ 2 ตัวจ่าย 100 กับ 3 ตัวจ่าย
// 1,000 ซึ่งอยู่ในหัวข้อ H3 ไม่ใช่ในกริดนี้
//
// The block title is a <p> and the <section> carries an aria-label: a market
// grid is chrome, so it never emits a heading tag at any level.
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "รายการยอดนิยมที่เปิดรับในระบบเดียวกับตลาดอื่น ตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของรายการได้จากหน้าเดียว",
    note: "ตรวจรอบเปิดรับก่อนแทง",
    icon: "🏛️",
  },
  {
    name: "หวยฮานอย",
    detail: "อยู่ในหน้ารวมหวยเดียวกับรายการอื่น โดยช่วงเวลาเปิดและปิดรับเป็นไปตามรอบที่ระบบกำหนดของแต่ละวัน",
    note: "รอบเปิด–ปิดตามที่ระบบกำหนด",
    icon: "🏮",
  },
  {
    name: "หวยลาวพัฒนา",
    detail: "เลือกตัวเลขและดูรายละเอียดของรายการได้จากหน้าเดียว ไม่ต้องสลับไปมาหลายหน้าเพื่อดูรอบที่กำลังเปิดรับ",
    note: "เลือกเลขจากหน้าเดียว",
    icon: "🎫",
  },
  {
    name: "หวยหุ้นต่างประเทศ",
    detail: "รวมอยู่ในรายการที่ระบบเปิดรับเช่นกัน ตรวจสอบรอบและรายละเอียดของแต่ละรายการได้ก่อนยืนยันทุกครั้ง",
    note: "ตรวจรายละเอียดก่อนยืนยัน",
    icon: "📈",
  },
];

// 888PARUAY palette (ทอง-เขียวเข้ม-แดง): การ์ดพื้นเขียวเข้ม #0d2312 ในกรอบพื้นยก
// #143a1c ที่สว่างขึ้นเป็นทองหลัก #fcdc2b ตอน hover ชื่อตลาดเป็นทองสว่าง #fff6ae
// คำอธิบายเป็นสีเนื้อความ #e8e4c6 และชิปด้านล่างไล่ทองสว่าง → ทองลึก #a87d0c
// ตัวอักษรบนชิปใช้สีพื้นเพจ #07130a หัวข้อไล่ตามลำดับสีบนโลโก้ เขียวสด #1fae1c →
// ทองสว่าง → แดง #cf1111 — ชุดแดง-ทอง-เงินโครเมียมของแบรนด์ก่อนหน้า (#1a0709 #2a0b0e
// #fadc64 #fdf3b4 #e0b03a #f3f6fa #e01f26 #d8bda6 #120406) ออกทั้งหมด
---

<section aria-label={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับแทง`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#1fae1c] via-[#fff6ae] to-[#cf1111] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ {BRAND_NAME} เปิดรับแทง
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fcdc2b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#143a1c] bg-[#0d2312]/90 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fcdc2b]/65 hover:bg-[#143a1c] hover:shadow-[0_10px_30px_rgba(252,220,43,0.24)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(31,174,28,0.55)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#fff6ae] transition-colors group-hover:text-[#fffdf0]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#e8e4c6]/80">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#fff6ae] to-[#a87d0c] px-4 py-1.5 text-center text-[11px] font-bold text-[#07130a] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.note}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#e8e4c6]/80">
    ทั้งสี่รายการข้างต้นรวมอยู่ในระบบเดียวของ {BRAND_NAME} ผู้ใช้งานสามารถตรวจสอบรอบเปิดรับ เลือกตัวเลข และดูรายละเอียดของแต่ละรายการได้จากหน้าเดียว โดยแต่ละประเภทจะมีช่วงเวลาเปิดและปิดรับแตกต่างกันตามรอบที่ระบบกำหนด
  </p>
</section>
