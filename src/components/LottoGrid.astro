---
import { BRAND_NAME } from "../lib/brandProfile";

// LOTTOPLUS (ดรอป 2026-10-28, .claude/brand-spec-lottoplus.md §2–§5): สี่ประเภทหวย
// ที่บรีฟรอบนี้ระบุไว้ใน **docx H2 §2** ("<แบรนด์> รัฐบาลไทย ลาว ฮานอย หุ้น
// อัตราจ่ายสูง จ่ายเต็ม โอนไว" — content.txt บรรทัด 5) และย่อหน้าบรรทัด 6 ไล่ชื่อไว้
// ตรงตัวว่า **หวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล · หวยลาว · หวยฮานอย ·
// หวยหุ้นที่อ้างอิงดัชนีตลาดหลักทรัพย์** และไม่มีมากกว่านั้น หน้าแรกวางกริดนี้
// **ต่อท้าย ContentBoxTwoHuay ทันที** เพราะเป็นวิดเจ็ตของหัวข้อนั้นโดยตรง
// ⚠️ **บรีฟรอบนี้เขียน "หวยลาว" เฉย ๆ ไม่ใช่ "หวยลาวพัฒนา"** และ **ไม่มี
// "หวยออมสิน"** (ทั้งสองคำเป็นของแบรนด์หวยเจ้าก่อน ๆ ที่เคยถือไฟล์นี้) ·
// **"รับทุกเลข ไม่มีอั้นเลข" / "จ่ายเต็ม จ่ายสด" / "บาทละ 1,000" / "เลขเด็ด"
// ก็เป็นคำของเจ้าของไฟล์รอบที่แล้ว ไม่ใช่ของบรีฟนี้** ถอดออกครบแล้ว
// `detail` ประกอบจากประโยคของบรีฟรอบนี้เองเท่านั้น (รวบรวมข้อมูลหวยหลายประเภทไว้ใน
// แพลตฟอร์มเดียว / แต่ละรายการมีรอบปิดรับและเวลาออกผลแตกต่างกัน / ควรตรวจสอบตาราง
// อัตราจ่าย วงเงินรับรางวัล และเงื่อนไขการถอนเงินให้ครบถ้วน / แต่ละรายการอาจมี
// ข้อกำหนดเกี่ยวกับเลขอั้น วงเงินเดิมพัน และการจ่ายรางวัลแตกต่างกัน / หวยรัฐบาลไทย
// หวยลาว หวยฮานอย และหวยหุ้นอาจมีเงื่อนไขแตกต่างกัน) `note` เป็นชิปสรุปจากประโยค
// เดียวกัน **ไม่ใช่อัตราจ่ายและไม่ใช่เวลาออกรางวัล** — บรีฟไม่ได้ระบุเวลาเปิด-ปิดรับ
// ของรายการไหนไว้เป็นตัวเลขเลย ส่วนเรทเดียวที่เอกสารมีคือ 2 ตัว 100 กับ 3 ตัว 1,000
// ซึ่งอยู่ใน docx H2 §3 และ H3 §4/§5 **ไม่ใช่ในกริดนี้**
// ⚠️ **ไม่มี 0.3% / 0.8% / คืนยอดเสีย / แนะนำเพื่อน ในไฟล์นี้** (เป็นคอปปี้โปรโมชั่น
// ของ WIN8S แบรนด์ขาออก และบรีฟรอบนี้ไม่มีหมวดโปรโมชั่นเลย) และไม่มีสล็อต/บาคาร่า/
// ค่ายเกม/ฝากถอน/ธนาคาร ซึ่งบรีฟรอบนี้ก็ไม่มีสักคำ
//
// The block title is a <p> and the <section> carries an aria-label: a market
// grid is chrome, so it never emits a heading tag at any level. ทุกอีโมจิอยู่ใน
// <span aria-hidden="true"> ของตัวเอง (build แดงถ้าไม่มี) และไฟล์นี้ไม่มีลิงก์
// สักเส้น จึงไม่มี href ให้ตรวจ
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "รายการที่บรีฟระบุไว้เป็นประเภทแรก อ้างอิงผลสลากกินแบ่งรัฐบาล จึงมีรอบประกาศผลตามปฏิทินของงวดนั้น ควรดูรอบปิดรับของเว็บไซต์แยกจากเวลาประกาศผล",
    note: "อ้างอิงผลสลากกินแบ่งรัฐบาล",
    icon: "🏛️",
  },
  {
    name: "หวยลาว",
    detail: "อยู่ในแพลตฟอร์มเดียวกับรายการอื่น โดยมีรอบปิดรับและเวลาออกผลเป็นของตัวเอง จึงควรดูตารางรอบของรายการนี้แยกจากหวยรัฐบาลไทย",
    note: "รอบปิดรับต่างจากรายการอื่น",
    icon: "🎫",
  },
  {
    name: "หวยฮานอย",
    detail: "เปิดรับในระบบเดียวกัน และเป็นอีกรายการที่กำหนดรอบปิดรับกับเวลาออกผลไว้ของตัวเอง โดยอาจมีข้อกำหนดเรื่องเลขอั้นและวงเงินเดิมพันต่างจากรายการอื่น",
    note: "ตรวจเลขอั้นและวงเงินเดิมพัน",
    icon: "🏮",
  },
  {
    name: "หวยหุ้นต่างประเทศ",
    detail: "อ้างอิงดัชนีตลาดหลักทรัพย์ รอบของรายการนี้จึงผูกกับเวลาทำการของตลาดที่อ้างอิง ควรตรวจสอบวงเงินรับรางวัลและเงื่อนไขการจ่ายรางวัลก่อนยืนยันบิล",
    note: "อ้างอิงดัชนีตลาดหลักทรัพย์",
    icon: "📈",
  },
];

// พาเลตรอบนี้ (brand-spec §2 — **โซนเนื้อหา ธีมสว่าง** ไม่ใช่โครม):
// วิดเจ็ตนี้ถูกวางต่อท้าย docx §2 กลางสายเนื้อหา จึงต้องอ่านต่อเนื่องกับการ์ด
// เนื้อหาสว่างที่ขนาบมันอยู่ **ห้าม "แก้" ให้เป็นกริดพื้นมืด** — ถ้าทำ หมึก 0d3326
// กับ 3f6f5c จะหายไปเลย ไม่ใช่แค่จางลง (โครมเข้ม 052e22 / 03201a / 0a4433 รอบนี้
// เป็นของ navbar · footer · ticker · แถบล่างมือถือ เท่านั้น ไม่ใช่ของไฟล์นี้)
// ⚠️⚠️ ไฟล์นี้มาถึงรอบนี้ยังเป็น **แดง/ชมพูของ LOTTO189** ทั้งใบ ซึ่งเป็นธีมสว่าง
// เหมือนกันแต่คนละค่าทุกตัว จึงรีเธมทั้งไฟล์ **ห้ามเหลือแดง/ชมพู/ทองของรอบก่อนไว้
// เลยสักค่า** และคอมเมนต์เก่าที่อ้างแบรนด์นั้นถูกเขียนใหม่ทั้งหมด
//   พื้นเพจ e1fef3 (bg.json) · การ์ด ffffff · ชั้นยก/hover f0fdf7 ·
//   เส้นบาง a3ddc3 อิ่มเป็น 19a97c ตอน hover · ออราสว่าง 2fd49b
//   ชื่อประเภทหวยเป็น **เขียวมรกต 046c4e** (6.70:1 บนการ์ดขาว) คำอธิบายเป็นหมึกรอง
//   **3f6f5c** (5.98:1 บนการ์ด) และบรรทัดสรุปใต้กริดก็เป็นค่าเดียวกันบนพื้นเพจ (5.60:1)
//   ชิปใต้การ์ดเป็น **แผ่นถมไล่ 03543c → 046c4e บนหมึกขาว** (9.23 / 6.70:1 —
//   ครึ่งเข้มของสูตร "ปุ่ม CTA หลัก" ของ §2)
//   หัวแถบเป็น **เขียวมรกต 046c4e ทึบสีเดียว** บนพื้นเพจ (6.27:1) + ขีดใต้ที่เป็น
//   **พื้นถม** ไล่ผ่าน 19a97c
// ⚠️⚠️ **ห้ามลากไล่เฉดของชิปขึ้นไปถึง 19a97c หรือ e2b32a แล้ววางหมึกขาว**
// (19a97c ได้ 3.0:1 · e2b32a ได้ 2.0:1 บนขาว — ตกเกณฑ์ทั้งคู่) และ
// **19a97c 2fd49b a3ddc3 d2f3e4 e2b32a e1fef3 f0fdf7 ห้ามถือตัวอักษรเด็ดขาด**
// เป็นเส้น/ขอบ/ออรา/พื้นถมเท่านั้น · ทองที่ถือตัวอักษรบนผิวสว่างได้คือ 8a6508
// ⚠️ **หัวแถบนี้ตั้งใจไม่ใช้ bg-clip-text** เพราะบนหน้าเดียวกัน §1 (ContentBoxHuay)
// ถือหัวข้อไล่เฉดสามสต็อปอยู่แล้ว
// ⚠️ **เงาบนการ์ดสว่างต้องเบา**: rgba(13,51,38,0.10) · hover rgba(4,108,78,0.18)
// **ห้ามลอกค่า alpha ของรอบที่การ์ดเป็นผิวเข้มมาใช้**
// rgba() ที่อนุญาตรอบนี้: rgba(4,108,78,α) · rgba(25,169,124,α) · rgba(47,212,155,α) ·
// rgba(226,179,42,α) · rgba(13,51,38,α) · rgba(5,46,34,α) · rgba(3,32,26,α)
//
// ⚠️ เทียบสีเป็น **"ค่า"** ไม่ใช่ "ตระกูลสี" — เขียวรอบนี้คือ **046c4e / 0c7c58 /
// 03543c / 19a97c / 2fd49b / a3ddc3 / d2f3e4 / e1fef3 / f0fdf7** หมึก **0d3326 /
// 3f6f5c** ทอง **e2b32a / 8a6508** เท่านั้น **เขียวผ่านรีโปนี้มาแล้วหลายเจ้า
// การเจอเขียวจึงไม่พิสูจน์อะไรเลย**
// ⚠️⚠️ **ชุดที่เพิ่งอยู่ทั้งใบนี้คือแดง/ชมพู/ทองของ LOTTO189** กวาดก่อนใคร:
// fff0f0 ffe4e6 ffd4d7 f5b9bd a8333f 25090f 6e3b44 b00718 c1071b 8a0412 8f6310
// d61023 ff2436 e9b53c 24060c 3d0d16 120307 7e1221 ffeaea f0bcbc c3ccd6
// ⚠️⚠️ **WIN8S แบรนด์ขาออกทันที (ส้มเพลิง/ทอง/ครีมบนดำ) = เสี่ยงหลงเหลือสูงสุด**:
// 1e0101 2a0a04 3b130b 5a2410 8a3a12 250604 140302 fdf0e6 e0bda4 f27a1a e5a92b c9d2dc
// 🚨 คู่ที่ต้องสงสัยว่าพิมพ์ผิดก่อนเสมอ: 0e5424 1e7033 35a043 073c1a 002908 3ddc4a
// 23823a eef7f0 9dc2a5 (ZORO365) · 116018 0b4a12 1a7d24 28c437 15401d 051409 10280f
// 3c5b36 e8fbe4 b4d6ad e6f7df d7f0cd f0ffeb (TEVA69) · 0b7d28 0a5f1c 0f9b35 0c3a16
// 061f0c (สาธุ168) · 143a1c 1fae1c 07130a 0d2312 (888PARUAY) ↔ 046c4e / 03543c /
// 0c7c58 / 19a97c / 2fd49b / e1fef3 / f0fdf7 / d2f3e4 / a3ddc3 / 0d3326 / 3f6f5c
// **(เขียวจาง/ขาวอมเขียวใกล้กันมาก ต้องอ่านค่าทีละตัว)** ·
// e5a92b e9b53c e3bb45 e8c86a e0b03a f2a033 d4922c ffd94a e3a712 cd9a2c fdeb7c
// ab7314 fcdc2b fff6ae a87d0c ↔ e2b32a / 8a6508 ·
// c9d2dc dde1e7 cfd6e3 c3ccd6 c6cfd2 ↔ c8d4d0 (โครมเข้มเท่านั้น ไม่อยู่ในไฟล์นี้)
// ⚠️ แดงของแบรนด์หวยเก่ากว่าที่ต้อง grep ทีละค่า: fcd4c3 fce2d4 f5e7c8 (หวยคิง) ·
// dc0409 f5363d 8e0206 f3c54e (หวยดีใจ) · dc0203 f5282a ffc93c ffeab0 (หวย365) ·
// cf1111 e01f26 1a0709 2a0b0e 120406 (แบรนด์หวยเก่ากว่านั้น) · dd1b74 a4186b
// (มีทรัพย์168) · ff2e52 e01238 c9102f (มาดาม168)
// (เขียนเฮกซ์ของแบรนด์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีเก่าสะดุดที่คอมเมนต์)
// ⚠️⚠️ **รอบนี้ไม่มีแดง ไม่มีชมพู ไม่มีส้ม ไม่มีม่วง ไม่มีฟ้า/ไซแอน ไม่มีครีม/งาช้าง
// และไม่มีแรมป์เทาเงินในไฟล์นี้** · LINE green 00B900 กับเขียว success ของฟีด
// ถอนเงินอยู่ไฟล์อื่น **คงไว้ ห้ามกลืนเข้าเขียวมรกตของรอบนี้** — รอบนี้สับสนง่าย
// ที่สุดเพราะแบรนด์ก็เป็นเขียว
//
// **ห้ามใส่ `text-center` บน <section>** — ใส่บนกล่องหัวแถบกับการ์ดแต่ละใบเท่านั้น
// (กริดนี้ไม่มีสล็อต จึงไม่มีย่อหน้าของหน้าเพจให้ตกทอดไปโดน แต่คงกฎไว้ให้เหมือนกัน
// ทั้งโปรเจกต์)
---

<section aria-label={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับแทง`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl leading-normal font-black tracking-widest text-[#046c4e] uppercase">ประเภทหวยที่ {BRAND_NAME} เปิดรับแทง</p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#19a97c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#a3ddc3] bg-white p-5 text-center shadow-[0_10px_26px_rgba(13,51,38,0.10)] transition-all duration-300 hover:-translate-y-2 hover:border-[#19a97c] hover:bg-[#f0fdf7] hover:shadow-[0_14px_34px_rgba(4,108,78,0.18)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(47,212,155,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#046c4e]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#3f6f5c]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#03543c] to-[#046c4e] px-4 py-1.5 text-center text-[11px] font-bold text-white shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.note}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#3f6f5c]">
    ทั้งสี่รายการข้างต้นรวมอยู่ในแพลตฟอร์มเดียวของ {BRAND_NAME} ผู้ใช้งานสามารถศึกษารูปแบบการเดิมพัน ตรวจสอบหมายเลข และติดตามข้อมูลผลรางวัลได้จากเว็บไซต์เดียว โดยแต่ละรายการมีรอบปิดรับและเวลาออกผลแตกต่างกัน จึงควรตรวจสอบตารางอัตราจ่าย วงเงินรับรางวัล และเงื่อนไขการถอนเงินให้ครบถ้วน รวมถึงข้อกำหนดเกี่ยวกับเลขอั้นและวงเงินเดิมพันของแต่ละประเภทก่อนยืนยันบิล
  </p>
</section>
