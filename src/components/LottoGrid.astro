---
// The หวย types กินดี365 lists on the หน้าส่งโพย, and nothing else — the brief
// names exactly four: หวยรัฐบาลไทย, หวยลาวพัฒนา, หวยฮานอย VIP และหวยหุ้นต่างประเทศ.
// It also states that เวลาเปิดรับ อัตราจ่าย และเงื่อนไข ต่างกันตามประเภทหวยและรอบ
// จึงควรยึดรายละเอียดบนหน้าส่งโพยในรอบนั้นเป็นหลัก — so no close time and no
// per-market rate is printed here. The only rates quoted anywhere on this page
// are the brief's own 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000, and they live in the
// rate tables, not in this grid.
//
// The block title is a <p> and the <section> carries an aria-label: a product
// grid is chrome, so it never emits a heading tag.
const lottos = [
  { name: "หวยรัฐบาลไทย", detail: "เลือกรอบที่เปิดรับ ระบุเลข 2 ตัวหรือ 3 ตัวและยอดเดิมพัน แล้วตรวจรายละเอียดก่อนยืนยันโพย", reward: "ตามรอบที่เปิดรับ", icon: "🏛️" },
  { name: "หวยลาวพัฒนา", detail: "เลือกประเภทการเดิมพันของรอบนั้น แล้วตรวจอัตราจ่ายที่ระบบแสดงก่อนส่งโพย", reward: "ตามรอบที่เปิดรับ", icon: "🎫" },
  { name: "หวยฮานอย VIP", detail: "ตรวจเวลาเปิด-ปิดและรายละเอียดของรอบที่ต้องการก่อนกรอกเลขและยอดแทง", reward: "ตามรอบที่เปิดรับ", icon: "🏮" },
  { name: "หวยหุ้นต่างประเทศ", detail: "อีกหนึ่งหมวดที่เลือกแทงได้ในบัญชีเดียวกับหวยประเภทอื่น ตามรอบที่ระบบเปิดบริการ", reward: "ตามรอบที่เปิดรับ", icon: "📈" },
];
---

<section aria-label="ประเภทหวยที่ กินดี365 เปิดรับแทง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbeeb8] via-[#e9c55d] to-[#7e5f1f] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ กินดี365 เปิดรับแทง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9c55d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#1c47a8]/60 bg-[#062052]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e9c55d]/60 hover:bg-[#0a2f7a] hover:shadow-[0_10px_30px_rgba(233,197,93,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(233,197,93,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#fbeeb8] transition-colors group-hover:text-[#e9c55d]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#a9c4e8]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#e9c55d] to-[#fbeeb8] px-4 py-1.5 text-center text-[11px] font-bold text-[#00081f] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#a9c4e8]">
    เวลาเปิด-ปิด อัตราจ่าย และเงื่อนไขของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน ควรยึดรายละเอียดที่หน้าส่งโพยของ กินดี365 แสดง ณ เวลาทำรายการเป็นหลักก่อนส่งโพยทุกครั้ง
  </p>
</section>
