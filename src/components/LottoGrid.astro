---
// The หวย types PREMSUK365 lists on the หน้าแทง, and nothing else. The brief
// states only that เวลาเปิด-ปิด, อัตราจ่าย, เลขอั้น and วงเงิน differ per type
// and per round and should be checked on the หน้าแทง at the moment of the
// transaction — so no close time and no เลขอั้น limit is printed here. The only
// rates quoted anywhere on this page are the brief's own 2 ตัวจ่าย 100 and
// 3 ตัวจ่าย 1,000, and they live in the rate tables, not in this grid.
//
// The block title is a <p> and the <section> carries an aria-label: a product
// grid is chrome, so it never emits a heading tag.
const lottos = [
  { name: "หวยรัฐบาลไทย", detail: "เลือกรอบที่เปิดรับ กรอกเลขและยอดเดิมพัน แล้วตรวจรายละเอียดก่อนยืนยันโพย", reward: "ตามรอบที่เปิดรับ", icon: "🏛️" },
  { name: "หวยลาว", detail: "เลือกประเภทการเดิมพันของรอบนั้น แล้วตรวจอัตราจ่ายที่ระบบแสดงก่อนส่งโพย", reward: "ตามรอบที่เปิดรับ", icon: "🎫" },
  { name: "หวยฮานอย", detail: "ตรวจเวลาเปิด-ปิดและรายละเอียดของรอบที่ต้องการก่อนกรอกเลข", reward: "ตามรอบที่เปิดรับ", icon: "🏮" },
  { name: "หวยยี่กี่", detail: "รอบเดิมพันหมุนเวียนถี่กว่าประเภทอื่น ควรดูรอบที่ระบบเปิดรับอยู่ก่อนทุกครั้ง", reward: "ตามรอบที่เปิดรับ", icon: "⏱️" },
  { name: "หวยหุ้น", detail: "อีกหนึ่งประเภทที่เลือกแทงได้ในระบบเดียวกับหวยประเภทอื่น", reward: "ตามรอบที่เปิดรับ", icon: "📈" },
];
---

<section aria-label="ประเภทหวยที่ PREMSUK365 เปิดรับแทง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ PREMSUK365 เปิดรับแทง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3c56a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#1c6b3f]/60 bg-[#082013]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e3c56a]/60 hover:bg-[#0d3a22] hover:shadow-[0_10px_30px_rgba(227,197,106,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(227,197,106,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#f7e8b4] transition-colors group-hover:text-[#e3c56a]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#a9bda9]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#e3c56a] to-[#f7e8b4] px-4 py-1.5 text-center text-[11px] font-bold text-[#020c06] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#a9bda9]">
    เวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน ควรยึดข้อมูลที่หน้าแทงของ PREMSUK365 แสดง ณ เวลาทำรายการเป็นหลักก่อนส่งโพยทุกครั้ง
  </p>
</section>
