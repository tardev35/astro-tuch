---
// LOTTOKA: ห้าประเภทหวยที่ brief ระบุไว้ใต้ H2 #2 และไม่มีมากกว่านั้น —
// หวยรัฐบาลไทย, หวยลาว (ลาวพัฒนา), หวยออมสิน, หวยฮานอย (เวียดนาม) และ
// หวยหุ้นต่างประเทศและหุ้นไทย. `detail` คือประโยคของ brief เองทั้งประโยค
// ส่วน `reward` เป็นชิปสรุปข้อเท็จจริงจากประโยคเดียวกัน (วันออกรางวัล/แหล่งอ้างอิง)
// ไม่ใช่อัตราจ่าย — เรทเดียวที่มีอยู่ในเอกสารคือ 2 ตัวบาทละ 100 กับ 3 ตัวบาทละ
// 1,000 และทั้งคู่อยู่ในหัวข้อ #4/#5 ไม่ใช่ในกริดนี้
//
// The block title is a <p> and the <section> carries an aria-label: a product
// grid is chrome, so it never emits a heading tag.
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "ลุ้นรวยทุกวันที่ 1 และ 16 ของเดือน เปิดรับแทงล่วงหน้า ปิดรับช้า ให้เวลาคุณหาเลขเด็ดได้อย่างเต็มที่",
    reward: "ออกทุกวันที่ 1 และ 16",
    icon: "🏛️",
  },
  {
    name: "หวยลาว (ลาวพัฒนา)",
    detail: "หวยยอดฮิตฝั่งโขง ออกรางวัลทุกวันจันทร์ พุธ ศุกร์ ลุ้นง่าย จ่ายหนัก",
    reward: "จันทร์ · พุธ · ศุกร์",
    icon: "🎫",
  },
  {
    name: "หวยออมสิน",
    detail: "อีกหนึ่งทางเลือกสำหรับคนชอบหวยไทย อ้างอิงผลสลากออมสิน มั่นใจได้ในความโปร่งใส",
    reward: "อ้างอิงผลสลากออมสิน",
    icon: "🏦",
  },
  {
    name: "หวยฮานอย (เวียดนาม)",
    detail: "ลุ้นสนุกได้ทุกวันไม่มีวันหยุด มีทั้งฮานอยปกติ ฮานอยพิเศษ และฮานอย VIP",
    reward: "ทุกวันไม่มีวันหยุด",
    icon: "🏮",
  },
  {
    name: "หวยหุ้นต่างประเทศและหุ้นไทย",
    detail: "ตอบสนองสายวิเคราะห์ด้วยหวยหุ้นชั้นนำ เช่น นิเคอิ ดาวโจนส์ ฮั่งเส็ง และอื่นๆ อีกมากมาย",
    reward: "นิเคอิ · ดาวโจนส์ · ฮั่งเส็ง",
    icon: "📈",
  },
];
---

<section aria-label="ประเภทหวยที่ LOTTOKA เปิดรับแทง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ LOTTOKA เปิดรับแทง
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2353a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#c21e22]/45 bg-[#1c0d0f]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e2353a]/70 hover:bg-[#3a0709] hover:shadow-[0_10px_30px_rgba(226,53,58,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(226,53,58,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#ffe9ea] transition-colors group-hover:text-[#ff8a8d]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#bdb4b6]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#ff8a8d] to-[#c21e22] px-4 py-1.5 text-center text-[11px] font-bold text-[#0a0608] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#bdb4b6]">
    ทุกประเภทเปิดรับแทงผ่านระบบเดียวกันของ LOTTOKA มีนโยบายรับแทงทุกเลข ไม่มีปิดกั้น และหากทำรายการสำเร็จก่อนระบบปิดรับโพย เมื่อถูกรางวัลจะจ่ายเต็มจำนวนตามเรทราคาที่กำหนดไว้ในบิล
  </p>
</section>
