---
import { BRAND_NAME } from "../lib/brandProfile";

// 365LOTTO (2026-09-24): สามตลาดที่บรีฟระบุไว้ในหัวข้อ H2 "บริการหลัก หวยรัฐบาลไทย
// ฮานอย ลาวพัฒนา" และไม่มีมากกว่านั้น — ตลาดที่สี่ (หวยหุ้นต่างประเทศ) ของแบรนด์
// ก่อนหน้าถูกถอดออก เพราะบรีฟรอบนี้ไม่ได้เอ่ยถึงเลย `detail` ประกอบจากประโยคของ
// บรีฟเอง (แยกรอบเปิดรับของแต่ละประเภทไว้อย่างชัดเจน / ตรวจสอบเลข รอบเวลา และ
// รายละเอียดของรายการก่อนยืนยัน / ติดตามหวยหลายประเภทได้จากหน้าเดียวโดยไม่ต้อง
// เปลี่ยนหลายเว็บไซต์) `note` เป็นชิปสรุปจากประโยคเดียวกัน ไม่ใช่อัตราจ่ายและไม่ใช่
// วันออกรางวัล — บรีฟไม่ได้ระบุวันออกรางวัลของตลาดไหนไว้เลย ส่วนเรทเดียวที่เอกสาร
// มีคือ 2 ตัวจ่าย 100 กับ 3 ตัวจ่าย 1,000 ซึ่งอยู่ในหัวข้อ H3 ไม่ใช่ในกริดนี้
//
// The block title is a <p> and the <section> carries an aria-label: a market
// grid is chrome, so it never emits a heading tag at any level.
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "รายการหลักที่เปิดรับในระบบเดียวกับตลาดอื่น แยกรอบเปิดรับไว้ชัดเจน ตรวจสอบเลขและรายละเอียดของรายการก่อนยืนยันได้จากหน้าเดียว",
    note: "แยกรอบเปิดรับชัดเจน",
    icon: "🏛️",
  },
  {
    name: "หวยฮานอย",
    detail: "อีกหนึ่งรายการยอดนิยมที่รวมไว้ในระบบเดียวกัน ตรวจสอบรอบเวลาของรายการที่เปิดรับได้ก่อนทำรายการทุกครั้ง",
    note: "ตรวจรอบเวลาก่อนแทง",
    icon: "🏮",
  },
  {
    name: "หวยลาวพัฒนา",
    detail: "เปิดรับผ่านหน้าเดียวกับรายการอื่น ติดตามหวยหลายประเภทได้จากหน้าเดียวโดยไม่ต้องเปลี่ยนหลายเว็บไซต์",
    note: "ติดตามจากหน้าเดียว",
    icon: "🎫",
  },
];

// 365LOTTO palette (แดง-ทอง-เงินโครเมียม): การ์ดพื้นการ์ด #1a0709 ในกรอบพื้นยก
// #2a0b0e ที่สว่างขึ้นเป็นทองหลัก #fadc64 ตอน hover ชื่อตลาดเป็นเงินโครเมียม
// #f3f6fa คำอธิบายเป็นสีรอง #d8bda6 และชิปด้านล่างไล่ทองสว่าง #fdf3b4 → ทองลึก
// #e0b03a ตัวอักษรบนชิปใช้สีพื้นเพจ #120406 — ชุดกรมท่า-ทองของหวยพยัคฆ์ (#030b1c
// #08152f #0f2149 #1c3566 #e8eef8 #9fb0d0 #fadb6c #fdf5a4 #ab6d13) ออกทั้งหมด
---

<section aria-label={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับแทง`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f3f6fa] via-[#fadc64] to-[#e01f26] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ {BRAND_NAME} เปิดรับแทง
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fadc64] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#2a0b0e] bg-[#1a0709]/90 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fadc64]/65 hover:bg-[#2a0b0e] hover:shadow-[0_10px_30px_rgba(250,220,100,0.24)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(224,31,38,0.5)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#f3f6fa] transition-colors group-hover:text-[#fdf3b4]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#d8bda6]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#fdf3b4] to-[#e0b03a] px-4 py-1.5 text-center text-[11px] font-bold text-[#120406] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.note}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#d8bda6]">
    ทั้งสามรายการข้างต้นรวมอยู่ในระบบเดียวของ {BRAND_NAME} พร้อมแยกรอบเปิดรับของแต่ละประเภทไว้อย่างชัดเจน ผู้ใช้งานสามารถตรวจสอบเลข รอบเวลา และรายละเอียดของรายการก่อนยืนยัน ช่วยให้ติดตามหวยหลายประเภทได้จากหน้าเดียวโดยไม่ต้องเปลี่ยนหลายเว็บไซต์
  </p>
</section>
