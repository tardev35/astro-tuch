---
// The หวย types KINDEE365's brief names, and nothing else — exactly four:
// หวยรัฐบาลไทย, หวยลาวพัฒนา, หวยฮานอย และหวยหุ้นต่างประเทศ. The brief also says
// เวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของรอบนั้นควรตรวจสอบให้ครบก่อนยืนยันโพย
// เพราะแต่ละประเภทอาจมีเงื่อนไขต่างกัน — so no close time and no per-market rate
// is printed here. The only rates quoted anywhere on this page are the brief's
// own 3 ตัวบาทละ 1,000 และ 2 ตัวบาทละ 100, and they live in the rate tables of
// sections 4 and 5, not in this grid.
//
// The block title is a <p> and the <section> carries an aria-label: a product
// grid is chrome, so it never emits a heading tag.
const lottos = [
  { name: "หวยรัฐบาลไทย", detail: "เลือกรอบที่เปิดรับ ระบุเลขที่ต้องการและจำนวนเงินเดิมพัน แล้วตรวจรายละเอียดอีกครั้งก่อนยืนยันโพย", reward: "ตามรอบที่เปิดรับ", icon: "🏛️" },
  { name: "หวยลาวพัฒนา", detail: "เลือกประเภทการเดิมพันของรอบนั้น แล้วตรวจอัตราจ่ายและเลขอั้นที่ระบบแสดงก่อนส่งโพย", reward: "ตามรอบที่เปิดรับ", icon: "🎫" },
  { name: "หวยฮานอย", detail: "ดูเวลาเปิด-ปิดและเงื่อนไขของรอบที่ต้องการก่อนกรอกเลข เพราะแต่ละรอบอาจกำหนดไว้ไม่เหมือนกัน", reward: "ตามรอบที่เปิดรับ", icon: "🏮" },
  { name: "หวยหุ้นต่างประเทศ", detail: "อีกหนึ่งหมวดที่เลือกแทงได้ในระบบเดียวกับหวยประเภทอื่น ตามรอบที่เว็บไซต์เปิดให้บริการ", reward: "ตามรอบที่เปิดรับ", icon: "📈" },
];
---

<section aria-label="ประเภทหวยที่ KINDEE365 เปิดรับแทง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f8dc8c] via-[#e8bb4a] to-[#b98213] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ KINDEE365 เปิดรับแทง
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8bb4a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#1f6fd0]/60 bg-[#083163]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e8bb4a]/60 hover:bg-[#02153c] hover:shadow-[0_10px_30px_rgba(232,187,74,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(232,187,74,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#f8dc8c] transition-colors group-hover:text-[#e8bb4a]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#8fb3d9]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#f8dc8c] to-[#b98213] px-4 py-1.5 text-center text-[11px] font-bold text-[#010b26] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#8fb3d9]">
    เวลาเปิด-ปิด อัตราจ่าย เลขอั้น และวงเงินของหวยแต่ละประเภทและแต่ละรอบอาจแตกต่างกัน ควรยึดรายละเอียดที่ระบบของ KINDEE365 แสดง ณ เวลาส่งโพยเป็นหลักก่อนยืนยันโพยทุกครั้ง
  </p>
</section>
