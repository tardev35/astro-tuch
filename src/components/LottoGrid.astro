---
import { BRAND_NAME } from "../lib/brandProfile";

// หวยพยัคฆ์ (2026-09-22): สี่ตลาดที่ brief ระบุไว้ใต้ H1 และไม่มีมากกว่านั้น —
// รัฐบาลไทย, ฮานอย, ลาวพัฒนา และหวยหุ้นต่างประเทศ `detail` ประกอบจากประโยคของ
// brief เอง (รวมไว้ในระบบเดียว / เลือกดูรอบที่เปิดรับ / ตรวจสอบเลขที่ต้องการ /
// จัดการรายการได้จากหน้าเดียว / รายการที่เปิดรับต่างกันตามวันและช่วงเวลา)
// `note` เป็นชิปสรุปจากประโยคเดียวกัน ไม่ใช่อัตราจ่ายและไม่ใช่วันออกรางวัล —
// brief ไม่ได้ระบุวันออกรางวัลของตลาดไหนไว้เลย รอบก่อน (LOTTOKA) คิดวันออกรางวัล
// ขึ้นมาเอง ซึ่งเป็นข้อมูลที่ยืนยันไม่ได้ จึงไม่ยกมาใช้ต่อ ส่วนเรทเดียวที่เอกสาร
// มีคือ 2 ตัวจ่าย 100 กับ 3 ตัวจ่าย 1,000 และทั้งคู่อยู่ในหัวข้อ H3 ไม่ใช่ในกริดนี้
//
// The block title is a <p> and the <section> carries an aria-label: a market
// grid is chrome, so it never emits a heading tag at any level.
const lottos = [
  {
    name: "หวยรัฐบาลไทย",
    detail: "รายการหลักที่เปิดรับในระบบเดียวกับตลาดอื่น เลือกดูรอบที่เปิดรับและตรวจสอบเลขที่ต้องการก่อนยืนยันรายการได้จากหน้าเดียว",
    note: "ตรวจรอบที่เปิดรับ",
    icon: "🏛️",
  },
  {
    name: "หวยฮานอย",
    detail: "อีกหนึ่งรายการที่รวมไว้ในระบบเดียวกัน รายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา จึงควรดูรอบล่าสุดจากหน้ารวมหวยก่อนทำรายการ",
    note: "ดูรอบล่าสุดก่อนแทง",
    icon: "🏮",
  },
  {
    name: "หวยลาวพัฒนา",
    detail: "เปิดรับผ่านหน้าเดียวกับรายการอื่น เลือกประเภทการแทง ตรวจสอบรายละเอียดของบิล แล้วจัดการรายการของตัวเองได้จากหน้าเว็บไซต์",
    note: "จัดการจากหน้าเดียว",
    icon: "🎫",
  },
  {
    name: "หวยหุ้นต่างประเทศ",
    detail: "รายการหวยหุ้นที่รวมอยู่ในระบบเดียวกัน เหมาะกับคนที่ต้องการติดตามหวยหลายประเภทโดยไม่ต้องสลับหลายเว็บไซต์",
    note: "ติดตามได้ในที่เดียว",
    icon: "📈",
  },
];

// หวยพยัคฆ์ palette (กรมท่า-ทอง): การ์ดพื้นการ์ด #08152f ในกรอบน้ำเงินคั่น #1c3566
// ที่สว่างขึ้นเป็นทองหลัก #fadb6c ตอน hover ชื่อตลาดเป็นเงิน #e8eef8 คำอธิบายเป็น
// สีรอง #9fb0d0 และชิปด้านล่างไล่ทองสว่าง #fdf5a4 → ทองบรอนซ์ #ab6d13 ตัวอักษร
// บนชิปทองใช้สีพื้นเพจ #030b1c แดง LOTTOKA เดิมออกทั้งหมด
---

<section aria-label={`ประเภทหวยที่ ${BRAND_NAME} เปิดรับแทง`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8eef8] via-[#fadb6c] to-[#ab6d13] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ {BRAND_NAME} เปิดรับแทง
    </p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fadb6c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#1c3566] bg-[#08152f]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fadb6c]/60 hover:bg-[#0f2149] hover:shadow-[0_10px_30px_rgba(250,219,108,0.22)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(250,219,108,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#e8eef8] transition-colors group-hover:text-[#fdf5a4]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#9fb0d0]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#fdf5a4] to-[#ab6d13] px-4 py-1.5 text-center text-[11px] font-bold text-[#030b1c] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.note}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#9fb0d0]">
    ทุกประเภทข้างต้นรวมอยู่ในระบบเดียวของ {BRAND_NAME} เลือกดูรอบที่เปิดรับ ตรวจสอบเลขที่ต้องการ และจัดการรายการได้จากหน้าเดียว โดยรายการที่เปิดรับอาจแตกต่างกันตามวันและช่วงเวลา
    จึงควรตรวจสอบรอบล่าสุดจากหน้ารวมหวยก่อนทำรายการทุกครั้ง
  </p>
</section>
