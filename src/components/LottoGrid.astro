---
// The four หวย types the LEKDED docx actually names, and nothing else. The brief
// states only that วงเงินรับแทง, เลขอั้น, เวลาเปิด-ปิด and อัตราจ่าย differ per
// type and should be checked in the system for that round — so no payout rate,
// no close time and no เลขอั้น limit is printed here. Anything more specific
// than "ตรวจสอบข้อมูลที่ระบบแสดงในรอบนั้น" would be invented.
//
// The block title is a <p> and the <section> carries an aria-label: a product
// grid is chrome, so it never emits a heading tag.
const lottos = [
  { name: "หวยรัฐบาลไทย", detail: "เลือกเลขและกรอกจำนวนเงิน ตรวจรายละเอียดโพยก่อนยืนยันรายการผ่านมือถือ", reward: "ตามรอบที่เปิดให้บริการ", icon: "🏛️" },
  { name: "หวยลาว", detail: "ระบบแยกหมวดหมู่และรอบเดิมพันไว้ให้ตรวจสอบได้ง่ายก่อนส่งโพย", reward: "ตามรอบที่เปิดให้บริการ", icon: "🎫" },
  { name: "หวยฮานอย", detail: "เลือกประเภทการเดิมพันและตรวจข้อมูลของรอบนั้นก่อนกดยืนยัน", reward: "ตามรอบที่เปิดให้บริการ", icon: "🎯" },
  { name: "หวยหุ้น", detail: "อีกหนึ่งประเภทที่เลือกซื้อได้ในบัญชีเดียวกับหวยประเภทอื่น", reward: "ตามรอบที่เปิดให้บริการ", icon: "📈" },
];
---

<section aria-label="ประเภทหวยที่ LEKDED เปิดให้ซื้อ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff4cd] via-[#e2c466] to-[#b5811e] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยที่ LEKDED เปิดให้ซื้อ
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2c466] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#7a5d2c]/40 bg-[#0b1405]/80 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e2c466]/60 hover:bg-[#123209] hover:shadow-[0_10px_30px_rgba(226,196,102,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(226,196,102,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#fff4cd] transition-colors group-hover:text-[#fbe479]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#a89a6b]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#e2c466] to-[#fbe479] px-4 py-1.5 text-center text-[11px] font-bold text-[#030803] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs leading-relaxed text-[#a89a6b]">
    วงเงินรับแทง เลขอั้น เวลาเปิด-ปิด และอัตราจ่ายของหวยแต่ละประเภทอาจแตกต่างกัน ควรตรวจสอบข้อมูลที่ระบบแสดงในรอบนั้นก่อนส่งโพยทุกครั้ง
  </p>
</section>
