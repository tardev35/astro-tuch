---
// Bet types only. The brief states 2 ตัว / 3 ตัว / เลขอั้น / วิ่งบน-วิ่งล่าง and a
// maximum payout of 1,000 for 3 ตัว — no market list, no close times, no other
// rates. Anything more specific than "ตามเรทที่ระบบแสดง" would be invented.
const lottos = [
  { name: "หวย 2 ตัว", detail: "เลือกเลขบนหรือเลขล่าง", reward: "ตามเรทที่ระบบแสดง", icon: "🎱" },
  { name: "หวย 3 ตัว", detail: "ใส่เลขและยอดแทงได้ในโพยเดียว", reward: "จ่ายสูงสุด 1,000", icon: "🎯" },
  { name: "เลขอั้น", detail: "วงเงินรับของเลขนั้นแสดงก่อนยืนยัน", reward: "ตามเรทที่ระบบแสดง", icon: "🚦" },
  { name: "วิ่งบน", detail: "เลขวิ่งตำแหน่งบน", reward: "ตามเรทที่ระบบแสดง", icon: "⬆️" },
  { name: "วิ่งล่าง", detail: "เลขวิ่งตำแหน่งล่าง", reward: "ตามเรทที่ระบบแสดง", icon: "⬇️" },
];
---

<section aria-label="ประเภทการแทงหวยที่ HSOD เปิดรับ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eef1f6] via-[#ff4d55] to-[#e8121d] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทการแทงหวยที่ HSOD เปิดรับ
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8121d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-start overflow-hidden rounded-2xl border border-[#7c0207]/30 bg-[#170406]/75 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e8121d]/60 hover:bg-[#2a0508] hover:shadow-[0_10px_30px_rgba(232,18,29,0.25)]">
          <span aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(232,18,29,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </span>
          <p class="text-center text-sm font-bold text-[#eef1f6] transition-colors group-hover:text-[#ff4d55]">{lotto.name}</p>
          <p class="mt-1 text-center text-[11px] leading-relaxed text-[#aeb6c2]">{lotto.detail}</p>
          <p class="mt-3 rounded-full bg-gradient-to-r from-[#e8121d] to-[#ff4d55] px-4 py-1.5 text-center text-[11px] font-bold text-[#1a0204] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </p>
        </div>
      ))
    }
  </div>
</section>
