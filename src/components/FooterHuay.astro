---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const logoAlt = "โลโก้ 365LOTTO ตัวเลข 365 สีทองสามมิติ ต่อด้วยคำว่า LOTTO สีขาวโครเมียมที่ตัว O ทั้งสองเป็นวงสีแดง";

// 365LOTTO (รอบแดง-ทอง 2026-09-24): พื้นแดงเกือบดำ #120406 ขอบและเส้นคั่นทองลึก
// #9c6a12 ออร่าบนเป็นทอง #fadc64 ตัวอักษรรองสีครีมอุ่น #d8bda6 — สีกรมท่า
// #030b1c/#0f2149 กับ #dbe4f7/#9fb0d0 ของ หวยพยัคฆ์ รอบก่อนไม่เหลือแล้ว
//
// /ตรวจหวย และ /แนวทาง ไม่อยู่ในรายการทางลัดรอบนี้ เพราะสองไฟล์นั้นอยู่ใน
// src/pages-disabled/ ตามสถานะ toggle ที่ operator ตั้งไว้ — ลิงก์ค้างไว้จะกลาย
// เป็น href ไป route ที่ไม่มีจริง ซึ่ง verify-build จะฟ้องเป็น error
//
// /ทางเข้า ไม่ได้อยู่ในเมนู navbar (toggle register/login เปิดอยู่) แต่ยังถูก
// route และ index อยู่ ลิงก์จาก footer จึงเป็นทางเดียวที่ผู้ใช้เข้าถึงหน้านั้นได้
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#9c6a12]/55 bg-[#120406] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(18,4,6,0.7)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#fadc64]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#fadc64]/20 bg-[#fadc64]/5 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[140, 280, 420]} sizes="140px" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="text-2xl font-black tracking-widest text-white italic">
                <span class="bg-gradient-to-r from-[#fdf3b4] via-[#fadc64] to-[#e0b03a] bg-clip-text text-transparent">365</span>
                <span class="bg-gradient-to-r from-[#f3f6fa] to-[#e01f26] bg-clip-text text-transparent">LOTTO</span>
              </p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#9c6a12]/60 pl-4 text-sm leading-relaxed text-[#d8bda6]">
          365LOTTO รวมทั้งหวยและคาสิโนไว้ในระบบเดียว มีให้เลือกตั้งแต่หวยรัฐบาลไทย ฮานอย ลาวพัฒนา ไปจนถึงบาคาร่า ไพ่ และสล็อต เลือกหมวดที่สนใจผ่านบัญชีเดียว
          ตรวจสอบรอบที่เปิดรับและอัตราจ่ายของแต่ละรายการได้จากหน้าเดียว โดยควรตรวจสอบเงื่อนไขของแต่ละรอบก่อนยืนยันทุกครั้ง
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-[#9c6a12]/50 bg-[#2a0b0e] px-4 py-1 text-xs font-bold text-[#f0ddc4] shadow-sm">2 ตัวจ่าย 100</span>
          <span class="rounded-full border border-[#fadc64]/40 bg-[#fadc64]/15 px-4 py-1 text-xs font-bold text-[#fadc64] shadow-sm">3 ตัวจ่าย 1,000</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#9c6a12]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d8bda6]">
          {shortcuts.map((item) => (
            <li>
              <a href={item.path} class="transition-colors hover:text-[#fadc64]">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#9c6a12]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อทีมงาน LINE 24 ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#d8bda6]">ระบบฝาก-ถอนอัตโนมัติ รองรับ:</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#9c6a12] pt-8 text-xs font-medium text-[#d8bda6] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} 365LOTTO ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-white">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
