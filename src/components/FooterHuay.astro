---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const logoAlt = "โลโก้ LOTTOKA ตัวอักษรหนาคำว่า LOTTO สีแดงเข้ม ต่อด้วย KA สีขาวที่มีเส้นขอบบางล้อมรอบ";

// LOTTOKA เป็นเว็บแทงหวยลอตโต้ — /ตรวจหวย และ /แนวทาง เปิดใช้งานรอบนี้ จึงมีลิงก์อยู่
// ส่วน /ทางเข้า ไม่ได้อยู่ในเมนู navbar (toggle register/login เปิดอยู่) แต่ยังถูก
// route และ index อยู่ ลิงก์จาก footer จึงเป็นทางเดียวที่ผู้ใช้เข้าถึงหน้านั้นได้
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#7d1114]/55 bg-[#0a0608] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(0,0,0,0.55)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#c21e22]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e2353a]/20 bg-[#e2353a]/5 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[140, 280, 420]} sizes="140px" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="text-2xl font-black tracking-widest text-white italic">
                <span class="bg-gradient-to-r from-[#e2353a] to-[#7d1114] bg-clip-text text-transparent">LOTTO</span>
                <span class="bg-gradient-to-r from-[#ffe9ea] to-[#bdb4b6] bg-clip-text text-transparent">KA</span>
              </p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#7d1114]/60 pl-4 text-sm leading-relaxed text-[#bdb4b6]">
          LOTTOKA เว็บแทงหวยออนไลน์แพลตฟอร์มหลักเว็บตรง ไม่ผ่านเอเย่นต์ เปิดรับหวยรัฐบาลไทย หวยลาว หวยออมสิน หวยฮานอย และหวยหุ้น ทุกยอดฝาก-ถอนโอนเข้าบัญชีของบริษัทโดยตรง
          ไม่ผ่านบุคคลที่สาม รับยอดเข้าเต็ม 100% ไม่หักค่าธรรมเนียม
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-[#7d1114]/50 bg-[#1c0d0f] px-4 py-1 text-xs font-bold text-[#ded9da] shadow-sm">ฝากถอนออโต้</span>
          <span class="rounded-full border border-[#e2353a]/40 bg-[#e2353a]/15 px-4 py-1 text-xs font-bold text-[#ff8a8d] shadow-sm">ยอดเข้าบัญชีบริษัทโดยตรง</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#7d1114]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#bdb4b6]">
          {shortcuts.map((item) => (
            <li>
              <a href={item.path} class="transition-colors hover:text-[#ff8a8d]">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#7d1114]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อทีมงาน LINE 24 ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#bdb4b6]">ระบบฝาก-ถอนอัตโนมัติ รองรับ:</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#7d1114] pt-8 text-xs font-medium text-[#bdb4b6] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} LOTTOKA ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-white">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
