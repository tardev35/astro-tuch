---
import { Picture } from "astro:assets";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// alt บรรยายอาร์ตเวิร์กจริงของดรอป 2026-10-27 (เปิดไฟล์ด้วย Read แล้ว ไม่ได้คัดลอก
// ของรอบก่อน): เวิร์ดมาร์กสามมิติ ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินตัดขอบแดง
// ครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงา
// (เขียนเป็นคำบรรยายรูปแบบ ไม่พิมพ์ชื่อแบรนด์ซ้ำ — ชื่อมาจาก BRAND_NAME)
const logoAlt = `โลโก้ ${BRAND_NAME} เวิร์ดมาร์กสามมิติแบบเซอริฟตัวหนา ครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบเส้นสีแดงเลือดนก ครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงาที่มีแถบแสงสะท้อนสีขาวพาดกลาง ตัดขอบขาว`;

// ───────────────────────────────────────────────────────────────────────────
// รอบ 2026-10-27 — พาเลตตาม .claude/brand-spec-lotto189.md §2
// **ธีมรอบนี้คือ "เนื้อหาสว่าง โครมเข้ม"** พื้นเพจเป็น #fff0f0 (จาก bg.json)
// แต่ footer คือ "โครม" = พื้นเข้มตัวอักษรสว่าง ทำหน้าที่เป็นกรอบโปสเตอร์ปิดท้ายหน้า
// **ห้าม "แก้" ให้ footer สว่างตามพื้นเพจ** และบล็อก <address> ด้านล่าง paste
// verbatim ตาม playbook ซึ่งออกแบบมาสำหรับ footer เข้มพอดี — **ห้ามทาสีทับมัน**
//
// ค่าที่ใช้ในไฟล์นี้ (ห้ามใช้ค่าอื่น):
//   พื้นชั้นลึก #120307 (พื้นของ footer) · พื้นชั้นยก #3d0d16 (การ์ด/ชิป)
//   ตัวอักษรหลัก #ffeaea (17.9:1 บน #120307 · 12.0:1 บน #3d0d16) · ขาว #ffffff
//   ทองอำพัน #e9b53c (10.7:1 หัวคอลัมน์/ลิงก์ hover) · เส้น #7e1221
//   ไล่เฉดปุ่ม #8a0412 -> #b00718 -> #d61023 คู่หมึกขาว (10.4 / 7.3 / 5.3:1)
//   rgba ที่อนุญาต: rgba(233,181,60,α) rgba(176,7,24,α) rgba(18,3,7,α) rgba(0,0,0,α)
//
// ⚠️⚠️ ธีมเดิมของไฟล์นี้คือ **รวย168 ดำ/ทอง** (070707 1c1a16 f3ece0 ffd94a e3a712
// b07d08 0a0a0a) และก่อนหน้านั้น **สาธุ168 เขียวมรกต/ทองสัมฤทธิ์** (061f0c 0c3a16
// c9cb63 aeb04a 9ba03c e9fbdd 0b7d28) · เจ้าของชุด *Huay เดิม (cd9a2c fdeb7c ab7314
// f5e7c8 fcd4c3 fce2d4 0c0b0a 120a02 1c140b 5c3f12) · หวย365 (140203 dc0203 f5282a
// ffc93c ffeab0 8c0402 3a0a0c c08a07 f6e7e0 1a0303) · มีทรัพย์168 (dd1b74 a4186b
// 4a0d35 2d0720 f7dcf6 f0ccf5) — ไม่มีค่าใดเหลืออยู่แล้ว
// 🚨🚨 **รอบนี้เป็นแบรนด์แดงจริง ซึ่งกลับทิศจากคำเตือนของรอบก่อนที่ห้ามแดงทุกเฉด**
// แต่แดงของรอบนี้ต้องเป็น **#b00718 / #c1071b / #8a0412 / #d61023 เท่านั้น**
// ห้ามเป็นแดงคริมสันของ มาดาม168 (ff2e52 e01238 c9102f) หรือแดงอิฐของ MEXICANOSLOT
// (de2b1e a81410 c81e12 9d140c) หรือแดงของ หวย365 (dc0203 f5282a) —
// **เทียบให้ตรงหกหลักกับ brand-spec §2 ห้ามตัดสินด้วยสายตา**
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// ⚠️ เขียว #00B900 -> #009900 บนปุ่ม LINE เป็น **สีของแบรนด์ LINE** ไม่ใช่สีของ
// แบรนด์นี้ ห้ามเปลี่ยนเป็นแดง
//
// 🚨🚨 **รอบนี้ถอด BankStrip ออกจาก footer โดยตั้งใจ** — บรีฟรอบนี้
// (src/assets/content.txt) **ไม่มีหมวดฝากถอน ธนาคาร หรือวอลเลทเลยแม้แต่คำเดียว**
// ต่างจากเจ้าของไฟล์เดิม (รวย168) ที่บรีฟมีหมวดนั้น การคง BankStrip ไว้จะเป็นการ
// ประกาศบริการที่บรีฟไม่ได้พูดถึง และคำว่า "ทรูมันนี่" ที่เคยอยู่ใต้แถบนั้นเป็น
// **คำของแบรนด์ก่อนๆ (okkub88 / โบ๊ะบ๊ะ168)** ซึ่งห้ามเขียนกลับเข้ามา
// ที่มาแทนคือชิปสี่ตลาดหวย ซึ่งเป็นสี่รายการที่บรีฟรอบนี้ระบุไว้ตรงตัว
// ⚠️ BankStrip.astro ยังอยู่ครบในฐานะ inventory ของแบรนด์ถัดไป **ห้ามลบไฟล์**
//
// เนื้อความเขียนใหม่จากคลังคำของบรีฟรอบนี้เท่านั้น:
// แนะนำเว็บหวยลอตโต้ · แทงหวยออนไลน์ · แทงหวยจ่ายสด · หวยรัฐบาลไทย · หวยลาว ·
// หวยฮานอย · หวยหุ้นต่างประเทศ · จ่ายเต็ม · จ่ายสด · รับทุกเลข · ไม่มีอั้นเลข ·
// อัตราจ่าย 2 ตัว 100 · 3 ตัว 1,000 · รอบประกาศผล · รอบปิดรับ · ฐานเงินเดิมพัน ·
// วงเงินจ่ายสูงสุด · ยืนยันบิล · บิลหวย · หมายเลขรายการ · บัญชีแอบอ้าง ·
// เจ้าหน้าที่ · แอดมิน · 24ชม.
// ⚠️⚠️ **หวยออมสิน / สลากกินแบ่งรัฐบาล / บาทละ 1,000 ไม่มีในบรีฟรอบนี้**
// (เจ้าของไฟล์เดิมมี) — บรีฟรอบนี้ระบุสี่ประเภทเท่านั้น:
// **รัฐบาลไทย · ลาว · ฮานอย · หุ้นต่างประเทศ**
// ⚠️⚠️ **คืนยอดเสีย 0.3% / แนะนำเพื่อน 0.8% เป็นคอปปี้ของ ZNOVA168 รอบก่อน**
// ถอดออกจากแถวชิปแล้ว — สองตัวเลขนั้นพิมพ์อยู่บนสไลด์จริง จึงเขียนได้เฉพาะใน alt
// ของสไลด์เท่านั้น **ห้ามเป็นคำกล่าวอ้างในคอปปี้ที่ไหนทั้งสิ้น**
// ⚠️ ตัวเลขที่ขึ้นเว็บได้รอบนี้มีแค่ **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.**
// ห้ามแต่งอัตราจ่าย/ชื่อตลาดหวย/ปีก่อตั้ง/จำนวนสมาชิกขึ้นเอง และ **ห้ามเขียน 100%**
//
// รายการทางลัดตรงกับเมนูของ NavbarHuay แล้วเติม /ทางเข้า /terms /privacy
// ทุก href ชี้ไปไฟล์ที่มีจริงใน src/pages/ (เช็กแล้วทั้งรายการ) — /ตรวจหวย กับ
// /แนวทาง อยู่ในรายการเพราะรอบนี้เป็นเว็บหวยและสองไฟล์นั้นถูกย้ายกลับเข้า
// src/pages/ แล้ว ลิงก์กับไฟล์ต้องมาคู่กันเสมอ ไม่งั้น verify-build จะฟ้อง href
// ที่ชี้ไป route ที่ไม่มี
//
// /ทางเข้า ไม่อยู่ในเมนู navbar รอบนี้ (toggle cta เปิด /login กับ /register เป็น
// หน้าปุ่มจริงแล้ว) แต่หน้ายัง route และ index อยู่ — ลิงก์ใน footer จึงเป็นทางเดียว
// ที่ยังชี้ไปถึง ห้ามถอดออกจากที่นี่ ไม่งั้นได้หน้าที่ถูก index แต่ไม่มีลิงก์ภายในเลย
const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

// สี่ตลาดนี้คือสี่รายการที่บรีฟรอบนี้ระบุไว้ตรงตัว (content.txt บรรทัด 4 และ 6)
// ไม่ใช่รายการที่แต่งขึ้นเอง และไม่มีรายการที่ห้าที่บรีฟไม่ได้เอ่ยถึง
const markets = ["หวยรัฐบาลไทย", "หวยลาว", "หวยฮานอย", "หวยหุ้นต่างประเทศ"];
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e9b53c]/55 bg-[#120307] pt-16 pb-8 font-sans text-[#ffeaea] shadow-[0_-10px_30px_rgba(18,3,7,0.85)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#b00718]/25 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e9b53c]/30 bg-[#3d0d16] p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[140, 280, 420]} sizes="140px" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="rounded-md bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#d61023] px-3 py-1 text-2xl font-black tracking-widest text-[#ffffff]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#e9b53c]/60 pl-4 text-sm leading-relaxed text-[#ffeaea]">
          {BRAND_NAME} นำเสนอข้อมูลหวยออนไลน์หลายประเภทไว้ในช่องทางเดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ โดยแต่ละรายการมีรอบปิดรับและรอบประกาศผลแตกต่างกัน
          สำหรับอัตราจ่ายที่ระบุไว้ว่า 2 ตัว 100 และ 3 ตัว 1,000 ควรตรวจสอบว่าคำนวณจากฐานเงินเดิมพันจำนวนเท่าใด ใช้กับหวยประเภทใดบ้าง และมีวงเงินจ่ายสูงสุดเท่าใด ก่อนยืนยันบิลทุกครั้ง
          หากพบปัญหาเกี่ยวกับบิลหวยหรือธุรกรรม ควรเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ และติดต่อเจ้าหน้าที่ผ่านช่องทางทางการเพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP
          ทั้งนี้ ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e9b53c]/40 bg-[#3d0d16] px-4 py-1 text-xs font-bold text-[#ffeaea] shadow-sm">จ่ายเต็ม จ่ายสด</span>
          <span class="rounded-full border border-[#e9b53c]/40 bg-[#b00718]/25 px-4 py-1 text-xs font-bold text-[#e9b53c] shadow-sm">รับทุกเลข ไม่มีอั้นเลข</span>
          <span class="rounded-full border border-[#e9b53c]/40 bg-[#3d0d16] px-4 py-1 text-xs font-bold text-[#ffeaea] shadow-sm">2 ตัว 100 · 3 ตัว 1,000</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12" aria-label="ทางลัดหน้าเว็บ">
        <p class="border-b border-[#e9b53c]/35 pb-2 text-lg font-black tracking-widest text-[#e9b53c] uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ffeaea]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="transition-colors hover:text-[#e9b53c]">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#e9b53c]/35 pb-2 text-lg font-black tracking-widest text-[#e9b53c] uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อแอดมิน {BRAND_NAME} ทาง LINE ตลอด 24ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#ffeaea]">ประเภทหวยที่ระบบเปิดรับ:</div>
        <ul class="flex flex-wrap gap-2 rounded-xl border border-[#e9b53c]/25 bg-[#3d0d16] p-3">
          {
            markets.map((market) => (
              <li class="rounded-lg border border-[#7e1221] bg-[#120307] px-3 py-1.5 text-xs font-bold text-[#ffeaea]">{market}</li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e9b53c]/35 pt-8 text-xs font-medium text-[#ffeaea] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME} ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#e9b53c]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#e9b53c]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#e9b53c]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
