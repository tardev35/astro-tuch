---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const logoAlt = "โลโก้ หวย365 ตัวอักษรเอียงหนาทึบบนพื้นขาว คำว่า หวย เป็นสีแดงสด ตามด้วยเลข 365 ที่สลับสีดำ แดง ดำ";

// หวย365 (รอบแดงสด-ทอง 2026-10-03): พื้นดำอมแดง #140203 ขอบบนแดงแบรนด์ #dc0203
// เส้นคั่นทองลึก #c08a07 (ใช้เป็นเส้น/ขอบเท่านั้น ห้ามเอาไปเป็นพื้นของตัวอักษร)
// ออร่าบนเป็นทองรอง #ffc93c ตัวอักษรรองเป็นครีมอมชมพู #f6e7e0 = BRAND_TEXT
// (~14:1 บนพื้น) ลิงก์ hover เป็นแดงสว่าง #f5282a — ชุดของ หวยเฮง789 ที่เคยอยู่ใน
// ไฟล์นี้ (#1c0606 #2b0909 #dc2224 #e43434 #f4bc5d #a8690c #fbe3d4) ออกครบทุกจุดแล้ว
//
// ย่อหน้าแนะนำเว็บเขียนใหม่จาก src/assets/content.txt ของ หวย365 ล้วน — บรีฟรอบนี้
// พูดถึง แนวทางหวย/กลุ่มหวย/สถิติหวยย้อนหลัง/ผลหวยตามรอบที่ประกาศ · รัฐบาลไทย
// ฮานอย ลาวพัฒนา หวยหุ้นต่างประเทศ · เลือกเลข ส่งโพย ตรวจสอบรายการผ่านมือถือ ·
// ตรวจเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย ก่อนเลือกแทง พร้อมคำกำกับที่บรีฟเขียนเอง
// ว่าสถิติย้อนหลังใช้ยืนยันเลขงวดถัดไปไม่ได้ (ห้ามตัดทิ้งเพราะฟังดูไม่ขายของ)
// ป้ายอัตราจ่ายสองอันตรงกับบรีฟพอดี (2 ตัว 100 / 3 ตัว 1,000)
//
// /ตรวจหวย และ /แนวทาง อยู่ในรายการทางลัดรอบนี้ เพราะสองไฟล์นั้นอยู่ใน
// src/pages/ (หวย365 เป็นเว็บหวย) — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ไม่งั้น verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// /ทางเข้า ไม่ได้อยู่ในเมนู navbar (toggle register/login เปิดอยู่) แต่ยังถูก
// route และ index อยู่ ลิงก์จาก footer จึงเป็นทางเดียวที่ผู้ใช้เข้าถึงหน้านั้นได้
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#dc0203]/55 bg-[#140203] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(8,1,1,0.75)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#ffc93c]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#ffc93c]/20 bg-[#ffc93c]/5 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[140, 280, 420]} sizes="140px" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="rounded-md bg-[#dc0203] px-3 py-1 text-2xl font-black tracking-widest text-white">หวย365</p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#c08a07]/60 pl-4 text-sm leading-relaxed text-[#f6e7e0]">
          หวย365 เว็บแทงหวยออนไลน์ที่รวมข้อมูลและรายการหวยไว้ในหน้าเดียว ทั้งแนวทางหวย กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศ สมาชิกติดตามได้ทั้งหวยรัฐบาลไทย ฮานอย ลาวพัฒนา
          และหวยหุ้นต่างประเทศตามตลาดที่เปิดให้บริการ พร้อมเลือกเลข ส่งโพย และตรวจสอบรายการผ่านมือถือได้สะดวก ก่อนเลือกแทงสามารถตรวจเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายของแต่ละรายการได้
          ทั้งนี้ข้อมูลสถิติย้อนหลังช่วยสำหรับย้อนดูผลในรอบที่ผ่านมา แต่ไม่สามารถใช้ยืนยันหรือรับประกันเลขที่จะออกในงวดถัดไปได้
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-[#c08a07]/50 bg-[#3a0a0c] px-4 py-1 text-xs font-bold text-[#f6e7e0] shadow-sm">2 ตัวจ่าย 100</span>
          <span class="rounded-full border border-[#ffc93c]/40 bg-[#ffc93c]/15 px-4 py-1 text-xs font-bold text-[#ffc93c] shadow-sm">3 ตัวจ่าย 1,000</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#c08a07]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f6e7e0]">
          {shortcuts.map((item) => (
            <li>
              <a href={item.path} class="transition-colors hover:text-[#f5282a]">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#c08a07]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อแอดมิน หวย365 ทาง LINE 24 ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#f6e7e0]">ช่องทางธุรกรรมที่ระบบรองรับ:</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#c08a07] pt-8 text-xs font-medium text-[#f6e7e0] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} หวย365 ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-white">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
