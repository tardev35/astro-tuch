---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const logoAlt = "โลโก้ หวยเฮง789 ตัวอักษรไทยสามมิติ คำว่า หวย เป็นสีแดงเลือดนกขอบทอง และคำว่า เฮง789 เป็นสีทองไล่เฉด";

// หวยเฮง789 (รอบแดงนำ-ทองรอง 2026-10-01): พื้นแดงเกือบดำ #1c0606 ขอบบนแดงแบรนด์
// #dc2224 เส้นคั่นทองลึก #a8690c (ใช้เป็นเส้น/ขอบเท่านั้น ห้ามเอาไปเป็นพื้นของ
// ตัวอักษร — ได้แค่ 3.8:1) ออร่าบนเป็นทองรอง #f4bc5d ตัวอักษรรองเป็นครีมอมส้ม
// #fbe3d4 = BRAND_TEXT (~14:1 บนพื้น) ลิงก์ hover เป็นแดงสว่าง #e43434 —
// ชุดของ LOTTOPLUS ที่เคยอยู่ในไฟล์นี้ (#dc020e #ff2d38 #f3c623 #8a6a0a #120b0c
// #2a0d0f #ddc7c7 #f0e2e2) ถูกแทนครบทุกจุดแล้ว
//
// ย่อหน้าแนะนำเว็บเขียนใหม่จาก src/assets/content.txt ของ หวยเฮง789 ล้วน —
// รอบก่อน (หวยเฮง24) เป็นเว็บหวยเหมือนกันแต่คนละบรีฟ: "ลาวพัฒนา" และ "ฝากถอน
// ผ่านวอลเลท/ธนาคาร" เป็นของบรีฟรอบก่อน บรีฟรอบนี้ไม่ได้ระบุทั้งสองอย่าง จึงถอด
// ออกทั้งคู่ และใช้ถ้อยคำของบรีฟรอบนี้แทน — รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ ·
// เลขเด็ด เลขดัง · เลือกเลขเอง ส่งโพย ตรวจผล ในบัญชีเดียว · รองรับมือถือ
// พร้อมคำกำกับเรื่องวงเงินที่บรีฟเขียนไว้เอง (ห้ามตัดทิ้งเพราะฟังดูไม่ขายของ)
// ป้ายอัตราจ่ายสองอันตรงกับบรีฟพอดี (2 ตัว 100 / 3 ตัว 1,000)
//
// /ตรวจหวย และ /แนวทาง อยู่ในรายการทางลัดรอบนี้ เพราะสองไฟล์นั้นอยู่ใน
// src/pages/ (หวยเฮง789 เป็นเว็บหวย) — ลิงก์กับไฟล์ต้องมาคู่กันเสมอ
// ไม่งั้น verify-build จะฟ้อง href ที่ชี้ไป route ที่ไม่มีจริง
//
// /ทางเข้า ไม่ได้อยู่ในเมนู navbar (toggle register/login เปิดอยู่) แต่ยังถูก
// route และ index อยู่ ลิงก์จาก footer จึงเป็นทางเดียวที่ผู้ใช้เข้าถึงหน้านั้นได้
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ตรวจหวย", path: "/ตรวจหวย" },
  { name: "แนวทาง", path: "/แนวทาง" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#dc2224]/55 bg-[#1c0606] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(11,2,2,0.7)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#f4bc5d]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f4bc5d]/20 bg-[#f4bc5d]/5 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[140, 280, 420]} sizes="140px" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="rounded-md bg-[#dc2224] px-3 py-1 text-2xl font-black tracking-widest text-white">หวยเฮง789</p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#a8690c]/60 pl-4 text-sm leading-relaxed text-[#fbe3d4]">
          หวยเฮง789 เปิดรับแทงหวยออนไลน์ผ่านหน้าเว็บไซต์ รวมหลายประเภทไว้ในบัญชีเดียว ทั้งรัฐบาลไทย ฮานอย ลาว และหวยหุ้นต่างประเทศ สมาชิกเลือกเลขเด็ด เลขดัง หรือชุดตัวเลขที่สนใจได้ด้วยตัวเอง
          พร้อมตรวจสอบรอบ อัตราจ่าย และรายละเอียดโพยก่อนยืนยันรายการ ระบบรองรับการใช้งานผ่านมือถือ ทั้งติดตามรอบหวย ส่งโพย และตรวจผลได้จากหน้าเดียว ทั้งนี้วงเงินที่รับได้ขึ้นอยู่กับประเภทหวย
          เลขแต่ละชุด และแต่ละรอบ จึงควรอ้างอิงวงเงินที่ระบบเปิดรับจริงก่อนส่งโพยทุกครั้ง
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-[#a8690c]/50 bg-[#2b0909] px-4 py-1 text-xs font-bold text-[#fbe3d4] shadow-sm">2 ตัวจ่าย 100</span>
          <span class="rounded-full border border-[#f4bc5d]/40 bg-[#f4bc5d]/15 px-4 py-1 text-xs font-bold text-[#f4bc5d] shadow-sm">3 ตัวจ่าย 1,000</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#a8690c]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fbe3d4]">
          {shortcuts.map((item) => (
            <li>
              <a href={item.path} class="transition-colors hover:text-[#e43434]">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#a8690c]/50 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อแอดมิน หวยเฮง789 ทาง LINE 24 ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#fbe3d4]">ช่องทางธุรกรรมที่ระบบรองรับ:</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a8690c] pt-8 text-xs font-medium text-[#fbe3d4] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} หวยเฮง789 ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-white">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
