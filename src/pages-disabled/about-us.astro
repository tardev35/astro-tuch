---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "UFA24K บริการคาสิโนออนไลน์ผ่านมือถือ สมัครสมาชิกง่าย รองรับสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ พร้อมระบบฝากถอนอัตโนมัติและทีมงานดูแลให้คำแนะนำตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ UFA24K คาสิโนออนไลน์บนมือถือ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout
  title="เกี่ยวกับเรา UFA24K คาสิโนออนไลน์บนมือถือ ฝากถอนออโต้ ทีมงานดูแลตลอด 24 ชม."
  description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับเรา" as="h1">
    <p class="text-left text-base leading-relaxed text-[#f0e6c8]">
      UFA24K พร้อมให้บริการเกมคาสิโนออนไลน์ผ่านมือถือสำหรับสมาชิกที่ต้องการความสะดวกในการเล่น ระบบรองรับการเข้าใช้งานผ่านสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ได้อย่างง่ายดาย พร้อมระบบฝากถอนอัตโนมัติที่เปิดให้บริการตลอด 24 ชั่วโมง ทำรายการได้ด้วยตัวเองโดยไม่ต้องรอแอดมิน และมีทีมงานคอยดูแลให้คำแนะนำตลอดการเดิมพัน เพื่อให้สมาชิกทุกคนเล่นเกมคาสิโนกับ UFA24K ได้อย่างมั่นใจในทุกขั้นตอน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
