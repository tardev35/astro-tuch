---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "การตรวจผลรางวัลของแต่ละประเภทหวย และการตรวจบิลของตัวเอง"
// ไม่มีตัวเลขของงวดใด ไม่มีตารางผล ไม่มีวันที่ และไม่มีการทำนายผลใด ๆ
// เว็บไซต์ไม่ใช่ผู้ประกาศผล — ผลรางวัลให้อ้างอิงแหล่งประกาศผลของประเภทนั้น
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น (รวย168):
// ประเภทหวยมีสี่ชื่อ — **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน**
// (บรรทัด 4, 6) · หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล และหวยออมสินเป็น
// รายการที่เกี่ยวข้องกับผลรางวัลออมสิน (บรรทัด 6) · แต่ละประเภทมีวันประกาศผล
// และรูปแบบการออกรางวัลแตกต่างกัน (บรรทัด 6) · อัตราจ่ายบาทละ 1,000 ต้องตรวจว่า
// ใช้กับการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุด เพราะไม่ใช่
// ทุกรายการที่ใช้อัตราเดียวกัน (บรรทัด 6, 25) · 2 ตัว 100 ต้องตรวจว่าเป็นสองตัวบน
// หรือสองตัวล่าง (บรรทัด 8) · 3 ตัว 1,000 ต้องตรวจว่าเป็นสามตัวตรงหรือสามตัวโต๊ด
// (บรรทัด 10) · คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% (บรรทัด 12, 14, 16) ·
// ฝากถอนผ่านธนาคารและทรูมันนี่ (บรรทัด 18) · แอดมิน 24ชม. เก็บหมายเลขรายการและ
// หลักฐาน ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ตรวจช่องทางติดต่อจากเว็บไซต์ทางการ
// เพื่อหลีกเลี่ยงบัญชีแอบอ้าง (บรรทัด 20, 27)
//
// ⚠️⚠️ **"หวยลาวพัฒนา" และ "หวยหุ้นต่างประเทศ" ไม่มีในบรีฟรอบนี้** — เป็นคำของ
// แบรนด์ที่เคยเป็นเจ้าของไฟล์นี้ ถอดออกครบแล้ว บรีฟรอบนี้ระบุสี่ประเภทข้างบน
// เท่านั้น ห้ามเติมประเภทอื่น (ธ.ก.ส. · ยี่กี · หวยหุ้น) และห้ามเติมสิ่งที่บรีฟ
// ไม่ได้ให้: ใบอนุญาต · หน่วยงานกำกับ · นิติบุคคล · ชื่อธนาคาร · ชื่อค่ายเกม ·
// เวลาประกาศผลเป็นตัวเลข · ตารางผลย้อนหลัง · ยอดขั้นต่ำเป็นตัวเลข · จำนวนสมาชิก ·
// ปีก่อตั้ง — ตัวเลขที่ขึ้นหน้าได้มีแค่ บาทละ 1,000 · 2 ตัว 100 · 3 ตัว 1,000 ·
// 0.3% · 0.8% · 24ชม.
// ⚠️ ห้ามใช้คำของแบรนด์ขาออก มาดาม168 (มาดาม · เกมสล็อตเปย์แรง · เปย์แรง ·
// จ่ายไม่มีอั้น · ไม่อั้น · เว็บสล็อต · สล็อตออนไลน์ · เกมสล็อต) และของเก่ากว่า
// (นาซ่า · เซิร์ฟไทย · อวกาศ · ไม่ผ่านม้า · บัญชีม้า)
//
// ⚖️ YMYL: คำกำกับของบรีฟเป็นเนื้อหาของหน้า ไม่ใช่ของตัดทิ้ง — ควรตรวจสอบความ
// ถูกต้องของข้อมูลก่อนทำรายการ เพราะเลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกัน
// ผลรางวัลในงวดถัดไปได้ (บรรทัด 4) · ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถ
// คาดการณ์ได้อย่างแม่นยำจากเลขย้อนหลัง (บรรทัด 10) · ยังไม่สามารถยืนยันได้ว่า
// ใช้อัตราเดียวกันกับหวยทุกประเภท (บรรทัด 25) · เครดิตคืนยอดเสียไม่ได้หมายความว่า
// จะได้รับเงินคืนจากทุกบิล (บรรทัด 14)
//
// CHROME: AnnouncementHuay · FaqHuay · LatestWinnersHuay — รอบนี้แบรนด์เองเป็น
// เว็บหวย ชุด *Huay จึงเป็นธีมหลักของทั้งเว็บ ไม่ใช่ซับธีมของสองหน้านี้อีกต่อไป
// (เรียก <Announcement /> แบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน
// ห้ามส่ง message prop · FaqHuay มี default faqs = [] จึงต้องส่ง prop faqs ทุกครั้ง)
//
// ธีม: ⚠️ ข้อยกเว้น Phase 4.5 คุ้มครอง **ชุดคอมโพเนนต์** เท่านั้น ไม่ได้คุ้มครอง
// พาเลตเก่าหรือชื่อแบรนด์เก่า — หน้านี้ใช้พาเลตของ brand-spec §2 เต็มรูปแบบ
// (ธีมมืด: พื้นเพจ #000000 จาก bg.json)
//   ผิวการ์ด #121110 (ตั้งโดย ContentBox) · ชั้นยก #1c1a16 · ชั้นจม #070707
//   เส้น hairline #3d3425 · เนื้อความ #f3ece0 (16.0:1 บนผิวการ์ด)
//   หัวข้อ/ไฮไลต์ <strong>/ป้าย ทอง #ffd94a (13.8:1) · หมึกรอง #bfb8aa ·
//   แพลทินัม #dde1e7 · โครเมียมเงิน #e8eaee
//   ปุ่มหลัก ไล่เฉด #ffd94a -> #e3a712 -> #b07d08 + **หมึกดำ #0a0a0a**
//   ปุ่ม outline ขอบ+ตัวอักษร #ffd94a บนผิว #070707
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1 — พื้นทองต้องใช้หมึกดำเท่านั้น**
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** ชุดแดง/ทองโบราณบนผิวขาวที่เคยอยู่ในไฟล์นี้
// (c30303 8f0505 e81313 4a0f0f fff1ef ffdbdb ffeee8 dcb95f b8862b 96681f)
// ถอดออกครบแล้ว รวมถึงเงา rgba ของแดงเก่า (195,3,3) และ (74,15,15) — แดงคือฮิวนำของ
// แบรนด์ขาออก (มาดาม168 คริมสัน) ปล่อยไว้ = ผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#f3ece0]` ไว้บนการ์ดแล้ว ทุกอย่าง
// ข้างในสืบทอดลงมา สีที่เขียนเองมีแค่ไฮไลต์บน <strong> (= #ffd94a)
//
// การ์ดขั้นตอนเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อของชุดการ์ด
// ไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ ContentBox3ThreeNeumorphism ก็เป็น
// คำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ จึงส่ง heading={false} ให้เป็น <p>
const steps = [
  {
    icon: "🔐",
    label: "เข้าสู่ระบบบัญชีสมาชิก",
    detail:
      "เข้าสู่ระบบด้วยบัญชีที่ใช้ทำรายการ ผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ บัญชีเดียวใช้เปิดเมนูตรวจบิลของหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสินได้ทั้งหมด",
  },
  {
    icon: "🎯",
    label: "เลือกประเภทหวยและงวดที่ต้องการตรวจ",
    detail:
      "เมนูตรวจบิลแสดงประเภทหวยไว้คู่กับงวดของรายการเสมอ ให้เลือกบรรทัดที่ตรงกับบิลที่ต้องการตรวจก่อน เพราะแต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน",
  },
  {
    icon: "🧾",
    label: "เทียบบิลหวยกับแหล่งประกาศผลของประเภทนั้น",
    detail:
      "บิลหวยบันทึกประเภทหวย งวด หมายเลขที่เลือก และอัตราจ่ายไว้ตั้งแต่ตอนยืนยันรายการ จึงนำไปเทียบกับผลที่ประกาศของประเภทและงวดเดียวกันได้ครบจากหน้าเดียว",
  },
];

const faqs = [
  {
    q: `ตรวจผลรางวัลและตรวจบิลกับ ${BRAND_NAME} ได้จากที่ไหน?`,
    a: "เข้าสู่ระบบบัญชีสมาชิกแล้วเปิดเมนูตรวจบิล ระบบจะแสดงประเภทหวย งวดของรายการ หมายเลขที่เลือก อัตราจ่าย และสถานะไว้ในที่เดียว บัญชีเดียวจึงใช้ตรวจบิลของหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสินได้เอง",
  },
  {
    q: `${BRAND_NAME} เป็นผู้ประกาศผลรางวัลเองหรือไม่?`,
    a: "ไม่ใช่ เว็บไซต์นำเสนอข้อมูลประเภทหวยที่เปิดให้บริการ รอบปิดรับ อัตราจ่าย และรายละเอียดของบิลที่สมาชิกทำไว้ ส่วนผลรางวัลของแต่ละงวดให้อ้างอิงแหล่งประกาศผลของประเภทนั้นเป็นหลัก หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล และหวยออมสินเป็นรายการที่เกี่ยวข้องกับผลรางวัลออมสิน",
  },
  {
    q: "หวยแต่ละประเภทประกาศผลคนละวันกันหรือไม่?",
    a: "แต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน จึงควรอ่านรอบปิดรับและวันประกาศผลที่ระบบแสดงบนรายการนั้นให้ชัดเจนก่อนทำรายการ และตรวจสอบจากประกาศล่าสุดของเว็บไซต์ทางการอีกครั้ง เพราะงวดของแต่ละประเภทไม่ได้ตรงกัน",
  },
  {
    q: "อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ใช้ได้กับหวยทุกประเภทหรือไม่?",
    a: "ยังไม่สามารถยืนยันได้ว่าใช้อัตราเดียวกันกับหวยทุกประเภท ควรตรวจสอบตารางอัตราจ่าย ฐานเงินเดิมพัน วงเงินจ่ายสูงสุด และข้อจำกัดการรับหมายเลขของแต่ละรายการจากข้อมูลล่าสุดก่อนยืนยันบิล และให้ยึดอัตราจ่ายที่ระบบแสดงบนรายการตอนยืนยัน เพราะเป็นค่าที่ถูกบันทึกลงในบิลนั้นจริง",
  },
  {
    q: `ตรวจบิลไม่ได้ ติดต่อ ${BRAND_NAME} อย่างไร?`,
    a: "ตรวจสอบสถานะรายการในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม. พร้อมแจ้งประเภทหวย งวดของรายการ และหมายเลขรายการ โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 152 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีตรวจผลรางวัลหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยออมสิน พร้อมวิธีตรวจบิลและเก็บหมายเลขรายการไว้อ้างอิงจากแหล่งประกาศผลของแต่ละประเภท`;

const pageHeading = `ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจบิล รัฐบาลไทย ลาว ฮานอย ออมสิน`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ตรวจผลรางวัลและตรวจบิลหวยทุกประเภท`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#ffd94a]">{BRAND_NAME}</strong> นำเสนอข้อมูลหวยออนไลน์หลากหลายประเภทไว้ในช่องทางเดียว ทั้งหวยรัฐบาลไทยที่อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาว หวยฮานอย
        และรายการที่เกี่ยวข้องกับผลรางวัลออมสิน โดยแต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัลแตกต่างกัน หน้านี้รวมวิธีใช้เมนูตรวจบิลของบัญชีตัวเอง ตั้งแต่การเลือกประเภทหวย
        การอ่านงวดและวันประกาศผล ไปจนถึงการเทียบหมายเลขในบิลกับแหล่งประกาศผลของประเภทนั้น
      </p>

      <p>
        <strong class="text-[#ffd94a]">หน้านี้ไม่ได้ประกาศผลรางวัลเอง และไม่ได้ชี้นำผลของงวดใด</strong> สิ่งที่ตรวจสอบได้จริงคือประเภทหวยที่เปิดให้บริการ รอบปิดรับ วันประกาศผล อัตราจ่าย
        และรายละเอียดของบิลที่ระบบบันทึกไว้ตอนยืนยันรายการ ส่วนผลรางวัลของแต่ละงวดให้อ้างอิงแหล่งประกาศผลของประเภทนั้นเป็นหลัก แล้วจึงนำมาเทียบกับหมายเลขรายการและตัวเลขที่อยู่ในบิล
        ควรตรวจสอบความถูกต้องของข้อมูลก่อนทำรายการทุกครั้ง เพราะเลขเด็ดหรือสถิติย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้
      </p>

      <p>
        สำหรับอัตราจ่ายที่ระบุว่า <strong class="text-[#ffd94a]">บาทละ 1,000</strong> ควรตรวจสอบว่าใช้กับการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงินจ่ายสูงสุด
        เพราะไม่ใช่ทุกรายการที่จะใช้อัตราจ่ายเดียวกัน เช่นเดียวกับ <strong class="text-[#ffd94a]">2 ตัว 100</strong> ที่ควรตรวจว่าใช้กับสองตัวบนหรือสองตัวล่าง และ
        <strong class="text-[#ffd94a]">3 ตัว 1,000</strong> ที่ควรตรวจว่าใช้กับสามตัวตรง สามตัวโต๊ด หรือรูปแบบใด ก่อนยืนยันบิลจึงควรอ่านตารางอัตราจ่ายและข้อจำกัดการรับหมายเลขให้ครบ
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ขั้นตอนตรวจผลรางวัลและตรวจบิลของตัวเอง">
    <div class="flex flex-col gap-6">
      <p>
        ลำดับด้านล่างเป็นลำดับเดียวกับที่ระบบเก็บข้อมูลไว้ คือเข้าบัญชี เลือกประเภทหวยและงวด แล้วจึงอ่านรายละเอียดของบิล ทำตามลำดับนี้จะตัดปัญหาการอ่านข้ามประเภทหรือข้ามงวดออกไปได้เกือบทั้งหมด
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลรางวัลและตรวจบิลด้วยตัวเอง">
        {
          steps.map((step, i) => (
