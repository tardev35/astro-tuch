---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// Steps a member follows to read their own bill after a draw. No draw result,
// no example winning number and no prediction lives on this page — the brief
// supports how the system is used, never what a result will be.
//
// This page keeps the red/gold Huay theme + AnnouncementHuay on purpose (the
// playbook's sanctioned exception for the หวย sub-section). Only the theme is
// exempt: the brand name follows the rebrand like everywhere else, so no earlier
// lottery brand's name may survive anywhere on this page or in its components.
const steps = [
  { icon: "🔐", label: "เข้าสู่ระบบ", detail: "เปิดบัญชีสมาชิกจากมือถือหรือคอมพิวเตอร์ แล้วเข้าหน้าประวัติโพย" },
  { icon: "🧾", label: "เปิดบิลที่ต้องการตรวจ", detail: "เลือกรอบและเลขที่ส่งไว้ ระบบแสดงยอดแทงและอัตราจ่ายที่บันทึกไว้ตอนส่งโพย" },
  { icon: "✅", label: "ดูสถานะรางวัล", detail: "เมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดที่เข้าบัญชีสมาชิก" },
];

// KINDEE365's brief DOES publish a rate — เลข 3 ตัว บาทละ 1,000 และเลข 2 ตัว
// บาทละ 100 — so this page may state it, but only paired with the brief's own
// caveat: ให้ยึดตัวเลขที่ระบบแสดงจริง ณ เวลาส่งโพย. Do not build a rate TABLE
// here; the tables belong to index.astro's two H3 sections. Nothing else about
// payouts may be claimed — no licence, no registration, no guaranteed return.

const faqs = [
  {
    q: "ตรวจโพย KINDEE365 ย้อนหลังได้ที่ไหน",
    a: "เปิดประวัติโพยในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรอบที่ส่ง เลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนส่งโพย ทำให้เทียบกับสถานะที่ระบบอัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "โพยที่ถูกรางวัลคิดยอดตามเรทเท่าไร",
    a: "อัตราจ่ายที่กำหนดไว้คือเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 โดยยอดตามเรทจะคำนวณจากอัตราจ่ายที่ระบบแสดงบนหน้าส่งโพย ณ ตอนที่คุณกดยืนยันรายการ และอัตรานั้นจะถูกบันทึกไว้ในบิลของรอบนั้น จึงเปิดดูย้อนหลังได้ว่าคิดจากเรทเท่าไร ควรตรวจสอบตัวเลขที่แสดงจริงก่อนกดยืนยันทุกครั้ง",
  },
  {
    q: "สถานะบิลไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร",
    a: "ตรวจสอบประวัติโพยหรือธุรกรรมในบัญชีก่อน หากยังพบความผิดปกติ ให้ติดต่อเจ้าหน้าที่ KINDEE365 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน ประเภทหวย และรายละเอียดรายการ เพื่อให้ตรวจสอบต่อได้ตรงจุด",
  },
];

// Passed explicitly rather than letting AnnouncementHuay's default render: a
// ticker default is the classic place a previous brand's slogan survives a
// rebrand unnoticed. The component's default is kept in step with this string.
const announcement =
  "KINDEE365 เปิดรับแทงหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ ตามรอบที่เปิดบริการ อัตราจ่ายที่กำหนดไว้คือเลข 3 ตัวบาทละ 1,000 และเลข 2 ตัวบาทละ 100 ควรตรวจสอบตัวเลขที่ระบบแสดงจริงก่อนยืนยันโพยทุกครั้ง เลือกประเภทหวย ส่งโพย และเช็กประวัติรายการได้เองจากบัญชีสมาชิก ฝากถอนระบบออโต้รองรับทั้งธนาคารและวอลเลทตามช่องทางที่เปิดให้บริการ เจ้าหน้าที่ KINDEE365 รับเรื่องตลอด 24 ชั่วโมง";

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 157.
const pageDescription = "ตรวจหวย KINDEE365 วิธีเช็กผลรางวัลและตรวจโพยย้อนหลังด้วยตัวเองจากบัญชีสมาชิก พร้อมวิธีอ่านสถานะบิล ยอดตามอัตราจ่าย และขั้นตอนแจ้งเจ้าหน้าที่เมื่อรายการไม่ตรง";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย KINDEE365 เช็กผลรางวัลและสถานะโพยด้วยตัวเอง",
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย KINDEE365 เช็กผลรางวัล ประวัติบิล และยอดตามเรทด้วยตัวเอง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <section class="mx-auto my-8 w-full max-w-5xl px-4">
    <div class="relative isolate overflow-hidden rounded-3xl border border-[#c1121f]/50 bg-[#3d0b0e]/90 p-8 shadow-[0_15px_40px_rgba(227,197,106,0.2)] backdrop-blur-xl md:p-12">
      <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-64 w-64 rounded-full bg-[#e3c56a]/15 blur-[60px]"></div>
      <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-64 w-64 rounded-full bg-[#1c6b3f]/30 blur-[60px]"></div>

      <div class="flex w-full flex-col items-center">
        <span aria-hidden="true" class="mb-4 text-5xl drop-shadow-[0_0_15px_rgba(227,197,106,0.8)]">🧾</span>
        <h1 class="mb-3 bg-gradient-to-r from-[#f7e8b4] via-[#e3c56a] to-[#8a6a26] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">ตรวจหวย KINDEE365</h1>
        <p class="w-full text-left text-base leading-relaxed text-[#f4e7d3]">
          หน้านี้อธิบายวิธีเช็กผลรางวัลและตรวจโพยของคุณเองกับ KINDEE365 ตั้งแต่เปิดประวัติบิล ดูเลขและยอดที่ส่งไว้ ไปจนถึงการอ่านสถานะรางวัลและยอดที่เข้าบัญชี ครอบคลุมทั้งหวยรัฐบาลไทย หวยลาวพัฒนา
          หวยฮานอย และหวยหุ้นต่างประเทศตามรอบที่เปิดบริการ เว็บไซต์ไม่ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลประกาศ ส่วนเวลาเปิด-ปิดรับ อัตราจ่าย เลขอั้น
          และวงเงินต่างกันตามประเภทหวยและรอบ จึงให้ยึดข้อมูลที่ระบบแสดงบนหน้าส่งโพยเป็นหลัก
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจโพยด้วยตัวเองสามขั้นตอน">
        {
          steps.map((step, i) => (
            <div class="flex flex-col gap-2 rounded-2xl border border-[#c1121f]/40 bg-[#1a0405]/60 p-5 transition-colors hover:border-[#e3c56a]/50">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#f7e8b4] to-[#8a6a26] text-sm font-black text-[#1a0405]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#f7e8b4]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#cbaa8d]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#8a6a26] via-[#e3c56a] to-[#8a6a26] px-8 py-4 font-black text-[#1a0405] shadow-[0_5px_15px_rgba(227,197,106,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#2a9d5c]/60 bg-[#0d3a22] px-8 py-4 font-bold text-[#f7e8b4] shadow-[0_5px_15px_rgba(42,157,92,0.25)] transition-colors hover:bg-[#1c6b3f]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก KINDEE365
        </a>
      </div>
    </div>
  </section>

  <ContentBoxHuay title="ขั้นตอนตรวจโพย KINDEE365 หลังผลรางวัลประกาศ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f4e7d3]">
        เมื่อผลของรอบที่คุณส่งโพยไว้ถูกประกาศแล้ว ให้เทียบเลขในบิลกับผลตามประเภทที่แทงจริง เพราะเลขชุดเดียวกันใช้ตัดสินคนละประเภทกัน
        การอ่านผิดประเภทคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล สมาชิก KINDEE365 เปิดดูบิลย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งรอบที่ส่ง เลขที่เลือก ยอดแทง
        และอัตราจ่ายที่แสดงไว้ตอนยืนยันรายการ จึงตรวจย้อนกลับได้ว่ารายการที่ส่งไปตรงกับที่ตั้งใจหรือไม่ เมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดตามเรทที่ปล่อยเข้าบัญชีให้ถอนได้
        ระหว่างรอตรวจสอบ ควรเก็บข้อมูลบิลไว้จนกว่ารายการจะเสร็จสมบูรณ์ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ยอดตามเรทคำนวณจากอัตราจ่ายที่บันทึกไว้ในบิล" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f4e7d3]">
        อัตราจ่ายที่ KINDEE365 กำหนดไว้คือ <strong class="text-[#f7e8b4]">เลข 3 ตัว บาทละ 1,000 และเลข 2 ตัว บาทละ 100</strong> ใช้คำนวณยอดเบื้องต้นก่อนส่งโพยได้ แต่ยอดตามเรทของโพยที่ถูกรางวัลจะคิดจากอัตราจ่ายที่ระบบแสดงบนหน้ายืนยันโพย
        ณ ตอนที่คุณกดส่งรายการ ไม่ใช่จากตัวเลขที่จำมาจากรอบก่อน อัตรานั้นจะถูกบันทึกลงในบิลพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดแทง จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร และเทียบกับยอดที่เข้าบัญชีหลังระบบตรวจสอบเสร็จได้โดยตรง
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#f4e7d3]">
        เวลาเปิด-ปิดรับ อัตราจ่าย เลขอั้น และวงเงินที่รับได้ต่างกันตามประเภทหวยและรอบ ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ จึงควรอ่านตัวเลขที่ KINDEE365
        แสดงไว้จริงบนหน้าส่งโพยให้ครบก่อนกดยืนยันทุกครั้ง เมื่อส่งโพยสำเร็จแล้วบิลจะถูกเก็บไว้ในประวัติ ไม่ลบบิล ไม่เบี้ยวโพย จึงเทียบย้อนหลังได้เสมอ
      </p>
    </div>
  </ContentBoxHuay>

  <LatestWinnersHuay />

  <ContentBoxHuay title="โพยหรือรายการฝากถอนมีปัญหา แจ้งเจ้าหน้าที่ KINDEE365 ได้ 24 ชั่วโมง" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f4e7d3]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง ฝากเงินแล้วเครดิตไม่เข้า ถอนเงินค้าง เข้าสู่ระบบไม่ได้ หรือพบยอดในบิลไม่ตรงกับรายการ ให้ตรวจสอบประวัติโพยและประวัติธุรกรรมในบัญชีก่อนเป็นอันดับแรก
        เพราะรายการส่วนใหญ่อธิบายได้จากข้อมูลที่ระบบบันทึกไว้แล้ว หากยังพบความผิดปกติ ติดต่อเจ้าหน้าที่ KINDEE365 ได้ตลอด 24 ชั่วโมง พร้อมแจ้งประเภทหวย รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดธุรกรรม
        เพื่อให้ตรวจสอบได้ตรงจุด สมาชิกควรเก็บข้อมูลบิลและหลักฐานการทำรายการไว้จนกว่าปัญหาจะได้รับการตรวจสอบเสร็จสิ้น ส่วนการฝากถอนผ่านระบบออโต้ของธนาคารหรือวอลเลทที่รองรับ สามารถตรวจสอบยอด ส่งคำขอถอน
        และติดตามสถานะได้ด้วยตัวเองจากบัญชีสมาชิกตลอดเวลา และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>
    </div>
  </ContentBoxHuay>

  <FaqHuay title="คำถามที่พบบ่อยเรื่องการตรวจหวยกับ KINDEE365" faqs={faqs} />

  <Navfoot />
</MainLayout>
