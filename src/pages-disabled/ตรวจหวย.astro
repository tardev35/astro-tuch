---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้ว่าด้วย "วิธีดูผลหวยตามรอบที่ประกาศและตรวจสถานะโพยของตัวเอง" — ไม่มีผลรางวัล
// จริง ไม่มีวันที่งวด ไม่มีตัวเลขของงวดใด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ เว็บไม่ได้
// เป็นผู้ประกาศผล ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภทเป็นหลัก และถ้ารายการนั้น
// มีหลายรอบต่อวัน ต้องเทียบชื่อรายการกับเวลาของรอบให้ตรงก่อนคำนวณผลรางวัล
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมแนวทางหวย
// กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว ครบทั้งหวยรัฐบาลไทย
// หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศ (ลำดับตามบรีฟ) · ตรวจสอบเวลาเปิดรับ
// เวลาปิดรับ อัตราจ่าย และผลของแต่ละรายการได้ก่อนเลือกแทง · เลือกเลข ส่งโพย และ
// ตรวจสอบรายการผ่านมือถือ · อัตราจ่ายของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท
// และ 3 ตัว จ่าย 1,000 บาท ซึ่งแต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกัน
// จึงต้องยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยก่อนยืนยัน · สมัคร 3 ขั้นตอน · แอดมิน
// ติดต่อได้ 24 ชั่วโมง
//
// เฮดจ์ของบรีฟที่ต้องอยู่บนหน้านี้เสมอ: สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบ
// ไม่สามารถรับประกันหรือยืนยันเลขที่จะออกในงวดถัดไปได้ (content.txt L4, L7, L24)
//
// มุมของบรีฟรอบก่อน (เลขเด็ด · เลขดัง · ไม่จำกัด / แทงได้ไม่อั้น · "หวยลาว" เฉย ๆ ·
// ฮานอยปกติ/พิเศษ/วีไอพี · ฝากถอนวอลเลท · เช็คผลทันที) ไม่ได้อยู่ในบรีฟรอบนี้ จึงไม่
// ปรากฏบนหน้านี้ ห้ามเติมผลรางวัล วันที่งวด ตัวเลขสถิติจริง เวลาออกรางวัลรายรายการ
// ใบอนุญาต ชื่อธนาคาร ยอดฝาก-ถอนขั้นต่ำ หรือตัวเลขอื่นนอกชุด 2 ตัว 100 /
// 3 ตัว 1,000 / 3 ขั้นตอน / 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ brand-spec §3 / SKILL.md Phase 4.5
// ข้อ 5: รูปทรงแดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ และยังใช้
// AnnouncementHuay ต่อ ไม่สลับไป AnnouncementCyber เหมือนหน้าอื่น — ข้อยกเว้นครอบ
// เฉพาะธีมเท่านั้น ชื่อแบรนด์และเนื้อหาต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก
// BRAND_NAME ไม่พิมพ์ทับ และค่าสีถูกขยับมาใช้เลขจริงของ brand-spec §2 รอบนี้
// (#240406 / #180303 / #9c0201 / #c08a07 / #ffc93c / #ffeab0 / #dc0203 /
// #f5282a / #f6e7e0 / #1a0303) แทนชุดของ หวยเฮง789 (#2b0909 #1c0606 #5c0a0a
// #a8690c #d99a10 #f4bc5d #ffefc2 #dc2224 #e43434 #fbe3d4) ที่ออกครบแล้ว
//
// การ์ดขั้นตอนด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก
// <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const steps = [
  {
    icon: "🔐",
    label: "Login แล้วเปิดประวัติโพย",
    detail: "เข้าสู่ระบบบัญชีสมาชิกผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ แล้วเปิดประวัติรายการในหมวดหวยที่ต้องการตรวจ โดยใช้บัญชีเดียวกับที่ส่งโพยไว้",
  },
  {
    icon: "🎯",
    label: "เลือกรายการและรอบให้ตรงกับโพย",
    detail: "เลือกหวยที่แทงไว้ ทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา หรือหวยหุ้นต่างประเทศ แล้วเทียบชื่อรายการและเวลาของรอบให้ตรงกับโพยที่ส่งไว้ก่อนอ่านผล",
  },
  {
    icon: "🧾",
    label: "อ่านเลข ยอด และสถานะในโพย",
    detail: "ระบบแสดงเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนยืนยันโพย พร้อมสถานะของรายการที่อัปเดตหลังการตรวจสอบเสร็จสิ้น",
  },
];

const faqs = [
  {
    q: `ดูผลหวยกับ ${BRAND_NAME} ได้จากรายการไหนบ้าง?`,
    a: "ในบัญชีเดียวมีทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา หวยหุ้นต่างประเทศ และรายการอื่นตามที่ระบบเปิดรับในแต่ละวัน จึงควรเปิดดูตารางหวย เวลาปิดรับ อัตราจ่าย และผลของแต่ละรอบที่ระบบแสดงก่อน แล้วค่อยเทียบผลอย่างเป็นทางการของหวยประเภทนั้นกับเลขในโพยของรอบเดียวกัน",
  },
  {
    q: `สถิติหวยย้อนหลังและแนวทางหวยของ ${BRAND_NAME} ใช้ยืนยันเลขงวดถัดไปได้หรือไม่?`,
    a: "สถิติย้อนหลังช่วยให้ย้อนดูผลและรูปแบบตัวเลขที่เคยออกในรอบที่ผ่านมา ส่วนแนวทางหวยเป็นข้อมูลประกอบจากแหล่งหรือกลุ่มต่าง ๆ แต่ไม่สามารถรับประกันหรือยืนยันเลขที่จะออกในงวดถัดไปได้ เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา",
  },
  {
    q: "อัตรา 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับหวยทุกประเภทหรือไม่?",
    a: "ขึ้นอยู่กับประเภทหวยและเงื่อนไขของแต่ละรอบ จึงไม่ควรถือว่าเป็นอัตราเดียวกันทุกรายการ สมาชิกควรตรวจสอบอัตรา 2 ตัวและ 3 ตัวที่แสดงในหน้าส่งโพยของรอบนั้นก่อนยืนยันรายการเป็นหลัก เนื่องจากบางรายการอาจกำหนดอัตราหรือวงเงินแตกต่างกัน",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน?",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้จากหน้าเดียว",
  },
  {
    q: "สถานะโพยไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร?",
    a: `ตรวจสอบประวัติรายการในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อรายการ รอบเวลา เลขที่เลือก และข้อมูลรายการที่เกี่ยวข้อง โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 150 ตัวอักษร
const pageDescription = `ตรวจหวย ${BRAND_NAME} รวมวิธีดูผลหวยตามรอบที่ประกาศและตรวจสถานะโพยของหวยรัฐบาลไทย ฮานอย ลาวพัฒนา และหุ้นต่างประเทศ พร้อมสถิติย้อนหลังที่เป็นเพียงข้อมูลประกอบ`;

const graph = pageGraph(Astro, {
  name: `ตรวจหวย ${BRAND_NAME} ดูผลหวยตามรอบและตรวจสถานะโพยด้วยตัวเอง`,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title={`ตรวจหวย ${BRAND_NAME} ดูผลหวยรัฐบาลไทย ฮานอย ลาวพัฒนา หุ้นต่างประเทศ และสถานะโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`ตรวจหวย ${BRAND_NAME} ดูผลหวยตามรอบและตรวจสถานะโพยด้วยตัวเอง`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        หน้านี้รวมวิธีดูผลหวยตามรอบที่ประกาศและตรวจสถานะโพยของตัวเองกับ <strong class="text-[#ffeab0]">{BRAND_NAME}</strong> ตั้งแต่เปิดประวัติรายการในบัญชีสมาชิก ดูเลขที่เลือกและยอดเดิมพันที่ส่งไว้
        ไปจนถึงการอ่านสถานะของรายการหลังระบบตรวจสอบเสร็จ โดยบัญชีเดียวรวมรายการหวยไว้ครบทั้งหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศ พร้อมหมวดแนวทางหวย กลุ่มหวย และสถิติหวยย้อนหลัง
        จึงเลือกดูรายการที่ต้องการได้จากหน้าเว็บไซต์บนเบราว์เซอร์มือถือโดยไม่ต้องสลับใช้งานหลายบัญชี
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        หน้านี้ไม่มีตัวเลขของงวดใด ไม่มีการทำนายผล และไม่ได้ประกาศผลรางวัลของงวดใดเอง
        <strong class="text-[#ffeab0]">การดูผลหวยควรอ้างอิงการประกาศผลอย่างเป็นทางการของหวยแต่ละประเภท</strong> และหากรายการนั้นมีหลายรอบต่อวัน ควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล
        ส่วนเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และวงเงินที่รับได้ ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนดูผลหวยและตรวจสถานะโพยด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#9c0201] bg-[#180303]/75 p-5 transition-colors hover:border-[#ffc93c]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#ffeab0] to-[#c08a07] text-sm font-black text-[#1a0303]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#ffc93c]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#f6e7e0]">{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#c08a07] via-[#ffeab0] to-[#c08a07] px-8 py-4 font-black text-[#1a0303] shadow-[0_5px_15px_rgba(255,201,60,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#c08a07]/60 bg-[#9c0201] px-8 py-4 font-bold text-[#ffc93c] shadow-[0_5px_15px_rgba(8,1,1,0.6)] transition-colors hover:bg-[#180303]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ดูผลหวยให้ตรงประเภทและตรงรอบก่อนคำนวณผลรางวัล" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        เมื่อรอบที่คุณส่งโพยไว้ประกาศผลแล้ว ให้เทียบเลขในโพยกับ <strong class="text-[#ffeab0]">การประกาศผลอย่างเป็นทางการของหวยประเภทเดียวกันและรอบเดียวกับที่แทงจริง</strong>
        เพราะหวยรัฐบาลไทยออกรางวัลตามกำหนดของตัวเอง หวยฮานอยมีหลายรอบ หวยลาวพัฒนาและหวยหุ้นต่างประเทศก็เปิดรับตามตลาดและตารางของแต่ละรายการ ส่วนเลขชุดเดียวกันยังใช้ตัดสินคนละรูปแบบการเดิมพันกัน
        ทั้งเลข 2 ตัวและเลข 3 ตัว การอ่านข้ามรายการหรือข้ามรอบจึงเป็นสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        หมวดสถิติหวยย้อนหลังมีไว้ให้ย้อนดูผลและรูปแบบตัวเลขที่เคยออกในรอบที่ผ่านมา ส่วนหมวดแนวทางหวยและกลุ่มหวยเป็นข้อมูลที่รวบรวมจากแหล่งต่าง ๆ ให้ค้นหาได้ง่ายขึ้น
        <strong class="text-[#ffeab0]">สถิติย้อนหลังและแนวทางหวยเป็นข้อมูลประกอบ ไม่สามารถรับประกันหรือยืนยันเลขที่จะออกในงวดถัดไปได้</strong> เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา
        จึงควรใช้ทั้งสองหมวดเป็นข้อมูลอ่านประกอบ ไม่ใช่ข้อสรุปของรอบที่ยังไม่ออก
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
