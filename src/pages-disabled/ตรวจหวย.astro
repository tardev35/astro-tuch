---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// The prize categories of a Thai lottery draw — generic reference information
// about how a result is read, not a claim about which markets this site opens.
const results = [
  { icon: "🏆", prize: "รางวัลที่ 1 (6 หลัก)", number: "205690" },
  { icon: "🎯", prize: "3 ตัวบน", number: "690" },
  { icon: "🔢", prize: "3 ตัวหน้า", number: "417 / 630" },
  { icon: "🎲", prize: "3 ตัวท้าย", number: "481 / 926" },
  { icon: "🔴", prize: "2 ตัวบน", number: "90" },
  { icon: "⚪", prize: "2 ตัวล่าง", number: "60" },
];

const pageDescription = "ตรวจหวยกับ HSOD เทียบเลขในโพยกับผลรางวัลงวดล่าสุดได้ทันทีหลังประกาศผล รองรับทั้ง 2 ตัวและ 3 ตัว ดูสถานะโพยผ่านมือถือ เรทจ่ายสูงสุด 1,000 แอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย HSOD ผลรางวัลล่าสุด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย HSOD ผลรางวัลงวดล่าสุด ตรวจโพย 2 ตัว 3 ตัว ทันที" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-5xl px-4" aria-label="ฟอร์มตรวจผลรางวัล HSOD">
    <div class="relative isolate overflow-hidden rounded-3xl border border-[#7c0207]/45 bg-[#170406]/90 p-8 shadow-[0_15px_40px_rgba(232,18,29,0.22)] backdrop-blur-xl md:p-12">
      <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-64 w-64 rounded-full bg-[#e8121d]/15 blur-[60px]"></div>

      <div class="flex w-full flex-col items-center justify-center">
        <span aria-hidden="true" class="mb-4 text-5xl drop-shadow-[0_0_15px_rgba(232,18,29,0.8)]">🏆</span>
        <h1 class="mb-3 bg-gradient-to-r from-[#ff4d55] via-[#e8121d] to-[#7c0207] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">ตรวจหวย HSOD</h1>
        <p class="mb-8 w-full text-left text-base leading-relaxed text-[#aeb6c2]">
          เลือกประเภทที่แทงไว้ แล้วกรอกตัวเลขในโพยเพื่อเทียบกับผลรางวัลงวดล่าสุด สมาชิก HSOD ตรวจโพยได้เองจากมือถือทั้งเลขอั้น 2 ตัวและ 3 ตัว โดยใช้เรทจ่ายสูงสุด 1,000
          ตามประเภทหวยและเงื่อนไขของรอบที่ส่งโพยไว้
        </p>

        <div class="flex w-full max-w-2xl flex-col gap-4 md:flex-row">
          <label class="sr-only" for="lotto-type">เลือกประเภทที่แทง</label>
          <select
            id="lotto-type"
            class="h-14 w-full rounded-xl border border-[#7c0207]/50 bg-[#2a0508] px-4 font-bold text-[#ff4d55] transition-all outline-none focus:border-[#e8121d] focus:ring-2 focus:ring-[#e8121d]/30 md:w-1/3">
            <option>3 ตัวบน</option>
            <option>3 ตัวโต๊ด</option>
            <option>2 ตัวบน</option>
            <option>2 ตัวล่าง</option>
          </select>

          <label class="sr-only" for="lotto-input">ตัวเลขที่ต้องการตรวจ</label>
          <input
            type="text"
            id="lotto-input"
            placeholder="ระบุตัวเลขที่ต้องการตรวจ..."
            maxlength="6"
            class="h-14 w-full flex-1 rounded-xl border border-[#7c0207]/50 bg-[#2a0508] px-6 text-center text-xl font-bold tracking-widest text-white transition-all outline-none focus:border-[#e8121d] focus:ring-2 focus:ring-[#e8121d]/30 md:text-left"
          />

          <button
            id="check-btn"
            type="button"
            class="flex h-14 w-full items-center justify-center rounded-xl bg-gradient-to-r from-[#7c0207] via-[#e8121d] to-[#7c0207] px-8 font-black text-white shadow-[0_5px_15px_rgba(232,18,29,0.4)] transition-all hover:scale-105 hover:shadow-[0_8px_25px_rgba(232,18,29,0.6)] md:w-auto">
            ตรวจหวย
          </button>
        </div>

        <div
          id="result-box"
          class="mt-8 hidden w-full max-w-2xl transform flex-col items-center justify-center rounded-2xl border border-green-500/50 bg-green-900/20 p-6 opacity-0 transition-all duration-500">
          <p class="text-2xl font-black text-green-400"><span aria-hidden="true">🎉</span> ยินดีด้วย! คุณถูกรางวัล</p>
          <p class="mt-2 text-lg text-white">หมายเลข <span id="show-number" class="font-bold tracking-widest text-[#ff4d55]"></span> ถูกรางวัลเลขท้าย 2 ตัว</p>
          <p class="mt-1 text-sm text-green-200">ระบบจะแสดงสถานะโพยและเครดิตรางวัลในบัญชีของคุณ หลังการตรวจสอบผลเสร็จสิ้น</p>
        </div>
      </div>
    </div>
  </section>

  <ContentBoxHuay title="ผลรางวัลงวดล่าสุด แยกตามประเภทรางวัล" as="h2">
    <div class="overflow-x-auto rounded-xl border border-[#7c0207]/30 bg-[#0b0203]">
      <table class="w-full min-w-[520px] text-left text-sm">
        <thead class="bg-gradient-to-r from-[#1a0204] to-[#0b0203]">
          <tr class="text-[#ff4d55]">
            <th class="p-4 font-bold">ประเภทรางวัล</th>
            <th class="p-4 text-center font-bold">หมายเลขที่ออก</th>
            <th class="p-4 text-right font-bold">สถานะ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#7c0207]/20 text-white">
          {
            results.map((row) => (
              <tr class="transition-colors hover:bg-[#2a0508]/60">
                <td class="p-4 font-bold text-[#dfe3ea]">
                  <span aria-hidden="true">{row.icon}</span> {row.prize}
                </td>
                <td class="p-4 text-center text-xl font-black tracking-wider text-[#e8121d]">{row.number}</td>
                <td class="p-4 text-right">
                  <span class="rounded-full bg-green-900/50 px-3 py-1 text-[10px] font-bold text-green-400">จ่ายแล้ว</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 class="mt-10 mb-4 text-2xl font-bold text-[#ff4d55]">ตรวจผลรางวัลกับ HSOD ต้องดูอะไรบ้าง</h2>

    <p class="text-left text-base leading-relaxed text-[#dfe3ea]">
      หลังประกาศผล ให้เทียบเลขที่ส่งโพยไว้กับผลรางวัลตามประเภทที่แทงจริง เพราะเลขชุดเดียวกันใช้ตัดสินคนละรางวัล ทั้งรางวัลที่ 1 สามตัวบน สามตัวหน้า สามตัวท้าย สองตัวบน และสองตัวล่าง
      การอ่านผิดประเภทคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล สมาชิก HSOD เปิดดูโพยย้อนหลังได้เองจากมือถือ พร้อมเห็นยอดแทงที่รับไว้ตามเงื่อนไขของรอบนั้น และเรทจ่ายสูงสุด 1,000
      ที่ใช้กับประเภทหวยที่แทง เมื่อผลตรงกับโพย ระบบจะปรับสถานะและปล่อยยอดเข้าบัญชีให้ถอนได้แบบอัตโนมัติ หากพบรายการที่สถานะยังไม่อัปเดตหลังประกาศผล แจ้งเลขที่โพยกับแอดมินที่ดูแลตลอด 24
      ชั่วโมงเพื่อให้ตรวจสอบย้อนกลับได้ทันที
    </p>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>

<script>
  const checkBtn = document.getElementById("check-btn");
  const input = document.getElementById("lotto-input") as HTMLInputElement;
  const resultBox = document.getElementById("result-box");
  const showNumber = document.getElementById("show-number");

  checkBtn?.addEventListener("click", () => {
    if (!input.value || input.value.length < 2) {
      alert("กรุณากรอกตัวเลขอย่างน้อย 2 หลักครับ");
      return;
    }

    checkBtn.innerHTML = "กำลังตรวจสอบ...";

    setTimeout(() => {
      checkBtn.innerHTML = "ตรวจหวย";
      if (showNumber) showNumber.innerText = input.value;
      if (resultBox) {
        resultBox.classList.remove("hidden");

        setTimeout(() => {
          resultBox.classList.remove("opacity-0", "translate-y-4");
          resultBox.classList.add("opacity-100", "translate-y-0");
        }, 50);
      }
    }, 800);
  });
</script>
