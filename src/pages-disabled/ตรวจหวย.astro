---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// Steps a member follows to read their own bill after a draw. No draw result,
// no example winning number, no date and no prediction lives on this page — the
// brief supports how the system is used, never what a result will be.
//
// MHEEPOOH168 เปิดหมวดหวยไว้ในระบบเดียวกับบาคาร่า สล็อต และบอล หน้าหวยจึงคง
// ตระกูลคอมโพเนนต์ Huay (ธีมแดง) ไว้ตามข้อยกเว้นใน Phase 4.5 ของ playbook —
// ธีมได้รับการยกเว้น ชื่อแบรนด์ไม่ได้ยกเว้น ทุกจุดที่เอ่ยชื่อต้องเป็น MHEEPOOH168
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: รวมบาคาร่า สล็อต หวย
// บอล ไว้ในระบบเดียว · แยกเมนูตามหมวด สลับรูปแบบการเล่นได้จากบัญชีเดียว ·
// โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไขที่ระบบกำหนด ·
// รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ · ตรวจสอบสถานะรายการและยอด
// ผ่านบัญชีสมาชิกได้เอง · แอดมิน 24 ชั่วโมง
// ห้ามใส่อัตราจ่ายเป็นตัวเลข ผลรางวัล วันที่ สถิติ เลขเด็ด ชื่อตลาดหวยรายตัว
// ยอดถอนขั้นต่ำ/ขั้นสูง หรือเลขที่ใบอนุญาตใด ๆ เพราะบรีฟรอบนี้ไม่ได้ระบุไว้
const steps = [
  { icon: "🔐", label: "เข้าสู่ระบบ", detail: "เปิดบัญชีสมาชิกจากมือถือหรือคอมพิวเตอร์ แล้วเข้าหน้าประวัติโพยในหมวดหวย" },
  { icon: "🧾", label: "เปิดบิลที่ต้องการตรวจ", detail: "เลือกรอบและเลขที่ส่งไว้ ระบบแสดงยอดแทงและอัตราจ่ายที่บันทึกไว้ตอนส่งโพย" },
  { icon: "✅", label: "ดูสถานะรายการ", detail: "เมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดที่เข้าบัญชีสมาชิก" },
];

const faqs = [
  {
    q: "ตรวจโพยหวย MHEEPOOH168 ย้อนหลังได้ที่ไหน",
    a: "เปิดประวัติโพยในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรอบที่ส่ง เลขที่เลือก ยอดแทง และอัตราจ่ายที่บันทึกไว้ตอนส่งโพย ทำให้เทียบกับสถานะที่ระบบอัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "โพยที่ถูกรางวัลคิดยอดตามเรทเท่าไร",
    a: "ยอดตามเรทคำนวณจากอัตราจ่ายที่ระบบแสดงบนหน้าส่งโพยของประเภทและรอบที่เลือก ณ ตอนที่กดยืนยันรายการ อัตรานั้นจะถูกบันทึกไว้ในบิลพร้อมกับเลขและยอดแทง จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร ไม่ควรคำนวณจากเรทที่จำมาจากรอบก่อน",
  },
  {
    q: "เล่นหวยกับหมวดเกมอื่นในบัญชีเดียวกันได้ไหม",
    a: "ได้ เพราะ MHEEPOOH168 รวมบาคาร่า สล็อต หวย และบอลไว้ในระบบเดียว แต่ละประเภทแยกเป็นเมนูชัดเจนและสลับรูปแบบการเล่นได้จากบัญชีเดียว ส่วนยอดและสถานะรายการของทุกหมวดตรวจสอบได้จากบัญชีสมาชิกของตัวเอง",
  },
  {
    q: "สถานะบิลไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร",
    a: "ตรวจสอบประวัติโพยหรือรายการเครดิตในบัญชีก่อน หากยังพบความผิดปกติ ให้ติดต่อแอดมิน MHEEPOOH168 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมแจ้งเวลา จำนวนเงิน ประเภทที่แทง และรายละเอียดรายการ เพื่อให้ตรวจสอบต่อได้ตรงจุด",
  },
];

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription = "ตรวจหวย MHEEPOOH168 วิธีเปิดดูโพยย้อนหลังและอ่านสถานะรายการจากบัญชีสมาชิกด้วยตนเอง พร้อมจุดที่ควรตรวจสอบอัตราจ่ายและรอบที่เปิดรับก่อนกดยืนยันโพยทุกครั้ง";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย MHEEPOOH168 เช็กสถานะโพยด้วยตัวเอง",
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย MHEEPOOH168 เปิดดูโพยย้อนหลังและสถานะรายการด้วยตัวเอง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-5xl px-4">
    <div class="relative isolate overflow-hidden rounded-3xl border border-[#c21e22]/50 bg-[#3a0709]/90 p-8 shadow-[0_15px_40px_rgba(194,30,34,0.22)] backdrop-blur-xl md:p-12">
      <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-64 w-64 rounded-full bg-[#e2353a]/20 blur-[60px]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-64 w-64 rounded-full bg-[#ffe9ea]/10 blur-[60px]"></div>

      <div class="flex w-full flex-col items-center">
        <span aria-hidden="true" class="mb-4 text-5xl drop-shadow-[0_0_15px_rgba(226,53,58,0.8)]">🧾</span>
        <h1 class="mb-3 bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">ตรวจหวย MHEEPOOH168</h1>
        <p class="w-full text-left text-base leading-relaxed text-[#ded9da]">
          หน้านี้อธิบายวิธีตรวจโพยของคุณเองในหมวดหวยของ MHEEPOOH168 ตั้งแต่เปิดประวัติบิล ดูเลขและยอดที่ส่งไว้ ไปจนถึงการอ่านสถานะรายการและยอดที่เข้าบัญชีสมาชิก โดยหมวดหวยถูกแยกเป็นเมนูของตัวเองในระบบเดียวกับบาคาร่า
          สล็อต และบอล จึงสลับรูปแบบการเล่นได้จากบัญชีเดียว เว็บไซต์ไม่ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ ให้ยึดผลที่หน่วยงานผู้จัดออกรางวัลประกาศเป็นหลัก ส่วนรอบที่เปิดรับ เวลาปิดรับ และอัตราจ่าย ให้ยึดตัวเลขที่ระบบแสดงบนหน้าส่งโพยของรอบนั้น
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจโพยด้วยตัวเองสามขั้นตอน">
        {
          steps.map((step, i) => (
            <div class="flex flex-col gap-2 rounded-2xl border border-[#c21e22]/40 bg-[#140a0c]/70 p-5 transition-colors hover:border-[#e2353a]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#e2353a] to-[#7d1114] text-sm font-black text-[#ffe9ea]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#ff8a8d]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#bdb4b6]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7d1114] via-[#c21e22] to-[#7d1114] px-8 py-4 font-black text-[#ffe9ea] shadow-[0_5px_15px_rgba(194,30,34,0.45)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#c21e22]/60 bg-[#1c0d0f] px-8 py-4 font-bold text-[#ff8a8d] shadow-[0_5px_15px_rgba(226,53,58,0.22)] transition-colors hover:bg-[#3a0709]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก MHEEPOOH168
        </a>
      </div>
    </div>
  </section>

  <ContentBoxHuay title="ขั้นตอนตรวจโพย MHEEPOOH168 หลังผลรางวัลประกาศ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เมื่อผลของรอบที่คุณส่งโพยไว้ถูกประกาศแล้ว ให้เทียบเลขในบิลกับผลตามประเภทที่แทงจริง เพราะเลขชุดเดียวกันใช้ตัดสินคนละประเภทกัน
        การอ่านผิดประเภทคือสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล สมาชิก MHEEPOOH168 เปิดดูบิลย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งรอบที่ส่ง เลขที่เลือก ยอดแทง
        และอัตราจ่ายที่แสดงไว้ตอนยืนยันรายการ จึงตรวจย้อนกลับได้ว่ารายการที่ส่งไปตรงกับที่ตั้งใจหรือไม่ เมื่อระบบตรวจสอบเสร็จ สถานะของบิลจะอัปเดตพร้อมยอดตามเรทที่ปล่อยเข้าบัญชี
        ระหว่างรอตรวจสอบ ควรเก็บข้อมูลบิลไว้จนกว่ารายการจะเสร็จสมบูรณ์ และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ยอดตามเรทคิดจากอัตราจ่ายที่บันทึกไว้ในบิล" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        ยอดตามเรทของโพยที่ถูกรางวัลคิดจาก <strong class="text-[#ff9a9d]">อัตราจ่ายที่ระบบแสดงบนหน้ายืนยันโพย ณ ตอนที่คุณกดส่งรายการ</strong> ไม่ใช่จากตัวเลขที่จำมาจากรอบก่อน
        เพราะประเภทที่เลือกและรอบที่เปิดรับเป็นตัวกำหนดเรทของรายการนั้น อัตราที่ใช้จะถูกบันทึกลงในบิลพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดแทง จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร
        และเทียบกับยอดที่เข้าบัญชีหลังระบบตรวจสอบเสร็จได้โดยตรง ก่อนกดยืนยันทุกครั้งจึงควรอ่านอัตราจ่าย วงเงิน และเวลาปิดรับที่ระบบแสดงของรอบนั้นให้ครบ
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#ded9da]">
        ยอดที่ถูกปล่อยเข้าบัญชีตรวจสอบได้จากประวัติรายการเครดิตในบัญชีสมาชิกเช่นกัน MHEEPOOH168
        <strong class="text-[#ff9a9d]">รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์</strong> สมาชิกจึงเลือกวิธีจัดการเครดิตได้ตามความสะดวก และตรวจสอบสถานะของแต่ละรายการได้ด้วยตัวเอง
        ขั้นตอนถูกจัดวางให้เข้าใจง่าย เหมาะกับทั้งสมาชิกใหม่และผู้ที่ใช้งานเป็นประจำ โดยชื่อบัญชีที่ผูกไว้ควรตรงกับชื่อที่สมัคร ระบบจึงจะดำเนินรายการเข้า-ออกให้ได้อย่างถูกต้อง
      </p>

      <p class="mt-6 text-left text-base leading-relaxed text-[#ded9da]">
        หมวดหวยอยู่ในระบบเดียวกับบาคาร่า สล็อต และบอล โดยแต่ละประเภทแยกเป็นเมนูอย่างชัดเจน <strong class="text-[#ff9a9d]">สลับรูปแบบการเล่นได้จากบัญชีเดียว</strong>
        ไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์ ยอดที่ปล่อยเข้าจากโพยที่ถูกรางวัลจึงใช้งานต่อในหมวดอื่นหรือจัดการจากหน้าบัญชีเดียวกันได้ทันที
        และสิทธิ์โปรโมชั่นอย่างโบนัสคืนยอดเสีย 0.3% กับโบนัสแนะนำเพื่อน 0.8% ก็ตรวจสอบรอบคำนวณและเงื่อนไขได้จากหน้าโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง
      </p>
    </div>
  </ContentBoxHuay>

  <LatestWinnersHuay />

  <ContentBoxHuay title="โพยหรือรายการเครดิตมีปัญหา แจ้งแอดมิน MHEEPOOH168 ได้ 24 ชั่วโมง" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง เครดิตไม่เข้า รายการถอนค้าง เข้าสู่ระบบไม่ได้ หรือพบยอดในบิลไม่ตรงกับรายการ ให้ตรวจสอบประวัติโพยและประวัติรายการเครดิตในบัญชีก่อนเป็นอันดับแรก
        เพราะรายการส่วนใหญ่อธิบายได้จากข้อมูลที่ระบบบันทึกไว้แล้ว หากยังพบความผิดปกติ ติดต่อแอดมิน MHEEPOOH168 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมแจ้งประเภทที่แทง รอบเดิมพัน เวลา จำนวนเงิน และรายละเอียดรายการ
        เพื่อให้ตรวจสอบได้ตรงจุด ทีมงานพร้อมให้ข้อมูลทั้งเรื่องการสมัคร เมนูเกมแต่ละหมวด โปรโมชั่น และระบบเครดิต สมาชิกควรเก็บข้อมูลบิลและหลักฐานการทำรายการไว้จนกว่าเรื่องจะตรวจสอบเสร็จสิ้น
        และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>
    </div>
  </ContentBoxHuay>

  <FaqHuay title="คำถามที่พบบ่อยเรื่องการตรวจหวยกับ MHEEPOOH168" faqs={faqs} />

  <Navfoot />
</MainLayout>
