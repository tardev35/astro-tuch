---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้ว่าด้วย "วิธีตรวจผลหวยและตรวจสถานะโพยของตัวเอง" ไม่มีผลรางวัลจริง ไม่มี
// วันที่ ไม่มีเลขเด็ด และไม่มีการทำนายใด ๆ อยู่บนหน้านี้ — LOTTOPLUS ไม่ได้เป็น
// ผู้ประกาศผล ให้ยึดผลอย่างเป็นทางการของหวยแต่ละประเภทเป็นหลัก และถ้ารายการนั้น
// มีหลายรอบต่อวัน ต้องเทียบชื่อรายการกับเวลาของรอบให้ตรงก่อนคำนวณผลรางวัล
// (src/assets/content.txt L8)
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของ LOTTOPLUS เท่านั้น: เว็บหวย
// ออนไลน์ไม่ผ่านแอป สมัคร/ใช้งานผ่านเบราว์เซอร์บนมือถือได้ · รวมหวยรัฐบาลไทย
// ลาวพัฒนา ฮานอย และหวยหุ้นไว้ในบัญชีเดียว · เลือกเลข ส่งโพย ตรวจสอบรายการ
// ตรวจผลหวย และจัดการฝากถอนได้จากหน้าเว็บไซต์ · อัตราจ่ายหวย 2 ตัว 100 และ
// 3 ตัว 1,000 ซึ่งขึ้นกับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ จึงต้องยึด
// ตัวเลขที่ระบบแสดงก่อนยืนยันโพย · แอดมินติดต่อได้ 24 ชั่วโมง
// ห้ามเติมสถิติ ผลย้อนหลัง เวลาออกรางวัลรายรายการ ชื่อธนาคาร ยอดฝาก-ถอนขั้นต่ำ
// ใบอนุญาต หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 / 0.3% / 0.8% /
// 24 ชั่วโมง เพราะบรีฟรอบนี้ไม่ได้ระบุไว้ และห้ามใช้คำสายคาสิโนทุกคำ
//
// ข้อยกเว้น "หน้าหวยคงธีม Huay" ของ Phase 4.5 ไม่ถูกใช้เป็นข้อยกเว้นในรอบนี้:
// กฎนั้นมีไว้กันไม่ให้ฮิวของแบรนด์คาสิโนถูกยัดลงหมวดหวย แต่ LOTTOPLUS เป็นเว็บ
// หวยและพาเลตต์ของแบรนด์เองก็เป็นแดง-ทองอยู่แล้ว หน้านี้จึงถูกรีธีมตามพาเลตต์
// §2 เหมือนทุกหน้า — ชุดแดงของ LOTTO24/888PARUAY รอบก่อน (#dc2626 #fc2b2c
// #b40102 #fbbf24 #a16207 #fde68a #15060a #2a0405 #f6e2e2 #e0c4c4 #fcdc2b
// #fff6ae #a87d0c #cf1111 #240808 #140404 #3a0f0f #e8e4c6 #c3b98f) ออกครบแล้ว
//
// การ์ดขั้นตอนด้านล่างเป็น chrome ไม่ใช่หัวข้อบทความ ป้ายจึงเป็น <span> และชื่อ
// ของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง ต่างจาก
// <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const steps = [
  {
    icon: "🔐",
    label: "Login แล้วเปิดประวัติโพย",
    detail: "เข้าสู่ระบบบัญชีสมาชิกผ่านเบราว์เซอร์บนมือถือหรือคอมพิวเตอร์ แล้วเปิดประวัติรายการในหมวดหวยที่ต้องการตรวจ โดยไม่ต้องติดตั้งแอปเพิ่มเติม",
  },
  {
    icon: "🎯",
    label: "เลือกรายการและรอบให้ตรงกับโพย",
    detail: "เลือกหวยที่แทงไว้ ทั้งรัฐบาลไทย ลาวพัฒนา ฮานอย หรือหวยหุ้น แล้วเทียบชื่อรายการและเวลาของรอบให้ตรงกับโพยที่ส่งไว้ก่อนอ่านผล",
  },
  {
    icon: "🧾",
    label: "อ่านเลข ยอด และสถานะในโพย",
    detail: "ระบบแสดงเลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนยืนยันโพย พร้อมสถานะของรายการที่อัปเดตหลังการตรวจสอบเสร็จสิ้น",
  },
];

const faqs = [
  {
    q: "ตรวจผลหวยกับ LOTTOPLUS ดูได้จากรายการไหนบ้าง?",
    a: "ในบัญชีเดียวมีทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น โดยรายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน จึงควรเปิดดูรายการล่าสุดที่ระบบแสดงก่อน แล้วค่อยเทียบผลอย่างเป็นทางการของหวยประเภทนั้นกับเลขในโพยของรอบเดียวกัน",
  },
  {
    q: "หวย 2 ตัว 100 และหวย 3 ตัว 1,000 ใช้กับทุกรายการหรือไม่?",
    a: "ไม่ควรถือว่าเป็นอัตราเดียวกันทุกประเภท อัตราจ่ายจริงอาจแตกต่างตามประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ สมาชิกจึงควรยึดตัวเลขที่ LOTTOPLUS แสดงในหน้าส่งโพยก่อนยืนยันรายการเป็นหลัก",
  },
  {
    q: "เปิดดูโพยย้อนหลังของตัวเองได้ที่ไหน?",
    a: "เข้าสู่ระบบแล้วเปิดประวัติรายการในบัญชีสมาชิกได้ด้วยตัวเอง ระบบจะแสดงรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่บันทึกไว้ตอนกดยืนยัน ทำให้เทียบกับสถานะที่อัปเดตหลังตรวจสอบเสร็จได้ทันที",
  },
  {
    q: "สถานะโพยไม่ตรงกับที่ส่งไว้ ต้องทำอย่างไร?",
    a: "ตรวจสอบประวัติโพยและประวัติเครดิตในบัญชีก่อนเป็นอันดับแรก หากยังพบความผิดปกติ ติดต่อแอดมิน LOTTOPLUS ผ่านช่องทางที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อรายการ รอบเวลา จำนวนเงิน และรายละเอียดโพย โดยไม่ควรเปิดเผยรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 157 ตัวอักษร
const pageDescription = "ตรวจหวย LOTTOPLUS วิธีเช็กผลหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น พร้อมขั้นตอนดูโพยย้อนหลังในบัญชีสมาชิก และการเทียบชื่อรายการกับเวลาของรอบก่อนคำนวณผลรางวัล";

const graph = pageGraph(Astro, {
  name: "ตรวจหวย LOTTOPLUS เช็กผลหวยและสถานะโพยด้วยตัวเอง",
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="ตรวจหวย LOTTOPLUS เช็กผลรัฐบาลไทย ลาวพัฒนา ฮานอย หวยหุ้น และสถานะโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title="ตรวจหวย LOTTOPLUS เช็กผลหวยและสถานะโพยด้วยตัวเอง" as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวมวิธีตรวจผลหวยและตรวจสถานะโพยของตัวเองกับ <strong class="text-[#fff4f4]">LOTTOPLUS</strong> ตั้งแต่เปิดประวัติรายการในบัญชีสมาชิก ดูเลขที่เลือกและยอดเดิมพันที่ส่งไว้ ไปจนถึงการอ่านสถานะของรายการหลังระบบตรวจสอบเสร็จ
        โดยระบบรวมหวยหลายประเภทไว้ในบัญชีเดียว ทั้งหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น จึงเลือกดูรายการที่ต้องการได้จากหน้าเว็บไซต์บนเบราว์เซอร์มือถือโดยไม่จำเป็นต้องติดตั้งแอป
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        LOTTOPLUS ไม่ได้เป็นผู้ประกาศผลรางวัลเอง และหน้านี้ไม่มีเลขเด็ดหรือการทำนายผลใด ๆ
        <strong class="text-[#fff4f4]">การตรวจผลควรอ้างอิงผลอย่างเป็นทางการของหวยแต่ละประเภท</strong> และหากรายการนั้นมีหลายรอบต่อวัน ควรตรวจสอบชื่อรายการและเวลาของรอบให้ตรงกันก่อนคำนวณผลรางวัล ส่วนรอบที่เปิดรับ
        เวลาปิดรับ และอัตราจ่าย ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้นเป็นหลัก
      </p>

      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="ขั้นตอนตรวจผลหวยและสถานะโพยด้วยตัวเอง">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-2 rounded-2xl border border-[#2a0d0f] bg-[#120b0c]/75 p-5 transition-colors hover:border-[#f3c623]/55">
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#fde79a] to-[#8a6a0a] text-sm font-black text-[#1a0203]">
                  {i + 1}
                </span>
                <span aria-hidden="true" class="text-xl">
                  {step.icon}
                </span>
                <span class="text-base font-black tracking-wide text-[#f3c623]">{step.label}</span>
              </div>
              <p class="text-left text-base leading-relaxed text-[#f0e2e2]">{step.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/login"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#8a6a0a] via-[#f3c623] to-[#8a6a0a] px-8 py-4 font-black text-[#1a0203] shadow-[0_5px_15px_rgba(243,198,35,0.4)] transition-transform hover:scale-105">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบเพื่อตรวจโพย
        </a>
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#8a6a0a]/60 bg-[#2a0d0f] px-8 py-4 font-bold text-[#f3c623] shadow-[0_5px_15px_rgba(5,1,2,0.6)] transition-colors hover:bg-[#1f0a0c]">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก LOTTOPLUS
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ตรวจผลหวย LOTTOPLUS ให้ตรงประเภทและตรงรอบก่อนคำนวณผลรางวัล" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        เมื่อรอบที่คุณส่งโพยไว้ประกาศผลแล้ว ให้เทียบเลขในโพยกับ <strong class="text-[#fff4f4]">ผลอย่างเป็นทางการของหวยประเภทเดียวกันและรอบเดียวกับที่แทงจริง</strong>
        เพราะหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น ต่างมีรายการและการประกาศผลเป็นของตัวเอง หวยหุ้นยังมีรอบเดิมพันแตกต่างกันในแต่ละวัน และเลขชุดเดียวกันก็ใช้ตัดสินคนละรูปแบบการแทงกัน ทั้งเลข 2 ตัวและเลข
        3 ตัว การอ่านข้ามรายการหรือข้ามรอบจึงเป็นสาเหตุที่พบบ่อยที่สุดของการเข้าใจว่าโพยไม่ถูกรางวัล
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สมาชิก LOTTOPLUS เปิดดูโพยย้อนหลังได้เองจากบัญชี ระบบบันทึกทั้งชื่อรายการและรอบที่ส่ง เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงไว้ตอนยืนยัน จึงย้อนกลับไปตรวจได้ว่ารายการที่ส่งไป
        ตรงกับที่ตั้งใจหรือไม่ และเมื่อระบบตรวจสอบเสร็จ สถานะของโพยจะอัปเดตพร้อมยอดที่เข้าบัญชีสมาชิก หากพบว่าเลขหรือรอบไม่ตรงกับที่ต้องการ ให้เก็บรายละเอียดของโพยนั้นไว้แล้วแจ้งแอดมินตรวจสอบ
        แทนการคำนวณผลด้วยตัวเองจากรอบอื่น
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="อัตราจ่ายที่บันทึกไว้ในโพย หวย 2 ตัว 100 และหวย 3 ตัว 1,000" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        LOTTOPLUS แสดงอัตราจ่ายของแต่ละรูปแบบให้ตรวจสอบได้จากหน้าส่งโพยก่อนยืนยันการเดิมพัน โดยอัตราที่ประกาศไว้คือ
        <strong class="text-[#fff4f4]">หวย 2 ตัว 100 และหวย 3 ตัว 1,000</strong> แต่ <strong class="text-[#fff4f4]">อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ</strong>
        จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลัก ไม่ใช่ตัวเลขที่จำมาจากรอบก่อนหน้า
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ก่อนกดยืนยันทุกครั้งจึงควรไล่อ่านให้ครบทั้ง <strong class="text-[#fff4f4]">รายการหวยที่เลือก รอบที่เปิดรับ รูปแบบการแทง อัตราจ่าย และเวลาปิดรับ</strong> ที่ระบบแสดงของรอบนั้น โดยเฉพาะเลข 3 ตัวตรงและรูปแบบการเดิมพันอื่นที่อาจมีวิธีคำนวณเงินรางวัลแตกต่างกัน
        เมื่อทุกอย่างตรงกับที่ตั้งใจแล้วค่อยยืนยัน ขั้นตอนนี้ใช้เวลาไม่นาน แต่ตัดปัญหาการส่งผิดรอบหรือผิดรูปแบบออกไปได้เกือบทั้งหมด และทำให้การตรวจผลหลังรอบจบเหลือแค่การเทียบเลขกับผลที่ประกาศ
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกลงในโพยพร้อมกับรอบที่ส่ง เลขที่เลือก และยอดเดิมพัน จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากอัตราเท่าไร และเทียบกับยอดที่เข้าบัญชีหลังตรวจสอบเสร็จได้โดยตรง
