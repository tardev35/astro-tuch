---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

const tips = [
  { title: "แนวทางหวยรัฐบาลไทย งวดล่าสุด", desc: "รวมเลขเด่นและเลขรองของงวดนี้ พร้อมจุดที่ควรดูก่อนจัดโพยส่งเข้ารอบที่เปิดรับ", type: "หวยรัฐบาลไทย", date: "วันนี้", hot: true },
  { title: "เจาะแนวทางหวยลาว ก่อนปิดรับ", desc: "แนวทางเลขที่คนแทงหนักในรอบนี้ พร้อมวิธีกระจายเลขไม่ให้ยอดกระจุกอยู่ตัวเดียว", type: "หวยลาว", date: "วันนี้", hot: true },
  { title: "สถิติเลขท้าย 2 ตัวหวยฮานอยที่ออกซ้ำ", desc: "สรุปเลขท้าย 2 ตัวที่ออกซ้ำบ่อยในรอบย้อนหลัง ใช้เป็นฐานคัดเลขก่อนลงโพยจริง", type: "หวยฮานอย", date: "เมื่อวาน", hot: false },
  { title: "แนวทางหวยยี่กี่ รอบถี่ต้องคุมอะไร", desc: "ยี่กี่เปิดรอบถี่กว่าหวยประเภทอื่น ควรคัดเลขและคุมยอดต่อรอบให้ชัดก่อนยืนยันโพย", type: "หวยยี่กี่", date: "เมื่อวาน", hot: false },
  { title: "อ่านแนวทางหวยหุ้นให้เป็นก่อนส่งโพย", desc: "หวยหุ้นอิงอะไร รอบไหนเปิดรับบ้าง และควรตรวจอะไรก่อนกดยืนยันรายการทุกครั้ง", type: "หวยหุ้น", date: "2 วันที่แล้ว", hot: false },
  { title: "ตรวจโพยผ่านมือถือหลังประกาศผล", desc: "ขั้นตอนเปิดดูโพยย้อนหลังจากบัญชีสมาชิก ดูสถานะรางวัลและยอดที่ปล่อยเข้าบัญชี", type: "ตรวจโพย", date: "2 วันที่แล้ว", hot: false },
];
// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char). This page is 154.
const pageDescription =
  "รวมแนวทางหวย เลขเด่น และสถิติงวดย้อนหลังก่อนส่งโพยกับ HUAY928 ครอบคลุมหวยรัฐบาลไทย ลาว ฮานอย ยี่กี่ และหุ้น พร้อมวิธีจัดโพยให้พอดีวงเงินที่แต่ละรอบเปิดรับ";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย HUAY928 เลขเด่นก่อนส่งโพย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย HUAY928 เลขเด่นรัฐบาลไทย ลาว ฮานอย ยี่กี่ หุ้น อัปเดตทุกวัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(223,180,85,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#f7d979] via-[#dfb455] to-[#a87a1e] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย HUAY928</h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#8fa5c4]">
        รวบรวมเลขเด่น เลขรอง และสถิติรอบย้อนหลัง ให้สมาชิก HUAY928 คัดเลขและวางแผนโพยได้ก่อนรอบปิดรับ ครอบคลุมทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย หวยยี่กี่ และหวยหุ้น โดยวงเงินรับแทง เลขอั้น
        เวลาเปิด-ปิด และอัตราจ่ายของหวยแต่ละประเภทอาจแตกต่างกัน จึงควรตรวจสอบข้อมูลที่ระบบแสดงในรอบนั้นก่อนส่งโพยทุกครั้ง
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl font-black tracking-widest text-[#dfb455] uppercase">รวมแนวทางหวยล่าสุด ก่อนถึงรอบปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#2c4d84]/35 bg-[#04122b]/85 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#dfb455]/55 hover:shadow-[0_15px_30px_rgba(223,180,85,0.22)]">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#12508f]/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between">
              <span class="rounded-full border border-[#2c4d84]/50 bg-[#08234c] px-3 py-1 text-xs font-bold text-[#f7d979]">{tip.type}</span>
              {tip.hot && (
                <span class="flex animate-pulse items-center gap-1 text-xs font-black text-[#dfb455]">
                  <span aria-hidden="true">🔥</span> มาแรง
                </span>
              )}
              {!tip.hot && <span class="text-xs font-medium text-[#8fa5c4]">{tip.date}</span>}
            </div>

            <span class="mb-2 line-clamp-1 block text-xl font-bold text-white transition-colors group-hover:text-[#f7d979]">{tip.title}</span>

            <p class="mb-6 line-clamp-2 text-left text-base leading-relaxed text-[#d5e3f7]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#2c4d84]/25 pt-4 text-sm font-bold text-[#f7d979]">
              <span aria-hidden="true">💰</span>
              อัตราจ่ายตามที่ระบบแสดงในรอบนั้น
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Navfoot />
</MainLayout>
