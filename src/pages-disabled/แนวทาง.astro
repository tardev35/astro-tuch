---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางหวยในฐานะข้อมูลประกอบ + จุดที่ตรวจสอบได้จริงก่อนส่งโพย"
// ไม่ใช่บริการทำนายผล — ไม่มีตัวเลขของรอบใด ไม่มีผลรางวัล ไม่มีตารางสถิติ
// และ **ห้ามบอกใบ้ว่าเลขใดมีโอกาสออกมากกว่ากัน**
//
// ⚠️ เฮดจ์ของบรีฟเองต้องอยู่บนหน้านี้เสมอ ห้ามตัดเพราะฟังดูลบ (content.txt บรรทัด 4,
// 25): "แนวทางหวยเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือ
// รับประกันผลรางวัลล่วงหน้าได้ และผลหวยแต่ละรอบให้อ้างอิงประกาศอย่างเป็นทางการ" —
// รอบนี้มันถือหัวข้อ H2 ของตัวเองทั้งก้อน เฮดจ์คู่กันที่บรรทัด 7 และ 10 ขนมาด้วย:
// "ไม่อั้นจ่าย" ไม่ได้แปลว่าทุกเลขทุกรอบไม่มีวงเงินสูงสุด ให้ยึดหน้าส่งโพยจริง ·
// "ไม่มีลบโพย" หมายถึงโพยที่ระบบรับและยืนยันอย่างสมบูรณ์ตามเงื่อนไขที่ประกาศไว้
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมรายการหวย
// ยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก — รัฐบาลไทย หวยลาว หวยฮานอย
// หวยออมสิน และหวย ธ.ก.ส. (บรรทัด 4, 6) · เลือกเลข ตรวจสอบรอบ อัตราจ่าย และส่งโพย
// ผ่านมือถือจากบัญชีเดียว พร้อมดูแนวทางและสถิติประกอบการเลือกเลข (บรรทัด 4) ·
// ตรวจสอบเวลาเปิดรับ เวลาปิดรับ เลข และยอดเดิมพันก่อนส่งโพย (บรรทัด 6) · เลขเด็ด
// หรือเลขที่มีผู้เลือกจำนวนมากควรเช็กวงเงินที่ระบบเปิดรับก่อนยืนยัน (บรรทัด 7) ·
// อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท
// (บรรทัด 9, 12, 14, 27) · เลข 3 ตัวมีหลายรูปแบบและไม่ได้ใช้อัตราเดียวกันเสมอ
// (บรรทัด 14) · สมัคร 3 ขั้นตอน (บรรทัด 16) · แอดมิน 24 ชั่วโมง (บรรทัด 19) ·
// PIN · OTP (บรรทัด 17, 20)
//
// ⚠️ บรีฟรอบนี้ระบุรายการหวยไว้ห้าชื่อเท่านั้น (รัฐบาลไทย · ลาว · ฮานอย · ออมสิน ·
// ธ.ก.ส.) ห้ามเติมตลาดอื่น (หวยหุ้น ยี่กี ลาวพัฒนา) และห้ามเติมสิ่งที่บรีฟไม่ได้
// ให้ไว้: ใบอนุญาต · หน่วยงานกำกับ · ชื่อธนาคาร · เวลาออกรางวัลเป็นตัวเลข · ตาราง
// สถิติ · ตัวเลขความแม่นยำ · ยอดฝากขั้นต่ำ · จำนวนสมาชิก · ปีก่อตั้ง
// ตัวเลขที่อ้างได้มีแค่ 2 ตัว / 3 ตัว / 100 / 1,000 / 3 ขั้นตอน / 24 ชั่วโมง
// คำว่า "เลขดัง" ไม่มีในบรีฟรอบนี้ — ใช้ "เลขเด็ด" และ "เลขที่มีผู้เลือกจำนวนมาก"
//
// CHROME: Announcement5 · Faq4 ตรงกับทั้งเว็บรอบนี้ (เรียก <Announcement /> แบบ bare
// ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน)
//
// ธีม: หน้าหวยสองหน้านี้คงโทน "หวย" แดง-ทองของตัวเองไว้ตามข้อยกเว้น แต่เฉดเป็นของ
// แบรนด์นี้ทั้งหมด (brand-spec §2) — แดงแบรนด์ #dc0409 · แดงสว่าง #f5363d · แดงลึก
// #8e0206 · แดงดำ #4b0205 · ทอง accent #f3c54e · ทองเข้ม #9a6d16 · เงินโครเมียม
// #eef0f4 / #c3c7d1 · พื้นผิว #0d0407 / #17080c / #211016 · เนื้อความ #edeaf0
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#edeaf0]` ไว้บนการ์ดแล้ว สีที่เขียนเอง
// มีแค่ accent บน <strong> (= #f3c54e สีเดียวทั้งเว็บ)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็กหัวข้อ
// และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ
// จึงส่ง heading={false} ให้ render เป็น <p>
const tips = [
  {
    title: "รวมเลขเด็ดและชุดตัวเลขที่สนใจไว้ให้ครบก่อน",
    desc: "ระบบเปิดรับทั้งเลขเด็ดและชุดตัวเลขที่เลือกเอง ให้รวบรวมเลขที่สนใจไว้ก่อน แล้วค่อยเปิดหน้าส่งโพยทีเดียว จะได้ไม่ต้องตัดสินใจตอนกรอก",
    type: "เลือกเลข",
    note: "เลขเด็ด · เลือกเอง",
  },
  {
    title: "เลือกรายการหวยและรอบเปิดรับให้ตรงกับเลขที่คิดไว้",
    desc: "รัฐบาลไทยเปิดรับตามกำหนดออกรางวัล ส่วนหวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. เปิดรับตามรายการและรอบที่ระบบกำหนด ให้เลือกรายการให้ชัดก่อน แล้วจึงลงเลขในรอบของรายการนั้น",
    type: "รายการและรอบ",
    note: "ไทย · ลาว · ฮานอย · ออมสิน · ธ.ก.ส.",
  },
  {
    title: "อ่านเวลาเปิดรับและเวลาปิดรับของรอบก่อนกรอกเลข",
    desc: "แต่ละรายการมีเวลาเปิดรับและเวลาปิดรับของตัวเอง ให้ดูเวลาที่ระบบแสดงบนรอบนั้นก่อนกรอกเลข เพราะรอบที่ปิดรับแล้วจะส่งโพยเข้าไม่ได้ แม้ระบบจะเข้าใช้งานได้อยู่",
    type: "เวลาเปิด-ปิดรับ",
    note: "ตามที่ระบบแสดง",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือกบนหน้าส่งโพย",
    desc: "อัตราสำหรับรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน ให้ยึดตัวเลขที่ระบบแสดงก่อนยืนยัน",
    type: "อัตราจ่าย",
    note: "2 ตัว 100 · 3 ตัว 1,000",
  },
  {
    title: "เลข 3 ตัวมีหลายรูปแบบ ตรวจรูปแบบก่อนยืนยัน",
    desc: "การเดิมพันเลข 3 ตัวสามารถมีหลายรูปแบบและไม่ได้หมายความว่าทุกรายการจะใช้อัตราเดียวกัน จึงควรตรวจรูปแบบที่เลือกไว้ให้ตรง แล้วยึดข้อมูลล่าสุดในระบบก่อนกดยืนยัน",
    type: "รูปแบบการเดิมพัน",
    note: "ตรวจก่อนยืนยัน",
  },
  {
    title: "กลับมาเปิดประวัติรายการทุกครั้งหลังส่งโพย",
    desc: "โพยที่ระบบยืนยันแล้วควรมีประวัติรายการให้กลับมาตรวจสอบได้ ทั้งชื่อหวย รอบ เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนกดยืนยัน จึงย้อนดูเองได้จากบัญชีสมาชิก",
    type: "ประวัติรายการ",
    note: "ตรวจได้ด้วยตัวเอง",
  },
];

const faqs = [
  {
    q: `แนวทางหวยบน ${BRAND_NAME} การันตีเลขเข้าทุกงวดหรือไม่?`,
    a: "ไม่สามารถการันตีเลขเข้าทุกงวดได้ แนวทาง เลขเด็ด และสถิติย้อนหลังใช้เป็นข้อมูลประกอบเท่านั้น ผลหวยในแต่ละรอบให้อ้างอิงประกาศอย่างเป็นทางการ และไม่มีแนวทางใดรับประกันผลล่วงหน้าได้แน่นอน สิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันคือรายการหวย รอบ รูปแบบการเดิมพัน อัตราจ่าย และวงเงินที่ระบบเปิดรับ",
  },
  {
    q: "เลขเด็ดคือเลขที่มีโอกาสออกมากกว่าหรือไม่?",
    a: "ไม่ใช่ เลขเด็ดเป็นเพียงเลขที่กำลังได้รับความสนใจ ไม่ใช่สัญญาณของผลที่จะเกิดขึ้น และไม่มีเลขชุดใดมีโอกาสออกมากกว่าอีกชุดหนึ่ง เลขที่มีผู้เลือกจำนวนมากยังอาจมีวงเงินที่ระบบเปิดรับต่างจากเลขทั่วไปด้วย",
  },
  {
    q: `${BRAND_NAME} รับเลขเด็ดแบบไม่อั้นจ่ายจริงหรือไม่?`,
    a: "สามารถเลือกเลขตามรายการที่เปิดรับได้ แต่คำว่าไม่อั้นจ่ายไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน และยึดเงื่อนไขที่แสดงบนหน้าส่งโพยเป็นหลัก",
  },
  {
    q: "อัตรา 2 ตัวจ่าย 100 และ 3 ตัวจ่าย 1,000 ใช้กับทุกหวยหรือไม่?",
    a: "ใช้กับรายการที่เข้าเงื่อนไขเท่านั้น หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน โดยเฉพาะเลข 3 ตัวที่มีหลายรูปแบบ จึงควรตรวจสอบอัตราล่าสุดบนหน้าส่งโพยก่อนยืนยันรายการทุกครั้ง",
  },
  {
    q: `สอบถามเรื่องรอบ อัตราจ่าย หรือวงเงินกับ ${BRAND_NAME} ได้ที่ไหน?`,
    a: `ติดต่อแอดมิน ${BRAND_NAME} ผ่านช่องทางบริการที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง พร้อมแจ้งชื่อหวย รอบเวลา เลขที่เลือก และข้อมูลรายการเพื่อให้ตรวจสอบได้ตรงจุด โดยไม่ควรส่งรหัสผ่าน PIN หรือ OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 157 ตัวอักษร
const pageDescription = `แนวทางหวย ${BRAND_NAME} รวมวิธีเลือกเลขเด็ดสำหรับรัฐบาลไทย หวยลาว หวยฮานอย หวยออมสิน หวย ธ.ก.ส. และจุดที่ควรตรวจก่อนส่งโพย เป็นข้อมูลประกอบ ไม่การันตีเลขเข้าทุกงวด`;

const pageHeading = `แนวทางหวย ${BRAND_NAME} เลขเด็ดและสถิติย้อนหลัง รัฐบาลไทย ลาว ฮานอย ออมสิน ธ.ก.ส.`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางหวย ${BRAND_NAME} เลขเด็ดและสถิติย้อนหลังประกอบการเลือกเลข`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#f3c54e]">{BRAND_NAME}</strong> รวบรวมรายการหวยยอดนิยมและแนวทางตัวเลขไว้ให้ติดตามก่อนหวยออก ทั้งรัฐบาลไทยตามกำหนดออกรางวัล หวยลาว หวยฮานอย หวยออมสิน และหวย ธ.ก.ส. ตามรายการที่เปิดให้บริการ
        หน้านี้รวมวิธีใช้ข้อมูลเหล่านั้นวางแผนก่อนส่งโพย ตั้งแต่การรวบรวมเลขเด็ดหรือชุดตัวเลขที่สนใจ ไปจนถึงการอ่านรอบเปิดรับ อัตราจ่าย และวงเงินที่ระบบเปิดรับบนหน้าส่งโพย
      </p>

      <p>
        <strong class="text-[#f3c54e]">หน้านี้ไม่ทำนายเลข ไม่ชี้ว่าเลขใดมีโอกาสออกมากกว่ากัน และไม่รับประกันผลรางวัลของรอบใด</strong> สิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันคือรายการหวย รอบเปิดรับ เวลาปิดรับ
        รูปแบบการเดิมพัน อัตราจ่ายของรูปแบบนั้น และวงเงินที่ระบบเปิดรับของเลขนั้น ทั้งหมดทำได้จากบัญชีเดียวผ่านมือถือ
      </p>

      <p>
        <strong class="text-[#f3c54e]">หวยแต่ละประเภทและรูปแบบการเดิมพันอาจมีเรทแตกต่างกัน</strong> จึงควรยึดอัตราล่าสุดบนหน้าส่งโพยเป็นหลักทุกครั้ง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
        และตรวจสอบเลขกับยอดเดิมพันก่อนยืนยันโพยทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="แนวทางและสถิติย้อนหลังเป็นข้อมูลประกอบเท่านั้น ไม่การันตีเลขเข้าทุกงวด">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#f3c54e]">แนวทาง เลขเด็ด และสถิติย้อนหลังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถการันตีว่าเลขจะเข้าทุกงวดหรือรับประกันผลรางวัลล่วงหน้าได้</strong>
        เลขที่มีผู้เลือกจำนวนมากคือเลขที่กำลังได้รับความสนใจ ไม่ใช่สัญญาณของผลที่จะเกิดขึ้น และผลของแต่ละรอบไม่ได้ขึ้นกับรอบก่อนหน้า หน้านี้จึงไม่มีการชี้เลขและไม่มีการจัดอันดับว่าเลขใดน่าออกกว่ากัน ส่วนผลหวยของแต่ละรอบให้อ้างอิงประกาศอย่างเป็นทางการเป็นหลัก
      </p>

      <p>
        ในทางเดียวกัน คำว่า <strong class="text-[#f3c54e]">ไม่อั้นจ่าย ไม่ได้หมายความว่าทุกเลขหรือทุกรอบจะไม่มีวงเงินสูงสุด</strong> หากเป็นเลขเด็ดหรือเลขที่มีผู้เลือกจำนวนมาก ควรตรวจสอบวงเงินที่ระบบเปิดรับก่อนยืนยัน
        และเงื่อนไขจริงให้ยึดข้อมูลที่แสดงบนหน้าส่งโพยเป็นหลัก ส่วนคำว่าไม่มีลบโพยหมายถึงโพยที่ระบบรับและยืนยันอย่างสมบูรณ์ตามเงื่อนไขที่ประกาศไว้ กรณีรายการผิดพลาดหรือเป็นโมฆะให้เป็นไปตามข้อกำหนดที่เว็บไซต์ประกาศ
      </p>

      <p>
        สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้โพยของคุณตรวจสอบได้ มากกว่าการชี้เลข คือรู้ว่าส่งเข้ารายการและรอบไหน รูปแบบใด อัตราจ่ายเท่าไร และวงเงินที่ระบบเปิดรับของเลขนั้นอยู่ที่เท่าไร
        เมื่อข้อมูลเหล่านี้ตรงกับที่ตั้งใจแล้วค่อยกดยืนยัน จะตัดปัญหาการส่งผิดรายการหรือผิดรูปแบบออกไปได้เกือบทั้งหมด
      </p>
    </div>
  </ContentBoxNeumorphism>

