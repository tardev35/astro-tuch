---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้คือ "แนวทางอ่านเลขเด็ด เลขดัง ข้อมูลย้อนหลัง และตารางอัตราจ่าย"
// ⚠️⚠️ **หน้านี้ห้ามอ่านเป็นคำสัญญาว่าจะถูกรางวัล** บรีฟรอบนี้
// (src/assets/content.txt) เขียนคำกำกับไว้เองสองประโยคว่า **"ผลการออกรางวัล
// มีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ"** (บรรทัด 4) และ
// **"ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง"** (บรรทัด 12)
// → ประโยคกำกับทุกประโยค ship ครบ ห้ามตัดเพราะฟังดูลบ และ
// **ห้ามเขียนเลขจริงเป็นตัวเลข ห้ามตารางผลย้อนหลัง ห้ามสูตร ห้ามการทำนายผล**
// สิ่งที่หน้านี้ทำได้คือบอก "วิธีอ่าน" ข้อมูลเหล่านั้น ไม่ใช่บอกว่าจะออกเลขอะไร
//
// หัวข้อของหน้านี้มาจาก **เนื้อหาของหน้าเอง** ไม่ใช่จาก docx ของ index —
// บรีฟรอบนี้ไม่มีส่วน SUB-PAGES ส่วนคำว่า "เลขเด็ด" ใช้ได้เฉพาะในหน้านี้
// (brand-spec §5) เพราะเป็นหัวข้อเดิมของหน้านี้ ห้ามให้หลุดไปหน้าอื่น
//
// ข้อเท็จจริงทั้งหมดยึดตาม `src/assets/content.txt` ของรอบนี้เท่านั้น:
// ประเภทหวยมีสี่ชื่อ —
// **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยหุ้นต่างประเทศ** (บรรทัด 4, 6) ·
// แต่ละรายการมีวันประกาศผลและรูปแบบการเดิมพันแตกต่างกัน (บรรทัด 6) ·
// รับทุกเลข ไม่มีเลขอั้น จ่ายเต็มตามอัตราที่กำหนด (บรรทัด 6) · ผู้ใช้งานสามารถ
// ศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลผลรางวัล
// ได้ในช่องทางเดียว (บรรทัด 4) · 2 ตัว 100 ต้องตรวจว่าเป็นสองตัวบนหรือสองตัวล่าง
// และคำนวณจากเงินเดิมพันเท่าใด (บรรทัด 8, 10) · 3 ตัว 1,000 ต้องตรวจว่าเป็น
// สามตัวตรงหรือสามตัวโต๊ด พร้อมฐานเงินเดิมพันและวงเงินจ่ายสูงสุด (บรรทัด 12) ·
// รอบปิดรับ · ยืนยันบิล (บรรทัด 20) · แอดมิน 24ชม. · เก็บหมายเลขรายการและหลักฐาน ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · บัญชีแอบอ้าง · ตรวจเวลาให้บริการจริงจาก
// ประกาศล่าสุด (บรรทัด 22)
//
// ⚠️⚠️ **"หวยออมสิน" / "หวยลาวพัฒนา" / "บาทละ 1,000" ไม่มีในบรีฟรอบนี้** — เป็น
// คำของแบรนด์หวยเจ้าก่อน ๆ ที่เคยเป็นเจ้าของไฟล์นี้ ถอดออกครบแล้ว ห้ามเติมประเภท
// อื่น (ธ.ก.ส. · ยี่กี · ออมสิน) ห้ามเติมใบอนุญาต · หน่วยงานกำกับ · ชื่อธนาคาร ·
// นิติบุคคล · ปีก่อตั้ง · จำนวนสมาชิก · เวลาเป็นตัวเลข · ยอดขั้นต่ำเป็นตัวเลข
// ⚠️⚠️ **บรีฟรอบนี้ไม่มีหมวดโปรโมชั่น และไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลย** →
// เปอร์เซ็นต์คืนยอดเสีย/แนะนำเพื่อนที่เคยอยู่ในไฟล์นี้เป็นคอปปี้ของ **แบรนด์ขาออก
// รอบก่อน** และพิมพ์อยู่บนอาร์ตเวิร์กสไลด์เท่านั้น **ห้ามปรากฏในหน้านี้เลย**
// ตัวเลขที่ขึ้นหน้าได้รอบนี้มีแค่ **2 ตัว 100 · 3 ตัว 1,000 · 3 ขั้นตอน · 24ชม.**
// ⚠️ ห้ามใช้คำของแบรนด์ขาออกและแบรนด์เก่ากว่า (ศัพท์สล็อต/วอลเลท/โปรไม่อั้น ฯลฯ)
// — **ลิสต์คำต้องห้ามทั้งหมดอยู่ที่ `.claude/brand-spec-lotto189.md` §5 ที่เดียว**
//
// CHROME: AnnouncementHuay · FaqHuay — รอบนี้แบรนด์เองเป็นเว็บหวย ชุด *Huay
// จึงเป็นธีมหลักของทั้งเว็บ ไม่ใช่ซับธีมของสองหน้านี้อีกต่อไป (เรียก
// <Announcement /> **แบบ bare** ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน
// **ห้ามส่ง message prop** · FaqHuay มี default faqs = [] จึงต้องส่ง prop faqs)
//
// ธีม: หน้านี้ใช้พาเลตของ .claude/brand-spec-lotto189.md §2 เต็มรูปแบบ
// **เนื้อหาเป็นผิวสว่าง** (พื้นเพจ #fff0f0 จาก bg.json)
//   ผิวการ์ด #ffffff (ตั้งโดย ContentBox) · ชั้นยก #ffe4e6 · wash #ffd4d7
//   เส้นอ่อน #f5b9bd · เส้นเข้ม #a8333f (เส้นเท่านั้น)
//   เนื้อความ #25090f (18.7:1 บนการ์ดขาว) · หมึกรอง #6e3b44 (8.8:1)
//   หัวข้อ/ไฮไลต์ <strong>/ป้าย แดงเลือดนก #b00718 (7.3:1) · แดงลึก #8a0412 (10.4:1)
//   ปุ่มหลัก ไล่เฉด #8a0412 -> #b00718 -> #d61023 + **หมึกขาว #ffffff**
//   ปุ่ม outline ขอบ+ตัวอักษร #b00718 บนผิว #ffffff
// ⚠️⚠️ **ขาวบนพื้นเพจ #fff0f0 ได้แค่ 1.07:1** และ #ff2436 (3.9:1) · #e9b53c (2.0:1)
// · #c3ccd6 · #f5b9bd · #ffd4d7 · #ffe4e6 **ห้ามถือตัวอักษรบนผิวสว่าง**
// ⚠️⚠️ **รอบก่อนหน้านี้เป็นธีมมืดทั้งหน้า** ชุดทอง/ดำที่เคยอยู่ในไฟล์นี้ถอดออก
// ครบแล้ว รวมถึง rgba ของทองเก่า **ลิสต์เฮกซ์ต้องห้ามทั้งหมดอยู่ที่
// `.claude/brand-spec-lotto189.md` §2 ที่เดียว ห้ามคัดลอกมาไว้ในคอมเมนต์ของ
// ไฟล์นี้** (sweep จะสะดุดที่ตัวเอง)
// rgba() ที่อนุญาตรอบนี้: rgba(176,7,24,α) · rgba(193,7,27,α) · rgba(138,4,18,α) ·
// rgba(214,16,35,α) · rgba(37,9,15,α) · rgba(245,185,189,α)
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed` + สีหมึกไว้บนการ์ดแล้ว สีที่เขียนเอง
// มีแค่ไฮไลต์บน <strong> (= #b00718) · **ห้าม mx-auto / max-w-* บน <p>**
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ
// จึงส่ง heading={false} ให้ render เป็น <p>
const checks = [
