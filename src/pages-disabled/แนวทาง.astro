---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้เป็น "แนวทางการจัดโพยและจุดที่ควรตรวจก่อนยืนยัน" ไม่ใช่บริการทำนายผล —
// ไม่มีตัวเลขของงวดใด ไม่มีผลรางวัลจริง ไม่มีวันที่งวด ไม่มีสถิติตัวเลขย้อนหลัง และ
// ไม่รับประกันเลขใด ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันโพย
// (รายการหวย รอบที่เปิดรับ รูปแบบการเดิมพัน อัตราจ่ายที่ระบบแสดง เวลาปิดรับ
// และวงเงินที่ระบบเปิดรับของเลขนั้น)
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของรอบนี้เท่านั้น: รวมแนวทางหวย
// กลุ่มหวย สถิติหวยย้อนหลัง และผลหวยตามรอบที่ประกาศไว้ในหน้าเดียว ครบทั้งหวย
// รัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศ (ลำดับตามบรีฟ) · เลือกเลข
// ส่งโพย และตรวจสอบรายการผ่านมือถือ · ตรวจสอบเวลาเปิดรับ เวลาปิดรับ อัตราจ่าย และ
// ผลของแต่ละรายการได้ก่อนเลือกแทง · อัตราจ่ายของรายการที่เข้าเงื่อนไขคือ 2 ตัว
// จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท ซึ่ง "แต่ละรายการอาจกำหนดอัตราจ่ายหรือ
// วงเงินแตกต่างกัน" ตามประเภทหวยและรูปแบบการเดิมพัน (L9, L11) — เฮดจ์ประโยคนี้
// ต้องอยู่บนหน้านี้เสมอ เช่นเดียวกับ "แนวทางหรือสถิติย้อนหลังเป็นเพียงข้อมูลประกอบ
// ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป" (L7) · สมัคร 3 ขั้นตอน ·
// แอดมิน 24 ชั่วโมง
//
// มุมของบรีฟรอบก่อน (เลขเด็ด · เลขดัง · ไม่จำกัด / แทงได้ไม่อั้น · "หวยลาว" เฉย ๆ
// แทนลาวพัฒนา · ฮานอยปกติ/พิเศษ/วีไอพี · ฝากถอนวอลเลทและธนาคาร · เช็คผลทันที)
// ไม่ได้อยู่ในบรีฟรอบนี้ จึงถูกถอดออกจากหน้านี้แล้ว ห้ามเติมกลับ และห้ามเติมสถิติ
// ตัวเลขจริง ผลย้อนหลัง วันที่งวด เวลาออกรางวัลรายรายการ ใบอนุญาต ชื่อธนาคาร
// เงื่อนไขฝาก-ถอน หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 / 3 ขั้นตอน /
// 24 ชั่วโมง และห้ามใช้คำนอกหมวดหวยทุกคำ
//
// หน้านี้ใช้ข้อยกเว้น "หมวดหวยคงธีม Huay" ของ brand-spec §3 / SKILL.md Phase 4.5
// ข้อ 5: รูปทรงแดง-ทอง-ดำ ของ /ตรวจหวย กับ /แนวทาง เป็นของหมวดหวยโดยตั้งใจ รอบนี้
// แบรนด์เป็นเว็บแทงหวยล้วน ธีมนี้จึงเป็นธีมของแบรนด์เอง และ AnnouncementHuay เป็น
// ticker ของทุกหน้าในไซต์ ไม่ใช่ของเฉพาะหมวดหวยอีกต่อไป — ข้อยกเว้นครอบเฉพาะธีม
// เท่านั้น ชื่อแบรนด์และเนื้อหาต้องเป็นของรอบปัจจุบันทั้งหมด ชื่อแบรนด์จึงมาจาก
// BRAND_NAME ไม่พิมพ์ทับ
//
// ค่าสีของไฟล์นี้เคยเป็นชุดทอง-แดงของรอบ หวยเฮง789 ทั้งไฟล์ (พื้นน้ำตาลแดง ทอง
// อำพัน และเนื้อความสีครีมอมส้ม) ตอนนี้ถูกเปลี่ยนมาใช้เลขจริงของ brand-spec §2
// รอบนี้ครบทุกจุดแล้ว ตามบทบาทที่ §2 กำหนด: พื้นลึกสุด #140203 · พื้นการ์ด #240406 ·
// พื้นยกระดับ/ปุ่มรอง #3a0a0c · ทองลึก #c08a07 · ทองแบรนด์ #ffc93c · ทองอ่อน
// #ffeab0 · เนื้อความ #f6e7e0 · หมึกบนพื้นทอง #1a0303 ปุ่มทองจบไล่เฉดที่ #c08a07
// ตามกฎคอนทราสต์ของ §2 (เข้มกว่านั้นหมึก #1a0303 จะตก) และไม่มีหมึกทองบนพื้นแดง
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "รายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน เพราะหวยแต่ละประเภทมีตารางเวลาเป็นของตัวเอง ให้เปิดดูจากหน้าเว็บไซต์ก่อนว่ารอบไหนกำลังเปิดรับ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง",
    type: "รอบที่เปิดรับ",
    note: "ต่างกันตามรายการ",
  },
  {
    title: "เลือกรายการหวยให้ตรงกับเลขที่คิดไว้",
    desc: "บัญชีเดียวรวมหวยรัฐบาลไทย หวยฮานอย หวยลาวพัฒนา และหวยหุ้นต่างประเทศไว้ด้วยกัน ให้เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วค่อยลงเลขในรอบของรายการนั้น",
    type: "รายการหวย",
    note: "รัฐบาลไทย · ฮานอย · ลาวพัฒนา · หุ้นต่างประเทศ",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือก",
    desc: "อัตราของรายการที่เข้าเงื่อนไขคือ 2 ตัว จ่าย 100 บาท และ 3 ตัว จ่าย 1,000 บาท แต่อาจแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน ให้ยึดอัตราที่ระบบแสดงในหน้าส่งโพยของรอบนั้น",
    type: "อัตราจ่าย",
    note: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    title: "ดูวงเงินที่ระบบเปิดรับของเลขนั้นก่อนลงยอด",
    desc: "เลือกเลขที่ตั้งใจไว้ได้ตามรายการที่เปิดรับ แต่ยอดต่อเลขให้อ้างอิงวงเงินที่ระบบเปิดรับจริงของรอบนั้น เพราะแต่ละประเภทหวย แต่ละเลข และแต่ละรอบอาจกำหนดวงเงินไม่เท่ากัน",
    type: "วงเงิน",
    note: "ต่างกันตามเลขและรอบ",
  },
  {
    title: "ถือแนวทางเป็นข้อมูลประกอบ ไม่ใช่คำทำนาย",
    desc: "แนวทางเลือกเลขทุกรูปแบบเป็นเพียงข้อมูลประกอบการตัดสินใจ ตัวเลขที่ติดตามกันไม่สามารถรับประกันผลรางวัลได้ และผลของแต่ละรอบไม่ขึ้นกับรอบก่อนหน้า",
    type: "แนวทาง",
    note: "ไม่ใช่การรับประกัน",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงของรอบนั้น แล้วเผื่อเวลาไว้ตรวจทานเลขและยอดอีกครั้ง",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจโพยย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูรายการย้อนหลังได้เองจากบัญชีสมาชิก ทั้งเลขที่ส่ง ยอดเดิมพัน อัตราจ่ายที่บันทึกไว้ และสถานะที่อัปเดตหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจรายการ",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 153 ตัวอักษร
const pageDescription = `แนวทางหวย ${BRAND_NAME} รวมจุดที่ควรตรวจก่อนส่งโพย รายการหวย รอบที่เปิดรับ รูปแบบเลข อัตราจ่าย และวงเงินที่ระบบเปิดรับ เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่คำทำนาย`;

const graph = pageGraph(Astro, {
  name: `แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทางหวย ${BRAND_NAME} จุดที่ควรตรวจและอัตราจ่ายก่อนยืนยันโพย`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={`แนวทางหวย ${BRAND_NAME} ข้อมูลอ้างอิงประกอบการตัดสินใจก่อนส่งโพย`} as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        หน้านี้รวบรวมแนวทางจัดโพยและจุดที่ควรตรวจของ <strong class="text-[#ffeab0]">{BRAND_NAME}</strong> ไว้ให้สมาชิกใช้วางแผนก่อนถึงเวลาปิดรับ โดยบัญชีเดียวรวมหวยรัฐบาลไทย หวยฮานอย
        หวยลาวพัฒนา และหวยหุ้นต่างประเทศไว้ด้วยกัน พร้อมหมวดแนวทางหวย กลุ่มหวย และสถิติหวยย้อนหลัง จึงเลือกประเภทหวยที่ต้องการ เลือกเลข ส่งโพย ตรวจสอบรายการ และดูผลหวยตามรอบที่ประกาศได้จากหน้าเว็บไซต์ผ่านเบราว์เซอร์บนมือถือ
        ส่วนเวลาเปิดรับ เวลาปิดรับ และอัตราจ่ายล่าสุดของแต่ละรายการจะแสดงอยู่ในหน้าส่งโพยของรอบนั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">แนวทางบนหน้านี้เป็นข้อมูลอ้างอิงเท่านั้น ไม่ใช่การทำนายผลและไม่ใช่การรับประกันเลขใด</strong> แนวทางหวยและสถิติหวยย้อนหลังเป็นเพียงข้อมูลประกอบ
        ไม่ได้เพิ่มความแน่นอนในการทายผลหวยรอบถัดไป เพราะผลการออกรางวัลแต่ละรอบไม่ได้ยืนยันจากสถิติที่ผ่านมา
      </p>

      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        <strong class="text-[#ffeab0]">แต่ละรายการอาจกำหนดอัตราจ่ายหรือวงเงินแตกต่างกันตามประเภทหวยและรูปแบบการเดิมพัน จึงไม่ควรถือว่าใช้กับทุกรายการเหมือนกัน</strong> ให้ยึดข้อมูลที่แสดงในหน้าส่งโพยของแต่ละรอบเป็นหลักทุกครั้ง
        ทั้งอัตราจ่ายและวงเงินที่ระบบเปิดรับของเลขนั้น การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="จุดที่ควรตรวจให้ครบก่อนถึงเวลาปิดรับ" as="h2">
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#c08a07]/45 bg-[#140203]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#ffc93c]/60 hover:shadow-[0_15px_30px_rgba(255,201,60,0.22)]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#3a0a0c]/80 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#c08a07]/55 bg-[#240406] px-3 py-1 text-xs font-bold text-[#ffc93c]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#f6e7e0]/70">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#ffeab0] transition-colors group-hover:text-[#ffc93c]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#f6e7e0]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#3a0a0c] pt-4 text-base font-bold text-[#ffc93c]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยันโพย
            </div>
          </li>
        ))
      }
    </ul>
  </ContentBoxHuay>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ตรวจสอบได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f6e7e0]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#ffeab0]">รายการหวยและรอบที่เลือก รูปแบบการเดิมพัน อัตราจ่ายของรูปแบบนั้น เวลาปิดรับ และวงเงินที่ระบบเปิดรับของเลขนั้น</strong>
        เพราะทั้งหมดนี้เป็นตัวกำหนดว่ารายการจะคำนวณผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนแนวทางหวยและเลขที่คิดไว้ล่วงหน้าเป็นเพียงจุดตั้งต้นของการตัดสินใจ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e7e0]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ffc93c]">🎯</span>
          <span>
            <strong class="text-[#ffeab0]">คัดเลขก่อน แล้วค่อยเลือกรายการและรูปแบบ</strong> รวบรวมเลขที่มีในใจให้ครบก่อน จากนั้นเปิดดูว่ารอบนี้เปิดรับรายการใด และอัตราจ่ายของรูปแบบที่เลือกแสดงไว้เท่าไร
          </span>
