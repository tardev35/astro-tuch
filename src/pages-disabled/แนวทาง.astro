// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c เพราะไทย 1 ตัว = 3 ไบต์)
// ปัจจุบัน 155 ตัวอักษร · นับด้วย node -e "console.log([...'…'].length)"
const pageDescription = `แนวทาง ${BRAND_NAME} รวมวิธีอ่านเลขเด็ด เลขดัง และข้อมูลย้อนหลังของหวยแต่ละประเภท พร้อมวิธีอ่านตารางอัตราจ่ายและรอบปิดรับก่อนเลือกหมายเลขและยืนยันบิลหวยทุกครั้ง`;

const pageHeading = `แนวทาง ${BRAND_NAME} อ่านเลขเด็ด เลขดัง และข้อมูลย้อนหลังเป็นข้อมูลประกอบ`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทาง ${BRAND_NAME} อ่านเลขเด็ด เลขดัง และตารางอัตราจ่ายก่อนเลือกเลข`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#b00718]">{BRAND_NAME}</strong> นำเสนอข้อมูลหวยออนไลน์หลายประเภท ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอย และหวยหุ้นต่างประเทศ พร้อมรายละเอียดอัตราจ่ายและรอบประกาศผลที่แตกต่างกัน หน้านี้รวม
        <strong class="text-[#b00718]">แนวทางการอ่านข้อมูลก่อนเลือกหมายเลข</strong> ตั้งแต่การศึกษารูปแบบการเลือกหมายเลข การอ่านเงื่อนไขการเดิมพันของแต่ละรายการ การติดตามข้อมูลผลรางวัลจากแหล่งต่าง ๆ ไปจนถึงการอ่านตารางอัตราจ่ายให้ตรงกับรูปแบบที่เลือกไว้
      </p>

      <p>
        <strong class="text-[#b00718]">หน้านี้ไม่มีเลขแนะนำ ไม่ทำนายผลของงวดใด และไม่ได้บอกว่าควรเลือกหมายเลขใด</strong> เพราะ
        <strong class="text-[#b00718]">ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ</strong> และ
        <strong class="text-[#b00718]">ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง</strong>
        สิ่งที่หน้านี้ทำได้คืออธิบายว่าข้อมูลชุดไหนตรวจสอบได้จริง และควรอ่านจากที่ใดก่อนทำรายการ
      </p>

      <p>
        ก่อนทำรายการทุกครั้งจึงควรตรวจสอบความถูกต้องของข้อมูล วันประกาศผล และเงื่อนไขการเดิมพันของประเภทที่เลือกให้ชัดเจน รวมถึงตารางอัตราจ่าย ฐานเงินเดิมพัน และวงเงินจ่ายสูงสุดของงวดนั้น
        การใช้บริการมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง และตรวจสอบรายละเอียดของรายการให้ครบก่อนยืนยันบิลทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="เลขเด็ด เลขดัง และข้อมูลย้อนหลัง อ่านเป็นข้อมูลประกอบ ไม่ใช่คำรับประกัน">
    <div class="flex flex-col gap-6">
      <p>
        ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบเงื่อนไขการเดิมพัน และติดตามข้อมูลผลรางวัลได้ในช่องทางเดียว โดยควรตรวจสอบความถูกต้องของข้อมูลและข้อกำหนดก่อนทำรายการ เพราะ
        <strong class="text-[#b00718]">ผลการออกรางวัลไม่สามารถรับประกันได้จากสถิติหรือเลขย้อนหลัง</strong> ข้อมูลที่เผยแพร่ตามแหล่งต่าง ๆ จึงควรอ่านเป็นข้อมูลประกอบ ไม่ใช่ข้อสรุปว่างวดถัดไปจะออกเลขใด และควรเทียบกับเงื่อนไขของรายการจริงที่ระบบแสดงอยู่เสมอ
      </p>

      <p>
        ข้อมูลย้อนหลังมีประโยชน์ในแง่การทำความเข้าใจว่าหวยแต่ละประเภทประกาศผลในรูปแบบใด และรายการนั้นรับหมายเลขแบบใดได้บ้าง แต่
        <strong class="text-[#b00718]">ผลการออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำ</strong> การอ่านข้อมูลย้อนหลังจึงไม่ใช่การลดความไม่แน่นอนของงวดถัดไป และไม่ควรใช้แทนการอ่านตารางอัตราจ่าย
        ข้อจำกัดการรับหมายเลข และเงื่อนไขการจ่ายรางวัลของรายการนั้น
      </p>

      <p>
        สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้การตัดสินใจของคุณอยู่บนข้อมูลที่ตรวจสอบได้ มากกว่าการคาดการณ์ผล คือรู้ว่ารายการอยู่ในประเภทหวยและงวดไหน รับหมายเลขรูปแบบใด อัตราจ่ายของรูปแบบนั้นเป็นเท่าไร
        คำนวณจากฐานเงินเดิมพันเท่าใด และวงเงินจ่ายสูงสุดอยู่ที่ระดับใด เมื่อข้อมูลเหล่านี้ตรงกับที่ตั้งใจแล้วค่อยยืนยันบิล
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism as="h2" title="แนวทางอ่านข้อมูลแยกตามประเภทหวยที่เปิดให้บริการ" heading={false} titleleft="หวยรัฐบาลไทย" titlecenter="หวยลาว และหวยฮานอย" titleright="หวยหุ้นต่างประเทศ">
    <p slot="left">หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล จึงควรอ่านรอบปิดรับที่ระบบแสดงให้ตรงกับงวดของสลากกินแบ่งรัฐบาล แล้วตรวจรูปแบบการเลือกหมายเลขกับอัตราจ่ายของรายการอีกครั้งก่อนยืนยัน</p>
    <p slot="center">
      หวยลาวและหวยฮานอยมีวันประกาศผลและรูปแบบการเดิมพันของตัวเอง ให้เลือกประเภทและงวดที่ต้องการให้ชัดก่อนทำรายการ เพราะรายการของทั้งสองประเภทอาจเปิดรับคนละช่วงกัน และอัตราจ่ายไม่จำเป็นต้องเท่ากัน
    </p>
    <p slot="right">หวยหุ้นต่างประเทศอ้างอิงผลของตลาดที่รายการนั้นระบุไว้ จึงควรตรวจสอบแหล่งอ้างอิงผลให้ชัดเจน พร้อมอ่านรอบปิดรับและเงื่อนไขการเดิมพันของรายการก่อนยืนยันบิลทุกครั้ง</p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="จุดที่ตรวจสอบได้จริงก่อนเลือกหมายเลขและยืนยันบิล">
    <div class="flex flex-col gap-6">
      <p>
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนยืนยัน ไม่ใช่การคาดการณ์ผลล่วงหน้า หกจุดด้านล่างเปิดดูได้จากหน้ารายการและประกาศล่าสุดทั้งหมด และเป็นตัวกำหนดว่ารายการจะคิดเงินรางวัลอย่างไร
        กับยอดเงินที่มีสิทธิ์ได้รับจะเป็นไปตามเงื่อนไขของรายการหรือไม่
      </p>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="จุดที่ควรตรวจสอบก่อนเลือกหมายเลขและยืนยันบิล">
        {
          checks.map((item) => (
            <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#f5b9bd] bg-[#ffe4e6] p-6 shadow-[0_8px_20px_rgba(37,9,15,0.08)] transition-all duration-300 hover:-translate-y-2 hover:border-[#b00718] hover:shadow-[0_14px_28px_rgba(176,7,24,0.2)]">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#b00718]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />

              <div class="mb-4 flex items-center justify-between gap-3">
                <span class="rounded-full border border-[#b00718]/50 bg-[#ffffff] px-3 py-1 text-xs font-bold text-[#b00718]">{item.type}</span>
                <span class="text-right text-xs font-medium text-[#6e3b44]">{item.note}</span>
              </div>

              <span class="mb-2 block text-xl font-bold text-[#b00718] transition-colors group-hover:text-[#8a0412]">{item.title}</span>

              <p class="mb-6">{item.desc}</p>

              <div class="mt-auto flex items-center gap-2 border-t border-[#f5b9bd] pt-4 text-base font-bold text-[#8a0412]">
                <span aria-hidden="true">🧾</span>
                อ่านรอบปิดรับและตารางอัตราจ่ายจากเว็บไซต์ทางการก่อนทำรายการ
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title={`อ่านประกาศล่าสุดและติดต่อแอดมิน ${BRAND_NAME} ได้ตลอด 24ชม.`}>
    <div class="flex flex-col gap-6">
      <p>
        ประกาศล่าสุดของเว็บไซต์ทางการเป็นที่เดียวที่เงื่อนไขของรายการ รอบปิดรับ และตารางอัตราจ่ายจะตรงกับที่เปิดใช้งานจริง จึงควรอ่านทุกครั้งก่อนเลือกหมายเลข เพราะหวยรัฐบาลไทย หวยลาว หวยฮานอย
        และหวยหุ้นต่างประเทศอาจกำหนด <strong class="text-[#b00718]">รอบปิดรับและอัตราจ่าย</strong> ไม่เท่ากัน และข้อจำกัดการรับหมายเลขของแต่ละงวดก็เปลี่ยนได้ตามประกาศ
      </p>

      <p>
        ก่อน <strong class="text-[#b00718]">ยืนยันบิล</strong> ให้ไล่ตรวจอีกครั้งว่าประเภทหวย งวด รูปแบบการเลือกหมายเลข และอัตราจ่ายบนหน้ารายการตรงกับที่ตั้งใจไว้ เพราะค่าที่ระบบแสดงตอนยืนยันคือค่าที่ถูกบันทึกลงในบิลนั้นจริง
        หลังยืนยันแล้วให้เก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบย้อนหลัง
      </p>

      <p>
        หากมีข้อสงสัยเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย เงื่อนไขของรายการ หรือการใช้งานบัญชี ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม.
        และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง พร้อมแจ้งรายละเอียดให้ชัดเจน โดย
        <strong class="text-[#b00718]">ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong> ทั้งนี้ ควรตรวจสอบเวลาการให้บริการจริงจากประกาศล่าสุดอีกครั้ง
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#8a0412] via-[#b00718] to-[#d61023] px-8 py-4 font-black text-[#ffffff] shadow-[0_6px_18px_rgba(176,7,24,0.3)] transition-transform hover:scale-105">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
        <a
          href="/ตรวจหวย"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#b00718] bg-[#ffffff] px-8 py-4 font-bold text-[#b00718] shadow-[0_6px_18px_rgba(176,7,24,0.15)] transition-colors hover:bg-[#ffe4e6]">
          <span aria-hidden="true">🧾</span> ตรวจผลรางวัลและตรวจบิล
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับแนวทางการอ่านข้อมูลหวยของ ${BRAND_NAME}`} faqs={faqs} />

  <Navfoot />
</MainLayout>
