---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้คือ "แนวทางการตรวจสอบข้อมูลก่อนตัดสินใจ" ไม่ใช่การชี้นำผลรางวัล
// ⚠️ ห้ามเขียนเลขเด็ด เลขแนะนำ สถิติย้อนหลัง สูตร เทคนิค หรือการทำนายผลใด ๆ —
// บรีฟรอบนี้ (src/assets/content.txt) ไม่มีสิ่งเหล่านั้นเลยสักบรรทัด และบรีฟเขียน
// ไว้เองว่า "ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้" (บรรทัด 12) รอบก่อน ๆ ของ
// ไฟล์นี้เป็นแบรนด์หวยอีกเจ้าที่บรีฟของมันพูดเรื่องแนวทางตัวเลข/สถิติย้อนหลังเอง —
// รอบนี้ไม่ใช่ ห้ามสืบทอด
//
// ⚠️ ประโยคกำกับความเสี่ยงของบรีฟต้องขึ้นครบ ห้ามตัดเพราะฟังดูลบ: ข้อมูลเกี่ยวกับ
// บริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้ (บรรทัด 4) ·
// ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละ
// ประเภทก่อนทำรายการ (บรรทัด 6) · ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้
// (บรรทัด 12) · ควรอ่านเงื่อนไขล่าสุดก่อนรับสิทธิ์ และตรวจสอบว่าโปรโมชั่นใช้ร่วมกัน
// ได้หรือไม่ (บรรทัด 14) · เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพัน
// ครั้งต่อไป (บรรทัด 16)
//
// ข้อเท็จจริงอื่นยึดตามบรีฟรอบนี้เท่านั้น: ประเภทหวยสี่ชื่อ — หวยรัฐบาลไทยที่
// อ้างอิงผลสลากกินแบ่งรัฐบาล หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศที่มีรอบ
// ประกาศผลแตกต่างกัน (บรรทัด 4, 6) · อัตราจ่ายตัวอย่าง เลข 2 ตัว 100 และเลข 3 ตัว
// 1,000 พร้อมข้อจำกัดยอดรับและวงเงินจ่ายสูงสุด (บรรทัด 8, 10, 12) · คืนยอดเสีย
// 0.3% และแนะนำเพื่อน 0.8% มีเงื่อนไขเรื่องประเภทหวย ยอดที่นำมาคำนวณ รอบรับเครดิต
// และจำนวนบัญชีที่เข้าร่วม (บรรทัด 14, 16, 18) · ฝากถอนผ่านธนาคารและวอลเลท ต้องดู
// ยอดขั้นต่ำ ระยะเวลาดำเนินการ และชื่อบัญชีปลายทาง (บรรทัด 20) · บัญชีแอบอ้าง ·
// รหัสผ่าน · รหัส OTP · แอดมิน 24ชม. (บรรทัด 22)
//
// ⚠️ ห้ามเติมประเภทหวยอื่น (ออมสิน ธ.ก.ส. ยี่กี) ห้ามเติมใบอนุญาต · หน่วยงานกำกับ ·
// ชื่อธนาคาร · ชื่อค่ายเกม · นิติบุคคล · ปีก่อตั้ง · จำนวนสมาชิก · เวลาเป็นตัวเลข ·
// ยอดขั้นต่ำเป็นตัวเลข — ตัวเลขที่ขึ้นหน้าได้มีแค่ 2 ตัว 100 · 3 ตัว 1,000 · 0.3% ·
// 0.8% · 24ชม. และห้ามใช้คำที่บรีฟไม่มี (สล็อต · บาคาร่า · ยิงปลา · ไฮโล · บอล ·
// คาสิโนสด · RTP · ค่ายเกม · เว็บตรง · ไม่ผ่านเอเย่นต์ · ระบบดูแลการเงิน ·
// ปลอดภัยไม่ผ่านม้า · มงกุฎ · หวยคิง)
//
// CHROME: AnnouncementHuay · FaqHuay — รอบนี้ทั้งเว็บย้ายไป Announcement5 / Faq3
// แล้ว สองหน้าหวย (หน้านี้กับ /ตรวจหวย) เก็บชุด *Huay + *Neumorphism ไว้เป็น
// ซับธีมตามข้อยกเว้น Phase 4.5 ของ playbook โดยตั้งใจ (เรียก <Announcement />
// แบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน ห้ามส่ง message prop ·
// FaqHuay มี default faqs = [] จึงต้องส่ง prop faqs ทุกครั้ง)
//
// ธีม: ⚠️ ข้อยกเว้น Phase 4.5 คุ้มครอง **ชุดคอมโพเนนต์** เท่านั้น ไม่ได้คุ้มครอง
// พาเลตเก่าหรือชื่อแบรนด์เก่า — หน้านี้ใช้พาเลตของ brand-spec §2 เต็มรูปแบบ
// (ธีมสว่าง: พื้นเพจ #ffdbdb จาก bg.json)
//   ผิวการ์ด #ffffff · อินเซ็ต #fff1ef · เนื้อความ #4a0f0f (15.4:1)
//   หัวข้อ/ขอบ/ออรา/พื้นถมปุ่ม #c30303 (6.3:1 · ขาวบนพื้นนี้ 6.3:1)
//   ไฮไลต์บน <strong> #8f0505 (9.6:1) — สงวนไว้ให้งานนั้นงานเดียว
// ⚠️ ทองโบราณ #dcb95f #b8862b #96681f เป็นสีของโครมเท่านั้น (บนการ์ดขาวได้แค่
// 1.9–3.5:1) หน้านี้จึงไม่มีทองเลย และไม่มีแดงสแกเลต #e81313 ถือตัวอักษรหรือเป็น
// พื้นของตัวอักษร
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed` + สีหมึกไว้บนการ์ดแล้ว สีที่เขียนเอง
// มีแค่ไฮไลต์บน <strong> (= #8f0505)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ
// จึงส่ง heading={false} ให้ render เป็น <p>
const checks = [
  {
    title: "เลือกประเภทหวยให้ตรงกับรายการที่ต้องการ",
    desc: "ระบบรวมประเภทหวยไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ ให้เลือกประเภทให้ชัดก่อน เพราะเงื่อนไขของแต่ละประเภทไม่เหมือนกัน",
    type: "ประเภทหวย",
    note: "รัฐบาลไทย · ลาวพัฒนา · ฮานอย · หุ้น",
  },
  {
    title: "อ่านรอบเปิดรับ รอบปิดรับ และรอบประกาศผลของรายการนั้น",
    desc: "แต่ละรายการมีรอบเปิดรับ รอบปิดรับ และรอบประกาศผลของตัวเอง ให้อ่านวันเวลาที่ระบบแสดงบนรายการนั้นก่อนทำรายการ เพราะรายการที่ปิดรับแล้วจะทำรายการเพิ่มไม่ได้",
    type: "รอบปิดรับ",
    note: "ตามที่ระบบแสดง",
  },
  {
    title: "ตรวจตารางอัตราจ่ายและเงื่อนไขก่อนยืนยันรายการ",
    desc: "บรีฟระบุตัวอย่างอัตราจ่ายเลข 2 ตัว 100 และเลข 3 ตัว 1,000 แต่อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการเดิมพัน และเงื่อนไขของแต่ละรอบ ให้ยึดตารางอัตราจ่ายล่าสุดที่ระบบแสดง",
    type: "อัตราจ่าย",
    note: "2 ตัว 100 · 3 ตัว 1,000",
  },
  {
    title: "ตรวจเลขอั้น การจำกัดยอดรับ และวงเงินจ่ายสูงสุด",
    desc: "ก่อนยืนยันรายการควรอ่านเงื่อนไขเรื่องเลขอั้น การจำกัดยอดรับ ฐานเงินเดิมพันที่ใช้คำนวณ และวงเงินจ่ายสูงสุดของรอบนั้น เพราะหลักเกณฑ์อาจต่างกันตามประเภทหวย",
    type: "ข้อจำกัดยอดรับ",
    note: "อ่านจากตารางทางการ",
  },
  {
    title: "อ่านเงื่อนไขโปรโมชั่นจากประกาศล่าสุด",
    desc: "รายการคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% อาจมีเงื่อนไขเรื่องประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนบัญชีที่เข้าร่วมต่างกัน จึงควรอ่านก่อนรับสิทธิ์",
    type: "โปรโมชั่น",
    note: "คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8%",
  },
  {
    title: "ตรวจชื่อบัญชีปลายทางก่อนทำธุรกรรมฝากถอน",
    desc: "ก่อนทำธุรกรรมควรศึกษาช่องทางฝากถอนผ่านธนาคารและวอลเลทที่เปิดใช้งานจริง ยอดขั้นต่ำ ระยะเวลาดำเนินการ และตรวจชื่อบัญชีปลายทางให้ตรงกับข้อมูลที่ยืนยันได้",
    type: "ฝากถอน",
    note: "ธนาคาร · วอลเลท",
  },
];

const faqs = [
  {
    q: `แนวทางบน ${BRAND_NAME} บอกได้ไหมว่าผลรางวัลรอบถัดไปจะออกอะไร?`,
    a: "ไม่ได้ ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้ หน้านี้จึงไม่มีการชี้นำผลรางวัลและไม่มีการทำนายผลของรอบใด สิ่งที่ตรวจสอบได้จริงก่อนทำรายการคือประเภทหวย รอบเปิดรับ รอบปิดรับ รอบประกาศผล อัตราจ่าย เงื่อนไขของรายการ และแหล่งอ้างอิงผลรางวัลที่ระบุไว้",
  },
  {
    q: "ควรตรวจอะไรก่อนทำรายการทุกครั้ง?",
    a: "ควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละประเภทให้ชัดเจนก่อนทำรายการ เพราะหวยแต่ละประเภทมีรอบประกาศผลแตกต่างกัน และควรอ่านเงื่อนไขเรื่องเลขอั้น การจำกัดยอดรับ และวงเงินจ่ายสูงสุดประกอบด้วย",
  },
  {
    q: "โปรโมชั่นคืนยอดเสีย 0.3% ใช้ได้กับหวยทุกประเภทหรือไม่?",
    a: "ควรตรวจสอบเงื่อนไขจากประกาศล่าสุด เพราะหวยแต่ละประเภทอาจมีหลักเกณฑ์การคำนวณยอดเสียและรอบรับเครดิตแตกต่างกัน ทั้งนี้ เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป",
  },
  {
    q: `จะตรวจสอบข้อมูลเกี่ยวกับบริษัทแม่ของ ${BRAND_NAME} ได้อย่างไร?`,
    a: "ข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ หน้านี้จึงไม่สรุปแทนผู้ใช้งานว่าควรเชื่อคำกล่าวอ้างใด แต่บอกว่าข้อมูลชุดใดเปิดดูได้จากระบบจริงและควรตรวจก่อนทำรายการ",
  },
  {
    q: `สอบถามเรื่องรอบปิดรับ อัตราจ่าย หรือเงื่อนไขกับ ${BRAND_NAME} ได้ที่ไหน?`,
    a: `ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม. และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง โดยไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น`,
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 157 ตัวอักษร
const pageDescription = `แนวทาง ${BRAND_NAME} รวมสิ่งที่ควรตรวจก่อนทำรายการ ทั้งรอบปิดรับ รอบประกาศผล อัตราจ่าย เงื่อนไขของแต่ละรายการ และการอ่านประกาศล่าสุด เป็นข้อมูลประกอบก่อนตัดสินใจ`;

const pageHeading = `แนวทาง ${BRAND_NAME} ข้อมูลที่ควรตรวจสอบก่อนทำรายการหวยแต่ละประเภท`;

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title={`แนวทาง ${BRAND_NAME} ตรวจรอบปิดรับ อัตราจ่าย และเงื่อนไขก่อนทำรายการ`} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#8f0505]">{BRAND_NAME}</strong> รวบรวมข้อมูลหวยหลายประเภทไว้ในเว็บไซต์เดียว ทั้งหวยรัฐบาลไทย หวยลาวพัฒนา หวยฮานอย และหวยหุ้นต่างประเทศ หน้านี้รวม
        <strong class="text-[#8f0505]">แนวทางการตรวจสอบข้อมูลก่อนตัดสินใจ</strong> ตั้งแต่การเลือกประเภทหวย การอ่านรอบเปิดรับและรอบประกาศผล การตรวจตารางอัตราจ่ายและเงื่อนไขของแต่ละรายการ
        ไปจนถึงการอ่านประกาศล่าสุดของเว็บไซต์ทางการก่อนรับสิทธิ์โปรโมชั่น
      </p>

      <p>
        <strong class="text-[#8f0505]">หน้านี้ไม่ได้ชี้นำผลรางวัล ไม่ได้ทำนายผลของรอบใด และไม่ได้บอกว่าควรเลือกตัวเลขใด</strong> สิ่งที่หน้านี้ทำได้คือบอกว่าข้อมูลชุดไหนตรวจสอบได้จริง
        และควรตรวจจากที่ใดก่อนทำรายการ เพราะหวยแต่ละประเภทมีรอบประกาศผลแตกต่างกัน และอัตราจ่ายกับเงื่อนไขของแต่ละรายการอาจไม่เหมือนกัน
      </p>

      <p>
        ก่อนทำรายการทุกครั้งควรตรวจสอบวันเวลาเปิดรับ อัตราจ่าย แหล่งอ้างอิงผลรางวัล และข้อกำหนดของแต่ละประเภทให้ชัดเจน ส่วนข้อมูลเกี่ยวกับบริษัทแม่และประวัติการให้บริการ
        ควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ การใช้บริการมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง และตรวจสอบรายละเอียดของรายการให้ครบก่อนยืนยันทุกครั้ง
      </p>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title="ข้อมูลบนหน้านี้เป็นข้อมูลประกอบ ไม่ใช่การชี้นำผลรางวัล">
    <div class="flex flex-col gap-6">
      <p>
        <strong class="text-[#8f0505]">ผลรางวัลไม่สามารถคาดการณ์หรือรับประกันได้</strong> และข้อมูลเกี่ยวกับบริษัทแม่กับประวัติการให้บริการก็ควรตรวจสอบจากหลักฐานที่เชื่อถือได้ก่อนตัดสินใจ
        หน้านี้จึงไม่สรุปแทนผู้ใช้งานว่าควรเชื่อคำกล่าวอ้างใด แต่บอกว่าข้อมูลชุดใดเปิดดูได้จากระบบจริงและควรตรวจก่อนทำรายการ
      </p>

      <p>
        ในทางเดียวกัน <strong class="text-[#8f0505]">เครดิตคืนยอดเสียไม่ได้รับประกันผลตอบแทนจากการเดิมพันครั้งต่อไป</strong> รายการคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8%
        เป็นรายการที่มีเงื่อนไขของตัวเอง ทั้งประเภทหวยที่เข้าร่วม ยอดที่นำมาคำนวณ รอบรับเครดิต และจำนวนบัญชีที่เข้าร่วม ก่อนรับสิทธิ์ควรอ่านเงื่อนไขล่าสุดและตรวจสอบว่าโปรโมชั่นใช้ร่วมกันได้หรือไม่
      </p>

      <p>
        สิ่งที่หน้านี้ช่วยได้จึงเป็นการทำให้รายการของคุณตรวจสอบได้ มากกว่าการคาดการณ์ผล คือรู้ว่ารายการอยู่ในประเภทหวยและรอบไหน อัตราจ่ายเท่าไร เงื่อนไขของรายการเป็นอย่างไร
        และแหล่งอ้างอิงผลรางวัลของรอบนั้นคืออะไร เมื่อข้อมูลเหล่านี้ตรงกับที่ตั้งใจแล้วค่อยยืนยันรายการ จะตัดปัญหาการทำรายการผิดประเภทหรือผิดรอบออกไปได้เกือบทั้งหมด
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="สิ่งที่ควรตรวจก่อนทำรายการ แยกตามประเภทหวยที่เปิดให้บริการ"
    heading={false}
    titleleft="หวยรัฐบาลไทย"
    titlecenter="หวยลาวพัฒนา และหวยฮานอย"
    titleright="หวยหุ้นต่างประเทศ">
    <p slot="left">
      หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล จึงควรอ่านรอบปิดรับที่ระบบแสดงให้ตรงกับรอบประกาศผลของสลากกินแบ่งรัฐบาล แล้วตรวจอัตราจ่ายกับเงื่อนไขของรายการอีกครั้งก่อนยืนยัน
    </p>
    <p slot="center">
      หวยลาวพัฒนาและหวยฮานอยมีรอบประกาศผลตามประเภทของตัวเอง ให้เลือกประเภทและรอบที่ต้องการให้ชัดก่อนทำรายการ เพราะรายการของทั้งสองประเภทอาจเปิดรับคนละช่วงกัน และอัตราจ่ายไม่จำเป็นต้องเท่ากัน
    </p>
    <p slot="right">
      หวยหุ้นต่างประเทศมีรอบประกาศผลของตัวเอง จึงควรตรวจสอบแหล่งอ้างอิงผลรางวัลที่ระบุไว้บนรายการนั้นให้ชัดเจน พร้อมอ่านรอบปิดรับและเงื่อนไขของรายการก่อนยืนยันทุกครั้ง
    </p>
  </ContentBox3ThreeNeumorphism>

  <ContentBox as="h2" title="จุดที่ตรวจสอบได้จริงก่อนทำรายการ รอบปิดรับ อัตราจ่าย และเงื่อนไขของรายการ">
    <div class="flex flex-col gap-6">
      <p>
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนยืนยัน ไม่ใช่การคาดการณ์ผลล่วงหน้า หกจุดด้านล่างเปิดดูได้จากหน้ารายการและประกาศล่าสุดทั้งหมด และเป็นตัวกำหนดว่ารายการจะคิดเงินรางวัลอย่างไร
        กับสิทธิ์ที่ได้รับจะเป็นไปตามเงื่อนไขของรายการหรือไม่
      </p>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="จุดที่ควรตรวจสอบก่อนทำรายการ">
        {
          checks.map((item) => (
            <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#c30303]/30 bg-[#fff1ef] p-6 shadow-[0_8px_20px_rgba(74,15,15,0.1)] transition-all duration-300 hover:-translate-y-2 hover:border-[#c30303]/70 hover:shadow-[0_14px_28px_rgba(195,3,3,0.18)]">
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-white to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

              <div class="mb-4 flex items-center justify-between gap-3">
                <span class="rounded-full border border-[#c30303]/40 bg-white px-3 py-1 text-xs font-bold text-[#c30303]">{item.type}</span>
                <span class="text-right text-xs font-medium text-[#c30303]">{item.note}</span>
              </div>

              <span class="mb-2 block text-xl font-bold text-[#c30303] transition-colors group-hover:text-[#4a0f0f]">{item.title}</span>

              <p class="mb-6">{item.desc}</p>

              <div class="mt-auto flex items-center gap-2 border-t border-[#c30303]/30 pt-4 text-base font-bold text-[#4a0f0f]">
                <span aria-hidden="true">🧾</span>
                ตรวจรอบปิดรับและอัตราจ่ายจากเว็บไซต์ทางการก่อนทำรายการ
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </ContentBox>

  <ContentBoxNeumorphism as="h2" title={`อ่านประกาศล่าสุดและติดต่อเจ้าหน้าที่ ${BRAND_NAME} ได้ตลอด 24ชม.`}>
    <div class="flex flex-col gap-6">
      <p>
        ประกาศล่าสุดของเว็บไซต์ทางการเป็นที่เดียวที่เงื่อนไขของรายการ รอบปิดรับ อัตราจ่าย และรายละเอียดโปรโมชั่นจะตรงกับที่เปิดใช้งานจริง จึงควรอ่านทุกครั้งก่อนรับสิทธิ์หรือทำรายการฝากถอน
        ส่วนช่องทางฝากถอนผ่านธนาคารและวอลเลท ควรศึกษายอดขั้นต่ำ ระยะเวลาดำเนินการ และตรวจ <strong class="text-[#8f0505]">ชื่อบัญชีปลายทาง</strong> ให้ตรงกับข้อมูลที่ยืนยันได้
        หากพบธุรกรรมล่าช้าหรือข้อมูลบัญชีผิดปกติ ควรเก็บหลักฐานการทำรายการและติดต่อผู้ให้บริการชำระเงินโดยเร็ว ไม่ควรโอนเงินซ้ำโดยไม่ได้ตรวจสอบสถานะรายการเดิม
      </p>

      <p>
        หากมีข้อสงสัยเกี่ยวกับประเภทหวย รอบปิดรับ อัตราจ่าย เงื่อนไขของรายการ หรือการใช้งานบัญชี ติดต่อเจ้าหน้าที่ผ่านช่องทางที่ระบุไว้บนเว็บไซต์ทางการได้ตลอด 24ชม.
        และควรตรวจสอบช่องทางติดต่อจากเว็บไซต์ทางการก่อนส่งข้อความเพื่อหลีกเลี่ยงบัญชีแอบอ้าง พร้อมเก็บหมายเลขรายการและหลักฐานที่เกี่ยวข้องไว้สำหรับตรวจสอบ โดย
        <strong class="text-[#8f0505]">ไม่เปิดเผยรหัสผ่านหรือรหัส OTP ให้บุคคลอื่น</strong>
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/register"
          class="flex items-center justify-center gap-2 rounded-xl bg-[#c30303] px-8 py-4 font-black text-white shadow-[0_6px_18px_rgba(195,3,3,0.35)] transition-transform hover:scale-105">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก {BRAND_NAME}
        </a>
        <a
          href="/ตรวจหวย"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#c30303]/50 bg-white px-8 py-4 font-bold text-[#c30303] shadow-[0_6px_18px_rgba(74,15,15,0.14)] transition-colors hover:bg-[#fff1ef]">
          <span aria-hidden="true">🧾</span> ตรวจผลรางวัลและตรวจสอบรายการ
        </a>
      </div>
    </div>
  </ContentBoxNeumorphism>

  <Faq as="h2" title={`คำถามที่พบบ่อยเกี่ยวกับแนวทางการตรวจสอบข้อมูลของ ${BRAND_NAME}`} faqs={faqs} />

