---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น "รูปแบบการดูสถิติและแนวทางเลือกเลข" ไม่ใช่บริการทำนายผล — LOTTOPLUS
// ไม่ประกาศผลรางวัลเอง ไม่มีเลขเด็ด ไม่รับประกันเลขใด และไม่มีแนวทางใดที่ใช้เป็น
// การการันตีได้ ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยันโพย (รายการหวย
// รอบที่เปิดรับ รูปแบบการแทง อัตราจ่ายที่ระบบแสดง เวลาปิดรับ) ไม่ใช่ "เลขเด่นงวดนี้"
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt ของ LOTTOPLUS เท่านั้น: รวมหวย
// รัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ในบัญชีเดียว · เลือกเลข ส่งโพย ตรวจสอบ
// รายการ และตรวจผลหวยได้จากหน้าเว็บไซต์โดยไม่ต้องติดตั้งแอป · หวยหุ้นมีรอบเดิมพัน
// แตกต่างกันในแต่ละวัน · อัตราจ่าย 2 ตัว 100 และ 3 ตัว 1,000 ซึ่ง "อาจขึ้นอยู่กับ
// ประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพย
// เป็นหลัก" (L10) — เฮดจ์ประโยคนี้ต้องอยู่บนหน้านี้เสมอ · แอดมิน 24 ชั่วโมง
// ห้ามเติมสถิติตัวเลขจริง ผลย้อนหลัง วันที่ เลขเด็ด เวลาออกรางวัลรายรายการ ชื่อ
// ธนาคาร เงื่อนไขฝาก-ถอน หรือตัวเลขอื่นนอกชุด 2 ตัว 100 / 3 ตัว 1,000 / 0.3% /
// 0.8% / 24 ชั่วโมง และห้ามใช้คำสายคาสิโนทุกคำ
//
// ข้อยกเว้น "หน้าหวยคงธีม Huay" ของ Phase 4.5 ไม่ถูกใช้เป็นข้อยกเว้นในรอบนี้:
// กฎนั้นมีไว้กันไม่ให้ฮิวของแบรนด์คาสิโนถูกยัดลงหมวดหวย แต่ LOTTOPLUS เป็นเว็บหวย
// และพาเลตต์ของแบรนด์เองก็เป็นแดง-ทองอยู่แล้ว หน้านี้จึงรีธีมตามพาเลตต์ §2 เหมือน
// ทุกหน้า — ชุดแดงของ LOTTO24/888PARUAY รอบก่อน (#dc2626 #fc2b2c #b40102 #fbbf24
// #a16207 #fde68a #15060a #2a0405 #f6e2e2 #e0c4c4 #fcdc2b #fff6ae #a87d0c #cf1111
// #240808 #140404 #3a0f0f #e8e4c6 #c3b98f) ออกครบแล้ว
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> (บทบาท list รับชื่อได้จริง
// ต่างจาก <div> เปล่าที่ aria-label ไม่ถูกประกาศ)
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "รายการที่เปิดรับและรอบของแต่ละวันอาจต่างกัน โดยเฉพาะหวยหุ้นที่มีรอบเดิมพันแตกต่างกันในแต่ละวัน ให้เปิดดูจากหน้าเว็บไซต์ก่อนว่ารอบไหนกำลังเปิดรับ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง",
    type: "รอบที่เปิดรับ",
    note: "ต่างกันตามรายการ",
  },
  {
    title: "เลือกรายการหวยให้ตรงกับเลขที่คิดไว้",
    desc: "บัญชีเดียวรวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ด้วยกัน ให้เลือกรายการที่ตั้งใจแทงให้ชัดก่อน แล้วค่อยลงเลขในรอบของรายการนั้น",
    type: "รายการหวย",
    note: "ไทย · ลาวพัฒนา · ฮานอย · หุ้น",
  },
  {
    title: "อ่านอัตราจ่ายของรูปแบบที่เลือก",
    desc: "อัตราจ่ายที่ประกาศไว้คือหวย 2 ตัว 100 และหวย 3 ตัว 1,000 แต่อัตราจริงอาจต่างกันตามประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ ให้ยึดตัวเลขที่ระบบแสดงในหน้าส่งโพยของรอบนั้น",
    type: "อัตราจ่าย",
    note: "ยึดตัวเลขที่ระบบแสดง",
  },
  {
    title: "ดูสถิติเป็นข้อมูลอ้างอิง ไม่ใช่คำทำนาย",
    desc: "การไล่ดูเลขที่เคยออกของแต่ละรายการเป็นเพียงข้อมูลประกอบการตัดสินใจ ผลของทุกรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า จึงไม่มีแนวทางใดที่ใช้เป็นการรับประกันผลรอบถัดไปได้",
    type: "ดูสถิติ",
    note: "ไม่ใช่การรับประกัน",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงของรอบนั้น แล้วเผื่อเวลาไว้ตรวจทานเลขและยอดอีกครั้ง",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจโพยย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูรายการย้อนหลังได้เองจากบัญชีสมาชิก ทั้งเลขที่ส่ง ยอดเดิมพัน อัตราจ่ายที่บันทึกไว้ และสถานะที่อัปเดตหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจรายการ",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (นับตัวอักษร ไม่ใช่ไบต์ — ห้ามใช้ wc -c) ปัจจุบัน 158 ตัวอักษร
const pageDescription = "แนวทางหวย LOTTOPLUS แนวทางและสถิติเป็นข้อมูลอ้างอิงเท่านั้น รวมจุดที่ควรตรวจทั้งรอบหวย รูปแบบการแทง และอัตราจ่ายที่ระบบแสดง ก่อนยืนยันโพยหวยรัฐบาลไทย ลาวพัฒนา";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย LOTTOPLUS ดูสถิติเป็นข้อมูลอ้างอิงก่อนส่งโพย",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย LOTTOPLUS ดูสถิติและตรวจอัตราจ่ายก่อนยืนยันโพย" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title="แนวทางหวย LOTTOPLUS ดูสถิติเป็นข้อมูลอ้างอิงก่อนส่งโพย" as="h1">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        หน้านี้รวบรวมรูปแบบการดูสถิติและแนวทางเลือกเลขของ <strong class="text-[#fff4f4]">LOTTOPLUS</strong> ไว้ให้สมาชิกใช้วางแผนก่อนถึงเวลาปิดรับ โดยบัญชีเดียวรวมหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้นไว้ด้วยกัน
        จึงเลือกรายการที่ต้องการ ส่งโพย ตรวจสอบรายการ และตรวจผลหวยได้จากหน้าเว็บไซต์บนเบราว์เซอร์มือถือโดยไม่จำเป็นต้องติดตั้งแอป ส่วนรอบที่เปิดรับ เวลาปิดรับ และรายละเอียดของแต่ละรูปแบบจะแสดงอยู่ในหน้าส่งโพยของรอบนั้น
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        <strong class="text-[#fff4f4]">แนวทางและสถิติบนหน้านี้เป็นข้อมูลอ้างอิงเท่านั้น ไม่ใช่การทำนายผลและไม่ใช่การรับประกันเลขใด</strong> ผลของทุกรอบเป็นการสุ่มและไม่ขึ้นกับรอบก่อนหน้า LOTTOPLUS ไม่ได้เป็นผู้ประกาศผลรางวัลเอง
        และ <strong class="text-[#fff4f4]">อัตราจ่ายจริงอาจขึ้นอยู่กับประเภทหวย รูปแบบการแทง และรอบที่เปิดรับ</strong>
        จึงควรยึดตัวเลขที่ระบบแสดงก่อนยืนยันโพยเป็นหลักทุกครั้ง การเดิมพันมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมกับตัวเอง
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="จุดที่ควรตรวจให้ครบก่อนถึงเวลาปิดรับ" as="h2">
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <li class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#8a6a0a]/45 bg-[#120b0c]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#f3c623]/60 hover:shadow-[0_15px_30px_rgba(243,198,35,0.22)]">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a0d0f]/80 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#8a6a0a]/55 bg-[#1f0a0c] px-3 py-1 text-xs font-bold text-[#f3c623]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#f0e2e2]/70">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#fde79a] transition-colors group-hover:text-[#f3c623]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#f0e2e2]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#2a0d0f] pt-4 text-base font-bold text-[#f3c623]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยันโพย
            </div>
          </li>
        ))
      }
    </ul>
  </ContentBoxHuay>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ตรวจสอบได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#fff4f4]">รายการหวยและรอบที่เลือก รูปแบบการแทง อัตราจ่ายของรูปแบบนั้น และเวลาปิดรับ</strong>
        เพราะสี่อย่างนี้เป็นตัวกำหนดว่ารายการจะคำนวณผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขที่คิดไว้ล่วงหน้าหรือสถิติที่ไล่ดูย้อนหลังเป็นเพียงจุดตั้งต้นของการตัดสินใจ
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e2e2]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🎯</span>
          <span>
            <strong class="text-[#fff4f4]">คัดเลขก่อน แล้วค่อยเลือกรายการและรูปแบบ</strong> รวบรวมเลขที่มีในใจให้ครบก่อน จากนั้นเปิดดูว่ารอบนี้เปิดรับรายการใด และอัตราจ่ายของรูปแบบที่เลือกแสดงไว้เท่าไร
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🎱</span>
          <span>
            <strong class="text-[#fff4f4]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในระดับที่รับความผันผวนของรอบนั้นได้
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">⏱️</span>
          <span>
            <strong class="text-[#fff4f4]">เผื่อเวลาก่อนถึงเวลาปิดรับ</strong> แต่ละรายการปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#f3c623]">🧾</span>
          <span>
            <strong class="text-[#fff4f4]">กลับมาตรวจโพยทุกครั้งหลังส่ง</strong> ระบบบันทึกชื่อรายการ รอบ เลขที่เลือก ยอดเดิมพัน และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เปิดดูประวัติย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="LOTTOPLUS เปิดรับหวยรัฐบาลไทย ลาวพัฒนา ฮานอย และหวยหุ้น" as="h2">
    <div class="flex flex-col gap-6">
      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        สมาชิกที่มีเลขในใจแล้วส่งโพยกับ LOTTOPLUS ได้จากหน้าเว็บไซต์โดยตรง เริ่มจากหวยรัฐบาลไทยตามรอบออกรางวัล หวยลาวพัฒนาและหวยฮานอยตามรายการที่เปิดรับ และหวยหุ้นที่มีรอบเดิมพัน แตกต่างกันในแต่ละวัน
        เลือกรูปแบบเลขและตรวจสอบเวลาปิดรับก่อนส่งโพยได้จากหน้าเดียว หลังส่งรายการแล้วควรกลับมาตรวจสอบโพย เลขที่เลือก ยอดเดิมพัน และสถานะรายการให้เรียบร้อย
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ก่อนตัดสินใจทุกครั้ง ให้เปิดดู <strong class="text-[#fff4f4]">ตัวเลขที่ระบบแสดงจริงในหน้าส่งโพย</strong> ของรอบนั้นก่อน แล้วคำนวณยอดจากอัตราที่เห็นจริง ไม่ใช่จากอัตราที่จำมาจากรอบก่อน อัตราที่ประกาศไว้คือหวย
        2 ตัว 100 และหวย 3 ตัว 1,000 ส่วนเลข 3 ตัวตรงและรูปแบบการเดิมพันอื่นอาจมีวิธีคำนวณเงินรางวัลแตกต่างกัน อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกไว้ในโพย จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากอัตราเท่าไร
      </p>

      <p class="text-left text-base leading-relaxed text-[#f0e2e2]">
        ผู้ที่ยังไม่มีบัญชีสมัครเองได้ผ่านหน้าเว็บไซต์บนมือถือ กรอกข้อมูลตามที่ระบบกำหนด ยืนยันบัญชี แล้ว Login เพื่อเลือกประเภทหวยที่ต้องการ หลังเข้าสู่ระบบจะเห็นรอบหวย อัตราจ่าย โปรโมชั่น เครดิต
