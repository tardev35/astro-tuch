---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import Faq from "../components/FaqHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";
import { BRAND_NAME } from "../lib/brandProfile";

// หน้านี้คือ "แนวทางอ่านเลขเด็ด เลขดัง สถิติย้อนหลัง และตารางอัตราจ่าย"
// ⚠️⚠️ **หน้านี้ห้ามอ่านเป็นคำสัญญาว่าจะถูกรางวัล** บรีฟรอบนี้
// (src/assets/content.txt) อนุญาตให้พูดถึงเลขเด็ด เลขดัง และสถิติย้อนหลังได้จริง
// (บรรทัด 2, 4) แต่เขียนคำกำกับไว้เองในประโยคเดียวกันว่า **"เลขเด็ดหรือสถิติ
// ย้อนหลังไม่สามารถรับประกันผลรางวัลในงวดถัดไปได้"** (บรรทัด 4) และ **"ผลการ
// ออกรางวัลมีความไม่แน่นอนและไม่สามารถคาดการณ์ได้อย่างแม่นยำจากเลขย้อนหลัง"**
// (บรรทัด 10) → ประโยคกำกับทุกประโยค ship ครบ ห้ามตัดเพราะฟังดูลบ และ
// **ห้ามเขียนเลขจริงเป็นตัวเลข ห้ามตารางผลย้อนหลัง ห้ามสูตร ห้ามการทำนายผล**
// สิ่งที่หน้านี้ทำได้คือบอก "วิธีอ่าน" ข้อมูลเหล่านั้น ไม่ใช่บอกว่าจะออกเลขอะไร
//
// ข้อเท็จจริงทั้งหมดยึดตามบรีฟรอบนี้เท่านั้น (รวย168): ประเภทหวยมีสี่ชื่อ —
// **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน** (บรรทัด 4, 6) ·
// หวยรัฐบาลไทยอ้างอิงผลสลากกินแบ่งรัฐบาล และหวยออมสินเป็นรายการที่เกี่ยวข้องกับ
// ผลรางวัลออมสิน (บรรทัด 6) · แต่ละประเภทมีวันประกาศผลและรูปแบบการออกรางวัล
// แตกต่างกัน (บรรทัด 6) · ผู้ใช้งานสามารถศึกษารูปแบบการเลือกหมายเลข ตรวจสอบ
// เงื่อนไขการเดิมพัน และติดตามข้อมูลเลขดังจากแหล่งต่าง ๆ ได้ (บรรทัด 4) ·
// บาทละ 1,000 ต้องตรวจว่าใช้กับการเดิมพันประเภทใด รวมถึงฐานเงินเดิมพันและวงเงิน
// จ่ายสูงสุด เพราะไม่ใช่ทุกรายการที่ใช้อัตราเดียวกัน (บรรทัด 6) · 2 ตัว 100
// ต้องตรวจว่าเป็นสองตัวบนหรือสองตัวล่าง และคำนวณจากเงินเดิมพันเท่าใด พร้อม
// ข้อจำกัดการรับหมายเลข (บรรทัด 8) · 3 ตัว 1,000 ต้องตรวจว่าเป็นสามตัวตรงหรือ
// สามตัวโต๊ด (บรรทัด 10) · คืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% (บรรทัด 12-16) ·
// ฝากถอนผ่านธนาคารและทรูมันนี่ (บรรทัด 18) · แอดมิน 24ชม. · เก็บหมายเลขรายการ ·
// ไม่เปิดเผยรหัสผ่านหรือรหัส OTP · บัญชีแอบอ้าง (บรรทัด 20, 27)
//
// ⚠️⚠️ **"หวยลาวพัฒนา" และ "หวยหุ้นต่างประเทศ" ไม่มีในบรีฟรอบนี้** — เป็นคำของ
// แบรนด์ที่เคยเป็นเจ้าของไฟล์นี้ ถอดออกครบแล้ว บรีฟรอบนี้ระบุสี่ประเภทข้างบน
// เท่านั้น ห้ามเติมประเภทอื่น (ธ.ก.ส. · ยี่กี · หวยหุ้น) ห้ามเติมใบอนุญาต ·
// หน่วยงานกำกับ · ชื่อธนาคาร · ชื่อค่ายเกม · นิติบุคคล · ปีก่อตั้ง · จำนวนสมาชิก ·
// เวลาเป็นตัวเลข · ยอดขั้นต่ำเป็นตัวเลข — ตัวเลขที่ขึ้นหน้าได้มีแค่ บาทละ 1,000 ·
// 2 ตัว 100 · 3 ตัว 1,000 · 0.3% · 0.8% · 24ชม.
// ⚠️ ห้ามใช้คำของแบรนด์ขาออก มาดาม168 (มาดาม · เกมสล็อตเปย์แรง · เปย์แรง ·
// จ่ายไม่มีอั้น · ไม่อั้น · เว็บสล็อต · สล็อตออนไลน์ · เกมสล็อต) และของเก่ากว่า
// (นาซ่า · เซิร์ฟไทย · อวกาศ · ไม่ผ่านม้า · บัญชีม้า)
//
// CHROME: AnnouncementHuay · FaqHuay — รอบนี้แบรนด์เองเป็นเว็บหวย ชุด *Huay
// จึงเป็นธีมหลักของทั้งเว็บ ไม่ใช่ซับธีมของสองหน้านี้อีกต่อไป (เรียก
// <Announcement /> แบบ bare ให้ตกไปใช้ default message ของแบรนด์ปัจจุบัน
// ห้ามส่ง message prop · FaqHuay มี default faqs = [] จึงต้องส่ง prop faqs ทุกครั้ง)
//
// ธีม: ⚠️ ข้อยกเว้น Phase 4.5 คุ้มครอง **ชุดคอมโพเนนต์** เท่านั้น ไม่ได้คุ้มครอง
// พาเลตเก่าหรือชื่อแบรนด์เก่า — หน้านี้ใช้พาเลตของ brand-spec §2 เต็มรูปแบบ
// (ธีมมืด: พื้นเพจ #000000 จาก bg.json)
//   ผิวการ์ด #121110 (ตั้งโดย ContentBox) · ชั้นยก #1c1a16 · ชั้นจม #070707
//   เส้น hairline #3d3425 · เนื้อความ #f3ece0 (16.0:1 บนผิวการ์ด)
//   หัวข้อ/ไฮไลต์ <strong>/ป้าย ทอง #ffd94a (13.8:1) · หมึกรอง #bfb8aa ·
//   แพลทินัม #dde1e7 · โครเมียมเงิน #e8eaee
//   ปุ่มหลัก ไล่เฉด #ffd94a -> #e3a712 -> #b07d08 + **หมึกดำ #0a0a0a**
//   ปุ่ม outline ขอบ+ตัวอักษร #ffd94a บนผิว #070707
// ⚠️⚠️ **ขาวบนทองได้แค่ ~1.2–2.2:1 — พื้นทองต้องใช้หมึกดำเท่านั้น**
// ⚠️⚠️ **รอบนี้ไม่มีแดงเลยสักเฉด** ชุดแดง/ทองโบราณบนผิวขาวที่เคยอยู่ในไฟล์นี้
// (c30303 8f0505 e81313 4a0f0f fff1ef ffdbdb ffeee8 dcb95f b8862b 96681f)
// ถอดออกครบแล้ว รวมถึงเงา rgba ของแดงเก่า (195,3,3) และ (74,15,15) — แดงคือฮิวนำของ
// แบรนด์ขาออก (มาดาม168 คริมสัน) ปล่อยไว้ = ผิดพาเลตและหลงเหลือข้ามแบรนด์พร้อมกัน
// rgba() ที่อนุญาตรอบนี้: rgba(255,217,74,α) · rgba(227,167,18,α) ·
// rgba(176,125,8,α) · rgba(232,234,238,α) · rgba(0,0,0,α)
//
// ย่อหน้าในกล่องไม่ถือคลาสสีของตัวเอง — ContentBox / ContentBoxNeumorphism ตั้ง
// `text-left text-base leading-relaxed text-[#f3ece0]` ไว้บนการ์ดแล้ว สีที่เขียนเอง
// มีแค่ไฮไลต์บน <strong> (= #ffd94a)
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเป็น <span> ไม่ใช่แท็ก
// หัวข้อ และชื่อของชุดการ์ดไปอยู่บน aria-label ของ <ul> ป้ายสามคอลัมน์ของ
// ContentBox3ThreeNeumorphism เป็นคำบรรยายที่หน้านี้ตั้งเอง ไม่ใช่หัวข้อย่อยของบรีฟ
// จึงส่ง heading={false} ให้ render เป็น <p>
