---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// หน้านี้เป็น "แนวทางและวิธีจัดโพย" ไม่ใช่การทำนายผล — เว็บไม่ประกาศผลรางวัลเองและไม่รับประกัน
// เลขใด ทุกการ์ดจึงพูดถึงสิ่งที่ตรวจสอบได้จริงก่อนกดยืนยัน (อัตราจ่าย วงเงิน เวลาปิดรับ
// ประเภทและรอบที่เลือก) ไม่ใช่ "เลขเด่นงวดนี้"
//
// ข้อเท็จจริงทั้งหมดยึดตาม src/assets/content.txt เท่านั้น: MHEEPOOH168 รวมบาคาร่า สล็อต
// หวย และบอลไว้ในระบบเดียว · แยกเมนูตามหมวด สลับรูปแบบการเล่นได้จากบัญชีเดียว พร้อม
// ตัวเลือกจากหลายค่ายและหลายตลาด · โบนัสคืนยอดเสีย 0.3% และแนะนำเพื่อน 0.8% ตามเงื่อนไข
// ที่ระบบกำหนด · รองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ · ตรวจสอบสถานะ
// รายการและยอดผ่านบัญชีสมาชิกได้เอง · แอดมิน 24 ชั่วโมง
// ห้ามใส่ตัวเลขอัตราจ่าย ผลรางวัล วันที่ สถิติ เลขเด็ด ชื่อตลาดหวยรายตัว หรือเงื่อนไข
// ฝาก-ถอนที่บรีฟรอบนี้ไม่ได้ระบุ
//
// การ์ดเหล่านี้เป็น chrome ไม่ใช่หัวข้อบทความ ชื่อการ์ดจึงเรนเดอร์เป็น span ไม่ใช่แท็กหัวข้อ
// และ label ของ grid ย้ายไปอยู่บน aria-label ของ section แทน
//
// ตระกูล Huay (ธีมแดง) เป็นข้อยกเว้นที่ playbook อนุญาตไว้ใน Phase 4.5 สำหรับหน้าหวย
// จึงไม่ถูกบังคับให้ใช้พาเลตต์ทองของแบรนด์หลัก — ยกเว้นเฉพาะธีม ชื่อแบรนด์ไม่ยกเว้น
const tips = [
  {
    title: "เปิดดูรอบที่เปิดรับก่อนคัดเลข",
    desc: "เข้าหน้าส่งโพยดูก่อนว่ารอบไหนกำลังเปิดรับอยู่ แล้วตรวจว่าโพยถูกส่งเข้ารอบที่ตั้งใจจริง ไม่ใช่รอบถัดไปที่ระบบเปิดค้างไว้",
    type: "รอบที่เปิดรับ",
    note: "ยึดตามที่ระบบแสดง",
  },
  {
    title: "อ่านอัตราจ่ายของประเภทที่เลือก",
    desc: "แต่ละประเภทคิดผลคนละแบบและมีเรทของตัวเอง ให้เปิดดูอัตราจ่ายที่ระบบแสดงของรอบนั้นก่อน แทนการใช้ตัวเลขที่จำมาจากรอบก่อน",
    type: "อัตราจ่าย",
    note: "บันทึกไว้ในบิลทุกครั้ง",
  },
  {
    title: "แบ่งยอดไว้ล่วงหน้าก่อนลงเลข",
    desc: "แบ่งงบออกเป็นหน่วยย่อยไว้ก่อนแทนการเทไปที่เลขเดียว แล้วเทียบยอดรวมในโพยกับงบที่ตั้งไว้อีกครั้งก่อนส่งรายการ",
    type: "คุมงบ",
    note: "ตั้งงบก่อนทุกครั้ง",
  },
  {
    title: "เผื่อเวลาก่อนถึงเวลาปิดรับ",
    desc: "การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด ให้ดูเวลาปิดรับที่ระบบแสดงแล้วเผื่อเวลาไว้ตรวจทานอีกรอบ",
    type: "เวลาปิดรับ",
    note: "ต่างกันตามรอบ",
  },
  {
    title: "ตรวจยอดในโพยก่อนกดยืนยัน",
    desc: "ก่อนยืนยันให้ไล่ดูเลขที่เลือก ยอดแทงต่อรายการ และยอดรวมของโพยที่ระบบสรุปให้ เพื่อให้เห็นยอดที่จะถูกตัดจริงก่อนส่งรายการ",
    type: "ยอดรวมโพย",
    note: "ระบบสรุปก่อนยืนยัน",
  },
  {
    title: "ตรวจโพยย้อนหลังจากบัญชีสมาชิก",
    desc: "เปิดดูบิลย้อนหลังได้เองจากบัญชีสมาชิก ทั้งสถานะของรายการและยอดที่ปล่อยเข้าบัญชีหลังระบบตรวจสอบเสร็จ",
    type: "ตรวจโพย",
    note: "ทุกรอบ",
  },
];

// 150–160 CHARACTERS (not bytes — Thai is 3 bytes/char).
const pageDescription = "แนวทางหวย MHEEPOOH168 วิธีคัดเลข จัดโพย และคุมงบก่อนรอบปิดรับ พร้อมจุดที่ควรตรวจสอบให้ครบทั้งอัตราจ่าย วงเงิน และเวลาปิดรับที่ระบบแสดงจริงก่อนกดยืนยันโพย";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย MHEEPOOH168 วิธีคัดเลขและจัดโพยก่อนรอบปิดรับ",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="แนวทางหวย MHEEPOOH168 วิธีจัดโพยและตรวจข้อมูลก่อนรอบปิดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4">
    <div class="mb-10 flex flex-col items-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(226,53,58,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#ffe9ea] via-[#ff8a8d] to-[#c21e22] bg-clip-text text-center text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย MHEEPOOH168</h1>
      <p class="mt-3 w-full text-left text-base leading-relaxed text-[#ded9da]">
        หน้านี้รวบรวมแนวทางการคัดเลขและจัดโพยของ <strong class="text-[#ff9a9d]">MHEEPOOH168</strong> ให้สมาชิกวางแผนได้ก่อนรอบปิดรับ โดยหมวดหวยถูกแยกเป็นเมนูของตัวเองในระบบเดียวกับบาคาร่า สล็อต และบอล
        จึงเลือกประเภทที่ต้องการและสลับรูปแบบการเล่นได้จากบัญชีเดียว ส่วนรอบที่เปิดรับ เวลาปิดรับ อัตราจ่าย และวงเงินของแต่ละประเภทจะแสดงอยู่บนหน้าส่งโพยของรอบนั้น จึงให้ยึดตัวเลขที่ระบบแสดงจริงเป็นหลักก่อนกดยืนยันทุกครั้ง
        เว็บไซต์ไม่ประกาศผลรางวัลเองและไม่ทำนายเลขใด ๆ
      </p>
    </div>

    <h2 class="mb-6 text-center text-2xl leading-normal font-black tracking-widest text-[#ff8a8d] uppercase">จุดที่ควรตรวจให้ครบก่อนถึงรอบปิดรับ</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="แนวทางจัดโพยแยกตามจุดที่ต้องตรวจ">
      {
        tips.map((tip) => (
          <div class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-[#c21e22]/40 bg-[#3a0709]/90 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#e2353a]/60 hover:shadow-[0_15px_30px_rgba(226,53,58,0.25)]">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#7d1114]/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="rounded-full border border-[#c21e22]/55 bg-[#140a0c] px-3 py-1 text-xs font-bold text-[#ff8a8d]">{tip.type}</span>
              <span class="text-right text-xs font-medium text-[#bdb4b6]">{tip.note}</span>
            </div>

            <span class="mb-2 block text-xl font-bold text-[#ded9da] transition-colors group-hover:text-[#ff9a9d]">{tip.title}</span>

            <p class="mb-6 text-left text-base leading-relaxed text-[#bdb4b6]">{tip.desc}</p>

            <div class="mt-auto flex items-center gap-2 border-t border-[#c21e22]/30 pt-4 text-sm font-bold text-[#ff8a8d]">
              <span aria-hidden="true">💰</span>
              ตรวจอัตราจ่ายที่ระบบแสดงก่อนยืนยัน
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <ContentBoxHuay title="คัดเลขและคุมยอดให้ใช้งานได้จริงก่อนส่งโพย" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        แนวทางที่ใช้ได้จริงคือแนวทางที่ตรวจสอบได้ก่อนกดยืนยัน ไม่ใช่การเดาผลล่วงหน้า สิ่งที่ควรเปิดดูให้ครบทุกครั้งคือ
        <strong class="text-[#ff9a9d]">ประเภทและรอบที่เลือก อัตราจ่ายของประเภทนั้น วงเงินที่ระบบแสดง และเวลาปิดรับ</strong>
        เพราะสี่อย่างนี้เป็นตัวกำหนดว่ารายการจะคิดผลอย่างไรและยอดรวมในโพยจะออกมาเท่าไร ส่วนเลขที่คิดไว้ล่วงหน้าเป็นเพียงจุดตั้งต้น
        <strong class="text-[#ff9a9d]">ไม่มีเลขหรือสูตรใดรับประกันผลได้เสียล่วงหน้า</strong> การเดิมพันจึงมีความเสี่ยง ควรกำหนดงบประมาณให้เหมาะสมทุกครั้ง
      </p>

      <ul class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ded9da]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🎯</span>
          <span><strong class="text-[#ff9a9d]">คัดเลขก่อน แล้วค่อยเลือกประเภท</strong> เลือกเลขที่มีในใจให้ครบก่อน จากนั้นเปิดหน้าส่งโพยดูว่ารอบนี้เปิดรับประเภทใด และเรทของประเภทที่เลือกแสดงไว้เท่าไร</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🎱</span>
          <span><strong class="text-[#ff9a9d]">กระจายยอด อย่ากระจุกตัวเดียว</strong> แบ่งยอดออกเป็นหน่วยย่อยไว้ล่วงหน้า แล้ววางต่อเลขให้อยู่ในระดับที่รับความผันผวนของรอบนั้นได้</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">⏱️</span>
          <span><strong class="text-[#ff9a9d]">เผื่อเวลาก่อนรอบปิดรับ</strong> แต่ละรอบปิดรับคนละเวลา การส่งโพยชิดเวลาปิดทำให้ไม่เหลือจังหวะแก้ไขเมื่อกรอกผิด</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-[#ff8a8d]">🧾</span>
          <span>
            <strong class="text-[#ff9a9d]">เก็บบิลไว้ทุกครั้ง</strong> เมื่อส่งโพยสำเร็จ ระบบบันทึกรอบ เลข ยอดแทง และอัตราจ่ายที่แสดงตอนยืนยันไว้ให้ เช็กประวัติรายการย้อนหลังได้เองจากบัญชีสมาชิก
          </span>
        </li>
      </ul>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="MHEEPOOH168 รวมหวยไว้กับบาคาร่า สล็อต และบอลในระบบเดียว" as="h2">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        สายหวยที่มีเลขในใจเข้ามาส่งโพยกับ MHEEPOOH168 ได้จากเมนูหวยของเว็บไซต์โดยตรง โดยแต่ละประเภทถูกแยกหมวดไว้อย่างชัดเจน พร้อมตัวเลือกจากหลายค่ายและหลายตลาดตามรอบที่เปิดให้บริการ
        สมาชิกเลือกประเภท เลือกเลข ส่งโพย และเช็กประวัติรายการได้ด้วยตัวเอง ระบบจะแสดงวงเงินและรายละเอียดของรายการก่อนยืนยัน ทำให้เห็นเลขและยอดเดิมพันอย่างชัดเจนก่อนกดส่ง
        และบิลจะถูกเก็บไว้ในประวัติให้เทียบย้อนหลังได้เสมอ
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        ก่อนตัดสินใจทุกครั้ง ให้เปิดดู <strong class="text-[#ff9a9d]">ตัวเลขที่ระบบแสดงจริงบนหน้าส่งโพย</strong> ของรอบนั้นก่อน แล้วคำนวณยอดตามเรทจากตัวเลขที่เห็นจริง ไม่ใช่จากเรทที่จำมาจากรอบก่อน
        เพราะเวลาเปิด-ปิดรับ วงเงินที่รับได้ และรายละเอียดของแต่ละประเภทต่างกันไปตามรอบ อัตราที่ใช้ตอนกดยืนยันจะถูกบันทึกไว้ในบิล จึงเปิดดูย้อนหลังได้เสมอว่ารายการนั้นคิดจากเรทเท่าไร
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        เครดิตที่ใช้ส่งโพยอยู่ในบัญชีเดียวกับหมวดเกมอื่น <strong class="text-[#ff9a9d]">สลับไปเล่นบาคาร่า สล็อต หรือบอลได้จากบัญชีเดียว</strong> ไม่ต้องเปลี่ยนไปใช้หลายเว็บไซต์
        ระบบรองรับช่องทางธนาคารและวอลเลทที่กำหนดไว้ภายในเว็บไซต์ สมาชิกจึงเลือกวิธีจัดการเครดิตได้ตามความสะดวก และตรวจสอบสถานะรายการกับยอดคงเหลือได้เองจากบัญชีสมาชิก
        ส่วนสิทธิ์โปรโมชั่นอย่างโบนัสคืนยอดเสีย 0.3% และโบนัสแนะนำเพื่อน 0.8% มีเงื่อนไขแยกไว้ชัดเจน ควรตรวจสอบรายละเอียดจากหน้าโปรโมชั่นก่อนกดรับสิทธิ์ทุกครั้ง
      </p>

      <p class="text-left text-base leading-relaxed text-[#ded9da]">
        หากส่งโพยไม่สำเร็จ เลขที่ต้องการแทงไม่แสดง เครดิตไม่เข้า รายการถอนค้าง หรือพบยอดในบิลไม่ตรงกับรายการ ให้ตรวจสอบประวัติโพยและประวัติรายการเครดิตในบัญชีก่อน หากยังพบความผิดปกติ
        ติดต่อแอดมิน MHEEPOOH168 ผ่าน Line Official ได้ตลอด 24 ชั่วโมง พร้อมแจ้งประเภทที่แทง รอบเดิมพัน เวลา และจำนวนเงิน เพื่อให้ตรวจสอบได้ตรงจุด และไม่ควรเปิดเผยรหัสผ่านหรือ OTP แก่บุคคลอื่นไม่ว่ากรณีใด
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MHEEPOOH168"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7d1114] via-[#c21e22] to-[#7d1114] px-8 py-4 font-black text-[#ffe9ea] shadow-[0_5px_15px_rgba(194,30,34,0.45)] transition-transform hover:scale-105">
          <span aria-hidden="true">⚡</span> สมัครสมาชิก MHEEPOOH168
        </a>
        <a
          href="/ตรวจหวย"
          aria-label="ตรวจหวยและเช็กสถานะโพย MHEEPOOH168"
          class="flex items-center justify-center gap-2 rounded-xl border border-[#c21e22]/60 bg-[#1c0d0f] px-8 py-4 font-bold text-[#ff8a8d] shadow-[0_5px_15px_rgba(226,53,58,0.22)] transition-colors hover:bg-[#3a0709]">
          <span aria-hidden="true">🧾</span> ตรวจโพยของคุณ
        </a>
      </div>
    </div>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>
