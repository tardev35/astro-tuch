---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (MEXICANOSLOT -> ZANE96): NavbarStyle2 -> NavbarStyle6
// และ FooterPremiumSumo -> FooterCyber มีได้ทีละตัวเท่านั้น การ "หมุน" ของสอง
// ตระกูลนี้จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ
// inventory ของแบรนด์ถัดไป
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ทรงของสองไฟล์นี้ต่างจากของรอบก่อนจริง ไม่ใช่แค่เปลี่ยนสี: NavbarStyle2 เป็นแถบ
// info คาดบนสุดคู่กับการ์ดพิลล์ลอยแนวนอน และเมนูมือถือเป็น overlay เต็มจอ —
// **NavbarStyle6 เป็น "รางแนวตั้งลอยริมซ้าย" บนเดสก์ท็อป (fixed left-3 สูง 640px)
// คู่กับแท็บโลโก้ห้อยกลางขอบบน ปุ่ม CTA ลอยมุมขวาบน และเมนูมือถือเป็น drawer
// กว้าง 260px ที่เลื่อนเข้าจาก "ซ้าย" พร้อมไล่รายการทีละตัว** · FooterPremiumSumo
// เป็นแผ่น rounded-t-[3rem] ที่มีออราเบลอคร่อมสองขอบ กริด 5/3/4 — **FooterCyber
// เป็นแผ่นที่ clip-path ตัดขอบบนเป็น "หลังคาแหลมกลางจอ" มีตารางเส้นพื้นหลัง
// และปุ่มทุกตัวตัดมุมทแยงด้วย clip-path เหมือนกัน** ทั้งคู่ไม่ render BankStrip
//
// ⚠️⚠️ **รอบนี้ยังเป็นเว็บสล็อต เนื้อหายังสว่าง และโครมยังเข้มเหมือนรอบก่อน
// แต่เปลี่ยนฮิวทั้งตระกูล**
// บรีฟเรียกตัวเองว่า "สล็อตลิขสิทธิ์แท้ในไทย เว็บตรงไม่ผ่านเอเย่นต์" และพูดถึง
