---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (รวย168 -> สล็อต168): NavbarHuay -> NavbarStyle11
// และ FooterHuay -> Footer (ตัวฐาน) มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ✅ NavbarStyle11 + Footer.astro **ไม่ปรากฏในสิบสี่คอมมิตล่าสุดเลย** — ไกลที่สุด
// จากของที่เพิ่งใช้ (ตรวจทีละคอมมิตแล้วใน brand-spec §3)
//
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน: สล็อต168 เป็น "เว็บสล็อตออนไลน์" ไม่ใช่เว็บหวย**
// บรีฟเรียกตัวเองว่า "ระบบสล็อตเว็บนอก ทางเข้าเล่นฐานเกมหลัก ไม่ผ่านเอเย่นต์100%"
// และพูดถึง **ค่ายแท้ถูกลิขสิทธิ์ · ฝากถอนยอดเข้าบริษัทแม่โดยตรง · สล็อตคลาสสิก ·
// เกมที่มีรอบโบนัส · เกมที่ใช้สัญลักษณ์พิเศษ · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ฝากถอนทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม.**
// → **/ตรวจหวย กับ /แนวทาง ถูกย้ายกลับไป src/pages-disabled/ แล้วรอบนี้** และลิงก์
// ของทั้งสองหน้า **ถูกถอดออก** จากเมนู navbar และจาก footer (route ไม่มีอยู่จริง
// แล้วทั้งคู่ — ลิงก์ค้างไว้จะทำให้ verify-build แดง)
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarStyle11 ประกาศเมนูเป็น `links` ชุดเดียวและ map ทั้งแถบเดสก์ท็อป+
// แผงดรอปดาวน์มือถือจากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น
// **พี่น้อง** ของ label — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
// (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login (หน้าปุ่มจริงของรอบนี้)
// ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน login/register/Navfoot เท่านั้น
//
// ภาษาภาพของรอบนี้อ่านจากอาร์ตเวิร์กจริง — **เวิร์ดมาร์ก "สล็อต168" ตัวอักษรเจล
// สามมิติแดงสดมันวาว ไฮไลต์ขาวสเปกคูลาร์ มีมงกุฎทองเล็กประดับหัวใจแดงบนตัวอักษร
// ตัวแรก · แบนเนอร์เป็นสตูดิโอพื้นขาวสะอาด ผู้หญิงใส่คาร์ดิแกนแดงถือโทรศัพท์ที่จอ
