---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (ufalion168 -> ดวงเศรษฐี168): NavbarStyle6 -> NavbarStyle11
// และ FooterStyle2 -> FooterPremiumSumo มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
//
// ⚠️ **NavbarStyle11 กับ FooterPremiumSumo ไม่เคยถูกใช้ในรอบ 14 commit ที่ผ่านมา**
// (ตรวจด้วย `git show <sha>:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`
// ย้อนหลัง 14 รอบ) — NavbarStyle6 เพิ่งออกรอบที่แล้ว ส่วน NavbarStyle9/NavbarPremium/
// NavbarCyber/NavbarStyle5/8/10/7/4Black ถูกใช้ไปในรอบใกล้ๆ นี้ทั้งหมด
// FooterStyle2/Footer/FooterStyle3/FooterPremium/FooterCyber ก็เช่นกัน
// FooterPremiumSumo ห่างที่สุดในกลุ่มที่เหลือ (และ FooterHuay เป็นของเว็บหวย ตัดทิ้ง)
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (subagent รอบ P1 ทำให้แล้ว):
// (ก) ไอคอนเมนูเดิมเป็นชุด **ฟุตบอล/กีฬา** ของ ufalion168 (🏟️ 🎽 ⚽) ต้องเปลี่ยนเป็นชุด
// **เกมเดิมพันหลายประเภท + โชคลาภจีน** ของรอบนี้ (ข) ทั้งสองไฟล์ใช้ isActivePath จาก
// ../lib/nav **ห้ามเขียน isActive เอง** เพราะ Astro.url.pathname เป็น percent-encoded
// บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น หน้าแรก · โปรโมชั่น · สมัครสมาชิก ·
// เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง render บล็อก `<address>` จาก BRAND_ADDRESS
//
// ⚠️ **BankStrip.astro ยังเป็นไฟล์ที่ render อยู่รอบนี้** (FooterPremiumSumo import มัน)
// จึงต้อง retheme เหมือนไฟล์โครมตัวอื่น — แต่ **โลโก้ธนาคารจริงข้างในห้ามแตะสี**
// เป็นสีซีแมนติกของแบรนด์ธนาคาร ไม่ใช่สีของเว็บ
//
// ทรง "หรูแบบคฤหาสน์เศรษฐี + มงคลจีน" ของสองไฟล์นี้เลือกให้เข้ากับอาร์ตเวิร์ก
// รอบนี้โดยตรง — ไฉ่ซิงเอี๊ยหมวกแดงขลิบทอง มงกุฎทอง กองเหรียญทอง และชิป/ไพ่ดำ-ทอง
// จึง **ห้ามใส่ภาษาสนามบอล (ลูกฟุตบอล ถ้วยรางวัล ธงดาวฟุตบอล เสื้อแข่ง) แบบรอบก่อน
// หรือภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนไซเบอร์ กลับเข้าไปในสองไฟล์นี้**
//
// ⚠️ **ทั้งสองไฟล์ค้างสีของแบรนด์อื่นอยู่ และรอบนี้มีกับดักสองชั้นพร้อมกัน: ทองกับแดง**
// ห้ามเทียบด้วยตาเด็ดขาด ต้องเทียบเป็นค่า:
//   ทอง/เหลือง — **เคยถูกใช้มาเกือบทุกแบรนด์** ufalion168 (รอบที่แล้ว) คือ d4922c
//         (+fdfc71 f6e3b4) · รับตัง168 ffdc8c ซึ่ง **ใกล้ทองของรอบนี้ที่สุด**
//         ต่างที่ R255 vs R240 และ B140 vs B120 · รวยเทพ168 f0bb4e · TND168 dfa310 ·
//         มีเฮ168 fcd45c · รวยแทร่168 f9a826 · นินจา168 fef54b · สบายเบท168 ffc82e ·
//         มีโชค168 fcd434 · ขวัญใจ168 f7c92b · สมหวัง168 e3b23c · UFA324 e5a81b
//   แดง — **รอบนี้มีแดง แต่เป็นคนละค่ากับทุกแบรนด์** fb1b32 ของมีเฮ168 ใกล้ที่สุด
//         (ต่างที่ R251 vs R217) · e4021b ของรวยเทพ168 (ต่างที่ G2 vs G33, B27 vs B42) ·
//         fa0513 ของสมหวัง168 · d30304 ของรับตัง168 · b3121b ของขวัญใจ168
//         — ทั้งหมดต้องถูกกวาดออก
//   บรอนซ์ — **ไม่มีอยู่ในรอบนี้เลย** a25b24 8c4312 d39c45 ของ ufalion168 (รอบที่แล้ว)
//         และ d9701a ของรวยเทพ168
//   ฟ้า/น้ำเงิน — **ไม่มีอยู่ในรอบนี้เลย** 039cfa c3ebfc 04366b ของรวยแทร่168 ·
//         32bcfb a9e9ff 07335f ของนินจา168 · 2f9ff5 a8dcff 0b3f78 ของสบายเบท168
//   เงิน/โครเมียม — **ไม่มีอยู่ในรอบนี้เลย** 8792a0 b9c2cc f0e8d4 464f5a ของ UFA324 ·
//         cfd9e6 ของรับตัง168 — ⚠️ ผมของนายแบบ/นางแบบในแบนเนอร์เป็นสีเงินจริง
//         **แต่นั่นเป็นวัตถุในภาพ ไม่ใช่สีแบรนด์** ห้ามดึงเข้ามาเป็นสีของ UI
// ส่วน **ทองน้ำผึ้งรอบนี้คือ #f0c878** และ **แดงชาดจีนรอบนี้คือ #d9212a**
// (+#8e1a16 แดงเลือดหมู) หมึกบนพื้นถมทองคือ **#2a0608**
// ⚠️ **#d9212a ได้คอนทราสต์แค่ 2.7:1 บนผิวการ์ด (4.2:1 บนพื้นดำ) = ตกเกณฑ์ AA**
// จึงเป็นสีพื้นถม/ขอบ/ออรา/ไอคอนเท่านั้น ห้ามถือตัวอักษรบนพื้นเข้ม ถ้าจะมีตัวอักษร
// ที่อ่านว่าแดง ให้ถมแดงเป็นพื้นแล้ววาง #fff8d8 ทับ (4.7:1) และ #8e1a16 ห้ามถือ
// ตัวอักษรทุกขนาด
// รายการค่าของแบรนด์อื่นทั้งหมดอยู่ใน .claude/brand-spec-duangsetthi168.md §2
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// ⚠️ รอบนี้ **ทองน้ำผึ้งนำ แดงชาดจีนเป็นสีอัตลักษณ์คู่กัน และแดงเลือดหมูเป็นเงาที่
// ไม่เคยถือตัวอักษร** — ต่างจากรอบก่อน (ufalion168 ทองสองเฉดล้วน ไม่มีสีที่สองเลย)
// สิ่งที่แยกรอบนี้ออกจากแบรนด์ทอง/แดงก่อนหน้าจึงเป็น (ก) ค่าสีคนละชุดทุกตัว
// (ข) การมีแดงกลับมาเป็นฮิวคู่ (ค) การหมุน variant ไป navbar/footer ที่ไม่ถูกใช้มา
// 14 รอบ + การ์ดชุด FloatingBadge/Neumorphism/TwoPremium/SevenThree/SevenThreePremium/
// TwoCyberCut/3ThreePremium ซึ่งไม่ทับกับรอบก่อนเลยสักตัว
// อ่านมาจากอาร์ตเวิร์กตรงๆ: ทองคือตัวอักษร "ดวงเศรษฐี" ขลิบหมวก มงกุฎ กองเหรียญ
// และขอบไพ่/ชิป ส่วนแดงคือหมวกไฉ่ซิงเอี๊ย เลข "168" และแถบ "จากเศรษฐีพนันมือ1"
// (palette.json วัด vivid ของ logo.webp ได้ #fce443 #fcc31d #fce23d #f1ab13 #e40301
// = **ทองสี่เฉด + แดงหนึ่ง** ซึ่งตรงกับที่ตาเห็น แต่ค่าดิบใช้ตรงๆ ไม่ได้เพราะ
// e40301 ห่างจาก e4021b ของรวยเทพ168 แค่ 24 หน่วย และ fce443 ห่างจาก fce343 ของ
// PUNPRO168 แค่ 1 หน่วย จึงเลื่อนเป็น #d9212a กับ #f0c878)
// ⚠️ **พื้นเพจเป็นดำสนิท #000000 ตาม bg.json** — bg.json คือแหล่งเดียวของพื้นเพจ
// ⚠️ **รอบนี้อาร์ตเวิร์กพื้นขาว-งาช้าง แต่พื้นเว็บเป็นดำสนิท** — ไม่ตรงกันโดยตั้งใจ
// ห้าม "แก้" ให้พื้นเว็บเป็นขาวตามรูป พื้นเพจมาจาก bg.json เท่านั้น
// **รอบนี้ไม่มีบรอนซ์ ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง ไม่มีเขียว ไม่มีเงิน/โครเมียม
// ไม่มีโรสโกลด์ ไม่มีส้มสด และไม่มีชมพูฟูเชีย ในทั้งสามไฟล์**
// และ **ไม่มีลิงก์ /ตรวจหวย กับ /แนวทาง ในทั้งสามไฟล์** เพราะถึงบรีฟรอบนี้จะเอ่ยถึง
// หวย แต่เป็น 1 ใน 6 ประเภทเกมที่ "สอน" เท่านั้น ไม่ใช่แกนของเว็บ และคำสั่งของ
// operator ไม่มีคำว่า เว็บหวย — สองหน้านั้นอยู่ใน src/pages-disabled/ จึงไม่มี
// route ให้ลิงก์ และ verify-build จะแดงถ้าเหลือไว้ (โครมขึ้นทุกหน้า)
//
// รอบนี้ toggle cta ของ uploader ยังเปิดอยู่: /login กับ /register เป็นหน้าปุ่มที่
// index ได้จริง จึงมีสองรายการนั้นอยู่ในเมนู navbar ถัดจาก โปรโมชั่น ทันที และ
// /ทางเข้า ถูกถอดออกจากเมนูแทน (footer ยังลิงก์ทั้งสามหน้าได้ตามปกติ — route มีจริง)
import Navbar from "../components/NavbarStyle11.astro";
import Footer from "../components/FooterPremiumSumo.astro";

// Only banner1 is ever rendered, so only banner1 is imported.
//
// This used to glob `banner*.{png,webp,jpg,jpeg}` eagerly, and an imported
// image is an EMITTED image whether or not anything renders it. Every stale
// banner in src/assets was therefore copied into dist/_astro on every build and
// uploaded on every deploy — banner.png (2.2 MB), banner2.png and banner3.png,
// 3.1 MB of previous brands' artwork that no page has ever linked. It cost a
// visitor nothing, which is exactly why it survived so long.
//
// The wide glob carried a fallback chain (banner1 → first .webp → first of
// anything) whose entire purpose was to avoid silently picking a stale file.
// Naming one file removes that failure mode instead of mitigating it: there is
// nothing else in scope to pick. A missing banner1 now stops the build with a
// message rather than rendering the previous brand's hero.
//
// Keep the extension list. The uploader writes banner1.png today, but brands
// launched before that have banner1.webp and must keep building.
const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner1.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
if (bannerPaths.length === 0) {
  throw new Error("MainLayout: no src/assets/banner1.{png,webp,jpg,jpeg} — the hero image is missing. The uploader writes banner1.png; upload it before building.");
}
const mainBannerPath = bannerPaths.find((path) => path.endsWith(".webp")) ?? bannerPaths[0];
const mainBanner = bannerImages[mainBannerPath].default;

// Optional portrait/square art for phones, written by the uploader as
// banner1-mobile.*. Pinned by name for the same reason banner1 is.
//
// OPTIONAL, and that is the whole difficulty: banner1 is overwritten on every
// rebrand because the uploader requires it, but a brand that ships no mobile
// art would inherit the previous brand's if the file simply stayed on disk.
// So the uploader DELETES banner1-mobile.* whenever banner1 is uploaded
// without one — the mobile file's lifetime is tied to the desktop file's, and
// there is no state here that can outlive the brand it belongs to.
//
// A <source> rather than CSS: only the matching candidate is ever fetched, so
// a phone downloads the phone art and nothing else. Two <img> toggled by
// `hidden` would download both, on the element that decides LCP.
const mobileBannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner1-mobile.{png,webp,jpg,jpeg}", { eager: true });
const mobileBannerPaths = Object.keys(mobileBannerImages);
const mobileBannerPath = mobileBannerPaths.find((path) => path.endsWith(".webp")) ?? mobileBannerPaths[0];
const mobileBanner = mobileBannerPath ? mobileBannerImages[mobileBannerPath].default : null;
const mobileBannerImg = mobileBanner ? await getImage({ src: mobileBanner, widths: [360, 480, 640, 828, 1080], format: "avif", quality: 60 }) : null;

// ค่า default มาจากบรรทัด Title / Description ของบรีฟรอบนี้ตรงตัว
// (src/assets/content.txt บรรทัด 1-2) ห้ามเติมให้ครบ 150 ตัวอักษร —
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้แล้วเพราะเหตุผลนี้โดยเฉพาะ
const {
  title = `${BRAND_NAME} เว็บสอนเล่นเกมออนไลน์ จากเศรษฐีพนันมือ1`,
  description = `${BRAND_NAME} เว็บสอนเล่นเกมเดิมพันออนไลน์ สล็อต บาคาร่า ยิงปลา ไฮโล บอล หวย รวมสูตรการเล่น และเทคนิคการสอนเดิมพัน จากเศรษฐีพนันมือ1`,
  robots = "index, follow",
} = Astro.props;

// og:image. Two problems with what used to be here (`ImageOg = ogImage.src`):
//
//   * `.src` on an imported asset is the ORIGINAL file. Astro copied slide1.png
//     into the build untouched — 190 KB of PNG — purely to be linked from a
//     meta tag. getImage() below runs it through the same pipeline every other
//     image uses.
//   * every page declares twitter:card = summary_large_image, which wants a
//     1.91:1 image around 1200x630. slide1 is a 600x600 square, so the card was
//     rendering a small square crop of a promo banner.
//
// The uploader now writes src/assets/og.png at 1200x630 when slide1 is
// uploaded. Prefer it when it exists; fall back to slide1 for a brand launched
// before that, so this never breaks a build.
const ogCandidates = import.meta.glob<{ default: ImageMetadata }>("../assets/og.{png,webp,jpg,jpeg}", { eager: true });
const ogCandidatePaths = Object.keys(ogCandidates);
const ogSource = ogCandidatePaths.length > 0 ? ogCandidates[ogCandidatePaths[0]].default : ogImage;

// Width only — passing height as well would make the image service crop to that
// exact box, which turns the square fallback into a slice of itself.
const ogRendered = await getImage({ src: ogSource, format: "jpeg", quality: 80, width: Math.min(1200, ogSource.width) });
const ImageOg = ogRendered.src;

// The wallpaper <Image> below is decorative and deliberately lazy/async. It used
// to be loading="eager" decoding="sync", which had the browser fetch and decode
// a full-viewport image at the same priority as the hero banner — the actual LCP
// element — on the one request where that competition costs most. A background
// arriving a beat later is not something a visitor notices; a slow hero is.
//
// (The note lives here rather than above the tag: that tag is one branch of a
// ternary, and a {/* comment */} beside it makes the branch two expressions,
// which fails the build with "Expected ) but found $$render".)
const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

// Glob'd, not a static `import Bg from "../assets/bg.png"`, for the same reason
// banner1 is glob'd (see the comment above bannerImages): a static import is an
// EMITTED file whether or not anything renders it. When bgMode is "color" or
// "gradient" the <Image> branch below never runs, so a leftover bg.png from a
// previous brand's asset drop must not be forced into the bundle just because
// this file's name is referenced somewhere. Glob only matches files that exist
// on disk, so once a stale bg.png is deleted there is nothing left to emit.
const bgImages = import.meta.glob<{ default: ImageMetadata }>("../assets/bg.{png,webp,jpg,jpeg}", { eager: true });
const bgPaths = Object.keys(bgImages);
const Bg = bgPaths.length > 0 ? bgImages[bgPaths[0]].default : null;

// canonicalFor() is the same function every JSON-LD URL goes through, so the
// canonical and the structured data cannot drift apart (see src/lib/schema.ts).
// Do not replace it with new URL(Astro.url.pathname, Astro.site) — that is what
// used to be here, and it disagreed with the JSON-LD about the trailing slash
// on every page.
const canonicalURL = canonicalFor(Astro);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = BRAND_NAME;

const profile = brandProfile(Astro.site);

// คำบรรยาย alt ของ hero เขียนจากไฟล์ banner1.png ของดรอป 2026-10-20 จริง
// (อ่านด้วย Read ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — **สิงโตทองสวมมงกุฎ สนามฟุตบอล
// อัฒจันทร์กลางคืน เสื้อแข่งดำ-ทอง ถ้วยแชมเปี้ยนส์ลีกสีเงิน ลูกฟุตบอลดำ-ทอง
// ธงดาวฟุตบอลทอง และไอคอนกราฟแท่งของ ufalion168 ไม่มีอยู่ในรูปรอบนี้เลย**
// หญิงสาวชุดขาว-แดง ตู้สล็อต 777 ไพ่เอซโพแดง ชิปคาสิโนแดง-ขาว และกล่องของขวัญแดง
// ของ รวยเทพ168 ก็ไม่มี หน้ายิ้มหัวเราะสีเหลืองทองและชุดลูกไม้ขาวผูกโบว์แดงของ
// มีเฮ168 ก็ไม่มี ถุงเงินสีฟ้าและโบว์ซาตินฟ้าของ รวยแทร่168 ก็ไม่มี นินจาการ์ตูน
// และชูริเคนฟ้าของ นินจา168 ก็ไม่มี แมวการ์ตูนขนขาวลายส้มของ สบายเบท168 ก็ไม่มี
// ดอกซากุระชมพูและริบบิ้นซาตินชมพูของ ถอนชัวร์168 ก็ไม่มี แมวกวักนำโชค เหรียญจีน
// รูสี่เหลี่ยม และธงชาติสิงคโปร์ของ มีโชค168 ก็ไม่มี หญิงสาวผมดำชุดไทยแดง-ครีมของ
// ขวัญใจ168 ก็ไม่มี ลายกนก/เจดีย์ทองของสมหวัง168 ก็ไม่มี อักขระมังกรจีน 龍 ของ
// GT66B ก็ไม่มี
// ⚠️ รอบนี้ฉากหลังของแบนเนอร์เป็น **ห้องโถงคฤหาสน์หรูโทนขาว-งาช้าง** — **สว่าง
// ตรงข้ามกับพื้นเพจซึ่งเป็นดำสนิท** และนั่นถูกต้องแล้ว เพราะพื้นเพจมาจาก bg.json
// คนละเรื่องกับรูป **ฝั่งซ้าย** เป็น **ชายหนุ่มผมสั้นสีเงิน สวมสูทขาว นั่งพิงพนัก
// บัลลังก์ทอง สวมนาฬิกาทองและแหวนทอง** **ฝั่งขวา** เป็น **หญิงสาวผมยาวสีเงิน
// สวมชุดรัดรูปสีขาว-ทอง พร้อมสร้อยคอ ต่างหู และกำไลทอง เท้าคางอยู่** รอบตัวทั้งสอง
// มี **มงกุฎทองหลายใบ กองเหรียญทอง ชิปคาสิโนสีดำ-ทอง และไพ่เอซโพดำพื้นดำขลิบทอง**
// **กลางภาพด้านบน** เป็น **โลโก้ขนาดย่อ: หัวไฉ่ซิงเอี๊ยหมวกแดงขลิบทอง + ชื่อแบรนด์**
// ใต้ลงมาเป็น **ชื่อแบรนด์ตัวโต "ดวงเศรษฐี" สีทองไล่เฉดสามมิติ ต่อด้วยเลข "168"
// สีแดงสดสามมิติ** ต่อด้วย **คำว่า เว็บสอนเล่นเกมออนไลน์ ตัวหนาสีขาวขลิบทอง** และ
// **แถบโค้งพื้นแดงขอบทองเขียนว่า จากเศรษฐีพนันมือ1 พร้อมมงกุฎทองเล็กต่อท้าย**
// — **ไม่มีสีฟ้า ไม่มีสีเขียว ไม่มีสีม่วง และไม่มีบรอนซ์ในภาพนี้เลย**
//
// <html> มี id="top" เป็นเป้าของปุ่ม "กลับขึ้นบน" ใน footer แทน onclick เดิมที่
// ฮาร์ดโค้ด behavior ของ scroll ไว้ จึงไม่ฟัง prefers-reduced-motion — ตอนนี้การ
// เลื่อนมาจาก scroll-behavior ใน global.css ซึ่งบล็อก reduced-motion ทับให้แล้ว
//
// ห้ามวาง expression comment ไว้ "ก่อน" <html> ในไฟล์นี้ — Astro จะเลิกมองว่า
// <html> เป็น root ของเอกสารแล้วตัดทั้งแท็กทิ้ง (ทดสอบแล้วเมื่อ 2026-07-31:
// ผลลัพธ์คือทุกหน้าไม่มี <html lang="th"> เลย) คอมเมนต์ที่อธิบายโครงหน้าเลยต้อง
// อยู่ใน frontmatter แบบนี้เท่านั้น
//
// color บน <html> คือสีตัวอักษร "พื้น" ของทั้งเว็บ มาจาก BRAND_TEXT — ห้ามลบ
// ตอนรีแบรนด์ ไม่มีที่อื่นตั้งค่านี้เลย (global.css ก็ไม่ตั้ง) ถ้าหายไป element
// ไหนที่ไม่ได้ใส่คลาสสีเองจะกลายเป็นสีดำของเบราว์เซอร์บนพื้นดำสนิท = หายไปเลย
// หน้า terms/privacy/404 เป็นไฟล์ถาวรที่ไม่ใส่สีของแบรนด์ไว้ข้างในโดยตั้งใจ
// จึงพึ่งบรรทัดนี้ทั้งหมด — verify-build.mjs ตรวจข้อนี้ให้แล้ว build จะแดงถ้าลืม
//
// background-color ใน <style is:global> เป็นสีรองพื้นก่อนที่ชั้น bg จะวาดทับ
// รอบนี้ตั้งเป็น #000000 ให้ตรงกับ bg.json ของดรอปนี้ซึ่งเป็น
// {"mode":"color","color":"#000000"} = **ดำสนิท** รอบก่อน (ถอนชัวร์168) ก็เป็น
// ค่าเดียวกัน แต่ค่านี้มาจาก bg.json ไม่ได้สืบทอดมา — ให้เปิดไฟล์ตรวจทุกรอบ
// ไม่ใช่เดาว่าเท่าเดิมเพราะ "ก็ดำเหมือนกัน"
//
// --font-sans ตั้งเป็น inline style บน <html> ไม่ใช่ใน CSS เพราะ @theme ของ
// Tailwind ประกาศตัวแปรนี้ที่ :root — inline style ชนะเสมอโดยไม่ต้องพึ่ง
// ลำดับของ stylesheet หรือ !important (คอมเมนต์อยู่ใน frontmatter เพราะ
// คอมเมนต์แบบ HTML จะถูกส่งออกไปที่ไฟล์ผลลัพธ์จริง) รอบนี้ BRAND_FONT หมุนจาก
// kanit กลับไปเป็น google-sans ชุด @font-face และ fontPreloads จึงเปลี่ยนตามเอง
// ทั้งหมด — แบรนด์นี้จะไม่มี preload ของ kanit-v17-latin_thai-* เลยสักไฟล์
const heroAlt = `แบนเนอร์ ${BRAND_NAME} เป็นภาพแนวนอนฉากห้องโถงคฤหาสน์หรูโทนขาวงาช้างสว่าง มีเหรียญทองปลิวกระจายอยู่ทั่วทั้งภาพ ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีเงิน สวมสูทสีขาว นั่งพิงพนักบัลลังก์ทองโดยยกมือขึ้นแตะคาง สวมนาฬิกาข้อมือทองและแหวนทอง รายรอบด้วยมงกุฎทอง กองเหรียญทอง และไพ่เอซโพดำพื้นดำขอบทอง กลางภาพด้านบนเป็นโลโก้ ${BRAND_NAME} ขนาดย่อ เป็นหัวเทพเจ้าโชคลาภจีนยิ้มหัวเราะ สวมหมวกทรงจีนสีแดงขลิบทองมีลูกปัดทองห้อยสองข้าง ใต้ลงมาเป็นชื่อแบรนด์ตัวใหญ่ ตัวอักษรไทยคำว่า ดวงเศรษฐี เป็นตัวหนาสามมิติผิวทองมันวาว ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติสีแดงสดขลิบทอง ถัดลงมาเป็นคำโปรยตัวหนาสีขาวขอบทองเขียนว่า เว็บสอนเล่นเกมออนไลน์ และแผ่นป้ายโค้งพื้นสีแดงขอบสีทองเขียนว่า จากเศรษฐีพนันมือ1 ต่อท้ายด้วยมงกุฎทองใบเล็ก ฝั่งขวาเป็นหญิงสาวผมยาวสีเงิน สวมชุดรัดรูปสีขาวแต่งลายทอง พร้อมสร้อยคอทอง ต่างหูทอง และกำไลทอง เท้าคางมองมาทางผู้ชม ข้างตัวมีกองชิปคาสิโนสีดำลายทองและกองเหรียญทอง`
---

<html lang="th" id="top" style={`--font-sans: ${fontStack}; color: ${BRAND_TEXT};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href={`/favicon-96x96.png?v=${iconVersion}`} sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
              {profile.showShortcutIcon && <link rel="shortcut icon" href={`/favicon.ico?v=${iconVersion}`} />}
              <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${iconVersion}`} />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #000000;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        Bg && (
          <Image
            src={Bg}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[412, 768, 1024, 1900]}
            sizes="100vw"
            format="avif"
            class="fixed inset-0 -z-50 h-full w-full object-cover"
            quality="low"
            decoding="async"
          />
        )
      )
    }

    <Navbar />

    <div class="mb-2 flex w-full items-center justify-center">
      {
        /* The LCP element. sizes must describe how wide it is DRAWN, and it is
          drawn full-bleed at every breakpoint — the old "(max-width: 768px)
          412px" claimed 412 px on mobile, so a DPR-2 phone needed 824 and the
          browser jumped straight past the 768 candidate to the 1900 one. That
          is a 3x over-fetch on exactly the image that decides LCP, not a
          blurry-image problem. More candidates below 1900 so there is
          something sensible to land on.

          decoding="sync" is gone: it blocks the main thread on decode for no
          benefit here, since the image is already fetchpriority="high". */
      }
      <picture class="block">
        {mobileBannerImg && <source media="(max-width: 767px)" type="image/avif" srcset={mobileBannerImg.srcSet.attribute || mobileBannerImg.src} sizes="100vw" />}
        <Image
          src={mainBanner}
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          widths={[412, 640, 828, 1024, 1280, 1600, 1900]}
          sizes="100vw"
          class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
          format="avif"
          quality={60}
        />
      </picture>
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
