// kanit (LOTTOPLUS) ไปเป็น google-sans ชุด @font-face และ fontPreloads จึง
// เปลี่ยนตามเองทั้งหมด — แบรนด์นี้จะไม่มี preload ของ kanit-v17-* เลยสักไฟล์
const heroAlt = `แบนเนอร์ ${BRAND_NAME} เป็นภาพแนวนอนฉากผ้าซาตินสีชมพูนวลพลิ้วที่มีดอกไม้สีชมพูจางและประกายแสงฟุ้งประดับอยู่ทั่วภาพเป็นฉากหลัง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเกล้าผมผูกโบว์ริบบิ้นซาตินสีชมพู สวมชุดลูกไม้ระบายสีชมพูอ่อนและต่างหูรูปหัวใจ ท้าวคางมองมาทางผู้ชม ข้างตัวมีไพ่เอซโพดำกับโพแดงวางซ้อนกัน และลูกเต๋าสีชมพูจุดขาววางอยู่ กลางภาพค่อนไปทางขวาเป็นข้อความตัวใหญ่สามมิติ ${BRAND_NAME} ตัวอักษรอ้วนมน ผิวไล่จากขาวนวลด้านบนลงมาหาชมพูอ่อนด้านล่าง ตัดขอบสีชมพูเข้มหนาสองชั้น โดยตัวอักษร A มีหัวใจสีชมพูดวงเล็กซ้อนอยู่ในช่องกลางตัวอักษร ถัดมาเป็นตัวอักษรไทยสามมิติผิวชมพูอ่อนตัดขอบชมพูเข้ม และใต้สุดเป็นแถบแคปซูลพื้นสีชมพูบานเย็นขอบทองที่มีข้อความสีขาวและสีทองอยู่ภายใน เหนือเวิร์ดมาร์กตัวใหญ่ขึ้นไปเป็นตราสัญลักษณ์ทรงกลมพื้นชมพูขอบขาว ซึ่งมีมาสคอตลูกหมูการ์ตูนหน้ากลมสีชมพูหูตก แก้มแดงระเรื่อ ขยิบตาข้างหนึ่งและยิ้มอ้าปาก เอาสองขาหน้าเกาะขอบวงกลมโผล่ขึ้นมา ฝั่งขวาของภาพเป็นวงล้อรูเล็ตขอบทองวางเอียงอยู่หลังกองชิปคาสิโนสีชมพูสลับขาว และมีหัวใจสีชมพูสามมิติผิวมันเงาลอยกระจายอยู่ทั่วทั้งภาพ`
---

<html lang="th" id="top" style={`--font-sans: ${fontStack}; color: ${BRAND_TEXT};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href={`/favicon-96x96.png?v=${iconVersion}`} sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
              {profile.showShortcutIcon && <link rel="shortcut icon" href={`/favicon.ico?v=${iconVersion}`} />}
              <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${iconVersion}`} />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #f8b9f0;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        Bg && (
          <Image
            src={Bg}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[412, 768, 1024, 1900]}
            sizes="100vw"
            format="avif"
            class="fixed inset-0 -z-50 h-full w-full object-cover"
            quality="low"
            decoding="async"
          />
        )
      )
    }

    <Navbar />

    <div class="mb-2 flex w-full items-center justify-center">
      {
        /* The LCP element. sizes must describe how wide it is DRAWN, and it is
          drawn full-bleed at every breakpoint — the old "(max-width: 768px)
          412px" claimed 412 px on mobile, so a DPR-2 phone needed 824 and the
          browser jumped straight past the 768 candidate to the 1900 one. That
          is a 3x over-fetch on exactly the image that decides LCP, not a
          blurry-image problem. More candidates below 1900 so there is
          something sensible to land on.

          decoding="sync" is gone: it blocks the main thread on decode for no
          benefit here, since the image is already fetchpriority="high". */
      }
      <picture class="block">
        {mobileBannerImg && <source media="(max-width: 767px)" type="image/avif" srcset={mobileBannerImg.srcSet.attribute || mobileBannerImg.src} sizes="100vw" />}
        <Image
          src={mainBanner}
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          widths={[412, 640, 828, 1024, 1280, 1600, 1900]}
          sizes="100vw"
          class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
          format="avif"
          quality={60}
        />
      </picture>
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
