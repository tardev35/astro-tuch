---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (สบาย168 -> พักยก168): NavbarStyle7 -> NavbarStyle4Black
// และ FooterPremium -> FooterStyle3 มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
//
// ทรงของสองไฟล์นี้ต่างจากของรอบก่อนจริง ไม่ใช่แค่เปลี่ยนสี: NavbarStyle7 เป็น
// **แถบแนวนอน sticky + bottom sheet บนมือถือ** ส่วน NavbarStyle4Black เป็น
// **แถบแนวนอนที่เมนูเป็นแผ่นเฉียง skew-x-[-15deg] + drawer เลื่อนจากขวา** ·
// FooterPremium เป็นแผ่น rounded-t-[3rem] กริด 12 คอลัมน์ ส่วน FooterStyle3 เป็น
// **การ์ด CTA ลอยคร่อมขอบบน (-top-14/md:-top-16) แล้วแผ่นเว้น pt-64 ไว้รับ**
// พร้อม BankStrip อยู่ในคอลัมน์ช่องทางทำรายการ
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ⚠️ **รอบนี้ยังเป็นเว็บสล็อตเหมือนรอบก่อน แต่คนละแกน**: รอบก่อนเป็นสล็อต "เบทต่ำ"
// รอบนี้เป็น **เว็บสล็อตเจ้าดังค่ายแท้ ถูกลิขสิทธิ์100% มีทดลองเล่นฟรี** และ
// **ยังไม่ใช่เว็บหวย** → /ตรวจหวย กับ /แนวทาง ยังอยู่ใน src/pages-disabled/ จึง
// **ห้ามมีลิงก์ /ตรวจหวย หรือ /แนวทาง ในเมนูหรือฟุตเตอร์รอบนี้เด็ดขาด**
// (verify-build จะแดงถ้าลิงก์ชี้ไป route ที่ไม่มี และโครมขึ้นทุกหน้า)
// ชุด *Huay ทั้งหมดยังเป็น inventory เต็มตัวรอบนี้ ไม่มีหน้าไหน render มันเลย
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarStyle4Black ประกาศเมนูเป็น `links` ชุดเดียวและ map ทั้งแถบเดสก์ท็อป+
// drawer มือถือจากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น
// **พี่น้อง** ของ label — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
// (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login (หน้าปุ่มจริงของรอบนี้)
// ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน login/register/Navfoot เท่านั้น
//
// ⚠️ **BankStrip.astro ยัง render รอบนี้** เพราะ FooterStyle3 import มันมาเอง
// ตามทรงของ variant (ไม่ใช่เราดึงเข้ามา) และบรีฟรอบนี้พูดถึง "ช่องทางฝากถอน" จริง
// (content.txt บรรทัด 4) — **ไฟล์นั้นไม่มีสีของแบรนด์อยู่เลยและต้องไม่มีตลอดไป**
// สีที่เห็นเป็นสีซีแมนติกของแบรนด์ธนาคารซึ่งอบมาใน PNG แล้ว **sweep สีต้องข้ามไฟล์นั้น**
//
