---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (okkub88 -> MEXICANOSLOT): NavbarStyle8 -> NavbarStyle2
// และ FooterStyle3 -> FooterPremiumSumo มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ทรงของสองไฟล์นี้ต่างจากของรอบก่อนจริง ไม่ใช่แค่เปลี่ยนสี: NavbarStyle8 เป็นแถบนอน
// แบนติดขอบบน ไม่มีแถบ info และเมนูมือถือเป็น drawer เลื่อนเข้าจากขอบขวา —
// **NavbarStyle2 มีแถบ info คาดบนสุด (lg ขึ้นไป) ตัว nav เป็นการ์ดพิลล์ลอย
// rounded-[20px] sticky top-2 สูง 75px และเมนูมือถือเป็น overlay เต็มจอที่ไล่
// รายการขึ้นทีละตัว** · FooterStyle3 เป็นแผ่นที่มีการ์ด CTA ลอยคร่อมขอบบน
// (-top-14 พร้อม pt-* รับ) และ BankStrip อยู่ในแถบของตัวเอง — **FooterPremiumSumo
// เป็นแผ่น rounded-t-[3rem] ที่มีออราเบลอคร่อมทั้งขอบบนและขอบล่าง กริด 12 คอลัมน์
// แบ่ง 5/3/4 ไม่มีการ์ด CTA ลอย และไม่ render BankStrip เลย**
//
// ⚠️⚠️ **รอบนี้ยังเป็นเว็บสล็อตและเนื้อหายังเป็นธีมสว่างเหมือนรอบก่อน แต่เปลี่ยนฮิว
// ทั้งตระกูล และ "กลับทิศของโครม"**
// บรีฟเรียกตัวเองว่า "สล็อตเมกซิกัน เดิมพันออนไลน์ เว็บแท้ที่นี่ที่เดียว" และพูดถึง
// **การันตีเว็บตรง · ยอดเข้าบริษัทไม่ผ่านเอเย่นต์ · สดส่งตรงจากเมกซิกัน ·
// โปรโมชั่นอัปเดตใหม่ตลอดสัปดาห์ · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ไม่จำกัด ·
// สมัครด้วยตัวเอง 3 ขั้นตอน · แอดมินออนไลน์ตลอด 24ชม.**
// 🚨🚨 **บรีฟรอบนี้ไม่พูดถึงธนาคาร วอลเลท หรือการฝากถอนเลยแม้แต่คำเดียว** — และนั่น
// คือเหตุผลหนึ่งที่ footer รอบนี้เลือกตัวที่ **ไม่ render BankStrip**
// → **/ตรวจหวย กับ /แนวทาง ยังอยู่ใน src/pages-disabled/ ต่อ** และ NavbarStyle2
// กับ FooterPremiumSumo **ต้องไม่มีลิงก์ไปสองหน้านั้น** (ตรวจแล้วใน P1) route ไม่มีอยู่จริง
// ลิงก์ค้างไว้จะทำให้ verify-build แดง
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarStyle2 เคยประกาศเมนูเป็นอาร์เรย์ inline **สองชุด** (เดสก์ท็อป + overlay)
// และ **ไม่มีไอคอนเลย** — รวบเป็น `links` ชุดเดียวพร้อมไอคอนเป็น
// <span aria-hidden="true"> ที่เป็น **พี่น้อง** ของ label แล้ว
// **ห้ามแยกกลับเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS **แบบ verbatim ตาม SKILL.md ห้ามทาสี**
// (รอบก่อนต้องเบี่ยงเพราะ footer เป็นผิวขาว — รอบนี้ footer เข้ม จึงกลับไปใช้ค่าเดิม)
// (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro
// ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login
// (หน้าปุ่มจริงของรอบนี้) ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน
// login/register/Navfoot
//
// ภาษาภาพของรอบนี้อ่านจากอาร์ตเวิร์กจริง — **ซอมเบรโรฟางขอบลายปักแดง-เขียว ·
// ปอนโช/ผ้าซาราเป้ลายทางแดง-ขาว-เขียว · มาราคัส · กีตาร์โปร่ง · กระบองเพชรเขียว ·
// พริกแดง · ธงชาติเม็กซิโกเขียว-ขาว-แดง · อาคารอะโดบีครีม · ลายปักเรขาคณิต ·
// เหรียญทอง · ดอกไม้แดง · หนวด · เวิร์ดมาร์กสามมิติ "MEXICANO" แดงสด + "SLOT"
// น้ำเงินไล่ฟ้า ตัดขอบขาวหนา · แคปซูลแดงขอบทองเขียนว่า แจกโบนัสทั้งวัน**
// ⚠️ จึง **ห้ามใส่ภาษาหน้าการ์ตูนกลมชมพูขยิบตาชู V/หัวใจชมพู/ฟองสบู่/โบว์/ตัวอักษร
// เจลลี่บับเบิลกัมชมพู (okkub88) หรือภาษาเมฆฟ้า/ตู้สล็อต 777 ฟ้า/หัวการ์ตูน
// หน้าตกใจ (โบ๊ะบ๊ะ168) หรือภาษาลูกหมูมีปีกนางฟ้า (หมูบิน168) หรือภาษาเจลแดง/
// มงกุฎทอง/วงล้อแดง (สล็อต168) หรือภาษาลูกบอลหวย/ใบสลาก (รวย168) หรือภาษา
// ห้างสรรพสินค้าหรู (มาดาม168) หรือภาษาอวกาศ/นักบินอวกาศ (นาซ่า168) กลับเข้าไป
// ในสองไฟล์นี้**
// ⚠️ และ **ห้ามใส่ภาษามอนอสเปซ/สแลชสามตัว/SYSTEM_/เส้นสแกนนีออน**
// ⚠️⚠️ **กับดักที่แหลมที่สุดของรอบนี้: "SLOT" ในเวิร์ดมาร์กเป็นสีน้ำเงินไล่ฟ้าจริง
// บนโลโก้และแบนเนอร์ — แต่มันเป็นอาร์ตเวิร์ก ไม่ใช่สี UI** ฟ้าคือฮิวนำของ
// โบ๊ะบ๊ะ168 เมื่อสองรอบก่อน การดึงฟ้าเข้ามาเป็นสีเว็บ = หลงเหลือข้ามแบรนด์แบบตรงตัว
// **สี UI ของรอบนี้มาจากครึ่งแรกของเวิร์ดมาร์ก (แดง) ธงชาติ (แดง-ขาว-เขียว)
// และขอบแคปซูล/เหรียญ (ทอง) เท่านั้น**
// โครงสร้าง/เลย์เอาต์ของ variant คงไว้ได้ แต่ภาษาภาพ (คำ ไอคอน ลวดลาย)
// ต้องเป็นของรอบนี้
