---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (โปรดี168 -> ยูฟ้า168): NavbarStyle4 -> NavbarStyle9
// และ FooterPremiumSumo -> FooterCyber มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
//
// ⚠️ **FooterCyber เคยออกรอบรวยแท้168 (สองรอบก่อน) ไม่ใช่รอบที่แล้ว** จึงยังนับว่า
// หมุนออกจากตัวที่เพิ่งใช้ได้ถูกต้อง ส่วน NavbarStyle9 ไม่เคยถูกใช้ในรอบหลังๆ เลย
// (ตรวจด้วย `git show <sha>:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ⚠️ **รอบนี้เปลี่ยนหมวดเว็บอีกครั้ง**: รอบก่อนเป็นสล็อตล้วน รอบนี้เป็น
// **เว็บพนันออนไลน์ครบวงจร แทงบอล + สล็อต + บาคาร่า** และ **ยังไม่ใช่เว็บหวย**
// → /ตรวจหวย กับ /แนวทาง ยังอยู่ใน src/pages-disabled/ จึง
// **ห้ามมีลิงก์ /ตรวจหวย หรือ /แนวทาง ในเมนูหรือฟุตเตอร์รอบนี้เด็ดขาด**
// (verify-build จะแดงถ้าลิงก์ชี้ไป route ที่ไม่มี และโครมขึ้นทุกหน้า)
// ⚠️⚠️ **FooterCyber ที่เลือกรอบนี้ ship มาพร้อมลิงก์ /ตรวจหวย และ /แนวทาง ใน
// อาร์เรย์ของตัวเอง — ถอดออกแล้วในรอบ P1 ห้ามใส่กลับ**
// ชุด *Huay ทั้งหมดยังเป็น inventory เต็มตัวรอบนี้ ไม่มีหน้าไหน render มันเลย
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarStyle9 ต้องประกาศเมนูเป็น `links` ชุดเดียวและ map ทั้งเดสก์ท็อป+ลิ้นชัก
// มือถือจากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น **พี่น้อง**
// ของ label — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
// (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login (หน้าปุ่มจริงของรอบนี้)
// ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน login/register/Navfoot เท่านั้น
//
// ⚠️ **BankStrip.astro ยังเป็น inventory รอบนี้** — FooterCyber ไม่ได้ import มัน
// และบรีฟรอบนี้ **ไม่ได้ระบุชื่อธนาคารแม้แต่แห่งเดียว** จึงไม่มีเหตุผล
// ให้ดึงกลับเข้ามา ถ้าวันไหนดึงกลับ: **ไฟล์นั้นไม่มีสีของแบรนด์อยู่เลยและต้องไม่มี
// ตลอดไป** สีที่เห็นเป็นสีซีแมนติกของแบรนด์ธนาคารซึ่งอบมาใน PNG แล้ว
