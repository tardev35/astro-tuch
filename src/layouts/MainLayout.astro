---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (โบ๊ะบ๊ะ168 -> okkub88): NavbarStyle5 -> NavbarStyle8
// และ FooterStyle2 -> FooterStyle3 มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
// ทรงของสองไฟล์นี้ต่างจากของรอบก่อนจริง ไม่ใช่แค่เปลี่ยนสี: NavbarStyle5 มีแถบ info
// คาดเหนือ nav (เฉพาะ lg ขึ้นไป) ตัว nav สูง 70px และเมนูมือถือเป็นแผงเต็มจอที่ไล่
// รายการขึ้นทีละตัว — **NavbarStyle8 เป็นแถบนอนแบนไม่มีแถบ info ด้านบน และเมนู
// มือถือเป็น drawer เลื่อนเข้าจากขอบขวา** · FooterStyle2 เป็นแผ่นแบน ขอบบนเส้นหนา
// 3px กริด 4 คอลัมน์เท่ากัน — **FooterStyle3 เป็นแผ่นที่มีการ์ด CTA ลอยคร่อมขอบบน
// (-top-14 พร้อม pt-* รับ) และ BankStrip อยู่ในแถบของตัวเอง**
//
// ⚠️⚠️ **รอบนี้ยังเป็นเว็บสล็อตและยังเป็นธีมสว่างเหมือนรอบก่อน แต่เปลี่ยนฮิวทั้งตระกูล
// และ "กลับทิศของโครม"**
// บรีฟเรียกตัวเองว่า "เว็บสล็อตเงินดี ทางเข้าเล่นง่าย ยูสใหม่แตกไว" และพูดถึง
// **รับโปรไม่อั้น · โบนัสแจกทั้งวันไม่จำกัด · สมัคร 3 ขั้นตอน · คืนยอดเสีย 0.3% ·
// แนะนำเพื่อน 0.8% · ฝากถอนทุกธนาคารและทรูวอลเลท · ฝากถอนไม่มีขั้นต่ำ ·
// แอดมิน 24ชม.**
// → **/ตรวจหวย กับ /แนวทาง ยังอยู่ใน src/pages-disabled/ ต่อ** และ NavbarStyle8
// กับ FooterStyle3 **ต้องไม่มีลิงก์ไปสองหน้านั้น** (ตรวจแล้วใน P1) route ไม่มีอยู่จริง
// ลิงก์ค้างไว้จะทำให้ verify-build แดง
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarStyle8 ประกาศเมนูเป็น `links` ชุดเดียวและ map ทั้งแถบเดสก์ท็อป+drawer
// จากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น **พี่น้อง**
// ของ label — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
// (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login (หน้าปุ่มจริงของรอบนี้)
// ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน login/register/Navfoot
//
// ภาษาภาพของรอบนี้อ่านจากอาร์ตเวิร์กจริง — **หน้าการ์ตูนกลมสีชมพูขยิบตา ยิ้มอ้าปาก
// แก้มแดง มือชู V ใส่ถุงมือขาว (ทำหน้าที่เป็นตัว O ของเวิร์ดมาร์ก) · เวิร์ดมาร์ก
// "OKkub88" ตัวอักษรเจลลี่สามมิติชมพูบับเบิลกัม ตัดขอบขาวหนา · หัวใจชมพูลอยประดับ
// รอบตัวอักษร · แบนเนอร์เป็นสตูดิโอพื้นขาวสะอาด ผู้หญิงใส่คาร์ดิแกนถักชมพูถือ
// โทรศัพท์ที่จอแสดงตารางเกมสล็อตหกช่อง · สไลด์ทั้งสองใบมีหมูการ์ตูนชมพู เหรียญทอง
// กล่องของขวัญชมพู และเลข 0.3% / 0.8% ตัวบับเบิลชมพู**
// ภาษาที่ใช้ได้รอบนี้: **เจลลี่บับเบิลกัมชมพู · ไฮไลต์ขาว · หัวใจชมพู · หน้ายิ้ม
// การ์ตูนกลม · แก้มแดง · ฟองสบู่ · แคปซูล/พิลล์มน · โบว์ · ประกาย/สปาร์เคิล**
