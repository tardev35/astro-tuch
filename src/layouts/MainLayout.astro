---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (มาดาม168 -> รวย168): NavbarStyle4Black -> NavbarHuay
// และ FooterPremium -> FooterHuay มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
// (ตรวจของรอบก่อนด้วย `git show HEAD:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`)
//
// ⚠️⚠️ **รอบนี้กลับทิศจากรอบก่อน: รวย168 เป็น "เว็บหวยออนไลน์" ไม่ใช่เว็บสล็อต**
// บรีฟเรียกตัวเองว่า "แทงหวยเว็บรวย รับแทงเลขออนไลน์ทุกประเภท" และพูดถึง
// **หวยรัฐบาลไทย · หวยลาว · หวยฮานอย · หวยออมสิน · บาทละ 1,000 ·
// อัตราจ่าย 2 ตัว 100 · 3 ตัว 1,000 · คืนยอดเสีย 0.3% · แนะนำเพื่อน 0.8% ·
// ฝากถอนทุกธนาคารและทรูมันนี่ · แอดมิน 24ชม.**
// → **/ตรวจหวย กับ /แนวทาง ถูกย้ายกลับเข้า src/pages/ แล้วรอบนี้** และลิงก์ของ
// ทั้งสองหน้า **ต้องอยู่** ในเมนู navbar และใน footer (route มีจริงทั้งคู่)
// นี่คือเหตุผลที่เลือกตระกูล *Huay ทั้งชุด — ตรงธีมจริง ไม่ใช่แค่หมุนให้ครบ
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarHuay ประกาศเมนูเป็น `links` ชุดเดียวและ map ทั้งแถบเดสก์ท็อป+
// drawer มือถือจากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น
// **พี่น้อง** ของ label — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
// (ฉ) ปุ่ม CTA ในโครมชี้ไป /register กับ /login (หน้าปุ่มจริงของรอบนี้)
// ไม่ใช่ลิงก์ affiliate ตรงๆ — targetUrl ของรอบนี้อยู่ใน login/register/Navfoot เท่านั้น
//
// ⚠️ **FooterHuay มีลิงก์ /ตรวจหวย กับ /แนวทาง อยู่ใต้ "ทางลัดหน้าเว็บ" มาแต่เดิม**
// ซึ่งรอบนี้ **ถูกต้องแล้ว** (ต่างจากแบรนด์สล็อตที่ต้องถอดออก) — route มีจริงทั้งคู่
//
// ภาษาภาพของรอบนี้อ่านจากอาร์ตเวิร์กจริง — **สตูดิโอดำสนิท ลูกบอลหวยเลข 9/6/8
// ใบสลากกินแบ่ง ป้ายตารางอัตราจ่ายขอบโครเมียม ผู้หญิงผมสั้นดัดลอนสีขาวเงิน
