import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (พักยก168 -> เงินทอง168): NavbarStyle4Black -> NavbarStyle10
// และ FooterStyle3 -> FooterStyle2 มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
//
// ทรงของสองไฟล์นี้ต่างจากของรอบก่อนจริง ไม่ใช่แค่เปลี่ยนสี: NavbarStyle4Black เป็น
// **แถบเต็มความกว้างที่เมนูเป็นแผ่นเฉียง skew-x-[-15deg] + drawer เลื่อนจากขวา**
// ส่วน NavbarStyle10 เป็น **แคปซูลลอย rounded-[20px] sticky top-2 max-w-7xl
