// ไม่มีในบรีฟรอบนี้เลย ห้ามเขียนกลับเข้ามาในสองบรรทัดนี้
// 🚨 **บรีฟรอบนี้ไม่มีหมวดฝากถอน/ธนาคาร/วอลเลทเลยแม้แต่คำเดียว และไม่มีหมวด
// โปรโมชั่นด้วย** — คำที่พลาดง่ายที่สุดของรอบนี้คือการเผลอเติมท้าย description ว่า
// "รองรับทุกธนาคารและวอลเลท" หรือ "คืนยอดเสีย 0.3%"
// · คำของ ZANE96 ("สล็อตลิขสิทธิ์แท้ในไทย" / "เว็บตรงไม่ผ่านเอเย่นต์" /
// "แหล่งรวมเกมสล็อตแบรนด์ดัง" / "ยูสใหม่เล่น1บาทได้") · คำของ okkub88
// ("เว็บสล็อตเงินดี" / "ทางเข้าเล่นง่าย" / "ยูสใหม่แตกไว" / "รับโปรไม่อั้น" /
// "โบนัสแจกทั้งวันไม่จำกัด" / "ฝากถอนไม่มีขั้นต่ำ" / **"ทรูวอลเลท"**) ·
// คำของ โบ๊ะบ๊ะ168 ("เกมสล็อตสนุกสุดมันส์" / "เว็บตรงแตกง่าย" / "เบทต่ำ" /
// "ไม่ทำเทิร์น" / "รวมค่ายดัง" / "ถอนได้ไม่จำกัด" / "ทรูมันนี่") ·
// คำของ หมูบิน168 ("เกมสล็อตแท้" / "เว็บตรงถูกลิขสิทธิ์" / "เชื่อถือได้" /
// "ไม่จำกัดยอด") · คำของ สล็อต168 ("ระบบสล็อตเว็บนอก" / "ทางเข้าแท้" /
// "ไม่ผ่านเอเย่นต์100%" / "ฐานเกมหลัก") · คำหวยของแบรนด์หวยเก่า — **ชื่อแบรนด์**
// ("รวย168" / "888PARUAY" / "JEDI66" / "หวยเต็ง" / "LOTTOPLUS") และวลีเฉพาะของมัน
// ("แทงหวยเว็บรวย" / "บาทละ1,000" / "หวยออมสิน" / "สลากกินแบ่งรัฐบาล") ก็ห้ามเช่นกัน
// ⚠️ แต่ **คำหมวดหวยทั่วไป ("หวย" / "แทงหวย" / "สลาก" / "งวด" / "เลขเด็ด")
// รอบนี้ใช้ได้** เพราะเป็นคำของบรีฟเอง — อย่าสืบทอดข้อห้ามข้ามรอบโดยไม่เปิดบรีฟดู
// รอบนี้คำนิยามตัวเองคือ "แนะนำเว็บหวยลอตโต้ แทงหวยจ่ายสด รับทุกเลข ไม่มีอั้น"
// ตามบรรทัด Title/Description ของบรีฟเป๊ะๆ (content.txt บรรทัด 1-2) — ทั้งสองบรรทัด
// นี้คัดมา **verbatim** ห้ามต่อเติม เหตุผลที่คัดตรงตัว: บรรทัดในบรีฟคือคำของแบรนด์
// ไม่ใช่ร่างให้ปรับปรุง
const {
  title = `${BRAND_NAME} แนะนำเว็บหวยลอตโต้ แทงหวยจ่ายสด รับทุกเลข ไม่มีอั้น`,
  description = `${BRAND_NAME} แนะนำเว็บหวยลอตโต้ แทงหวยออนไลน์ ลาว ฮานอย รัฐบาลไทย หุ้นต่างประเทศ จ่ายเต็ม จ่ายสด เปิดรับทุกเลข ไม่มีอั้นเลข`,
  robots = "index, follow",
} = Astro.props;

// og:image. Two problems with what used to be here (`ImageOg = ogImage.src`):
//
//   * `.src` on an imported asset is the ORIGINAL file. Astro copied slide1.png
//     into the build untouched — 190 KB of PNG — purely to be linked from a
//     meta tag. getImage() below runs it through the same pipeline every other
//     image uses.
//   * every page declares twitter:card = summary_large_image, which wants a
//     1.91:1 image around 1200x630. slide1 is a 600x600 square, so the card was
//     rendering a small square crop of a promo banner.
//
// The uploader now writes src/assets/og.png at 1200x630 when slide1 is
// uploaded. Prefer it when it exists; fall back to slide1 for a brand launched
// before that, so this never breaks a build.
const ogCandidates = import.meta.glob<{ default: ImageMetadata }>("../assets/og.{png,webp,jpg,jpeg}", { eager: true });
const ogCandidatePaths = Object.keys(ogCandidates);
const ogSource = ogCandidatePaths.length > 0 ? ogCandidates[ogCandidatePaths[0]].default : ogImage;

// Width only — passing height as well would make the image service crop to that
// exact box, which turns the square fallback into a slice of itself.
const ogRendered = await getImage({ src: ogSource, format: "jpeg", quality: 80, width: Math.min(1200, ogSource.width) });
const ImageOg = ogRendered.src;

// The wallpaper <Image> below is decorative and deliberately lazy/async. It used
// to be loading="eager" decoding="sync", which had the browser fetch and decode
// a full-viewport image at the same priority as the hero banner — the actual LCP
// element — on the one request where that competition costs most. A background
// arriving a beat later is not something a visitor notices; a slow hero is.
//
// (The note lives here rather than above the tag: that tag is one branch of a
// ternary, and a {/* comment */} beside it makes the branch two expressions,
// which fails the build with "Expected ) but found $$render".)
const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

// Glob'd, not a static `import Bg from "../assets/bg.png"`, for the same reason
// banner1 is glob'd (see the comment above bannerImages): a static import is an
// EMITTED file whether or not anything renders it. When bgMode is "color" or
// "gradient" the <Image> branch below never runs, so a leftover bg.png from a
// previous brand's asset drop must not be forced into the bundle just because
// this file's name is referenced somewhere. Glob only matches files that exist
// on disk, so once a stale bg.png is deleted there is nothing left to emit.
const bgImages = import.meta.glob<{ default: ImageMetadata }>("../assets/bg.{png,webp,jpg,jpeg}", { eager: true });
const bgPaths = Object.keys(bgImages);
const Bg = bgPaths.length > 0 ? bgImages[bgPaths[0]].default : null;

// canonicalFor() is the same function every JSON-LD URL goes through, so the
// canonical and the structured data cannot drift apart (see src/lib/schema.ts).
// Do not replace it with new URL(Astro.url.pathname, Astro.site) — that is what
// used to be here, and it disagreed with the JSON-LD about the trailing slash
// on every page.
const canonicalURL = canonicalFor(Astro);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = BRAND_NAME;

const profile = brandProfile(Astro.site);

// คำบรรยาย alt ของ hero เขียนจากไฟล์ banner1.png ของดรอปนี้จริง (2243x701,
// อ่านด้วย Read ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — **ดรอปนี้เปลี่ยนคู่สีทั้งหมด
// จากโครเมียมเงิน+ทองหลอมเหลว+ส้มเพลิงของรอบก่อน เป็นโครเมียมเงิน+แดงเลือดนก+
// ขอบทอง และเปลี่ยนฉากจากสตูดิโอขาว-เทาควันที่มีนักรบหญิงถือดาบและผ้าขาวพลิ้ว
// เป็นห้องสีขาวครีมที่มีหญิงสาวสวมสูทขาวนั่งบนอาร์มแชร์ กับลูกบอลหวยและใบโพยหวย**
// ของรอบก่อน (ZNOVA168 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด) ที่ **ไม่มีในรูปนี้**:
// นักรบหญิงถือดาบยาวผิวเงิน · ชุดเกราะเมทัลลิกเงิน-ขาวประดับหนามแหลม · ริบบิ้นผ้า
// สีแดงพลิ้ว · เหรียญทองลอยกระจาย · ตัวอักษรไทย "สล็อต1บาททรูวอลเลท" ·
// โลโก้ทรูมันนี่วอลเล็ตบนการ์ดขาว · ลำแสงสว่างพาดทแยง · ผ้าขาวพลิ้ว
// ของ ZANE96 ที่ไม่มีเช่นกัน: ตู้สล็อตผิวแก้วม่วงไลแลคที่มีเลข 777 · ชิปคาสิโน
// แมเจนต้าสลับขาว · เชอร์รี่สองลูกสีชมพู · เพชรม่วง · ลำแสงนีออนม่วง-แมเจนต้า ·
// หัวใจเส้นขอบม่วง · ชุดรัดรูปผิวเมทัลลิกโฮโลแกรมสีม่วงเงิน
// ของ MEXICANOSLOT ที่ไม่มีเช่นกัน: ซอมเบรโรฟางขอบลายปัก · ปอนโช/ผ้าซาราเป้ลายทอ
// แดง-ขาว-เขียว · มาราคัส · กีตาร์โปร่ง · กระบองเพชรเขียว · พริกแดง ·
// ธงชาติเม็กซิโก · อาคารอะโดบีครีม · ชายไว้หนวด
// ของ okkub88 ที่ไม่มีเช่นกัน: หน้าการ์ตูนกลมสีชมพูขยิบตาชูสองนิ้ว · ถุงมือขาว ·
// คาร์ดิแกนถักสีชมพู · เวิร์ดมาร์กเจลลี่บับเบิลกัมชมพู
// ของ โบ๊ะบ๊ะ168 ที่ไม่มีเช่นกัน: เสื้อคลุมถักฟ้าอ่อน · หัวการ์ตูนผู้หญิงหน้าตกใจ ·
// เมฆการ์ตูนฟ้าอ่อน · เวิร์ดมาร์กบับเบิลฟ้า
// ของ หมูบิน168 ที่ไม่มีเช่นกัน: ลูกหมูการ์ตูนอ้วนกลมสีชมพู · ปีกนางฟ้าสีขาว
// ของ สล็อต168 ที่ไม่มีเช่นกัน: คาร์ดิแกนถักสีแดง · เวิร์ดมาร์กเจลแดง ·
// มงกุฎทองเล็กประดับหัวใจแดง · คำว่า "ไม่ผ่านเอเย่นต์100%"
// ของ ยูฟ้า168 ที่ไม่มีเช่นกัน: ลูกฟุตบอลลายขาว-ดำขอบทอง · หางวงโคจรทอง ·
// อัฒจันทร์ · สปอตไลต์ · ไพ่เอซ
// ของ มาดาม168 / นาซ่า168 / สบาย168 ที่ไม่มีเช่นกัน: โถงห้างสรรพสินค้า ·
// ฉากอวกาศ/นักบินอวกาศ · โรงเรือนปลูกผัก/หมวกฟางชาวนา
// ของแบรนด์เก่ากว่านั้นที่ไม่มีเช่นกัน: วัดไทยริมน้ำของ รวยแท้168 · สิงโตทองของ
// ufalion168 · หัวไฉ่ซิงเอี๊ยของ ดวงเศรษฐี168 · กล่องของขวัญแดงของ รวยเทพ168 ·
// ชุดลูกไม้ขาวผูกโบว์แดงของ มีเฮ168 · ถุงเงินสีฟ้าของ รวยแทร่168 · นินจาการ์ตูน
// ของ นินจา168 · แมวการ์ตูนลายส้มของ สบายเบท168 · ดอกซากุระชมพูของ ถอนชัวร์168 ·
// แมวกวักของ มีโชค168 · อักขระมังกรจีนของ GT66B · หมูสวมหน้ากากโจรของ มีทรัพย์168
// ⚠️⚠️ **ระวังที่สุดสามข้อ:**
// (1) **รอบนี้ไม่มีตัวการ์ตูนและไม่มีอาวุธเลย** — แบนเนอร์เป็น **หญิงสาวเรนเดอร์
// สมจริงคนเดียวฝั่งซ้าย นั่งเอนบนอาร์มแชร์ ไม่ได้ถืออะไรในมือ และไม่มีโทรศัพท์**
// (2) 🚨🚨 **ลูกบอลหวยและใบโพยหวยมีจริงในรูปนี้ ซึ่งรอบก่อนห้ามไว้ (เป็นของ รวย168)**
// — ให้บรรยายตามที่เห็น อย่าสืบทอดข้อห้ามข้ามรอบ แต่ **ไม่มีม่วง ไม่มีแมเจนต้า
// ไม่มีฟ้า ไม่มีส้มเพลิง และไม่มีเหรียญทองลอยกระจายในรูปนี้เลย**
// (3) 🚨🚨 **แดง/ทอง/ครีมคือฮิวนำของ MEXICANOSLOT เมื่อสามรอบก่อน** — สีในรูป
// **เป็นอาร์ตเวิร์ก** ส่วนสี UI ต้องมาจากตาราง brand-spec §2 เท่านั้น ห้ามดูดค่าจากรูป
// ⚠️ รอบนี้ฉากหลังของแบนเนอร์เป็น **ห้องสีขาวครีมที่มีม่านขาวและผนังบัวหลุยส์**
// **ฝั่งซ้าย** เป็น **หญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมสูทขาวทับชุดชั้นในลูกไม้ขาว
// กับกางเกงขายาวสีขาว นั่งเอนบนอาร์มแชร์บุผ้าสีขาวขอบทอง มือหนึ่งเท้าคางเบาๆ**
// **ตรงกลางค่อนไปขวา** เป็น **เวิร์ดมาร์กสามมิติตัวโต ครึ่งแรกเป็นตัวอักษรละติน
// ผิวโครเมียมเงินขัดเงาตัดขอบแดง ครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงาตัดขอบขาว**
// ต่อด้วย **"แนะนำเว็บ" ตัวอักษรไทยสามมิติผิวเงิน และ "หวยลอตโต้" ผิวแดง ตัดขอบขาว**
// และใต้สุดเป็น **แถบแคปซูลพื้นแดงเข้มขอบทองเขียนว่า แทงหวยจ่ายสด สีขาว คั่นด้วย
// เส้นตั้ง รับทุกเลข สีทอง คั่นด้วยเส้นตั้ง ไม่มีอั้น สีขาว** **ตามขอบภาพ** มี
// **ลูกบอลหวยทรงกลมสีขาวพิมพ์ตัวเลขสีแดง 9 7 8 และ 3** และ **ริมล่างขวา** มี
// **ใบโพยหวยกองซ้อนกันกับปากกาด้ามสีทอง**
// ⚠️⚠️ **อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง** — alt จึงอ้างชื่อด้วย ${BRAND_NAME}
// เท่านั้น **ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลงใน alt** (hero ขึ้นทุกหน้า จึงเป็นจุดรั่ว
// ที่กว้างที่สุดในเว็บ)
// ⚠️ **ฉากในภาพสว่าง และรอบนี้พื้นเพจก็สว่างด้วย (#fff0f0 จาก bg.json)** —
// แต่ **ค่าพื้นเพจมาจาก bg.json เท่านั้น ไม่ได้อนุมานจากรูป** ให้เปิด bg.json
// ดูทุกรอบเหมือนเดิม แม้ในรอบที่ทั้งสองค่าบังเอิญไปทางเดียวกัน
//
// <html> มี id="top" เป็นเป้าของปุ่ม "กลับขึ้นบน" ใน footer แทน onclick เดิมที่
// ฮาร์ดโค้ด behavior ของ scroll ไว้ จึงไม่ฟัง prefers-reduced-motion — ตอนนี้การ
// เลื่อนมาจาก scroll-behavior ใน global.css ซึ่งบล็อก reduced-motion ทับให้แล้ว
//
// ห้ามวาง expression comment ไว้ "ก่อน" <html> ในไฟล์นี้ — Astro จะเลิกมองว่า
// <html> เป็น root ของเอกสารแล้วตัดทั้งแท็กทิ้ง (ทดสอบแล้วเมื่อ 2026-07-31:
// ผลลัพธ์คือทุกหน้าไม่มี <html lang="th"> เลย) คอมเมนต์ที่อธิบายโครงหน้าเลยต้อง
// อยู่ใน frontmatter แบบนี้เท่านั้น
//
// color บน <html> คือสีตัวอักษร "พื้น" ของทั้งเว็บ มาจาก BRAND_TEXT — ห้ามลบ
// ตอนรีแบรนด์ ไม่มีที่อื่นตั้งค่านี้เลย (global.css ก็ไม่ตั้ง) ถ้าหายไป element
// ไหนที่ไม่ได้ใส่คลาสสีเองจะกลายเป็นสีดำของเบราว์เซอร์
// หน้า terms/privacy/404 เป็นไฟล์ถาวรที่ไม่ใส่สีของแบรนด์ไว้ข้างในโดยตั้งใจ
// จึงพึ่งบรรทัดนี้ทั้งหมด — verify-build.mjs ตรวจข้อนี้ให้แล้ว build จะแดงถ้าลืม
// ⚠️⚠️ รอบนี้ค่านี้เป็น **แดงเลือดนกจม #25090f (18.7:1 บนการ์ดขาว ·
// 17.9:1 บนพื้นเพจ)** เพราะ **เนื้อหา** เป็นธีมสว่าง — รอบก่อนเป็นเอสเพรสโซอมส้ม 2a1206
// **ห้ามสืบทอดค่าข้ามรอบ** และห้ามคงค่าเดิมไว้ ไม่งั้นหน้า terms/privacy/404
// จะกลายเป็นตัวอักษรสีของแบรนด์ก่อนบนการ์ดขาว = หลงเหลือข้ามแบรนด์ทั้งสามหน้า
// ⚠️ ค่านี้เป็นสีของ **ผิวสว่าง** ไม่ใช่ของโครม — navbar/footer/ticker รอบนี้เป็น
// ผิวเข้มและประกาศสีตัวอักษรของตัวเอง (#ffeaea) ไว้ครบ ค่านี้จึงไปไม่ถึงมัน
//
// background-color ใน <style is:global> เป็นสีรองพื้นก่อนที่ชั้น bg จะวาดทับ
// รอบนี้ตั้งเป็น #fff0f0 ให้ตรงกับ bg.json ของดรอปนี้ซึ่งเป็น mode color
// + color #fff0f0 = **ขาวอมชมพูจาง (สว่างมาก)**
// ⚠️⚠️ **รอบก่อน (ZNOVA168) เป็น fffbf0 = ครีมอมงาช้างอุ่น ซึ่งเป็นคนละค่า**
// ค่านี้มาจาก bg.json ไม่ได้สืบทอดมา ให้เปิดไฟล์ตรวจทุกรอบ และ **นี่คือค่าที่กำหนด
// ทิศของ "เนื้อหา" ทั้งเว็บ**: รอบนี้เนื้อหาสว่าง แต่โครมเข้ม
// ⚠️ ขาวบน #fff0f0 ได้แค่ 1.07:1 (มองไม่เห็นเลย) ข้อความที่วางบนพื้นเพจตรงๆ
// โดยไม่มีการ์ดรองจึงต้องเป็นหมึกเข้มเท่านั้น
//
// --font-sans ตั้งเป็น inline style บน <html> ไม่ใช่ใน CSS เพราะ @theme ของ
// Tailwind ประกาศตัวแปรนี้ที่ :root — inline style ชนะเสมอโดยไม่ต้องพึ่ง
// ลำดับของ stylesheet หรือ !important (คอมเมนต์อยู่ใน frontmatter เพราะ
// คอมเมนต์แบบ HTML จะถูกส่งออกไปที่ไฟล์ผลลัพธ์จริง) รอบนี้ BRAND_FONT หมุนจาก
// kanit (ZNOVA168) ไปเป็น google-sans ชุด @font-face และ fontPreloads จึง
// เปลี่ยนตามเองทั้งหมด — แบรนด์นี้จะไม่มี preload ของ kanit-v17-* เลยสักไฟล์
const heroAlt = `แบนเนอร์ ${BRAND_NAME} เป็นภาพแนวนอนฉากห้องสีขาวครีม มีม่านผ้าสีขาวและผนังบัวแบบหลุยส์อยู่เป็นฉากหลัง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเข้มดัดลอน สวมสูทสีขาวทับชุดชั้นในลูกไม้สีขาวและกางเกงขายาวสีขาว นั่งเอนอยู่บนอาร์มแชร์บุผ้าสีขาวขอบทอง มือหนึ่งเท้าคางเบาๆ สายตามองมาทางผู้ชม กลางภาพค่อนไปทางขวาเป็นข้อความตัวใหญ่สามมิติ ${BRAND_NAME} ซึ่งครึ่งแรกเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงาตัดขอบเส้นสีแดง และครึ่งหลังเป็นตัวเลขผิวแดงเลือดนกเคลือบเงา ตัดขอบสีขาว ใต้ข้อความเป็นคำว่า แนะนำเว็บ ด้วยตัวอักษรไทยสามมิติสีเงิน ต่อท้ายด้วยคำว่า หวยลอตโต้ สีแดง ตัดขอบขาว และใต้สุดเป็นแถบแคปซูลพื้นสีแดงเข้มขอบทองเขียนว่า แทงหวยจ่ายสด ด้วยตัวอักษรสีขาว คั่นด้วยเส้นตั้ง แล้วตามด้วย รับทุกเลข สีทอง คั่นด้วยเส้นตั้ง แล้วปิดท้ายด้วย ไม่มีอั้น สีขาว ตามขอบภาพทั้งซ้ายและขวามีลูกบอลหวยทรงกลมสีขาวพิมพ์ตัวเลขสีแดงวางกระจายอยู่ และริมล่างขวาเป็นใบโพยหวยกองซ้อนกันกับปากกาด้ามสีทอง โดยมีโลโก้ ${BRAND_NAME} ขนาดเล็กอยู่ที่ขอบบนตรงกลาง`;
---

<html lang="th" id="top" style={`--font-sans: ${fontStack}; color: ${BRAND_TEXT};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href={`/favicon-96x96.png?v=${iconVersion}`} sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
              {profile.showShortcutIcon && <link rel="shortcut icon" href={`/favicon.ico?v=${iconVersion}`} />}
              <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${iconVersion}`} />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #fff0f0;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        Bg && (
          <Image
            src={Bg}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[412, 768, 1024, 1900]}
            sizes="100vw"
            format="avif"
            class="fixed inset-0 -z-50 h-full w-full object-cover"
            quality="low"
            decoding="async"
          />
        )
      )
    }

    <Navbar />

    <div class="mb-2 flex w-full items-center justify-center">
      {
        /* The LCP element. sizes must describe how wide it is DRAWN, and it is
          drawn full-bleed at every breakpoint — the old "(max-width: 768px)
          412px" claimed 412 px on mobile, so a DPR-2 phone needed 824 and the
          browser jumped straight past the 768 candidate to the 1900 one. That
          is a 3x over-fetch on exactly the image that decides LCP, not a
          blurry-image problem. More candidates below 1900 so there is
          something sensible to land on.

          decoding="sync" is gone: it blocks the main thread on decode for no
          benefit here, since the image is already fetchpriority="high". */
      }
      <picture class="block">
        {mobileBannerImg && <source media="(max-width: 767px)" type="image/avif" srcset={mobileBannerImg.srcSet.attribute || mobileBannerImg.src} sizes="100vw" />}
        <Image
          src={mainBanner}
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          widths={[412, 640, 828, 1024, 1280, 1600, 1900]}
          sizes="100vw"
          class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
          format="avif"
          quality={60}
        />
      </picture>
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
