---
import { Image, getImage } from "astro:assets";
import bgConfig from "../assets/bg.json";
import ogImage from "../assets/slide1.png";
import "../styles/global.css";
import { BRAND_NAME, BRAND_TEXT, brandProfile, fontStack, iconVersion } from "../lib/brandProfile";
import { canonicalFor } from "../lib/schema";
// การหมุน variant รอบนี้ (มีทรัพย์168 -> สาธุ168): NavbarStyle3 -> NavbarHuay
// และ FooterStyle3 -> FooterHuay มีได้ทีละตัวเท่านั้น การ "หมุน" ของสองตระกูลนี้
// จึงแปลว่าเปลี่ยนว่า import ชี้ไปไฟล์ไหน ไฟล์เดิมยังอยู่ครบในฐานะ inventory
// ของแบรนด์ถัดไป
//
// ⚠️ **NavbarHuay และ FooterHuay ไม่เคยถูกใช้ในรอบ 14 commit ที่ผ่านมาเลย** (ตรวจ
// ด้วย `git show <sha>:src/layouts/MainLayout.astro | grep -E 'Navbar|Footer'`
// ย้อนหลัง 14 รอบ) — NavbarStyle3 เพิ่งออกรอบที่แล้ว ส่วน NavbarStyle11/6/9/5/8/10/
// 7/4Black/NavbarPremium/NavbarCyber ถูกใช้ไปในรอบใกล้ๆ นี้ทั้งหมด และฝั่ง footer
// **ทั้งหกตัวที่ไม่ใช่ Huay ถูกใช้ครบในรอบ 14 commit**
// ⚠️ เหตุผลที่เลือกชุด *Huay ไม่ใช่แค่ "เว้นนานที่สุด" แต่เพราะ **รอบนี้เป็นเว็บหวย
// เต็มตัว** (บรีฟทั้งฉบับเป็นหวยรัฐบาลไทย/ฮานอย/ลาว/หุ้น และแบนเนอร์เขียนว่า
// "เว็บหวยจ่ายจริงไม่โกง") ชุดนี้ถูกทำไว้สำหรับแบรนด์แนวนี้โดยเฉพาะ
//
// ⚠️ หนี้ที่ต้องตรวจก่อนต่อสองไฟล์นี้เข้ามา (ทำครบแล้วในรอบ P1):
// (ก) NavbarHuay ประกาศเมนูเป็น `const menu` ชุดเดียวและ map ทั้งเดสก์ท็อป+ลิ้นชัก
// มือถือจากตัวเดียวกัน พร้อมไอคอนเป็น <span aria-hidden="true"> ที่เป็น **พี่น้อง**
// ของ label อยู่แล้ว — **ห้ามแยกเป็นสองอาร์เรย์ และห้ามเอาไอคอนไปต่อในข้อความ**
// (ข) ทั้งสองไฟล์ใช้ isActivePath จาก ../lib/nav **ห้ามเขียน isActive เอง** เพราะ
// Astro.url.pathname เป็น percent-encoded บน route ภาษาไทย (ค) ลำดับเมนูต้องเป็น
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · ที่เหลือ (ง) ฟุตเตอร์ต้อง
// render บล็อก `<address>` จาก BRAND_ADDRESS (จ) ทั้งสองไฟล์ไม่มีคอมเมนต์แบบ HTML
// เหลืออยู่ และต้องไม่มีกลับเข้าไป เพราะ Astro ส่งคอมเมนต์ HTML ขึ้น production ตรงๆ
//
// ⚠️ **BankStrip.astro ยังเป็นไฟล์ที่ render อยู่รอบนี้** (FooterHuay import มัน)
// — แต่ **ไฟล์นั้นไม่มีสีของแบรนด์อยู่เลยและต้องไม่มีตลอดไป** สีที่เห็นเป็นสีซีแมนติก
// ของแบรนด์ธนาคารซึ่งอบมาใน PNG แล้ว การ retheme จึงต้อง **ข้ามไฟล์นั้น** สิ่งที่
// ปรับได้คือกรอบ/พื้นของการ์ดที่ครอบแถบ ซึ่งอยู่ใน FooterHuay ไม่ใช่ใน BankStrip
//
// ทรงของสองไฟล์นี้เลือกให้เข้ากับอาร์ตเวิร์กรอบนี้โดยตรง — **วัดไทย เจดีย์ทอง
// ชุดไทยลายปักทอง สลากกินแบ่งรัฐบาล ดอกบัว และลูกบอลหวย** จึง **ห้ามใส่ภาษา
// ฟาร์มการ์ตูน/หมูหน้ากากโจรแบบรอบก่อน ภาษาคฤหาสน์จีน (ไฉ่ซิงเอี๊ย มงกุฎทอง
// เหรียญทอง ไพ่โพดำ) หรือภาษาสนามบอล/มอนอสเปซ/SYSTEM_/เส้นสแกนไซเบอร์
// กลับเข้าไปในสองไฟล์นี้**
//
// ⚠️ **ทั้งสองไฟล์ค้างสีของ หวยคิง อยู่ (เจ้าของเดิมของชุด *Huay) และกับดักรอบนี้คือทอง**
// ห้ามเทียบด้วยตาเด็ดขาด ต้องเทียบเป็นค่า:
//   ทอง/เหลือง — **เคยถูกใช้มาแล้วเกือบทุกแบรนด์** หวยคิง cd9a2c fdeb7c ab7314
//         (ค้างอยู่ในสองไฟล์นี้ตอนรับมา) · f0c878 ของ ดวงเศรษฐี168 · d4922c fdfc71
//         d39c45 f6e3b4 ของ ufalion168 · f0bb4e ของรวยเทพ168 · fcd45c 6b4a08 ของมีเฮ168 ·
//         fcd434 ffeaa0 ของมีโชค168 · ffdc8c f0b429 ของรับตัง168 · e5a81b ffe08a ของ
//         UFA324 · f7c92b ffe6a3 ของขวัญใจ168 · fef54b ของนินจา168 · ffc82e ของ
//         สบายเบท168 · ffd84d ของถอนชัวร์168 — **ทั้งหมดต้องถูกกวาดออก**
//   ชมพู/ฟูเชีย — **ไม่มีอยู่ในรอบนี้เลย** dd1b74 a4186b 4a0d35 2d0720 f7dcf6 f0ccf5
//         ของ มีทรัพย์168 (รอบที่แล้ว) · fa63b9 ffb3de ของถอนชัวร์168 · f5469f ff8dc6
//         8c0f52 ของมีโชค168 · ff8f9c ของมีเฮ168 · ffadaf ของสมหวัง168 · ff6b6e ของ
//         รับตัง168 · f2bba5 c98a74 โรสโกลด์ของขวัญใจ168
//         ⚠️ **ดอกบัวสีชมพูในแบนเนอร์เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
//   แดงชาด — **ไม่มีอยู่ในรอบนี้เลย** d9212a 8e1a16 ของ ดวงเศรษฐี168 · fb1b32 5c0410
//         ของมีเฮ168 · e4021b ของรวยเทพ168 · d30304 ของรับตัง168 · b3121b ของขวัญใจ168 ·
//         fa0513 ของสมหวัง168 · dc0203 f5282a ของหวย365 (เจ้าของก่อนหวยคิงในชุด *Huay)
//   บรอนซ์ — **ไม่มีอยู่ในรอบนี้เลย** a25b24 8c4312 ของ ufalion168 · d9701a ของรวยเทพ168
//   ฟ้า/น้ำเงิน — **ไม่มีอยู่ในรอบนี้เลย** 039cfa c3ebfc 04366b ของรวยแทร่168 ·
//         32bcfb a9e9ff 07335f ของนินจา168 · 2f9ff5 a8dcff 0b3f78 ของสบายเบท168
//         ⚠️ **ท้องฟ้าฟ้าอ่อนในแบนเนอร์เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
//         (เขียว #00B900 บนปุ่ม LINE เป็นสีของแบรนด์ LINE คงไว้ตามเดิม **ห้ามเปลี่ยน
//         เป็นเขียวของแบรนด์** ถึงรอบนี้สีแบรนด์จะเป็นเขียวก็ตาม)
//   เงิน/โครเมียม — **ไม่มีอยู่ในรอบนี้เลย** 8792a0 b9c2cc f0e8d4 464f5a ของ UFA324 ·
//         cfd9e6 ของรับตัง168
// ส่วน **เขียวมรกตรอบนี้คือ #0b7d28** และ **เขียวเข้มรอบนี้คือ #0a5f1c**
// พื้นโครมคือ **#0c3a16** (ยก) กับ **#061f0c** (จม) ตัวอักษรบนโครมคือ #e9fbdd /
// #ffffff และทองสัมฤทธิ์ **#c9cb63 / #aeb04a / #9ba03c**
// ⚠️ **ทองสัมฤทธิ์ทั้งสามค่าบนพื้นโครม #0c3a16 ได้ 7.5 / 5.6 / 4.6:1 = ผ่าน AA**
// จึงถือตัวอักษรบนโครมได้จริง แต่ **บนผิวการ์ดขาวได้แค่ 1.7–2.8:1 = ห้ามใช้**
// และ **#0f9b35 เขียวใบตองได้แค่ 3.7:1 บนขาว เป็น stop ของไล่เฉด/ออราเท่านั้น**
// รายการค่าของแบรนด์อื่นทั้งหมดอยู่ใน .claude/brand-spec-satu168.md §2
// (เขียนเฮกซ์เก่าแบบไม่มี # เพื่อไม่ให้ sweep ที่ไล่หาสีแบรนด์เก่าสะดุดที่คอมเมนต์นี้)
//
// ⚠️⚠️ **รอบนี้คือแบรนด์ "ธีมสว่าง" รอบที่สองของรีโปนี้** — bg.json ของดรอปนี้เป็น
// {"mode":"color","color":"#d8ffc7"} = **เขียวมิ้นต์สว่าง** (รอบก่อนเป็น #f0ccf5
// ชมพูอมม่วง) และ bg.json คือแหล่งเดียวของพื้นเพจ **ห้าม "แก้" ให้กลับไป
// เป็นดำเพราะรอบก่อนๆ เป็นแบบนั้น** ทิศของธีมรอบนี้คือ **เนื้อหา = การ์ดสว่าง
// หมึกเข้ม / โครม (navbar · footer · ticker · winners feed · Navfoot · CtaRedirect)
// = เขียวป่าเข้มตัวอักษรสว่าง** โครมยังเข้มเพราะ (ก) บล็อก <address> ใน footer ต้อง
// paste verbatim ซึ่งออกแบบมาสำหรับ footer เข้ม (ข) หัว-ท้ายเข้มคร่อมเนื้อหาสว่าง
// คืออ่านง่าย (ค) โลโก้เขียว-ทองบนพื้นโปร่งอ่านออกชัดกว่าบนพื้นเข้ม และ
// (ง) อาร์ตเวิร์กเองก็ใช้แคปซูลดำขอบทองบนฉากสว่าง
//
// ⚠️ รอบนี้ **เขียวมรกตนำ คู่ทองสัมฤทธิ์อมเขียวเป็นสีที่สอง** — ต่างจากรอบก่อน
// (มีทรัพย์168 ชมพูบานเย็นนำเดี่ยว) สิ่งที่แยกรอบนี้ออกจากทุกแบรนด์ก่อนหน้าคือ
// (ก) **เขียวไม่เคยถูกใช้เป็นสีแบรนด์ในรีโปนี้เลยสักรอบ** (ข) ทองสัมฤทธิ์ #aeb04a
// อมเขียว ห่างจากทองที่ใกล้ที่สุดในรีโป (d39c45 ของ ufalion168) 42 หน่วย
// (ค) การหมุน variant ไป navbar + footer + ticker + feed + faq ชุด *Huay ทั้งชุด
// ซึ่งไม่ถูกใช้มา 14 รอบ + การ์ดชุด Huay/FloatingBadge/TwoHuay/SevenThreeHuay/
// SevenThreeCyberCut/3ThreeHuay/TwoCyberCut ซึ่งไม่ทับกับรอบก่อนเลยสักไฟล์
// อ่านมาจากอาร์ตเวิร์กตรงๆ: เขียวคือตัวอักษร "สาธุ" ส่วนเลข "168" เป็นทองเหลือง
// (palette.json วัด vivid ของ logo.webp ได้ #fdfdbb #fbe97c #039a14 #fdfbad #0c4c0a
// = **เขียวสดคู่เหลืองทอง** ซึ่งตรงกับที่ตาเห็น แต่ค่าดิบใช้ตรงๆ ไม่ได้เพราะ 039a14
// ได้แค่ 3.7:1 บนขาว และ fbe97c ห่างจาก ffe08a ของ UFA324 แค่ 17 หน่วย จึงเลื่อนเป็น
// #0b7d28 กับ #aeb04a) ⚠️ ส่วน vivid ของ banner1 ที่ palette.json วัดได้
// (#eac3ab #e4bca4) เป็น **สีผิวคนในภาพ ไม่ใช่สีแบรนด์เลย**
// — palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้
// **รอบนี้ไม่มีชมพู ไม่มีแดงชาด ไม่มีบรอนซ์ส้ม ไม่มีฟ้า/น้ำเงิน ไม่มีม่วง
// ไม่มีเงิน/โครเมียม ไม่มีโรสโกลด์ และไม่มีทองส้มสด ในทั้งสามไฟล์**
// และ ⚠️ **ต้องมีลิงก์ /ตรวจหวย กับ /แนวทาง ในเมนูและฟุตเตอร์รอบนี้** เพราะบรีฟ
// ทั้งฉบับเป็นหวยล้วน — สองหน้านั้นถูกย้ายกลับมาที่ src/pages/ แล้วจึงมี route จริง
// (verify-build จะแดงถ้าลิงก์ชี้ไป route ที่ไม่มี และโครมขึ้นทุกหน้า)
//
// รอบนี้ toggle cta ของ uploader ยังเปิดอยู่: /login กับ /register เป็นหน้าปุ่มที่
// index ได้จริง จึงมีสองรายการนั้นอยู่ในเมนู navbar ถัดจาก โปรโมชั่น ทันที และ
// /ทางเข้า ถูกถอดออกจากเมนูแทน (footer ยังลิงก์ทั้งสามหน้าได้ตามปกติ — route มีจริง)
import Navbar from "../components/NavbarHuay.astro";
import Footer from "../components/FooterHuay.astro";

// Only banner1 is ever rendered, so only banner1 is imported.
//
// This used to glob `banner*.{png,webp,jpg,jpeg}` eagerly, and an imported
// image is an EMITTED image whether or not anything renders it. Every stale
// banner in src/assets was therefore copied into dist/_astro on every build and
// uploaded on every deploy — banner.png (2.2 MB), banner2.png and banner3.png,
// 3.1 MB of previous brands' artwork that no page has ever linked. It cost a
// visitor nothing, which is exactly why it survived so long.
//
// The wide glob carried a fallback chain (banner1 → first .webp → first of
// anything) whose entire purpose was to avoid silently picking a stale file.
// Naming one file removes that failure mode instead of mitigating it: there is
// nothing else in scope to pick. A missing banner1 now stops the build with a
// message rather than rendering the previous brand's hero.
//
// Keep the extension list. The uploader writes banner1.png today, but brands
// launched before that have banner1.webp and must keep building.
const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner1.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
if (bannerPaths.length === 0) {
  throw new Error("MainLayout: no src/assets/banner1.{png,webp,jpg,jpeg} — the hero image is missing. The uploader writes banner1.png; upload it before building.");
}
const mainBannerPath = bannerPaths.find((path) => path.endsWith(".webp")) ?? bannerPaths[0];
const mainBanner = bannerImages[mainBannerPath].default;

// Optional portrait/square art for phones, written by the uploader as
// banner1-mobile.*. Pinned by name for the same reason banner1 is.
//
// OPTIONAL, and that is the whole difficulty: banner1 is overwritten on every
// rebrand because the uploader requires it, but a brand that ships no mobile
// art would inherit the previous brand's if the file simply stayed on disk.
// So the uploader DELETES banner1-mobile.* whenever banner1 is uploaded
// without one — the mobile file's lifetime is tied to the desktop file's, and
// there is no state here that can outlive the brand it belongs to.
//
// A <source> rather than CSS: only the matching candidate is ever fetched, so
// a phone downloads the phone art and nothing else. Two <img> toggled by
// `hidden` would download both, on the element that decides LCP.
const mobileBannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner1-mobile.{png,webp,jpg,jpeg}", { eager: true });
const mobileBannerPaths = Object.keys(mobileBannerImages);
const mobileBannerPath = mobileBannerPaths.find((path) => path.endsWith(".webp")) ?? mobileBannerPaths[0];
const mobileBanner = mobileBannerPath ? mobileBannerImages[mobileBannerPath].default : null;
const mobileBannerImg = mobileBanner ? await getImage({ src: mobileBanner, widths: [360, 480, 640, 828, 1080], format: "avif", quality: 60 }) : null;

// ค่า default มาจากบรรทัด Title / Description ของบรีฟรอบนี้ตรงตัว
// (src/assets/content.txt บรรทัด 1-2) ห้ามเติมให้ครบ 150 ตัวอักษร —
// verify-build ยกเว้นเพดานล่าง 150 ให้หน้าแรกไว้แล้วเพราะเหตุผลนี้โดยเฉพาะ
const {
  title = `${BRAND_NAME} เว็บหวยจ่ายจริงไม่โกง ระบบแทงหวย รัฐบาลไทย ฮานอย ลาว หุ้น`,
  description = `${BRAND_NAME} เว็บหวยจ่ายจริงไม่โกง ทางเข้าระบบแทงหวย ผ่านบริษัทแม่โดยตรง เปิดรับแทง รัฐบาลไทย ฮานอย ลาว หุ้นต่างประเทศ จ่ายจริง ไม่มีประวัติโกงล้าน%`,
  robots = "index, follow",
} = Astro.props;

// og:image. Two problems with what used to be here (`ImageOg = ogImage.src`):
//
//   * `.src` on an imported asset is the ORIGINAL file. Astro copied slide1.png
//     into the build untouched — 190 KB of PNG — purely to be linked from a
//     meta tag. getImage() below runs it through the same pipeline every other
//     image uses.
//   * every page declares twitter:card = summary_large_image, which wants a
//     1.91:1 image around 1200x630. slide1 is a 600x600 square, so the card was
//     rendering a small square crop of a promo banner.
//
// The uploader now writes src/assets/og.png at 1200x630 when slide1 is
// uploaded. Prefer it when it exists; fall back to slide1 for a brand launched
// before that, so this never breaks a build.
const ogCandidates = import.meta.glob<{ default: ImageMetadata }>("../assets/og.{png,webp,jpg,jpeg}", { eager: true });
const ogCandidatePaths = Object.keys(ogCandidates);
const ogSource = ogCandidatePaths.length > 0 ? ogCandidates[ogCandidatePaths[0]].default : ogImage;

// Width only — passing height as well would make the image service crop to that
// exact box, which turns the square fallback into a slice of itself.
const ogRendered = await getImage({ src: ogSource, format: "jpeg", quality: 80, width: Math.min(1200, ogSource.width) });
const ImageOg = ogRendered.src;

// The wallpaper <Image> below is decorative and deliberately lazy/async. It used
// to be loading="eager" decoding="sync", which had the browser fetch and decode
// a full-viewport image at the same priority as the hero banner — the actual LCP
// element — on the one request where that competition costs most. A background
// arriving a beat later is not something a visitor notices; a slow hero is.
//
// (The note lives here rather than above the tag: that tag is one branch of a
// ternary, and a {/* comment */} beside it makes the branch two expressions,
// which fails the build with "Expected ) but found $$render".)
const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

// Glob'd, not a static `import Bg from "../assets/bg.png"`, for the same reason
// banner1 is glob'd (see the comment above bannerImages): a static import is an
// EMITTED file whether or not anything renders it. When bgMode is "color" or
// "gradient" the <Image> branch below never runs, so a leftover bg.png from a
// previous brand's asset drop must not be forced into the bundle just because
// this file's name is referenced somewhere. Glob only matches files that exist
// on disk, so once a stale bg.png is deleted there is nothing left to emit.
const bgImages = import.meta.glob<{ default: ImageMetadata }>("../assets/bg.{png,webp,jpg,jpeg}", { eager: true });
const bgPaths = Object.keys(bgImages);
const Bg = bgPaths.length > 0 ? bgImages[bgPaths[0]].default : null;

// canonicalFor() is the same function every JSON-LD URL goes through, so the
// canonical and the structured data cannot drift apart (see src/lib/schema.ts).
// Do not replace it with new URL(Astro.url.pathname, Astro.site) — that is what
// used to be here, and it disagreed with the JSON-LD about the trailing slash
// on every page.
const canonicalURL = canonicalFor(Astro);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = BRAND_NAME;

const profile = brandProfile(Astro.site);

// คำบรรยาย alt ของ hero เขียนจากไฟล์ banner1.png ของดรอป 2026-10-21 จริง
// (อ่านด้วย Read ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — **ฟาร์มทุ่งหญ้าแดดจัด
// ยุ้งฉางไม้สีแดง กังหันลมไม้ ฟ่อนฟางเหลือง รั้วไม้ หมูการ์ตูนสวมหน้ากากโจรสีดำ
// ชายหนุ่มผมเงินเสื้อกล้ามขาว หญิงสาวสปอร์ตบราชมพู แคปซูลดำขอบชมพู "ระบบดูแล
// การเงิน" และแถบขาว "ฝากถอนทุกช่องทาง ปลอดภัยไม่ผ่านม้า" ของ มีทรัพย์168
// ไม่มีอยู่ในรูปรอบนี้เลย** ห้องโถงคฤหาสน์หรูขาว-งาช้าง หัวไฉ่ซิงเอี๊ย มงกุฎทอง
// ชิปคาสิโนดำ-ทอง และไพ่เอซโพดำของ ดวงเศรษฐี168 ก็ไม่มี สิงโตทองสวมมงกุฎ สนาม
// ฟุตบอล และถ้วยแชมเปี้ยนส์ลีกของ ufalion168 ก็ไม่มี ตู้สล็อต 777 และกล่องของขวัญ
// แดงของ รวยเทพ168 ก็ไม่มี ชุดลูกไม้ขาวผูกโบว์แดงของ มีเฮ168 ก็ไม่มี ถุงเงินสีฟ้า
// ของ รวยแทร่168 ก็ไม่มี นินจาการ์ตูนและชูริเคนฟ้าของ นินจา168 ก็ไม่มี แมวการ์ตูน
// ขนขาวลายส้มของ สบายเบท168 ก็ไม่มี ดอกซากุระชมพูของ ถอนชัวร์168 ก็ไม่มี แมวกวัก
// นำโชคและธงชาติสิงคโปร์ของ มีโชค168 ก็ไม่มี อักขระมังกรจีน 龍 ของ GT66B ก็ไม่มี
// และ **มงกุฎทองวางบนลูกบอลหวยสีทองเลข 9 ของ หวยคิง ซึ่งเป็นเจ้าของเดิมของชุด
// *Huay ก็ไม่มี**
// ⚠️ รอบนี้ฉากหลังของแบนเนอร์เป็น **วัดไทย/พระบรมมหาราชวังกลางแจ้งแดดจัด** —
// **เจดีย์และยอดปราสาททองหลายองค์** ท้องฟ้าฟ้าอ่อนมีเมฆขาว ด้านหน้ามี **ใบบัวและ
// ดอกบัวชมพู** **ฝั่งซ้าย** เป็น **ชายหนุ่มผมสั้นสีดำ สวมชุดไทยโจงกระเบนสีครีม-ทอง
// ลายปัก สร้อยและกำไลทอง ถือสลากกินแบ่งรัฐบาลในมือ** **ฝั่งขวา** เป็น **หญิงสาว
// ผมสั้นสีดำทัดดอกไม้ขาว สวมชุดไทยสไบลายทอง สร้อยและต่างหูทอง ถือสลากกินแบ่ง
// คลี่เป็นพัด** **กลางภาพด้านบน** เป็น **โลโก้ขนาดย่อ: ชื่อแบรนด์เขียว-ทอง**
// ใต้ลงมาเป็น **ชื่อแบรนด์ตัวโต "สาธุ" เขียวมรกตสามมิติ ต่อด้วยเลข "168" ทอง
// สามมิติ** ต่อด้วย **แคปซูลมนพื้นดำขอบทองเขียนว่า เว็บหวย (ขาว) จ่ายจริงไม่โกง
// (ทอง)** และ **แถบทองขอบมนเขียนว่า ระบบแทงหวย รัฐบาลไทย ฮานอย ลาว หุ้น**
// ขนาบด้วย **ไอคอนเหรียญทองและไอคอนกราฟแท่งขึ้น** มุมล่างซ้าย-ขวามี
// **ลูกบอลหวยขาว-ดำเลข 6 และ 9**
// ⚠️ **ฉากในภาพสว่าง และรอบนี้พื้นเพจก็สว่างเช่นกัน (#d8ffc7 จาก bg.json)** —
// แต่ **ค่าพื้นเพจยังมาจาก bg.json เท่านั้น ไม่ได้อนุมานจากรูป** ให้เปิด bg.json
// ดูทุกรอบเหมือนเดิม
// — **ไม่มีสีชมพูเป็นสีแบรนด์ ไม่มีบรอนซ์ส้ม ไม่มีสีม่วง และไม่มีโครเมียมในภาพนี้เลย
// ส่วนฟ้าอ่อนของท้องฟ้า ชมพูของดอกบัว ครีมของชุดไทย และดำของลูกบอลหวย
// เป็นวัตถุในภาพ ไม่ใช่สีแบรนด์**
//
// <html> มี id="top" เป็นเป้าของปุ่ม "กลับขึ้นบน" ใน footer แทน onclick เดิมที่
// ฮาร์ดโค้ด behavior ของ scroll ไว้ จึงไม่ฟัง prefers-reduced-motion — ตอนนี้การ
// เลื่อนมาจาก scroll-behavior ใน global.css ซึ่งบล็อก reduced-motion ทับให้แล้ว
//
// ห้ามวาง expression comment ไว้ "ก่อน" <html> ในไฟล์นี้ — Astro จะเลิกมองว่า
// <html> เป็น root ของเอกสารแล้วตัดทั้งแท็กทิ้ง (ทดสอบแล้วเมื่อ 2026-07-31:
// ผลลัพธ์คือทุกหน้าไม่มี <html lang="th"> เลย) คอมเมนต์ที่อธิบายโครงหน้าเลยต้อง
// อยู่ใน frontmatter แบบนี้เท่านั้น
//
// color บน <html> คือสีตัวอักษร "พื้น" ของทั้งเว็บ มาจาก BRAND_TEXT — ห้ามลบ
// ตอนรีแบรนด์ ไม่มีที่อื่นตั้งค่านี้เลย (global.css ก็ไม่ตั้ง) ถ้าหายไป element
// ไหนที่ไม่ได้ใส่คลาสสีเองจะกลายเป็นสีดำของเบราว์เซอร์บนพื้นดำสนิท = หายไปเลย
// หน้า terms/privacy/404 เป็นไฟล์ถาวรที่ไม่ใส่สีของแบรนด์ไว้ข้างในโดยตั้งใจ
// จึงพึ่งบรรทัดนี้ทั้งหมด — verify-build.mjs ตรวจข้อนี้ให้แล้ว build จะแดงถ้าลืม
//
// background-color ใน <style is:global> เป็นสีรองพื้นก่อนที่ชั้น bg จะวาดทับ
// รอบนี้ตั้งเป็น #d8ffc7 ให้ตรงกับ bg.json ของดรอปนี้ซึ่งเป็น
// {"mode":"color","color":"#d8ffc7"} = **เขียวมิ้นต์สว่าง**
// ⚠️⚠️ **รอบก่อน (มีทรัพย์168) เป็น f0ccf5 ชมพูอมม่วง และรอบนี้ไม่ใช่** — ค่านี้
// มาจาก bg.json ไม่ได้สืบทอดมา ให้เปิดไฟล์ตรวจทุกรอบ ไม่ใช่เดาว่าเท่าเดิมเพราะ
// "รอบก่อนก็สว่างเหมือนกัน" และ **นี่คือค่าที่กำหนดทิศของธีมทั้งเว็บ**:
// เนื้อหาเป็นการ์ดสว่างหมึกเข้ม ส่วนโครมเป็นเขียวป่าเข้มตัวอักษรสว่าง
//
// --font-sans ตั้งเป็น inline style บน <html> ไม่ใช่ใน CSS เพราะ @theme ของ
// Tailwind ประกาศตัวแปรนี้ที่ :root — inline style ชนะเสมอโดยไม่ต้องพึ่ง
// ลำดับของ stylesheet หรือ !important (คอมเมนต์อยู่ใน frontmatter เพราะ
// คอมเมนต์แบบ HTML จะถูกส่งออกไปที่ไฟล์ผลลัพธ์จริง) รอบนี้ BRAND_FONT หมุนจาก
// kanit กลับไปเป็น google-sans ชุด @font-face และ fontPreloads จึงเปลี่ยนตามเอง
// ทั้งหมด — แบรนด์นี้จะไม่มี preload ของ kanit-v17-latin_thai-* เลยสักไฟล์
const heroAlt = `แบนเนอร์ ${BRAND_NAME} เป็นภาพแนวนอนฉากวัดไทยกลางแจ้งแดดจัด ด้านหลังมีเจดีย์และยอดปราสาทสีทองหลายองค์เรียงกัน ท้องฟ้าสีฟ้าอ่อนมีเมฆขาว ด้านหน้ามีใบบัวสีเขียวและดอกบัวสีชมพูบาน ฝั่งซ้ายเป็นชายหนุ่มผมสั้นสีดำ สวมชุดไทยโจงกระเบนสีครีมปักลายทอง สวมสร้อยคอและกำไลทอง นั่งถือสลากกินแบ่งรัฐบาลอยู่ในมือ ฝั่งขวาเป็นหญิงสาวผมสั้นสีดำทัดดอกไม้สีขาว สวมชุดไทยสไบปักลายทอง สวมสร้อยและต่างหูทอง ถือสลากกินแบ่งรัฐบาลคลี่เป็นรูปพัด กลางภาพด้านบนเป็นโลโก้ ${BRAND_NAME} ขนาดย่อ ใต้ลงมาเป็นชื่อแบรนด์ตัวใหญ่ ตัวอักษรไทยคำว่า สาธุ เป็นตัวหนาสามมิติผิวมันวาวสีเขียวมรกตตัดขอบขาว ต่อท้ายด้วยเลข 168 ตัวหนาสามมิติผิวมันวาวสีทอง ถัดลงมาเป็นแคปซูลมนพื้นสีดำขอบสีทองเขียนว่า เว็บหวย ด้วยตัวอักษรสีขาว ต่อด้วยคำว่า จ่ายจริงไม่โกง ด้วยตัวอักษรสีทอง และใต้สุดเป็นแถบสีทองขอบมนเขียนว่า ระบบแทงหวย รัฐบาลไทย ฮานอย ลาว หุ้น ขนาบด้วยไอคอนเหรียญทองทางซ้ายและไอคอนกราฟแท่งขาขึ้นทางขวา มุมล่างของภาพมีลูกบอลหวยสีขาวสลับดำพิมพ์เลข 6 และเลข 9`
---

<html lang="th" id="top" style={`--font-sans: ${fontStack}; color: ${BRAND_TEXT};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href={`/favicon-96x96.png?v=${iconVersion}`} sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
              {profile.showShortcutIcon && <link rel="shortcut icon" href={`/favicon.ico?v=${iconVersion}`} />}
              <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${iconVersion}`} />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #d8ffc7;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        Bg && (
          <Image
            src={Bg}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[412, 768, 1024, 1900]}
            sizes="100vw"
            format="avif"
            class="fixed inset-0 -z-50 h-full w-full object-cover"
            quality="low"
            decoding="async"
          />
        )
      )
    }

    <Navbar />

    <div class="mb-2 flex w-full items-center justify-center">
      {
        /* The LCP element. sizes must describe how wide it is DRAWN, and it is
          drawn full-bleed at every breakpoint — the old "(max-width: 768px)
          412px" claimed 412 px on mobile, so a DPR-2 phone needed 824 and the
          browser jumped straight past the 768 candidate to the 1900 one. That
          is a 3x over-fetch on exactly the image that decides LCP, not a
          blurry-image problem. More candidates below 1900 so there is
          something sensible to land on.

          decoding="sync" is gone: it blocks the main thread on decode for no
          benefit here, since the image is already fetchpriority="high". */
      }
      <picture class="block">
        {mobileBannerImg && <source media="(max-width: 767px)" type="image/avif" srcset={mobileBannerImg.srcSet.attribute || mobileBannerImg.src} sizes="100vw" />}
        <Image
          src={mainBanner}
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          widths={[412, 640, 828, 1024, 1280, 1600, 1900]}
          sizes="100vw"
          class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
          format="avif"
          quality={60}
        />
      </picture>
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
