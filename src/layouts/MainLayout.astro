// ที่บรีฟระบุเอง (บาคาร่า สล็อต ไฮโล รูเล็ต ยิงปลา บอล หวย) **ไม่ใช่การรั่วของ
// แบรนด์หวยเก่า** แต่ก็ไม่ได้แปลว่าเว็บนี้เป็นเว็บหวย — ห้ามเขียนเนื้อหาเฉพาะทาง
// หวย (งวด เลขเด็ด สลาก โพย รอบปิดรับ สองตัวบน-ล่าง สามตัวตรง-โต๊ด) ที่ไหนก็ตามในเว็บ
// รอบนี้คำนิยามตัวเองคือ "เจ้าของบาคาร่าสล็อต ถูกลิขสิทธิ์ เซิร์ฟแท้ ปลอดภัยในไทย"
// ตามบรรทัด Title/Description ของบรีฟเป๊ะๆ (content.txt บรรทัด 1-2) — ทั้งสองบรรทัด
// นี้คัดมา **verbatim** ห้ามต่อเติม เหตุผลที่คัดตรงตัว: บรรทัดในบรีฟคือคำของแบรนด์
// ไม่ใช่ร่างให้ปรับปรุง
const {
  title = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต ถูกลิขสิทธิ์ เซิร์ฟแท้ ปลอดภัยในไทย`,
  description = `${BRAND_NAME} เจ้าของบาคาร่าสล็อต เว็บตรง ถูกลิขสิทธิ์ ครบทุกค่าย ไฮโล รูเล็ต ยิงปลา บอล หวย เข้าเล่นได้ 24 ชั่วโมง เซิร์ฟแท้ ปลอดภัยในไทย`,
  robots = "index, follow",
} = Astro.props;

// og:image. Two problems with what used to be here (`ImageOg = ogImage.src`):
//
//   * `.src` on an imported asset is the ORIGINAL file. Astro copied slide1.png
//     into the build untouched — 190 KB of PNG — purely to be linked from a
//     meta tag. getImage() below runs it through the same pipeline every other
//     image uses.
//   * every page declares twitter:card = summary_large_image, which wants a
//     1.91:1 image around 1200x630. slide1 is a 600x600 square, so the card was
//     rendering a small square crop of a promo banner.
//
// The uploader now writes src/assets/og.png at 1200x630 when slide1 is
// uploaded. Prefer it when it exists; fall back to slide1 for a brand launched
// before that, so this never breaks a build.
const ogCandidates = import.meta.glob<{ default: ImageMetadata }>("../assets/og.{png,webp,jpg,jpeg}", { eager: true });
const ogCandidatePaths = Object.keys(ogCandidates);
const ogSource = ogCandidatePaths.length > 0 ? ogCandidates[ogCandidatePaths[0]].default : ogImage;

// Width only — passing height as well would make the image service crop to that
// exact box, which turns the square fallback into a slice of itself.
const ogRendered = await getImage({ src: ogSource, format: "jpeg", quality: 80, width: Math.min(1200, ogSource.width) });
const ImageOg = ogRendered.src;

// The wallpaper <Image> below is decorative and deliberately lazy/async. It used
// to be loading="eager" decoding="sync", which had the browser fetch and decode
// a full-viewport image at the same priority as the hero banner — the actual LCP
// element — on the one request where that competition costs most. A background
// arriving a beat later is not something a visitor notices; a slow hero is.
//
// (The note lives here rather than above the tag: that tag is one branch of a
// ternary, and a {/* comment */} beside it makes the branch two expressions,
// which fails the build with "Expected ) but found $$render".)
const bgMode = (bgConfig as { mode?: string }).mode ?? "image";
const bgCss = bgMode === "color" ? `background-color:${(bgConfig as { color?: string }).color};` : bgMode === "gradient" ? `background-image:${(bgConfig as { css?: string }).css};` : null;

// Glob'd, not a static `import Bg from "../assets/bg.png"`, for the same reason
// banner1 is glob'd (see the comment above bannerImages): a static import is an
// EMITTED file whether or not anything renders it. When bgMode is "color" or
// "gradient" the <Image> branch below never runs, so a leftover bg.png from a
// previous brand's asset drop must not be forced into the bundle just because
// this file's name is referenced somewhere. Glob only matches files that exist
// on disk, so once a stale bg.png is deleted there is nothing left to emit.
const bgImages = import.meta.glob<{ default: ImageMetadata }>("../assets/bg.{png,webp,jpg,jpeg}", { eager: true });
const bgPaths = Object.keys(bgImages);
const Bg = bgPaths.length > 0 ? bgImages[bgPaths[0]].default : null;

// canonicalFor() is the same function every JSON-LD URL goes through, so the
// canonical and the structured data cannot drift apart (see src/lib/schema.ts).
// Do not replace it with new URL(Astro.url.pathname, Astro.site) — that is what
// used to be here, and it disagreed with the JSON-LD about the trailing slash
// on every page.
const canonicalURL = canonicalFor(Astro);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = BRAND_NAME;

const profile = brandProfile(Astro.site);

// คำบรรยาย alt ของ hero เขียนจากไฟล์ banner1.png ของดรอปนี้จริง (2243x701,
// อ่านด้วย Read ก่อนเขียน) ไม่ใช่คัดลอกของรอบก่อน — **ดรอปนี้เปลี่ยนฉากทั้งฉาก
// จากห้องสไตล์ญี่ปุ่นที่มีกอไผ่ ดอกไม้ขาว หญิงสาวสวมกิโมโนลายดอกไม้เขียว-ขาว
// และดาบคาทานะวางพาด (ZORO365) มาเป็นโถงวังหินอ่อนสีงาช้างที่มีเสาและซุ้มโค้ง
// หญิงสาวสวมมงกุฎทองประดับอัญมณีแดงกับชุดราตรีแดง-ขาวปักทอง กองชิปคาสิโนแดง-ขาว
// และไพ่เอซโพดำ — ทั้งฉาก ทั้งคู่สี และพร็อพทุกชิ้นเปลี่ยนหมด**
// ของรอบก่อน (ZORO365 — แบรนด์ขาออก เสี่ยงหลงเหลือสูงสุด) ที่ **ไม่มีในรูปนี้**:
// ห้องสไตล์ญี่ปุ่น · กอไผ่ · ดอกไม้สีขาว · กิโมโนลายดอกไม้เขียว-ขาว ·
// ดาบคาทานะ · วงพู่กันหมึกดำ-เขียว · ชิปคาสิโนสีเขียวเข้มสลับขาว ·
// ควันเขียวเรืองแสง · ตัวอักษรไทย "เกมคาสิโนสายตรง"
// ของ TEVA69 ที่ไม่มีเช่นกัน: ห้องออฟฟิศสีขาวครีมที่มีหน้าต่างบานสูง · สูทสีขาว ·
// อาร์มแชร์บุผ้าขาว · โน้ตบุ๊กเปิด · ต้นไม้ใบเขียวในกระถาง · ชิปพิมพ์เลข 69
// ของ LOTTO189 ที่ไม่มีเช่นกัน: ลูกบอลหวยทรงกลมสีขาวพิมพ์ตัวเลขสีแดง ·
// ใบโพยหวยกองซ้อนกัน · ปากกาด้ามสีทอง · ม่านผ้าสีขาวและผนังบัวแบบหลุยส์
// ของ ZANE96 ที่ไม่มีเช่นกัน: ตู้สล็อตผิวแก้วม่วงไลแลคที่มีเลข 777 · ชิปคาสิโน
// แมเจนต้าสลับขาว · เชอร์รี่สองลูกสีชมพู · เพชรม่วง · ลำแสงนีออนม่วง-แมเจนต้า
// ของ ZNOVA168 ที่ไม่มีเช่นกัน: ชุดเกราะเมทัลลิกเงิน-ขาวประดับหนามแหลม ·
// ริบบิ้นผ้าสีแดงพลิ้ว · เหรียญทองลอยกระจาย · โลโก้ทรูมันนี่วอลเล็ตบนการ์ดขาว
// ของ MEXICANOSLOT ที่ไม่มีเช่นกัน: ซอมเบรโรฟางขอบลายปัก · ปอนโช/ผ้าซาราเป้ ·
// มาราคัส · กีตาร์โปร่ง · กระบองเพชรเขียว · พริกแดง · ธงชาติเม็กซิโก ·
// อาคารอะโดบีครีม · ชายไว้หนวด
// ของ รวยเทพ168 ที่ไม่มีเช่นกัน: เทพเจ้าแห่งโชคลาภของจีนกำลังหัวเราะ ·
// หมวกปีกสีทองแต่งแดง · ก้อนทองในมือ · ริ้วทองโค้ง · เหรียญทองกระจาย
// ของแบรนด์เก่ากว่านั้นที่ไม่มีเช่นกัน: หน้าการ์ตูนกลมชมพูขยิบตาชู V (okkub88) ·
// เมฆการ์ตูนฟ้าอ่อน (โบ๊ะบ๊ะ168) · ลูกหมูการ์ตูนมีปีกนางฟ้า (หมูบิน168) ·
// นักบินอวกาศ (นาซ่า168) · ลูกฟุตบอลขอบทองกับอัฒจันทร์ (ยูฟ้า168) ·
// วัดไทยริมน้ำ (รวยแท้168) · สิงโตทอง (ufalion168) · แมวกวัก (มีโชค168)
// ⚠️⚠️ **ระวังที่สุดสามข้อ:**
// (1) 🚨🚨 **"มงกุฎทอง" กลับทิศจากรอบก่อนๆ** — TEVA69 เคยถูกห้ามไว้เพราะเป็น
// "มงกุฎทองบนกองชิป" และ สล็อต168 เพราะ "มงกุฎทองเล็กประดับหัวใจแดง" แต่
// **ดรอปนี้มีมงกุฎทองประดับอัญมณีแดงที่นางแบบสวมอยู่บนศีรษะจริง** และ
// **มงกุฎเงินประดับกำมะหยี่แดงอยู่บนโลโก้** — **บรรยายตามที่เห็น อย่าสืบทอด
// ข้อห้ามข้ามรอบ** แต่ระบุตำแหน่งให้ตรง (สวมบนศีรษะ/อยู่บนโลโก้ ไม่ใช่วางบนกองชิป)
// (2) 🚨 **ชิปคาสิโนมีจริงในรูปนี้ด้วย** — เป็น **ชิปสีแดงสลับขาว** ไม่ใช่ชิปเขียว
// ของ ZORO365 ไม่ใช่ชิปแมเจนต้าของ ZANE96 และ **ไม่มีมงกุฎวางอยู่บนกองชิป**
// — บรรยายรูปแต่ละใบจากตัวมันเอง อย่าเหมารวม
// (3) 🚨🚨 **แดงเคยเป็นฮิวนำของ LOTTO189 · MEXICANOSLOT · สล็อต168 · มาดาม168 ·
// รวยแท้168 · ดวงเศรษฐี168 มาแล้ว** — สีในรูป **เป็นอาร์ตเวิร์ก** ส่วนสี UI ต้องมา
// จากตาราง brand-spec §2 เท่านั้น ห้ามดูดค่าจากรูป
// ⚠️ รอบนี้ฉากหลังของแบนเนอร์เป็น **โถงวังหินอ่อนสีงาช้างที่มีเสาสูงและซุ้มโค้ง**
// **ฝั่งซ้าย** เป็น **หญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีแดง
// และต่างหูแดง สวมชุดราตรีแดง-ขาวปักทองแต่งลูกไม้ขาว เอนกายอยู่บนหมอนกำมะหยี่แดง
// เท้าคางมองมาทางผู้ชม**
// **ตรงกลางค่อนไปขวา** เป็น **เวิร์ดมาร์กสามมิติตัวโต ครึ่งแรกเป็นตัวเลขผิวแดงชาด
// เคลือบเงาตัดขอบทอง ครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา**
// ต่อด้วย **ตัวอักษรไทยสามมิติสีทองไล่เฉด** และใต้สุดเป็น **แถบแคปซูลพื้นแดงเข้ม
// ขอบช่อใบไม้ทอง ตัวอักษรขาว**
// **มุมล่างซ้ายและล่างขวา** มี **กองชิปคาสิโนสีแดงสลับขาว** · **ขอบขวา** มี
// **ไพ่เอซโพดำสองใบ** และ **กรอบทองฉลุ** · **มุมบนขวา** มี **โลโก้ตราสัญลักษณ์
// ดวงเล็กที่มีมงกุฎอยู่ด้านบน**
// ⚠️⚠️ **อาร์ตเวิร์กพิมพ์ชื่อแบรนด์ไว้บนรูปจริง** — alt จึงอ้างชื่อด้วย BRAND_NAME
// เท่านั้น **ห้ามพิมพ์ตัวอักษรชื่อแบรนด์ลงใน alt** (hero ขึ้นทุกหน้า จึงเป็นจุดรั่ว
// ที่กว้างที่สุดในเว็บ)
// ⚠️ **ฉากในภาพสว่าง และรอบนี้พื้นเพจก็สว่าง (#f7e4e9 จาก bg.json) — แต่นั่นเป็น
// เรื่องบังเอิญ** **ค่าพื้นเพจมาจาก bg.json เท่านั้น ไม่ได้อนุมานจากรูป** ให้เปิด
// bg.json ดูทุกรอบ โดยเฉพาะรอบที่สองค่าบังเอิญไปทางเดียวกันแบบนี้
//
// <html> มี id="top" เป็นเป้าของปุ่ม "กลับขึ้นบน" ใน footer แทน onclick เดิมที่
// ฮาร์ดโค้ด behavior ของ scroll ไว้ จึงไม่ฟัง prefers-reduced-motion — ตอนนี้การ
// เลื่อนมาจาก scroll-behavior ใน global.css ซึ่งบล็อก reduced-motion ทับให้แล้ว
//
// ห้ามวาง expression comment ไว้ "ก่อน" <html> ในไฟล์นี้ — Astro จะเลิกมองว่า
// <html> เป็น root ของเอกสารแล้วตัดทั้งแท็กทิ้ง (ทดสอบแล้วเมื่อ 2026-07-31:
// ผลลัพธ์คือทุกหน้าไม่มี <html lang="th"> เลย) คอมเมนต์ที่อธิบายโครงหน้าเลยต้อง
// อยู่ใน frontmatter แบบนี้เท่านั้น
//
// color บน <html> คือสีตัวอักษร "พื้น" ของทั้งเว็บ มาจาก BRAND_TEXT — ห้ามลบ
// ตอนรีแบรนด์ ไม่มีที่อื่นตั้งค่านี้เลย (global.css ก็ไม่ตั้ง) ถ้าหายไป element
// ไหนที่ไม่ได้ใส่คลาสสีเองจะกลายเป็นสีดำของเบราว์เซอร์
// หน้า terms/privacy/404 เป็นไฟล์ถาวรที่ไม่ใส่สีของแบรนด์ไว้ข้างในโดยตั้งใจ
// จึงพึ่งบรรทัดนี้ทั้งหมด — verify-build.mjs ตรวจข้อนี้ให้แล้ว build จะแดงถ้าลืม
// ⚠️⚠️ รอบนี้ค่านี้เป็น **หมึกเข้ม #36080f (16.3:1 บนการ์ด #fdf5f6 ·
// 14.4:1 บนพื้นเพจ #f7e4e9)** เพราะ **เนื้อหา** เป็นธีมสว่าง — รอบก่อนเป็นหมึกสว่าง
// eef7f0 เพราะทั้งเว็บเป็นธีมมืด **ห้ามสืบทอดค่าข้ามรอบ** และห้ามคงค่าเดิมไว้
// ไม่งั้นหน้า terms/privacy/404 จะเป็นตัวอักษรขาวจางบนพื้นชมพูจาง = อ่านไม่ออกเลย
// ⚠️ รอบนี้ค่านี้ใช้ได้เฉพาะบนผิวเนื้อหาสว่าง **ไม่ใช่บนผิวโครมเข้ม** —
// navbar/footer/ticker/แถบล่างมือถือประกาศสีตัวอักษรของตัวเองไว้ครบตามเดิม
// (หมึกบนโครมคือ #fdf5f6) **ห้ามถอดคลาสสีออกจากสี่ไฟล์นั้นโดยคิดว่าจะ inherit ได้**
//
// background-color ใน <style is:global> เป็นสีรองพื้นก่อนที่ชั้น bg จะวาดทับ
// รอบนี้ตั้งเป็น #f7e4e9 ให้ตรงกับ bg.json ของดรอปนี้ซึ่งเป็น mode color
// + color #f7e4e9 = **ชมพูบลัชจาง**
// ⚠️⚠️ **รอบก่อน (ZORO365) เป็น 002908 = เขียวป่าจมเกือบดำ ซึ่งอยู่คนละปลายของ
// สเกลความสว่าง** — ค่านี้มาจาก bg.json ไม่ได้สืบทอดมา ให้เปิดไฟล์ตรวจทุกรอบ
// และ **นี่คือค่าที่กำหนดทิศของทั้งเว็บ**: รอบนี้เนื้อหาสว่าง โครมเข้ม
// ⚠️ หมึกสว่างบน #f7e4e9 มองไม่เห็นเลย ข้อความบนผิวเนื้อหาจึงต้องเป็นหมึกเข้มเท่านั้น
//
// --font-sans ตั้งเป็น inline style บน <html> ไม่ใช่ใน CSS เพราะ @theme ของ
// Tailwind ประกาศตัวแปรนี้ที่ :root — inline style ชนะเสมอโดยไม่ต้องพึ่ง
// ลำดับของ stylesheet หรือ !important (คอมเมนต์อยู่ใน frontmatter เพราะ
// คอมเมนต์แบบ HTML จะถูกส่งออกไปที่ไฟล์ผลลัพธ์จริง) รอบนี้ BRAND_FONT หมุนจาก
// google-sans (ZORO365) ไปเป็น kanit ชุด @font-face และ fontPreloads จึง
// เปลี่ยนตามเองทั้งหมด — แบรนด์นี้จะไม่มี preload ของ google-sans-v70-* เลยสักไฟล์
const heroAlt = `แบนเนอร์ ${BRAND_NAME} เป็นภาพแนวนอนฉากโถงวังหินอ่อนสีงาช้างที่มีเสาสูงและซุ้มโค้งเป็นฉากหลัง ฝั่งซ้ายเป็นหญิงสาวผมยาวสีน้ำตาลเป็นลอน สวมมงกุฎทองประดับอัญมณีสีแดงและต่างหูระย้าสีแดง สวมชุดราตรีสีแดงสลับขาวปักลวดลายทองและแต่งลูกไม้สีขาว เอนกายอยู่บนหมอนกำมะหยี่สีแดง เท้าคางมองมาทางผู้ชม กลางภาพค่อนไปทางขวาเป็นข้อความตัวใหญ่สามมิติ ${BRAND_NAME} ซึ่งครึ่งแรกเป็นตัวเลขผิวแดงชาดเคลือบเงาตัดขอบทอง และครึ่งหลังเป็นตัวอักษรละตินผิวโครเมียมเงินขัดเงา ไล่จากเงินสว่างด้านบนลงมาหาเทาเข้มด้านล่าง ใต้ข้อความเป็นตัวอักษรไทยสามมิติสีทองไล่เฉดตัดขอบแดง และใต้สุดเป็นแถบแคปซูลพื้นสีแดงเข้มขอบช่อใบไม้ทองที่มีข้อความสีขาวอยู่ภายใน มุมล่างซ้ายและมุมล่างขวาของภาพมีกองชิปคาสิโนสีแดงสลับขาวซ้อนกันเป็นตั้ง ขอบขวาของภาพมีไพ่เอซโพดำสองใบวางพิงอยู่กับกรอบทองฉลุลาย ส่วนมุมบนขวาเป็นโลโก้ ${BRAND_NAME} ขนาดเล็ก ซึ่งเป็นเวิร์ดมาร์กเดียวกันวางบนโล่ตราสัญลักษณ์ผิวโครเมียมเงิน โดยมีมงกุฎผิวเงินประดับกำมะหยี่สีแดงอยู่ด้านบน`;
---

<html lang="th" id="top" style={`--font-sans: ${fontStack}; color: ${BRAND_TEXT};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {profile.fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin={profile.crossorigin} />)}
    <link rel="canonical" href={canonicalURL} />

    {
      profile.headOrder.map((block) => (
        <Fragment>
          {block === "icons" && (
            <Fragment>
              <link rel="icon" type="image/png" href={`/favicon-96x96.png?v=${iconVersion}`} sizes="96x96" />
              <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
              {profile.showShortcutIcon && <link rel="shortcut icon" href={`/favicon.ico?v=${iconVersion}`} />}
              <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${iconVersion}`} />
            </Fragment>
          )}

          {block === "appmeta" && (
            <Fragment>
              {profile.showAppTitle && <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />}
              <link rel="manifest" href="/site.webmanifest" />
            </Fragment>
          )}

          {block === "og" && (
            <Fragment>
              <meta property="og:type" content="website" />
              <meta property="og:url" content={canonicalURL} />
              <meta property="og:title" content={title} />
              <meta property="og:description" content={description} />
              <meta property="og:image" content={ogImageURL} />
              <meta property="og:site_name" content={ogSiteName} />
              {profile.showOgLocale && <meta property="og:locale" content="th_TH" />}
            </Fragment>
          )}

          {block === "twitter" && (
            <Fragment>
              <meta name="twitter:card" content="summary_large_image" />
              {profile.showTwitterUrl && <meta name="twitter:url" content={canonicalURL} />}
              <meta name="twitter:title" content={title} />
              <meta name="twitter:description" content={description} />
              <meta name="twitter:image" content={ogImageURL} />
            </Fragment>
          )}
        </Fragment>
      ))
    }

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #f7e4e9;
        font-weight: 400;
        font-family: var(--font-sans) !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    {
      bgCss ? (
        <div class="fixed inset-0 -z-50 h-full w-full bg-cover bg-center" style={bgCss} />
      ) : (
        Bg && (
          <Image
            src={Bg}
            alt=""
            loading="lazy"
            fetchpriority="low"
            widths={[412, 768, 1024, 1900]}
            sizes="100vw"
            format="avif"
            class="fixed inset-0 -z-50 h-full w-full object-cover"
            quality="low"
            decoding="async"
          />
        )
      )
    }

    <Navbar />

    <div class="mb-2 flex w-full items-center justify-center">
      {
        /* The LCP element. sizes must describe how wide it is DRAWN, and it is
          drawn full-bleed at every breakpoint — the old "(max-width: 768px)
          412px" claimed 412 px on mobile, so a DPR-2 phone needed 824 and the
          browser jumped straight past the 768 candidate to the 1900 one. That
          is a 3x over-fetch on exactly the image that decides LCP, not a
          blurry-image problem. More candidates below 1900 so there is
          something sensible to land on.

          decoding="sync" is gone: it blocks the main thread on decode for no
          benefit here, since the image is already fetchpriority="high". */
      }
      <picture class="block">
        {mobileBannerImg && <source media="(max-width: 767px)" type="image/avif" srcset={mobileBannerImg.srcSet.attribute || mobileBannerImg.src} sizes="100vw" />}
        <Image
          src={mainBanner}
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          widths={[412, 640, 828, 1024, 1280, 1600, 1900]}
          sizes="100vw"
          class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
          format="avif"
          quality={60}
        />
      </picture>
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
